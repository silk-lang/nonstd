//! Store tests: the memory store passes the conformance suite.
import store { conformance, MemoryStore, Store, StoreError }
import codec { DecodeError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError }

test effect fn memoryStoreConformsTest() -> ()
  ! AssertionError<'static> | StoreError | DecodeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut memory = MemoryStore.make()
  run conformance()
    |> Effect.provideMut<Store>(&mut memory)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
