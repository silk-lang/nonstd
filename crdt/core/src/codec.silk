//! The byte encoding of deltas: LEB128 integers and length-prefixed byte strings.
//!
//! Every encoding starts with [`VERSION`], so a reader can refuse data written by a later format.
import clock { DeltaId }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The format of encoded deltas.
pub const VERSION: u64 = 1

/// Encoded data was cut short, malformed or written by an unknown format.
pub struct DecodeError {}

/// Appends values to a byte list.
pub struct Writer {
  pub bytes: List<u8>,
}

impl Writer {
  pub fn make() -> Writer {
    return Writer { bytes: List<u8>.make() }
  }

  pub effect fn byte(self: &mut Self, value: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.bytes.append(value)
  }

  /// An unsigned LEB128 integer.
  pub effect fn number(self: &mut Self, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rest = value
    while rest >= 128 {
      run self.bytes.append(u64.toU8(u64.bitOr(u64.bitAnd(rest, 127), 128)))
      rest = u64.shiftRight(rest, 7)
    }
    run self.bytes.append(u64.toU8(rest))
  }

  pub effect fn size(self: &mut Self, value: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.number(usize.toU64(value))
  }

  pub effect fn flag(self: &mut Self, value: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if value {
      run self.bytes.append(1)
    } else {
      run self.bytes.append(0)
    }
  }

  /// A length-prefixed byte string.
  pub effect fn data(self: &mut Self, value: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.size(value.length)
    run self.bytes.appendSlice(value)
  }

  pub effect fn id(self: &mut Self, value: DeltaId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.number(value.lamport)
    run self.number(value.actor)
  }
}

/// Reads values from bytes in the order a [`Writer`] wrote them.
pub struct Reader<'a> {
  bytes: &'a [u8],
  at: usize,
}

impl<'a> Reader<'a> {
  pub fn of(bytes: &'a [u8]) -> Reader<'a> {
    return Reader<'a> { bytes: bytes, at: 0 }
  }

  /// Whether every byte has been read.
  pub fn done(self: &Self) -> bool {
    return self.at == self.bytes.length
  }

  pub effect fn byte(self: &mut Self) -> u8
    ! DecodeError {
    if self.at >= self.bytes.length {
      fail DecodeError {}
    }
    let value = self.bytes[self.at]
    self.at = self.at + 1
    return value
  }

  pub effect fn number(self: &mut Self) -> u64
    ! DecodeError {
    let mut value: u64 = 0
    let mut shift: u64 = 0
    while true {
      let next = run self.byte()
      if shift > 63 {
        fail DecodeError {}
      }
      value = u64.bitOr(value, u64.shiftLeft(u8.toU64(u8.bitAnd(next, 127)), shift))
      if next < 128 {
        break
      }
      shift = shift + 7
    }
    return value
  }

  /// A size, refused when larger than the bytes left, which every size here counts or bounds.
  pub effect fn size(self: &mut Self) -> usize
    ! DecodeError {
    let value = run self.number()
    if value > usize.toU64(self.bytes.length - self.at) {
      fail DecodeError {}
    }
    return u64.toUsize(value)
  }

  pub effect fn flag(self: &mut Self) -> bool
    ! DecodeError {
    let value = run self.byte()
    if value > 1 {
      fail DecodeError {}
    }
    return value == 1
  }

  pub effect fn data(self: &mut Self) -> &'a [u8]
    ! DecodeError {
    let length = run self.size()
    let value = Slice.view(self.bytes, self.at, length)
    self.at = self.at + length
    return value
  }

  pub effect fn id(self: &mut Self) -> DeltaId
    ! DecodeError {
    let lamport = run self.number()
    let actor = run self.number()
    return DeltaId.make(lamport, actor)
  }
}
