//! Names for deltas: actors, Lamport-stamped delta ids, and frontiers.
import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

/// The id of one replica session: a random number that is never reused.
pub type ActorId = u64

/// The name of one delta: its Lamport timestamp and the actor that made it.
///
/// Every delta's timestamp is one more than the highest timestamp among its parents, so a delta
/// always sorts after everything it saw. Ids order by timestamp, then by actor.
pub struct DeltaId {
  pub lamport: u64,
  pub actor: ActorId,
}

impl Copy for DeltaId {}

impl DeltaId {
  /// Makes the id of the delta stamped `lamport` by `actor`.
  pub fn make(lamport: u64, actor: ActorId) -> DeltaId {
    return DeltaId { lamport: lamport, actor: actor }
  }

  /// Whether both ids name the same delta.
  pub fn same(self: &Self, other: &DeltaId) -> bool {
    return self.lamport == other.lamport && self.actor == other.actor
  }

  /// Whether this id sorts before `other`: a lower timestamp, or the same one and a lower actor.
  pub fn before(self: &Self, other: &DeltaId) -> bool {
    if self.lamport != other.lamport {
      return self.lamport < other.lamport
    }
    return self.actor < other.actor
  }
}

fn idEquals(left: &DeltaId, right: &DeltaId) -> bool {
  return left.same(right)
}

fn idHash(value: &DeltaId, seed: &HashSeed) -> u64 {
  return Hash.combine(Hash.mix(seed, value.lamport), value.actor)
}

impl HashKey for DeltaId { equals: DeltaId.idEquals hash: DeltaId.idHash }

/// A version of a document: the set of deltas that no other delta in the version builds on.
///
/// The ids are kept sorted. A frontier usually holds one id; it holds more only while concurrent
/// branches are not merged yet.
pub struct Frontier {
  ids: List<DeltaId>,
}

impl Frontier {
  /// The version before any delta.
  pub fn empty() -> Frontier {
    return Frontier { ids: List<DeltaId>.make() }
  }

  /// The version whose only tip is `id`.
  pub effect fn single(id: DeltaId) -> Frontier ! OutOfMemoryError ? &mut Allocator {
    let mut frontier = Frontier.empty()
    run frontier.ids.append(id)
    return move frontier
  }

  /// A frontier holding `ids`, sorted and without duplicates. The ids must not build on each other.
  pub effect fn of(ids: &[DeltaId]) -> Frontier ! OutOfMemoryError ? &mut Allocator {
    let mut frontier = Frontier.empty()
    let mut k: usize = 0
    while k < ids.length {
      run frontier.add(ids[k])
      k = k + 1
    }
    return move frontier
  }

  /// A copy of this frontier.
  pub effect fn copy(self: &Self) -> Frontier ! OutOfMemoryError ? &mut Allocator {
    return run Frontier.of(self.ids.asSlice())
  }

  /// The tips, sorted.
  pub fn tips(self: &Self) -> &[DeltaId] {
    return self.ids.asSlice()
  }

  /// The number of tips.
  pub fn length(self: &Self) -> usize {
    return self.ids.length()
  }

  /// Whether `id` is one of the tips.
  pub fn has(self: &Self, id: DeltaId) -> bool {
    let mut k: usize = 0
    while k < self.ids.length() {
      if self.ids.get(k).same(&id) {
        return true
      }
      k = k + 1
    }
    return false
  }

  /// Whether both frontiers hold the same tips.
  pub fn same(self: &Self, other: &Frontier) -> bool {
    if self.ids.length() != other.ids.length() {
      return false
    }
    let mut k: usize = 0
    while k < self.ids.length() {
      if !self.ids.get(k).same(&other.ids.get(k)) {
        return false
      }
      k = k + 1
    }
    return true
  }

  /// Adds `id` as a tip, keeping the ids sorted. Does nothing if it is already a tip.
  pub effect fn add(self: &mut Self, id: DeltaId) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at: usize = 0
    while at < self.ids.length() {
      let here = self.ids.get(at)
      if here.same(&id) {
        return ()
      }
      if id.before(&here) {
        break
      }
      at = at + 1
    }
    run self.ids.insert(at, id)
  }

  /// Removes `id` if it is a tip.
  pub fn remove(self: &mut Self, id: DeltaId) -> () {
    let mut k: usize = 0
    while k < self.ids.length() {
      if self.ids.get(k).same(&id) {
        drop self.ids.remove(k)
        return ()
      }
      k = k + 1
    }
  }

  /// Moves the version past a new delta `id` that built on `parents`: the parents stop being tips
  /// and `id` becomes one.
  pub effect fn advance(self: &mut Self, parents: &[DeltaId], id: DeltaId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut k: usize = 0
    while k < parents.length {
      self.remove(parents[k])
      k = k + 1
    }
    run self.add(id)
  }

  /// The Lamport timestamp of a delta built on this frontier: one more than its highest tip.
  pub fn nextLamport(self: &Self) -> u64 {
    let mut highest: u64 = 0
    let mut k: usize = 0
    while k < self.ids.length() {
      let lamport = self.ids.get(k).lamport
      if lamport > highest {
        highest = lamport
      }
      k = k + 1
    }
    return highest + 1
  }
}
