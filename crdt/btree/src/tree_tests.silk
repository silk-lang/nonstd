//! Tree tests: random edits match a list, old roots survive edits, and nodes are freed.
import tree { Item, Root, Summary, Tree }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize
import silk.testing.testing { AssertionError, Testing }

type Failures = AssertionError<'static> | OutOfMemoryError

struct Run {
  width: usize,
  tag: u64,
}

impl Copy for Run {}

struct Total {
  items: usize,
  width: usize,
  top: u64,
}

impl Copy for Total {}

impl Summary for Total {
  fn zero() -> Total {
    return Total { items: 0, width: 0, top: 0 }
  }

  fn add(self: &mut Self, other: &Total) -> () {
    self.items = self.items + other.items
    self.width = self.width + other.width
    if other.top > self.top {
      self.top = other.top
    }
  }
}

impl Item<Total> for Run {
  fn summary(self: &Self) -> Total {
    return Total { items: 1, width: self.width, top: self.tag }
  }
}

fn width(total: &Total) -> usize {
  return total.width
}

fn top(total: &Total) -> u64 {
  return total.top
}

struct Random {
  state: u64,
}

impl Random {
  fn next(self: &mut Self) -> u64 {
    let mut x = self.state
    x = u64.bitXor(x, u64.shiftLeft(x, 13))
    x = u64.bitXor(x, u64.shiftRight(x, 7))
    x = u64.bitXor(x, u64.shiftLeft(x, 17))
    self.state = x
    return x
  }

  fn below(self: &mut Self, bound: usize) -> usize {
    if bound == 0 {
      return 0
    }
    return u64.toUsize(self.next() % usize.toU64(bound))
  }
}

effect fn sameAs(tree: &Tree<Run, Total>, root: Root, model: &List<Run>) -> ()
  ! Failures {
  run Testing.expect(tree.length(root) == model.length(), "the tree has the model's length")
  let mut total: usize = 0
  let mut k: usize = 0
  while k < model.length() {
    let expected = model.get(k)
    let actual = tree.get(root, k)
    run Testing.expect(actual.tag == expected.tag, "each item matches the model")
    run Testing.expect(tree.measureBefore(root, width, k) == total, "prefix widths match")
    total = total + expected.width
    k = k + 1
  }
  run Testing.expect(tree.summary(root).width == total, "the root summary is the total width")
}

effect fn randomEdits() -> ()
  ! Failures
  ? &mut Allocator {
  let mut tree = Tree<Run, Total>.make(Run { width: 0, tag: 0 })
  let mut root = Root.empty()
  let mut model = List<Run>.make()
  let mut random = Random { state: 88172645463325252 }
  let mut step: usize = 0
  while step < 20000 {
    let choice = random.below(10)
    let length = model.length()
    if choice < 6 || length == 0 {
      let at = random.below(length + 1)
      let run_ = Run { width: random.below(4), tag: usize.toU64(step) }
      run tree.insert(&mut root, at, run_)
      run model.insert(at, run_)
    } else if choice < 8 {
      let at = random.below(length)
      let run_ = Run { width: random.below(4), tag: usize.toU64(step) + 1000000 }
      run tree.set(&mut root, at, run_)
      model.set(at, run_)
    } else {
      let at = random.below(length)
      let removed = run tree.remove(&mut root, at)
      let expected = model.remove(at)
      run Testing.expect(removed.tag == expected.tag, "remove returns the item")
    }
    if step % 97 == 0 {
      run sameAs(&tree, root, &model)
    }
    step = step + 1
  }
  run sameAs(&tree, root, &model)
  run tree.release(root)
  run Testing.expect(tree.liveNodes() == 0, "releasing the last root frees every node")
}

effect fn seekSkipsZeroWidth() -> ()
  ! Failures
  ? &mut Allocator {
  let mut tree = Tree<Run, Total>.make(Run { width: 0, tag: 0 })
  let mut root = Root.empty()
  let mut k: usize = 0
  while k < 100 {
    // widths 0, 1, 2, 0, 1, 2, ...
    run tree.insert(&mut root, k, Run { width: k % 3, tag: usize.toU64(k) })
    k = k + 1
  }
  let first = tree.seek(root, width, 0)
  run Testing.expect(first.index == 1 && first.before == 0, "offset 0 skips the zero-width item")
  let second = tree.seek(root, width, 1)
  run Testing.expect(second.index == 2 && second.before == 1, "offset 1 is inside the third item")
  let fourth = tree.seek(root, width, 3)
  run Testing.expect(fourth.index == 4 && fourth.before == 3, "offset 3 skips index 3")
  let end = tree.seek(root, width, 100000)
  run Testing.expect(end.index == 100 && end.before == tree.summary(root).width, "past the end")
  run tree.release(root)
}

effect fn seekKeyFindsTheFirstAtLeast() -> ()
  ! Failures
  ? &mut Allocator {
  let mut tree = Tree<Run, Total>.make(Run { width: 0, tag: 0 })
  let mut root = Root.empty()
  run Testing.expect(tree.seekKey(root, top, 5) == 0, "an empty tree seeks to 0")
  let mut k: usize = 0
  while k < 300 {
    // tags 3, 6, 9, ... in order
    run tree.insert(&mut root, k, Run { width: 1, tag: usize.toU64(3 * k + 3) })
    k = k + 1
  }
  let mut target: u64 = 0
  while target < 905 {
    // The first tag at least `target` is ceil(target / 3) * 3, at index ceil(target / 3) - 1.
    let mut wanted: u64 = 300
    if target == 0 {
      wanted = 0
    } else if target <= 900 {
      wanted = (target + 2) / 3 - 1
    }
    run Testing.expect(
      tree.seekKey(root, top, target) == u64.toUsize(wanted),
      "the first tag at least the target",
    )
    target = target + 1
  }
  run tree.release(root)
}

effect fn buildMatchesInserts() -> ()
  ! Failures
  ? &mut Allocator {
  let mut tree = Tree<Run, Total>.make(Run { width: 0, tag: 0 })
  let sizes: [usize; 6] = [0, 1, 16, 17, 257, 5000]
  let mut s: usize = 0
  while s < 6 {
    let mut items = List<Run>.make()
    let mut k: usize = 0
    while k < sizes[s] {
      run items.append(Run { width: k % 4, tag: usize.toU64(k) })
      k = k + 1
    }
    let mut root = run tree.build(items.asSlice())
    run sameAs(&tree, root, &items)
    run Testing.expect(tree.summary(root).items == sizes[s], "a built tree counts its items")
    if sizes[s] > 0 {
      run tree.insert(&mut root, sizes[s] / 2, Run { width: 1, tag: 77 })
      run items.insertRepeated(sizes[s] / 2, Run { width: 1, tag: 77 }, 1)
      drop run tree.remove(&mut root, 0)
      drop items.remove(0)
      run sameAs(&tree, root, &items)
    }
    run tree.release(root)
    s = s + 1
  }
  run Testing.expect(tree.liveNodes() == 0, "built trees free every node")
}

effect fn versionsAreIndependent() -> ()
  ! Failures
  ? &mut Allocator {
  let mut tree = Tree<Run, Total>.make(Run { width: 0, tag: 0 })
  let mut root = Root.empty()
  let mut model = List<Run>.make()
  let mut k: usize = 0
  while k < 500 {
    let item = Run { width: 1, tag: usize.toU64(k) }
    run tree.insert(&mut root, k, item)
    run model.append(item)
    k = k + 1
  }
  let before = tree.liveNodes()
  let old = tree.retain(root)
  run tree.set(&mut root, 250, Run { width: 5, tag: 99999 })
  let copied = tree.liveNodes() - before
  run Testing.expect(copied > 0 && copied <= 4, "an edit copies only the path to the change")
  run sameAs(&tree, old, &model)
  run Testing.expect(tree.get(root, 250).tag == 99999, "the new root sees the edit")
  run Testing.expect(!root.same(&old), "the roots differ")
  let mut k2: usize = 0
  while k2 < 200 {
    run tree.insert(&mut root, 0, Run { width: 1, tag: 7 })
    k2 = k2 + 1
  }
  run sameAs(&tree, old, &model)
  run tree.release(old)
  run tree.release(root)
  run Testing.expect(tree.liveNodes() == 0, "both versions released frees every node")
}

test effect fn randomEditsTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run randomEdits() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn seekSkipsZeroWidthTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run seekSkipsZeroWidth() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn seekKeyFindsTheFirstAtLeastTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run seekKeyFindsTheFirstAtLeast() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn buildMatchesInsertsTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run buildMatchesInserts() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn versionsAreIndependentTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run versionsAreIndependent() |> Effect.provideMut<Allocator>(&mut allocator)
}
