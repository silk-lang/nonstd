//! A persistent B+ tree of `Copy` items with per-node summaries.
//!
//! A [`Tree`] is an arena of reference-counted nodes. A [`Root`] names one version of a sequence
//! stored in that arena. Editing through a root copies only the nodes on the path to the change
//! that another root still shares; nodes that only this root reaches are edited in place. So
//! keeping an old version costs one [`Tree.retain`], and editing it later never disturbs the
//! other versions.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The most items in a leaf and the most children of an inner node.
pub const FANOUT: usize = 16

/// One slot more than [`FANOUT`], so a node can overflow by one before it splits.
const SLOTS: usize = 17

/// No node: the id of an empty root.
pub const NONE: usize = usize.MAX

/// A value that summarizes a run of items, such as their total length.
///
/// `zero` must be the identity of `add`, and `add` must be associative, so the summary of a node
/// is the same however its items are split between children.
pub interface Summary {
  fn zero() -> Self

  fn add(self: &mut Self, other: &Self) -> ()
}

/// An item that a tree can store: it reports its own summary `S`.
pub interface Item<S> {
  fn summary(self: &Self) -> S
}

struct Node<T, S> {
  refs: u32,
  leaf: bool,
  length: usize,
  count: usize,
  summary: S,
  items: [T; 17],
  children: [usize; 17],
}

impl<T: Copy, S: Copy> Copy for Node<T, S> {}

/// One version of a sequence in a [`Tree`]: the id of its root node, or [`NONE`] when empty.
///
/// A root is plain data. The tree counts references for it only through [`Tree.retain`] and
/// [`Tree.release`], so every root that is kept must be retained once and released once.
pub struct Root {
  pub node: usize,
}

impl Copy for Root {}

impl Root {
  /// The empty sequence.
  pub fn empty() -> Root {
    return Root { node: NONE }
  }

  /// Whether this root names the same nodes as `other`: equal roots are equal sequences.
  pub fn same(self: &Self, other: &Root) -> bool {
    return self.node == other.node
  }
}

/// Where a seek landed: the item index, and how much of the measure lies before that item.
pub struct Position {
  pub index: usize,
  pub before: usize,
}

impl Copy for Position {}

/// An arena of nodes shared by every version of the sequences it stores.
pub struct Tree<T, S> {
  nodes: List<Node<T, S>>,
  free: List<usize>,
  filler: T,
  live: usize,
}

impl<T: Copy + Item<S>, S: Copy + Summary> Tree<T, S> {
  /// An empty arena. `filler` fills unused item slots and is never returned.
  pub fn make(filler: T) -> Tree<T, S> {
    return Tree<T, S> {
      nodes: List<Node<T, S>>.make(),
      free: List<usize>.make(),
      filler: filler,
      live: 0,
    }
  }

  /// The number of nodes in use, for tests and memory accounting.
  pub fn liveNodes(self: &Self) -> usize {
    return self.live
  }

  /// The number of items in `root`.
  pub fn length(self: &Self, root: Root) -> usize {
    if root.node == NONE {
      return 0
    }
    return self.nodes.get(root.node).count
  }

  /// The summary of every item in `root`.
  pub fn summary(self: &Self, root: Root) -> S {
    if root.node == NONE {
      return Summary.zero()
    }
    return self.nodes.get(root.node).summary
  }

  /// Adds a reference to `root` and returns it, so it stays readable after other roots change.
  pub fn retain(self: &mut Self, root: Root) -> Root {
    if root.node != NONE {
      let mut node = self.nodes.get(root.node)
      node.refs = node.refs + 1
      self.nodes.set(root.node, node)
    }
    return root
  }

  /// Drops a reference to `root`, freeing every node that no other root reaches.
  pub effect fn release(self: &mut Self, root: Root) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if root.node != NONE {
      run self.unref(root.node)
    }
  }

  /// The item at `index`. Traps if `index` is not less than the length.
  pub fn get(self: &Self, root: Root, index: usize) -> T {
    if index >= self.length(root) {
      Intrinsic.trap("Tree.get: the index is not less than the length")
    }
    let mut id = root.node
    let mut at = index
    while true {
      let node = self.nodes.get(id)
      if node.leaf {
        return node.items[at]
      }
      let mut k: usize = 0
      while true {
        let child = self.nodes.get(node.children[k])
        if at < child.count {
          break
        }
        at = at - child.count
        k = k + 1
      }
      id = node.children[k]
    }
    return self.filler
  }

  /// The first item whose measure ends past `target`, and the measure of the items before it.
  ///
  /// Items with a zero measure are skipped, so seeking a visible offset steps over tombstones.
  /// When `target` is at or past the total measure, the result is the length and the total.
  pub fn seek(self: &Self, root: Root, measure: fn(&S) -> usize, target: usize) -> Position {
    let mut position = Position { index: 0, before: 0 }
    if root.node == NONE {
      return position
    }
    let mut id = root.node
    let mut left = target
    while true {
      let node = self.nodes.get(id)
      if node.leaf {
        let mut k: usize = 0
        while k < node.length {
          let m = measure(&node.items[k].summary())
          if left < m {
            return position
          }
          left = left - m
          position.before = position.before + m
          position.index = position.index + 1
          k = k + 1
        }
        return position
      }
      let mut k: usize = 0
      let mut descend = NONE
      while k < node.length {
        let child = self.nodes.get(node.children[k])
        let m = measure(&child.summary)
        if left < m {
          descend = node.children[k]
          break
        }
        left = left - m
        position.before = position.before + m
        position.index = position.index + child.count
        k = k + 1
      }
      if descend == NONE {
        return position
      }
      id = descend
    }
    return position
  }

  /// The measure of the first `index` items.
  pub fn measureBefore(self: &Self, root: Root, measure: fn(&S) -> usize, index: usize) -> usize {
    if root.node == NONE {
      return 0
    }
    let mut total: usize = 0
    let mut id = root.node
    let mut at = index
    while true {
      let node = self.nodes.get(id)
      if node.leaf {
        let mut k: usize = 0
        while k < at && k < node.length {
          total = total + measure(&node.items[k].summary())
          k = k + 1
        }
        return total
      }
      let mut k: usize = 0
      let mut descend = NONE
      while k < node.length {
        let child = self.nodes.get(node.children[k])
        if at < child.count {
          descend = node.children[k]
          break
        }
        at = at - child.count
        total = total + measure(&child.summary)
        k = k + 1
      }
      if descend == NONE {
        return total
      }
      id = descend
    }
    return total
  }

  /// Inserts `item` before position `index` of `root`. Traps if `index` is more than the length.
  pub effect fn insert(self: &mut Self, root: &mut Root, index: usize, item: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if index > self.length(root.*) {
      Intrinsic.trap("Tree.insert: the index is more than the length")
    }
    if root.node == NONE {
      let mut node = self.blank(true)
      node.items[0] = item
      node.length = 1
      let fresh = self.refresh(node)
      root.node = run self.store(fresh)
      return ()
    }
    let id = run self.unique(root.node)
    let split = run self.insertInto(id, index, item)
    if split == NONE {
      root.node = id
      return ()
    }
    let mut top = self.blank(false)
    top.children[0] = id
    top.children[1] = split
    top.length = 2
    let fresh = self.refresh(top)
    root.node = run self.store(fresh)
  }

  /// Replaces the item at `index` of `root`. Traps if `index` is not less than the length.
  pub effect fn set(self: &mut Self, root: &mut Root, index: usize, item: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if index >= self.length(root.*) {
      Intrinsic.trap("Tree.set: the index is not less than the length")
    }
    let id = run self.unique(root.node)
    root.node = id
    run self.setIn(id, index, item)
  }

  /// Removes and returns the item at `index` of `root`. Traps if `index` is not less than the
  /// length.
  pub effect fn remove(self: &mut Self, root: &mut Root, index: usize) -> T
    ! OutOfMemoryError
    ? &mut Allocator {
    if index >= self.length(root.*) {
      Intrinsic.trap("Tree.remove: the index is not less than the length")
    }
    let id = run self.unique(root.node)
    let item = run self.removeFrom(id, index)
    let mut top = self.nodes.get(id)
    if top.count == 0 {
      run self.unref(id)
      root.node = NONE
      return item
    }
    let mut current = id
    while !top.leaf && top.length == 1 {
      let only = top.children[0]
      let mut child = self.nodes.get(only)
      child.refs = child.refs + 1
      self.nodes.set(only, child)
      run self.unref(current)
      current = only
      top = child
    }
    root.node = current
    return item
  }

  fn blank(self: &Self, leaf: bool) -> Node<T, S> {
    return Node<T, S> {
      refs: 1,
      leaf: leaf,
      length: 0,
      count: 0,
      summary: Summary.zero(),
      items: [self.filler; 17],
      children: [NONE; 17],
    }
  }

  // Recomputes the count and summary of `node` from its items or children.
  fn refresh(self: &Self, node: Node<T, S>) -> Node<T, S> {
    let mut out = node
    let mut summary = Summary.zero()
    let mut count: usize = 0
    let mut k: usize = 0
    while k < out.length {
      if out.leaf {
        summary.add(&out.items[k].summary())
        count = count + 1
      } else {
        let child = self.nodes.get(out.children[k])
        summary.add(&child.summary)
        count = count + child.count
      }
      k = k + 1
    }
    out.summary = summary
    out.count = count
    return out
  }

  effect fn store(self: &mut Self, node: Node<T, S>) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    self.live = self.live + 1
    match self.free.pop() {
      Option<usize>.Some { value } => {
        let id = value
        self.nodes.set(id, node)
        return id
      }
      Option<usize>.None => {}
    }
    let id = self.nodes.length()
    run self.nodes.append(node)
    return id
  }

  // A node id that only one parent reaches, copying `id` if it is shared.
  effect fn unique(self: &mut Self, id: usize) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut node = self.nodes.get(id)
    if node.refs == 1 {
      return id
    }
    node.refs = node.refs - 1
    self.nodes.set(id, node)
    let mut copy = node
    copy.refs = 1
    if !copy.leaf {
      let mut k: usize = 0
      while k < copy.length {
        let childId = copy.children[k]
        let mut child = self.nodes.get(childId)
        child.refs = child.refs + 1
        self.nodes.set(childId, child)
        k = k + 1
      }
    }
    return run self.store(copy)
  }

  effect fn unref(self: &mut Self, id: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut pending = List<usize>.make()
    run pending.append(id)
    while true {
      match pending.pop() {
        Option<usize>.Some { value } => {
          let next = value
          let mut node = self.nodes.get(next)
          node.refs = node.refs - 1
          self.nodes.set(next, node)
          if node.refs == 0 {
            if !node.leaf {
              let mut k: usize = 0
              while k < node.length {
                run pending.append(node.children[k])
                k = k + 1
              }
            }
            self.live = self.live - 1
            run self.free.append(next)
          }
        }
        Option<usize>.None => {
          break
        }
      }
    }
  }

  // Which child of inner `node` holds item `index`, and the index inside that child. An index
  // equal to the node's count lands at the end of the last child.
  fn childFor(self: &Self, node: &Node<T, S>, index: usize) -> Position {
    let mut at = index
    let mut k: usize = 0
    while k + 1 < node.length {
      let child = self.nodes.get(node.children[k])
      if at < child.count {
        break
      }
      at = at - child.count
      k = k + 1
    }
    return Position { index: k, before: at }
  }

  // Inserts into unique node `id`; returns the id of the new right sibling when it split.
  effect fn insertInto(self: &mut Self, id: usize, index: usize, item: T) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut node = self.nodes.get(id)
    if node.leaf {
      let mut k = node.length
      while k > index {
        node.items[k] = node.items[k - 1]
        k = k - 1
      }
      node.items[index] = item
      node.length = node.length + 1
    } else {
      let place = self.childFor(&node, index)
      let child = run self.unique(node.children[place.index])
      node.children[place.index] = child
      let split = run self.insertInto(child, place.before, item)
      if split != NONE {
        let mut k = node.length
        while k > place.index + 1 {
          node.children[k] = node.children[k - 1]
          k = k - 1
        }
        node.children[place.index + 1] = split
        node.length = node.length + 1
      }
    }
    if node.length <= FANOUT {
      let fresh = self.refresh(node)
      self.nodes.set(id, fresh)
      return NONE
    }
    let half = node.length / 2
    let mut right = self.blank(node.leaf)
    let mut k: usize = half
    while k < node.length {
      right.items[k - half] = node.items[k]
      right.children[k - half] = node.children[k]
      k = k + 1
    }
    right.length = node.length - half
    node.length = half
    let fresh = self.refresh(node)
    self.nodes.set(id, fresh)
    let sibling = self.refresh(right)
    return run self.store(sibling)
  }

  effect fn setIn(self: &mut Self, id: usize, index: usize, item: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut node = self.nodes.get(id)
    if node.leaf {
      node.items[index] = item
    } else {
      let place = self.childFor(&node, index)
      let child = run self.unique(node.children[place.index])
      node.children[place.index] = child
      run self.setIn(child, place.before, item)
    }
    let fresh = self.refresh(node)
    self.nodes.set(id, fresh)
  }

  effect fn removeFrom(self: &mut Self, id: usize, index: usize) -> T
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut node = self.nodes.get(id)
    let mut item = self.filler
    if node.leaf {
      item = node.items[index]
      let mut k = index
      while k + 1 < node.length {
        node.items[k] = node.items[k + 1]
        k = k + 1
      }
      node.length = node.length - 1
    } else {
      let place = self.childFor(&node, index)
      let child = run self.unique(node.children[place.index])
      node.children[place.index] = child
      item = run self.removeFrom(child, place.before)
      if self.nodes.get(child).count == 0 {
        run self.unref(child)
        let mut k = place.index
        while k + 1 < node.length {
          node.children[k] = node.children[k + 1]
          k = k + 1
        }
        node.length = node.length - 1
      }
    }
    let fresh = self.refresh(node)
    self.nodes.set(id, fresh)
    return item
  }
}
