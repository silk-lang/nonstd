//! TCP tests: a request and its response cross a real local socket. The client connects and
//! writes before the server accepts (the kernel queues both), so one thread plays both sides.
import core.codec { DecodeError }
import core.doc { Document }
import sync { Client, MemoryServer }
import tcp { boundPort, connectLocal, listenLocal, readMessage, serveOne, writeMessage }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.io.byte_duplex { ByteIoError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter }
import silk.net.socket_native { Listener, NativeSocketError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.format { Format }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }

type Failures = AssertionError<'static>
  | WriterError
  | NativeSocketError
  | ByteIoError
  | DecodeError
  | OutOfMemoryError

// Listens, writing the error to standard error when it fails so the test log says why.
effect fn listenOrReport() -> Listener
  ! NativeSocketError | WriterError {
  let opened = run Effect.result(listenLocal(0))
  match move opened {
    Result<Listener, NativeSocketError>.Success { value } => {
      return move value
    }
    Result<Listener, NativeSocketError>.Failure { error } => {
      let mut writer = StderrWriter.make()
      run Writer.writeString("listen failed: ") |> Effect.provideMut<Writer>(&mut writer)
      run Format.debug(&error) |> Effect.provideMut<Writer>(&mut writer)
      run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut writer)
      run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
      fail move error
    }
  }
}

effect fn roundTrip() -> ()
  ! Failures
  ? &mut MonotonicClock | &mut Allocator {
  // Port 0 lets the system pick a free one; a fixed port can fall in a range Windows reserves.
  let mut listener = run listenOrReport()
  let port = boundPort(&listener)
  let mut server = MemoryServer.make(100)
  let mut document = run Document.make(1)
  run document.insertText(1, 0, String.utf8Bytes("over the wire"))
  let mut client = Client.make(5)

  let start = run MonotonicClock.now()
  let mut connection = run connectLocal(port, &start)
  let request = run client.request(&mut document)
  run writeMessage(&mut connection, request.asSlice(), &start)
  let served = run serveOne(&mut listener, &mut server)
  run Testing.expect(served, "the server answers")
  let mut response = List<u8>.make()
  let complete = run readMessage(&mut connection, &mut response, &start)
  run Testing.expect(complete, "the response arrives whole")
  run client.receive(&mut document, response.asSlice())
  drop run Effect.result(connection.close())

  // A second replica gets the text through the socket.
  let mut other = run Document.make(2)
  let mut second = Client.make(5)
  let mut again = run connectLocal(port, &start)
  let ask = run second.request(&mut other)
  run writeMessage(&mut again, ask.asSlice(), &start)
  drop run serveOne(&mut listener, &mut server)
  let mut answer = List<u8>.make()
  drop run readMessage(&mut again, &mut answer, &start)
  run second.receive(&mut other, answer.asSlice())
  drop run Effect.result(again.close())
  run Testing.expect(other.textLength(1) == 13, "the text crosses the socket")
  drop run Effect.result(listener.close())
}

test effect fn roundTripTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut clock = OsMonotonicClock.make()
  run roundTrip()
    |> Effect.provideMut<MonotonicClock>(&mut clock)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
