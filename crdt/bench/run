#!/usr/bin/env python3
"""Build crdt-bench in release and time the crdt workloads: `crdt/bench/run [SIZE]`."""
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
REPO = ROOT.parents[1]
sys.path.insert(0, str(REPO / "native/gpu/webgpu/core/scripts"))
from _build import build  # noqa: E402

program = build(ROOT, release=True)
raise SystemExit(subprocess.run([str(program), *sys.argv[1:]]).returncode)
