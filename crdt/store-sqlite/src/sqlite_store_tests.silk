//! SQLite store tests: the store passes the conformance suite in memory and in a file, and a file
//! keeps its deltas across connections.
import core.codec { DecodeError }
import core.doc { Document }
import core.store { conformance, load, save, Store, StoreError }
import sqlite_store { SqliteStore }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }

type Failures = AssertionError<'static> | StoreError | DecodeError | OutOfMemoryError

test effect fn memoryDatabaseConformsTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = run SqliteStore.openMemory() |> Effect.provideMut<Allocator>(&mut allocator)
  run conformance()
    |> Effect.provideMut<Store>(&mut store)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn saveOnce(document: &Document, path: string) -> ()
  ! Failures
  ? &mut Allocator {
  let mut store = run SqliteStore.open(path)
  drop run save(document, 3, 0) |> Effect.provideMut<Store>(&mut store)
}

effect fn reopen(path: string) -> ()
  ! Failures
  ? &mut Allocator {
  let mut document = run Document.make(5)
  run document.insertText(1, 0, String.utf8Bytes("kept on disk"))
  drop run document.commit()
  run saveOnce(&document, path)
  let mut again = run SqliteStore.open(path)
  let loaded = run load(3, 6) |> Effect.provideMut<Store>(&mut again)
  run Testing.expect(loaded.textLength(1) == 12, "a new connection loads the saved text")
  run Testing.expect(loaded.frontier().same(document.frontier()), "and its version")
}

test effect fn fileKeepsDeltasTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  let path = "crdt-store-sqlite-test.db"
  run reopen(path) |> Effect.provideMut<Allocator>(&mut allocator)
}
