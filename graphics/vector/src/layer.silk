//! Layers: masks, clips, group opacity and blend modes (Compositing and Blending Level 1).
//!
//! A group that needs isolation (opacity below 1, a mask, a clip, a filter or a blend mode other
//! than normal) is drawn into its own transparent [`Pixmap`] and then composited onto its parent
//! with [`composite`]. A [`Mask`] is one byte per pixel: clip paths become masks from coverage
//! (several clips intersect by multiplying), and `mask` elements become masks from a rendered
//! pixmap's alpha or luminance.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.simd.f32x4
import silk.simd.simd
import silk.simd.u8x16
import silk.simd.u32x4
import strips { Coverage, BAND, minU32 }
import pixmap { Pixmap, Rgba8, div255, over, overSpan, scalePacked }
import paint { Shader }
import color_space as colorSpace

pub const BLEND_NORMAL: u8 = 0

pub const BLEND_MULTIPLY: u8 = 1

pub const BLEND_SCREEN: u8 = 2

pub const BLEND_OVERLAY: u8 = 3

pub const BLEND_DARKEN: u8 = 4

pub const BLEND_LIGHTEN: u8 = 5

pub const BLEND_COLOR_DODGE: u8 = 6

pub const BLEND_COLOR_BURN: u8 = 7

pub const BLEND_HARD_LIGHT: u8 = 8

pub const BLEND_SOFT_LIGHT: u8 = 9

pub const BLEND_DIFFERENCE: u8 = 10

pub const BLEND_EXCLUSION: u8 = 11

pub const BLEND_HUE: u8 = 12

pub const BLEND_SATURATION: u8 = 13

pub const BLEND_COLOR: u8 = 14

pub const BLEND_LUMINOSITY: u8 = 15

/// One coverage byte per pixel, row major.
pub struct Mask {
  maskWidth: u32,
  maskHeight: u32,
  bytes: List<u8>,
}

impl Mask {
  /// A mask with every pixel set to `value`.
  pub effect fn make(width: u32, height: u32, value: u8) -> Mask
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut bytes = List<u8>.make()
    run bytes.appendRepeated(value, u32.toUsize(width) * u32.toUsize(height))
    return Mask { maskWidth: width, maskHeight: height, bytes: move bytes }
  }

  pub fn width(self: &Self) -> u32 {
    return self.maskWidth
  }

  pub fn height(self: &Self) -> u32 {
    return self.maskHeight
  }

  pub fn data(self: &Self) -> &[u8] {
    return self.bytes.asSlice()
  }

  pub fn at(self: &Self, x: u32, y: u32) -> u8 {
    return self.bytes.asSlice()[u32.toUsize(y) * u32.toUsize(self.maskWidth) + u32.toUsize(x)]
  }

  /// The coverage of a clip path (rasterized with its `clip-rule`).
  pub effect fn fromCoverage(coverage: &Coverage) -> Mask
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut mask = run Mask.make(coverage.width(), coverage.height(), 0)
    let width = u32.toUsize(coverage.width())
    let height = coverage.height()
    let d = mask.bytes.asMutSlice()
    let fills = coverage.fills()
    let mut f: usize = 0
    while f < fills.length {
      let span = fills[f]
      let mut y = span.y
      while y < span.y + BAND && y < height {
        let mut x = span.x
        while x < span.x + span.width {
          d[u32.toUsize(y) * width + u32.toUsize(x)] = 255
          x = x + 1
        }
        y = y + 1
      }
      f = f + 1
    }
    let alphas = coverage.alphas()
    let strips = coverage.strips()
    let mut s: usize = 0
    while s < strips.length {
      let strip = strips[s]
      let mut column: u32 = 0
      while column < strip.width {
        let base = u32.toUsize(strip.alphaOffset + column * BAND)
        let mut row: u32 = 0
        while row < BAND && strip.y + row < height {
          d[u32.toUsize(strip.y + row) * width + u32.toUsize(strip.x + column)] = alphas[base
            + u32.toUsize(row)]
          row = row + 1
        }
        column = column + 1
      }
      s = s + 1
    }
    return move mask
  }

  /// The coverage of a clip path over columns `x0 .. x1` and rows `y0 .. y1` only, as a
  /// `x1 - x0` by `y1 - y0` mask: the same bytes [`Mask.fromCoverage`] has in that box.
  pub effect fn fromCoverageWithin(coverage: &Coverage, x0: u32, y0: u32, x1: u32, y1: u32) -> Mask
    ! OutOfMemoryError
    ? &mut Allocator {
    let right = minU32(x1, coverage.width())
    let bottom = minU32(y1, coverage.height())
    let boxWidth = if x1 > x0 {
      x1 - x0
    } else {
      0
    }
    let boxHeight = if y1 > y0 {
      y1 - y0
    } else {
      0
    }
    let mut mask = run Mask.make(boxWidth, boxHeight, 0)
    if right <= x0 || bottom <= y0 {
      return move mask
    }
    let width = u32.toUsize(boxWidth)
    let d = mask.bytes.asMutSlice()
    let fills = coverage.fills()
    let mut f: usize = 0
    while f < fills.length {
      let span = fills[f]
      if span.y < bottom && span.y + BAND > y0 && span.x < right && span.x + span.width > x0 {
        let first = if span.x > x0 {
          span.x
        } else {
          x0
        }
        let last = minU32(span.x + span.width, right)
        let mut y = if span.y > y0 {
          span.y
        } else {
          y0
        }
        while y < span.y + BAND && y < bottom {
          let row = u32.toUsize(y - y0) * width
          let mut x = first
          while x < last {
            d[row + u32.toUsize(x - x0)] = 255
            x = x + 1
          }
          y = y + 1
        }
      }
      f = f + 1
    }
    let alphas = coverage.alphas()
    let strips = coverage.strips()
    let mut s: usize = 0
    while s < strips.length {
      let strip = strips[s]
      if strip.y < bottom && strip.y + BAND > y0 && strip.x < right && strip.x + strip.width > x0 {
        let mut column: u32 = if strip.x < x0 {
          x0 - strip.x
        } else {
          0
        }
        while column < strip.width && strip.x + column < right {
          let base = u32.toUsize(strip.alphaOffset + column * BAND)
          let mut row: u32 = 0
          while row < BAND && strip.y + row < bottom {
            if strip.y + row >= y0 {
              d[u32.toUsize(strip.y + row - y0) * width + u32.toUsize(strip.x + column - x0)] = alphas[
                base + u32.toUsize(row)
              ]
            }
            row = row + 1
          }
          column = column + 1
        }
      }
      s = s + 1
    }
    return move mask
  }

  /// `mask-type: alpha`: the rendered mask content's alpha.
  pub effect fn fromAlpha(content: &Pixmap) -> Mask
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut mask = run Mask.make(content.width(), content.height(), 0)
    let source = content.data()
    let d = mask.bytes.asMutSlice()
    let mut i: usize = 0
    while i < d.length {
      d[i] = source[i * 4 + 3]
      i = i + 1
    }
    return move mask
  }

  /// `mask-type: luminance` (the SVG default): the luminance of the premultiplied content with
  /// the CSS Masking coefficients 0.2125, 0.7154, 0.0721, which also folds in its alpha. Content
  /// rendered with `color-interpolation: linearRGB` must be converted by the caller first.
  pub effect fn fromLuminance(content: &Pixmap) -> Mask
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut mask = run Mask.make(content.width(), content.height(), 0)
    let source = content.data()
    let d = mask.bytes.asMutSlice()
    let mut i: usize = 0
    while i < d.length {
      // Fixed point with weights summing to 65536: 13926 + 46884 + 4726.
      let l = 13926 * u8.toU32(source[i * 4]) + 46884 * u8.toU32(source[i * 4 + 1])
        + 4726 * u8.toU32(source[i * 4 + 2])
      d[i] = u32.toU8(u32.shiftRight(l + 32768, 16))
      i = i + 1
    }
    return move mask
  }

  /// Multiplies this mask by `other` (clip intersection, or a mask on a clipped group).
  pub fn intersect(self: &mut Self, other: &Mask) -> () {
    let width = minU32(self.maskWidth, other.maskWidth)
    let height = minU32(self.maskHeight, other.maskHeight)
    let stride = u32.toUsize(self.maskWidth)
    let otherStride = u32.toUsize(other.maskWidth)
    let o = other.bytes.asSlice()
    let d = self.bytes.asMutSlice()
    let mut y: usize = 0
    while y < u32.toUsize(self.maskHeight) {
      let mut x: usize = 0
      while x < stride {
        let i = y * stride + x
        if y < u32.toUsize(height) && x < u32.toUsize(width) {
          d[i] = u32.toU8(div255(u8.toU32(d[i]) * u8.toU32(o[y * otherStride + x])))
        } else {
          d[i] = 0
        }
        x = x + 1
      }
      y = y + 1
    }
  }
}

/// Like [`paint.fill`], with the coverage also multiplied by `clip`.
pub fn fillClipped<S: Shader>(
  target: &mut Pixmap,
  coverage: &Coverage,
  shader: &S,
  opacity: u8,
  clip: &Mask,
) -> () {
  if opacity == 0 {
    return
  }
  let width = minU32(minU32(target.width(), coverage.width()), clip.width())
  let height = minU32(minU32(target.height(), coverage.height()), clip.height())
  let stride = u32.toUsize(target.width()) * 4
  let level = u8.toU32(opacity)
  let d = target.dataMut()
  let fills = coverage.fills()
  let mut f: usize = 0
  while f < fills.length {
    let span = fills[f]
    let mut y = span.y
    while y < span.y + BAND && y < height {
      let mut x = span.x
      while x < span.x + span.width && x < width {
        let mask = div255(u8.toU32(clip.at(x, y)) * level)
        if mask != 0 {
          over(
            &mut d,
            u32.toUsize(y) * stride + u32.toUsize(x) * 4,
            scale(shader.shade(x, y), mask),
          )
        }
        x = x + 1
      }
      y = y + 1
    }
    f = f + 1
  }
  let alphas = coverage.alphas()
  let strips = coverage.strips()
  let mut s: usize = 0
  while s < strips.length {
    let strip = strips[s]
    let mut column: u32 = 0
    while column < strip.width && strip.x + column < width {
      let base = u32.toUsize(strip.alphaOffset + column * BAND)
      let mut row: u32 = 0
      while row < BAND && strip.y + row < height {
        let x = strip.x + column
        let y = strip.y + row
        let mask = div255(
          div255(u8.toU32(alphas[base + u32.toUsize(row)]) * level) * u8.toU32(clip.at(x, y)),
        )
        if mask != 0 {
          over(
            &mut d,
            u32.toUsize(y) * stride + u32.toUsize(x) * 4,
            scale(shader.shade(x, y), mask),
          )
        }
        row = row + 1
      }
      column = column + 1
    }
    s = s + 1
  }
}

fn scale(color: Rgba8, mask: u32) -> Rgba8 {
  if mask == 255 {
    return color
  }
  return Rgba8 {
    r: u32.toU8(div255(u8.toU32(color.r) * mask)),
    g: u32.toU8(div255(u8.toU32(color.g) * mask)),
    b: u32.toU8(div255(u8.toU32(color.b) * mask)),
    a: u32.toU8(div255(u8.toU32(color.a) * mask)),
  }
}

/// [`composite`] through `mask` as well (masks and clip paths on the group).
pub fn compositeMasked(
  target: &mut Pixmap,
  layer: &Pixmap,
  mode: u8,
  opacity: u8,
  mask: &Mask,
) -> () {
  let width = minU32(minU32(target.width(), layer.width()), mask.width())
  let height = minU32(minU32(target.height(), layer.height()), mask.height())
  let stride = u32.toUsize(target.width()) * 4
  let layerStride = u32.toUsize(layer.width()) * 4
  let level = u8.toU32(opacity)
  let source = layer.data()
  let d = target.dataMut()
  let mut y: u32 = 0
  while y < height {
    let mut x: u32 = 0
    while x < width {
      let m = div255(u8.toU32(mask.at(x, y)) * level)
      if m != 0 {
        let j = u32.toUsize(y) * layerStride + u32.toUsize(x) * 4
        let s = scale(
          Rgba8 { r: source[j], g: source[j + 1], b: source[j + 2], a: source[j + 3] },
          m,
        )
        blendPixel(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, s, mode)
      }
      x = x + 1
    }
    y = y + 1
  }
}

/// Composites the isolated group `layer` onto `target` with blend `mode` and group `opacity`.
pub fn composite(target: &mut Pixmap, layer: &Pixmap, mode: u8, opacity: u8) -> () {
  let width = target.width()
  let height = target.height()
  compositeWithin(&mut target, layer, mode, opacity, 0, 0, width, height)
}

/// [`composite`] limited to pixels `x0 .. x1` by `y0 .. y1`.
pub fn compositeWithin(
  target: &mut Pixmap,
  layer: &Pixmap,
  mode: u8,
  opacity: u8,
  x0: u32,
  y0: u32,
  x1: u32,
  y1: u32,
) -> () {
  if opacity == 0 {
    return
  }
  let width = minU32(minU32(target.width(), layer.width()), x1)
  let height = minU32(minU32(target.height(), layer.height()), y1)
  let stride = u32.toUsize(target.width()) * 4
  let layerStride = u32.toUsize(layer.width()) * 4
  let level = u8.toU32(opacity)
  let source = layer.data()
  let d = target.dataMut()
  if mode == BLEND_NORMAL {
    compositeNormal(&mut d, source, stride, layerStride, level, x0, y0, width, height)
    return
  }
  let mut y: u32 = y0
  while y < height {
    let mut x: u32 = x0
    while x < width {
      let j = u32.toUsize(y) * layerStride + u32.toUsize(x) * 4
      if source[j + 3] != 0 {
        let s = scale(
          Rgba8 { r: source[j], g: source[j + 1], b: source[j + 2], a: source[j + 3] },
          level,
        )
        blendPixel(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, s, mode)
      }
      x = x + 1
    }
    y = y + 1
  }
}

/// The `BLEND_NORMAL` case of [`compositeWithin`]: each row is packed (scaled by `level`)
/// into spans of [`overSpan`], skipping spans with no visible pixel.
fn compositeNormal(
  d: &mut [u8],
  source: &[u8],
  stride: usize,
  layerStride: usize,
  level: u32,
  x0: u32,
  y0: u32,
  width: u32,
  height: u32,
) -> () {
  let mut colors: [u32; SPAN] = [0; SPAN]
  let none = u32x4.splat(0)
  let opaqueBit = u32x4.splat(0x01000000)
  let lanes = u32x4.splat(0x00ff00ff)
  let scale = u32x4.splat(level)
  let eight = u32x4.splat(8)
  let mut y: u32 = y0
  while y < height {
    let line = u32.toUsize(y) * layerStride
    let row = u32.toUsize(y) * stride
    let mut x: u32 = x0
    while x < width {
      let count = u32.toUsize(minU32(width - x, SPAN_U32))
      let start = line + u32.toUsize(x) * 4
      let mut seen = u32x4.splat(0)
      let mut i: usize = 0
      while i + 4 <= count {
        let words = u8x16.bitcastToU32x4(u8x16.load(source, start + i * 4))
        let mut kept = u32x4.select(u32x4.lanesLess(words, opaqueBit), none, words)
        if level != 255 {
          let rb = div255Lanes4(u32x4.wrappingMultiply(kept & lanes, scale))
          let ag = div255Lanes4(u32x4.wrappingMultiply(u32x4.shiftRight(kept, eight) & lanes, scale))
          kept = rb | u32x4.shiftLeft(ag, eight)
        }
        u32x4.store(&mut colors, i, kept)
        seen = seen | kept
        i = i + 4
      }
      let mut rest: u32 = u32x4.reduceBitOr(seen)
      while i < count {
        let j = start + i * 4
        let a = u8.toU32(source[j + 3])
        let mut word: u32 = 0
        if a != 0 {
          word = u8.toU32(source[j]) | u32.shiftLeft(u8.toU32(source[j + 1]), 8) | u32.shiftLeft(u8.toU32(source[j + 2]), 16) | u32.shiftLeft(a, 24)
          if level != 255 {
            word = scalePacked(word, level)
          }
        }
        colors[i] = word
        rest = rest | word
        i = i + 1
      }
      if rest != 0 {
        overSpan(&mut d, row + u32.toUsize(x) * 4, &colors, count)
      }
      x = x + usize.toU32(count)
    }
    y = y + 1
  }
}

/// `div255Lanes` of `pixmap` on four words at once.
@inlineAlways
fn div255Lanes4(x: simd<u32, 4>) -> simd<u32, 4> {
  let lanes = u32x4.splat(0x00ff00ff)
  let eight = u32x4.splat(8)
  let t = u32x4.wrappingAdd(x, u32x4.splat(0x00800080))
  return u32x4.shiftRight(u32x4.wrappingAdd(t, u32x4.shiftRight(t, eight) & lanes), eight) & lanes
}

const SPAN: usize = 128
const SPAN_U32: u32 = 128

/// Compositing 1 #blending without compositing (FE1 feBlend `no-composite`): each pixel
/// becomes `layer`'s mixed with the target's B(Cb, Cs), keeping `layer`'s alpha.
pub fn mixWithin(
  target: &mut Pixmap,
  layer: &Pixmap,
  mode: u8,
  x0: u32,
  y0: u32,
  x1: u32,
  y1: u32,
) -> () {
  let width = minU32(minU32(target.width(), layer.width()), x1)
  let height = minU32(minU32(target.height(), layer.height()), y1)
  let stride = u32.toUsize(target.width()) * 4
  let layerStride = u32.toUsize(layer.width()) * 4
  let source = layer.data()
  let d = target.dataMut()
  let mut y: u32 = y0
  while y < height {
    let mut x: u32 = x0
    while x < width {
      let j = u32.toUsize(y) * layerStride + u32.toUsize(x) * 4
      let i = u32.toUsize(y) * stride + u32.toUsize(x) * 4
      mixPixel(
        &mut d,
        i,
        Rgba8 { r: source[j], g: source[j + 1], b: source[j + 2], a: source[j + 3] },
        mode,
      )
      x = x + 1
    }
    y = y + 1
  }
}

fn mixPixel(d: &mut [u8], i: usize, s: Rgba8, mode: u8) -> () {
  if mode == BLEND_NORMAL || s.a == 0 {
    d[i] = s.r
    d[i + 1] = s.g
    d[i + 2] = s.b
    d[i + 3] = s.a
    return
  }
  let sa = u8.toF32(s.a) / 255.0
  let ba = u8.toF32(d[i + 3]) / 255.0
  let sr = u8.toF32(s.r) / 255.0
  let sg = u8.toF32(s.g) / 255.0
  let sb = u8.toF32(s.b) / 255.0
  let zero: f32 = 0.0
  let cb = if ba > 0.0 {
    Color3 {
      r: u8.toF32(d[i]) / 255.0 / ba,
      g: u8.toF32(d[i + 1]) / 255.0 / ba,
      b: u8.toF32(d[i + 2]) / 255.0 / ba,
    }
  } else {
    Color3 { r: zero, g: zero, b: zero }
  }
  let result = blendColor(cb, Color3 { r: sr / sa, g: sg / sa, b: sb / sa }, mode)
  let k = sa * ba
  d[i] = toByte(sr * (1.0 - ba) + k * result.r)
  d[i + 1] = toByte(sg * (1.0 - ba) + k * result.g)
  d[i + 2] = toByte(sb * (1.0 - ba) + k * result.b)
  d[i + 3] = s.a
}

/// Blends premultiplied `s` onto the pixel at byte offset `i`:
/// `co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs)`, `ao = as + ab (1 - as)`.
fn blendPixel(d: &mut [u8], i: usize, s: Rgba8, mode: u8) -> () {
  if mode == BLEND_NORMAL {
    over(&mut d, i, s)
    return
  }
  if s.a == 0 {
    return
  }
  if d[i + 3] == 0 {
    // With no backdrop the formula below reduces to the source: toByte(n / 255) is n.
    d[i] = s.r
    d[i + 1] = s.g
    d[i + 2] = s.b
    d[i + 3] = s.a
    return
  }
  if mode < BLEND_HUE {
    blendSeparable(&mut d, i, s, mode)
    return
  }
  let sa = u8.toF32(s.a) / 255.0
  let ba = u8.toF32(d[i + 3]) / 255.0
  let sr = u8.toF32(s.r) / 255.0
  let sg = u8.toF32(s.g) / 255.0
  let sb = u8.toF32(s.b) / 255.0
  let br = u8.toF32(d[i]) / 255.0
  let bg = u8.toF32(d[i + 1]) / 255.0
  let bb = u8.toF32(d[i + 2]) / 255.0

  // Unpremultiplied colors for B.
  let csr = sr / sa
  let csg = sg / sa
  let csb = sb / sa
  let zero: f32 = 0.0
  let cbr = if ba > 0.0 {
    br / ba
  } else {
    zero
  }
  let cbg = if ba > 0.0 {
    bg / ba
  } else {
    zero
  }
  let cbb = if ba > 0.0 {
    bb / ba
  } else {
    zero
  }
  let result = blendColor(
    Color3 { r: cbr, g: cbg, b: cbb },
    Color3 { r: csr, g: csg, b: csb },
    mode,
  )
  let rr = result.r
  let rg = result.g
  let rb = result.b
  let k = sa * ba
  d[i] = toByte(sr * (1.0 - ba) + br * (1.0 - sa) + k * rr)
  d[i + 1] = toByte(sg * (1.0 - ba) + bg * (1.0 - sa) + k * rg)
  d[i + 2] = toByte(sb * (1.0 - ba) + bb * (1.0 - sa) + k * rb)
  d[i + 3] = toByte(sa + ba * (1.0 - sa))
}

// The separable modes on all three channels at once. Every lane runs the scalar formula's
// operations in the same order (selects stand in for its branches), so bytes match exactly.
// The backdrop alpha is non-zero here. Lane 3 is zero in both inputs and stays finite.
fn blendSeparable(d: &mut [u8], i: usize, s: Rgba8, mode: u8) -> () {
  let sa = u8.toF32(s.a) / 255.0
  let ba = u8.toF32(d[i + 3]) / 255.0
  let scale = f32x4.splat(255.0)
  let src = f32x4.fromArray([u8.toF32(s.r), u8.toF32(s.g), u8.toF32(s.b), 0.0]) / scale
  let dst = f32x4.fromArray([u8.toF32(d[i]), u8.toF32(d[i + 1]), u8.toF32(d[i + 2]), 0.0]) / scale
  let cs = src / f32x4.splat(sa)
  let cb = dst / f32x4.splat(ba)
  let zero = f32x4.splat(0.0)
  let one = f32x4.splat(1.0)
  let two = f32x4.splat(2.0)
  let half = f32x4.splat(0.5)
  let mut result = cs
  if mode == BLEND_MULTIPLY {
    result = cb * cs
  } else if mode == BLEND_SCREEN {
    result = cb + cs - cb * cs
  } else if mode == BLEND_OVERLAY {
    result = hardLight4(cs, cb)
  } else if mode == BLEND_DARKEN {
    result = f32x4.select(f32x4.lanesLess(cb, cs), cb, cs)
  } else if mode == BLEND_LIGHTEN {
    result = f32x4.select(f32x4.lanesGreater(cb, cs), cb, cs)
  } else if mode == BLEND_COLOR_DODGE {
    let q = cb / (one - cs)
    let m = f32x4.select(f32x4.lanesLess(one, q), one, q)
    let r = f32x4.select(f32x4.lanesGreaterOrEqual(cs, one), one, m)
    result = f32x4.select(f32x4.lanesEqual(cb, zero), zero, r)
  } else if mode == BLEND_COLOR_BURN {
    let q = (one - cb) / cs
    let m = one - f32x4.select(f32x4.lanesLess(one, q), one, q)
    let r = f32x4.select(f32x4.lanesLessOrEqual(cs, zero), zero, m)
    result = f32x4.select(f32x4.lanesGreaterOrEqual(cb, one), one, r)
  } else if mode == BLEND_HARD_LIGHT {
    result = hardLight4(cb, cs)
  } else if mode == BLEND_SOFT_LIGHT {
    let low = cb - (one - two * cs) * cb * (one - cb)
    let poly = ((f32x4.splat(16.0) * cb - f32x4.splat(12.0)) * cb + f32x4.splat(4.0)) * cb
    let dd = f32x4.select(f32x4.lanesLessOrEqual(cb, f32x4.splat(0.25)), poly, f32x4.sqrt(cb))
    let high = cb + (two * cs - one) * (dd - cb)
    result = f32x4.select(f32x4.lanesLessOrEqual(cs, half), low, high)
  } else if mode == BLEND_DIFFERENCE {
    let bits = f32x4.bitcastToU32x4(cb - cs) & u32x4.splat(0x7fffffff)
    result = u32x4.bitcastToF32x4(bits)
  } else if mode == BLEND_EXCLUSION {
    result = cb + cs - two * cb * cs
  }
  let mixed = src * f32x4.splat(1.0 - ba) + dst * f32x4.splat(1.0 - sa) + f32x4.splat(sa * ba) * result
  let low = f32x4.select(f32x4.lanesGreater(mixed, zero), mixed, zero)
  let clamped = f32x4.select(f32x4.lanesLess(low, one), low, one)
  let bytes = f32x4.toU32x4(clamped * scale + half)
  d[i] = u32.wrappingToU8(u32x4.extract(bytes, 0))
  d[i + 1] = u32.wrappingToU8(u32x4.extract(bytes, 1))
  d[i + 2] = u32.wrappingToU8(u32x4.extract(bytes, 2))
  d[i + 3] = toByte(sa + ba * (1.0 - sa))
}

// hardLight on four lanes: `cb * 2 * cs` when `cs <= 0.5`, else screen with `2 cs - 1`.
@inlineAlways
fn hardLight4(cb: simd<f32, 4>, cs: simd<f32, 4>) -> simd<f32, 4> {
  let two = f32x4.splat(2.0)
  let low = cb * two * cs
  let s = two * cs - f32x4.splat(1.0)
  let high = cb + s - cb * s
  return f32x4.select(f32x4.lanesLessOrEqual(cs, f32x4.splat(0.5)), low, high)
}

// Blend results are finite (a NaN would have trapped in f32.toU8), so plain selects clamp
// as f32.min/max do, and the scaled value is in 0.5 ..= 255.5, where truncation needs no check.
fn toByte(value: f32) -> u8 {
  return u32.wrappingToU8(Intrinsic.f32ToU32(minF(maxF(value, 0.0), 1.0) * 255.0 + 0.5))
}

// LIMITATION-7 (silk-lang/silk#2566): f32.min/max order NaNs and signed zeros with a chain of
// branches. Blend channels are finite, and a zero's sign never reaches an output byte.
@inlineAlways
fn minF(a: f32, b: f32) -> f32 {
  return if a < b {
    a
  } else {
    b
  }
}

@inlineAlways
fn maxF(a: f32, b: f32) -> f32 {
  return if a > b {
    a
  } else {
    b
  }
}

fn separable(cb: f32, cs: f32, mode: u8) -> f32 {
  if mode == BLEND_MULTIPLY {
    return cb * cs
  }
  if mode == BLEND_SCREEN {
    return cb + cs - cb * cs
  }
  if mode == BLEND_OVERLAY {
    return hardLight(cs, cb)
  }
  if mode == BLEND_DARKEN {
    return minF(cb, cs)
  }
  if mode == BLEND_LIGHTEN {
    return maxF(cb, cs)
  }
  if mode == BLEND_COLOR_DODGE {
    if cb == 0.0 {
      return 0.0
    }
    if cs >= 1.0 {
      return 1.0
    }
    return minF(1.0, cb / (1.0 - cs))
  }
  if mode == BLEND_COLOR_BURN {
    if cb >= 1.0 {
      return 1.0
    }
    if cs <= 0.0 {
      return 0.0
    }
    return 1.0 - minF(1.0, (1.0 - cb) / cs)
  }
  if mode == BLEND_HARD_LIGHT {
    return hardLight(cb, cs)
  }
  if mode == BLEND_SOFT_LIGHT {
    if cs <= 0.5 {
      return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb)
    }
    let d = if cb <= 0.25 {
      ((16.0 * cb - 12.0) * cb + 4.0) * cb
    } else {
      f32.sqrt(cb)
    }
    return cb + (2.0 * cs - 1.0) * (d - cb)
  }
  if mode == BLEND_DIFFERENCE {
    return f32.abs(cb - cs)
  }
  if mode == BLEND_EXCLUSION {
    return cb + cs - 2.0 * cb * cs
  }
  return cs
}

fn hardLight(cb: f32, cs: f32) -> f32 {
  if cs <= 0.5 {
    return cb * 2.0 * cs
  }
  let s = 2.0 * cs - 1.0
  return cb + s - cb * s
}

struct Color3 {
  r: f32,
  g: f32,
  b: f32,
}

impl Copy for Color3 {}

fn blendColor(backdrop: Color3, source: Color3, mode: u8) -> Color3 {
  if mode >= BLEND_HUE {
    if mode == BLEND_HUE {
      return setLum(setSat(source, sat(backdrop)), lum(backdrop))
    }
    if mode == BLEND_SATURATION {
      return setLum(setSat(backdrop, sat(source)), lum(backdrop))
    }
    if mode == BLEND_COLOR {
      return setLum(source, lum(backdrop))
    }
    return setLum(backdrop, lum(source))
  }
  return Color3 {
    r: separable(backdrop.r, source.r, mode),
    g: separable(backdrop.g, source.g, mode),
    b: separable(backdrop.b, source.b, mode),
  }
}

fn lum(c: Color3) -> f32 {
  return 0.3 * c.r + 0.59 * c.g + 0.11 * c.b
}

fn clipColor(c: Color3) -> Color3 {
  let l = lum(c)
  let n = minF(c.r, minF(c.g, c.b))
  let x = maxF(c.r, maxF(c.g, c.b))
  let mut r = c.r
  let mut g = c.g
  let mut b = c.b
  if n < 0.0 {
    r = l + (r - l) * l / (l - n)
    g = l + (g - l) * l / (l - n)
    b = l + (b - l) * l / (l - n)
  }
  if x > 1.0 {
    r = l + (r - l) * (1.0 - l) / (x - l)
    g = l + (g - l) * (1.0 - l) / (x - l)
    b = l + (b - l) * (1.0 - l) / (x - l)
  }
  return Color3 { r: r, g: g, b: b }
}

fn setLum(c: Color3, l: f32) -> Color3 {
  let d = l - lum(c)
  return clipColor(Color3 { r: c.r + d, g: c.g + d, b: c.b + d })
}

fn sat(c: Color3) -> f32 {
  return maxF(c.r, maxF(c.g, c.b)) - minF(c.r, minF(c.g, c.b))
}

/// The spec's SetSat: the largest channel becomes `s`, the smallest 0, the middle scales.
fn setSat(c: Color3, s: f32) -> Color3 {
  let mx = maxF(c.r, maxF(c.g, c.b))
  let mn = minF(c.r, minF(c.g, c.b))
  if mx <= mn {
    return Color3 { r: 0.0, g: 0.0, b: 0.0 }
  }
  return Color3 {
    r: (c.r - mn) * s / (mx - mn),
    g: (c.g - mn) * s / (mx - mn),
    b: (c.b - mn) * s / (mx - mn),
  }
}

/// Like `fillClipped`, with source-over arithmetic in linear light. Inputs and output remain
/// premultiplied sRGB RGBA8; clip and opacity use the existing coverage-byte rounding contract.
pub fn fillClippedLinearRgb<S: Shader>(
  target: &mut Pixmap,
  coverage: &Coverage,
  shader: &S,
  opacity: u8,
  clip: &Mask,
) -> () {
  if opacity == 0 {
    return
  }
  let width = minU32(minU32(target.width(), coverage.width()), clip.width())
  let height = minU32(minU32(target.height(), coverage.height()), clip.height())
  let stride = u32.toUsize(target.width()) * 4
  let level = u8.toU32(opacity)
  let uniform = shader.isUniform()
  let solid = if uniform {
    shader.shade(0, 0)
  } else {
    Rgba8.make(0, 0, 0, 0)
  }
  let d = target.dataMut()
  let fills = coverage.fills()
  let mut f: usize = 0
  while f < fills.length {
    let span = fills[f]
    let mut y = span.y
    while y < span.y + BAND && y < height {
      let mut x = span.x
      while x < span.x + span.width && x < width {
        let mask = div255(u8.toU32(clip.at(x, y)) * level)
        if mask != 0 {
          let source = if uniform {
            solid
          } else {
            shader.shade(x, y)
          }
          colorSpace.over(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, source, mask)
        }
        x = x + 1
      }
      y = y + 1
    }
    f = f + 1
  }
  let alphas = coverage.alphas()
  let strips = coverage.strips()
  let mut s: usize = 0
  while s < strips.length {
    let strip = strips[s]
    let mut column: u32 = 0
    while column < strip.width && strip.x + column < width {
      let base = u32.toUsize(strip.alphaOffset + column * BAND)
      let mut row: u32 = 0
      while row < BAND && strip.y + row < height {
        let x = strip.x + column
        let y = strip.y + row
        let mask = div255(
          div255(u8.toU32(alphas[base + u32.toUsize(row)]) * level) * u8.toU32(clip.at(x, y)),
        )
        if mask != 0 {
          let source = if uniform {
            solid
          } else {
            shader.shade(x, y)
          }
          colorSpace.over(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, source, mask)
        }
        row = row + 1
      }
      column = column + 1
    }
    s = s + 1
  }
}

/// Like `composite`, but decode straight sRGB channels before blending/compositing and encode
/// back afterwards. No intermediate linear RGBA8 image or per-pixel allocation is used.
pub fn compositeLinearRgb(target: &mut Pixmap, layer: &Pixmap, mode: u8, opacity: u8) -> () {
  let width = target.width()
  let height = target.height()
  compositeWithinLinearRgb(&mut target, layer, mode, opacity, 0, 0, width, height)
}

/// Bounded `compositeLinearRgb`, with the same half-open bounds as `compositeWithin`.
pub fn compositeWithinLinearRgb(
  target: &mut Pixmap,
  layer: &Pixmap,
  mode: u8,
  opacity: u8,
  x0: u32,
  y0: u32,
  x1: u32,
  y1: u32,
) -> () {
  if opacity == 0 {
    return
  }
  let width = minU32(minU32(target.width(), layer.width()), x1)
  let height = minU32(minU32(target.height(), layer.height()), y1)
  let stride = u32.toUsize(target.width()) * 4
  let layerStride = u32.toUsize(layer.width()) * 4
  let level = u8.toU32(opacity)
  let source = layer.data()
  let d = target.dataMut()
  let mut y = y0
  while y < height {
    let mut x = x0
    while x < width {
      let j = u32.toUsize(y) * layerStride + u32.toUsize(x) * 4
      let s = Rgba8 { r: source[j], g: source[j + 1], b: source[j + 2], a: source[j + 3] }
      blendLinearPixel(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, s, mode, level)
      x = x + 1
    }
    y = y + 1
  }
}

/// Masked `compositeLinearRgb`; mask/opacity multiply with the same rounding as `compositeMasked`.
pub fn compositeMaskedLinearRgb(
  target: &mut Pixmap,
  layer: &Pixmap,
  mode: u8,
  opacity: u8,
  mask: &Mask,
) -> () {
  if opacity == 0 {
    return
  }
  let width = minU32(minU32(target.width(), layer.width()), mask.width())
  let height = minU32(minU32(target.height(), layer.height()), mask.height())
  let stride = u32.toUsize(target.width()) * 4
  let layerStride = u32.toUsize(layer.width()) * 4
  let level = u8.toU32(opacity)
  let source = layer.data()
  let d = target.dataMut()
  let mut y: u32 = 0
  while y < height {
    let mut x: u32 = 0
    while x < width {
      let m = div255(u8.toU32(mask.at(x, y)) * level)
      if m != 0 {
        let j = u32.toUsize(y) * layerStride + u32.toUsize(x) * 4
        let s = Rgba8 { r: source[j], g: source[j + 1], b: source[j + 2], a: source[j + 3] }
        blendLinearPixel(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, s, mode, m)
      }
      x = x + 1
    }
    y = y + 1
  }
}

fn blendLinearPixel(d: &mut [u8], i: usize, source: Rgba8, mode: u8, mask: u32) -> () {
  if source.a == 0 || mask == 0 {
    return
  }
  if mode == BLEND_NORMAL {
    colorSpace.over(&mut d, i, source, mask)
    return
  }
  let sa = u8.toF64(source.a) / 255.0 * u32.toF64(mask) / 255.0
  let ba = u8.toF64(d[i + 3]) / 255.0
  let sr = colorSpace.decode(source.r, source.a)
  let sg = colorSpace.decode(source.g, source.a)
  let sb = colorSpace.decode(source.b, source.a)
  let br = colorSpace.decode(d[i], d[i + 3])
  let bg = colorSpace.decode(d[i + 1], d[i + 3])
  let bb = colorSpace.decode(d[i + 2], d[i + 3])

  // Reuse the existing f32 separable and nonseparable blend formulas; channels are never bytes
  // in linear space. Transfer and the surrounding premultiplied arithmetic retain f64 precision.
  let result = blendColor(
    Color3 { r: f64.toF32(br), g: f64.toF32(bg), b: f64.toF32(bb) },
    Color3 { r: f64.toF32(sr), g: f64.toF32(sg), b: f64.toF32(sb) },
    mode,
  )
  let alpha = sa + ba * (1.0 - sa)
  let s = sa * (1.0 - ba)
  let b = ba * (1.0 - sa)
  let k = sa * ba
  d[i] = colorSpace.encode(sr * s + br * b + k * f32.toF64(result.r), alpha)
  d[i + 1] = colorSpace.encode(sg * s + bg * b + k * f32.toF64(result.g), alpha)
  d[i + 2] = colorSpace.encode(sb * s + bb * b + k * f32.toF64(result.b), alpha)
  d[i + 3] = colorSpace.byte(alpha)
}
