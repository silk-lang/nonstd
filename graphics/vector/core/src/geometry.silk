//! The silk.geometry points, rectangles and 2D affine transforms over f64, plus
//! the rasterizer's own length helpers.
import silk.core.ownership { Copy }
import silk.num.f64
import silk.num.u64
import silk.num.i64
import silk.core.option { Option }
import silk.geometry.point { Point2 }
import silk.geometry.affine { Affine2 }
import silk.geometry.rect as rect

/// f64.sin and f64.cos of one angle, bit for bit, from one shared reduction and polynomial
/// pair (f64.sin and f64.cos each compute both and keep one). Mirrors the stdlib's
/// sineOrCosine; keep the two in step until silk-lang/silk#2766 adds f64.sinCos.
pub struct SineCosine {
  pub sine: f64,
  pub cosine: f64,
}

impl Copy for SineCosine {}

pub fn sineCosine(x: f64) -> SineCosine {
  if f64.isNaN(x) || f64.isInfinite(x) {
    let nan = f64.fromBits(9221120237041090560)
    return SineCosine { sine: nan, cosine: nan }
  }
  if x == 0.0 {
    return SineCosine { sine: x, cosine: 1.0 }
  }
  let mut offset = f64.fromBits(0x3FE0000000000000)
  if x < 0.0 {
    offset = f64.fromBits(0xBFE0000000000000)
  }
  let whole = f64.trunc(x * f64.fromBits(0x3FE45F306DC9C883) + offset)
  let parts: [u64; 10] = [
    0x3FF9200000000000, 0x3F3FB40000000000, 0x3E74440000000000, 0x3D868C0000000000,
    0x3C91A60000000000, 0x3BA3180000000000, 0x3AE8A20000000000, 0x3A1C060000000000,
    0x394C1C0000000000, 0x387A240000000000,
  ]
  let mut residual = x
  let mut at: usize = 0
  while at < 10 {
    residual = residual - whole * f64.fromBits(parts[at])
    at = at + 1
  }
  let squared = residual * residual
  let sines: [u64; 6] = [
    0xBFC5555555555549, 0x3F8111111110F8A6, 0xBF2A01A019C161D5, 0x3EC71DE357B1FE7D,
    0xBE5AE5E68A2B9CEB, 0x3DE5D93A5ACFD57C,
  ]
  let cosines: [u64; 6] = [
    0x3FA555555555554C, 0xBF56C16C16C15177, 0x3EFA01A019CB1590, 0xBE927E4F809C52AD,
    0x3E21EE9EBDB4B1C4, 0xBDA8FAE9BE8838D4,
  ]
  let mut sineTail = f64.fromBits(sines[5])
  let mut cosineTail = f64.fromBits(cosines[5])
  let mut term: usize = 5
  while term > 0 {
    term = term - 1
    sineTail = f64.fromBits(sines[term]) + squared * sineTail
    cosineTail = f64.fromBits(cosines[term]) + squared * cosineTail
  }
  let sineValue = residual + residual * squared * sineTail
  let cosineValue = 1.0 - 0.5 * squared + squared * squared * cosineTail
  let mut quadrant: i64 = 0
  if let Option<i64>.Some { value: quotient } = f64.checkedToI64(whole) {
    quadrant = i64.bitAnd(quotient, 3)
  }

  // Sine runs sine, cosine, -sine, -cosine through the quadrants; cosine starts one later.
  let sine = if quadrant == 0 {
    sineValue
  } else if quadrant == 1 {
    cosineValue
  } else if quadrant == 2 {
    -sineValue
  } else {
    -cosineValue
  }
  let cosine = if quadrant == 3 {
    sineValue
  } else if quadrant == 0 {
    cosineValue
  } else if quadrant == 1 {
    -sineValue
  } else {
    -cosineValue
  }
  return SineCosine { sine: sine, cosine: cosine }
}

/// |value| by clearing the sign bit. Unlike f64.abs, a NaN keeps its payload
/// instead of becoming the canonical NaN; callers only test finiteness.
pub fn magnitude(value: f64) -> f64 {
  return f64.fromBits(u64.bitAnd(f64.toBits(value), 9223372036854775807))
}

/// Euclidean length scaled by the larger magnitude, as stroke and flatten use
/// it: the same arithmetic as max(|x|, |y|) * sqrt((x/s)^2 + (y/s)^2), with
/// one select instead of f64.max. A NaN input gives NaN.
pub fn scaledLength(x: f64, y: f64) -> f64 {
  let ax = magnitude(x)
  let ay = magnitude(y)
  let scale = if ax > ay { ax } else { ay }
  if scale == 0.0 && ax == 0.0 && ay == 0.0 {
    return 0.0
  }
  let a = x / scale
  let b = y / scale
  return scale * f64.sqrt(a * a + b * b)
}

/// A position in user or device space.
pub type Point = Point2<f64>

/// Axis-aligned bounds in user or device space.
pub type Rect = rect.Rect<f64>

/// The SVG matrix `[a c e; b d f; 0 0 1]` as `silk.geometry.affine.Affine2`:
/// `x' = xx x + xy y + dx`, `y' = yx x + yy y + dy`. `left * right` applies `right` first.
pub type Affine = Affine2<f64>

/// The rectangle at `(x, y)` with the given width and height.
pub fn rectAt(x: f64, y: f64, width: f64, height: f64) -> Rect {
  return Rect.new(x, y, x + width, y + height)
}
