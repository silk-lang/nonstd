//! Color helpers for the scene.
//!
//! Primitives store colors as `silk.color.rgba.Rgba<f32>`: straight-alpha, gamma-encoded sRGB
//! channels in `0 ..= 1`, ready to copy into an instance buffer. Make them from hex values with
//! [`rgb`] and [`rgba`], or from any `silk.color.color.Color` (Oklch, Display P3, HSL, ...) with
//! [`fromColor`], which maps the color into the sRGB gamut. Gradients interpolate their stops with
//! `silk.color` in any CSS Color 4 interpolation space ([`mix`]).
import silk.color.color { Color, Interpolation }
import silk.color.rgba { Rgba }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import vector.pixmap { Rgba8 }

fn channel(hex: u32, shift: u32) -> f32 {
  return u32.toF32(u32.shiftRight(hex, shift) & 255) / 255.0
}

/// An opaque color from `0xRRGGBB`.
pub fn rgb(hex: u32) -> Rgba<f32> {
  return Rgba<f32>.new(channel(hex, 16), channel(hex, 8), channel(hex, 0), 1.0)
}

/// A color from `0xRRGGBBAA`.
pub fn rgba(hex: u32) -> Rgba<f32> {
  return Rgba<f32>.new(channel(hex, 24), channel(hex, 16), channel(hex, 8), channel(hex, 0))
}

/// Fully transparent black.
pub fn transparent() -> Rgba<f32> {
  return Rgba<f32>.new(0.0, 0.0, 0.0, 0.0)
}

/// Opaque black.
pub fn black() -> Rgba<f32> {
  return Rgba<f32>.new(0.0, 0.0, 0.0, 1.0)
}

/// Opaque white.
pub fn white() -> Rgba<f32> {
  return Rgba<f32>.new(1.0, 1.0, 1.0, 1.0)
}

/// `color` mapped into the sRGB gamut (CSS Color 4 gamut mapping) as scene channels.
pub fn fromColor(color: Color) -> Rgba<f32> {
  let c = color.toRgba()
  return Rgba<f32>.new(f64.toF32(c.r), f64.toF32(c.g), f64.toF32(c.b), f64.toF32(c.a))
}

/// Scene channels as a `silk.color` sRGB color.
pub fn toColor(color: Rgba<f32>) -> Color {
  return Color.srgb(f32.toF64(color.r), f32.toF64(color.g), f32.toF64(color.b), f32.toF64(color.a))
}

/// Whether nothing would be drawn: alpha is zero, negative or NaN.
pub fn isTransparent(color: Rgba<f32>) -> bool {
  return !(color.a > 0.0)
}

/// The color `t` of the way from `from` to `to`, interpolated as CSS Color 4 specifies
/// (premultiplied, in `interpolation.space`), then mapped into the sRGB gamut.
pub fn mix(from: Rgba<f32>, to: Rgba<f32>, t: f32, interpolation: Interpolation) -> Rgba<f32> {
  return fromColor(toColor(from).mix(toColor(to), f32.toF64(t), interpolation))
}

fn clampUnit(value: f32) -> f32 {
  if !(value > 0.0) {
    return 0.0
  }
  if value > 1.0 {
    return 1.0
  }
  return value
}

/// `value` in `0 ..= 1` to the nearest byte; NaN gives 0.
pub fn unitToByte(value: f32) -> u8 {
  return f32.toU8(clampUnit(value) * 255.0 + 0.5)
}

/// Straight-alpha bytes, rounded and clamped.
pub fn toRgba8(color: Rgba<f32>) -> Rgba8 {
  return Rgba8.make(
    unitToByte(color.r),
    unitToByte(color.g),
    unitToByte(color.b),
    unitToByte(color.a),
  )
}

/// Premultiplied-alpha bytes, as `vector` pixmaps store them.
pub fn toPremultipliedRgba8(color: Rgba<f32>) -> Rgba8 {
  return toRgba8(color).premultiply()
}
