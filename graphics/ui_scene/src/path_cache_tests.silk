//! Path cache tests: hits on whole-pixel moves, misses on new subpixel offsets, eviction, and
//! coverage that matches a direct `vector` fill.
import color { Color }
import path_cache { PathCache }
import primitives { Background, ContentMask, PathSprite }
import scene { Scene }
import scene_tests { rect, window }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }
import vector.geometry { Affine }
import vector.geometry_error { GeometryError }
import vector.path { Path }
import vector.strips { Coverage, NONZERO, Rasterizer }
import vector.stroke { Stroke }

fn at(x: f64, y: f64) -> Affine {
  return Affine.new(1.0, 0.0, 0.0, 1.0, x, y)
}

/// The coverage of path sprite `index` of layer 0 at pixel `(x, y)` of the window, 0 outside.
fn coverageAt(scene: &Scene, index: usize, x: i32, y: i32) -> u32 {
  let p = scene.paths(0)[index]
  let lx = x - p.x
  let ly = y - p.y
  if lx < 0 || ly < 0 || lx >= u32.toI32(p.width) || ly >= u32.toI32(p.height) {
    return 0
  }
  let ux = i32.toU32(lx)
  let uy = i32.toU32(ly)
  let band = uy - uy % 4
  let strips = scene.pathStrips()
  let mut s = u32.toUsize(p.stripStart)
  while s < u32.toUsize(p.stripStart + p.stripCount) {
    let strip = strips[s]
    if strip.y == band && ux >= strip.x && ux < strip.x + strip.width {
      return u8.toU32(
        scene.pathAlphas()[u32.toUsize(strip.alphaOffset + (ux - strip.x) * 4 + uy - band)],
      )
    }
    s = s + 1
  }
  let fills = scene.pathFills()
  let mut f = u32.toUsize(p.fillStart)
  while f < u32.toUsize(p.fillStart + p.fillCount) {
    let fill = fills[f]
    if fill.y == band && ux >= fill.x && ux < fill.x + fill.width {
      return 255
    }
    f = f + 1
  }
  return 0
}

effect fn caching() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 10.3)
  let paint = Background.solid(Color.black())
  let mut cache = PathCache.make()
  let mut scene = Scene.make()

  run cache.beginFrame()
  drop run cache.fill(&mut scene, 7, &path, &at(50.25, 40.0), NONZERO, paint, window())
  drop run cache.fill(&mut scene, 7, &path, &at(150.25, 140.0), NONZERO, paint, window())
  drop run cache.fill(&mut scene, 7, &path, &at(50.5, 40.0), NONZERO, paint, window())
  run Testing.expect(
    cache.misses() == 2 && cache.hits() == 1,
    "a whole-pixel move hits, a new subpixel offset misses",
  )
  run Testing.expect(cache.length() == 2, "two placements cached")
  run scene.finish()

  // Placements 100 px apart have the same coverage, 100 px apart.
  let mut same = true
  let mut y: i32 = 25
  while y < 56 {
    let mut x: i32 = 35
    while x < 66 {
      same = same && coverageAt(&scene, 0, x, y) == coverageAt(&scene, 1, x + 100, y + 100)
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(same, "reused coverage lands at the new origin")

  // The cached coverage equals a direct fill at the same transform.
  let mut raster = Rasterizer.make()
  let mut direct = Coverage.make(200, 200)
  run raster.fill(&path, &at(50.25, 40.0), NONZERO, &mut direct)
  let mut equal = true
  let mut yy: u32 = 25
  while yy < 56 {
    let mut xx: u32 = 35
    while xx < 66 {
      equal = equal
        && coverageAt(&scene, 0, u32.toI32(xx), u32.toI32(yy)) == u8.toU32(direct.alphaAt(xx, yy))
      xx = xx + 1
    }
    yy = yy + 1
  }
  run Testing.expect(equal, "path-relative coverage matches vector's own fill")

  // Unused for two frames: evicted on the third.
  run cache.beginFrame()
  run cache.beginFrame()
  run Testing.expect(cache.length() == 2, "kept while unused for up to two frames")
  run cache.beginFrame()
  run Testing.expect(cache.length() == 0, "evicted after two unused frames")

  // Strokes cache on their style.
  scene.clear()
  let mut style = Stroke.make(3.0)
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(50.0, 50.0), paint, window())
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(60.0, 50.0), paint, window())
  style.width = 4.0
  drop run cache.stroke(&mut scene, 9, &path, &style, &at(70.0, 50.0), paint, window())
  run Testing.expect(
    cache.hits() == 2 && cache.misses() == 4,
    "same style hits, a new width misses",
  )
}

test effect fn coverageIsCachedAcrossFrames() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run caching() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn uncached() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 30.0)
  let mut cache = PathCache.make()
  let mut scene = Scene.make()
  run cache.beginFrame()
  let mask = ContentMask.new(rect(40.0, 40.0, 100.0, 100.0))
  let order = run cache.fill(
    &mut scene,
    0,
    &path,
    &at(50.0, 50.0),
    NONZERO,
    Background.solid(Color.black()),
    mask,
  )
  run Testing.expect(order == 1 && cache.length() == 0, "id 0 is drawn but not cached")
  let hidden = run cache.fill(
    &mut scene,
    0,
    &path,
    &at(500.0, 500.0),
    NONZERO,
    Background.solid(Color.black()),
    mask,
  )
  run Testing.expect(hidden == 0, "a path outside its mask adds nothing")
  run scene.finish()
  let p = scene.paths(0)[0]
  run Testing.expect(
    p.x == 40 && p.y == 40 && p.width == 40 && p.height == 40,
    "clipped to the mask",
  )
}

test effect fn uncachedPathsClipToTheirMask() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run uncached() |> Effect.provideMut<Allocator>(&mut allocator)
}
