/// Renders `scene` (finished here) on a 100 x 100 transparent pixmap.
effect fn render(scene: &mut Scene, pixels: &AtlasPixels) -> Pixmap
  ! GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run scene.finish()
  let mut target = run Pixmap.make(100, 100)
  let mut renderer = CpuRenderer.make()
  run renderer.draw(&scene.*, pixels, &mut target)
  return move target
}

fn near(a: u8, b: u32, tolerance: u32) -> bool {
  let x = u8.toU32(a)
  return if x > b {
    x - b <= tolerance
  } else {
    b - x <= tolerance
  }
}

fn is(p: Rgba8, r: u32, g: u32, b: u32, a: u32) -> bool {
  return near(p.r, r, 1) && near(p.g, g, 1) && near(p.b, b, 1) && near(p.a, a, 1)
}

effect fn quads() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut scene = Scene.make()

  // A red square from 10.5 to 30: the left column is half covered.
  drop run scene.quad(
    Quad.fill(rect(10.5, 10.0, 19.5, 20.0), window(), Background.solid(color.rgb(0xff0000))),
  )

  // Clipped by its content mask at y = 60.
  drop run scene.quad(
    Quad.fill(
      rect(40.0, 50.0, 20.0, 20.0),
      ContentMask.new(rect(0.0, 0.0, 100.0, 60.0)),
      Background.solid(color.rgb(0x0000ff)),
    ),
  )

  // Rounded with a 10 px radius.
  let mut rounded = Quad.fill(
    rect(70.0, 10.0, 20.0, 20.0),
    window(),
    Background.solid(color.rgb(0x00ff00)),
  )
  rounded.cornerRadii = Corners<f32>.uniform(10.0)
  drop run scene.quad(rounded)
  let image = run render(&mut scene, &pixels)
  run Testing.expect(is(image.pixel(20, 20), 255, 0, 0, 255), "inside is the fill color")
  run Testing.expect(
    is(image.pixel(10, 20), 128, 0, 0, 128),
    "a half-covered column has half alpha",
  )
  run Testing.expect(
    is(image.pixel(9, 20), 0, 0, 0, 0) && is(image.pixel(30, 20), 0, 0, 0, 0),
    "outside is untouched",
  )
  run Testing.expect(
    is(image.pixel(50, 59), 0, 0, 255, 255) && is(image.pixel(50, 60), 0, 0, 0, 0),
    "content mask clips",
  )
  run Testing.expect(is(image.pixel(70, 10), 0, 0, 0, 0), "a rounded corner pixel is empty")
  run Testing.expect(is(image.pixel(80, 20), 0, 255, 0, 255), "a rounded quad's center is filled")
}

test effect fn quadsFillClipAndRound() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run quads() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn borders() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut scene = Scene.make()
  let mut q = Quad.fill(
    rect(10.0, 10.0, 40.0, 40.0),
    window(),
    Background.solid(color.transparent()),
  )
  q.borderWidths = Insets<f32>.new(2.0, 4.0, 2.0, 4.0)
  q.borderColor = color.black()
  drop run scene.quad(q)
  let mut d = Quad.fill(rect(55.0, 10.0, 40.0, 40.0), window(), Background.solid(color.white()))
  d.borderWidths = Insets<f32>.uniform(4.0)
  d.borderColor = color.black()
  d.borderStyle = BorderStyle.Dashed
  drop run scene.quad(d)
  let image = run render(&mut scene, &pixels)
  run Testing.expect(
    is(image.pixel(30, 10), 0, 0, 0, 255) && is(image.pixel(30, 11), 0, 0, 0, 255),
    "top border is 2 px",
  )
  run Testing.expect(
    is(image.pixel(30, 12), 0, 0, 0, 0),
    "a transparent background leaves the inside empty",
  )
  run Testing.expect(
    is(image.pixel(13, 30), 0, 0, 0, 255) && is(image.pixel(14, 30), 0, 0, 0, 0),
    "left border is 4 px",
  )

  // Dashes: 8 px on, 4 px off along the top center line, from the top-left corner.
  run Testing.expect(is(image.pixel(60, 11), 0, 0, 0, 255), "a dash")
  run Testing.expect(is(image.pixel(65, 11), 255, 255, 255, 255), "a gap shows the background")
  run Testing.expect(is(image.pixel(75, 30), 255, 255, 255, 255), "the background fills the inside")
}

test effect fn bordersSolidAndDashed() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run borders() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn gradients() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut scene = Scene.make()
  drop run scene.quad(
    Quad.fill(
      rect(0.0, 0.0, 100.0, 10.0),
      window(),
      Background.linear(90.0, color.rgb(0x000000), color.rgb(0xffffff)),
    ),
  )
  let oklab = Background.Linear {
    gradient: LinearGradient {
      angle: 180.0,
      from: ColorStop { color: color.rgb(0xff0000), offset: 0.0 },
      to: ColorStop { color: color.rgb(0x0000ff), offset: 1.0 },
      interpolation: Interpolation.new(ColorSpace.Oklab),
    },
  }
  drop run scene.quad(Quad.fill(rect(0.0, 20.0, 10.0, 80.0), window(), oklab))
  let image = run render(&mut scene, &pixels)
  run Testing.expect(
    image.pixel(0, 5).r < 3 && image.pixel(99, 5).r > 252,
    "90deg runs left to right",
  )
  run Testing.expect(near(image.pixel(50, 5).r, 128, 2), "sRGB midpoint")
  run Testing.expect(
    image.pixel(5, 20).r > 250 && image.pixel(5, 99).b > 250,
    "180deg runs top to bottom",
  )

  // Oklab's red-blue midpoint is about (140, 83, 162); sRGB's is (128, 0, 128).
  let mid = image.pixel(5, 60)
  run Testing.expect(
    near(mid.r, 140, 4) && near(mid.g, 83, 6) && near(mid.b, 162, 4),
    "Oklab interpolation",
  )
}

test effect fn linearGradients() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run gradients() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shadows() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut scene = Scene.make()
  drop run scene.shadow(
    Shadow {
      bounds: rect(20.0, 20.0, 30.0, 30.0),
      mask: window(),
      cornerRadii: Corners<f32>.uniform(0.0),
      color: color.black(),
      blurRadius: 8.0,
      offset: Vector2<f32>.new(0.0, 0.0),
      spread: 0.0,
      inset: false,
    },
  )
  drop run scene.shadow(
    Shadow {
      bounds: rect(60.0, 60.0, 30.0, 30.0),
      mask: window(),
      cornerRadii: Corners<f32>.uniform(0.0),
      color: color.black(),
      blurRadius: 4.0,
      offset: Vector2<f32>.new(0.0, 0.0),
      spread: 4.0,
      inset: true,
    },
  )
  let image = run render(&mut scene, &pixels)
  run Testing.expect(image.pixel(35, 35).a > 250, "a drop shadow is solid in the middle")
  let edge = u8.toU32(image.pixel(20, 35).a)
  run Testing.expect(edge > 100 && edge < 155, "about half at the shape's edge")
  run Testing.expect(image.pixel(8, 35).a < 4, "faded out 3 sigma away")
  run Testing.expect(near(image.pixel(30, 35).a, u8.toU32(image.pixel(39, 35).a), 2), "symmetric")
  run Testing.expect(image.pixel(60, 75).a > 200, "an inset shadow is dark at the box edge")
  run Testing.expect(image.pixel(75, 75).a < 4, "and clear in the middle")
  run Testing.expect(image.pixel(59, 75).a == 0, "and nothing outside the box")
}

test effect fn dropAndInsetShadows() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shadows() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sprites() -> ()
  ! AssertionError<'static> | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut atlas = Atlas.make(
    AtlasOptions { textureSize: 64, maxTextureSize: 64, maxTextures: 1, padding: 1 },
  )
  let mono = run atlas.allocate(Kind.Monochrome, 4, 2)
  let poly = run atlas.allocate(Kind.Polychrome, 2, 2)
  let mut pixels = AtlasPixels.make()
  run pixels.sync(&atlas)
  pixels.write(mono, &[0, 64, 128, 255, 255, 255, 255, 255])
  pixels.write(poly, &[255, 0, 0, 255, 0, 128, 0, 128, 0, 0, 0, 0, 10, 20, 30, 255])
  let mut scene = Scene.make()
  drop run scene.glyph(
    GlyphSprite {
      bounds: rect(10.0, 10.0, 4.0, 2.0),
      mask: window(),
      tile: mono,
      color: color.rgb(0x0000ff),
    },
  )
  drop run scene.image(
    ImageSprite {
      bounds: rect(20.0, 10.0, 2.0, 2.0),
      mask: window(),
      tile: poly,
      opacity: 1.0,
      cornerRadii: Corners<f32>.uniform(0.0),
      grayscale: false,
    },
  )
  drop run scene.image(
    ImageSprite {
      bounds: rect(30.0, 10.0, 2.0, 2.0),
      mask: window(),
      tile: poly,
      opacity: 0.5,
      cornerRadii: Corners<f32>.uniform(0.0),
      grayscale: true,
    },
  )
  let image = run render(&mut scene, &pixels)
  run Testing.expect(is(image.pixel(10, 10), 0, 0, 0, 0), "zero coverage draws nothing")
  run Testing.expect(is(image.pixel(12, 10), 0, 0, 128, 128), "coverage tints the glyph color")
  run Testing.expect(is(image.pixel(13, 11), 0, 0, 255, 255), "full coverage")
  run Testing.expect(
    is(image.pixel(20, 10), 255, 0, 0, 255) && is(image.pixel(21, 10), 0, 128, 0, 128),
    "images copy premultiplied texels",
  )
  run Testing.expect(is(image.pixel(21, 11), 10, 20, 30, 255), "at the tile size sampling is exact")
  let gray = image.pixel(30, 10)
  run Testing.expect(
    gray.r == gray.g && gray.g == gray.b && near(gray.a, 128, 1),
    "grayscale at half opacity",
  )
}

test effect fn atlasSprites() -> ()
  ! AssertionError<'static> | AtlasError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sprites() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pathsAndLayers() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut path = Path.make()
  run path.circle(0.0, 0.0, 17.3)
  let transform = Affine.new(1.0, 0.0, 0.0, 1.0, 30.25, 33.5)
  let mut cache = PathCache.make()
  run cache.beginFrame()
  let mut scene = Scene.make()
  drop run cache.fill(
    &mut scene,
    1,
    &path,
    &transform,
    NONZERO,
    Background.solid(color.rgb(0x336699)),
    window(),
  )
  let image = run render(&mut scene, &pixels)

  // The same fill straight through vector.
  let mut expected = run Pixmap.make(100, 100)
  let mut raster = Rasterizer.make()
  let mut coverage = Coverage.make(100, 100)
  run raster.fill(&path, &transform, NONZERO, &mut coverage)
  painting.fill(&mut expected, &coverage, &Solid.make(Rgba8.make(0x33, 0x66, 0x99, 255)), 255)
  let mut same = true
  let mut i: u32 = 0
  while i < 100 * 100 {
    let a = image.pixel(i % 100, i / 100)
    let b = expected.pixel(i % 100, i / 100)
    same = same && a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
    i = i + 1
  }
  run Testing.expect(same, "a path draws byte for byte as vector fills it")

  // Group opacity: two overlapping opaque quads in a layer at 50% composite as one.
  let mut layered = Scene.make()
  drop run layered.pushIsolatedLayer(
    rect(0.0, 0.0, 100.0, 100.0),
    window(),
    Isolation { opacity: 0.5, blend: 0 },
  )
  drop run layered.quad(
    Quad.fill(rect(10.0, 10.0, 20.0, 20.0), window(), Background.solid(color.rgb(0xff0000))),
  )
  drop run layered.quad(
    Quad.fill(rect(20.0, 10.0, 20.0, 20.0), window(), Background.solid(color.rgb(0x0000ff))),
  )
  run layered.popLayer()
  drop run layered.underline(
    Underline {
      bounds: rect(10.0, 50.0, 80.0, 6.0),
      mask: window(),
      color: color.black(),
      thickness: 2.0,
      wavy: true,
    },
  )
  let grouped = run render(&mut layered, &pixels)
  run Testing.expect(
    is(grouped.pixel(25, 20), 0, 0, 128, 128),
    "the top quad wins inside the group",
  )
  run Testing.expect(is(grouped.pixel(15, 20), 128, 0, 0, 128), "the group fades as one")
  let mut wave: u32 = 0
  let mut x: u32 = 10
  while x < 90 {
    let mut y: u32 = 50
    while y < 56 {
      if grouped.pixel(x, y).a > 0 {
        wave = wave + 1
      }
      y = y + 1
    }
    x = x + 1
  }
  run Testing.expect(
    grouped.pixel(10, 49).a == 0 && grouped.pixel(10, 56).a == 0,
    "a wavy underline stays in its bounds",
  )
  run Testing.expect(wave > 160 && wave < 480, "a wavy underline draws a band, not a box")
}

test effect fn pathsLayersAndUnderlines() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pathsAndLayers() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The same filter parameters are consumed by the browser's GPU renderer.
effect fn filteredLayers() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let pixels = AtlasPixels.make()
  let mut scene = Scene.make()
  let mut effects = LayerEffects.none()
  effects.blur = 4.0
  effects.saturation = 0.0
  drop run scene.pushEffectLayer(
    rect(8.0, 8.0, 64.0, 64.0),
    window(),
    Isolation { opacity: 1.0, blend: 0 },
    effects,
  )
  drop run scene.quad(
    Quad.fill(rect(20.0, 20.0, 40.0, 40.0), window(), Background.solid(color.rgb(0xff0000))),
  )
  run scene.popLayer()
  let image = run render(&mut scene, &pixels)
  let center = image.pixel(40, 40)
  run Testing.expect(
    near(center.r, 54, 2) && center.r == center.g && center.g == center.b,
    "layer color matrix follows blur",
  )
  run Testing.expect(
    image.pixel(18, 40).a > 0 && image.pixel(5, 40).a == 0,
    "layer blur extends beyond the source bounds",
  )
  let mut backdrop = Scene.make()
  drop run backdrop.quad(
    Quad.fill(rect(0.0, 0.0, 50.0, 100.0), window(), Background.solid(color.rgb(0xff0000))),
  )
  drop run backdrop.quad(
    Quad.fill(rect(50.0, 0.0, 50.0, 100.0), window(), Background.solid(color.rgb(0x0000ff))),
  )
  effects = LayerEffects.none()
  effects.backdropBlur = 4.0
  effects.clip = rect(25.0, 25.0, 50.0, 50.0)
  effects.radius = 10.0
  drop run backdrop.pushEffectLayer(
    effects.clip,
    window(),
    Isolation { opacity: 1.0, blend: 0 },
    effects,
  )
  run backdrop.popLayer()
  let glass = run render(&mut backdrop, &pixels)
  run Testing.expect(
    glass.pixel(48, 50).r > 80 && glass.pixel(48, 50).b > 40,
    "backdrop filters preceding layers",
  )
  run Testing.expect(
    is(glass.pixel(48, 10), 255, 0, 0, 255),
    "backdrop clip leaves outside pixels intact",
  )
  let mut replay = Scene.make()
  run replay.replay(&backdrop, 0, backdrop.operationCount())
  let copied = run render(&mut replay, &pixels)
  run Testing.expect(
    copied.pixel(48, 50).b == glass.pixel(48, 50).b,
    "scene replay retains filter parameters",
  )
}

test effect fn layersFilterContentAndBackdrop() -> ()
  ! AssertionError<'static> | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run filteredLayers() |> Effect.provideMut<Allocator>(&mut allocator)
}
