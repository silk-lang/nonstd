//! Scroll-linked groups: primitives whose position follows a scroll offset, so a renderer can
//! scroll them without painting again, as a browser compositor scrolls a layer.
//!
//! [`Scene.pushScrollGroup`] opens a group with a [`ScrollLink`]. Its primitives are painted
//! where they sit with every scroll at 0, and drawn moved by the link's offset at the scroll
//! positions the renderer uses: [`Scene.scrolls`] as painted, or newer ones. Each axis of the
//! offset is `clamp(factor * scroll + base, low, high)` of the linked node's scroll, rounded to
//! whole pixels, so moved coverage stays exact:
//!
//! - scrolled content: factor -1 ([`ScrollAxis.content`]);
//! - a scrollbar thumb: factor `travel / range` ([`ScrollAxis.scaled`]);
//! - a sticky box: factor 1 with the base and limits of its sticky range.
//!
//! Groups nest: a group's offset adds to its parent's, and its clip is cut by its parent's.
//! [`Placements.resolve`] works out every group's offset and clip, and its methods move a
//! primitive of a group by them.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.i32
import silk.num.u32
import silk.num.usize
import primitives {
  ContentMask,
  GlyphSprite,
  ImageSprite,
  LayerSprite,
  PathSprite,
  Quad,
  Shadow,
  Underline,
}

/// An offset that leaves everything unbounded.
pub const UNBOUNDED: f32 = 1.0e30

/// The group of primitives outside every scroll group.
pub const ROOT_GROUP: u32 = 0

/// One axis of a [`ScrollLink`]: the offset `clamp(factor * scroll + base, low, high)`.
pub struct ScrollAxis {
  pub factor: f32,
  pub base: f32,
  pub low: f32,
  pub high: f32,
}

impl Copy for ScrollAxis {}

impl ScrollAxis {
  /// No movement on this axis.
  pub fn fixed() -> ScrollAxis {
    return ScrollAxis { factor: 0.0, base: 0.0, low: -UNBOUNDED, high: UNBOUNDED }
  }

  /// Content that moves against the scroll.
  pub fn content() -> ScrollAxis {
    return ScrollAxis { factor: -1.0, base: 0.0, low: -UNBOUNDED, high: UNBOUNDED }
  }

  /// Moves `factor` pixels per pixel of scroll, unbounded.
  pub fn scaled(factor: f32) -> ScrollAxis {
    return ScrollAxis { factor: factor, base: 0.0, low: -UNBOUNDED, high: UNBOUNDED }
  }

  /// This axis for scrolls and offsets `scale` times larger: from CSS to device pixels.
  pub fn inDevice(self: &Self, scale: f32) -> ScrollAxis {
    return ScrollAxis {
      factor: self.factor,
      base: self.base * scale,
      low: self.low * scale,
      high: self.high * scale,
    }
  }

  /// The offset at `scroll`, in whole pixels.
  pub fn at(self: &Self, scroll: f32) -> f32 {
    let raw = self.factor * scroll + self.base
    let bounded = f32.min(f32.max(raw, self.low), self.high)
    return f32.round(bounded)
  }
}

/// How a group follows the scroll of node `node` (an id the painter chooses, the same one its
/// [`ScrollPosition`] carries).
pub struct ScrollLink {
  pub node: u32,
  pub x: ScrollAxis,
  pub y: ScrollAxis,
}

impl Copy for ScrollLink {}

/// Where node `node` is scrolled to and how far it can go, in device pixels.
pub struct ScrollPosition {
  pub node: u32,
  pub x: f32,
  pub y: f32,
  pub minX: f32,
  pub maxX: f32,
  pub minY: f32,
  pub maxY: f32,
}

impl Copy for ScrollPosition {}

impl ScrollPosition {
  /// This position moved by (`dx`, `dy`) and kept in range.
  pub fn movedBy(self: Self, dx: f32, dy: f32) -> ScrollPosition {
    return ScrollPosition {
      node: self.node,
      x: f32.round(f32.min(f32.max(self.x + dx, self.minX), f32.max(self.maxX, self.minX))),
      y: f32.round(f32.min(f32.max(self.y + dy, self.minY), f32.max(self.maxY, self.minY))),
      minX: self.minX,
      maxX: self.maxX,
      minY: self.minY,
      maxY: self.maxY,
    }
  }
}

/// A group as the scene records it.
pub struct ScrollGroup {
  /// The enclosing group, [`ROOT_GROUP`] at the top level.
  pub parent: u32,
  pub link: ScrollLink,
  /// What the group's primitives are cut to, in its parent's space.
  pub clip: Rect<f32>,
  /// Where the group's primitives can draw at any scroll, in its parent's space: what the group
  /// is ordered by against everything around it.
  pub bounds: Rect<f32>,
}

impl Copy for ScrollGroup {}

/// Where a group draws: moved by (`dx`, `dy`) and cut to `clip`, in window pixels.
pub struct Placement {
  pub dx: f32,
  pub dy: f32,
  pub clip: Rect<f32>,
}

impl Copy for Placement {}

fn unbounded() -> Rect<f32> {
  return Rect<f32>.new(-UNBOUNDED, -UNBOUNDED, UNBOUNDED, UNBOUNDED)
}

fn moved(r: Rect<f32>, dx: f32, dy: f32) -> Rect<f32> {
  return Rect<f32>.new(r.xMin + dx, r.yMin + dy, r.xMax + dx, r.yMax + dy)
}

fn cut(a: Rect<f32>, b: Rect<f32>) -> Rect<f32> {
  return Rect<f32>.new(
    f32.max(a.xMin, b.xMin),
    f32.max(a.yMin, b.yMin),
    f32.min(a.xMax, b.xMax),
    f32.min(a.yMax, b.yMax),
  )
}

fn movedMask(mask: ContentMask, p: Placement) -> ContentMask {
  return ContentMask.new(cut(moved(mask.bounds, p.dx, p.dy), p.clip))
}

/// The offset and clip of every group of a scene at some scroll positions.
pub struct Placements {
  list: List<Placement>,
}

impl Placements {
  pub fn make() -> Placements {
    return Placements { list: List<Placement>.make() }
  }

  /// Works out every group of `groups` (parents before children) at the scroll positions of
  /// `painted`, each replaced by the one of `newer` for the same node when there is one.
  pub effect fn resolve(
    self: &mut Self,
    groups: &[ScrollGroup],
    painted: &[ScrollPosition],
    newer: &[ScrollPosition],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.list.clear()
    run self.list.append(Placement { dx: 0.0, dy: 0.0, clip: unbounded() })
    let mut g: usize = 1
    while g < groups.length {
      let group = groups[g]
      let parent = self.list.get(u32.toUsize(group.parent))
      let scroll = positionOf(painted, newer, group.link.node)
      let dx = parent.dx + group.link.x.at(scroll.x)
      let dy = parent.dy + group.link.y.at(scroll.y)
      let clip = cut(parent.clip, moved(group.clip, parent.dx, parent.dy))
      run self.list.append(Placement { dx: dx, dy: dy, clip: clip })
      g = g + 1
    }
  }

  /// Whether every group draws where it was painted, unclipped: nothing to move.
  pub fn still(self: &Self) -> bool {
    return self.list.length() <= 1
  }

  /// The placement of group `group`.
  pub fn get(self: &Self, group: u32) -> Placement {
    if u32.toUsize(group) >= self.list.length() {
      return Placement { dx: 0.0, dy: 0.0, clip: unbounded() }
    }
    return self.list.get(u32.toUsize(group))
  }

  pub fn quad(self: &Self, q: Quad, group: u32) -> Quad {
    if group == ROOT_GROUP {
      return q
    }
    let p = self.get(group)
    let mut out = q
    out.bounds = moved(q.bounds, p.dx, p.dy)
    out.mask = movedMask(q.mask, p)
    return out
  }

  pub fn shadow(self: &Self, s: Shadow, group: u32) -> Shadow {
    if group == ROOT_GROUP {
      return s
    }
    let p = self.get(group)
    let mut out = s
    out.bounds = moved(s.bounds, p.dx, p.dy)
    out.mask = movedMask(s.mask, p)
    return out
  }

  pub fn underline(self: &Self, u: Underline, group: u32) -> Underline {
    if group == ROOT_GROUP {
      return u
    }
    let p = self.get(group)
    let mut out = u
    out.bounds = moved(u.bounds, p.dx, p.dy)
    out.mask = movedMask(u.mask, p)
    return out
  }

  pub fn glyph(self: &Self, g: GlyphSprite, group: u32) -> GlyphSprite {
    if group == ROOT_GROUP {
      return g
    }
    let p = self.get(group)
    let mut out = g
    out.bounds = moved(g.bounds, p.dx, p.dy)
    out.mask = movedMask(g.mask, p)
    return out
  }

  pub fn image(self: &Self, s: ImageSprite, group: u32) -> ImageSprite {
    if group == ROOT_GROUP {
      return s
    }
    let p = self.get(group)
    let mut out = s
    out.bounds = moved(s.bounds, p.dx, p.dy)
    out.clipBounds = moved(s.clipBounds, p.dx, p.dy)
    out.mask = movedMask(s.mask, p)
    return out
  }

  pub fn path(self: &Self, s: PathSprite, group: u32) -> PathSprite {
    if group == ROOT_GROUP {
      return s
    }
    let p = self.get(group)
    let mut out = s
    out.x = s.x + f32.toI32(p.dx)
    out.y = s.y + f32.toI32(p.dy)
    out.paintBounds = moved(s.paintBounds, p.dx, p.dy)
    out.mask = movedMask(s.mask, p)
    return out
  }

  pub fn layer(self: &Self, s: LayerSprite, group: u32) -> LayerSprite {
    if group == ROOT_GROUP {
      return s
    }
    let p = self.get(group)
    let mut out = s
    out.bounds = cut(moved(s.bounds, p.dx, p.dy), p.clip)
    out.effects.clip = moved(s.effects.clip, p.dx, p.dy)
    return out
  }
}

fn positionOf(painted: &[ScrollPosition], newer: &[ScrollPosition], node: u32) -> Vector2<f32> {
  let mut i: usize = 0
  while i < newer.length {
    if newer[i].node == node {
      return Vector2<f32> { x: newer[i].x, y: newer[i].y }
    }
    i = i + 1
  }
  i = 0
  while i < painted.length {
    if painted[i].node == node {
      return Vector2<f32> { x: painted[i].x, y: painted[i].y }
    }
    i = i + 1
  }
  return Vector2<f32> { x: 0.0, y: 0.0 }
}
