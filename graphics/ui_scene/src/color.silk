//! Colors as the UI scene stores them: straight-alpha sRGB channels in `0 ..= 1`.
//!
//! [`Color`] has the same public fields as `silk.color.rgba.Rgba<f32>`, so the scene can switch to
//! the std type once nonstd pins a silk release with `silk.color`; until then this module carries
//! the little color math the scene needs: byte conversion, premultiplication, and the sRGB and
//! Oklab interpolation used by gradients.
import silk.core.equal { Equal }
import silk.core.ownership { Copy }
import silk.num.f32
import silk.num.u32
import vector.pixmap { Rgba8 }

/// A straight-alpha color with gamma-encoded sRGB channels, each nominally in `0 ..= 1`.
pub struct Color {
  pub r: f32,
  pub g: f32,
  pub b: f32,
  pub a: f32,
}

impl Copy for Color {}

impl Equal for Color {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.r == right.r && left.g == right.g && left.b == right.b && left.a == right.a
  }
}

/// The space a gradient interpolates its stops in.
pub union ColorSpace {
  /// Gamma-encoded sRGB channels, as CSS gradients default to.
  Srgb,
  /// Oklab, which keeps perceived lightness even across the ramp.
  Oklab,
}

impl Copy for ColorSpace {}

impl Equal for ColorSpace {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index() == right.index()
  }
}

impl ColorSpace {
  /// `0` for sRGB, `1` for Oklab.
  pub fn index(self: &Self) -> u32 {
    return match &self.* {
      ColorSpace.Srgb => 0
      ColorSpace.Oklab => 1
    }
  }
}

fn clampUnit(value: f32) -> f32 {
  if !(value > 0.0) {
    return 0.0
  }
  if value > 1.0 {
    return 1.0
  }
  return value
}

/// `value` in `0 ..= 1` to the nearest byte; NaN gives 0.
pub fn unitToByte(value: f32) -> u8 {
  return f32.toU8(clampUnit(value) * 255.0 + 0.5)
}

fn channel(hex: u32, shift: u32) -> f32 {
  return u32.toF32(u32.shiftRight(hex, shift) & 255) / 255.0
}

impl Color {
  /// The color with channels `r`, `g`, `b` and alpha `a`.
  pub fn new(r: f32, g: f32, b: f32, a: f32) -> Color {
    return Color { r: r, g: g, b: b, a: a }
  }

  /// An opaque color from `0xRRGGBB`.
  pub fn rgb(hex: u32) -> Color {
    return Color { r: channel(hex, 16), g: channel(hex, 8), b: channel(hex, 0), a: 1.0 }
  }

  /// A color from `0xRRGGBBAA`.
  pub fn rgba(hex: u32) -> Color {
    return Color {
      r: channel(hex, 24),
      g: channel(hex, 16),
      b: channel(hex, 8),
      a: channel(hex, 0),
    }
  }

  /// Fully transparent black.
  pub fn transparent() -> Color {
    return Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }

  /// Opaque black.
  pub fn black() -> Color {
    return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  }

  /// Opaque white.
  pub fn white() -> Color {
    return Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
  }

  /// The same color with alpha `alpha`.
  pub fn withAlpha(self: Self, alpha: f32) -> Color {
    return Color { r: self.r, g: self.g, b: self.b, a: alpha }
  }

  /// The same color with its alpha multiplied by `factor`.
  pub fn fade(self: Self, factor: f32) -> Color {
    return Color { r: self.r, g: self.g, b: self.b, a: self.a * factor }
  }

  /// Whether nothing would be drawn: alpha is zero, negative or NaN.
  pub fn isTransparent(self: &Self) -> bool {
    return !(self.a > 0.0)
  }

  /// Straight-alpha bytes, rounded and clamped.
  pub fn toRgba8(self: Self) -> Rgba8 {
    return Rgba8.make(
      unitToByte(self.r),
      unitToByte(self.g),
      unitToByte(self.b),
      unitToByte(self.a),
    )
  }

  /// Premultiplied-alpha bytes, as `vector` pixmaps store them.
  pub fn toPremultipliedRgba8(self: Self) -> Rgba8 {
    return self.toRgba8().premultiply()
  }

  /// The color `t` of the way from `self` to `other` in `space`, premultiplied while interpolating
  /// as CSS Color 4 asks (so a transparent end does not tint the result), then unpremultiplied.
  pub fn mix(self: Self, other: Color, t: f32, space: ColorSpace) -> Color {
    let a = clampUnit(self.a)
    let b = clampUnit(other.a)
    let alpha = a + (b - a) * t
    if !(alpha > 0.0) {
      return Color.transparent()
    }
    let from = match space {
      ColorSpace.Srgb => [self.r, self.g, self.b]
      ColorSpace.Oklab => srgbToOklab(self.r, self.g, self.b)
    }
    let to = match space {
      ColorSpace.Srgb => [other.r, other.g, other.b]
      ColorSpace.Oklab => srgbToOklab(other.r, other.g, other.b)
    }
    let c0 = (from[0] * a + (to[0] * b - from[0] * a) * t) / alpha
    let c1 = (from[1] * a + (to[1] * b - from[1] * a) * t) / alpha
    let c2 = (from[2] * a + (to[2] * b - from[2] * a) * t) / alpha
    return match space {
      ColorSpace.Srgb => Color { r: c0, g: c1, b: c2, a: alpha }
      ColorSpace.Oklab => {
        let rgb = oklabToSrgb(c0, c1, c2)
        Color { r: rgb[0], g: rgb[1], b: rgb[2], a: alpha }
      }
    }
  }
}

/// sRGB transfer: gamma-encoded `0 ..= 1` to linear light.
pub fn srgbToLinear(value: f32) -> f32 {
  let magnitude = f32.abs(value)
  let linear = if magnitude <= 0.04045 {
    magnitude / 12.92
  } else {
    f32.pow((magnitude + 0.055) / 1.055, 2.4)
  }
  return f32.copysign(linear, value)
}

/// sRGB transfer: linear light to gamma-encoded `0 ..= 1`.
pub fn linearToSrgb(value: f32) -> f32 {
  let magnitude = f32.abs(value)
  let encoded = if magnitude <= 0.0031308 {
    magnitude * 12.92
  } else {
    1.055 * f32.pow(magnitude, 1.0 / 2.4) - 0.055
  }
  return f32.copysign(encoded, value)
}

/// Gamma-encoded sRGB to Oklab `[L, a, b]` (Björn Ottosson's matrices).
pub fn srgbToOklab(r: f32, g: f32, b: f32) -> [f32; 3] {
  let lr = srgbToLinear(r)
  let lg = srgbToLinear(g)
  let lb = srgbToLinear(b)
  let l = f32.cbrt(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb)
  let m = f32.cbrt(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb)
  let s = f32.cbrt(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb)
  return [
    0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
    1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
    0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
  ]
}

/// Oklab `[L, a, b]` to gamma-encoded sRGB, unclamped.
pub fn oklabToSrgb(lightness: f32, a: f32, b: f32) -> [f32; 3] {
  let l1 = lightness + 0.3963377774 * a + 0.2158037573 * b
  let m1 = lightness - 0.1055613458 * a - 0.0638541728 * b
  let s1 = lightness - 0.0894841775 * a - 1.2914855480 * b
  let l = l1 * l1 * l1
  let m = m1 * m1 * m1
  let s = s1 * s1 * s1
  return [
    linearToSrgb(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
    linearToSrgb(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
    linearToSrgb(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s),
  ]
}
