//! Scene tests: draw orders, batch counts on fixture scenes, layers and replay.
import atlas.atlas { AtlasTile, Kind, TextureId, TileId }
import color { Color }
import primitives { Background, ContentMask, GlyphSprite, Isolation, Quad, Shadow, Underline, }
import scene { Batch, PrimitiveKind, Scene }
import silk.core.effect { Effect }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

pub fn rect(x: f32, y: f32, w: f32, h: f32) -> Rect<f32> {
  return Rect<f32>.new(x, y, x + w, y + h)
}

pub fn window() -> ContentMask {
  return ContentMask.new(rect(0.0, 0.0, 1000.0, 1000.0))
}

pub fn quadAt(x: f32, y: f32, w: f32, h: f32, color: Color) -> Quad {
  return Quad.fill(rect(x, y, w, h), window(), Background.solid(color))
}

pub fn shadowUnder(bounds: Rect<f32>) -> Shadow {
  return Shadow {
    bounds: bounds,
    mask: window(),
    cornerRadii: Corners<f32>.uniform(6.0),
    color: Color.rgba(0x00000060),
    blurRadius: 8.0,
    offset: Vector2<f32>.new(0.0, 2.0),
    spread: 0.0,
    inset: false,
  }
}

pub fn tile(texture: u32, x: u32) -> AtlasTile {
  return AtlasTile {
    id: TileId { index: x, generation: 0 },
    texture: TextureId { kind: Kind.Monochrome, index: texture },
    bounds: Rect<u32>.new(x, 0, x + 8, 10),
  }
}

pub fn glyphAt(x: f32, y: f32, texture: u32) -> GlyphSprite {
  return GlyphSprite {
    bounds: rect(x, y, 8.0, 10.0),
    mask: window(),
    tile: tile(texture, 0),
    color: Color.black(),
  }
}

fn kinds(batches: &[Batch]) -> u32 {
  // Kind indices of the batches as decimal digits, first batch most significant.
  let mut digits: u32 = 0
  let mut i: usize = 0
  while i < batches.length {
    digits = digits * 10 + batches[i].kind.index()
    i = i + 1
  }
  return digits
}

/// A list of `count` cards, each a shadow, a quad and a line of glyphs; cards do not overlap.
effect fn cards(scene: &mut Scene, count: u32, texture: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: u32 = 0
  while i < count {
    let y = u32.toF32(i) * 80.0
    let card = rect(10.0, y + 10.0, 300.0, 40.0)
    drop run scene.shadow(shadowUnder(card))
    drop run scene.quad(Quad.fill(card, window(), Background.solid(Color.white())))
    let mut g: u32 = 0
    while g < 12 {
      drop run scene.glyph(glyphAt(20.0 + u32.toF32(g) * 9.0, y + 25.0, texture))
      g = g + 1
    }
    i = i + 1
  }
}

effect fn orderingAndBatches() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut scene = Scene.make()
  let a = run scene.quad(quadAt(0.0, 0.0, 10.0, 10.0, Color.white()))
  let b = run scene.quad(quadAt(20.0, 0.0, 10.0, 10.0, Color.white()))
  let c = run scene.quad(quadAt(40.0, 0.0, 10.0, 10.0, Color.white()))
  run Testing.expect(a == 1 && b == 1 && c == 1, "disjoint quads share an order")
  let s = run scene.shadow(shadowUnder(rect(0.0, 0.0, 50.0, 10.0)))
  run Testing.expect(s == 2, "a shadow over the quads draws after them")
  let hidden = run scene.quad(quadAt(2000.0, 0.0, 10.0, 10.0, Color.white()))
  run Testing.expect(hidden == 0, "a quad outside its content mask is dropped")
  let clear = run scene.quad(quadAt(100.0, 0.0, 10.0, 10.0, Color.transparent()))
  run Testing.expect(clear == 0, "a transparent borderless quad is dropped")
  run scene.finish()
  let batches = scene.batches(0)
  run Testing.expect(batches.length == 2, "one quad batch, then one shadow batch")
  run Testing.expect(kinds(batches) == 10, "quads before shadows, as their orders ask")
  run Testing.expect(batches[0].end - batches[0].start == 3, "the three quads are one run")
  run Testing.expect(scene.quads(0).length == 3 && scene.shadows(0).length == 1, "sorted lists")
}

test effect fn overlapOrdersAndMergesBatches() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run orderingAndBatches() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cardList() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut scene = Scene.make()
  run cards(&mut scene, 12, 0)
  run scene.finish()
  let batches = scene.batches(0)
  run Testing.expect(scene.primitiveCount() == 12 * 14, "every primitive kept")
  run Testing.expect(batches.length == 3, "12 cards draw in 3 batches")
  run Testing.expect(kinds(batches) == 14, "shadows, then quads, then glyphs")
  run Testing.expect(batches[2].end == 144 && batches[2].texture == 0, "one glyph run on texture 0")

  // Glyphs on two textures split their run by texture.
  scene.clear()
  run cards(&mut scene, 4, 0)
  run cards(&mut scene, 4, 1)
  run scene.finish()
  let split = scene.batches(0)
  run Testing.expect(scene.layerCount() == 1, "clear reuses the root layer")

  // The second set of cards lands on the first, so its shadows draw after the first glyphs.
  run Testing.expect(kinds(split) == 14014, "each card set is shadows, quads, glyphs")
  run Testing.expect(split[2].texture == 0 && split[5].texture == 1, "runs follow the textures")
}

test effect fn cardListBatches() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cardList() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn layers() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut scene = Scene.make()
  drop run scene.quad(quadAt(0.0, 0.0, 100.0, 100.0, Color.white()))
  run scene.pushLayer(rect(0.0, 0.0, 100.0, 100.0))
  let first = run scene.quad(quadAt(10.0, 10.0, 50.0, 50.0, Color.black()))
  let second = run scene.quad(quadAt(20.0, 20.0, 50.0, 50.0, Color.black()))
  let line = run scene.underline(
    Underline {
      bounds: rect(10.0, 80.0, 50.0, 2.0),
      mask: window(),
      color: Color.black(),
      thickness: 1.0,
      wavy: false,
    },
  )
  run scene.popLayer()
  run Testing.expect(
    first == 2 && second == 2 && line == 2,
    "a pinned layer gives its contents one order",
  )
  let after = run scene.quad(quadAt(30.0, 30.0, 10.0, 10.0, Color.white()))
  run Testing.expect(after == 3, "the pinned bounds are in the tree")

  let layer = run scene.pushIsolatedLayer(
    rect(200.5, 0.0, 99.0, 50.0),
    window(),
    Isolation { opacity: 0.5, blend: 0 },
  )
  let inside = run scene.quad(quadAt(210.0, 10.0, 20.0, 20.0, Color.black()))
  let overlap = run scene.quad(quadAt(215.0, 10.0, 20.0, 20.0, Color.black()))
  run scene.popLayer()
  run Testing.expect(layer == 1, "the first isolated layer is layer 1")
  run Testing.expect(
    inside == 1 && overlap == 2,
    "an isolated layer orders its contents on its own",
  )
  run scene.finish()
  run Testing.expect(scene.layerCount() == 2, "window plus one isolated layer")
  let sprites = scene.layers(0)
  run Testing.expect(
    sprites.length == 1 && sprites[0].layer == 1,
    "the parent draws the layer once",
  )
  run Testing.expect(
    sprites[0].bounds.xMin == 200.0 && sprites[0].bounds.xMax == 300.0,
    "bounds rounded out",
  )
  run Testing.expect(
    scene.batches(1).length == 1 && scene.quads(1).length == 2,
    "the layer's own batches",
  )
  run Testing.expect(
    kinds(scene.batches(0)) == 16131,
    "window: quad, layer, quads, underline, quad",
  )
}

test effect fn pinnedAndIsolatedLayers() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run layers() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn replaying() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut previous = Scene.make()
  drop run previous.quad(quadAt(0.0, 0.0, 400.0, 1000.0, Color.white()))
  let start = previous.operationCount()
  run cards(&mut previous, 3, 0)
  drop run previous.pushIsolatedLayer(
    rect(0.0, 0.0, 50.0, 50.0),
    window(),
    Isolation { opacity: 0.5, blend: 0 },
  )
  drop run previous.quad(quadAt(0.0, 0.0, 10.0, 10.0, Color.black()))
  run previous.popLayer()
  let end = previous.operationCount()
  run previous.finish()

  let mut next = Scene.make()
  drop run next.quad(quadAt(0.0, 0.0, 400.0, 1000.0, Color.white()))
  run next.replay(&previous, start, end)
  run next.finish()
  run Testing.expect(next.primitiveCount() == previous.primitiveCount(), "the range is copied")
  run Testing.expect(next.layerCount() == 2, "the isolated layer is replayed too")
  let a = previous.batches(0)
  let b = next.batches(0)
  run Testing.expect(a.length == b.length, "same batches")
  let mut same = true
  let mut i: usize = 0
  while i < a.length {
    same = same && a[i].kind.index() == b[i].kind.index() && a[i].start == b[i].start
      && a[i].end == b[i].end
    i = i + 1
  }
  run Testing.expect(same, "same runs")
}

test effect fn replayCopiesARange() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replaying() |> Effect.provideMut<Allocator>(&mut allocator)
}
