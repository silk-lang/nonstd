//! A frame's primitives, ordered by overlap and merged into batches, as GPUI's `Scene`.
//!
//! Painting appends primitives with [`Scene.quad`], [`Scene.shadow`] and the others. Each one gets
//! a draw order from a [`BoundsTree`]: one more than the highest order of anything it overlaps, so
//! disjoint primitives share orders. [`Scene.finish`] sorts every kind by order (sprites also by
//! texture) and merges the kinds back into a list of [`Batch`] runs per layer, so a renderer issues
//! one draw per run instead of one per primitive.
//! Ordering bounds round outward to whole pixels, matching raster coverage: fractional shapes
//! can blend into the same pixel even when their geometric interiors do not overlap.
//!
//! # Layers
//!
//! [`Scene.pushLayer`] pins everything until the matching [`Scene.popLayer`] to one order, as GPUI's
//! `push_layer`: the layer's bounds are ordered once, and its primitives are not inserted in the
//! tree. Inside a pinned layer, primitives of one kind draw in the order they were added, and
//! overlapping primitives of different kinds draw in kind order (shadows, quads, paths, underlines,
//! glyphs, images, layers), so pin only content that does not care.
//!
//! [`Scene.pushIsolatedLayer`] opens an offscreen group instead: its primitives get their own
//! orders and batches (layer `n`, read with [`Scene.batches`]), and the parent gets one
//! [`LayerSprite`] that composites the group with an opacity and a blend mode. Primitives inside
//! keep window coordinates. Layer 0 is the window.
//!
//! # Replay
//!
//! Every paint call is logged as an operation. A view whose output did not change can copy its
//! operations from the previous frame's scene with [`Scene.replay`] instead of painting again:
//! keep two scenes, read [`Scene.operationCount`] before and after a view paints to know its
//! range, and swap the scenes after each frame. Replay copies path coverage too, so a replayed path
//! is not rasterized again. A replayed range must hold as many pops as pushes.
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.i32
import silk.num.u32
import silk.num.usize
import vector.strips { Fill, Strip }
import effects { LayerEffects }
import bounds_tree { BoundsTree }
import scroll { ScrollGroup, ScrollLink, ScrollPosition, ScrollAxis, ROOT_GROUP }
import color
import primitives {
  Background,
  ContentMask,
  GlyphSprite,
  ImageSprite,
  Isolation,
  LayerSprite,
  PathSprite,
  Quad,
  Shadow,
  Underline,
}

const NONE: u32 = 4294967295

/// The primitive kinds, in the order that breaks ties between equal draw orders.
pub union PrimitiveKind {
  Shadow,
  Quad,
  Path,
  Underline,
  Glyph,
  Image,
  /// An isolated layer, composited as one item.
  Layer,
}

impl Copy for PrimitiveKind {}

impl Equal for PrimitiveKind {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index() == right.index()
  }
}

/// The number of primitive kinds.
pub const KIND_COUNT: usize = 7

impl PrimitiveKind {
  /// The kind's position in [`PrimitiveKind`], from 0 for shadows to 6 for layers.
  pub fn index(self: &Self) -> u32 {
    return match &self.* {
      PrimitiveKind.Shadow => 0
      PrimitiveKind.Quad => 1
      PrimitiveKind.Path => 2
      PrimitiveKind.Underline => 3
      PrimitiveKind.Glyph => 4
      PrimitiveKind.Image => 5
      PrimitiveKind.Layer => 6
    }
  }

  /// The kind at `index`; out-of-range indices give layers.
  pub fn fromIndex(index: u32) -> PrimitiveKind {
    return match index {
      0 => PrimitiveKind.Shadow
      1 => PrimitiveKind.Quad
      2 => PrimitiveKind.Path
      3 => PrimitiveKind.Underline
      4 => PrimitiveKind.Glyph
      5 => PrimitiveKind.Image
      _ => PrimitiveKind.Layer
    }
  }
}

/// A run of one kind of primitive that a renderer draws with one call: items `start .. end` of
/// that kind's sorted list in the layer (for example [`Scene.quads`]).
pub struct Batch {
  pub kind: PrimitiveKind,
  pub start: u32,
  pub end: u32,
  /// The atlas texture index (`AtlasTile.texture.index`) every sprite of the run samples, for
  /// glyphs and images; otherwise `0xFFFFFFFF`.
  pub texture: u32,
}

impl Copy for Batch {}

struct SortKey {
  order: u32,
  texture: u32,
  index: u32,
  end: usize,
}

impl Copy for SortKey {}

fn compareKeys(left: &SortKey, right: &SortKey) -> Ordering {
  if left.order != right.order {
    return if left.order < right.order {
      Ordering.Less
    } else {
      Ordering.Greater
    }
  }
  if left.texture != right.texture {
    return if left.texture < right.texture {
      Ordering.Less
    } else {
      Ordering.Greater
    }
  }
  if left.index != right.index {
    return if left.index < right.index {
      Ordering.Less
    } else {
      Ordering.Greater
    }
  }
  return Ordering.Equal
}

impl Order for SortKey {
  compare: SortKey.compareKeys
}

/// One kind's primitives in one layer: as added (for replay) and sorted (for drawing).
struct Items<T> {
  added: List<T>,
  orders: List<u32>,
  textures: List<u32>,
  /// The scroll group of each item.
  groups: List<u32>,
  sorted: List<T>,
  sortedOrders: List<u32>,
  sortedTextures: List<u32>,
  sortedGroups: List<u32>,
  keys: List<SortKey>,
}

impl<T: Copy> Items<T> {
  fn make() -> Items<T> {
    return Items<T> {
      added: List<T>.make(),
      orders: List<u32>.make(),
      textures: List<u32>.make(),
      groups: List<u32>.make(),
      sorted: List<T>.make(),
      sortedOrders: List<u32>.make(),
      sortedTextures: List<u32>.make(),
      sortedGroups: List<u32>.make(),
      keys: List<SortKey>.make(),
    }
  }

  fn clear(self: &mut Self) -> () {
    self.added.clear()
    self.orders.clear()
    self.textures.clear()
    self.groups.clear()
    self.sorted.clear()
    self.sortedOrders.clear()
    self.sortedTextures.clear()
    self.sortedGroups.clear()
  }

  fn length(self: &Self) -> usize {
    return self.added.length()
  }

  effect fn copyFrom(self: &mut Self, other: &Items<T>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.clear()
    run self.added.appendSlice(other.added.asSlice())
    run self.orders.appendSlice(other.orders.asSlice())
    run self.textures.appendSlice(other.textures.asSlice())
    run self.groups.appendSlice(other.groups.asSlice())
    run self.sorted.appendSlice(other.sorted.asSlice())
    run self.sortedOrders.appendSlice(other.sortedOrders.asSlice())
    run self.sortedTextures.appendSlice(other.sortedTextures.asSlice())
    run self.sortedGroups.appendSlice(other.sortedGroups.asSlice())
    self.keys.clear()
    run self.keys.appendSlice(other.keys.asSlice())
  }

  effect fn push(self: &mut Self, item: T, order: u32, texture: u32, group: u32) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.added.reserve(1)
    run self.orders.reserve(1)
    run self.textures.reserve(1)
    run self.groups.reserve(1)
    let index = usize.toU32(self.added.length())
    run self.added.append(item)
    run self.orders.append(order)
    run self.textures.append(texture)
    run self.groups.append(group)
    return index
  }

  /// The highest order of the items from `start` on.
  fn maxOrderFrom(self: &Self, start: usize) -> u32 {
    let mut highest: u32 = 0
    let mut i = start
    while i < self.orders.length() {
      if self.orders.get(i) > highest {
        highest = self.orders.get(i)
      }
      i = i + 1
    }
    return highest
  }

  /// Adds `base` to the order of every item from `start` on.
  fn raiseFrom(self: &mut Self, start: usize, base: u32) -> () {
    let orders = self.orders.asMutSlice()
    let mut i = start
    while i < orders.length {
      orders[i] = orders[i] + base
      i = i + 1
    }
  }

  effect fn sort(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.keys.clear()
    self.sorted.clear()
    self.sortedOrders.clear()
    self.sortedTextures.clear()
    self.sortedGroups.clear()
    let count = self.added.length()
    run self.sorted.reserve(count)
    run self.sortedOrders.reserve(count)
    run self.sortedTextures.reserve(count)
    run self.sortedGroups.reserve(count)
    let mut i: usize = 0
    while i < count {
      let start = i
      let order = self.orders.get(i)
      let texture = self.textures.get(i)
      i = i + 1
      while i < count && self.orders.get(i) == order && self.textures.get(i) == texture {
        i = i + 1
      }

      // Equal-key consecutive items already have the right relative order. Sort the runs
      // by order, texture and first index, then copy them intact: the same final ordering.
      run self.keys.append(
        SortKey { order: order, texture: texture, index: usize.toU32(start), end: i },
      )
    }

    // Pinned editor runs arrive in nondecreasing draw order and use a small
    // atlas texture set. Stable partitioning each order avoids comparison-sorting
    // hundreds of thousands of alternating image/text keys on every camera frame.
    let mut monotonic = true
    let mut maxTexture: u32 = 0
    let mut check: usize = 0
    while check < self.keys.length() {
      let key = self.keys.get(check)
      if check > 0 && key.order < self.keys.get(check - 1).order {
        monotonic = false
      }
      if key.texture > maxTexture {
        maxTexture = key.texture
      }
      check = check + 1
    }
    if monotonic && maxTexture < 8 {
      let mut start: usize = 0
      while start < self.keys.length() {
        let mut end = start + 1
        while end < self.keys.length() && self.keys.get(end).order == self.keys.get(start).order {
          end = end + 1
        }
        let mut texture: u32 = 0
        while texture <= maxTexture {
          let mut at = start
          while at < end {
            let key = self.keys.get(at)
            if key.texture == texture {
              run self.appendSorted(key)
            }
            at = at + 1
          }
          texture = texture + 1
        }
        start = end
      }
      return ()
    }
    run self.keys.sort()
    let mut j: usize = 0
    while j < self.keys.length() {
      let key = self.keys.get(j)
      run self.appendSorted(key)
      j = j + 1
    }
  }

  effect fn appendSorted(self: &mut Self, key: SortKey) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = u32.toUsize(key.index)
    let length = key.end - at
    run self.sorted.appendSlice(Slice.view<T>(self.added.asSlice(), at, length))
    run self.sortedOrders.appendSlice(Slice.view<u32>(self.orders.asSlice(), at, length))
    run self.sortedTextures.appendSlice(Slice.view<u32>(self.textures.asSlice(), at, length))
    run self.sortedGroups.appendSlice(Slice.view<u32>(self.groups.asSlice(), at, length))
  }
}

struct LayerData {
  tree: BoundsTree,
  shadows: Items<Shadow>,
  quads: Items<Quad>,
  paths: Items<PathSprite>,
  underlines: Items<Underline>,
  glyphs: Items<GlyphSprite>,
  images: Items<ImageSprite>,
  layers: Items<LayerSprite>,
  batches: List<Batch>,
}

impl LayerData {
  fn make() -> LayerData {
    return LayerData {
      tree: BoundsTree.make(),
      shadows: Items<Shadow>.make(),
      quads: Items<Quad>.make(),
      paths: Items<PathSprite>.make(),
      underlines: Items<Underline>.make(),
      glyphs: Items<GlyphSprite>.make(),
      images: Items<ImageSprite>.make(),
      layers: Items<LayerSprite>.make(),
      batches: List<Batch>.make(),
    }
  }

  effect fn copyFrom(self: &mut Self, other: &LayerData) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.tree.copyFrom(&other.tree)
    run self.shadows.copyFrom(&other.shadows)
    run self.quads.copyFrom(&other.quads)
    run self.paths.copyFrom(&other.paths)
    run self.underlines.copyFrom(&other.underlines)
    run self.glyphs.copyFrom(&other.glyphs)
    run self.images.copyFrom(&other.images)
    run self.layers.copyFrom(&other.layers)
    self.batches.clear()
    run self.batches.appendSlice(other.batches.asSlice())
  }

  fn clear(self: &mut Self) -> () {
    self.tree.clear()
    self.shadows.clear()
    self.quads.clear()
    self.paths.clear()
    self.underlines.clear()
    self.glyphs.clear()
    self.images.clear()
    self.layers.clear()
    self.batches.clear()
  }

  effect fn sort(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.shadows.sort()
    run self.quads.sort()
    run self.paths.sort()
    run self.underlines.sort()
    run self.glyphs.sort()
    run self.images.sort()
    run self.layers.sort()
  }

  fn sortedOrders(self: &Self, kind: u32) -> &[u32] {
    return match kind {
      0 => self.shadows.sortedOrders.asSlice()
      1 => self.quads.sortedOrders.asSlice()
      2 => self.paths.sortedOrders.asSlice()
      3 => self.underlines.sortedOrders.asSlice()
      4 => self.glyphs.sortedOrders.asSlice()
      5 => self.images.sortedOrders.asSlice()
      _ => self.layers.sortedOrders.asSlice()
    }
  }

  fn sortedGroups(self: &Self, kind: u32) -> &[u32] {
    return match kind {
      0 => self.shadows.sortedGroups.asSlice()
      1 => self.quads.sortedGroups.asSlice()
      2 => self.paths.sortedGroups.asSlice()
      3 => self.underlines.sortedGroups.asSlice()
      4 => self.glyphs.sortedGroups.asSlice()
      5 => self.images.sortedGroups.asSlice()
      _ => self.layers.sortedGroups.asSlice()
    }
  }

  /// How many items of each kind the layer holds, to mark where a group starts.
  fn counts(self: &Self) -> [usize; 7] {
    return [
      self.shadows.length(),
      self.quads.length(),
      self.paths.length(),
      self.underlines.length(),
      self.glyphs.length(),
      self.images.length(),
      self.layers.length(),
    ]
  }

  fn maxOrderFrom(self: &Self, starts: [usize; 7]) -> u32 {
    let mut highest = self.shadows.maxOrderFrom(starts[0])
    highest = maxU32(highest, self.quads.maxOrderFrom(starts[1]))
    highest = maxU32(highest, self.paths.maxOrderFrom(starts[2]))
    highest = maxU32(highest, self.underlines.maxOrderFrom(starts[3]))
    highest = maxU32(highest, self.glyphs.maxOrderFrom(starts[4]))
    highest = maxU32(highest, self.images.maxOrderFrom(starts[5]))
    return maxU32(highest, self.layers.maxOrderFrom(starts[6]))
  }

  fn raiseFrom(self: &mut Self, starts: [usize; 7], base: u32) -> () {
    self.shadows.raiseFrom(starts[0], base)
    self.quads.raiseFrom(starts[1], base)
    self.paths.raiseFrom(starts[2], base)
    self.underlines.raiseFrom(starts[3], base)
    self.glyphs.raiseFrom(starts[4], base)
    self.images.raiseFrom(starts[5], base)
    self.layers.raiseFrom(starts[6], base)
  }

  fn sortedTextures(self: &Self, kind: u32) -> &[u32] {
    return match kind {
      4 => self.glyphs.sortedTextures.asSlice()
      _ => self.images.sortedTextures.asSlice()
    }
  }

  /// GPUI's merge: take the kind whose next item has the lowest order, and extend its run while
  /// its orders do not pass the next order of any other kind (equal orders never overlap).
  effect fn buildBatches(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.batches.clear()
    let mut cursors: [usize; 7] = [0, 0, 0, 0, 0, 0, 0]
    while true {
      let mut pick: u32 = NONE
      let mut lowest: u32 = NONE
      let mut k: u32 = 0
      while k < 7 {
        let orders = self.sortedOrders(k)
        let at = cursors[u32.toUsize(k)]
        if at < orders.length && (pick == NONE || orders[at] < lowest) {
          pick = k
          lowest = orders[at]
        }
        k = k + 1
      }
      if pick == NONE {
        return
      }
      let mut limit: u32 = NONE
      let mut other: u32 = 0
      while other < 7 {
        if other != pick {
          let orders = self.sortedOrders(other)
          let at = cursors[u32.toUsize(other)]
          if at < orders.length && orders[at] < limit {
            limit = orders[at]
          }
        }
        other = other + 1
      }
      let sprite = pick == 4 || pick == 5
      let orders = self.sortedOrders(pick)
      let start = cursors[u32.toUsize(pick)]
      let texture = if sprite {
        self.sortedTextures(pick)[start]
      } else {
        NONE
      }
      let mut end = start
      while end < orders.length && orders[end] <= limit
        && (!sprite || self.sortedTextures(pick)[end] == texture) {
        end = end + 1
      }
      cursors[u32.toUsize(pick)] = end
      run self.batches.append(
        Batch {
          kind: PrimitiveKind.fromIndex(pick),
          start: usize.toU32(start),
          end: usize.toU32(end),
          texture: texture,
        },
      )
    }
  }
}

const OP_PUSH_PINNED: u32 = 7

const OP_PUSH_ISOLATED: u32 = 8

const OP_POP: u32 = 9

const OP_PUSH_GROUP: u32 = 10

const OP_POP_GROUP: u32 = 11

const NO_TREE: u32 = 4294967295

/// One logged paint call, for [`Scene.replay`].
struct Operation {
  kind: u32,
  layer: u32,
  index: u32,
}

impl Copy for Operation {}

struct Push {
  bounds: Rect<f32>,
  mask: ContentMask,
  isolation: Isolation,
  effects: LayerEffects,
}

impl Copy for Push {}

struct Context {
  layer: u32,
  /// The pinned order, or 0 when primitives are ordered by the tree.
  pinned: u32,
  /// The scroll group primitives join.
  group: u32,
  /// The group tree primitives are ordered by (an index of `groupTrees`), or `NO_TREE` for the
  /// layer's own tree.
  tree: u32,
  /// For the context a scroll group opened: how many items of each kind its layer held then.
  starts: [usize; 7],
  opensGroup: bool,
}

impl Copy for Context {}

/// One frame's primitives. Reuse two scenes across frames with [`Scene.clear`].
pub struct Scene {
  layerData: List<LayerData>,
  layersUsed: u32,
  stack: List<Context>,
  operations: List<Operation>,
  pushes: List<Push>,
  strips: List<Strip>,
  fills: List<Fill>,
  alphas: List<u8>,
  /// Every scroll group, [`ROOT_GROUP`] first.
  groups: List<ScrollGroup>,
  /// The order trees of the scroll groups open now, reused across frames.
  groupTrees: List<BoundsTree>,
  treesUsed: u32,
  scrollPositions: List<ScrollPosition>,
}

fn maxU32(a: u32, b: u32) -> u32 {
  if a > b {
    return a
  }
  return b
}

fn rootGroup() -> ScrollGroup {
  let everything = Rect<f32>.new(-1.0e30, -1.0e30, 1.0e30, 1.0e30)
  return ScrollGroup {
    parent: ROOT_GROUP,
    link: ScrollLink { node: 4294967295, x: ScrollAxis.fixed(), y: ScrollAxis.fixed() },
    clip: everything,
    bounds: everything,
  }
}

fn topContext(layer: u32, pinned: u32, group: u32, tree: u32) -> Context {
  return Context {
    layer: layer,
    pinned: pinned,
    group: group,
    tree: tree,
    starts: [0, 0, 0, 0, 0, 0, 0],
    opensGroup: false,
  }
}

fn clipped(bounds: Rect<f32>, mask: ContentMask) -> Rect<f32> {
  return Rect<f32>.new(
    f32.max(bounds.xMin, mask.bounds.xMin),
    f32.max(bounds.yMin, mask.bounds.yMin),
    f32.min(bounds.xMax, mask.bounds.xMax),
    f32.min(bounds.yMax, mask.bounds.yMax),
  )
}

fn isVisible(bounds: Rect<f32>) -> bool {
  return bounds.xMin < bounds.xMax && bounds.yMin < bounds.yMax
}

fn pixelBounds(bounds: Rect<f32>) -> Rect<f32> {
  return Rect<f32>.new(
    f32.floor(bounds.xMin),
    f32.floor(bounds.yMin),
    f32.ceil(bounds.xMax),
    f32.ceil(bounds.yMax),
  )
}

impl Scene {
  pub fn make() -> Scene {
    return Scene {
      layerData: List<LayerData>.make(),
      layersUsed: 0,
      stack: List<Context>.make(),
      operations: List<Operation>.make(),
      pushes: List<Push>.make(),
      strips: List<Strip>.make(),
      fills: List<Fill>.make(),
      alphas: List<u8>.make(),
      groups: List<ScrollGroup>.make(),
      groupTrees: List<BoundsTree>.make(),
      treesUsed: 0,
      scrollPositions: List<ScrollPosition>.make(),
    }
  }

  /// Makes this scene an exact copy of `other`, finished or not, reusing this scene's storage.
  /// Use it to hand a frame to another thread while the original stays for replay.
  pub effect fn copyFrom(self: &mut Self, other: &Scene) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.clear()
    while self.layerData.length() < u32.toUsize(other.layersUsed) {
      run self.layerData.append(LayerData.make())
    }
    let mut i: usize = 0
    while i < u32.toUsize(other.layersUsed) {
      run self.layerData.asMutSlice()[i].copyFrom(&other.layerData.asSlice()[i])
      i = i + 1
    }
    self.layersUsed = other.layersUsed
    run self.stack.appendSlice(other.stack.asSlice())
    run self.operations.appendSlice(other.operations.asSlice())
    run self.pushes.appendSlice(other.pushes.asSlice())
    run self.strips.appendSlice(other.strips.asSlice())
    run self.fills.appendSlice(other.fills.asSlice())
    run self.alphas.appendSlice(other.alphas.asSlice())
    run self.groups.appendSlice(other.groups.asSlice())
    run self.scrollPositions.appendSlice(other.scrollPositions.asSlice())
  }

  /// Empties the scene for the next frame and keeps its storage.
  pub fn clear(self: &mut Self) -> () {
    let data = self.layerData.asMutSlice()
    let mut i: usize = 0
    while i < data.length {
      data[i].clear()
      i = i + 1
    }
    self.layersUsed = 0
    self.stack.clear()
    self.operations.clear()
    self.pushes.clear()
    self.strips.clear()
    self.fills.clear()
    self.alphas.clear()
    self.groups.clear()
    self.treesUsed = 0
    self.scrollPositions.clear()
  }

  effect fn ensureRoot(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.layersUsed == 0 {
      drop run self.newLayer()
    }
    if self.groups.length() == 0 {
      run self.groups.append(rootGroup())
    }
  }

  effect fn newLayer(self: &mut Self) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.layersUsed
    if u32.toUsize(index) == self.layerData.length() {
      run self.layerData.append(LayerData.make())
    }
    self.layersUsed = index + 1
    return index
  }

  fn context(self: &Self) -> Context {
    if self.stack.length() == 0 {
      return topContext(0, 0, ROOT_GROUP, NO_TREE)
    }
    return self.stack.get(self.stack.length() - 1)
  }

  /// The order for a primitive drawing `bounds` under `mask` in the current layer, or 0 when it is
  /// clipped away entirely.
  effect fn place(self: &mut Self, bounds: Rect<f32>, mask: ContentMask) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensureRoot()
    let visible = clipped(bounds, mask)
    if !isVisible(visible) {
      return 0
    }
    let context = self.context()
    if context.pinned != 0 {
      return context.pinned
    }
    if context.tree != NO_TREE {
      return run self.groupTrees.asMutSlice()[u32.toUsize(context.tree)].insert(
        pixelBounds(visible),
      )
    }
    return run self.layerData.asMutSlice()[u32.toUsize(context.layer)].tree.insert(
      pixelBounds(visible),
    )
  }

  /// The scroll group primitives added now join.
  fn group(self: &Self) -> u32 {
    return self.context().group
  }

  effect fn log(self: &mut Self, kind: u32, index: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let layer = self.context().layer
    run self.operations.append(Operation { kind: kind, layer: layer, index: index })
  }

  fn current(self: &mut Self) -> &mut LayerData {
    let layer = self.context().layer
    return &mut self.layerData.asMutSlice()[u32.toUsize(layer)]
  }

  /// Adds a quad and returns its draw order, or 0 when its content mask hides it.
  pub effect fn quad(self: &mut Self, quad: Quad) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let order = run self.place(quad.bounds, quad.mask)
    if order == 0 {
      return 0
    }
    if quad.background.isTransparent() && !quad.hasBorder() {
      return 0
    }
    let group = self.group()
    let index = run self.current().quads.push(quad, order, 0, group)
    run self.log(1, index)
    return order
  }

  /// Adds a shadow and returns its draw order, or 0 when it is hidden.
  pub effect fn shadow(self: &mut Self, shadow: Shadow) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if color.isTransparent(shadow.color) {
      return 0
    }
    let order = run self.place(shadow.paintBounds(), shadow.mask)
    if order == 0 {
      return 0
    }
    let group = self.group()
    let index = run self.current().shadows.push(shadow, order, 0, group)
    run self.log(0, index)
    return order
  }

  /// Adds an underline and returns its draw order, or 0 when it is hidden.
  pub effect fn underline(self: &mut Self, underline: Underline) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if color.isTransparent(underline.color) || !(underline.thickness > 0.0) {
      return 0
    }
    let order = run self.place(underline.bounds, underline.mask)
    if order == 0 {
      return 0
    }
    let group = self.group()
    let index = run self.current().underlines.push(underline, order, 0, group)
    run self.log(3, index)
    return order
  }

  /// Adds a glyph or monochrome icon sprite and returns its draw order, or 0 when it is hidden.
  pub effect fn glyph(self: &mut Self, sprite: GlyphSprite) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if color.isTransparent(sprite.color) {
      return 0
    }
    let order = run self.place(sprite.bounds, sprite.mask)
    if order == 0 {
      return 0
    }
    let group = self.group()
    let index = run self.current().glyphs.push(sprite, order, sprite.tile.texture.index, group)
    run self.log(4, index)
    return order
  }

  /// Adds an image sprite and returns its draw order, or 0 when it is hidden.
  pub effect fn image(self: &mut Self, sprite: ImageSprite) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if !(sprite.opacity > 0.0) {
      return 0
    }
    let order = run self.place(sprite.bounds, sprite.mask)
    if order == 0 {
      return 0
    }
    let group = self.group()
    let index = run self.current().images.push(sprite, order, sprite.tile.texture.index, group)
    run self.log(5, index)
    return order
  }

  /// Adds path coverage already rasterized at pixel origin `(x, y)`: `strips` and `fills` relative
  /// to the origin, and the `alphas` the strips index. Returns the draw order, or 0 when hidden.
  /// `PathCache.fill` and `PathCache.stroke` call this; it is public for coverage made elsewhere.
  pub effect fn pathCoverage(
    self: &mut Self,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    mask: ContentMask,
    paint: Background,
    paintBounds: Rect<f32>,
    strips: &[Strip],
    fills: &[Fill],
    alphas: &[u8],
  ) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    if paint.isTransparent() || (strips.length == 0 && fills.length == 0) {
      return 0
    }
    let fx = i32.toF32(x)
    let fy = i32.toF32(y)
    let bounds = Rect<f32>.new(fx, fy, fx + u32.toF32(width), fy + u32.toF32(height))
    let order = run self.place(bounds, mask)
    if order == 0 {
      return 0
    }
    let stripStart = usize.toU32(self.strips.length())
    let fillStart = usize.toU32(self.fills.length())
    let alphaBase = usize.toU32(self.alphas.length())
    run self.strips.reserve(strips.length)
    run self.fills.reserve(fills.length)
    run self.alphas.appendSlice(alphas)
    let mut i: usize = 0
    while i < strips.length {
      let s = strips[i]
      run self.strips.append(
        Strip { x: s.x, y: s.y, width: s.width, alphaOffset: s.alphaOffset + alphaBase },
      )
      i = i + 1
    }
    run self.fills.appendSlice(fills)
    let sprite = PathSprite {
      x: x,
      y: y,
      width: width,
      height: height,
      mask: mask,
      paint: paint,
      paintBounds: paintBounds,
      stripStart: stripStart,
      stripCount: usize.toU32(strips.length),
      fillStart: fillStart,
      fillCount: usize.toU32(fills.length),
    }
    let group = self.group()
    let index = run self.current().paths.push(sprite, order, 0, group)
    run self.log(2, index)
    return order
  }

  /// Pins every primitive until the matching [`Scene.popLayer`] to one draw order, the order of
  /// `bounds` (or the enclosing pinned layer's order).
  pub effect fn pushLayer(self: &mut Self, bounds: Rect<f32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensureRoot()
    let context = self.context()
    let pinned = if context.pinned != 0 {
      context.pinned
    } else if context.tree != NO_TREE {
      run self.groupTrees.asMutSlice()[u32.toUsize(context.tree)].insert(pixelBounds(bounds))
    } else {
      run self.layerData.asMutSlice()[u32.toUsize(context.layer)].tree.insert(pixelBounds(bounds))
    }
    let index = usize.toU32(self.pushes.length())
    run self.pushes.append(
      Push {
        bounds: bounds,
        mask: ContentMask.new(bounds),
        isolation: Isolation { opacity: 1.0, blend: 0 },
        effects: LayerEffects.none(),
      },
    )
    run self.log(OP_PUSH_PINNED, index)
    run self.stack.append(topContext(context.layer, pinned, context.group, context.tree))
  }

  /// Opens an isolated layer: primitives until the matching [`Scene.popLayer`] are ordered and
  /// batched on their own, rendered offscreen over `bounds` clipped to `mask` (rounded out to whole
  /// pixels), and composited onto the current layer with `isolation`. Returns the new layer's index.
  pub effect fn pushIsolatedLayer(
    self: &mut Self,
    bounds: Rect<f32>,
    mask: ContentMask,
    isolation: Isolation,
  ) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.pushEffectLayer(bounds, mask, isolation, LayerEffects.none())
  }

  /// Opens an isolated layer with device-pixel blur and color filters.
  /// Include three blur standard deviations in `bounds` to keep the visible blur tails.
  /// The backdrop clip in `effects` is independent of these expanded paint bounds.
  pub effect fn pushEffectLayer(
    self: &mut Self,
    bounds: Rect<f32>,
    mask: ContentMask,
    isolation: Isolation,
    effects: LayerEffects,
  ) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensureRoot()
    let pushIndex = usize.toU32(self.pushes.length())
    run self.pushes.append(
      Push { bounds: bounds, mask: mask, isolation: isolation, effects: effects },
    )
    run self.log(OP_PUSH_ISOLATED, pushIndex)
    let visible = clipped(bounds, mask)
    let target = Rect<f32>.new(
      f32.floor(visible.xMin),
      f32.floor(visible.yMin),
      f32.ceil(visible.xMax),
      f32.ceil(visible.yMax),
    )
    let order = run self.place(target, mask)
    let parent = self.context().layer
    let group = self.group()
    let layer = run self.newLayer()
    if order != 0 && isolation.opacity > 0.0 {
      drop run self.layerData.asMutSlice()[u32.toUsize(parent)].layers.push(
        LayerSprite { layer: layer, bounds: target, isolation: isolation, effects: effects },
        order,
        0,
        group,
      )
    }
    run self.stack.append(topContext(layer, 0, group, NO_TREE))
    return layer
  }

  /// Opens a scroll group that follows `link`, inside the current group: primitives until the
  /// matching [`Scene.popScrollGroup`] are painted as with every scroll at 0 and drawn moved by
  /// the link's offset (see the `scroll` module), cut to `clip`. `bounds` holds everywhere they
  /// can draw at any scroll (normally `clip` itself): the group is ordered as one item of those
  /// bounds against what is around it, and its primitives among themselves. Both rectangles are
  /// in the current group's space. Returns the group's index.
  pub effect fn pushScrollGroup(
    self: &mut Self,
    link: ScrollLink,
    clip: Rect<f32>,
    bounds: Rect<f32>,
  ) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensureRoot()
    let context = self.context()
    let index = usize.toU32(self.groups.length())
    run self.groups.append(
      ScrollGroup { parent: context.group, link: link, clip: clip, bounds: bounds },
    )
    run self.log(OP_PUSH_GROUP, index)
    let mut tree = NO_TREE
    if context.pinned == 0 {
      tree = self.treesUsed
      if u32.toUsize(tree) == self.groupTrees.length() {
        run self.groupTrees.append(BoundsTree.make())
      }
      self.groupTrees.asMutSlice()[u32.toUsize(tree)].clear()
      self.treesUsed = tree + 1
    }
    let starts = self.layerData.asSlice()[u32.toUsize(context.layer)].counts()
    run self.stack.append(
      Context {
        layer: context.layer,
        pinned: context.pinned,
        group: index,
        tree: tree,
        starts: starts,
        opensGroup: true,
      },
    )
    return index
  }

  /// Closes the scroll group opened last: orders it as one item of its bounds after what it
  /// overlaps, with its primitives' orders above that. Does nothing unless a group is open last.
  pub effect fn popScrollGroup(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.stack.length() == 0 || !self.context().opensGroup {
      return
    }
    run self.log(OP_POP_GROUP, 0)
    let inner = self.context()
    drop self.stack.pop()
    if inner.tree == NO_TREE {
      return
    }
    self.treesUsed = inner.tree
    let outer = self.context()
    let data = &mut self.layerData.asMutSlice()[u32.toUsize(inner.layer)]
    let highest = data.maxOrderFrom(inner.starts)
    if highest == 0 {
      return
    }
    let group = self.groups.get(u32.toUsize(inner.group))
    let area = pixelBounds(group.bounds)
    let base = if outer.tree != NO_TREE {
      run self.groupTrees.asMutSlice()[u32.toUsize(outer.tree)].maxOverlapping(area)
    } else {
      run data.tree.maxOverlapping(area)
    }
    data.raiseFrom(inner.starts, base)
    if outer.tree != NO_TREE {
      run self.groupTrees.asMutSlice()[u32.toUsize(outer.tree)].insertWithOrder(
        area,
        base + highest,
      )
    } else {
      run data.tree.insertWithOrder(area, base + highest)
    }
  }

  /// Records that node `position.node` is scrolled to `position`, for the scroll groups that
  /// follow it. A later call for the same node replaces it.
  pub effect fn setScroll(self: &mut Self, position: ScrollPosition) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let list = self.scrollPositions.asMutSlice()
    let mut i: usize = 0
    while i < list.length {
      if list[i].node == position.node {
        list[i] = position
        return
      }
      i = i + 1
    }
    run self.scrollPositions.append(position)
  }

  /// The scroll positions recorded with [`Scene.setScroll`].
  pub fn scrolls(self: &Self) -> &[ScrollPosition] {
    return self.scrollPositions.asSlice()
  }

  /// Every scroll group, parents before children, [`ROOT_GROUP`] first (empty for an unused
  /// scene).
  pub fn scrollGroups(self: &Self) -> &[ScrollGroup] {
    return self.groups.asSlice()
  }

  /// The scroll group of every item of `kind` in layer `layer`, parallel to its sorted list.
  pub fn groupsOf(self: &Self, layer: u32, kind: PrimitiveKind) -> &[u32] {
    return self.layerAt(layer).sortedGroups(kind.index())
  }

  /// Closes the layer opened last. Does nothing when no layer is open.
  pub effect fn popLayer(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.stack.length() == 0 {
      return
    }
    run self.log(OP_POP, 0)
    drop self.stack.pop()
  }

  /// The number of operations logged so far: the start or end of a range for [`Scene.replay`].
  pub fn operationCount(self: &Self) -> usize {
    return self.operations.length()
  }

  /// Repeats operations `start .. end` of `previous` (a scene from an earlier frame, not yet
  /// cleared) in this scene: the same primitives and layers, ordered again against what this scene
  /// already holds.
  pub effect fn replay(self: &mut Self, previous: &Scene, start: usize, end: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let last = if end < previous.operations.length() {
      end
    } else {
      previous.operations.length()
    }
    let mut i = start
    while i < last {
      let op = previous.operations.get(i)
      let at = u32.toUsize(op.index)
      let data = &previous.layerData.asSlice()[u32.toUsize(op.layer)]
      if op.kind == 0 {
        drop run self.shadow(data.shadows.added.get(at))
      } else if op.kind == 1 {
        drop run self.quad(data.quads.added.get(at))
      } else if op.kind == 2 {
        let p = data.paths.added.get(at)
        let s0 = u32.toUsize(p.stripStart)
        let f0 = u32.toUsize(p.fillStart)
        let strips = Slice.view<Strip>(previous.strips.asSlice(), s0, u32.toUsize(p.stripCount))
        let fills = Slice.view<Fill>(previous.fills.asSlice(), f0, u32.toUsize(p.fillCount))
        run self.replayPath(p, strips, fills, previous.alphas.asSlice())
      } else if op.kind == 3 {
        drop run self.underline(data.underlines.added.get(at))
      } else if op.kind == 4 {
        drop run self.glyph(data.glyphs.added.get(at))
      } else if op.kind == 5 {
        drop run self.image(data.images.added.get(at))
      } else if op.kind == OP_PUSH_PINNED {
        run self.pushLayer(previous.pushes.get(at).bounds)
      } else if op.kind == OP_PUSH_ISOLATED {
        let push = previous.pushes.get(at)
        drop run self.pushEffectLayer(push.bounds, push.mask, push.isolation, push.effects)
      } else if op.kind == OP_POP {
        run self.popLayer()
      } else if op.kind == OP_PUSH_GROUP {
        let group = previous.groups.get(at)
        drop run self.pushScrollGroup(group.link, group.clip, group.bounds)
      } else if op.kind == OP_POP_GROUP {
        run self.popScrollGroup()
      }
      i = i + 1
    }
  }

  /// Copies one path's strips, whose alphas index `alphas`, as one contiguous alpha run.
  effect fn replayPath(
    self: &mut Self,
    path: PathSprite,
    strips: &[Strip],
    fills: &[Fill],
    alphas: &[u8],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut local = List<Strip>.make()
    let mut localAlphas = List<u8>.make()
    run local.reserve(strips.length)
    let mut i: usize = 0
    while i < strips.length {
      let s = strips[i]
      let from = u32.toUsize(s.alphaOffset)
      let count = u32.toUsize(s.width) * 4
      run local.append(
        Strip { x: s.x, y: s.y, width: s.width, alphaOffset: usize.toU32(localAlphas.length()) },
      )
      run localAlphas.appendSlice(Slice.view<u8>(alphas, from, count))
      i = i + 1
    }
    drop run self.pathCoverage(
      path.x,
      path.y,
      path.width,
      path.height,
      path.mask,
      path.paint,
      path.paintBounds,
      local.asSlice(),
      fills,
      localAlphas.asSlice(),
    )
  }

  /// Closes any layer left open, sorts every kind by order and builds each layer's batches.
  pub effect fn finish(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensureRoot()
    while self.stack.length() != 0 {
      if self.context().opensGroup {
        run self.popScrollGroup()
      } else {
        drop self.stack.pop()
      }
    }
    let data = self.layerData.asMutSlice()
    let mut i: usize = 0
    while i < u32.toUsize(self.layersUsed) {
      run data[i].sort()
      run data[i].buildBatches()
      i = i + 1
    }
  }

  /// The number of layers: 1 for the window plus one per isolated layer (0 for an unused scene).
  pub fn layerCount(self: &Self) -> u32 {
    return self.layersUsed
  }

  fn layerAt(self: &Self, layer: u32) -> &LayerData {
    return &self.layerData.asSlice()[u32.toUsize(layer)]
  }

  /// Layer `layer`'s batches in drawing order, after [`Scene.finish`].
  pub fn batches(self: &Self, layer: u32) -> &[Batch] {
    return self.layerAt(layer).batches.asSlice()
  }

  /// Layer `layer`'s shadows sorted by order, after [`Scene.finish`].
  pub fn shadows(self: &Self, layer: u32) -> &[Shadow] {
    return self.layerAt(layer).shadows.sorted.asSlice()
  }

  /// Layer `layer`'s quads sorted by order, after [`Scene.finish`].
  pub fn quads(self: &Self, layer: u32) -> &[Quad] {
    return self.layerAt(layer).quads.sorted.asSlice()
  }

  /// Layer `layer`'s paths sorted by order, after [`Scene.finish`].
  pub fn paths(self: &Self, layer: u32) -> &[PathSprite] {
    return self.layerAt(layer).paths.sorted.asSlice()
  }

  /// Layer `layer`'s underlines sorted by order, after [`Scene.finish`].
  pub fn underlines(self: &Self, layer: u32) -> &[Underline] {
    return self.layerAt(layer).underlines.sorted.asSlice()
  }

  /// Layer `layer`'s glyph sprites sorted by order and texture, after [`Scene.finish`].
  pub fn glyphs(self: &Self, layer: u32) -> &[GlyphSprite] {
    return self.layerAt(layer).glyphs.sorted.asSlice()
  }

  /// Layer `layer`'s image sprites sorted by order and texture, after [`Scene.finish`].
  pub fn images(self: &Self, layer: u32) -> &[ImageSprite] {
    return self.layerAt(layer).images.sorted.asSlice()
  }

  /// The isolated layers drawn in layer `layer`, sorted by order, after [`Scene.finish`].
  pub fn layers(self: &Self, layer: u32) -> &[LayerSprite] {
    return self.layerAt(layer).layers.sorted.asSlice()
  }

  /// The draw orders of `kind` in layer `layer`, parallel to its sorted list.
  pub fn orders(self: &Self, layer: u32, kind: PrimitiveKind) -> &[u32] {
    return self.layerAt(layer).sortedOrders(kind.index())
  }

  /// The number of primitives of every kind in every layer, isolated layer sprites included.
  pub fn primitiveCount(self: &Self) -> usize {
    let mut total: usize = 0
    let mut i: usize = 0
    while i < u32.toUsize(self.layersUsed) {
      let d = &self.layerData.asSlice()[i]
      total = total + d.shadows.length() + d.quads.length() + d.paths.length()
        + d.underlines.length()
        + d.glyphs.length()
        + d.images.length()
        + d.layers.length()
      i = i + 1
    }
    return total
  }

  /// Every path's strips; a [`PathSprite`] holds its range.
  pub fn pathStrips(self: &Self) -> &[Strip] {
    return self.strips.asSlice()
  }

  /// Every path's fully covered runs; a [`PathSprite`] holds its range.
  pub fn pathFills(self: &Self) -> &[Fill] {
    return self.fills.asSlice()
  }

  /// The coverage bytes the strips index, 4 per strip column.
  pub fn pathAlphas(self: &Self) -> &[u8] {
    return self.alphas.asSlice()
  }
}
