//! Bounds tree tests: overlap ordering against a brute-force reference, and tree depth.
import bounds_tree { BoundsTree, overlaps }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

/// A small deterministic generator (xorshift32).
pub struct Random {
  state: u32,
}

impl Random {
  pub fn make(seed: u32) -> Random {
    return Random { state: u32.wrappingMultiply(seed, 2654435761) + 1 }
  }

  pub fn next(self: &mut Self) -> u32 {
    let mut x = self.state
    x = x ^ u32.shiftLeft(x, 13)
    x = x ^ u32.shiftRight(x, 17)
    x = x ^ u32.shiftLeft(x, 5)
    self.state = x
    return x
  }

  /// A value in `low ..= high`.
  pub fn range(self: &mut Self, low: u32, high: u32) -> u32 {
    return low + self.next() % (high - low + 1)
  }
}

fn rect(x: f32, y: f32, w: f32, h: f32) -> Rect<f32> {
  return Rect<f32>.new(x, y, x + w, y + h)
}

effect fn basicOrders() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = BoundsTree.make()
  let a = run tree.insert(rect(0.0, 0.0, 10.0, 10.0))
  let b = run tree.insert(rect(20.0, 0.0, 10.0, 10.0))
  let c = run tree.insert(rect(5.0, 5.0, 20.0, 2.0))
  let d = run tree.insert(rect(10.0, 0.0, 10.0, 10.0))
  let e = run tree.insert(rect(6.0, 6.0, 1.0, 1.0))
  run Testing.expect(a == 1 && b == 1, "disjoint rectangles share order 1")
  run Testing.expect(c == 2, "a rectangle over two others draws after both")
  run Testing.expect(d == 3, "touching edges do not overlap, but the bar under it does")
  run Testing.expect(e == 3, "order is one more than the highest overlapping order")
  run Testing.expect(tree.length() == 5, "five rectangles inserted")
  tree.clear()
  let again = run tree.insert(rect(0.0, 0.0, 10.0, 10.0))
  run Testing.expect(again == 1 && tree.length() == 1, "clear forgets everything")
}

test effect fn ordersFollowOverlap() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run basicOrders() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matchesBruteForce(seed: u32) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = BoundsTree.make()
  let mut random = Random.make(seed)
  let mut rects = List<Rect<f32>>.make()
  let mut orders = List<u32>.make()
  let mut i: u32 = 0
  while i < 600 {
    let r = rect(
      u32.toF32(random.range(0, 500)),
      u32.toF32(random.range(0, 500)),
      u32.toF32(random.range(1, 60)),
      u32.toF32(random.range(1, 60)),
    )
    let mut expected: u32 = 0
    let mut j: usize = 0
    while j < rects.length() {
      if overlaps(rects.get(j), r) && orders.get(j) > expected {
        expected = orders.get(j)
      }
      j = j + 1
    }
    let order = run tree.insert(r)
    run Testing.expect(order == expected + 1, "the tree agrees with a linear scan")
    run rects.append(r)
    run orders.append(order)
    i = i + 1
  }
}

test effect fn agreesWithLinearScan() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matchesBruteForce(1) |> Effect.provideMut<Allocator>(&mut allocator)
  run matchesBruteForce(77) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn denseGrid() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = BoundsTree.make()
  let mut y: u32 = 0
  let mut allOne = true
  while y < 100 {
    let mut x: u32 = 0
    while x < 100 {
      let order = run tree.insert(rect(u32.toF32(x) * 10.0, u32.toF32(y) * 10.0, 8.0, 8.0))
      allOne = allOne && order == 1
      x = x + 1
    }
    y = y + 1
  }
  run Testing.expect(allOne, "10 000 disjoint cells all share order 1")
  let depth = run tree.depth()
  run Testing.expect(depth < 40, "a row-by-row grid does not degenerate into a list")
  let cover = run tree.insert(rect(0.0, 0.0, 1000.0, 1000.0))
  run Testing.expect(cover == 2, "a rectangle over the grid draws after it")
}

test effect fn gridStaysShallow() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run denseGrid() |> Effect.provideMut<Allocator>(&mut allocator)
}
