//! Browser ABI. Each token owns a document, a surface, and its GPU resources.
//!
//! The JavaScript wrapper serializes calls and releases each token once. Raw callers must
//! never reuse a released token or call into the module while another call holds a loan.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import atlas.atlas { Atlas, AtlasOptions, AtlasError, AtlasTile, Kind }
  import silk.core.option { Option }
  import silk.geometry.rect { Rect }
  import silk.num.u32
  import editor.document { Document, Node, Camera }
  import ui_scene.scene { Scene }
  import ui_scene.effects { LayerEffects }
  import ui_scene.color
  import ui_renderer.renderer { UiRenderer }
  import ui_renderer.atlas_textures { GpuAtlas }
  import webgpu.runtime {
    Adapter,
    AdapterRequest,
    Device,
    DeviceRequest,
    Instance,
    RequestAdapterOptions,
    GpuError
  }
  import webgpu.resources { Queue, getQueue }
  import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
  import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
  import webgpu_sys.generated_webgpu as flags
  import vector.geometry_error { GeometryError }
  import silk.core.effect { Effect }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.mem.box { Box }
  import silk.mem.pointer { Pointer }
  import silk.num.f32
  import silk.num.usize

  unsafe extern "C" fn now() -> f64 as "editor#now"

  unsafe extern "C" fn metric(
    build: f64,
    draw: f64,
    visible: u32,
    visited: u32,
    batches: u32,
  ) -> () as "editor#metric"

  // The browser captures the current Canvas2D source synchronously into this atlas tile.
  unsafe extern "C" fn copyImage(
    queue: flags.WGPUQueue,
    texture: flags.WGPUTexture,
    x: u32,
    y: u32,
    width: u32,
    height: u32,
  ) -> u32 as "editor#copy_image"

  struct Failed {}

  struct FindingAdapter {
    request: AdapterRequest<'static>
  }

  struct FindingDevice {
    adapter: Adapter,
    request: DeviceRequest
  }

  struct Running {
    device: Device,
    queue: Queue,
    surface: Surface<'static>,
    renderer: UiRenderer,
    atlas: GpuAtlas,
    format: u32,
    width: u32,
    height: u32,
  }

  struct Unrooted {}

  struct Root {
    storage: Box<State>
  }

  struct State {
    instance: Instance,
    document: Document,
    scene: Scene,
    retained: bool,
    retainedRevision: u64,
    boundsRevision: u64,
    boundsChecked: bool,
    retainedBounds: Option<Rect<f32>>,
    retainedCamera: Camera,
    tiles: Atlas,
    stage: Failed | FindingAdapter | FindingDevice | Running,
    root: Unrooted | Root,
  }

  effect fn start() -> ?*mut u8
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let instance = run Instance.create()
    let request = run instance.requestAdapterStart(&RequestAdapterOptions.default())
    let mut storage = run Box<State>.make(
      State {
        instance: move instance,
        document: Document.make(),
        scene: Scene.make(),
        retained: false,
        retainedRevision: 0,
        boundsRevision: 0,
        boundsChecked: false,
        retainedBounds: Option<Rect<f32>>.None,
        retainedCamera: Camera { x: 0.0, y: 0.0, zoom: 1.0, scale: 1.0, width: 1.0, height: 1.0 },
        tiles: Atlas.make(
          AtlasOptions { textureSize: 2048, maxTextureSize: 4096, maxTextures: 8, padding: 1 },
        ),
        stage: FindingAdapter { request: move request },
        root: Unrooted {},
      },
    )
    let pinned = Pointer.fromMutRef(&mut storage.getMut()[0])
    let mut anchor = ()
    let fresh = unsafe Pointer.borrowMut(&mut anchor, pinned)
    fresh.root = Root { storage: move storage }
    return unsafe Intrinsic.pointerReinterpret<*mut State, *mut u8>(pinned)
  }

  effect fn failedStart<E>(error: E) -> ?*mut u8 {
    drop error
    return Pointer.null<u8>()
  }

  effect fn failed<E>(error: E) -> i32 {
    drop error
    return -1
  }

  effect fn failedId<E>(error: E) -> u32 {
    drop error
    return 0
  }

  fn pointer(token: *mut u8) -> *mut State {
    return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(token)
  }

  effect fn poll(state: &mut State) -> i32
    ! GpuError | OutOfMemoryError {
    let previous = Intrinsic.replace(state.stage, Failed {})
    match move previous {
      FindingAdapter { request } => {
        let mut pending = move request
        if pending.poll() {
          let adapter = run pending.finish()
          let next = run adapter.requestDeviceStart(&DeviceDescriptor.default())
          state.stage = FindingDevice { adapter: move adapter, request: move next }
        } else {
          state.stage = FindingAdapter { request: move pending }
        }
      }
      FindingDevice { adapter, request } => {
        let mut pending = move request
        if pending.poll() {
          let device = run pending.finish()
          let target = SurfaceTarget.canvasId(b"silk-editor")
          let surface = run Surface.create(&state.instance, &target, b"editor")
          let capabilities = run surface.getCapabilities(&adapter)
          let formats = capabilities.formats()
          let mut format: u32 = 0
          let mut i: usize = 0
          while i < formats.length {
            if formats[i] == flags.WGPUTextureFormat_BGRA8Unorm
              || formats[i] == flags.WGPUTextureFormat_RGBA8Unorm {
              format = formats[i]
              break
            }
            i = i + 1
          }
          if format == 0 {
            fail GpuError.status(0xffffffff)
          }
          let queue = run getQueue(&device)
          let renderer = run UiRenderer.make(&device, format)
          state.stage = Running {
            device: move device,
            queue: move queue,
            surface: move surface,
            renderer: move renderer,
            atlas: GpuAtlas.make(),
            format: format,
            width: 0,
            height: 0,
          }
          return 1
        } else {
          state.stage = FindingDevice { adapter: move adapter, request: move pending }
        }
      }
      Running running => {
        run running.device.checkErrors()
        state.stage = move running
        return 1
      }
      Failed empty => {
        return -1
      }
    }
    return 0
  }

  effect fn draw(
    state: &mut State,
    camera: Camera,
    cull: bool,
    retained: bool,
    background: u32,
  ) -> i32
    ! GpuError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    if let Running active = &mut state.stage {
      run active.device.checkErrors()
      let width = f32.toU32(camera.width * camera.scale)
      let height = f32.toU32(camera.height * camera.scale)
      if width == 0 || height == 0 {
        return 0
      }
      if width != active.width || height != active.height {
        let configuration = SurfaceConfiguration.make(&active.device, active.format, width, height)
        active.surface.configure(&configuration)
        active.width = width
        active.height = height
      }
      let begin = unsafe now()
      if retained && (!state.boundsChecked || state.boundsRevision != state.document.revision) {
        state.retainedBounds = state.document.retainedImageBounds()
        state.boundsRevision = state.document.revision
        state.boundsChecked = true
      }

      // Close views benefit from CPU culling; dense overviews reuse the GPU scene.
      // Cache eligibility separately so an unchanged close view never scans all nodes.
      let mut useRetained = false
      if retained {
        if let Option<Rect<f32>>.Some { value: bounds } = state.retainedBounds {
          let sceneArea = (bounds.xMax - bounds.xMin) * (bounds.yMax - bounds.yMin)
          let viewArea = camera.width * camera.height / (camera.zoom * camera.zoom)
          useRetained = !cull || viewArea >= sceneArea * 0.05
        }
      }
      if !useRetained {
        state.retained = false
      }
      let refresh = !state.retained || state.retainedRevision != state.document.revision
      if useRetained && refresh {
        if let Option<Rect<f32>>.Some { value: bounds } = state.retainedBounds {
          state.retainedCamera = Camera {
            x: bounds.xMin - 1.0,
            y: bounds.yMin - 1.0,
            zoom: 1.0,
            scale: 1.0,
            width: bounds.xMax - bounds.xMin + 2.0,
            height: bounds.yMax - bounds.yMin + 2.0,
          }
          run state.document.paint(&mut state.scene, state.retainedCamera, false)
          state.retainedRevision = state.document.revision
          state.retained = true
        }
      }
      if !state.retained {
        run state.document.paint(&mut state.scene, camera, cull)
      }
      let prepared = unsafe now()
      let texture = run active.surface.getCurrentTexture()
      let view = run texture.texture.createView(&TextureViewDescriptor.default())
      if state.retained {
        let scale = camera.zoom * camera.scale
        run active.renderer.drawRetainedImages(
          &active.device,
          &active.queue,
          &state.scene,
          &active.atlas,
          &view,
          width,
          height,
          color.rgba(background),
          scale,
          (state.retainedCamera.x - camera.x) * scale,
          (state.retainedCamera.y - camera.y) * scale,
          refresh,
        )
      } else {
        run active.renderer.draw(
          &active.device,
          &active.queue,
          &state.scene,
          &active.atlas,
          &view,
          width,
          height,
          color.rgba(background),
        )
      }
      run active.surface.present()
      let end = unsafe now()
      unsafe metric(
        prepared - begin,
        end - prepared,
        state.document.visible,
        state.document.visited,
        usize.toU32(state.scene.batches(0).length),
      )
      return 1
    }
    return -1
  }

  export "C" fn editorStart() -> ?*mut u8 as "editor_start" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(start(), failedStart) |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn editorPoll(token: *mut u8) -> i32 as "editor_poll" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return run Effect.catchAll(poll(&mut state), failed)
  }

  export "C" fn editorSet(
    token: *mut u8,
    id: u32,
    kind: u32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    radius: f32,
    fill: u32,
    border: u32,
    borderWidth: f32,
    blur: f32,
    shadowX: f32,
    shadowY: f32,
    shadow: u32,
    fill2: u32,
    angle: f32,
    flags_: u32,
    opacity: f32,
    layerBlur: f32,
    backdropBlur: f32,
    brightness: f32,
    contrast: f32,
    saturation: f32,
    blend: u32,
    innerShadow: u32,
    innerBlur: f32,
    innerX: f32,
    innerY: f32,
  ) -> u32 as "editor_set" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let node = Node {
      kind: kind,
      source: Rect<f32>.new(0.0, 0.0, 1.0, 1.0),
      x: x,
      y: y,
      width: width,
      height: height,
      radius: radius,
      fill: fill,
      border: border,
      borderWidth: borderWidth,
      blur: blur,
      shadowX: shadowX,
      shadowY: shadowY,
      shadow: shadow,
      fill2: fill2,
      angle: angle,
      flags: flags_,
      opacity: opacity,
      effects: LayerEffects {
        blur: layerBlur,
        backdropBlur: backdropBlur,
        brightness: brightness,
        contrast: contrast,
        saturation: saturation,
        clip: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
        radius: 0.0,
        shape: 0,
      },
      blend: u32.toU8(blend),
      innerShadow: innerShadow,
      innerBlur: innerBlur,
      innerX: innerX,
      innerY: innerY,
      alive: true,
    }
    if id == 0 {
      let mut allocator = Allocator.systemAllocatorProvider()
      return run Effect.catchAll(state.document.add(node), failedId)
        |> Effect.provideMut<Allocator>(&mut allocator)
    }
    return if state.document.set(id, node) {
      id
    } else {
      0
    }
  }

  export "C" fn editorRemove(token: *mut u8, id: u32) -> u32 as "editor_remove" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return if state.document.remove(id) {
      1
    } else {
      0
    }
  }

  export "C" fn editorHit(token: *mut u8, x: f32, y: f32) -> u32 as "editor_hit" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return state.document.hit(x, y)
  }

  export "C" fn editorDraw(
    token: *mut u8,
    x: f32,
    y: f32,
    zoom: f32,
    scale: f32,
    width: f32,
    height: f32,
    cull: u32,
    background: u32,
  ) -> i32 as "editor_draw" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let mut allocator = Allocator.systemAllocatorProvider()
    let camera = Camera { x: x, y: y, zoom: zoom, scale: scale, width: width, height: height }
    return run Effect.catchAll(
      draw(&mut state, camera, (cull & 1) != 0, (cull & 2) != 0, background),
      failed,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn editorDrop(token: *mut u8) -> () as "editor_drop" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let root = Intrinsic.replace(state.root, Unrooted {})
    match move root {
      Root { storage } => {
        drop storage
      }
      Unrooted empty => ()
    }
  }

  effect fn installImage(
    state: &mut State,
    kind: u32,
    tile: AtlasTile,
    pixels: &[u8],
    external: bool,
  ) -> u32
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if let Running active = &mut state.stage {
      run active.atlas.sync(&active.device, &state.tiles)
      if external {
        let texture = active.atlas.texture(u32.toUsize(tile.texture.index))
        let copied = unsafe copyImage(
          unsafe active.queue.raw(),
          unsafe texture.raw(),
          tile.bounds.xMin,
          tile.bounds.yMin,
          tile.bounds.xMax - tile.bounds.xMin,
          tile.bounds.yMax - tile.bounds.yMin,
        )
        if copied == 0 {
          return 0
        }
      } else {
        active.atlas.write(&active.queue, tile, pixels)
      }
      if kind == 0 {
        return run state.document.addTile(tile)
      }
      if let Option<AtlasTile>.Some { value } = state.document.replaceTile(kind, tile) {
        drop state.tiles.free(value.id)
        return kind
      }
    }
    return 0
  }

  // Allocate before replacing: a full atlas leaves the current image valid. This atlas does
  // not advance frames, so allocate cannot evict another live document tile implicitly.
  effect fn upload(
    state: &mut State,
    kind: u32,
    width: u32,
    height: u32,
    pixels: &[u8],
    external: bool,
  ) -> u32
    ! GpuError | OutOfMemoryError | AtlasError
    ? &mut Allocator {
    if let Running _ = &mut state.stage {
      let tile = run state.tiles.allocate(Kind.Polychrome, width, height)
      let result = run Effect.catchAll(
        installImage(&mut state, kind, tile, pixels, external),
        failedId,
      )
      if result == 0 {
        drop state.tiles.free(tile.id)
      }
      return result
    }
    return 0
  }

  export "C" fn editorImage(
    token: *mut u8,
    width: u32,
    height: u32,
    bytes: [*]const u8,
  ) -> u32 as "editor_image" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let mut pixelsAnchor = ()
    let pixels = unsafe Pointer.borrowMany(&pixelsAnchor, bytes, u32.toUsize(width * height * 4))
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(upload(&mut state, 0, width, height, pixels, false), failedId)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn editorImageReplace(
    token: *mut u8,
    kind: u32,
    width: u32,
    height: u32,
    bytes: [*]const u8,
  ) -> u32 as "editor_image_replace" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let mut pixelsAnchor = ()
    let pixels = unsafe Pointer.borrowMany(&pixelsAnchor, bytes, u32.toUsize(width * height * 4))
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(upload(&mut state, kind, width, height, pixels, false), failedId)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn editorCanvas(
    token: *mut u8,
    kind: u32,
    width: u32,
    height: u32,
  ) -> u32 as "editor_canvas" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(upload(&mut state, kind, width, height, &[], true), failedId)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  export "C" fn editorImageView(
    token: *mut u8,
    kind: u32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
  ) -> u32 as "editor_image_view" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return if state.document.setTileView(kind, Rect<f32>.new(x, y, x + width, y + height)) {
      1
    } else {
      0
    }
  }

  export "C" fn editorImageNode(token: *mut u8, id: u32, kind: u32) -> u32 as "editor_image_node" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return if state.document.setImageKind(id, kind) {
      1
    } else {
      0
    }
  }

  export "C" fn editorImageSource(
    token: *mut u8,
    id: u32,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
  ) -> u32 as "editor_image_source" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return if state.document.setImageSource(id, Rect<f32>.new(x, y, x + width, y + height)) {
      1
    } else {
      0
    }
  }

  export "C" fn editorImageRelease(token: *mut u8, kind: u32) -> () as "editor_image_release" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    if let Option<AtlasTile>.Some { value } = state.document.releaseTile(kind) {
      drop state.tiles.free(value.id)
    }
  }

  export "C" fn editorImageCount(token: *mut u8) -> u32 as "editor_image_count" {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut(&mut anchor, pointer(token))
    return state.tiles.tileCount()
  }
}
