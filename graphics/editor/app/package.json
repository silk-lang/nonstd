{
  "name": "@silk/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "format": "oxfmt --write .",
    "check": "oxfmt --check . && oxlint --disable-nested-config . && bun run typecheck",
    "check:write": "oxfmt --write . && oxlint --disable-nested-config --fix .",
    "test": "bun test tests/model.test.ts tests/resize.test.ts tests/selection.test.ts",
    "prepare": "effect-tsgo patch --oxlint",
    "test:browser": "playwright test",
    "bench": "playwright test --config playwright.bench.config.ts",
    "bench:selection:cpu": "bun benchmarks/selection-cpu.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.4.2"
}
