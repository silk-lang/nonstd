{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "effecttsgo"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "ignorePatterns": ["**/dist/**"],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "rules": {
    "no-nested-ternary": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "lib",
            "name": [
              "Element",
              "HTMLElement",
              "HTMLCanvasElement",
              "HTMLInputElement",
              "EventTarget",
              "Event",
              "PointerEvent",
              "MouseEvent",
              "KeyboardEvent",
              "WheelEvent",
              "Blob"
            ]
          },
          {
            "from": "package",
            "package": "foldkit",
            "name": ["HtmlBuilder"]
          },
          {
            "from": "package",
            "package": "effect",
            "name": ["Enqueue", "Stream", "Effect"]
          },
          "Editor",
          "CanvasHost",
          "CanvasError",
          "FileError",
          "H",
          "CanvasInput",
          "Html",
          "Enqueue",
          "CustomEvent",
          "Queue",
          {
            "from": "package",
            "package": "@playwright/test",
            "name": ["Page", "PlaywrightTestArgs"]
          },
          "Page",
          "Buffer",
          "IDBDatabase",
          "StorageError",
          "BeforeUnloadEvent",
          "TestInfo"
        ]
      }
    ]
  },
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"]
}
