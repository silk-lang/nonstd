#!/usr/bin/env python3
"""Check the editor's native contracts, generated ABI, WASM build, and optional browser tests.

Use --browser with PLAYWRIGHT_MODULE and PLAYWRIGHT_CHROMIUM_EXECUTABLE pointing to installed tools.
On Linux, run the browser check under xvfb-run; pass EDITOR_SOFTWARE_GPU=1 for SwiftShader.
"""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from _compiler import compiler_command

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--browser', action='store_true')
args = parser.parse_args()

def run(command):
    subprocess.run(command, cwd=REPO, check=True)

run([sys.executable, str(REPO / 'gpu/webgpu/scripts/generate-browser'), '--check'])
run([*compiler_command('format'), str(ROOT / 'src'), str(ROOT / 'browser/src/bridge.silk'), str(ROOT / 'browser/src/main.silk'), '--check'])
with tempfile.TemporaryDirectory(prefix='silk-editor-check-') as temp:
    command = [*compiler_command('test'), '--manifest-path', str(ROOT / 'silk.toml'), '--root', 'src/tests.silk']
    if sys.platform == 'darwin':
        # dev.45 links native unit tests against its generated libSystem stub, which omits
        # the runner's alarm symbol. Use the SDK's real libSystem instead. No source patch.
        clang = os.environ.get('SILK_CLANG') or shutil.which('clang-22')
        if not clang:
            raise SystemExit('Set SILK_CLANG to Clang 22+ for the macOS native test workaround')
        wrapper = Path(temp) / 'clang'
        wrapper.write_text('#!' + sys.executable + '\nimport os, sys\nargs = sys.argv[1:]\n'
            "if not any(a in args for a in ['-c', '--version', '-v', '-E', '-S']):\n"
            "    for i in range(len(args)-2, -1, -1):\n"
            "        if args[i] == '-L' and '/.silk--' in args[i+1]: del args[i:i+2]\n"
            f'os.execv({clang!r}, [{clang!r}, *args])\n')
        wrapper.chmod(0o755)
        command += ['--clang', str(wrapper)]
    run(command)
run([*compiler_command('check'), '--manifest-path', str(ROOT / 'browser/silk.toml')])
run([sys.executable, str(ROOT / 'scripts/browser'), 'build'])
for path in list((ROOT / 'js').glob('*.js')) + list((ROOT / 'web').glob('*.js')):
    run(['node', '--check', str(path)])
if args.browser:
    run(['node', str(ROOT / 'web/test.mjs')])
