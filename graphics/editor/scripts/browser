#!/usr/bin/env python3
"""Build the editor WASM package and distributable browser modules, optionally serve the demo."""
import argparse
import shutil
import subprocess
from pathlib import Path
from _compiler import compiler_command
ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('mode', choices=['build', 'serve'], nargs='?', default='serve')
parser.add_argument('--port', type=int, default=8050)
args = parser.parse_args()
subprocess.run([*compiler_command('build'), '--manifest-path', str(ROOT / 'browser/silk.toml'),
                '--target', 'wasm32-unknown-unknown', '--release'], cwd=REPO, check=True)
dist = ROOT / 'dist'
dist.mkdir(exist_ok=True)
shutil.copy2(REPO / 'build/llvm/wasm32-unknown-unknown/release/graphics-editor-browser', dist / 'editor.wasm')
for path in (ROOT / 'js').glob('*'):
    if path.suffix in ['.js', '.ts']:
        text = path.read_text().replace('../../../gpu/webgpu/browser/host.ts', './host.js')
        (dist / path.name).write_text(text)
for source, target in [('host.ts', 'host.js'), ('generated_schema.ts', 'generated_schema.js')]:
    text = (REPO / 'gpu/webgpu/browser' / source).read_text().replace('./generated_schema.ts', './generated_schema.js')
    (dist / target).write_text(text)
print(f'Browser library: {dist}')
if args.mode == 'serve':
    subprocess.run(['node', str(ROOT / 'web/serve.mjs'), str(args.port)], cwd=REPO, check=True)
