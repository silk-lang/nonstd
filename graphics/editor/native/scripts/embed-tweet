#!/usr/bin/env python3
"""Embed the supplied tweet unchanged, for native rendering and portable SVG export."""
from pathlib import Path
import base64
root = Path(__file__).resolve().parents[1]
data = (root / 'assets/tweet-challenge.png').read_bytes()
png = ''.join(f'\\x{byte:02x}' for byte in data)
uri = 'data:image/png;base64,' + base64.b64encode(data).decode()
(root / 'src/tweet_asset.silk').write_text(
    '//! Generated by scripts/embed-tweet from assets/tweet-challenge.png.\n'
    + 'pub fn png() -> &\'static [u8] { return b"' + png + '" }\n'
    + 'pub fn uri() -> string<\'static> { return "' + uri + '" }\n')
