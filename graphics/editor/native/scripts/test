#!/usr/bin/env python3
"""Run native Studio contracts and CPU workload timings; use --release for timings."""
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[2]
sys.path.insert(0, str(REPO / 'gpu/webgpu/scripts'))
from _build import build, command_path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--release', action='store_true')
    args = parser.parse_args()
    # dev.47's generated macOS libSystem stub omits several math routines used by the
    # CPU renderer. Resolve them from the installed SDK for this headless executable.
    with tempfile.TemporaryDirectory(prefix='silk-studio-test-') as temporary:
        if sys.platform == 'darwin':
            clang = command_path('install-llvm')
            wrapper = Path(temporary) / 'clang'
            wrapper.write_text('#!' + sys.executable + '\n' +
                'import os, sys\nargs = sys.argv[1:]\n' +
                'if not any(a in args for a in ["-c", "--version", "-v", "-E", "-S"]):\n' +
                '    for i in range(len(args)-2, -1, -1):\n' +
                '        if args[i] == "-L" and "/.silk--" in args[i+1]:\n' +
                '            del args[i:i+2]\n' +
                f'os.execv({str(clang)!r}, [{str(clang)!r}, *args])\n')
            wrapper.chmod(0o755)
            os.environ['SILK_CLANG'] = str(wrapper)
        program = build(ROOT / 'tests', release=args.release)
        return subprocess.run([str(program)], cwd=REPO, timeout=300).returncode


if __name__ == '__main__':
    raise SystemExit(main())
