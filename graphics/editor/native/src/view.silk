  LineHeight,
  TextAlign
}
import silk.collections.list { List }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.usize

fn theme() -> Theme {
  let mut t = Theme.light(1)
  t.background = rgb(0xfcfcfa)
  t.surface = rgb(0xfcfcfa)
  t.text = rgb(0x30372e)
  t.mutedText = rgb(0x7a8374)
  t.border = rgb(0xdfe3da)
  t.accent = rgb(0x2d4535)
  t.accentHover = rgb(0x3f5945)
  t.highlight = rgb(0xe9efdf)
  t.fontSize = 12.0
  t.controlHeight = 30.0
  return t
}

/// Registers the native UI's icon resources before the first view is mounted.
pub effect fn resources(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run icons.resources(&mut batch)
}

fn iconButton(
  ui: &mut Ui<Message>,
  t: &Theme,
  m: &Studio,
  icon: u32,
  label: string,
  code: u32,
) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(label)
      ui.testId(label)
      if m.focusAction != 0 && m.focusAction == code {
        ui.takeFocus()
      }
      if code == 16 || code == 18 {
        ui.on(
          EventKind.Focus,
          |event| Reply<Message>.Emit { message: Message.FocusReturned { action: code } },
        )
      }
      let tipKey = 10000 + u32.toU64(code)
      tooltip(
        &mut ui,
        t,
        tipKey,
        m.tooltip == tipKey,
        label,
        |show| Message.Tooltip {
          id: if show {
            tipKey
          } else {
            0
          },
        },
      )
      ui.width(Length.px(28.0))
      ui.height(Length.px(28.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.BoxSizing { value: BoxSizing.BorderBox },
          Property.AlignItems { value: Align.Center },
          Property.JustifyContent { value: Align.Center },
          Property.BorderRadius { value: corners(5.0) },
        ],
      )
      ui.hover(&[Property.BackgroundColor { color: sceneColor.rgb(0xeaf0e3) }])
      ui.color(rgb(0x747d70))
      glyph(&mut ui, icon, 18.0)
    },
  )
}

fn glyph(ui: &mut Ui<Message>, resource: u32, size: f32) -> () {
  ui.box(
    |ui| {
      ui.fontSize(size)
      ui.style(&[Property.LineHeight { value: LineHeight.Px { value: size } }])
      ui.width(Length.px(size))
      ui.height(Length.px(size))
      ui.style(&[Property.FlexShrink { value: 0.0 }])
      ui.icon(resource)
    },
  )
}

fn line(ui: &mut Ui<Message>, side: Side) -> () {
  ui.style(
    &[
      Property.BorderWidth { side: side, value: 1.0 },
      Property.BorderStyle { value: BorderStyle.Solid },
      Property.BorderColor { color: rgb(0xe8ebe3) },
    ],
  )
}

fn section(ui: &mut Ui<Message>, t: &Theme, name: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(10.0)
      if name == "Dimensions" || name == "Fill" {
        ui.style(&[Property.Margin { side: Side.Top, value: Length.px(6.0) }])
      }
      ui.color(rgb(0x626e5b))
      ui.style(&[Property.FontWeight { value: 650.0 }])
      ui.text(name)
    },
  )
}

fn panelSection(
  ui: &mut Ui<Message>,
  t: &Theme,
  title: string,
  body: fn(&mut Ui<Message>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.padding(15.0)
      ui.gap(10.0)
      ui.style(
        &[
          Property.Padding { side: Side.Top, value: Length.px(17.0) },
          Property.Padding { side: Side.Bottom, value: Length.px(17.0) },
          Property.FlexShrink { value: 0.0 },
        ],
      )
      line(&mut ui, Side.Bottom)
      if title != "" {
        section(&mut ui, t, title)
      }
      body(&mut ui)
    },
  )
}

fn hint(ui: &mut Ui<Message>, text: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(9.0)
      ui.color(rgb(0x97a08f))
      ui.style(&[Property.LineHeight { value: LineHeight.Number { value: 1.6 } }])
      ui.text(text)
    },
  )
}

fn item(
  ui: &mut Ui<Message>,
  t: &Theme,
  icon: u32,
  title: string,
  shortcut: string,
  code: u32,
) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(title)
      ui.height(Length.px(33.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.AlignItems { value: Align.Center },
          Property.BoxSizing { value: BoxSizing.BorderBox },
          Property.FlexShrink { value: 0.0 },
          Property.BorderRadius { value: corners(5.0) },
        ],
      )
      ui.padding(8.0)
      ui.gap(8.0)
      ui.fontSize(11.0)
      ui.color(rgb(0x65765a))
      ui.hover(&[Property.BackgroundColor { color: rgb(0xedf2e5) }])
      glyph(&mut ui, icon, 14.0)
      ui.text(title)
      spacer(&mut ui)
      hint(&mut ui, shortcut)
    },
  )
}

fn setting(
  ui: &mut Ui<Message>,
  t: &Theme,
  icon: u32,
  title: string,
  enabled: bool,
  code: u32,
) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(title)
      ui.accessRole(Role.Switch)
      ui.checked(enabled)
      ui.height(Length.px(28.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.AlignItems { value: Align.Center },
        ],
      )
      ui.gap(8.0)
      ui.fontSize(11.0)
      ui.color(rgb(0x758269))
      glyph(&mut ui, icon, 16.0)
      ui.text(title)
      spacer(&mut ui)
      ui.box(
        |ui| {
          ui.width(Length.px(25.0))
          ui.height(Length.px(14.0))
          ui.background(
            if enabled {
              rgb(0x728c5e)
            } else {
              rgb(0xdfe4d8)
            },
          )
          ui.style(
            &[
              Property.Position { value: Position.Relative },
              Property.BorderRadius { value: corners(20.0) },
            ],
          )
          ui.box(
            |ui| {
              place(
                &mut ui,
                if enabled {
                  13.0
                } else {
                  2.0
                },
                2.0,
                10.0,
                10.0,
              )
              ui.background(rgb(0xffffff))
              ui.style(&[Property.BorderRadius { value: corners(10.0) }])
            },
          )
        },
      )
    },
  )
}

fn place(ui: &mut Ui<Message>, x: f32, y: f32, w: f32, h: f32) -> () {
  ui.style(
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset { side: Side.Left, value: Length.px(x) },
      Property.Inset { side: Side.Top, value: Length.px(y) },
      Property.Width { value: Length.px(w) },
      Property.Height { value: Length.px(h) },
      Property.BoxSizing { value: BoxSizing.BorderBox },
    ],
  )
}

fn button(ui: &mut Ui<Message>, t: &Theme, label: string, code: u32) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(label)
      ui.width(Length.percent(100.0))
      ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
      ui.padding(6.0)
      ui.fontSize(10.0)
      ui.color(rgb(0x6a775d))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.JustifyContent { value: Align.Center },
        ],
      )
      border(&mut ui, 1.0, rgb(0xe0e6d7), 5.0)
      ui.hover(&[Property.BackgroundColor { color: rgb(0xeef2e6) }])
      ui.text(label)
    },
  )
}

fn field(
  ui: &mut Ui<Message>,
  t: &Theme,
  m: &Studio,
  label: string,
  key: u32,
  value: string,
) -> () {
  ui.row(
    |ui| {
      ui.height(
        Length.px(
          if key == 19 {
            31.0
          } else {
            30.0
          },
        ),
      )
      if key == 19 {
        ui.style(&[Property.Margin { side: Side.Bottom, value: Length.px(8.0) }])
      }
      ui.width(Length.percent(100.0))
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BoxSizing { value: BoxSizing.BorderBox },
        ],
      )
      ui.gap(6.0)
      ui.padding(6.0)
      border(&mut ui, 1.0, t.border, 5.0)
      ui.background(rgb(0xf5f6f1))
      if key != 19 && key != 14 && key != 5 && key != 9 && key != 10 && key != 26 {
        ui.box(
          |ui| {
            ui.fontSize(9.0)
            ui.color(t.mutedText)
            if label == "Width" {
              ui.text("W")
            } else if label == "Height" {
              ui.text("H")
            } else if label == "Corner radius" {
              ui.text("Radius")
            } else if label == "Opacity %" {
              ui.text("Opacity %")
            } else if label == "Font size" {
              ui.text("Size")
            } else if label == "Stroke width" {
              ui.text("Width")
            } else if label == "Shadow blur" {
              ui.text("Blur")
            } else if label == "Shadow Y" {
              ui.text("Offset Y")
            } else {
              ui.text(label)
            }
          },
        )
      }
      ui.input(
        if m.draftField == key {
          String.view(&m.draft)
        } else {
          value
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label(label)
          ui.testId(label)
          ui.grow(1.0)
          ui.style(
            &[
              Property.MinWidth { value: Length.px(0.0) },
              Property.BoxSizing { value: BoxSizing.BorderBox },
            ],
          )
          ui.fontSize(11.0)
          ui.onInput(|v| Message.Draft { field: key, value: move v })
          ui.onEnter(|| Message.Commit)
          ui.onBlur(|| Message.Commit)
          ui.onKeyDown(|e| Reply<Message>.Stop)
        },
      )
    },
  )
}

fn number(ui: &mut Ui<Message>, t: &Theme, m: &Studio, label: string, key: u32, value: f32) -> () {
  let text = ui.alloc(format.decimal(value))
  field(&mut ui, t, m, label, key, String.view(&text))
}

fn color(ui: &mut Ui<Message>, t: &Theme, m: &Studio, label: string, key: u32, value: u32) -> () {
  ui.row(
    |ui| {
      ui.height(Length.px(32.0))
      ui.padding(5.0)
      ui.gap(6.0)
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BoxSizing { value: BoxSizing.BorderBox },
        ],
      )
      border(&mut ui, 1.0, rgb(0xe8ebe2), 5.0)
      ui.pressable(
        || Message.ColorOpen { field: key, value: value },
        |ui| {
          let mut title = ui.alloc(String.copy(label))
          ui.alloc(title.append(" color"))
          ui.label(String.view(&title))
          ui.width(Length.px(20.0))
          ui.height(Length.px(20.0))
          ui.style(&[Property.FlexShrink { value: 0.0 }])
          ui.background(sceneColor.rgba(value))
          border(&mut ui, 1.0, rgba(0x000000, 0.07), 4.0)
        },
      )
      let text = ui.alloc(format.colorLabel(value))
      ui.input(
        if m.draftField == key {
          String.view(&m.draft)
        } else {
          String.view(&text)
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label(label)
          ui.testId(label)
          ui.grow(1.0)
          ui.style(&[Property.MinWidth { value: Length.px(0.0) }])
          ui.fontSize(11.0)
          ui.onInput(|v| Message.Draft { field: key, value: move v })
          ui.onEnter(|| Message.Commit)
          ui.onBlur(|| Message.Commit)
          ui.onKeyDown(|event| Reply<Message>.Stop)
        },
      )
      ui.box(
        |ui| {
          ui.fontSize(10.0)
          ui.color(t.mutedText)
          ui.text(label)
        },
      )
    },
  )
}

fn colorPicker(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  if m.colorField == 0 {
    return ()
  }
  ui.overlay(
    902,
    |ui| {
      ui.color(t.text)
      ui.fontSize(12.0)
      ui.style(
        &[
          Property.FontFamily { family: 1 },
          Property.LineHeight { value: LineHeight.Number { value: 1.5 } },
        ],
      )
      place(&mut ui, 0.0, 0.0, m.width, m.height)
      ui.onPointerDown(|event| Reply<Message>.EmitAndStop { message: Message.ColorClose })
      ui.column(
        |ui| {
          place(&mut ui, m.width - m.rightWidth() - 288.0, 180.0, 272.0, 328.0)
          ui.accessRole(Role.Dialog)
          ui.label("Choose color")
          ui.focusTrap(true)
          ui.background(t.surface)
          ui.padding(16.0)
          ui.gap(12.0)
          border(&mut ui, 1.0, t.border, 10.0)
          ui.onPointerDown(|event| Reply<Message>.Stop)
          ui.onKeyDown(
            |event| if String.view(&event.key) == "Escape" {
              Reply<Message>.EmitAndStop { message: Message.ColorClose }
            } else {
              Reply<Message>.Stop
            },
          )
          ui.row(
            |ui| {
              ui.fontSize(12.0)
              ui.text("Choose color")
              spacer(&mut ui)
              ui.pressable(
                || Message.ColorClose,
                |ui| {
                  ui.label("Close color picker")
                  glyph(&mut ui, icons.CLOSE, 16.0)
                },
              )
            },
          )
          ui.box(
            |ui| {
              ui.height(Length.px(48.0))
              ui.background(sceneColor.rgba(m.colorValue))
              border(&mut ui, 1.0, t.border, 5.0)
            },
          )
          let labels: [string; 4] = ["Red", "Green", "Blue", "Alpha"]
          let mut i: usize = 0
          while i < labels.length {
            let channel = usize.toU32(i)
            slider(
              &mut ui,
              t,
              950 + usize.toU64(i),
              labels[i],
              u32.toF32(u32.shiftRight(m.colorValue, (3 - channel) * 8) & 255),
              SliderRange { min: 0.0, max: 255.0, step: 1.0, places: 0 },
              |value| Message.ColorChannel { channel: channel, value: value },
            )
            i = i + 1
          }
        },
      )
    },
  )
}

fn choice(
  ui: &mut Ui<Message>,
  t: &Theme,
  key: u64,
  state: &MenuState,
  label: string,
  values: &[string],
  selected: usize,
  message: fn(MenuMessage) -> Message,
) -> () {
  let mut control = theme()
  control.fontSize = 11.0
  control.controlHeight = 31.0
  control.surface = rgb(0xf5f6f1)
  control.border = rgb(0xe8ebe2)
  selectControl(&mut ui, &control, key, state, label, values, selected, message)
}

fn header(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.row(
    |ui| {
      place(&mut ui, 0.0, 0.0, m.width, 56.0)
      ui.padding(12.0)
      ui.gap(9.0)
      ui.style(&[Property.AlignItems { value: Align.Center }])
      ui.background(t.surface)
      line(&mut ui, Side.Bottom)
      ui.pressable(
        || Message.Action { code: 17 },
        |ui| {
          ui.label("File")
          ui.testId("File")
          if m.focusAction == 17 {
            ui.takeFocus()
          }
          ui.on(
            EventKind.Focus,
            |event| Reply<Message>.Emit { message: Message.FocusReturned { action: 17 } },
          )
          ui.width(Length.px(28.0))
          ui.height(Length.px(28.0))
          ui.style(
            &[
              Property.Display { value: Display.Flex },
              Property.AlignItems { value: Align.Center },
              Property.JustifyContent { value: Align.Center },
              Property.BorderRadius { value: corners(8.0) },
              Property.FontFamily { family: 3 },
              Property.FontStyle { value: FontStyle.Italic },
            ],
          )
          ui.background(t.accent)
          ui.color(rgb(0xedf2e4))
          ui.fontSize(27.0)
          ui.text("s")
        },
      )
      if m.width > 850.0 {
        ui.row(
          |ui| {
            ui.gap(3.0)
            ui.fontSize(14.0)
            ui.style(&[Property.FontWeight { value: 650.0 }])
            ui.text("silk")
            if m.width > 1100.0 {
              ui.box(
                |ui| {
                  ui.color(rgb(0x90988b))
                  ui.style(&[Property.FontWeight { value: 400.0 }])
                  ui.text("studio")
                },
              )
            }
          },
        )
      }
      ui.box(
        |ui| {
          ui.width(Length.px(19.0))
          ui.height(Length.px(18.0))
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.style(&[Property.Padding { side: Side.Left, value: Length.px(9.0) }])
          ui.box(
            |ui| {
              ui.width(Length.px(1.0))
              ui.height(Length.px(18.0))
              ui.background(t.border)
            },
          )
        },
      )
      ui.input(
        if m.draftField == 18 {
          String.view(&m.draft)
        } else {
          m.string(m.title)
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label("Document name")
          ui.width(Length.px(170.0))
          ui.height(Length.px(30.0))
          ui.padding(7.0)
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.fontSize(12.0)
          ui.onInput(|v| Message.Draft { field: 18, value: move v })
          ui.onBlur(|| Message.Commit)
          ui.onEnter(|| Message.Commit)
          ui.onKeyDown(|e| Reply<Message>.Stop)
        },
      )
      if m.width > 850.0 {
        ui.box(
          |ui| {
            ui.padding(4.0)
            ui.fontSize(8.0)
            ui.color(t.mutedText)
            ui.background(rgb(0xeef1e9))
            ui.style(&[Property.BorderRadius { value: corners(3.0) }])
            ui.text("LOCAL")
          },
        )
      }
      spacer(&mut ui)
      if m.width > 1100.0 {
        ui.row(
          |ui| {
            ui.gap(5.0)
            ui.fontSize(10.0)
            ui.color(rgb(0x7e8977))
            ui.style(
              &[
                Property.AlignItems { value: Align.Center },
                Property.Padding { side: Side.Right, value: Length.px(12.0) },
              ],
            )
            glyph(&mut ui, icons.CHECK, 13.0)
            ui.text(
              if m.savedRevision == m.revision {
                "Saved on this device"
              } else {
                "Saving…"
              },
            )
          },
        )
      }
      ui.box(
        |ui| {
          ui.disabled(m.past.length() == 0)
          if m.past.length() == 0 {
            ui.style(&[Property.Opacity { value: 0.3 }])
          }
          iconButton(&mut ui, t, m, icons.UNDO, "Undo", 0)
        },
      )
      ui.box(
        |ui| {
          ui.disabled(m.future.length() == 0)
          if m.future.length() == 0 {
            ui.style(&[Property.Opacity { value: 0.3 }])
          }
          iconButton(&mut ui, t, m, icons.REDO, "Redo", 1)
        },
      )
      ui.box(
        |ui| {
          ui.width(Length.px(1.0))
          ui.height(Length.px(18.0))
          ui.background(t.border)
        },
      )
      iconButton(&mut ui, t, m, icons.SEARCH, "Commands", 16)
      ui.pressable(
        || Message.Action { code: 15 },
        |ui| {
          ui.label("Export PNG")
          ui.height(Length.px(31.0))
          ui.padding(9.0)
          ui.gap(8.0)
          ui.style(
            &[
              Property.Display { value: Display.Flex },
              Property.FlexDirection { value: FlexDirection.Row },
              Property.AlignItems { value: Align.Center },
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.BorderRadius { value: corners(6.0) },
            ],
          )
          ui.fontSize(11.0)
          ui.background(t.accent)
          ui.color(rgb(0xffffff))
          glyph(&mut ui, icons.EXPORT, 15.0)
          ui.text("Export PNG")
        },
      )
    },
  )
}

fn layerList(
  ui: &mut Ui<Message>,
  t: &Theme,
  label: string,
  count: usize,
  rowHeight: f32,
  height: f32,
  offset: f32,
  onScroll: fn(f32) -> Message,
  row: fn(&mut Ui<Message>, usize) -> (),
) -> () {
  let window = visibleRows(count, rowHeight, height, offset, 4)
  ui.column(
    |ui| {
      ui.accessRole(Role.List)
      ui.label(label)
      ui.height(Length.px(height))
      ui.style(
        &[
          Property.OverflowY { value: Overflow.Auto },
          Property.OverflowX { value: Overflow.Hidden },
          Property.FlexShrink { value: 0.0 },
        ],
      )
      ui.on(EventKind.Scroll, |event| Reply<Message>.Emit { message: onScroll(event.y) })
      ui.box(
        |ui| {
          ui.height(Length.px(usize.toF32(window.first) * rowHeight))
          ui.style(&[Property.FlexShrink { value: 0.0 }])
        },
      )
      let mut index = window.first
      while index < window.end {
        ui.key(usize.toU64(index))
        ui.row(
          |ui| {
            ui.accessRole(Role.ListItem)
            ui.height(Length.px(rowHeight))
            ui.style(
              &[Property.FlexShrink { value: 0.0 }, Property.AlignItems { value: Align.Center }],
            )
            row(&mut ui, index)
          },
        )
        index = index + 1
      }
      ui.box(
        |ui| {
          ui.height(Length.px(usize.toF32(count - window.end) * rowHeight))
          ui.style(&[Property.FlexShrink { value: 0.0 }])
        },
      )
    },
  )
}

fn sidebar(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.column(
    |ui| {
      place(&mut ui, 0.0, 56.0, m.leftWidth(), m.canvasHeight())
      ui.background(t.surface)
      line(&mut ui, Side.Right)
      ui.fontSize(11.0)
      ui.row(
        |ui| {
          ui.height(Length.px(48.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.box(
            |ui| {
              ui.style(&[Property.FontWeight { value: 650.0 }])
              ui.text("Workspace")
            },
          )
          spacer(&mut ui)
          iconButton(&mut ui, t, m, icons.MORE, "Open document", 36)
        },
      )
      ui.column(
        |ui| {
          ui.padding(10.0)
          ui.style(
            &[
              Property.Padding { side: Side.Top, value: Length.px(14.0) },
              Property.Padding { side: Side.Bottom, value: Length.px(12.0) },
              Property.MaxHeight { value: Length.px(200.0) },
              Property.OverflowY { value: Overflow.Auto },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.row(
            |ui| {
              ui.height(Length.px(34.0))
              ui.style(&[Property.AlignItems { value: Align.Center }])
              ui.box(
                |ui| {
                  ui.padding(6.0)
                  section(&mut ui, t, "Pages")
                },
              )
              spacer(&mut ui)
              iconButton(&mut ui, t, m, icons.PLUS, "Add page", 10)
            },
          )
          ui.each(
            m.pages.asSlice(),
            |p| u32.toU64(p.id),
            |ui, p| {
              ui.pressable(
                || Message.Page { id: p.id },
                |ui| {
                  ui.height(Length.px(31.0))
                  ui.padding(9.0)
                  ui.style(
                    &[
                      Property.BoxSizing { value: BoxSizing.BorderBox },
                      Property.Display { value: Display.Flex },
                      Property.FlexDirection { value: FlexDirection.Row },
                      Property.AlignItems { value: Align.Center },
                      Property.BorderRadius { value: corners(5.0) },
                    ],
                  )
                  ui.gap(8.0)
                  ui.fontSize(11.0)
                  ui.color(t.mutedText)
                  if p.id == m.page {
                    ui.background(rgb(0xeaf0e3))
                    ui.color(rgb(0x35492f))
                  }
                  ui.label(m.string(p.name))
                  glyph(&mut ui, icons.FILE, 14.0)
                  ui.text(m.string(p.name))
                  spacer(&mut ui)
                  if p.id == m.page {
                    glyph(&mut ui, icons.CHECK, 13.0)
                  }
                },
              )
            },
          )
        },
      )
      ui.row(
        |ui| {
          ui.height(Length.px(44.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.Padding { side: Side.Top, value: Length.px(18.0) },
            ],
          )
          section(&mut ui, t, "Layers")
          spacer(&mut ui)
          ui.box(
            |ui| {
              ui.background(rgb(0xf0f2ec))
              ui.color(rgb(0x959e8c))
              ui.padding(3.0)
              ui.fontSize(9.0)
              ui.number(usize.toI64(m.pageCount))
            },
          )
        },
      )
      ui.box(
        |ui| {
          ui.height(Length.px(37.0))
          ui.style(
            &[
              Property.Padding { side: Side.Left, value: Length.px(9.0) },
              Property.Padding { side: Side.Right, value: Length.px(9.0) },
            ],
          )
          ui.row(
            |ui| {
              ui.height(Length.px(28.0))
              ui.padding(6.0)
              ui.gap(6.0)
              ui.style(
                &[
                  Property.BoxSizing { value: BoxSizing.BorderBox },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              border(&mut ui, 1.0, rgb(0xe7eae1), 5.0)
              ui.color(rgb(0x929b89))
              glyph(&mut ui, icons.SEARCH, 14.0)
              ui.input(
                String.view(&m.search),
                |ui| {
                  ui.accessRole(Role.TextBox)
                  ui.grow(1.0)
                  ui.fontSize(10.0)
                  ui.style(&[Property.MinWidth { value: Length.px(0.0) }])
                  ui.placeholder("Find a layer…")
                  ui.label("Find a layer")
                  ui.onInput(|v| Message.Search { value: move v })
                  ui.onKeyDown(|e| Reply<Message>.Stop)
                },
              )
            },
          )
        },
      )
      let cached = m.layerRevision == m.revision && m.layerPage == m.page
      let mut fallback = List<Row>.make()
      if !cached {
        fallback = ui.alloc(layers.build(m))
      }
      let rows = if cached {
        m.layerRows.asSlice()
      } else {
        fallback.asSlice()
      }
      let nodes = m.elements.asSlice()
      if rows.length == 0 {
        ui.box(
          |ui| {
            ui.padding(16.0)
            ui.height(Length.px(50.0))
            hint(
              &mut ui,
              if String.byteLength(String.view(&m.search)) > 0 {
                "No matching layers."
              } else {
                "This page is a blank canvas."
              },
            )
          },
        )
      }
      let emptyHeight: f32 = if rows.length == 0 {
        50.0
      } else {
        0.0
      }
      layerList(
        &mut ui,
        t,
        "Layers",
        rows.length,
        32.0,
        f32.max(
          80.0,
          m.height - 316.0 - f32.min(154.0, usize.toF32(m.pages.length()) * 31.0) - emptyHeight,
        ),
        m.scroll,
        |top| Message.Scroll { top: top },
        |ui, index| {
          let row = rows[index]
          let e = nodes[row.index]
          ui.box(
            |ui| {
              ui.accessRole(Role.Button)
              ui.tabIndex(0)
              ui.cursor(Cursor.Pointer)
              ui.width(Length.percent(100.0))
              ui.height(Length.px(32.0))
              ui.padding(0.0)
              ui.style(
                &[
                  Property.BoxSizing { value: BoxSizing.BorderBox },
                  Property.BorderRadius { value: corners(0.0) },
                  Property.WhiteSpace { value: WhiteSpace.NoWrap },
                  Property.OverflowX { value: Overflow.Hidden },
                ],
              )
              if e.selected {
                ui.background(t.highlight)
              }
              ui.hover(&[Property.BackgroundColor { color: rgb(0xf1f3ee) }])
              ui.label(m.string(e.name))
              ui.selected(e.selected)
              ui.on(
                EventKind.Click,
                |event| Reply<Message>.EmitAndStop {
                  message: Message.Select { id: e.id, extend: (event.modifiers & MOD_SHIFT) != 0 }
                },
              )
              ui.on(
                EventKind.PointerEnter,
                |event| Reply<Message>.Emit { message: Message.HoverLayer { id: e.id } },
              )
              ui.on(
                EventKind.PointerLeave,
                |event| Reply<Message>.Emit { message: Message.HoverLayer { id: 0 } },
              )
              ui.row(
                |ui| {
                  ui.gap(0.0)
                  ui.style(
                    &[
                      Property.AlignItems { value: Align.Center },
                      Property.Padding {
                        side: Side.Left,
                        value: Length.px(8.0 + f32.min(6.0, u32.toF32(row.depth)) * 12.0),
                      },
                    ],
                  )
                  if row.children {
                    ui.box(
                      |ui| {
                        ui.accessRole(Role.Button)
                        ui.tabIndex(0)
                        ui.cursor(Cursor.Pointer)
                        ui.on(
                          EventKind.Click,
                          |event| Reply<Message>.EmitAndStop {
                            message: Message.Collapse { id: e.id }
                          },
                        )
                        ui.label(
                          if layers.collapsed(m, e.id) {
                            "Expand layer"
                          } else {
                            "Collapse layer"
                          },
                        )
                        ui.width(Length.px(12.0))
                        ui.height(Length.px(22.0))
                        ui.style(
                          &[
                            Property.Display { value: Display.Flex },
                            Property.AlignItems { value: Align.Center },
                          ],
                        )
                        ui.icon(
                          if layers.collapsed(m, e.id) {
                            icons.CHEVRON
                          } else {
                            icons.DOWN
                          },
                        )
                      },
                    )
                  } else {
                    ui.box(
                      |ui| {
                        ui.width(Length.px(9.0))
                      },
                    )
                  }
                  ui.box(
                    |ui| {
                      ui.width(Length.px(20.0))
                      ui.style(&[Property.FlexShrink { value: 0.0 }])
                      ui.color(rgb(0x8a957f))
                      glyph(
                        &mut ui,
                        if e.kind == 2 {
                          icons.TEXT
                        } else if e.kind == 3 {
                          icons.FRAME
                        } else if e.kind == 4 {
                          icons.GROUP
                        } else if e.kind == 1 {
                          icons.ELLIPSE
                        } else {
                          icons.RECT
                        },
                        14.0,
                      )
                    },
                  )
                  ui.box(
                    |ui| {
                      ui.grow(1.0)
                      ui.style(
                        &[
                          Property.MinWidth { value: Length.px(0.0) },
                          Property.OverflowX { value: Overflow.Hidden },
                        ],
                      )
                      ui.fontSize(11.0)
                      ui.color(t.text)
                      ui.text(m.string(e.name))
                    },
                  )
                  let mut flagIndex: u32 = 0
                  while flagIndex < 2 {
                    let bit: u32 = if flagIndex == 0 {
                      2
                    } else {
                      1
                    }
                    let active = (e.shape.flags & bit) != 0
                    ui.box(
                      |ui| {
                        ui.accessRole(Role.Button)
                        ui.tabIndex(0)
                        ui.cursor(Cursor.Pointer)
                        let mut label = ui.alloc(
                          String.copy(
                            if bit == 2 {
                              if active {
                                "Unlock "
                              } else {
                                "Lock "
                              }
                            } else {
                              if active {
                                "Show "
                              } else {
                                "Hide "
                              }
                            },
                          ),
                        )
                        ui.alloc(label.append(m.string(e.name)))
                        ui.label(String.view(&label))
                        ui.width(Length.px(20.0))
                        ui.height(Length.px(22.0))
                        ui.style(&[Property.FlexShrink { value: 0.0 }])
                        ui.on(
                          EventKind.Click,
                          |event| Reply<Message>.EmitAndStop {
                            message: Message.LayerFlag { id: e.id, bit: bit }
                          },
                        )
                        ui.style(
                          &[
                            Property.Opacity {
                              value: if m.hoveredLayer == e.id || active {
                                1.0
                              } else {
                                0.0
                              },
                            },
                          ],
                        )
                        ui.focused(&[Property.Opacity { value: 1.0 }])
                        glyph(
                          &mut ui,
                          if bit == 2 {
                            icons.LOCK
                          } else {
                            icons.EYE
                          },
                          12.0,
                        )
                      },
                    )
                    flagIndex = flagIndex + 1
                  }
                },
              )
            },
          )
        },
      )

      ui.row(
        |ui| {
          ui.height(Length.px(44.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Top)
          ui.fontSize(8.0)
          ui.color(rgb(0xa3ab9c))
          ui.text("YOUR SPACE TO MAKE.")
          spacer(&mut ui)
          iconButton(&mut ui, t, m, icons.HELP, "Keyboard shortcuts", 18)
        },
      )
    },
  )
}

fn pair(ui: &mut Ui<Message>, body: fn(&mut Ui<Message>, bool) -> ()) -> () {
  ui.row(
    |ui| {
      ui.gap(8.0)
      ui.box(
        |ui| {
          ui.grow(1.0)
          ui.style(
            &[
              Property.FlexBasis { value: Length.px(0.0) },
              Property.MinWidth { value: Length.px(0.0) },
            ],
          )
          body(&mut ui, false)
        },
      )
      ui.box(
        |ui| {
          ui.grow(1.0)
          ui.style(
            &[
              Property.FlexBasis { value: Length.px(0.0) },
              Property.MinWidth { value: Length.px(0.0) },
            ],
          )
          body(&mut ui, true)
        },
      )
    },
  )
}

fn inspector(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.column(
    |ui| {
      place(&mut ui, m.width - m.rightWidth(), 56.0, m.rightWidth(), m.canvasHeight())
      ui.background(t.surface)
      line(&mut ui, Side.Left)
      ui.row(
        |ui| {
          ui.height(Length.px(48.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.fontSize(11.0)
          ui.box(
            |ui| {
              ui.style(&[Property.FontWeight { value: 650.0 }])
              ui.text("Design")
            },
          )
          spacer(&mut ui)
          ui.box(
            |ui| {
              ui.fontSize(10.0)
              ui.color(rgb(0x9c9b93))
              let at = m.index(m.primary)
              ui.text(
                if m.selected == 0 || at == usize.MAX {
                  "PAGE"
                } else {
                  let kind = m.elements.get(at).kind
                  if kind == 0 {
                    "RECTANGLE"
                  } else if kind == 1 {
                    "ELLIPSE"
                  } else if kind == 2 {
                    "TEXT"
                  } else if kind == 3 {
                    "FRAME"
                  } else {
                    "GROUP"
                  }
                },
              )
            },
          )
        },
      )
      ui.column(
        |ui| {
          ui.grow(1.0)
          ui.style(
            &[
              Property.MinHeight { value: Length.px(0.0) },
              Property.OverflowY { value: Overflow.Auto },
              Property.OverflowX { value: Overflow.Hidden },
            ],
          )
          if m.selected == 0 {
            panelSection(
              &mut ui,
              t,
              "Page name",
              |ui| {
                let mut i: usize = 0
                while i < m.pages.length() {
                  let p = m.pages.get(i)
                  if p.id == m.page {
                    field(&mut ui, t, m, "Page name", 19, m.string(p.name))
                  }
                  i = i + 1
                }
              },
            )
            panelSection(
              &mut ui,
              t,
              "Canvas",
              |ui| {
                ui.column(
                  |ui| {
                    setting(&mut ui, t, icons.GRID, "Show grid", m.grid, 19)
                    setting(&mut ui, t, icons.SNAP, "Smart guides", m.snap, 20)
                  },
                )
              },
            )
            ui.column(
              |ui| {
                ui.padding(25.0)
                ui.gap(0.0)
                ui.style(
                  &[
                    Property.Padding { side: Side.Top, value: Length.px(32.0) },
                    Property.Padding { side: Side.Bottom, value: Length.px(32.0) },
                    Property.FlexShrink { value: 0.0 },
                  ],
                )
                ui.box(
                  |ui| {
                    ui.fontSize(36.0)
                    ui.color(rgb(0xa3b48b))
                    ui.height(Length.px(54.0))
                    ui.style(&[Property.Margin { side: Side.Bottom, value: Length.px(17.0) }])
                    ui.style(
                      &[
                        Property.Display { value: Display.Flex },
                        Property.AlignItems { value: Align.Center },
                      ],
                    )
                    glyph(&mut ui, icons.SPARK, 28.0)
                  },
                )
                ui.box(
                  |ui| {
                    ui.style(
                      &[
                        Property.FontFamily { family: 3 },
                        Property.LineHeight { value: LineHeight.Number { value: 1.2 } },
                      ],
                    )
                    ui.fontSize(25.0)
                    ui.color(rgb(0x506345))
                    ui.style(&[Property.WhiteSpace { value: WhiteSpace.PreWrap }])
                    ui.text("A space for\nyour next idea.")
                  },
                )
                ui.box(
                  |ui| {
                    ui.style(&[Property.Margin { side: Side.Top, value: Length.px(14.0) }])
                    ui.fontSize(11.0)
                    ui.color(rgb(0x96a18c))
                    ui.style(&[Property.LineHeight { value: LineHeight.Number { value: 1.8 } }])
                    ui.style(&[Property.WhiteSpace { value: WhiteSpace.PreWrap }])
                    ui.text(
                      "Draw a shape, set some type, and make it yours. Everything stays on this device.",
                    )
                  },
                )
                ui.pressable(
                  || Message.Action { code: 18 },
                  |ui| {
                    ui.fontSize(10.0)
                    ui.color(rgb(0x70865c))
                    ui.style(
                      &[
                        Property.Margin { side: Side.Top, value: Length.px(18.0) },
                        Property.FontWeight { value: 600.0 },
                      ],
                    )
                    ui.text("Find your flow  ↗")
                  },
                )
              },
            )
            panelSection(
              &mut ui,
              t,
              "Quick actions",
              |ui| {
                ui.column(
                  |ui| {
                    item(&mut ui, t, icons.FRAME, "Fit to canvas", "⇧1", 7)
                    item(&mut ui, t, icons.PLUS, "Add a page", "", 10)
                    item(&mut ui, t, icons.CLOSE, "Delete this page", "", 11)
                    item(&mut ui, t, icons.EXPORT, "Export SVG", "", 14)
                  },
                )
              },
            )
          } else {
            let at = m.index(m.primary)
            if at != usize.MAX {
              let e = m.elements.get(at)
              let n = e.shape
              panelSection(
                &mut ui,
                t,
                "",
                |ui| {
                  ui.row(
                    |ui| {
                      ui.gap(8.0)
                      ui.fontSize(11.0)
                      ui.style(
                        &[
                          Property.AlignItems { value: Align.Center },
                          Property.FontWeight { value: 600.0 },
                        ],
                      )
                      glyph(
                        &mut ui,
                        if e.kind == 2 {
                          icons.TEXT
                        } else if e.kind == 1 {
                          icons.ELLIPSE
                        } else {
                          icons.RECT
                        },
                        16.0,
                      )
                      if m.selected > 1 {
                        selectionText(&mut ui, m.selected)
                      } else {
                        ui.text(m.string(e.name))
                      }
                    },
                  )
                  field(&mut ui, t, m, "Layer name", 17, m.string(e.name))
                  ui.row(
                    |ui| {
                      ui.style(&[Property.JustifyContent { value: Align.SpaceBetween }])
                      ui.disabled(m.selected < 2)
                      if m.selected < 2 {
                        ui.style(&[Property.Opacity { value: 0.3 }])
                      }
                      iconButton(&mut ui, t, m, icons.LEFT, "Align left", 25)
                      iconButton(&mut ui, t, m, icons.CENTER, "Align center", 26)
                      iconButton(&mut ui, t, m, icons.RIGHT, "Align right", 27)
                      iconButton(&mut ui, t, m, icons.TOP, "Align top", 28)
                      iconButton(&mut ui, t, m, icons.MIDDLE, "Align middle", 29)
                      iconButton(&mut ui, t, m, icons.BOTTOM, "Align bottom", 30)
                    },
                  )
                  section(&mut ui, t, "Position")
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        number(&mut ui, t, m, "Y", 2, n.y)
                      } else {
                        number(&mut ui, t, m, "X", 1, n.x)
                      }
                    },
                  )
                  section(&mut ui, t, "Dimensions")
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        number(&mut ui, t, m, "Height", 4, n.height)
                      } else {
                        number(&mut ui, t, m, "Width", 3, n.width)
                      }
                    },
                  )
                  if m.selected > 1 {
                    hint(&mut ui, "Values apply to all selected layers.")
                  }
                },
              )
              if e.kind == 2 {
                panelSection(
                  &mut ui,
                  t,
                  "Typography",
                  |ui| {
                    let fonts: [string; 3] = ["Arial", "Georgia", "Courier New"]
                    choice(
                      &mut ui,
                      t,
                      702,
                      &m.fontMenu,
                      "Font family",
                      &fonts,
                      u32.toUsize(e.fontFamily),
                      |message| Message.Font { message: message },
                    )
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          let weights: [string; 4] = ["400", "500", "600", "700"]
                          choice(
                            &mut ui,
                            t,
                            703,
                            &m.weightMenu,
                            "Font weight",
                            &weights,
                            u32.toUsize(
                              if e.fontWeight >= 400 {
                                (e.fontWeight - 400) / 100
                              } else {
                                0
                              },
                            ),
                            |message| Message.Weight { message: message },
                          )
                        } else {
                          number(&mut ui, t, m, "Font size", 15, e.fontSize)
                        }
                      },
                    )
                    field(&mut ui, t, m, "Text", 14, m.string(e.text))
                    hint(&mut ui, "Double-click text on the canvas to edit.")
                  },
                )
              }
              panelSection(
                &mut ui,
                t,
                "Appearance",
                |ui| {
                  if e.kind == 4 {
                    number(&mut ui, t, m, "Opacity %", 6, n.opacity * 100.0)
                  } else {
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Corner radius", 7, n.radius)
                        } else {
                          number(&mut ui, t, m, "Opacity %", 6, n.opacity * 100.0)
                        }
                      },
                    )
                    section(&mut ui, t, "Fill")
                    color(&mut ui, t, m, "Fill", 5, n.fill)
                    ui.row(
                      |ui| {
                        ui.gap(6.0)
                        let colors: [u32; 7] = [
                          0x25352bff,
                          0xb8c5acff,
                          0xe6b84eff,
                          0xe3ad90ff,
                          0xf7f5ecff,
                          0xffffffff,
                          0x111111ff,
                        ]
                        let mut i: usize = 0
                        while i < colors.length {
                          let value = colors[i]
                          ui.pressable(
                            || Message.Fill { value: value },
                            |ui| {
                              let name = ui.alloc(format.hex(value))
                              ui.label(String.view(&name))
                              ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
                              ui.width(Length.px(21.0))
                              ui.height(Length.px(21.0))
                              ui.background(sceneColor.rgba(value))
                              border(&mut ui, 1.0, sceneColor.rgba(0x0000000c), 11.0)
                            },
                          )
                          i = i + 1
                        }
                      },
                    )
                  }
                },
              )
              if e.kind == 0 || e.kind == 3 {
                panelSection(
                  &mut ui,
                  t,
                  "Stroke",
                  |ui| {
                    color(&mut ui, t, m, "Stroke", 9, n.border)
                    number(&mut ui, t, m, "Stroke width", 8, n.borderWidth)
                  },
                )
              }
              if e.kind != 4 {
                panelSection(
                  &mut ui,
                  t,
                  "Effects",
                  |ui| {
                    let blends: [string; 16] = [
                      "Normal",
                      "Multiply",
                      "Screen",
                      "Overlay",
                      "Darken",
                      "Lighten",
                      "Color dodge",
                      "Color burn",
                      "Hard light",
                      "Soft light",
                      "Difference",
                      "Exclusion",
                      "Hue",
                      "Saturation",
                      "Color",
                      "Luminosity",
                    ]
                    section(&mut ui, t, "Blend mode")
                    choice(
                      &mut ui,
                      t,
                      701,
                      &m.blendMenu,
                      "Blend mode",
                      &blends,
                      u8.toUsize(n.blend),
                      |message| Message.Blend { message: message },
                    )
                    ui.column(
                      |ui| {
                        ui.gap(8.0)
                        number(&mut ui, t, m, "Layer blur", 20, n.effects.blur)
                        if e.kind != 2 {
                          number(&mut ui, t, m, "Backdrop blur", 21, n.effects.backdropBlur)
                        }
                        number(&mut ui, t, m, "Brightness %", 22, n.effects.brightness * 100.0)
                        number(&mut ui, t, m, "Contrast %", 23, n.effects.contrast * 100.0)
                        number(&mut ui, t, m, "Saturation %", 24, n.effects.saturation * 100.0)
                      },
                    )
                    hint(
                      &mut ui,
                      "Layer blur softens this layer. Backdrop blur softens layers behind it; use a transparent fill to see through.",
                    )
                  },
                )
              }
              if e.kind == 0 || e.kind == 3 {
                panelSection(
                  &mut ui,
                  t,
                  "Drop shadow",
                  |ui| {
                    color(&mut ui, t, m, "Shadow", 10, n.shadow)
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Shadow Y", 13, n.shadowY)
                        } else {
                          number(&mut ui, t, m, "Shadow blur", 11, n.blur)
                        }
                      },
                    )
                    hint(&mut ui, "Use an eight-digit hex value for transparency.")
                  },
                )
                panelSection(
                  &mut ui,
                  t,
                  "Inner shadow",
                  |ui| {
                    color(&mut ui, t, m, "Inner shadow", 26, n.innerShadow)
                    number(&mut ui, t, m, "Inner blur", 27, n.innerBlur)
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Inner Y", 29, n.innerY)
                        } else {
                          number(&mut ui, t, m, "Inner X", 28, n.innerX)
                        }
                      },
                    )
                  },
                )
              }
              panelSection(
                &mut ui,
                t,
                "Arrange",
                |ui| {
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Bring front", 23)
                      } else {
                        button(&mut ui, t, "Send back", 24)
                      }
                    },
                  )
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Delete", 2)
                      } else {
                        button(&mut ui, t, "Duplicate", 3)
                      }
                    },
                  )
                },
              )
              panelSection(
                &mut ui,
                t,
                "Export selection",
                |ui| {
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "PNG", 15)
                      } else {
                        button(&mut ui, t, "SVG", 14)
                      }
                    },
                  )
                },
              )
            }
          }
        },
      )
    },
  )
}

fn canvas(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.key(100)
  ui.box(
    |ui| {
      place(
        &mut ui,
        m.leftWidth(),
        56.0,
        f32.max(100.0, m.canvasWidth()),
        f32.max(100.0, m.height - 83.0),
      )
      ui.testId("canvas")
      ui.label("Design canvas")
      ui.tabIndex(0)
      if m.focusAction == 40 {
        ui.takeFocus()
      }
      ui.on(
        EventKind.Focus,
        |event| Reply<Message>.Emit { message: Message.FocusReturned { action: 40 } },
      )
      ui.cursor(
        if m.gesture == 5 {
          Cursor.Grabbing
        } else if m.tool == 5 || m.space {
          Cursor.Grab
        } else if m.tool == 4 {
          Cursor.Text
        } else if m.tool > 0 {
          Cursor.Crosshair
        } else {
          Cursor.Default
        },
      )

      ui.onPointerDown(
        |e| Reply<Message>.EmitAndStop { message: Message.Down { point: Pointer.from(e) } },
      )

      ui.on(
        EventKind.PointerMove,
        |e| if m.gesture == 0 {
          Reply<Message>.Pass
        } else {
          Reply<Message>.EmitAndStop { message: Message.Move { point: Pointer.from(e) } }
        },
      )

      ui.on(
        EventKind.PointerUp,
        |e| Reply<Message>.EmitAndStop { message: Message.Up { point: Pointer.from(e) } },
      )

      ui.on(
        EventKind.Wheel,
        |e| Reply<Message>.EmitAndStop {
          message: Message.Wheel {
            x: e.x,
            y: e.y,
            dx: e.deltaX,
            dy: e.deltaY,
            zoom: (e.modifiers & (MOD_CONTROL | MOD_META)) != 0,
          }
        },
      )
    },
  )

  if m.hasGuideX {
    let x = m.leftWidth() + (m.guideX - m.cameraX) * m.zoom
    if x >= m.leftWidth() && x < m.width - m.rightWidth() {
      ui.box(
        |ui| {
          place(&mut ui, x, 56.0, 1.0, m.canvasHeight())
          ui.background(rgb(0xcc8059))
          ui.style(&[Property.PointerEvents { value: false }])
        },
      )
    }
  }
  if m.hasGuideY {
    let y = 56.0 + (m.guideY - m.cameraY) * m.zoom
    if y >= 56.0 && y < m.height - 27.0 {
      ui.box(
        |ui| {
          place(&mut ui, m.leftWidth(), y, m.canvasWidth(), 1.0)
          ui.background(rgb(0xcc8059))
          ui.style(&[Property.PointerEvents { value: false }])
        },
      )
    }
  }
  let mut frameIndex: usize = 0
  let mut shown: usize = 0
  while frameIndex < m.frames.length() && shown < 300 {
    let e = m.elements.get(m.frames.get(frameIndex))
    let n = e.shape
    let x = m.leftWidth() + (n.x - m.cameraX) * m.zoom
    let y = 56.0 + (n.y - m.cameraY) * m.zoom - 22.0
    let w = n.width * m.zoom
    if !editing.flag(m, e, 1) && w >= 60.0 && x + w > m.leftWidth() && x < m.width - m.rightWidth()
      && y >= 56.0
      && y < m.height - 27.0 {
      ui.box(
        |ui| {
          place(
            &mut ui,
            f32.max(m.leftWidth(), x),
            y,
            f32.min(w, m.width - m.rightWidth() - x),
            18.0,
          )
          ui.style(
            &[
              Property.PointerEvents { value: false },
              Property.WhiteSpace { value: WhiteSpace.NoWrap },
              Property.OverflowX { value: Overflow.Hidden },
            ],
          )
          ui.fontSize(10.0)
          ui.color(rgb(0x7a8374))
          ui.text(m.string(e.name))
        },
      )
      shown = shown + 1
    }
    frameIndex = frameIndex + 1
  }
  if m.selected > 0 && m.gesture != 4 {
    let b = editing.bounds(m)
    let x = m.leftWidth() + ((b[0] + b[2]) * 0.5 - m.cameraX) * m.zoom
    let y = 56.0 + (b[3] - m.cameraY) * m.zoom + 7.0
    let xs: [f32; 8] = [
      b[0],
      (b[0] + b[2]) * 0.5,
      b[2],
      b[2],
      b[2],
      (b[0] + b[2]) * 0.5,
      b[0],
      b[0],
    ]
    let ys: [f32; 8] = [
      b[1],
      b[1],
      b[1],
      (b[1] + b[3]) * 0.5,
      b[3],
      b[3],
      b[3],
      (b[1] + b[3]) * 0.5,
    ]
    let mut handle: usize = 0
    while handle < 8 {
      let hx = m.leftWidth() + (xs[handle] - m.cameraX) * m.zoom
      let hy = 56.0 + (ys[handle] - m.cameraY) * m.zoom
      if hx >= m.leftWidth() && hx < m.width - m.rightWidth() && hy >= 56.0
        && hy < m.height - 27.0 {
        ui.box(
          |ui| {
            place(&mut ui, hx - 4.0, hy - 4.0, 8.0, 8.0)
            ui.label("Resize handle")
            ui.cursor(
              if handle == 0 || handle == 4 {
                Cursor.ResizeNorthWestSouthEast
              } else if handle == 2 || handle == 6 {
                Cursor.ResizeNorthEastSouthWest
              } else if handle == 1 || handle == 5 {
                Cursor.ResizeVertical
              } else {
                Cursor.ResizeHorizontal
              },
            )
            ui.onPointerDown(
              |event| Reply<Message>.EmitAndStop {
                message: Message.Down { point: Pointer.from(event) }
              },
            )
            ui.on(
              EventKind.PointerMove,
              |event| Reply<Message>.EmitAndStop {
                message: Message.Move { point: Pointer.from(event) }
              },
            )
            ui.on(
              EventKind.PointerUp,
              |event| Reply<Message>.EmitAndStop {
                message: Message.Up { point: Pointer.from(event) }
              },
            )
          },
        )
      }
      handle = handle + 1
    }
    if x >= m.leftWidth() + 40.0 && x < m.width - m.rightWidth() - 40.0 && y >= 56.0
      && y < m.height - 48.0 {
      ui.box(
        |ui| {
          place(&mut ui, x - 50.0, y, 100.0, 17.0)
          ui.style(
            &[
              Property.PointerEvents { value: false },
              Property.Display { value: Display.Flex },
              Property.JustifyContent { value: Align.Center },
            ],
          )
          ui.box(
            |ui| {
              ui.padding(3.0)
              ui.background(rgb(0x567a44))
              ui.color(rgb(0xffffff))
              ui.fontSize(9.0)
              ui.style(&[Property.BorderRadius { value: corners(3.0) }])
              let mut label = ui.alloc(format.decimal(b[2] - b[0]))
              ui.alloc(label.append(" × "))
              let height = ui.alloc(format.decimal(b[3] - b[1]))
              ui.alloc(label.append(String.view(&height)))
              ui.text(String.view(&label))
            },
          )
        },
      )
    }
  }

  if m.editing != 0 {
    let at = m.index(m.editing)
    if at != usize.MAX {
      let e = m.elements.get(at)
      ui.input(
        if m.draftField == 14 {
          String.view(&m.draft)
        } else {
          m.string(e.text)
        },
        |ui| {
          place(
            &mut ui,
            m.leftWidth() + (e.shape.x - m.cameraX) * m.zoom,
            56.0 + (e.shape.y - m.cameraY) * m.zoom,
            f32.max(160.0, e.shape.width * m.zoom),
            f32.max(30.0, e.shape.height * m.zoom),
          )
          ui.accessRole(Role.TextBox)
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.label("Edit text")
          ui.testId("Edit text")
          ui.takeFocus()
          ui.fontSize(f32.min(200.0, e.fontSize * m.zoom))
          ui.color(sceneColor.rgba(e.shape.fill))
          ui.style(
            &[
              Property.FontFamily { family: e.fontFamily + 2 },
              Property.FontWeight { value: u32.toF32(e.fontWeight) },
            ],
          )
          border(&mut ui, 1.0, rgb(0x567a44), 0.0)
          ui.onInput(|v| Message.Draft { field: 14, value: move v })
          ui.onEnter(|| Message.FinishText)
          ui.onBlur(|| Message.FinishText)
          ui.onKeyDown(
            |e| if String.view(&e.key) == "Escape" {
              Reply<Message>.EmitAndStop { message: Message.CancelText }
            } else {
              Reply<Message>.Stop
            },
          )
        },
      )
    }
  }

  ui.row(
    |ui| {
      place(&mut ui, m.leftWidth() + 15.0, 68.0, f32.max(100.0, m.canvasWidth() - 204.0), 20.0)
      ui.fontSize(10.0)
      ui.color(rgb(0x778272))
      ui.gap(6.0)
      ui.text(m.string(m.title))
      ui.text(" / ")
      let mut i: usize = 0
      while i < m.pages.length() {
        let page = m.pages.get(i)
        if page.id == m.page {
          ui.text(m.string(page.name))
        }
        i = i + 1
      }
    },
  )
  ui.row(
    |ui| {
      place(&mut ui, m.width - m.rightWidth() - 144.0, 65.0, 134.0, 36.0)
      ui.background(t.surface)
      border(&mut ui, 1.0, rgb(0xdce2d5), 7.0)
      ui.padding(3.0)
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BoxShadow {
            value: BoxShadow {
              offsetX: 0.0,
              offsetY: 2.0,
              blur: 6.0,
              spread: 0.0,
              color: rgba(0x293a25, 0.06),
              inset: false,
            },
          },
        ],
      )
      iconButton(&mut ui, t, m, icons.MINUS, "Zoom out", 38)
      let percentage = ui.alloc(format.zoomLabel(m.zoom))
      ui.input(
        if m.draftField == 31 {
          String.view(&m.draft)
        } else {
          String.view(&percentage)
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label("Zoom percentage")
          ui.width(Length.px(42.0))
          ui.fontSize(10.0)
          ui.style(&[Property.TextAlign { value: TextAlign.Center }])
          ui.onInput(|value| Message.Draft { field: 31, value: move value })
          ui.onEnter(|| Message.Commit)
          ui.onBlur(|| Message.Commit)
          ui.onKeyDown(|event| Reply<Message>.Stop)
        },
      )
      iconButton(&mut ui, t, m, icons.PLUS, "Zoom in", 39)
      iconButton(&mut ui, t, m, icons.FRAME, "Fit", 7)
    },
  )

  ui.row(
    |ui| {
      let dockWidth: f32 = if m.width <= 850.0 {
        236.0
      } else {
        278.0
      }
      let dockHeight: f32 = if m.width <= 850.0 {
        49.0
      } else {
        53.0
      }
      place(
        &mut ui,
        (m.canvasWidth() - dockWidth) * 0.5 + m.leftWidth(),
        m.height - 50.0 - dockHeight,
        dockWidth,
        dockHeight,
      )
      ui.background(t.surface)
      ui.style(
        &[
          Property.BorderRadius { value: corners(12.0) },
          Property.BoxShadow {
            value: BoxShadow {
              offsetX: 0.0,
              offsetY: 8.0,
              blur: 30.0,
              spread: 0.0,
              color: rgba(0x2d3c27, 0.12),
              inset: false,
            },
          },
        ],
      )
      border(&mut ui, 1.0, t.border, 12.0)
      ui.padding(4.5)
      ui.gap(3.0)
      let symbols: [u32; 6] = [
        icons.SELECT,
        icons.FRAME,
        icons.RECT,
        icons.ELLIPSE,
        icons.TEXT,
        icons.HAND,
      ]
      let names: [string; 6] = ["V", "F", "R", "O", "T", "H"]
      let labels: [string; 6] = ["Select", "Frame", "Rectangle", "Ellipse", "Text", "Hand"]
      let mut i: usize = 0
      while i < 6 {
        let kind = usize.toU32(i)
        ui.pressable(
          || Message.Tool { kind: kind },
          |ui| {
            ui.width(
              Length.px(
                if m.width <= 850.0 {
                  35.0
                } else {
                  42.0
                },
              ),
            )
            ui.height(
              Length.px(
                if m.width <= 850.0 {
                  38.0
                } else {
                  42.0
                },
              ),
            )
            ui.style(
              &[
                Property.Display { value: Display.Flex },
                Property.FlexDirection { value: FlexDirection.Row },
                Property.Position { value: Position.Relative },
                Property.BoxSizing { value: BoxSizing.BorderBox },
                Property.AlignItems { value: Align.Center },
                Property.JustifyContent { value: Align.Center },
              ],
            )
            ui.padding(7.0)
            ui.label(labels[i])
            ui.testId(labels[i])
            ui.selected(m.tool == kind)
            let tipKey = 11000 + usize.toU64(i)
            let mut tip = ui.alloc(String.copy(labels[i]))
            ui.alloc(tip.append(" · "))
            ui.alloc(tip.append(names[i]))
            tooltip(
              &mut ui,
              t,
              tipKey,
              m.tooltip == tipKey,
              String.view(&tip),
              |show| Message.Tooltip {
                id: if show {
                  tipKey
                } else {
                  0
                },
              },
            )
            ui.style(&[Property.BorderRadius { value: corners(6.0) }])
            if m.tool == kind {
              ui.background(t.accent)
              ui.color(rgb(0xffffff))
            }
            ui.color(
              if m.tool == kind {
                rgb(0xeff4e4)
              } else {
                rgb(0x798570)
              },
            )
            glyph(&mut ui, symbols[i], 20.0)
            ui.box(
              |ui| {
                place(
                  &mut ui,
                  if m.width <= 850.0 {
                    23.0
                  } else {
                    30.0
                  },
                  if m.width <= 850.0 {
                    25.0
                  } else {
                    29.0
                  },
                  8.0,
                  9.0,
                )
                ui.fontSize(7.0)
                ui.text(names[i])
              },
            )
          },
        )
        i = i + 1
      }
    },
  )
}

fn menu(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  if m.menu == 0 {
    return ()
  }
  ui.overlay(
    900,
    |ui| {
      ui.color(t.text)
      ui.fontSize(12.0)
      ui.style(
        &[
          Property.FontFamily { family: 1 },
          Property.LineHeight { value: LineHeight.Number { value: 1.5 } },
        ],
      )
      place(&mut ui, 0.0, 0.0, m.width, m.height)
      ui.onPointerDown(|event| Reply<Message>.EmitAndStop { message: Message.Action { code: 35 } })
      if m.menu != 2 {
        ui.background(rgba(0x24301d, 0.188))
        ui.style(&[Property.BackdropBlur { value: 3.0 }])
      }
      ui.column(
        |ui| {
          place(
            &mut ui,
            if m.menu == 2 {
              12.0
            } else {
              (m.width - 460.0) * 0.5
            },
            if m.menu == 2 {
              48.0
            } else {
              m.height * 0.12
            },
            if m.menu == 2 {
              272.0
            } else {
              460.0
            },
            0.0,
          )
          ui.style(
            &[
              Property.Height { value: Length.Auto },
              Property.MaxHeight { value: Length.px(m.height * 0.75) },
            ],
          )
          ui.background(t.surface)
          border(&mut ui, 1.0, t.border, 12.0)
          ui.style(
            &[
              Property.BoxShadow {
                value: BoxShadow {
                  offsetX: 0.0,
                  offsetY: 20.0,
                  blur: 70.0,
                  spread: 0.0,
                  color: rgba(0x1d2b17, 0.18),
                  inset: false,
                },
              },
            ],
          )
          ui.focusTrap(true)
          ui.onPointerDown(|event| Reply<Message>.Stop)
          ui.onKeyDown(
            |event| if String.view(&event.key) == "Escape" {
              Reply<Message>.EmitAndStop { message: Message.Action { code: 35 } }
            } else {
              Reply<Message>.Stop
            },
          )
          if m.menu == 2 {
            ui.accessRole(Role.Menu)
            ui.label("File actions")
            ui.padding(6.0)
            item(&mut ui, t, icons.PLUS, "New document", "", 12)
            item(&mut ui, t, icons.FILE, "Open document…", "⌘O", 36)
            line(&mut ui, Side.Top)
            item(&mut ui, t, icons.EXPORT, "Save document", "⌘S", 13)
            item(&mut ui, t, icons.FILE, "Save as…", "⇧⌘S", 37)
            item(&mut ui, t, icons.EXPORT, "Export SVG", "", 14)
            item(&mut ui, t, icons.EXPORT, "Export PNG", "", 15)
            item(&mut ui, t, icons.HELP, "Keyboard shortcuts", "?", 18)
            item(&mut ui, t, icons.CLOSE, "Close menu", "Esc", 35)
          } else {
            ui.accessRole(Role.Dialog)
            ui.label(
              if m.menu == 1 {
                "Commands"
              } else {
                "Keyboard shortcuts"
              },
            )
            ui.row(
              |ui| {
                ui.height(Length.px(47.0))
                ui.padding(16.0)
                ui.style(
                  &[
                    Property.AlignItems { value: Align.Center },
                    Property.FlexShrink { value: 0.0 },
                    Property.BoxSizing { value: BoxSizing.BorderBox },
                  ],
                )
                line(&mut ui, Side.Bottom)
                ui.fontSize(14.0)
                ui.style(&[Property.FontWeight { value: 600.0 }])
                ui.color(rgb(0x435c36))
                ui.text(
                  if m.menu == 1 {
                    "Commands"
                  } else {
                    "Keyboard shortcuts"
                  },
                )
                spacer(&mut ui)
                iconButton(&mut ui, t, m, icons.CLOSE, "Close dialog", 35)
              },
            )
            ui.column(
              |ui| {
                ui.padding(12.0)
                ui.style(
                  &[
                    Property.OverflowY { value: Overflow.Auto },
                    Property.MinHeight { value: Length.px(0.0) },
                  ],
                )
                if m.menu == 1 {
                  let titles: [string; 18] = [
                    "Fit everything",
                    "Zoom to selection",
                    "100% zoom",
                    "Duplicate selection",
                    "Group selection",
                    "Ungroup selection",
                    "Bring to front",
                    "Send to back",
                    "Toggle grid",
                    "Toggle smart guides",
                    "Add page",
                    "Add effects playground",
                    "Add 100k rectangles",
                    "Add 100k image + text cards",
                    "Save document",
                    "Open document…",
                    "New document",
                    "Save as…",
                  ]
                  let codes: [u32; 18] = [
                    7,
                    8,
                    9,
                    3,
                    21,
                    22,
                    23,
                    24,
                    19,
                    20,
                    10,
                    32,
                    31,
                    42,
                    13,
                    36,
                    12,
                    37,
                  ]
                  let shortcuts: [string; 18] = [
                    "⇧1",
                    "⇧2",
                    "0",
                    "⌘D",
                    "⌘G",
                    "⇧⌘G",
                    "⌘]",
                    "⌘[",
                    "",
                    "",
                    "",
                    "",
                    "",
                    "",
                    "⌘S",
                    "⌘O",
                    "",
                    "⇧⌘S",
                  ]
                  let symbols: [u32; 18] = [
                    icons.FRAME,
                    icons.SELECT,
                    icons.SEARCH,
                    icons.RECT,
                    icons.GROUP,
                    icons.GROUP,
                    icons.TOP,
                    icons.BOTTOM,
                    icons.GRID,
                    icons.SNAP,
                    icons.PLUS,
                    icons.RECT,
                    icons.RECT,
                    icons.RECT,
                    icons.EXPORT,
                    icons.FILE,
                    icons.PLUS,
                    icons.FILE,
                  ]
                  let mut first: usize = 0
                  while first < titles.length
                    && !commands.matches(titles[first], String.view(&m.commandSearch)) {
                    first = first + 1
                  }
                  ui.input(
                    String.view(&m.commandSearch),
                    |ui| {
                      ui.accessRole(Role.TextBox)
                      ui.label("Search commands")
                      ui.placeholder("What would you like to do?")
                      ui.takeFocus()
                      ui.height(Length.px(44.0))
                      ui.padding(10.0)
                      ui.background(rgb(0xf4f7ee))
                      ui.fontSize(12.0)
                      border(&mut ui, 1.0, t.border, 6.0)
                      ui.focused(&[Property.BorderColor { color: rgb(0x63885b) }])
                      ui.style(
                        &[
                          Property.Margin { side: Side.Bottom, value: Length.px(10.0) },
                          Property.Margin { side: Side.Left, value: Length.px(6.0) },
                          Property.Margin { side: Side.Right, value: Length.px(6.0) },
                          Property.FlexShrink { value: 0.0 },
                          Property.BoxSizing { value: BoxSizing.BorderBox },
                        ],
                      )
                      ui.onInput(|value| Message.CommandSearch { value: move value })
                      ui.onKeyDown(
                        |event| if String.view(&event.key) == "Enter" && first < codes.length {
                          Reply<Message>.EmitAndStop {
                            message: Message.Action { code: codes[first] }
                          }
                        } else if String.view(&event.key) == "Escape" {
                          Reply<Message>.EmitAndStop { message: Message.Action { code: 35 } }
                        } else {
                          Reply<Message>.Stop
                        },
                      )
                    },
                  )
                  let mut i: usize = 0
                  while i < titles.length {
                    if commands.matches(titles[i], String.view(&m.commandSearch)) {
                      item(&mut ui, t, symbols[i], titles[i], shortcuts[i], codes[i])
                    }
                    i = i + 1
                  }
                  if first == titles.length {
                    hint(&mut ui, "No matching commands.")
                  }
                } else {
                  ui.box(
                    |ui| {
                      ui.fontSize(11.0)
                      ui.color(rgb(0x929f85))
                      ui.style(
                        &[
                          Property.LineHeight { value: LineHeight.Number { value: 1.8 } },
                          Property.Padding { side: Side.Left, value: Length.px(10.0) },
                          Property.Padding { side: Side.Right, value: Length.px(10.0) },
                          Property.Margin { side: Side.Bottom, value: Length.px(15.0) },
                        ],
                      )
                      ui.text(
                        "A few familiar gestures to keep your ideas moving. Use Ctrl in place of ⌘ on Windows and Linux.",
                      )
                    },
                  )
                  let titles: [string; 15] = [
                    "Move / Frame / Rectangle",
                    "Ellipse / Text / Hand",
                    "Pan canvas",
                    "Zoom at pointer",
                    "Select more layers",
                    "Draw square / keep proportions",
                    "Duplicate while dragging",
                    "Skip smart guides",
                    "Undo / Redo",
                    "Copy / Cut / Paste",
                    "Group / Ungroup",
                    "Nudge / Large nudge",
                    "Fit all / Fit selection",
                    "Commands / Save file",
                    "Cancel gesture",
                  ]
                  let keys: [string; 15] = [
                    "V / F / R",
                    "O / T / H",
                    "Space + drag",
                    "⌘ + scroll / pinch",
                    "Shift + click",
                    "Shift + drag",
                    "Alt + drag",
                    "Alt while dragging",
                    "⌘Z / ⇧⌘Z",
                    "⌘C / ⌘X / ⌘V",
                    "⌘G / ⇧⌘G",
                    "Arrows / Shift + arrows",
                    "⇧1 / ⇧2",
                    "⌘K / ⌘S",
                    "Esc",
                  ]
                  let mut i: usize = 0
                  while i < titles.length {
                    ui.row(
                      |ui| {
                        ui.height(Length.px(28.5))
                        ui.style(
                          &[
                            Property.AlignItems { value: Align.Center },
                            Property.FlexShrink { value: 0.0 },
                          ],
                        )
                        ui.style(
                          &[
                            Property.Padding { side: Side.Left, value: Length.px(10.0) },
                            Property.Padding { side: Side.Right, value: Length.px(10.0) },
                          ],
                        )
                        ui.fontSize(11.0)
                        ui.color(rgb(0x6e7e61))
                        ui.text(titles[i])
                        spacer(&mut ui)
                        hint(&mut ui, keys[i])
                      },
                    )
                    i = i + 1
                  }
                }
              },
            )
          }
        },
      )
    },
  )
}

pub fn render(m: &Studio, ui: &mut Ui<Message>) -> () {
  let t = theme()

  ui.box(
    |ui| {
      ui.width(Length.percent(100.0))
      ui.height(Length.percent(100.0))
      ui.tabIndex(-1)
      ui.takeFocus()
      ui.color(t.text)
      ui.fontSize(12.0)
      ui.style(
        &[
          Property.FontFamily { family: 1 },
          Property.LineHeight { value: LineHeight.Number { value: 1.5 } },
          Property.Position { value: Position.Relative },
        ],
      )

      ui.onKeyDown(
        |e| if String.view(&e.key) == " " {
          Reply<Message>.Emit { message: Message.Space { pressed: true } }
        } else {
          Reply<Message>.Emit {
            message: Message.Key { key: uiCopy(String.view(&e.key)), modifiers: e.modifiers }
          }
        },
      )
      ui.on(
        EventKind.KeyUp,
        |e| if String.view(&e.key) == " " {
          Reply<Message>.Emit { message: Message.Space { pressed: false } }
        } else {
          Reply<Message>.Pass
        },
      )

      canvas(&mut ui, &t, m)

      // The canvas adds/removes overlays as selection changes. Shell identity must
      // not depend on that sibling count, or edits can replace the focused control.
      ui.key(200)
      header(&mut ui, &t, m)
      if m.panels {
        ui.key(201)
        sidebar(&mut ui, &t, m)
        ui.key(202)
        inspector(&mut ui, &t, m)
      }

      ui.key(203)
      ui.row(
        |ui| {
          place(&mut ui, 0.0, m.height - 27.0, m.width, 27.0)
          ui.background(t.surface)
          ui.padding(12.0)
          ui.style(&[Property.AlignItems { value: Align.Center }])
          line(&mut ui, Side.Top)
          ui.gap(10.0)
          ui.label("Selection status")
          ui.fontSize(9.0)
          ui.color(t.mutedText)
          ui.box(
            |ui| {
              ui.width(Length.px(4.0))
              ui.height(Length.px(4.0))
              ui.background(rgb(0x7e9767))
              ui.style(&[Property.BorderRadius { value: corners(2.0) }])
            },
          )
          if m.selected > 0 {
            selectionText(&mut ui, m.selected)
          } else {
            ui.text(
              if String.byteLength(String.view(&m.notice)) > 0 {
                String.view(&m.notice)
              } else {
                "Ready to make something"
              },
            )
          }
          if m.width > 1100.0 {
            ui.box(
              |ui| {
                ui.text("Space to pan · Cmd/Ctrl + scroll to zoom")
              },
            )
          }
          spacer(&mut ui)
          ui.pressable(
            || Message.Action { code: 20 },
            |ui| {
              ui.style(
                &[
                  Property.Display { value: Display.Flex },
                  Property.FlexDirection { value: FlexDirection.Row },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              ui.gap(4.0)
              ui.label("Toggle snapping")
              glyph(&mut ui, icons.SNAP, 12.0)
              ui.text("Snap")
            },
          )
          ui.pressable(
            || Message.Action { code: 19 },
            |ui| {
              ui.style(
                &[
                  Property.Display { value: Display.Flex },
                  Property.FlexDirection { value: FlexDirection.Row },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              ui.gap(4.0)
              ui.label("Toggle grid")
              glyph(&mut ui, icons.GRID, 12.0)
              ui.text("Grid")
            },
          )
          ui.text("SILK STUDIO")
        },
      )
      menu(&mut ui, &t, m)
      colorPicker(&mut ui, &t, m)
    },
  )
}

fn selectionText(ui: &mut Ui<Message>, count: usize) -> () {
  let mut label = ui.alloc(format.decimal(usize.toF32(count)))
  ui.alloc(
    label.append(
      if count == 1 {
        " layer selected"
      } else {
        " layers selected"
      },
    ),
  )
  ui.text(String.view(&label))
}

fn uiCopy(value: string) -> String {
  let mut h = Heap.make()
  return h.alloc(String.copy(value))
}
