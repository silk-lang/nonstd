//! Studio's native controls. The canvas is one input surface
//! Drawing layers are not UI nodes.
import ui_scene.color as sceneColor
import silk.num.u8
import model { Studio, Message, Pointer, Element }
import format
import icons
import layers { Row }
import layers
import ui_tree.lib { Batch }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import ui_app.heap { Heap }
import ui_app.ui { Ui, Reply }
import ui_components.lib {
  Theme,
  rgb,
  rgba,
  border,
  corners,
  spacer,
  buttonWith,
  Tone,
  visibleRows,
  select
}
import ui_tree.node { EventKind }
import ui_tree.input { MOD_CONTROL, MOD_META, MOD_SHIFT }
import ui_tree.mutation {
  Property,
  Length,
  Position,
  Side,
  Align,
  Overflow,
  BoxSizing,
  Cursor,
  WhiteSpace,
  Role,
  Display,
  FlexDirection,
  BorderStyle,
  BoxShadow,
  FontStyle,
  LineHeight
}
import silk.collections.list { List }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.u64
import silk.num.usize

fn theme() -> Theme {
  let mut t = Theme.light(1)
  t.background = rgb(0xfcfcfa)
  t.surface = rgb(0xfcfcfa)
  t.text = rgb(0x30372e)
  t.mutedText = rgb(0x7a8374)
  t.border = rgb(0xdfe3da)
  t.accent = rgb(0x2d4535)
  t.accentHover = rgb(0x3f5945)
  t.highlight = rgb(0xe9efdf)
  t.fontSize = 12.0
  t.controlHeight = 30.0
  return t
}

/// Registers the native UI's icon resources before the first view is mounted.
pub effect fn resources(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run icons.resources(&mut batch)
}

fn iconButton(ui: &mut Ui<Message>, t: &Theme, icon: u32, label: string, code: u32) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(label)
      ui.testId(label)
      ui.width(Length.px(28.0))
      ui.height(Length.px(28.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.BoxSizing { value: BoxSizing.BorderBox },
          Property.AlignItems { value: Align.Center },
          Property.JustifyContent { value: Align.Center },
          Property.BorderRadius { value: corners(5.0) },
        ],
      )
      ui.hover(&[Property.BackgroundColor { color: sceneColor.rgb(0xeaf0e3) }])
      ui.color(rgb(0x747d70))
      glyph(&mut ui, icon, 18.0)
    },
  )
}

fn glyph(ui: &mut Ui<Message>, resource: u32, size: f32) -> () {
  ui.box(
    |ui| {
      ui.fontSize(size)
      ui.width(Length.px(size))
      ui.height(Length.px(size))
      ui.style(&[Property.FlexShrink { value: 0.0 }])
      ui.icon(resource)
    },
  )
}

fn line(ui: &mut Ui<Message>, side: Side) -> () {
  ui.style(
    &[
      Property.BorderWidth { side: side, value: 1.0 },
      Property.BorderStyle { value: BorderStyle.Solid },
      Property.BorderColor { color: rgb(0xe8ebe3) },
    ],
  )
}

fn section(ui: &mut Ui<Message>, t: &Theme, name: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(10.0)
      ui.color(rgb(0x626e5b))
      ui.style(&[Property.FontWeight { value: 650.0 }])
      ui.text(name)
    },
  )
}

fn panelSection(
  ui: &mut Ui<Message>,
  t: &Theme,
  title: string,
  body: fn(&mut Ui<Message>) -> (),
) -> () {
  ui.column(
    |ui| {
      ui.padding(15.0)
      ui.gap(10.0)
      ui.style(
        &[
          Property.Padding { side: Side.Top, value: Length.px(17.0) },
          Property.Padding { side: Side.Bottom, value: Length.px(17.0) },
          Property.FlexShrink { value: 0.0 },
        ],
      )
      line(&mut ui, Side.Bottom)
      if title != "" {
        section(&mut ui, t, title)
      }
      body(&mut ui)
    },
  )
}

fn hint(ui: &mut Ui<Message>, text: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(9.0)
      ui.color(rgb(0x97a08f))
      ui.style(&[Property.LineHeight { value: LineHeight.Number { value: 1.6 } }])
      ui.text(text)
    },
  )
}

fn item(
  ui: &mut Ui<Message>,
  t: &Theme,
  icon: u32,
  title: string,
  shortcut: string,
  code: u32,
) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(title)
      ui.height(Length.px(33.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.AlignItems { value: Align.Center },
          Property.BoxSizing { value: BoxSizing.BorderBox },
          Property.BorderRadius { value: corners(5.0) },
        ],
      )
      ui.padding(8.0)
      ui.gap(8.0)
      ui.fontSize(11.0)
      ui.color(rgb(0x65765a))
      ui.hover(&[Property.BackgroundColor { color: rgb(0xedf2e5) }])
      glyph(&mut ui, icon, 14.0)
      ui.text(title)
      spacer(&mut ui)
      hint(&mut ui, shortcut)
    },
  )
}

fn setting(
  ui: &mut Ui<Message>,
  t: &Theme,
  icon: u32,
  title: string,
  enabled: bool,
  code: u32,
) -> () {
  ui.pressable(
    || Message.Action { code: code },
    |ui| {
      ui.label(title)
      ui.accessRole(Role.Switch)
      ui.checked(enabled)
      ui.height(Length.px(28.0))
      ui.style(
        &[
          Property.Display { value: Display.Flex },
          Property.FlexDirection { value: FlexDirection.Row },
          Property.AlignItems { value: Align.Center },
        ],
      )
      ui.gap(8.0)
      ui.fontSize(11.0)
      ui.color(rgb(0x758269))
      glyph(&mut ui, icon, 16.0)
      ui.text(title)
      spacer(&mut ui)
      ui.box(
        |ui| {
          ui.width(Length.px(25.0))
          ui.height(Length.px(14.0))
          ui.background(
            if enabled {
              rgb(0x728c5e)
            } else {
              rgb(0xdfe4d8)
            },
          )
          ui.style(
            &[
              Property.Position { value: Position.Relative },
              Property.BorderRadius { value: corners(20.0) },
            ],
          )
          ui.box(
            |ui| {
              place(
                &mut ui,
                if enabled {
                  13.0
                } else {
                  2.0
                },
                2.0,
                10.0,
                10.0,
              )
              ui.background(rgb(0xffffff))
              ui.style(&[Property.BorderRadius { value: corners(10.0) }])
            },
          )
        },
      )
    },
  )
}

fn place(ui: &mut Ui<Message>, x: f32, y: f32, w: f32, h: f32) -> () {
  ui.style(
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset { side: Side.Left, value: Length.px(x) },
      Property.Inset { side: Side.Top, value: Length.px(y) },
      Property.Width { value: Length.px(w) },
      Property.Height { value: Length.px(h) },
      Property.BoxSizing { value: BoxSizing.BorderBox },
    ],
  )
}

fn button(ui: &mut Ui<Message>, t: &Theme, label: string, code: u32) -> () {
  buttonWith(&mut ui, t, Tone.Ghost, false, label, || Message.Action { code: code })
}

fn field(
  ui: &mut Ui<Message>,
  t: &Theme,
  m: &Studio,
  label: string,
  key: u32,
  value: string,
) -> () {
  ui.row(
    |ui| {
      ui.height(Length.px(30.0))
      ui.width(Length.percent(100.0))
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BoxSizing { value: BoxSizing.BorderBox },
        ],
      )
      ui.gap(6.0)
      ui.padding(6.0)
      border(&mut ui, 1.0, t.border, 5.0)
      ui.background(rgb(0xf5f6f1))
      if key != 19 && key != 14 && key != 5 && key != 9 && key != 10 && key != 26 {
        ui.box(
          |ui| {
            ui.fontSize(9.0)
            ui.color(t.mutedText)
            if label == "Width" {
              ui.text("W")
            } else if label == "Height" {
              ui.text("H")
            } else if label == "Corner radius" {
              ui.text("Radius")
            } else if label == "Opacity %" {
              ui.text("Opacity %")
            } else if label == "Backdrop blur" {
              ui.text("BG blur")
            } else if label == "Saturation %" {
              ui.text("Sat %")
            } else if label == "Contrast %" {
              ui.text("Ctr %")
            } else {
              ui.text(label)
            }
          },
        )
      }
      ui.input(
        if m.draftField == key {
          String.view(&m.draft)
        } else {
          value
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label(label)
          ui.testId(label)
          ui.grow(1.0)
          ui.style(
            &[
              Property.MinWidth { value: Length.px(0.0) },
              Property.BoxSizing { value: BoxSizing.BorderBox },
            ],
          )
          ui.fontSize(11.0)
          ui.onInput(|v| Message.Draft { field: key, value: move v })
          ui.onEnter(|| Message.Commit)
          ui.onBlur(|| Message.Commit)
          ui.onKeyDown(|e| Reply<Message>.Stop)
        },
      )
    },
  )
}

fn number(ui: &mut Ui<Message>, t: &Theme, m: &Studio, label: string, key: u32, value: f32) -> () {
  let text = ui.alloc(format.decimal(value))
  field(&mut ui, t, m, label, key, String.view(&text))
}

fn color(ui: &mut Ui<Message>, t: &Theme, m: &Studio, label: string, key: u32, value: u32) -> () {
  ui.row(
    |ui| {
      ui.gap(8.0)
      ui.style(&[Property.AlignItems { value: Align.Center }])
      ui.box(
        |ui| {
          ui.width(Length.px(20.0))
          ui.height(Length.px(20.0))
          ui.background(sceneColor.rgba(value))
          border(&mut ui, 1.0, rgb(0xdfe3da), 4.0)
        },
      )
      ui.box(
        |ui| {
          ui.grow(1.0)
          ui.style(&[Property.MinWidth { value: Length.px(0.0) }])
          let text = ui.alloc(format.hex(value))
          field(&mut ui, t, m, label, key, String.view(&text))
        },
      )
    },
  )
}

fn header(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.row(
    |ui| {
      place(&mut ui, 0.0, 0.0, m.width, 56.0)
      ui.padding(12.0)
      ui.gap(9.0)
      ui.style(&[Property.AlignItems { value: Align.Center }])
      ui.background(t.surface)
      line(&mut ui, Side.Bottom)
      ui.pressable(
        || Message.Action { code: 17 },
        |ui| {
          ui.label("File")
          ui.testId("File")
          ui.width(Length.px(28.0))
          ui.height(Length.px(28.0))
          ui.style(
            &[
              Property.Display { value: Display.Flex },
              Property.AlignItems { value: Align.Center },
              Property.JustifyContent { value: Align.Center },
              Property.BorderRadius { value: corners(8.0) },
              Property.FontFamily { family: 3 },
              Property.FontStyle { value: FontStyle.Italic },
            ],
          )
          ui.background(t.accent)
          ui.color(rgb(0xedf2e4))
          ui.fontSize(27.0)
          ui.text("s")
        },
      )
      ui.row(
        |ui| {
          ui.gap(3.0)
          ui.fontSize(16.0)
          ui.style(&[Property.FontWeight { value: 650.0 }])
          ui.text("silk")
          ui.box(
            |ui| {
              ui.color(rgb(0x90988b))
              ui.style(&[Property.FontWeight { value: 400.0 }])
              ui.text("studio")
            },
          )
        },
      )
      ui.box(
        |ui| {
          ui.width(Length.px(19.0))
          ui.height(Length.px(18.0))
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.style(&[Property.Padding { side: Side.Left, value: Length.px(9.0) }])
          ui.box(
            |ui| {
              ui.width(Length.px(1.0))
              ui.height(Length.px(18.0))
              ui.background(t.border)
            },
          )
        },
      )
      ui.input(
        if m.draftField == 18 {
          String.view(&m.draft)
        } else {
          m.string(m.title)
        },
        |ui| {
          ui.accessRole(Role.TextBox)
          ui.label("Document name")
          ui.width(Length.px(170.0))
          ui.height(Length.px(30.0))
          ui.padding(7.0)
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.fontSize(12.0)
          ui.onInput(|v| Message.Draft { field: 18, value: move v })
          ui.onBlur(|| Message.Commit)
          ui.onEnter(|| Message.Commit)
          ui.onKeyDown(|e| Reply<Message>.Stop)
        },
      )
      ui.box(
        |ui| {
          ui.padding(4.0)
          ui.fontSize(8.0)
          ui.color(t.mutedText)
          ui.background(rgb(0xeef1e9))
          ui.style(&[Property.BorderRadius { value: corners(3.0) }])
          ui.text("LOCAL")
        },
      )
      spacer(&mut ui)
      if m.width >= 1100.0 {
        ui.row(
          |ui| {
            ui.gap(5.0)
            ui.fontSize(10.0)
            ui.color(rgb(0x7e8977))
            ui.style(
              &[
                Property.AlignItems { value: Align.Center },
                Property.Padding { side: Side.Right, value: Length.px(12.0) },
              ],
            )
            glyph(&mut ui, icons.CHECK, 13.0)
            ui.text(
              if m.savedRevision == m.revision {
                "Saved on this device"
              } else {
                "Saving…"
              },
            )
          },
        )
      }
      ui.box(
        |ui| {
          ui.disabled(m.past.length() == 0)
          if m.past.length() == 0 {
            ui.style(&[Property.Opacity { value: 0.3 }])
          }
          iconButton(&mut ui, t, icons.UNDO, "Undo", 0)
        },
      )
      ui.box(
        |ui| {
          ui.disabled(m.future.length() == 0)
          if m.future.length() == 0 {
            ui.style(&[Property.Opacity { value: 0.3 }])
          }
          iconButton(&mut ui, t, icons.REDO, "Redo", 1)
        },
      )
      ui.box(
        |ui| {
          ui.width(Length.px(1.0))
          ui.height(Length.px(18.0))
          ui.background(t.border)
        },
      )
      iconButton(&mut ui, t, icons.SEARCH, "Commands", 16)
      ui.pressable(
        || Message.Action { code: 15 },
        |ui| {
          ui.label("Export PNG")
          ui.height(Length.px(31.0))
          ui.padding(9.0)
          ui.gap(8.0)
          ui.style(
            &[
              Property.Display { value: Display.Flex },
              Property.FlexDirection { value: FlexDirection.Row },
              Property.AlignItems { value: Align.Center },
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.BorderRadius { value: corners(6.0) },
            ],
          )
          ui.fontSize(11.0)
          ui.background(t.accent)
          ui.color(rgb(0xffffff))
          glyph(&mut ui, icons.EXPORT, 15.0)
          ui.text("Export PNG")
        },
      )
    },
  )
}

fn layerList(
  ui: &mut Ui<Message>,
  t: &Theme,
  label: string,
  count: usize,
  rowHeight: f32,
  height: f32,
  offset: f32,
  onScroll: fn(f32) -> Message,
  row: fn(&mut Ui<Message>, usize) -> (),
) -> () {
  let window = visibleRows(count, rowHeight, height, offset, 4)
  ui.column(
    |ui| {
      ui.accessRole(Role.List)
      ui.label(label)
      ui.height(Length.px(height))
      ui.style(
        &[
          Property.OverflowY { value: Overflow.Auto },
          Property.OverflowX { value: Overflow.Hidden },
          Property.FlexShrink { value: 0.0 },
        ],
      )
      ui.on(EventKind.Scroll, |event| Reply<Message>.Emit { message: onScroll(event.y) })
      ui.box(
        |ui| {
          ui.height(Length.px(usize.toF32(window.first) * rowHeight))
          ui.style(&[Property.FlexShrink { value: 0.0 }])
        },
      )
      let mut index = window.first
      while index < window.end {
        ui.key(usize.toU64(index))
        ui.row(
          |ui| {
            ui.accessRole(Role.ListItem)
            ui.height(Length.px(rowHeight))
            ui.style(
              &[Property.FlexShrink { value: 0.0 }, Property.AlignItems { value: Align.Center }],
            )
            row(&mut ui, index)
          },
        )
        index = index + 1
      }
      ui.box(
        |ui| {
          ui.height(Length.px(usize.toF32(count - window.end) * rowHeight))
          ui.style(&[Property.FlexShrink { value: 0.0 }])
        },
      )
    },
  )
}

fn sidebar(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.column(
    |ui| {
      place(&mut ui, 0.0, 56.0, 224.0, m.height - 83.0)
      ui.background(t.surface)
      line(&mut ui, Side.Right)
      ui.fontSize(11.0)
      ui.row(
        |ui| {
          ui.height(Length.px(48.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.box(
            |ui| {
              ui.style(&[Property.FontWeight { value: 650.0 }])
              ui.text("Workspace")
            },
          )
          spacer(&mut ui)
          iconButton(&mut ui, t, icons.MORE, "Open document", 36)
        },
      )
      ui.column(
        |ui| {
          ui.padding(10.0)
          ui.style(
            &[
              Property.Padding { side: Side.Top, value: Length.px(14.0) },
              Property.Padding { side: Side.Bottom, value: Length.px(12.0) },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.row(
            |ui| {
              ui.height(Length.px(34.0))
              ui.style(&[Property.AlignItems { value: Align.Center }])
              ui.box(
                |ui| {
                  ui.padding(6.0)
                  section(&mut ui, t, "Pages")
                },
              )
              spacer(&mut ui)
              iconButton(&mut ui, t, icons.PLUS, "Add page", 10)
            },
          )
          ui.each(
            m.pages.asSlice(),
            |p| u32.toU64(p.id),
            |ui, p| {
              ui.pressable(
                || Message.Page { id: p.id },
                |ui| {
                  ui.height(Length.px(31.0))
                  ui.padding(9.0)
                  ui.style(
                    &[
                      Property.BoxSizing { value: BoxSizing.BorderBox },
                      Property.Display { value: Display.Flex },
                      Property.FlexDirection { value: FlexDirection.Row },
                      Property.AlignItems { value: Align.Center },
                      Property.BorderRadius { value: corners(5.0) },
                    ],
                  )
                  ui.gap(8.0)
                  ui.fontSize(11.0)
                  ui.color(t.mutedText)
                  if p.id == m.page {
                    ui.background(rgb(0xeaf0e3))
                    ui.color(rgb(0x35492f))
                  }
                  ui.label(m.string(p.name))
                  glyph(&mut ui, icons.FILE, 14.0)
                  ui.text(m.string(p.name))
                  spacer(&mut ui)
                  if p.id == m.page {
                    glyph(&mut ui, icons.CHECK, 13.0)
                  }
                },
              )
            },
          )
        },
      )
      ui.row(
        |ui| {
          ui.height(Length.px(44.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.Padding { side: Side.Top, value: Length.px(18.0) },
            ],
          )
          section(&mut ui, t, "Layers")
          spacer(&mut ui)
          ui.box(
            |ui| {
              ui.background(rgb(0xf0f2ec))
              ui.color(rgb(0x959e8c))
              ui.padding(3.0)
              ui.fontSize(9.0)
              ui.number(usize.toI64(m.elements.length()))
            },
          )
        },
      )
      ui.box(
        |ui| {
          ui.height(Length.px(37.0))
          ui.style(
            &[
              Property.Padding { side: Side.Left, value: Length.px(9.0) },
              Property.Padding { side: Side.Right, value: Length.px(9.0) },
            ],
          )
          ui.row(
            |ui| {
              ui.height(Length.px(28.0))
              ui.padding(6.0)
              ui.gap(6.0)
              ui.style(
                &[
                  Property.BoxSizing { value: BoxSizing.BorderBox },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              border(&mut ui, 1.0, rgb(0xe7eae1), 5.0)
              ui.color(rgb(0x929b89))
              glyph(&mut ui, icons.SEARCH, 14.0)
              ui.input(
                String.view(&m.search),
                |ui| {
                  ui.accessRole(Role.TextBox)
                  ui.grow(1.0)
                  ui.fontSize(10.0)
                  ui.style(&[Property.MinWidth { value: Length.px(0.0) }])
                  ui.placeholder("Find a layer…")
                  ui.label("Find a layer")
                  ui.onInput(|v| Message.Search { value: move v })
                  ui.onKeyDown(|e| Reply<Message>.Stop)
                },
              )
            },
          )
        },
      )
      let cached = m.layerRevision == m.revision && m.layerPage == m.page
      let mut fallback = List<Row>.make()
      if !cached {
        fallback = ui.alloc(layers.build(m))
      }
      let rows = if cached {
        m.layerRows.asSlice()
      } else {
        fallback.asSlice()
      }
      let nodes = m.elements.asSlice()
      layerList(
        &mut ui,
        t,
        "Layers",
        rows.length,
        32.0,
        f32.max(80.0, m.height - 316.0 - usize.toF32(m.pages.length()) * 31.0),
        m.scroll,
        |top| Message.Scroll { top: top },
        |ui, index| {
          let row = rows[index]
          let e = nodes[row.index]
          ui.pressable(
            || Message.Select { id: e.id, extend: false },
            |ui| {
              ui.width(Length.percent(100.0))
              ui.height(Length.px(32.0))
              ui.padding(0.0)
              ui.style(
                &[
                  Property.BoxSizing { value: BoxSizing.BorderBox },
                  Property.BorderRadius { value: corners(0.0) },
                  Property.WhiteSpace { value: WhiteSpace.NoWrap },
                  Property.OverflowX { value: Overflow.Hidden },
                ],
              )
              if e.selected {
                ui.background(t.highlight)
              }
              ui.hover(&[Property.BackgroundColor { color: rgb(0xf1f3ee) }])
              ui.label(m.string(e.name))
              ui.row(
                |ui| {
                  ui.gap(6.0)
                  ui.style(
                    &[
                      Property.AlignItems { value: Align.Center },
                      Property.Padding {
                        side: Side.Left,
                        value: Length.px(5.0 + f32.min(6.0, u32.toF32(row.depth)) * 12.0),
                      },
                    ],
                  )
                  if row.children {
                    ui.box(
                      |ui| {
                        ui.accessRole(Role.Button)
                        ui.tabIndex(0)
                        ui.cursor(Cursor.Pointer)
                        ui.on(
                          EventKind.Click,
                          |event| Reply<Message>.EmitAndStop {
                            message: Message.Collapse { id: e.id }
                          },
                        )
                        ui.label(
                          if layers.collapsed(m, e.id) {
                            "Expand layer"
                          } else {
                            "Collapse layer"
                          },
                        )
                        ui.width(Length.px(12.0))
                        ui.icon(
                          if layers.collapsed(m, e.id) {
                            icons.CHEVRON
                          } else {
                            icons.DOWN
                          },
                        )
                      },
                    )
                  } else {
                    ui.box(
                      |ui| {
                        ui.width(Length.px(12.0))
                      },
                    )
                  }
                  ui.fontSize(14.0)
                  ui.color(rgb(0x8a957f))
                  ui.icon(
                    if e.kind == 2 {
                      icons.TEXT
                    } else if e.kind == 3 {
                      icons.FRAME
                    } else if e.kind == 4 {
                      icons.GROUP
                    } else if e.kind == 1 {
                      icons.ELLIPSE
                    } else {
                      icons.RECT
                    },
                  )
                  ui.box(
                    |ui| {
                      ui.fontSize(11.0)
                      ui.color(t.text)
                      ui.text(m.string(e.name))
                    },
                  )
                },
              )
            },
          )
        },
      )

      ui.row(
        |ui| {
          ui.height(Length.px(44.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Top)
          ui.fontSize(8.0)
          ui.color(rgb(0xa3ab9c))
          ui.text("YOUR SPACE TO MAKE.")
          spacer(&mut ui)
          iconButton(&mut ui, t, icons.HELP, "Keyboard shortcuts", 18)
        },
      )
    },
  )
}

fn pair(ui: &mut Ui<Message>, body: fn(&mut Ui<Message>, bool) -> ()) -> () {
  ui.row(
    |ui| {
      ui.gap(8.0)
      ui.box(
        |ui| {
          ui.width(Length.px(106.0))
          body(&mut ui, false)
        },
      )
      ui.box(
        |ui| {
          ui.width(Length.px(106.0))
          body(&mut ui, true)
        },
      )
    },
  )
}

fn inspector(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.column(
    |ui| {
      place(&mut ui, m.width - 252.0, 56.0, 252.0, m.height - 83.0)
      ui.background(t.surface)
      line(&mut ui, Side.Left)
      ui.row(
        |ui| {
          ui.height(Length.px(48.0))
          ui.padding(12.0)
          ui.style(
            &[
              Property.BoxSizing { value: BoxSizing.BorderBox },
              Property.AlignItems { value: Align.Center },
              Property.FlexShrink { value: 0.0 },
            ],
          )
          line(&mut ui, Side.Bottom)
          ui.fontSize(11.0)
          ui.box(
            |ui| {
              ui.style(&[Property.FontWeight { value: 650.0 }])
              ui.text("Design")
            },
          )
          spacer(&mut ui)
          ui.box(
            |ui| {
              ui.fontSize(10.0)
              ui.color(rgb(0x9c9b93))
              let at = m.index(m.primary)
              ui.text(
                if m.selected == 0 || at == usize.MAX {
                  "PAGE"
                } else {
                  let kind = m.elements.get(at).kind
                  if kind == 0 {
                    "RECTANGLE"
                  } else if kind == 1 {
                    "ELLIPSE"
                  } else if kind == 2 {
                    "TEXT"
                  } else if kind == 3 {
                    "FRAME"
                  } else {
                    "GROUP"
                  }
                },
              )
            },
          )
        },
      )
      ui.column(
        |ui| {
          ui.grow(1.0)
          ui.style(
            &[
              Property.MinHeight { value: Length.px(0.0) },
              Property.OverflowY { value: Overflow.Auto },
              Property.OverflowX { value: Overflow.Hidden },
            ],
          )
          if m.selected == 0 {
            panelSection(
              &mut ui,
              t,
              "Page name",
              |ui| {
                let mut i: usize = 0
                while i < m.pages.length() {
                  let p = m.pages.get(i)
                  if p.id == m.page {
                    field(&mut ui, t, m, "Page name", 19, m.string(p.name))
                  }
                  i = i + 1
                }
              },
            )
            panelSection(
              &mut ui,
              t,
              "Canvas",
              |ui| {
                ui.gap(3.0)
                setting(&mut ui, t, icons.GRID, "Show grid", m.grid, 19)
                setting(&mut ui, t, icons.SNAP, "Snap to pixels", m.snap, 20)
              },
            )
            ui.column(
              |ui| {
                ui.padding(25.0)
                ui.gap(17.0)
                ui.style(
                  &[
                    Property.Padding { side: Side.Top, value: Length.px(32.0) },
                    Property.Padding { side: Side.Bottom, value: Length.px(32.0) },
                    Property.FlexShrink { value: 0.0 },
                  ],
                )
                ui.box(
                  |ui| {
                    ui.fontSize(36.0)
                    ui.color(rgb(0xa3b48b))
                    glyph(&mut ui, icons.SPARK, 36.0)
                  },
                )
                ui.box(
                  |ui| {
                    ui.style(
                      &[
                        Property.FontFamily { family: 3 },
                        Property.LineHeight { value: LineHeight.Number { value: 1.2 } },
                      ],
                    )
                    ui.fontSize(25.0)
                    ui.color(rgb(0x506345))
                    ui.style(&[Property.WhiteSpace { value: WhiteSpace.PreWrap }])
                    ui.text("A space for\nyour next idea.")
                  },
                )
                ui.box(
                  |ui| {
                    ui.fontSize(11.0)
                    ui.color(rgb(0x96a18c))
                    ui.style(&[Property.LineHeight { value: LineHeight.Number { value: 1.8 } }])
                    ui.style(&[Property.WhiteSpace { value: WhiteSpace.PreWrap }])
                    ui.text(
                      "Draw a shape, set some type, and\nmake it yours. Everything stays on\nthis device.",
                    )
                  },
                )
                ui.pressable(
                  || Message.Action { code: 18 },
                  |ui| {
                    ui.fontSize(10.0)
                    ui.color(rgb(0x70865c))
                    ui.text("Find your flow")
                  },
                )
              },
            )
            panelSection(
              &mut ui,
              t,
              "Quick actions",
              |ui| {
                ui.gap(0.0)
                item(&mut ui, t, icons.FRAME, "Fit to canvas", "Shift 1", 7)
                item(&mut ui, t, icons.PLUS, "Add a page", "", 10)
                item(&mut ui, t, icons.CLOSE, "Delete this page", "", 11)
                item(&mut ui, t, icons.EXPORT, "Export SVG", "", 14)
              },
            )
          } else {
            let at = m.index(m.primary)
            if at != usize.MAX {
              let e = m.elements.get(at)
              let n = e.shape
              panelSection(
                &mut ui,
                t,
                "",
                |ui| {
                  ui.row(
                    |ui| {
                      ui.gap(8.0)
                      ui.fontSize(11.0)
                      ui.style(
                        &[
                          Property.AlignItems { value: Align.Center },
                          Property.FontWeight { value: 600.0 },
                        ],
                      )
                      glyph(
                        &mut ui,
                        if e.kind == 2 {
                          icons.TEXT
                        } else if e.kind == 1 {
                          icons.ELLIPSE
                        } else {
                          icons.RECT
                        },
                        16.0,
                      )
                      if m.selected > 1 {
                        selectionText(&mut ui, m.selected)
                      } else {
                        ui.text(m.string(e.name))
                      }
                    },
                  )
                  field(&mut ui, t, m, "Layer name", 17, m.string(e.name))
                  ui.row(
                    |ui| {
                      ui.style(&[Property.JustifyContent { value: Align.SpaceBetween }])
                      ui.disabled(m.selected < 2)
                      if m.selected < 2 {
                        ui.style(&[Property.Opacity { value: 0.3 }])
                      }
                      iconButton(&mut ui, t, icons.LEFT, "Align left", 25)
                      iconButton(&mut ui, t, icons.CENTER, "Align center", 26)
                      iconButton(&mut ui, t, icons.RIGHT, "Align right", 27)
                      iconButton(&mut ui, t, icons.TOP, "Align top", 28)
                      iconButton(&mut ui, t, icons.MIDDLE, "Align middle", 29)
                      iconButton(&mut ui, t, icons.BOTTOM, "Align bottom", 30)
                    },
                  )
                  section(&mut ui, t, "Position")
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        number(&mut ui, t, m, "Y", 2, n.y)
                      } else {
                        number(&mut ui, t, m, "X", 1, n.x)
                      }
                    },
                  )
                  section(&mut ui, t, "Dimensions")
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        number(&mut ui, t, m, "Height", 4, n.height)
                      } else {
                        number(&mut ui, t, m, "Width", 3, n.width)
                      }
                    },
                  )
                  if m.selected > 1 {
                    hint(&mut ui, "Values apply to all selected layers.")
                  }
                },
              )
              if e.kind == 2 {
                panelSection(
                  &mut ui,
                  t,
                  "Typography",
                  |ui| {
                    let fonts: [string; 3] = ["Arial", "Georgia", "Courier New"]
                    select(
                      &mut ui,
                      t,
                      702,
                      &m.fontMenu,
                      "Font family",
                      &fonts,
                      u32.toUsize(e.fontFamily),
                      |message| Message.Font { message: message },
                    )
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Font weight", 16, u32.toF32(e.fontWeight))
                        } else {
                          number(&mut ui, t, m, "Font size", 15, e.fontSize)
                        }
                      },
                    )
                    field(&mut ui, t, m, "Text", 14, m.string(e.text))
                    hint(&mut ui, "Double-click text on the canvas to edit.")
                  },
                )
              }
              panelSection(
                &mut ui,
                t,
                "Appearance",
                |ui| {
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        number(&mut ui, t, m, "Corner radius", 7, n.radius)
                      } else {
                        number(&mut ui, t, m, "Opacity %", 6, n.opacity * 100.0)
                      }
                    },
                  )
                  section(&mut ui, t, "Fill")
                  color(&mut ui, t, m, "Fill", 5, n.fill)
                  ui.row(
                    |ui| {
                      ui.gap(8.0)
                      let colors: [u32; 7] = [
                        0x25352bff,
                        0xb8c5acff,
                        0xe6b84eff,
                        0xe3ad90ff,
                        0xf7f5ecff,
                        0xffffffff,
                        0x111111ff,
                      ]
                      let mut i: usize = 0
                      while i < colors.length {
                        let value = colors[i]
                        ui.pressable(
                          || Message.Fill { value: value },
                          |ui| {
                            let name = ui.alloc(format.hex(value))
                            ui.label(String.view(&name))
                            ui.width(Length.px(21.0))
                            ui.height(Length.px(21.0))
                            ui.background(sceneColor.rgba(value))
                            border(&mut ui, 1.0, sceneColor.rgba(0x0000000c), 11.0)
                          },
                        )
                        i = i + 1
                      }
                    },
                  )
                },
              )
              if e.kind == 0 || e.kind == 3 {
                panelSection(
                  &mut ui,
                  t,
                  "Stroke",
                  |ui| {
                    color(&mut ui, t, m, "Stroke", 9, n.border)
                    number(&mut ui, t, m, "Stroke width", 8, n.borderWidth)
                  },
                )
              }
              panelSection(
                &mut ui,
                t,
                "Effects",
                |ui| {
                  let blends: [string; 16] = [
                    "Normal",
                    "Multiply",
                    "Screen",
                    "Overlay",
                    "Darken",
                    "Lighten",
                    "Color dodge",
                    "Color burn",
                    "Hard light",
                    "Soft light",
                    "Difference",
                    "Exclusion",
                    "Hue",
                    "Saturation",
                    "Color",
                    "Luminosity",
                  ]
                  select(
                    &mut ui,
                    t,
                    701,
                    &m.blendMenu,
                    "Blend mode",
                    &blends,
                    u8.toUsize(n.blend),
                    |message| Message.Blend { message: message },
                  )
                  number(&mut ui, t, m, "Layer blur", 20, n.effects.blur)
                  if e.kind != 2 {
                    number(&mut ui, t, m, "Backdrop blur", 21, n.effects.backdropBlur)
                  }
                  number(&mut ui, t, m, "Brightness %", 22, n.effects.brightness * 100.0)
                  number(&mut ui, t, m, "Contrast %", 23, n.effects.contrast * 100.0)
                  number(&mut ui, t, m, "Saturation %", 24, n.effects.saturation * 100.0)
                },
              )
              if e.kind == 0 || e.kind == 3 {
                panelSection(
                  &mut ui,
                  t,
                  "Drop shadow",
                  |ui| {
                    color(&mut ui, t, m, "Shadow", 10, n.shadow)
                    number(&mut ui, t, m, "Shadow blur", 11, n.blur)
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Shadow Y", 13, n.shadowY)
                        } else {
                          number(&mut ui, t, m, "Shadow X", 12, n.shadowX)
                        }
                      },
                    )
                    hint(&mut ui, "Use an eight-digit hex value for transparency.")
                  },
                )
                panelSection(
                  &mut ui,
                  t,
                  "Inner shadow",
                  |ui| {
                    color(&mut ui, t, m, "Inner shadow", 26, n.innerShadow)
                    number(&mut ui, t, m, "Inner blur", 27, n.innerBlur)
                    pair(
                      &mut ui,
                      |ui, right| {
                        if right {
                          number(&mut ui, t, m, "Inner Y", 29, n.innerY)
                        } else {
                          number(&mut ui, t, m, "Inner X", 28, n.innerX)
                        }
                      },
                    )
                  },
                )
              }
              panelSection(
                &mut ui,
                t,
                "Arrange",
                |ui| {
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Bring front", 23)
                      } else {
                        button(&mut ui, t, "Send back", 24)
                      }
                    },
                  )
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Delete", 2)
                      } else {
                        button(&mut ui, t, "Duplicate", 3)
                      }
                    },
                  )
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Ungroup", 22)
                      } else {
                        button(&mut ui, t, "Group", 21)
                      }
                    },
                  )
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "Lock / unlock", 34)
                      } else {
                        button(&mut ui, t, "Hide / show", 33)
                      }
                    },
                  )
                },
              )
              panelSection(
                &mut ui,
                t,
                "Export selection",
                |ui| {
                  pair(
                    &mut ui,
                    |ui, right| {
                      if right {
                        button(&mut ui, t, "PNG", 15)
                      } else {
                        button(&mut ui, t, "SVG", 14)
                      }
                    },
                  )
                },
              )
            }
          }
        },
      )
    },
  )
}

fn canvas(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  ui.box(
    |ui| {
      place(&mut ui, 224.0, 56.0, f32.max(100.0, m.width - 476.0), f32.max(100.0, m.height - 83.0))
      ui.testId("canvas")
      ui.label("Design canvas")
      ui.tabIndex(0)
      ui.cursor(
        if m.tool == 5 {
          Cursor.Grab
        } else {
          Cursor.Default
        },
      )

      ui.onPointerDown(
        |e| Reply<Message>.EmitAndStop { message: Message.Down { point: Pointer.from(e) } },
      )

      ui.on(
        EventKind.PointerMove,
        |e| if m.gesture == 0 {
          Reply<Message>.Pass
        } else {
          Reply<Message>.EmitAndStop { message: Message.Move { point: Pointer.from(e) } }
        },
      )

      ui.on(
        EventKind.PointerUp,
        |e| Reply<Message>.EmitAndStop { message: Message.Up { point: Pointer.from(e) } },
      )

      ui.on(
        EventKind.Wheel,
        |e| Reply<Message>.EmitAndStop {
          message: Message.Wheel {
            x: e.x,
            y: e.y,
            dx: e.deltaX,
            dy: e.deltaY,
            zoom: (e.modifiers & (MOD_CONTROL | MOD_META)) != 0,
          }
        },
      )
    },
  )

  if m.selected == 1 && m.gesture != 4 {
    let at = m.index(m.primary)
    if at != usize.MAX {
      let n = m.elements.get(at).shape
      let x = 224.0 + (n.x + n.width * 0.5 - m.cameraX) * m.zoom
      let y = 56.0 + (n.y + n.height - m.cameraY) * m.zoom + 7.0
      if x >= 264.0 && x < m.width - 292.0 && y >= 56.0 && y < m.height - 48.0 {
        ui.box(
          |ui| {
            place(&mut ui, x - 40.0, y, 80.0, 17.0)
            ui.style(
              &[
                Property.PointerEvents { value: false },
                Property.Display { value: Display.Flex },
                Property.JustifyContent { value: Align.Center },
              ],
            )
            ui.box(
              |ui| {
                ui.padding(3.0)
                ui.background(rgb(0x567a44))
                ui.color(rgb(0xffffff))
                ui.fontSize(9.0)
                ui.style(&[Property.BorderRadius { value: corners(3.0) }])
                let mut label = ui.alloc(format.decimal(f32.floor(n.width + 0.5)))
                ui.alloc(label.append(" × "))
                let height = ui.alloc(format.decimal(f32.floor(n.height + 0.5)))
                ui.alloc(label.append(String.view(&height)))
                ui.text(String.view(&label))
              },
            )
          },
        )
      }
    }
  }

  if m.editing != 0 {
    let at = m.index(m.editing)
    if at != usize.MAX {
      let e = m.elements.get(at)
      ui.input(
        if m.draftField == 14 {
          String.view(&m.draft)
        } else {
          m.string(e.text)
        },
        |ui| {
          place(
            &mut ui,
            224.0 + (e.shape.x - m.cameraX) * m.zoom,
            56.0 + (e.shape.y - m.cameraY) * m.zoom,
            f32.max(80.0, e.shape.width * m.zoom),
            f32.max(30.0, e.shape.height * m.zoom),
          )
          ui.accessRole(Role.TextBox)
          ui.style(&[Property.BoxSizing { value: BoxSizing.BorderBox }])
          ui.label("Edit text")
          ui.testId("Edit text")
          ui.takeFocus()
          ui.fontSize(e.fontSize * m.zoom)
          ui.color(sceneColor.rgba(e.shape.fill))
          ui.style(
            &[
              Property.FontFamily { family: e.fontFamily + 2 },
              Property.FontWeight { value: u32.toF32(e.fontWeight) },
            ],
          )
          border(&mut ui, 1.0, rgb(0x567a44), 0.0)
          ui.onInput(|v| Message.Draft { field: 14, value: move v })
          ui.onEnter(|| Message.FinishText)
          ui.onBlur(|| Message.FinishText)
          ui.onKeyDown(
            |e| if String.view(&e.key) == "Escape" {
              Reply<Message>.EmitAndStop { message: Message.FinishText }
            } else {
              Reply<Message>.Stop
            },
          )
        },
      )
    }
  }

  ui.row(
    |ui| {
      place(&mut ui, 239.0, 71.0, f32.max(100.0, m.width - 680.0), 20.0)
      ui.fontSize(10.0)
      ui.color(rgb(0x778272))
      ui.gap(6.0)
      ui.text(m.string(m.title))
      ui.text(" / ")
      let mut i: usize = 0
      while i < m.pages.length() {
        let page = m.pages.get(i)
        if page.id == m.page {
          ui.text(m.string(page.name))
        }
        i = i + 1
      }
    },
  )
  ui.row(
    |ui| {
      place(&mut ui, m.width - 396.0, 65.0, 134.0, 36.0)
      ui.background(t.surface)
      border(&mut ui, 1.0, rgb(0xdce2d5), 7.0)
      ui.padding(3.0)
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BoxShadow {
            value: BoxShadow {
              offsetX: 0.0,
              offsetY: 2.0,
              blur: 6.0,
              spread: 0.0,
              color: rgba(0x293a25, 0.06),
              inset: false,
            },
          },
        ],
      )
      iconButton(&mut ui, t, icons.MINUS, "Zoom out", 38)
      ui.pressable(
        || Message.Action { code: 9 },
        |ui| {
          ui.label("100% zoom")
          ui.width(Length.px(43.0))
          ui.fontSize(10.0)
          ui.color(rgb(0x687660))
          ui.style(
            &[
              Property.Display { value: Display.Flex },
              Property.FlexDirection { value: FlexDirection.Row },
              Property.JustifyContent { value: Align.Center },
            ],
          )
          let mut label = ui.alloc(format.decimal(f32.floor(m.zoom * 100.0 + 0.5)))
          ui.alloc(label.append("%"))
          ui.text(String.view(&label))
        },
      )
      iconButton(&mut ui, t, icons.PLUS, "Zoom in", 39)
      iconButton(&mut ui, t, icons.FRAME, "Fit", 7)
    },
  )

  ui.row(
    |ui| {
      place(&mut ui, (m.width - 476.0 - 284.0) * 0.5 + 224.0, m.height - 104.0, 284.0, 54.0)
      ui.background(t.surface)
      ui.style(
        &[
          Property.BorderRadius { value: corners(12.0) },
          Property.BoxShadow {
            value: BoxShadow {
              offsetX: 0.0,
              offsetY: 8.0,
              blur: 30.0,
              spread: 0.0,
              color: rgba(0x2d3c27, 0.12),
              inset: false,
            },
          },
        ],
      )
      border(&mut ui, 1.0, t.border, 12.0)
      ui.padding(6.0)
      ui.gap(4.0)
      let symbols: [u32; 6] = [
        icons.SELECT,
        icons.FRAME,
        icons.RECT,
        icons.ELLIPSE,
        icons.TEXT,
        icons.HAND,
      ]
      let names: [string; 6] = ["V", "F", "R", "O", "T", "H"]
      let labels: [string; 6] = ["Select", "Frame", "Rectangle", "Ellipse", "Text", "Hand"]
      let mut i: usize = 0
      while i < 6 {
        let kind = usize.toU32(i)
        ui.pressable(
          || Message.Tool { kind: kind },
          |ui| {
            ui.width(Length.px(42.0))
            ui.height(Length.px(42.0))
            ui.style(
              &[
                Property.Display { value: Display.Flex },
                Property.FlexDirection { value: FlexDirection.Row },
                Property.Position { value: Position.Relative },
                Property.BoxSizing { value: BoxSizing.BorderBox },
                Property.AlignItems { value: Align.Center },
                Property.JustifyContent { value: Align.Center },
              ],
            )
            ui.padding(7.0)
            ui.label(labels[i])
            ui.testId(labels[i])
            ui.style(&[Property.BorderRadius { value: corners(6.0) }])
            if m.tool == kind {
              ui.background(t.accent)
              ui.color(rgb(0xffffff))
            }
            ui.color(
              if m.tool == kind {
                rgb(0xeff4e4)
              } else {
                rgb(0x798570)
              },
            )
            glyph(&mut ui, symbols[i], 20.0)
            ui.box(
              |ui| {
                place(&mut ui, 30.0, 29.0, 8.0, 9.0)
                ui.fontSize(7.0)
                ui.text(names[i])
              },
            )
          },
        )
        i = i + 1
      }
    },
  )
}

fn menu(ui: &mut Ui<Message>, t: &Theme, m: &Studio) -> () {
  if m.menu == 0 {
    return ()
  }
  ui.overlay(
    900,
    |ui| {
      place(
        &mut ui,
        if m.menu == 2 {
          12.0
        } else {
          (m.width - 460.0) * 0.5
        },
        if m.menu == 2 {
          48.0
        } else {
          115.0
        },
        if m.menu == 2 {
          272.0
        } else {
          460.0
        },
        if m.menu == 2 {
          320.0
        } else {
          f32.min(670.0, m.height - 180.0)
        },
      )
      ui.background(t.surface)
      ui.padding(
        if m.menu == 2 {
          6.0
        } else {
          20.0
        },
      )
      ui.gap(
        if m.menu == 2 {
          0.0
        } else {
          8.0
        },
      )
      ui.style(&[Property.BorderRadius { value: corners(12.0) }])
      border(&mut ui, 1.0, t.border, 12.0)
      ui.focusTrap(true)
      ui.style(&[Property.OverflowY { value: Overflow.Auto }])

      ui.row(
        |ui| {
          ui.fontSize(18.0)
          ui.text(
            if m.menu == 1 {
              "Commands"
            } else if m.menu == 2 {
              "File"
            } else {
              "Keyboard shortcuts"
            },
          )
          spacer(&mut ui)
          button(&mut ui, t, "Close", 35)
        },
      )

      if m.menu == 3 {
        ui.text(
          "V Select · F Frame · R Rectangle\nO Ellipse · T Text · H Hand\n⌘/Ctrl + wheel: Zoom\nShift + 1: Fit page · 0: 100%\n⌘Z Undo · ⇧⌘Z Redo\n⌘D Duplicate · ⌘G Group\n⌘C Copy · ⌘V Paste\n⌘S Save · Delete Remove",
        )
      } else if m.menu == 2 {
        item(&mut ui, t, icons.PLUS, "New document", "", 12)
        item(&mut ui, t, icons.FILE, "Open document…", "Cmd O", 36)
        item(&mut ui, t, icons.CHECK, "Save document", "Cmd S", 13)
        item(&mut ui, t, icons.FILE, "Save as…", "", 37)
        item(&mut ui, t, icons.EXPORT, "Export PNG", "", 15)
        item(&mut ui, t, icons.EXPORT, "Export SVG", "", 14)
        item(&mut ui, t, icons.HELP, "Keyboard shortcuts", "?", 18)
      } else {
        button(&mut ui, t, "Open document…", 36)
        button(&mut ui, t, "Save as…", 37)
        button(&mut ui, t, "Save document", 13)
        button(&mut ui, t, "New document", 12)
        button(&mut ui, t, "Add a page", 10)
        button(&mut ui, t, "Export PNG", 15)
        button(&mut ui, t, "Export SVG", 14)
        button(&mut ui, t, "Add 100k rectangles", 31)
        button(&mut ui, t, "Add effects playground", 32)
        button(&mut ui, t, "Fit page", 7)
        button(&mut ui, t, "Fit selection", 8)
        button(&mut ui, t, "Select all", 6)
        button(&mut ui, t, "Keyboard shortcuts", 18)
      }
    },
  )
}

pub fn render(m: &Studio, ui: &mut Ui<Message>) -> () {
  let t = theme()

  ui.box(
    |ui| {
      ui.width(Length.percent(100.0))
      ui.height(Length.percent(100.0))
      ui.color(t.text)
      ui.fontSize(12.0)
      ui.style(&[Property.FontFamily { family: 1 }, Property.Position { value: Position.Relative }])

      ui.onKeyDown(
        |e| if String.view(&e.key) == " " {
          Reply<Message>.Emit { message: Message.Space { pressed: true } }
        } else {
          Reply<Message>.Emit {
            message: Message.Key { key: uiCopy(String.view(&e.key)), modifiers: e.modifiers }
          }
        },
      )
      ui.on(
        EventKind.KeyUp,
        |e| if String.view(&e.key) == " " {
          Reply<Message>.Emit { message: Message.Space { pressed: false } }
        } else {
          Reply<Message>.Pass
        },
      )

      canvas(&mut ui, &t, m)
      header(&mut ui, &t, m)
      sidebar(&mut ui, &t, m)
      inspector(&mut ui, &t, m)

      ui.row(
        |ui| {
          place(&mut ui, 0.0, m.height - 27.0, m.width, 27.0)
          ui.background(t.surface)
          ui.padding(12.0)
          ui.style(&[Property.AlignItems { value: Align.Center }])
          line(&mut ui, Side.Top)
          ui.gap(10.0)
          ui.label("Selection status")
          ui.fontSize(9.0)
          ui.color(t.mutedText)
          ui.box(
            |ui| {
              ui.width(Length.px(4.0))
              ui.height(Length.px(4.0))
              ui.background(rgb(0x7e9767))
              ui.style(&[Property.BorderRadius { value: corners(2.0) }])
            },
          )
          if m.selected > 0 {
            selectionText(&mut ui, m.selected)
          } else {
            ui.text(
              if String.byteLength(String.view(&m.notice)) > 0 {
                String.view(&m.notice)
              } else {
                "Ready to make something"
              },
            )
          }
          ui.box(
            |ui| {
              ui.text("Space to pan · Cmd/Ctrl + scroll to zoom")
            },
          )
          spacer(&mut ui)
          ui.pressable(
            || Message.Action { code: 20 },
            |ui| {
              ui.style(
                &[
                  Property.Display { value: Display.Flex },
                  Property.FlexDirection { value: FlexDirection.Row },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              ui.gap(4.0)
              ui.label("Toggle snapping")
              glyph(&mut ui, icons.SNAP, 12.0)
              ui.text("Snap")
            },
          )
          ui.pressable(
            || Message.Action { code: 19 },
            |ui| {
              ui.style(
                &[
                  Property.Display { value: Display.Flex },
                  Property.FlexDirection { value: FlexDirection.Row },
                  Property.AlignItems { value: Align.Center },
                ],
              )
              ui.gap(4.0)
              ui.label("Toggle grid")
              glyph(&mut ui, icons.GRID, 12.0)
              ui.text("Grid")
            },
          )
          ui.text("SILK STUDIO")
        },
      )
      menu(&mut ui, &t, m)
    },
  )
}

fn selectionText(ui: &mut Ui<Message>, count: usize) -> () {
  let mut label = ui.alloc(format.decimal(usize.toF32(count)))
  ui.alloc(
    label.append(
      if count == 1 {
        " layer selected"
      } else {
        " layers selected"
      },
    ),
  )
  ui.text(String.view(&label))
}

fn uiCopy(value: string) -> String {
  let mut h = Heap.make()
  return h.alloc(String.copy(value))
}
