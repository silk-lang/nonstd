//! Composes a retained graphics document with native UI chrome.
import ui_tree.canvas_text as textRaster
import ui_tree.canvas_text { TextCache, TextTile, TextRequest, TextViewport, croppedText }
import exports as exportDocument
import tweet_asset
import codec.png { PngError }
import codec.jpeg { JpegError }
import codec.image { ImageError }
import codec.decode as decode
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import vector.pixmap { Pixmap }
import model { Studio, Element }
import editing
import editor.document { Document, Node, Camera }
import ui_tree.lib { UiTree, TreeError, Batch, FrameInput, CpuSnapshot }
import ui_tree.mutation {
  NodeKind,
  Property,
  Length,
  LineHeight,
  WhiteSpace,
  Position,
  Side,
  Overflow
}
import ui_scene.scene { Scene }
import ui_scene.primitives { Quad, ContentMask, Background }
import ui_scene.color as color
import atlas.atlas { AtlasError, AtlasTile, AtlasOptions, Kind }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.geometry.insets { Insets }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize

struct TextProbe {
  element: usize,
  cache: usize,
  node: u32,
  kind: u32,
  tileIndex: u32,
  tileGeneration: u32,
}

impl Copy for TextProbe {}

/// Retained shape and text caches. The UI tree owns the GPU atlas.
pub struct Canvas {
  document: Document,
  textCache: TextCache,
  image: Option<AtlasTile>,
  rasterFrame: u64,
  normalizedRevision: u64,
  probes: List<TextProbe>,
  allTextBound: bool,
  probeBounds: List<Rect<f32>>,
  pub scene: Scene,
  /// Image-only overview geometry, transformed by the GPU independently of chrome.
  pub retainedScene: Scene,
  pub retained: bool,
  pub retainedRevision: u64,
  pub retainedX: f32,
  pub retainedY: f32,
  retainedValid: bool,
  imageBounds: Option<Rect<f32>>,
  shapes: Scene,
  revision: u64,
  paintedRevision: u64,
  exporting: bool,
  deferDensity: bool,
  refinePending: bool,
  refineAt: f64,
  editing: u32,
  canvasBounds: Rect<f32>,
  cameraX: f32,
  cameraY: f32,
  width: f32,
  height: f32,
  page: u32,
  zoom: f32,
  scale: f32
}

impl Canvas {
  /// Atlas pages for dense image/text documents. Eight 2048² base pages per kind,
  /// allocated lazily; individual high-zoom tiles may request larger pages.
  pub fn atlasOptions() -> AtlasOptions {
    let mut options = AtlasOptions.default()
    options.textureSize = 2048
    options.maxTextures = 8
    return options
  }

  /// Whether native composition needs a presentation after handling input.
  pub fn needsFrame(self: &Self, m: &Studio, tree: &UiTree) -> bool {
    return tree.needsFrame() || self.paintedRevision != m.paintRevision
  }

  pub fn make() -> Canvas {
    return Canvas {
      document: Document.make(),
      textCache: TextCache.make(),
      image: Option<AtlasTile>.None,
      rasterFrame: 0,
      normalizedRevision: 18446744073709551615,
      probes: List<TextProbe>.make(),
      allTextBound: false,
      probeBounds: List<Rect<f32>>.make(),
      scene: Scene.make(),
      retainedScene: Scene.make(),
      retained: false,
      retainedRevision: 0,
      retainedX: 0.0,
      retainedY: 0.0,
      retainedValid: false,
      imageBounds: Option<Rect<f32>>.None,
      shapes: Scene.make(),
      revision: 18446744073709551615,
      paintedRevision: 18446744073709551615,
      exporting: false,
      deferDensity: false,
      refinePending: false,
      refineAt: 0.0,
      editing: 0,
      canvasBounds: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      cameraX: 0.0,
      cameraY: 0.0,
      width: 0.0,
      height: 0.0,
      page: 0,
      zoom: 0.0,
      scale: 0.0,
    }
  }

  /// Resolves natural dimensions only for newly created or edited text; resized/imported
  /// text keeps its explicit dimensions.
  pub effect fn normalize(self: &mut Self, m: &mut Studio, tree: &mut UiTree) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.normalizedRevision == m.geometryRevision {
      return false
    }
    let mut changed = false
    let mut i: usize = 0
    while i < m.elements.length() {
      let mut e = m.elements.get(i)
      if e.kind == 2 && e.autoSize {
        let size = run self.measurement(&m.*, e, &mut tree)
        e.shape.width = size[0]
        e.shape.height = size[1]
        e.autoSize = false
        m.elements.set(i, e)
        changed = true
      }
      i = i + 1
    }
    if changed {
      m.revision = m.revision + 1
      m.geometryRevision = m.geometryRevision + 1
    }
    self.normalizedRevision = m.geometryRevision
    return changed
  }

  /// Drops document-local atlas entries before replacing a document with reused identities.
  pub fn reset(self: &mut Self, tree: &mut UiTree) -> () {
    let mut i: usize = 0
    while i < self.textCache.text.length() {
      drop tree.atlas.free(self.textCache.text.get(i).tile.id)
      i = i + 1
    }
    let image = self.image
    self.* = Canvas.make()
    self.image = image
  }

  /// Number of shared text raster allocations, useful for cache diagnostics.
  pub fn textTileCount(self: &Self) -> usize {
    return self.textCache.text.length()
  }

  /// Number of raster pixels retained for text (four bytes per pixel).
  pub fn textPixelCount(self: &Self) -> usize {
    return self.textCache.textPixels
  }

  /// Loads one shared source texture; all image elements refer to crops of this allocation.
  pub effect fn loadAssets(self: &mut Self, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.image.isSome() {
      return ()
    }
    let mut batch = Batch.make()
    run batch.image(1000000, tweet_asset.png())
    run tree.apply(run batch.take())
    self.image = run tree.imageTile(1000000)
  }

  effect fn measurement(self: &mut Self, m: &Studio, e: Element, tree: &mut UiTree) -> [f32; 3]
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run self.textCache.measurement(textRequest(m, e), &mut tree)
  }

  effect fn textTile(
    self: &mut Self,
    m: &Studio,
    e: Element,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> TextTile
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.textCache.rasterFrame = self.rasterFrame
    self.textCache.exporting = self.exporting
    self.textCache.deferDensity = self.deferDensity
    return run self.textCache.raster(
      textRequest(m, e),
      textViewport(m),
      &mut tree,
      &mut textTree,
      &mut snapshot,
      scale,
    )
  }

  effect fn probe(
    self: &mut Self,
    element: usize,
    e: Element,
    cache: usize,
    node: u32,
    kind: u32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if cache == usize.MAX {
      self.allTextBound = false
    } else {
      let tile = self.textCache.text.get(cache)
      if croppedText(tile) {
        self.allTextBound = false
      }
    }
    let block = self.probes.length() / 64
    let bounds = Rect<f32>.new(
      e.shape.x,
      e.shape.y,
      e.shape.x + e.shape.width,
      e.shape.y + e.shape.height,
    )
    if block == self.probeBounds.length() {
      run self.probeBounds.append(bounds)
    } else {
      let old = self.probeBounds.get(block)
      self.probeBounds.set(
        block,
        Rect<f32>.new(
          f32.min(old.xMin, bounds.xMin),
          f32.min(old.yMin, bounds.yMin),
          f32.max(old.xMax, bounds.xMax),
          f32.max(old.yMax, bounds.yMax),
        ),
      )
    }
    run self.probes.append(
      TextProbe {
        element: element,
        cache: cache,
        node: node,
        kind: kind,
        tileIndex: if cache == usize.MAX {
          0
        } else {
          self.textCache.text.get(cache).tile.id.index
        },
        tileGeneration: if cache == usize.MAX {
          0
        } else {
          self.textCache.text.get(cache).tile.id.generation
        },
      },
    )
  }

  // Most camera changes need no document rebuild: all small labels already have
  // sufficient raster density. Check only text blocks intersecting the viewport.
  fn needsText(self: &Self, m: &Studio, scale: f32, tree: &UiTree, quality: bool) -> bool {
    // Complete overview bindings share hundreds of rasters across 100k labels.
    // Validate each current raster once instead of checking every instance.
    if self.allTextBound {
      let mut at: usize = 0
      while at < self.textCache.text.length() {
        let tile = self.textCache.text.get(at)
        if tile.used == self.rasterFrame {
          if let Option<AtlasTile>.None = tree.atlas.get(tile.tile.id) {
            return true
          }
          let wanted = f32.max(
            0.25,
            f32.ceil(m.zoom * scale * f32.max(tile.stretchX, tile.stretchY) * 4.0) / 4.0,
          )
          let small = tile.size <= 12.0 && tile.naturalWidth <= 256.0 && tile.naturalHeight <= 32.0
          if quality
            && (tile.density < wanted
              || tile.density > wanted * 4.0 && !(small && self.textCache.textPixels < 16000000)) {
            return true
          }
        }
        at = at + 1
      }
      return false
    }
    let viewport = Rect<f32>.new(
      m.cameraX,
      m.cameraY,
      m.cameraX + m.canvasWidth() / m.zoom,
      m.cameraY + m.canvasHeight() / m.zoom,
    )
    let mut block: usize = 0
    while block < self.probeBounds.length() {
      let b = self.probeBounds.get(block)
      if b.xMin < viewport.xMax && b.xMax > viewport.xMin && b.yMin < viewport.yMax
        && b.yMax > viewport.yMin {
        let mut at = block * 64
        let end = if at + 64 < self.probes.length() {
          at + 64
        } else {
          self.probes.length()
        }
        while at < end {
          let probe = self.probes.get(at)
          let e = m.elements.get(probe.element)
          if e.shape.x < viewport.xMax && e.shape.x + e.shape.width > viewport.xMin
            && e.shape.y < viewport.yMax
            && e.shape.y + e.shape.height > viewport.yMin {
            if probe.cache == usize.MAX {
              return true
            }
            let tile = self.textCache.text.get(probe.cache)
            if probe.tileIndex != tile.tile.id.index
              || probe.tileGeneration != tile.tile.id.generation {
              return true
            }
            if let Option<AtlasTile>.None = tree.atlas.get(tile.tile.id) {
              return true
            }
            let wanted = f32.max(
              0.25,
              f32.ceil(m.zoom * scale * f32.max(tile.stretchX, tile.stretchY) * 4.0) / 4.0,
            )
            let small = tile.size <= 12.0 && tile.naturalWidth <= 256.0
              && tile.naturalHeight <= 32.0
            if quality
              && (tile.density < wanted
                || tile.density > wanted * 4.0
                  && !(small && self.textCache.textPixels < 16000000)) {
              return true
            }

            // Keep the crop until the visible text leaves its cached pixel bounds.
            if !textCovered(tile, m, e) {
              return true
            }
          }
          at = at + 1
        }
      }
      block = block + 1
    }
    return false
  }

  // Camera motion only refreshes visible text bindings, preserving the shape store,
  // hierarchy, spatial blocks, and the other 100k image nodes.
  effect fn refreshText(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.rasterFrame = self.rasterFrame + 1
    let mut updated: usize = 0
    let mut cropped = false
    let right = m.cameraX + m.canvasWidth() / m.zoom
    let bottom = m.cameraY + m.canvasHeight() / m.zoom
    let mut block: usize = 0
    while block < self.probeBounds.length() {
      let b = self.probeBounds.get(block)
      if b.xMin < right && b.xMax > m.cameraX && b.yMin < bottom && b.yMax > m.cameraY {
        let mut at = block * 64
        let end = if at + 64 < self.probes.length() {
          at + 64
        } else {
          self.probes.length()
        }
        while at < end {
          let mut probe = self.probes.get(at)
          let e = m.elements.get(probe.element)
          if e.shape.x < right && e.shape.x + e.shape.width > m.cameraX && e.shape.y < bottom
            && e.shape.y + e.shape.height > m.cameraY {
            let tile = run self.textTile(m, e, &mut tree, &mut textTree, &mut snapshot, scale)
            updated = updated + 1
            cropped = cropped || croppedText(tile)
            let mut node = e.shape
            node.opacity = editing.opacity(m, e)
            if probe.kind < 2 {
              probe.kind = run self.document.addTile(tile.tile)
            } else {
              drop self.document.replaceTile(probe.kind, tile.tile)
            }
            node.kind = probe.kind
            node.x = node.x + tile.cropX / tile.density * tile.stretchX
            node.y = node.y + tile.cropY / tile.density * tile.stretchY
            node.width = tile.pixelsWidth / tile.density * tile.stretchX
            node.height = tile.pixelsHeight / tile.density * tile.stretchY
            node.fill = 0xffffffff
            drop self.document.set(probe.node, node)
            probe.cache = tile.cache
            probe.tileIndex = tile.tile.id.index
            probe.tileGeneration = tile.tile.id.generation
            self.probes.set(at, probe)
          }
          at = at + 1
        }
      }
      block = block + 1
    }
    self.allTextBound = updated == self.probes.length() && !cropped
    self.retainedValid = false
    self.imageBounds = self.document.retainedImageBounds()
  }

  /// Renders the selection or page to a transparent image, capped at 4096 pixels per axis.
  pub effect fn exportPixels(
    self: &mut Self,
    m: &mut Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    textSnapshot: &mut CpuSnapshot,
    snapshot: &mut CpuSnapshot,
  ) -> Pixmap
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let bounds = exportDocument.bounds(&m.*)
    let width = f32.max(1.0, bounds.xMax - bounds.xMin)
    let height = f32.max(1.0, bounds.yMax - bounds.yMin)
    let density = f32.min(1.0, 4096.0 / f32.max(width, height))
    let savedZoom = m.zoom
    m.zoom = density
    self.exporting = true
    self.revision = 18446744073709551615
    run self.frame(&m.*, &mut tree, &mut textTree, &mut textSnapshot, 1.0)
    m.zoom = savedZoom
    self.exporting = false
    self.revision = 18446744073709551615
    let mut scene = Scene.make()
    let w = f32.ceil(width * density)
    let h = f32.ceil(height * density)
    run self.document.paint(
      &mut scene,
      Camera { x: bounds.xMin, y: bounds.yMin, zoom: density, scale: 1.0, width: w, height: h },
      true,
    )
    run snapshot.copyUploads(&tree.*)

    // The reference renderer takes its output dimensions from the tree's viewport.
    run textTree.frame(FrameInput { width: w, height: h, scale: 1.0, time: 0.0 })
    return run snapshot.renderScene(&textTree.*, &scene)
  }

  /// Builds the visible document and chrome into one scene in physical pixels.
  pub effect fn frame(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.deferDensity = false
    run self.prepare(m, &mut tree, &mut textTree, &mut snapshot, scale, false)
    self.refinePending = false
  }

  /// Prepares GPU-retained overview images and a separate chrome scene when eligible.
  /// Otherwise produces the ordinary complete scene. Use `frame` for CPU captures.
  pub effect fn frameRetained(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.deferDensity = false
    run self.prepare(m, &mut tree, &mut textTree, &mut snapshot, scale, true)
    self.refinePending = false
  }

  /// Next idle text-quality frame, in seconds on the native event-loop clock.
  /// The host must wake at this deadline even when no more input arrives.
  pub fn nextTextDeadline(self: &Self) -> Option<f64> {
    return if self.refinePending {
      Option<f64>.some(self.refineAt)
    } else {
      Option<f64>.None
    }
  }

  /// Whether the host should request the pending idle text-quality frame.
  pub fn textRefinementDue(self: &Self, time: f64) -> bool {
    return self.refinePending && time >= self.refineAt
  }

  fn canvasMoved(self: &Self, m: &Studio) -> bool {
    let next = m.canvasRect()
    return self.canvasBounds.xMin != next.xMin || self.canvasBounds.yMin != next.yMin
      || self.canvasBounds.xMax != next.xMax
      || self.canvasBounds.yMax != next.yMax
  }

  /// Reuses text pixels during camera motion and refines density after 150ms idle.
  /// Missing, evicted or newly exposed text still refreshes immediately. `time`
  /// and `nextTextDeadline` share the host's monotonic seconds clock; captures
  /// and exports use `frame` for immediate full-quality composition.
  pub effect fn frameInteractive(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
    time: f64,
    retain: bool,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let moving = self.canvasMoved(m) || self.cameraX != m.cameraX || self.cameraY != m.cameraY
      || self.width != m.width
      || self.height != m.height
      || self.zoom != m.zoom
      || self.scale != scale
    if moving {
      self.refineAt = time + 0.150
    }
    self.deferDensity = !self.exporting && time < self.refineAt
    run self.prepare(m, &mut tree, &mut textTree, &mut snapshot, scale, retain)
    self.refinePending = self.deferDensity && self.needsText(m, scale, &tree.*, true)
  }

  /// Builds the visible document and chrome into one scene in physical pixels.
  effect fn prepare(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
    retain: bool,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let cameraChanged = self.canvasMoved(m) || self.cameraX != m.cameraX
      || self.cameraY != m.cameraY
      || self.width != m.width
      || self.height != m.height
      || self.zoom != m.zoom
      || self.scale != scale
    let rebuild = self.editing != m.editing || self.revision != m.geometryRevision
      || self.page != m.page
      || self.scale != scale
    if rebuild {
      self.rasterFrame = self.rasterFrame + 1
      self.document = Document.make()
      self.probes.clear()
      self.allTextBound = true
      self.probeBounds.clear()
      let imageKind = if let Option<AtlasTile>.Some { value: tile } = self.image {
        drop tree.atlas.touch(tile.id)
        run self.document.addTile(tile)
      } else {
        0
      }
      let elements = m.elements.asSlice()
      let mut i: usize = 0
      while i < elements.length {
        let e = elements[i]
        if e.page == m.page && e.kind != 4 && (self.exporting || e.id != m.editing)
          && (!self.exporting || exportDocument.included(m, e))
          && !editing.flag(m, e, 1) {
          let mut node = e.shape
          node.opacity = editing.opacity(m, e)
          if e.image == 1 {
            node.kind = imageKind
          }
          if e.kind == 2 {
            if m.zoom * scale > 4.0 || e.shape.width * m.zoom * scale > 4096.0
              || e.shape.height * m.zoom * scale > 4096.0 {
              if !self.exporting
                && (e.shape.x + e.shape.width < m.cameraX || e.shape.y + e.shape.height < m.cameraY
                  || e.shape.x > m.cameraX + (m.canvasWidth()) / m.zoom
                  || e.shape.y > m.cameraY + (m.canvasHeight()) / m.zoom) {
                node.flags = node.flags | 1
                let id = run self.document.add(node)
                run self.probe(i, e, usize.MAX, id, 0)
                i = i + 1
                continue
              }
            }
            let tile = run self.textTile(m, e, &mut tree, &mut textTree, &mut snapshot, scale)
            node.kind = run self.document.addTile(tile.tile)
            node.x = node.x + tile.cropX / tile.density * tile.stretchX
            node.y = node.y + tile.cropY / tile.density * tile.stretchY
            node.width = tile.pixelsWidth / tile.density * tile.stretchX
            node.height = tile.pixelsHeight / tile.density * tile.stretchY
            node.fill = 0xffffffff
            let id = run self.document.add(node)
            run self.probe(i, e, tile.cache, id, node.kind)
          } else {
            drop run self.document.add(node)
          }
        }
        i = i + 1
      }
      self.retainedValid = false
      self.imageBounds = self.document.retainedImageBounds()
      self.revision = m.geometryRevision
      self.page = m.page
      self.editing = m.editing
      self.zoom = m.zoom
      self.scale = scale
    }
    let refreshText = !rebuild && (cameraChanged || self.refinePending)
      && self.needsText(m, scale, &tree.*, !self.deferDensity)
    if refreshText {
      run self.refreshText(m, &mut tree, &mut textTree, &mut snapshot, scale)
    }
    let previouslyRetained = self.retained
    self.retained = false
    if retain && !self.exporting && !m.grid && overlayIndependent(tree.scene()) {
      if let Option<Rect<f32>>.Some { value: bounds } = self.imageBounds {
        let area = (bounds.xMax - bounds.xMin) * (bounds.yMax - bounds.yMin)
        let visibleArea = m.canvasWidth() * m.canvasHeight() / (m.zoom * m.zoom)
        if visibleArea >= area * 0.1 {
          if !self.retainedValid {
            self.retainedX = bounds.xMin - 1.0
            self.retainedY = bounds.yMin - 1.0
            run self.document.paint(
              &mut self.retainedScene,
              Camera {
                x: self.retainedX,
                y: self.retainedY,
                zoom: 1.0,
                scale: 1.0,
                width: bounds.xMax - bounds.xMin + 2.0,
                height: bounds.yMax - bounds.yMin + 2.0,
              },
              false,
            )
            self.retainedRevision = self.retainedRevision + 1
            self.retainedValid = true
          }
          self.retained = true
        }
      }
    }
    if !self.retained && (rebuild || refreshText || cameraChanged || previouslyRetained) {
      run self.document.paint(
        &mut self.shapes,
        Camera {
          x: m.cameraX - m.canvasLeft() / m.zoom,
          y: m.cameraY - m.canvasTop() / m.zoom,
          zoom: m.zoom,
          scale: scale,
          width: m.width,
          height: m.height,
        },
        true,
      )
      self.zoom = m.zoom
      self.scale = scale
      self.cameraX = m.cameraX
      self.cameraY = m.cameraY
      self.width = m.width
      self.height = m.height
    }
    self.zoom = m.zoom
    self.scale = scale
    self.cameraX = m.cameraX
    self.cameraY = m.cameraY
    self.width = m.width
    self.height = m.height
    self.canvasBounds = m.canvasRect()
    self.scene.clear()
    let full = Rect<f32>.new(0.0, 0.0, m.width * scale, m.height * scale)
    let mask = ContentMask.new(
      Rect<f32>.new(
        m.canvasLeft() * scale,
        m.canvasTop() * scale,
        (m.canvasRight()) * scale,
        (m.canvasBottom()) * scale,
      ),
    )
    if !self.retained {
      drop run self.scene.quad(
        Quad.fill(full, ContentMask.new(full), Background.solid(color.rgb(0xe8eae6))),
      )
    }
    if m.grid && m.zoom > 0.15 {
      let spacing = f32.max(4.0, 16.0 * m.zoom) * scale
      let mut x = m.canvasLeft() * scale - (m.cameraX * m.zoom * scale) % spacing
      while x < (m.canvasRight()) * scale {
        let mut y = m.canvasTop() * scale - (m.cameraY * m.zoom * scale) % spacing
        while y < (m.canvasBottom()) * scale {
          drop run self.scene.quad(
            Quad.fill(
              Rect<f32>.new(x, y, x + scale, y + scale),
              mask,
              Background.solid(color.rgba(0x99a18c50)),
            ),
          )
          y = y + spacing
        }
        x = x + spacing
      }
    }
    if !self.retained {
      run self.scene.replay(&self.shapes, 0, self.shapes.operationCount())
    }
    if m.selected > 0 {
      let b = editing.bounds(m)
      let x = (b[0] - m.cameraX) * m.zoom + m.canvasLeft()
      let y = (b[1] - m.cameraY) * m.zoom + m.canvasTop()
      let r = (b[2] - m.cameraX) * m.zoom + m.canvasLeft()
      let bottom = (b[3] - m.cameraY) * m.zoom + m.canvasTop()
      let mut outline = Quad.fill(
        Rect<f32>.new(x * scale, y * scale, r * scale, bottom * scale),
        mask,
        Background.solid(color.transparent()),
      )
      outline.borderWidths = Insets<f32>.uniform(scale)
      outline.borderColor = color.rgb(0x567a44)
      drop run self.scene.quad(outline)
      let mut corner: usize = 0
      while corner < 8 {
        let cx = if corner == 0 || corner == 6 || corner == 7 {
          x
        } else if corner == 1 || corner == 5 {
          (x + r) * 0.5
        } else {
          r
        }
        let cy = if corner < 3 {
          y
        } else if corner == 3 || corner == 7 {
          (y + bottom) * 0.5
        } else {
          bottom
        }
        let mut q = Quad.fill(
          Rect<f32>.new(
            (cx - 3.5) * scale,
            (cy - 3.5) * scale,
            (cx + 3.5) * scale,
            (cy + 3.5) * scale,
          ),
          mask,
          Background.solid(color.white()),
        )
        q.borderWidths = Insets<f32>.uniform(scale)
        q.borderColor = color.rgb(0x567a44)
        drop run self.scene.quad(q)
        corner = corner + 1
      }
    }
    if m.gesture == 4 {
      let x = (f32.min(m.startX, m.currentX) - m.cameraX) * m.zoom + m.canvasLeft()
      let y = (f32.min(m.startY, m.currentY) - m.cameraY) * m.zoom + m.canvasTop()
      let r = (f32.max(m.startX, m.currentX) - m.cameraX) * m.zoom + m.canvasLeft()
      let bottom = (f32.max(m.startY, m.currentY) - m.cameraY) * m.zoom + m.canvasTop()
      let mut q = Quad.fill(
        Rect<f32>.new(x * scale, y * scale, r * scale, bottom * scale),
        mask,
        Background.solid(color.rgba(0x75985b20)),
      )
      q.borderWidths = Insets<f32>.uniform(scale)
      q.borderColor = color.rgb(0x567a44)
      drop run self.scene.quad(q)
    }
    run self.scene.replay(tree.scene(), 0, tree.scene().operationCount())
    run self.scene.finish()
    self.paintedRevision = m.paintRevision
  }
}

/// Creates the reusable native text measurement/rasterization tree.
pub effect fn textResources(tree: &mut UiTree) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.fontFamily(1, "Noto Sans, sans-serif")
  run batch.fontFamily(2, "Arial, Noto Sans, sans-serif")
  run batch.fontFamily(3, "Georgia, Noto Serif, serif")
  run batch.fontFamily(4, "Courier New, Noto Mono, monospace")
  run tree.apply(run batch.take())
  run textRaster.setup(&mut tree)
}

// Backdrop-dependent chrome (such as the command palette) needs the normal compositor.
fn overlayIndependent(scene: &Scene) -> bool {
  let mut layer: u32 = 0
  while layer < scene.layerCount() {
    let sprites = scene.layers(layer)
    let mut i: usize = 0
    while i < sprites.length {
      if sprites[i].effects.backdropBlur > 0.0 || sprites[i].isolation.blend != 0 {
        return false
      }
      i = i + 1
    }
    layer = layer + 1
  }
  return true
}

fn textRequest<'a>(m: &'a Studio, e: Element) -> TextRequest<'a> {
  return TextRequest<'a> {
    id: e.id,
    key: e.text,
    value: m.string(e.text),
    size: e.fontSize,
    weight: e.fontWeight,
    family: e.fontFamily + 2,
    fill: e.shape.fill,
    x: e.shape.x,
    y: e.shape.y,
    width: e.shape.width,
    height: e.shape.height,
  }
}

fn textViewport(m: &Studio) -> TextViewport {
  return TextViewport {
    x: m.cameraX,
    y: m.cameraY,
    width: m.canvasWidth(),
    height: m.canvasHeight(),
    zoom: m.zoom,
  }
}

fn textCovered(tile: TextTile, m: &Studio, e: Element) -> bool {
  return textRaster.textCovered(tile, textViewport(m), textRequest(m, e))
}
