//! Composes a retained graphics document with native UI chrome.
import exports as exportDocument
import tweet_asset
import codec.png { PngError }
import codec.jpeg { JpegError }
import codec.image { ImageError }
import codec.decode as decode
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import vector.pixmap { Pixmap }
import model { Studio, Element }
import editing
import editor.document { Document, Node, Camera }
import ui_tree.lib { UiTree, TreeError, Batch, FrameInput, CpuSnapshot }
import ui_tree.mutation {
  NodeKind,
  Property,
  Length,
  LineHeight,
  WhiteSpace,
  Position,
  Side,
  Overflow
}
import ui_scene.scene { Scene }
import ui_scene.primitives { Quad, ContentMask, Background }
import ui_scene.color as color
import atlas.atlas { AtlasError, AtlasTile, AtlasOptions, Kind }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.geometry.insets { Insets }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize

struct Measurement {
  text: u32,
  size: f32,
  weight: u32,
  family: u32,
  dimensions: [f32; 3],
  next: usize,
}

impl Copy for Measurement {}

struct TextProbe {
  element: usize,
  cache: usize,
  node: u32,
  kind: u32,
  tileIndex: u32,
  tileGeneration: u32,
}

impl Copy for TextProbe {}

struct TextTile {
  used: u64,
  resident: bool,
  cache: usize,
  next: usize,
  id: u32,
  text: u32,
  size: f32,
  weight: u32,
  fill: u32,
  family: u32,
  width: f32,
  height: f32,
  density: f32,
  cropX: f32,
  cropY: f32,
  naturalWidth: f32,
  naturalHeight: f32,
  baseline: f32,
  stretchX: f32,
  stretchY: f32,
  pixelsWidth: f32,
  pixelsHeight: f32,
  tile: AtlasTile
}

impl Copy for TextTile {}

/// Retained shape and text caches. The UI tree owns the GPU atlas.
pub struct Canvas {
  document: Document,
  text: List<TextTile>,
  textHeads: HashMap<u32, usize>,
  measurements: List<Measurement>,
  measureHeads: HashMap<u32, usize>,
  image: Option<AtlasTile>,
  textPixels: usize,
  rasterFrame: u64,
  normalizedRevision: u64,
  probes: List<TextProbe>,
  allTextBound: bool,
  probeBounds: List<Rect<f32>>,
  pub scene: Scene,
  /// Image-only overview geometry, transformed by the GPU independently of chrome.
  pub retainedScene: Scene,
  pub retained: bool,
  pub retainedRevision: u64,
  pub retainedX: f32,
  pub retainedY: f32,
  retainedValid: bool,
  imageBounds: Option<Rect<f32>>,
  shapes: Scene,
  revision: u64,
  paintedRevision: u64,
  exporting: bool,
  editing: u32,
  cameraX: f32,
  cameraY: f32,
  width: f32,
  height: f32,
  page: u32,
  zoom: f32,
  scale: f32
}

impl Canvas {
  /// Atlas pages for dense image/text documents. Eight 2048² base pages per kind,
  /// allocated lazily; individual high-zoom tiles may request larger pages.
  pub fn atlasOptions() -> AtlasOptions {
    let mut options = AtlasOptions.default()
    options.textureSize = 2048
    options.maxTextures = 8
    return options
  }

  /// Whether native composition needs a presentation after handling input.
  pub fn needsFrame(self: &Self, m: &Studio, tree: &UiTree) -> bool {
    return tree.needsFrame() || self.paintedRevision != m.paintRevision
  }

  pub fn make() -> Canvas {
    return Canvas {
      document: Document.make(),
      text: List<TextTile>.make(),
      textHeads: HashMap<u32, usize>.make(Hash.seed(1307)),
      measurements: List<Measurement>.make(),
      measureHeads: HashMap<u32, usize>.make(Hash.seed(1309)),
      image: Option<AtlasTile>.None,
      textPixels: 0,
      rasterFrame: 0,
      normalizedRevision: 18446744073709551615,
      probes: List<TextProbe>.make(),
      allTextBound: false,
      probeBounds: List<Rect<f32>>.make(),
      scene: Scene.make(),
      retainedScene: Scene.make(),
      retained: false,
      retainedRevision: 0,
      retainedX: 0.0,
      retainedY: 0.0,
      retainedValid: false,
      imageBounds: Option<Rect<f32>>.None,
      shapes: Scene.make(),
      revision: 18446744073709551615,
      paintedRevision: 18446744073709551615,
      exporting: false,
      editing: 0,
      cameraX: 0.0,
      cameraY: 0.0,
      width: 0.0,
      height: 0.0,
      page: 0,
      zoom: 0.0,
      scale: 0.0,
    }
  }

  /// Resolves natural dimensions only for newly created or edited text; resized/imported
  /// text keeps its explicit dimensions.
  pub effect fn normalize(self: &mut Self, m: &mut Studio, tree: &mut UiTree) -> bool
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if self.normalizedRevision == m.geometryRevision {
      return false
    }
    let mut changed = false
    let mut i: usize = 0
    while i < m.elements.length() {
      let mut e = m.elements.get(i)
      if e.kind == 2 && e.autoSize {
        let size = run self.measurement(&m.*, e, &mut tree)
        e.shape.width = size[0]
        e.shape.height = size[1]
        e.autoSize = false
        m.elements.set(i, e)
        changed = true
      }
      i = i + 1
    }
    if changed {
      m.revision = m.revision + 1
      m.geometryRevision = m.geometryRevision + 1
    }
    self.normalizedRevision = m.geometryRevision
    return changed
  }

  /// Drops document-local atlas entries before replacing a document with reused identities.
  pub fn reset(self: &mut Self, tree: &mut UiTree) -> () {
    let mut i: usize = 0
    while i < self.text.length() {
      drop tree.atlas.free(self.text.get(i).tile.id)
      i = i + 1
    }
    let image = self.image
    self.* = Canvas.make()
    self.image = image
  }

  /// Number of shared text raster allocations, useful for cache diagnostics.
  pub fn textTileCount(self: &Self) -> usize {
    return self.text.length()
  }

  /// Number of raster pixels retained for text (four bytes per pixel).
  pub fn textPixelCount(self: &Self) -> usize {
    return self.textPixels
  }

  /// Loads one shared source texture; all image elements refer to crops of this allocation.
  pub effect fn loadAssets(self: &mut Self, tree: &mut UiTree) -> ()
    ! JpegError | PngError | ImageError | AtlasError | OutOfMemoryError
    ? &mut Allocator {
    if let Option<AtlasTile>.Some { value: _ } = self.image {
      return ()
    }
    let pixels = run decode.decodeSrgb(tweet_asset.png())
    let tile = run tree.atlas.allocate(Kind.Polychrome, pixels.width(), pixels.height())
    run tree.uploads.push(tile, pixels.data(), 0, pixels.width() * 4)
    self.image = Option<AtlasTile>.some(tile)
  }

  effect fn measurement(self: &mut Self, m: &Studio, e: Element, tree: &mut UiTree) -> [f32; 3]
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let head = self.measureHeads.get(e.text) |> Option<usize>.unwrapOr(usize.MAX)
    let mut at = head
    while at != usize.MAX {
      let entry = self.measurements.get(at)
      if entry.size == e.fontSize && entry.weight == e.fontWeight && entry.family == e.fontFamily {
        return entry.dimensions
      }
      at = entry.next
    }
    let dimensions = run measureText(m, e, &mut tree)
    drop run self.measureHeads.insert(e.text, self.measurements.length())
    run self.measurements.append(
      Measurement {
        text: e.text,
        size: e.fontSize,
        weight: e.fontWeight,
        family: e.fontFamily,
        dimensions: dimensions,
        next: head,
      },
    )
    return dimensions
  }

  effect fn textTile(
    self: &mut Self,
    m: &Studio,
    e: Element,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> TextTile
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let dimensions = run self.measurement(m, e, &mut textTree)
    let naturalWidth = dimensions[0]
    let naturalHeight = dimensions[1]
    let baseline = dimensions[2]
    let head = self.textHeads.get(e.text) |> Option<usize>.unwrapOr(usize.MAX)
    let mut old = usize.MAX
    let mut cursor = head
    while cursor != usize.MAX {
      let cached = self.text.get(cursor)
      if cached.size == e.fontSize && cached.weight == e.fontWeight && cached.family == e.fontFamily
        && cached.fill == e.shape.fill
        && cached.width == e.shape.width
        && cached.height == e.shape.height
        && (cached.id == e.id
          || cached.cropX == 0.0 && cached.cropY == 0.0
            && cached.pixelsWidth == f32.ceil(cached.naturalWidth * cached.density)
            && cached.pixelsHeight == f32.ceil(cached.naturalHeight * cached.density)) {
        old = cursor
        break
      }
      cursor = cached.next
    }
    let stretchX = e.shape.width / naturalWidth
    let stretchY = e.shape.height / naturalHeight
    let wanted = f32.max(0.001, m.zoom * scale * f32.max(stretchX, stretchY))
    let small = e.fontSize <= 12.0 && naturalWidth <= 256.0 && naturalHeight <= 32.0
    let requested = if self.exporting {
      wanted
    } else {
      f32.max(
        if small && self.textPixels < 8000000 {
          4.0
        } else {
          0.25
        },
        f32.ceil(wanted * 4.0) / 4.0,
      )
    }
    let mut density = requested

    // Coarse buckets amortize the small shared labels. Large text uses the
    // requested density: doubling it can unnecessarily turn a full raster into
    // a costly viewport crop (for example at 400% -> 401% on a Retina display).
    if !self.exporting && small {
      density = 0.25
      while density < requested {
        density = density * 2.0
      }
    }
    let totalWidth = f32.max(1.0, f32.ceil(naturalWidth * density))
    let totalHeight = f32.max(1.0, f32.ceil(naturalHeight * density))
    let clipX = totalWidth > 4096.0
    let clipY = totalHeight > 4096.0
    let cropX: f32 = if clipX && !self.exporting {
      f32.max(0.0, f32.floor((m.cameraX - e.shape.x) / stretchX * density) - 256.0)
    } else {
      0.0
    }
    let cropY: f32 = if clipY && !self.exporting {
      f32.max(0.0, f32.floor((m.cameraY - e.shape.y) / stretchY * density) - 256.0)
    } else {
      0.0
    }
    let w = f32.max(
      1.0,
      f32.min(
        totalWidth - cropX,
        if clipX {
          f32.min(4096.0, (m.canvasWidth()) * density / m.zoom / stretchX + 512.0)
        } else {
          4096.0
        },
      ),
    )
    let h = f32.max(
      1.0,
      f32.min(
        totalHeight - cropY,
        if clipY {
          f32.min(4096.0, (m.canvasHeight()) * density / m.zoom / stretchY + 512.0)
        } else {
          4096.0
        },
      ),
    )
    if old != usize.MAX {
      let mut cached = self.text.get(old)
      if cached.text == e.text && cached.size == e.fontSize && cached.weight == e.fontWeight
        && cached.fill == e.shape.fill
        && cached.family == e.fontFamily
        && cached.width == e.shape.width
        && cached.height == e.shape.height
        && cached.density >= density
        && (cached.density <= density * 4.0 || small && self.textPixels < 16000000)
        && (if self.exporting {
          !croppedText(cached)
        } else {
          textCovered(cached, m, e)
        })
        && tree.atlas.touch(cached.tile.id) {
        cached.used = self.rasterFrame
        self.text.set(old, cached)
        return cached
      }
    }

    let mut batch = Batch.make()
    run batch.setText(2, m.string(e.text))
    run batch.style(
      1,
      &[
        Property.Width { value: Length.px(w) },
        Property.Height { value: Length.px(h) },
        Property.WhiteSpace { value: WhiteSpace.Pre },
        Property.FontFamily { family: e.fontFamily + 2 },
        Property.FontSize { value: e.fontSize * density },
        Property.FontWeight { value: u32.toF32(e.fontWeight) },
        Property.Color { color: color.rgba(e.shape.fill) },
        Property.LineHeight { value: LineHeight.Number { value: 1.5 } },
      ],
    )
    run batch.style(
      3,
      &[
        Property.Position { value: Position.Absolute },
        Property.Inset { side: Side.Left, value: Length.px(2.0 * density - cropX) },
        Property.Inset {
          side: Side.Top,
          value: Length.px((e.fontSize + 2.0 - baseline) * density - cropY),
        },
        Property.Width { value: Length.px(totalWidth) },
        Property.Height { value: Length.px(totalHeight) },
      ],
    )
    run textTree.apply(run batch.take())

    // This scratch tree paints one label, then copies its pixels into the canvas
    // atlas. Earlier labels no longer need their glyph tiles. Advance eviction
    // and disable subtree replay so every glyph used now is touched again.
    drop textTree.atlas.beginFrame()
    textTree.invalidatePaint()
    run textTree.frame(FrameInput { width: w, height: h, scale: 1.0, time: 0.0 })
    if textTree.atlas.evicted().length > 0 {
      drop run textTree.glyphs.prune(&textTree.atlas)
      textTree.atlas.clearEvicted()
    }
    run snapshot.sync(&mut textTree)
    let pixels = run snapshot.render(&textTree.*)
    if old != usize.MAX {
      let mut previous = self.text.get(old)
      if previous.resident {
        self.textPixels = self.textPixels
          - f32.toUsize(previous.pixelsWidth * previous.pixelsHeight)
        drop tree.atlas.free(previous.tile.id)
        previous.resident = false
        self.text.set(old, previous)
      }
    }
    let tile = run self.allocateText(&mut tree, pixels.width(), pixels.height())
    run tree.uploads.push(tile, pixels.data(), 0, pixels.width() * 4)
    self.textPixels = self.textPixels + f32.toUsize(w * h)
    let cached = TextTile {
      used: self.rasterFrame,
      resident: true,
      cache: if old == usize.MAX {
        self.text.length()
      } else {
        old
      },
      next: if old == usize.MAX {
        head
      } else {
        self.text.get(old).next
      },
      id: e.id,
      text: e.text,
      size: e.fontSize,
      weight: e.fontWeight,
      fill: e.shape.fill,
      family: e.fontFamily,
      width: e.shape.width,
      height: e.shape.height,
      density: density,
      cropX: cropX,
      cropY: cropY,
      naturalWidth: naturalWidth,
      naturalHeight: naturalHeight,
      baseline: baseline,
      stretchX: stretchX,
      stretchY: stretchY,
      pixelsWidth: w,
      pixelsHeight: h,
      tile: tile,
    }
    if old == usize.MAX {
      drop run self.textHeads.insert(e.text, self.text.length())
      run self.text.append(cached)
    } else {
      self.text.set(old, cached)
    }
    return cached
  }

  // UiTree retains its own paint caches, so advancing its atlas eviction frame
  // would invalidate UI sprites. Reclaim only canvas text that this rebuild has
  // not used; preserve every allocation already referenced by the new document.
  effect fn allocateText(self: &mut Self, tree: &mut UiTree, width: u32, height: u32) -> AtlasTile
    ! AtlasError | OutOfMemoryError
    ? &mut Allocator {
    while true {
      let allocated = run Effect.result(tree.atlas.allocate(Kind.Polychrome, width, height))
      match move allocated {
        Result<AtlasTile, AtlasError | OutOfMemoryError>.Success { value } => {
          return value
        }
        Result<AtlasTile, AtlasError | OutOfMemoryError>.Failure { error } => {
          match move error {
            OutOfMemoryError failure => {
              fail move failure
            }
            AtlasError failure => {
              match failure {
                AtlasError.Full => {}
                _ => {
                  fail failure
                }
              }
            }
          }
        }
      }
      let mut oldest = usize.MAX
      let mut used = self.rasterFrame
      let mut i: usize = 0
      while i < self.text.length() {
        let candidate = self.text.get(i)
        if candidate.resident && candidate.used < used {
          oldest = i
          used = candidate.used
        }
        i = i + 1
      }
      if oldest == usize.MAX {
        fail AtlasError.Full
      }
      let mut entry = self.text.get(oldest)
      drop tree.atlas.free(entry.tile.id)
      self.textPixels = self.textPixels - f32.toUsize(entry.pixelsWidth * entry.pixelsHeight)
      entry.resident = false
      self.text.set(oldest, entry)
    }
  }

  effect fn probe(
    self: &mut Self,
    element: usize,
    e: Element,
    cache: usize,
    node: u32,
    kind: u32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if cache == usize.MAX {
      self.allTextBound = false
    } else {
      let tile = self.text.get(cache)
      if croppedText(tile) {
        self.allTextBound = false
      }
    }
    let block = self.probes.length() / 64
    let bounds = Rect<f32>.new(
      e.shape.x,
      e.shape.y,
      e.shape.x + e.shape.width,
      e.shape.y + e.shape.height,
    )
    if block == self.probeBounds.length() {
      run self.probeBounds.append(bounds)
    } else {
      let old = self.probeBounds.get(block)
      self.probeBounds.set(
        block,
        Rect<f32>.new(
          f32.min(old.xMin, bounds.xMin),
          f32.min(old.yMin, bounds.yMin),
          f32.max(old.xMax, bounds.xMax),
          f32.max(old.yMax, bounds.yMax),
        ),
      )
    }
    run self.probes.append(
      TextProbe {
        element: element,
        cache: cache,
        node: node,
        kind: kind,
        tileIndex: if cache == usize.MAX {
          0
        } else {
          self.text.get(cache).tile.id.index
        },
        tileGeneration: if cache == usize.MAX {
          0
        } else {
          self.text.get(cache).tile.id.generation
        },
      },
    )
  }

  // Most camera changes need no document rebuild: all small labels already have
  // sufficient raster density. Check only text blocks intersecting the viewport.
  fn needsText(self: &Self, m: &Studio, scale: f32, tree: &UiTree) -> bool {
    // Complete overview bindings share hundreds of rasters across 100k labels.
    // Validate each current raster once instead of checking every instance.
    if self.allTextBound {
      let mut at: usize = 0
      while at < self.text.length() {
        let tile = self.text.get(at)
        if tile.used == self.rasterFrame {
          if let Option<AtlasTile>.None = tree.atlas.get(tile.tile.id) {
            return true
          }
          let wanted = f32.max(
            0.25,
            f32.ceil(m.zoom * scale * f32.max(tile.stretchX, tile.stretchY) * 4.0) / 4.0,
          )
          let small = tile.size <= 12.0 && tile.naturalWidth <= 256.0 && tile.naturalHeight <= 32.0
          if tile.density < wanted
            || tile.density > wanted * 4.0 && !(small && self.textPixels < 16000000) {
            return true
          }
        }
        at = at + 1
      }
      return false
    }
    let viewport = Rect<f32>.new(
      m.cameraX,
      m.cameraY,
      m.cameraX + m.canvasWidth() / m.zoom,
      m.cameraY + m.canvasHeight() / m.zoom,
    )
    let mut block: usize = 0
    while block < self.probeBounds.length() {
      let b = self.probeBounds.get(block)
      if b.xMin < viewport.xMax && b.xMax > viewport.xMin && b.yMin < viewport.yMax
        && b.yMax > viewport.yMin {
        let mut at = block * 64
        let end = if at + 64 < self.probes.length() {
          at + 64
        } else {
          self.probes.length()
        }
        while at < end {
          let probe = self.probes.get(at)
          let e = m.elements.get(probe.element)
          if e.shape.x < viewport.xMax && e.shape.x + e.shape.width > viewport.xMin
            && e.shape.y < viewport.yMax
            && e.shape.y + e.shape.height > viewport.yMin {
            if probe.cache == usize.MAX {
              return true
            }
            let tile = self.text.get(probe.cache)
            if probe.tileIndex != tile.tile.id.index
              || probe.tileGeneration != tile.tile.id.generation {
              return true
            }
            if let Option<AtlasTile>.None = tree.atlas.get(tile.tile.id) {
              return true
            }
            let wanted = f32.max(
              0.25,
              f32.ceil(m.zoom * scale * f32.max(tile.stretchX, tile.stretchY) * 4.0) / 4.0,
            )
            let small = tile.size <= 12.0 && tile.naturalWidth <= 256.0
              && tile.naturalHeight <= 32.0
            if tile.density < wanted
              || tile.density > wanted * 4.0 && !(small && self.textPixels < 16000000) {
              return true
            }

            // Keep the crop until the visible text leaves its cached pixel bounds.
            if !textCovered(tile, m, e) {
              return true
            }
          }
          at = at + 1
        }
      }
      block = block + 1
    }
    return false
  }

  // Camera motion only refreshes visible text bindings, preserving the shape store,
  // hierarchy, spatial blocks, and the other 100k image nodes.
  effect fn refreshText(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.rasterFrame = self.rasterFrame + 1
    let mut updated: usize = 0
    let mut cropped = false
    let right = m.cameraX + m.canvasWidth() / m.zoom
    let bottom = m.cameraY + m.canvasHeight() / m.zoom
    let mut block: usize = 0
    while block < self.probeBounds.length() {
      let b = self.probeBounds.get(block)
      if b.xMin < right && b.xMax > m.cameraX && b.yMin < bottom && b.yMax > m.cameraY {
        let mut at = block * 64
        let end = if at + 64 < self.probes.length() {
          at + 64
        } else {
          self.probes.length()
        }
        while at < end {
          let mut probe = self.probes.get(at)
          let e = m.elements.get(probe.element)
          if e.shape.x < right && e.shape.x + e.shape.width > m.cameraX && e.shape.y < bottom
            && e.shape.y + e.shape.height > m.cameraY {
            let tile = run self.textTile(m, e, &mut tree, &mut textTree, &mut snapshot, scale)
            updated = updated + 1
            cropped = cropped || croppedText(tile)
            let mut node = e.shape
            node.opacity = editing.opacity(m, e)
            if probe.kind < 2 {
              probe.kind = run self.document.addTile(tile.tile)
            } else {
              drop self.document.replaceTile(probe.kind, tile.tile)
            }
            node.kind = probe.kind
            node.x = node.x + tile.cropX / tile.density * tile.stretchX
            node.y = node.y + tile.cropY / tile.density * tile.stretchY
            node.width = tile.pixelsWidth / tile.density * tile.stretchX
            node.height = tile.pixelsHeight / tile.density * tile.stretchY
            node.fill = 0xffffffff
            drop self.document.set(probe.node, node)
            probe.cache = tile.cache
            probe.tileIndex = tile.tile.id.index
            probe.tileGeneration = tile.tile.id.generation
            self.probes.set(at, probe)
          }
          at = at + 1
        }
      }
      block = block + 1
    }
    self.allTextBound = updated == self.probes.length() && !cropped
    self.retainedValid = false
    self.imageBounds = self.document.retainedImageBounds()
  }

  /// Renders the selection or page to a transparent image, capped at 4096 pixels per axis.
  pub effect fn exportPixels(
    self: &mut Self,
    m: &mut Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    textSnapshot: &mut CpuSnapshot,
    snapshot: &mut CpuSnapshot,
  ) -> Pixmap
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let bounds = exportDocument.bounds(&m.*)
    let width = f32.max(1.0, bounds.xMax - bounds.xMin)
    let height = f32.max(1.0, bounds.yMax - bounds.yMin)
    let density = f32.min(1.0, 4096.0 / f32.max(width, height))
    let savedZoom = m.zoom
    m.zoom = density
    self.exporting = true
    self.revision = 18446744073709551615
    run self.frame(&m.*, &mut tree, &mut textTree, &mut textSnapshot, 1.0)
    m.zoom = savedZoom
    self.exporting = false
    self.revision = 18446744073709551615
    let mut scene = Scene.make()
    let w = f32.ceil(width * density)
    let h = f32.ceil(height * density)
    run self.document.paint(
      &mut scene,
      Camera { x: bounds.xMin, y: bounds.yMin, zoom: density, scale: 1.0, width: w, height: h },
      true,
    )
    run snapshot.copyUploads(&tree.*)

    // The reference renderer takes its output dimensions from the tree's viewport.
    run textTree.frame(FrameInput { width: w, height: h, scale: 1.0, time: 0.0 })
    return run snapshot.renderScene(&textTree.*, &scene)
  }

  /// Builds the visible document and chrome into one scene in physical pixels.
  pub effect fn frame(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    run self.prepare(m, &mut tree, &mut textTree, &mut snapshot, scale, false)
  }

  /// Prepares GPU-retained overview images and a separate chrome scene when eligible.
  /// Otherwise produces the ordinary complete scene. Use `frame` for CPU captures.
  pub effect fn frameRetained(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    run self.prepare(m, &mut tree, &mut textTree, &mut snapshot, scale, true)
  }

  /// Builds the visible document and chrome into one scene in physical pixels.
  effect fn prepare(
    self: &mut Self,
    m: &Studio,
    tree: &mut UiTree,
    textTree: &mut UiTree,
    snapshot: &mut CpuSnapshot,
    scale: f32,
    retain: bool,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let cameraChanged = self.cameraX != m.cameraX || self.cameraY != m.cameraY
      || self.width != m.width
      || self.height != m.height
      || self.zoom != m.zoom
      || self.scale != scale
    let rebuild = self.editing != m.editing || self.revision != m.geometryRevision
      || self.page != m.page
      || self.scale != scale
    if rebuild {
      self.rasterFrame = self.rasterFrame + 1
      self.document = Document.make()
      self.probes.clear()
      self.allTextBound = true
      self.probeBounds.clear()
      let imageKind = if let Option<AtlasTile>.Some { value: tile } = self.image {
        drop tree.atlas.touch(tile.id)
        run self.document.addTile(tile)
      } else {
        0
      }
      let elements = m.elements.asSlice()
      let mut i: usize = 0
      while i < elements.length {
        let e = elements[i]
        if e.page == m.page && e.kind != 4 && (self.exporting || e.id != m.editing)
          && (!self.exporting || exportDocument.included(m, e))
          && !editing.flag(m, e, 1) {
          let mut node = e.shape
          node.opacity = editing.opacity(m, e)
          if e.image == 1 {
            node.kind = imageKind
          }
          if e.kind == 2 {
            if m.zoom * scale > 4.0 || e.shape.width * m.zoom * scale > 4096.0
              || e.shape.height * m.zoom * scale > 4096.0 {
              if !self.exporting
                && (e.shape.x + e.shape.width < m.cameraX || e.shape.y + e.shape.height < m.cameraY
                  || e.shape.x > m.cameraX + (m.canvasWidth()) / m.zoom
                  || e.shape.y > m.cameraY + (m.canvasHeight()) / m.zoom) {
                node.flags = node.flags | 1
                let id = run self.document.add(node)
                run self.probe(i, e, usize.MAX, id, 0)
                i = i + 1
                continue
              }
            }
            let tile = run self.textTile(m, e, &mut tree, &mut textTree, &mut snapshot, scale)
            node.kind = run self.document.addTile(tile.tile)
            node.x = node.x + tile.cropX / tile.density * tile.stretchX
            node.y = node.y + tile.cropY / tile.density * tile.stretchY
            node.width = tile.pixelsWidth / tile.density * tile.stretchX
            node.height = tile.pixelsHeight / tile.density * tile.stretchY
            node.fill = 0xffffffff
            let id = run self.document.add(node)
            run self.probe(i, e, tile.cache, id, node.kind)
          } else {
            drop run self.document.add(node)
          }
        }
        i = i + 1
      }
      self.retainedValid = false
      self.imageBounds = self.document.retainedImageBounds()
      self.revision = m.geometryRevision
      self.page = m.page
      self.editing = m.editing
      self.zoom = m.zoom
      self.scale = scale
    }
    let refreshText = !rebuild && cameraChanged && self.needsText(m, scale, &tree.*)
    if refreshText {
      run self.refreshText(m, &mut tree, &mut textTree, &mut snapshot, scale)
    }
    let previouslyRetained = self.retained
    self.retained = false
    if retain && !self.exporting && !m.grid && overlayIndependent(tree.scene()) {
      if let Option<Rect<f32>>.Some { value: bounds } = self.imageBounds {
        let area = (bounds.xMax - bounds.xMin) * (bounds.yMax - bounds.yMin)
        let visibleArea = m.canvasWidth() * m.canvasHeight() / (m.zoom * m.zoom)
        if visibleArea >= area * 0.1 {
          if !self.retainedValid {
            self.retainedX = bounds.xMin - 1.0
            self.retainedY = bounds.yMin - 1.0
            run self.document.paint(
              &mut self.retainedScene,
              Camera {
                x: self.retainedX,
                y: self.retainedY,
                zoom: 1.0,
                scale: 1.0,
                width: bounds.xMax - bounds.xMin + 2.0,
                height: bounds.yMax - bounds.yMin + 2.0,
              },
              false,
            )
            self.retainedRevision = self.retainedRevision + 1
            self.retainedValid = true
          }
          self.retained = true
        }
      }
    }
    if !self.retained && (rebuild || refreshText || cameraChanged || previouslyRetained) {
      run self.document.paint(
        &mut self.shapes,
        Camera {
          x: m.cameraX - m.leftWidth() / m.zoom,
          y: m.cameraY - 56.0 / m.zoom,
          zoom: m.zoom,
          scale: scale,
          width: m.width,
          height: m.height,
        },
        true,
      )
      self.zoom = m.zoom
      self.scale = scale
      self.cameraX = m.cameraX
      self.cameraY = m.cameraY
      self.width = m.width
      self.height = m.height
    }
    self.zoom = m.zoom
    self.scale = scale
    self.cameraX = m.cameraX
    self.cameraY = m.cameraY
    self.width = m.width
    self.height = m.height
    self.scene.clear()
    let full = Rect<f32>.new(0.0, 0.0, m.width * scale, m.height * scale)
    let mask = ContentMask.new(
      Rect<f32>.new(
        m.leftWidth() * scale,
        56.0 * scale,
        (m.width - m.rightWidth()) * scale,
        (m.height - 27.0) * scale,
      ),
    )
    if !self.retained {
      drop run self.scene.quad(
        Quad.fill(full, ContentMask.new(full), Background.solid(color.rgb(0xe8eae6))),
      )
    }
    if m.grid && m.zoom > 0.15 {
      let spacing = f32.max(4.0, 16.0 * m.zoom) * scale
      let mut x = m.leftWidth() * scale - (m.cameraX * m.zoom * scale) % spacing
      while x < (m.width - m.rightWidth()) * scale {
        let mut y = 56.0 * scale - (m.cameraY * m.zoom * scale) % spacing
        while y < (m.height - 27.0) * scale {
          drop run self.scene.quad(
            Quad.fill(
              Rect<f32>.new(x, y, x + scale, y + scale),
              mask,
              Background.solid(color.rgba(0x99a18c50)),
            ),
          )
          y = y + spacing
        }
        x = x + spacing
      }
    }
    if !self.retained {
      run self.scene.replay(&self.shapes, 0, self.shapes.operationCount())
    }
    if m.selected > 0 {
      let b = editing.bounds(m)
      let x = (b[0] - m.cameraX) * m.zoom + m.leftWidth()
      let y = (b[1] - m.cameraY) * m.zoom + 56.0
      let r = (b[2] - m.cameraX) * m.zoom + m.leftWidth()
      let bottom = (b[3] - m.cameraY) * m.zoom + 56.0
      let mut outline = Quad.fill(
        Rect<f32>.new(x * scale, y * scale, r * scale, bottom * scale),
        mask,
        Background.solid(color.transparent()),
      )
      outline.borderWidths = Insets<f32>.uniform(scale)
      outline.borderColor = color.rgb(0x567a44)
      drop run self.scene.quad(outline)
      let mut corner: usize = 0
      while corner < 8 {
        let cx = if corner == 0 || corner == 6 || corner == 7 {
          x
        } else if corner == 1 || corner == 5 {
          (x + r) * 0.5
        } else {
          r
        }
        let cy = if corner < 3 {
          y
        } else if corner == 3 || corner == 7 {
          (y + bottom) * 0.5
        } else {
          bottom
        }
        let mut q = Quad.fill(
          Rect<f32>.new(
            (cx - 3.5) * scale,
            (cy - 3.5) * scale,
            (cx + 3.5) * scale,
            (cy + 3.5) * scale,
          ),
          mask,
          Background.solid(color.white()),
        )
        q.borderWidths = Insets<f32>.uniform(scale)
        q.borderColor = color.rgb(0x567a44)
        drop run self.scene.quad(q)
        corner = corner + 1
      }
    }
    if m.gesture == 4 {
      let x = (f32.min(m.startX, m.currentX) - m.cameraX) * m.zoom + m.leftWidth()
      let y = (f32.min(m.startY, m.currentY) - m.cameraY) * m.zoom + 56.0
      let r = (f32.max(m.startX, m.currentX) - m.cameraX) * m.zoom + m.leftWidth()
      let bottom = (f32.max(m.startY, m.currentY) - m.cameraY) * m.zoom + 56.0
      let mut q = Quad.fill(
        Rect<f32>.new(x * scale, y * scale, r * scale, bottom * scale),
        mask,
        Background.solid(color.rgba(0x75985b20)),
      )
      q.borderWidths = Insets<f32>.uniform(scale)
      q.borderColor = color.rgb(0x567a44)
      drop run self.scene.quad(q)
    }
    run self.scene.replay(tree.scene(), 0, tree.scene().operationCount())
    run self.scene.finish()
    self.paintedRevision = m.paintRevision
  }
}

/// Creates the reusable native text measurement/rasterization tree.
pub effect fn textResources(tree: &mut UiTree) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.fontFamily(1, "Noto Sans, sans-serif")
  run batch.fontFamily(2, "Arial, Noto Sans, sans-serif")
  run batch.fontFamily(3, "Georgia, Noto Serif, serif")
  run batch.fontFamily(4, "Courier New, Noto Mono, monospace")
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(
    1,
    &[Property.OverflowX { value: Overflow.Hidden }, Property.OverflowY { value: Overflow.Hidden }],
  )
  run batch.box(1, 3, &[])
  run batch.text(3, 2, "")
  run tree.apply(run batch.take())
}

effect fn measureText(m: &Studio, e: Element, tree: &mut UiTree) -> [f32; 3]
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut width: f32 = 0.0
  let mut height: f32 = 0.0
  let mut baseline: f32 = 0.0
  let mut measure = Batch.make()
  run measure.setText(2, m.string(e.text))
  run measure.style(
    1,
    &[
      Property.Width { value: Length.px(1000000.0) },
      Property.Height { value: Length.px(1.0) },
      Property.WhiteSpace { value: WhiteSpace.Pre },
      Property.FontFamily { family: e.fontFamily + 2 },
      Property.FontSize { value: e.fontSize },
      Property.FontWeight { value: u32.toF32(e.fontWeight) },
      Property.LineHeight { value: LineHeight.Number { value: 1.5 } },
    ],
  )
  run measure.style(
    3,
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset { side: Side.Left, value: Length.px(0.0) },
      Property.Inset { side: Side.Top, value: Length.px(0.0) },
      Property.Width { value: Length.px(1000000.0) },
      Property.Height { value: Length.px(e.fontSize * 1.5) },
    ],
  )
  run tree.apply(run measure.take())
  run tree.layoutNow()
  let css = tree.node(tree.slotOf(2)).css
  let fragments = tree.output.fragments.values.asSlice()
  let mut j: usize = 0
  while j < fragments.length {
    let f = fragments[j]
    if f.source == css {
      baseline = f32.max(baseline, f.worldLocation.y + f.firstBaselines.alphabetic)
      width = f32.max(width, f.worldLocation.x + f.size.width)
      height = f32.max(height, f.worldLocation.y + f.size.height)
    }
    j = j + 1
  }
  width = f32.ceil(f32.max(1.0, width) + 4.0)
  height = f32.ceil(f32.max(e.fontSize * 1.5, height) + 4.0)
  return [width, height, baseline]
}

// Backdrop-dependent chrome (such as the command palette) needs the normal compositor.
fn overlayIndependent(scene: &Scene) -> bool {
  let mut layer: u32 = 0
  while layer < scene.layerCount() {
    let sprites = scene.layers(layer)
    let mut i: usize = 0
    while i < sprites.length {
      if sprites[i].effects.backdropBlur > 0.0 || sprites[i].isolation.blend != 0 {
        return false
      }
      i = i + 1
    }
    layer = layer + 1
  }
  return true
}

fn croppedText(tile: TextTile) -> bool {
  return tile.cropX > 0.0 || tile.cropY > 0.0
    || tile.pixelsWidth < f32.ceil(tile.naturalWidth * tile.density)
    || tile.pixelsHeight < f32.ceil(tile.naturalHeight * tile.density)
}

// Compare viewport coverage in the cached raster's coordinates. Recomputing a
// preferred crop origin is not an invalidation: its overscan is there for panning.
fn textCovered(tile: TextTile, m: &Studio, e: Element) -> bool {
  if !croppedText(tile) {
    return true
  }
  let left = f32.max(0.0, (m.cameraX - e.shape.x) / tile.stretchX * tile.density)
  let top = f32.max(0.0, (m.cameraY - e.shape.y) / tile.stretchY * tile.density)
  let right = f32.min(
    f32.ceil(tile.naturalWidth * tile.density),
    (m.cameraX + m.canvasWidth() / m.zoom - e.shape.x) / tile.stretchX * tile.density,
  )
  let bottom = f32.min(
    f32.ceil(tile.naturalHeight * tile.density),
    (m.cameraY + m.canvasHeight() / m.zoom - e.shape.y) / tile.stretchY * tile.density,
  )
  if right <= left || bottom <= top {
    return true
  }
  return tile.cropX <= f32.floor(left) && tile.cropY <= f32.floor(top)
    && tile.cropX + tile.pixelsWidth >= f32.ceil(right)
    && tile.cropY + tile.pixelsHeight >= f32.ceil(bottom)
}
