//! Native Studio document and interaction state. Drawing elements stay outside the UI tree.
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash, HashKey }
import ui_components.lib { MenuState, MenuMessage }
import silk.core.option { Option }
import format
import editor.document { Node }
import ui_app.heap { Heap }
import ui_app.app { App, Context, Subscriptions, NoCommand }
import ui_app.ui { Ui }
import ui_tree.input { MOD_SHIFT, MOD_CONTROL, MOD_META, MOD_ALT }
import ui_tree.node { Event }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize
import silk.num.u32
import silk.num.u64
import silk.num.f32
import view
import layers { Row }
import layers
import editing
import samples

/// An editable layer: rect, ellipse, text, frame, or group (kind 0 through 4).
pub struct Element {
  pub id: u32,
  pub page: u32,
  pub parent: u32,
  pub kind: u32,
  pub name: u32,
  pub text: u32,
  pub fontSize: f32,
  pub fontWeight: u32,
  pub fontFamily: u32,
  pub shape: Node,
  pub selected: bool,
  pub autoSize: bool,
}

impl Copy for Element {}

pub struct Page {
  pub id: u32,
  pub name: u32
}

impl Copy for Page {}

pub struct Snapshot {
  pub elements: List<Element>,
  pub pages: List<Page>,
  pub page: u32,
  pub title: u32
}

/// A pointer sample in window logical points.
pub struct Pointer {
  pub x: f32,
  pub y: f32,
  pub shift: bool,
  pub alt: bool,
  pub pan: bool,
  pub double: bool
}

impl Copy for Pointer {}

impl Pointer {
  pub fn from(event: &Event) -> Pointer {
    return Pointer {
      x: event.x,
      y: event.y,
      shift: (event.modifiers & MOD_SHIFT) != 0,
      alt: (event.modifiers & MOD_ALT) != 0,
      pan: event.button != 0,
      double: event.detail >= 2,
    }
  }
}

pub union Message {
  Action { pub code: u32 },
  Tool { pub kind: u32 },
  Collapse { pub id: u32 },
  Select { pub id: u32, pub extend: bool },
  Page { pub id: u32 },
  Down { pub point: Pointer },
  Move { pub point: Pointer },
  Up { pub point: Pointer },
  Wheel { pub x: f32, pub y: f32, pub dx: f32, pub dy: f32, pub zoom: bool },
  Field { pub field: u32, pub value: String },
  Search { pub value: String },
  Scroll { pub top: f32 },
  Resize { pub width: f32, pub height: f32 },
  Key { pub key: String, pub modifiers: u32 },
  Draft { pub field: u32, pub value: String },
  Commit,
  Blend { pub message: MenuMessage },
  Font { pub message: MenuMessage },
  FinishText,
  Space { pub pressed: bool },
  Tick,
  Saved { pub ok: bool },
}

/// UI and document state. Strings are interned append-only so history shares their storage.
pub struct Studio {
  pub heap: Heap,
  pub stringHashes: HashMap<u64, u32>,
  pub strings: List<String>,
  pub elements: List<Element>,
  pub pages: List<Page>,
  pub indexes: List<usize>,
  pub nextId: u32,
  pub page: u32,
  pub title: u32,
  pub tool: u32,
  pub width: f32,
  pub height: f32,
  pub cameraX: f32,
  pub cameraY: f32,
  pub zoom: f32,
  pub selected: usize,
  pub primary: u32,
  pub search: String,
  pub collapsed: List<u32>,
  pub layerRows: List<Row>,
  pub layerRevision: u64,
  pub layerPage: u32,
  pub scroll: f32,
  pub past: List<Snapshot>,
  pub future: List<Snapshot>,
  pub before: List<Element>,
  pub beforeDuplicate: List<Element>,
  pub duplicated: bool,
  pub gesture: u32,
  pub startX: f32,
  pub startY: f32,
  pub currentX: f32,
  pub currentY: f32,
  pub startCameraX: f32,
  pub startCameraY: f32,
  pub handle: u32,
  pub revision: u64,
  pub savedRevision: u64,
  pub paintRevision: u64,
  pub geometryRevision: u64,
  pub draftField: u32,
  pub draft: String,
  pub menu: u32,
  pub grid: bool,
  pub snap: bool,
  pub space: bool,
  pub saveRequested: bool,
  pub blendMenu: MenuState,
  pub fontMenu: MenuState,
  pub exportRequested: u32,
  pub notice: String,
  pub clipboard: List<Element>,
  pub editing: u32,
}

impl Studio {
  pub fn make() -> Studio {
    return Studio {
      heap: Heap.make(),
      stringHashes: HashMap<u64, u32>.make(Hash.seed(716)),
      strings: List<String>.make(),
      elements: List<Element>.make(),
      pages: List<Page>.make(),
      indexes: List<usize>.make(),
      nextId: 1,
      page: 1,
      title: 0,
      tool: 0,
      width: 1440.0,
      height: 960.0,
      cameraX: -80.0,
      cameraY: -80.0,
      zoom: 0.8,
      selected: 0,
      primary: 0,
      search: String.make(),
      collapsed: List<u32>.make(),
      layerRows: List<Row>.make(),
      layerRevision: u64.MAX,
      layerPage: 0,
      scroll: 0.0,
      past: List<Snapshot>.make(),
      future: List<Snapshot>.make(),
      before: List<Element>.make(),
      beforeDuplicate: List<Element>.make(),
      duplicated: false,
      gesture: 0,
      startX: 0.0,
      startY: 0.0,
      currentX: 0.0,
      currentY: 0.0,
      startCameraX: 0.0,
      startCameraY: 0.0,
      handle: 0,
      revision: 0,
      savedRevision: 0,
      paintRevision: 1,
      geometryRevision: 1,
      draftField: 0,
      draft: String.make(),
      menu: 0,
      grid: false,
      snap: true,
      space: false,
      saveRequested: false,
      blendMenu: MenuState.make(),
      fontMenu: MenuState.make(),
      exportRequested: 0,
      notice: String.make(),
      clipboard: List<Element>.make(),
      editing: 0,
    }
  }

  pub fn intern(self: &mut Self, value: string) -> u32 {
    let hash = HashKey.hash(&value, &Hash.seed(2003))
    if let Option<u32>.Some { value: key } = self.stringHashes.get(hash) {
      if self.string(key) == value {
        return key
      }
    }
    if self.strings.length() > 0
      && String.view(&self.strings.asSlice()[self.strings.length() - 1]) == value {
      return usize.toU32(self.strings.length() - 1)
    }
    let key = usize.toU32(self.strings.length())
    let text = self.heap.alloc(String.copy(value))
    self.heap.alloc(self.strings.append(move text))
    drop self.heap.alloc(self.stringHashes.insert(hash, key))
    return key
  }

  pub fn string(self: &Self, key: u32) -> string {
    if u32.toUsize(key) >= self.strings.length() {
      return ""
    }
    return String.view(&self.strings.asSlice()[u32.toUsize(key)])
  }

  pub fn index(self: &Self, id: u32) -> usize {
    if u32.toUsize(id) >= self.indexes.length() {
      return usize.MAX
    }
    return self.indexes.get(u32.toUsize(id))
  }

  pub fn reindex(self: &mut Self) -> () {
    while self.indexes.length() < u32.toUsize(self.nextId) {
      self.heap.alloc(self.indexes.append(usize.MAX))
    }
    let indices = self.indexes.asMutSlice()
    let mut i: usize = 0
    while i < indices.length {
      indices[i] = usize.MAX
      i = i + 1
    }
    i = 0
    let elements = self.elements.asSlice()
    while i < elements.length {
      indices[u32.toUsize(elements[i].id)] = i
      i = i + 1
    }
  }

  pub fn add(
    self: &mut Self,
    kind: u32,
    name: string,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    fill: u32,
  ) -> u32 {
    let id = self.nextId
    self.nextId = id + 1
    let nameKey = self.intern(name)
    let mut node = Node.rect(x, y, width, height, fill)
    if kind == 1 {
      node.kind = 1
    }
    let element = Element {
      id: id,
      page: self.page,
      parent: 0,
      kind: kind,
      name: nameKey,
      text: nameKey,
      autoSize: kind == 2,
      fontSize: 32.0,
      fontWeight: 400,
      fontFamily: 0,
      shape: node,
      selected: false,
    }
    while self.indexes.length() <= u32.toUsize(id) {
      self.heap.alloc(self.indexes.append(usize.MAX))
    }
    self.indexes.set(u32.toUsize(id), self.elements.length())
    self.heap.alloc(self.elements.append(element))
    self.paintRevision = self.paintRevision + 1
    return id
  }

  pub fn copyElements(self: &mut Self) -> List<Element> {
    let mut result = List<Element>.make()
    self.heap.alloc(result.appendSlice(self.elements.asSlice()))
    return move result
  }

  pub fn snapshot(self: &mut Self) -> Snapshot {
    let elements = self.copyElements()
    let mut pages = List<Page>.make()
    self.heap.alloc(pages.appendSlice(self.pages.asSlice()))
    return Snapshot {
      elements: move elements,
      pages: move pages,
      page: self.page,
      title: self.title,
    }
  }

  pub fn checkpoint(self: &mut Self) -> () {
    let state = self.snapshot()
    while self.past.length() >= 50
      || (self.past.length() > 1 && self.past.length() * self.elements.length() > 500000) {
      drop self.past.remove(0)
    }
    self.heap.alloc(self.past.append(move state))
    self.future.clear()
  }

  pub fn changed(self: &mut Self) -> () {
    self.reindex()
    self.geometryRevision = self.geometryRevision + 1
    self.revision = self.revision + 1
    self.paintRevision = self.paintRevision + 1
    self.recount()
  }

  pub fn recount(self: &mut Self) -> () {
    self.selected = 0
    self.primary = 0
    let nodes = self.elements.asSlice()
    let mut i: usize = 0
    while i < nodes.length {
      if nodes[i].selected && nodes[i].page == self.page {
        self.selected = self.selected + 1
        self.primary = nodes[i].id
      }
      i = i + 1
    }
  }

  pub fn clearSelection(self: &mut Self) -> () {
    let nodes = self.elements.asMutSlice()
    let mut i: usize = 0
    while i < nodes.length {
      nodes[i].selected = false
      i = i + 1
    }
    self.selected = 0
    self.primary = 0
  }

  pub fn select(self: &mut Self, id: u32, extend: bool) -> () {
    if !extend {
      self.clearSelection()
    }
    let at = self.index(id)
    if at != usize.MAX {
      let value1 = !self.elements.asSlice()[at].selected
      let index1 = at
      let mut item1 = self.elements.get(index1)
      item1.selected = value1
      self.elements.set(index1, item1)
    }
    self.recount()
    self.paintRevision = self.paintRevision + 1
  }

  pub fn fit(self: &mut Self, selection: bool) -> () {
    let nodes = self.elements.asSlice()
    let mut i: usize = 0
    let mut x: f32 = 1000000.0
    let mut y = x
    let mut right: f32 = -1000000.0
    let mut bottom = right
    while i < nodes.length {
      let e = nodes[i]
      if e.page == self.page && (e.shape.flags & 1) == 0 && (!selection || e.selected) {
        x = f32.min(x, e.shape.x)
        y = f32.min(y, e.shape.y)
        right = f32.max(right, e.shape.x + e.shape.width)
        bottom = f32.max(bottom, e.shape.y + e.shape.height)
      }
      i = i + 1
    }
    if right < x {
      self.cameraX = -80.0
      self.cameraY = -80.0
      self.zoom = 1.0
      return ()
    }
    let w = f32.max(self.width - 500.0, 100.0)
    let h = f32.max(self.height - 180.0, 100.0)
    self.zoom = f32.max(
      0.02,
      f32.min(4.0, f32.min(w / f32.max(right - x, 1.0), h / f32.max(bottom - y, 1.0))),
    )
    self.cameraX = x - (self.width - 476.0) / self.zoom * 0.5 + (right - x) * 0.5
    self.cameraY = y - (self.height - 110.0) / self.zoom * 0.5 + (bottom - y) * 0.5
  }
}

impl App<Message, NoCommand> for Studio {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    view.render(self, &mut ui)
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Action { code } => editing.action(&mut self, code)
      Message.Tool { kind } => {
        self.tool = kind
        self.menu = 0
        self.editing = 0
      }
      Message.Collapse { id } => {
        let mut at: usize = 0
        while at < self.collapsed.length() && self.collapsed.get(at) != id {
          at = at + 1
        }
        if at < self.collapsed.length() {
          drop self.collapsed.remove(at)
        } else {
          self.heap.alloc(self.collapsed.append(id))
        }
        self.layerRevision = u64.MAX
      }
      Message.Select { id, extend } => self.select(id, extend)
      Message.Page { id } => {
        self.page = id
        self.clearSelection()
        self.scroll = 0.0
        self.fit(false)
        self.paintRevision = self.paintRevision + 1
      }
      Message.Down { point } => editing.down(&mut self, point)
      Message.Move { point } => editing.drag(&mut self, point)
      Message.Up { point } => editing.up(&mut self, point)
      Message.Wheel { x, y, dx, dy, zoom } => editing.wheel(&mut self, x, y, dx, dy, zoom)
      Message.Field { field, value } => editing.field(&mut self, field, String.view(&value))
      Message.Search { value } => {
        self.layerRevision = u64.MAX
        self.search = move value
        self.scroll = 0.0
      }
      Message.Scroll { top } => {
        self.scroll = top
      }
      Message.Resize { width, height } => {
        self.width = width
        self.height = height
        self.paintRevision = self.paintRevision + 1
      }
      Message.Key { key, modifiers } => editing.key(&mut self, String.view(&key), modifiers)
      Message.Draft { field, value } => {
        self.draftField = field
        self.draft = move value
      }
      Message.Commit => {
        if self.draftField != 0 {
          let field = self.draftField
          let value = Intrinsic.replace(self.draft, String.make())
          self.draft = String.make()
          self.draftField = 0
          editing.field(&mut self, field, String.view(&value))
        }
      }
      Message.Blend { message: choice } => {
        if let Option<usize>.Some { value } = self.blendMenu.update(choice) {
          let text = self.heap.alloc(format.decimal(usize.toF32(value)))
          editing.field(&mut self, 25, String.view(&text))
        }
      }
      Message.Font { message: choice } => {
        if let Option<usize>.Some { value } = self.fontMenu.update(choice) {
          let text = self.heap.alloc(format.decimal(usize.toF32(value)))
          editing.field(&mut self, 30, String.view(&text))
        }
      }
      Message.FinishText => {
        if self.draftField == 14 {
          let text = Intrinsic.replace(self.draft, String.make())
          self.draftField = 0
          editing.field(&mut self, 14, String.view(&text))
        }
        self.editing = 0
        self.geometryRevision = self.geometryRevision + 1
      }
      Message.Space { pressed } => {
        self.space = pressed
      }
      Message.Tick => {
        if self.revision != self.savedRevision && self.gesture == 0 {
          self.saveRequested = true
        }
      }
      Message.Saved { ok } => {
        if ok {
          self.savedRevision = self.revision
        }
        self.saveRequested = false
      }
    }
    if self.layerRevision != self.revision || self.layerPage != self.page {
      let mut heap = Heap.make()
      self.layerRows = heap.alloc(layers.build(&self.*))
      self.layerRevision = self.revision
      self.layerPage = self.page
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    subs.resize(1, |w, h| Message.Resize { width: w, height: h })
    subs.every(2, 1.0, |time| Message.Tick)
  }
}
