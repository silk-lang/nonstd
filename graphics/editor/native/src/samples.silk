pub fn mosaic(m: &mut Studio) -> () {
  page(&mut m, "100k rectangles")
  let mut i: usize = 0
  let shades = pixels.data()
  let height: f32 = 20000.0 * 1219.0 / 1290.0 / 250.0
  let name = m.intern("Rectangle")
  let capacity = m.elements.length() + 100002
  m.heap.alloc(m.elements.reserve(capacity))
  while i < 100000 {
    let g = u8.toU32(shades[i])
    let color = g * 0x01010100 + 255
    let id = m.add(
      0,
      "",
      usize.toF32(i % 400) * 50.0 + 1.0,
      usize.toF32(i / 400) * height + 1.0,
      48.0,
      height - 2.0,
      color,
    )
    let at = m.index(id)
    let value10 = name
    let index10 = at
    let mut item10 = m.elements.get(index10)
    item10.name = value10
    m.elements.set(index10, item10)

    i = i + 1
  }
  text(&mut m, "SILK + WEBGPU + NATIVE UI", 800.0, -3200.0, 900.0, 0x25352bff, 0)
  text(&mut m, "100K elements", 5200.0, -1700.0, 800.0, 0x25352bff, 0)
}

pub fn effects(m: &mut Studio) -> () {
