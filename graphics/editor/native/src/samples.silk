//! The same Form & Field composition and stress/effects pages as Studio's browser demo.
import silk.text.string { String }
import silk.num.u8
import model { Studio, Page }
import silk.num.usize
import silk.num.u32
import pixels

pub fn page(m: &mut Studio, name: string) -> () {
  let id = m.nextId
  m.nextId = id + 1
  let key = m.intern(name)
  m.heap.alloc(m.pages.append(Page { id: id, name: key }))
  m.page = id
  m.clearSelection()
}

fn text(m: &mut Studio, value: string, x: f32, y: f32, size: f32, color: u32, parent: u32) -> () {
  let id = m.add(
    2,
    value,
    x,
    y,
    usize.toF32(String.byteLength(value)) * size * 0.56,
    size * 1.5,
    color,
  )
  let at = m.index(id)
  let mut measured = m.elements.get(at)
  measured.shape.width = if value == "FORM & FIELD" {
    152.0
  } else if value == "Make room" {
    345.0
  } else if value == "for the good." {
    365.0
  } else {
    measured.shape.width * 1.2
  }
  if value == "Make room" || value == "for the good." || value == "Good things"
    || value == "take space." {
    measured.fontFamily = 1
  }
  m.elements.set(at, measured)
  let value1 = size
  let index1 = at
  let mut item1 = m.elements.get(index1)
  item1.autoSize = value1 <= 512.0
  item1.fontSize = if value1 > 512.0 {
    512.0
  } else {
    value1
  }
  m.elements.set(index1, item1)

  let value2 = parent
  let index2 = at
  let mut item2 = m.elements.get(index2)
  item2.parent = value2
  m.elements.set(index2, item2)
}

pub fn starter(m: &mut Studio) -> () {
  m.title = m.intern("Form & Field")
  page(&mut m, "Explorations")
  let a = m.add(3, "01 / The introduction", 0.0, 0.0, 440.0, 560.0, 0xf7f5ecff)
  text(&mut m, "FORM & FIELD", 32.0, 28.0, 14.0, 0x25352bff, a)
  text(&mut m, "Make room", 30.0, 110.0, 56.0, 0x25352bff, a)
  text(&mut m, "for the good.", 30.0, 175.0, 56.0, 0x25352bff, a)
  text(&mut m, "Objects for a slower, better everyday.", 32.0, 265.0, 15.0, 0x687267ff, a)
  let button = m.add(0, "Explore button", 32.0, 322.0, 155.0, 44.0, 0x283e30ff)
  let at0 = m.index(button)
  let value3: f32 = 22.0
  let index3 = at0
  let mut item3 = m.elements.get(index3)
  item3.shape.radius = value3
  m.elements.set(index3, item3)

  let value4 = a
  let index4 = at0
  let mut item4 = m.elements.get(index4)
  item4.parent = value4
  m.elements.set(index4, item4)

  text(&mut m, "Explore collection", 47.0, 332.0, 12.0, 0xffffffff, a)
  let sun = m.add(1, "Sun", 292.0, 363.0, 112.0, 112.0, 0xe6b84eff)
  let at1 = m.index(sun)
  let value5 = a
  let index5 = at1
  let mut item5 = m.elements.get(index5)
  item5.parent = value5
  m.elements.set(index5, item5)

  let ground = m.add(0, "Ground", 0.0, 475.0, 440.0, 85.0, 0xd9dfc8ff)
  let at2 = m.index(ground)
  let value6 = a
  let index6 = at2
  let mut item6 = m.elements.get(index6)
  item6.parent = value6
  m.elements.set(index6, item6)

  text(&mut m, "LESS, BUT LOVELY.", 32.0, 510.0, 11.0, 0x25352bff, a)
  text(&mut m, "EST. 2026", 325.0, 510.0, 11.0, 0x25352bff, a)
  let b = m.add(3, "02 / A little perspective", 500.0, 0.0, 360.0, 360.0, 0x2d4535ff)
  text(&mut m, "A LITTLE PERSPECTIVE", 530.0, 25.0, 10.0, 0xd3debfff, b)
  text(&mut m, "Good things", 530.0, 84.0, 38.0, 0xf4f3dfff, b)
  text(&mut m, "take space.", 530.0, 134.0, 38.0, 0xf4f3dfff, b)
  let circle = m.add(1, "Circle study", 740.0, 224.0, 84.0, 84.0, 0xd6dfb5ff)
  let at3 = m.index(circle)
  let value7 = b
  let index7 = at3
  let mut item7 = m.elements.get(index7)
  item7.parent = value7
  m.elements.set(index7, item7)

  text(&mut m, "Find your everyday ritual.", 530.0, 282.0, 12.0, 0xd3debfff, b)
  let c = m.add(3, "03 / Color & character", 500.0, 412.0, 360.0, 148.0, 0xfafaf6ff)
  text(&mut m, "THE PALETTE", 522.0, 426.0, 10.0, 0x687267ff, c)
  let colors: [u32; 5] = [0x2d4535ff, 0xd6dfb5ff, 0xe6b84eff, 0xe3ad90ff, 0xf7f5ecff]
  let mut i: usize = 0
  while i < 5 {
    let id = m.add(0, "Swatch", 522.0 + usize.toF32(i) * 64.0, 465.0, 52.0, 52.0, colors[i])
    let at4 = m.index(id)
    let value8: f32 = 26.0
    let index8 = at4
    let mut item8 = m.elements.get(index8)
    item8.shape.radius = value8
    m.elements.set(index8, item8)

    let value9 = c
    let index9 = at4
    let mut item9 = m.elements.get(index9)
    item9.parent = value9
    m.elements.set(index9, item9)

    i = i + 1
  }
