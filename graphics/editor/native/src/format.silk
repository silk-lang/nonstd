//! Portable document encoding and validated inspector values.
import ui_components.numeric as numericInput
import model { Studio, Element, Page }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.u32
import silk.num.u8
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.num.usize
import silk.json.value { Json, Value, JsonChild }
import silk.json.scanner { JsonError }

pub fn number(value: string) -> f32 {
  let parsed = numericInput.parse(value).unwrapOr(f32.NAN)
  return if f32.abs(parsed) > 1000000.0 {
    f32.NAN
  } else {
    parsed
  }
}

pub fn color(value: string) -> u32 {
  let b = String.utf8Bytes(value)
  if b.length != 7 && b.length != 9 {
    return 0
  }
  if b[0] != 35 {
    return 0
  }
  let mut v: u32 = 0
  let mut i: usize = 1
  while i < b.length {
    let c = b[i]
    let digit = if c >= 48 && c <= 57 {
      u8.toU32(c - 48)
    } else if c >= 97 && c <= 102 {
      u8.toU32(c - 87)
    } else if c >= 65 && c <= 70 {
      u8.toU32(c - 55)
    } else {
      256
    }
    if digit > 15 {
      return 0
    }
    v = v * 16 + digit
    i = i + 1
  }
  return if b.length == 7 {
    v * 256 + 255
  } else {
    v
  }
}

pub effect fn integer(text: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut n = value
  while true {
    digits[count] = u64.toU8(n % 10) + 48
    count = count + 1
    n = n / 10
    if n == 0 {
      break
    }
  }
  while count > 0 {
    count = count - 1
    let b: [u8; 1] = [digits[count]]
    run text.append(String.fromUtf8(&b) |> Result<string, InvalidUtf8>.unwrapOr("0"))
  }
}

pub effect fn decimal(value: f32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let positive = f32.abs(value)
  if value < 0.0 {
    run text.append("-")
  }
  let scaled = f32.toU64(f32.round(positive * 1000.0))
  run integer(&mut text, scaled / 1000)
  let fraction = scaled % 1000
  if fraction != 0 {
    run text.append(".")
    if fraction < 100 {
      run text.append("0")
    }
    if fraction < 10 {
      run text.append("0")
    }
    run integer(&mut text, fraction)
  }
  return move text
}

pub effect fn hex(value: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy("#")
  let digits = "0123456789abcdef"
  let mut shift: u32 = 28
  while true {
    run text.append(String.slice(digits, u32.toUsize((u32.shiftRight(value, shift)) & 15), 1))
    if shift == 0 {
      break
    }
    shift = shift - 4
  }
  return move text
}

/// The editable color label, with opaque alpha omitted.
pub effect fn colorLabel(value: u32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let digits = "0123456789ABCDEF"
  let end: u32 = if (value & 255) == 255 {
    8
  } else {
    0
  }
  let mut shift: u32 = 28
  while true {
    run text.append(String.slice(digits, u32.toUsize(u32.shiftRight(value, shift) & 15), 1))
    if shift == end {
      break
    }
    shift = shift - 4
  }
  return move text
}

pub effect fn quoted(text: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run text.append("\"")
  let bytes = String.utf8Bytes(value)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if b == 34 || b == 92 || b < 32 {
      run text.append(String.slice(value, start, i - start))
      if b == 34 {
        run text.append("\\\"")
      } else if b == 92 {
        run text.append("\\\\")
      } else if b == 10 {
        run text.append("\\n")
      } else if b == 13 {
        run text.append("\\r")
      } else if b == 9 {
        run text.append("\\t")
      } else {
        run text.append("\\u00")
        let digits = "0123456789abcdef"
        run text.append(String.slice(digits, u8.toUsize(b / 16), 1))
        run text.append(String.slice(digits, u8.toUsize(b % 16), 1))
      }
      start = i + 1
    }
    i = i + 1
  }
  run text.append(String.slice(value, start, bytes.length - start))
  run text.append("\"")
}

import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash }
import editor.document { Node }

/// A file is syntactically JSON but not a valid Studio document.
pub struct InvalidDocument {}

pub fn blendName(index: u8) -> string<'static> {
  let names: [string<'static>; 16] = [
    "normal",
    "multiply",
    "screen",
    "overlay",
    "darken",
    "lighten",
    "color-dodge",
    "color-burn",
    "hard-light",
    "soft-light",
    "difference",
    "exclusion",
    "hue",
    "saturation",
    "color",
    "luminosity",
  ]
  return names[u8.toUsize(index) & 15]
}

fn kindName(index: u32) -> string<'static> {
  let names: [string<'static>; 5] = ["rect", "ellipse", "text", "frame", "group"]
  return names[u32.toUsize(index)]
}

effect fn property(out: &mut String, name: string, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(",")
  run quoted(&mut out, name)
  run out.append(":")
  run quoted(&mut out, value)
}

effect fn numeric(out: &mut String, name: string, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(",")
  run quoted(&mut out, name)
  run out.append(":")
  let text = run decimal(value)
  run out.append(String.view(&text))
}

effect fn identifier(out: &mut String, id: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("\"")
  run integer(&mut out, u32.toU64(id))
  run out.append("\"")
}

/// Encodes the browser Studio version-one document schema.
pub effect fn encode(m: &Studio) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run String.copy("{\"version\":1,\"id\":\"native-studio\"")
  run property(&mut out, "name", m.string(m.title))
  run out.append(",\"nextId\":")
  run integer(&mut out, u32.toU64(m.nextId))
  run out.append(",\"activePageId\":")
  run identifier(&mut out, m.page)
  run out.append(",\"pages\":[")
  let mut page: usize = 0
  while page < m.pages.length() {
    let p = m.pages.get(page)
    if page > 0 {
      run out.append(",")
    }
    run out.append("{\"id\":")
    run identifier(&mut out, p.id)
    run property(&mut out, "name", m.string(p.name))
    run out.append(",\"nodes\":[")
    let mut first = true
    let mut i: usize = 0
    while i < m.elements.length() {
      let e = m.elements.get(i)
      if e.page == p.id {
        if !first {
          run out.append(",")
        }
        first = false
        run out.append("{\"id\":")
        run identifier(&mut out, e.id)
        run out.append(",\"parentId\":")
        if e.parent == 0 {
          run out.append("null")
        } else {
          run identifier(&mut out, e.parent)
        }
        run property(&mut out, "kind", kindName(e.kind))
        run property(&mut out, "name", m.string(e.name))
        run property(&mut out, "text", m.string(e.text))
        if e.image == 1 {
          run property(&mut out, "image", "tweet-challenge")
          run out.append(",\"imageCrop\":{\"x\":")
          let cropX = run fraction(e.shape.source.xMin)
          run out.append(String.view(&cropX))
          run cropNumber(&mut out, "y", e.shape.source.yMin)
          run cropNumber(&mut out, "width", e.shape.source.xMax - e.shape.source.xMin)
          run cropNumber(&mut out, "height", e.shape.source.yMax - e.shape.source.yMin)
          run out.append("}")
        }
        run property(
          &mut out,
          "fontFamily",
          if e.fontFamily == 1 {
            "Georgia"
          } else if e.fontFamily == 2 {
            "Courier New"
          } else {
            "Arial"
          },
        )
        run property(&mut out, "blendMode", blendName(e.shape.blend))
        run numeric(&mut out, "x", e.shape.x)
        run numeric(&mut out, "y", e.shape.y)
        run numeric(&mut out, "width", e.shape.width)
        run numeric(&mut out, "height", e.shape.height)
        run numeric(&mut out, "strokeWidth", e.shape.borderWidth)
        run numeric(&mut out, "radius", e.shape.radius)
        run numeric(&mut out, "opacity", e.shape.opacity)
        run numeric(&mut out, "blur", e.shape.blur)
        run numeric(&mut out, "shadowX", e.shape.shadowX)
        run numeric(&mut out, "shadowY", e.shape.shadowY)
        run numeric(&mut out, "fontSize", e.fontSize)
        run numeric(&mut out, "fontWeight", u32.toF32(e.fontWeight))
        run numeric(&mut out, "layerBlur", e.shape.effects.blur)
        run numeric(&mut out, "backdropBlur", e.shape.effects.backdropBlur)
        run numeric(&mut out, "brightness", e.shape.effects.brightness)
        run numeric(&mut out, "contrast", e.shape.effects.contrast)
        run numeric(&mut out, "saturation", e.shape.effects.saturation)
        run numeric(&mut out, "innerBlur", e.shape.innerBlur)
        run numeric(&mut out, "innerShadowX", e.shape.innerX)
        run numeric(&mut out, "innerShadowY", e.shape.innerY)
        let color0 = run hex(e.shape.fill)
        run property(&mut out, "fill", String.view(&color0))
        let color1 = run hex(e.shape.border)
        run property(&mut out, "stroke", String.view(&color1))
        let color2 = run hex(e.shape.shadow)
        run property(&mut out, "shadow", String.view(&color2))
        let color3 = run hex(e.shape.innerShadow)
        run property(&mut out, "innerShadow", String.view(&color3))
        run out.append(
          if (e.shape.flags & 1) != 0 {
            ",\"hidden\":true"
          } else {
            ",\"hidden\":false"
          },
        )
        run out.append(
          if (e.shape.flags & 2) != 0 {
            ",\"locked\":true}"
          } else {
            ",\"locked\":false}"
          },
        )
      }
      i = i + 1
    }
    run out.append("]}")
    page = page + 1
  }
  run out.append("]}\n")
  return move out
}

fn stringField<'a>(value: &'a Value, name: string) -> string<'a> {
  return Json.asString(Json.field(value, name)) |> Option<string>.unwrapOr("")
}

effect fn scalar(value: &Value, name: string, fallback: f32, min: f32, max: f32) -> f32
  ! InvalidDocument {
  let n = Json.asF32(Json.field(value, name)) |> Option<f32>.unwrapOr(fallback)
  if !(n >= min && n <= max) {
    fail InvalidDocument {}
  }
  return n
}

effect fn colorField(value: &Value, name: string, fallback: u32) -> u32
  ! InvalidDocument {
  let text = stringField(value, name)
  if text == "" {
    return fallback
  }
  let bytes = String.utf8Bytes(text)
  if (bytes.length != 7 && bytes.length != 9) || bytes[0] != 35 {
    fail InvalidDocument {}
  }
  let mut i: usize = 1
  while i < bytes.length {
    let c = bytes[i]
    if !((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) {
      fail InvalidDocument {}
    }
    i = i + 1
  }
  return color(text)
}

fn boolean(value: &Value, name: string) -> bool {
  if let Option<&Value>.Some { value: found } = Json.field(value, name) {
    if let Value.Bool { value: flag } = &found.* {
      return flag
    }
  }
  return false
}

effect fn array<'a>(value: &'a Value, name: string) -> &'a [JsonChild]
  ! InvalidDocument {
  if let Option<&Value>.Some { value: list } = Json.field(value, name) {
    if let Value.Array { values } = &list.* {
      return values.get()[0].asSlice()
    }
  }
  fail InvalidDocument {}
}

/// Reads browser and native files, rejecting duplicate ids, missing parents and cycles.
pub effect fn decode(bytes: &[u8]) -> Studio
  ! JsonError | InvalidDocument | OutOfMemoryError
  ? &mut Allocator {
  if bytes.length > 268435456 {
    fail InvalidDocument {}
  }
  let document = run Json.parse(bytes)
  if (Json.asU64(Json.field(&document, "version")) |> Option<u64>.unwrapOr(0)) != 1 {
    fail InvalidDocument {}
  }
  let pages = run array(&document, "pages")
  if pages.length == 0 || pages.length > 100 {
    fail InvalidDocument {}
  }
  let mut ids = HashMap<string, u32>.make(Hash.seed(1827))
  let mut next: u32 = 1
  let mut pi: usize = 0
  while pi < pages.length {
    if let JsonChild.Item { value: page } = &pages[pi] {
      let key = stringField(&page, "id")
      if key == "" || ids.contains(key) {
        fail InvalidDocument {}
      }
      drop run ids.insert(key, next)
      next = next + 1
      let nodes = run array(&page, "nodes")
      if nodes.length > 400000 {
        fail InvalidDocument {}
      }
      let mut ni: usize = 0
      while ni < nodes.length {
        if let JsonChild.Item { value: node } = &nodes[ni] {
          let id = stringField(&node, "id")
          if id == "" || ids.contains(id) {
            fail InvalidDocument {}
          }
          drop run ids.insert(id, next)
          next = next + 1
        }
        ni = ni + 1
      }
    }
    pi = pi + 1
  }
  let mut m = Studio.make()
  m.title = m.intern(stringField(&document, "name"))
  m.nextId = next
  m.page = ids.get(stringField(&document, "activePageId")) |> Option<u32>.unwrapOr(0)
  pi = 0
  while pi < pages.length {
    if let JsonChild.Item { value: page } = &pages[pi] {
      let pageId = ids.get(stringField(&page, "id")) |> Option<u32>.unwrapOr(0)
      let pageName = m.intern(stringField(&page, "name"))
      run m.pages.append(Page { id: pageId, name: pageName })
      let nodes = run array(&page, "nodes")
      let mut ni: usize = 0
      while ni < nodes.length {
        if let JsonChild.Item { value: node } = &nodes[ni] {
          let id = ids.get(stringField(&node, "id")) |> Option<u32>.unwrapOr(0)
          let kind = stringField(&node, "kind")
          let kindId: u32 = if kind == "rect" {
            0
          } else if kind == "ellipse" {
            1
          } else if kind == "text" {
            2
          } else if kind == "frame" {
            3
          } else if kind == "group" {
            4
          } else {
            5
          }
          if kindId > 4 {
            fail InvalidDocument {}
          }
          let parentName = stringField(&node, "parentId")
          let parent = ids.get(parentName) |> Option<u32>.unwrapOr(0)
          if parentName != "" && parent == 0 {
            fail InvalidDocument {}
          }
          let name = m.intern(stringField(&node, "name"))
          let textValue = stringField(&node, "text")
          if String.byteLength(textValue) > 40000 {
            fail InvalidDocument {}
          }
          let text = m.intern(textValue)
          let mut e = Element {
            id: id,
            page: pageId,
            parent: parent,
            kind: kindId,
            name: name,
            text: text,
            image: 0,
            autoSize: false,
            fontSize: 32.0,
            fontWeight: 400,
            fontFamily: 0,
            shape: Node.rect(0.0, 0.0, 1.0, 1.0, 0xffffffff),
            selected: false,
          }
          let asset = stringField(&node, "image")
          if asset != "" {
            if asset != "tweet-challenge" || kindId != 0 {
              fail InvalidDocument {}
            }
            e.image = 1
            if let Option<&Value>.Some { value: crop } = Json.field(&node, "imageCrop") {
              if let Value.Object { entries: _ } = &crop.* {
                let x = run scalar(crop, "x", 0.0, 0.0, 1.0)
                let y = run scalar(crop, "y", 0.0, 0.0, 1.0)
                let w = run scalar(crop, "width", 1.0, 0.000001, 1.0)
                let h = run scalar(crop, "height", 1.0, 0.000001, 1.0)
                if x + w > 1.000001 || y + h > 1.000001 {
                  fail InvalidDocument {}
                }
                e.shape.source = Rect<f32>.new(x, y, f32.min(1.0, x + w), f32.min(1.0, y + h))
              }
            }
          }
          if kindId == 1 {
            e.shape.kind = 1
          }
          e.shape.x = run scalar(&node, "x", 0.0, -1000000.0, 1000000.0)
          e.shape.y = run scalar(&node, "y", 0.0, -1000000.0, 1000000.0)
          e.shape.width = run scalar(&node, "width", 1.0, 0.1, 100000.0)
          e.shape.height = run scalar(&node, "height", 1.0, 0.1, 100000.0)
          e.shape.borderWidth = run scalar(&node, "strokeWidth", 0.0, 0.0, 1000.0)
          e.shape.radius = run scalar(&node, "radius", 0.0, 0.0, 50000.0)
          e.shape.opacity = run scalar(&node, "opacity", 1.0, 0.0, 1.0)
          e.shape.blur = run scalar(&node, "blur", 0.0, 0.0, 1000.0)
          e.shape.shadowX = run scalar(&node, "shadowX", 0.0, -1000000.0, 1000000.0)
          e.shape.shadowY = run scalar(&node, "shadowY", 0.0, -1000000.0, 1000000.0)
          e.fontSize = run scalar(&node, "fontSize", 32.0, 1.0, 512.0)
          e.fontWeight = f32.toU32(run scalar(&node, "fontWeight", 400.0, 100.0, 900.0))
          e.shape.effects.blur = run scalar(&node, "layerBlur", 0.0, 0.0, 1000.0)
          e.shape.effects.backdropBlur = run scalar(&node, "backdropBlur", 0.0, 0.0, 1000.0)
          e.shape.effects.brightness = run scalar(&node, "brightness", 1.0, 0.0, 4.0)
          e.shape.effects.contrast = run scalar(&node, "contrast", 1.0, 0.0, 4.0)
          e.shape.effects.saturation = run scalar(&node, "saturation", 1.0, 0.0, 4.0)
          e.shape.innerBlur = run scalar(&node, "innerBlur", 0.0, 0.0, 1000.0)
          e.shape.innerX = run scalar(&node, "innerShadowX", 0.0, -1000000.0, 1000000.0)
          e.shape.innerY = run scalar(&node, "innerShadowY", 0.0, -1000000.0, 1000000.0)
          e.shape.fill = run colorField(&node, "fill", 0)
          e.shape.border = run colorField(&node, "stroke", 0)
          e.shape.shadow = run colorField(&node, "shadow", 0)
          e.shape.innerShadow = run colorField(&node, "innerShadow", 0)
          let family = stringField(&node, "fontFamily")
          e.fontFamily = if family == "Georgia" {
            1
          } else if family == "Courier New" {
            2
          } else {
            0
          }
          let blend = stringField(&node, "blendMode")
          let mut bi: u8 = 0
          while bi < 16 {
            if blendName(bi) == blend {
              e.shape.blend = bi
            }
            bi = bi + 1
          }
          if boolean(&node, "hidden") {
            e.shape.flags = e.shape.flags | 1
          }
          if boolean(&node, "locked") {
            e.shape.flags = e.shape.flags | 2
          }
          run m.elements.append(e)
        }
        ni = ni + 1
      }
    }
    pi = pi + 1
  }
  m.reindex()
  let mut active = false
  pi = 0
  while pi < m.pages.length() {
    if m.pages.get(pi).id == m.page {
      active = true
    }
    pi = pi + 1
  }
  if !active {
    fail InvalidDocument {}
  }
  let mut i: usize = 0
  while i < m.elements.length() {
    let e = m.elements.get(i)
    let mut parent = e.parent
    let mut depth: u32 = 0
    while parent != 0 {
      let index = m.index(parent)
      if index == usize.MAX || parent == e.id || depth >= 64 {
        fail InvalidDocument {}
      }
      let p = m.elements.get(index)
      if p.page != e.page || (p.kind != 3 && p.kind != 4) {
        fail InvalidDocument {}
      }
      parent = p.parent
      depth = depth + 1
    }
    i = i + 1
  }
  m.fit(false)
  return move m
}

/// Whether an inspector color is a complete RGB or RGBA hex value.
pub fn validColor(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  if (bytes.length != 7 && bytes.length != 9) || bytes[0] != 35 {
    return false
  }
  let mut i: usize = 1
  while i < bytes.length {
    let c = bytes[i]
    if !((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)) {
      return false
    }
    i = i + 1
  }
  return true
}

/// A camera zoom as a rounded percentage for the editable zoom control.
pub effect fn zoomLabel(zoom: f32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run decimal(f32.floor(zoom * 100.0 + 0.5))
  run text.append("%")
  return move text
}

// Seven fractional places retain subpixel crop boundaries across a JSON round trip.
effect fn fraction(value: f32) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let scaled = f32.toU64(f32.round(value * 10000000.0))
  run integer(&mut text, scaled / 10000000)
  run text.append(".")
  let remainder = scaled % 10000000
  let mut divisor: u64 = 1000000
  while divisor > 1 && remainder < divisor {
    run text.append("0")
    divisor = divisor / 10
  }
  run integer(&mut text, remainder)
  return move text
}

effect fn cropNumber(out: &mut String, name: string, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(",")
  run quoted(&mut out, name)
  run out.append(":")
  let number = run fraction(value)
  run out.append(String.view(&number))
}
