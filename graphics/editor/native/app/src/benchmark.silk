//! Deterministic renderer benchmark harness. Ordinary windows use desktop.silk.
//! Runs a ui-app [`Runtime`] in a native window: platform/window for the window and input,
//! ui-tree-window to turn window events into tree input, and ui_renderer on WebGPU (Dawn) for
//! the frames.
//!
//! The loop waits for window events, with a timeout at the runtime's next timer, or polls while
//! the app subscribes to animation frames. Input goes to the tree, the tree's records go to the
//! runtime, and a frame is drawn when the tree wants one.
//!
//! An app runs with the inspector (ui/inspect/server) when it passes one that is on to
//! [`runWindowWith`]: requests are served from the loop, input they dispatch is pumped to the app
//! like window input, the records the app takes go to the inspector's event log, and the
//! highlight is drawn over the frame.
//!
//! `check` mode ignores real input: after the first frame it clicks the node named
//! `options.checkClick` and presses Tab through the same path a user's input takes, draws two
//! more frames, reads the window's surface back and compares it with the CPU reference of the
//! same frame. It returns 0 within tolerance, 1 outside and 2 on an error.
import menus
import studio.editing as editing
import studio.samples as samples
import studio.exports as exportDocument
import codec.image { ImageError }
import codec.png { PngError }
import codec.jpeg { JpegError }
import files { Storage }
import silk.collections.bytes { Bytes }
import window.menu { OpenDialog, SaveDialog }
import window.types { DialogId }
import silk.core.result { Result }
import ui_tree.inspect { encodePng }
import studio.model { Studio, Message }
import studio.render { Canvas, textResources }
import ui_app.app { NoCommand }
import ui_tree.input { Input, MOD_CONTROL }
import ui_app.runtime { Runtime, pump, tick, resize }
import ui_app.harness { click, press }
import ui_tree.inspect { findAll }
import ui_tree.lib { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import ui_tree_window.lib { feed, windowCursor, HostState, serve }
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import demo.compare { Tolerance, compare }
import demo_host.frames { copyOut, isBgra, pickFormat, readbackSize, unpack }
import atlas.atlas { Atlas, AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import window.event { Event }
import window.native { NativePlatform }
import window.platform { Platform }
import window.types { RawSurface, Wait, WindowError, WindowId, WindowOptions, TitleBar }
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources { Queue, Texture, getQueue }
import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.size { Size2 }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.text.string { String }
import silk.num.f64
import silk.num.i64
import silk.num.u64

/// How to open the window.
pub struct RunOptions {
  pub title: string<'static>,
  /// The content size in logical points (CSS pixels).
  pub width: f64,
  pub height: f64,
  /// Script and check the frame instead of taking input (see the module documentation).
  pub check: bool,
  /// Print frame-stage CPU timings for local performance investigations.
  pub profile: bool,
  /// Exercise a deterministic overview zoom and pan path, then exit without saving.
  pub benchmark: bool,
  pub retained: bool,
  /// The test id, label or text of the node `check` clicks.
  pub checkClick: string<'static>,
  /// The test id, label or text of a node that must exist after the click.
  pub checkExpect: string<'static>,
}

/// The frame `check` reads back: the scripted input goes in after frame 1.
const CHECK_FRAME: u64 = 3

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

fn deviceSize(logical: f64, scale: f64) -> u32 {
  return f64.toU32(f64.floor(logical * scale + 0.5))
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut OsMonotonicClock) -> f64 {
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&now))
    + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000000.0
}

/// Whether a node's test id, label or text is `value`.
effect fn exists(tree: &UiTree, value: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, value, &mut found)
  return found.length() != 0
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns the exit code.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}

pub effect fn runWindowWith(
  app: &mut Runtime<Studio, Message, NoCommand>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  storage: &mut Storage,
) -> i32
  ! JpegError
    | PngError
    | ImageError
    | WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
  ? &mut Allocator {
  let check = options.check
  let mut inspector = if check || options.benchmark {
    drop inspector
    Inspector.off()
  } else {
    move inspector
  }
  let mut clock = OsMonotonicClock.make()
  let started = run seconds(&mut clock)
  let mut tree = run UiTree.make(collection)
  tree.atlas = Atlas.make(Canvas.atlasOptions())
  run tree.apply(move resources)
  run app.start(&mut tree, 0.0)
  let mut snapshot = CpuSnapshot.make()
  let mut canvas = Canvas.make()
  run canvas.loadAssets(&mut tree)
  let mut textTree = run UiTree.make(collection)
  run textResources(&mut textTree)
  let mut textSnapshot = CpuSnapshot.make()

  let mut platform = run NativePlatform.start()
  let mut windowOptions = WindowOptions.make(options.title, options.width, options.height)
  windowOptions.minSize = Option<Size2<f64>>.some(Size2<f64>.new(800.0, 600.0))
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    windowOptions.titleBar = TitleBar.Transparent
  }
  let window = run platform.openWindow(&windowOptions)
  let owner = window
  let mut host = HostState.make()
  let menu = run menus.make()
  run platform.setMenuBar(&menu)
  platform.focus(owner)
  let raw = platform.rawSurface(window)
  let target = match unsafe targetOf(&owner, raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-app: this backend has no GPU surface\n", &())
      return 2
    }
  }
  let instance = run Instance.create()
  let surface = run Surface.create(&instance, &target, String.utf8Bytes("ui app"))
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&surface))
  let capabilities = run surface.getCapabilities(&adapter)
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-app: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    return 2
  }
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, format)
  let mut imageRenderer = run UiRenderer.make(&device, format)
  let mut uploadedImages: u64 = 18446744073709551615
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  if check {
    let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
    if !canCopy {
      StderrWriter.print("ui-app: the surface cannot be read back\n", &())
      return 2
    }
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
    renderer.setTextSettings(TextSettings.none())
  }
  if capabilities.alphaModes().length != 0 {
    configuration.setAlphaMode(capabilities.alphaModes()[0])
  }

  let initial = platform.contentSize(window)
  let mut width = initial.width
  let mut height = initial.height
  let mut scale = platform.scaleFactor(window)
  let mut configured = false
  let mut drawn: u64 = 0
  let mut status: i32 = 0
  let mut dialogKind: u32 = 0
  let mut pendingDialog = DialogId { value: 0 }
  run resize(&mut app, &mut tree, f64.toF32(width), f64.toF32(height))
  platform.requestFrame(owner)
  while true {
    // Wait for input or a frame, at most until the next timer.
    let now = (run seconds(&mut clock)) - started
    if canvas.textRefinementDue(now) {
      platform.requestFrame(owner)
    }
    let wait = if check || options.benchmark {
      Wait.Seconds { seconds: 0.016 }
    } else {
      let mut deadline = match app.nextDeadline() {
        Option<f64>.Some { value } => if value > now {
          value - now
        } else {
          0.0
        }
        Option<f64>.None => -1.0
      }
      if let Option<f64>.Some { value } = canvas.nextTextDeadline() {
        // Once due, wait for the requested display callback instead of spinning
        // with a zero timeout (an occluded window may receive no callback).
        if value > now {
          let remaining = value - now
          if deadline < 0.0 || remaining < deadline {
            deadline = remaining
          }
        }
      }
      match inspector.pollInterval() {
        Option<f64>.Some { value } => Wait.Seconds {
          seconds: if deadline >= 0.0 && deadline < value {
            deadline
          } else {
            value
          },
        }
        Option<f64>.None => if deadline >= 0.0 {
          Wait.Seconds { seconds: deadline }
        } else {
          Wait.Forever
        }
      }
    }
    let mut next = run platform.nextEvent(wait)
    let time = (run seconds(&mut clock)) - started
    if options.benchmark {
      if let Option<Event>.None = &next {
        next = Option<Event>.some(Event.RequestFrame { window: owner, targetTime: time })
      }
    }
    let mut redraw = false
    if !check {
      run tick(&mut app, &mut tree, time, false)
      redraw = canvas.needsFrame(&app.model, &tree)
    }
    if run inspector.poll(&mut tree) {
      while true {
        // Input from the inspector is answered like window input.
        run serve(&mut platform, owner, &mut tree, &mut host)
        run inspector.observe(&tree)
        drop run pump(&mut app, &mut tree)
        if !run inspector.dispatchNext(&mut tree) {
          break
        }
      }
      platform.setCursor(owner, windowCursor(tree.cursor()))
      redraw = true
    }
    if let Option<Event>.Some { value } = &next {
      let mut resized = false
      match &value {
        Event.RequestFrame { window: _, targetTime } => {
          if configured || deviceSize(width, scale) > 0 {
            if !configured {
              surface.resize(
                &mut configuration,
                deviceSize(width, scale),
                deviceSize(height, scale),
              )
              configured = true
            }
            let viewport = FrameInput {
              width: f64.toF32(width),
              height: f64.toF32(height),
              scale: f64.toF32(scale),
              time: targetTime,
            }
            if check && !options.benchmark && drawn == 1 {
              drop run click(&mut app, &mut tree, viewport, options.checkClick)
              run press(&mut app, &mut tree, viewport, "Tab", 0)
            }
            if !check && app.wantsFrames() {
              run tick(&mut app, &mut tree, time, true)
            }
            let frameStart = run seconds(&mut clock)
            if options.benchmark && drawn > 0 {
              run tree.dispatch(
                Input.Wheel {
                  x: 740.0,
                  y: 550.0,
                  deltaX: if drawn > 120 {
                    if drawn <= 140 {
                      6.0
                    } else {
                      -6.0
                    }
                  } else {
                    0.0
                  },
                  deltaY: if drawn <= 60 {
                    -17.5
                  } else if drawn <= 120 {
                    16.35514
                  } else {
                    0.0
                  },
                  modifiers: if drawn <= 120 {
                    MOD_CONTROL
                  } else {
                    0
                  },
                },
              )
              drop run pump(&mut app, &mut tree)
            }
            if run canvas.normalize(&mut app.model, &mut textTree) {
              run app.render(&mut tree)
            }
            run tree.frame(viewport)
            run serve(&mut platform, owner, &mut tree, &mut host)
            if run pump(&mut app, &mut tree) {
              run tree.frame(viewport)
              run serve(&mut platform, owner, &mut tree, &mut host)
            }
            let layoutEnd = run seconds(&mut clock)
            if !check && !options.benchmark {
              run canvas.frameInteractive(
                &app.model,
                &mut tree,
                &mut textTree,
                &mut textSnapshot,
                f64.toF32(scale),
                time,
                !inspector.enabled() && options.retained,
              )
            } else if !inspector.enabled() && options.retained {
              run canvas.frameRetained(
                &app.model,
                &mut tree,
                &mut textTree,
                &mut textSnapshot,
                f64.toF32(scale),
              )
            } else {
              run canvas.frame(
                &app.model,
                &mut tree,
                &mut textTree,
                &mut textSnapshot,
                f64.toF32(scale),
              )
            }
            let canvasEnd = run seconds(&mut clock)
            run textures.sync(&device, &tree.atlas)
            let pending = tree.pendingUploads()
            let list = pending.entries()
            let mut i: usize = 0
            while i < list.length {
              textures.write(&queue, list[i].tile, pending.pixels(list[i]))
              i = i + 1
            }
            run inspector.afterFrameScene(&tree, &canvas.scene)
            run snapshot.sync(&mut tree)
            let deviceWidth = deviceSize(width, scale)
            let deviceHeight = deviceSize(height, scale)
            let texture = run surface.getCurrentTexture()
            let view = run texture.texture.createView(&TextureViewDescriptor.default())
            let uploadEnd = run seconds(&mut clock)
            if canvas.retained {
              let imageScale = app.model.zoom * f64.toF32(scale)
              run imageRenderer.drawRetainedImages(
                &device,
                &queue,
                &canvas.retainedScene,
                &textures,
                &view,
                deviceWidth,
                deviceHeight,
                color.rgb(0xe8eae6),
                imageScale,
                (canvas.retainedX - app.model.cameraX) * imageScale
                  + app.model.canvasLeft() * f64.toF32(scale),
                (canvas.retainedY - app.model.cameraY) * imageScale
                  + app.model.canvasTop() * f64.toF32(scale),
                uploadedImages != canvas.retainedRevision,
              )
              uploadedImages = canvas.retainedRevision
              run renderer.drawOverlay(
                &device,
                &queue,
                &canvas.scene,
                &textures,
                &view,
                deviceWidth,
                deviceHeight,
              )
            } else {
              run renderer.draw(
                &device,
                &queue,
                inspector.sceneWith(&canvas.scene),
                &textures,
                &view,
                deviceWidth,
                deviceHeight,
                color.white(),
              )
            }
            let drawEnd = run seconds(&mut clock)
            drawn = drawn + 1
            if check && !options.benchmark && drawn == CHECK_FRAME
              && !(run exists(&tree, options.checkExpect)) {
              StderrWriter.print("check: the scripted click did not reach the app\n", &())
              status = 1
            } else if check
              && ((!options.benchmark && drawn == CHECK_FRAME)
                || options.benchmark && drawn == 161) {
              if options.benchmark {
                // Compare two real GPU paths on the same device and atlas. The CPU
                // sampler differs visibly for subpixel-sized image crops at fit-all.
                let buffer = run copyOut(
                  &device,
                  &queue,
                  &texture.texture,
                  deviceWidth,
                  deviceHeight,
                )
                let padded = run runtime.mapRead(
                  &device,
                  &buffer,
                  0,
                  readbackSize(deviceWidth, deviceHeight),
                )
                let retainedPixels = run unpack(
                  padded.asSlice(),
                  deviceWidth,
                  deviceHeight,
                  isBgra(format),
                )
                run canvas.frame(
                  &app.model,
                  &mut tree,
                  &mut textTree,
                  &mut textSnapshot,
                  f64.toF32(scale),
                )
                run renderer.draw(
                  &device,
                  &queue,
                  &canvas.scene,
                  &textures,
                  &view,
                  deviceWidth,
                  deviceHeight,
                  color.white(),
                )
                status = run checkFrame(
                  &device,
                  &queue,
                  &texture.texture,
                  isBgra(format),
                  retainedPixels.asSlice(),
                  deviceWidth,
                  deviceHeight,
                )
              } else {
                let reference = run snapshot.renderScene(&tree, &canvas.scene)
                let png = run encodePng(&reference)
                drop run storage.writeBytes(
                  "/tmp/silk-studio-native-check.png",
                  Bytes.asSlice(&png),
                )
                status = run checkFrame(
                  &device,
                  &queue,
                  &texture.texture,
                  isBgra(format),
                  reference.data(),
                  deviceWidth,
                  deviceHeight,
                )
              }
            }
            run surface.present()
            run device.checkErrors()
            if options.profile {
              let frameEnd = run seconds(&mut clock)
              StderrWriter.print(
                "frame-ms: layout={} canvas={} upload={} draw={} present={}\n",
                &(
                  (layoutEnd - frameStart) * 1000.0,
                  (canvasEnd - layoutEnd) * 1000.0,
                  (uploadEnd - canvasEnd) * 1000.0,
                  (drawEnd - uploadEnd) * 1000.0,
                  (frameEnd - drawEnd) * 1000.0
                ),
              )
            }
            if options.benchmark && drawn >= 161
              || check && !options.benchmark && drawn >= CHECK_FRAME {
              break
            }
            platform.setCursor(owner, windowCursor(tree.cursor()))
          }
          redraw = check || options.benchmark || app.wantsFrames()
            || canvas.needsFrame(&app.model, &tree)
        }
        Event.Resized { window: _, size, scaleFactor } => {
          width = size.width
          height = size.height
          scale = scaleFactor
          resized = true
        }
        Event.ScaleFactorChanged { window: _, scaleFactor } => {
          scale = scaleFactor
          resized = true
        }
        Event.Pinch { position, delta, .. } => {
          if !check {
            editing.wheel(
              &mut app.model,
              f64.toF32(position.x),
              f64.toF32(position.y),
              0.0,
              -f64.toF32(delta) * 250.0,
              true,
            )
            run app.render(&mut tree)
            redraw = true
          }
        }
        Event.Focused { focused, .. } => {
          drop run feed(&mut tree, &value)
          run serve(&mut platform, owner, &mut tree, &mut host)
          drop run pump(&mut app, &mut tree)
          if !focused {
            app.model.space = false
            if app.model.gesture != 0 {
              editing.cancel(&mut app.model)
            }
            run app.render(&mut tree)
            redraw = true
          }
        }
        Event.MenuAction { action } => {
          editing.action(&mut app.model, action)
          run app.render(&mut tree)
          redraw = true
        }
        Event.DialogClosed { dialog, paths } => {
          if dialog.value == pendingDialog.value {
            if paths.length() != 0 {
              let chosen = String.view(&paths.asSlice()[0])
              if dialogKind == 3 {
                // Preserve the current design before switching documents.
                let saved = run storage.save(&mut app.model)
                if saved {
                  if let Option<Studio>.Some { value: loaded } = run storage.open(chosen) {
                    canvas.reset(&mut tree)
                    uploadedImages = 18446744073709551615
                    app.model = move loaded
                  } else {
                    app.model.notice = run String.copy("Could not open that Silk document")
                  }
                }
              } else if dialogKind == 1 {
                let result = run Effect.result(exportDocument.svg(&app.model))
                match move result {
                  Result<String, exportDocument.UnsupportedBackdrop | OutOfMemoryError>.Success {
                    value: svg
                  } => {
                    let ok = run storage.writeBytes(chosen, String.utf8Bytes(String.view(&svg)))
                    app.model.notice = run String.copy(
                      if ok {
                        "SVG exported"
                      } else {
                        "Could not write SVG"
                      },
                    )
                  }
                  Result<String, exportDocument.UnsupportedBackdrop | OutOfMemoryError>.Failure {
                    error
                  } => {
                    drop error
                    app.model.notice = run String.copy(
                      "SVG cannot preserve backdrop blur. Export PNG or .silkdesign instead.",
                    )
                  }
                }
              } else if dialogKind == 2 {
                let pixels = run canvas.exportPixels(
                  &mut app.model,
                  &mut tree,
                  &mut textTree,
                  &mut textSnapshot,
                  &mut snapshot,
                )
                let png = run encodePng(&pixels)
                let ok = run storage.writeBytes(chosen, Bytes.asSlice(&png))
                app.model.notice = run String.copy(
                  if ok {
                    "PNG exported"
                  } else {
                    "Could not write PNG"
                  },
                )
              } else if dialogKind == 5 {
                if run storage.save(&mut app.model) {
                  let mut fresh = Studio.make()
                  samples.page(&mut fresh, "Page 1")
                  fresh.title = fresh.intern("Untitled")
                  fresh.revision = 1
                  let previous = run String.copy(String.view(&storage.path))
                  storage.path = run String.copy(chosen)
                  if run storage.save(&mut fresh) {
                    canvas.reset(&mut tree)
                    uploadedImages = 18446744073709551615
                    app.model = move fresh
                  } else {
                    storage.path = move previous
                    app.model.notice = run String.copy("Could not create the new document")
                  }
                }
              } else if dialogKind == 4 {
                let previous = run String.copy(String.view(&storage.path))
                storage.path = run String.copy(chosen)
                if !(run storage.save(&mut app.model)) {
                  storage.path = move previous
                }
              }
              run app.render(&mut tree)
              redraw = true
            }
            dialogKind = 0
          }
        }
        Event.CloseRequested { window: _ } => {
          editing.commitDraft(&mut app.model)
          if !check && !options.benchmark && app.model.revision != app.model.savedRevision
            && !(run storage.save(&mut app.model)) {
            continue
          }
          break
        }
        Event.QuitRequested => {
          editing.commitDraft(&mut app.model)
          if !check && !options.benchmark && app.model.revision != app.model.savedRevision
            && !(run storage.save(&mut app.model)) {
            continue
          }
          break
        }
        _ => {
          if !check && run feed(&mut tree, &value) {
            run serve(&mut platform, owner, &mut tree, &mut host)
            run inspector.observe(&tree)
            drop run pump(&mut app, &mut tree)
            platform.setCursor(owner, windowCursor(tree.cursor()))
            redraw = canvas.needsFrame(&app.model, &tree)
          }
        }
      }
      if resized {
        let w = deviceSize(width, scale)
        let h = deviceSize(height, scale)
        if w > 0 && h > 0 {
          surface.resize(&mut configuration, w, h)
          configured = true
        }
        run resize(&mut app, &mut tree, f64.toF32(width), f64.toF32(height))
        redraw = true
      }
    }
    if !check && !options.benchmark && storage.collect(&mut app.model, false) {
      run app.render(&mut tree)
      redraw = true
    }
    if !check && !options.benchmark && app.model.saveRequested {
      run storage.autosave(&mut app.model)
      run app.render(&mut tree)
      redraw = true
    }
    if !check && app.model.exportRequested != 0 && dialogKind == 0 {
      dialogKind = app.model.exportRequested
      app.model.exportRequested = 0
      if dialogKind == 3 {
        let mut options = OpenDialog.file("Open Silk document", "silkdesign,json")
        options.parent = Option<WindowId>.some(owner)
        pendingDialog = run platform.openFileDialog(&options)
      } else {
        let mut options = SaveDialog.named(
          if dialogKind == 5 {
            "New document"
          } else if dialogKind == 4 {
            "Save as"
          } else {
            "Export"
          },
          if dialogKind == 1 {
            "Design.svg"
          } else if dialogKind == 2 {
            "Design.png"
          } else {
            "Design.silkdesign"
          },
          if dialogKind == 1 {
            "svg"
          } else if dialogKind == 2 {
            "png"
          } else {
            "silkdesign"
          },
        )
        options.parent = Option<WindowId>.some(owner)
        pendingDialog = run platform.saveFileDialog(&options)
      }
    }

    // Hidden/occluded windows receive no display-link callback. Inspector commands still
    // need a composed frame before the next request; leave GPU uploads pending for display.
    if inspector.enabled()
      && (canvas.needsFrame(&app.model, &tree) || inspector.wantsFrame()
        || canvas.textRefinementDue(time)) {
      if run canvas.normalize(&mut app.model, &mut textTree) {
        run app.render(&mut tree)
      }
      run tree.frame(
        FrameInput {
          width: f64.toF32(width),
          height: f64.toF32(height),
          scale: f64.toF32(scale),
          time: time,
        },
      )
      run serve(&mut platform, owner, &mut tree, &mut host)
      run canvas.frameInteractive(
        &app.model,
        &mut tree,
        &mut textTree,
        &mut textSnapshot,
        f64.toF32(scale),
        time,
        false,
      )
      run inspector.afterFrameScene(&tree, &canvas.scene)
      redraw = true
    }
    if redraw || canvas.textRefinementDue(time) {
      platform.requestFrame(owner)
    }
  }
  run inspector.close()
  surface.unconfigure()
  platform.closeWindow(owner)
  return status
}
