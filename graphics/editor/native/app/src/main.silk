//! Silk Studio's native desktop entry point.
import codec.image { ImageError }
import codec.png { PngError }
import codec.jpeg { JpegError }
import studio.model { Studio, Message }
import studio.samples as samples
import studio.view as view
import studio.format as format
import silk.num.f32
import files { Storage, InvalidFile, defaultPath, desktopFonts }
import silk.system.filesystem { FileError }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }
import ui_app.app { NoCommand }
import ui_app.runtime { Runtime }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { Batch }
import ui_inspect_server.lib { Inspector, InspectorOptions }
import desktop { RunOptions, runWindowWith }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.io.writer_native { StderrWriter }
import silk.text.string { String }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import ui_tree.lib { TreeError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }

effect fn program() -> i32
  ! JpegError
    | PngError
    | ImageError
    | WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | HostInputError
    | FileError
    | InvalidFile
  ? &mut Allocator | &mut HostInput {
  let mut check = false
  let mut inspect = false
  let mut profile = false
  let mut benchmark = false
  let mut retained = true
  let mut width: f32 = 1440.0
  let mut height: f32 = 960.0
  let mut path = run defaultPath()
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      let argument = String.fromUtf8(Bytes.asSlice(&value))
        |> Result<string, InvalidUtf8>.unwrapOr("")
      if String.startsWith(argument, "--width=") {
        let number = format.number(String.slice(argument, 8, String.byteLength(argument) - 8))
        if number == number {
          width = f32.max(800.0, f32.min(4096.0, number))
        }
      } else if String.startsWith(argument, "--height=") {
        let number = format.number(String.slice(argument, 9, String.byteLength(argument) - 9))
        if number == number {
          height = f32.max(600.0, f32.min(4096.0, number))
        }
      } else if Bytes.asSlice(&value) == b"--check" {
        check = true
      } else if Bytes.asSlice(&value) == b"--benchmark" {
        benchmark = true
        profile = true
      } else if Bytes.asSlice(&value) == b"--no-retained" {
        retained = false
      } else if Bytes.asSlice(&value) == b"--profile" {
        profile = true
      } else if Bytes.asSlice(&value) == b"--inspect" {
        inspect = true
      } else {
        path = run String.copy(
          String.fromUtf8(Bytes.asSlice(&value)) |> Result<string, InvalidUtf8>.unwrapOr(""),
        )
      }
    }
    i = i + 1
  }
  let mut collection = run fixtures.fonts()
  run desktopFonts(&mut collection)
  let mut batch = Batch.make()
  run batch.fontFamily(1, ".SF NS, System Font, Arial, Noto Sans, sans-serif")
  run view.resources(&mut batch)
  let mut storage = run Storage.make(move path)
  run batch.fontFamily(2, "Arial, Noto Sans, sans-serif")
  run batch.fontFamily(3, "Georgia, Noto Serif, serif")
  run batch.fontFamily(4, "Courier New, Noto Mono, monospace")
  let mut model = if benchmark {
    let mut sample = Studio.make()
    samples.challenge(&mut sample)
    move sample
  } else if check {
    let mut sample = Studio.make()
    samples.starter(&mut sample)
    sample.fit(false)
    move sample
  } else {
    run storage.initial()
  }
  model.width = width
  model.height = height
  model.fit(false)
  let mut app = Runtime<Studio, Message, NoCommand>.make(move model)
  let mut inspection = InspectorOptions.make()
  inspection.releaseBuilds = inspect
  let inspector = run Inspector.start(move inspection)
  return run runWindowWith(
    &mut app,
    &collection,
    run batch.take(),
    RunOptions {
      title: "Silk Studio",
      width: f32.toF64(width),
      height: f32.toF64(height),
      check: check,
      profile: profile,
      benchmark: benchmark,
      retained: retained,
      checkClick: "Rectangle",
      checkExpect: "Design canvas",
    },
    move inspector,
    &mut storage,
  )
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("Silk Studio: could not start the native app\n", &())
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(Effect.catch<AtlasError>(program(), atlasFailure), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn atlasFailure(error: AtlasError) -> i32 {
  match error {
    AtlasError.EmptyTile => {
      StderrWriter.print("Silk Studio: empty atlas tile\n", &())
    }
    AtlasError.Full => {
      StderrWriter.print("Silk Studio: atlas exhausted\n", &())
    }
    AtlasError.TooLarge { width, height } => {
      StderrWriter.print("Silk Studio: atlas tile too large: {} x {}\n", &(width, height))
    }
  }
  return 2
}
