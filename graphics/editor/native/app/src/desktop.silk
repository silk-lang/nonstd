//! Runs a ui-app [`Runtime`] in a native window: platform/window for the window and input,
//! ui-tree-window to turn window events into tree input, and ui_renderer on WebGPU (Dawn) for
//! the frames.
//!
//! The loop waits for window events, with a timeout at the runtime's next timer, or polls while
//! the app subscribes to animation frames. Input goes to the tree, the tree's records go to the
//! runtime, and a frame is drawn when the tree wants one.
//!
//! An app runs with the inspector (ui/inspect/server) when it passes one that is on to
//! [`runWindowWith`]: requests are served from the loop, input they dispatch is pumped to the app
//! like window input, the records the app takes go to the inspector's event log, and the
//! highlight is drawn over the frame.
//!
//! `check` mode ignores real input: after the first frame it clicks the node named
//! `options.checkClick` and presses Tab through the same path a user's input takes, draws two
//! more frames, reads the window's surface back and compares it with the CPU reference of the
//! same frame. It returns 0 within tolerance, 1 outside and 2 on an error.
import menus
import studio.editing as editing
import studio.view as view
import studio.samples as samples
import studio.exports as exportDocument
import codec.image { ImageError }
import codec.png { PngError }
import codec.jpeg { JpegError }
import files { Storage }
import silk.collections.bytes { Bytes }
import window.menu { OpenDialog, SaveDialog }
import window.types { DialogId }
import silk.core.result { Result }
import ui_tree.inspect { encodePng }
import studio.model { Studio, Message }
import studio.render { Canvas, textResources }
import ui_app.app { NoCommand }
import ui_app.runtime { Runtime, pump }
import ui_tree.lib { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import ui_tree_window.lib { feed }
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import atlas.atlas { Atlas, AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import window.event { Event, MouseButton }
import window.native { NativePlatform }
import window.platform { Platform }
import window.types { WindowError, WindowId, WindowOptions, TitleBar }
import webgpu.runtime { Device, GpuError }
import webgpu.resources { Queue }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.size { Size2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.f64
import silk.num.i64
import silk.num.u64
import ui_app_window.lib { WindowContent, runWindowHosted, RunOptions as HostOptions }
import ui_scene.scene { Scene }
import webgpu.resources { TextureView }
pub import benchmark { RunOptions }
import benchmark

struct Desktop<'fonts, 'storage> {
  canvas: Canvas,
  textTree: UiTree<'fonts>,
  textSnapshot: CpuSnapshot,
  snapshot: CpuSnapshot,
  storage: &'storage mut Storage,
  imageRenderer: Option<UiRenderer>,
  uploadedImages: u64,
  dialogKind: u32,
  pendingDialog: DialogId,
  retained: bool,
  check: bool,
  profiling: bool,
  windowDrag: bool,
  now: f64,
}

effect fn pngFailure(error: ImageError) -> never
  ! TreeError {
  drop error
  fail TreeError.BadResource { index: 0, resource: 0 }
}

impl<'fonts, 'storage> WindowContent<Studio, Message, NoCommand> for Desktop<'fonts, 'storage> {
  effect fn setup(self: &mut Self, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    tree.atlas = Atlas.make(Canvas.atlasOptions())
    run self.canvas.loadAssets(&mut tree)
  }

  fn configure(self: &Self, options: &mut WindowOptions) -> () {
    options.minSize = Option<Size2<f64>>.some(Size2<f64>.new(800.0, 600.0))
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      options.titleBar = TitleBar.Transparent
    }
  }

  effect fn opened(self: &mut Self, platform: &mut NativePlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    let menu = run menus.make()
    run platform.setMenuBar(&menu)
    platform.focus(window)
  }

  effect fn gpu(self: &mut Self, device: &Device, format: u32) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    self.imageRenderer = Option<UiRenderer>.some(run UiRenderer.make(device, format))
  }

  fn profile(self: &Self) -> bool {
    return self.profiling
  }

  fn wakeAfter(self: &Self) -> Option<f64> {
    if let Option<f64>.Some { value } = self.canvas.nextTextDeadline() {
      return Option<f64>.some(f64.max(0.008, value - self.now))
    }
    return if self.storage.saving() {
      Option<f64>.some(0.05)
    } else {
      Option<f64>.None
    }
  }

  effect fn poll(
    self: &mut Self,
    app: &mut Runtime<Studio, Message, NoCommand>,
    tree: &mut UiTree,
    time: f64,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    self.now = time
    return self.canvas.textRefinementDue(time) || self.canvas.needsFrame(&app.model, &tree.*)
  }

  fn needsFrame(self: &Self, app: &Runtime<Studio, Message, NoCommand>, tree: &UiTree) -> bool {
    return self.canvas.needsFrame(&app.model, &tree.*) || self.canvas.textRefinementDue(self.now)
  }

  effect fn prepare(
    self: &mut Self,
    app: &mut Runtime<Studio, Message, NoCommand>,
    tree: &mut UiTree,
  ) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if run self.canvas.normalize(&mut app.model, &mut self.textTree) {
      run app.render(&mut tree)
    }
  }

  effect fn frame(
    self: &mut Self,
    app: &Runtime<Studio, Message, NoCommand>,
    tree: &mut UiTree,
    input: FrameInput,
    inspector: &Inspector,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    if self.check {
      run self.canvas.frame(
        &app.model,
        &mut tree,
        &mut self.textTree,
        &mut self.textSnapshot,
        input.scale,
      )
    } else {
      run self.canvas.frameInteractive(
        &app.model,
        &mut tree,
        &mut self.textTree,
        &mut self.textSnapshot,
        input.scale,
        self.now,
        self.retained && !inspector.enabled(),
      )
    }
  }

  fn scene<'s>(self: &'s Self, tree: &'s UiTree) -> &'s Scene {
    return &self.canvas.scene
  }

  effect fn draw(
    self: &mut Self,
    app: &Runtime<Studio, Message, NoCommand>,
    renderer: &mut UiRenderer,
    device: &Device,
    queue: &Queue,
    tree: &UiTree,
    inspector: &Inspector,
    textures: &GpuAtlas,
    view: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if self.canvas.retained {
      if let Option<UiRenderer>.Some { value: images } = &mut self.imageRenderer {
        let scale = app.model.zoom * tree.input.scale
        run images.drawRetainedImages(
          device,
          queue,
          &self.canvas.retainedScene,
          textures,
          view,
          width,
          height,
          color.rgb(0xe8eae6),
          scale,
          (self.canvas.retainedX - app.model.cameraX) * scale
            + app.model.canvasLeft() * tree.input.scale,
          (self.canvas.retainedY - app.model.cameraY) * scale
            + app.model.canvasTop() * tree.input.scale,
          self.uploadedImages != self.canvas.retainedRevision,
        )
        self.uploadedImages = self.canvas.retainedRevision
      }
      run renderer.drawOverlay(device, queue, &self.canvas.scene, textures, view, width, height)
    } else {
      run renderer.draw(
        device,
        queue,
        inspector.sceneWith(&self.canvas.scene),
        textures,
        view,
        width,
        height,
        color.white(),
      )
    }
  }

  effect fn closing(self: &mut Self, app: &mut Runtime<Studio, Message, NoCommand>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    editing.commitDraft(&mut app.model)
    return app.model.revision == app.model.savedRevision || run self.storage.save(&mut app.model)
  }

  effect fn event(
    self: &mut Self,
    app: &mut Runtime<Studio, Message, NoCommand>,
    tree: &mut UiTree,
    event: &Event,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    match &event.* {
      Event.MouseDown { button, position, .. } => {
        if button == MouseButton.Left
          && view.windowDragAt(&tree.*, f64.toF32(position.x), f64.toF32(position.y)) {
          self.windowDrag = true
        } else {
          return false
        }
      }
      Event.Pinch { position, delta, .. } => {
        if !self.check {
          editing.wheel(
            &mut app.model,
            f64.toF32(position.x),
            f64.toF32(position.y),
            0.0,
            -f64.toF32(delta) * 250.0,
            true,
          )
          run app.render(&mut tree)
        }
      }
      Event.Focused { focused, .. } => {
        drop run feed(&mut tree, event)
        drop run pump(&mut app, &mut tree)
        if !focused {
          app.model.space = false
          if app.model.gesture != 0 {
            editing.cancel(&mut app.model)
          }
          run app.render(&mut tree)
        }
      }
      Event.MenuAction { action } => {
        editing.action(&mut app.model, action)
        run app.render(&mut tree)
      }
      Event.DialogClosed { dialog, paths } => {
        if dialog.value == self.pendingDialog.value {
          if paths.length() != 0 {
            let chosen = String.view(&paths.asSlice()[0])
            if self.dialogKind == 3 {
              // Preserve the current design before switching documents.
              let saved = run self.storage.save(&mut app.model)
              if saved {
                if let Option<Studio>.Some { value: loaded } = run self.storage.open(chosen) {
                  self.canvas.reset(&mut tree)
                  self.uploadedImages = 18446744073709551615
                  app.model = move loaded
                } else {
                  app.model.notice = run String.copy("Could not open that Silk document")
                }
              }
            } else if self.dialogKind == 1 {
              let result = run Effect.result(exportDocument.svg(&app.model))
              match move result {
                Result<String, exportDocument.UnsupportedBackdrop | OutOfMemoryError>.Success {
                  value: svg
                } => {
                  let ok = run self.storage.writeBytes(chosen, String.utf8Bytes(String.view(&svg)))
                  app.model.notice = run String.copy(
                    if ok {
                      "SVG exported"
                    } else {
                      "Could not write SVG"
                    },
                  )
                }
                Result<String, exportDocument.UnsupportedBackdrop | OutOfMemoryError>.Failure {
                  error
                } => {
                  drop error
                  app.model.notice = run String.copy(
                    "SVG cannot preserve backdrop blur. Export PNG or .silkdesign instead.",
                  )
                }
              }
            } else if self.dialogKind == 2 {
              let pixels = run self.canvas.exportPixels(
                &mut app.model,
                &mut tree,
                &mut self.textTree,
                &mut self.textSnapshot,
                &mut self.snapshot,
              )
              let png = run Effect.catch<ImageError>(encodePng(&pixels), pngFailure)
              let ok = run self.storage.writeBytes(chosen, Bytes.asSlice(&png))
              app.model.notice = run String.copy(
                if ok {
                  "PNG exported"
                } else {
                  "Could not write PNG"
                },
              )
            } else if self.dialogKind == 5 {
              if run self.storage.save(&mut app.model) {
                let mut fresh = Studio.make()
                samples.page(&mut fresh, "Page 1")
                fresh.title = fresh.intern("Untitled")
                fresh.revision = 1
                let previous = run String.copy(String.view(&self.storage.path))
                self.storage.path = run String.copy(chosen)
                if run self.storage.save(&mut fresh) {
                  self.canvas.reset(&mut tree)
                  self.uploadedImages = 18446744073709551615
                  app.model = move fresh
                } else {
                  self.storage.path = move previous
                  app.model.notice = run String.copy("Could not create the new document")
                }
              }
            } else if self.dialogKind == 4 {
              let previous = run String.copy(String.view(&self.storage.path))
              self.storage.path = run String.copy(chosen)
              if !(run self.storage.save(&mut app.model)) {
                self.storage.path = move previous
              }
            }
            run app.render(&mut tree)
          }
          self.dialogKind = 0
        }
      }
      _ => {
        return false
      }
    }
    return true
  }

  effect fn update(
    self: &mut Self,
    app: &mut Runtime<Studio, Message, NoCommand>,
    tree: &mut UiTree,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut changed = false
    if self.windowDrag {
      self.windowDrag = false
      platform.startWindowDrag(window)
    }
    if self.storage.collect(&mut app.model, false) {
      run app.render(&mut tree)
      changed = true
    }
    if app.model.saveRequested {
      run self.storage.autosave(&mut app.model)
      run app.render(&mut tree)
      changed = true
    }
    if app.model.exportRequested != 0 && self.dialogKind == 0 {
      self.dialogKind = app.model.exportRequested
      app.model.exportRequested = 0
      if self.dialogKind == 3 {
        let mut options = OpenDialog.file("Open Silk document", "silkdesign,json")
        options.parent = Option<WindowId>.some(window)
        self.pendingDialog = run platform.openFileDialog(&options)
      } else {
        let mut options = SaveDialog.named(
          if self.dialogKind == 5 {
            "New document"
          } else if self.dialogKind == 4 {
            "Save as"
          } else {
            "Export"
          },
          if self.dialogKind == 1 {
            "Design.svg"
          } else if self.dialogKind == 2 {
            "Design.png"
          } else {
            "Design.silkdesign"
          },
          if self.dialogKind == 1 {
            "svg"
          } else if self.dialogKind == 2 {
            "png"
          } else {
            "silkdesign"
          },
        )
        options.parent = Option<WindowId>.some(window)
        self.pendingDialog = run platform.saveFileDialog(&options)
      }
    }
    return changed
  }
}

pub effect fn runWindowWith(
  app: &mut Runtime<Studio, Message, NoCommand>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  storage: &mut Storage,
) -> i32
  ! JpegError
    | PngError
    | ImageError
    | WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
  ? &mut Allocator {
  if options.benchmark {
    return run benchmark.runWindowWith(
      &mut app,
      collection,
      move resources,
      move options,
      move inspector,
      &mut storage,
    )
  }
  let mut textTree = run UiTree.make(collection)
  run textResources(&mut textTree)
  let mut desktop = Desktop {
    canvas: Canvas.make(),
    textTree: move textTree,
    textSnapshot: CpuSnapshot.make(),
    snapshot: CpuSnapshot.make(),
    storage: &mut storage,
    imageRenderer: Option<UiRenderer>.None,
    uploadedImages: 18446744073709551615,
    dialogKind: 0,
    pendingDialog: DialogId { value: 0 },
    retained: options.retained,
    check: options.check,
    profiling: options.profile,
    windowDrag: false,
    now: 0.0,
  }
  return run runWindowHosted(
    &mut app,
    collection,
    move resources,
    HostOptions {
      title: options.title,
      width: options.width,
      height: options.height,
      check: options.check,
      checkClick: options.checkClick,
      checkExpect: options.checkExpect,
    },
    move inspector,
    &mut desktop,
  )
}
