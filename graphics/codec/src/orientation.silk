//! Lossless EXIF orientation of decoded RGBA samples.
import image { Image, ImageError }
import silk.num.u32
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Returns a new image oriented according to EXIF values 1–8.
/// Unknown values use the identity orientation. Source pixels remain unchanged.
pub effect fn apply(source: &Image, orientation: u8) -> Image
  ! ImageError | OutOfMemoryError
  ? &mut Allocator {
  let width = source.width()
  let height = source.height()
  let swapped = orientation >= 5 && orientation <= 8
  let mut output = run Image.make(
    if swapped {
      height
    } else {
      width
    },
    if swapped {
      width
    } else {
      height
    },
  )
  let stride = u32.toUsize(
    if swapped {
      height
    } else {
      width
    },
  )
  let pixels = output.dataMut()
  let input = source.data()
  let w = u32.toUsize(width)
  let h = u32.toUsize(height)
  let mut y: usize = 0
  while y < h {
    let mut x: usize = 0
    while x < w {
      let dx = if orientation == 2 || orientation == 3 {
        w - 1 - x
      } else if orientation == 5 || orientation == 8 {
        y
      } else if orientation == 6 || orientation == 7 {
        h - 1 - y
      } else {
        x
      }
      let dy = if orientation == 3 || orientation == 4 {
        h - 1 - y
      } else if orientation == 5 || orientation == 6 {
        x
      } else if orientation == 7 || orientation == 8 {
        w - 1 - x
      } else {
        y
      }
      let from = (y * w + x) * 4
      let to = (dy * stride + dx) * 4
      let mut channel: usize = 0
      while channel < 4 {
        pixels[to + channel] = input[from + channel]
        channel = channel + 1
      }
      x = x + 1
    }
    y = y + 1
  }
  return move output
}
