import jpeg_metadata
import jpeg_metadata { Metadata }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn assembledBody() -> ()
  ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let decoded = run jpeg_metadata.decodeWithMetadata(
    b"\xff\xd8\xff\xe0\x00\x10\x4a\x46\x49\x46\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00\xff\xe1\x00\x22\x45\x78\x69\x66\x00\x00\x4d\x4d\x00\x2a\x00\x00\x00\x08\x00\x01\x01\x12\x00\x03\x00\x00\x00\x01\x00\x06\x00\x00\x00\x00\x00\x00\xff\xdb\x00\x43\x00\x02\x01\x01\x01\x01\x01\x02\x01\x01\x01\x02\x02\x02\x02\x02\x04\x03\x02\x02\x02\x02\x05\x04\x04\x03\x04\x06\x05\x06\x06\x06\x05\x06\x06\x06\x07\x09\x08\x06\x07\x09\x07\x06\x06\x08\x0b\x08\x09\x0a\x0a\x0a\x0a\x0a\x06\x08\x0b\x0c\x0b\x0a\x0c\x09\x0a\x0a\x0a\xff\xdb\x00\x43\x01\x02\x02\x02\x02\x02\x02\x05\x03\x03\x05\x0a\x07\x06\x07\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\x0a\xff\xc0\x00\x11\x08\x00\x07\x00\x09\x03\x01\x22\x00\x02\x11\x01\x03\x11\x01\xff\xc4\x00\x1f\x00\x00\x01\x05\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\xff\xc4\x00\xb5\x10\x00\x02\x01\x03\x03\x02\x04\x03\x05\x05\x04\x04\x00\x00\x01\x7d\x01\x02\x03\x00\x04\x11\x05\x12\x21\x31\x41\x06\x13\x51\x61\x07\x22\x71\x14\x32\x81\x91\xa1\x08\x23\x42\xb1\xc1\x15\x52\xd1\xf0\x24\x33\x62\x72\x82\x09\x0a\x16\x17\x18\x19\x1a\x25\x26\x27\x28\x29\x2a\x34\x35\x36\x37\x38\x39\x3a\x43\x44\x45\x46\x47\x48\x49\x4a\x53\x54\x55\x56\x57\x58\x59\x5a\x63\x64\x65\x66\x67\x68\x69\x6a\x73\x74\x75\x76\x77\x78\x79\x7a\x83\x84\x85\x86\x87\x88\x89\x8a\x92\x93\x94\x95\x96\x97\x98\x99\x9a\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xff\xc4\x00\x1f\x01\x00\x03\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\xff\xc4\x00\xb5\x11\x00\x02\x01\x02\x04\x04\x03\x04\x07\x05\x04\x04\x00\x01\x02\x77\x00\x01\x02\x03\x11\x04\x05\x21\x31\x06\x12\x41\x51\x07\x61\x71\x13\x22\x32\x81\x08\x14\x42\x91\xa1\xb1\xc1\x09\x23\x33\x52\xf0\x15\x62\x72\xd1\x0a\x16\x24\x34\xe1\x25\xf1\x17\x18\x19\x1a\x26\x27\x28\x29\x2a\x35\x36\x37\x38\x39\x3a\x43\x44\x45\x46\x47\x48\x49\x4a\x53\x54\x55\x56\x57\x58\x59\x5a\x63\x64\x65\x66\x67\x68\x69\x6a\x73\x74\x75\x76\x77\x78\x79\x7a\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x92\x93\x94\x95\x96\x97\x98\x99\x9a\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xff\xe2\x00\x28\x49\x43\x43\x5f\x50\x52\x4f\x46\x49\x4c\x45\x00\x02\x02\x6f\x66\x69\x6c\x65\x2d\x62\x79\x74\x65\x73\x2d\x66\x6f\x72\x2d\x61\x73\x73\x65\x6d\x62\x6c\x79\xff\xe2\x00\x0b\x75\x6e\x72\x65\x6c\x61\x74\x65\x64\xff\xe2\x00\x19\x49\x43\x43\x5f\x50\x52\x4f\x46\x49\x4c\x45\x00\x01\x02\x6f\x70\x61\x71\x75\x65\x2d\x70\x72\xff\xda\x00\x0c\x03\x01\x00\x02\x11\x03\x11\x00\x3f\x00\xf9\xce\x8a\x28\xae\x73\xfb\xe0\xff\xd9",
  )
  run Testing.expect(
    decoded.metadata.orientation == 6 && decoded.image.width() == 9 && decoded.image.height() == 7,
    "raw dimensions and orientation retained",
  )
  let actual = decoded.metadata.iccProfile.asSlice()
  let expected = b"\x6f\x70\x61\x71\x75\x65\x2d\x70\x72\x6f\x66\x69\x6c\x65\x2d\x62\x79\x74\x65\x73\x2d\x66\x6f\x72\x2d\x61\x73\x73\x65\x6d\x62\x6c\x79"
  run Testing.expect(actual.length == expected.length, "all ICC chunks assembled")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(
      actual[i] == expected[i],
      "chunk sequence controls assembly, not marker order",
    )
    i = i + 1
  }
}

test effect fn reorderedProfileChunks() -> ()
  ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run assembledBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejects(data: &[u8]) -> ()
  ! AssertionError<'static>
  ? &mut Allocator {
  let result = run Effect.result(jpeg_metadata.read(data))
  let rejected = match &result {
    Result<Metadata, JpegError | ImageError | OutOfMemoryError>.Success { value } => false
    Result<Metadata, JpegError | ImageError | OutOfMemoryError>.Failure { error } => true
  }
  run Testing.expect(rejected, "malformed ICC chunk framing rejected")
}

