//! Separable f64 inverse DCT with bounded 8-bit level-shifted output (T.81 A.3.3).
import silk.num.i32
import silk.num.u16
import silk.num.f64

// B[x,u] = C(u)/2 * cos((2*x+1)*u*pi/16), C(0)=1/sqrt(2).
const BASIS: [f64; 64] = [
  0.35355339059327373,
  0.4903926402016152,
  0.46193976625564337,
  0.4157348061512726,
  0.3535533905932738,
  0.27778511650980114,
  0.19134171618254492,
  0.09754516100806417,
  0.35355339059327373,
  0.4157348061512726,
  0.19134171618254492,
  -0.0975451610080641,
  -0.35355339059327373,
  -0.4903926402016152,
  -0.4619397662556434,
  -0.2777851165098011,
  0.35355339059327373,
  0.27778511650980114,
  -0.19134171618254486,
  -0.4903926402016152,
  -0.35355339059327384,
  0.09754516100806415,
  0.46193976625564326,
  0.41573480615127273,
  0.35355339059327373,
  0.09754516100806417,
  -0.46193976625564337,
  -0.2777851165098011,
  0.3535533905932737,
  0.41573480615127273,
  -0.19134171618254495,
  -0.4903926402016153,
  0.35355339059327373,
  -0.0975451610080641,
  -0.4619397662556434,
  0.2777851165098009,
  0.35355339059327384,
  -0.41573480615127256,
  -0.19134171618254528,
  0.4903926402016152,
  0.35355339059327373,
  -0.277785116509801,
  -0.19134171618254517,
  0.4903926402016152,
  -0.35355339059327334,
  -0.09754516100806401,
  0.46193976625564337,
  -0.4157348061512725,
  0.35355339059327373,
  -0.4157348061512727,
  0.191341716182545,
  0.09754516100806439,
  -0.3535533905932736,
  0.4903926402016153,
  -0.4619397662556432,
  0.27778511650980076,
  0.35355339059327373,
  -0.4903926402016152,
  0.46193976625564326,
  -0.41573480615127256,
  0.3535533905932733,
  -0.27778511650980076,
  0.19134171618254478,
  -0.09754516100806429,
]

fn pixel(value: f64) -> u8 {
  if value <= 0.0 {
    return 0
  }
  if value >= 255.0 {
    return 255
  }
  return f64.toU8(f64.floor(value + 0.5))
}

/// Dequantizes coefficients in natural order and reconstructs one 8-by-8 block.
/// The caller validates quantization tables and entropy coefficient bounds.
pub fn block(coefficients: &[i32; 64], quantization: &[u16; 64]) -> [u8; 64] {
  let mut output: [u8; 64] = [0; 64]
  let mut onlyDc = true
  let mut i: usize = 1
  while i < 64 {
    if coefficients[i] != 0 {
      onlyDc = false
    }
    i = i + 1
  }
  if onlyDc {
    let value = pixel(128.0 + i32.toF64(coefficients[0]) * u16.toF64(quantization[0]) / 8.0)
    i = 0
    while i < 64 {
      output[i] = value
      i = i + 1
    }
    return output
  }
  let mut temporary: [f64; 64] = [0.0; 64]
  let mut v: usize = 0
  while v < 8 {
    let mut x: usize = 0
    while x < 8 {
      let mut sum: f64 = 0.0
      let mut u: usize = 0
      while u < 8 {
        let at = v * 8 + u
        sum = sum + BASIS[x * 8 + u] * i32.toF64(coefficients[at]) * u16.toF64(quantization[at])
        u = u + 1
      }
      temporary[v * 8 + x] = sum
      x = x + 1
    }
    v = v + 1
  }
  let mut y: usize = 0
  while y < 8 {
    let mut x: usize = 0
    while x < 8 {
      let mut sum: f64 = 128.0
      v = 0
      while v < 8 {
        sum = sum + BASIS[y * 8 + v] * temporary[v * 8 + x]
        v = v + 1
      }
      output[y * 8 + x] = pixel(sum)
      x = x + 1
    }
    y = y + 1
  }
  return output
}
