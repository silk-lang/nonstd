//! Bounded JPEG entropy bytes and canonical Huffman decoding (T.81 Annex C/F).
import jpeg_header { JpegError }
import silk.num.u8
import silk.num.u32
import silk.core.ownership { Copy }

pub struct Reader<'a> {
  data: &'a [u8],
  position: usize,
  current: u32,
  remaining: u8,
}

impl<'a> Reader<'a> {
  pub fn make(data: &'a [u8]) -> Reader<'a> {
    return Reader<'a> { data: data, position: 0, current: 0, remaining: 0 }
  }

  /// Consumed bytes, including stuffed zero bytes and accepted restart markers.
  pub fn offset(self: &Self) -> usize {
    return self.position
  }

  pub effect fn bits(self: &mut Self, count: u8) -> u32
    ! JpegError {
    if count > 16 {
      fail JpegError.InvalidData
    }
    let mut result: u32 = 0
    let mut i: u8 = 0
    while i < count {
      if self.remaining == 0 {
        if self.position == self.data.length {
          fail JpegError.InvalidData
        }
        self.current = u8.toU32(self.data[self.position])
        self.position = self.position + 1
        if self.current == 255 {
          if self.position == self.data.length || self.data[self.position] != 0 {
            fail JpegError.InvalidData
          }
          self.position = self.position + 1
        }
        self.remaining = 8
      }
      result = result * 2 + self.current / 128
      self.current = (self.current * 2) % 256
      self.remaining = self.remaining - 1
      i = i + 1
    }
    return result
  }

  /// JPEG's sign extension for the additional magnitude bits of a coefficient.
  pub effect fn receive(self: &mut Self, count: u8) -> i32
    ! JpegError {
    if count == 0 {
      return 0
    }
    let value = run self.bits(count)
    let mut range: u32 = 1
    let mut i: u8 = 0
    while i < count {
      range = range * 2
      i = i + 1
    }
    return if value < range / 2 {
      u32.toI32(value) - u32.toI32(range - 1)
    } else {
      u32.toI32(value)
    }
  }

  /// Verifies the one-bit padding at the end of a scan or restart interval.
  pub effect fn finish(self: &mut Self) -> ()
    ! JpegError {
    while self.remaining > 0 {
      if self.current / 128 != 1 {
        fail JpegError.InvalidData
      }
      self.current = (self.current * 2) % 256
      self.remaining = self.remaining - 1
    }
  }

  /// Discards only one-bit padding and verifies the expected cyclic restart marker.
  pub effect fn restart(self: &mut Self, expected: u8) -> ()
    ! JpegError {
    if expected > 7 {
      fail JpegError.InvalidData
    }
    run self.finish()
    if self.position == self.data.length || self.data[self.position] != 255 {
      fail JpegError.InvalidData
    }
    while self.position < self.data.length && self.data[self.position] == 255 {
      self.position = self.position + 1
    }
    if self.position == self.data.length || self.data[self.position] != 208 + expected {
      fail JpegError.InvalidData
    }
    self.position = self.position + 1
    self.current = 0
  }
}

pub struct Table {
  first: [u32; 17],
  count: [u32; 17],
  offset: [usize; 17],
  symbols: [u8; 256],
}

impl Copy for Table {}

impl Table {
  /// Builds canonical codes, excluding oversubscribed and reserved all-one codes.
  pub effect fn make(counts: &[u8], symbols: &[u8]) -> Table
    ! JpegError {
    if counts.length != 16 || symbols.length == 0 || symbols.length > 256 {
      fail JpegError.InvalidData
    }
    let mut table = Table { first: [0; 17], count: [0; 17], offset: [0; 17], symbols: [0; 256] }
    let mut code: u32 = 0
    let mut limit: u32 = 2
    let mut offset: usize = 0
    let mut length: usize = 1
    while length <= 16 {
      let count = u8.toU32(counts[length - 1])
      if code + count >= limit {
        fail JpegError.InvalidData
      }
      table.first[length] = code
      table.count[length] = count
      table.offset[length] = offset
      offset = offset + u32.toUsize(count)
      if offset > symbols.length {
        fail JpegError.InvalidData
      }
      code = (code + count) * 2
      limit = limit * 2
      length = length + 1
    }
    if offset != symbols.length {
      fail JpegError.InvalidData
    }
    offset = 0
    while offset < symbols.length {
      table.symbols[offset] = symbols[offset]
      offset = offset + 1
    }
    return move table
  }

  pub effect fn decode(self: &Self, reader: &mut Reader) -> u8
    ! JpegError {
    let mut length: usize = 1
    let mut code: u32 = 0
    while length <= 16 {
      code = code * 2 + run reader.bits(1)
      if code >= self.first[length] && code - self.first[length] < self.count[length] {
        return self.symbols[self.offset[length] + u32.toUsize(code - self.first[length])]
      }
      length = length + 1
    }
    fail JpegError.InvalidData
  }
}
