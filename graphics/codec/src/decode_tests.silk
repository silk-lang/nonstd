//! decode.decodeSrgb: format sniffing, colour conversion and EXIF orientation.
import decode { Format, decodeSrgb, sniff }
import image { Image, ImageError }
import png { PngError }
import png
import jpeg { JpegError }
import jpeg
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

// 3 x 2 opaque rgb(200, 100, 50), without colour chunks.
fn plainPng() -> &'static [u8] {
  return b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x03\x00\x00\x00\x02\x08\x06\x00\x00\x00\x9d\x74\x66\x1a\x00\x00\x00\x11\x49\x44\x41\x54\x78\x9c\x63\x38\x91\x62\xf4\x1f\x86\x19\x90\x39\x00\xb7\x17\x0e\x2f\xd1\x91\xec\x4d\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
}

// The same samples tagged gAMA 1.0: linear light, so they brighten in sRGB.
fn linearPng() -> &'static [u8] {
  return b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x03\x00\x00\x00\x02\x08\x06\x00\x00\x00\x9d\x74\x66\x1a\x00\x00\x00\x04\x67\x41\x4d\x41\x00\x01\x86\xa0\x31\xe8\x96\x5f\x00\x00\x00\x11\x49\x44\x41\x54\x78\x9c\x63\x38\x91\x62\xf4\x1f\x86\x19\x90\x39\x00\xb7\x17\x0e\x2f\xd1\x91\xec\x4d\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
}

