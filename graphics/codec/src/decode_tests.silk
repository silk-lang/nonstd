}

fn sameBytes(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

test effect fn sniffsSignatures() -> ()
  ! AssertionError<'static> {
  run Testing.expect(sniff(plainPng()) == Format.Png, "PNG signature")
  run Testing.expect(sniff(rotatedJpeg()) == Format.Jpeg, "JPEG SOI and marker")
  run Testing.expect(sniff(b"<svg/>") == Format.Unknown, "anything else")
  run Testing.expect(sniff(b"\xff\xd8") == Format.Unknown, "a truncated JPEG signature")
}

test effect fn srgbPngIsUnchanged() -> ()
  ! AssertionError<'static> | PngError | JpegError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let decoded = run decodeSrgb(plainPng()) |> Effect.provideMut<Allocator>(&mut allocator)
  let direct = run png.decode(plainPng()) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(decoded.width() == 3 && decoded.height() == 2, "PNG size")
  run Testing.expect(sameBytes(decoded.data(), direct.data()), "sRGB samples pass through")
}

test effect fn pngGammaIsConverted() -> ()
  ! AssertionError<'static> | PngError | JpegError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let decoded = run decodeSrgb(linearPng()) |> Effect.provideMut<Allocator>(&mut allocator)
  let samples = decoded.data()

  // Linear 100/255 is sRGB 170 or so; the opaque alpha stays.
  run Testing.expect(samples[1] > 150 && samples[3] == 255, "gAMA 1.0 samples brighten into sRGB")
}

test effect fn jpegOrientationIsApplied() -> ()
  ! AssertionError<'static> | PngError | JpegError | ImageError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let decoded = run decodeSrgb(rotatedJpeg()) |> Effect.provideMut<Allocator>(&mut allocator)
  let raw = run jpeg.decode(rotatedJpeg()) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(raw.width() == 9 && raw.height() == 7, "stored samples are 9 x 7")
  run Testing.expect(decoded.width() == 7 && decoded.height() == 9, "orientation 6 swaps the axes")
}

test effect fn unknownDataFails() -> ()
  ! AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(decodeSrgb(b"GIF89a"))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let failed = match &result {
    Result<Image, PngError | JpegError | ImageError | OutOfMemoryError>.Failure { error } => true
    _ => false
  }
  run Testing.expect(failed, "a GIF is not decoded")
}
