//! How far a GPU frame is from the CPU reference, as the ui_renderer tests measure it.
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.num.f32

/// Limits on the per-channel difference: the largest, the share of channels over 8, the mean.
pub struct Tolerance {
  pub max: u32,
  pub share: f32,
  pub mean: f32,
}

impl Copy for Tolerance {}

impl Tolerance {
  /// The demo's limits. Frames differ from the CPU reference in under 0.05% of their channels
  /// and by 0.05 levels on average (lavapipe and SwiftShader). The largest differences, up to
  /// about 80 levels at 2x, are on the wavy underline, which the GPU draws by distance to the
  /// sine wave to first order; ui_renderer's own fixtures allow 48 on gentler waves.
  pub fn frame() -> Tolerance {
    return Tolerance { max: 96, share: 0.002, mean: 0.25 }
  }
}

pub struct Comparison {
  pub max: u32,
  pub over: u32,
  pub channels: usize,
  pub mean: f32,
  /// The first pixel with the largest difference.
  pub worstX: u32,
  pub worstY: u32,
  pub sameSize: bool,
}

impl Copy for Comparison {}

impl Comparison {
  pub fn within(self: &Self, tolerance: Tolerance) -> bool {
    return self.sameSize && self.max <= tolerance.max
      && u32.toF32(self.over) <= tolerance.share * usize.toF32(self.channels)
      && self.mean <= tolerance.mean
  }
}

/// Compares two tightly packed RGBA8 images `width` pixels wide.
pub fn compare(cpu: &[u8], gpu: &[u8], width: u32) -> Comparison {
  if cpu.length != gpu.length || width == 0 {
    return Comparison {
      max: 0,
      over: 0,
      channels: 0,
      mean: 0.0,
      worstX: 0,
      worstY: 0,
      sameSize: false,
    }
  }
  let mut max: u32 = 0
  let mut worst: usize = 0
  let mut over: u32 = 0
  let mut sum: f32 = 0.0
  let mut i: usize = 0
  while i < cpu.length {
    let a = u8.toU32(cpu[i])
    let b = u8.toU32(gpu[i])
    let d = if a > b {
      a - b
    } else {
      b - a
    }
    if d > max {
      max = d
      worst = i
    }
    if d > 8 {
      over = over + 1
    }
    sum = sum + u32.toF32(d)
    i = i + 1
  }
  let pixel = usize.toU32(worst / 4)
  return Comparison {
    max: max,
    over: over,
    channels: cpu.length,
    mean: sum / usize.toF32(cpu.length),
    worstX: pixel % width,
    worstY: pixel / width,
    sameSize: true,
  }
}
