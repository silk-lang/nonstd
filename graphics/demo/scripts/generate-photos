#!/usr/bin/env python3
"""Writes the image grid's photos (assets/photos) with Pillow: small procedural scenes, half PNG
and half JPEG, so the demo decodes both through images/codec. Rerun only to change them; the
output is committed."""
import math
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter

OUT = Path(__file__).resolve().parent.parent / "assets/photos"
W, H = 160, 120

# (sky top, sky bottom, sun, hills, ground) per scene.
PALETTES = [
    ((26, 42, 108), (178, 31, 31), (253, 187, 45), (60, 30, 60), (30, 20, 40)),
    ((135, 206, 235), (224, 246, 255), (255, 244, 179), (76, 140, 74), (44, 94, 52)),
    ((15, 32, 39), (44, 83, 100), (230, 230, 240), (32, 58, 67), (12, 22, 28)),
    ((255, 175, 123), (215, 109, 119), (255, 236, 180), (58, 28, 113), (28, 14, 60)),
    ((86, 204, 242), (47, 128, 237), (255, 255, 255), (230, 240, 250), (200, 220, 240)),
    ((242, 153, 74), (242, 201, 76), (255, 250, 220), (150, 90, 40), (110, 60, 30)),
    ((20, 30, 48), (36, 59, 85), (255, 255, 230), (20, 40, 30), (10, 20, 15)),
    ((168, 237, 234), (254, 214, 227), (255, 255, 255), (120, 180, 160), (80, 140, 120)),
    ((67, 198, 172), (25, 22, 84), (248, 255, 174), (20, 60, 70), (10, 30, 40)),
    ((255, 94, 98), (255, 153, 102), (255, 230, 150), (90, 40, 50), (60, 25, 35)),
    ((131, 96, 195), (46, 191, 145), (250, 250, 210), (40, 80, 70), (25, 50, 45)),
    ((240, 242, 240), (0, 12, 64), (255, 220, 120), (30, 30, 70), (15, 15, 40)),
]


def lerp(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def scene(index, palette):
    top, bottom, sun, hills, ground = palette
    image = Image.new("RGB", (W, H))
    draw = ImageDraw.Draw(image)
    for y in range(H):
        draw.line([(0, y), (W, y)], fill=lerp(top, bottom, y / (H - 1)))
    sx = 30 + (index * 37) % 100
    sy = 25 + (index * 13) % 30
    glow = Image.new("RGBA", (W, H), sun + (0,))
    ImageDraw.Draw(glow).ellipse([sx - 20, sy - 20, sx + 20, sy + 20], fill=sun + (150,))
    glow = glow.filter(ImageFilter.GaussianBlur(9))
    image = Image.alpha_composite(image.convert("RGBA"), glow).convert("RGB")
    draw = ImageDraw.Draw(image)
    draw.ellipse([sx - 12, sy - 12, sx + 12, sy + 12], fill=sun)
    for layer, color in ((0, hills), (1, ground)):
        base = 70 + layer * 22
        amplitude = 14 - layer * 6
        phase = index * 0.9 + layer * 2.1
        points = [(0, H)]
        for x in range(0, W + 1, 4):
            y = base + amplitude * math.sin(x / 23.0 + phase) + 5 * math.sin(x / 7.0 + phase * 2)
            points.append((x, y))
        points.append((W, H))
        draw.polygon(points, fill=color)
    return image.filter(ImageFilter.SMOOTH)


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    for index, palette in enumerate(PALETTES):
        image = scene(index, palette)
        if index % 2 == 0:
            image.save(OUT / f"photo-{index:02}.png", optimize=True)
        else:
            image.save(OUT / f"photo-{index:02}.jpg", quality=82, optimize=True)


if __name__ == "__main__":
    main()
