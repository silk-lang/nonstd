#!/usr/bin/env python3
"""Writes src/generated_assets.silk: every file under assets/ as a byte string, so the native and
browser builds carry the same bytes. `--check` fails when the module is stale.

The demo does not use `silk.build.source.Source.read` because, in Silk 0.1.0-dev.44, a read
inside a dependency package resolves under the dependency's src/ and is lexed as Silk source.
"""
import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ASSETS = ROOT / "assets"
OUTPUT = ROOT / "src/generated_assets.silk"
EMBEDDED = ("fonts/*.ttf", "icons/*.svg", "photos/*.png", "photos/*.jpg")


def escape(data):
    out = []
    for byte in data:
        if 32 <= byte < 127 and byte not in (34, 92):
            out.append(chr(byte))
        else:
            out.append("\\x%02x" % byte)
    return "".join(out)


def name_of(path):
    stem = re.sub(r"[^0-9a-zA-Z]+", " ", path.relative_to(ASSETS).as_posix().rsplit(".", 1)[0])
    words = stem.split()
    return words[0].lower() + "".join(word[:1].upper() + word[1:] for word in words[1:])


def render():
    files = sorted({path for pattern in EMBEDDED for path in ASSETS.glob(pattern)})
    lines = ["// Generated by scripts/embed-assets from graphics/demo/assets; do not edit."]
    for path in files:
        relative = path.relative_to(ASSETS).as_posix()
        lines.append(f"/// assets/{relative}")
        lines.append(f"pub fn {name_of(path)}() -> &'static [u8] {{ return b\"{escape(path.read_bytes())}\" }}")
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    text = render()
    if args.check:
        if not OUTPUT.exists() or OUTPUT.read_text() != text:
            print(f"{OUTPUT} is stale; run graphics/demo/scripts/embed-assets", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
