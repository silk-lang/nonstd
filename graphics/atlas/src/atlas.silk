//! A texture atlas for glyphs, icons and images: many textures, one kind of pixel each.
//!
//! The atlas hands out rectangles ([`AtlasTile`]) and remembers the frame each tile was last used
//! in. It never holds pixels and has no GPU dependency: the renderer creates one texture per
//! [`TextureInfo`] (in the format its [`Kind`] names) and writes a tile's pixels into
//! [`AtlasTile.bounds`] after allocating it. Textures never change size, so this works the same on
//! native WebGPU, browser WebGPU and the CPU reference.
//!
//! A frame calls [`Atlas.beginFrame`], then [`Atlas.touch`] for every cached tile it draws and
//! [`Atlas.allocate`] for every miss. When a kind has no room and already has
//! [`AtlasOptions.maxTextures`] textures, `allocate` evicts the least recently used tiles that were
//! not used in the current frame. Evicted ids are listed by [`Atlas.evicted`] until
//! [`Atlas.clearEvicted`], so a cache keyed by content can drop them; a stale id is also refused by
//! [`Atlas.get`] and [`Atlas.touch`].
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.geometry.rect { Rect }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import shelf { AllocId, Allocation, ShelfAllocator }

const NONE: u32 = 4294967295

/// The pixel format family of a texture. Tiles of different kinds never share a texture.
pub union Kind {
  /// One coverage byte per pixel (A8 / R8Unorm): grayscale glyphs and monochrome icons.
  Monochrome,
  /// Per-channel coverage in RGBA8: subpixel glyphs.
  Subpixel,
  /// Premultiplied color in RGBA8 or BGRA8: color glyphs, color icons and images.
  Polychrome,
}

impl Copy for Kind {}

impl Equal for Kind {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index() == right.index()
  }
}

/// The number of kinds.
pub const KIND_COUNT: usize = 3

impl Kind {
  /// `0` for monochrome, `1` for subpixel, `2` for polychrome.
  pub fn index(self: &Self) -> usize {
    return match &self.* {
      Kind.Monochrome => 0
      Kind.Subpixel => 1
      Kind.Polychrome => 2
    }
  }

  /// Bytes per texel in the texture format.
  pub fn bytesPerPixel(self: &Self) -> u32 {
    return match &self.* {
      Kind.Monochrome => 1
      _ => 4
    }
  }
}

/// How the atlas sizes its textures.
pub struct AtlasOptions {
  /// The width and height of a new texture, unless a tile needs a larger one.
  pub textureSize: u32,
  /// The largest texture side the atlas creates. 8192 is the `maxTextureDimension2D` every WebGPU
  /// adapter supports, browsers included.
  pub maxTextureSize: u32,
  /// Textures per kind before `allocate` starts to evict.
  pub maxTextures: u32,
  /// Empty pixels kept around each tile, so bilinear sampling never reads a neighbour.
  pub padding: u32,
}

impl Copy for AtlasOptions {}

impl AtlasOptions {
  /// 1024-pixel textures, up to 8192, four per kind, no padding.
  pub fn default() -> AtlasOptions {
    return AtlasOptions { textureSize: 1024, maxTextureSize: 8192, maxTextures: 4, padding: 0 }
  }
}

/// A texture in the atlas. `index` counts textures of all kinds in creation order and never changes.
pub struct TextureId {
  pub kind: Kind,
  pub index: u32,
}

impl Copy for TextureId {}

impl Equal for TextureId {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index == right.index
  }
}

/// The handle of a tile. Stale after the tile is freed or evicted, even if its slot is reused.
pub struct TileId {
  pub index: u32,
  pub generation: u32,
}

impl Copy for TileId {}

impl Equal for TileId {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index == right.index && left.generation == right.generation
  }
}

/// A tile: where its pixels live.
pub struct AtlasTile {
  pub id: TileId,
  pub texture: TextureId,
  /// The tile's pixels in its texture, padding excluded.
  pub bounds: Rect<u32>,
}

impl Copy for AtlasTile {}

/// A texture the renderer must create (or has created) for the atlas.
pub struct TextureInfo {
  pub id: TextureId,
  pub width: u32,
  pub height: u32,
  /// Live tiles in the texture.
  pub tileCount: u32,
  /// Pixels covered by live tiles, padding included.
  pub allocatedArea: u64,
}

impl Copy for TextureInfo {}

/// Why [`Atlas.allocate`] refused a request.
pub union AtlasError {
  /// The width or height is zero. Nothing needs to be drawn, so cache the absence instead.
  EmptyTile,
  /// The tile and its padding are larger than [`AtlasOptions.maxTextureSize`].
  TooLarge { pub width: u32, pub height: u32 },
  /// The kind has its maximum number of textures and no space is left after evicting every tile
  /// not used in the current frame.
  Full,
}

impl Copy for AtlasError {}

struct Texture {
  id: TextureId,
  allocator: ShelfAllocator,
}

struct Entry {
  texture: u32,
  allocation: AllocId,
  bounds: Rect<u32>,
  lastUsed: u64,
  generation: u32,
  live: bool,
  nextFree: u32,
}

impl Copy for Entry {}

pub struct Atlas {
  options: AtlasOptions,
  frameNumber: u64,
  textures: List<Texture>,
  entries: List<Entry>,
  firstFree: u32,
  liveCount: u32,
  evictedIds: List<TileId>,
}

impl Atlas {
  /// An empty atlas. Textures are created on demand.
  pub fn make(options: AtlasOptions) -> Atlas {
    return Atlas {
      options: options,
      frameNumber: 0,
      textures: List<Texture>.make(),
      entries: List<Entry>.make(),
      firstFree: NONE,
      liveCount: 0,
      evictedIds: List<TileId>.make(),
    }
  }

  pub fn settings(self: &Self) -> AtlasOptions {
    return self.options
  }

  /// The current frame number. It starts at 0.
  pub fn frame(self: &Self) -> u64 {
    return self.frameNumber
  }

  /// Starts the next frame and returns its number. Tiles used in earlier frames become evictable.
  pub fn beginFrame(self: &mut Self) -> u64 {
    self.frameNumber = self.frameNumber + 1
    return self.frameNumber
  }

  /// The number of live tiles.
  pub fn tileCount(self: &Self) -> u32 {
    return self.liveCount
  }

  /// The number of textures of all kinds. Indices below it are valid [`TextureId.index`] values.
  pub fn textureCount(self: &Self) -> usize {
    return self.textures.length()
  }

  /// The texture with `TextureId.index` equal to `index`.
  pub fn texture(self: &Self, index: usize) -> TextureInfo {
    let texture = &self.textures.asSlice()[index]
    return TextureInfo {
      id: texture.id,
      width: texture.allocator.width(),
      height: texture.allocator.height(),
      tileCount: texture.allocator.allocationCount(),
      allocatedArea: texture.allocator.allocatedArea(),
    }
  }

  /// The live tile `id`, or `None` if it was freed or evicted.
  pub fn get(self: &Self, id: TileId) -> Option<AtlasTile> {
    let index = u32.toUsize(id.index)
    if !self.isLive(id) {
      return Option<AtlasTile>.None
    }
    return Option<AtlasTile>.Some { value: self.tileAt(index) }
  }

  /// Marks `id` used in the current frame, so it is not evicted before the next one. Returns false
  /// if `id` is stale, in which case the caller allocates and draws it again.
  pub fn touch(self: &mut Self, id: TileId) -> bool {
    if !self.isLive(id) {
      return false
    }
    let entries = self.entries.asMutSlice()
    entries[u32.toUsize(id.index)].lastUsed = self.frameNumber
    return true
  }

  /// Reserves a `width` x `height` tile of `kind` and marks it used in the current frame.
  ///
  /// The caller writes the tile's pixels at [`AtlasTile.bounds`] in texture [`AtlasTile.texture`],
  /// creating that texture first if its index is new (see [`Atlas.textureCount`]).
  pub effect fn allocate(self: &mut Self, kind: Kind, width: u32, height: u32) -> AtlasTile
    ! AtlasError | OutOfMemoryError
    ? &mut Allocator {
    if width == 0 || height == 0 {
      fail AtlasError.EmptyTile
    }
    let padding = u32.saturatingMultiply(self.options.padding, 2)
    let outerWidth = u32.saturatingAdd(width, padding)
    let outerHeight = u32.saturatingAdd(height, padding)
    if outerWidth > self.options.maxTextureSize || outerHeight > self.options.maxTextureSize {
      fail AtlasError.TooLarge { width: width, height: height }
    }
    run self.entries.reserve(1)

    // Newest textures first: older ones are fuller.
    let mut kindTextures: u32 = 0
    let mut t = self.textures.length()
    while t > 0 {
      t = t - 1
      if &self.textures.asSlice()[t].id.kind == &kind {
        kindTextures = kindTextures + 1
        let placed = run self.textures.asMutSlice()[t].allocator.allocate(outerWidth, outerHeight)
        if let Option<Allocation>.Some { value } = placed {
          return run self.record(t, value)
        }
      }
    }
    if kindTextures < self.options.maxTextures {
      let side = textureSide(self.options, outerWidth, outerHeight)
      let index = self.textures.length()
      let allocator = run ShelfAllocator.make(side, side)
      run self.textures.append(
        Texture {
          id: TextureId { kind: kind, index: usize.toU32(index) },
          allocator: move allocator,
        },
      )
      let placed = run self.textures.asMutSlice()[index].allocator.allocate(outerWidth, outerHeight)
      if let Option<Allocation>.Some { value } = placed {
        return run self.record(index, value)
      }
      fail AtlasError.Full
    }
    return run self.evictFor(kind, outerWidth, outerHeight)
  }

  /// Releases `id` at once. Returns false if it is stale. Explicitly freed ids are not listed by
  /// [`Atlas.evicted`].
  pub fn free(self: &mut Self, id: TileId) -> bool {
    if !self.isLive(id) {
      return false
    }
    self.release(u32.toUsize(id.index))
    return true
  }

  /// Evicts every tile last used before frame `frame`, lists it in [`Atlas.evicted`], and returns
  /// how many were evicted. `atlas.evictUnusedSince(atlas.frame() - 2)` drops what the last two
  /// frames did not draw.
  pub effect fn evictUnusedSince(self: &mut Self, frame: u64) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut count: u32 = 0
    let mut i: usize = 0
    while i < self.entries.length() {
      let entry = self.entries.get(i)
      if entry.live && entry.lastUsed < frame {
        run self.evictedIds.append(TileId { index: usize.toU32(i), generation: entry.generation })
        self.release(i)
        count = count + 1
      }
      i = i + 1
    }
    return count
  }

  /// The ids evicted since the last [`Atlas.clearEvicted`], oldest first.
  pub fn evicted(self: &Self) -> &[TileId] {
    return self.evictedIds.asSlice()
  }

  pub fn clearEvicted(self: &mut Self) -> () {
    self.evictedIds.clear()
  }

  /// Evicts least recently used tiles of `kind`, oldest first, until the request fits in the
  /// texture an eviction freed space in.
  effect fn evictFor(self: &mut Self, kind: Kind, width: u32, height: u32) -> AtlasTile
    ! AtlasError | OutOfMemoryError
    ? &mut Allocator {
    // Keys sort oldest first: the inverted age above, the entry index below.
    let mut candidates = List<u64>.make()
    let mut i: usize = 0
    while i < self.entries.length() {
      let entry = self.entries.get(i)
      let texture = &self.textures.asSlice()[u32.toUsize(entry.texture)]

      // Evicting from a texture smaller than the request could never make room.
      if entry.live && entry.lastUsed < self.frameNumber && &texture.id.kind == &kind
        && texture.allocator.width() >= width
        && texture.allocator.height() >= height {
        let age = self.frameNumber - entry.lastUsed
        let clamped: u64 = if age > 4294967295 {
          4294967295
        } else {
          age
        }
        run candidates.append(u64.shiftLeft(4294967295 - clamped, 32) | usize.toU64(i))
      }
      i = i + 1
    }
    run candidates.sort()
    run self.evictedIds.reserve(candidates.length())
    let mut c: usize = 0
    while c < candidates.length() {
      let index = u64.toUsize(candidates.get(c) & 4294967295)
      let entry = self.entries.get(index)
      run self.evictedIds.append(TileId { index: usize.toU32(index), generation: entry.generation })
      self.release(index)
      let t = u32.toUsize(entry.texture)
      let placed = run self.textures.asMutSlice()[t].allocator.allocate(width, height)
      if let Option<Allocation>.Some { value } = placed {
        return run self.record(t, value)
      }
      c = c + 1
    }
    fail AtlasError.Full
  }

  /// Stores `allocation` in texture `t` as a new entry. `allocate` reserved room for it.
  effect fn record(self: &mut Self, t: usize, allocation: Allocation) -> AtlasTile
    ! OutOfMemoryError
    ? &mut Allocator {
    let p = self.options.padding
    let outer = allocation.rect
    let bounds = Rect<u32>.new(outer.xMin + p, outer.yMin + p, outer.xMax - p, outer.yMax - p)
    let mut index = u32.toUsize(self.firstFree)
    let mut generation: u32 = 0
    if self.firstFree != NONE {
      let reused = self.entries.get(index)
      generation = reused.generation
      self.firstFree = reused.nextFree
    } else {
      index = self.entries.length()
    }
    let entry = Entry {
      texture: usize.toU32(t),
      allocation: allocation.id,
      bounds: bounds,
      lastUsed: self.frameNumber,
      generation: generation,
      live: true,
      nextFree: NONE,
    }
    if index < self.entries.length() {
      self.entries.set(index, entry)
    } else {
      run self.entries.append(entry)
    }
    self.liveCount = self.liveCount + 1
    return self.tileAt(index)
  }

  fn release(self: &mut Self, index: usize) -> () {
    let entry = self.entries.get(index)
    drop self.textures.asMutSlice()[u32.toUsize(entry.texture)].allocator.free(entry.allocation)
    let entries = self.entries.asMutSlice()
    entries[index].live = false
    entries[index].generation = u32.wrappingAdd(entry.generation, 1)
    entries[index].nextFree = self.firstFree
    self.firstFree = usize.toU32(index)
    self.liveCount = self.liveCount - 1
  }

  fn isLive(self: &Self, id: TileId) -> bool {
    let index = u32.toUsize(id.index)
    if index >= self.entries.length() {
      return false
    }
    let entry = &self.entries.asSlice()[index]
    return entry.live && entry.generation == id.generation
  }

  fn tileAt(self: &Self, index: usize) -> AtlasTile {
    let entry = self.entries.get(index)
    return AtlasTile {
      id: TileId { index: usize.toU32(index), generation: entry.generation },
      texture: self.textures.asSlice()[u32.toUsize(entry.texture)].id,
      bounds: entry.bounds,
    }
  }
}

/// The side of a new square texture for a `width` x `height` request: the configured size, or the
/// next power of two that holds the request, at most the maximum.
fn textureSide(options: AtlasOptions, width: u32, height: u32) -> u32 {
  let need = if width > height {
    width
  } else {
    height
  }
  let mut side = options.textureSize
  if side == 0 {
    side = 1
  }
  while side < need && side < options.maxTextureSize {
    side = u32.saturatingMultiply(side, 2)
  }
  if side > options.maxTextureSize {
    side = options.maxTextureSize
  }
  return side
}
