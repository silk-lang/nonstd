//! A shelf allocator for the rectangles of one texture.
//!
//! The texture is cut into horizontal shelves that always cover its full height, top to bottom. A
//! shelf is either empty (one free segment as wide as the texture) or holds items left to right,
//! each in a segment of the shelf's width. A request goes to a shelf whose height matches its
//! height bucket (see [`shelfHeight`]); a new shelf is split off the smallest empty shelf that fits.
//! Freeing an item merges its segment with free neighbours, and a shelf that becomes empty merges
//! with empty neighbours, so the space can be reused by items of any height.
//!
//! The allocator only does bookkeeping: it never touches pixels and has no GPU dependency.
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.geometry.rect { Rect }
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// The slot of a free segment.
const FREE: u32 = 4294967295

/// The handle of one allocation. It goes stale when the allocation is freed, so [`ShelfAllocator.get`]
/// and [`ShelfAllocator.free`] refuse it after that, even if its slot is reused.
pub struct AllocId {
  pub index: u32,
  pub generation: u32,
}

impl Copy for AllocId {}

impl Equal for AllocId {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.index == right.index && left.generation == right.generation
  }
}

/// A successful allocation: its handle and its rectangle in texture pixels.
pub struct Allocation {
  pub id: AllocId,
  pub rect: Rect<u32>,
}

impl Copy for Allocation {}

struct Segment {
  x: u32,
  width: u32,
  slot: u32,
}

impl Copy for Segment {}

struct Shelf {
  y: u32,
  height: u32,
  /// Sorted by `x` and covering the full texture width.
  segments: List<Segment>,
  used: u32,
}

struct Slot {
  rect: Rect<u32>,
  generation: u32,
  live: bool,
  /// The next free slot after this one, while this one is free.
  nextFree: u32,
}

impl Copy for Slot {}

/// The height of the shelf that holds an item `height` pixels tall.
///
/// Heights are rounded up to a step that grows with the height (2 up to 16, 4 up to 32, 8 up to 64,
/// 16 up to 128, then 32), so glyphs of one font size share shelves while tall items waste at most
/// a few percent.
pub fn shelfHeight(height: u32) -> u32 {
  let step: u32 = if height <= 16 {
    2
  } else if height <= 32 {
    4
  } else if height <= 64 {
    8
  } else if height <= 128 {
    16
  } else {
    32
  }
  return u32.saturatingMultiply((u32.saturatingAdd(height, step - 1)) / step, step)
}

fn minU32(a: u32, b: u32) -> u32 {
  if a < b {
    return a
  }
  return b
}

/// Packs rectangles into one `width` x `height` texture.
pub struct ShelfAllocator {
  pixelWidth: u32,
  pixelHeight: u32,
  shelves: List<Shelf>,
  slots: List<Slot>,
  firstFree: u32,
  area: u64,
  count: u32,
}

impl ShelfAllocator {
  /// An empty allocator for a `width` x `height` texture.
  pub effect fn make(width: u32, height: u32) -> ShelfAllocator
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = ShelfAllocator {
      pixelWidth: width,
      pixelHeight: height,
      shelves: List<Shelf>.make(),
      slots: List<Slot>.make(),
      firstFree: FREE,
      area: 0,
      count: 0,
    }
    if width > 0 && height > 0 {
      let shelf = run emptyShelf(0, height, width)
      run result.shelves.append(move shelf)
    }
    return move result
  }

  pub fn width(self: &Self) -> u32 {
    return self.pixelWidth
  }

  pub fn height(self: &Self) -> u32 {
    return self.pixelHeight
  }

  /// The number of live allocations.
  pub fn allocationCount(self: &Self) -> u32 {
    return self.count
  }

  /// The summed area of the live allocations, in pixels.
  pub fn allocatedArea(self: &Self) -> u64 {
    return self.area
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.count == 0
  }

  /// The number of shelves, empty ones included.
  pub fn shelfCount(self: &Self) -> usize {
    return self.shelves.length()
  }

  /// The rectangle of the live allocation `id`, or `None` if `id` is stale.
  pub fn get(self: &Self, id: AllocId) -> Option<Rect<u32>> {
    let index = u32.toUsize(id.index)
    if index >= self.slots.length() {
      return Option<Rect<u32>>.None
    }
    let slot = self.slots.get(index)
    if !slot.live || slot.generation != id.generation {
      return Option<Rect<u32>>.None
    }
    return Option<Rect<u32>>.Some { value: slot.rect }
  }

  /// Reserves a `width` x `height` rectangle. Returns `None` if it is empty, larger than the
  /// texture, or does not fit in the space left.
  pub effect fn allocate(self: &mut Self, width: u32, height: u32) -> Option<Allocation>
    ! OutOfMemoryError
    ? &mut Allocator {
    if width == 0 || height == 0 || width > self.pixelWidth || height > self.pixelHeight {
      return Option<Allocation>.None
    }
    let bucket = minU32(shelfHeight(height), self.pixelHeight)

    // 1. A used shelf of the request's own bucket.
    let mut s: usize = 0
    while s < self.shelves.length() {
      let shelf = &self.shelves.asSlice()[s]
      if shelf.used > 0 && shelf.height >= height && shelf.height <= bucket {
        let found = freeSegment(&shelf.segments, width)
        if found < shelf.segments.length() {
          return Option<Allocation>.Some { value: run self.place(s, found, width, height) }
        }
      }
      s = s + 1
    }

    // 2. The smallest empty shelf that holds the bucket, split to the bucket's height.
    let mut best = self.shelves.length()
    let mut s2: usize = 0
    while s2 < self.shelves.length() {
      let shelf = &self.shelves.asSlice()[s2]
      if shelf.used == 0 && shelf.height >= bucket {
        if best == self.shelves.length() || shelf.height < self.shelves.asSlice()[best].height {
          best = s2
        }
      }
      s2 = s2 + 1
    }
    if best < self.shelves.length() {
      let shelf = &mut self.shelves.asMutSlice()[best]
      if shelf.height > bucket {
        let restY = shelf.y + bucket
        let restHeight = shelf.height - bucket
        shelf.height = bucket
        let rest = run emptyShelf(restY, restHeight, self.pixelWidth)
        run self.shelves.insert(best + 1, move rest)
      }
      return Option<Allocation>.Some { value: run self.place(best, 0, width, height) }
    }

    // 3. Under pressure: an empty shelf shorter than the bucket, then any taller used shelf.
    let mut s3: usize = 0
    while s3 < self.shelves.length() {
      let shelf = &self.shelves.asSlice()[s3]
      if shelf.height >= height {
        let found = freeSegment(&shelf.segments, width)
        if found < shelf.segments.length() && (shelf.used == 0 || shelf.height > bucket) {
          return Option<Allocation>.Some { value: run self.place(s3, found, width, height) }
        }
      }
      s3 = s3 + 1
    }
    return Option<Allocation>.None
  }

  /// Releases the allocation `id`. Returns false, and changes nothing, if `id` is stale.
  pub fn free(self: &mut Self, id: AllocId) -> bool {
    let rect = match self.get(id) {
      Option<Rect<u32>>.Some { value } => value
      Option<Rect<u32>>.None => {
        return false
      }
    }
    let index = u32.toUsize(id.index)
    self.release(index)
    self.count = self.count - 1
    self.area = self.area - u32.toU64(rect.xMax - rect.xMin) * u32.toU64(rect.yMax - rect.yMin)

    let s = self.shelfAt(rect.yMin)
    let shelf = &mut self.shelves.asMutSlice()[s]
    let mut g: usize = 0
    while shelf.segments.asSlice()[g].x != rect.xMin {
      g = g + 1
    }
    let marked = shelf.segments.asMutSlice()
    marked[g].slot = FREE
    shelf.used = shelf.used - 1
    if g + 1 < shelf.segments.length() && shelf.segments.asSlice()[g + 1].slot == FREE {
      let next = shelf.segments.remove(g + 1)
      let merged = shelf.segments.asMutSlice()
      merged[g].width = merged[g].width + next.width
    }
    if g > 0 && shelf.segments.asSlice()[g - 1].slot == FREE {
      let current = shelf.segments.remove(g)
      let merged = shelf.segments.asMutSlice()
      merged[g - 1].width = merged[g - 1].width + current.width
    }
    if shelf.used == 0 {
      self.mergeEmpty(s)
    }
    return true
  }

  /// Frees every allocation. Outstanding ids go stale.
  pub effect fn clear(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.slots.length() {
      if self.slots.asSlice()[i].live {
        self.release(i)
      }
      i = i + 1
    }
    self.shelves.clear()
    if self.pixelWidth > 0 && self.pixelHeight > 0 {
      let shelf = run emptyShelf(0, self.pixelHeight, self.pixelWidth)
      run self.shelves.append(move shelf)
    }
    self.count = 0
    self.area = 0
  }

  effect fn place(self: &mut Self, s: usize, g: usize, width: u32, height: u32) -> Allocation
    ! OutOfMemoryError
    ? &mut Allocator {
    // Reserve first so that nothing below can fail halfway.
    run self.slots.reserve(1)
    run self.shelves.asMutSlice()[s].segments.reserve(1)
    let index: u32 = if self.firstFree != FREE {
      self.firstFree
    } else {
      usize.toU32(self.slots.length())
    }
    let shelf = &mut self.shelves.asMutSlice()[s]
    let segment = shelf.segments.get(g)
    let rect = Rect<u32>.new(segment.x, shelf.y, segment.x + width, shelf.y + height)
    if segment.width > width {
      let rest = Segment { x: segment.x + width, width: segment.width - width, slot: FREE }
      run shelf.segments.insert(g + 1, rest)
    }
    let segments = shelf.segments.asMutSlice()
    segments[g].width = width
    segments[g].slot = index
    shelf.used = shelf.used + 1
    let mut generation: u32 = 0
    if u32.toUsize(index) < self.slots.length() {
      let reused = self.slots.get(u32.toUsize(index))
      generation = reused.generation
      self.firstFree = reused.nextFree
      self.slots.set(
        u32.toUsize(index),
        Slot { rect: rect, generation: generation, live: true, nextFree: FREE },
      )
    } else {
      run self.slots.append(Slot { rect: rect, generation: generation, live: true, nextFree: FREE })
    }
    self.count = self.count + 1
    self.area = self.area + u32.toU64(width) * u32.toU64(height)
    return Allocation { id: AllocId { index: index, generation: generation }, rect: rect }
  }

  /// Marks slot `index` free and puts it at the head of the free list.
  fn release(self: &mut Self, index: usize) -> () {
    let slots = self.slots.asMutSlice()
    slots[index].live = false
    slots[index].generation = u32.wrappingAdd(slots[index].generation, 1)
    slots[index].nextFree = self.firstFree
    self.firstFree = usize.toU32(index)
  }

  /// The index of the shelf that starts at `y`.
  fn shelfAt(self: &Self, y: u32) -> usize {
    let shelves = self.shelves.asSlice()
    let mut low: usize = 0
    let mut high = shelves.length
    while high - low > 1 {
      let middle = low + (high - low) / 2
      if shelves[middle].y <= y {
        low = middle
      } else {
        high = middle
      }
    }
    return low
  }

  /// Joins the empty shelf `s` with the empty shelves around it.
  fn mergeEmpty(self: &mut Self, s: usize) -> () {
    let mut at = s
    if at + 1 < self.shelves.length() && self.shelves.asSlice()[at + 1].used == 0 {
      let next = self.shelves.remove(at + 1)
      let shelves = self.shelves.asMutSlice()
      shelves[at].height = shelves[at].height + next.height
    }
    if at > 0 && self.shelves.asSlice()[at - 1].used == 0 {
      let current = self.shelves.remove(at)
      at = at - 1
      let shelves = self.shelves.asMutSlice()
      shelves[at].height = shelves[at].height + current.height
    }
  }
}

effect fn emptyShelf(y: u32, height: u32, width: u32) -> Shelf
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut segments = List<Segment>.make()
  run segments.append(Segment { x: 0, width: width, slot: FREE })
  return Shelf { y: y, height: height, segments: move segments, used: 0 }
}

/// The first free segment at least `width` wide, or the segment count if there is none.
fn freeSegment(segments: &List<Segment>, width: u32) -> usize {
  let all = segments.asSlice()
  let mut g: usize = 0
  while g < all.length {
    if all[g].slot == FREE && all[g].width >= width {
      return g
    }
    g = g + 1
  }
  return all.length
}
