//! Packing tests for one texture: no overlap, fill ratio, freeing and merging.
import shelf { AllocId, Allocation, ShelfAllocator, shelfHeight }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

/// A small linear congruential generator, so the tests are deterministic.
pub struct Random {
  state: u32,
}

impl Random {
  pub fn make(seed: u32) -> Random {
    return Random { state: seed }
  }

  /// A value in `low ..= high`.
  pub fn range(self: &mut Self, low: u32, high: u32) -> u32 {
    self.state = u32.wrappingAdd(u32.wrappingMultiply(self.state, 1664525), 1013904223)
    return low + u32.shiftRight(self.state, 8) % (high - low + 1)
  }
}

fn overlaps(a: Rect<u32>, b: Rect<u32>) -> bool {
  return a.xMin < b.xMax && b.xMin < a.xMax && a.yMin < b.yMax && b.yMin < a.yMax
}

/// True if no two rectangles overlap and all lie inside `width` x `height`.
pub fn disjointInside(rects: &[Rect<u32>], width: u32, height: u32) -> bool {
  let mut i: usize = 0
  while i < rects.length {
    let a = rects[i]
    if a.xMin >= a.xMax || a.yMin >= a.yMax || a.xMax > width || a.yMax > height {
      return false
    }
    let mut j = i + 1
    while j < rects.length {
      if overlaps(a, rects[j]) {
        return false
      }
      j = j + 1
    }
    i = i + 1
  }
  return true
}

fn isNone(value: Option<Allocation>) -> bool {
  return match value {
    Option<Allocation>.None => true
    _ => false
  }
}

fn rectOf(value: Option<Allocation>) -> Rect<u32> {
  return match value {
    Option<Allocation>.Some { value: found } => found.rect
    Option<Allocation>.None => Rect<u32>.new(0, 0, 0, 0)
  }
}

fn idOf(value: Option<Allocation>) -> AllocId {
  return match value {
    Option<Allocation>.Some { value: found } => found.id
    Option<Allocation>.None => AllocId { index: 4294967295, generation: 0 }
  }
}

fn isLive(packer: &ShelfAllocator, id: AllocId) -> bool {
  return match packer.get(id) {
    Option<Rect<u32>>.Some { value } => true
    Option<Rect<u32>>.None => false
  }
}

test effect fn shelfHeightsRoundUpByGrowingSteps() -> ()
  ! AssertionError<'static> {
  run Testing.expect(shelfHeight(1) == 2 && shelfHeight(2) == 2 && shelfHeight(15) == 16, "step 2")
  run Testing.expect(shelfHeight(17) == 20 && shelfHeight(32) == 32, "step 4")
  run Testing.expect(
    shelfHeight(33) == 40 && shelfHeight(65) == 80 && shelfHeight(129) == 160,
    "steps 8, 16, 32",
  )
}

/// Packs glyph-sized rectangles until the texture refuses one, then checks the packing.
effect fn packGlyphs(seed: u32) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(512, 512)
  let mut random = Random.make(seed)
  let mut rects = List<Rect<u32>>.make()
  let mut misses: u32 = 0
  while misses < 20 {
    let placed = run packer.allocate(random.range(4, 28), random.range(8, 36))
    if isNone(placed) {
      misses = misses + 1
    } else {
      run rects.append(rectOf(placed))
    }
  }
  run Testing.expect(
    disjointInside(rects.asSlice(), 512, 512),
    "glyph tiles are disjoint and inside",
  )
  run Testing.expect(u32.toUsize(packer.allocationCount()) == rects.length(), "count matches")
  let mut area: u64 = 0
  let mut i: usize = 0
  while i < rects.length() {
    let r = rects.get(i)
    area = area + u32.toU64(r.xMax - r.xMin) * u32.toU64(r.yMax - r.yMin)
    i = i + 1
  }
  run Testing.expect(area == packer.allocatedArea(), "allocated area matches")

  // Glyph-like sizes fill most of the texture before the first refusal.
  run Testing.expect(area * 100 >= 512 * 512 * 85, "fill ratio is at least 85%")
}

test effect fn glyphSizedTilesPackDisjointAndDense() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run packGlyphs(1) |> Effect.provideMut<Allocator>(&mut allocator)
  run packGlyphs(77) |> Effect.provideMut<Allocator>(&mut allocator)
  run packGlyphs(4242) |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Uniform tiles that divide the texture exactly fill all of it.
effect fn packUniform() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(256, 256)
  let mut rects = List<Rect<u32>>.make()
  let mut i: u32 = 0
  while i < 256 {
    let placed = run packer.allocate(16, 16)
    run Testing.expect(!isNone(placed), "every 16x16 tile fits")
    run rects.append(rectOf(placed))
    i = i + 1
  }
  run Testing.expect(isNone(run packer.allocate(1, 1)), "the texture is full")
  run Testing.expect(packer.allocatedArea() == 256 * 256, "fill ratio is 100%")
  run Testing.expect(disjointInside(rects.asSlice(), 256, 256), "uniform tiles are disjoint")
}

test effect fn uniformTilesFillTheTexture() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run packUniform() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refuseInvalid() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(64, 32)
  run Testing.expect(isNone(run packer.allocate(0, 4)), "zero width is refused")
  run Testing.expect(isNone(run packer.allocate(4, 0)), "zero height is refused")
  run Testing.expect(isNone(run packer.allocate(65, 4)), "too wide is refused")
  run Testing.expect(isNone(run packer.allocate(4, 33)), "too tall is refused")
  let whole = run packer.allocate(64, 32)
  run Testing.expect(&rectOf(whole) == &Rect<u32>.new(0, 0, 64, 32), "the whole texture fits")
  run Testing.expect(packer.isEmpty() == false, "not empty")
}

test effect fn emptyAndOversizedRequestsAreRefused() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run refuseInvalid() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Freeing everything merges segments and shelves back into one empty shelf.
effect fn freeAllMerges(seed: u32) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(256, 256)
  let mut random = Random.make(seed)
  let mut ids = List<AllocId>.make()
  let mut misses: u32 = 0
  while misses < 10 {
    let placed = run packer.allocate(random.range(1, 40), random.range(1, 70))
    if isNone(placed) {
      misses = misses + 1
    } else {
      run ids.append(idOf(placed))
    }
  }
  run Testing.expect(packer.shelfCount() > 1, "several shelves")

  // Free in a scrambled order so merges happen on both sides.
  let mut i: usize = 0
  while i < ids.length() {
    let j = u32.toUsize(random.range(0, usize.toU32(ids.length() - 1)))
    let a = ids.get(i)
    let b = ids.get(j)
    ids.set(i, b)
    ids.set(j, a)
    i = i + 1
  }
  let mut k: usize = 0
  while k < ids.length() {
    run Testing.expect(packer.free(ids.get(k)), "a live id frees")
    k = k + 1
  }
  run Testing.expect(packer.isEmpty() && packer.allocatedArea() == 0, "nothing is allocated")
  run Testing.expect(packer.shelfCount() == 1, "shelves merged back into one")
  run Testing.expect(
    &rectOf(run packer.allocate(256, 256)) == &Rect<u32>.new(0, 0, 256, 256),
    "the whole texture is free again",
  )
}

test effect fn freeingEverythingMergesBackToOneShelf() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run freeAllMerges(3) |> Effect.provideMut<Allocator>(&mut allocator)
  run freeAllMerges(91) |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Freed ids go stale, and their slots come back with a new generation.
effect fn staleIds() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(64, 64)
  let first = idOf(run packer.allocate(10, 10))
  let second = idOf(run packer.allocate(10, 10))
  run Testing.expect(isLive(&packer, first) && isLive(&packer, second), "both live")
  run Testing.expect(packer.free(first), "first frees")
  run Testing.expect(!packer.free(first), "a second free is refused")
  run Testing.expect(!isLive(&packer, first), "a freed id is stale")
  let third = idOf(run packer.allocate(10, 10))
  run Testing.expect(
    third.index == first.index && third.generation != first.generation,
    "the slot is reused with a new generation",
  )
  run Testing.expect(!isLive(&packer, first) && isLive(&packer, third), "the old id stays stale")
  run Testing.expect(
    &rectOf(run packer.allocate(10, 10)) != &Rect<u32>.new(0, 0, 0, 0),
    "allocation continues",
  )
}

test effect fn freedIdsGoStale() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run staleIds() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Churn: random frees and allocations keep every live rectangle disjoint.
effect fn churn(seed: u32) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut packer = run ShelfAllocator.make(256, 256)
  let mut random = Random.make(seed)
  let mut ids = List<AllocId>.make()
  let mut round: u32 = 0
  while round < 2000 {
    if ids.length() > 0 && random.range(0, 2) == 0 {
      let victim = u32.toUsize(random.range(0, usize.toU32(ids.length() - 1)))
      let id = ids.get(victim)
      let last = ids.get(ids.length() - 1)
      ids.set(victim, last)
      drop ids.pop()
      run Testing.expect(packer.free(id), "a live id frees")
    } else {
      let placed = run packer.allocate(random.range(2, 48), random.range(2, 48))
      if !isNone(placed) {
        run ids.append(idOf(placed))
      }
    }
    round = round + 1
  }
  let mut rects = List<Rect<u32>>.make()
  let mut i: usize = 0
  while i < ids.length() {
    let rect = match packer.get(ids.get(i)) {
      Option<Rect<u32>>.Some { value } => value
      Option<Rect<u32>>.None => Rect<u32>.new(0, 0, 0, 0)
    }
    run rects.append(rect)
    i = i + 1
  }
  run Testing.expect(
    disjointInside(rects.asSlice(), 256, 256),
    "live tiles stay disjoint under churn",
  )
  run Testing.expect(u32.toUsize(packer.allocationCount()) == ids.length(), "count matches")
}

test effect fn churnKeepsTilesDisjoint() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run churn(5) |> Effect.provideMut<Allocator>(&mut allocator)
  run churn(2024) |> Effect.provideMut<Allocator>(&mut allocator)
}
