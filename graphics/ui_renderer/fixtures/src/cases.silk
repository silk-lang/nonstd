//! The fixtures the GPU renderer is checked with, each rendered by the CPU reference, with the
//! tolerance the GPU output must meet. Used by the native test and the browser test.
import atlas.atlas { AtlasError, AtlasOptions }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import ui_scene.cpu { AtlasPixels, CpuRenderer }
import ui_scene.scene { Scene }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import fixtures
import fixtures { Tiles, WIDTH, HEIGHT }

/// The number of fixtures.
pub const COUNT: u32 = 9

/// How far a fixture may drift from the CPU reference.
pub struct Tolerance {
  /// No channel may differ by more.
  pub max: u32,
  /// At most this share of channels may differ by more than 8.
  pub share: f32,
  /// The mean channel difference must stay below this.
  pub mean: f32,
}

impl Copy for Tolerance {}

/// A fixture rendered on the CPU, with what the GPU needs to render it too.
pub struct Fixture {
  pub name: string<'static>,
  pub scene: Scene,
  pub tiles: Tiles,
  pub cpu: Pixmap,
  pub tolerance: Tolerance,
}

/// Fixture `index`, below [`COUNT`], built and rendered on the CPU.
pub effect fn fixture(index: u32) -> Fixture
  ! AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut scene = Scene.make()
  let mut tiles = Tiles.make(
    AtlasOptions { textureSize: 64, maxTextureSize: 64, maxTextures: 2, padding: 1 },
  )
  let mut name: string<'static> = "cards"
  let mut tolerance = Tolerance { max: 48, share: 0.006, mean: 0.5 }
  if index == 0 {
    run fixtures.cards(&mut scene, &mut tiles)
  } else if index == 1 {
    name = "borders"
    run fixtures.borders(&mut scene)
  } else if index == 2 {
    name = "shadows"
    run fixtures.shadows(&mut scene)
  } else if index == 3 {
    name = "layers"
    run fixtures.layers(&mut scene)
  } else if index == 4 {
    name = "nested"
    run fixtures.nested(&mut scene, &mut tiles)
  } else if index == 5 {
    name = "gradients"
    run fixtures.gradients(&mut scene)
  } else if index == 6 {
    name = "effects"
    run fixtures.effects(&mut scene)
  } else if index == 7 {
    name = "surfaces"
    run fixtures.surfaces(&mut scene, &mut tiles)
  } else {
    name = "text ramp"
    run fixtures.textRamp(&mut scene, &mut tiles)
    tolerance = Tolerance { max: 1, share: 0.0, mean: 0.1 }
  }
  run scene.finish()
  let mut pixels = AtlasPixels.make()
  run pixels.sync(&tiles.atlas)
  let uploads = tiles.uploads.asSlice()
  let mut u: usize = 0
  while u < uploads.length {
    pixels.write(uploads[u].tile, uploads[u].pixels.asSlice())
    u = u + 1
  }
  let surfaces = tiles.surfaces.asSlice()
  let mut s: usize = 0
  while s < surfaces.length {
    let surface = &surfaces[s]
    run pixels.setSurface(surface.id, surface.width, surface.height, surface.pixels.asSlice())
    s = s + 1
  }
  let mut cpu = run Pixmap.make(WIDTH, HEIGHT)
  let mut reference = CpuRenderer.make()
  run reference.draw(&scene, &pixels, &mut cpu)
  return Fixture {
    name: name,
    scene: move scene,
    tiles: move tiles,
    cpu: move cpu,
    tolerance: tolerance,
  }
}
