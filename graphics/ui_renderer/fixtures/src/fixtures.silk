//! Fixture scenes, shared by the GPU comparison and the benchmark. The first four are the
//! `graphics/ui_scene/tests` golden scenes.
import atlas.atlas { Atlas, AtlasError, AtlasOptions, AtlasTile, Kind }
import silk.collections.list { List }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u32
import silk.num.usize
import ui_scene.color as color
import silk.color.color { ColorSpace, HueInterpolation, Interpolation }
import silk.color.rgba { Rgba }
import ui_scene.path_cache { PathCache }
import ui_scene.primitives {
  Background,
  BorderStyle,
  ColorStop,
  ContentMask,
  GlyphSprite,
  ImageSprite,
  Isolation,
  LinearGradient,
  Quad,
  Shadow,
  Underline,
}
import ui_scene.scene { Scene }
import vector.geometry { Affine }
import vector.geometry_error { GeometryError }
import vector.layer { BLEND_MULTIPLY, BLEND_SCREEN }
import vector.path { Path as VectorPath }
import vector.strips { EVENODD, NONZERO }
import vector.stroke { CAP_ROUND, JOIN_ROUND, Stroke }

pub const WIDTH: u32 = 240

pub const HEIGHT: u32 = 180

/// A tile and its pixels, to upload to both the CPU and the GPU atlas.
pub struct Upload {
  pub tile: AtlasTile,
  pub pixels: List<u8>,
}

/// The atlas a fixture allocates from, and the tiles it wrote.
pub struct Tiles {
  pub atlas: Atlas,
  pub uploads: List<Upload>,
}

impl Tiles {
  pub fn make(options: AtlasOptions) -> Tiles {
    return Tiles { atlas: Atlas.make(options), uploads: List<Upload>.make() }
  }
}

pub fn rect(x: f32, y: f32, w: f32, h: f32) -> Rect<f32> {
  return Rect<f32>.new(x, y, x + w, y + h)
}

pub fn window() -> ContentMask {
  return ContentMask.new(rect(0.0, 0.0, u32.toF32(WIDTH), u32.toF32(HEIGHT)))
}

fn rounded(bounds: Rect<f32>, radius: f32, background: Background) -> Quad {
  let mut q = Quad.fill(bounds, window(), background)
  q.cornerRadii = Corners<f32>.uniform(radius)
  return q
}

fn shadow(
  bounds: Rect<f32>,
  radius: f32,
  blur: f32,
  dy: f32,
  spread: f32,
  shade: Rgba<f32>,
  inset: bool,
) -> Shadow {
  return Shadow {
    bounds: bounds,
    mask: window(),
    cornerRadii: Corners<f32>.uniform(radius),
    color: shade,
    blurRadius: blur,
    offset: Vector2<f32>.new(0.0, dy),
    spread: spread,
    inset: inset,
  }
}

/// A 7 x 9 glyph-like coverage pattern: a ring with soft edges.
pub effect fn glyphTile(tiles: &mut Tiles) -> AtlasTile
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  let tile = run tiles.atlas.allocate(Kind.Monochrome, 7, 9)
  let mut coverage = List<u8>.make()
  let mut y: u32 = 0
  while y < 9 {
    let mut x: u32 = 0
    while x < 7 {
      let dx = u32.toF32(x) - 3.0
      let dy = u32.toF32(y) - 4.0
      let d = f32.sqrt(dx * dx + dy * dy * 0.6)
      let ring = 1.0 - f32.min(f32.abs(d - 2.5), 1.0)
      run coverage.append(f32.toU8(ring * 255.0 + 0.5))
      x = x + 1
    }
    y = y + 1
  }
  run tiles.uploads.append(Upload { tile: tile, pixels: move coverage })
  return tile
}

/// A 16 x 16 premultiplied checker image with a transparent quarter.
pub effect fn imageTile(tiles: &mut Tiles) -> AtlasTile
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  let tile = run tiles.atlas.allocate(Kind.Polychrome, 16, 16)
  let mut texels = List<u8>.make()
  let mut y: u32 = 0
  while y < 16 {
    let mut x: u32 = 0
    while x < 16 {
      let texel: [u8; 4] = if x >= 8 && y >= 8 {
        [0, 0, 0, 0]
      } else if (x / 4 + y / 4) % 2 == 0 {
        [230, 120, 20, 255]
      } else {
        [20, 60, 120, 160]
      }
      run texels.appendSlice(&texel)
      x = x + 1
    }
    y = y + 1
  }
  run tiles.uploads.append(Upload { tile: tile, pixels: move texels })
  return tile
}

/// A 16 x 16 tile holding every coverage level 0 ..= 255 once, row by row.
pub effect fn rampTile(tiles: &mut Tiles) -> AtlasTile
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  let tile = run tiles.atlas.allocate(Kind.Monochrome, 16, 16)
  let mut coverage = List<u8>.make()
  let mut i: u32 = 0
  while i < 256 {
    run coverage.append(u32.toU8(i))
    i = i + 1
  }
  run tiles.uploads.append(Upload { tile: tile, pixels: move coverage })
  return tile
}

effect fn star(points: u32, radius: f64) -> VectorPath
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut star = VectorPath.make()
  let mut k: u32 = 0
  while k < points {
    let angle = u32.toF64(k * 2 % points) * 2.0 * 3.141592653589793 / u32.toF64(points)
      - 1.5707963267948966
    let px = radius * f64.cos(angle)
    let py = radius * f64.sin(angle)
    if k == 0 {
      run star.moveTo(px, py)
    } else {
      run star.lineTo(px, py)
    }
    k = k + 1
  }
  run star.close()
  return move star
}

/// Cards with shadows, borders, gradient headers, text-like glyphs, an image, underlines and
/// vector icons.
pub effect fn cards(scene: &mut Scene, tiles: &mut Tiles) -> ()
  ! AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let glyph = run glyphTile(&mut tiles)
  let picture = run imageTile(&mut tiles)
  let mut cache = PathCache.make()
  run cache.beginFrame()
  drop run scene.quad(
    Quad.fill(rect(0.0, 0.0, 240.0, 180.0), window(), Background.solid(color.rgb(0xf2f3f5))),
  )
  let mut i: u32 = 0
  while i < 2 {
    let x = 12.0 + u32.toF32(i) * 114.0
    let card = rect(x, 14.0, 102.0, 150.0)
    drop run scene.shadow(shadow(card, 10.0, 12.0, 4.0, 0.0, color.rgba(0x10203050), false))
    let mut body = rounded(card, 10.0, Background.solid(color.white()))
    body.borderWidths = Insets<f32>.uniform(1.0)
    body.borderColor = color.rgba(0x0000001f)
    drop run scene.quad(body)
    let mut header = rounded(
      rect(x, 14.0, 102.0, 34.0),
      0.0,
      Background.linear(90.0 + u32.toF32(i) * 45.0, color.rgb(0x4f46e5), color.rgb(0x06b6d4)),
    )
    header.cornerRadii = Corners<f32>.new(10.0, 10.0, 0.0, 0.0)
    drop run scene.quad(header)
    let mut g: u32 = 0
    while g < 9 {
      drop run scene.glyph(
        GlyphSprite {
          bounds: rect(x + 8.0 + u32.toF32(g) * 8.0, 58.0, 7.0, 9.0),
          mask: window(),
          tile: glyph,
          color: color.rgb(0x111827),
        },
      )
      g = g + 1
    }
    drop run scene.underline(
      Underline {
        bounds: rect(x + 8.0, 68.0, 70.0, 4.0),
        mask: window(),
        color: color.rgb(0xdc2626),
        thickness: 1.0,
        wavy: i == 1,
      },
    )
    drop run scene.image(
      ImageSprite {
        bounds: rect(x + 8.0, 80.0, 32.0 + u32.toF32(i) * 8.0, 32.0),
        mask: window(),
        tile: picture,
        opacity: 1.0,
        cornerRadii: Corners<f32>.uniform(6.0),
        grayscale: i == 1,
      },
    )
    let mut check = VectorPath.make()
    run check.moveTo(0.0, 6.0)
    run check.lineTo(5.0, 11.0)
    run check.lineTo(14.0, 1.0)
    let mut style = Stroke.make(2.5)
    style.cap = CAP_ROUND
    style.join = JOIN_ROUND
    let at = Affine.new(1.0, 0.0, 0.0, 1.0, f32.toF64(x) + 60.0, 86.25)
    drop run cache.stroke(
      &mut scene,
      1,
      &check,
      &style,
      &at,
      Background.solid(color.rgb(0x16a34a)),
      window(),
    )
    let shape = run star(5, 12.0)
    let rule = if i == 0 {
      NONZERO
    } else {
      EVENODD
    }
    let place = Affine.new(1.0, 0.0, 0.0, 1.0, f32.toF64(x) + 70.0, 135.5)
    drop run cache.fill(
      &mut scene,
      2,
      &shape,
      &place,
      rule,
      Background.linear(180.0, color.rgb(0xf59e0b), color.rgb(0xef4444)),
      window(),
    )
    i = i + 1
  }
}

/// Corner radii, uneven and dashed borders, and a translucent border over its background.
pub effect fn borders(scene: &mut Scene) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  drop run scene.quad(
    Quad.fill(rect(0.0, 0.0, 240.0, 180.0), window(), Background.solid(color.white())),
  )
  let mut a = rounded(rect(10.0, 10.0, 60.0, 60.0), 0.0, Background.solid(color.rgb(0xfde68a)))
  a.cornerRadii = Corners<f32>.new(0.0, 12.0, 30.0, 4.0)
  a.borderWidths = Insets<f32>.new(2.0, 6.0, 10.0, 1.0)
  a.borderColor = color.rgb(0x92400e)
  drop run scene.quad(a)
  let mut b = rounded(rect(90.0, 10.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0xbfdbfe)))
  b.borderWidths = Insets<f32>.uniform(3.0)
  b.borderColor = color.rgb(0x1e3a8a)
  b.borderStyle = BorderStyle.Dashed
  drop run scene.quad(b)
  let mut c = rounded(rect(170.0, 10.0, 60.0, 60.0), 8.0, Background.solid(color.rgb(0x22c55e)))
  c.borderWidths = Insets<f32>.uniform(8.0)
  c.borderColor = color.rgba(0x00000060)
  drop run scene.quad(c)
  let mut d = rounded(rect(10.5, 90.25, 100.0, 70.0), 14.0, Background.solid(color.transparent()))
  d.borderWidths = Insets<f32>.uniform(2.0)
  d.borderColor = color.rgb(0xdb2777)
  d.borderStyle = BorderStyle.Dashed
  drop run scene.quad(d)
  let oklab = Background.Linear {
    gradient: LinearGradient {
      angle: 135.0,
      from: ColorStop { color: color.rgb(0xff0000), offset: 0.1 },
      to: ColorStop { color: color.rgba(0x0000ff40), offset: 0.9 },
      interpolation: Interpolation.new(ColorSpace.Oklab),
    },
  }
  drop run scene.quad(rounded(rect(130.0, 90.0, 100.0, 70.0), 20.0, oklab))
}

/// Drop shadows with offsets and spread, an inset shadow, and a shadow clipped by its mask.
pub effect fn shadows(scene: &mut Scene) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  drop run scene.quad(
    Quad.fill(rect(0.0, 0.0, 240.0, 180.0), window(), Background.solid(color.rgb(0xe5e7eb))),
  )
  let a = rect(20.0, 20.0, 60.0, 50.0)
  drop run scene.shadow(shadow(a, 8.0, 16.0, 8.0, 2.0, color.rgba(0x00000080), false))
  drop run scene.quad(rounded(a, 8.0, Background.solid(color.white())))
  let b = rect(110.0, 20.0, 100.0, 50.0)
  drop run scene.shadow(shadow(b, 25.0, 4.0, 0.0, 6.0, color.rgba(0x7c3aedc0), false))
  drop run scene.quad(rounded(b, 25.0, Background.solid(color.white())))
  let c = rect(20.0, 100.0, 90.0, 60.0)
  drop run scene.quad(rounded(c, 12.0, Background.solid(color.white())))
  drop run scene.shadow(shadow(c, 12.0, 10.0, 3.0, 2.0, color.rgba(0x000000a0), true))
  let mut clipped = shadow(
    rect(140.0, 100.0, 70.0, 60.0),
    0.0,
    20.0,
    0.0,
    0.0,
    color.rgb(0x0f766e),
    false,
  )
  clipped.mask = ContentMask.new(rect(130.0, 90.0, 60.0, 80.0))
  drop run scene.shadow(clipped)
}

/// Isolated layers with opacity and multiply, a pinned layer, and nested content masks.
pub effect fn layers(scene: &mut Scene) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  drop run scene.quad(
    Quad.fill(
      rect(0.0, 0.0, 240.0, 180.0),
      window(),
      Background.linear(90.0, color.rgb(0xfef3c7), color.rgb(0xdbeafe)),
    ),
  )
  drop run scene.pushIsolatedLayer(
    rect(10.0, 10.0, 100.0, 80.0),
    window(),
    Isolation { opacity: 0.6, blend: 0 },
  )
  drop run scene.quad(
    rounded(rect(15.0, 15.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0xef4444))),
  )
  drop run scene.quad(
    rounded(rect(45.0, 25.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0x3b82f6))),
  )
  run scene.popLayer()
  drop run scene.pushIsolatedLayer(
    rect(130.0, 10.0, 100.0, 80.0),
    window(),
    Isolation { opacity: 1.0, blend: BLEND_MULTIPLY },
  )
  drop run scene.quad(
    rounded(rect(135.0, 15.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0xf97316))),
  )
  drop run scene.quad(
    rounded(rect(165.0, 25.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0x14b8a6))),
  )
  run scene.popLayer()
  run scene.pushLayer(rect(10.0, 100.0, 220.0, 70.0))
  let outer = ContentMask.new(rect(20.5, 105.0, 150.0, 60.0))
  let inner = outer.intersect(ContentMask.new(rect(60.0, 120.0, 200.0, 30.0)))
  let mut i: u32 = 0
  while i < 6 {
    let mut q = rounded(
      rect(10.0 + u32.toF32(i) * 36.0, 110.0, 32.0, 50.0),
      6.0,
      Background.solid(color.rgb(0x6366f1)),
    )
    q.mask = if i % 2 == 0 {
      outer
    } else {
      inner
    }
    drop run scene.quad(q)
    i = i + 1
  }
  run scene.popLayer()
}

/// Nested isolated layers (screen inside a faded group), sprites and paths clipped by fractional
/// masks, paths at odd pixel rows, and a quad straddling the target's edge.
pub effect fn nested(scene: &mut Scene, tiles: &mut Tiles) -> ()
  ! AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let glyph = run glyphTile(&mut tiles)
  let picture = run imageTile(&mut tiles)
  drop run scene.quad(
    Quad.fill(rect(0.0, 0.0, 240.0, 180.0), window(), Background.solid(color.rgb(0x1f2937))),
  )
  drop run scene.pushIsolatedLayer(
    rect(8.0, 8.0, 140.0, 100.0),
    window(),
    Isolation { opacity: 0.8, blend: 0 },
  )
  drop run scene.quad(
    rounded(rect(8.0, 8.0, 140.0, 100.0), 16.0, Background.solid(color.rgb(0x0ea5e9))),
  )
  drop run scene.pushIsolatedLayer(
    rect(30.0, 30.0, 100.0, 60.0),
    window(),
    Isolation { opacity: 1.0, blend: BLEND_SCREEN },
  )
  drop run scene.quad(
    rounded(rect(30.0, 30.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0xf43f5e))),
  )
  drop run scene.quad(
    rounded(rect(70.0, 30.0, 60.0, 60.0), 30.0, Background.solid(color.rgb(0x84cc16))),
  )
  run scene.popLayer()
  run scene.popLayer()
  let clip = ContentMask.new(rect(160.5, 10.25, 60.0, 50.5))
  let mut g: u32 = 0
  while g < 12 {
    drop run scene.glyph(
      GlyphSprite {
        bounds: rect(156.0 + u32.toF32(g % 6) * 11.0, 12.0 + u32.toF32(g / 6) * 40.0, 14.0, 18.0),
        mask: clip,
        tile: glyph,
        color: color.rgb(0xfde047),
      },
    )
    g = g + 1
  }
  drop run scene.image(
    ImageSprite {
      bounds: rect(160.0, 70.0, 64.0, 40.0),
      mask: ContentMask.new(rect(150.0, 75.5, 80.0, 30.0)),
      tile: picture,
      opacity: 0.7,
      cornerRadii: Corners<f32>.uniform(0.0),
      grayscale: false,
    },
  )
  let mut cache = PathCache.make()
  run cache.beginFrame()
  let shape = run star(7, 14.0)
  let mut k: u32 = 0
  while k < 4 {
    let place = Affine.new(
      1.0,
      0.0,
      0.0,
      1.0,
      30.0 + u32.toF64(k) * 36.0,
      133.0 + u32.toF64(k) * 3.0,
    )
    drop run cache.fill(
      &mut scene,
      7,
      &shape,
      &place,
      NONZERO,
      Background.solid(color.rgba(0xfbbf24e0)),
      ContentMask.new(rect(0.0, 120.0, 150.0, 37.5)),
    )
    k = k + 1
  }
  let mut edge = rounded(
    rect(200.0, 130.0, 60.0, 70.0),
    12.0,
    Background.solid(color.rgba(0xa78bfaa0)),
  )
  edge.borderWidths = Insets<f32>.uniform(2.0)
  edge.borderColor = color.white()
  drop run scene.quad(edge)
}

fn gradient(
  angle: f32,
  from: Rgba<f32>,
  to: Rgba<f32>,
  interpolation: Interpolation,
) -> Background {
  return Background.Linear {
    gradient: LinearGradient {
      angle: angle,
      from: ColorStop { color: from, offset: 0.0 },
      to: ColorStop { color: to, offset: 1.0 },
      interpolation: interpolation,
    },
  }
}

/// Linear gradients in every kind of interpolation the GPU handles: sRGB mixed in the shader, and
/// ramps for linear sRGB, Oklab, Oklch on each hue arc, HSL and Display P3, on quads with borders
/// and on a path, with translucent stops.
pub effect fn gradients(scene: &mut Scene) -> ()
  ! GeometryError | OutOfMemoryError
  ? &mut Allocator {
  drop run scene.quad(
    Quad.fill(rect(0.0, 0.0, 240.0, 180.0), window(), Background.solid(color.rgb(0xf8fafc))),
  )
  let spaces = [
    Interpolation.new(ColorSpace.Srgb),
    Interpolation.new(ColorSpace.SrgbLinear),
    Interpolation.new(ColorSpace.Oklab),
    Interpolation.new(ColorSpace.Oklch),
    Interpolation { space: ColorSpace.Oklch, hue: HueInterpolation.Longer },
    Interpolation { space: ColorSpace.Hsl, hue: HueInterpolation.Increasing },
    Interpolation { space: ColorSpace.Lch, hue: HueInterpolation.Decreasing },
    Interpolation.new(ColorSpace.DisplayP3),
  ]
  let mut i: usize = 0
  while i < 8 {
    let x = 6.0 + usize.toF32(i % 4) * 58.0
    let y = 6.0 + usize.toF32(i / 4) * 58.0
    let mut q = rounded(
      rect(x, y, 52.0, 52.0),
      usize.toF32(i) * 3.0,
      gradient(
        45.0 + usize.toF32(i) * 40.0,
        color.rgb(0xe11d48),
        color.rgba(0x2563ebc0),
        spaces[i],
      ),
    )
    q.borderWidths = Insets<f32>.uniform(1.5)
    q.borderColor = color.rgba(0x0f172a60)
    drop run scene.quad(q)
    i = i + 1
  }
  let mut cache = PathCache.make()
  run cache.beginFrame()
  let shape = run star(6, 26.0)
  let mut k: u32 = 0
  while k < 3 {
    let place = Affine.new(1.0, 0.0, 0.0, 1.0, 40.0 + u32.toF64(k) * 78.0, 148.0)
    drop run cache.fill(
      &mut scene,
      u32.toU64(k),
      &shape,
      &place,
      NONZERO,
      gradient(90.0, color.rgb(0x22c55e), color.rgba(0xa855f780), spaces[u32.toUsize(k) * 3 + 1]),
      window(),
    )
    k = k + 1
  }
}

/// Every coverage level drawn as text in black, white and a mid gray, at the tile's own size.
pub effect fn textRamp(scene: &mut Scene, tiles: &mut Tiles) -> ()
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  let ramp = run rampTile(&mut tiles)
  let colors = [color.black(), color.white(), color.rgb(0x808080), color.rgb(0x2563eb)]
  let mut i: usize = 0
  while i < 4 {
    drop run scene.glyph(
      GlyphSprite {
        bounds: rect(8.0 + usize.toF32(i) * 24.0, 8.0, 16.0, 16.0),
        mask: window(),
        tile: ramp,
        color: colors[i],
      },
    )
    i = i + 1
  }
}

/// A dense window for the benchmark: `columns` x `rows` cards, each a shadow, a bordered rounded
/// quad and a line of `glyphs` glyphs, over a `width` x `height` target.
pub effect fn dense(
  scene: &mut Scene,
  tiles: &mut Tiles,
  width: u32,
  height: u32,
  columns: u32,
  rows: u32,
  glyphs: u32,
) -> ()
  ! AtlasError | OutOfMemoryError
  ? &mut Allocator {
  let glyph = run glyphTile(&mut tiles)
  let all = ContentMask.new(rect(0.0, 0.0, u32.toF32(width), u32.toF32(height)))
  drop run scene.quad(Quad.fill(all.bounds, all, Background.solid(color.rgb(0xf8fafc))))
  let cw = u32.toF32(width) / u32.toF32(columns)
  let ch = u32.toF32(height) / u32.toF32(rows)
  let mut row: u32 = 0
  while row < rows {
    let mut column: u32 = 0
    while column < columns {
      let card = rect(u32.toF32(column) * cw + 4.0, u32.toF32(row) * ch + 4.0, cw - 8.0, ch - 8.0)
      let mut s = shadow(card, 6.0, 8.0, 2.0, 0.0, color.rgba(0x0000003c), false)
      s.mask = all
      drop run scene.shadow(s)
      let mut q = Quad.fill(card, all, Background.solid(color.white()))
      q.cornerRadii = Corners<f32>.uniform(6.0)
      q.borderWidths = Insets<f32>.uniform(1.0)
      q.borderColor = color.rgb(0xe2e8f0)
      drop run scene.quad(q)
      let mut g: u32 = 0
      while g < glyphs {
        let gx = card.xMin + 4.0 + u32.toF32(g) * 7.0
        if gx + 7.0 < card.xMax {
          drop run scene.glyph(
            GlyphSprite {
              bounds: rect(f32.floor(gx), f32.floor(card.yMin + 4.0), 7.0, 9.0),
              mask: all,
              tile: glyph,
              color: color.rgb(0x0f172a),
            },
          )
        }
        g = g + 1
      }
      column = column + 1
    }
    row = row + 1
  }
}
