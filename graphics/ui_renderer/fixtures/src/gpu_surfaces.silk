//! GPU textures for a fixture's surfaces, registered with a `UiRenderer`: what a web view backend
//! does with the textures its engine hands over.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import webgpu.resources as gpu
import webgpu.resources { Queue, Texture }
import webgpu.runtime { Device, GpuError }
import webgpu.descriptors {
  TexelCopyBufferLayout,
  TexelCopyTextureInfo,
  TextureDescriptor,
  TextureViewDescriptor
}
import webgpu_sys.generated_webgpu as flags
import gpu_scene.renderer { extent }
import ui_renderer.renderer { UiRenderer }
import fixtures { Tiles }

/// Creates a texture for each of `tiles`' surfaces (BGRA8 with swapped bytes where the surface
/// asks for it), uploads its pixels and registers it with `renderer`. Keep the textures until the
/// frames that draw them are submitted.
pub effect fn uploadSurfaces(
  device: &Device,
  queue: &Queue,
  renderer: &mut UiRenderer,
  tiles: &Tiles,
) -> List<Texture>
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut textures = List<Texture>.make()
  let surfaces = tiles.surfaces.asSlice()
  let mut s: usize = 0
  while s < surfaces.length {
    let surface = &surfaces[s]
    let mut descriptor = TextureDescriptor.default().withLabel(b"ui fixture surface")
    descriptor.setSize(extent(surface.width, surface.height))
    descriptor.setFormat(
      if surface.bgra {
        flags.WGPUTextureFormat_BGRA8Unorm
      } else {
        flags.WGPUTextureFormat_RGBA8Unorm
      },
    )
    descriptor.setDimension(flags.WGPUTextureDimension_2D)
    descriptor.setMipLevelCount(1)
    descriptor.setSampleCount(1)
    descriptor.setUsage(flags.WGPUTextureUsage_TextureBinding | flags.WGPUTextureUsage_CopyDst)
    let texture = run gpu.createTexture(device, &descriptor)
    let mut bytes = List<u8>.make()
    run bytes.appendSlice(surface.pixels.asSlice())
    if surface.bgra {
      let data = bytes.asMutSlice()
      let mut i: usize = 0
      while i + 3 < data.length {
        let r = data[i]
        data[i] = data[i + 2]
        data[i + 2] = r
        i = i + 4
      }
    }
    let destination = TexelCopyTextureInfo.default().withTexture(&texture)
    let mut layout: TexelCopyBufferLayout = TexelCopyBufferLayout.default()
    layout.setBytesPerRow(surface.width * 4)
    layout.setRowsPerImage(surface.height)
    queue.writeTexture(
      &destination,
      bytes.asSlice(),
      &layout,
      &extent(surface.width, surface.height),
    )
    drop destination
    let view = run texture.createView(&TextureViewDescriptor.default())
    run renderer.setSurface(surface.id, &view)
    run textures.append(move texture)
    s = s + 1
  }
  return move textures
}
