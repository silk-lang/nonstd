#!/usr/bin/env python3
"""Run the dense-scene benchmark (release build, on Dawn) and check it against bench/budget.json."""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT.parents[1] / "native" / "gpu" / "webgpu" / "scripts"))
from _build import build  # noqa: E402

budget = json.loads((ROOT / "bench" / "budget.json").read_text())
binary = build(ROOT / "bench", release=True)
result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=600)
sys.stderr.write(result.stderr)
if result.returncode != 0:
    raise SystemExit(result.returncode)
measured = {}
for line in result.stderr.splitlines():
    parts = line.split()
    if len(parts) == 2 and parts[0] in ("primitives", "build", "encode", "frame"):
        measured[parts[0]] = float(parts[1])
print(f"dense scene: {int(measured['primitives'])} primitives, 1280 x 800 BGRA8")
print(f"{'stage':<8} {'median ms':>10} {'budget ms':>10}")
over = []
for stage in ("build", "encode", "frame"):
    print(f"{stage:<8} {measured[stage]:>10.2f} {budget[stage]:>10.2f}")
    if measured[stage] > budget[stage]:
        over.append(stage)
if over:
    raise SystemExit("over budget: " + ", ".join(over))
