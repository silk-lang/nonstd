#!/usr/bin/env python3
"""Imports a texture another GPU API produced (a Vulkan opaque file descriptor on Linux, an IOSurface
on macOS) with webgpu.shared_texture and draws it through UiRenderer surface sprites, compared with
the CPU reference. Linux needs the Vulkan headers and loader (libvulkan-dev). Pass --require to fail
when the adapter cannot import (CI does)."""
import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[1]
sys.path.insert(0, str(REPO / "gpu" / "webgpu" / "scripts"))
from _build import build, command_path  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--require", action="store_true", help="fail when the adapter lacks the import feature")
args = parser.parse_args()

os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
binary = build(ROOT / "shared-texture-test")
command = [str(binary)] + (["--require"] if args.require else [])
print("+ " + shlex.join(command), flush=True)
subprocess.run(command, cwd=REPO, check=True, timeout=300)
