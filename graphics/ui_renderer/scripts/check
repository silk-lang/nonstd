#!/usr/bin/env python3
"""Gate for graphics/ui_renderer: fresh shaders, package checks (native and wasm32) and, unless
--skip-native, the CPU/GPU comparison on Dawn (lavapipe in CI)."""
import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[1]
sys.path.insert(0, str(REPO / "gpu" / "webgpu" / "scripts"))
from _build import build, command_path, executable  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-native", action="store_true", help="omit the GPU comparison")
args = parser.parse_args()


def run(command, **kwargs):
    print("+ " + shlex.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=REPO, check=True, **kwargs)


run([sys.executable, REPO / "gpu/webgpu/scripts/embed-shaders", "--check"])
run([sys.executable, REPO / "gpu/webgpu/scripts/generate-browser", "--check"])
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
silk = compiler_bin / executable("silk")
for package in ("", "fixtures", "tests", "bench", "browser"):
    manifest = ROOT / package / "silk.toml"
    # Generated modules keep their generator's layout.
    sources = sorted(path for path in (ROOT / package / "src").glob("*.silk") if not path.name.startswith("generated_"))
    run([silk, "format", "--check", "--manifest-path", manifest, *sources])
    run([silk, "check", "--manifest-path", manifest])
for package in ("", "browser"):
    run([silk, "check", "--manifest-path", ROOT / package / "silk.toml", "--target", "wasm32-unknown-unknown"])
if not args.skip_native:
    binary = build(ROOT / "tests")
    run([binary], timeout=300)
