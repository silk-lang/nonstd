//! Times a dense UI frame: `columns` x `rows` cards, each a drop shadow, a bordered rounded quad
//! and two lines of glyphs, on a 1280 x 800 BGRA8 target (the common surface format).
//!
//! Prints one `name value` line per measurement, the median over the timed frames in
//! milliseconds: `build` (clear, paint and finish the scene on the CPU), `encode` (pack, upload
//! and record the frame) and `frame` (encode, submit and wait for the GPU). `scripts/bench`
//! compares them with the recorded budget.
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources as gpu
import webgpu.resources { Queue, Texture }
import webgpu.descriptors {
  BufferDescriptor,
  DeviceDescriptor,
  TexelCopyBufferInfo,
  TexelCopyBufferLayout,
  TexelCopyTextureInfo,
  TextureDescriptor,
  TextureViewDescriptor,
}
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i64
import silk.num.u32
import silk.num.usize
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { Instant, SystemClock }
import atlas.atlas { AtlasError, AtlasOptions }
import ui_scene.color { Color }
import ui_scene.scene { Scene }
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import gpu_scene.renderer { extent }
import ui_fixtures.fixtures
import ui_fixtures.fixtures { Tiles }

const WIDTH: u32 = 1280

const HEIGHT: u32 = 800

const COLUMNS: u32 = 16

const ROWS: u32 = 20

const GLYPHS: u32 = 9

const WARMUP: u32 = 3

const FRAMES: u32 = 30

fn nanos(start: &Instant, end: &Instant) -> i64 {
  return (SystemClock.seconds(end) - SystemClock.seconds(start)) * 1000000000
    + SystemClock.nanoseconds(end)
    - SystemClock.nanoseconds(start)
}

effect fn median(times: &mut List<i64>) -> f64
  ! OutOfMemoryError
  ? &mut Allocator {
  run times.sort()
  return i64.toF64(times.asSlice()[times.length() / 2]) / 1000000.0
}

effect fn program() -> i32
  ! GpuError | OutOfMemoryError | AtlasError
  ? &mut Allocator | &mut MonotonicClock {
  let instance = run Instance.create()
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.default())
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run gpu.getQueue(&device)
  let format = flags.WGPUTextureFormat_BGRA8Unorm
  let mut renderer = run UiRenderer.make(&device, format)
  let mut descriptor = TextureDescriptor.default().withLabel(b"bench target")
  descriptor.setSize(extent(WIDTH, HEIGHT))
  descriptor.setFormat(format)
  descriptor.setDimension(flags.WGPUTextureDimension_2D)
  descriptor.setMipLevelCount(1)
  descriptor.setSampleCount(1)
  descriptor.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
  let texture = run gpu.createTexture(&device, &descriptor)
  let view = run texture.createView(&TextureViewDescriptor.default())
  let readback = run gpu.createBuffer(
    &device,
    &BufferDescriptor.make(
      b"bench sync",
      256,
      flags.WGPUBufferUsage_CopyDst | flags.WGPUBufferUsage_MapRead,
      false,
    ),
  )
  let mut scene = Scene.make()
  let mut atlas = GpuAtlas.make()
  let mut builds = List<i64>.make()
  let mut encodes = List<i64>.make()
  let mut frames = List<i64>.make()
  let mut primitives: usize = 0
  let mut frame: u32 = 0
  while frame < WARMUP + FRAMES {
    let start = run MonotonicClock.now()
    scene.clear()
    let mut tiles = Tiles.make(AtlasOptions.default())
    run fixtures.dense(&mut scene, &mut tiles, WIDTH, HEIGHT, COLUMNS, ROWS, GLYPHS)
    run scene.finish()
    let built = run MonotonicClock.now()
    if frame == 0 {
      run atlas.sync(&device, &tiles.atlas)
      let uploads = tiles.uploads.asSlice()
      let mut u: usize = 0
      while u < uploads.length {
        atlas.write(&queue, uploads[u].tile, uploads[u].pixels.asSlice())
        u = u + 1
      }
      primitives = scene.primitiveCount()
    }
    let mut encoder = run gpu.createCommandEncoder(&device, b"bench frame")
    run renderer.encode(
      &device,
      &queue,
      &mut encoder,
      &scene,
      &atlas,
      &view,
      WIDTH,
      HEIGHT,
      Color.white(),
    )
    let encoded = run MonotonicClock.now()

    // Wait for the frame by reading one pixel back.
    let source = TexelCopyTextureInfo.default().withTexture(&texture)
    let mut layout: TexelCopyBufferLayout = TexelCopyBufferLayout.default()
    layout.setBytesPerRow(256)
    layout.setRowsPerImage(1)
    let mut destination = TexelCopyBufferInfo.default().withBuffer(&readback)
    destination.setLayout(layout)
    encoder.copyTextureToBuffer(&source, &destination, &extent(1, 1))
    drop destination
    drop source
    let commands = run encoder.finish(b"bench frame")
    queue.submit(&[commands.reference()])
    drop run runtime.mapRead(&device, &readback, 0, 4)
    let done = run MonotonicClock.now()
    if frame >= WARMUP {
      run builds.append(nanos(&start, &built))
      run encodes.append(nanos(&built, &encoded))
      run frames.append(nanos(&built, &done))
    }
    frame = frame + 1
  }
  run device.checkErrors()
  StderrWriter.print("primitives {}\n", &(primitives,))
  StderrWriter.print("build {}\n", &(run median(&mut builds),))
  StderrWriter.print("encode {}\n", &(run median(&mut encodes),))
  StderrWriter.print("frame {}\n", &(run median(&mut frames),))
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui renderer benchmark failed\n", &())
  return 2
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}
