#!/usr/bin/env python3
"""Build the ui_renderer browser test for wasm and run it in already-installed Chromium."""
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT.parents[2] / "native" / "gpu" / "webgpu" / "core" / "scripts"))
from _build import build  # noqa: E402

binary = build(ROOT.parent / "browser", target="wasm32-unknown-unknown")
command = ["node", str(ROOT.parent / "browser/test.mjs"), "--wasm", str(binary)]
if sys.platform == "linux":
    # Chromium's Linux headless mode lacks WebGPU presentation; a virtual display stands in.
    if not shutil.which("xvfb-run") or not shutil.which("xauth"):
        raise SystemExit("the browser test needs xvfb-run and xauth on Linux; run native/gpu/webgpu/core/scripts/setup-ci --browser")
    command = ["xvfb-run", "--auto-servernum", "--server-args=-screen 0 1280x720x24", *command]
subprocess.run(command, check=True, timeout=600)
