//! Packs a finished `ui_scene.Scene` into the instance layouts the WGSL shaders read.
//!
//! Every kind's sorted list, from every layer, goes into one byte list in layer order, so one GPU
//! buffer per kind holds the whole frame and a batch draws instances `base + start .. base + end`.
//! The lists keep their storage between frames.
import silk.collections.list { List }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silk.color.color { ColorSpace }
import silk.color.rgba { Rgba }
import ui_scene.color
import ui_scene.primitives {
  Background,
  BorderStyle,
  LinearGradient,
  ContentMask,
  GlyphSprite,
  ImageSprite,
  PathSprite,
  Quad,
  Shadow,
  Underline,
}
import ui_scene.scene { Scene, KIND_COUNT }
import vector.pixmap { pack }
import vector.strips { Fill, Strip }

/// Bytes per instance of each kind, matching the structs in `shaders/`.
pub const QUAD_BYTES: usize = 160

pub const SHADOW_BYTES: usize = 128

pub const UNDERLINE_BYTES: usize = 64

pub const MONO_BYTES: usize = 64

pub const POLY_BYTES: usize = 96

pub const PATH_BYTES: usize = 96

pub const RUN_BYTES: usize = 32

/// Entries per gradient ramp, one premultiplied RGBA8 word each, as the CPU reference keeps.
pub const RAMP_LENGTH: usize = 256

const SOLID: u32 = 4294967295

const PI: f64 = 3.141592653589793

fn writeWord(bytes: &mut [u8], offset: usize, value: u32) -> () {
  bytes[offset] = u32.toU8(value & 255)
  bytes[offset + 1] = u32.toU8(u32.shiftRight(value, 8) & 255)
  bytes[offset + 2] = u32.toU8(u32.shiftRight(value, 16) & 255)
  bytes[offset + 3] = u32.toU8(u32.shiftRight(value, 24))
}

effect fn pushU32(bytes: &mut List<u8>, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut word: [u8; 4] = [0; 4]
  writeWord(&mut word, 0, value)
  run bytes.appendSlice(&word)
}

effect fn pushF32(bytes: &mut List<u8>, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushU32(&mut bytes, f32.toBits(value))
}

effect fn push4(bytes: &mut List<u8>, a: f32, b: f32, c: f32, d: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // One capacity check and bulk copy per vector, instead of sixteen individual appends.
  // Explicit little-endian writes preserve the shader ABI independently of host endianness.
  let mut vector: [u8; 16] = [0; 16]
  writeWord(&mut vector, 0, f32.toBits(a))
  writeWord(&mut vector, 4, f32.toBits(b))
  writeWord(&mut vector, 8, f32.toBits(c))
  writeWord(&mut vector, 12, f32.toBits(d))
  run bytes.appendSlice(&vector)
}

effect fn pushRect(bytes: &mut List<u8>, r: Rect<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, r.xMin, r.yMin, r.xMax, r.yMax)
}

effect fn pushColor(bytes: &mut List<u8>, c: Rgba<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, c.r, c.g, c.b, c.a)
}

effect fn pushCorners(bytes: &mut List<u8>, c: Corners<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, c.topLeft, c.topRight, c.bottomRight, c.bottomLeft)
}

/// Appends the 256-entry ramp of `gradient` to `ramps`, sampled with the same `color.mix` the
/// CPU reference uses, and returns its index.
effect fn pushRamp(ramps: &mut List<u8>, gradient: LinearGradient) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let index = usize.toU32(ramps.length() / (RAMP_LENGTH * 4))
  let mut i: usize = 0
  while i < RAMP_LENGTH {
    let t = usize.toF32(i) / 255.0
    let c = color.mix(gradient.from.color, gradient.to.color, t, gradient.interpolation)
    run pushU32(&mut ramps, pack(color.toPremultipliedRgba8(c)))
    i = i + 1
  }
  return index
}

/// The `Paint` struct of `shaders/common.wgsl`: 20 words. `box` is the box a gradient spans.
/// Gradients interpolated in sRGB mix in the shader; any other interpolation (Oklab, Oklch, a
/// hue arc, a wide gamut space, ...) gets a ramp in `ramps`, so it matches `silk.color` exactly.
effect fn pushPaint(
  bytes: &mut List<u8>,
  ramps: &mut List<u8>,
  paint: Background,
  box: Rect<f32>,
  dashed: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let dash: u32 = if dashed {
    1
  } else {
    0
  }
  match paint {
    Background.Solid { color: fill } => {
      run pushU32(&mut bytes, 0)
      run pushU32(&mut bytes, 0)
      run pushU32(&mut bytes, dash)
      run pushU32(&mut bytes, 0)
      run pushColor(&mut bytes, fill)
      run push4(&mut bytes, 0.0, 0.0, 0.0, 0.0)
      run push4(&mut bytes, 0.0, 0.0, 0.0, 0.0)
      run push4(&mut bytes, 1.0, 0.0, 0.0, 0.0)
    }
    Background.Linear { gradient } => {
      // CSS: the line runs through the center at `angle` clockwise from up, long enough that the
      // corners reach 0 and 1 (the CPU reference's Painter.setGradient).
      let radians = f32.toF64(gradient.angle) * PI / 180.0
      let dx = f64.toF32(f64.sin(radians))
      let dy = f64.toF32(-f64.cos(radians))
      let w = box.xMax - box.xMin
      let h = box.yMax - box.yMin
      let half = f32.max((f32.abs(w * dx) + f32.abs(h * dy)) * 0.5, 0.000001)
      let native = match gradient.interpolation.space {
        ColorSpace.Srgb => true
        _ => false
      }
      if native {
        run pushU32(&mut bytes, 1)
        run pushU32(&mut bytes, 0)
      } else {
        let ramp = run pushRamp(&mut ramps, gradient)
        run pushU32(&mut bytes, 2)
        run pushU32(&mut bytes, ramp)
      }
      run pushU32(&mut bytes, dash)
      run pushU32(&mut bytes, 0)
      run pushColor(&mut bytes, gradient.from.color)
      run pushColor(&mut bytes, gradient.to.color)
      run push4(&mut bytes, (box.xMin + box.xMax) * 0.5, (box.yMin + box.yMax) * 0.5, dx, dy)
      run push4(&mut bytes, half, gradient.from.offset, gradient.to.offset, 0.0)
    }
  }
}

effect fn packQuad(bytes: &mut List<u8>, ramps: &mut List<u8>, q: Quad) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, q.bounds)
  run pushRect(&mut bytes, q.mask.bounds)
  run pushCorners(&mut bytes, q.cornerRadii)
  let w = q.borderWidths
  run push4(&mut bytes, w.top, w.right, w.bottom, w.left)
  let border = if q.hasBorder() {
    q.borderColor
  } else {
    color.transparent()
  }
  run pushColor(&mut bytes, border)
  let dashed = match q.borderStyle {
    BorderStyle.Solid => false
    BorderStyle.Dashed => true
  }
  run pushPaint(&mut bytes, &mut ramps, q.background, q.bounds, dashed)
}

effect fn packShadow(bytes: &mut List<u8>, s: Shadow) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, s.shape())
  run pushRect(&mut bytes, s.mask.bounds)
  run pushCorners(&mut bytes, s.shapeRadii())
  run pushColor(&mut bytes, s.color)
  run pushRect(&mut bytes, s.bounds)
  run pushCorners(&mut bytes, s.cornerRadii)
  run pushRect(&mut bytes, s.paintBounds())
  run push4(
    &mut bytes,
    s.sigma(),
    if s.inset {
      1.0
    } else {
      0.0
    },
    0.0,
    0.0,
  )
}

effect fn packUnderline(bytes: &mut List<u8>, u: Underline) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, u.bounds)
  run pushRect(&mut bytes, u.mask.bounds)
  run pushColor(&mut bytes, u.color)
  run push4(
    &mut bytes,
    u.thickness,
    if u.wavy {
      1.0
    } else {
      0.0
    },
    0.0,
    0.0,
  )
}

effect fn pushTile(bytes: &mut List<u8>, r: Rect<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, u32.toF32(r.xMin), u32.toF32(r.yMin), u32.toF32(r.xMax), u32.toF32(r.yMax))
}

effect fn packGlyph(bytes: &mut List<u8>, g: GlyphSprite) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, g.bounds)
  run pushRect(&mut bytes, g.mask.bounds)
  run pushColor(&mut bytes, g.color)
  run pushTile(&mut bytes, g.tile.bounds)
}

effect fn packImage(bytes: &mut List<u8>, s: ImageSprite) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, s.bounds)
  run pushRect(&mut bytes, s.mask.bounds)
  run pushTile(&mut bytes, s.tile.bounds)
  run pushRect(&mut bytes, s.clipBounds)
  run pushCorners(&mut bytes, s.cornerRadii)
  run push4(
    &mut bytes,
    s.opacity,
    if s.grayscale {
      1.0
    } else {
      0.0
    },
    u32.toF32(s.quarterTurns % 4),
    0.0,
  )
}

/// One frame's instances, ready to upload.
pub struct Instances {
  pub quads: List<u8>,
  pub shadows: List<u8>,
  pub underlines: List<u8>,
  pub glyphs: List<u8>,
  pub images: List<u8>,
  pub paths: List<u8>,
  pub runs: List<u8>,
  pub alphas: List<u8>,
  /// Gradient ramps, `RAMP_LENGTH` words each.
  pub ramps: List<u8>,
  /// For layer `l` and kind `k`, `bases[l * KIND_COUNT + k]` is the index of the layer's first
  /// instance of that kind.
  bases: List<u32>,
  /// The first run of each path, in packed order, plus the total run count at the end.
  pathRuns: List<u32>,
}

impl Instances {
  pub fn make() -> Instances {
    return Instances {
      quads: List<u8>.make(),
      shadows: List<u8>.make(),
      underlines: List<u8>.make(),
      glyphs: List<u8>.make(),
      images: List<u8>.make(),
      paths: List<u8>.make(),
      runs: List<u8>.make(),
      alphas: List<u8>.make(),
      ramps: List<u8>.make(),
      bases: List<u32>.make(),
      pathRuns: List<u32>.make(),
    }
  }

  /// The instance index of item `start` of kind `kind` (a `PrimitiveKind.index()`) in `layer`.
  pub fn base(self: &Self, layer: u32, kind: u32) -> u32 {
    return self.bases.get(u32.toUsize(layer) * KIND_COUNT + u32.toUsize(kind))
  }

  /// The runs of paths `first .. end` (packed path indices).
  pub fn runRange(self: &Self, first: u32, end: u32) -> [u32; 2] {
    return [self.pathRuns.get(u32.toUsize(first)), self.pathRuns.get(u32.toUsize(end))]
  }

  /// The number of path runs.
  pub fn runCount(self: &Self) -> u32 {
    return usize.toU32(self.runs.length() / RUN_BYTES)
  }

  /// Packs every layer of `scene`, which must be finished.
  pub effect fn pack(self: &mut Self, scene: &Scene) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.quads.clear()
    self.shadows.clear()
    self.underlines.clear()
    self.glyphs.clear()
    self.images.clear()
    self.paths.clear()
    self.runs.clear()
    self.alphas.clear()
    self.ramps.clear()
    self.bases.clear()
    self.pathRuns.clear()
    run self.alphas.appendSlice(scene.pathAlphas())
    while self.alphas.length() % 4 != 0 {
      run self.alphas.append(0)
    }
    let strips = scene.pathStrips()
    let fills = scene.pathFills()
    let mut layer: u32 = 0
    while layer < scene.layerCount() {
      run self.bases.append(usize.toU32(self.shadows.length() / SHADOW_BYTES))
      run self.bases.append(usize.toU32(self.quads.length() / QUAD_BYTES))
      run self.bases.append(usize.toU32(self.paths.length() / PATH_BYTES))
      run self.bases.append(usize.toU32(self.underlines.length() / UNDERLINE_BYTES))
      run self.bases.append(usize.toU32(self.glyphs.length() / MONO_BYTES))
      run self.bases.append(usize.toU32(self.images.length() / POLY_BYTES))
      run self.bases.append(0)
      let shadows = scene.shadows(layer)
      let mut i: usize = 0
      while i < shadows.length {
        run packShadow(&mut self.shadows, shadows[i])
        i = i + 1
      }
      let quads = scene.quads(layer)
      i = 0
      while i < quads.length {
        run packQuad(&mut self.quads, &mut self.ramps, quads[i])
        i = i + 1
      }
      let underlines = scene.underlines(layer)
      i = 0
      while i < underlines.length {
        run packUnderline(&mut self.underlines, underlines[i])
        i = i + 1
      }
      let glyphs = scene.glyphs(layer)
      i = 0
      while i < glyphs.length {
        run packGlyph(&mut self.glyphs, glyphs[i])
        i = i + 1
      }
      let images = scene.images(layer)
      i = 0
      while i < images.length {
        run packImage(&mut self.images, images[i])
        i = i + 1
      }
      let paths = scene.paths(layer)
      i = 0
      while i < paths.length {
        run self.packPath(paths[i], strips, fills)
        i = i + 1
      }
      layer = layer + 1
    }
    let total = self.runCount()
    run self.pathRuns.append(total)
  }

  effect fn packPath(self: &mut Self, p: PathSprite, strips: &[Strip], fills: &[Fill]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = usize.toU32(self.paths.length() / PATH_BYTES)
    let firstRun = self.runCount()
    run self.pathRuns.append(firstRun)
    run pushRect(&mut self.paths, p.mask.bounds)
    run pushPaint(&mut self.paths, &mut self.ramps, p.paint, p.paintBounds, false)
    let bottom = p.y + u32.toI32(p.height)
    let mut s = u32.toUsize(p.stripStart)
    while s < u32.toUsize(p.stripStart + p.stripCount) {
      let strip = strips[s]
      run self.addRun(
        p.x + u32.toI32(strip.x),
        p.y + u32.toI32(strip.y),
        strip.width,
        strip.alphaOffset / 4,
        index,
        bottom,
      )
      s = s + 1
    }
    let mut f = u32.toUsize(p.fillStart)
    while f < u32.toUsize(p.fillStart + p.fillCount) {
      let fill = fills[f]
      run self.addRun(
        p.x + u32.toI32(fill.x),
        p.y + u32.toI32(fill.y),
        fill.width,
        SOLID,
        index,
        bottom,
      )
      f = f + 1
    }
  }

  effect fn addRun(
    self: &mut Self,
    x: i32,
    y: i32,
    width: u32,
    alpha: u32,
    path: u32,
    bottom: i32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run pushU32(&mut self.runs, i32.wrappingToU32(x))
    run pushU32(&mut self.runs, i32.wrappingToU32(y))
    run pushU32(&mut self.runs, width)
    run pushU32(&mut self.runs, alpha)
    run pushU32(&mut self.runs, path)
    run pushU32(&mut self.runs, i32.wrappingToU32(bottom))
    run pushU32(&mut self.runs, 0)
    run pushU32(&mut self.runs, 0)
  }
}
