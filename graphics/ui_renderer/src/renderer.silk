//! Draws a finished `ui_scene.Scene` with WebGPU, natively through Dawn and in the browser.
//!
//! Each batch of the scene is one instanced draw: quads (rounded-rectangle SDF with borders and
//! dashes), shadows (closed-form Gaussian along x, sampled along y), underlines, monochrome
//! sprites with text gamma and contrast correction, polychrome sprites, and path coverage strips.
//! All instances of a frame live in persistent storage buffers, one per kind, that grow when a
//! frame outgrows them and are never shrunk.
//!
//! A scene without isolated layers draws straight onto the target. With isolated layers, the frame
//! is drawn into an RGBA8 texture, each layer into its own texture, composited with gpu_scene's
//! blend modes, and the result is copied to the target at the end. Textures are pooled across
//! frames.
//!
//! The output is premultiplied, blended in the target's (sRGB-encoded) space, like the CPU
//! reference `ui_scene.cpu.CpuRenderer`, which it matches within a small tolerance rather than byte
//! for byte: analytic SDF edges and the erf blur differ from exact area coverage and a separable
//! Gaussian by a few levels at edges.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import webgpu.resources as gpu
import webgpu.resources { BindGroup, Buffer, CommandEncoder, Queue, RenderPipeline, TextureView }
import webgpu.runtime { Device, GpuError }
import webgpu.descriptors {
  BindGroupDescriptor,
  BindGroupEntry,
  BlendComponent,
  BlendState,
  Color as ClearColor,
  ColorTargetState,
  FragmentState,
  MultisampleState,
  Origin3D,
  PrimitiveState,
  RenderPassColorAttachment,
  RenderPassDescriptor,
  RenderPipelineDescriptor,
  TexelCopyTextureInfo,
  VertexState,
}
import webgpu_sys.generated_webgpu as flags
import gpu_scene.renderer { entry, extent, storage, textureEntry, upload }
import silk.color.rgba { Rgba }
import ui_scene.color as color
import gpu_scene.filter { FilterImage, FilterRenderer }
import vector.filter { BlurPlan, Region }
import ui_scene.effects { LayerEffects }
import ui_scene.primitives { LayerSprite }
import ui_scene.scene { Batch, PrimitiveKind, Scene }
import ui_scene.scroll { Placements, ScrollPosition }
import atlas_textures { GpuAtlas }
import instances {
  Instances,
  MONO_BYTES,
  PATH_BYTES,
  POLY_BYTES,
  QUAD_BYTES,
  RUN_BYTES,
  SHADOW_BYTES,
  UNDERLINE_BYTES,
}
import text { TextSettings }
import generated_shaders as shaders

/// The format of offscreen layers.
pub const LAYER_FORMAT: u32 = flags.WGPUTextureFormat_RGBA8Unorm

const GLOBALS: usize = 0

const SHADOWS: usize = 1

const QUADS: usize = 2

const UNDERLINES: usize = 3

const GLYPHS: usize = 4

const IMAGES: usize = 5

const PATHS: usize = 6

const RUNS: usize = 7

const ALPHAS: usize = 8

const RAMPS: usize = 9

const OP_COMPOSITE: u32 = 0

const OP_COPY: u32 = 1

/// Whether `format` is a target the renderer can draw to: RGBA8Unorm or BGRA8Unorm, the formats
/// WebGPU surfaces offer. (The `-srgb` variants would re-encode the already sRGB-encoded output.)
pub fn supportsFormat(format: u32) -> bool {
  return format == flags.WGPUTextureFormat_RGBA8Unorm
    || format == flags.WGPUTextureFormat_BGRA8Unorm
}

struct Modules {
  quad: gpu.ShaderModule,
  shadow: gpu.ShaderModule,
  underline: gpu.ShaderModule,
  mono: gpu.ShaderModule,
  poly: gpu.ShaderModule,
  path: gpu.ShaderModule,
}

/// One pipeline per primitive kind, for one target format.
struct Pipelines {
  quad: RenderPipeline,
  shadow: RenderPipeline,
  underline: RenderPipeline,
  mono: RenderPipeline,
  poly: RenderPipeline,
  path: RenderPipeline,
}

/// Premultiplied source-over.
fn over() -> BlendComponent {
  let mut component = BlendComponent.default()
  component.setOperation(flags.WGPUBlendOperation_Add)
  component.setSrcFactor(flags.WGPUBlendFactor_One)
  component.setDstFactor(flags.WGPUBlendFactor_OneMinusSrcAlpha)
  return component
}

effect fn makePipeline(
  device: &Device,
  module: &gpu.ShaderModule,
  format: u32,
  blended: bool,
) -> RenderPipeline
  ! GpuError {
  let vertex = VertexState.default().withModule(module).withEntryPoint(b"vs")
  let mut blend = BlendState.default()
  blend.setColor(over())
  blend.setAlpha(over())
  let mut target: ColorTargetState = if blended {
    ColorTargetState.default().withBlend(&blend)
  } else {
    ColorTargetState.default()
  }
  target.setFormat(format)
  target.setWriteMask(flags.WGPUColorWriteMask_All)
  let targets = [target]
  let fragment = FragmentState.default().withModule(module).withEntryPoint(b"fs").withTargets(
    &targets,
  )
  let mut primitive: PrimitiveState = PrimitiveState.default()
  primitive.setTopology(flags.WGPUPrimitiveTopology_TriangleList)
  let mut multisample: MultisampleState = MultisampleState.default()
  multisample.setCount(1)
  let mut descriptor = RenderPipelineDescriptor.default().withVertex(vertex).withFragment(&fragment)
  descriptor.setPrimitive(primitive)
  descriptor.setMultisample(multisample)
  return run gpu.createRenderPipeline(device, &descriptor)
}

effect fn makePipelines(device: &Device, modules: &Modules, format: u32) -> Pipelines
  ! GpuError {
  return Pipelines {
    quad: run makePipeline(device, &modules.quad, format, true),
    shadow: run makePipeline(device, &modules.shadow, format, true),
    underline: run makePipeline(device, &modules.underline, format, true),
    mono: run makePipeline(device, &modules.mono, format, true),
    poly: run makePipeline(device, &modules.poly, format, true),
    path: run makePipeline(device, &modules.path, format, true),
  }
}

fn clearOf(color: Rgba<f32>) -> ClearColor {
  let a = f32.max(f32.min(color.a, 1.0), 0.0)
  let mut clear = ClearColor.default()
  clear.setR(f32.toF64(f32.max(f32.min(color.r, 1.0), 0.0) * a))
  clear.setG(f32.toF64(f32.max(f32.min(color.g, 1.0), 0.0) * a))
  clear.setB(f32.toF64(f32.max(f32.min(color.b, 1.0), 0.0) * a))
  clear.setA(f32.toF64(a))
  return clear
}

fn writeU32(bytes: &mut [u8], offset: usize, value: u32) -> () {
  bytes[offset] = u32.toU8(value & 255)
  bytes[offset + 1] = u32.toU8(u32.shiftRight(value, 8) & 255)
  bytes[offset + 2] = u32.toU8(u32.shiftRight(value, 16) & 255)
  bytes[offset + 3] = u32.toU8(u32.shiftRight(value, 24))
}

/// How deep the isolated layers drawn by `layer` nest, 0 when there are none.
fn depthOf(scene: &Scene, layer: u32) -> u32 {
  let sprites = scene.layers(layer)
  let mut deepest: u32 = 0
  let mut i: usize = 0
  while i < sprites.length {
    let d = 1 + depthOf(scene, sprites[i].layer)
    if d > deepest {
      deepest = d
    }
    i = i + 1
  }
  return deepest
}

/// The number of isolated layers composited under `layer`, nested ones included.
fn compositesOf(scene: &Scene, layer: u32) -> usize {
  let sprites = scene.layers(layer)
  let mut total = sprites.length
  let mut i: usize = 0
  while i < sprites.length {
    total = total + compositesOf(scene, sprites[i].layer)
    i = i + 1
  }
  return total
}

/// A rectangle of target pixels.
struct Area {
  x: u32,
  y: u32,
  width: u32,
  height: u32,
}

fn areaOf(sprite: &LayerSprite, width: u32, height: u32) -> Area {
  let x0 = f32.max(f32.floor(sprite.bounds.xMin), 0.0)
  let y0 = f32.max(f32.floor(sprite.bounds.yMin), 0.0)
  let x1 = f32.min(f32.ceil(sprite.bounds.xMax), u32.toF32(width))
  let y1 = f32.min(f32.ceil(sprite.bounds.yMax), u32.toF32(height))
  if !(x0 < x1 && y0 < y1) {
    return Area { x: 0, y: 0, width: 0, height: 0 }
  }
  return Area {
    x: f32.toU32(x0),
    y: f32.toU32(y0),
    width: f32.toU32(x1 - x0),
    height: f32.toU32(y1 - y0),
  }
}

/// Draws UI scenes onto one target format. Keep one per window and reuse it every frame.
pub struct UiRenderer {
  format: u32,
  direct: Pipelines,
  offscreen: Pipelines,
  composite: RenderPipeline,
  copy: RenderPipeline,
  overlay: RenderPipeline,
  text: TextSettings,
  instances: Instances,
  /// The globals uniform and the instance buffers (see GLOBALS .. RAMPS).
  buffers: List<Buffer>,
  /// One 48-byte uniform per composite or copy pass of a frame.
  params: List<Buffer>,
  /// 0 is the backdrop copy, 1 + d the target of nesting depth d.
  layers: List<FilterImage>,
  filters: List<FilterRenderer>,
  layerWidth: u32,
  layerHeight: u32,
  /// Scroll positions newer than a scene's own (see [`UiRenderer.setScrolls`]).
  newer: List<ScrollPosition>,
  /// The scroll groups of the scene drawn last, placed.
  placed: Placements,
}

impl UiRenderer {
  /// A renderer for targets of `format` (see [`supportsFormat`]), with GPUI's default text
  /// correction.
  pub effect fn make(device: &Device, format: u32) -> UiRenderer
    ! GpuError {
    let modules = Modules {
      quad: run gpu.createShaderModule(device, b"ui quad", shaders.quad()),
      shadow: run gpu.createShaderModule(device, b"ui shadow", shaders.shadow()),
      underline: run gpu.createShaderModule(device, b"ui underline", shaders.underline()),
      mono: run gpu.createShaderModule(device, b"ui mono sprite", shaders.mono()),
      poly: run gpu.createShaderModule(device, b"ui poly sprite", shaders.poly()),
      path: run gpu.createShaderModule(device, b"ui path", shaders.path()),
    }
    let layer = run gpu.createShaderModule(device, b"ui layer", shaders.layer())
    return UiRenderer {
      format: format,
      direct: run makePipelines(device, &modules, format),
      offscreen: run makePipelines(device, &modules, LAYER_FORMAT),
      composite: run makePipeline(device, &layer, LAYER_FORMAT, false),
      copy: run makePipeline(device, &layer, format, false),
      overlay: run makePipeline(device, &layer, format, true),
      text: TextSettings.default(),
      instances: Instances.make(),
      buffers: List<Buffer>.make(),
      params: List<Buffer>.make(),
      layers: List<FilterImage>.make(),
      filters: List<FilterRenderer>.make(),
      layerWidth: 0,
      layerHeight: 0,
      newer: List<ScrollPosition>.make(),
      placed: Placements.make(),
    }
  }

  /// Draws the scroll groups of every following scene at `positions` where one is for their
  /// node, instead of where the scene was painted: a compositor scroll, without painting again.
  /// An empty list draws scenes as painted.
  pub effect fn setScrolls(self: &mut Self, positions: &[ScrollPosition]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.newer.clear()
    run self.newer.appendSlice(positions)
  }

  /// The target format.
  pub fn targetFormat(self: &Self) -> u32 {
    return self.format
  }

  /// The text correction used for glyph sprites.
  pub fn textSettings(self: &Self) -> TextSettings {
    return self.text
  }

  pub fn setTextSettings(self: &mut Self, settings: TextSettings) -> () {
    self.text = settings
  }

  /// Clears `target` (`width` x `height`, of the renderer's format) to `clear`, draws layer 0 of
  /// `scene` (which must be finished) with sprites from `atlas`, and submits.
  pub effect fn draw(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    scene: &Scene,
    atlas: &GpuAtlas,
    target: &TextureView,
    width: u32,
    height: u32,
    clear: Rgba<f32>,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let mut encoder = run gpu.createCommandEncoder(device, b"ui frame")
    run self.encode(device, queue, &mut encoder, scene, atlas, target, width, height, clear)
    let finished = run encoder.finish(b"ui frame")
    queue.submit(&[finished.reference()])
  }

  /// Draws an overlay onto an existing target without clearing it.
  /// Opacity and layer filters are supported. Backdrop filters and non-normal
  /// blends must use `draw` with the underlying content in the same scene.
  /// Use a separate renderer for the underlying retained geometry so its buffers survive.
  pub effect fn drawOverlay(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    scene: &Scene,
    atlas: &GpuAtlas,
    target: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if width == 0 || height == 0 || scene.layerCount() == 0 {
      return
    }
    run self.upload(device, queue, scene, width, height)
    let mut encoder = run gpu.createCommandEncoder(device, b"ui overlay")
    if scene.layerCount() == 1 || compositesOf(scene, 0) == 0 {
      run self.drawRange(
        device,
        &mut encoder,
        target,
        &self.direct,
        scene,
        atlas,
        0,
        0,
        scene.batches(0).length,
        true,
        clearOf(color.transparent()),
      )
    } else {
      run self.reserve(device, queue, scene, width, height)
      let mut slot: usize = 0
      run self.isolated(
        device,
        queue,
        &mut encoder,
        scene,
        atlas,
        0,
        0,
        clearOf(color.transparent()),
        width,
        height,
        &mut slot,
      )
      run self.pass(
        device,
        queue,
        &mut encoder,
        &self.overlay,
        target,
        slot,
        OP_COPY,
        0,
        255,
        1,
        0,
        LayerEffects.none(),
        Area { x: 0, y: 0, width: width, height: height },
      )
    }
    let finished = run encoder.finish(b"ui overlay")
    queue.submit(&[finished.reference()])
  }

  /// Draws a single-layer, image-only scene using a GPU camera transform.
  /// Set `refresh` after any scene/atlas binding change or intervening ordinary draw.
  /// The scene remains in its original coordinates; only the camera uniform is
  /// uploaded on other frames. Scale must be positive and finite.
  pub effect fn drawRetainedImages(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    scene: &Scene,
    atlas: &GpuAtlas,
    target: &TextureView,
    width: u32,
    height: u32,
    clear: Rgba<f32>,
    scale: f32,
    x: f32,
    y: f32,
    refresh: bool,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if refresh {
      run self.upload(device, queue, scene, width, height)
    }
    let mut globals: [u8; 48] = [0; 48]
    writeU32(&mut globals, 0, f32.toBits(u32.toF32(width)))
    writeU32(&mut globals, 4, f32.toBits(u32.toF32(height)))
    writeU32(&mut globals, 32, f32.toBits(scale))
    writeU32(&mut globals, 40, f32.toBits(x))
    writeU32(&mut globals, 44, f32.toBits(y))
    queue.writeBuffer(&self.buffers.asSlice()[GLOBALS], 0, &globals)
    let mut encoder = run gpu.createCommandEncoder(device, b"retained images")
    run self.drawRange(
      device,
      &mut encoder,
      target,
      &self.direct,
      scene,
      atlas,
      0,
      0,
      scene.batches(0).length,
      false,
      clearOf(clear),
    )
    let finished = run encoder.finish(b"retained images")
    queue.submit(&[finished.reference()])
  }

  /// [`UiRenderer.draw`] into `encoder` without submitting, for callers that also present or
  /// read back. Buffer and texture writes are queued on `queue` now, so submit `encoder` before
  /// encoding the next frame with this renderer.
  pub effect fn encode(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    encoder: &mut CommandEncoder,
    scene: &Scene,
    atlas: &GpuAtlas,
    target: &TextureView,
    width: u32,
    height: u32,
    clear: Rgba<f32>,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if width == 0 || height == 0 {
      return
    }
    run self.upload(device, queue, scene, width, height)
    if scene.layerCount() == 0 {
      run clearPass(&mut encoder, target, clearOf(clear))
      return
    }
    if scene.layerCount() == 1 || compositesOf(scene, 0) == 0 {
      let count = scene.batches(0).length
      run self.drawRange(
        device,
        &mut encoder,
        target,
        &self.direct,
        scene,
        atlas,
        0,
        0,
        count,
        false,
        clearOf(clear),
      )
      return
    }
    run self.reserve(device, queue, scene, width, height)
    let mut slot: usize = 0
    run self.isolated(
      device,
      queue,
      &mut encoder,
      scene,
      atlas,
      0,
      0,
      clearOf(clear),
      width,
      height,
      &mut slot,
    )
    run self.pass(
      device,
      queue,
      &mut encoder,
      &self.copy,
      target,
      slot,
      OP_COPY,
      0,
      255,
      1,
      0,
      LayerEffects.none(),
      Area { x: 0, y: 0, width: width, height: height },
    )
  }

  effect fn upload(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    scene: &Scene,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    run self.placed.resolve(scene.scrollGroups(), scene.scrolls(), self.newer.asSlice())
    run self.instances.pack(scene, &self.placed)
    let mut globals: [u8; 48] = [0; 48]
    writeU32(&mut globals, 0, f32.toBits(u32.toF32(width)))
    writeU32(&mut globals, 4, f32.toBits(u32.toF32(height)))
    writeU32(&mut globals, 8, f32.toBits(self.text.contrast))
    let ratios = self.text.gammaRatios()
    let mut r: usize = 0
    while r < 4 {
      writeU32(&mut globals, 16 + r * 4, f32.toBits(ratios[r]))
      r = r + 1
    }
    writeU32(&mut globals, 32, f32.toBits(1.0))
    let storage = flags.WGPUBufferUsage_Storage
    run upload(
      device,
      queue,
      &mut self.buffers,
      GLOBALS,
      b"ui globals",
      &globals,
      flags.WGPUBufferUsage_Uniform,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      SHADOWS,
      b"ui shadows",
      &mut self.instances.shadows,
      SHADOW_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      QUADS,
      b"ui quads",
      &mut self.instances.quads,
      QUAD_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      UNDERLINES,
      b"ui underlines",
      &mut self.instances.underlines,
      UNDERLINE_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      GLYPHS,
      b"ui glyphs",
      &mut self.instances.glyphs,
      MONO_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      IMAGES,
      b"ui images",
      &mut self.instances.images,
      POLY_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      PATHS,
      b"ui paths",
      &mut self.instances.paths,
      PATH_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      RUNS,
      b"ui path runs",
      &mut self.instances.runs,
      RUN_BYTES,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      ALPHAS,
      b"ui path alphas",
      &mut self.instances.alphas,
      16,
      storage,
    )
    run uploadList(
      device,
      queue,
      &mut self.buffers,
      RAMPS,
      b"ui gradient ramps",
      &mut self.instances.ramps,
      16,
      storage,
    )
  }

  /// Grows the pooled layer textures and pass uniforms to what `scene` needs.
  effect fn reserve(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    scene: &Scene,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    if self.filters.length() == 0 {
      run self.filters.append(run FilterRenderer.make(device, queue))
    }
    self.filters.asMutSlice()[0].reset()
    if width != self.layerWidth || height != self.layerHeight {
      self.layers.clear()
      self.layerWidth = width
      self.layerHeight = height
    }
    let needed = u32.toUsize(depthOf(scene, 0)) + 5
    while self.layers.length() < needed {
      let layer = run FilterImage.make(device, width, height)
      run self.layers.append(move layer)
    }
    let passes = compositesOf(scene, 0) + 1
    let zeros: [u8; 48] = [0; 48]
    while self.params.length() < passes {
      let buffer = run storage(
        device,
        queue,
        b"ui layer params",
        &zeros,
        flags.WGPUBufferUsage_Uniform,
      )
      run self.params.append(move buffer)
    }
  }

  /// Draws `layer` into the layer texture of nesting `depth`, cleared to `clear`, compositing the
  /// isolated layers it holds as they come in its batches.
  effect fn isolated(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    encoder: &mut CommandEncoder,
    scene: &Scene,
    atlas: &GpuAtlas,
    layer: u32,
    depth: u32,
    clear: ClearColor,
    width: u32,
    height: u32,
    slot: &mut usize,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let targetIndex = u32.toUsize(depth) + 1
    let batches = scene.batches(layer)
    let mut from: usize = 0
    let mut load = false
    let mut b: usize = 0
    while b < batches.length {
      let batch = batches[b]
      let isLayer = match batch.kind {
        PrimitiveKind.Layer => true
        _ => false
      }
      if isLayer {
        run self.drawRange(
          device,
          &mut encoder,
          &self.layers.asSlice()[targetIndex].view,
          &self.offscreen,
          scene,
          atlas,
          layer,
          from,
          b,
          load,
          clear,
        )
        load = true
        let sprites = scene.layers(layer)
        let groups = scene.groupsOf(layer, PrimitiveKind.Layer)
        let mut i = u32.toUsize(batch.start)
        while i < u32.toUsize(batch.end) {
          let sprite = self.placed.layer(sprites[i], groups[i])
          let area = areaOf(&sprite, width, height)
          if area.width > 0 {
            let transparent = clearOf(Rgba<f32>.new(0.0, 0.0, 0.0, 0.0))
            run self.isolated(
              device,
              queue,
              &mut encoder,
              scene,
              atlas,
              sprite.layer,
              depth + 1,
              transparent,
              width,
              height,
              &mut slot,
            )

            // The blend reads what is under the layer from a copy.
            let list = self.layers.asSlice()
            let target = &list[targetIndex]
            let mut origin = Origin3D.default()
            if sprite.effects.backdropBlur == 0.0 {
              origin.setX(area.x)
              origin.setY(area.y)
            }
            let mut source = TexelCopyTextureInfo.default().withTexture(&target.texture)
            source.setOrigin(origin)
            let mut copy = TexelCopyTextureInfo.default().withTexture(&list[0].texture)
            copy.setOrigin(origin)
            encoder.copyTextureToTexture(
              &source,
              &copy,
              &extent(
                if sprite.effects.backdropBlur > 0.0 {
                  width
                } else {
                  area.width
                },
                if sprite.effects.backdropBlur > 0.0 {
                  height
                } else {
                  area.height
                },
              ),
            )
            drop list
            let content = run self.filterLayer(
              device,
              queue,
              &mut encoder,
              sprite,
              u32.toUsize(depth) + 2,
              width,
              height,
            )
            let opacity = f32.toU32(
              f32.max(f32.min(sprite.isolation.opacity, 1.0), 0.0) * 255.0 + 0.5,
            )
            run self.pass(
              device,
              queue,
              &mut encoder,
              &self.composite,
              &self.layers.asSlice()[targetIndex].view,
              slot.*,
              OP_COMPOSITE,
              u8ToU32(sprite.isolation.blend),
              opacity,
              content,
              if sprite.effects.backdropBlur > 0.0 {
                self.layers.length() - 2
              } else {
                0
              },
              sprite.effects,
              move area,
            )
            slot.* = slot.* + 1
          }
          i = i + 1
        }
        from = b + 1
      }
      b = b + 1
    }
    if !load || from < batches.length {
      run self.drawRange(
        device,
        &mut encoder,
        &self.layers.asSlice()[targetIndex].view,
        &self.offscreen,
        scene,
        atlas,
        layer,
        from,
        batches.length,
        load,
        clear,
      )
    }
  }

  effect fn filterLayer(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    encoder: &mut CommandEncoder,
    sprite: LayerSprite,
    source: usize,
    width: u32,
    height: u32,
  ) -> usize
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let effects = sprite.effects
    let scratch = self.layers.length() - 3
    let area = areaOf(&sprite, width, height)
    let region = Region.make(area.x, area.y, area.x + area.width, area.y + area.height)
    let images = self.layers.asSlice()
    let filter = &mut self.filters.asMutSlice()[0]
    let mut content = source
    if effects.blur > 0.0 {
      let plan = run BlurPlan.make(f32.toF64(effects.blur))
      run filter.gaussianBlur(
        device,
        queue,
        &mut encoder,
        &images[scratch],
        &images[source],
        &images[scratch + 1],
        &plan,
        &plan,
        region,
      )
      content = scratch
    }
    if effects.hasColor() {
      let output = if content == source {
        scratch
      } else {
        source
      }
      run filter.colorMatrix(
        device,
        queue,
        &mut encoder,
        &images[output],
        &images[content],
        effects.matrix(),
        region,
      )
      content = output
    }
    if effects.backdropBlur > 0.0 {
      let plan = run BlurPlan.make(f32.toF64(effects.backdropBlur))
      run filter.gaussianBlur(
        device,
        queue,
        &mut encoder,
        &images[scratch + 1],
        &images[0],
        &images[scratch + 2],
        &plan,
        &plan,
        Region.make(0, 0, width, height),
      )
    }
    return content
  }

  /// A full-target pass of `shaders/layer.wgsl` through `pipeline` onto `output`, limited to
  /// `area`, reading layer texture `content` (and the backdrop copy).
  effect fn pass(
    self: &Self,
    device: &Device,
    queue: &Queue,
    encoder: &mut CommandEncoder,
    pipeline: &RenderPipeline,
    output: &TextureView,
    slot: usize,
    op: u32,
    mode: u32,
    opacity: u32,
    content: usize,
    backdropContent: usize,
    effects: LayerEffects,
    area: Area,
  ) -> ()
    ! GpuError {
    let mut header: [u8; 48] = [0; 48]
    writeU32(&mut header, 0, op)
    writeU32(&mut header, 4, mode)
    writeU32(&mut header, 8, opacity)
    writeU32(
      &mut header,
      12,
      if effects.backdropBlur > 0.0 {
        1
      } else {
        0
      },
    )
    writeU32(&mut header, 16, f32.toBits(effects.clip.xMin))
    writeU32(&mut header, 20, f32.toBits(effects.clip.yMin))
    writeU32(&mut header, 24, f32.toBits(effects.clip.xMax))
    writeU32(&mut header, 28, f32.toBits(effects.clip.yMax))
    writeU32(&mut header, 32, f32.toBits(effects.radius))
    writeU32(&mut header, 36, effects.shape)
    let params = &self.params.asSlice()[slot]
    queue.writeBuffer(params, 0, &header)
    let list = self.layers.asSlice()
    let layout = run pipeline.getBindGroupLayout(0)
    let entries = [
      entry(0, params),
      textureEntry(1, &list[0].view),
      textureEntry(2, &list[content].view),
      textureEntry(3, &list[backdropContent].view),
    ]
    let group = run gpu.createBindGroup(
      device,
      &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
    )
    let mut color = RenderPassColorAttachment.default().withView(output)
    color.setLoadOp(flags.WGPULoadOp_Load)
    color.setStoreOp(flags.WGPUStoreOp_Store)
    let colors = [color]
    let mut pass = run encoder.beginRenderPass(
      &RenderPassDescriptor.default().withColorAttachments(&colors),
    )
    pass.setPipeline(pipeline)
    pass.setBindGroup(0, &group, &[])
    pass.setScissorRect(area.x, area.y, area.width, area.height)
    pass.draw(3, 1, 0, 0)
    pass.end()
  }

  /// One pass on `view` (cleared to `clear` unless `load`) drawing batches `from .. to` of `layer`,
  /// none of which may be an isolated layer.
  effect fn drawRange(
    self: &Self,
    device: &Device,
    encoder: &mut CommandEncoder,
    view: &TextureView,
    pipelines: &Pipelines,
    scene: &Scene,
    atlas: &GpuAtlas,
    layer: u32,
    from: usize,
    to: usize,
    load: bool,
    clear: ClearColor,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let mut color = RenderPassColorAttachment.default().withView(view)
    color.setClearValue(clear)
    color.setLoadOp(
      if load {
        flags.WGPULoadOp_Load
      } else {
        flags.WGPULoadOp_Clear
      },
    )
    color.setStoreOp(flags.WGPUStoreOp_Store)
    let colors = [color]
    let mut pass = run encoder.beginRenderPass(
      &RenderPassDescriptor.default().withColorAttachments(&colors),
    )
    let b = self.buffers.asSlice()
    let batches = scene.batches(layer)
    let mut imageGroups = List<BindGroup>.make()
    let mut imageTextures = List<u32>.make()
    let mut lastKind: u32 = 255
    let mut i = from
    while i < to {
      let batch = batches[i]
      let kind = batch.kind.index()
      let base = self.instances.base(layer, kind)
      let first = base + batch.start
      let count = batch.end - batch.start
      match batch.kind {
        PrimitiveKind.Shadow => {
          let layout = run pipelines.shadow.getBindGroupLayout(0)
          let entries = [entry(0, &b[GLOBALS]), entry(1, &b[SHADOWS])]
          let group = run gpu.createBindGroup(
            device,
            &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
          )
          pass.setPipeline(&pipelines.shadow)
          lastKind = kind
          pass.setBindGroup(0, &group, &[])
          pass.draw(6, count, 0, first)
        }
        PrimitiveKind.Quad => {
          let layout = run pipelines.quad.getBindGroupLayout(0)
          let entries = [entry(0, &b[GLOBALS]), entry(1, &b[QUADS]), entry(7, &b[RAMPS])]
          let group = run gpu.createBindGroup(
            device,
            &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
          )
          pass.setPipeline(&pipelines.quad)
          lastKind = kind
          pass.setBindGroup(0, &group, &[])
          pass.draw(6, count, 0, first)
        }
        PrimitiveKind.Underline => {
          let layout = run pipelines.underline.getBindGroupLayout(0)
          let entries = [entry(0, &b[GLOBALS]), entry(1, &b[UNDERLINES])]
          let group = run gpu.createBindGroup(
            device,
            &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
          )
          pass.setPipeline(&pipelines.underline)
          lastKind = kind
          pass.setBindGroup(0, &group, &[])
          pass.draw(6, count, 0, first)
        }
        PrimitiveKind.Glyph => {
          if u32.toUsize(batch.texture) < atlas.textureCount() {
            let layout = run pipelines.mono.getBindGroupLayout(0)
            let entries = [
              entry(0, &b[GLOBALS]),
              entry(1, &b[GLYPHS]),
              textureEntry(2, atlas.view(u32.toUsize(batch.texture))),
            ]
            let group = run gpu.createBindGroup(
              device,
              &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
            )
            pass.setPipeline(&pipelines.mono)
            lastKind = kind
            pass.setBindGroup(0, &group, &[])
            pass.draw(6, count, 0, first)
          }
        }
        PrimitiveKind.Image => {
          if u32.toUsize(batch.texture) < atlas.textureCount() {
            let mut slot: usize = 0
            while slot < imageTextures.length() && imageTextures.get(slot) != batch.texture {
              slot = slot + 1
            }
            if slot == imageTextures.length() {
              let layout = run pipelines.poly.getBindGroupLayout(0)
              let entries = [
                entry(0, &b[GLOBALS]),
                entry(1, &b[IMAGES]),
                textureEntry(2, atlas.view(u32.toUsize(batch.texture))),
              ]
              let group = run gpu.createBindGroup(
                device,
                &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
              )
              run imageGroups.append(move group)
              run imageTextures.append(batch.texture)
            }
            if lastKind != kind {
              pass.setPipeline(&pipelines.poly)
              lastKind = kind
            }
            pass.setBindGroup(0, &imageGroups.asSlice()[slot], &[])
            pass.draw(6, count, 0, first)
          }
        }
        PrimitiveKind.Path => {
          let range = self.instances.runRange(first, first + count)
          if range[1] > range[0] {
            let layout = run pipelines.path.getBindGroupLayout(0)
            let entries = [
              entry(0, &b[GLOBALS]),
              entry(1, &b[RUNS]),
              entry(2, &b[PATHS]),
              entry(3, &b[ALPHAS]),
              entry(7, &b[RAMPS]),
            ]
            let group = run gpu.createBindGroup(
              device,
              &BindGroupDescriptor.default().withLayout(&layout).withEntries(&entries),
            )
            pass.setPipeline(&pipelines.path)
            lastKind = kind
            pass.setBindGroup(0, &group, &[])
            pass.draw(6, range[1] - range[0], 0, range[0])
          }
        }
        PrimitiveKind.Layer => {}
      }
      i = i + 1
    }
    pass.end()
  }
}

fn u8ToU32(value: u8) -> u32 {
  return u8.toU32(value)
}

effect fn clearPass(encoder: &mut CommandEncoder, view: &TextureView, clear: ClearColor) -> ()
  ! GpuError {
  let mut color = RenderPassColorAttachment.default().withView(view)
  color.setClearValue(clear)
  color.setLoadOp(flags.WGPULoadOp_Clear)
  color.setStoreOp(flags.WGPUStoreOp_Store)
  let colors = [color]
  let pass = run encoder.beginRenderPass(
    &RenderPassDescriptor.default().withColorAttachments(&colors),
  )
  pass.end()
}

/// Uploads `bytes`, padded to at least one `element` so the binding is never smaller than one
/// instance.
effect fn uploadList(
  device: &Device,
  queue: &Queue,
  slots: &mut List<Buffer>,
  index: usize,
  label: &[u8],
  bytes: &mut List<u8>,
  element: usize,
  usage: u64,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let length = bytes.length()
  if length < element {
    run bytes.appendRepeated(0, element - length)
  }
  run upload(device, queue, &mut slots, index, label, bytes.asSlice(), usage)
}
