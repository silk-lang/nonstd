// Generated by scripts/embed-shaders from graphics/ui_renderer/shaders; do not edit.
pub fn quad() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Quads: a rounded rectangle filled with a paint, and a solid or dashed border band over it.\nstruct Quad {\n  bounds: vec4f,\n  mask: vec4f,\n  // top-left, top-right, bottom-right, bottom-left\n  radii: vec4f,\n  // top, right, bottom, left\n  borders: vec4f,\n  // straight alpha; `paint.kind.z` is 1 for a dashed border\n  borderColor: vec4f,\n  paint: Paint,\n}\n@group(0) @binding(1) var<storage, read> quads: array<Quad>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let q = quads[index];\n  return Varying(corner(cover(q.bounds, q.mask), v), index);\n}\n\nconst PI: f32 = 3.141592653589793;\n\nfn clampedRadii(r: vec4f, radii: vec4f) -> vec4f {\n  let limit = max(min(r.z - r.x, r.w - r.y) * 0.5, 0.0);\n  return clamp(radii, vec4f(0.0), vec4f(limit));\n}\n\n// A quarter of an ellipse's perimeter (Ramanujan).\nfn quarterArc(e: vec2f) -> f32 {\n  if e.x <= 0.0 || e.y <= 0.0 { return 0.0; }\n  return PI * 0.25 * (3.0 * (e.x + e.y) - sqrt((3.0 * e.x + e.y) * (e.x + 3.0 * e.y)));\n}\n\n// Where along the outline of `r` (corner radii `tl`, `tr`, `br`, `bl` as x, y pairs) the point\n// nearest to `p` lies, measured from the bottom of the top-left corner, clockwise.\nfn perimeterPosition(p: vec2f, r: vec4f, tl: vec2f, tr: vec2f, br: vec2f, bl: vec2f) -> f32 {\n  let arcs = vec4f(quarterArc(tl), quarterArc(tr), quarterArc(br), quarterArc(bl));\n  let top = max(r.z - tr.x - (r.x + tl.x), 0.0);\n  let right = max(r.w - br.y - (r.y + tr.y), 0.0);\n  let bottom = max(r.z - br.x - (r.x + bl.x), 0.0);\n  let start1 = arcs.x;\n  let start2 = start1 + top;\n  let start3 = start2 + arcs.y;\n  let start4 = start3 + right;\n  let start5 = start4 + arcs.z;\n  let start6 = start5 + bottom;\n  let start7 = start6 + arcs.w;\n\n  // Corner zones, by the arc's angle (y down: angles grow clockwise).\n  if p.x < r.x + tl.x && p.y < r.y + tl.y && arcs.x > 0.0 {\n    let d = (p - (r.xy + tl)) / tl;\n    let a = atan2(d.y, d.x) + 2.0 * PI;\n    return clamp((a - PI) / (0.5 * PI), 0.0, 1.0) * arcs.x;\n  }\n  if p.x > r.z - tr.x && p.y < r.y + tr.y && arcs.y > 0.0 {\n    let d = (p - vec2f(r.z - tr.x, r.y + tr.y)) / tr;\n    let a = atan2(d.y, d.x) + 2.0 * PI;\n    return start2 + clamp((a - 1.5 * PI) / (0.5 * PI), 0.0, 1.0) * arcs.y;\n  }\n  if p.x > r.z - br.x && p.y > r.w - br.y && arcs.z > 0.0 {\n    let d = (p - (r.zw - br)) / br;\n    let a = atan2(d.y, d.x);\n    return start4 + clamp(a / (0.5 * PI), 0.0, 1.0) * arcs.z;\n  }\n  if p.x < r.x + bl.x && p.y > r.w - bl.y && arcs.w > 0.0 {\n    let d = (p - vec2f(r.x + bl.x, r.w - bl.y)) / bl;\n    let a = atan2(d.y, d.x);\n    return start6 + clamp((a - 0.5 * PI) / (0.5 * PI), 0.0, 1.0) * arcs.w;\n  }\n\n  // Otherwise the nearest straight side.\n  let distances = vec4f(abs(p.y - r.y), abs(p.x - r.z), abs(p.y - r.w), abs(p.x - r.x));\n  let nearest = min(min(distances.x, distances.y), min(distances.z, distances.w));\n  if nearest == distances.x { return start1 + clamp(p.x - (r.x + tl.x), 0.0, top); }\n  if nearest == distances.y { return start3 + clamp(p.y - (r.y + tr.y), 0.0, right); }\n  if nearest == distances.z { return start5 + clamp(r.z - br.x - p.x, 0.0, bottom); }\n  let left = max(r.w - bl.y - (r.y + tl.y), 0.0);\n  return start7 + clamp(r.w - bl.y - p.y, 0.0, left);\n}\n\n// Coverage of dashes `2 w` long with gaps `w`, starting on at position 0.\nfn dashCoverage(s: f32, w: f32) -> f32 {\n  let period = 3.0 * w;\n  let m = s - period * floor(s / period);\n  if m < 2.0 * w {\n    return clamp(0.5 + min(m, 2.0 * w - m), 0.0, 1.0);\n  }\n  return clamp(0.5 - min(m - 2.0 * w, period - m), 0.0, 1.0);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let q = quads[v.index];\n  let p = v.position.xy;\n  let clip = areaIn(q.mask, p);\n  if clip <= 0.0 { discard; }\n  let radii = clampedRadii(q.bounds, q.radii);\n  let outer = coverage(roundedRectSdf(p, q.bounds, radii));\n  let background = shade(q.paint, p) * outer;\n\n  var border = vec4f(0.0);\n  let w = q.borders;\n  if q.borderColor.a > 0.0 && max(max(w.x, w.y), max(w.z, w.w)) > 0.0 {\n    // The band between the outline and the inner outline inset by the widths, whose corners are\n    // elliptical with radii (r - left or right, r - top or bottom).\n    let inner = vec4f(q.bounds.x + w.w, q.bounds.y + w.x, q.bounds.z - w.y, q.bounds.w - w.z);\n    var inside = 0.0;\n    if inner.x < inner.z && inner.y < inner.w {\n      let c = p - (inner.xy + inner.zw) * 0.5;\n      var e = vec2f(radii.x - w.w, radii.x - w.x);\n      if c.x >= 0.0 && c.y < 0.0 { e = vec2f(radii.y - w.y, radii.y - w.x); }\n      if c.x >= 0.0 && c.y >= 0.0 { e = vec2f(radii.z - w.y, radii.z - w.z); }\n      if c.x < 0.0 && c.y >= 0.0 { e = vec2f(radii.w - w.w, radii.w - w.z); }\n      inside = coverage(ellipticRectSdf(p, inner, max(e, vec2f(0.0))));\n    }\n    var band = max(outer - inside, 0.0);\n    if q.paint.kind.z == 1u && band > 0.0 {\n      // Dashes along the band's center line, as long as twice the widest edge.\n      let widest = max(max(w.x, w.y), max(w.z, w.w));\n      let mid = vec4f(q.bounds.x + w.w * 0.5, q.bounds.y + w.x * 0.5, q.bounds.z - w.y * 0.5, q.bounds.w - w.z * 0.5);\n      let tl = max(vec2f(radii.x - w.w * 0.5, radii.x - w.x * 0.5), vec2f(0.0));\n      let tr = max(vec2f(radii.y - w.y * 0.5, radii.y - w.x * 0.5), vec2f(0.0));\n      let br = max(vec2f(radii.z - w.y * 0.5, radii.z - w.z * 0.5), vec2f(0.0));\n      let bl = max(vec2f(radii.w - w.w * 0.5, radii.w - w.z * 0.5), vec2f(0.0));\n      band = band * dashCoverage(perimeterPosition(p, mid, tl, tr, br, bl), widest);\n    }\n    border = premultiply(q.borderColor) * band;\n  }\n  let b = border * clip;\n  let g = background * clip;\n  return b + g * (1.0 - b.a);\n}\n" }
pub fn shadow() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Shadows: a rounded rectangle blurred by a Gaussian, evaluated in closed form along x with an\n// erf approximation and integrated numerically along y (Evan Wallace's method, as GPUI does).\nstruct Shadow {\n  // The blurred shape: the box moved by the offset and grown (or, inset, shrunk) by the spread.\n  shape: vec4f,\n  mask: vec4f,\n  shapeRadii: vec4f,\n  // straight alpha\n  color: vec4f,\n  // The box casting the shadow; an inset shadow draws only inside it.\n  box: vec4f,\n  boxRadii: vec4f,\n  // Everything the shadow can touch.\n  reach: vec4f,\n  // sigma, inset (1 or 0)\n  params: vec4f,\n}\n@group(0) @binding(1) var<storage, read> shadows: array<Shadow>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = shadows[index];\n  return Varying(corner(cover(s.reach, s.mask), v), index);\n}\n\nconst SQRT_HALF: f32 = 0.7071067811865476;\nconst SQRT_TAU: f32 = 2.5066282746310002;\nconst SAMPLES: i32 = 8;\n\nfn gaussian(x: f32, sigma: f32) -> f32 {\n  return exp(-(x * x) / (2.0 * sigma * sigma)) / (SQRT_TAU * sigma);\n}\n\n// Abramowitz and Stegun 7.1.27, |error| < 5e-4.\nfn erf2(v: vec2f) -> vec2f {\n  let s = sign(v);\n  let a = abs(v);\n  let r1 = 1.0 + (0.278393 + (0.230389 + (0.000972 + 0.078108 * a) * a) * a) * a;\n  let r2 = r1 * r1;\n  return s - s / (r2 * r2);\n}\n\n// The blurred coverage of one row `y` (from the center) of the rounded box, at `x`.\nfn blurAlongX(x: f32, y: f32, sigma: f32, radius: f32, half: vec2f) -> f32 {\n  let delta = min(half.y - radius - abs(y), 0.0);\n  let curved = half.x - radius + sqrt(max(0.0, radius * radius - delta * delta));\n  let integral = 0.5 + 0.5 * erf2((x + vec2f(-curved, curved)) * (SQRT_HALF / sigma));\n  return integral.y - integral.x;\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = shadows[v.index];\n  let p = v.position.xy;\n  let clip = areaIn(s.mask, p);\n  if clip <= 0.0 { discard; }\n  let sigma = s.params.x;\n  var alpha = 0.0;\n  if s.shape.x < s.shape.z && s.shape.y < s.shape.w {\n    if sigma < 0.05 {\n      alpha = coverage(roundedRectSdf(p, s.shape, s.shapeRadii));\n    } else {\n      let half = (s.shape.zw - s.shape.xy) * 0.5;\n      let q = p - (s.shape.xy + half);\n      let radius = clamp(pickRadius(q, s.shapeRadii), 0.0, min(half.x, half.y));\n      // The kernel is only non-zero over the shape's rows within 3 sigma.\n      let start = clamp(-3.0 * sigma, q.y - half.y, q.y + half.y);\n      let end = clamp(3.0 * sigma, q.y - half.y, q.y + half.y);\n      let step = (end - start) / f32(SAMPLES);\n      var y = start + step * 0.5;\n      for (var i = 0; i < SAMPLES; i += 1) {\n        alpha += blurAlongX(q.x, q.y - y, sigma, radius, half) * gaussian(y, sigma) * step;\n        y += step;\n      }\n    }\n  }\n  if s.params.y != 0.0 {\n    alpha = (1.0 - alpha) * coverage(roundedRectSdf(p, s.box, s.boxRadii));\n  }\n  return premultiply(s.color) * (clamp(alpha, 0.0, 1.0) * clip);\n}\n" }
pub fn underline() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Underlines: the top `thickness` rows of the bounds, or a sine wave of that stroke width with\n// wavelength 8 * thickness, centered in the bounds.\nstruct Underline {\n  bounds: vec4f,\n  mask: vec4f,\n  // straight alpha\n  color: vec4f,\n  // thickness, wavy (1 or 0)\n  params: vec4f,\n}\n@group(0) @binding(1) var<storage, read> underlines: array<Underline>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let u = underlines[index];\n  return Varying(corner(cover(u.bounds, u.mask), v), index);\n}\n\nconst TAU: f32 = 6.283185307179586;\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let u = underlines[v.index];\n  let p = v.position.xy;\n  let b = u.bounds;\n  let thickness = u.params.x;\n  var alpha = 0.0;\n  if u.params.y == 0.0 {\n    alpha = areaIn(vec4f(b.x, b.y, b.z, min(b.y + thickness, b.w)), p) * areaIn(u.mask, p);\n  } else {\n    // Distance to the wave, to first order: the vertical gap over the slope's length.\n    let amplitude = max((b.w - b.y - thickness) * 0.5, 0.0);\n    let k = TAU / (8.0 * thickness);\n    let x = p.x - b.x;\n    let gap = p.y - (b.y + b.w) * 0.5 - amplitude * sin(k * x);\n    let slope = amplitude * k * cos(k * x);\n    let distance = abs(gap) / sqrt(1.0 + slope * slope);\n    let clipped = vec4f(max(u.mask.xy, b.xy), min(u.mask.zw, b.zw));\n    alpha = clamp(thickness * 0.5 - distance + 0.5, 0.0, 1.0) * areaIn(clipped, p);\n  }\n  if alpha <= 0.0 { discard; }\n  return premultiply(u.color) * alpha;\n}\n" }
pub fn mono() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Sprite sampling shared by mono.wgsl and poly.wgsl: bilinear at pixel centers, clamped to the\n// tile, read with textureLoad so no texel outside the tile is touched.\n@group(0) @binding(2) var atlas: texture_2d<f32>;\n\n// Tile `tile` (texel rectangle xMin, yMin, xMax, yMax) stretched over `bounds`, at pixel center `p`.\nfn sampleTile(tile: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let f = clamp(uv - 0.5, vec2f(0.0), size - 1.0);\n  let i0 = floor(f);\n  let w = f - i0;\n  let i1 = min(i0 + 1.0, size - 1.0);\n  let a = textureLoad(atlas, vec2u(tile.xy + i0), 0);\n  let b = textureLoad(atlas, vec2u(tile.xy + vec2f(i1.x, i0.y)), 0);\n  let c = textureLoad(atlas, vec2u(tile.xy + vec2f(i0.x, i1.y)), 0);\n  let d = textureLoad(atlas, vec2u(tile.xy + i1), 0);\n  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n}\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n// Monochrome sprites: glyphs and icons, a coverage tile tinted with one color, with the\n// DirectWrite contrast and gamma correction for text (from Windows Terminal's dwrite.hlsl, MIT,\n// as GPUI uses it).\nstruct MonoSprite {\n  bounds: vec4f,\n  mask: vec4f,\n  // straight alpha\n  color: vec4f,\n  tile: vec4f,\n}\n@group(0) @binding(1) var<storage, read> sprites: array<MonoSprite>;\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = sprites[index];\n  return Varying(corner(cover(s.bounds, s.mask), v), index);\n}\n\nfn brightness(color: vec3f) -> f32 {\n  return dot(color, vec3f(0.30, 0.59, 0.11));\n}\n\n// The correction of glyph coverage `alpha` for text of `color`.\nfn correctText(alpha: f32, color: vec3f) -> f32 {\n  let b = brightness(color);\n  let k = globals.contrast * clamp(4.0 * (0.75 - b), 0.0, 1.0);\n  let a = alpha * (k + 1.0) / (alpha * k + 1.0);\n  let g = globals.gamma;\n  let correction = (g.x * b + g.y) * a + (g.z * b + g.w);\n  return a + a * (1.0 - a) * correction;\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = sprites[v.index];\n  let p = v.position.xy;\n  let clipped = vec4f(max(s.mask.xy, s.bounds.xy), min(s.mask.zw, s.bounds.zw));\n  let clip = areaIn(clipped, p);\n  if clip <= 0.0 { discard; }\n  let sample = sampleTile(s.tile, s.bounds, p).r;\n  let alpha = clamp(correctText(sample, clamp(s.color.rgb, vec3f(0.0), vec3f(1.0))), 0.0, 1.0);\n  return premultiply(s.color) * (alpha * clip);\n}\n" }
pub fn poly() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Sprite sampling shared by mono.wgsl and poly.wgsl: bilinear at pixel centers, clamped to the\n// tile, read with textureLoad so no texel outside the tile is touched.\n@group(0) @binding(2) var atlas: texture_2d<f32>;\n\n// Tile `tile` (texel rectangle xMin, yMin, xMax, yMax) stretched over `bounds`, at pixel center `p`.\nfn sampleTile(tile: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let f = clamp(uv - 0.5, vec2f(0.0), size - 1.0);\n  let i0 = floor(f);\n  let w = f - i0;\n  let i1 = min(i0 + 1.0, size - 1.0);\n  let a = textureLoad(atlas, vec2u(tile.xy + i0), 0);\n  let b = textureLoad(atlas, vec2u(tile.xy + vec2f(i1.x, i0.y)), 0);\n  let c = textureLoad(atlas, vec2u(tile.xy + vec2f(i0.x, i1.y)), 0);\n  let d = textureLoad(atlas, vec2u(tile.xy + i1), 0);\n  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n}\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n// Polychrome sprites: images, color glyphs and color icons from premultiplied RGBA tiles, with\n// opacity, corner radii and grayscale.\nstruct PolySprite {\n  bounds: vec4f,\n  mask: vec4f,\n  tile: vec4f,\n  clipBounds: vec4f,\n  radii: vec4f,\n  // opacity, grayscale (1 or 0)\n  params: vec4f,\n}\n@group(0) @binding(1) var<storage, read> sprites: array<PolySprite>;\n\nfn cameraSprite(source: PolySprite) -> PolySprite {\n  var s = source;\n  let camera = globals.imageCamera;\n  let translation = vec4f(camera.zw, camera.zw);\n  s.bounds = source.bounds * camera.x + translation;\n  s.mask = source.mask * camera.x + translation;\n  s.clipBounds = source.clipBounds * camera.x + translation;\n  s.radii = source.radii * camera.x;\n  return s;\n}\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = cameraSprite(sprites[index]);\n  return Varying(corner(cover(s.bounds, s.mask), v), index);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = cameraSprite(sprites[v.index]);\n  let p = v.position.xy;\n  let radii = clamp(s.radii, vec4f(0.0), vec4f(max(min(s.clipBounds.z - s.clipBounds.x, s.clipBounds.w - s.clipBounds.y) * 0.5, 0.0)));\n  let weight = coverage(roundedRectSdf(p, s.clipBounds, radii)) * clamp(s.params.x, 0.0, 1.0) * areaIn(s.mask, p);\n  if weight <= 0.0 { discard; }\n  var uv = (p - s.bounds.xy) / (s.bounds.zw - s.bounds.xy);\n  let turn = u32(s.params.z);\n  if turn == 1u { uv = vec2f(uv.y, 1.0 - uv.x); }\n  if turn == 2u { uv = vec2f(1.0) - uv; }\n  if turn == 3u { uv = vec2f(1.0 - uv.y, uv.x); }\n  var c = sampleTile(s.tile, s.bounds, s.bounds.xy + uv * (s.bounds.zw - s.bounds.xy));\n  if s.params.y != 0.0 {\n    let l = dot(c.rgb, vec3f(0.2126, 0.7152, 0.0722));\n    c = vec4f(l, l, l, c.a);\n  }\n  return c * weight;\n}\n" }
pub fn path() -> &'static [u8] { return b"// Shared by every UI pipeline (scripts/embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c);\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), vec2f(0.0), globals.size);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), vec2f(0.0), globals.size);\n  return vec4f(lo, max(hi, lo));\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The radius of the corner of quadrant `q` (from the center): top-left, top-right, bottom-right,\n// bottom-left in `radii`.\nfn pickRadius(q: vec2f, radii: vec4f) -> f32 {\n  if q.x < 0.0 {\n    return select(radii.w, radii.x, q.y < 0.0);\n  }\n  return select(radii.z, radii.y, q.y < 0.0);\n}\n\n// Signed distance from `p` to rectangle `r` with circular corners `radii`, each clamped to half\n// the shorter side; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: vec4f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let center = r.xy + half;\n  let q = p - center;\n  let limit = max(min(half.x, half.y), 0.0);\n  let radius = clamp(pickRadius(q, radii), 0.0, limit);\n  let d = abs(q) - half + radius;\n  return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - radius;\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e` (an approximation off the ellipse, exact for circles).\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = abs(p - (r.xy + half));\n  let d = q - (half - e);\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    let k0 = length(d / e);\n    let k1 = length(d / (e * e));\n    return k0 * (k0 - 1.0) / k1;\n  }\n  let b = q - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a two-stop CSS linear gradient. `kind.x` is 0 for solid, 1 for a\n// gradient mixed here in sRGB, 2 for a gradient read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color). `first` and `last` hold the stops, straight\n// sRGB (`first` is the solid color). `line` is the gradient's center and direction, `stops` its half\n// length and the two stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let along = dot(p - paint.line.xy, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  t = step / 255.0;\n  let a = clamp(paint.first.a, 0.0, 1.0);\n  let b = clamp(paint.last.a, 0.0, 1.0);\n  let alpha = a + (b - a) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  var c = (paint.first.rgb * a + (paint.last.rgb * b - paint.first.rgb * a) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n// Paths: `vector` coverage strips (4-row bands with one coverage byte per row, packed into a\n// word per column) and fully covered runs, placed at the path's integer origin. The band layout\n// is gpu_scene's, except that bands start at the sprite's own y and every run has a paint record.\nstruct Run {\n  x: i32,\n  y: i32,\n  width: u32,\n  // Word index of the first column in `alphas`, or SOLID for a fully covered run.\n  alpha: u32,\n  path: u32,\n  // The last row + 1 the path covers.\n  bottom: i32,\n  unused0: u32,\n  unused1: u32,\n}\nstruct PathRecord {\n  mask: vec4f,\n  paint: Paint,\n}\n@group(0) @binding(1) var<storage, read> runs: array<Run>;\n@group(0) @binding(2) var<storage, read> paths: array<PathRecord>;\n@group(0) @binding(3) var<storage, read> alphas: array<u32>;\n\nconst SOLID: u32 = 0xffffffffu;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let r = runs[index];\n  let top = f32(r.y);\n  let x = f32(r.x);\n  let bounds = vec4f(x, top, x + f32(r.width), f32(min(r.y + 4, r.bottom)));\n  return Varying(corner(cover(bounds, paths[r.path].mask), v), index);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let r = runs[v.index];\n  let path = paths[r.path];\n  let p = v.position.xy;\n  let clip = areaIn(path.mask, p);\n  if clip <= 0.0 { discard; }\n  var alpha = 1.0;\n  if r.alpha != SOLID {\n    let column = u32(i32(floor(p.x)) - r.x);\n    let row = u32(i32(floor(p.y)) - r.y);\n    alpha = f32((alphas[r.alpha + column] >> (8u * row)) & 255u) / 255.0;\n  }\n  return shade(path.paint, p) * (alpha * clip);\n}\n" }
pub fn layer() -> &'static [u8] { return b"// Blend-mode math shared by compose.wgsl and filter.wgsl (scripts/embed-shaders prepends it),\n// matching vector.layer on premultiplied bytes.\n\nconst NORMAL: u32 = 0u;\nconst MULTIPLY: u32 = 1u;\nconst SCREEN: u32 = 2u;\nconst OVERLAY: u32 = 3u;\nconst DARKEN: u32 = 4u;\nconst LIGHTEN: u32 = 5u;\nconst COLOR_DODGE: u32 = 6u;\nconst COLOR_BURN: u32 = 7u;\nconst HARD_LIGHT: u32 = 8u;\nconst SOFT_LIGHT: u32 = 9u;\nconst DIFFERENCE: u32 = 10u;\nconst EXCLUSION: u32 = 11u;\nconst HUE: u32 = 12u;\nconst SATURATION: u32 = 13u;\nconst COLOR: u32 = 14u;\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn bytes(t: texture_2d<f32>, pixel: vec2u) -> vec4u {\n  return vec4u(round(textureLoad(t, pixel, 0) * 255.0));\n}\n\nfn toByte(v: f32) -> u32 { return u32(floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5)); }\n\nfn hardLight(cb: f32, cs: f32) -> f32 {\n  if cs <= 0.5 { return cb * 2.0 * cs; }\n  let s = 2.0 * cs - 1.0;\n  return cb + s - cb * s;\n}\n\nfn separable(cb: f32, cs: f32, mode: u32) -> f32 {\n  switch mode {\n    case MULTIPLY: { return cb * cs; }\n    case SCREEN: { return cb + cs - cb * cs; }\n    case OVERLAY: { return hardLight(cs, cb); }\n    case DARKEN: { return min(cb, cs); }\n    case LIGHTEN: { return max(cb, cs); }\n    case COLOR_DODGE: {\n      if cb == 0.0 { return 0.0; }\n      if cs >= 1.0 { return 1.0; }\n      return min(1.0, cb / (1.0 - cs));\n    }\n    case COLOR_BURN: {\n      if cb >= 1.0 { return 1.0; }\n      if cs <= 0.0 { return 0.0; }\n      return 1.0 - min(1.0, (1.0 - cb) / cs);\n    }\n    case HARD_LIGHT: { return hardLight(cb, cs); }\n    case SOFT_LIGHT: {\n      if cs <= 0.5 { return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb); }\n      var d = sqrt(cb);\n      if cb <= 0.25 { d = ((16.0 * cb - 12.0) * cb + 4.0) * cb; }\n      return cb + (2.0 * cs - 1.0) * (d - cb);\n    }\n    case DIFFERENCE: { return abs(cb - cs); }\n    case EXCLUSION: { return cb + cs - 2.0 * cb * cs; }\n    default: { return cs; }\n  }\n}\n\nfn lum(c: vec3f) -> f32 { return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z; }\n\nfn clipColor(c: vec3f) -> vec3f {\n  let l = lum(c);\n  let n = min(c.x, min(c.y, c.z));\n  let x = max(c.x, max(c.y, c.z));\n  var r = c;\n  if n < 0.0 { r = l + (r - l) * l / (l - n); }\n  if x > 1.0 { r = l + (r - l) * (1.0 - l) / (x - l); }\n  return r;\n}\n\nfn setLum(c: vec3f, l: f32) -> vec3f { return clipColor(c + (l - lum(c))); }\n\nfn sat(c: vec3f) -> f32 { return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z)); }\n\nfn setSat(c: vec3f, s: f32) -> vec3f {\n  let mx = max(c.x, max(c.y, c.z));\n  let mn = min(c.x, min(c.y, c.z));\n  if mx <= mn { return vec3f(0.0); }\n  return (c - mn) * s / (mx - mn);\n}\n\n// co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs), ao = as + ab (1 - as), on premultiplied bytes.\nfn blend(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL {\n    let inverse = 255u - s.w;\n    return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n  }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  if sa == 0.0 { return b; }\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let k = sa * ba;\n  let o = sc * (1.0 - ba) + bc * (1.0 - sa) + k * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), toByte(sa + ba * (1.0 - sa)));\n}\n\n// Blending without compositing (feBlend no-composite): `s` mixed with B(Cb, Cs), keeping\n// its alpha; vector.layer mixPixel.\nfn mixed(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL || s.w == 0u { return s; }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let o = sc * (1.0 - ba) + sa * ba * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), s.w);\n}\n// Isolated layers: composite a layer onto a copy of what is under it with a vector.layer blend\n// mode and a group opacity (prepended with gpu_scene's blend.wgsl), and copy a finished frame out\n// to a target of any format.\nstruct Params { op: u32, mode: u32, opacity: u32, backdropEnabled: u32, clip: vec4f, radius: f32, shape: u32, unused: vec2u }\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var backdrop: texture_2d<f32>;\n@group(0) @binding(2) var layer: texture_2d<f32>;\n@group(0) @binding(3) var filteredBackdrop: texture_2d<f32>;\n\nconst OP_COMPOSITE: u32 = 0u;\nconst OP_COPY: u32 = 1u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let pixel = vec2u(position.xy);\n  let content = bytes(layer, pixel);\n  if params.op == OP_COPY { return vec4f(content) / 255.0; }\n  var b = bytes(backdrop, pixel);\n  if params.backdropEnabled != 0u {\n    let halfSize = (params.clip.zw - params.clip.xy) * 0.5;\n    let p = position.xy - (params.clip.xy + halfSize);\n    let radius = min(params.radius, min(halfSize.x, halfSize.y));\n    let q = abs(p) - halfSize + radius;\n    var distance = length(max(q, vec2f(0.0))) + min(max(q.x, q.y), 0.0) - radius;\n    if params.shape == 1u {\n      let normalized = p / max(halfSize, vec2f(0.001));\n      distance = (length(normalized) - 1.0) * min(halfSize.x, halfSize.y);\n    }\n    let coverage = clamp(0.5 - distance, 0.0, 1.0) * f32(params.opacity) / 255.0;\n    b = vec4u(round(mix(vec4f(b), vec4f(bytes(filteredBackdrop, pixel)), coverage)));\n  }\n  if params.opacity == 0u || content.w == 0u { return vec4f(b) / 255.0; }\n  var s = content;\n  if params.opacity != 255u {\n    s = vec4u(div255(s.x * params.opacity), div255(s.y * params.opacity), div255(s.z * params.opacity), div255(s.w * params.opacity));\n  }\n  return vec4f(blend(b, s, params.mode)) / 255.0;\n}\n" }
