//! GPU textures for a `graphics/atlas` [`Atlas`]: the GPU counterpart of `ui_scene.cpu.AtlasPixels`.
//!
//! Call [`GpuAtlas.sync`] after allocating tiles, so every atlas texture has a GPU texture, then
//! [`GpuAtlas.write`] each new tile's pixels: one coverage byte per pixel for monochrome tiles
//! (R8Unorm), four bytes per pixel for subpixel and polychrome tiles (RGBA8Unorm, premultiplied).
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import atlas.atlas { Atlas, AtlasTile, Kind, TextureInfo }
import webgpu.resources as gpu
import webgpu.resources { Queue, Texture, TextureView }
import webgpu.runtime { Device, GpuError }
import webgpu.descriptors {
  Origin3D,
  TexelCopyBufferLayout,
  TexelCopyTextureInfo,
  TextureDescriptor,
  TextureViewDescriptor,
}
import webgpu_sys.generated_webgpu as flags
import gpu_scene.renderer { extent }

struct AtlasTexture {
  texture: Texture,
  view: TextureView,
  bytesPerPixel: u32,
}

/// The GPU textures of one atlas, indexed like `AtlasTile.texture.index`.
pub struct GpuAtlas {
  textures: List<AtlasTexture>,
}

impl GpuAtlas {
  pub fn make() -> GpuAtlas {
    return GpuAtlas { textures: List<AtlasTexture>.make() }
  }

  /// The number of textures created so far.
  pub fn textureCount(self: &Self) -> usize {
    return self.textures.length()
  }

  /// Creates a zeroed texture for every texture `atlas` has added since the last call.
  pub effect fn sync(self: &mut Self, device: &Device, atlas: &Atlas) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    while self.textures.length() < atlas.textureCount() {
      let info = atlas.texture(self.textures.length())
      run self.create(device, info)
    }
  }

  /// Like [`GpuAtlas.sync`], from a copy of the atlas's texture list (`Atlas.texture` for each
  /// index), for a renderer on another thread than the atlas.
  pub effect fn syncInfos(self: &mut Self, device: &Device, infos: &[TextureInfo]) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    while self.textures.length() < infos.length {
      let info = infos[self.textures.length()]
      run self.create(device, info)
    }
  }

  effect fn create(self: &mut Self, device: &Device, info: TextureInfo) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    let mono = match info.id.kind {
      Kind.Monochrome => true
      _ => false
    }
    let mut descriptor = TextureDescriptor.default().withLabel(b"ui atlas")
    descriptor.setSize(extent(info.width, info.height))
    descriptor.setFormat(
      if mono {
        flags.WGPUTextureFormat_R8Unorm
      } else {
        flags.WGPUTextureFormat_RGBA8Unorm
      },
    )
    descriptor.setDimension(flags.WGPUTextureDimension_2D)
    descriptor.setMipLevelCount(1)
    descriptor.setSampleCount(1)

    // Browser canvas copies require a renderable destination, even though composition samples it.
    descriptor.setUsage(
      flags.WGPUTextureUsage_TextureBinding | flags.WGPUTextureUsage_CopyDst
        | if mono {
          0
        } else {
          flags.WGPUTextureUsage_RenderAttachment
        },
    )
    let texture = run gpu.createTexture(device, &descriptor)
    let view = run texture.createView(&TextureViewDescriptor.default())
    run self.textures.append(
      AtlasTexture {
        texture: move texture,
        view: move view,
        bytesPerPixel: info.id.kind.bytesPerPixel(),
      },
    )
  }

  /// Uploads `pixels` (tightly packed rows of the tile's size) into `tile`'s place. Does nothing
  /// for a texture [`GpuAtlas.sync`] has not created, or when `pixels` is too short.
  pub fn write(self: &Self, queue: &Queue, tile: AtlasTile, pixels: &[u8]) -> () {
    let index = u32.toUsize(tile.texture.index)
    if index >= self.textures.length() {
      return
    }
    let texture = &self.textures.asSlice()[index]
    let width = tile.bounds.xMax - tile.bounds.xMin
    let height = tile.bounds.yMax - tile.bounds.yMin
    let rowBytes = width * texture.bytesPerPixel
    if width == 0 || height == 0 || pixels.length < u32.toUsize(rowBytes * height) {
      return
    }
    let mut origin = Origin3D.default()
    origin.setX(tile.bounds.xMin)
    origin.setY(tile.bounds.yMin)
    let mut destination = TexelCopyTextureInfo.default().withTexture(&texture.texture)
    destination.setOrigin(origin)
    let mut layout: TexelCopyBufferLayout = TexelCopyBufferLayout.default()
    layout.setBytesPerRow(rowBytes)
    layout.setRowsPerImage(height)
    queue.writeTexture(&destination, pixels, &layout, &extent(width, height))
  }

  /// Borrows the backing texture for external uploads into an allocated tile.
  ///
  /// `index` must be below `textureCount`. Call `sync` before use. The caller writes only
  /// its allocated tile bounds and uses premultiplied pixels for polychrome textures.
  pub fn texture(self: &Self, index: usize) -> &Texture {
    return &self.textures.asSlice()[index].texture
  }

  /// The view of texture `index`, which must be below [`GpuAtlas.textureCount`].
  pub fn view(self: &Self, index: usize) -> &TextureView {
    return &self.textures.asSlice()[index].view
  }
}
