//! Viewport mapping and SVG basic-shape equivalent paths.
import geometry {
  Point,
  Size,
  Rect,
  Transform,
  Path,
  Segment,
  Arc,
  checkedRect,
  isEmptyRect,
  isFiniteSize
}
import numeric { Cursor }
import numeric
import silk.core.option { Option }
import silk.num.f64
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }

pub enum Alignment {
  None,
  XMinYMin,
  XMidYMin,
  XMaxYMin,
  XMinYMid,
  XMidYMid,
  XMaxYMid,
  XMinYMax,
  XMidYMax,
  XMaxYMax,
}

pub struct AspectRatio {
  pub alignment: Alignment,
  pub slice: bool,
  pub defer: bool,
}

impl Copy for AspectRatio {}

impl AspectRatio {
  /// SVG's initial xMidYMid meet value, without the legacy defer marker.
  pub fn make() -> Self {
    return Self { alignment: Alignment.XMidYMid, slice: false, defer: false }
  }
}

pub fn viewBox(data: &[u8]) -> Option<Rect> {
  let mut cursor = Cursor.make(data)
  Cursor.space(&mut cursor)
  let mut args: [f64; 4] = [0.0; 4]
  let mut i: usize = 0
  while i < 4 {
    if i > 0 && !Cursor.requiredSeparator(&mut cursor) {
      return Option<Rect>.None
    }
    let parsed = Cursor.number(&mut cursor)
    match &parsed {
      Option<f64>.Some { value } => {
        args[i] = value
      }
      _ => {
        return Option<Rect>.None
      }
    }
    i = i + 1
  }
  Cursor.space(&mut cursor)
  if cursor.at != data.length {
    return Option<Rect>.None
  }
  return checkedRect(args[0], args[1], args[2], args[3])
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn word<'a>(cursor: &mut Cursor<'a>) -> &'a [u8] {
  Cursor.space(&mut cursor.*)
  let start = cursor.at
  while cursor.at < cursor.data.length && !numeric.whitespace(cursor.data[cursor.at]) {
    cursor.at = cursor.at + 1
  }
  return Slice.view<u8>(cursor.data, start, cursor.at - start)
}

/// Strict shared SVG2 grammar with the additive SVG1.1 defer marker.
/// Invalid attributes may default; invalid fragment components must not.
pub fn aspectRatio(data: &[u8]) -> Option<AspectRatio> {
  let mut cursor = Cursor.make(data)
  let first = word(&mut cursor)
  let defer = equal(first, b"defer")
  let token = if defer {
    word(&mut cursor)
  } else {
    first
  }
  let alignment = if equal(token, b"none") {
    Alignment.None
  } else if equal(token, b"xMinYMin") {
    Alignment.XMinYMin
  } else if equal(token, b"xMidYMin") {
    Alignment.XMidYMin
  } else if equal(token, b"xMaxYMin") {
    Alignment.XMaxYMin
  } else if equal(token, b"xMinYMid") {
    Alignment.XMinYMid
  } else if equal(token, b"xMidYMid") {
    Alignment.XMidYMid
  } else if equal(token, b"xMaxYMid") {
    Alignment.XMaxYMid
  } else if equal(token, b"xMinYMax") {
    Alignment.XMinYMax
  } else if equal(token, b"xMidYMax") {
    Alignment.XMidYMax
  } else if equal(token, b"xMaxYMax") {
    Alignment.XMaxYMax
  } else {
    return Option<AspectRatio>.None
  }
  let mode = word(&mut cursor)
  let slice = equal(mode, b"slice")
  Cursor.space(&mut cursor)
  if (mode.length != 0 && !slice && !equal(mode, b"meet")) || cursor.at != data.length {
    return Option<AspectRatio>.None
  }
  return Option<AspectRatio>.some(AspectRatio { alignment: alignment, slice: slice, defer: defer })
}

/// Parse an attribute and map it, defaulting invalid values to xMidYMid meet.
pub fn viewport(box: Rect, width: f64, height: f64, preserveAspectRatio: &[u8]) -> Option<
  Transform
> {
  let parsed = aspectRatio(preserveAspectRatio)
  let ratio = match &parsed {
    Option<AspectRatio>.Some { value } => value
    _ => AspectRatio.make()
  }
  return viewportWithAspectRatio(box, width, height, ratio)
}

/// Map a parsed value without allocation or parsing; none ignores meetOrSlice.
/// The retained legacy defer marker does not itself alter viewport mapping.
pub fn viewportWithAspectRatio(box: Rect, width: f64, height: f64, ratio: AspectRatio) -> Option<
  Transform
> {
  if isEmptyRect(box) || !f64.isFinite(width) || !f64.isFinite(height) || width < 0.0
    || height < 0.0 {
    return Option<Transform>.None
  }
  let size = Rect.size(box)
  if !isFiniteSize(size) {
    return Option<Transform>.None
  }
  let none = ratio.alignment == Alignment.None
  let x = match &ratio.alignment {
    Alignment.XMinYMin => 0.0
    Alignment.XMinYMid => 0.0
    Alignment.XMinYMax => 0.0
    Alignment.XMaxYMin => 1.0
    Alignment.XMaxYMid => 1.0
    Alignment.XMaxYMax => 1.0
    _ => 0.5
  }
  let y = match &ratio.alignment {
    Alignment.XMinYMin => 0.0
    Alignment.XMidYMin => 0.0
    Alignment.XMaxYMin => 0.0
    Alignment.XMinYMax => 1.0
    Alignment.XMidYMax => 1.0
    Alignment.XMaxYMax => 1.0
    _ => 0.5
  }
  let mut sx = width / size.width
  let mut sy = height / size.height
  if !none {
    let scale = if ratio.slice {
      f64.max(sx, sy)
    } else {
      f64.min(sx, sy)
    }
    sx = scale
    sy = scale
  }
  let tx = -box.xMin * sx
    + if none {
      0.0
    } else {
      (width - size.width * sx) * x
    }
  let ty = -box.yMin * sy
    + if none {
      0.0
    } else {
      (height - size.height * sy) * y
    }
  let result = Transform.new(sx, 0.0, 0.0, sy, tx, ty)
  if !Transform.isFinite(result) {
    return Option<Transform>.None
  }
  return Option<Transform>.some(result)
}

fn arc(rx: f64, ry: f64, x: f64, y: f64) -> Segment {
  return Segment.ArcTo {
    arc: Arc {
      radii: Size.new(rx, ry),
      rotationDegrees: 0.0,
      largeArc: false,
      sweep: true,
      to: Point.new(x, y),
    },
  }
}

effect fn appendAll(path: &mut Path, segments: &[Segment]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Path.reserve(&mut path.*, segments.length)
  let mut i: usize = 0
  while i < segments.length {
    let accepted = run Path.append(&mut path.*, segments[i])
    i = i + 1
  }
}

pub effect fn rectangle(x: f64, y: f64, width: f64, height: f64, rx: f64, ry: f64) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  if !Point.isFinite(Point.new(x, y)) || !isFiniteSize(Size.new(width, height))
    || !isFiniteSize(Size.new(rx, ry))
    || width <= 0.0
    || height <= 0.0
    || rx < 0.0
    || ry < 0.0 {
    return move path
  }
  let right = x + width
  let bottom = y + height
  if !Point.isFinite(Point.new(right, bottom)) {
    return move path
  }
  let radiusX = f64.min(rx, width / 2.0)
  let radiusY = f64.min(ry, height / 2.0)
  if radiusX == 0.0 || radiusY == 0.0 {
    run appendAll(
      &mut path,
      &[
        Segment.MoveTo { to: Point.new(x, y) },
        Segment.LineTo { to: Point.new(right, y) },
        Segment.LineTo { to: Point.new(right, bottom) },
        Segment.LineTo { to: Point.new(x, bottom) },
        Segment.Close,
      ],
    )
  } else {
    run appendAll(
      &mut path,
      &[
        Segment.MoveTo { to: Point.new(x + radiusX, y) },
        Segment.LineTo { to: Point.new(right - radiusX, y) },
        arc(radiusX, radiusY, right, y + radiusY),
        Segment.LineTo { to: Point.new(right, bottom - radiusY) },
        arc(radiusX, radiusY, right - radiusX, bottom),
        Segment.LineTo { to: Point.new(x + radiusX, bottom) },
        arc(radiusX, radiusY, x, bottom - radiusY),
        Segment.LineTo { to: Point.new(x, y + radiusY) },
        arc(radiusX, radiusY, x + radiusX, y),
        Segment.Close,
      ],
    )
  }
  return move path
}

pub effect fn ellipse(cx: f64, cy: f64, rx: f64, ry: f64) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  if !Point.isFinite(Point.new(cx, cy)) || !isFiniteSize(Size.new(rx, ry)) || rx <= 0.0
    || ry <= 0.0 {
    return move path
  }
  if !Point.isFinite(Point.new(cx + rx, cy + ry)) || !Point.isFinite(Point.new(cx - rx, cy - ry)) {
    return move path
  }
  run appendAll(
    &mut path,
    &[
      Segment.MoveTo { to: Point.new(cx + rx, cy) },
      arc(rx, ry, cx, cy + ry),
      arc(rx, ry, cx - rx, cy),
      arc(rx, ry, cx, cy - ry),
      arc(rx, ry, cx + rx, cy),
      Segment.Close,
    ],
  )
  return move path
}
