#!/usr/bin/env python3
"""Generate the key tables shared by the Silk side and the native backends.

One list below defines the physical key codes (UI Events `code` names) and the named logical
keys (UI Events `key` names). Their order fixes the discriminants on both sides of the C ABI,
so never reorder; append new members at the end of a list.

Writes src/keys.silk, native/macos/keys.h, native/linux/keys.h, native/windows/keys.h and
browser/keys.js. Run it after editing this file; CI checks that
the outputs are current.
"""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent

# UI Events KeyboardEvent.code names, https://www.w3.org/TR/uievents-code/.
CODES = (
    ["Unidentified"]
    + [f"Key{c}" for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"]
    + [f"Digit{d}" for d in range(10)]
    + [f"F{n}" for n in range(1, 25)]
    + [
        "Escape", "Enter", "Tab", "Space", "Backspace", "Delete", "Insert", "Home", "End",
        "PageUp", "PageDown", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown",
        "ShiftLeft", "ShiftRight", "ControlLeft", "ControlRight", "AltLeft", "AltRight",
        "MetaLeft", "MetaRight", "CapsLock", "Fn", "ContextMenu",
        "Minus", "Equal", "BracketLeft", "BracketRight", "Backslash", "Semicolon", "Quote",
        "Backquote", "Comma", "Period", "Slash", "IntlBackslash", "IntlRo", "IntlYen",
        "Lang1", "Lang2",
    ]
    + [f"Numpad{d}" for d in range(10)]
    + [
        "NumpadAdd", "NumpadSubtract", "NumpadMultiply", "NumpadDivide", "NumpadDecimal",
        "NumpadEnter", "NumpadEqual", "NumpadComma", "NumLock",
        "AudioVolumeUp", "AudioVolumeDown", "AudioVolumeMute", "Help", "PrintScreen",
        "ScrollLock", "Pause",
    ]
)

# UI Events KeyboardEvent.key names for keys that produce no character,
# https://www.w3.org/TR/uievents-key/. Character keys arrive as text instead.
NAMED = (
    ["Unidentified", "Enter", "Tab", "Backspace", "Delete", "Insert", "Escape",
     "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End", "PageUp", "PageDown",
     "Shift", "Control", "Alt", "Meta", "CapsLock", "Fn", "ContextMenu", "Help", "NumLock",
     "ScrollLock", "Pause", "PrintScreen", "AudioVolumeUp", "AudioVolumeDown", "AudioVolumeMute",
     "KanaMode", "Eisu"]
    + [f"F{n}" for n in range(1, 25)]
)

# The named key a physical key produces on every layout. Other keys produce text.
CODE_TO_NAMED = {
    "Enter": "Enter", "NumpadEnter": "Enter", "Tab": "Tab", "Backspace": "Backspace",
    "Delete": "Delete", "Insert": "Insert", "Escape": "Escape", "ArrowLeft": "ArrowLeft",
    "ArrowRight": "ArrowRight", "ArrowUp": "ArrowUp", "ArrowDown": "ArrowDown", "Home": "Home",
    "End": "End", "PageUp": "PageUp", "PageDown": "PageDown", "ShiftLeft": "Shift",
    "ShiftRight": "Shift", "ControlLeft": "Control", "ControlRight": "Control",
    "AltLeft": "Alt", "AltRight": "Alt", "MetaLeft": "Meta", "MetaRight": "Meta",
    "CapsLock": "CapsLock", "Fn": "Fn", "ContextMenu": "ContextMenu", "Help": "Help",
    "NumLock": "NumLock", "ScrollLock": "ScrollLock", "Pause": "Pause",
    "PrintScreen": "PrintScreen", "AudioVolumeUp": "AudioVolumeUp",
    "AudioVolumeDown": "AudioVolumeDown", "AudioVolumeMute": "AudioVolumeMute",
    "Lang1": "KanaMode", "Lang2": "Eisu",
    **{f"F{n}": f"F{n}" for n in range(1, 25)},
}

# macOS virtual key codes (HIToolbox Events.h, kVK_*) to UI Events codes.
MACOS = {
    0x00: "KeyA", 0x01: "KeyS", 0x02: "KeyD", 0x03: "KeyF", 0x04: "KeyH", 0x05: "KeyG",
    0x06: "KeyZ", 0x07: "KeyX", 0x08: "KeyC", 0x09: "KeyV", 0x0A: "IntlBackslash",
    0x0B: "KeyB", 0x0C: "KeyQ", 0x0D: "KeyW", 0x0E: "KeyE", 0x0F: "KeyR", 0x10: "KeyY",
    0x11: "KeyT", 0x12: "Digit1", 0x13: "Digit2", 0x14: "Digit3", 0x15: "Digit4",
    0x16: "Digit6", 0x17: "Digit5", 0x18: "Equal", 0x19: "Digit9", 0x1A: "Digit7",
    0x1B: "Minus", 0x1C: "Digit8", 0x1D: "Digit0", 0x1E: "BracketRight", 0x1F: "KeyO",
    0x20: "KeyU", 0x21: "BracketLeft", 0x22: "KeyI", 0x23: "KeyP", 0x24: "Enter",
    0x25: "KeyL", 0x26: "KeyJ", 0x27: "Quote", 0x28: "KeyK", 0x29: "Semicolon",
    0x2A: "Backslash", 0x2B: "Comma", 0x2C: "Slash", 0x2D: "KeyN", 0x2E: "KeyM",
    0x2F: "Period", 0x30: "Tab", 0x31: "Space", 0x32: "Backquote", 0x33: "Backspace",
    0x35: "Escape", 0x36: "MetaRight", 0x37: "MetaLeft", 0x38: "ShiftLeft",
    0x39: "CapsLock", 0x3A: "AltLeft", 0x3B: "ControlLeft", 0x3C: "ShiftRight",
    0x3D: "AltRight", 0x3E: "ControlRight", 0x3F: "Fn", 0x40: "F17", 0x41: "NumpadDecimal",
    0x43: "NumpadMultiply", 0x45: "NumpadAdd", 0x47: "NumLock", 0x48: "AudioVolumeUp",
    0x49: "AudioVolumeDown", 0x4A: "AudioVolumeMute", 0x4B: "NumpadDivide",
    0x4C: "NumpadEnter", 0x4E: "NumpadSubtract", 0x4F: "F18", 0x50: "F19",
    0x51: "NumpadEqual", 0x52: "Numpad0", 0x53: "Numpad1", 0x54: "Numpad2", 0x55: "Numpad3",
    0x56: "Numpad4", 0x57: "Numpad5", 0x58: "Numpad6", 0x59: "Numpad7", 0x5A: "F20",
    0x5B: "Numpad8", 0x5C: "Numpad9", 0x5D: "IntlYen", 0x5E: "IntlRo", 0x5F: "NumpadComma",
    0x60: "F5", 0x61: "F6", 0x62: "F7", 0x63: "F3", 0x64: "F8", 0x65: "F9", 0x66: "Lang2",
    0x67: "F11", 0x68: "Lang1", 0x69: "F13", 0x6A: "F16", 0x6B: "F14", 0x6D: "F10",
    0x6E: "ContextMenu", 0x6F: "F12", 0x71: "F15", 0x72: "Help", 0x73: "Home",
    0x74: "PageUp", 0x75: "Delete", 0x76: "F4", 0x77: "End", 0x78: "F2", 0x79: "PageDown",
    0x7A: "F1", 0x7B: "ArrowLeft", 0x7C: "ArrowRight", 0x7D: "ArrowDown", 0x7E: "ArrowUp",
}

# Linux evdev key codes (linux/input-event-codes.h, KEY_*) to UI Events codes. X11 key codes
# are these plus 8.
EVDEV = {
    1: "Escape", **{1 + d: f"Digit{d}" for d in range(1, 10)}, 11: "Digit0", 12: "Minus",
    13: "Equal", 14: "Backspace", 15: "Tab",
    **{16 + i: f"Key{c}" for i, c in enumerate("QWERTYUIOP")}, 26: "BracketLeft",
    27: "BracketRight", 28: "Enter", 29: "ControlLeft",
    **{30 + i: f"Key{c}" for i, c in enumerate("ASDFGHJKL")}, 39: "Semicolon", 40: "Quote",
    41: "Backquote", 42: "ShiftLeft", 43: "Backslash",
    **{44 + i: f"Key{c}" for i, c in enumerate("ZXCVBNM")}, 51: "Comma", 52: "Period",
    53: "Slash", 54: "ShiftRight", 55: "NumpadMultiply", 56: "AltLeft", 57: "Space",
    58: "CapsLock", **{58 + n: f"F{n}" for n in range(1, 11)}, 69: "NumLock",
    70: "ScrollLock", 71: "Numpad7", 72: "Numpad8", 73: "Numpad9", 74: "NumpadSubtract",
    75: "Numpad4", 76: "Numpad5", 77: "Numpad6", 78: "NumpadAdd", 79: "Numpad1",
    80: "Numpad2", 81: "Numpad3", 82: "Numpad0", 83: "NumpadDecimal", 86: "IntlBackslash",
    87: "F11", 88: "F12", 89: "IntlRo", 96: "NumpadEnter", 97: "ControlRight",
    98: "NumpadDivide", 99: "PrintScreen", 100: "AltRight", 102: "Home", 103: "ArrowUp",
    104: "PageUp", 105: "ArrowLeft", 106: "ArrowRight", 107: "End", 108: "ArrowDown",
    109: "PageDown", 110: "Insert", 111: "Delete", 113: "AudioVolumeMute",
    114: "AudioVolumeDown", 115: "AudioVolumeUp", 117: "NumpadEqual", 119: "Pause",
    121: "NumpadComma", 122: "Lang1", 123: "Lang2", 124: "IntlYen", 125: "MetaLeft",
    126: "MetaRight", 127: "ContextMenu", 138: "Help", 464: "Fn",
    **{170 + n: f"F{n}" for n in range(13, 25)},
}

# Windows keyboard scan codes (set 1, as WM_KEYDOWN's lParam carries them) to UI Events
# codes; 0xE0xx marks the extended keys. Chromium's dom_code_data.inc agrees.
WINDOWS = {
    0x01: "Escape", **{0x01 + d: f"Digit{d}" for d in range(1, 10)}, 0x0B: "Digit0",
    0x0C: "Minus", 0x0D: "Equal", 0x0E: "Backspace", 0x0F: "Tab",
    **{0x10 + i: f"Key{c}" for i, c in enumerate("QWERTYUIOP")}, 0x1A: "BracketLeft",
    0x1B: "BracketRight", 0x1C: "Enter", 0x1D: "ControlLeft",
    **{0x1E + i: f"Key{c}" for i, c in enumerate("ASDFGHJKL")}, 0x27: "Semicolon",
    0x28: "Quote", 0x29: "Backquote", 0x2A: "ShiftLeft", 0x2B: "Backslash",
    **{0x2C + i: f"Key{c}" for i, c in enumerate("ZXCVBNM")}, 0x33: "Comma", 0x34: "Period",
    0x35: "Slash", 0x36: "ShiftRight", 0x37: "NumpadMultiply", 0x38: "AltLeft",
    0x39: "Space", 0x3A: "CapsLock", **{0x3A + n: f"F{n}" for n in range(1, 11)},
    0x45: "Pause", 0x46: "ScrollLock", 0x47: "Numpad7", 0x48: "Numpad8", 0x49: "Numpad9",
    0x4A: "NumpadSubtract", 0x4B: "Numpad4", 0x4C: "Numpad5", 0x4D: "Numpad6",
    0x4E: "NumpadAdd", 0x4F: "Numpad1", 0x50: "Numpad2", 0x51: "Numpad3", 0x52: "Numpad0",
    0x53: "NumpadDecimal", 0x56: "IntlBackslash", 0x57: "F11", 0x58: "F12",
    0x59: "NumpadEqual", **{0x64 + n - 13: f"F{n}" for n in range(13, 24)}, 0x71: "Lang2",
    0x72: "Lang1", 0x73: "IntlRo", 0x76: "F24", 0x7D: "IntlYen", 0x7E: "NumpadComma",
    0xE01C: "NumpadEnter", 0xE01D: "ControlRight", 0xE020: "AudioVolumeMute",
    0xE02E: "AudioVolumeDown", 0xE030: "AudioVolumeUp", 0xE035: "NumpadDivide",
    0xE037: "PrintScreen", 0xE038: "AltRight", 0xE045: "NumLock", 0xE047: "Home",
    0xE048: "ArrowUp", 0xE049: "PageUp", 0xE04B: "ArrowLeft", 0xE04D: "ArrowRight",
    0xE04F: "End", 0xE050: "ArrowDown", 0xE051: "PageDown", 0xE052: "Insert",
    0xE053: "Delete", 0xE05B: "MetaLeft", 0xE05C: "MetaRight", 0xE05D: "ContextMenu",
}


def common_header(lines):
    named_index = {name: i for i, name in enumerate(NAMED)}
    lines += [f"#define SILK_CODE_{name} {i}" for i, name in enumerate(CODES)]
    lines += [""]
    lines += [f"#define SILK_NAMED_{name} {i}" for i, name in enumerate(NAMED)]
    lines += [f"#define SILK_CODE_COUNT {len(CODES)}", ""]
    lines += ["// KeyCode to the NamedKey it always produces, or Unidentified."]
    lines += [f"static const uint16_t silk_code_named_keys[{len(CODES)}] = {{"]
    for name in CODES:
        named = CODE_TO_NAMED.get(name, "Unidentified")
        lines.append(f"  {named_index[named]}, // {name}")
    lines += ["};", ""]


def table_header(name, comment, table, size, index):
    code_index = {code: i for i, code in enumerate(CODES)}
    lines = [
        "// Generated by platform/window/scripts/generate-keys; do not edit.",
        "#pragma once",
        "#include <stdint.h>",
        "",
    ]
    common_header(lines)
    lines += [f"// {comment}", f"static const uint16_t {name}[{size}] = {{"]
    by_index = {index(native): code for native, code in table.items()}
    for i in range(size):
        if i in by_index:
            lines.append(f"  [{i}] = {code_index[by_index[i]]}, // {by_index[i]}")
    lines += ["};", ""]
    return "\n".join(lines)


def browser_module():
    codes = ", ".join(f"'{name}'" for name in CODES)
    named = ", ".join(f"'{name}'" for name in NAMED)
    pairs = ", ".join(f"{name}: '{value}'" for name, value in CODE_TO_NAMED.items())
    return (
        "// Generated by platform/window/scripts/generate-keys; do not edit.\n"
        "// KeyCode and NamedKey discriminants are positions in these lists.\n"
        f"export const CODES = [{codes}];\n"
        f"export const NAMED = [{named}];\n"
        f"export const CODE_TO_NAMED = {{{pairs}}};\n"
    )


def silk_source():
    lines = [
        "//! Physical key codes and named logical keys. Generated by scripts/generate-keys; do not edit.",
        "//! The discriminants are part of the native backends' C ABI.",
        "import silk.num.u32",
        "",
        "/// A physical key, named after its position on a US keyboard (UI Events `code`).",
        "/// The same physical key reports the same code on every layout.",
        "pub enum(u16) KeyCode {",
    ]
    lines += [f"  {name}," for name in CODES]
    lines += [
        "}",
        "",
        "/// A logical key that produces no character (UI Events `key`). Keys that produce",
        "/// characters are reported as text in `Key.Character`.",
        "pub enum(u16) NamedKey {",
    ]
    lines += [f"  {name}," for name in NAMED]
    lines += ["}", ""]
    lines += [f"const KEY_CODES: [KeyCode; {len(CODES)}] = ["]
    lines += [f"  KeyCode.{name}," for name in CODES]
    lines += ["]", ""]
    lines += [f"const NAMED_KEYS: [NamedKey; {len(NAMED)}] = ["]
    lines += [f"  NamedKey.{name}," for name in NAMED]
    lines += ["]", ""]
    lines += [
        "/// The code with discriminant `value`, or `Unidentified` when no member has it.",
        "pub fn keyCodeFromValue(value: u32) -> KeyCode {",
        f"  if value >= {len(CODES)} {{",
        "    return KeyCode.Unidentified",
        "  }",
        "  return KEY_CODES[u32.toUsize(value)]",
        "}",
        "",
        "/// The named key with discriminant `value`, or `Unidentified` when no member has it.",
        "pub fn namedKeyFromValue(value: u32) -> NamedKey {",
        f"  if value >= {len(NAMED)} {{",
        "    return NamedKey.Unidentified",
        "  }",
        "  return NAMED_KEYS[u32.toUsize(value)]",
        "}",
        "",
    ]
    return "\n".join(lines)


def macos_header():
    code_index = {name: i for i, name in enumerate(CODES)}
    named_index = {name: i for i, name in enumerate(NAMED)}
    lines = [
        "// Generated by platform/window/scripts/generate-keys; do not edit.",
        "#pragma once",
        "#include <stdint.h>",
        "",
    ]
    lines += [f"#define SILK_CODE_{name} {i}" for i, name in enumerate(CODES)]
    lines += [""]
    lines += [f"#define SILK_NAMED_{name} {i}" for i, name in enumerate(NAMED)]
    lines += ["", "// kVK_* to KeyCode."]
    lines += ["static const uint16_t silk_macos_key_codes[128] = {"]
    for vk in range(128):
        name = MACOS.get(vk, "Unidentified")
        lines.append(f"  {code_index[name]}, // 0x{vk:02X} {name}")
    lines += ["};", "", "// KeyCode to the NamedKey it always produces, or Unidentified."]
    lines += [f"static const uint16_t silk_code_named_keys[{len(CODES)}] = {{"]
    for name in CODES:
        named = CODE_TO_NAMED.get(name, "Unidentified")
        lines.append(f"  {named_index[named]}, // {name}")
    lines += ["};", ""]
    return "\n".join(lines)


def main():
    assert len(set(CODES)) == len(CODES) and len(set(NAMED)) == len(NAMED)
    assert set(MACOS.values()) <= set(CODES)
    assert set(EVDEV.values()) <= set(CODES) and set(WINDOWS.values()) <= set(CODES)
    assert set(CODE_TO_NAMED) <= set(CODES) and set(CODE_TO_NAMED.values()) <= set(NAMED)
    outputs = {
        ROOT / "src/keys.silk": silk_source(),
        ROOT / "native/macos/keys.h": macos_header(),
        ROOT / "native/linux/keys.h": table_header(
            "silk_evdev_key_codes", "evdev KEY_* (X11 key code - 8) to KeyCode.", EVDEV, 512,
            lambda code: code),
        ROOT / "native/windows/keys.h": table_header(
            "silk_windows_key_codes",
            "Scan code (+ 256 for extended keys) to KeyCode.", WINDOWS, 512,
            lambda code: (256 if code & 0xE000 else 0) + (code & 0xFF)),
        ROOT / "browser/keys.js": browser_module(),
    }
    check = "--check" in sys.argv[1:]
    stale = []
    for path, text in outputs.items():
        if check:
            if not path.is_file() or path.read_text(encoding="utf-8") != text:
                stale.append(path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text, encoding="utf-8")
    if stale:
        for path in stale:
            print(f"stale: {path.relative_to(ROOT)} (run platform/window/scripts/generate-keys)")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
