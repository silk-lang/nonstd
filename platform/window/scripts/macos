#!/usr/bin/env python3
"""Build the AppKit bridge, then build or run the macOS smoke test or demo.

  scripts/macos native          build .cache/platform-window/libsilkwindow.a
  scripts/macos smoke [--build-only] [--release]
  scripts/macos demo [--build-only] [--release]

Needs macOS with the Xcode or Command Line Tools SDK. The demo also needs the WebGPU
prerequisites from the repository README.
"""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parent.parent
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import command_path, executable  # noqa: E402

FRAMEWORKS = ("Cocoa", "QuartzCore", "UniformTypeIdentifiers")
DEPLOYMENT = "14.0"  # NSView.displayLink(target:selector:) is macOS 14+


def native():
    if sys.platform != "darwin":
        raise SystemExit("The AppKit bridge builds only on macOS.")
    out = REPO / ".cache/platform-window"
    out.mkdir(parents=True, exist_ok=True)
    sdk = subprocess.check_output(["xcrun", "--sdk", "macosx", "--show-sdk-path"], text=True).strip()
    obj = out / "bridge.o"
    archive = out / "libsilkwindow.a"
    flags = ["-isysroot", sdk, f"-mmacosx-version-min={DEPLOYMENT}", "-fobjc-arc", "-fblocks",
             "-O2", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
             "-Wno-deprecated-declarations"]
    subprocess.run(["xcrun", "clang", *flags, "-c", str(PACKAGE / "native/macos/bridge.m"),
                    "-o", str(obj)], check=True)
    if archive.exists():
        archive.unlink()
    subprocess.run(["xcrun", "ar", "rcs", str(archive), str(obj)], check=True)
    return archive


def silk_command(subcommand, manifest, release):
    compiler_bin = command_path("install-silk")
    clang = command_path("install-llvm")
    command = [str(compiler_bin / executable("silkc")), subcommand, "--manifest-path", str(manifest),
               "--stdlib", str(compiler_bin.parent / "lib/silk/stdlib"), "--clang", str(clang)]
    if release:
        command.append("--release")
    return command, dict(os.environ, SILK_CLANG=str(clang))


def smoke(build_only, release):
    archive = native()
    stage = PACKAGE / "tests/macos/native"
    stage.mkdir(exist_ok=True)
    shutil.copy2(archive, stage / "libsilkwindow.a")
    command, env = silk_command("build" if build_only else "run", PACKAGE / "tests/macos/silk.toml", release)
    return subprocess.run(command, cwd=REPO, env=env).returncode


def demo(build_only, release):
    from _build import build
    archive = native()
    links = [{"static-archive": str(archive)}] + [{"framework": name} for name in FRAMEWORKS]
    program = build(PACKAGE / "examples/demo", release=release, extra_links=links)
    if build_only:
        print(program)
        return 0
    return subprocess.run([str(program)], cwd=REPO).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["native", "smoke", "demo"])
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    if args.target == "native":
        print(native())
        return 0
    if args.target == "smoke":
        return smoke(args.build_only, args.release)
    return demo(args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
