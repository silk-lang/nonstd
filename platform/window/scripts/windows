#!/usr/bin/env python3
"""Build the Win32 bridge, then build or run the Windows smoke test.

  scripts/windows native                  build .cache/platform-window/windows/silkwindow.lib
  scripts/windows smoke [--build-only] [--release]

Run from an x64 Visual Studio developer shell with the Windows SDK (the same setup as the
WebGPU packages), so clang finds the SDK headers and the linker finds the import libraries.
"""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parent.parent
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import command_path, executable  # noqa: E402

NATIVE = PACKAGE / "native"
SOURCES = ["common/core.c", "windows/bridge.c"]
# Silk links without the C runtime defaults, so the bridge uses the DLL runtime (ucrt and
# vcruntime, named in tests/windows/silk.toml), which initializes itself.
FLAGS = ["--target=x86_64-pc-windows-msvc", "-fms-runtime-lib=dll", "-std=c11", "-O2",
         "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
         "-Wno-missing-field-initializers", "-D_CRT_SECURE_NO_WARNINGS"]


def native():
    if os.name != "nt":
        raise SystemExit("The Win32 bridge builds only on Windows.")
    clang = Path(os.environ.get("SILK_CLANG") or command_path("install-llvm"))
    out = REPO / ".cache/platform-window/windows"
    out.mkdir(parents=True, exist_ok=True)
    objects = []
    for source in SOURCES:
        obj = out / (Path(source).stem + ".obj")
        subprocess.run([str(clang), *FLAGS, "-c", str(NATIVE / source), "-o", str(obj)],
                       check=True)
        objects.append(obj)
    library = out / "silkwindow.lib"
    if library.exists():
        library.unlink()
    lib = clang.parent / executable("llvm-lib")
    if lib.exists():
        subprocess.run([str(lib), f"/out:{library}", *map(str, objects)], check=True)
    else:
        ar = clang.parent / executable("llvm-ar")
        subprocess.run([str(ar), "rcs", str(library), *map(str, objects)], check=True)
    return library


def smoke(build_only, release):
    library = native()
    stage = PACKAGE / "tests/windows/native"
    stage.mkdir(exist_ok=True)
    shutil.copy2(library, stage / "silkwindow.lib")
    compiler_bin = command_path("install-silk")
    clang = os.environ.get("SILK_CLANG") or str(command_path("install-llvm"))
    command = [str(compiler_bin / executable("silkc")), "build", "--manifest-path",
               str(PACKAGE / "tests/windows/silk.toml"), "--stdlib",
               str(compiler_bin.parent / "lib/silk/stdlib"), "--clang", clang]
    if release:
        command.append("--release")
    env = dict(os.environ, SILK_CLANG=clang)
    output = subprocess.run(command, cwd=REPO, env=env, capture_output=True, text=True)
    sys.stdout.write(output.stdout)
    sys.stderr.write(output.stderr)
    if output.returncode != 0:
        return output.returncode
    name = executable("platform-window-tests-windows")
    found = [p for p in (PACKAGE / "tests/windows/build").rglob(name)
             if p.is_file() and ("release" if release else "debug") in p.parts]
    if not found:
        raise SystemExit("smoke test executable not found")
    if build_only:
        print(found[0])
        return 0
    return subprocess.run([str(found[0])], env=env, timeout=120).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["native", "smoke"])
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    if args.target == "native":
        print(native())
        return 0
    return smoke(args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
