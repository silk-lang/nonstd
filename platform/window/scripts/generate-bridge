#!/usr/bin/env python3
"""Generate src/bridge_sys.silk, the Silk declarations of native/bridge.h.

The Windows and Linux backends are C libraries; the browser backend is JavaScript imported
by the wasm module from the "window" module. Silk spells the two kinds of foreign function
differently, and other targets need stubs, so the declarations are generated from the one
list below. Keep it in the order and shape of native/bridge.h.

Run it after editing the list; CI checks that the output is current.
"""
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent

TEXT = "?[*]const u8"
OUT = "?[*]mut u8"

# (name, [(parameter, type)], result, stub body result)
FUNCTIONS = [
    ("start", [], "i32", "3"),
    ("backend", [], "u32", "0"),
    ("open", [("title", TEXT), ("titleLength", "usize"), ("width", "f64"), ("height", "f64"),
              ("minWidth", "f64"), ("minHeight", "f64"), ("flags", "u32")], "u32", "0"),
    ("close", [("window", "u32")], "()", "()"),
    ("next_event", [("timeout", "f64"), ("event", "*mut RawEvent")], "u8", "0"),
    ("event_text", [("index", "usize"), ("destination", OUT), ("capacity", "usize")], "usize", "0"),
    ("request_frame", [("window", "u32")], "()", "()"),
    ("content_size", [("window", "u32"), ("width", "*mut f64"), ("height", "*mut f64")], "()", "()"),
    ("scale_factor", [("window", "u32")], "f64", "1.0"),
    ("raw_surface", [("window", "u32"), ("first", "*mut ?*mut u8"), ("second", "*mut ?*mut u8"),
                     ("id", "*mut u64")], "u32", "0"),
    ("set_title", [("window", "u32"), ("title", TEXT), ("length", "usize")], "()", "()"),
    ("set_content_size", [("window", "u32"), ("width", "f64"), ("height", "f64")], "()", "()"),
    ("set_min_content_size", [("window", "u32"), ("width", "f64"), ("height", "f64")], "()", "()"),
    ("set_visible", [("window", "u32"), ("visible", "u8")], "()", "()"),
    ("focus", [("window", "u32")], "()", "()"),
    ("minimize", [("window", "u32")], "()", "()"),
    ("toggle_full_screen", [("window", "u32")], "()", "()"),
    ("start_window_drag", [("window", "u32")], "()", "()"),
    ("set_cursor", [("window", "u32"), ("cursor", "u32")], "()", "()"),
    ("set_ime", [("window", "u32"), ("enabled", "u8"), ("x", "f64"), ("y", "f64"),
                 ("width", "f64"), ("height", "f64")], "()", "()"),
    ("menu_begin_bar", [], "()", "()"),
    ("menu_begin", [("title", TEXT), ("length", "usize")], "()", "()"),
    ("menu_end", [], "()", "()"),
    ("menu_action", [("title", TEXT), ("length", "usize"), ("action", "u32"), ("keyKind", "u32"),
                     ("keyValue", "u32"), ("modifiers", "u32"), ("enabled", "u8"),
                     ("checked", "u8")], "()", "()"),
    ("menu_separator", [], "()", "()"),
    ("menu_system", [("item", "u32")], "()", "()"),
    ("menu_commit", [], "()", "()"),
    ("open_dialog", [("title", TEXT), ("titleLength", "usize"), ("directory", TEXT),
                     ("directoryLength", "usize"), ("extensions", TEXT),
                     ("extensionsLength", "usize"), ("flags", "u32"), ("parent", "u32")], "u32", "0"),
    ("save_dialog", [("title", TEXT), ("titleLength", "usize"), ("directory", TEXT),
                     ("directoryLength", "usize"), ("name", TEXT), ("nameLength", "usize"),
                     ("extensions", TEXT), ("extensionsLength", "usize"), ("flags", "u32"),
                     ("parent", "u32")], "u32", "0"),
    ("clipboard_read", [("destination", OUT), ("capacity", "usize")], "i64", "-1"),
    ("clipboard_write", [("text", TEXT), ("length", "usize")], "()", "()"),
    ("appearance", [], "u32", "0"),
    ("test_key", [("window", "u32"), ("code", "u32"), ("text", TEXT), ("length", "usize"),
                  ("modifiers", "u32")], "u8", "0"),
    ("test_mouse", [("window", "u32"), ("kind", "u32"), ("button", "u32"), ("x", "f64"),
                    ("y", "f64"), ("dx", "f64"), ("dy", "f64")], "u8", "0"),
    ("test_preedit", [("window", "u32"), ("text", TEXT), ("length", "usize"), ("start", "u64"),
                      ("end", "u64")], "u8", "0"),
    ("test_commit", [("window", "u32"), ("text", TEXT), ("length", "usize")], "u8", "0"),
    ("test_resize", [("window", "u32"), ("width", "f64"), ("height", "f64")], "u8", "0"),
    ("test_ime_rect", [("window", "u32"), ("x", "*mut f64"), ("y", "*mut f64"),
                       ("width", "*mut f64"), ("height", "*mut f64")], "()", "()"),
]

HEADER = '''//! The C ABI of native/bridge.h, shared by the Windows, Linux and browser backends.
//! Generated by scripts/generate-bridge; do not edit.
//!
//! On Windows and Linux the functions come from the C bridge the program links; in a wasm32
//! build they are imports from the "window" module, which browser/window-host.js provides.
//! On other targets they are stubs, so `bridge` type-checks everywhere and
//! `BridgePlatform.start` reports `Unsupported`.
import silk.core.ownership { Copy }

/// `SilkWindowEvent` in bridge.h.
pub extern "C" struct RawEvent {
  pub kind: u32,
  pub window: u32,
  pub code: u32,
  pub named: u32,
  pub modifiers: u32,
  pub flags: u32,
  pub count: u32,
  pub phase: u32,
  pub x: f64,
  pub y: f64,
  pub dx: f64,
  pub dy: f64,
  pub value: f64,
  pub start: u64,
  pub end: u64,
}

impl Copy for RawEvent {}

impl RawEvent {
  pub fn zero() -> RawEvent {
    return RawEvent {
      kind: 0,
      window: 0,
      code: 0,
      named: 0,
      modifiers: 0,
      flags: 0,
      count: 0,
      phase: 0,
      x: 0.0,
      y: 0.0,
      dx: 0.0,
      dy: 0.0,
      value: 0.0,
      start: 0,
      end: 0,
    }
  }
}
'''


def parameters(params, indent):
    if not params:
        return "()"
    inner = "".join(f"{indent}  {name}: {kind},\n" for name, kind in params)
    return "(\n" + inner + indent + ")"


def declaration(name, params, result, indent, suffix):
    return f"{indent}pub unsafe extern \"C\" fn silk_window_{name}{parameters(params, indent)} -> {result}{suffix}"


def stub(name, params, result, value, indent):
    head = f"{indent}pub unsafe fn silk_window_{name}{parameters(params, indent)} -> {result} {{"
    return f"{head}\n{indent}  return {value}\n{indent}}}"


def source():
    lines = [HEADER]
    lines.append('static if Intrinsic.targetOperatingSystem() == "windows" '
                 '|| Intrinsic.targetOperatingSystem() == "linux" {')
    for name, params, result, _ in FUNCTIONS:
        lines.append(declaration(name, params, result, "  ", ""))
    lines.append("} else {")
    lines.append('  static if Intrinsic.targetArchitecture() == "wasm32" {')
    for name, params, result, _ in FUNCTIONS:
        lines.append(declaration(name, params, result, "    ", f' as "window#silk_window_{name}"'))
    lines.append("  } else {")
    stubs = [stub(name, params, result, value, "    ") for name, params, result, value in FUNCTIONS]
    lines.append("\n\n".join(stubs))
    lines.append("  }")
    lines.append("}")
    return "\n".join(lines) + "\n"


def javascript():
    names = ", ".join(f"'silk_window_{name}'" for name, _, _, _ in FUNCTIONS)
    return ("// Generated by platform/window/scripts/generate-bridge; do not edit.\n"
            "// Every import the wasm module expects from the \"window\" module.\n"
            f"export const IMPORTS = [{names}];\n")


def formatted(text):
    """The Silk source as `silkc format` writes it, so the output passes the format check."""
    silkc = shutil.which("silkc")
    if silkc is None:
        sys.path.insert(0, str(ROOT.parent.parent / "gpu/webgpu/scripts"))
        from _build import command_path, executable
        silkc = str(command_path("install-silk") / executable("silkc"))
    with tempfile.TemporaryDirectory() as directory:
        path = Path(directory) / "bridge_sys.silk"
        path.write_text(text, encoding="utf-8")
        subprocess.run([silkc, "format", str(path)], check=True, stdout=subprocess.DEVNULL)
        return path.read_text(encoding="utf-8")


def main():
    outputs = {
        ROOT / "src/bridge_sys.silk": formatted(source()),
        ROOT / "browser/imports.js": javascript(),
    }
    check = "--check" in sys.argv[1:]
    stale = []
    for path, text in outputs.items():
        if check:
            if not path.is_file() or path.read_text(encoding="utf-8") != text:
                stale.append(path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text, encoding="utf-8")
    for path in stale:
        print(f"stale: {path.relative_to(ROOT)} (run platform/window/scripts/generate-bridge)")
    return 1 if stale else 0


if __name__ == "__main__":
    raise SystemExit(main())
