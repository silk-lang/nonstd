//! Drives the AppKit backend through a real window: frames only on request, resize, IME
//! composition and commit, typed keys, clipboard, closing. Needs a logged-in macOS session.
//! Exit code 0 when every hard check passed; checks that need the window to have keyboard
//! focus are reported as skipped when the session cannot give it.
import window.event { Event, Key, Modifiers }
import window.keys { KeyCode }
import window.macos { MacPlatform }
import window.menu { MenuBar, Shortcut, SystemItem }
import window.platform { Platform }
import window.types { WindowId, WindowOptions, WindowError, Wait, ImeState, RawSurface }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.rect { Rect }
import silk.geometry.size { Size2 }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// What arrived while the test waited.
struct Tally {
  frames: u32,
  resizes: u32,
  width: f64,
  preedit: String,
  preeditStart: usize,
  preeditEvents: u32,
  text: String,
  keyDowns: u32,
  keyA: bool,
  menuActions: u32,
}

impl Tally {
  fn make() -> Tally {
    return Tally {
      frames: 0,
      resizes: 0,
      width: 0.0,
      preedit: String.make(),
      preeditStart: 0,
      preeditEvents: 0,
      text: String.make(),
      keyDowns: 0,
      keyA: false,
      menuActions: 0,
    }
  }
}

/// Collects events for about `seconds`.
effect fn collect(platform: &mut MacPlatform, seconds: f64) -> Tally
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut tally = Tally.make()
  let mut waited: f64 = 0.0
  while waited < seconds {
    match move run platform.nextEvent(Wait.Seconds { seconds: 0.02 }) {
      Option<Event>.Some { value } => {
        match &value {
          Event.RequestFrame { window, targetTime } => {
            tally.frames = tally.frames + 1
          }
          Event.Resized { window, size, scaleFactor } => {
            tally.resizes = tally.resizes + 1
            tally.width = size.width
          }
          Event.ImePreedit { window, text, selectionStart, selectionEnd } => {
            tally.preeditEvents = tally.preeditEvents + 1
            tally.preedit.clear()
            run tally.preedit.append(text.view())
            tally.preeditStart = selectionStart
          }
          Event.TextInput { window, text } => {
            run tally.text.append(text.view())
          }
          Event.KeyDown { window, key, code, modifiers, repeat, imeHandled } => {
            tally.keyDowns = tally.keyDowns + 1
            match &key {
              Key.Character { text } => {
                if code == KeyCode.KeyA && text.view() == "a" {
                  tally.keyA = true
                }
              }
              _ => {}
            }
          }
          Event.MenuAction { action } => {
            tally.menuActions = tally.menuActions + 1
          }
          _ => {}
        }
      }
      _ => {
        waited = waited + 0.02
      }
    }
  }
  return move tally
}

struct Checks {
  failed: u32,
}

impl Checks {
  fn check(self: &mut Self, ok: bool, what: string<'static>) -> () {
    if ok {
      StderrWriter.print("ok    {}\n", &(what,))
    } else {
      StderrWriter.print("FAIL  {}\n", &(what,))
      self.failed = self.failed + 1
    }
  }

  fn soft(self: &mut Self, ok: bool, what: string<'static>) -> () {
    if ok {
      StderrWriter.print("ok    {}\n", &(what,))
    } else {
      StderrWriter.print("skip  {} (the window did not get keyboard focus)\n", &(what,))
    }
  }
}

effect fn smoke(checks: &mut Checks) -> ()
  ! WindowError | OutOfMemoryError
  ? &mut Allocator {
  let mut platform = run MacPlatform.start()
  checks.check(platform.usesFiber(), "AppKit runs on its own stack")
  let options = WindowOptions.make("platform-window smoke test", 400.0, 300.0)
  let window = run platform.openWindow(&options)
  platform.focus(window)

  let opened = run collect(&mut platform, 0.5)
  checks.check(opened.resizes >= 1 && opened.width == 400.0, "first Resized has the content width")
  checks.check(opened.frames >= 1, "a new window gets a first frame")
  checks.check(platform.scaleFactor(window) >= 1.0, "scale factor")
  match platform.rawSurface(window) {
    RawSurface.MetalLayer { layer } => {
      checks.check(true, "the view has a CAMetalLayer")
    }
    _ => {
      checks.check(false, "the view has a CAMetalLayer")
    }
  }

  let idle = run collect(&mut platform, 0.3)
  checks.check(idle.frames == 0, "no frames without a request")
  platform.requestFrame(window)
  platform.requestFrame(window)
  platform.requestFrame(window)
  let requested = run collect(&mut platform, 0.3)
  checks.check(requested.frames == 1, "requests coalesce into one display-paced frame")

  platform.simulateResize(window, Size2<f64>.new(500.0, 350.0))
  let resized = run collect(&mut platform, 0.3)
  checks.check(resized.resizes == 1 && resized.width == 500.0, "resize delivers Resized")
  checks.check(resized.frames >= 1, "resize delivers a frame")
  checks.check(platform.contentSize(window).width == 500.0, "content size follows")

  platform.setIme(window, ImeState.at(Rect<f64>.new(10.0, 20.0, 12.0, 38.0)))
  platform.simulateMarkedText(window, "にほん", 3, 0)
  let composing = run collect(&mut platform, 0.1)
  checks.check(composing.preedit.view() == "にほん", "preedit text")
  checks.check(composing.preeditStart == 9, "preedit caret in UTF-8 bytes")
  let candidate = platform.imeCandidateRect(window)
  checks.check(
    candidate.width() == 2.0 && candidate.height() == 18.0,
    "candidate window at the caret",
  )
  platform.simulateInsertText(window, "日本")
  let committed = run collect(&mut platform, 0.1)
  checks.check(
    committed.preeditEvents == 1 && committed.preedit.view() == "",
    "commit ends the preedit",
  )
  checks.check(committed.text.view() == "日本", "commit delivers TextInput")

  platform.setIme(window, ImeState.disabled())
  platform.simulateKey(window, 0, "a", Modifiers.none())
  let typed = run collect(&mut platform, 0.5)
  checks.soft(typed.keyA, "KeyDown for A")
  checks.soft(typed.text.view() == "a", "typing A delivers TextInput")

  let mut bar = MenuBar.make()
  run bar.begin("App")
  run bar.system(SystemItem.Quit)
  run bar.end()
  run bar.begin("Test")
  run bar.action("Run", 7, Option<Shortcut>.some(Shortcut.command('r')))
  run bar.end()
  run platform.setMenuBar(&bar)
  let mut command = Modifiers.none()
  command.meta = true
  platform.simulateKey(window, 15, "r", command)
  let shortcut = run collect(&mut platform, 0.5)
  checks.soft(shortcut.menuActions == 1, "a menu shortcut delivers MenuAction")
  checks.check(shortcut.text.view() == "", "a shortcut types no text")

  run platform.writeClipboard("silk ✓")
  match move run platform.readClipboard() {
    Option<String>.Some { value } => {
      checks.check(value.view() == "silk ✓", "clipboard round trip")
    }
    _ => {
      checks.check(false, "clipboard round trip")
    }
  }

  platform.closeWindow(window)
  platform.requestFrame(window)
  let closed = run collect(&mut platform, 0.2)
  checks.check(
    closed.frames == 0 && platform.contentSize(window).width == 0.0,
    "a closed window is gone",
  )
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}

effect fn program() -> i32
  ! WindowError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut checks = Checks { failed: 0 }
  run smoke(&mut checks) |> Effect.provideMut<Allocator>(&mut allocator)
  if checks.failed != 0 {
    return 1
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("FAIL  the platform did not start or a window was refused\n", &())
  return 2
}
