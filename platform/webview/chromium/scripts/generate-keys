#!/usr/bin/env python3
"""Generate native/keys.h: for each platform-window key code (by its discriminant), the Windows
virtual key code Chromium's key events are keyed on, and the native key code of each OS: the X11
key code, the macOS virtual key code (0xFFFF when there is none) and the Windows scan code
(0xE0xx for the extended keys).

The key code list and the evdev table come from platform/window/scripts/generate-keys, so the
discriminants match platform-window's C ABI. Run after that list grows; CI checks the output is
current (--check).
"""
import importlib.util
from importlib.machinery import SourceFileLoader
from pathlib import Path
import sys

PACKAGE = Path(__file__).resolve().parent.parent
WINDOW_KEYS = PACKAGE.parent.parent / "window/scripts/generate-keys"
OUTPUT = PACKAGE / "native/keys.h"

_loader = SourceFileLoader("window_keys", str(WINDOW_KEYS))
keys = importlib.util.module_from_spec(importlib.util.spec_from_loader("window_keys", _loader))
_loader.exec_module(keys)

# Windows virtual key codes (WinUser.h VK_*), which Chromium's key events are keyed on.
VK = {
    **{f"Key{c}": ord(c) for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"},
    **{f"Digit{d}": 0x30 + d for d in range(10)},
    **{f"F{n}": 0x6F + n for n in range(1, 25)},
    **{f"Numpad{d}": 0x60 + d for d in range(10)},
    "Escape": 0x1B, "Enter": 0x0D, "Tab": 0x09, "Space": 0x20, "Backspace": 0x08,
    "Delete": 0x2E, "Insert": 0x2D, "Home": 0x24, "End": 0x23, "PageUp": 0x21,
    "PageDown": 0x22, "ArrowLeft": 0x25, "ArrowRight": 0x27, "ArrowUp": 0x26,
    "ArrowDown": 0x28, "ShiftLeft": 0xA0, "ShiftRight": 0xA1, "ControlLeft": 0xA2,
    "ControlRight": 0xA3, "AltLeft": 0xA4, "AltRight": 0xA5, "MetaLeft": 0x5B,
    "MetaRight": 0x5C, "CapsLock": 0x14, "ContextMenu": 0x5D, "Minus": 0xBD, "Equal": 0xBB,
    "BracketLeft": 0xDB, "BracketRight": 0xDD, "Backslash": 0xDC, "Semicolon": 0xBA,
    "Quote": 0xDE, "Backquote": 0xC0, "Comma": 0xBC, "Period": 0xBE, "Slash": 0xBF,
    "IntlBackslash": 0xE2, "IntlRo": 0xC1, "IntlYen": 0xDC, "Lang1": 0x15, "Lang2": 0x19,
    "NumpadAdd": 0x6B, "NumpadSubtract": 0x6D, "NumpadMultiply": 0x6A, "NumpadDivide": 0x6F,
    "NumpadDecimal": 0x6E, "NumpadEnter": 0x0D, "NumpadEqual": 0xBB, "NumpadComma": 0x6C,
    "NumLock": 0x90, "AudioVolumeUp": 0xAF, "AudioVolumeDown": 0xAE, "AudioVolumeMute": 0xAD,
    "Help": 0x2F, "PrintScreen": 0x2C, "ScrollLock": 0x91, "Pause": 0x13,
}


def header():
    x11 = {code: evdev + 8 for evdev, code in keys.EVDEV.items()}
    mac = {code: value for value, code in keys.MACOS.items()}
    scan = {code: value for value, code in keys.WINDOWS.items()}
    lines = [
        "// Generated by platform/webview/chromium/scripts/generate-keys; do not edit.",
        "// Indexed by platform-window's KeyCode discriminant: {Windows virtual key, X11 key code,",
        "// macOS virtual key code (0xFFFF for none), Windows scan code (0xE0xx extended)}.",
        "#pragma once",
        "#include <stdint.h>",
        "",
        f"#define SILK_CEF_KEY_COUNT {len(keys.CODES)}",
        "",
        "static const uint16_t silk_cef_keys[SILK_CEF_KEY_COUNT][4] = {",
    ]
    for code in keys.CODES:
        lines.append(f"    {{0x{VK.get(code, 0):02X}, {x11.get(code, 0)}, 0x{mac.get(code, 0xFFFF):04X}, "
                     f"0x{scan.get(code, 0):04X}}}, // {code}")
    lines += ["};", ""]
    return "\n".join(lines)


def main():
    text = header()
    if "--check" in sys.argv[1:]:
        if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != text:
            print(f"stale: {OUTPUT.relative_to(PACKAGE)} (run platform/webview/chromium/scripts/generate-keys)")
            return 1
        return 0
    OUTPUT.write_text(text, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
