#!/usr/bin/env python3
"""Install CEF, then build and run the Chromium web view smoke test on macOS or Windows.

  scripts/smoke [--build-only] [--release]

The macOS and Windows counterpart of `scripts/linux smoke`: the same test (tests/smoke) in a real
window, with the runtime directory scripts/install-cef puts together as its argument, Chromium's
sandbox off and CPU frames. On Windows, scripts/prepare-windows builds the bridge against the CEF
headers install-cef just copied, so run it from an x64 Visual Studio developer shell.

CEF writes its log to .cache/cef/smoke.log; its errors are printed when the test fails.
"""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402


def runtime():
    output = subprocess.run([sys.executable, str(REPO / "scripts/install-cef")], check=True,
                            stdout=subprocess.PIPE, text=True).stdout
    return Path(output.strip().splitlines()[-1])


def smoke(build_only, release):
    directory = runtime()
    if sys.platform == "win32":
        # The bridge compiles against the headers install-cef copied, so it is built after it.
        subprocess.run([sys.executable, str(REPO / "scripts/prepare-windows")], check=True)
    # A program built before the headers were installed has the stand-in bridge.
    stale = PACKAGE / "tests/smoke/build"
    if stale.exists():
        shutil.rmtree(stale)
    program = build(PACKAGE / "tests/smoke", release=release)
    if build_only:
        print(program)
        return 0
    log = REPO / ".cache/cef/smoke.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    if log.exists():
        log.unlink()
    env = dict(os.environ, SILK_CEF_LOG=str(log))
    code = subprocess.run([str(program), str(directory)], env=env, timeout=300).returncode
    if code and log.exists():
        lines = [line for line in log.read_text(errors="replace").splitlines()
                 if ":ERROR:" in line or ":FATAL:" in line or "CONSOLE" in line]
        print("--- CEF log errors and console lines (last 80)", flush=True)
        print("\n".join(lines[-80:]), flush=True)
    return code


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    if sys.platform not in ("darwin", "win32"):
        raise SystemExit("On Linux, use scripts/linux smoke.")
    return smoke(args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
