#!/usr/bin/env python3
"""Install CEF, then build and run the Chromium web view smoke test in a real window.

  scripts/linux smoke [--backend x11|wayland|all] [--build-only] [--release]

`scripts/install-cef` puts the pinned CEF runtime together and copies its headers where the
bridge compiles against them; the smoke test (tests/smoke) gets the runtime directory as its
argument. It runs under Xvfb (x11) or a headless Weston (wayland), started the way
platform/window/scripts/linux starts them, with Chromium's sandbox and GPU process off and CPU
frames, so it needs no GPU: the UI renderer draws on lavapipe when VK_ICD_FILENAMES is not set.

CEF writes its log to .cache/cef/smoke.log, printed when the test fails.

Needs what platform/window's Linux bridge needs (libx11-dev libxkbcommon-dev libwayland-dev, xvfb
and weston) and the libraries libcef.so loads (the smoke test lists any that are missing).
"""
import argparse
import os
from pathlib import Path
import runpy
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402

LAVAPIPE = Path("/usr/share/vulkan/icd.d/lvp_icd.json")


def runtime():
    output = subprocess.run([sys.executable, str(REPO / "scripts/install-cef")], check=True,
                            capture_output=True, text=True).stdout
    return Path(output.strip().splitlines()[-1])


def missing_libraries(library):
    listing = subprocess.run(["ldd", str(library)], capture_output=True, text=True).stdout
    return [line.split()[0] for line in listing.splitlines() if "not found" in line]


def smoke(backend, build_only, release):
    directory = runtime()
    program = build(PACKAGE / "tests/smoke", release=release)
    if build_only:
        print(program)
        return 0
    missing = missing_libraries(directory / "libcef.so")
    if missing:
        print("libcef.so needs libraries this system lacks: " + " ".join(missing), file=sys.stderr)
        return 1
    log = REPO / ".cache/cef/smoke.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    if log.exists():
        log.unlink()
    env = dict(os.environ, SILK_WINDOW_SCALE="1", SILK_CEF_LOG=str(log))
    if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
        env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
    # The runners start the program without arguments; a wrapper adds the runtime directory.
    wrapper = REPO / ".cache/cef/smoke"
    wrapper.write_text(f'#!/bin/sh\nexec "{program}" "{directory}"\n')
    wrapper.chmod(0o755)
    linux = runpy.run_path(str(REPO / "platform/window/scripts/linux"))
    status = 0
    for name in (["x11", "wayland"] if backend == "all" else [backend]):
        print(f"--- {name}", flush=True)
        runner = linux["run_under_x11"] if name == "x11" else linux["run_under_wayland"]
        code = runner(wrapper, env)
        print(f"--- {name}: {'passed' if code == 0 else f'failed ({code})'}", flush=True)
        status = status or code
    if status and log.exists():
        print("--- CEF log (last 200 lines)", flush=True)
        print("\n".join(log.read_text(errors="replace").splitlines()[-200:]), flush=True)
    return status


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["smoke"])
    parser.add_argument("--backend", choices=["x11", "wayland", "all"], default="x11")
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    return smoke(args.backend, args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
