#!/usr/bin/env python3
"""Build the CEF bridge on Windows, as platform-webview-chromium's `win32-chromium` archive.

  scripts/windows native    build .cache/platform-webview-chromium/windows/silkcef.lib

scripts/prepare-windows runs this and names the result, with the import libraries it needs, as the
override of the `win32-chromium` archive, so plain `silk build` links it. The bridge is the real one
when scripts/install-cef has put CEF's headers in native/cef/include, and a stand-in that reports
CEF missing otherwise (native/entry.c), so preparing Windows never downloads CEF.

Run from an x64 Visual Studio developer shell with the Windows SDK, as for platform/window.
"""
import os
from pathlib import Path
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import command_path, executable  # noqa: E402

NATIVE = PACKAGE / "native"
OUT = REPO / ".cache/platform-webview-chromium/windows"


def api_flag():
    manifest = (PACKAGE / "silk.toml").read_text(encoding="utf-8")
    start = manifest.index("-DCEF_API_VERSION=")
    return manifest[start:manifest.index('"', start)]


# Silk links without the C runtime defaults, so the bridge uses the DLL runtime (ucrt and
# vcruntime, which prepare-windows stages beside the library), which initializes itself.
FLAGS = ["--target=x86_64-pc-windows-msvc", "-fms-runtime-lib=dll", "-std=c11", "-O2", "-Wall",
         "-Wextra", "-Werror", "-Wno-unused-parameter", "-Wno-missing-field-initializers",
         "-D_CRT_SECURE_NO_WARNINGS"]


def native():
    if os.name != "nt":
        raise SystemExit("The Windows CEF bridge builds only on Windows.")
    clang = Path(os.environ.get("SILK_CLANG") or command_path("install-llvm"))
    OUT.mkdir(parents=True, exist_ok=True)
    obj = OUT / "bridge.obj"
    subprocess.run([str(clang), *FLAGS, api_flag(), "-I", str(NATIVE / "cef"), "-c",
                    str(NATIVE / "entry.c"), "-o", str(obj)], check=True)
    library = OUT / "silkcef.lib"
    if library.exists():
        library.unlink()
    lib = clang.parent / executable("llvm-lib")
    if lib.exists():
        subprocess.run([str(lib), f"/out:{library}", str(obj)], check=True)
    else:
        subprocess.run([str(clang.parent / executable("llvm-ar")), "rcs", str(library), str(obj)],
                       check=True)
    return library


def main():
    if sys.argv[1:] != ["native"]:
        print(__doc__)
        return 2
    print(native())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
