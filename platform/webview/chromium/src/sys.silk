//! The CEF bridge's C ABI (native/bridge.h).
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }

/// `SilkCefEvent` in bridge.h.
pub extern "C" struct RawEvent {
  pub kind: u32,
  pub view: u32,
  pub request: u32,
  pub flags: u32,
  pub level: u32,
  pub width: u32,
  pub height: u32,
  pub count: u32,
  pub value: f64,
}

impl Copy for RawEvent {}

impl RawEvent {
  pub fn zero() -> RawEvent {
    return RawEvent {
      kind: 0,
      view: 0,
      request: 0,
      flags: 0,
      level: 0,
      width: 0,
      height: 0,
      count: 0,
      value: 0.0,
    }
  }
}

/// `SilkCefPlane` in bridge.h.
pub extern "C" struct RawPlane {
  pub fd: i32,
  pub stride: u32,
  pub offset: u64,
}

impl Copy for RawPlane {}

/// `SilkCefFrame` in bridge.h.
pub extern "C" struct RawFrame {
  pub kind: u32,
  pub width: u32,
  pub height: u32,
  pub generation: u64,
  pub pixels: ?[*]const u8,
  pub drmFormat: u32,
  pub planeCount: u32,
  pub drmModifier: u64,
  pub planes: [RawPlane; 4],
  pub x: i32,
  pub y: i32,
  pub shown: u32,
}

impl RawFrame {
  pub fn zero() -> RawFrame {
    let plane = RawPlane { fd: -1, stride: 0, offset: 0 }
    return RawFrame {
      kind: 0,
      width: 0,
      height: 0,
      generation: 0,
      pixels: unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>()),
      drmFormat: 0,
      drmModifier: 0,
      planeCount: 0,
      planes: [plane, plane, plane, plane],
      x: 0,
      y: 0,
      shown: 0,
    }
  }
}

pub const CREATED: u32 = 1

pub const CLOSED: u32 = 2

pub const LOAD_STARTED: u32 = 3

pub const LOAD_PROGRESS: u32 = 4

pub const LOAD_FINISHED: u32 = 5

