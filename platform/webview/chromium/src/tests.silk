//! Tests that need no CEF: starting without one, and how window input maps to the bridge's.
//! The Linux smoke test (tests/smoke) runs the real thing.
import chromium { ChromiumWebViews, StartError }
import options { ChromiumOptions }
import input { modifierBits, buttonNumber, buttonBit, wheelPixels, cursorFromValue, LINE_PIXELS }
import sys
import window.event { Modifiers, MouseButton, ScrollDelta }
import window.types { Cursor }
import webview.types { MOD_SHIFT, MOD_CONTROL, MOD_META, BUTTON_PRIMARY, BUTTON_SECONDARY }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

effect fn startSucceeds(options: &ChromiumOptions) -> bool
  ! StartError
  ? &mut Allocator {
  let mut views = run ChromiumWebViews.start(options)
  views.shutdown()
  return true
}

effect fn wasNoLibrary(error: StartError) -> bool {
  return match error {
    StartError.NoLibrary => true
    _ => false
  }
}

effect fn missingRuntimeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let options = run ChromiumOptions.make("/nonexistent/silk-cef-runtime")
  let noLibrary = run Effect.catchAll(startSucceeds(&options), wasNoLibrary)
  run Testing.expect(noLibrary, "a runtime directory without libcef.so fails with NoLibrary")
  let message = run ChromiumWebViews.startError()
  run Testing.expect(
    String.contains(String.view(&message), "libcef.so"),
    "and startError names the library",
  )
}

test effect fn startingWithoutARuntimeFails() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run missingRuntimeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn modifiersAndButtonsMap() -> ()
  ! AssertionError<'static> {
  let mut modifiers = Modifiers.none()
  run Testing.expect(modifierBits(modifiers, 0) == 0, "no modifiers, no bits")
  modifiers.shift = true
  modifiers.meta = true
  modifiers.capsLock = true
  let bits = modifierBits(modifiers, sys.MOD_LEFT_BUTTON)
  run Testing.expect(
    bits == (MOD_SHIFT | MOD_META | sys.MOD_CAPS_LOCK | sys.MOD_LEFT_BUTTON),
    "shift, meta, caps lock and held buttons",
  )
  run Testing.expect((bits & MOD_CONTROL) == 0, "and nothing else")
  let left = match buttonNumber(MouseButton.Left) {
    Option<u32>.Some { value } => value == BUTTON_PRIMARY
    Option<u32>.None => false
  }
  let right = match buttonNumber(MouseButton.Right) {
    Option<u32>.Some { value } => value == BUTTON_SECONDARY
    Option<u32>.None => false
  }
  run Testing.expect(left && right, "left and right buttons map to the page's buttons")
  run Testing.expect(
    buttonBit(BUTTON_SECONDARY) == sys.MOD_RIGHT_BUTTON
      && buttonBit(BUTTON_PRIMARY) == sys.MOD_LEFT_BUTTON,
    "held buttons have their modifier bits",
  )
}

test effect fn wheelAndCursorsMap() -> ()
  ! AssertionError<'static> {
  let lines = wheelPixels(ScrollDelta.Lines { delta: Vector2<f64>.new(0.0, 2.0) })
  run Testing.expect(lines.y == 2.0 * LINE_PIXELS && lines.x == 0.0, "wheel lines become pixels")
  let points = wheelPixels(ScrollDelta.Points { delta: Vector2<f64>.new(3.5, -7.0) })
  run Testing.expect(points.x == 3.5 && points.y == -7.0, "trackpad points pass through")
  run Testing.expect(cursorFromValue(1) == Cursor.IBeam, "the bridge reports window cursors")
  run Testing.expect(cursorFromValue(2) == Cursor.PointingHand, "by discriminant")
  run Testing.expect(cursorFromValue(500) == Cursor.Arrow, "and unknown values are arrows")
}
