//! Translating platform-window's input into what the CEF bridge takes.
import sys
import window.event { Modifiers, MouseButton, ScrollDelta }
import window.types { Cursor }
import webview.types {
  MOD_SHIFT,
  MOD_CONTROL,
  MOD_ALT,
  MOD_META,
  BUTTON_PRIMARY,
  BUTTON_AUXILIARY,
  BUTTON_SECONDARY
}
import silk.core.option { Option }
import silk.num.u32

/// Pixels one wheel line scrolls, as Chromium scrolls a notch on Linux.
pub const LINE_PIXELS: f64 = 40.0

/// The bridge's modifier bits for `modifiers` with the mouse buttons in `buttons` held.
pub fn modifierBits(modifiers: Modifiers, buttons: u32) -> u32 {
  let mut bits: u32 = buttons
  if modifiers.shift {
    bits = bits | MOD_SHIFT
  }
  if modifiers.control {
    bits = bits | MOD_CONTROL
  }
  if modifiers.alt {
    bits = bits | MOD_ALT
  }
  if modifiers.meta {
    bits = bits | MOD_META
  }
  if modifiers.capsLock {
    bits = bits | sys.MOD_CAPS_LOCK
  }
  return bits
}

/// The bridge's button number for `button`, or None for the buttons pages do not see as clicks.
pub fn buttonNumber(button: MouseButton) -> Option<u32> {
  return match button {
    MouseButton.Left => Option<u32>.some(BUTTON_PRIMARY)
    MouseButton.Middle => Option<u32>.some(BUTTON_AUXILIARY)
    MouseButton.Right => Option<u32>.some(BUTTON_SECONDARY)
    _ => Option<u32>.None
  }
}

/// The modifier bit of a held mouse button.
pub fn buttonBit(button: u32) -> u32 {
  if button == BUTTON_AUXILIARY {
    return sys.MOD_MIDDLE_BUTTON
  }
  if button == BUTTON_SECONDARY {
    return sys.MOD_RIGHT_BUTTON
  }
  return sys.MOD_LEFT_BUTTON
}

pub struct WheelPixels {
  pub x: f64,
  pub y: f64,
}

/// A scroll in CSS pixels; positive y shows what is above, as Chromium's wheel events do.
pub fn wheelPixels(delta: ScrollDelta) -> WheelPixels {
  return match delta {
    ScrollDelta.Lines { delta: lines } => WheelPixels {
      x: lines.x * LINE_PIXELS,
      y: lines.y * LINE_PIXELS,
    }
    ScrollDelta.Points { delta: points } => WheelPixels { x: points.x, y: points.y }
  }
}

const CURSORS: [Cursor; 22] = [
  Cursor.Arrow,
  Cursor.IBeam,
  Cursor.PointingHand,
  Cursor.Crosshair,
  Cursor.ClosedHand,
  Cursor.OpenHand,
  Cursor.NotAllowed,
  Cursor.ResizeLeftRight,
  Cursor.ResizeUpDown,
  Cursor.ResizeLeft,
  Cursor.ResizeRight,
  Cursor.ResizeUp,
  Cursor.ResizeDown,
  Cursor.ResizeNorthWestSouthEast,
  Cursor.ResizeNorthEastSouthWest,
  Cursor.ResizeColumn,
  Cursor.ResizeRow,
  Cursor.IBeamVertical,
  Cursor.DragCopy,
  Cursor.DragLink,
  Cursor.ContextualMenu,
  Cursor.None,
]

/// platform-window's cursor with discriminant `value` (the bridge reports those).
pub fn cursorFromValue(value: u32) -> Cursor {
  if value >= 22 {
    return Cursor.Arrow
  }
  return CURSORS[u32.toUsize(value)]
}
