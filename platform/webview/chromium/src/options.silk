//! How CEF starts: once per process, before the first view opens.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub struct ChromiumOptions {
  /// The runtime directory: libcef.so with the files beside it, its resources and locales, and
  /// silk-cef-helper (`scripts/install-cef` puts one together and prints its path). An app ships
  /// it and names it here.
  pub runtimeDir: String,
  /// The executable of CEF's other processes; empty for `silk-cef-helper` in `runtimeDir`.
  pub helperPath: String,
  /// Where named profiles keep cookies and storage between runs; empty for a temporary
  /// directory, so even named profiles last only as long as the process.
  pub cacheRoot: String,
  /// Extra Chromium command line switches, one per line, without the leading dashes
  /// (`"lang=pt-BR"`).
  pub switches: String,
  /// Chromium's sandbox for page processes. It needs unprivileged user namespaces or the
  /// setuid `chrome-sandbox` helper; turn it off in containers and CI that have neither.
  pub sandbox: bool,
  /// Frames come from the GPU process as dma-bufs that the host imports into Dawn (needs a GPU
  /// and a device with `webgpu.shared_texture.FEATURE_DMA_BUF`). Off, frames are CPU pixels
  /// the host uploads, which works everywhere, software rendering included.
  pub sharedTextures: bool,
  /// Chromium's GPU process. Off, pages composite in software (machines without a usable GPU,
  /// CI).
  pub gpu: bool,
}

impl ChromiumOptions {
  /// Options for the runtime in `runtimeDir`: sandboxed, GPU on, CPU frames.
  pub effect fn make(runtimeDir: string) -> ChromiumOptions
    ! OutOfMemoryError
    ? &mut Allocator {
    return ChromiumOptions {
      runtimeDir: run String.copy(runtimeDir),
      helperPath: String.make(),
      cacheRoot: String.make(),
      switches: String.make(),
      sandbox: true,
      sharedTextures: false,
      gpu: true,
    }
  }
}
