//! The C ABI of the native web view bridges (native/bridge.h): WKWebView on macOS
//! (native/macos/bridge.m), WebView2 on Windows (native/windows/bridge.c). On other targets the
//! same names are stubs, so `bridge` type-checks everywhere and `BridgeWebViews.open` reports
//! `Unsupported`.
import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }

/// `SilkWebViewEvent` in bridge.h.
pub extern "C" struct RawEvent {
  pub kind: u32,
  pub view: u32,
  pub request: u32,
  pub flags: u32,
  pub level: u32,
  pub width: u32,
  pub height: u32,
  pub count: u32,
  pub value: f64,
}

impl Copy for RawEvent {}

impl RawEvent {
  pub fn zero() -> RawEvent {
    return RawEvent {
      kind: 0,
      view: 0,
      request: 0,
      flags: 0,
      level: 0,
      width: 0,
      height: 0,
      count: 0,
      value: 0.0,
    }
  }
}

pub const CREATED: u32 = 1

pub const CLOSED: u32 = 2

pub const LOAD_STARTED: u32 = 3

pub const LOAD_PROGRESS: u32 = 4

pub const LOAD_FINISHED: u32 = 5

pub const URL_CHANGED: u32 = 6

pub const TITLE_CHANGED: u32 = 7

pub const HISTORY_CHANGED: u32 = 8

pub const NAVIGATION_REQUESTED: u32 = 9

pub const NEW_WINDOW_REQUESTED: u32 = 10

pub const FOCUS_CHANGED: u32 = 11

pub const SCRIPT_RESULT: u32 = 12

pub const SNAPSHOT: u32 = 13

pub const SCREENSHOT: u32 = 14

pub const ACTION_RESULT: u32 = 15

pub const CONSOLE: u32 = 16

pub const UNSUPPORTED: u32 = 17

pub const CRASHED: u32 = 18

pub const FLAG_OK: u32 = 1

pub const FLAG_SECOND: u32 = 2

pub const OPTION_INSPECTABLE: u32 = 1

pub const OPTION_ASK_BEFORE_NAVIGATING: u32 = 2

pub const OPTION_TRANSPARENT: u32 = 4

pub const OPENED: u32 = 0

pub const NO_WINDOW: u32 = 1

pub const ID_IN_USE: u32 = 2

pub const NOT_STARTED: u32 = 3

pub const AGENT_SNAPSHOT: u32 = 0

pub const AGENT_CLICK: u32 = 1

pub const AGENT_FILL: u32 = 2

pub const BACK: u32 = 0

pub const FORWARD: u32 = 1

pub const RELOAD: u32 = 2

pub const STOP: u32 = 3

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "windows" {
  pub unsafe extern "C" fn silk_webview_open(
    view: u32,
    window: u32,
    url: ?[*]const u8,
    urlLength: usize,
    profile: ?[*]const u8,
    profileLength: usize,
    flags: u32,
    agentScript: ?[*]const u8,
    agentScriptLength: usize,
  ) -> u32
  pub unsafe extern "C" fn silk_webview_close(view: u32) -> ()
  pub unsafe extern "C" fn silk_webview_exists(view: u32) -> u8
  pub unsafe extern "C" fn silk_webview_place(
    view: u32,
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    clipX0: f64,
    clipY0: f64,
    clipX1: f64,
    clipY1: f64,
    visible: u8,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_next_event(event: *mut RawEvent) -> u8
  pub unsafe extern "C" fn silk_webview_event_text(index: usize, length: *mut usize) -> ?[*]const u8
  pub unsafe extern "C" fn silk_webview_queue(
    view: u32,
    kind: u32,
    request: u32,
    flags: u32,
    text: ?[*]const u8,
    length: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_navigate(view: u32, url: ?[*]const u8, length: usize) -> ()
  pub unsafe extern "C" fn silk_webview_load_html(
    view: u32,
    html: ?[*]const u8,
    htmlLength: usize,
    baseUrl: ?[*]const u8,
    baseUrlLength: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_go(view: u32, operation: u32) -> ()
  pub unsafe extern "C" fn silk_webview_set_zoom(view: u32, factor: f64) -> ()
  pub unsafe extern "C" fn silk_webview_focus(view: u32) -> ()
  pub unsafe extern "C" fn silk_webview_evaluate(
    view: u32,
    request: u32,
    script: ?[*]const u8,
    length: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_agent(
    view: u32,
    request: u32,
    operation: u32,
    call: ?[*]const u8,
    callLength: usize,
    text: ?[*]const u8,
    textLength: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_screenshot(view: u32, request: u32) -> ()
  pub unsafe extern "C" fn silk_webview_click(
    view: u32,
    x: f64,
    y: f64,
    button: u32,
    clickCount: u32,
    modifiers: u32,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_move_pointer(
    view: u32,
    x: f64,
    y: f64,
    modifiers: u32,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_scroll(
    view: u32,
    x: f64,
    y: f64,
    deltaX: f64,
    deltaY: f64,
    modifiers: u32,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_type_text(
    view: u32,
    text: ?[*]const u8,
    length: usize,
  ) -> ()
  pub unsafe extern "C" fn silk_webview_press_key(
    view: u32,
    key: ?[*]const u8,
    length: usize,
    modifiers: u32,
  ) -> u8
  pub unsafe extern "C" fn silk_webview_answer_navigation(view: u32, request: u32, allow: u8) -> ()
  pub unsafe extern "C" fn silk_webview_open_devtools(view: u32) -> u8
  pub unsafe extern "C" fn silk_webview_test_frame(
    view: u32,
    x: *mut f64,
    y: *mut f64,
    width: *mut f64,
    height: *mut f64,
    visible: *mut u8,
  ) -> ()
} else {
  pub unsafe fn silk_webview_open(
    view: u32,
    window: u32,
    url: ?[*]const u8,
    urlLength: usize,
    profile: ?[*]const u8,
    profileLength: usize,
    flags: u32,
    agentScript: ?[*]const u8,
    agentScriptLength: usize,
  ) -> u32 {
    return 3
  }

  pub unsafe fn silk_webview_close(view: u32) -> () {
    return ()
  }

  pub unsafe fn silk_webview_exists(view: u32) -> u8 {
    return 0
  }

  pub unsafe fn silk_webview_place(
    view: u32,
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    clipX0: f64,
    clipY0: f64,
    clipX1: f64,
    clipY1: f64,
    visible: u8,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_next_event(event: *mut RawEvent) -> u8 {
    return 0
  }

  pub unsafe fn silk_webview_event_text(index: usize, length: *mut usize) -> ?[*]const u8 {
    return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())
  }

  pub unsafe fn silk_webview_queue(
    view: u32,
    kind: u32,
    request: u32,
    flags: u32,
    text: ?[*]const u8,
    length: usize,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_navigate(view: u32, url: ?[*]const u8, length: usize) -> () {
    return ()
  }

  pub unsafe fn silk_webview_load_html(
    view: u32,
    html: ?[*]const u8,
    htmlLength: usize,
    baseUrl: ?[*]const u8,
    baseUrlLength: usize,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_go(view: u32, operation: u32) -> () {
    return ()
  }

  pub unsafe fn silk_webview_set_zoom(view: u32, factor: f64) -> () {
    return ()
  }

  pub unsafe fn silk_webview_focus(view: u32) -> () {
    return ()
  }

  pub unsafe fn silk_webview_evaluate(
    view: u32,
    request: u32,
    script: ?[*]const u8,
    length: usize,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_agent(
    view: u32,
    request: u32,
    operation: u32,
    call: ?[*]const u8,
    callLength: usize,
    text: ?[*]const u8,
    textLength: usize,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_screenshot(view: u32, request: u32) -> () {
    return ()
  }

  pub unsafe fn silk_webview_click(
    view: u32,
    x: f64,
    y: f64,
    button: u32,
    clickCount: u32,
    modifiers: u32,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_move_pointer(view: u32, x: f64, y: f64, modifiers: u32) -> () {
    return ()
  }

  pub unsafe fn silk_webview_scroll(
    view: u32,
    x: f64,
    y: f64,
    deltaX: f64,
    deltaY: f64,
    modifiers: u32,
  ) -> () {
    return ()
  }

  pub unsafe fn silk_webview_type_text(view: u32, text: ?[*]const u8, length: usize) -> () {
    return ()
  }

  pub unsafe fn silk_webview_press_key(
    view: u32,
    key: ?[*]const u8,
    length: usize,
    modifiers: u32,
  ) -> u8 {
    return 1
  }

  pub unsafe fn silk_webview_answer_navigation(view: u32, request: u32, allow: u8) -> () {
    return ()
  }

  pub unsafe fn silk_webview_open_devtools(view: u32) -> u8 {
    return 0
  }

  pub unsafe fn silk_webview_test_frame(
    view: u32,
    x: *mut f64,
    y: *mut f64,
    width: *mut f64,
    height: *mut f64,
    visible: *mut u8,
  ) -> () {
    return ()
  }
}
