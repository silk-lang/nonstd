import agent {
  agentScript,
  snapshotCall,
  locateCall,
  focusForFillCall,
  readLocation,
  readError,
  readJsonString,
  isRef
}
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

test effect fn theScriptIsEmbedded() -> ()
  ! AssertionError<'static> {
  let script = agentScript()
  run Testing.expect(String.byteLength(script) > 1000, "the page script is embedded")
  run Testing.expect(String.contains(script, "__silkAgent"), "and defines window.__silkAgent")
  run Testing.expect(String.contains(snapshotCall(), "snapshot()"), "the snapshot call calls it")
}

test effect fn onlyRefsMakeCalls() -> ()
  ! AssertionError<'static> {
  run Testing.expect(isRef("e1") && isRef("e204"), "e and digits are refs")
  run Testing.expect(
    !isRef("e") && !isRef("x1") && !isRef("e1\")") && !isRef(""),
    "nothing else is",
  )
}

effect fn callsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  match run locateCall("e12") {
    Option<String>.Some { value } => {
      run Testing.expect(
        String.contains(String.view(&value), "window.__silkAgent.locate(\"e12\")"),
        "locateCall names the ref",
      )
    }
    Option<String>.None => run Testing.expect(false, "a ref makes a call")
  }
  run Testing.expect(
    match run focusForFillCall("e1); alert(1") {
      Option<String>.None => true
      Option<String>.Some { .. } => false
    },
    "a script in place of a ref makes no call",
  )

  let place = readLocation(
    "{\"ok\":true,\"x\":412.5,\"y\":-3.25,\"width\":80,\"height\":20,\"covered\":false}",
  )
  run Testing.expect(
    place.ok && place.x == 412.5 && place.y == -3.25,
    "readLocation reads the center",
  )
  run Testing.expect(!place.covered, "and the covered flag")
  let failed = readLocation(
    "{\"ok\":false,\"error\":\"no element e9; take a \\\"new\\\" snapshot\"}",
  )
  run Testing.expect(!failed.ok, "a failed call reads as not ok")
  let message = run readError(
    "{\"ok\":false,\"error\":\"no element e9; take a \\\"new\\\" snapshot\"}",
  )
  run Testing.expect(
    String.view(&message) == "no element e9; take a \"new\" snapshot",
    "readError unescapes the message",
  )
  let text = run readJsonString("\"- document \\\"Home\\\"\\n  - link \\\"Docs\\\" [ref=e1]\\n\"")
  run Testing.expect(
    String.view(&text) == "- document \"Home\"\n  - link \"Docs\" [ref=e1]\n",
    "readJsonString unescapes a snapshot",
  )
}

test effect fn callsAreBuiltAndRead() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run callsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
