//! What a web view reports. Events queue in the host and leave through
//! `WebViewHost.takeEvents`; there are no callbacks into Silk.
import types { ConsoleLevel }
import silk.collections.bytes { Bytes }
import silk.text.string { String }

pub struct WebViewEvent {
  /// The view, by the id the client opened it with.
  pub view: u32,
  pub kind: EventKind,
}

pub union EventKind {
  /// The view exists; commands sent before this still run, in order.
  Created,
  Closed,
  LoadStarted { pub url: String },
  /// How far the main frame's load is, `0 ..= 1`.
  LoadProgress { pub fraction: f32 },
  /// The load ended. `ok` is false when it failed or was stopped; `error` says why.
  LoadFinished { pub url: String, pub ok: bool, pub error: String },
  UrlChanged { pub url: String },
  TitleChanged { pub title: String },
  HistoryChanged { pub canGoBack: bool, pub canGoForward: bool },
  /// The page wants to go to `url` and `askBeforeNavigating` is on. Nothing happens until
  /// `Command.AnswerNavigation` with this `request`.
  NavigationRequested { pub request: u32, pub url: String, pub userInitiated: bool },
  /// The page asked for a new window or tab (`target=_blank`, `window.open`). The view does not
  /// open one; the app decides (open another view, navigate this one, or ignore it).
  NewWindowRequested { pub url: String },
  /// The page took (`true`) or gave up keyboard focus. A host moves the tree's focus to the
  /// view's node, or away from it, on this.
  FocusChanged { pub focused: bool },
  /// The answer to `Command.Evaluate`: the value as JSON text, or the error message when `ok`
  /// is false.
  ScriptResult { pub request: u32, pub ok: bool, pub value: String },
  /// The answer to `Command.Snapshot`.
  Snapshot { pub request: u32, pub text: String },
  /// The answer to `Command.Screenshot`: RGBA, 8 bits per channel, not premultiplied, rows top
  /// first, in device pixels.
  Screenshot { pub request: u32, pub width: u32, pub height: u32, pub pixels: Bytes },
  /// The answer to `ClickElement` and `FillElement`.
  ActionResult { pub request: u32, pub ok: bool, pub error: String },
  Console { pub level: ConsoleLevel, pub message: String },
  /// The backend cannot run `command` (named as `command.commandName` names it).
  Unsupported { pub request: u32, pub command: String },
  /// The page's process died. The view stays; `Reload` starts it again.
  Crashed { pub reason: String },
}
