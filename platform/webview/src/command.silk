//! What a client asks of a web view. Every backend runs every command; one it cannot run
//! queues `EventKind.Unsupported` naming it, never fails silently.
//!
//! Pointer and key commands are real input: native backends synthesize platform events (or use
//! the DevTools protocol's input domain), so pages see trusted events, the same as from a person.
//! Positions are CSS pixels from the top left of the page's viewport.
//!
//! Commands that answer carry a `request` number the client chooses; the answer event carries
//! it back.
import silk.text.string { String }

pub union Command {
  Navigate { pub url: String },
  /// Shows `html` as if loaded from `baseUrl` (relative links resolve against it).
  LoadHtml { pub html: String, pub baseUrl: String },
  Back,
  Forward,
  Reload,
  Stop,
  /// Page zoom, 1.0 for 100%.
  SetZoom { pub factor: f32 },
  /// Gives the page keyboard focus.
  Focus,
  /// Runs `script` in the page's main frame; `EventKind.ScriptResult` carries its value as
  /// JSON text. A promise is awaited.
  Evaluate { pub request: u32, pub script: String },
  /// A text outline of what the page shows, for agents: `EventKind.Snapshot`. Each element an
  /// agent can act on carries a ref (`[ref=e12]`) that `ClickElement` and `FillElement` take.
  Snapshot { pub request: u32 },
  /// The page's pixels: `EventKind.Screenshot`.
  Screenshot { pub request: u32 },
  /// Scrolls element `element` (a snapshot ref) into view and clicks its center:
  /// `EventKind.ActionResult`.
  ClickElement { pub request: u32, pub element: String },
  /// Focuses element `element`, selects its value and types `text` over it:
  /// `EventKind.ActionResult`.
  FillElement { pub request: u32, pub element: String, pub text: String },
  /// A click: button down and up at (`x`, `y`). `clickCount` 2 is a double click.
  ClickAt { pub x: f32, pub y: f32, pub button: u32, pub clickCount: u32, pub modifiers: u32 },
  MovePointer { pub x: f32, pub y: f32, pub modifiers: u32 },
  /// A wheel turn over (`x`, `y`), deltas in CSS pixels.
  Scroll { pub x: f32, pub y: f32, pub deltaX: f32, pub deltaY: f32, pub modifiers: u32 },
  /// Types `text` into whatever has focus in the page, as text input.
  TypeText { pub text: String },
  /// Presses and releases one key, named by its DOM `key` value (`"Enter"`, `"Tab"`, `"a"`).
  PressKey { pub key: String, pub modifiers: u32 },
  /// Answers a `NavigationRequested` event.
  AnswerNavigation { pub request: u32, pub allow: bool },
  /// Opens the engine's developer tools for the view.
  OpenDevTools,
}

/// The command's name, as `EventKind.Unsupported` reports it.
pub fn commandName(command: &Command) -> string<'static> {
  return match &command.* {
    Command.Navigate { .. } => "Navigate"
    Command.LoadHtml { .. } => "LoadHtml"
    Command.Back => "Back"
    Command.Forward => "Forward"
    Command.Reload => "Reload"
    Command.Stop => "Stop"
    Command.SetZoom { .. } => "SetZoom"
    Command.Focus => "Focus"
    Command.Evaluate { .. } => "Evaluate"
    Command.Snapshot { .. } => "Snapshot"
    Command.Screenshot { .. } => "Screenshot"
    Command.ClickElement { .. } => "ClickElement"
    Command.FillElement { .. } => "FillElement"
    Command.ClickAt { .. } => "ClickAt"
    Command.MovePointer { .. } => "MovePointer"
    Command.Scroll { .. } => "Scroll"
    Command.TypeText { .. } => "TypeText"
    Command.PressKey { .. } => "PressKey"
    Command.AnswerNavigation { .. } => "AnswerNavigation"
    Command.OpenDevTools => "OpenDevTools"
  }
}

/// The request number of a command that answers, or 0.
pub fn requestOf(command: &Command) -> u32 {
  return match &command.* {
    Command.Evaluate { request, .. } => request
    Command.Snapshot { request } => request
    Command.Screenshot { request } => request
    Command.ClickElement { request, .. } => request
    Command.FillElement { request, .. } => request
    Command.AnswerNavigation { request, .. } => request
    _ => 0
  }
}
