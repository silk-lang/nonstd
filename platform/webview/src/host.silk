//! The interface every web view backend implements.
//!
//! Like platform-window's `Platform`, it dispatches statically: an app is generic over
//! `H: WebViewHost` and picks a backend type at its entry point. Views are named by ids the
//! client chooses (plain `u32`s, conventionally the id of the ui-tree hosted node or its
//! `SetHostedView` view), so one value owns all native state.
//!
//! The loop belongs to the app. After each frame of the tree, `place` every view where its
//! hosted node's placement says; after each window event (native backends wake the window's
//! `nextEvent` when they queue one), drain `takeEvents`.
import command { Command }
import event { WebViewEvent }
import types { WebViewOptions, WebViewError, Placement, Backend, Capabilities }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub interface WebViewHost {
  /// Makes view `view`, hidden until the first `place`. `Created` follows.
  effect fn open(self: &mut Self, view: u32, options: &WebViewOptions) -> ()
    ! WebViewError | OutOfMemoryError
    ? &mut Allocator

  /// Closes the view at once; `Closed` follows. Later calls with its id do nothing.
  effect fn close(self: &mut Self, view: u32) -> () ! OutOfMemoryError ? &mut Allocator

  /// Moves, clips, shows or hides the view. Cheap when nothing changed.
  fn place(self: &mut Self, view: u32, placement: Placement) -> ()

  /// Runs `command` on the view, in order with earlier commands.
  effect fn send(self: &mut Self, view: u32, command: Command) -> ()
    ! WebViewError | OutOfMemoryError
    ? &mut Allocator

  /// Moves every queued event, oldest first, onto the end of `out`.
  effect fn takeEvents(self: &mut Self, out: &mut List<WebViewEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator

  fn backend(self: &Self) -> Backend

  fn capabilities(self: &Self) -> Capabilities
}
