//! Web views for Silk UIs: one engine-agnostic contract (plain-data commands in, event records
//! out), backends that implement it, and agent control shared by all of them.
pub import types {
  WebViewOptions,
  Placement,
  Backend,
  Capabilities,
  WebViewError,
  ConsoleLevel,
  MOD_SHIFT,
  MOD_CONTROL,
  MOD_ALT,
  MOD_META,
  BUTTON_PRIMARY,
  BUTTON_AUXILIARY,
  BUTTON_SECONDARY
}
pub import command { Command, commandName, requestOf }
pub import event { WebViewEvent, EventKind }
pub import host { WebViewHost }
pub import headless { HeadlessWebViews, HeadlessView }
pub import macos { MacWebViews, ViewFrame }
pub import native { NativeWebViews }
pub import agent {
  Location,
  agentScript,
  agentScriptBytes,
  snapshotCall,
  locateCall,
  focusForFillCall,
  readLocation,
  readError,
  readJsonString,
  isRef
}
