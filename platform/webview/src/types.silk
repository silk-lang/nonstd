//! Plain data every web view backend shares.
import silk.core.ownership { Copy }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// Modifier key flags of pointer and key commands (the same bits as `ui_tree.input`).
pub const MOD_SHIFT: u32 = 1

pub const MOD_CONTROL: u32 = 2

pub const MOD_ALT: u32 = 4

/// Command on macOS, the Windows key elsewhere.
pub const MOD_META: u32 = 8

/// Pointer buttons of pointer commands (the same numbers as `ui_tree.input`).
pub const BUTTON_PRIMARY: u32 = 0

pub const BUTTON_AUXILIARY: u32 = 1

pub const BUTTON_SECONDARY: u32 = 2

/// How a web view is made. Strings are owned, so options can be built once and kept.
pub struct WebViewOptions {
  /// The window the view lives in: a platform-window `WindowId.value`.
  pub window: u32,
  /// The first page to load; empty loads nothing (`about:blank`).
  pub url: String,
  /// Lets the engine's developer tools attach: Safari Web Inspector for WebKit, DevTools for
  /// WebView2 and Chromium.
  pub inspectable: bool,
  /// Keeps cookies and storage under this profile name between runs; empty for a session that
  /// forgets everything when the view closes.
  pub profile: String,
  /// Ask before every main frame navigation: the view queues `NavigationRequested` and waits for
  /// `Command.AnswerNavigation`. Off, every navigation goes ahead.
  pub askBeforeNavigating: bool,
  /// Draws nothing until the page paints, so the node's background shows through.
  pub transparent: bool,
}

impl WebViewOptions {
  /// A view in `window` loading `url`, inspectable, in a forgetful session.
  pub effect fn make(window: u32, url: string) -> WebViewOptions
    ! OutOfMemoryError
    ? &mut Allocator {
    return WebViewOptions {
      window: window,
      url: run String.copy(url),
      inspectable: true,
      profile: String.make(),
      askBeforeNavigating: false,
      transparent: false,
    }
  }
}

/// Where a view goes, in logical points (CSS pixels) from the top left of the window's content
/// area: the same numbers as a ui-tree `HostedPlacement`.
pub struct Placement {
  /// The page's viewport.
  pub bounds: Rect<f32>,
  /// The part of `bounds` that shows. A native child view is clipped to it; an offscreen one is
  /// drawn clipped to it.
  pub clip: Rect<f32>,
  /// Hidden views keep their page but show nothing and take no input.
  pub visible: bool,
  /// Device pixels per point.
  pub scale: f32,
}

impl Copy for Placement {}

impl Placement {
  pub fn hidden() -> Placement {
    let empty = Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
    return Placement { bounds: empty, clip: empty, visible: false, scale: 1.0 }
  }
}

/// Which engine draws the page.
pub enum Backend {
  /// No engine: pages are records, for tests anywhere.
  Headless,
  /// WKWebView, a native child view (macOS).
  WebKit,
  /// WebView2, a native child window (Windows).
  WebView2,
  /// Chromium through CEF, rendered offscreen into a texture (Linux; optional elsewhere).
  Chromium,
}

/// What a backend can do beyond the commands every backend runs.
pub struct Capabilities {
  /// The app can draw its own UI over the page (offscreen backends). Native child views
  /// always cover their bounds.
  pub overlays: bool,
  /// Requests can be intercepted and every response body read. WebKit only sees requests the
  /// page's scripts make.
  pub networkInterception: bool,
  /// The engine speaks the Chrome DevTools Protocol, for tools that want it directly.
  pub devToolsProtocol: bool,
}

impl Copy for Capabilities {}

pub enum WebViewError {
  /// This backend does not run here (no engine on this system or target).
  Unsupported,
  /// The engine refused to create the view.
  CreationFailed,
  /// The id names no open view.
  InvalidView,
  /// The id is already an open view.
  IdInUse,
}

pub enum ConsoleLevel {
  Debug,
  Log,
  Info,
  Warning,
  Error,
}
