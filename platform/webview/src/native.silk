//! The web view backend for the compilation target.
//!
//! - macOS: `macos.MacWebViews` (WKWebView), in platform-window's `MacPlatform` windows.
//! - Windows: `windows.WindowsWebViews` (WebView2), in platform-window's Win32 windows.
//! - Anything else: `headless.HeadlessWebViews` until its backend lands (Chromium on Linux).
static if Intrinsic.targetOperatingSystem() == "darwin" {
  import macos { MacWebViews }
  pub type NativeWebViews = MacWebViews
} else {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    import windows { WindowsWebViews }
    pub type NativeWebViews = WindowsWebViews
  } else {
    import headless { HeadlessWebViews }
    pub type NativeWebViews = HeadlessWebViews
  }
}
