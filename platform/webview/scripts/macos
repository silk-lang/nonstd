#!/usr/bin/env python3
"""Build or run the WebKit backend's smoke test.

  scripts/macos smoke [--build-only] [--release]

Needs macOS 14+. platform/webview/silk.toml compiles the WKWebView bridge and links WebKit, and
platform/window's compiles the AppKit bridge the views live in, so this is a plain `silk run` of
tests/macos.
"""
import argparse
from pathlib import Path
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parent.parent
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import silk_command  # noqa: E402


def smoke(build_only, release):
    command, env = silk_command("build" if build_only else "run", PACKAGE / "tests/macos/silk.toml", release)
    return subprocess.run(command, cwd=REPO, env=env).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["smoke"])
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    if sys.platform != "darwin":
        raise SystemExit("The WebKit smoke test runs only on macOS.")
    return smoke(args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
