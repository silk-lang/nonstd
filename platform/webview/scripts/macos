#!/usr/bin/env python3
"""Build or run the WebKit backend's smoke test or the browser demo.

  scripts/macos smoke [--build-only] [--release]
  scripts/macos demo [--build-only] [--release]

The demo (examples/browser) is a Silk UI toolbar around a live page; it also needs the WebGPU
prerequisites from the repository README (the pinned Dawn downloads on first build).

Needs macOS 14+. platform/webview/silk.toml compiles the WKWebView bridge and links WebKit, and
platform/window's compiles the AppKit bridge the views live in, so this is a plain `silk run` of
tests/native.
"""
import argparse
from pathlib import Path
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
REPO = PACKAGE.parent.parent
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build, silk_command  # noqa: E402


def smoke(build_only, release):
    command, env = silk_command("build" if build_only else "run", PACKAGE / "tests/native/silk.toml", release)
    return subprocess.run(command, cwd=REPO, env=env).returncode


def demo(build_only, release):
    program = build(PACKAGE / "examples/browser", release=release)
    if build_only:
        print(program)
        return 0
    return subprocess.run([str(program)], cwd=REPO).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["smoke", "demo"])
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    if sys.platform != "darwin":
        raise SystemExit("The WebKit smoke test and demo run only on macOS.")
    if args.target == "demo":
        return demo(args.build_only, args.release)
    return smoke(args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
