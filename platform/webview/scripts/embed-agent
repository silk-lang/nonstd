#!/usr/bin/env python3
"""Writes src/generated_agent.silk: agent/agent.js as a byte string, so every backend injects the
same script. `--check` fails when the module is stale.

The package does not use `silk.build.source.Source.read` because a read inside a dependency
package resolves under the dependency's src/ and is lexed as Silk source (see
graphics/demo/scripts/embed-assets).
"""
import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "agent/agent.js"
OUTPUT = ROOT / "src/generated_agent.silk"


def escape(data):
    out = []
    for byte in data:
        if 32 <= byte < 127 and byte not in (34, 92):
            out.append(chr(byte))
        else:
            out.append("\\x%02x" % byte)
    return "".join(out)


def render():
    data = SOURCE.read_bytes()
    return (
        "// Generated by scripts/embed-agent from agent/agent.js; do not edit.\n"
        "/// The page script every backend injects (agent/agent.js), UTF-8.\n"
        "pub fn agentScriptBytes() -> &'static [u8] {\n"
        f'  return b"{escape(data)}"\n'
        "}\n"
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Fail when the module is stale")
    args = parser.parse_args()
    text = render()
    if args.check:
        if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != text:
            print(f"{OUTPUT} is stale; run {Path(__file__).name}", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(text, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
