test effect fn dcLevelShiftAndClipping() -> ()
  ! AssertionError<'static> {
  let mut coefficients: [i32; 64] = [0; 64]
  let quantization: [u16; 64] = [1; 64]
  let neutral = jpeg_idct.block(&coefficients, &quantization)
  coefficients[0] = 1024
  let white = jpeg_idct.block(&coefficients, &quantization)
  coefficients[0] = -2048
  let black = jpeg_idct.block(&coefficients, &quantization)
  let mut i: usize = 0
  while i < 64 {
    run Testing.expect(
      neutral[i] == 128 && white[i] == 255 && black[i] == 0,
      "DC level shift and bounded samples",
    )
    i = i + 1
  }
}
