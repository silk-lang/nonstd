//! PNG color metadata is preserved for the color-management consumer.
import png
import png_decode { PngError, Chromaticities }
import image { ImageError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn metadata() -> ()
  ! PngError | ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let decoded = run png.decodeWithMetadata(
    b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x02\x00\x00\x00\x01\x08\x06\x00\x00\x00\xf4\x22\x7f\x8a\x00\x00\x00\x04\x67\x41\x4d\x41\x00\x00\xb1\x8f\x0b\xfc\x61\x05\x00\x00\x00\x20\x63\x48\x52\x4d\x00\x00\x7a\x26\x00\x00\x80\x84\x00\x00\xfa\x00\x00\x00\x80\xe8\x00\x00\x75\x30\x00\x00\xea\x60\x00\x00\x3a\x98\x00\x00\x17\x70\x9c\xba\x51\x3c\x00\x00\x00\x01\x73\x52\x47\x42\x02\x40\xc0\x7d\xc5\x00\x00\x00\x0e\x49\x44\x41\x54\x78\x9c\x63\xf8\xcf\xc0\xf0\x1f\x04\x01\x10\xf8\x03\xfd\x4e\x95\xc1\x6f\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82",
  )
  run Testing.expect(
    match &decoded.metadata.gamma {
      Option<u32>.Some { value } => value == 45455
      _ => false
    },
    "gamma stored in PNG integer units",
  )
  run Testing.expect(
    match &decoded.metadata.srgbIntent {
      Option<u8>.Some { value } => value == 2
      _ => false
    },
    "sRGB rendering intent",
  )
  run Testing.expect(
    match &decoded.metadata.chromaticities {
      Option<Chromaticities>.Some { value } => value.whiteX == 31270 && value.redX == 64000
        && value.greenY == 60000
        && value.blueY == 6000
      _ => false
    },
    "chromaticity coordinates retained",
  )
  let icc = run png.decodeWithMetadata(
    b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x02\x00\x00\x00\x01\x08\x02\x00\x00\x00\x7b\x40\xe8\xdd\x00\x00\x00\x26\x69\x43\x43\x50\x66\x69\x78\x74\x75\x72\x65\x00\x00\x78\x9c\x63\x60\x60\x68\x61\x40\x02\x41\xee\x4e\x0a\x0c\x68\x20\x31\xb9\xb8\x00\x5d\x8c\x9a\x00\x00\x4f\xaf\x03\x27\xc6\xd0\x7e\xf0\x00\x00\x00\x0f\x49\x44\x41\x54\x78\x9c\x63\xf8\xcf\xc0\xc0\xf0\x9f\x01\x00\x07\xff\x01\xff\x01\x7f\x89\xa7\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82",
  )
  let bytes = icc.metadata.iccProfile.asSlice()
  run Testing.expect(
    bytes.length == 132 && bytes[36] == 97 && bytes[39] == 112,
    "ICC profile decompressed and retained",
  )
}

test effect fn retainsColorMetadata() -> ()
  ! PngError | ImageError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run metadata() |> Effect.provideMut<Allocator>(&mut allocator)
}
