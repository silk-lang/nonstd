//! Decoding a PNG or JPEG file into display-ready samples: premultiplied sRGB RGBA8, with the
//! file's color description applied and its EXIF orientation (JPEG) applied.
import image { Image, ImageError }
import png { PngError, Chromaticities }
import png
import jpeg { JpegError }
import jpeg
import icc { Transform }
import icc
import orientation
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The container formats [`decodeSrgb`] reads, by their signatures.
pub enum Format {
  Png,
  Jpeg,
  Unknown,
}

/// The format `data` starts with.
pub fn sniff(data: &[u8]) -> Format {
  if data.length >= 8 && data[0] == 137 && data[1] == 80 && data[2] == 78 && data[3] == 71
    && data[4] == 13
    && data[5] == 10
    && data[6] == 26
    && data[7] == 10 {
    return Format.Png
  }
  if data.length >= 3 && data[0] == 255 && data[1] == 216 && data[2] == 255 {
    return Format.Jpeg
  }
  return Format.Unknown
}

fn present<T>(value: &Option<T>) -> bool {
  return match &value.* {
    Option<T>.Some { value: _ } => true
    Option<T>.None => false
  }
}

/// The conversion a PNG's color chunks ask for, in PNG-3 §12.2 order: iCCP, then sRGB, then
/// gAMA/cHRM. None means the samples are sRGB already.
pub effect fn pngTransform(metadata: &png.Metadata) -> Option<Transform>
  ! OutOfMemoryError
  ? &mut Allocator {
  let profile = Bytes.asSlice(&metadata.iccProfile)
  if profile.length > 0 {
    return run icc.fromProfile(profile)
  }
  if present<u8>(&metadata.srgbIntent) {
    return Option<Transform>.None
  }
  if present<u32>(&metadata.gamma) || present<Chromaticities>(&metadata.chromaticities) {
    return run icc.fromPng(&metadata.gamma, &metadata.chromaticities)
  }
  return Option<Transform>.None
}

/// The conversion a JPEG's APP2 ICC profile asks for; None means sRGB.
pub effect fn jpegTransform(metadata: &jpeg.Metadata) -> Option<Transform>
  ! OutOfMemoryError
  ? &mut Allocator {
  let profile = Bytes.asSlice(&metadata.iccProfile)
  if profile.length > 0 {
    return run icc.fromProfile(profile)
  }
  return Option<Transform>.None
}

fn convert(transform: &Option<Transform>, target: &mut Image) -> () {
  match &transform.* {
    Option<Transform>.Some { value } => {
      if !icc.isIdentity(&value) {
        icc.apply(&value, &mut target.*)
      }
    }
    Option<Transform>.None => {}
  }
}

/// Decodes a PNG or JPEG file into premultiplied sRGB samples, the way a browser shows an
/// `<img>` with the default `image-orientation: from-image`: embedded ICC profiles and PNG
/// gamma/chromaticities are converted to sRGB, and a JPEG's EXIF orientation is applied.
///
/// Fails with `PngError.Unsupported` for data that is neither format.
pub effect fn decodeSrgb(data: &[u8]) -> Image
  ! PngError | JpegError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  return match sniff(data) {
    Format.Png => {
      let decoded = run png.decodeWithMetadata(data)
      let mut result = move decoded.image
      convert(&(run pngTransform(&decoded.metadata)), &mut result)
      move result
    }
    Format.Jpeg => {
      let decoded = run jpeg.decodeWithMetadata(data)
      let mut result = move decoded.image
      convert(&(run jpegTransform(&decoded.metadata)), &mut result)
      if decoded.metadata.orientation > 1 && decoded.metadata.orientation <= 8 {
        run orientation.apply(&result, decoded.metadata.orientation)
      } else {
        move result
      }
    }
    Format.Unknown => {
      fail PngError.Unsupported
    }
  }
}
