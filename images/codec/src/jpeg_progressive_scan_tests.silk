}

effect fn separateBody() -> ()
  ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let decoded = run jpeg.decode(
    b"\xff\xd8\xff\xdb\x00\x43\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\xff\xc0\x00\x11\x08\x00\x07\x00\x09\x03\x01\x22\x00\x02\x11\x00\x03\x11\x00\xff\xc4\x00\x26\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xda\x00\x08\x01\x01\x00\x00\x3f\x00\x0f\xff\xda\x00\x08\x01\x02\x00\x00\x3f\x00\x3f\xff\xda\x00\x08\x01\x03\x00\x00\x3f\x00\x3f\xff\xd9",
  )
  let pixels = decoded.data()
  let mut i: usize = 0
  while i < pixels.length {
    run Testing.expect(
      pixels[i] == 128 && pixels[i + 1] == 128 && pixels[i + 2] == 128 && pixels[i + 3] == 255,
      "separate sequential components",
    )
    i = i + 4
  }
}

test effect fn separateSequentialScans() -> ()
  ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run separateBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
