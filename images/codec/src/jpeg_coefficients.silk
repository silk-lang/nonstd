//! JPEG sequential coefficient reconstruction, ITU T.81 Annex F.
import jpeg_entropy { Reader, Table }
import jpeg_header { JpegError }
import silk.num.u8
import silk.num.u32

pub const ZIGZAG: [usize; 64] = [
  0,
  1,
  8,
  16,
  9,
  2,
  3,
  10,
  17,
  24,
  32,
  25,
  18,
  11,
  4,
  5,
  12,
  19,
  26,
  33,
  40,
  48,
  41,
  34,
  27,
  20,
  13,
  6,
  7,
  14,
  21,
  28,
  35,
  42,
  49,
  56,
  57,
  50,
  43,
  36,
  29,
  22,
  15,
  23,
  30,
  37,
  44,
  51,
  58,
  59,
  52,
  45,
  38,
  31,
  39,
  46,
  53,
  60,
  61,
  54,
  47,
  55,
  62,
  63,
]

/// Decodes one 8-bit sequential block into natural row-major coefficient order.
/// The caller resets the component's DC predictor at scan/restart boundaries.
pub effect fn sequential(
  reader: &mut Reader,
  dc: &Table,
  ac: &Table,
  predictor: &mut i32,
) -> [i32; 64]
  ! JpegError {
  let mut block: [i32; 64] = [0; 64]
  let category = run dc.decode(&mut reader.*)
  if category > 11 || predictor.* < -32767 || predictor.* > 32767 {
    fail JpegError.InvalidData
  }
  let difference = run reader.receive(category)
  let value = predictor.* + difference
  if value < -32767 || value > 32767 {
    fail JpegError.InvalidData
  }
  predictor.* = value
  block[0] = value
  let mut index: usize = 1
  while index < 64 {
    let symbol = run ac.decode(&mut reader.*)
    let zeroes = u32.toUsize(u8.toU32(symbol / 16))
    let size = symbol % 16
    if size == 0 {
      if zeroes == 0 {
        break
      }
      if zeroes != 15 || index + 16 > 64 {
        fail JpegError.InvalidData
      }
      index = index + 16
    } else {
      if size > 10 || index + zeroes >= 64 {
        fail JpegError.InvalidData
      }
      index = index + zeroes
      block[ZIGZAG[index]] = run reader.receive(size)
      index = index + 1
    }
  }
  return block
}
