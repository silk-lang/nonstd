//! Progressive spectral selection and successive approximation (T.81 Annex G).
import jpeg_progressive
import silk.core.effect { Effect }
import silk.core.result { Result }
import jpeg_entropy { Reader, Table }
import jpeg_coefficients { ZIGZAG }
import jpeg_header { JpegError }
import silk.testing.testing { Testing, AssertionError }

test effect fn dcFirstAndRefinement() -> ()
  ! JpegError | AssertionError<'static> {
  let dc = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x02",
  )
  let mut block: [i32; 64] = [0; 64]
  let mut predictor: i32 = 0
  let mut first = Reader.make(b"\x3f")
  run jpeg_progressive.dcFirst(&mut first, &dc, &mut predictor, 1, &mut block)
  run Testing.expect(block[0] == -4, "negative point-transformed DC")
  let mut refinement = Reader.make(b"\xff\x00")
  run jpeg_progressive.dcRefine(&mut refinement, 0, &mut block)
  run Testing.expect(block[0] == -3, "DC refinement appends low signed bit")
}

test effect fn acEndOfBandRunSpansBlocks() -> ()
  ! JpegError | AssertionError<'static> {
  let ac = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x10",
  )
  let mut reader = Reader.make(b"\x7f")
  let mut block: [i32; 64] = [0; 64]
  let mut eob: u32 = 0
  run jpeg_progressive.acFirst(&mut reader, &ac, 1, 63, 0, &mut eob, &mut block)
  run Testing.expect(eob == 2, "EOB1 plus one means three blocks, current consumed")
  run jpeg_progressive.acFirst(&mut reader, &ac, 1, 63, 0, &mut eob, &mut block)
  run jpeg_progressive.acFirst(&mut reader, &ac, 1, 63, 0, &mut eob, &mut block)
  run Testing.expect(
    eob == 0 && reader.offset() == 1,
    "remaining blocks consume no additional entropy",
  )
}

test effect fn acRefinesExistingAndIntroducesNegative() -> ()
  ! JpegError | AssertionError<'static> {
  let ac = run Table.make(
    b"\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x01\x00",
  )
  let mut block: [i32; 64] = [0; 64]
  block[ZIGZAG[1]] = 2
  block[ZIGZAG[3]] = -2
  let mut eob: u32 = 0
  let mut reader = Reader.make(b"\x37")
  run jpeg_progressive.acRefine(&mut reader, &ac, 1, 3, 0, &mut eob, &mut block)
  run Testing.expect(
    block[ZIGZAG[1]] == 3 && block[ZIGZAG[2]] == -1 && block[ZIGZAG[3]] == -3,
    "correction bits follow sign and EOB codes, preserving coefficient sign",
  )
}

test effect fn rejectsInvalidBandsAndRuns() -> ()
  ! JpegError | AssertionError<'static> {
  let ac = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\xf0",
  )
  let mut block: [i32; 64] = [0; 64]
  let mut eob: u32 = 0
  let mut reader = Reader.make(b"\x7f")
  let overrun = run Effect.result(
    jpeg_progressive.acFirst(&mut reader, &ac, 1, 3, 0, &mut eob, &mut block),
  )
  run Testing.expect(
    match &overrun {
      Result<(), JpegError>.Failure { error } => true
      _ => false
    },
    "ZRL cannot cross spectral band",
  )
  let invalidBand = run Effect.result(
    jpeg_progressive.acRefine(&mut reader, &ac, 0, 63, 0, &mut eob, &mut block),
  )
  run Testing.expect(
    match &invalidBand {
      Result<(), JpegError>.Failure { error } => true
      _ => false
    },
    "AC band cannot include DC",
  )
  let invalidShift = run Effect.result(jpeg_progressive.dcRefine(&mut reader, 14, &mut block))
  run Testing.expect(
    match &invalidShift {
      Result<(), JpegError>.Failure { error } => true
      _ => false
    },
    "approximation bit is bounded",
  )
}
