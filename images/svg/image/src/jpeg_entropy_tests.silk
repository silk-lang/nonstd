//! ITU T.81 Annex C/F: canonical Huffman codes and entropy byte stuffing.
import jpeg_entropy { Reader, Table }
import jpeg_header { JpegError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }

test effect fn canonicalCodesAndSignedValues() -> ()
  ! JpegError | AssertionError<'static> {
  // Symbols 5, 7, 9 have canonical codes 0, 100, 101; all-one codes stay unused.
  let table = run Table.make(
    b"\x01\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x05\x07\x09",
  )
  let mut reader = Reader.make(b"\x4a\x9f")
  run Testing.expect((run table.decode(&mut reader)) == 5, "one-bit code")
  run Testing.expect((run table.decode(&mut reader)) == 7, "first three-bit code")
  run Testing.expect((run table.decode(&mut reader)) == 9, "second three-bit code")
  run Testing.expect((run reader.receive(3)) == -5, "JPEG negative coefficient extension")
  run Testing.expect((run reader.receive(3)) == -4, "second negative coefficient")
}

test effect fn stuffingAndRestart() -> ()
  ! JpegError | AssertionError<'static> {
  let mut reader = Reader.make(b"\xff\x00\x7f\xff\xd0\x80")
  run Testing.expect((run reader.bits(8)) == 255, "FF00 represents an entropy FF byte")
  run Testing.expect((run reader.bits(1)) == 0, "one sample before padding")
  run reader.restart(0)
  run Testing.expect((run reader.bits(8)) == 128, "restart begins at a fresh byte")
}

test effect fn rejectsReservedAndOversubscribedCodes() -> ()
  ! AssertionError<'static> {
  let reserved = run Effect.result(
    Table.make(b"\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", b"\x00\x01"),
  )
  run Testing.expect(
    match &reserved {
      Result<Table, JpegError>.Failure { error } => true
      _ => false
    },
    "all-ones code reserved",
  )
  let over = run Effect.result(
    Table.make(
      b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      b"\x00\x01\x02",
    ),
  )
  run Testing.expect(
    match &over {
      Result<Table, JpegError>.Failure { error } => true
      _ => false
    },
    "oversubscribed tree rejected",
  )
}

test effect fn rejectsMarkersAndWrongRestart() -> ()
  ! AssertionError<'static> {
  let mut marker = Reader.make(b"\xff\xd9")
  let read = run Effect.result(marker.bits(1))
  run Testing.expect(
    match &read {
      Result<u32, JpegError>.Failure { error } => true
      _ => false
    },
    "EOI is not entropy data",
  )
  let mut wrong = Reader.make(b"\xff\xd1")
  let restart = run Effect.result(wrong.restart(0))
  run Testing.expect(
    match &restart {
      Result<(), JpegError>.Failure { error } => true
      _ => false
    },
    "restart sequence checked",
  )
}
