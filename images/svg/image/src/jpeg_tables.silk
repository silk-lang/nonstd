//! Quantization, Huffman and restart tables shared by sequential/progressive scans.
import jpeg_header { JpegError }
import jpeg_entropy { Table }
import jpeg_coefficients { ZIGZAG }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.num.u8
import silk.num.u32

pub struct Tables {
  pub quantization: [[u16; 64]; 4],
  pub present: [bool; 4],
  pub dc: [Option<Table>; 4],
  pub ac: [Option<Table>; 4],
  pub restartInterval: usize,
}

fn be16(data: &[u8], at: usize) -> u32 {
  return u8.toU32(data[at]) * 256 + u8.toU32(data[at + 1])
}

impl Tables {
  pub fn make() -> Tables {
    return Tables {
      quantization: [[0; 64]; 4],
      present: [false; 4],
      dc: [Option<Table>.None; 4],
      ac: [Option<Table>.None; 4],
      restartInterval: 0,
    }
  }

  pub effect fn segment(self: &mut Self, marker: u8, payload: &[u8]) -> ()
    ! JpegError {
    if marker == 219 {
      let mut at: usize = 0
      while at < payload.length {
        let precision = payload[at] / 16
        let index = u32.toUsize(u8.toU32(payload[at] % 16))
        at = at + 1
        if precision > 1 || index > 3 {
          fail JpegError.InvalidData
        }
        let bytes: usize = if precision == 0 {
          1
        } else {
          2
        }
        if payload.length - at < bytes * 64 {
          fail JpegError.InvalidData
        }
        let mut i: usize = 0
        while i < 64 {
          let value = if bytes == 1 {
            u8.toU32(payload[at])
          } else {
            be16(payload, at)
          }
          if value == 0 {
            fail JpegError.InvalidData
          }
          self.quantization[index][ZIGZAG[i]] = u32.toU16(value)
          at = at + bytes
          i = i + 1
        }
        self.present[index] = true
      }
    } else if marker == 196 {
      let mut at: usize = 0
      while at < payload.length {
        if payload.length - at < 17 {
          fail JpegError.InvalidData
        }
        let kind = payload[at] / 16
        let index = u32.toUsize(u8.toU32(payload[at] % 16))
        if kind > 1 || index > 3 {
          fail JpegError.InvalidData
        }
        let counts = Slice.view<u8>(payload, at + 1, 16)
        let mut count: usize = 0
        let mut i: usize = 0
        while i < 16 {
          count = count + u32.toUsize(u8.toU32(counts[i]))
          i = i + 1
        }
        at = at + 17
        if count > payload.length - at {
          fail JpegError.InvalidData
        }
        let table = run Table.make(counts, Slice.view<u8>(payload, at, count))
        if kind == 0 {
          self.dc[index] = Option<Table>.some(table)
        } else {
          self.ac[index] = Option<Table>.some(table)
        }
        at = at + count
      }
    } else if marker == 221 {
      if payload.length != 2 {
        fail JpegError.InvalidData
      }
      self.restartInterval = u32.toUsize(be16(payload, 0))
    } else if marker == 204 {
      fail JpegError.Unsupported
    }
  }
}
