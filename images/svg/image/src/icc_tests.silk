  return b"\x00\x00\x01\x2c\x6e\x6f\x6e\x65\x02\x40\x00\x00\x6d\x6e\x74\x72\x52\x47\x42\x20\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x61\x63\x73\x70\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf6\xd6\x00\x01\x00\x00\x00\x00\xd3\x2d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x72\x58\x59\x5a\x00\x00\x00\xcc\x00\x00\x00\x14\x67\x58\x59\x5a\x00\x00\x00\xe0\x00\x00\x00\x14\x62\x58\x59\x5a\x00\x00\x00\xf4\x00\x00\x00\x14\x72\x54\x52\x43\x00\x00\x01\x08\x00\x00\x00\x0c\x67\x54\x52\x43\x00\x00\x01\x14\x00\x00\x00\x0c\x62\x54\x52\x43\x00\x00\x01\x20\x00\x00\x00\x0c\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x6f\xa3\x00\x00\x38\xf6\x00\x00\x03\x91\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x62\x94\x00\x00\xb7\x85\x00\x00\x18\xdc\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x24\xa1\x00\x00\x0f\x85\x00\x00\xb6\xd4\x63\x75\x72\x76\x00\x00\x00\x00\x00\x00\x00\x00\x63\x75\x72\x76\x00\x00\x00\x00\x00\x00\x00\x00\x63\x75\x72\x76\x00\x00\x00\x00\x00\x00\x00\x00"
