// sRGB colorants with the parametric type 3 sRGB curve.
fn srgbProfile() -> &'static [u8] {
  return b"\x00\x00\x01\x68\x6e\x6f\x6e\x65\x02\x40\x00\x00\x6d\x6e\x74\x72\x52\x47\x42\x20\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x61\x63\x73\x70\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf6\xd6\x00\x01\x00\x00\x00\x00\xd3\x2d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x72\x58\x59\x5a\x00\x00\x00\xcc\x00\x00\x00\x14\x67\x58\x59\x5a\x00\x00\x00\xe0\x00\x00\x00\x14\x62\x58\x59\x5a\x00\x00\x00\xf4\x00\x00\x00\x14\x72\x54\x52\x43\x00\x00\x01\x08\x00\x00\x00\x20\x67\x54\x52\x43\x00\x00\x01\x28\x00\x00\x00\x20\x62\x54\x52\x43\x00\x00\x01\x48\x00\x00\x00\x20\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x6f\xa3\x00\x00\x38\xf6\x00\x00\x03\x91\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x62\x94\x00\x00\xb7\x85\x00\x00\x18\xdc\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x24\xa1\x00\x00\x0f\x85\x00\x00\xb6\xd4\x70\x61\x72\x61\x00\x00\x00\x00\x00\x03\x00\x00\x00\x02\x66\x66\x00\x00\xf2\xa7\x00\x00\x0d\x59\x00\x00\x13\xd0\x00\x00\x0a\x5b\x70\x61\x72\x61\x00\x00\x00\x00\x00\x03\x00\x00\x00\x02\x66\x66\x00\x00\xf2\xa7\x00\x00\x0d\x59\x00\x00\x13\xd0\x00\x00\x0a\x5b\x70\x61\x72\x61\x00\x00\x00\x00\x00\x03\x00\x00\x00\x02\x66\x66\x00\x00\xf2\xa7\x00\x00\x0d\x59\x00\x00\x13\xd0\x00\x00\x0a\x5b"
}

// Gray profile with gamma 1.0 (u8Fixed8 curv).
fn grayProfile() -> &'static [u8] {
  return b"\x00\x00\x00\xa0\x6e\x6f\x6e\x65\x02\x40\x00\x00\x6d\x6e\x74\x72\x47\x52\x41\x59\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x61\x63\x73\x70\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf6\xd6\x00\x01\x00\x00\x00\x00\xd3\x2d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x6b\x54\x52\x43\x00\x00\x00\x90\x00\x00\x00\x10\x63\x75\x72\x76\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00\x00\x00"
}

// Only an A2B0 lut16Type tag.
fn lutProfile() -> &'static [u8] {
  return b"\x00\x00\x00\xc0\x6e\x6f\x6e\x65\x02\x40\x00\x00\x6d\x6e\x74\x72\x52\x47\x42\x20\x58\x59\x5a\x20\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x61\x63\x73\x70\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf6\xd6\x00\x01\x00\x00\x00\x00\xd3\x2d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x41\x32\x42\x30\x00\x00\x00\x90\x00\x00\x00\x30\x6d\x66\x74\x32\x00\x00\x00\x00\x03\x03\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
}

effect fn pixel(r: u8, g: u8, b: u8, a: u8) -> Image
  ! ImageError | OutOfMemoryError
  ? &mut Allocator {
  let mut value = run Image.make(1, 1)
  let data = value.dataMut()
  data[0] = r
  data[1] = g
  data[2] = b
  data[3] = a
  drop data
  return move value
}

fn sample(value: &Image, r: u8, g: u8, b: u8, a: u8) -> bool {
  let data = value.data()
  return data[0] == r && data[1] == g && data[2] == b && data[3] == a
}

effect fn converted(transform: &Option<Transform>, r: u8, g: u8, b: u8, a: u8) -> Image
  ! ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut value = run pixel(r, g, b, a)
  match &transform.* {
    Option<Transform>.Some { value: t } => icc.apply(&t, &mut value)
    Option<Transform>.None => {
      run Testing.expect(false, "profile accepted")
    }
  }
  return move value
}

fn accepted(transform: &Option<Transform>) -> bool {
  return match &transform.* {
    Option<Transform>.Some { value: _ } => true
    Option<Transform>.None => false
  }
}

fn identity(transform: &Option<Transform>) -> bool {
  return match &transform.* {
    Option<Transform>.Some { value } => icc.isIdentity(&value)
    Option<Transform>.None => false
  }
}

// https://www.color.org/specification/ICC.1-2022-05.pdf#page=115 (F.3 matrix/TRC)
effect fn matrixProfiles() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let linear = run icc.fromProfile(linearProfile())
  let gray = run converted(&linear, 128, 128, 128, 255)
  run Testing.expect(sample(&gray, 188, 188, 188, 255), "linear-light 128 encodes as sRGB 188")
  let colour = run converted(&linear, 200, 40, 90, 255)
  run Testing.expect(sample(&colour, 229, 110, 160, 255), "each channel through the matrix")

  // Premultiplied 200,40,90 at alpha 128 is 100,20,45; straight values convert, then multiply.
  let translucent = run converted(&linear, 100, 20, 45, 128)
  run Testing.expect(sample(&translucent, 115, 55, 80, 128), "alpha is kept")
  let clear = run converted(&linear, 0, 0, 0, 0)
  run Testing.expect(sample(&clear, 0, 0, 0, 0), "transparent stays transparent")
  run Testing.expect(!identity(&linear), "linear profile changes samples")
  let srgb = run icc.fromProfile(srgbProfile())
  run Testing.expect(identity(&srgb), "an sRGB profile is skipped")
}

// https://www.color.org/specification/ICC.1-2022-05.pdf#page=115 (F.2 grayTRCTag)
effect fn grayProfiles() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let gray = run icc.fromProfile(grayProfile())
  let value = run converted(&gray, 128, 128, 128, 255)
  run Testing.expect(sample(&value, 188, 188, 188, 255), "gray TRC maps to the PCS white")
}

// https://www.color.org/specification/ICC.1-2022-05.pdf#page=115
// Library policy: profiles without a matrix/TRC model are not applied (LUTs are phase 12C).
effect fn rejectedProfiles() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run Testing.expect(!accepted(&(run icc.fromProfile(lutProfile()))), "lutProfile()-only profile")
  run Testing.expect(
    !accepted(&(run icc.fromProfile(Slice.view<u8>(linearProfile(), 0, 200)))),
    "truncated profile",
  )
  run Testing.expect(!accepted(&(run icc.fromProfile(b""))), "empty profile")
}

// https://www.w3.org/TR/png-3/#11gAMA
// https://www.w3.org/TR/png-3/#11cHRM
effect fn pngDescriptions() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let linear = run icc.fromPng(&Option<u32>.Some { value: 100000 }, &Option<Chromaticities>.None)
  let value = run converted(&linear, 128, 128, 128, 255)
  run Testing.expect(sample(&value, 188, 188, 188, 255), "gAMA 1.0 is linear light")
  let primaries = Chromaticities {
    whiteX: 31270,
    whiteY: 32900,
    redX: 64000,
    redY: 33000,
    greenX: 30000,
    greenY: 60000,
    blueX: 15000,
    blueY: 6000,
  }
  let srgb = run icc.fromPng(&Option<u32>.None, &Option<Chromaticities>.Some { value: primaries })
  run Testing.expect(identity(&srgb), "sRGB primaries without gAMA keep samples")
  let zero = run icc.fromPng(&Option<u32>.Some { value: 0 }, &Option<Chromaticities>.None)
  run Testing.expect(!accepted(&zero), "gAMA zero is ignored")
}

test effect fn iccConversion() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matrixProfiles() |> Effect.provideMut<Allocator>(&mut allocator)
  run grayProfiles() |> Effect.provideMut<Allocator>(&mut allocator)
  run rejectedProfiles() |> Effect.provideMut<Allocator>(&mut allocator)
  run pngDescriptions() |> Effect.provideMut<Allocator>(&mut allocator)
}
