//! Source colour conversion contracts for embedded profiles and PNG gAMA/cHRM.
//! Profiles are crafted by images/svg/scripts/color-fixtures.py, whose independent
//! evaluation also produced the expected samples.
import icc { Transform }
import icc
import image { Image, ImageError }
import png_decode { Chromaticities }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

