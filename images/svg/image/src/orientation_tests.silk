//! All EXIF orientation permutations on an asymmetric labelled pixel grid.
import image { Image, ImageError }
import orientation
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

effect fn permutations() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut source = run Image.make(3, 2)
  let input = source.dataMut()
  let mut i: usize = 0
  while i < 6 {
    input[i * 4] = usize.toU8(i + 1)
    input[i * 4 + 1] = usize.toU8(i + 11)
    input[i * 4 + 2] = usize.toU8(i + 21)
    input[i * 4 + 3] = usize.toU8(i + 31)
    i = i + 1
  }
  drop input
  let expected: [[u8; 6]; 8] = [
    [1, 2, 3, 4, 5, 6],
    [3, 2, 1, 6, 5, 4],
    [6, 5, 4, 3, 2, 1],
    [4, 5, 6, 1, 2, 3],
    [1, 4, 2, 5, 3, 6],
    [4, 1, 5, 2, 6, 3],
    [6, 3, 5, 2, 4, 1],
    [3, 6, 2, 5, 1, 4],
  ]
  let mut value: usize = 0
  while value < 8 {
    let output = run orientation.apply(&source, usize.toU8(value + 1))
    let width: u32 = if value < 4 {
      3
    } else {
      2
    }
    let height: u32 = if value < 4 {
      2
    } else {
      3
    }
    run Testing.expect(output.width() == width && output.height() == height, "oriented dimensions")
    let pixels = output.data()
    i = 0
    while i < 6 {
      let label = expected[value][i]
      run Testing.expect(
        pixels[i * 4] == label && pixels[i * 4 + 1] == label + 10 && pixels[i * 4 + 2] == label + 20
          && pixels[i * 4 + 3] == label + 30,
        "all channels preserve the exact pixel permutation",
      )
      i = i + 1
    }
    value = value + 1
  }
  run Testing.expect(
    source.width() == 3 && source.height() == 2 && source.data()[0] == 1,
    "source remains unchanged",
  )
}

test effect fn allExifOrientations() -> ()
  ! ImageError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run permutations() |> Effect.provideMut<Allocator>(&mut allocator)
}
