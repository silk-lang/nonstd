//! Owned, row-major premultiplied RGBA8 in the sRGB color space.
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64

/// Maximum pixel count: 64 Mi pixels, or 256 MiB of RGBA storage.
/// This also keeps all encoder buffer lengths below signed 32-bit allocation bounds.
pub const MAX_PIXELS: u64 = 67108864

/// Image construction or encoding failed without producing a partial image or PNG.
pub enum ImageError {
  /// Either dimension is zero or exceeds PNG's unsigned 31-bit dimension range.
  InvalidDimensions,
  /// The pixel count exceeds MAX_PIXELS.
  TooLarge,
  /// A borrowed RGBA slice does not contain exactly width * height * 4 bytes.
  LengthMismatch,
  /// The stdlib compressor exhausted the precomputed output bound.
  CompressionFailed,
}

/// An owned tightly packed image. Each pixel is red, green, blue, alpha, with no row padding.
/// RGB values are sRGB-encoded and premultiplied by alpha; dropping the image frees its bytes.
pub struct Image {
  pixelWidth: u32,
  pixelHeight: u32,
  pixels: Bytes,
}

impl Image {
  /// Allocates a transparent-black image after validating dimensions and byte length.
  /// Dimensions must be 1..2147483647 and their product at most MAX_PIXELS.
  /// Size errors are reported before allocation; allocator failures remain OutOfMemoryError.
  pub effect fn make(width: u32, height: u32) -> Image
    ! ImageError | OutOfMemoryError
    ? &mut Allocator {
    let length = run Image.validateSize(width, height)
    let pixels = run Bytes.zeroed(length)
    return Image { pixelWidth: width, pixelHeight: height, pixels: move pixels }
  }

  /// Returns the checked RGBA byte length without allocating.
  /// Uses the same dimension and pixel-count limits as make and PNG encoding.
  pub effect fn validateSize(width: u32, height: u32) -> usize
    ! ImageError {
    if width == 0 || height == 0 || width > 2147483647 || height > 2147483647 {
      fail ImageError.InvalidDimensions
    }

    // Widen before multiplying: two accepted 31-bit dimensions fit in u64.
    let count = u32.toU64(width) * u32.toU64(height)
    if count > MAX_PIXELS {
      fail ImageError.TooLarge
    }

    // The pixel ceiling proves count * 4 fits usize on both native and wasm32.
    return u64.toUsize(count * 4)
  }

  /// Returns the number of pixels in a row.
  pub fn width(self: &Image) -> u32 {
    return self.pixelWidth
  }

  /// Returns the number of rows.
  pub fn height(self: &Image) -> u32 {
    return self.pixelHeight
  }

  /// Borrows exactly width * height * 4 premultiplied RGBA bytes, top row first.
  pub fn data(self: &Image) -> &[u8] {
    return Bytes.asSlice(&self.pixels)
  }

  /// Borrows the pixel bytes for in-place rendering, without changing their length.
  /// Callers should keep each RGB channel no greater than alpha.
  pub fn dataMut(self: &mut Image) -> &mut [u8] {
    return Bytes.asMutSlice(&mut self.pixels)
  }
}
