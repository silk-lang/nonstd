//! Baseline JPEG coefficient reconstruction, before dequantization and IDCT.
import jpeg_coefficients
import jpeg_entropy { Table, Reader }
import jpeg_header { JpegError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }

test effect fn reconstructsDifferentialDc() -> ()
  ! JpegError | AssertionError<'static> {
  let dc = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x02",
  )
  let ac = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00",
  )
  let mut predictor: i32 = 3
  let mut positive = Reader.make(b"\x4f")
  let first = run jpeg_coefficients.sequential(&mut positive, &dc, &ac, &mut predictor)
  run Testing.expect(
    first[0] == 5 && predictor == 5 && first[63] == 0,
    "positive DC difference and EOB",
  )
  let mut negative = Reader.make(b"\x0f")
  let second = run jpeg_coefficients.sequential(&mut negative, &dc, &ac, &mut predictor)
  run Testing.expect(second[0] == 2 && predictor == 2, "negative DC difference")
}

test effect fn reconstructsAcRunInNaturalOrder() -> ()
  ! JpegError | AssertionError<'static> {
  let dc = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00",
  )
  let ac = run Table.make(
    b"\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00\x11",
  )
  let mut predictor: i32 = 0
  let mut reader = Reader.make(b"\x57")
  let block = run jpeg_coefficients.sequential(&mut reader, &dc, &ac, &mut predictor)
  run Testing.expect(
    block[8] == 1 && block[1] == 0 && block[0] == 0,
    "zero run followed by zigzag index two",
  )
}

test effect fn rejectsAcRunPastBlock() -> ()
  ! JpegError | AssertionError<'static> {
  let dc = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\x00",
  )
  let ac = run Table.make(
    b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    b"\xf0",
  )
  let mut predictor: i32 = 0
  let mut reader = Reader.make(b"\x07")
  let result = run Effect.result(
    jpeg_coefficients.sequential(&mut reader, &dc, &ac, &mut predictor),
  )
  run Testing.expect(
    match &result {
      Result<[i32; 64], JpegError>.Failure { error } => true
      _ => false
    },
    "run cannot overrun coefficient array",
  )
}
