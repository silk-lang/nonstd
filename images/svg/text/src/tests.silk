test effect fn vertical() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run setsVerticalText() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn near(a: f64, b: f64) -> bool {
  return f64.abs(a - b) < 0.000000001
}

// text-align places each line in its part of the area and text-anchor does not apply; a
// justified line spreads over its separators, and the last line takes text-align-last
// (CSS Text 3 #text-align-property, SVG 2 #TextAnchoringProperties).
effect fn alignsInShapes() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let line: [u32; 9] = [0x41, 0x20, 0x41, 0x20, 0x41, 0x20, 0x41, 0x20, 0x41]
  let mut spans = [run span(&[SANS], Anchor.Middle)]
  spans[0].lineHeight = Option<f64>.Some { value: 120.0 }

  // "A A A " fills the first line of a 300 wide area; "A A" is the last.
  let mut text = run characters(&line)
  let area = run rectangle(10.0, 20.0, 310.0, 270.0)
  run wrapInAreas(&fonts, &spans, &mut text, &[move area], &[], true, Align.Start, Align.Start)
  let mut result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  run Testing.expect(near(glyph(&result, 0).x, 10.0), "start ignores text-anchor")
  run Testing.expect(near(glyph(&result, 6).x, 10.0), "the last line at start")

  text = run characters(&line)
  let wide = run rectangle(10.0, 20.0, 310.0, 270.0)
  run wrapInAreas(&fonts, &spans, &mut text, &[move wide], &[], true, Align.Right, Align.Center)
  result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let right = glyph(&result, 4).x + glyph(&result, 4).advance
  run Testing.expect(near(right, 310.0), "right")
  let middle = (glyph(&result, 6).x + glyph(&result, 8).x + glyph(&result, 8).advance) / 2.0
  run Testing.expect(near(middle, 160.0), "text-align-last center")

  text = run characters(&line)
  let justified = run rectangle(10.0, 20.0, 310.0, 270.0)
  run wrapInAreas(
    &fonts,
    &spans,
    &mut text,
    &[move justified],
    &[],
    true,
    Align.Justify,
    Align.Start,
  )
  result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  run Testing.expect(near(glyph(&result, 0).x, 10.0), "justified from the left")
  let end = glyph(&result, 4).x + glyph(&result, 4).advance
  run Testing.expect(near(end, 310.0), "justified to the right")
  let first = glyph(&result, 2).x - (glyph(&result, 0).x + glyph(&result, 0).advance)
  let second = glyph(&result, 4).x - (glyph(&result, 2).x + glyph(&result, 2).advance)
  run Testing.expect(near(first, second), "even gaps")
  run Testing.expect(near(glyph(&result, 6).x, 10.0), "the last line is not justified")
}

test effect fn shapes() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run findsAvailableSpans() |> Effect.provideMut<Allocator>(&mut allocator)
  run wrapsInShapes() |> Effect.provideMut<Allocator>(&mut allocator)
  run alignsInShapes() |> Effect.provideMut<Allocator>(&mut allocator)
  run growsShapes() |> Effect.provideMut<Allocator>(&mut allocator)
}
