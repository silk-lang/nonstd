//! Text layout tests over the subset fonts in images/svg/tests/fonts. Glyph ids and
//! advances are HarfBuzz's for the same fonts and text (uharfbuzz).
import layout { Anchor, Span, Character, PlacedGlyph, Layout, Instance, layout }
import svg_fonts.database { FontDatabase }
import svg_fonts.matching { Selection }
import silk.platform.native.host_input { NativeHostInput }
import silk.system.host_input { HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

const SANS: usize = 0

const MONO: usize = 1

effect fn read(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run NativeHostInput.workingDirectory()
  let root = run Path.fromBytes(Bytes.asSlice(&cwd))
  let mut relative = run String.copy("images/svg/tests/fonts/")
  run String.append(&mut relative, name)
  let path = run Path.resolve(&root, String.view(&relative))
  let mut files = run OsFileSystem.make("/")
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn loaded() -> FontDatabase
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut fonts = FontDatabase.make()
  drop run fonts.add(run read("NotoSans-Regular.subset.ttf"))
  drop run fonts.add(run read("NotoMono-Regular.subset.ttf"))
  return move fonts
}

fn regular(face: usize) -> Selection {
  return Selection {
    face: face,
    weight: 400.0,
    width: 100.0,
    italic: Option<f64>.None,
    oblique: Option<f64>.None,
    syntheticOblique: 0.0,
    syntheticBold: false,
  }
}

effect fn span(faces: &[usize], anchor: Anchor) -> Span
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut selections = List<Selection>.make()
  let mut index: usize = 0
  while index < faces.length {
    run List<Selection>.append(&mut selections, regular(faces[index]))
    index = index + 1
  }
  return Span { faces: move selections, size: 100.0, anchor: anchor }
}

fn plain(cp: u32) -> Character {
  return Character {
    cp: cp,
    span: 0,
    x: Option<f64>.None,
    y: Option<f64>.None,
    dx: 0.0,
    dy: 0.0,
    rotate: 0.0,
  }
}

effect fn characters(text: &[u32]) -> List<Character>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Character>.make()
  let mut index: usize = 0
  while index < text.length {
    run List<Character>.append(&mut out, plain(text[index]))
    index = index + 1
  }
  return move out
}

fn glyph(result: &Layout, index: usize) -> PlacedGlyph {
  return List<PlacedGlyph>.asSlice(&result.glyphs)[index]
}

effect fn expectGlyph(result: &Layout, index: usize, id: u32, x: f64, y: f64) -> ()
  ! AssertionError<'static> {
  let placed = glyph(result, index)
  run Testing.expect(placed.glyph == id, "glyph id")
  run Testing.expect(placed.x == x, "glyph x")
  run Testing.expect(placed.y == y, "glyph y")
}

// https://www.w3.org/TR/SVG2/text.html#TextLayoutAlgorithm "CSS layout": glyphs follow the
// shaper's advances, kerning included.
effect fn shapesAlongTheBaseline() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[SANS], Anchor.Start)]
  let text = run characters(&[0x41, 0x56, 0x41])
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  let s = 100.0 / 1000.0
  run Testing.expect(List<PlacedGlyph>.length(&result.glyphs) == 3, "one glyph per letter")
  run expectGlyph(&result, 0, 34, 0.0, 0.0)
  run expectGlyph(&result, 1, 55, 599.0 * s, 0.0)
  run expectGlyph(&result, 2, 34, 599.0 * s + 560.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).advance == 560.0 * s, "the kerned advance")
  let instance = &List<Instance>.asSlice(&result.instances)[0]
  run Testing.expect(instance.ascent > 0.0 && instance.descent > 0.0, "line metrics are read")
}

// #TextLayoutAlgorithm: positioning values on a character that is not the first of its
// typographic character are ignored, and a mark keeps the shaper's offset.
effect fn keepsClustersTogether() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x71, 0x0301, 0x78])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[1].dx = 50.0
  chars[2].dx = 10.0
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  let s = 100.0 / 1000.0
  run expectGlyph(&result, 0, 82, 0.0, 0.0)
  run expectGlyph(&result, 1, 581, 615.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).offsetX == -35.0 * s, "the mark offset")
  run Testing.expect(glyph(&result, 1).owner == 0, "the mark belongs to q")
  run expectGlyph(&result, 2, 89, 615.0 * s + 10.0, 0.0)

  let composed = run characters(&[0x65, 0x0301, 0x61])
  let merged = run layout(&fonts, &spans, List<Character>.asSlice(&composed))
  run Testing.expect(List<PlacedGlyph>.length(&merged.glyphs) == 2, "e + acute composes")
  run expectGlyph(&merged, 0, 169, 0.0, 0.0)
  run expectGlyph(&merged, 1, 66, 564.0 * s, 0.0)
}

// #TextLayoutAlgorithm "Apply absolute positions" and "Adjust positions: dx, dy".
effect fn appliesPositions() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x41, 0x56, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].y = Option<f64>.Some { value: 30.0 }
  chars[1].x = Option<f64>.Some { value: 200.0 }
  chars[2].dy = 5.0
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  let s = 100.0 / 1000.0
  run expectGlyph(&result, 0, 34, 0.0, 30.0)
  run expectGlyph(&result, 1, 55, 200.0, 30.0)
  run expectGlyph(&result, 2, 34, 599.0 * s + 560.0 * s + (200.0 - 599.0 * s), 35.0)
}

// #TextAnchoringProperties: a middle-anchored chunk centers its advance extent on its start.
effect fn anchorsChunks() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[SANS], Anchor.Middle)]
  let mut text = run characters(&[0x41, 0x56, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].x = Option<f64>.Some { value: 100.0 }
  chars[2].x = Option<f64>.Some { value: 300.0 }
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  let s = 100.0 / 1000.0
  let high = 599.0 * s + 100.0 + 560.0 * s
  let shift = 100.0 - (100.0 + high) / 2.0
  run expectGlyph(&result, 0, 34, 100.0 + shift, 0.0)
  run expectGlyph(&result, 1, 55, 599.0 * s + 100.0 + shift, 0.0)
  run expectGlyph(&result, 2, 34, 300.0 + (300.0 - (300.0 + (300.0 + 639.0 * s)) / 2.0), 0.0)
}

// CSS Fonts 4 #cluster-matching: a character missing from the first family falls back.
effect fn fallsBackPerCharacter() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[MONO, SANS], Anchor.Start)]
  let text = run characters(&[0x78, 0x03B1])
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  run Testing.expect(List<Instance>.length(&result.instances) == 2, "two faces are used")
  let first = glyph(&result, 0)
  let second = glyph(&result, 1)
  run Testing.expect(
    List<Instance>.asSlice(&result.instances)[first.instance].face == MONO,
    "x comes from the mono face",
  )
  run Testing.expect(
    List<Instance>.asSlice(&result.instances)[second.instance].face == SANS,
    "alpha falls back to sans",
  )
  run expectGlyph(&result, 1, 254, first.advance, 0.0)
  run Testing.expect(first.advance == 1229.0 * (100.0 / 2048.0), "the mono advance")
}

// CSS Text 3 #boundary-shaping: an element boundary without a formatting change does not
// break shaping, so A and V still kern.
effect fn shapesAcrossSpans() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let spans = [run span(&[SANS], Anchor.Start), run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x41, 0x56])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[1].span = 1
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text))
  let s = 100.0 / 1000.0
  run Testing.expect(List<Instance>.length(&result.instances) == 1, "the spans share an instance")
  run expectGlyph(&result, 1, 55, 599.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).span == 1, "V keeps its span")
}

test effect fn boundaries() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapesAcrossSpans() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn shaping() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapesAlongTheBaseline() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn clusters() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keepsClustersTogether() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn positions() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run appliesPositions() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn anchoring() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run anchorsChunks() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn fallback() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallsBackPerCharacter() |> Effect.provideMut<Allocator>(&mut allocator)
}
