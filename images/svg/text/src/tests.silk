//! Text layout tests over the subset fonts in images/svg/tests/fonts. Glyph ids and
//! advances are HarfBuzz's for the same fonts and text (uharfbuzz).
import layout {
  Anchor,
  Baseline,
  Bidi,
  Shift,
  Setting,
  Axis,
  Span,
  Character,
  PlacedGlyph,
  Layout,
  Instance,
  Line,
  Writing,
  TextOrientation,
  layout
}
import lines { Align, wrap, wrapInAreas }
import areas { Region, available, grown }
import svg_geometry.geometry { Path as Outline, Point, Segment, Transform }
import svg_fonts.database { FontDatabase, Fonts }
import svg_fonts.matching { Selection }
import silk.num.f64
import silk.platform.native.host_input { NativeHostInput }
import silk.system.host_input { HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

const SANS: usize = 0

const MONO: usize = 1

effect fn read(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run NativeHostInput.workingDirectory()
  let root = run Path.fromBytes(Bytes.asSlice(&cwd))
  let mut relative = run String.copy("images/svg/tests/fonts/")
  run String.append(&mut relative, name)
  let path = run Path.resolve(&root, String.view(&relative))
  let mut files = run OsFileSystem.make("/")
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn loaded() -> FontDatabase
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut fonts = FontDatabase.make()
  drop run fonts.add(run read("NotoSans-Regular.subset.ttf"))
  drop run fonts.add(run read("NotoMono-Regular.subset.ttf"))
  return move fonts
}

fn regular(face: usize) -> Selection {
  return Selection {
    face: face,
    weight: 400.0,
    width: 100.0,
    italic: Option<f64>.None,
    oblique: Option<f64>.None,
    syntheticOblique: 0.0,
    syntheticBold: false,
  }
}

effect fn span(faces: &[usize], anchor: Anchor) -> Span
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut selections = List<Selection>.make()
  let mut index: usize = 0
  while index < faces.length {
    run List<Selection>.append(&mut selections, regular(faces[index]))
    index = index + 1
  }
  return Span {
    faces: move selections,
    size: 100.0,
    anchor: anchor,
    letterSpacing: 0.0,
    wordSpacing: 0.0,
    dominant: Baseline.Alphabetic,
    alignment: Option<Baseline>.None,
    shift: Shift.Length { value: 0.0 },
    parent: Option<usize>.None,
    rtl: false,
    bidi: Bidi.Normal,
    features: List<Setting>.make(),
    variations: List<Axis>.make(),
    lineHeight: Option<f64>.None,
    writing: Writing.HorizontalTb,
    orientation: TextOrientation.Mixed,
  }
}

fn plain(cp: u32) -> Character {
  return Character {
    cp: cp,
    span: 0,
    x: Option<f64>.None,
    y: Option<f64>.None,
    dx: 0.0,
    dy: 0.0,
    rotate: 0.0,
    path: Option<usize>.None,
    line: Line.Inside,
  }
}

effect fn characters(text: &[u32]) -> List<Character>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Character>.make()
  let mut index: usize = 0
  while index < text.length {
    run List<Character>.append(&mut out, plain(text[index]))
    index = index + 1
  }
  return move out
}

fn glyph(result: &Layout, index: usize) -> PlacedGlyph {
  return List<PlacedGlyph>.asSlice(&result.glyphs)[index]
}

effect fn expectGlyph(result: &Layout, index: usize, id: u32, x: f64, y: f64) -> ()
  ! AssertionError<'static> {
  let placed = glyph(result, index)
  run Testing.expect(placed.glyph == id, "glyph id")
  run Testing.expect(placed.x == x, "glyph x")
  run Testing.expect(placed.y == y, "glyph y")
}

// https://www.w3.org/TR/SVG2/text.html#TextLayoutAlgorithm "CSS layout": glyphs follow the
// shaper's advances, kerning included.
effect fn shapesAlongTheBaseline() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Start)]
  let text = run characters(&[0x41, 0x56, 0x41])
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let s = 100.0 / 1000.0
  run Testing.expect(List<PlacedGlyph>.length(&result.glyphs) == 3, "one glyph per letter")
  run expectGlyph(&result, 0, 34, 0.0, 0.0)
  run expectGlyph(&result, 1, 55, 599.0 * s, 0.0)
  run expectGlyph(&result, 2, 34, 599.0 * s + 560.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).advance == 560.0 * s, "the kerned advance")
  let instance = &List<Instance>.asSlice(&result.instances)[0]
  run Testing.expect(instance.ascent > 0.0 && instance.descent > 0.0, "line metrics are read")
}

// #TextLayoutAlgorithm: positioning values on a character that is not the first of its
// typographic character are ignored, and a mark keeps the shaper's offset.
effect fn keepsClustersTogether() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x71, 0x0301, 0x78])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[1].dx = 50.0
  chars[2].dx = 10.0
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let s = 100.0 / 1000.0
  run expectGlyph(&result, 0, 82, 0.0, 0.0)
  run expectGlyph(&result, 1, 581, 615.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).offsetX == -35.0 * s, "the mark offset")
  run Testing.expect(glyph(&result, 1).owner == 0, "the mark belongs to q")
  run expectGlyph(&result, 2, 89, 615.0 * s + 10.0, 0.0)

  let composed = run characters(&[0x65, 0x0301, 0x61])
  let merged = run layout(&fonts, &spans, List<Character>.asSlice(&composed), &[], &[])
  run Testing.expect(List<PlacedGlyph>.length(&merged.glyphs) == 2, "e + acute composes")
  run expectGlyph(&merged, 0, 169, 0.0, 0.0)
  run expectGlyph(&merged, 1, 66, 564.0 * s, 0.0)
}

// #TextLayoutAlgorithm "Apply absolute positions" and "Adjust positions: dx, dy".
effect fn appliesPositions() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x41, 0x56, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].y = Option<f64>.Some { value: 30.0 }
  chars[1].x = Option<f64>.Some { value: 200.0 }
  chars[2].dy = 5.0
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let s = 100.0 / 1000.0
  run expectGlyph(&result, 0, 34, 0.0, 30.0)
  run expectGlyph(&result, 1, 55, 200.0, 30.0)
  run expectGlyph(&result, 2, 34, 599.0 * s + 560.0 * s + (200.0 - 599.0 * s), 35.0)
}

// #TextAnchoringProperties: a middle-anchored chunk centers its advance extent on its start.
effect fn anchorsChunks() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Middle)]
  let mut text = run characters(&[0x41, 0x56, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].x = Option<f64>.Some { value: 100.0 }
  chars[2].x = Option<f64>.Some { value: 300.0 }
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let s = 100.0 / 1000.0

  // Chunks shape independently (#TermTextChunk), so V is not kerned against the last A.
  let high = 599.0 * s + 100.0 + 600.0 * s
  let shift = 100.0 - (100.0 + high) / 2.0
  run expectGlyph(&result, 0, 34, 100.0 + shift, 0.0)
  run expectGlyph(&result, 1, 55, 599.0 * s + 100.0 + shift, 0.0)
  run expectGlyph(&result, 2, 34, 300.0 + (300.0 - (300.0 + (300.0 + 639.0 * s)) / 2.0), 0.0)
}

// CSS Fonts 4 #cluster-matching: a character missing from the first family falls back.
effect fn fallsBackPerCharacter() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[MONO, SANS], Anchor.Start)]
  let text = run characters(&[0x78, 0x03B1])
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  run Testing.expect(List<Instance>.length(&result.instances) == 2, "two faces are used")
  let first = glyph(&result, 0)
  let second = glyph(&result, 1)
  run Testing.expect(
    List<Instance>.asSlice(&result.instances)[first.instance].face == MONO,
    "x comes from the mono face",
  )
  run Testing.expect(
    List<Instance>.asSlice(&result.instances)[second.instance].face == SANS,
    "alpha falls back to sans",
  )
  run expectGlyph(&result, 1, 254, first.advance, 0.0)
  run Testing.expect(first.advance == 1229.0 * (100.0 / 2048.0), "the mono advance")
}

// CSS Text 3 #boundary-shaping: an element boundary without a formatting change does not
// break shaping, so A and V still kern.
effect fn shapesAcrossSpans() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Start), run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x41, 0x56])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[1].span = 1
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let s = 100.0 / 1000.0
  run Testing.expect(List<Instance>.length(&result.instances) == 1, "the spans share an instance")
  run expectGlyph(&result, 1, 55, 599.0 * s, 0.0)
  run Testing.expect(glyph(&result, 1).span == 1, "V keeps its span")
}

// SVG 2 #InlineSize: lines break at UAX #14 opportunities once the content passes the
// inline size; each line starts at the first character's x, one line box lower, and the
// white space at its end hangs.
effect fn wrapsLines() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let spans = [run span(&[SANS], Anchor.Start)]
  let mut text = run characters(&[0x41, 0x20, 0x41, 0x20, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].x = Option<f64>.Some { value: 10.0 }
  chars[0].y = Option<f64>.Some { value: 20.0 }
  chars[2].x = Option<f64>.Some { value: 500.0 }
  run wrap(&fonts, &spans, &mut text, 100.0, true)
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let instance = &List<Instance>.asSlice(&result.instances)[0]

  // CSS 2.1 #leading: half the line gap above the ascent and below the descent.
  let half = instance.lineGap / 2.0
  let line = (instance.descent + half) - (0.0 - instance.ascent - half)
  run Testing.expect(line > 0.0, "normal line-height comes from the face")
  run expectGlyph(&result, 0, 34, 10.0, 20.0)
  run Testing.expect(glyph(&result, 1).hidden && glyph(&result, 1).advance == 0.0, "space hangs")
  run expectGlyph(&result, 2, 34, 10.0, 20.0 + line)
  run expectGlyph(&result, 4, 34, 10.0, 20.0 + line + line)
  let marks = List<Character>.asSlice(&text)
  run Testing.expect(marks[2].line == Line.Start && marks[3].line == Line.Hang, "line roles")

  // A preserved segment break forces a line; a set line-height spaces the lines.
  let mut tall = [run span(&[SANS], Anchor.Start)]
  tall[0].lineHeight = Option<f64>.Some { value: 150.0 }
  let mut broken = run characters(&[0x41, 0x0A, 0x41])
  run wrap(&fonts, &tall, &mut broken, 1000.0, false)
  let lines = run layout(&fonts, &tall, List<Character>.asSlice(&broken), &[], &[])
  run expectGlyph(&lines, 0, 34, 0.0, 0.0)
  run Testing.expect(List<Character>.asSlice(&broken)[1].cp == 0x20, "the break renders as a space")
  run expectGlyph(&lines, 2, 34, 0.0, 150.0)
}

// CSS Writing Modes 3 #vertical-layout: in vertical text an upright character is shaped
// top to bottom, with the font's vertical alternates (`vert`) and advances.
effect fn setsVerticalText() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut database = FontDatabase.make()
  drop run database.add(run read("MPLUS1p-Regular.subset.ttf"))
  let fonts = Fonts.make(&database)
  let mut spans = [run span(&[0], Anchor.Start)]
  spans[0].writing = Writing.VerticalRl
  let mut text = run characters(&[0x304D, 0x3001, 0x41])
  let chars = List<Character>.asMutSlice(&mut text)
  chars[0].x = Option<f64>.Some { value: 50.0 }
  chars[0].y = Option<f64>.Some { value: 10.0 }
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let first = glyph(&result, 0)
  run Testing.expect(first.upright && first.rotate == 0.0, "kana is upright")
  run Testing.expect(glyph(&result, 1).glyph == 274, "the ideographic comma's vertical form")
  run Testing.expect(first.y == 10.0 && glyph(&result, 1).y == 110.0, "the pen runs down")
  run Testing.expect(
    !glyph(&result, 2).upright && glyph(&result, 2).rotate == 90.0,
    "A is sideways",
  )

  // Wrapped vertical-rl lines start at the first y and stack leftward by a line box.
  let mut column = run characters(&[0x304D, 0x304D, 0x304D])
  let cells = List<Character>.asMutSlice(&mut column)
  cells[0].x = Option<f64>.Some { value: 500.0 }
  cells[0].y = Option<f64>.Some { value: 10.0 }
  run wrap(&fonts, &spans, &mut column, 250.0, true)
  let marks = List<Character>.asSlice(&column)
  run Testing.expect(marks[2].line == Line.Start, "the third kana starts a line")
  let lines = run layout(&fonts, &spans, marks, &[], &[])
  run Testing.expect(glyph(&lines, 2).y == 10.0, "a line starts at the first y")
  run Testing.expect(glyph(&lines, 2).x < glyph(&lines, 0).x, "the next line is to the left")
}

effect fn rectangle(left: f64, top: f64, right: f64, bottom: f64) -> Region
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = Outline.make()
  drop run path.append(Segment.MoveTo { to: Point.new(left, top) })
  drop run path.append(Segment.LineTo { to: Point.new(right, top) })
  drop run path.append(Segment.LineTo { to: Point.new(right, bottom) })
  drop run path.append(Segment.LineTo { to: Point.new(left, bottom) })
  drop run path.append(Segment.Close)
  return run Region.make(&path, Transform.identity(), false)
}

// SVG 2 #TextShapeInside: a band's available spans are inside the shape and outside the
// subtracted ones for its whole height; a diamond narrows towards its tips.
effect fn findsAvailableSpans() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let area = run rectangle(0.0, 0.0, 100.0, 100.0)
  let hole = run rectangle(40.0, 50.0, 60.0, 200.0)
  let mut out = List<f64>.make()
  run available(&area, &[move hole], 10.0, 40.0, &mut out)
  run Testing.expect(
    List<f64>.length(&out) == 2 && List<f64>.get(&out, 1) == 100.0,
    "above the hole",
  )
  out = List<f64>.make()
  run available(&area, &[run rectangle(40.0, 50.0, 60.0, 200.0)], 40.0, 60.0, &mut out)
  let parts = List<f64>.asSlice(&out)
  run Testing.expect(parts.length == 4 && parts[1] == 40.0 && parts[2] == 60.0, "split by the hole")
  out = List<f64>.make()
  run available(&area, &[], 90.0, 110.0, &mut out)
  run Testing.expect(List<f64>.length(&out) == 0, "a band past the bottom has no room")
  let mut path = Outline.make()
  drop run path.append(Segment.MoveTo { to: Point.new(50.0, 0.0) })
  drop run path.append(Segment.LineTo { to: Point.new(100.0, 50.0) })
  drop run path.append(Segment.LineTo { to: Point.new(50.0, 100.0) })
  drop run path.append(Segment.LineTo { to: Point.new(0.0, 50.0) })
  drop run path.append(Segment.Close)
  let diamond = run Region.make(&path, Transform.identity(), false)
  out = List<f64>.make()
  run available(&diamond, &[], 40.0, 60.0, &mut out)
  run Testing.expect(
    List<f64>.get(&out, 0) == 10.0 && List<f64>.get(&out, 1) == 90.0,
    "the narrowest width across the band",
  )
}

// shape-margin grows a shape by a band along each edge and a disc at each vertex, so a
// band below a corner loses only the part within the margin of it.
effect fn growsShapes() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut square = Outline.make()
  drop run square.append(Segment.MoveTo { to: Point.new(0.0, 0.0) })
  drop run square.append(Segment.LineTo { to: Point.new(10.0, 0.0) })
  drop run square.append(Segment.LineTo { to: Point.new(10.0, 10.0) })
  drop run square.append(Segment.LineTo { to: Point.new(0.0, 10.0) })
  drop run square.append(Segment.Close)
  let mut holes = List<Region>.make()
  run grown(&square, Transform.identity(), false, 5.0, &mut holes)
  let area = run rectangle(-100.0, -100.0, 100.0, 100.0)

  // Beside an edge the margin is exact.
  let mut out = List<f64>.make()
  run available(&area, List<Region>.asSlice(&holes), 4.0, 6.0, &mut out)
  run Testing.expect(
    List<f64>.get(&out, 1) == -5.0 && List<f64>.get(&out, 2) == 15.0,
    "the margin beside an edge",
  )

  // Two below the corner the disc reaches sqrt(5² - 2²) across.
  out = List<f64>.make()
  run available(&area, List<Region>.asSlice(&holes), 12.0, 13.0, &mut out)
  let reach = f64.sqrt(21.0)
  run Testing.expect(
    f64.abs(List<f64>.get(&out, 1) + reach) < 0.01
      && f64.abs(List<f64>.get(&out, 2) - 10.0 - reach) < 0.01,
    "rounded at the corner",
  )
}

// Lines fill a shape from its top, one strut line box apart, and text past the last shape
// hangs.
effect fn wrapsInShapes() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let database = run loaded()
  let fonts = Fonts.make(&database)
  let mut spans = [run span(&[SANS], Anchor.Start)]
  spans[0].lineHeight = Option<f64>.Some { value: 120.0 }
  let mut text = run characters(&[0x41, 0x20, 0x41, 0x20, 0x41])
  let area = run rectangle(10.0, 20.0, 110.0, 270.0)
  run wrapInAreas(&fonts, &spans, &mut text, &[move area], &[], true, Align.Start, Align.Start)
  let result = run layout(&fonts, &spans, List<Character>.asSlice(&text), &[], &[])
  let instance = &List<Instance>.asSlice(&result.instances)[0]
  let leading = (120.0 - (instance.ascent + instance.descent)) / 2.0
  let baseline = 20.0 - (0.0 - instance.ascent - leading)
  run expectGlyph(&result, 0, 34, 10.0, baseline)
  let strut = (instance.descent + leading) - (0.0 - instance.ascent - leading)
  run expectGlyph(&result, 2, 34, 10.0, 20.0 + strut - (0.0 - instance.ascent - leading))
  run Testing.expect(glyph(&result, 4).hidden, "the third line does not fit")
}

test effect fn boundaries() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapesAcrossSpans() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn shaping() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapesAlongTheBaseline() |> Effect.provideMut<Allocator>(&mut allocator)
}

