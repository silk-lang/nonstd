//! The silk.geometry points, rectangles and 2D affine transforms over f64, plus
//! the rasterizer's own length helpers.
import silk.core.ownership { Copy }
import silk.num.f64
import silk.num.u64
import silk.geometry.point { Point2 }
import silk.geometry.affine { Affine2 }
import silk.geometry.rect as rect

/// |value| by clearing the sign bit. Unlike f64.abs, a NaN keeps its payload
/// instead of becoming the canonical NaN; callers only test finiteness.
pub fn magnitude(value: f64) -> f64 {
  return f64.fromBits(u64.bitAnd(f64.toBits(value), 9223372036854775807))
}

/// Euclidean length scaled by the larger magnitude, as stroke and flatten use
/// it: the same arithmetic as max(|x|, |y|) * sqrt((x/s)^2 + (y/s)^2), with
/// one select instead of f64.max. A NaN input gives NaN.
pub fn scaledLength(x: f64, y: f64) -> f64 {
  let ax = magnitude(x)
  let ay = magnitude(y)
  let scale = if ax > ay { ax } else { ay }
  if scale == 0.0 && ax == 0.0 && ay == 0.0 {
    return 0.0
  }
  let a = x / scale
  let b = y / scale
  return scale * f64.sqrt(a * a + b * b)
}

/// A position in user or device space.
pub type Point = Point2<f64>

/// Axis-aligned bounds in user or device space.
pub type Rect = rect.Rect<f64>

/// The SVG matrix `[a c e; b d f; 0 0 1]` as `silk.geometry.affine.Affine2`:
/// `x' = xx x + xy y + dx`, `y' = yx x + yy y + dy`. `left * right` applies `right` first.
pub type Affine = Affine2<f64>

/// The rectangle at `(x, y)` with the given width and height.
pub fn rectAt(x: f64, y: f64, width: f64, height: f64) -> Rect {
  return Rect.new(x, y, x + width, y + height)
}
