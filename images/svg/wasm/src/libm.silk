//! The C math functions the renderer's dependencies call on wasm32: `sinf`, `cosf`, `tanf`
//! and `hypotf` (read_fonts colour transforms), `fmaf` and `fmod`. The standalone wasm32
//! runtime links no C library, so these forward to the host's `Math` (see `js/`), except
//! `fmaf`, which is exact here. Other targets link the system libm.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.num.f32
  import silk.num.f64
  import silk.num.u64

  unsafe extern "C" fn hostSin(value: f64) -> f64 as "math#sin"

  unsafe extern "C" fn hostCos(value: f64) -> f64 as "math#cos"

  unsafe extern "C" fn hostTan(value: f64) -> f64 as "math#tan"

  unsafe extern "C" fn hostHypot(x: f64, y: f64) -> f64 as "math#hypot"

  unsafe extern "C" fn hostFmod(x: f64, y: f64) -> f64 as "math#fmod"

  export "C" fn sinf(value: f32) -> f32 as "sinf" {
    unsafe {
      return f64.toF32(hostSin(f32.toF64(value)))
    }
  }

  export "C" fn cosf(value: f32) -> f32 as "cosf" {
    unsafe {
      return f64.toF32(hostCos(f32.toF64(value)))
    }
  }

  export "C" fn tanf(value: f32) -> f32 as "tanf" {
    unsafe {
      return f64.toF32(hostTan(f32.toF64(value)))
    }
  }

  export "C" fn hypotf(x: f32, y: f32) -> f32 as "hypotf" {
    unsafe {
      return f64.toF32(hostHypot(f32.toF64(x), f32.toF64(y)))
    }
  }

  // JavaScript's `%` is C's fmod exactly (ECMA-262 Number::remainder).
  export "C" fn fmod(x: f64, y: f64) -> f64 as "fmod" {
    unsafe {
      return hostFmod(x, y)
    }
  }

  // musl's fmaf: x*y is exact in f64, so only the sum rounds. When that sum lies exactly
  // halfway between two f32 values and is inexact, the f64 is nudged toward the true value
  // so the final rounding to f32 is correct.
  export "C" fn fmaf(x: f32, y: f32, z: f32) -> f32 as "fmaf" {
    let xy = f32.toF64(x) * f32.toF64(y)
    let result = xy + f32.toF64(z)
    let bits = f64.toBits(result)
    let exponent = u64.shiftRight(bits, 52) & 0x7ff
    let wide = f32.toF64(z)
    if (bits & 0x1fffffff) != 0x10000000 || exponent == 0x7ff
      || (result - xy == wide && result - wide == xy) {
      return f64.toF32(result)
    }
    let negative = u64.shiftRight(bits, 63) == 1
    let error = if negative == (wide > xy) {
      xy - result + wide
    } else {
      wide - result + xy
    }
    let adjusted = if negative == (error < 0.0) {
      bits + 1
    } else {
      bits - 1
    }
    return f64.toF32(f64.fromBits(adjusted))
  }
}
