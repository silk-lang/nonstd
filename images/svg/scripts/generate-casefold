#!/usr/bin/env python3
"""Materialize Unicode18 full case folding (status C and F) for CSS family-name matching.

Default: offline, verify cached sources against casefold.lock.json.
--fetch: hydrate missing cache files, verifying the locked hashes.
--update: explicitly refresh source pins.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parents[3]
LOCK = ROOT / "images/svg/casefold.lock.json"
CACHE = ROOT / "images/svg/.cache/casefold"
OUTPUT = ROOT / "images/svg/fonts/src/casefold_data.silk"
URLS = {
    "folding": "https://www.unicode.org/Public/18.0.0/ucd/CaseFolding.txt",
    "license": "https://www.unicode.org/license.txt",
}


def source(name, record, update, fetch):
    if update:
        with urllib.request.urlopen(URLS[name], timeout=90) as response:
            body = response.read()
            record = {"url": URLS[name], "resolved": response.geturl(),
                      "sha256": hashlib.sha256(body).hexdigest()}
    else:
        path = CACHE / record["sha256"]
        if path.exists():
            body = path.read_bytes()
        else:
            if not fetch:
                raise ValueError(f"missing cached {name}; use --fetch to hydrate the locked cache")
            with urllib.request.urlopen(record["resolved"], timeout=90) as response:
                body = response.read()
        if hashlib.sha256(body).hexdigest() != record["sha256"]:
            raise ValueError(f"{name}: pinned digest mismatch")
    path = CACHE / record["sha256"]
    if not path.exists() or path.read_bytes() != body:
        CACHE.mkdir(parents=True, exist_ok=True)
        path.write_bytes(body)
    return body, record


def literal(name, body):
    escaped = "".join(f"\\x{b:02x}" for b in body)
    return f'fn {name}() -> &\'static [u8] {{\n  return b"{escaped}"\n}}\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--update", action="store_true", help="explicitly refresh source pins")
    mode.add_argument("--fetch", action="store_true", help="fetch missing locked sources without changing the pin")
    args = parser.parse_args()
    lock = {} if args.update else json.loads(LOCK.read_text())
    if not args.update and (lock["format"] != 1 or lock["unicode"] != "18.0.0"
                            or set(lock["sources"]) != set(URLS)):
        raise ValueError("invalid case folding lock format, Unicode version, or sources")
    records, sources = {}, {}
    for name in URLS:
        sources[name], records[name] = source(name, lock.get("sources", {}).get(name),
                                             args.update, args.fetch)
    text = sources["folding"].decode("utf-8")
    if not text.startswith("# CaseFolding-18.0.0.txt"):
        raise ValueError("case folding must match ucd Unicode18.0.0")
    folds = {}
    for line in text.splitlines():
        fields = [part.strip() for part in line.split("#", 1)[0].split(";")]
        if len(fields) < 3 or fields[1] not in ("C", "F"):
            continue
        mapping = [int(cp, 16) for cp in fields[2].split()]
        if not 1 <= len(mapping) <= 3:
            raise ValueError("full case folding maps to one to three scalars")
        folds[int(fields[0], 16)] = mapping
    # Each record: the scalar, then three folded scalars (0 when unused), 3 bytes each.
    rows = bytearray()
    for cp in sorted(folds):
        mapping = folds[cp] + [0] * (3 - len(folds[cp]))
        for value in [cp] + mapping:
            rows.extend(value.to_bytes(3, "little"))
    license_text = sources["license"].decode("utf-8")
    result = "// Generated by images/svg/scripts/generate-casefold. DO NOT EDIT.\n"
    result += "// Unicode18.0.0 CaseFolding.txt, status C and F; source hashes: images/svg/casefold.lock.json.\n"
    result += "\n".join("// " + line for line in license_text.splitlines()) + "\n"
    result += "import silk.num.u8\nimport silk.num.u32\n\n"
    result += literal("records", rows)
    result += '''
fn word(bytes: &[u8], at: usize) -> u32 {
  return u8.toU32(bytes[at]) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[at + 2]), 16)
}

/// Writes the full case folding of `cp` to `out` and returns its length (1 to 3).
pub fn fold(cp: u32, out: &mut [u32; 3]) -> usize {
  let data = records()
  let mut low: usize = 0
  let mut high = data.length / 12
  while low < high {
    let middle = low + (high - low) / 2
    let key = word(data, middle * 12)
    if key == cp {
      let mut length: usize = 0
      while length < 3 {
        let value = word(data, middle * 12 + 3 + length * 3)
        if value == 0 {
          return length
        }
        out[length] = value
        length = length + 1
      }
      return length
    }
    if key < cp { low = middle + 1 } else { high = middle }
  }
  out[0] = cp
  return 1
}
'''
    # Write through silk format, so that hydrating the cache leaves the committed file as is.
    with tempfile.TemporaryDirectory() as directory:
        staged = Path(directory) / OUTPUT.name
        staged.write_text(result, encoding="utf-8")
        subprocess.run([os.environ.get("SILK", "silk"), "format", str(staged)], check=True,
                       stdout=subprocess.DEVNULL)
        output = staged.read_bytes()
    if not OUTPUT.exists() or OUTPUT.read_bytes() != output:
        OUTPUT.write_bytes(output)
    if args.update:
        LOCK.write_text(json.dumps({"format": 1, "unicode": "18.0.0", "license": "Unicode-3.0",
                                    "sources": records}, indent=2) + "\n")
    print(f"Materialized {len(rows)//12} case folding records")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"generate-casefold: {error}")
