#!/usr/bin/env sh
# Build images-svg-wasm for wasm32 and print the module's path. Linking needs wasm-ld on PATH.
set -eu
root=$(cd "$(dirname "$0")/../../.." && pwd)
silk build --release --manifest-path "$root/images/svg/wasm/silk.toml" --target wasm32-unknown-unknown >&2
echo "$root/build/llvm/wasm32-unknown-unknown/release/images-svg-wasm"
