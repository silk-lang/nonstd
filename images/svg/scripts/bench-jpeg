#!/usr/bin/env python3
"""Measure standalone JPEG decode; no SVG rendering or reference-engine claim."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import statistics
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[3]

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('inputs', nargs='+', type=Path)
    parser.add_argument('--samples', type=int, default=3)
    parser.add_argument('--iterations', type=int, default=5)
    parser.add_argument('--warmup', type=int, default=1)
    parser.add_argument('--callgrind', action='store_true', help='separate complete-process Ir including hashing and startup')
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    if args.samples < 1 or not 1 <= args.iterations <= 100000 or not 0 <= args.warmup <= 10000:
        parser.error('invalid sample/iteration/warmup count')
    version = json.loads((ROOT/'toolchains.lock.json').read_text())['silk']['version']
    arch = {'arm64':'aarch64', 'AMD64':'x86_64'}.get(platform.machine(), platform.machine())
    system = {'Darwin':'apple-darwin', 'Linux':'unknown-linux-gnu'}.get(platform.system())
    if system is None or arch not in ('aarch64','x86_64'):
        parser.error('unsupported native target')
    if args.callgrind and platform.system() != 'Linux':
        parser.error('Callgrind requires Linux')
    report = {'silk_version':version, 'platform':platform.platform(), 'samples':args.samples,
              'iterations':args.iterations, 'warmup':args.warmup, 'measurements':[]}
    with tempfile.TemporaryDirectory(prefix='nonstd-jpeg-bench-') as temporary:
        package = Path(temporary)
        # A temporary executable package shares the exact library sources. No workspace
        # package or dependency copy is checked in solely to run a benchmark main.
        shutil.copytree(ROOT/'images/svg/image/src', package/'src')
        shutil.copyfile(package/'src/jpeg_bench.silk', package/'src/main.silk')
        (package/'silk.toml').write_text(f'[package]\nname = "jpeg-codec-bench"\nversion = "0.1.0"\nsilk-version = "{version}"\n')
        subprocess.run([os.environ.get('SILK','silk'),'build','--manifest-path',str(package/'silk.toml'),'--release'],check=True,timeout=300)
        binary = package/f'build/llvm/{arch}-{system}/release/jpeg-codec-bench'
        report['binary_sha256'] = hashlib.sha256(binary.read_bytes()).hexdigest()
        for source in args.inputs:
            source = source.resolve()
            command = [str(binary),'decode',str(source),str(args.iterations),str(args.warmup)]
            results = [json.loads(subprocess.run(command,capture_output=True,text=True,check=True,timeout=120).stdout) for _ in range(args.samples)]
            checksums = {item['checksum'] for item in results}
            if len(checksums) != 1:
                raise ValueError('unstable output checksum')
            for item in results:
                if item['elapsed_ns'] <= 0 or item['iterations'] != args.iterations or item['warmup'] != args.warmup or int(item['consumed']) != (int(item['checksum'])*(args.iterations+args.warmup)) % (2**64):
                    raise ValueError('invalid timing or output consumption')
            median = statistics.median(item['elapsed_ns']/args.iterations/1e6 for item in results)
            row = {'input':source.name,'input_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),'bytes':source.stat().st_size,
                   'width':results[0]['width'],'height':results[0]['height'],'checksum':results[0]['checksum'],'median_ms':median,'native_samples':results}
            if args.callgrind:
                counts = package/'callgrind.out'
                subprocess.run(['valgrind','--tool=callgrind',f'--callgrind-out-file={counts}',str(binary),'decode',str(source),'1','0'],check=True,capture_output=True,text=True,timeout=300)
                row['process_ir'] = int(next(line.split(':',1)[1] for line in counts.read_text().splitlines() if line.startswith('summary:')))
            report['measurements'].append(row)
            print(f'{source.name}: {median:.4f} ms/decode',flush=True)
    args.output.parent.mkdir(parents=True,exist_ok=True)
    args.output.write_text(json.dumps(report,indent=2)+'\n')

if __name__ == '__main__':
    main()
