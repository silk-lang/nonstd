#!/usr/bin/env python3
"""Gate for vector and gpu_scene: package checks, vector unit tests and, unless --skip-native, CPU/GPU scene equality on Dawn."""
import argparse
import os
import shlex
import subprocess
import sys
from _gpu import SVG, REPO, command_path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-native", action="store_true", help="omit the Dawn scene comparison")
args = parser.parse_args()


def run(command):
    print("+ " + shlex.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=SVG, check=True)


run([sys.executable, REPO / "gpu/webgpu/scripts/embed-shaders", "--check"])
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
stdlib = compiler_bin.parent / "lib/silk/stdlib"
for package in ("vector", "vector/bench", "vector/filter-bench", "gpu_scene", "gpu_scene/tests"):
    run([compiler_bin / "silkc", "check", "--manifest-path", SVG / package / "silk.toml", "--stdlib", stdlib])
run([compiler_bin / "silkc", "test", "--manifest-path", SVG / "vector/silk.toml", "--root", SVG / "vector/src/tests.silk", "--stdlib", stdlib])
if not args.skip_native:
    run([sys.executable, SVG / "scripts/test-scene"])
