#!/usr/bin/env python3
"""Materialize Unicode18 UTS46 mapping data; NFC/properties remain in ucd.

Default: offline, verify cached sources against idna.lock.json.
--fetch: hydrate missing cache files, verifying the locked hashes.
--update: explicitly refresh source pins.
"""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[3]
LOCK = ROOT / "images/svg/idna.lock.json"
CACHE = ROOT / "images/svg/.cache/idna"
OUTPUT = ROOT / "images/svg/src/url_idna_data.silk"
URLS = {
    "mapping": "https://www.unicode.org/Public/18.0.0/idna/IdnaMappingTable.txt",
    "license": "https://www.unicode.org/license.txt",
}


def source(name, record, update, fetch):
    if update:
        with urllib.request.urlopen(URLS[name], timeout=90) as response:
            body = response.read()
            record = {"url": URLS[name], "resolved": response.geturl(),
                      "sha256": hashlib.sha256(body).hexdigest()}
    else:
        path = CACHE / record["sha256"]
        if path.exists():
            body = path.read_bytes()
        else:
            if not fetch:
                raise ValueError(f"missing cached {name}; use --fetch to hydrate the locked cache")
            with urllib.request.urlopen(record["resolved"], timeout=90) as response:
                body = response.read()
        if hashlib.sha256(body).hexdigest() != record["sha256"]:
            raise ValueError(f"{name}: pinned digest mismatch")
    path = CACHE / record["sha256"]
    if not path.exists() or path.read_bytes() != body:
        CACHE.mkdir(parents=True, exist_ok=True)
        path.write_bytes(body)
    return body, record


def packed(value, width=3):
    return value.to_bytes(width, "little")


def literal(name, body):
    # One literal per packed table, not a giant AST of integer expressions.
    escaped = "".join(f"\\x{b:02x}" for b in body)
    return f'fn {name}() -> &\'static [u8] {{\n  return b"{escaped}"\n}}\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--update", action="store_true", help="explicitly refresh source pins")
    mode.add_argument("--fetch", action="store_true", help="fetch missing locked sources without changing the pin")
    args = parser.parse_args()
    lock = {} if args.update else json.loads(LOCK.read_text())
    if not args.update and (lock["format"] != 1 or lock["unicode"] != "18.0.0"
                            or set(lock["sources"]) != set(URLS)):
        raise ValueError("invalid IDNA lock format, Unicode version, or sources")
    records, sources = {}, {}
    for name in URLS:
        sources[name], records[name] = source(name, lock.get("sources", {}).get(name),
                                             args.update, args.fetch)
    text = sources["mapping"].decode("utf-8")
    if "# Version: 18.0.0" not in text:
        raise ValueError("mapping must match ucd Unicode18.0.0")
    status = {"valid": 0, "deviation": 1, "ignored": 2, "mapped": 3, "disallowed": 4}
    rows, pool, mappings = bytearray(), bytearray(), {}
    next_cp = 0
    for line in text.splitlines():
        fields = [part.strip() for part in line.split("#", 1)[0].split(";")]
        if not fields[0]:
            continue
        bounds = fields[0].split("..")
        start, end = int(bounds[0], 16), int(bounds[-1], 16)
        if start != next_cp:
            raise ValueError("mapping ranges must cover the Unicode codespace contiguously")
        next_cp = end + 1
        kind = status[fields[1]]
        mapping = tuple(int(cp, 16) for cp in fields[2].split()) if kind == 3 else ()
        if mapping not in mappings:
            mappings[mapping] = len(pool) // 3
            for cp in mapping:
                pool.extend(packed(cp))
        if len(mapping) > 255:
            raise ValueError("mapping exceeds packed length")
        rows.extend(packed(start) + bytes([kind]) + packed(mappings[mapping]) + bytes([len(mapping)]))
    if next_cp != 0x110000:
        raise ValueError("incomplete mapping")
    license_text = sources["license"].decode("utf-8")
    result = "// Generated by images/svg/scripts/generate-idna. DO NOT EDIT.\n"
    result += "// Unicode18.0.0 UTS46; source hashes: images/svg/idna.lock.json.\n"
    result += "\n".join("// " + line for line in license_text.splitlines()) + "\n"
    result += "import silk.num.u8\nimport silk.num.u32\n\n"
    result += literal("records", rows) + "\n" + literal("mappings", pool)
    result += '''
fn word(bytes: &[u8], at: usize) -> u32 {
  return u8.toU32(bytes[at]) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[at + 2]), 16)
}

// Returns a record offset; all scalar slots including unassigned are covered.
pub fn lookup(cp: u32) -> usize {
  let data = records()
  let mut low: usize = 0
  let mut high = data.length / 8
  while low + 1 < high {
    let middle = low + (high - low) / 2
    if word(data, middle * 8) <= cp { low = middle } else { high = middle }
  }
  return low * 8
}

pub fn status(record: usize) -> u8 { return records()[record + 3] }
pub fn length(record: usize) -> usize { return u8.toUsize(records()[record + 7]) }
pub fn mapping(record: usize, index: usize) -> u32 {
  return word(mappings(), (u32.toUsize(word(records(), record + 4)) + index) * 3)
}
'''
    output = result.encode("utf-8")
    if not OUTPUT.exists() or OUTPUT.read_bytes() != output:
        OUTPUT.write_bytes(output)
    if args.update:
        LOCK.write_text(json.dumps({"format": 1, "unicode": "18.0.0", "license": "Unicode-3.0",
                                    "sources": records}, indent=2) + "\n")
    print(f"Materialized {len(rows)//8} mapping records, {len(pool)//3} mapping scalars")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        raise SystemExit(f"generate-idna: {error}") from error
