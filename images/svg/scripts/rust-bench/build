#!/usr/bin/env python3
"""Explicit developer-only Rust build; never called by the PR gate.

Seed resolution from the pinned upstream lock, reject every registry version or
checksum absent from it, then build with --locked --release. Cargo may fetch the
pinned Git source and locked registry archives. No library dependency is added
to any Silk package.
"""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tomllib

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[3]
REVISION = "91455ee06d08ac2bfeab2b035ed2cfbfd0a68614"
LOCK_SHA256 = "ce2554b92b74fe4a4f16b7f06af35e9739132bf9cb407cde0e22137c86060227"
SOURCE = f"git+https://github.com/linebender/resvg?rev={REVISION}#{REVISION}"


def main():
    suite = json.loads((ROOT / "images/svg/tests/suites.lock.json").read_text())
    if suite["suites"]["resvg"]["revision"] != REVISION:
        raise SystemExit("resvg suite pin changed; update the benchmark pin and upstream lock together")
    upstream_bytes = (HERE / "upstream.Cargo.lock").read_bytes()
    if hashlib.sha256(upstream_bytes).hexdigest() != LOCK_SHA256:
        raise SystemExit("upstream Cargo.lock does not match its pinned source")
    upstream = tomllib.loads(upstream_bytes.decode())
    lock = HERE / "Cargo.lock"
    if not lock.exists():
        blocks = upstream_bytes.decode().split("[[package]]")
        for index, block in enumerate(blocks[1:], 1):
            package = tomllib.loads(block)
            if package["name"] in ("resvg", "usvg") and "source" not in package:
                lines = block.splitlines()
                version_line = next(i for i, line in enumerate(lines) if line.startswith("version ="))
                lines.insert(version_line + 1, f'source = "{SOURCE}"')
                blocks[index] = "\n".join(lines) + "\n"
        lock.write_text("[[package]]".join(blocks))
    cargo = os.environ.get("CARGO", "cargo")
    # Metadata resolves/downloads but does not compile; validate before any build.
    subprocess.run([cargo, "metadata", "--format-version", "1", "--manifest-path", str(HERE / "Cargo.toml")],
                   check=True, stdout=subprocess.DEVNULL)
    allowed = {(p["name"], p["version"], p.get("source"), p.get("checksum"))
               for p in upstream["package"] if "source" in p}
    for package in tomllib.loads(lock.read_text())["package"]:
        name = package["name"]
        if name == "svg-reference-bench" and "source" not in package:
            continue
        if name in ("resvg", "usvg") and package.get("source") == SOURCE and package["version"] == "0.49.0":
            continue
        key = (name, package["version"], package.get("source"), package.get("checksum"))
        if key not in allowed:
            raise SystemExit(f"refusing unpinned dependency {key}; remove the generated Cargo.lock and retry")
    subprocess.run([cargo, "build", "--release", "--locked", "--manifest-path", str(HERE / "Cargo.toml"), "--target-dir", str(HERE / "target")], check=True)
    print(HERE / "target/release/svg-reference-bench")


if __name__ == "__main__":
    main()
