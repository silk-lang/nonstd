//! Host-owned styling inputs. Font metrics and system palettes are explicit, not OS guesses.
import svg_core.document_styles { StyledGraph }
import svg_core.document_styles
import svg_core.stylesheets { Catalog }
import svg_core.resources { Resolver, ProcessingMode, Policy }
import svg_geometry.geometry { Size }
import svg_core.url { Url }
import svg_core.scene { RenderError }
import svg_core.structure { Options as StructureOptions, Graph, StructureError }
import svg_core.view_selection
import svg_css.computed { HostContext, ComputedError, Initials }
import svg_css.media_features { Environment as MediaEnvironment }
import svg_css.colors { Context as ColorContext, Color, Identity }
import svg_css.tokens { Limits, CssError }
import svg_css.lexer
import svg_css.input { Input }
import svg_css.value_cursor { Cursor }
import svg_css.properties { Property }
import svg_css.values { ValueId, Value, Mode }
import svg_css.values
import svg_css.text_values { TextValue }
import svg_css.text_values
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.f64
import svg_fonts.database { FontDatabase }

pub struct Environment<'a> {
  pub base: &'a Url,
  // Initial metrics must describe the host's selected font; finite/nonnegative
  // validation cannot establish their provenance. NativeHost measures a real face.
  pub media: MediaEnvironment,
  // Absolute, fully resolved host colors; currentColor/system references are invalid.
  pub colors: ColorContext,
  // A parsed family list, not a CSS-wide initial/inherit/unset/revert keyword.
  pub fontFamily: &'a [u8],
  // Concrete font shorthand values, indexed caption/icon/menu/message-box/small-caption/status-bar.
  pub systemFonts: [&'a [u8]; 6],
  pub cssLimits: Limits,
  pub structure: StructureOptions<'a>,
  /// The faces text may use (CSS Fonts 4 #font-matching-algorithm's installed fonts).
  pub fonts: &'a FontDatabase,
  /// Initial values parsed once by the host, so documents skip parsing them; none parses them
  /// per document.
  pub initials: Option<&'a Initials>,
}

fn nonnegative(value: f64) -> bool {
  return f64.isFinite(value) && value >= 0.0
}

fn absolute(color: &Color) -> bool {
  match &color.identity {
    Identity.Absolute => {}
    _ => {
      return false
    }
  }
  return color.missing == 0 && f64.isFinite(color.channels[0]) && f64.isFinite(color.channels[1])
    && f64.isFinite(color.channels[2])
    && nonnegative(color.alpha)
    && color.alpha <= 1.0
}

effect fn validate(environment: &Environment) -> ()
  ! RenderError {
  let context = &environment.media.initial
  let metrics = [
    context.fontSize,
    context.rootFontSize,
    context.xHeight,
    context.rootXHeight,
    context.capHeight,
    context.rootCapHeight,
    context.zeroAdvance,
    context.rootZeroAdvance,
    context.ideographAdvance,
    context.rootIdeographAdvance,
    context.lineHeight,
    context.rootLineHeight,
    context.viewportWidth,
    context.viewportHeight,
    context.smallViewportWidth,
    context.smallViewportHeight,
    context.dynamicViewportWidth,
    context.dynamicViewportHeight,
    context.parentFontSize,
    context.parentXHeight,
    context.parentCapHeight,
    context.parentZeroAdvance,
    context.parentIdeographAdvance,
    context.parentLineHeight,
    context.initialFontSize,
    context.mathFontSize,
    environment.media.deviceWidth,
    environment.media.deviceHeight,
    environment.media.resolutionDppx,
  ]
  let mut i: usize = 0
  while i < metrics.length {
    if !nonnegative(metrics[i]) {
      fail RenderError.InvalidStyleContext
    }
    i = i + 1
  }
  i = 0
  while i < context.fontSizeKeywords.length {
    if !nonnegative(context.fontSizeKeywords[i]) {
      fail RenderError.InvalidStyleContext
    }
    i = i + 1
  }
  if !f64.isFinite(context.parentFontWeight) || context.parentFontWeight < 1.0
    || context.parentFontWeight > 1000.0
    || !nonnegative(context.parentFontStretch)
    || context.parentFontStretch == 0.0
    || (!environment.media.infiniteResolution && environment.media.resolutionDppx == 0.0)
    || !absolute(&environment.colors.currentColor) {
    fail RenderError.InvalidStyleContext
  }
  i = 0
  while i < environment.colors.system.length {
    if !absolute(&environment.colors.system[i]) {
      fail RenderError.InvalidStyleContext
    }
    i = i + 1
  }
}

effect fn systemFont(catalog: &mut Catalog, source: &[u8], limits: &Limits) -> TextValue
  ! CssError | RenderError | OutOfMemoryError
  ? &mut Allocator {
  let tokens = run lexer.tokenize(source, limits)
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let mut cursor = Cursor.make(&input)
  let parsed = run text_values.parse(
    &mut catalog.engine.values.numerics,
    Property.Font,
    &input,
    &mut cursor,
    false,
  )
  if !cursor.done(&input) {
    fail RenderError.InvalidStyleContext
  }
  match move parsed {
    Option<TextValue>.Some { value } => {
      let mut size = false
      let mut family = false
      let mut i: usize = 0
      while i < value.items.length() {
        if value.items.asSlice()[i].property == Property.FontSize {
          size = true
        }
        if value.items.asSlice()[i].property == Property.FontFamily {
          family = true
        }
        i = i + 1
      }
      if !size || !family {
        fail RenderError.InvalidStyleContext
      }
      return move value
    }
    _ => {
      fail RenderError.InvalidStyleContext
    }
  }
}

effect fn compute(graph: &mut Graph, environment: &Environment) -> StyledGraph
  ! CssError | ComputedError | StructureError | RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  run validate(environment)
  let mut catalog = run Catalog.makeWith(environment.initials)
  let tokens = run lexer.tokenize(environment.fontFamily, &environment.cssLimits)
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let parsed = run values.parse(&mut catalog.engine.values, Property.FontFamily, &input, Mode.Css)
  let family = match &parsed {
    Option<ValueId>.Some { value } => value
    _ => {
      fail RenderError.InvalidStyleContext
    }
  }

  // values.parse also accepts CSS-wide keywords. A host initial value cannot
  // inherit/revert to another host and must contain an actual family list.
  match &catalog.engine.values.get(family).* {
    Value.Text { value } => {
      if value.property != Property.FontFamily || value.items.length() == 0 {
        fail RenderError.InvalidStyleContext
      }
    }
    _ => {
      fail RenderError.InvalidStyleContext
    }
  }
  let fonts = [
    run systemFont(&mut catalog, environment.systemFonts[0], &environment.cssLimits),
    run systemFont(&mut catalog, environment.systemFonts[1], &environment.cssLimits),
    run systemFont(&mut catalog, environment.systemFonts[2], &environment.cssLimits),
    run systemFont(&mut catalog, environment.systemFonts[3], &environment.cssLimits),
    run systemFont(&mut catalog, environment.systemFonts[4], &environment.cssLimits),
    run systemFont(&mut catalog, environment.systemFonts[5], &environment.cssLimits),
  ]
  let host = HostContext {
    dimensions: environment.media.initial,
    colors: environment.colors,
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let fragment = match &environment.structure.fragment {
    Option<&[u8]>.Some { value } => value
    _ => match &environment.base.fragment() {
      Option<&[u8]>.Some { value } => value
      _ => b""
    }
  }
  let selection = run view_selection.select(
    &graph.*,
    fragment,
    &mut catalog.engine.values,
    &environment.cssLimits,
  )
  return run document_styles.buildGraph(
    &mut graph.*,
    move catalog,
    &host,
    &environment.media,
    move selection,
    &environment.cssLimits,
    &environment.structure,
  )
}

effect fn cssFailure(error: CssError) -> StyledGraph
  ! RenderError {
  drop error
  fail RenderError.TooLarge
}

effect fn contextFailure(error: ComputedError) -> StyledGraph
  ! RenderError {
  drop error
  fail RenderError.InvalidStyleContext
}

effect fn structureFailure(error: StructureError) -> StyledGraph
  ! RenderError {
  match error {
    StructureError.InvalidXml => {
      fail RenderError.InvalidXml
    }
    StructureError.InvalidRoot => {
      fail RenderError.InvalidRoot
    }
    StructureError.TooLarge => {
      fail RenderError.TooLarge
    }
  }
}

pub effect fn styles(graph: &mut Graph, environment: &Environment) -> StyledGraph
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  return run Effect.catch<StructureError>(
    Effect.catch<ComputedError>(
      Effect.catch<CssError>(compute(&mut graph.*, environment), cssFailure),
      contextFailure,
    ),
    structureFailure,
  )
}

/// No host initials, for an [`Environment`] whose documents parse their own initial values.
pub fn noInitials<'a>() -> Option<&'a Initials> {
  return Option<&'a Initials>.None
}

/// Independent SVG image context: host preferences and initial font metrics are
/// retained, while viewport-dependent CSS and processing policy are local.
pub fn embedded<'a>(host: &'a Environment, base: &'a Url, viewport: Size) -> Environment<'a> {
  let mut media = host.media
  media.initial.viewportWidth = viewport.width
  media.initial.viewportHeight = viewport.height
  media.initial.smallViewportWidth = viewport.width
  media.initial.smallViewportHeight = viewport.height
  media.initial.dynamicViewportWidth = viewport.width
  media.initial.dynamicViewportHeight = viewport.height
  let mode = if host.structure.policy.mode == ProcessingMode.Animated
    || host.structure.policy.mode == ProcessingMode.SecureAnimated {
    ProcessingMode.SecureAnimated
  } else {
    ProcessingMode.SecureStatic
  }
  return Environment {
    base: base,
    media: media,
    colors: host.colors,
    fontFamily: host.fontFamily,
    systemFonts: host.systemFonts,
    cssLimits: host.cssLimits,
    fonts: host.fonts,
    initials: host.initials,
    structure: StructureOptions {
      policy: Policy { mode: mode, limits: host.structure.policy.limits },
      languages: host.structure.languages,
      supportedExtensions: host.structure.supportedExtensions,
      fragment: Option<&'a [u8]>.None,
      limits: host.structure.limits,
    },
  }
}
