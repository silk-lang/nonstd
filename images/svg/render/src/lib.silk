//! Parse, resolve and render SVG with the vector CPU backend.
pub import svg_core.scene { RenderOptions, RenderError, RenderTree, DisplayList, HitTarget }
pub import vector.pixmap { Pixmap }
pub import record { record }
import svg_core.structure { Graph, StructureError }
import svg_core.structure
import svg_core.url { Url }
import svg_core.resolve
import svg_core.image_assets
import svg_core.image_assets { DocumentSource }
import svg_core.scene { GlyphDocument }
import svg_core.mask_layer_sources
import document_images
import svg_geometry.geometry { Size }
import svg_raster.cpu
import vector.geometry_error { GeometryError }
pub import environment { Environment }
import environment
import native_environment
import svg_core.resources { Resolver, ResourceError, ProcessingMode }
import svg_core.animation
import svg_core.document_styles
import svg_xml.xml { NodeId }
import svg_core.css_animations
import svg_core.color_profiles
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u32
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn invalidStructure(error: StructureError) -> Graph
  ! RenderError {
  match error {
    StructureError.InvalidXml => {
      fail RenderError.InvalidXml
    }
    StructureError.InvalidRoot => {
      fail RenderError.InvalidRoot
    }
    StructureError.TooLarge => {
      fail RenderError.TooLarge
    }
  }
}

struct Budget {
  documentCount: usize,
  documents: usize,
  assets: usize,
  pixels: usize,
  occurrences: usize,
}

fn budget(options: &RenderOptions, host: &Environment) -> Budget {
  return Budget {
    documentCount: host.structure.limits.maxDocuments,
    documents: host.structure.limits.maxTotalBytes,
    assets: host.structure.limits.maxTotalBytes,
    pixels: options.maxPixels,
    occurrences: host.structure.limits.maxOccurrences,
  }
}

effect fn loaded(
  input: Graph,
  options: &RenderOptions,
  host: &Environment,
  viewport: Option<Size>,
  glyph: Option<GlyphDocument>,
  depth: usize,
  remaining: &mut Budget,
) -> RenderTree
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let mut graph = move input

  // Animated processing modes run declarative animation (SVG 2 #processing-modes), here
  // sampled once at the requested time.
  let mode = host.structure.policy.mode
  if mode == ProcessingMode.Animated || mode == ProcessingMode.SecureAnimated {
    // An mpath's motion path is its target's computed `d`, so documents with mpath
    // elements are styled once before sampling.
    let mut targets = List<List<NodeId>>.make()
    let mut named = false
    let mut d: usize = 0
    while d < graph.documents.length() {
      let found = run animation.motionTargets(&graph.documents.asSlice()[d].document)
      named = named || found.length() > 0
      run targets.append(move found)
      d = d + 1
    }
    let mut computed = List<List<animation.MotionPath>>.make()
    if named {
      let unanimated = run environment.styles(&mut graph, host)
      d = 0
      while d < graph.documents.length() {
        run computed.append(
          run document_styles.motionPaths(&graph, &unanimated, d, targets.asSlice()[d].asSlice()),
        )
        d = d + 1
      }
    } else {
      d = 0
      while d < graph.documents.length() {
        run computed.append(List<animation.MotionPath>.make())
        d = d + 1
      }
    }
    let documents = graph.documents.asMutSlice()
    d = 0
    while d < documents.length {
      run animation.sample(
        &mut documents[d].document,
        options.time,
        computed.asSlice()[d].asSlice(),
      )
      d = d + 1
    }
  }
  let mut styles = run environment.styles(&mut graph, host)

  // CSS Animations need the computed animation properties, so they are sampled after a first
  // cascade and styled again only when one applies.
  if (mode == ProcessingMode.Animated || mode == ProcessingMode.SecureAnimated)
    && run css_animations.sample(&mut graph, &styles, options.time) {
    styles = run environment.styles(&mut graph, host)
  }
  if graph.documents.length() > remaining.documentCount
    || graph.resourceBytes() > remaining.documents
    || graph.occurrences.length() > remaining.occurrences {
    fail RenderError.TooLarge
  }
  remaining.documentCount = remaining.documentCount - graph.documents.length()
  remaining.documents = remaining.documents - graph.resourceBytes()
  remaining.occurrences = remaining.occurrences - graph.occurrences.length()

  // SVG 1.1 colour profiles: icc-color() paints use the profiles they name, and images
  // become sRGB per their embedded description or `color-profile` property.
  let profiles = run color_profiles.load(&graph, &styles)
  color_profiles.applyColors(&mut styles.catalog.engine.values, &profiles)
  let mut images = run image_assets.load(&graph, remaining.pixels)
  run image_assets.loadLayers(
    &mut images,
    &graph,
    run mask_layer_sources.requests(&graph, &styles),
    remaining.pixels,
  )
  run image_assets.applyProfiles(&mut images, &graph, &styles, &profiles)
  if images.retainedBytes > remaining.assets {
    fail RenderError.TooLarge
  }
  remaining.assets = remaining.assets - images.retainedBytes
  let mut i: usize = 0
  while i < images.assets.length() {
    let image = &images.assets.asSlice()[i].image
    let count = u32.toUsize(image.width()) * u32.toUsize(image.height())
    if count > remaining.pixels {
      fail RenderError.TooLarge
    }
    remaining.pixels = remaining.pixels - count
    i = i + 1
  }
  run document_images.prepare(&mut images, host)
  let mut tree = match &viewport {
    Option<Size>.Some { value } => run resolve.resolveEmbedded(
      move images,
      move graph,
      move styles,
      options,
      &host.cssLimits,
      host.fonts,
      value,
      glyph,
    )
    _ => run resolve.resolveWithImages(
      move images,
      move graph,
      move styles,
      options,
      &host.cssLimits,
      host.fonts,
      host.media.initial.viewportWidth,
      host.media.initial.viewportHeight,
    )
  }
  i = 0
  while i < tree.embedded.length() {
    let entry = &tree.embedded.asSlice()[i]
    let result = run Effect.result(
      parseSource(
        &tree.documents.asSlice()[entry.source],
        options,
        host,
        entry.viewport,
        entry.glyph,
        depth + 1,
        &mut remaining.*,
      ),
    )
    match move result {
      Result<RenderTree, RenderError | OutOfMemoryError>.Success { value } => {
        let entries = tree.embedded.asMutSlice()
        entries[i].tree = Option<RenderTree>.some(move value)
      }
      Result<RenderTree, RenderError | OutOfMemoryError>.Failure { error } => match &error {
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
        RenderError problem => {
          if problem == RenderError.TooLarge {
            fail problem
          }
        }
      }
    }
    i = i + 1
  }
  run Effect.catch<GeometryError>(resolve.finishEmbedded(&mut tree), invalidBounds)
  return move tree
}

effect fn invalidBounds(error: GeometryError) -> ()
  ! RenderError {
  drop error
  fail RenderError.InvalidGeometry
}

effect fn invalidResource(error: ResourceError) -> Graph
  ! RenderError {
  if error == ResourceError.TooLarge {
    fail RenderError.TooLarge
  }
  fail RenderError.InvalidXml
}

effect fn parseSource(
  source: &DocumentSource,
  options: &RenderOptions,
  host: &Environment,
  viewport: Size,
  glyph: Option<GlyphDocument>,
  depth: usize,
  remaining: &mut Budget,
) -> RenderTree
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  if depth > host.structure.limits.maxReferenceDepth {
    fail RenderError.TooLarge
  }
  let base = match &source.response.finalUrl {
    Option<Url>.Some { value } => &value
    _ => &source.request
  }
  let mut local = environment.embedded(host, base, viewport)
  local.structure.fragment = source.request.fragment()

  // Glyph documents render in secure static mode (OpenType `SVG ` table), whole: the
  // glyph element is chosen in resolve, not by a fragment.
  if glyph.isSome() {
    local.structure.fragment = Option<&[u8]>.None
    local.structure.policy.mode = ProcessingMode.SecureStatic
  }
  local.structure.limits.maxDocuments = remaining.documentCount
  local.structure.limits.maxTotalBytes = remaining.documents
  local.structure.limits.maxOccurrences = remaining.occurrences
  let graph = run Effect.catch<ResourceError>(
    Effect.catch<StructureError>(
      structure.buildResponse(&source.response, &source.request, &local.structure),
      invalidStructure,
    ),
    invalidResource,
  )
  return run loaded(
    move graph,
    options,
    &local,
    Option<Size>.some(viewport),
    glyph,
    depth,
    &mut remaining.*,
  )
}

/// Parse XML, compute CSS and retain independent embedded SVG pictures.
pub effect fn parse(data: &[u8], options: &RenderOptions, host: &Environment) -> RenderTree
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let graph = run Effect.catch<StructureError>(
    structure.build(data, host.base, &host.structure),
    invalidStructure,
  )
  let mut remaining = budget(options, host)
  return run loaded(
    move graph,
    options,
    host,
    Option<Size>.None,
    Option<GlyphDocument>.None,
    0,
    &mut remaining,
  )
}

/// Parse an SVG image in a secure, exact logical viewport, including fractions.
/// Output overrides and zoom belong to the referencing image's device mapping.
pub effect fn parseEmbedded(
  data: &[u8],
  options: &RenderOptions,
  host: &Environment,
  viewport: Size,
) -> RenderTree
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let local = environment.embedded(host, host.base, viewport)
  let graph = run Effect.catch<StructureError>(
    structure.build(data, local.base, &local.structure),
    invalidStructure,
  )
  let mut remaining = budget(options, &local)
  return run loaded(
    move graph,
    options,
    &local,
    Option<Size>.some(viewport),
    Option<GlyphDocument>.None,
    0,
    &mut remaining,
  )
}

/// Render a retained display list; callers can reuse it without reparsing XML.
pub effect fn renderDisplayList(list: &DisplayList) -> Pixmap
  ! RenderError | OutOfMemoryError
  ? &mut Allocator {
  return run cpu.execute(list)
}

/// The element at the point (`x`, `y`) of the rendered image, in pixels from its top-left
/// corner: the topmost element whose `pointer-events` region holds the point (SVG 2
/// §15.5.1), or None over no such element. Clip paths limit regions; masks, filters and
/// opacity do not.
pub effect fn hitTest(list: &DisplayList, x: f64, y: f64) -> Option<HitTarget>
  ! RenderError | OutOfMemoryError
  ? &mut Allocator {
  return match run cpu.hitTest(list, x, y) {
    Option<usize>.Some { value } => Option<HitTarget>.some(list.targets.asSlice()[value])
    Option<usize>.None => Option<HitTarget>.None
  }
}

pub effect fn render(data: &[u8], options: &RenderOptions, host: &Environment) -> Pixmap
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let tree = run parse(data, options, host)
  let list = run record(move tree)
  return run renderDisplayList(&list)
}
