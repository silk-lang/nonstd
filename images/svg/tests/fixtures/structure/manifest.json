      "status": "pass",
      "reason": "An outer SVG uses its CSS layout box for the default transform reference, independently of its viewBox.",
      "spec": "https://www.w3.org/TR/css-transforms-1/#transform-box",
      "tolerance": {}
    },
    {
      "id": "unknown-and-foreign-content",
