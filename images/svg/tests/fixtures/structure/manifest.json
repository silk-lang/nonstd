          "relation": "=="
        }
      ],
      "status": "pass",
      "reason": "Clipping follows the transformed physical viewport polygon and remains local to its subtree.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/render.html#OverflowAndClipProperties",
      "tolerance": {}
    },
    {
