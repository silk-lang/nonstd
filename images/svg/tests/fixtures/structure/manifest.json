    {
      "id": "use-shadow-inheritance",
      "input": "inputs/use-shadow-inheritance.svg",
      "references": [
        {
          "path": "references/use-shadow-inheritance.svg",
          "relation": "=="
        }
      ],
      "status": "pass",
      "reason": "Repeated uses inherit independently and rematch selectors within their own shadow topology, not source or host ancestry.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#UseStyleInheritance",
      "tolerance": {}
    },
    {
      "id": "symbol-instance-viewport",
