        {
          "path": "references/switch-svg2-selection.svg",
          "relation": "=="
        }
      ],
      "status": "pass",
      "reason": "SVG2 selection ignores requiredFeatures, evaluates requiredExtensions, and never falls through because a selected element is hidden or non-rendering.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#SwitchElement",
      "tolerance": {}
    },
    {
