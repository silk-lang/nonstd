          "path": "references/symbol-instance-viewport.svg",
          "relation": "=="
        }
      ],
      "status": "pass",
      "reason": "Only the instanced symbol becomes display:inline through the UA-important host selector; use dimensions scale its viewBox.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#SymbolNotes",
      "tolerance": {}
    },
    {
      "id": "nested-viewport-overflow",
