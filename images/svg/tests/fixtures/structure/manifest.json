      "status": "pass",
      "reason": "Unknown SVG containers inherit normally; foreign private subtrees do not paint; a nested SVG inside foreignObject uses its containing block.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/struct.html#UnknownElement",
      "tolerance": {}
    },
    {
      "id": "asymmetric-viewport-overflow",
