        {
          "path": "references/nested-viewport-overflow.svg",
          "relation": "=="
        }
      ],
      "status": "pass",
      "reason": "Nested viewBox mapping clips oversize content at the physical viewport and does not leak its clip to a sibling.",
      "spec": "https://www.w3.org/TR/2018/CR-SVG2-20181004/render.html#OverflowAndClipProperties",
      "tolerance": {}
    },
    {
