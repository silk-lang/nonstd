//! CSS Animations sampled at one document time (CSS Animations 1, SVG 2 #processing-modes).
//! After a first cascade, `sample` reads each element's computed animation properties, finds
//! their @keyframes, and writes the sampled declarations into the element's animated `style`
//! attribute, which the next cascade reads at the animation origin.
import structure { Graph, OccurrenceId }
import document_styles { StyledGraph }
import stylesheets { Keyframes, Keyframe, KeyframeValue }
import animation
import svg_css.properties { Property }
import svg_css.properties
import svg_css.values { Value }
import svg_css.computed { StyleId, ComputedValue }
import svg_geometry.svg
import svg_xml.xml { Document, NodeId }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

fn view(bytes: &[u8], start: usize, end: usize) -> &[u8] {
  return Slice.view<u8>(bytes, start, end - start)
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 12
}

fn trim(bytes: &[u8]) -> &[u8] {
  let mut start: usize = 0
  let mut end = bytes.length
  while start < end && space(bytes[start]) {
    start = start + 1
  }
  while end > start && space(bytes[end - 1]) {
    end = end - 1
  }
  return view(bytes, start, end)
}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 {
    byte + 32
  } else {
    byte
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut k: usize = 0
  while k < left.length {
    if left[k] != right[k] {
      return false
    }
    k = k + 1
  }
  return true
}

// ASCII case-insensitive, as CSS keywords compare.
fn keyword(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut k: usize = 0
  while k < left.length {
    if lower(left[k]) != lower(right[k]) {
      return false
    }
    k = k + 1
  }
  return true
}

fn startsWith(bytes: &[u8], prefix: &[u8]) -> bool {
  return bytes.length >= prefix.length && keyword(view(bytes, 0, prefix.length), prefix)
}

/// Pieces of `bytes` split at `separator` outside parentheses and quotes, trimmed.
effect fn pieces(bytes: &[u8], comma: bool, out: &mut List<Span>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut depth: usize = 0
  let mut quote: u8 = 0
  let mut start: usize = 0
  let mut k: usize = 0
  while k <= bytes.length {
    let at_end = k == bytes.length
    let byte = if at_end {
      0
    } else {
      bytes[k]
    }
    if !at_end && quote != 0 {
      if byte == quote {
        quote = 0
      }
    } else if !at_end && (byte == 34 || byte == 39) {
      quote = byte
    } else if !at_end && byte == 40 {
      depth = depth + 1
    } else if !at_end && byte == 41 && depth > 0 {
      depth = depth - 1
    } else if at_end || depth == 0 && (comma && byte == 44 || !comma && space(byte)) {
      let piece = trim(view(bytes, start, k))
      if piece.length > 0 || comma {
        let offset = start + trimmedStart(view(bytes, start, k))
        run out.append(Span { start: offset, end: offset + piece.length })
      }
      start = k + 1
    }
    k = k + 1
  }
}

fn trimmedStart(bytes: &[u8]) -> usize {
  let mut start: usize = 0
  while start < bytes.length && space(bytes[start]) {
    start = start + 1
  }
  return start
}

struct Span {
  start: usize,
  end: usize,
}

impl Copy for Span {}

enum Jump {
  Start,
  End,
  None,
  Both,
}

/// An easing function (CSS Easing 1): cubic Bézier or steps.
union Timing {
  Bezier { pub x1: f64, pub y1: f64, pub x2: f64, pub y2: f64 },
  Steps { pub count: f64, pub jump: Jump },
}

impl Copy for Timing {}

enum Direction {
  Normal,
  Reverse,
  Alternate,
  AlternateReverse,
}

enum Fill {
  None,
  Forwards,
  Backwards,
  Both,
}

struct Entry {
  name: Bytes,
  duration: f64,
  timing: Timing,
  delay: f64,
  iterations: f64,
  direction: Direction,
  fill: Fill,
  paused: bool,
}

fn nan(value: f64) -> bool {
  return value != value
}

fn ease() -> Timing {
  return Timing.Bezier { x1: 0.25, y1: 0.1, x2: 0.25, y2: 1.0 }
}

effect fn defaults() -> Entry
  ! OutOfMemoryError
  ? &mut Allocator {
  return Entry {
    name: run Bytes.copy(b"none"),
    duration: 0.0,
    timing: ease(),
    delay: 0.0,
    iterations: 1.0,
    direction: Direction.Normal,
    fill: Fill.None,
    paused: false,
  }
}

effect fn copyEntry(entry: &Entry) -> Entry
  ! OutOfMemoryError
  ? &mut Allocator {
  return Entry {
    name: run Bytes.copy(Bytes.asSlice(&entry.name)),
    duration: entry.duration,
    timing: entry.timing,
    delay: entry.delay,
    iterations: entry.iterations,
    direction: entry.direction,
    fill: entry.fill,
    paused: entry.paused,
  }
}

// A <time>: a number with s or ms (CSS Values 4 #time).
fn time(word: &[u8]) -> Option<f64> {
  let mut cut: usize = 1
  let mut scale: f64 = 1.0
  if word.length > 2 && keyword(view(word, word.length - 2, word.length), b"ms") {
    cut = 2
    scale = 0.001
  } else if word.length < 2 || !keyword(view(word, word.length - 1, word.length), b"s") {
    return Option<f64>.None
  }
  return match svg.number(view(word, 0, word.length - cut)) {
    Option<f64>.Some { value } => Option<f64>.Some { value: value * scale }
    _ => Option<f64>.None
  }
}

// Comma-separated numbers inside `name(...)`.
fn arguments(
  word: &[u8],
  name: &[u8],
  out: &mut [f64; 4],
  words: &mut [Option<usize>; 2],
) -> Option<usize> {
  if !startsWith(word, name) || word.length < name.length + 2 || word[name.length] != 40
    || word[word.length - 1] != 41 {
    return Option<usize>.None
  }
  let inner = view(word, name.length + 1, word.length - 1)
  let mut count: usize = 0
  let mut start: usize = 0
  let mut k: usize = 0
  while k <= inner.length {
    if k == inner.length || inner[k] == 44 {
      let item = trim(view(inner, start, k))
      if count >= 4 {
        return Option<usize>.None
      }
      match svg.number(item) {
        Option<f64>.Some { value } => {
          out[count] = value
        }
        _ => {
          // steps() takes a position keyword as its second argument.
          if count < 2 {
            words[count] = Option<usize>.Some {
              value: name.length + 1 + start + trimmedStart(view(inner, start, k))
            }
          }
          out[count] = f64.NAN
        }
      }
      count = count + 1
      start = k + 1
    }
    k = k + 1
  }
  return Option<usize>.Some { value: count }
}

// An <easing-function> (CSS Easing 1 #easing-functions); linear() is treated as linear.
fn timing(word: &[u8]) -> Option<Timing> {
  if keyword(word, b"linear") || startsWith(word, b"linear(") {
    return Option<Timing>.Some { value: Timing.Bezier { x1: 0.0, y1: 0.0, x2: 1.0, y2: 1.0 } }
  }
  if keyword(word, b"ease") {
    return Option<Timing>.Some { value: ease() }
  }
  if keyword(word, b"ease-in") {
    return Option<Timing>.Some { value: Timing.Bezier { x1: 0.42, y1: 0.0, x2: 1.0, y2: 1.0 } }
  }
  if keyword(word, b"ease-out") {
    return Option<Timing>.Some { value: Timing.Bezier { x1: 0.0, y1: 0.0, x2: 0.58, y2: 1.0 } }
  }
  if keyword(word, b"ease-in-out") {
    return Option<Timing>.Some { value: Timing.Bezier { x1: 0.42, y1: 0.0, x2: 0.58, y2: 1.0 } }
  }
  if keyword(word, b"step-start") {
    return Option<Timing>.Some { value: Timing.Steps { count: 1.0, jump: Jump.Start } }
  }
  if keyword(word, b"step-end") {
    return Option<Timing>.Some { value: Timing.Steps { count: 1.0, jump: Jump.End } }
  }
  let mut numbers: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
  let mut words: [Option<usize>; 2] = [Option<usize>.None, Option<usize>.None]
  if let Option<usize>.Some { value } = arguments(word, b"cubic-bezier", &mut numbers, &mut words) {
    if value != 4 || nan(numbers[0]) || nan(numbers[1]) || nan(numbers[2]) || nan(numbers[3])
      || numbers[0] < 0.0
      || numbers[0] > 1.0
      || numbers[2] < 0.0
      || numbers[2] > 1.0 {
      return Option<Timing>.None
    }
    return Option<Timing>.Some {
      value: Timing.Bezier { x1: numbers[0], y1: numbers[1], x2: numbers[2], y2: numbers[3] },
    }
  }
  if let Option<usize>.Some { value } = arguments(word, b"steps", &mut numbers, &mut words) {
    let count = numbers[0]
    if value < 1 || value > 2 || nan(count) || count != f64.floor(count) || count < 1.0 {
      return Option<Timing>.None
    }
    let mut jump = Jump.End
    if value == 2 {
      let at = match words[1] {
        Option<usize>.Some { value: start } => start
        _ => {
          return Option<Timing>.None
        }
      }
      let rest = trim(view(word, at, word.length - 1))
      jump = if keyword(rest, b"jump-start") || keyword(rest, b"start") {
        Jump.Start
      } else if keyword(rest, b"jump-end") || keyword(rest, b"end") {
        Jump.End
      } else if keyword(rest, b"jump-none") {
        Jump.None
      } else if keyword(rest, b"jump-both") {
        Jump.Both
      } else {
        return Option<Timing>.None
      }
      if jump == Jump.None && count < 2.0 {
        return Option<Timing>.None
      }
    }
    return Option<Timing>.Some { value: Timing.Steps { count: count, jump: jump } }
  }
  return Option<Timing>.None
}

fn eased(timing: Timing, x: f64) -> f64 {
  return match timing {
    Timing.Bezier { x1, y1, x2, y2 } => if x <= 0.0 || x >= 1.0 {
      x
    } else {
      animation.spline(x1, y1, x2, y2, x)
    }
    Timing.Steps { count, jump } => {
      let jumps = match jump {
        Jump.Both => count + 1.0
        Jump.None => count - 1.0
        _ => count
      }
      let mut current = f64.floor(x * count)
      if jump == Jump.Start || jump == Jump.Both {
        current = current + 1.0
      }
      if x >= 0.0 && current < 0.0 {
        current = 0.0
      }
      if x <= 1.0 && current > jumps {
        current = jumps
      }
      current / jumps
    }
  }
}

fn iterationCount(word: &[u8]) -> Option<f64> {
  if keyword(word, b"infinite") {
    return Option<f64>.Some { value: f64.INFINITY }
  }
  return match svg.number(word) {
    Option<f64>.Some { value } => if value >= 0.0 {
      Option<f64>.Some { value: value }
    } else {
      Option<f64>.None
    }
    _ => Option<f64>.None
  }
}

fn direction(word: &[u8]) -> Option<Direction> {
  if keyword(word, b"normal") {
    return Option<Direction>.Some { value: Direction.Normal }
  }
  if keyword(word, b"reverse") {
    return Option<Direction>.Some { value: Direction.Reverse }
  }
  if keyword(word, b"alternate") {
    return Option<Direction>.Some { value: Direction.Alternate }
  }
  if keyword(word, b"alternate-reverse") {
    return Option<Direction>.Some { value: Direction.AlternateReverse }
  }
  return Option<Direction>.None
}

fn fill(word: &[u8]) -> Option<Fill> {
  if keyword(word, b"none") {
    return Option<Fill>.Some { value: Fill.None }
  }
  if keyword(word, b"forwards") {
    return Option<Fill>.Some { value: Fill.Forwards }
  }
  if keyword(word, b"backwards") {
    return Option<Fill>.Some { value: Fill.Backwards }
  }
  if keyword(word, b"both") {
    return Option<Fill>.Some { value: Fill.Both }
  }
  return Option<Fill>.None
}

fn playState(word: &[u8]) -> Option<bool> {
  if keyword(word, b"running") {
    return Option<bool>.Some { value: false }
  }
  if keyword(word, b"paused") {
    return Option<bool>.Some { value: true }
  }
  return Option<bool>.None
}

// A <keyframes-name>, unquoted.
effect fn name(word: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if word.length >= 2 && (word[0] == 34 || word[0] == 39) && word[word.length - 1] == word[0] {
    return run Bytes.copy(view(word, 1, word.length - 1))
  }
  return run Bytes.copy(word)
}

// One <single-animation> of the shorthand (CSS Animations 1 #animation): each component
// takes the first word it accepts, in the grammar's order, and the rest names keyframes.
effect fn single(text: &[u8]) -> Entry
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut entry = run defaults()
  let mut words = List<Span>.make()
  run pieces(text, false, &mut words)
  let mut times: usize = 0
  let mut seen: [bool; 6] = [false, false, false, false, false, false]
  let list = words.asSlice()
  let mut k: usize = 0
  while k < list.length {
    let word = view(text, list[k].start, list[k].end)
    k = k + 1
    if times < 2 {
      if let Option<f64>.Some { value } = time(word) {
        if times == 0 {
          entry.duration = value
        } else {
          entry.delay = value
        }
        times = times + 1
        continue
      }
    }
    if !seen[0] {
      if let Option<Timing>.Some { value } = timing(word) {
        entry.timing = value
        seen[0] = true
        continue
      }
    }
    if !seen[1] {
      if let Option<f64>.Some { value } = iterationCount(word) {
        entry.iterations = value
        seen[1] = true
        continue
      }
    }
    if !seen[2] {
      if let Option<Direction>.Some { value } = direction(word) {
        entry.direction = value
        seen[2] = true
        continue
      }
    }
    if !seen[3] {
      if let Option<Fill>.Some { value } = fill(word) {
        entry.fill = value
        seen[3] = true
        continue
      }
    }
    if !seen[4] {
      if let Option<bool>.Some { value } = playState(word) {
        entry.paused = value
        seen[4] = true
        continue
      }
    }
    if !seen[5] {
      entry.name = run name(word)
      seen[5] = true
    }
  }
  return move entry
}

fn rawText<'s>(styled: &'s StyledGraph, style: StyleId, property: Property) -> &'s [u8] {
  let engine = &styled.catalog.engine
  let computed = match engine.get(style, property) {
    Option<ComputedValue>.Some { value } => value
    _ => {
      return b""
    }
  }
  return match &engine.values.get(computed.value).* {
    Value.Raw { text } => view(Bytes.asSlice(&engine.values.strings), text.start, text.end)
    _ => b""
  }
}

// Whether a longhand holds anything but its initial value.
fn authored(text: &[u8], property: Property) -> bool {
  return text.length > 0 && !keyword(text, properties.initial(property))
}

// The element's animations: the shorthand's list, with authored longhands laid over it.
// Longhand lists repeat to the length of the name list (CSS Animations 1 #animation-name).
effect fn entries(styled: &StyledGraph, style: StyleId, out: &mut List<Entry>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let shorthand = rawText(styled, style, Property.Animation)
  if authored(shorthand, Property.Animation) {
    let mut items = List<Span>.make()
    run pieces(shorthand, true, &mut items)
    let list = items.asSlice()
    let mut k: usize = 0
    while k < list.length {
      run out.append(run single(view(shorthand, list[k].start, list[k].end)))
      k = k + 1
    }
  }
  let names = rawText(styled, style, Property.AnimationName)
  if authored(names, Property.AnimationName) {
    let mut items = List<Span>.make()
    run pieces(names, true, &mut items)
    let list = items.asSlice()
    let mut resized = List<Entry>.make()
    let mut k: usize = 0
    while k < list.length {
      let mut entry = if out.length() > 0 {
        run copyEntry(&out.asSlice()[k % out.length()])
      } else {
        run defaults()
      }
      entry.name = run name(view(names, list[k].start, list[k].end))
      run resized.append(move entry)
      k = k + 1
    }
    out.clear()
    k = 0
    while k < resized.length() {
      run out.append(run copyEntry(&resized.asSlice()[k]))
      k = k + 1
    }
  }
  if out.length() == 0 {
    return
  }
  let longhands: [Property; 7] = [
    Property.AnimationDuration,
    Property.AnimationTimingFunction,
    Property.AnimationDelay,
    Property.AnimationIterationCount,
    Property.AnimationDirection,
    Property.AnimationFillMode,
    Property.AnimationPlayState,
  ]
  let mut p: usize = 0
  while p < 7 {
    let property = longhands[p]
    p = p + 1
    let text = rawText(styled, style, property)
    if !authored(text, property) {
      continue
    }
    let mut items = List<Span>.make()
    run pieces(text, true, &mut items)
    let list = items.asSlice()
    if list.length == 0 {
      continue
    }
    let all = out.asMutSlice()
    let mut k: usize = 0
    while k < all.length {
      let word = view(text, list[k % list.length].start, list[k % list.length].end)
      if property == Property.AnimationDuration {
        if let Option<f64>.Some { value } = time(word) {
          all[k].duration = value
        }
      } else if property == Property.AnimationTimingFunction {
        if let Option<Timing>.Some { value } = timing(word) {
          all[k].timing = value
        }
      } else if property == Property.AnimationDelay {
        if let Option<f64>.Some { value } = time(word) {
          all[k].delay = value
        }
      } else if property == Property.AnimationIterationCount {
        if let Option<f64>.Some { value } = iterationCount(word) {
          all[k].iterations = value
        }
      } else if property == Property.AnimationDirection {
        if let Option<Direction>.Some { value } = direction(word) {
          all[k].direction = value
        }
      } else if property == Property.AnimationFillMode {
        if let Option<Fill>.Some { value } = fill(word) {
          all[k].fill = value
        }
      } else if let Option<bool>.Some { value } = playState(word) {
        all[k].paused = value
      }
      k = k + 1
    }
  }
}

// The directed progress of `entry` at `time`, or none outside its active and filled
// phases (Web Animations 1 #calculating-the-active-time, #calculating-the-directed-progress).
fn progress(entry: &Entry, time: f64) -> Option<f64> {
  let local = (if entry.paused {
    0.0
  } else {
    time
  })
    - entry.delay
  let duration = f64.max(entry.duration, 0.0)
  let active = if duration == 0.0 || entry.iterations == 0.0 {
    0.0
  } else {
    duration * entry.iterations
  }
  let mut overall: f64 = 0.0
  if local < 0.0 {
    if entry.fill != Fill.Backwards && entry.fill != Fill.Both {
      return Option<f64>.None
    }
  } else if local < active {
    overall = local / duration
  } else {
    if entry.fill != Fill.Forwards && entry.fill != Fill.Both {
      return Option<f64>.None
    }
    overall = if duration == 0.0 {
      entry.iterations
    } else {
      active / duration
    }
  }
  let mut iteration = f64.floor(overall)
  let mut simple = overall - iteration
  if simple == 0.0 && overall > 0.0 && local >= active {
    iteration = iteration - 1.0
    simple = 1.0
  }
  if f64.isInfinite(overall) {
    return Option<f64>.None
  }
  let odd = f64.remainder(iteration, 2.0) != 0.0
  let reversed = match entry.direction {
    Direction.Normal => false
    Direction.Reverse => true
    Direction.Alternate => odd
    Direction.AlternateReverse => !odd
  }
  return Option<f64>.Some {
    value: if reversed {
      1.0 - simple
    } else {
      simple
    },
  }
}

struct Stop {
  offset: f64,
  frame: usize,
  value: usize,
}

impl Copy for Stop {}

// The keyframe value of one property at `at`, written as "name: value" into `out`.
effect fn propertyAt(
  keyframes: &Keyframes,
  property: &[u8],
  entry: &Entry,
  at: f64,
  underlying: &[u8],
  out: &mut Bytes,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let frames = keyframes.frames.asSlice()
  let mut stops = List<Stop>.make()
  let mut f: usize = 0
  while f < frames.length {
    let values = frames[f].values.asSlice()
    let mut chosen = Option<usize>.None
    let mut v: usize = 0
    while v < values.length {
      if keyword(Bytes.asSlice(&values[v].name), property) {
        chosen = Option<usize>.Some { value: v }
      }
      v = v + 1
    }
    if let Option<usize>.Some { value } = chosen {
      let offsets = frames[f].offsets.asSlice()
      let mut o: usize = 0
      while o < offsets.length {
        // A later keyframe at the same offset replaces the earlier one.
        let all = stops.asMutSlice()
        let mut replaced = false
        let mut s: usize = 0
        while s < all.length {
          if all[s].offset == offsets[o] {
            all[s] = Stop { offset: offsets[o], frame: f, value: value }
            replaced = true
          }
          s = s + 1
        }
        if !replaced {
          run stops.append(Stop { offset: offsets[o], frame: f, value: value })
        }
        o = o + 1
      }
    }
    f = f + 1
  }
  let sorted = stops.asMutSlice()
  let mut k: usize = 1
  while k < sorted.length {
    let mut m = k
    while m > 0 && sorted[m - 1].offset > sorted[m].offset {
      let swap = sorted[m - 1]
      sorted[m - 1] = sorted[m]
      sorted[m] = swap
      m = m - 1
    }
    k = k + 1
  }
  let list = stops.asSlice()
  if list.length == 0 {
    return
  }

  // Missing 0% and 100% keyframes use the underlying value (#keyframes).
  let first = list[0]
  let last = list[list.length - 1]
  let mut fromOffset: f64 = 0.0
  let mut toOffset: f64 = 1.0
  let mut fromText = underlying
  let mut toText = underlying
  let mut timingOf = entry.timing
  if at < first.offset {
    toOffset = first.offset
    toText = Bytes.asSlice(&frames[first.frame].values.asSlice()[first.value].value)
  } else if at >= last.offset {
    fromOffset = last.offset
    fromText = Bytes.asSlice(&frames[last.frame].values.asSlice()[last.value].value)
    timingOf = frameTiming(&frames[last.frame], entry.timing)
    if last.offset == 1.0 {
      toText = fromText
    }
  } else {
    let mut s: usize = 0
    while s + 1 < list.length && list[s + 1].offset <= at {
      s = s + 1
    }
    fromOffset = list[s].offset
    toOffset = list[s + 1].offset
    fromText = Bytes.asSlice(&frames[list[s].frame].values.asSlice()[list[s].value].value)
    toText = Bytes.asSlice(&frames[list[s + 1].frame].values.asSlice()[list[s + 1].value].value)
    timingOf = frameTiming(&frames[list[s].frame], entry.timing)
  }
  let width = toOffset - fromOffset
  let local = if width > 0.0 {
    (at - fromOffset) / width
  } else {
    1.0
  }
  if out.length() > 0 {
    run out.append(b"; ")
  }
  run out.append(property)
  run out.append(b": ")
  run animation.interpolate(property, fromText, toText, eased(timingOf, local), &mut out.*)
}

fn frameTiming(frame: &Keyframe, fallback: Timing) -> Timing {
  return match &frame.timing {
    Option<Bytes>.Some { value } => match timing(trim(Bytes.asSlice(&value))) {
      Option<Timing>.Some { value: parsed } => parsed
      _ => fallback
    }
    _ => fallback
  }
}

fn keyframesNamed<'s>(styled: &'s StyledGraph, name: &[u8]) -> Option<&'s Keyframes> {
  let all = styled.catalog.keyframes.asSlice()
  let mut found = Option<&'s Keyframes>.None
  let mut k: usize = 0
  while k < all.length {
    if same(Bytes.asSlice(&all[k].name), name) {
      found = Option<&'s Keyframes>.Some { value: &all[k] }
    }
    k = k + 1
  }
  return found
}

struct Write {
  document: usize,
  node: NodeId,
  style: Bytes,
}

/// Samples the CSS animations of every element in `graph` at `time` seconds and writes their
/// values into the source documents. Returns whether anything was written, in which case the
/// graph must be styled again. Each source element is sampled once, from its first occurrence.
pub effect fn sample(graph: &mut Graph, styled: &StyledGraph, time: f64) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if styled.catalog.keyframes.length() == 0 {
    return false
  }
  let mut seen = List<List<bool>>.make()
  let mut d: usize = 0
  while d < graph.documents.length() {
    let mut marks = List<bool>.make()
    let mut n: usize = 0
    while n < Document.nodes(&graph.documents.asSlice()[d].document).length {
      run marks.append(false)
      n = n + 1
    }
    run seen.append(move marks)
    d = d + 1
  }
  let mut writes = List<Write>.make()
  let mut i: usize = 0
  while i < graph.occurrences.length() {
    let source = graph.occurrences.asSlice()[i].source
    let style = match styled.nodeStyle(OccurrenceId { index: i }) {
      Option<StyleId>.Some { value } => value
      _ => {
        i = i + 1
        continue
      }
    }
    i = i + 1
    let marks = seen.asMutSlice()[source.document.index].asMutSlice()
    if marks[source.node.index] {
      continue
    }
    marks[source.node.index] = true
    let mut list = List<Entry>.make()
    run entries(styled, style, &mut list)
    if list.length() == 0 {
      continue
    }
    let document = &graph.documents.asSlice()[source.document.index].document

    // Later animations in the list override earlier ones for the same property.
    let mut names = List<Bytes>.make()
    let mut texts = List<Bytes>.make()
    let all = list.asSlice()
    let mut a: usize = 0
    while a < all.length {
      let entry = &all[a]
      a = a + 1
      let keyframes = match keyframesNamed(styled, Bytes.asSlice(&entry.name)) {
        Option<&Keyframes>.Some { value } => value
        _ => {
          continue
        }
      }
      let at = match progress(entry, time) {
        Option<f64>.Some { value } => value
        _ => {
          continue
        }
      }
      let frames = keyframes.frames.asSlice()
      let mut f: usize = 0
      while f < frames.length {
        let values = frames[f].values.asSlice()
        let mut v: usize = 0
        while v < values.length {
          let property = Bytes.asSlice(&values[v].name)
          v = v + 1
          let mut known = false
          let mut n: usize = 0
          while n < names.length() {
            if keyword(Bytes.asSlice(&names.asSlice()[n]), property) {
              known = true
            }
            n = n + 1
          }
          let underlying = match Document.attribute(document, source.node, b"", property) {
            Option<&[u8]>.Some { value } => value
            _ => match properties.lookup(property) {
              Option<Property>.Some { value } => properties.initial(value)
              _ => b""
            }
          }
          let mut text = Bytes.make()
          run propertyAt(keyframes, property, entry, at, underlying, &mut text)
          if !known {
            run names.append(run Bytes.copy(property))
            run texts.append(move text)
          } else {
            let slots = texts.asMutSlice()
            let mut n: usize = 0
            while n < names.length() {
              if keyword(Bytes.asSlice(&names.asSlice()[n]), property) {
                slots[n] = run Bytes.copy(Bytes.asSlice(&text))
              }
              n = n + 1
            }
          }
        }
        f = f + 1
      }
    }
    if texts.length() == 0 {
      continue
    }
    let mut declarations = Bytes.make()
    let parts = texts.asSlice()
    let mut t: usize = 0
    while t < parts.length {
      if t > 0 {
        run declarations.append(b"; ")
      }
      run declarations.append(Bytes.asSlice(&parts[t]))
      t = t + 1
    }
    run writes.append(
      Write { document: source.document.index, node: source.node, style: move declarations },
    )
  }
  let pending = writes.asSlice()
  let documents = graph.documents.asMutSlice()
  let mut w: usize = 0
  while w < pending.length {
    run Document.setAttribute(
      &mut documents[pending[w].document].document,
      pending[w].node,
      animation.animated(),
      b"style",
      Bytes.asSlice(&pending[w].style),
    )
    w = w + 1
  }
  return pending.length > 0
}
