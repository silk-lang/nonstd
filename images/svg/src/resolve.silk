struct Viewport {
  width: f64,
  height: f64,
  pixelsWidth: u32,
  pixelsHeight: u32,
  scale: Transform
}

fn positive(value: Option<f64>) -> Option<f64> {
  return match &value {
    Option<f64>.Some { value: found } => if found >= 0.0 {
      Option<f64>.some(found)
    } else {
      Option<f64>.None
    }
    _ => Option<f64>.None
  }
}

fn rootRatio(width: Option<f64>, height: Option<f64>, box: Option<Rect>) -> Option<f64> {
  match &width {
    Option<f64>.Some { value: w } => {
      match &height {
        Option<f64>.Some { value: h } => {
          if w > 0.0 && h > 0.0 {
            return Option<f64>.some(w / h)
          }
        }
        _ => {}
      }
    }
    _ => {}
  }
  match &box {
    Option<Rect>.Some { value } => {
      if value.width() > 0.0 && value.height() > 0.0 {
        return Option<f64>.some(value.width() / value.height())
      }
    }
    _ => {}
  }
  return Option<f64>.None
}

// CSS default object sizing. Host dimensions supply the embedding viewport;
// output pixel overrides do not rewrite that document coordinate system.
effect fn sizing(
  engine: &Engine,
  root: StyleId,
  box: Option<Rect>,
  options: &RenderOptions,
  initialWidth: f64,
  initialHeight: f64,
) -> Viewport
  ! RenderError {
  if !f64.isFinite(options.zoom) || options.zoom <= 0.0 {
    fail RenderError.InvalidSize
  }
  let width = positive(engine.number(root, Property.Width, initialWidth))
  let height = positive(engine.number(root, Property.Height, initialHeight))
  let ratio = rootRatio(width, height, box)
  let mut w = initialWidth
  let mut h = initialHeight
  match &width {
    Option<f64>.Some { value } => {
      w = value
      match &height {
        Option<f64>.Some { value: foundHeight } => {
          h = foundHeight
        }
        _ => {
          match &ratio {
            Option<f64>.Some { value: foundRatio } => {
              h = w / foundRatio
            }
            _ => {}
          }
        }
      }
    }
    _ => {
      match &height {
        Option<f64>.Some { value } => {
          h = value
          match &ratio {
            Option<f64>.Some { value: foundRatio } => {
              w = h * foundRatio
            }
            _ => {}
          }
        }
        _ => {
          match &ratio {
            Option<f64>.Some { value } => {
              if value >= initialWidth / initialHeight {
                h = w / value
              } else {
                w = h * value
              }
            }
            _ => {}
          }
        }
      }
    }
  }
  if !f64.isFinite(w) || !f64.isFinite(h) || w <= 0.0 || h <= 0.0 {
    fail RenderError.InvalidSize
  }
  let mut outputWidth = w
  let mut outputHeight = h
  if options.width != 0 {
    outputWidth = u32.toF64(options.width)
    outputHeight = if options.height != 0 {
      u32.toF64(options.height)
    } else {
      outputWidth * (h / w)
    }
  } else if options.height != 0 {
    outputHeight = u32.toF64(options.height)
    outputWidth = outputHeight * (w / h)
  }
  let scaledWidth = f64.ceil(outputWidth * options.zoom)
  let scaledHeight = f64.ceil(outputHeight * options.zoom)
  let pw = match &f64.checkedToU32(scaledWidth) {
    Option<u32>.Some { value } => value
    _ => {
      fail RenderError.TooLarge
    }
  }
  let ph = match &f64.checkedToU32(scaledHeight) {
    Option<u32>.Some { value } => value
    _ => {
      fail RenderError.TooLarge
    }
  }
  if pw == 0 || ph == 0 {
    fail RenderError.InvalidSize
  }
  let widthPixels = u32.toUsize(pw)
  let heightPixels = u32.toUsize(ph)

  // The RGBA size must also fit vector's usize multiplication on wasm32.
  if widthPixels > usize.MAX / 4 / heightPixels || widthPixels > options.maxPixels / heightPixels {
    fail RenderError.TooLarge
  }
  let scale = Transform.scale(u32.toF64(pw) / w, u32.toF64(ph) / h)
  if !Transform.isFinite(scale) {
    fail RenderError.InvalidSize
  }
  return Viewport { width: w, height: h, pixelsWidth: pw, pixelsHeight: ph, scale: scale }
}

// Embedded documents retain the supplied logical viewport exactly. Ceil is
// only a storage bound; device placement belongs to the referencing image.
effect fn embeddedSizing(size: Size, maxPixels: usize) -> Viewport
  ! RenderError {
  if !size.isValid() || size.width <= 0.0 || size.height <= 0.0 {
    fail RenderError.InvalidSize
  }
  let width = match &f64.checkedToU32(f64.ceil(size.width)) {
    Option<u32>.Some { value } => value
    _ => {
      fail RenderError.TooLarge
    }
  }
  let height = match &f64.checkedToU32(f64.ceil(size.height)) {
    Option<u32>.Some { value } => value
    _ => {
      fail RenderError.TooLarge
    }
  }
  if width == 0 || height == 0 {
    fail RenderError.InvalidSize
  }
  let w = u32.toUsize(width)
  let h = u32.toUsize(height)
  if w > usize.MAX / 4 / h || w > maxPixels / h {
    fail RenderError.TooLarge
  }
  return Viewport {
    width: size.width,
    height: size.height,
    pixelsWidth: width,
    pixelsHeight: height,
    scale: Transform.identity(),
  }
}

struct Plan {
  document: Option<usize>,
  imageViewport: Size,
  imageBounds: Rect,
  image: Option<usize>,
  imageMapping: Transform,
  occurrence: OccurrenceId,
  firstChild: Option<usize>,
  nextSibling: Option<usize>,
  styleId: StyleId,
  style: Style,
  hasStroke: bool,
  vectorFlags: u8,
  vectorScreen: bool,
  subtreeEffects: bool,
  fixedPosition: Point,
  path: Option<usize>,
  /// Glyph cells that replace `path` in the fill bounding box (SVG 2 #TextBoundingBox).
  cells: Option<usize>,
  /// Text decoration painted before and after the glyphs (CSS Text Decoration 3
  /// #painting-order), in the same paint as the glyphs.
  early: Option<usize>,
  late: Option<usize>,
  /// A text content element: `text` or an element rendering its characters.
  text: bool,
  pathLength: Option<f64>,
  paintable: bool,
  container: bool,
  ownBounds: bool,
  instance: bool,
  foreign: bool,
  viewport: usize,
  childViewport: usize,
  layout: Option<usize>,
  local: Mapping,
  transformed: bool,
  perspective: bool,
  hiddenBackface: bool,
  suppressed: bool,
  pending: Option<usize>,
  /// The `filter` property does not apply (a `mask` element).
  unfiltered: bool,
  /// A text content child other than `a`: an inline box, to which clip-path, mask,
  /// filter, opacity, mix-blend-mode and isolation do not apply.
  inline: bool,
  /// The element's glyphs drawn from SVG glyph documents, in `Planning.colorGlyphs`.
  colors: GlyphRange,
}

struct GlyphRange {
  start: usize,
  end: usize,
}

impl Copy for GlyphRange {}

