//! SVG image positioning rectangles and sample-to-user mappings.
//! Natural dimensions are measured after image orientation, before CSS transforms.
import scene { RenderError }
import svg_geometry.geometry { Size, Rect, Transform }
import svg_geometry.svg { AspectRatio }
import svg_geometry.svg
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.f64

pub struct NaturalSize {
  pub width: Option<f64>,
  pub height: Option<f64>,
  pub ratio: Option<f64>,
}

impl Copy for NaturalSize {}

effect fn validate(value: Option<f64>, ratio: bool) -> ()
  ! RenderError {
  if let Option<f64>.Some { value: number } = &value {
    if !f64.isFinite(number) || number < 0.0 || (ratio && number == 0.0) {
      fail RenderError.InvalidGeometry
    }
  }
}

fn fallback(value: Option<f64>, defaultValue: f64) -> f64 {
  return match &value {
    Option<f64>.Some { value: number } => number
    _ => defaultValue
  }
}

/// CSS Images 3 default sizing, with SVG's 300 by 150 default object size.
/// None denotes auto/absent; explicit zero remains zero and disables painting.
pub effect fn size(width: Option<f64>, height: Option<f64>, natural: NaturalSize) -> Size
  ! RenderError {
  run validate(width, false)
  run validate(height, false)
  run validate(natural.width, false)
  run validate(natural.height, false)
  run validate(natural.ratio, true)
  let mut w = width
  let mut h = height
  if w.isNone() && h.isNone() {
    w = natural.width
    h = natural.height
  }
  let result = match &w {
    Option<f64>.Some { value: x } => {
      let y = match &h {
        Option<f64>.Some { value } => value
        _ => match &natural.ratio {
          Option<f64>.Some { value } => x / value
          _ => fallback(natural.height, 150.0)
        }
      }
      Size.new(x, y)
    }
    _ => match &h {
      Option<f64>.Some { value: y } => {
        let x = match &natural.ratio {
          Option<f64>.Some { value } => y * value
          _ => fallback(natural.width, 300.0)
        }
        Size.new(x, y)
      }
      _ => match &natural.ratio {
        Option<f64>.Some { value } => if value > 2.0 {
          Size.new(300.0, 300.0 / value)
        } else {
          Size.new(150.0 * value, 150.0)
        }
        _ => Size.new(300.0, 150.0)
      }
    }
  }
  if !result.isValid() {
    fail RenderError.InvalidGeometry
  }
  return result
}

/// Maps source samples into the positioning rectangle with preserveAspectRatio.
/// The caller clips slice overflow separately and composes the element's full
/// projective transform after this affine, local image placement.
pub fn fit(width: f64, height: f64, target: Rect, aspect: AspectRatio) -> Option<Transform> {
  if width <= 0.0 || height <= 0.0 || target.width() <= 0.0 || target.height() <= 0.0 {
    return Option<Transform>.None
  }
  let source = match &Rect.new(0.0, 0.0, width, height) {
    Option<Rect>.Some { value } => value
    _ => {
      return Option<Transform>.None
    }
  }
  return match &svg.viewportWithAspectRatio(source, target.width(), target.height(), aspect) {
    Option<Transform>.Some { value } => {
      let placed = Transform.multiply(Transform.translation(target.xMin, target.yMin), value)
      if placed.isFinite() {
        Option<Transform>.some(placed)
      } else {
        Option<Transform>.None
      }
    }
    _ => Option<Transform>.None
  }
}
