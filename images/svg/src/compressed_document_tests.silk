test effect fn exactExpansionBudget() -> ()
  ! StructureError | UrlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let graph = run source(
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x15\xca\x3b\x0e\x80\x20\x0c\x00\xd0\xab\x74\xeb\x46\x51\x37\x43\xb9\x8c\x10\x4a\xe2\x87\x40\x63\x3d\xbe\xfa\xe6\x17\xc6\x5d\xe0\x39\xf6\x73\x30\x8a\x6a\x5b\x89\xcc\xcc\xd9\xe2\xae\x5e\x68\xf6\xde\xd3\x37\x30\x86\x9e\x37\x85\x9a\x18\x1b\x82\xd5\xa4\xc2\x38\x23\x48\xae\x45\x94\x71\x42\x8a\xe1\x9f\xf1\x05\x6b\xf0\x08\xeb\x51\x00\x00\x00",
    175,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(graph.documents.length() == 1, "exact encoded plus decoded budget accepted")
}

