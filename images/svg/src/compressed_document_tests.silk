//! SVG 1.1 G.7 #ConformingSVGViewers, RFC 1950 §2.2 and RFC 1952 §2.3.1.
import structure { Graph, Options, StructureError, build }
import resources { Resolver, DataOnly, Limits as ResourceLimits }
import url { Url, UrlError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn source(data: &[u8], maximum: usize) -> Graph
  ! StructureError | UrlError | OutOfMemoryError
  ? &mut Allocator {
  let base = run Url.parseAbsolute(b"file:///fixtures/input.svgz")
  let mut host = DataOnly.make(ResourceLimits.defaults())
  let mut options = Options.defaults()
  options.limits.maxTotalBytes = maximum
  return run build(data, &base, &options) |> Effect.provideMut<Resolver>(&mut host)
}

effect fn valid(data: &[u8], documents: usize) -> ()
  ! StructureError | UrlError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let graph = run source(data, 67108864)
  run Testing.expect(
    graph.documents.length() == documents,
    "compressed documents parsed and referenced",
  )
}

effect fn rejects(data: &[u8], maximum: usize, limit: bool) -> ()
  ! AssertionError<'static>
  ? &mut Allocator {
  let result = run Effect.result(source(data, maximum))
  let rejected = match &result {
    Result<Graph, StructureError | UrlError | OutOfMemoryError>.Success { value } => false
    Result<Graph, StructureError | UrlError | OutOfMemoryError>.Failure { error } => match &error {
      StructureError value => if limit {
        value == StructureError.TooLarge
      } else {
        value == StructureError.InvalidXml
      }
      _ => false
    }
  }
  run Testing.expect(
    rejected,
    "invalid compression or bounded expansion rejected with the correct error",
  )
}

test effect fn gzipRoot() -> ()
  ! StructureError | UrlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run valid(
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x15\xca\x3b\x0e\x80\x20\x0c\x00\xd0\xab\x74\xeb\x46\x51\x37\x43\xb9\x8c\x10\x4a\xe2\x87\x40\x63\x3d\xbe\xfa\xe6\x17\xc6\x5d\xe0\x39\xf6\x73\x30\x8a\x6a\x5b\x89\xcc\xcc\xd9\xe2\xae\x5e\x68\xf6\xde\xd3\x37\x30\x86\x9e\x37\x85\x9a\x18\x1b\x82\xd5\xa4\xc2\x38\x23\x48\xae\x45\x94\x71\x42\x8a\xe1\x9f\xf1\x05\x6b\xf0\x08\xeb\x51\x00\x00\x00",
    1,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

