//! Resolved SVG data and backend-neutral paint commands. Paths remain in user space;
//! every drawing command carries its device transform and conservative device bounds.
import svg_geometry.geometry { Path, Rect, Point, Size }
import mapping { Mapping, ProjectionClip }
pub import used_viewports { Clip }
import document_styles { StyledGraph }
import structure { Graph, SourceId }
import image_assets { Asset, DocumentSource }
import svg_css.values { PaintLayer }
pub import svg_filters.program { Program as FilterProgram }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }

pub struct RenderOptions {
  /// Zero requests intrinsic sizing; nonzero values override output pixels before zoom.
  pub width: u32,
  pub height: u32,
  pub zoom: f64,
  pub maxPixels: usize,
  /// The document time in seconds at which animated processing modes sample animations.
  pub time: f64,
}

impl RenderOptions {
  pub fn make() -> RenderOptions {
    return RenderOptions { width: 0, height: 0, zoom: 1.0, maxPixels: 16000000, time: 0.0 }
  }
}

pub enum RenderError {
  InvalidXml,
  InvalidRoot,
  InvalidSize,
  TooLarge,
  InvalidStyleContext,
  InvalidGeometry,
}

/// Straight-alpha sRGB, normalized to [0, 1].
pub struct Color {
  pub r: f64,
  pub g: f64,
  pub b: f64,
  pub a: f64
}

impl Copy for Color {}

impl Color {
  pub fn black() -> Color {
    return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  }
}

pub union Paint {
  None,
  CurrentColor,
  ContextFill,
  ContextStroke,
  Solid { pub color: Color },
  Server { pub index: usize }
}

impl Copy for Paint {}

pub enum SpreadMethod {
  Pad,
  Reflect,
  Repeat,
}

pub struct GradientStop {
  pub offset: f64,
  pub color: Color,
}

impl Copy for GradientStop {}

pub union GradientGeometry {
  Linear { pub start: Point, pub end: Point },
  Radial { pub center: Point, pub radius: f64, pub focal: Point, pub focalRadius: f64 },
}

impl Copy for GradientGeometry {}

/// Geometry and stops are shared across instances with different device mappings.
pub struct Gradient {
  pub geometry: GradientGeometry,
  pub stops: usize,
  pub spread: SpreadMethod,
  pub linearRgb: bool,
  /// CSS <gradient> images interpolate premultiplied colors (CSS Images 3
  /// #coloring-gradient-line); SVG paint servers interpolate straight alpha.
  pub premultiplied: bool,
}

pub enum ImageSampling {
  Smooth,
  Nearest,
  Pixelated,
}

pub union PaintInstance {
  Image { pub image: usize, pub transform: Mapping, pub sampling: ImageSampling },
  Gradient { pub gradient: usize, pub transform: Mapping },
  Pattern { pub pattern: usize, pub transform: Mapping },
}

pub union Brush {
  Solid { pub color: Color },
  Server { pub index: usize },
}

impl Copy for Brush {}

/// Compositing and Blending Level 1 blend functions.
pub enum BlendMode {
  Normal,
  Multiply,
  Screen,
  Overlay,
  Darken,
  Lighten,
  ColorDodge,
  ColorBurn,
  HardLight,
  SoftLight,
  Difference,
  Exclusion,
  Hue,
  Saturation,
  Color,
  Luminosity,
}

pub enum FillRule {
  Nonzero,
  EvenOdd
}

pub enum LineCap {
  Butt,
  Round,
  Square
}

pub enum LineJoin {
  Miter,
  Round,
  Bevel,
  MiterClip,
  Arcs
}

/// Used paint values projected from computed CSS; group opacity is not inherited.
pub struct Style {
  pub color: Color,
  pub fill: Paint,
  pub stroke: Paint,
  pub fillOpacity: f64,
  pub strokeOpacity: f64,
  pub opacity: f64,
  pub blendMode: BlendMode,
  pub isolated: bool,
  pub strokeWidth: f64,
  pub miterLimit: f64,
  pub lineCap: LineCap,
  pub lineJoin: LineJoin,
  pub fillRule: FillRule,
  pub dashIndex: usize,
  pub dashOffset: f64,
  pub fontSize: f64,
  pub visible: bool,
  pub displayed: bool,
  pub crispEdges: bool,
  pub linearRgb: bool,
  pub paintOrder: [PaintLayer; 3],
}

impl Copy for Style {}

/// Non-scaling strokes retain the centerline-to-host and host-to-device maps
/// separately; paint coordinates still use the referencing shape's geometry.
pub struct StrokeSpace {
  pub pathToHost: Mapping,
  pub hostToDevice: Mapping,
}

impl Copy for StrokeSpace {}

/// Shape data is retained once; paint-order events reference it without copying
/// its style or mapping when marker content is interleaved with fill and stroke.
pub struct ResolvedShape {
  pub path: usize,
  pub transform: Mapping,
  pub strokeSpace: Option<usize>,
  pub clip: Option<usize>,
  pub bounds: Rect,
  pub style: Style,
}

/// Porter–Duff operations combining normalized CSS mask coverage.
pub enum MaskComposite {
  Add,
  Subtract,
  Intersect,
  Exclude
}

/// Depth-first group boundaries and paint events retain hierarchy without recursion.
pub union ResolvedNode {
  Embedded { pub image: usize, pub transform: Mapping, pub clip: Option<usize> },
  BeginGroup { pub opacity: f64, pub bounds: Rect, pub linearRgb: bool, pub blendMode: BlendMode },
  EndGroup,
  ApplyClip { pub index: usize },
  ApplyMask { pub luminance: bool, pub linearRgb: bool },
  ConvertMask { pub luminance: bool, pub linearRgb: bool },
  CompositeMask { pub operation: MaskComposite },
  Paint { pub shape: usize, pub layer: PaintLayer },
  /// Content up to the matching EndFilter is the SourceGraphic of `filters[filter]`, whose
  /// user space maps to the device through `transform`; `clip` limits the filter result.
  /// BackgroundImage reads the layer beneath the element's own group when `beneath`, and
  /// only inside `backdrop`, an `enable-background: new` region, when set.
  BeginFilter {
    pub filter: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub beneath: bool,
    pub backdrop: Option<usize>,
  },
  /// Directly after a BeginFilter, before its content: one image layer of that filter
  /// (`feImage`), drawn in the same space, up to the matching EndFilterImage. Layers
  /// follow the order of the program's image indices.
  BeginFilterImage,
  EndFilterImage,
  EndFilter,
  /// Where `occurrence` takes pointer events (SVG 2 #PointerEventsProperty): the fill
  /// region of `shapes[shape]` when `fill`, its stroke when `stroke`. Paints nothing.
  Hit { pub shape: usize, pub occurrence: usize, pub fill: bool, pub stroke: bool },
}

/// Resource-local retained drawing, shared by paint instances with different mappings.
/// Overflow-visible content bounds include every painted shape and marker.
pub struct ResolvedPattern {
  pub clip: Option<Clip>,
  pub tile: Rect,
  pub contentBounds: Rect,
  pub shapes: List<ResolvedShape>,
  pub nodes: List<ResolvedNode>,
}

/// One independent SVG image layout, populated by the rendering layer after
/// geometry establishes its concrete viewport. Source responses remain shared.
pub struct EmbeddedImage {
  pub source: usize,
  pub viewport: Size,
  pub tree: Option<RenderTree>,
  /// Set for an OpenType SVG glyph document, drawn as that glyph.
  pub glyph: Option<GlyphDocument>,
}

/// How an SVG glyph document is drawn (OpenType 1.9 `SVG ` table): only the element with
/// id `glyph<glyph>` and its ancestors' transforms, without clipping to the em square,
/// with `context-fill` and `context-stroke` taken from the text. Only solid paints carry
/// into the document; other paints are none there.
pub struct GlyphDocument {
  pub glyph: u32,
  pub fill: Paint,
  pub stroke: Paint,
}

impl Copy for GlyphDocument {}

pub struct RenderTree {
  pub documents: List<DocumentSource>,
  pub embedded: List<EmbeddedImage>,
  pub images: List<Asset>,
  pub width: u32,
  pub height: u32,
  pub maxPixels: usize,
  pub graph: Graph,
  pub styles: StyledGraph,
  pub shapes: List<ResolvedShape>,
  pub gradientStops: List<List<GradientStop>>,
  pub gradients: List<Gradient>,
  pub paints: List<PaintInstance>,
  pub patterns: List<ResolvedPattern>,
  pub strokeSpaces: List<StrokeSpace>,
  /// Includes CSS d:path() values at their original indices. Those path handles
  /// resolve here after geometry resolution, not in styles.catalog.engine.values.
  pub paths: List<Path>,
  pub dashes: List<List<f64>>,
  pub nodes: List<ResolvedNode>,
  pub projectionClips: List<ProjectionClip>,
  pub clipNodes: List<ClipNode>,
  pub filters: List<FilterProgram>,
}

pub struct Stroke {
  pub width: f64,
  pub cap: LineCap,
  pub join: LineJoin,
  pub miterLimit: f64,
  pub dashIndex: usize,
  pub dashOffset: f64,
}

impl Copy for Stroke {}

pub union Command {
  Embedded { pub image: usize, pub transform: Mapping, pub clip: Option<usize> },
  FillPath {
    pub path: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub bounds: Rect,
    pub brush: Brush,
    pub opacity: f64,
    pub linearRgb: bool,
    pub rule: FillRule,
    pub crispEdges: bool
  },
  StrokePath {
    pub path: usize,
    pub transform: Mapping,
    pub strokeSpace: Option<usize>,
    pub clip: Option<usize>,
    pub bounds: Rect,
    pub brush: Brush,
    pub opacity: f64,
    pub linearRgb: bool,
    pub stroke: Stroke,
    pub crispEdges: bool
  },
  PushLayer { pub opacity: f64, pub bounds: Rect, pub linearRgb: bool, pub blendMode: BlendMode },
  PopLayer,
  ApplyClip { pub index: usize },
  ApplyMask { pub luminance: bool, pub linearRgb: bool },
  ConvertMask { pub luminance: bool, pub linearRgb: bool },
  CompositeMask { pub operation: MaskComposite },
  BeginFilter {
    pub filter: usize,
    pub transform: Mapping,
    pub clip: Option<usize>,
    pub beneath: bool,
    pub backdrop: Option<usize>,
  },
  BeginFilterImage,
  EndFilterImage,
  EndFilter,
  /// A region where `targets[target]` takes pointer events: the fill of `path` by `rule`
  /// when `rule` is set, and its stroke when `stroke` is. Hit testing reads it; rendering
  /// skips it.
  Hit {
    pub path: usize,
    pub transform: Mapping,
    pub strokeSpace: Option<usize>,
    pub clip: Option<usize>,
    pub rule: Option<FillRule>,
    pub stroke: Option<Stroke>,
    pub target: usize,
  },
}

/// The element a hit lands on: the source element of the occurrence, and when it is in a
/// `use` element's shadow tree, the outermost `use` element that instantiates it.
pub struct HitTarget {
  pub source: SourceId,
  pub host: Option<SourceId>,
}

impl Copy for HitTarget {}

/// A repeatable resource-local picture; handles address the owning display list's arenas.
pub struct Pattern {
  pub tile: Rect,
  pub contentBounds: Rect,
  pub commands: List<Command>,
}

/// Clip operands precede their consumers, making cycles invalid by construction.
pub union ClipNode {
  Empty,
  Shape { pub path: usize, pub transform: Mapping, pub rule: FillRule },
  Intersect { pub left: usize, pub right: usize },
  Union { pub left: usize, pub right: usize },
}

/// Retained, CPU/GPU-neutral commands. No backend handles, closures or rasterizer state.
pub struct DisplayList {
  pub embedded: List<Option<DisplayList>>,
  pub images: List<Asset>,
  pub width: u32,
  pub height: u32,
  pub maxPatternPixels: usize,
  pub maxPatternWork: usize,
  pub gradientStops: List<List<GradientStop>>,
  pub gradients: List<Gradient>,
  pub paints: List<PaintInstance>,
  pub patterns: List<Pattern>,
  pub strokeSpaces: List<StrokeSpace>,
  pub paths: List<Path>,
  pub dashes: List<List<f64>>,
  pub commands: List<Command>,
  /// The elements `Command.Hit` targets.
  pub targets: List<HitTarget>,
  pub projectionClips: List<ProjectionClip>,
  pub clipNodes: List<ClipNode>,
  pub filters: List<FilterProgram>,
}
