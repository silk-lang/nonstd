//! SVG 1.1 colour profiles (1.1 ch. 12): `color-profile` elements, `icc-color()`
//! specifications and the `color-profile` property's profile choice.
import structure { Graph }
import document_styles { StyledGraph }
import resources { ResourceKind, ResourceError, Response, fetchWithPolicy }
import url { Url, UrlError }
import svg_xml.xml { Document, NodeId }
import svg_css.tokens { equal }
import svg_css.colors { Color }
import svg_css.values { Store, Value, Paint, Fallback, IccId }
import svg_image.icc
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import resources { Resolver }

/// One loaded `color-profile` element. Unavailable profiles keep empty data, so a
/// name that matches them still selects "no usable profile" rather than a later one.
pub struct Entry {
  pub document: usize,
  pub node: usize,
  pub name: Bytes,
  pub id: Bytes,
  pub data: Bytes,
}

pub struct Profiles {
  pub entries: List<Entry>,
}

impl Profiles {
  pub fn empty() -> Profiles {
    return Profiles { entries: List<Entry>.make() }
  }

  /// The first profile in document order whose `name` matches (1.1 §12.3.1), in the
  /// given document.
  pub fn named(self: &Self, document: usize, name: &[u8]) -> Option<usize> {
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let entry = &entries[index]
      if (entry.document == document || entry.document == usize.MAX)
        && equal(entry.name.asSlice(), name) {
        return Option<usize>.Some { value: index }
      }
      index = index + 1
    }
    return Option<usize>.None
  }

  /// The profile element with the given `id` in a document.
  pub fn element(self: &Self, document: usize, id: &[u8]) -> Option<usize> {
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let entry = &entries[index]
      if entry.document == document && entry.id.length() > 0 && equal(entry.id.asSlice(), id) {
        return Option<usize>.Some { value: index }
      }
      index = index + 1
    }
    return Option<usize>.None
  }
}

fn attribute<'a>(document: &'a Document, node: NodeId, name: &[u8]) -> &'a [u8] {
  return match &Document.attribute(document, node, b"", name) {
    Option<&[u8]>.Some { value } => value
    _ => b""
  }
}

/// Fetches every `color-profile` element's `href` (1.1 §12.3.2), then adds the
/// stylesheets' @color-profile rules. Profiles that fail
/// to load, or exceed the document byte budget, stay empty. `local` names a
/// platform profile store this renderer does not have, so it is ignored.
pub effect fn load(graph: &Graph, styles: &StyledGraph) -> Profiles
  ! OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let mut profiles = Profiles.empty()
  let mut remaining = graph.limits.maxTotalBytes
  let mut documentIndex: usize = 0
  while documentIndex < graph.documents.length() {
    let source = &graph.documents.asSlice()[documentIndex]
    let document = &source.document
    let current = documentIndex
    documentIndex = documentIndex + 1
    let mut n: usize = 0
    while n < Document.nodes(document).length {
      let node = NodeId { index: n }
      n = n + 1
      if !equal(Document.namespaceUri(document, node), b"http://www.w3.org/2000/svg")
        || !equal(Document.localName(document, node), b"color-profile") {
        continue
      }
      let href = match &Document.attribute(document, node, b"", b"href") {
        Option<&[u8]>.Some { value } => value
        _ => match &Document.attribute(document, node, b"http://www.w3.org/1999/xlink", b"href") {
          Option<&[u8]>.Some { value } => value
          _ => b""
        }
      }
      let mut data = Bytes.make()
      if href.length > 0 {
        let parsed = run Effect.result(
          Url.resolve(&graph.urls.asSlice()[source.nodeBases.asSlice()[node.index]], href),
        )
        match move parsed {
          Result<Url, UrlError | OutOfMemoryError>.Success { value: url } => {
            let fetched = run Effect.result(
              fetchWithPolicy(&url, ResourceKind.ColorProfile, &source.policy),
            )
            match move fetched {
              Result<Response, ResourceError | OutOfMemoryError>.Success { value } => {
                let count = value.bytes.length()
                if count <= remaining {
                  remaining = remaining - count
                  data = move value.bytes
                }
              }
              Result<Response, ResourceError | OutOfMemoryError>.Failure { error } => {
                match &error {
                  OutOfMemoryError problem => {
                    fail OutOfMemoryError {}
                  }
                  _ => {}
                }
              }
            }
          }
          Result<Url, UrlError | OutOfMemoryError>.Failure { error } => {
            match &error {
              OutOfMemoryError problem => {
                fail OutOfMemoryError {}
              }
              _ => {}
            }
          }
        }
      }
      run profiles.entries.append(
        Entry {
          document: current,
          node: node.index,
          name: run Bytes.copy(attribute(document, node, b"name")),
          id: run Bytes.copy(attribute(document, node, b"id")),
          data: move data,
        },
      )
    }
  }

  // @color-profile rules apply to every document of the render.
  let rules = styles.catalog.colorProfiles.asSlice()
  let mut r: usize = 0
  while r < rules.length {
    run profiles.entries.append(
      Entry {
        document: usize.MAX,
        node: usize.MAX,
        name: run Bytes.copy(rules[r].name.asSlice()),
        id: Bytes.make(),
        data: run Bytes.copy(rules[r].data.asSlice()),
      },
    )
    r = r + 1
  }
  return move profiles
}

/// The sRGB colour an `icc-color()` specification names, or None to use its sRGB
/// fallback (1.1 §12.2): unknown or unusable profiles and component counts that do
/// not match the profile's colour space.
pub fn iccColor(store: &Store, profiles: &Profiles, id: IccId, fallback: Color) -> Option<Color> {
  let value = store.icc(id)
  let name = store.text(value.profile)

  // Profiles are document-scoped by name; the style store is shared by all documents,
  // so names resolve in the first document that declares them.
  let entries = profiles.entries.asSlice()
  let mut index: usize = 0
  while index < entries.length {
    let entry = &entries[index]
    index = index + 1
    if !equal(entry.name.asSlice(), name) {
      continue
    }
    return match &icc.deviceColor(entry.data.asSlice(), value.channels.asSlice()) {
      Option<[f64; 3]>.Some { value: rgb } => Option<Color>.Some {
        value: Color.srgb(rgb[0], rgb[1], rgb[2], fallback.alpha),
      }
      Option<[f64; 3]>.None => Option<Color>.None
    }
  }
  return Option<Color>.None
}

/// Replaces the sRGB fallback of every `icc-color()` specification whose profile can
/// be evaluated with the colour the profile defines. Run once after the cascade.
pub fn applyColors(store: &mut Store, profiles: &Profiles) -> () {
  if profiles.entries.length() == 0 {
    return
  }
  let mut index: usize = 0
  while index < store.values.length() {
    let current = index
    index = index + 1
    let replaced = match &store.values.asSlice()[current] {
      Value.IccColor { color, icc } => match &iccColor(&store.*, profiles, icc, color) {
        Option<Color>.Some { value } => Option<Value>.Some {
          value: Value.IccColor { color: value, icc: icc },
        }
        _ => Option<Value>.None
      }
      Value.Paint { paint } => match &paint {
        Paint.IccColor { color, icc } => match &iccColor(&store.*, profiles, icc, color) {
          Option<Color>.Some { value } => Option<Value>.Some {
            value: Value.Paint { paint: Paint.IccColor { color: value, icc: icc } },
          }
          _ => Option<Value>.None
        }
        Paint.Server { url, fallback } => match &fallback {
          Fallback.IccColor { color, icc } => match &iccColor(&store.*, profiles, icc, color) {
            Option<Color>.Some { value } => Option<Value>.Some {
              value: Value.Paint {
                paint: Paint.Server {
                  url: url,
                  fallback: Fallback.IccColor { color: value, icc: icc },
                },
              },
            }
            _ => Option<Value>.None
          }
          _ => Option<Value>.None
        }
        _ => Option<Value>.None
      }
      _ => Option<Value>.None
    }
    match move replaced {
      Option<Value>.Some { value } => {
        store.values.set(current, move value)
      }
      Option<Value>.None => {}
    }
  }
}
