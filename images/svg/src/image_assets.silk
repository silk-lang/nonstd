//! Owned decoded image resources, shared by all occurrences of a source node.
import structure { Graph, SourceId }
import structure
import resources { Resolver, ResourceKind, ResourceError, Policy, Response, fetchWithPolicy }
import url { Url, UrlError }
import scene { RenderError }
import used_images { NaturalSize }
import svg_geometry.svg { AspectRatio }
import svg_xml.xml { Document, NodeId }
import svg_css.tokens { equal }
import svg_image.image { Image, ImageError }
import svg_image.png { PngError, Metadata as PngMetadata }
import svg_image.png
import svg_image.jpeg { JpegError, Metadata as JpegMetadata }
import svg_image.jpeg
import silk.collections.list { List }
import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.collections.hash_map { HashMap }
import silk.core.ownership { Copy }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

pub union ColorMetadata {
  Png { pub value: PngMetadata },
  Jpeg { pub value: JpegMetadata },
}

pub struct Asset {
  pub image: Image,
  pub color: ColorMetadata
}

/// Encoded document response is shared; each image occurrence supplies its own
/// viewport and secure style context. Transport metadata and redirect base survive.
pub struct DocumentMetadata {
  pub natural: NaturalSize,
  pub aspect: Option<AspectRatio>,
}

pub struct DocumentSource {
  pub response: Response,
  pub request: Url,
  pub metadata: Option<DocumentMetadata>,
}

union Loaded {
  Raster { asset: Asset },
  Document { source: DocumentSource },
}

/// A CSS mask layer image (CSS Masking 1 #the-mask-image) by occurrence and layer.
pub struct LayerRequest {
  pub occurrence: usize,
  pub layer: usize,
  pub url: Url,
  pub policy: Policy,
}

struct LayerKey {
  occurrence: usize,
  layer: usize
}

impl Copy for LayerKey {}

impl HashKey for LayerKey {
  fn equals(a: &Self, b: &Self) -> bool {
    return a.occurrence == b.occurrence && a.layer == b.layer
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.combine(Hash.mix(seed, usize.toU64(value.occurrence)), usize.toU64(value.layer))
  }
}

/// A loaded layer image: a decoded raster asset or an SVG document source.
pub union LayerSource {
  Raster { pub asset: usize },
  Document { pub document: usize },
}

impl Copy for LayerSource {}

/// Byte, pixel and request budgets shared by every load into one store.
struct Budget {
  pixels: usize,
  remaining: usize,
  retained: usize,
  urls: usize,
}

impl Copy for Budget {}

pub struct Store {
  pub retainedBytes: usize,
  pub assets: List<Asset>,
  pub documents: List<DocumentSource>,
  documentIndices: List<List<usize>>,
  indices: List<List<usize>>,
  layers: HashMap<LayerKey, LayerSource>,
  cache: List<Cached>,
  budget: Option<Budget>,
}

impl Store {
  pub fn empty() -> Store {
    return Store {
      retainedBytes: 0,
      assets: List<Asset>.make(),
      documents: List<DocumentSource>.make(),
      documentIndices: List<List<usize>>.make(),
      indices: List<List<usize>>.make(),
      layers: HashMap<LayerKey, LayerSource>.make(Hash.seed(0)),
      cache: List<Cached>.make(),
      budget: Option<Budget>.None,
    }
  }

  pub fn findLayer(self: &Self, occurrence: usize, layer: usize) -> Option<LayerSource> {
    return self.layers.get(LayerKey { occurrence: occurrence, layer: layer })
  }

  pub fn find(self: &Self, source: SourceId) -> Option<usize> {
    if source.document.index >= self.indices.length() {
      return Option<usize>.None
    }
    let nodes = self.indices.asSlice()[source.document.index].asSlice()
    if source.node.index >= nodes.length || nodes[source.node.index] == usize.MAX {
      return Option<usize>.None
    }
    return Option<usize>.some(nodes[source.node.index])
  }

  pub fn findDocument(self: &Self, source: SourceId) -> Option<usize> {
    if source.document.index >= self.documentIndices.length() {
      return Option<usize>.None
    }
    let nodes = self.documentIndices.asSlice()[source.document.index].asSlice()
    if source.node.index >= nodes.length || nodes[source.node.index] == usize.MAX {
      return Option<usize>.None
    }
    return Option<usize>.some(nodes[source.node.index])
  }
}

struct Cached {
  url: Url,
  asset: usize,
  document: usize,
}

effect fn decode(data: &[u8]) -> Asset
  ! PngError | JpegError | ImageError | OutOfMemoryError
  ? &mut Allocator {
  if data.length >= 8 && data[0] == 137 && data[1] == 80 && data[2] == 78 && data[3] == 71 {
    let decoded = run png.decodeWithMetadata(data)
    return Asset {
      image: move decoded.image,
      color: ColorMetadata.Png { value: move decoded.metadata },
    }
  }
  if data.length >= 2 && data[0] == 255 && data[1] == 216 {
    let decoded = run jpeg.decodeWithMetadata(data)
    return Asset {
      image: move decoded.image,
      color: ColorMetadata.Jpeg { value: move decoded.metadata },
    }
  }
  fail PngError.Unsupported
}

effect fn fetched(url: &Url, policy: &Policy, remaining: &mut usize) -> Loaded
  ! RenderError | ResourceError | PngError | JpegError | ImageError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let response = run fetchWithPolicy(url, ResourceKind.Image, policy)
  let count = Bytes.length(&response.bytes)
  if count > remaining.* {
    fail RenderError.TooLarge
  }
  remaining.* = remaining.* - count
  let bytes = Bytes.asSlice(&response.bytes)
  if (bytes.length >= 4 && bytes[0] == 137 && bytes[1] == 80 && bytes[2] == 78 && bytes[3] == 71)
    || (bytes.length >= 2 && bytes[0] == 255 && bytes[1] == 216) {
    return Loaded.Raster { asset: run decode(bytes) }
  }

  // Document validation and intrinsic styles need the renderer's host context.
  // Unsupported/malformed responses remain non-rendering until that validation.
  return Loaded.Document {
    source: DocumentSource {
      response: move response,
      request: run url.clone(),
      metadata: Option<DocumentMetadata>.None,
    },
  }
}

/// Resource errors and unsupported/malformed images paint nothing. Allocator
/// failure is never swallowed. Source bytes and retained pixels have separate caps.
pub effect fn load(graph: &Graph, maxPixels: usize) -> Store
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let mut store = Store.empty()
  store.budget = Option<Budget>.some(
    Budget {
      pixels: 0,
      remaining: graph.limits.maxTotalBytes,
      retained: graph.limits.maxTotalBytes,
      urls: graph.limits.maxUrlBytes,
    },
  )
  let mut documentIndex: usize = 0
  while documentIndex < graph.documents.length() {
    let source = &graph.documents.asSlice()[documentIndex]
    let document = &source.document
    let mut indices = List<usize>.make()
    let mut documentIndices = List<usize>.make()
    let mut n: usize = 0
    while n < Document.nodes(document).length {
      run indices.append(usize.MAX)
      run documentIndices.append(usize.MAX)
      let node = NodeId { index: n }
      n = n + 1
      if !equal(Document.namespaceUri(document, node), b"http://www.w3.org/2000/svg") {
        continue
      }
      let name = Document.localName(document, node)
      let filterImage = equal(name, b"feImage")
      if !equal(name, b"image") && !filterImage {
        continue
      }
      let href = match &Document.attribute(document, node, b"", b"href") {
        Option<&[u8]>.Some { value } => Option<&[u8]>.some(value)
        _ => Document.attribute(document, node, b"http://www.w3.org/1999/xlink", b"href")
      }
      let text = match &href {
        Option<&[u8]>.Some { value } => value
        _ => {
          continue
        }
      }

      // An feImage href with a fragment names an element, rendered like use.
      if text.length == 0 || (filterImage && structure.elementReference(text)) {
        continue
      }
      let parsed = run Effect.result(
        Url.resolve(&graph.urls.asSlice()[source.nodeBases.asSlice()[node.index]], text),
      )
      let url = match move parsed {
        Result<Url, UrlError | OutOfMemoryError>.Success { value } => move value
        Result<Url, UrlError | OutOfMemoryError>.Failure { error } => {
          match &error {
            OutOfMemoryError value => {
              fail OutOfMemoryError {}
            }
            _ => {}
          }
          continue
        }
      }
      let found = run obtain(&mut store, graph, move url, &source.policy, maxPixels)
      indices.set(node.index, found.asset)
      documentIndices.set(node.index, found.document)
    }
    run store.indices.append(move indices)
    run store.documentIndices.append(move documentIndices)
    documentIndex = documentIndex + 1
  }
  run settle(&mut store, graph)
  return move store
}

/// Loads CSS mask layer images into a store built by [`load`], under the same
/// budgets and URL cache.
pub effect fn loadLayers(
  store: &mut Store,
  graph: &Graph,
  requests: List<LayerRequest>,
  maxPixels: usize,
) -> ()
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let mut pending = move requests
  while pending.length() != 0 {
    let request = pending.remove(0)
    let found = run obtain(&mut store.*, graph, move request.url, &request.policy, maxPixels)
    let key = LayerKey { occurrence: request.occurrence, layer: request.layer }
    if found.asset != usize.MAX {
      drop run store.layers.insert(key, LayerSource.Raster { asset: found.asset })
    } else if found.document != usize.MAX {
      drop run store.layers.insert(key, LayerSource.Document { document: found.document })
    }
  }
  run settle(&mut store.*, graph)
}

effect fn settle(store: &mut Store, graph: &Graph) -> () {
  if let Option<Budget>.Some { value } = &store.budget {
    store.retainedBytes = graph.limits.maxTotalBytes - value.retained
  }
}

struct Found {
  asset: usize,
  document: usize,
}

impl Copy for Found {}

/// Fetches and retains one image URL, or reuses an earlier response for the same
/// URL. Unavailable or undecodable images return usize.MAX indices.
effect fn obtain(
  store: &mut Store,
  graph: &Graph,
  url: Url,
  policy: &Policy,
  maxPixels: usize,
) -> Found
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  let mut budget = match &store.budget {
    Option<Budget>.Some { value } => value
    _ => {
      fail RenderError.InvalidGeometry
    }
  }
  let found = run fetchInto(&mut store.*, graph, move url, policy, maxPixels, &mut budget)
  store.budget = Option<Budget>.some(budget)
  return found
}

effect fn fetchInto(
  store: &mut Store,
  graph: &Graph,
  url: Url,
  policy: &Policy,
  maxPixels: usize,
  budget: &mut Budget,
) -> Found
  ! RenderError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator {
  // Secure authorization precedes cache lookup, so an unrestricted earlier
  // document cannot lend a forbidden image to a secure document.
  if policy.mode.isSecure() && !equal(url.scheme(), b"data") {
    return Found { asset: usize.MAX, document: usize.MAX }
  }
  let mut i: usize = 0
  while i < store.cache.length() {
    let cached = &store.cache.asSlice()[i]
    if equal(cached.url.bytes(), url.bytes()) {
      return Found { asset: cached.asset, document: cached.document }
    }
    i = i + 1
  }
  if store.cache.length() >= graph.limits.maxRequests {
    fail RenderError.TooLarge
  }
  if url.bytes().length > budget.urls {
    fail RenderError.TooLarge
  }
  budget.urls = budget.urls - url.bytes().length
  let decoded = run Effect.result(fetched(&url, policy, &mut budget.remaining))
  let mut index = usize.MAX
  let mut documentIndex = usize.MAX
  match move decoded {
    Result<
      Loaded,
      RenderError | ResourceError | PngError | JpegError | ImageError | OutOfMemoryError
    >.Success {
      value: loaded
    } => {
      match move loaded {
        Loaded.Raster { asset: value } => {
          let count = u32.toUsize(value.image.width()) * u32.toUsize(value.image.height())
          if count > maxPixels - budget.pixels {
            fail RenderError.TooLarge
          }
          let profile = match &value.color {
            ColorMetadata.Png { value: color } => Bytes.length(&color.iccProfile)
            ColorMetadata.Jpeg { value: color } => Bytes.length(&color.iccProfile)
          }
          if count > budget.retained / 4 {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - count * 4
          if profile > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - profile
          budget.pixels = budget.pixels + count
          index = store.assets.length()
          run store.assets.append(move value)
        }
        Loaded.Document { source: value } => {
          let byteCount = Bytes.length(&value.response.bytes)
          if byteCount > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - byteCount
          let requestBytes = value.request.bytes().length
          if requestBytes > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - requestBytes
          let redirectBytes = match &value.response.finalUrl {
            Option<Url>.Some { value: redirect } => redirect.bytes().length
            _ => 0
          }
          if redirectBytes > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - redirectBytes
          let mimeBytes = match &value.response.mediaType {
            Option<Bytes>.Some { value: mime } => Bytes.length(&mime)
            _ => 0
          }
          if mimeBytes > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - mimeBytes
          let charsetBytes = match &value.response.charset {
            Option<Bytes>.Some { value: charset } => Bytes.length(&charset)
            _ => 0
          }
          if charsetBytes > budget.retained {
            fail RenderError.TooLarge
          }
          budget.retained = budget.retained - charsetBytes
          documentIndex = store.documents.length()
          run store.documents.append(move value)
        }
      }
    }
    Result<
      Loaded,
      RenderError | ResourceError | PngError | JpegError | ImageError | OutOfMemoryError
    >.Failure {
      error
    } => {
      match &error {
        RenderError value => {
          fail value
        }
        OutOfMemoryError value => {
          fail OutOfMemoryError {}
        }
        _ => {}
      }
    }
  }
  run store.cache.append(Cached { url: move url, asset: index, document: documentIndex })
  return Found { asset: index, document: documentIndex }
}
