fn startsInsensitive(bytes: &[u8], prefix: &[u8]) -> bool {
  return bytes.length >= prefix.length
    && insensitive(Slice.view<u8>(bytes, 0, prefix.length), prefix)
}

pub struct RuleSetId {
  pub index: usize,
}

impl Copy for RuleSetId {}

struct RuleSet {
  base: usize,
  policy: Policy,
  rules: List<usize>,
  index: CandidateIndex,
}

struct Source {
  url: usize,
  encoding: Encoding,
  ruleSet: RuleSetId,
}

impl Copy for Source {}

struct Cached {
  request: usize,
  url: usize,
  bytes: Bytes,
  protocol: Option<Encoding>,
  supported: bool,
}

struct StyleRule {
  selectors: SelectorList,
  buffer: usize,
  declarations: TokenRange,
  origin: Origin,
}

/// One declaration of a keyframe: the property name and its value text, both verbatim.
pub struct KeyframeValue {
  pub name: Bytes,
  pub value: Bytes,
}

/// A keyframe block with its offsets in [0, 1] (CSS Animations 1 #keyframes).
pub struct Keyframe {
  pub offsets: List<f64>,
  pub values: List<KeyframeValue>,
  /// animation-timing-function inside the keyframe, which times the segment after it.
  pub timing: Option<Bytes>,
}

/// An SVG 1.1 @color-profile rule whose `src` loaded (1.1 §12.3.1 #ColorProfileAtRule).
pub struct SheetProfile {
  pub name: Bytes,
  pub data: Bytes,
  /// The `rendering-intent` descriptor as an ICC intent 0 to 3, or 4 for `auto`.
  pub intent: u32,
}

/// An @keyframes rule. A later rule with the same name replaces an earlier one.
pub struct Keyframes {
  pub name: Bytes,
  pub frames: List<Keyframe>,
}

pub struct Catalog {
  pub buffers: List<TokenBuffer>,
  pub declarations: List<Declaration>,
  pub engine: Engine,
  /// The faces of @font-face rules whose source loaded, in rule order.
  pub fontFaces: List<DocumentFace>,
  pub keyframes: List<Keyframes>,
  pub colorProfiles: List<SheetProfile>,
  sources: List<Source>,
  urls: List<Url>,
  cache: List<Cached>,
  rules: List<StyleRule>,
  sets: List<RuleSet>,
  active: List<usize>,
  inputBytes: usize,
  storageBytes: usize,
  tokenCount: usize,
  ruleCount: usize,
  declarationCount: usize,
  // Presentation attribute text (hashed with its property, base and rule set) to the
  // declaration it last compiled to; repeated attribute values reuse its buffer and value.
  presentations: HashMap<u64, usize>,
  // Copies of the host's pretokenized sheets (Initials.prepareSheet), each used once.
  prepared: List<PreparedSheet>,
  // The user-agent sheet is already collected (see Catalog.prepareUserAgent).
  userAgent: bool,
}

/// A catalog holding only a collected user-agent sheet, which documents copy instead of
/// collecting the sheet again.
pub struct PreparedCatalog {
  catalog: Catalog,
  limits: Limits,
}

/// Style state a host prepares once for all its documents.
pub struct HostStyles {
  pub initials: Initials,
  pub catalog: Option<PreparedCatalog>,
}

impl HostStyles {
  /// Initial values parsed under `limits`, with the user-agent sheet collected when it can be
  /// copied (see Catalog.prepareUserAgent).
  pub effect fn make(sheet: &[u8], environment: &Environment, limits: &Limits) -> HostStyles
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut initials = run Initials.make(limits)

    // A sheet that fails here is collected, or tokenized, per document instead.
    run Effect.catch<CssError>(initials.prepareSheet(sheet, limits), unprepared)
    let mut resolver = DataOnly.make(ResourceLimits.defaults())
    let catalog = run Effect.catch<CssError>(
      Catalog.prepareUserAgent(Option<&Initials>.some(&initials), sheet, environment, limits),
      uncollected,
    )
      |> Effect.provideMut<Resolver>(&mut resolver)
    return HostStyles { initials: move initials, catalog: move catalog }
  }

  /// A catalog for one document, copied from the prepared one when it applies.
  pub effect fn catalogFor(styles: Option<&HostStyles>, limits: &Limits) -> Catalog
    ! OutOfMemoryError
    ? &mut Allocator {
    let host = match &styles {
      Option<&HostStyles>.Some { value } => value
      _ => {
        return run Catalog.make()
      }
    }
    if let Option<PreparedCatalog>.Some { value: prepared } = &host.catalog {
      let copied = run prepared.copyFor(limits)
      match move copied {
        Option<Catalog>.Some { value } => {
          return move value
        }
        _ => {}
      }
    }
    return run Catalog.makeWith(Option<&Initials>.some(&host.initials))
  }
}

effect fn unprepared(error: CssError) -> () {
  drop error
}

effect fn uncollected(error: CssError) -> Option<PreparedCatalog> {
  drop error
  return Option<PreparedCatalog>.None
}

impl PreparedCatalog {
  /// A copy of the prepared catalog for a document whose CSS limits are the ones it was
  /// collected under, so every budget charge and failure matches collecting it; None otherwise.
  pub effect fn copyFor(self: &PreparedCatalog, limits: &Limits) -> Option<Catalog>
    ! OutOfMemoryError
    ? &mut Allocator {
    if !sameLimits(&self.limits, limits) {
      return Option<Catalog>.None
    }
    let source = &self.catalog
    let engine = match move run source.engine.copyUnstyled() {
      Option<Engine>.Some { value } => move value
      _ => {
        return Option<Catalog>.None
      }
    }
    let mut buffers = run List<TokenBuffer>.makeWithCapacity(source.buffers.length())
    let mut i: usize = 0
    while i < source.buffers.length() {
      run buffers.append(run source.buffers.asSlice()[i].copy())
      i = i + 1
    }
    let mut declarations = run List<Declaration>.makeWithCapacity(source.declarations.length())
    run declarations.appendSlice(source.declarations.asSlice())
    let mut sources = run List<Source>.makeWithCapacity(source.sources.length())
    run sources.appendSlice(source.sources.asSlice())
    let mut rules = run List<StyleRule>.makeWithCapacity(source.rules.length())
    i = 0
    while i < source.rules.length() {
      let rule = &source.rules.asSlice()[i]
      run rules.append(
        StyleRule {
          selectors: run rule.selectors.copy(),
          buffer: rule.buffer,
          declarations: rule.declarations,
          origin: rule.origin,
        },
      )
      i = i + 1
    }
    let mut sets = run List<RuleSet>.makeWithCapacity(source.sets.length())
    i = 0
    while i < source.sets.length() {
      let set = &source.sets.asSlice()[i]
      let mut members = run List<usize>.makeWithCapacity(set.rules.length())
      run members.appendSlice(set.rules.asSlice())

      // Nothing has matched against the prepared catalog, so no index is built yet.
      run sets.append(
        RuleSet {
          base: set.base,
          policy: set.policy,
          rules: move members,
          index: CandidateIndex.make(),
        },
      )
      i = i + 1
    }
    let mut prepared = run List<PreparedSheet>.makeWithCapacity(source.prepared.length())
    i = 0
    while i < source.prepared.length() {
      run prepared.append(run source.prepared.asSlice()[i].copy())
      i = i + 1
    }
    return Option<Catalog>.some(
      Catalog {
        buffers: move buffers,
        declarations: move declarations,
        engine: move engine,
        fontFaces: List<DocumentFace>.make(),
        keyframes: List<Keyframes>.make(),
        colorProfiles: List<SheetProfile>.make(),
        sources: move sources,
        urls: List<Url>.make(),
        cache: List<Cached>.make(),
        rules: move rules,
        sets: move sets,
        active: List<usize>.make(),
        inputBytes: source.inputBytes,
        storageBytes: source.storageBytes,
        tokenCount: source.tokenCount,
        ruleCount: source.ruleCount,
        declarationCount: source.declarationCount,
        presentations: HashMap<u64, usize>.make(Hash.seed(0)),
        prepared: move prepared,
        userAgent: true,
      },
    )
  }
}

fn sameLimits(a: &Limits, b: &Limits) -> bool {
  return a.maxInputBytes == b.maxInputBytes && a.maxStorageBytes == b.maxStorageBytes
    && a.maxTokens == b.maxTokens
    && a.maxDepth == b.maxDepth
    && a.maxRules == b.maxRules
    && a.maxDeclarations == b.maxDeclarations
}

// Whether a sheet's only at-rules are @namespace, so collecting it reads neither the media
// environment nor any resource.
fn plainSheet(buffer: &TokenBuffer) -> bool {
  let tokens = buffer.tokens.asSlice()
  let mut i: usize = 0
  while i < tokens.length {
    match &tokens[i].kind {
      Kind.AtKeyword { name } => {
        if !insensitive(buffer.text(name), b"namespace") {
          return false
        }
      }
      _ => {}
    }
    i = i + 1
  }
  return true
}

struct SheetMetadata {
  protocol: Option<Encoding>,
  supported: bool,
}

effect fn sheetMetadata(address: &Url, response: &Response) -> SheetMetadata
  ! ResourceError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = SheetMetadata { protocol: Option<Encoding>.None, supported: true }
  if equal(Url.scheme(address), b"data") {
    let metadata = run resources.inspectData(address)
    result.supported = metadata.matchesMediaType(b"text/css")
    if result.supported {
      let charset = run metadata.decodedCharset()
      if let Option<Bytes>.Some { value } = &charset {
        result.protocol = encoding.label(Bytes.asSlice(&value))
      }
    }
  } else {
    if let Option<Bytes>.Some { value } = &response.mediaType {
      result.supported = insensitive(Bytes.asSlice(&value), b"text/css")
    }
    if let Option<Bytes>.Some { value } = &response.charset {
      result.protocol = encoding.label(Bytes.asSlice(&value))
    }
  }
  return move result
}

// Every sheet, import occurrence and inline block consumes the same aggregate budget.
effect fn charge(total: &mut usize, count: usize, maximum: usize, kind: CssErrorKind) -> ()
  ! CssError {
  if total.* > maximum || count > maximum - total.* {
    fail CssError { kind: kind, offset: 0 }
  }
  total.* = total.* + count
}

fn skip(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let mut at = start
  while at < end
    && match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => true
      _ => false
    } {
    at = at + 1
  }
  return at
}

struct Address {
  text: Span,
  next: usize,
  valid: bool
}

impl Copy for Address {}

fn address(buffer: &TokenBuffer, start: usize, end: usize) -> Address {
  let at = skip(buffer, start, end)
  let rejected = Address { text: Span { start: 0, end: 0 }, next: end, valid: false }
  if at >= end {
    return rejected
  }
  let token = &buffer.tokens.asSlice()[at]
  match &token.kind {
    Kind.String { text } => {
      return Address { text: text, next: at + 1, valid: true }
    }
    Kind.Url { text } => {
      return Address { text: text, next: at + 1, valid: true }
    }
    Kind.Function { name } => {
      if !insensitive(buffer.text(name), b"url") || token.matching > end {
        return rejected
      }
      let inner = skip(buffer, at + 1, token.matching)
      if inner >= token.matching || skip(buffer, inner + 1, token.matching) != token.matching {
        return rejected
      }
      match &buffer.tokens.asSlice()[inner].kind {
        Kind.String { text } => {
          return Address {
            text: text,
            next: if token.matching < end {
              token.matching + 1
            } else {
              end
            },
            valid: true,
          }
        }
        _ => {}
      }
    }
    _ => {}
  }
  return rejected
}

fn namespace(buffer: &TokenBuffer, range: TokenRange) -> Option<NamespaceBinding> {
  let mut at = skip(buffer, range.start, range.end)
  let mut prefix = Span { start: 0, end: 0 }
  if at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => {
        prefix = text
        at = at + 1
      }
      _ => {}
    }
  }
  let uri = address(buffer, at, range.end)
  if !uri.valid || skip(buffer, uri.next, range.end) != range.end {
    return Option<NamespaceBinding>.None
  }
  return Option<NamespaceBinding>.Some { value: NamespaceBinding { prefix: prefix, uri: uri.text } }
}

impl Catalog {
  pub effect fn make() -> Catalog
    ! OutOfMemoryError
    ? &mut Allocator {
    return run Catalog.makeWith(Option<&'static Initials>.None)
  }

  /// A catalog whose engine starts from `initials` when given, so the shared initial values
  /// are not parsed again for this document.
  pub effect fn makeWith(initials: Option<&Initials>) -> Catalog
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut buffers = List<TokenBuffer>.make()
    let closing = run variables.appendClosingBuffer(&mut buffers)
    let mut sources = List<Source>.make()
    run sources.append(
      Source { url: usize.MAX, encoding: Encoding.Utf8, ruleSet: RuleSetId { index: 0 } },
    )
    let mut sets = List<RuleSet>.make()
    run sets.append(
      RuleSet {
        base: usize.MAX,
        policy: Policy { mode: ProcessingMode.SecureStatic, limits: ResourceLimits.defaults() },
        rules: List<usize>.make(),
        index: CandidateIndex.make(),
      },
    )
    let engine = match &initials {
      Option<&Initials>.Some { value } => run Engine.makeWith(closing, value)
      _ => Engine.make(closing)
    }
    let prepared = match &initials {
      Option<&Initials>.Some { value } => run value.copySheets()
      _ => List<PreparedSheet>.make()
    }
    return Catalog {
      buffers: move buffers,
      declarations: List<Declaration>.make(),
      engine: move engine,
      fontFaces: List<DocumentFace>.make(),
      keyframes: List<Keyframes>.make(),
      colorProfiles: List<SheetProfile>.make(),
      sources: move sources,
      urls: List<Url>.make(),
      cache: List<Cached>.make(),
      rules: List<StyleRule>.make(),
      sets: move sets,
      active: List<usize>.make(),
      inputBytes: 0,
      storageBytes: 0,
      tokenCount: 0,
      ruleCount: 0,
      declarationCount: 0,
      presentations: HashMap<u64, usize>.make(Hash.seed(0)),
      prepared: move prepared,
      userAgent: false,
    }
  }

  /// Collects `sheet` as the user-agent sheet, as buildGraph adds it under the document's
  /// first registered base, for documents to copy. None for a sheet with at-rules other than
  /// @namespace, which may read the environment, or whose values cannot be copied.
  pub effect fn prepareUserAgent(
    initials: Option<&Initials>,
    sheet: &[u8],
    environment: &Environment,
    limits: &Limits,
  ) -> Option<PreparedCatalog>
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    let mut catalog = run Catalog.makeWith(initials)
    let buffer = run catalog.buffer(
      sheet,
      Source { url: 0, encoding: Encoding.Utf8, ruleSet: RuleSetId { index: 0 } },
      limits,
    )
    if !plainSheet(&catalog.buffers.asSlice()[buffer]) {
      return Option<PreparedCatalog>.None
    }
    run catalog.active.append(0)
    let bindings = List<NamespaceBinding>.make()
    let range = catalog.buffers.asSlice()[buffer].all()
    run catalog.collect(
      buffer,
      range,
      bindings.asSlice(),
      true,
      Origin.UserAgent,
      environment,
      limits,
      0,
    )
    let removed = catalog.active.pop()
    catalog.userAgent = true
    if !catalog.engine.values.copyable() {
      return Option<PreparedCatalog>.None
    }
    return Option<PreparedCatalog>.some(PreparedCatalog { catalog: move catalog, limits: limits.* })
  }

  /// Whether the user-agent sheet is already collected, so buildGraph does not add it.
  pub fn hasUserAgentSheet(self: &Self) -> bool {
    return self.userAgent
  }

  pub effect fn createRuleSet(self: &mut Self, base: usize, policy: Policy) -> RuleSetId
    ! OutOfMemoryError
    ? &mut Allocator {
    let result = RuleSetId { index: self.sets.length() }
    run self.sets.append(
      RuleSet {
        base: base,
        policy: policy,
        rules: List<usize>.make(),
        index: CandidateIndex.make(),
      },
    )
    return result
  }

  // Fragment-only CSS URLs retain the document that supplied their declaration.
  pub fn sourceDocument(self: &Self, buffer: usize) -> Option<&Url> {
    if buffer >= self.sources.length() {
      return Option<&Url>.None
    }
    let rules = self.sources.asSlice()[buffer].ruleSet
    return self.registeredBase(self.sets.asSlice()[rules.index].base)
  }

  pub fn base(self: &Self, buffer: usize) -> Option<&Url> {
    if buffer >= self.sources.length() {
      return Option<&Url>.None
    }
    let index = self.sources.asSlice()[buffer].url
    if index >= self.urls.length() {
      return Option<&Url>.None
    }
    return Option<&Url>.Some { value: &self.urls.asSlice()[index] }
  }

  pub fn registeredBase(self: &Self, base: usize) -> Option<&Url> {
    if base >= self.urls.length() {
      return Option<&Url>.None
    }
    return Option<&Url>.Some { value: &self.urls.asSlice()[base] }
  }

  pub effect fn matchesMedia(
    self: &mut Self,
    bytes: &[u8],
    base: usize,
    environment: &Environment,
    limits: &Limits,
  ) -> bool
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if bytes.length == 0 {
      return true
    }
    if base >= self.urls.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let buffer = run self.buffer(
      bytes,
      Source { url: base, encoding: Encoding.Utf8, ruleSet: RuleSetId { index: 0 } },
      limits,
    )
    let source = &self.buffers.asSlice()[buffer]
    let input = Input.Contiguous { buffer: source, range: source.all() }
    return run media_queries.matches(&input, environment, limits)
  }

  effect fn buffer(self: &mut Self, bytes: &[u8], source: Source, limits: &Limits) -> usize
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    run charge(&mut self.inputBytes, bytes.length, limits.maxInputBytes, CssErrorKind.InputLimit)
    run charge(&mut self.storageBytes, 0, limits.maxStorageBytes, CssErrorKind.StorageLimit)
    run charge(&mut self.tokenCount, 0, limits.maxTokens, CssErrorKind.TokenLimit)
    let mut available = limits.*
    available.maxStorageBytes = limits.maxStorageBytes - self.storageBytes
    available.maxTokens = limits.maxTokens - self.tokenCount
    let tokens = match self.preparedFor(bytes, &available) {
      Option<usize>.Some { value } => {
        let sheet = self.prepared.remove(value)
        let PreparedSheet { buffer, depth } = move sheet
        move buffer
      }
      _ => run lexer.tokenize(bytes, &available)
    }
    run charge(
      &mut self.storageBytes,
      Bytes.length(&tokens.data),
      limits.maxStorageBytes,
      CssErrorKind.StorageLimit,
    )
    run charge(
      &mut self.tokenCount,
      tokens.tokens.length(),
      limits.maxTokens,
      CssErrorKind.TokenLimit,
    )
    let result = self.buffers.length()
    run self.buffers.append(move tokens)
    run self.sources.append(source)
    return result
  }

  // A host-tokenized copy of `bytes` that fits the limits left, which tokenizing would give
  // exactly: its normalized source is `bytes` itself.
  fn preparedFor(self: &Self, bytes: &[u8], available: &Limits) -> Option<usize> {
    let prepared = self.prepared.asSlice()
    let mut i: usize = 0
    while i < prepared.length {
      let candidate = &prepared[i].buffer
      if candidate.sourceLength == bytes.length && prepared[i].depth <= available.maxDepth
        && Bytes.length(&candidate.data) <= available.maxStorageBytes
        && candidate.tokens.length() < available.maxTokens
        && bytes.length <= available.maxInputBytes
        && equal(candidate.source(), bytes) {
        return Option<usize>.some(i)
      }
      i = i + 1
    }
    return Option<usize>.None
  }

  // A buffer holding `bytes` as its source and no token, charged like buffer() would charge
  // its EOF token. Only for text that is never read back as tokens.
  effect fn rawBuffer(self: &mut Self, bytes: &[u8], source: Source, limits: &Limits) -> usize
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    run charge(&mut self.inputBytes, bytes.length, limits.maxInputBytes, CssErrorKind.InputLimit)
    run charge(
      &mut self.storageBytes,
      bytes.length,
      limits.maxStorageBytes,
      CssErrorKind.StorageLimit,
    )
    run charge(&mut self.tokenCount, 1, limits.maxTokens, CssErrorKind.TokenLimit)
    let result = self.buffers.length()
    run self.buffers.append(
      TokenBuffer {
        data: run Bytes.copy(bytes),
        sourceLength: bytes.length,
        tokens: List<Token>.make(),
      },
    )
    run self.sources.append(source)
    return result
  }

  /// Reserves room for `count` more presentation declarations and their buffers, so
  /// compiling a document's attributes does not copy these lists while they double.
  pub effect fn reservePresentations(self: &mut Self, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.declarations.reserve(count)
    run self.buffers.reserve(count)
    run self.sources.reserve(count)
  }

  pub effect fn registerBase(self: &mut Self, base: Url) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.urls.length()
    run self.urls.append(move base)
    return index
  }

  // Embedded XML style text is already decoded. Imported sheets use decodeStylesheet.
  pub effect fn addSheet(
    self: &mut Self,
    rules: RuleSetId,
    bytes: &[u8],
    base: usize,
    environmentEncoding: Encoding,
    origin: Origin,
    environment: &Environment,
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    if base >= self.urls.length() || rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let buffer = run self.buffer(
      bytes,
      Source { url: base, encoding: environmentEncoding, ruleSet: rules },
      limits,
    )
    run self.active.append(base)
    let bindings = List<NamespaceBinding>.make()
    let range = self.buffers.asSlice()[buffer].all()
    run self.collect(buffer, range, bindings.asSlice(), true, origin, environment, limits, 0)
    let removed = self.active.pop()
  }

  pub effect fn addInline(
    self: &mut Self,
    rules: RuleSetId,
    bytes: &[u8],
    base: usize,
    limits: &Limits,
  ) -> TokenRange
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if base >= self.urls.length() || rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let buffer = run self.buffer(
      bytes,
      Source { url: base, encoding: Encoding.Utf8, ruleSet: rules },
      limits,
    )
    let range = self.buffers.asSlice()[buffer].all()
    return run self.declarationsIn(buffer, range, limits)
  }

  pub effect fn addPresentation(
    self: &mut Self,
    rules: RuleSetId,
    bytes: &[u8],
    base: usize,
    property: Property,
    limits: &Limits,
  ) -> Option<usize>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if base >= self.urls.length() || rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    run charge(&mut self.declarationCount, 1, limits.maxDeclarations, CssErrorKind.DeclarationLimit)
    if property == Property.D && values.plainPathData(bytes) {
      // Path data is re-read from the source text; tokenizing it as CSS only
      // proves it is not a keyword, var() or block, which its bytes already do.
      let buffer = run self.rawBuffer(
        bytes,
        Source { url: base, encoding: Encoding.Utf8, ruleSet: rules },
        limits,
      )
      let value = run values.presentationPath(&mut self.engine.values, bytes)
      let index = self.declarations.length()
      run self.declarations.append(
        Declaration {
          target: Target.Property { property: Property.D },
          specified: Specified.Parsed { value: value },
          buffer: buffer,
          important: false,
        },
      )
      return Option<usize>.Some { value: index }
    }
    let key = presentationKey(bytes, property, base, rules)
    if let Option<usize>.Some { value: earlier } = self.presentations.get(key) {
      if self.samePresentation(earlier, bytes, property, base, rules) {
        // Same text, property and source: the same tokens and the same immutable value, so
        // the earlier buffer and value are shared, charged as a fresh tokenization would be.
        let declaration = self.declarations.asSlice()[earlier]
        let tokens = &self.buffers.asSlice()[declaration.buffer]
        let storage = Bytes.length(&tokens.data)

        // A raw buffer holds no token but is charged for its EOF token.
        let count = if tokens.tokens.length() == 0 {
          1
        } else {
          tokens.tokens.length()
        }
        run charge(
          &mut self.inputBytes,
          bytes.length,
          limits.maxInputBytes,
          CssErrorKind.InputLimit,
        )
        run charge(
          &mut self.storageBytes,
          storage,
          limits.maxStorageBytes,
          CssErrorKind.StorageLimit,
        )
        run charge(&mut self.tokenCount, count, limits.maxTokens, CssErrorKind.TokenLimit)
        let index = self.declarations.length()
        run self.declarations.append(declaration)
        return Option<usize>.Some { value: index }
      }
    }
    let mut quick = run values.presentationHexColor(&mut self.engine.values, property, bytes)
    if quick.isNone() {
      quick = run values.presentationNumber(&mut self.engine.values, property, bytes)
    }
    if let Option<ValueId>.Some { value } = quick {
      // A bare hex color or number is one token; its value is built without tokenizing.
      let buffer = run self.rawBuffer(
        bytes,
        Source { url: base, encoding: Encoding.Utf8, ruleSet: rules },
        limits,
      )
      let index = self.declarations.length()
      run self.declarations.append(
        Declaration {
          target: Target.Property { property: properties.canonical(property) },
          specified: Specified.Parsed { value: value },
          buffer: buffer,
          important: false,
        },
      )
      drop run self.presentations.insert(key, index)
      return Option<usize>.Some { value: index }
    }
    let buffer = run self.buffer(
      bytes,
      Source { url: base, encoding: Encoding.Utf8, ruleSet: rules },
      limits,
    )
    let parsed = run cascade.compilePresentation(
      &mut self.engine.values,
      self.buffers.asSlice(),
      buffer,
      property,
      limits,
    )
    match move parsed {
      Option<Declaration>.Some { value } => {
        let index = self.declarations.length()
        run self.declarations.append(move value)
        drop run self.presentations.insert(key, index)
        return Option<usize>.Some { value: index }
      }
      _ => {
        return Option<usize>.None
      }
    }
  }

  // Whether declaration `earlier` came from addPresentation with exactly these inputs.
  fn samePresentation(
    self: &Self,
    earlier: usize,
    bytes: &[u8],
    property: Property,
    base: usize,
    rules: RuleSetId,
  ) -> bool {
    let declaration = self.declarations.asSlice()[earlier]
    let source = self.sources.asSlice()[declaration.buffer]
    if source.url != base || source.ruleSet.index != rules.index {
      return false
    }
    let matches = match &declaration.target {
      Target.Property { property: target } => target == properties.canonical(property)
      _ => false
    }
    let tokens = &self.buffers.asSlice()[declaration.buffer]
    return matches && tokens.sourceLength == bytes.length
      && equal(Slice.view<u8>(Bytes.asSlice(&tokens.data), 0, bytes.length), bytes)
  }

  pub effect fn addExternal(
    self: &mut Self,
    rules: RuleSetId,
    url: Url,
    environmentEncoding: Encoding,
    origin: Origin,
    environment: &Environment,
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    run self.loadSheet(rules, move url, environmentEncoding, origin, environment, limits, 0)
  }

  effect fn declarationsIn(
    self: &mut Self,
    buffer: usize,
    range: TokenRange,
    limits: &Limits,
  ) -> TokenRange
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let parsed = run syntax.parseDeclarations(&self.buffers.asSlice()[buffer], range, limits)
    run charge(
      &mut self.declarationCount,
      parsed.length(),
      limits.maxDeclarations,
      CssErrorKind.DeclarationLimit,
    )
    let start = self.declarations.length()
    let mut i: usize = 0
    while i < parsed.length() {
      let declaration = run cascade.compile(
        &mut self.engine.values,
        self.buffers.asSlice(),
        buffer,
        &parsed.asSlice()[i],
        limits,
      )
      match move declaration {
        Option<Declaration>.Some { value } => {
          run self.declarations.append(move value)
        }
        _ => {}
      }
      i = i + 1
    }
    return TokenRange { start: start, end: self.declarations.length() }
  }

  effect fn collect(
    self: &mut Self,
    buffer: usize,
    range: TokenRange,
    inheritedBindings: &[NamespaceBinding],
    topLevel: bool,
    origin: Origin,
    environment: &Environment,
    limits: &Limits,
    depth: usize,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    if depth >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: range.start }
    }
    let parsed = run syntax.parseRules(&self.buffers.asSlice()[buffer], range, topLevel, limits)
    run charge(&mut self.ruleCount, parsed.length(), limits.maxRules, CssErrorKind.RuleLimit)
    let mut bindings = List<NamespaceBinding>.make()
    let mut b: usize = 0
    while b < inheritedBindings.length {
      run bindings.append(inheritedBindings[b])
      b = b + 1
    }
    let mut importsAllowed = topLevel
    let mut namespacesAllowed = topLevel
    let mut i: usize = 0
    while i < parsed.length() {
      let rule = &parsed.asSlice()[i]
      if rule.kind == RuleKind.Qualified {
        let selector = run selectors.parse(
          &self.buffers.asSlice()[buffer],
          rule.prelude,
          bindings.asSlice(),
          limits,
        )
        match move selector {
          Option<SelectorList>.Some { value } => {
            importsAllowed = false
            namespacesAllowed = false
            let declarations = run self.declarationsIn(buffer, rule.body, limits)
            let index = self.rules.length()
            let set = self.sources.asSlice()[buffer].ruleSet
            run self.sets.asMutSlice()[set.index].rules.append(index)
            run self.rules.append(
              StyleRule {
                selectors: move value,
                buffer: buffer,
                declarations: declarations,
                origin: origin,
              },
            )
          }
          _ => {}
        }
      } else {
        let name = self.buffers.asSlice()[buffer].text(rule.name)
        if insensitive(name, b"import") {
          if importsAllowed && rule.kind == RuleKind.AtStatement {
            run self.importSheet(buffer, rule.prelude, origin, environment, limits, depth + 1)
          }
        } else if insensitive(name, b"namespace") {
          if namespacesAllowed && rule.kind == RuleKind.AtStatement {
            let binding = namespace(&self.buffers.asSlice()[buffer], rule.prelude)
            match &binding {
              Option<NamespaceBinding>.Some { value } => {
                run bindings.append(value)
                importsAllowed = false
              }
              _ => {}
            }
          }
        } else if insensitive(name, b"media") && rule.kind == RuleKind.AtBlock {
          // Invalid media-query arms are replaced by not all, not discarded at-rules.
          importsAllowed = false
          namespacesAllowed = false
          let input = Input.Contiguous {
            buffer: &self.buffers.asSlice()[buffer],
            range: rule.prelude,
          }
          if run media_queries.matches(&input, environment, limits) {
            run self.collect(
              buffer,
              rule.body,
              bindings.asSlice(),
              false,
              origin,
              environment,
              limits,
              depth + 1,
            )
          }
        } else if insensitive(name, b"supports") && rule.kind == RuleKind.AtBlock {
          let input = Input.Contiguous {
            buffer: &self.buffers.asSlice()[buffer],
            range: rule.prelude,
          }
          let result = run supports.evaluate(&input, &mut self.engine.values, limits)
          if result.valid {
            importsAllowed = false
            namespacesAllowed = false
            if result.value {
              run self.collect(
                buffer,
                rule.body,
                bindings.asSlice(),
                false,
                origin,
                environment,
                limits,
                depth + 1,
              )
            }
          }
        } else if insensitive(name, b"font-face") && rule.kind == RuleKind.AtBlock {
          importsAllowed = false
          namespacesAllowed = false
          run self.fontFace(buffer, rule.body, limits)
        } else if insensitive(name, b"keyframes") && rule.kind == RuleKind.AtBlock {
          importsAllowed = false
          namespacesAllowed = false
          run self.keyframesRule(buffer, rule.prelude, rule.body, limits)
        } else if insensitive(name, b"color-profile") && rule.kind == RuleKind.AtBlock {
          importsAllowed = false
          namespacesAllowed = false
          run self.colorProfile(buffer, rule.body, limits)
        }
      }
      i = i + 1
    }
  }

  /// Records an @keyframes rule whose name is a custom ident or a string (CSS Animations 1
  /// #keyframes). Keyframes with invalid selectors are dropped, and `!important`
  /// declarations are ignored.
  effect fn keyframesRule(
    self: &mut Self,
    buffer: usize,
    prelude: TokenRange,
    body: TokenRange,
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let source = &self.buffers.asSlice()[buffer]
    let mut name = Option<Bytes>.None
    let mut at = prelude.start
    while at < prelude.end {
      match &source.tokens.asSlice()[at].kind {
        Kind.Whitespace => {}
        Kind.Ident { text } => {
          let word = source.text(text)
          if name.isSome() || insensitive(word, b"none") || insensitive(word, b"initial")
            || insensitive(word, b"inherit")
            || insensitive(word, b"unset")
            || insensitive(word, b"default") {
            return
          }
          name = Option<Bytes>.Some { value: run Bytes.copy(word) }
        }
        Kind.String { text } => {
          if name.isSome() {
            return
          }
          name = Option<Bytes>.Some { value: run Bytes.copy(source.text(text)) }
        }
        _ => {
          return
        }
      }
      at = at + 1
    }
    let named = match move name {
      Option<Bytes>.Some { value } => move value
      _ => {
        return
      }
    }
    let blocks = run syntax.parseRules(source, body, false, limits)
    let mut frames = List<Keyframe>.make()
    let mut b: usize = 0
    while b < blocks.length() {
      let block = blocks.asSlice()[b]
      b = b + 1
      if block.kind != RuleKind.Qualified {
        continue
      }
      let mut offsets = List<f64>.make()
      let mut valid = true
      let mut expecting = true
      let mut k = block.prelude.start
      while k < block.prelude.end && valid {
        match &source.tokens.asSlice()[k].kind {
          Kind.Whitespace => {}
          Kind.Comma => {
            valid = !expecting
            expecting = true
          }
          Kind.Ident { text } => {
            let word = source.text(text)
            if !expecting {
              valid = false
            } else if insensitive(word, b"from") {
              run offsets.append(0.0)
            } else if insensitive(word, b"to") {
              run offsets.append(1.0)
            } else {
              valid = false
            }
            expecting = false
          }
          Kind.Percentage { value, integer } => {
            if !expecting || value < 0.0 || value > 100.0 {
              valid = false
            } else {
              run offsets.append(value / 100.0)
            }
            expecting = false
          }
          _ => {
            valid = false
          }
        }
        k = k + 1
      }
      if !valid || expecting || offsets.length() == 0 {
        continue
      }
      let declarations = run syntax.parseDeclarations(source, block.body, limits)
      let mut values = List<KeyframeValue>.make()
      let mut timing = Option<Bytes>.None
      let mut d: usize = 0
      while d < declarations.length() {
        let declaration = declarations.asSlice()[d]
        d = d + 1
        if declaration.important {
          continue
        }
        let property = source.text(declaration.name)
        let mut text = Bytes.make()
        let mut t = declaration.value.start
        while t < declaration.value.end {
          run text.append(source.text(source.tokens.asSlice()[t].source))
          t = t + 1
        }
        if insensitive(property, b"animation-timing-function") {
          timing = Option<Bytes>.Some { value: move text }
        } else if !insensitive(property, b"animation")
          && !startsInsensitive(property, b"animation-") {
          run values.append(KeyframeValue { name: run Bytes.copy(property), value: move text })
        }
      }
      run frames.append(
        Keyframe { offsets: move offsets, values: move values, timing: move timing },
      )
    }
    run self.keyframes.append(Keyframes { name: move named, frames: move frames })
  }

  /// Records an @color-profile rule's `name` and fetches its `src` url under the sheet's
  /// policy (1.1 #ColorProfileAtRule). `src: sRGB` and `local()` sources, and rules
  /// without a name, add nothing.
  effect fn colorProfile(self: &mut Self, buffer: usize, body: TokenRange, limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    let source = &self.buffers.asSlice()[buffer]
    let declarations = run syntax.parseDeclarations(source, body, limits)
    let mut name = Option<Bytes>.None
    let mut address = Option<Span>.None
    let mut intent: u32 = 4
    let mut d: usize = 0
    while d < declarations.length() {
      let declaration = declarations.asSlice()[d]
      d = d + 1
      let property = source.text(declaration.name)
      let start = font_faces.skip(source, declaration.value.start, declaration.value.end)
      if start >= declaration.value.end {
        continue
      }
      if insensitive(property, b"name") {
        match &source.tokens.asSlice()[start].kind {
          Kind.Ident { text } => {
            if font_faces.skip(source, start + 1, declaration.value.end) == declaration.value.end {
              name = Option<Bytes>.Some { value: run Bytes.copy(source.text(text)) }
            }
          }
          _ => {}
        }
      } else if insensitive(property, b"src") {
        address = font_faces.address(source, start, declaration.value.end)
      } else if insensitive(property, b"rendering-intent") {
        match &source.tokens.asSlice()[start].kind {
          Kind.Ident { text } => {
            let word = source.text(text)
            intent = if insensitive(word, b"perceptual") {
              0
            } else if insensitive(word, b"relative-colorimetric") {
              1
            } else if insensitive(word, b"saturation") {
              2
            } else if insensitive(word, b"absolute-colorimetric") {
              3
            } else {
              4
            }
          }
          _ => {}
        }
      }
    }
    let named = match move name {
      Option<Bytes>.Some { value } => move value
      _ => {
        return
      }
    }
    let text = match &address {
      Option<Span>.Some { value } => source.text(value)
      _ => {
        return
      }
    }
    let parent = self.sources.asSlice()[buffer]
    if parent.url >= self.urls.length() || parent.ruleSet.index >= self.sets.length() {
      return
    }
    let policy = self.sets.asSlice()[parent.ruleSet.index].policy
    let resolved = run Effect.result(Url.resolve(&self.urls.asSlice()[parent.url], text))
    let url = match move resolved {
      Result<Url, UrlError | OutOfMemoryError>.Success { value } => move value
      Result<Url, UrlError | OutOfMemoryError>.Failure { error } => match move error {
        UrlError invalid => {
          return
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let fetched = run Effect.result(
      resources.fetchWithPolicy(&url, ResourceKind.ColorProfile, &policy),
    )
    let response = match move fetched {
      Result<Response, ResourceError | OutOfMemoryError>.Success { value } => move value
      Result<Response, ResourceError | OutOfMemoryError>.Failure { error } => match move error {
        ResourceError failure => {
          return
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    let size = Bytes.length(&response.bytes)
    if self.storageBytes > limits.maxStorageBytes
      || size > limits.maxStorageBytes - self.storageBytes {
      return
    }
    self.storageBytes = self.storageBytes + size
    run self.colorProfiles.append(
      SheetProfile { name: move named, data: move response.bytes, intent: intent },
    )
  }

  /// Loads the first `src` of an @font-face rule that fetches under the sheet's policy and
  /// holds a usable face (CSS Fonts 4 #src-desc). Sources that fail are skipped.
  effect fn fontFace(self: &mut Self, buffer: usize, body: TokenRange, limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    let parsed = run font_faces.parse(&self.buffers.asSlice()[buffer], body, limits)
    let rule = match move parsed {
      Option<font_faces.Rule>.Some { value } => move value
      _ => {
        return
      }
    }
    let parent = self.sources.asSlice()[buffer]
    if parent.url >= self.urls.length() || parent.ruleSet.index >= self.sets.length() {
      return
    }
    let policy = self.sets.asSlice()[parent.ruleSet.index].policy
    let mut candidates = List<FaceCandidate>.make()
    let mut index: usize = 0
    while index < rule.sources.length() {
      let entry = &rule.sources.asSlice()[index]
      index = index + 1
      let text = match &entry.* {
        FaceSource.Local { name } => {
          let mut copy = Bytes.make()
          run Bytes.append(&mut copy, Bytes.asSlice(&name))
          run candidates.append(FaceCandidate.Local { name: move copy })
          continue
        }
        FaceSource.Url { text } => self.buffers.asSlice()[buffer].text(text)
      }
      let resolved = run Effect.result(Url.resolve(&self.urls.asSlice()[parent.url], text))
      let url = match move resolved {
        Result<Url, UrlError | OutOfMemoryError>.Success { value } => move value
        Result<Url, UrlError | OutOfMemoryError>.Failure { error } => match move error {
          UrlError invalid => {
            continue
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      if policy.mode.isSecure() && !equal(Url.scheme(&url), b"data") {
        continue
      }
      let fetched = run Effect.result(resources.fetchWithPolicy(&url, ResourceKind.Font, &policy))
      let response = match move fetched {
        Result<Response, ResourceError | OutOfMemoryError>.Success { value } => move value
        Result<Response, ResourceError | OutOfMemoryError>.Failure { error } => match move error {
          ResourceError failure => {
            continue
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let size = Bytes.length(&response.bytes)
      if self.storageBytes > limits.maxStorageBytes
        || size > limits.maxStorageBytes - self.storageBytes {
        continue
      }
      if run FontDatabase.usable(Bytes.asSlice(&response.bytes)) {
        self.storageBytes = self.storageBytes + size
        run candidates.append(FaceCandidate.Data { bytes: move response.bytes })
        break
      }
    }
    if candidates.length() > 0 {
      run self.fontFaces.append(
        DocumentFace {
          family: move rule.family,
          candidates: move candidates,
          weight: rule.weight,
          width: rule.width,
          style: rule.style,
        },
      )
    }
  }

  effect fn importSheet(
    self: &mut Self,
    buffer: usize,
    range: TokenRange,
    origin: Origin,
    environment: &Environment,
    limits: &Limits,
    depth: usize,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    let sheet = &self.buffers.asSlice()[buffer]
    let reference = address(sheet, range.start, range.end)
    if !reference.valid {
      return
    }
    let mut at = skip(sheet, reference.next, range.end)
    if at < range.end {
      let token = &sheet.tokens.asSlice()[at]
      match &token.kind {
        Kind.Function { name } => {
          if insensitive(sheet.text(name), b"supports") {
            if token.matching > range.end {
              return
            }
            let input = Input.Contiguous {
              buffer: sheet,
              range: TokenRange { start: at + 1, end: token.matching },
            }
            let result = run supports.evaluateImport(&input, &mut self.engine.values, limits)
            if !result.valid || !result.value {
              return
            }
            at = if token.matching < range.end {
              token.matching + 1
            } else {
              range.end
            }
          }
        }
        _ => {}
      }
    }
    let media = Input.Contiguous { buffer: sheet, range: TokenRange { start: at, end: range.end } }
    if !run media_queries.matches(&media, environment, limits) {
      return
    }
    if depth >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: range.start }
    }
    let parent = self.sources.asSlice()[buffer]
    let resolved = run Effect.result(
      Url.resolve(&self.urls.asSlice()[parent.url], sheet.text(reference.text)),
    )
    let url = match move resolved {
      Result<Url, UrlError | OutOfMemoryError>.Success { value } => move value
      Result<Url, UrlError | OutOfMemoryError>.Failure { error } => match move error {
        UrlError invalid => {
          if invalid == UrlError.InputLimit {
            fail CssError { kind: CssErrorKind.InputLimit, offset: range.start }
          }
          return
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    run self.loadSheet(
      parent.ruleSet,
      move url,
      parent.encoding,
      origin,
      environment,
      limits,
      depth,
    )
  }

  effect fn loadSheet(
    self: &mut Self,
    rules: RuleSetId,
    url: Url,
    environmentEncoding: Encoding,
    origin: Origin,
    environment: &Environment,
    limits: &Limits,
    depth: usize,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Resolver | &mut Allocator {
    if rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let policy = self.sets.asSlice()[rules.index].policy

    // Authorization belongs to the consumer, even when raw bytes are cached.
    if policy.mode.isSecure() && !equal(Url.scheme(&url), b"data") {
      return
    }
    if depth >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: 0 }
    }
    let mut active: usize = 0
    while active < self.active.length() {
      if equal(
        Url.withoutFragment(&url),
        Url.withoutFragment(&self.urls.asSlice()[self.active.asSlice()[active]]),
      ) {
        return
      }
      active = active + 1
    }
    let mut cached: usize = 0
    while cached < self.cache.length() {
      if equal(
        Url.withoutFragment(&url),
        Url.withoutFragment(&self.urls.asSlice()[self.cache.asSlice()[cached].request]),
      )
        || equal(
          Url.withoutFragment(&url),
          Url.withoutFragment(&self.urls.asSlice()[self.cache.asSlice()[cached].url]),
        ) {
        break
      }
      cached = cached + 1
    }
    if cached == self.cache.length() {
      let fetched = run Effect.result(
        resources.fetchWithPolicy(&url, ResourceKind.StyleSheet, &policy),
      )
      let response = match move fetched {
        Result<Response, ResourceError | OutOfMemoryError>.Success { value } => move value
        Result<Response, ResourceError | OutOfMemoryError>.Failure { error } => match move error {
          ResourceError failure => {
            if failure == ResourceError.TooLarge {
              fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
            }
            return
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      if Bytes.length(&response.bytes) > limits.maxInputBytes - self.inputBytes {
        fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
      }
      run charge(
        &mut self.storageBytes,
        Bytes.length(&response.bytes),
        limits.maxStorageBytes,
        CssErrorKind.StorageLimit,
      )
      let inspected = run Effect.result(sheetMetadata(&url, &response))
      let metadata = match move inspected {
        Result<SheetMetadata, ResourceError | OutOfMemoryError>.Success { value } => move value
        Result<SheetMetadata, ResourceError | OutOfMemoryError>.Failure {
          error
        } => match move error {
          ResourceError invalid => {
            return
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
      let request = self.urls.length()
      run self.urls.append(move url)
      let base = match move response.finalUrl {
        Option<Url>.Some { value } => run self.registerBase(move value)
        _ => request
      }
      run self.cache.append(
        Cached {
          request: request,
          url: base,
          bytes: move response.bytes,
          protocol: metadata.protocol,
          supported: metadata.supported,
        },
      )
    }
    let entry = &self.cache.asSlice()[cached]
    if Bytes.length(&entry.bytes) > policy.limits.maxResourceBytes {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    if !entry.supported {
      return
    }
    let urlIndex = entry.url

    // A redirect can close an import cycle even when its request URL did not.
    active = 0
    while active < self.active.length() {
      if equal(
        Url.withoutFragment(&self.urls.asSlice()[urlIndex]),
        Url.withoutFragment(&self.urls.asSlice()[self.active.asSlice()[active]]),
      ) {
        return
      }
      active = active + 1
    }
    let decoded = run encoding.decodeStylesheet(
      Bytes.asSlice(&entry.bytes),
      entry.protocol,
      Option<Encoding>.Some { value: environmentEncoding },
      limits.maxInputBytes - self.inputBytes,
    )
    let imported = run self.buffer(
      Bytes.asSlice(&decoded.bytes),
      Source { url: urlIndex, encoding: decoded.encoding, ruleSet: rules },
      limits,
    )
    run self.active.append(urlIndex)
    let bindings = List<NamespaceBinding>.make()
    let all = self.buffers.asSlice()[imported].all()
    run self.collect(imported, all, bindings.asSlice(), true, origin, environment, limits, depth)
    let removed = self.active.pop()
  }

  effect fn prepareIndex(self: &mut Self, rules: RuleSetId) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let set = &mut self.sets.asMutSlice()[rules.index]
    if set.index.ready(set.rules.length()) {
      return
    }
    set.index.clear()
    let mut i: usize = 0
    while i < set.rules.length() {
      let rule = &self.rules.asSlice()[set.rules.asSlice()[i]]
      run set.index.add(&rule.selectors, &self.buffers.asSlice()[rule.buffer])
      i = i + 1
    }
    run set.index.finish()
  }

  pub effect fn matching<T: ElementTree>(
    self: &mut Self,
    rules: RuleSetId,
    tree: &T,
    node: usize,
    context: &mut MatchContext,
  ) -> List<Candidate>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let mut result = List<Candidate>.make()
    let mut selected: usize = 0
    while true {
      let id = RuleSetId { index: selected }
      run self.prepareIndex(id)
      let set = &mut self.sets.asMutSlice()[selected]
      run set.index.collect(tree, node, &mut context.*)
      let indices = set.index.candidates()
      let mut i: usize = 0
      while i < indices.length {
        let rule = &self.rules.asSlice()[set.rules.asSlice()[indices[i]]]
        let specificity = run selectors.matchElement(
          &rule.selectors,
          &self.buffers.asSlice()[rule.buffer],
          tree,
          node,
          &mut context.*,
        )
        match &specificity {
          Option<Specificity>.Some { value } => {
            let mut declaration = rule.declarations.start
            while declaration < rule.declarations.end {
              let mut priority = Priority.make(rule.origin, declaration + 1)
              priority.specificity = value
              run result.append(Candidate { declaration: declaration, priority: priority })
              declaration = declaration + 1
            }
          }
          _ => {}
        }
        i = i + 1
      }
      if selected == rules.index {
        break
      }
      selected = rules.index
    }
    return move result
  }

  /// `matching` for an element that is not the shadow host, reusing the results recorded under
  /// `key` by an earlier element with the same source wherever they did not depend on its
  /// position (see selectors.matchElementRecorded): use copies of one element see the same
  /// names, attributes and links, so only their positional rules are matched again.
  pub effect fn matchingShared<T: ElementTree>(
    self: &mut Self,
    rules: RuleSetId,
    tree: &T,
    node: usize,
    context: &mut MatchContext,
    key: u64,
    memo: &mut MatchMemo,
  ) -> List<Candidate>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if rules.index >= self.sets.length() {
      fail CssError { kind: CssErrorKind.InputLimit, offset: 0 }
    }
    let mut recorded = MemoRecord { start: 0, count: 0 }
    let mut recording = true
    if let Option<usize>.Some { value } = memo.keys.get(key) {
      recorded = memo.records.asSlice()[value]
      recording = false
    }
    let start = memo.results.length()
    let mut position: usize = 0
    let mut result = List<Candidate>.make()
    let mut selected: usize = 0
    while true {
      let id = RuleSetId { index: selected }
      run self.prepareIndex(id)
      let set = &mut self.sets.asMutSlice()[selected]
      run set.index.collect(tree, node, &mut context.*)
      let indices = set.index.candidates()
      let mut i: usize = 0
      while i < indices.length {
        let ruleIndex = set.rules.asSlice()[indices[i]]
        let rule = &self.rules.asSlice()[ruleIndex]
        let mut reused = false
        let mut specificity = Option<Specificity>.None
        if position < recorded.count {
          let earlier = memo.results.asSlice()[recorded.start + position]
          if earlier.rule == ruleIndex && !earlier.positional {
            specificity = earlier.specificity
            reused = true
          }
        }
        if recording {
          let recordedMatch = run selectors.matchElementRecorded(
            &rule.selectors,
            &self.buffers.asSlice()[rule.buffer],
            tree,
            node,
            &mut context.*,
          )
          specificity = recordedMatch.specificity
          run memo.results.append(
            MemoResult {
              rule: ruleIndex,
              specificity: specificity,
              positional: recordedMatch.positional,
            },
          )
        } else if !reused {
          specificity = run selectors.matchElement(
            &rule.selectors,
            &self.buffers.asSlice()[rule.buffer],
            tree,
            node,
            &mut context.*,
          )
        }
        position = position + 1
        match &specificity {
          Option<Specificity>.Some { value } => {
            let mut declaration = rule.declarations.start
            while declaration < rule.declarations.end {
              let mut priority = Priority.make(rule.origin, declaration + 1)
              priority.specificity = value
              run result.append(Candidate { declaration: declaration, priority: priority })
              declaration = declaration + 1
            }
          }
          _ => {}
        }
        i = i + 1
      }
      if selected == rules.index {
        break
      }
      selected = rules.index
    }
    if recording {
      drop run memo.keys.insert(key, memo.records.length())
      run memo.records.append(MemoRecord { start: start, count: position })
    }
    return move result
  }
}

/// Element-local selector results by source element, for Catalog.matchingShared.
pub struct MatchMemo {
  keys: HashMap<u64, usize>,
  records: List<MemoRecord>,
  results: List<MemoResult>,
}

impl MatchMemo {
  pub fn make() -> MatchMemo {
    return MatchMemo {
      keys: HashMap<u64, usize>.make(Hash.seed(0)),
      records: List<MemoRecord>.make(),
      results: List<MemoResult>.make(),
    }
  }
}

struct MemoRecord {
  start: usize,
  count: usize,
}

impl Copy for MemoRecord {}

struct MemoResult {
  rule: usize,
  specificity: Option<Specificity>,
  // Whether another copy may match differently (see selectors.matchElementRecorded).
  positional: bool,
}

impl Copy for MemoResult {}

// FNV-1a over the attribute text, then its property, base and rule set.
fn presentationKey(bytes: &[u8], property: Property, base: usize, rules: RuleSetId) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let mut i: usize = 0
  while i < bytes.length {
    hash = u64.wrappingMultiply(hash ^ u8.toU64(bytes[i]), 1099511628211)
    i = i + 1
  }
  hash = u64.wrappingMultiply(hash ^ usize.toU64(properties.index(property)), 1099511628211)
  hash = u64.wrappingMultiply(hash ^ usize.toU64(base), 1099511628211)
  return u64.wrappingMultiply(hash ^ usize.toU64(rules.index), 1099511628211)
}
