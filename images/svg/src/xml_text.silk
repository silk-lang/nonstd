//! Byte views of `silk.xml.document` text for the byte-based SVG and CSS code.
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8, String }

/// Returns the UTF-8 bytes of an optional document string, such as an attribute value.
pub fn bytes<'a>(value: Option<string<'a>>) -> Option<&'a [u8]> {
  return match move value {
    Option<string>.Some { value: text } => Option<&[u8]>.some(String.utf8Bytes(text))
    Option<string>.None => Option<&[u8]>.None
  }
}

/// Returns `value` as a name, URI or value to look up or store in a document. Bytes that are
/// not UTF-8 cannot name anything a document holds, so they become `<`, which no XML name or
/// namespace URI equals.
pub fn name(value: &[u8]) -> string {
  return match String.fromUtf8(value) {
    Result<string, InvalidUtf8>.Success { value: text } => text
    _ => "<"
  }
}
