//! Small f64 geometry vocabulary for SVG user and device coordinates.
//!
//! The types are the `silk.geometry` primitives over f64. Transforms use column
//! vectors: `left * right` applies right first. Primitive arithmetic follows IEEE 754.
//! The checked helpers here reject nonfinite input: they return None for invalid or
//! nonfinite results. Rectangles include their edges and may have zero area. None,
//! not a zero-area rectangle at the origin, represents absent bounds. No path parsing,
//! flattening, arc conversion, or curve bounds are performed by this storage layer.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.f64
import silk.geometry.point { Point2 }
import silk.geometry.vector { Vector2 }
import silk.geometry.size { Size2 }
import silk.geometry.affine { Affine2 }
import silk.geometry.rect as rect

/// A position in SVG user or device space.
pub type Point = Point2<f64>

/// A displacement between two positions.
pub type Vector = Vector2<f64>

/// A width and height.
pub type Size = Size2<f64>

/// Axis-aligned closed bounds. Public fields allow plain data interchange; the
/// checked helpers below reject nonfinite or reversed bounds, even when built directly.
pub type Rect = rect.Rect<f64>

/// SVG `matrix(a b c d e f)`: `xx = a`, `yx = b`, `xy = c`, `yy = d`, `dx = e`, `dy = f`.
pub type Transform = Affine2<f64>

/// True when both extents are finite.
pub fn isFiniteSize(size: Size) -> bool {
  return f64.isFinite(size.width) && f64.isFinite(size.height)
}

/// True when both extents are finite and nonnegative.
pub fn isValidSize(size: Size) -> bool {
  return f64.isFinite(size.width) && f64.isFinite(size.height) && size.width >= 0.0
    && size.height >= 0.0
}

/// Constructs bounds from origin and nonnegative extents without normalizing negatives.
pub fn checkedRect(x: f64, y: f64, width: f64, height: f64) -> Option<Rect> {
  if !isValidSize(Size.new(width, height)) {
    return Option<Rect>.None
  }
  return validated(Rect.new(x, y, x + width, y + height))
}

/// Bounds two finite points, regardless of their ordering.
pub fn boundsOfPoints(first: Point, second: Point) -> Option<Rect> {
  if !Point.isFinite(first) || !Point.isFinite(second) {
    return Option<Rect>.None
  }
  return validated(
    Rect.new(
      f64.min(first.x, second.x),
      f64.min(first.y, second.y),
      f64.max(first.x, second.x),
      f64.max(first.y, second.y),
    ),
  )
}

/// True for finite bounds whose minimum edges are not past their maximum edges.
pub fn isValidRect(bounds: Rect) -> bool {
  return Rect.isFinite(bounds) && bounds.xMin <= bounds.xMax && bounds.yMin <= bounds.yMax
}

/// True for invalid or zero-area bounds; a valid point/line box still has a location.
pub fn isEmptyRect(bounds: Rect) -> bool {
  return !isValidRect(bounds) || bounds.xMin == bounds.xMax || bounds.yMin == bounds.yMax
}

/// True when the bounds are valid and hold the finite point, edges included.
pub fn rectContains(bounds: Rect, point: Point) -> bool {
  return isValidRect(bounds) && Point.isFinite(point) && point.x >= bounds.xMin
    && point.x <= bounds.xMax
    && point.y >= bounds.yMin
    && point.y <= bounds.yMax
}

/// The smallest bounds holding both, or None when either is invalid.
pub fn unitedRects(first: Rect, second: Rect) -> Option<Rect> {
  if !isValidRect(first) || !isValidRect(second) {
    return Option<Rect>.None
  }
  return Option<Rect>.some(
    Rect.new(
      f64.min(first.xMin, second.xMin),
      f64.min(first.yMin, second.yMin),
      f64.max(first.xMax, second.xMax),
      f64.max(first.yMax, second.yMax),
    ),
  )
}

/// Disjoint bounds return None; touching bounds return their zero-area intersection.
pub fn intersectRects(first: Rect, second: Rect) -> Option<Rect> {
  if !isValidRect(first) || !isValidRect(second) {
    return Option<Rect>.None
  }
  return validated(
    Rect.new(
      f64.max(first.xMin, second.xMin),
      f64.max(first.yMin, second.yMin),
      f64.min(first.xMax, second.xMax),
      f64.min(first.yMax, second.yMax),
    ),
  )
}

fn validated(value: Rect) -> Option<Rect> {
  if !isValidRect(value) {
    return Option<Rect>.None
  }
  return Option<Rect>.some(value)
}

/// Largest singular value of the linear part; infinity signals an unrepresentable scale,
/// including a nonfinite translation.
pub fn maxScale(transform: Transform) -> f64 {
  if !Transform.isFinite(transform) {
    return f64.INFINITY
  }
  return Transform.maxScale(transform)
}

/// Bounds all four transformed corners, not a transformed curve's exact bounds.
/// None for a nonfinite transform, invalid bounds, or a nonfinite result.
pub fn mapRect(transform: Transform, bounds: Rect) -> Option<Rect> {
  if !Transform.isFinite(transform) || !isValidRect(bounds) {
    return Option<Rect>.None
  }
  let result = Transform.transformRect(transform, bounds)
  if !Rect.isFinite(result) {
    return Option<Rect>.None
  }
  return Option<Rect>.some(result)
}

/// Unresolved SVG endpoint arc parameters. Radii signs, zero radii, equal endpoints,
/// and rotation are preserved; the later arc resolver applies SVG Appendix B.2.
pub struct Arc {
  pub radii: Size,
  pub rotationDegrees: f64,
  pub largeArc: bool,
  pub sweep: bool,
  pub to: Point,
}

impl Copy for Arc {}

impl Arc {
  pub fn isFinite(self: Arc) -> bool {
    return isFiniteSize(self.radii) && f64.isFinite(self.rotationDegrees) && Point.isFinite(self.to)
  }
}

/// Absolute path commands. Smooth/relative commands resolve to these forms during parsing.
pub union Segment {
  MoveTo { pub to: Point, },
  LineTo { pub to: Point, },
  QuadraticTo { pub control: Point, pub to: Point, },
  CubicTo { pub control1: Point, pub control2: Point, pub to: Point, },
  ArcTo { pub arc: Arc, },
  Close,
}

impl Copy for Segment {}

impl Segment {
  pub fn isFinite(self: &Segment) -> bool {
    return match &self.* {
      Segment.MoveTo { to } => Point.isFinite(to)
      Segment.LineTo { to } => Point.isFinite(to)
      Segment.QuadraticTo { control, to } => Point.isFinite(control) && Point.isFinite(to)
      Segment.CubicTo { control1, control2, to } => Point.isFinite(control1)
        && Point.isFinite(control2)
        && Point.isFinite(to)
      Segment.ArcTo { arc } => Arc.isFinite(arc)
      Segment.Close => true
    }
  }
}

/// Owned, finite segment storage. List owns and drops the allocation; Path is not Copy.
/// The initial command must be MoveTo. Close restores the current subpath's start.
pub struct Path {
  storage: List<Segment>,
  current: Option<Point>,
  start: Point,
}

impl Path {
  pub fn make() -> Path {
    return Path {
      storage: List<Segment>.make(),
      current: Option<Point>.None,
      start: Point.new(0.0, 0.0),
    }
  }

  pub fn length(self: &Path) -> usize {
    return List<Segment>.length(&self.storage)
  }

  pub fn isEmpty(self: &Path) -> bool {
    return Path.length(self) == 0
  }

  pub fn segments(self: &Path) -> &[Segment] {
    return List<Segment>.asSlice(&self.storage)
  }

  pub fn currentPoint(self: &Path) -> Option<Point> {
    return match &self.current {
      Option<Point>.Some { value } => Option<Point>.some(value)
      Option<Point>.None => Option<Point>.None
    }
  }

  /// Reserves room for additional segments without changing the path.
  pub effect fn reserve(self: &mut Path, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run List<Segment>.reserve(&mut self.storage, additional)
  }

  /// False means invalid sequence/nonfinite input; storage and cursor are unchanged.
  /// Allocation failure likewise leaves the path unchanged.
  pub effect fn append(self: &mut Path, segment: Segment) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if !Segment.isFinite(&segment) {
      return false
    }
    let isMove = match &segment {
      Segment.MoveTo { to } => true
      _ => false
    }
    if Path.isEmpty(&self.*) && !isMove {
      return false
    }
    let next = match &segment {
      Segment.MoveTo { to } => to
      Segment.LineTo { to } => to
      Segment.QuadraticTo { control, to } => to
      Segment.CubicTo { control1, control2, to } => to
      Segment.ArcTo { arc } => arc.to
      Segment.Close => self.start
    }
    run List<Segment>.append(&mut self.storage, segment)
    if isMove {
      self.start = next
    }
    self.current = Option<Point>.some(next)
    return true
  }

  /// Clears the path while retaining its allocation for reuse.
  pub fn clear(self: &mut Path) -> () {
    List<Segment>.clear(&mut self.storage)
    self.current = Option<Point>.None
    self.start = Point.new(0.0, 0.0)
  }
}
