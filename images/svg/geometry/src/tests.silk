//! Geometry contracts grounded in the pinned SVG 2 CR; numeric rejection is library policy.
import geometry {
  Point,
  Vector,
  Size,
  Rect,
  Transform,
  Arc,
  Segment,
  Path,
  boundsOfPoints,
  checkedRect,
  intersectRects,
  isEmptyRect,
  isValidSize,
  mapRect,
  maxScale,
  rectContains,
  unitedRects
}
import silk.core.option { Option }
import silk.num.f64
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import svg_tests
import transform_tests
import arc_tests
import bounds_tests
import marker_tests

fn near(a: f64, b: f64) -> bool {
  return f64.abs(a - b) <= 0.000000000001
}

fn hasPoint(value: Option<Point>, x: f64, y: f64) -> bool {
  return match &value {
    Option<Point>.Some { value: point } => near(point.x, x) && near(point.y, y)
    Option<Point>.None => false
  }
}

fn missingTransform(value: Option<Transform>) -> bool {
  return match &value {
    Option<Transform>.None => true
    _ => false
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#InitialCoordinateSystem
test effect fn pointsVectorsAndSizes() -> ()
  ! AssertionError<'static> {
  let p = Point.new(2.0, 3.0)
  let v = Vector.new(4.0, -1.0)
  let q = p + v
  let delta = q - p
  let scaled = delta * 2.0
  run Testing.expect(q.x == 6.0 && q.y == 2.0, "point plus displacement")
  run Testing.expect(scaled.x == 8.0 && scaled.y == -2.0, "vector scaling")
  run Testing.expect(Vector.dot(v, delta) == 17.0, "dot product")
  run Testing.expect(Vector.cross(v, Vector.new(0.0, 1.0)) == 4.0, "oriented cross product")
  run Testing.expect(isValidSize(Size.new(0.0, 3.0)), "zero extent is valid")
  run Testing.expect(!isValidSize(Size.new(-1.0, 3.0)), "negative extent is invalid")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#TransformProperty
test effect fn affineCompositionAndVectorTranslation() -> ()
  ! AssertionError<'static> {
  let translate = Transform.translation(Vector.new(10.0, 20.0))
  let scale = Transform.scale(2.0, 3.0)
  let matrix = translate * scale
  let p = matrix * Point.new(4.0, 5.0)
  let v = matrix * Vector.new(4.0, 5.0)
  run Testing.expect(p.x == 18.0 && p.y == 35.0, "left times right applies right first")
  run Testing.expect(v.x == 8.0 && v.y == 15.0, "translation does not affect vectors")
  let reverse = scale * translate * Point.new(4.0, 5.0)
  run Testing.expect(reverse.x == 28.0 && reverse.y == 75.0, "composition is not commutative")
  let identity = Transform.identity() * p
  run Testing.expect(identity.x == p.x && identity.y == p.y, "identity")
  let turn = Transform.rotation(f64.PI / 2.0) * Point.new(2.0, 0.0)
  run Testing.expect(near(turn.x, 0.0) && near(turn.y, 2.0), "rotation uses radians and SVG axes")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#TransformProperty
test effect fn affineInverse() -> ()
  ! AssertionError<'static> {
  let matrix = Transform.new(2.0, 1.0, 3.0, 4.0, 10.0, -5.0)
  let inverted = Transform.inverse(matrix)
  let roundtrip = match &inverted {
    Option<Transform>.Some { value } => value * (matrix * Point.new(3.0, 7.0))
    Option<Transform>.None => Point.new(0.0, 0.0)
  }
  run Testing.expect(near(roundtrip.x, 3.0) && near(roundtrip.y, 7.0), "inverse restores the point")
  let reflected = Transform.inverse(Transform.scale(-2.0, 4.0))
  let valid = match &reflected {
    Option<Transform>.Some { value } => value.xx == -0.5 && value.yy == 0.25
    _ => false
  }
  run Testing.expect(valid, "negative determinant remains invertible")
  let extreme = Transform.inverse(Transform.scale(1e200, 1e-200))
  let balanced = match &extreme {
    Option<Transform>.Some { value } => near(value.xx / 1e-200, 1.0) && near(value.yy / 1e200, 1.0)
    _ => false
  }
  run Testing.expect(balanced, "row scaling avoids spurious determinant overflow and underflow")
  let sheared = Transform.inverse(Transform.new(1e308, 1e308, 0.0, 1e-10, 0.0, 0.0))
  let finite = match &sheared {
    Option<Transform>.Some { value } => f64.abs(value.yx / -1e10 - 1.0) < 0.00001
      && f64.abs(value.yy / 1e10 - 1.0) < 0.00001
    _ => false
  }
  run Testing.expect(finite, "a tiny normalized determinant need not overflow the inverse")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#TransformProperty
// Rejection, rather than an epsilon cutoff or identity fallback, is the geometry API policy.
test effect fn singularAndNonfiniteTransforms() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    missingTransform(Transform.inverse(Transform.scale(0.0, 1.0))),
    "zero scale is singular",
  )
  run Testing.expect(
    missingTransform(Transform.inverse(Transform.new(1.0, 2.0, 2.0, 4.0, 0.0, 0.0))),
    "dependent rows are singular",
  )
  run Testing.expect(
    missingTransform(Transform.inverse(Transform.translation(Vector.new(f64.INFINITY, 0.0)))),
    "infinity rejected",
  )
  let nan = f64.fromBits(9221120237041090560)
  run Testing.expect(
    !Transform.isFinite(Transform.translation(Vector.new(nan, 0.0))),
    "NaN classified",
  )
  run Testing.expect(
    missingTransform(Transform.inverse(Transform.scale(nan, 1.0))),
    "NaN inverse rejected",
  )
  run Testing.expect(
    !missingTransform(Transform.inverse(Transform.scale(1e-200, 1e-200))),
    "small nonzero scale remains invertible",
  )
  run Testing.expect(
    missingTransform(Transform.inverse(Transform.scale(1e-320, 1.0))),
    "unrepresentable inverse rejected",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
test effect fn boundsUnionIntersectionAndDegeneracy() -> ()
  ! AssertionError<'static> {
  let invalid = Rect { xMin: 1.0, yMin: 1.0, xMax: 0.0, yMax: 0.0 }
  let first = Option<Rect>.unwrapOr(
    boundsOfPoints(Point.new(5.0, 7.0), Point.new(1.0, 2.0)),
    invalid,
  )
  let second = Option<Rect>.unwrapOr(checkedRect(4.0, 6.0, 5.0, 3.0), invalid)
  let joined = unitedRects(first, second)
  let overlap = intersectRects(first, second)
  let joinedOk = match &joined {
    Option<Rect>.Some { value } => value.xMin == 1.0 && value.yMin == 2.0 && value.xMax == 9.0
      && value.yMax == 9.0
    _ => false
  }
  let overlapOk = match &overlap {
    Option<Rect>.Some { value } => value.xMin == 4.0 && value.yMin == 6.0 && value.xMax == 5.0
      && value.yMax == 7.0
    _ => false
  }
  run Testing.expect(
    joinedOk && overlapOk && rectContains(first, Point.new(1.0, 7.0)),
    "normalized bounds, union, intersection and inclusive containment",
  )
  let pointBox = checkedRect(3.0, 4.0, 0.0, 0.0)
  let degenerate = match &pointBox {
    Option<Rect>.Some { value } => isEmptyRect(value) && rectContains(value, Point.new(3.0, 4.0))
    _ => false
  }
  run Testing.expect(degenerate, "zero area bounds retain their location")
  let negative = checkedRect(0.0, 0.0, -1.0, 1.0)
  let rejected = match &negative {
    Option<Rect>.None => true
    _ => false
  }
  run Testing.expect(rejected, "negative extent is not normalized by new")
  let infinite = checkedRect(f64.MAX, 0.0, f64.MAX, 1.0)
  let overflow = match &infinite {
    Option<Rect>.None => true
    _ => false
  }
  run Testing.expect(overflow, "overflowing far edge rejected")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
test effect fn transformedBoundsUseAllCorners() -> ()
  ! AssertionError<'static> {
  let bounds = Rect { xMin: 1.0, yMin: 2.0, xMax: 4.0, yMax: 6.0 }
  let transformed = mapRect(Transform.new(1.0, 1.0, -1.0, 1.0, 0.0, 0.0), bounds)
  let valid = match &transformed {
    Option<Rect>.Some { value } => value.xMin == -5.0 && value.yMin == 3.0 && value.xMax == 2.0
      && value.yMax == 10.0
    _ => false
  }
  run Testing.expect(valid, "opposite corners alone do not bound a sheared rectangle")
  let absent = intersectRects(bounds, Rect { xMin: 10.0, yMin: 10.0, xMax: 11.0, yMax: 11.0 })
  let disjoint = match &absent {
    Option<Rect>.None => true
    _ => false
  }
  run Testing.expect(disjoint, "disjoint boxes have no intersection")
  let touch = intersectRects(bounds, Rect { xMin: 4.0, yMin: 3.0, xMax: 8.0, yMax: 5.0 })
  let touching = match &touch {
    Option<Rect>.Some { value } => isEmptyRect(value)
    _ => false
  }
  run Testing.expect(touching, "touching edges retain a zero width intersection")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataMovetoCommands
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataClosePathCommand
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataCubicBezierCommands
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataQuadraticBezierCommands
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataEllipticalArcCommands
test effect fn ownedPathPreservesSegmentsAndSubpaths() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut path = Path.make()
  run Path.reserve(&mut path, 8) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Path.isEmpty(&path), "new path has no segments")
  let moved = run Path.append(&mut path, Segment.MoveTo { to: Point.new(1.0, 2.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let line = run Path.append(&mut path, Segment.LineTo { to: Point.new(3.0, 4.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let quad = run Path.append(
    &mut path,
    Segment.QuadraticTo { control: Point.new(5.0, 6.0), to: Point.new(7.0, 8.0) },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let cubic = run Path.append(
    &mut path,
    Segment.CubicTo {
      control1: Point.new(9.0, 10.0),
      control2: Point.new(11.0, 12.0),
      to: Point.new(13.0, 14.0),
    },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arc = Arc {
    radii: Size.new(-5.0, 6.0),
    rotationDegrees: 45.0,
    largeArc: true,
    sweep: false,
    to: Point.new(15.0, 16.0),
  }
  let curved = run Path.append(&mut path, Segment.ArcTo { arc: arc })
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    moved && line && quad && cubic && curved,
    "all absolute segment forms retained",
  )
  let segments = Path.segments(&path)
  let stored = match &segments[4] {
    Segment.ArcTo { arc: value } => value.radii.width == -5.0 && value.rotationDegrees == 45.0
      && value.largeArc
      && !value.sweep
    _ => false
  }
  run Testing.expect(stored, "arc endpoint parameters remain lossless for later resolution")
  let closed = run Path.append(&mut path, Segment.Close)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    closed && hasPoint(Path.currentPoint(&path), 1.0, 2.0),
    "close returns to subpath start",
  )
  let afterClose = run Path.append(&mut path, Segment.LineTo { to: Point.new(20.0, 30.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    afterClose && hasPoint(Path.currentPoint(&path), 20.0, 30.0),
    "drawing after close is valid",
  )
  let next = run Path.append(&mut path, Segment.MoveTo { to: Point.new(40.0, 50.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nextClose = run Path.append(&mut path, Segment.Close)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    next && nextClose && hasPoint(Path.currentPoint(&path), 40.0, 50.0),
    "move starts a fresh subpath",
  )
  Path.clear(&mut path)
  run Testing.expect(
    Path.isEmpty(&path) && !hasPoint(Path.currentPoint(&path), 40.0, 50.0),
    "clear resets geometry and cursor",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataMovetoCommands
// Finite segment storage and atomic rejection are library policy, not path-string parsing.
test effect fn pathRejectsInvalidSegmentsWithoutMutation() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut path = Path.make()
  let line = run Path.append(&mut path, Segment.LineTo { to: Point.new(1.0, 2.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let close = run Path.append(&mut path, Segment.Close)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(!line && !close && Path.isEmpty(&path), "path must start with move")
  let moved = run Path.append(&mut path, Segment.MoveTo { to: Point.new(1.0, 2.0) })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bad = run Path.append(
    &mut path,
    Segment.CubicTo {
      control1: Point.new(f64.INFINITY, 0.0),
      control2: Point.new(0.0, 0.0),
      to: Point.new(8.0, 9.0),
    },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    moved && !bad && Path.length(&path) == 1 && hasPoint(Path.currentPoint(&path), 1.0, 2.0),
    "invalid control point leaves storage and cursor unchanged",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#TransformProperty
test effect fn readOnlyGeometryAccessorsAndScaleBound() -> ()
  ! AssertionError<'static> {
  let point = Point.new(2.0, 3.0)
  let coordinates = Point.coordinates(point)
  run Testing.expect(coordinates[0] == 2.0 && coordinates[1] == 3.0, "point coordinate interchange")
  let box = Rect { xMin: 1.0, yMin: 2.0, xMax: 4.0, yMax: 6.0 }
  let origin = Rect.origin(box)
  run Testing.expect(
    origin.x == 1.0 && origin.y == 2.0 && Rect.width(box) == 3.0 && Rect.height(box) == 4.0,
    "rectangle accessors",
  )
  let coefficients = Transform.coefficients(Transform.translation(Vector.new(7.0, 8.0)))
  run Testing.expect(coefficients[4] == 7.0 && coefficients[5] == 8.0, "SVG coefficient order")
  run Testing.expect(near(maxScale(Transform.scale(3.0, 4.0)), 4.0), "largest singular value")
  run Testing.expect(
    near(maxScale(Transform.new(1.0, 1.0, 1.0, 1.0, 0.0, 0.0)), 2.0),
    "sheared singular value",
  )
}
