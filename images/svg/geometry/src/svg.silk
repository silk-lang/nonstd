//! SVG-specific grammar and equivalent paths. Invalid path data retains complete tuples only.
import geometry { Point, Size, Rect, Transform, Path, Segment, Arc }
import numeric { Cursor }
import numeric
import transforms
import shapes
pub import shapes { Alignment, AspectRatio }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub fn number(data: &[u8]) -> Option<f64> {
  return numeric.number(data)
}

pub fn transform(data: &[u8]) -> Option<Transform> {
  return transforms.transform(data)
}

pub fn viewBox(data: &[u8]) -> Option<Rect> {
  return shapes.viewBox(data)
}

/// Strict preserveAspectRatio parsing; unlike viewport, invalid input stays absent.
pub fn aspectRatio(data: &[u8]) -> Option<AspectRatio> {
  return shapes.aspectRatio(data)
}

/// Allocation-free viewport mapping for an already parsed preserveAspectRatio value.
pub fn viewportWithAspectRatio(box: Rect, width: f64, height: f64, ratio: AspectRatio) -> Option<
  Transform
> {
  return shapes.viewportWithAspectRatio(box, width, height, ratio)
}

pub fn viewport(box: Rect, width: f64, height: f64, preserveAspectRatio: &[u8]) -> Option<
  Transform
> {
  return shapes.viewport(box, width, height, preserveAspectRatio)
}

pub effect fn rectangle(x: f64, y: f64, width: f64, height: f64, rx: f64, ry: f64) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  return run shapes.rectangle(x, y, width, height, rx, ry)
}

pub effect fn ellipse(cx: f64, cy: f64, rx: f64, ry: f64) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  return run shapes.ellipse(cx, cy, rx, ry)
}

fn upper(byte: u8) -> u8 {
  return if byte >= 97 && byte <= 122 {
    byte - 32
  } else {
    byte
  }
}

fn tupleSize(command: u8) -> usize {
  if command == 77 || command == 76 || command == 84 {
    return 2
  }
  if command == 72 || command == 86 {
    return 1
  }
  if command == 67 {
    return 6
  }
  if command == 83 || command == 81 {
    return 4
  }
  if command == 65 {
    return 7
  }
  return 0
}

fn position(x: f64, y: f64, current: Point, relative: bool) -> Point {
  return if relative {
    Point.new(current.x + x, current.y + y)
  } else {
    Point.new(x, y)
  }
}

fn reflected(current: Point, control: Point) -> Point {
  // Subtract first: reflection around a very large shared coordinate need not overflow.
  return Point.new(current.x + (current.x - control.x), current.y + (current.y - control.y))
}

pub struct ParsedPath {
  pub path: Path,
  // False on any malformed command or tuple, even if it ends exactly at EOF.
  pub complete: bool,
  // Byte position reached by the parser, including an incomplete final tuple.
  pub offset: usize,
}

pub effect fn parsePath(data: &[u8]) -> ParsedPath
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  let mut cursor = Cursor.make(data)
  let mut command: u8 = 0
  let mut previous: u8 = 0
  let mut current = Point.new(0.0, 0.0)
  let mut start = current
  let mut control = current
  let mut closed = false
  let mut complete = false
  while true {
    Cursor.space(&mut cursor)
    if cursor.at == data.length {
      complete = true
      break
    }
    let byte = data[cursor.at]
    let explicit = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
    if explicit {
      command = byte
      cursor.at = cursor.at + 1
      if upper(command) == 90 {
        if Path.isEmpty(&path) {
          break
        }
        let accepted = run Path.append(&mut path, Segment.Close)
        if !accepted {
          break
        }
        current = start
        previous = 90
        command = 0
        closed = true
        continue
      }
    }
    let kind = upper(command)
    let count = tupleSize(kind)
    if count == 0 || (Path.isEmpty(&path) && kind != 77) {
      break
    }
    let mut args: [f64; 7] = [0.0; 7]
    let mut i: usize = 0
    let mut valid = true
    while i < count {
      Cursor.separator(&mut cursor, i != 0 || !explicit)
      let parsed = if kind == 65 && (i == 3 || i == 4) {
        Cursor.flag(&mut cursor)
      } else {
        Cursor.number(&mut cursor)
      }
      match &parsed {
        Option<f64>.Some { value } => {
          args[i] = value
        }
        Option<f64>.None => {
          valid = false
        }
      }
      if !valid {
        break
      }
      i = i + 1
    }
    if !valid {
      break
    }
    let relative = command >= 97 && command <= 122
    let mut next = current
    let mut nextControl = current
    let mut segment = Segment.Close
    if kind == 77 || kind == 76 || kind == 84 {
      next = position(args[0], args[1], current, relative)
      if kind == 77 {
        segment = Segment.MoveTo { to: next }
      } else if kind == 76 {
        segment = Segment.LineTo { to: next }
      } else {
        nextControl = if previous == 81 || previous == 84 {
          reflected(current, control)
        } else {
          current
        }
        segment = Segment.QuadraticTo { control: nextControl, to: next }
      }
    } else if kind == 72 || kind == 86 {
      if kind == 72 {
        next.x = if relative {
          current.x + args[0]
        } else {
          args[0]
        }
      } else {
        next.y = if relative {
          current.y + args[0]
        } else {
          args[0]
        }
      }
      segment = Segment.LineTo { to: next }
    } else if kind == 67 {
      let first = position(args[0], args[1], current, relative)
      nextControl = position(args[2], args[3], current, relative)
      next = position(args[4], args[5], current, relative)
      segment = Segment.CubicTo { control1: first, control2: nextControl, to: next }
    } else if kind == 83 {
      let first = if previous == 67 || previous == 83 {
        reflected(current, control)
      } else {
        current
      }
      nextControl = position(args[0], args[1], current, relative)
      next = position(args[2], args[3], current, relative)
      segment = Segment.CubicTo { control1: first, control2: nextControl, to: next }
    } else if kind == 81 {
      nextControl = position(args[0], args[1], current, relative)
      next = position(args[2], args[3], current, relative)
      segment = Segment.QuadraticTo { control: nextControl, to: next }
    } else if kind == 65 {
      next = position(args[5], args[6], current, relative)
      segment = Segment.ArcTo {
        arc: Arc {
          radii: Size.new(args[0], args[1]),
          rotationDegrees: args[2],
          largeArc: args[3] == 1.0,
          sweep: args[4] == 1.0,
          to: next,
        },
      }
    }
    if !Segment.isFinite(&segment) {
      break
    }

    // SVG closes a subpath; a subsequent drawing command starts a new one at its start.
    // Explicit MoveTo makes that topology visible to backends whose close resets their state.
    if closed && kind != 77 {
      let moved = run Path.append(&mut path, Segment.MoveTo { to: current })
      if !moved {
        break
      }
      start = current
    }
    let accepted = run Path.append(&mut path, segment)
    if !accepted {
      break
    }
    closed = false
    current = next
    control = nextControl
    previous = kind
    if kind == 77 {
      start = next
      command = if relative {
        108
      } else {
        76
      }
    }
  }
  return ParsedPath { path: move path, complete: complete, offset: cursor.at }
}

pub effect fn points(data: &[u8], close: bool) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut path = Path.make()
  let mut cursor = Cursor.make(data)
  while true {
    if Path.isEmpty(&path) {
      Cursor.space(&mut cursor)
    } else if !Cursor.requiredSeparator(&mut cursor) {
      break
    }
    let xValue = Cursor.number(&mut cursor)
    let x = match &xValue {
      Option<f64>.Some { value } => value
      _ => {
        break
      }
    }
    if !Cursor.requiredSeparator(&mut cursor) {
      break
    }
    let yValue = Cursor.number(&mut cursor)
    let y = match &yValue {
      Option<f64>.Some { value } => value
      _ => {
        break
      }
    }
    let point = Point.new(x, y)
    let segment = if Path.isEmpty(&path) {
      Segment.MoveTo { to: point }
    } else {
      Segment.LineTo { to: point }
    }
    let accepted = run Path.append(&mut path, segment)
    if !accepted {
      break
    }
  }
  if close && !Path.isEmpty(&path) {
    let accepted = run Path.append(&mut path, Segment.Close)
  }
  return move path
}
