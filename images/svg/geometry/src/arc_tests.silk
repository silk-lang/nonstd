import geometry { Point, Size, Arc, Segment }
import arcs { ArcIter, NormalizedArc }
import arcs
import math
import silk.core.option { Option }
import silk.num.f64
import silk.testing.testing { Testing, AssertionError }

fn arc(rx: f64, ry: f64, rotation: f64, large: bool, sweep: bool, x: f64, y: f64) -> Arc {
  return Arc {
    radii: Size.new(rx, ry),
    rotationDegrees: rotation,
    largeArc: large,
    sweep: sweep,
    to: Point.new(x, y),
  }
}

fn near(a: f64, b: f64) -> bool {
  return f64.abs(a - b) < 0.000000001
}

fn count(iter: &mut ArcIter) -> usize {
  let mut total: usize = 0
  while true {
    let next = ArcIter.next(&mut iter.*)
    match &next {
      Option<Segment>.Some { value } => {
        total = total + 1
      }
      Option<Segment>.None => {
        return total
      }
    }
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#ArcOutOfRangeParameters
test effect fn arcDegenerateParameters() -> ()
  ! AssertionError<'static> {
  let mut empty = ArcIter.make(Point.new(3.0, 4.0), arc(2.0, 2.0, 0.0, true, true, 3.0, 4.0), 0.25)
  run Testing.expect(
    count(&mut empty) == 0 && !ArcIter.isLimited(&empty),
    "coincident arc endpoints omit the segment",
  )
  let mut line = ArcIter.make(Point.new(0.0, 0.0), arc(0.0, 2.0, 0.0, false, true, 3.0, 4.0), 0.25)
  let next = ArcIter.next(&mut line)
  let correct = match &next {
    Option<Segment>.Some { value } => match &value {
      Segment.LineTo { to } => to.x == 3.0 && to.y == 4.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(correct && count(&mut line) == 0, "zero radius becomes one line")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
test effect fn quarterArcControlsAndFlags() -> ()
  ! AssertionError<'static> {
  let mut quarter = ArcIter.make(
    Point.new(1.0, 0.0),
    arc(1.0, 1.0, 0.0, false, true, 0.0, 1.0),
    0.25,
  )
  let next = ArcIter.next(&mut quarter)
  let k = 0.5522847498307936
  let correct = match &next {
    Option<Segment>.Some { value } => match &value {
      Segment.CubicTo { control1, control2, to } => near(control1.x, 1.0) && near(control1.y, k)
        && near(control2.x, k)
        && near(control2.y, 1.0)
        && to.x == 0.0
        && to.y == 1.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    correct && count(&mut quarter) == 0,
    "quarter circle has standard tangent controls and exact endpoint",
  )
  let mut large = ArcIter.make(Point.new(1.0, 0.0), arc(1.0, 1.0, 0.0, true, true, 0.0, 1.0), 0.25)
  run Testing.expect(count(&mut large) > 1, "large-arc flag selects the long route")
  let mut reverse = ArcIter.make(
    Point.new(1.0, 0.0),
    arc(1.0, 1.0, 0.0, false, false, 0.0, -1.0),
    0.25,
  )
  let reversed = ArcIter.next(&mut reverse)
  let clockwise = match &reversed {
    Option<Segment>.Some { value } => match &value {
      Segment.CubicTo { control1, control2, to } => control1.y < 0.0 && to.y == -1.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(clockwise, "sweep selects tangent direction")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcCorrectionOutOfRangeRadii
test effect fn radiiCorrectionAndNegativeRadii() -> ()
  ! AssertionError<'static> {
  let mut iter = ArcIter.make(
    Point.new(-10.0, 0.0),
    arc(-1.0, -1.0, 0.0, false, true, 10.0, 0.0),
    0.25,
  )
  let first = ArcIter.next(&mut iter)
  let correct = match &first {
    Option<Segment>.Some { value } => match &value {
      Segment.CubicTo { control1, control2, to } => near(to.x, 0.0) && near(to.y, -10.0)
        && control1.y < 0.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    correct && count(&mut iter) == 1 && !ArcIter.isLimited(&iter),
    "negative radii become positive and too-small radii grow to a semicircle",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
// Device-space precision and the explicit finite-work limit are library policy.
test effect fn adaptiveArcPrecisionAndFiniteLimits() -> ()
  ! AssertionError<'static> {
  let a = arc(1000.0, 1000.0, 0.0, false, true, 0.0, 1000.0)
  let mut coarse = ArcIter.make(Point.new(1000.0, 0.0), a, 0.25)
  let mut fine = ArcIter.make(Point.new(1000.0, 0.0), a, 0.000001)
  run Testing.expect(
    count(&mut fine) > count(&mut coarse),
    "tighter transformed tolerance increases subdivision",
  )
  let mut huge = ArcIter.make(
    Point.new(-1.0e300, 0.0),
    arc(1.0e300, 1.0e300, 1.0e300, false, true, 1.0e300, 0.0),
    1.0e298,
  )
  let mut endpoint = Point.new(0.0, 0.0)
  while true {
    let next = ArcIter.next(&mut huge)
    match &next {
      Option<Segment>.Some { value } => {
        run Testing.expect(
          Segment.isFinite(&value),
          "large finite values never generate NaN or infinity",
        )
        match &value {
          Segment.CubicTo { control1, control2, to } => {
            endpoint = to
          }
          _ => {}
        }
      }
      Option<Segment>.None => {
        break
      }
    }
  }
  run Testing.expect(
    !ArcIter.isLimited(&huge) && endpoint.x == 1.0e300 && endpoint.y == 0.0,
    "normalized huge arc reaches exact endpoint",
  )
  let mut impossible = ArcIter.make(
    Point.new(1.0e300, 0.0),
    arc(1.0e300, 1.0e300, 0.0, false, true, 0.0, 1.0e300),
    0.25,
  )
  run Testing.expect(
    ArcIter.isLimited(&impossible) && count(&mut impossible) == 0,
    "unachievable tolerance is reported before any misleading output",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
test effect fn arcMathQuadrantsAndScaling() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    near(math.atan2(1.0, 1.0), 0.7853981633974483) && near(math.atan2(1.0, -1.0), 2.356194490192345)
      && near(math.atan2(-1.0, -1.0), -2.356194490192345),
    "atan2 resolves all quadrants",
  )
  run Testing.expect(
    near(math.hypot(3.0e300, 4.0e300) / 1.0e300, 5.0),
    "hypot avoids overflowing squares",
  )
  run Testing.expect(
    near(math.radians(450.0), 1.5707963267948966),
    "degrees normalize before conversion",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
test effect fn rotatedEllipseAndUnrepresentableControls() -> ()
  ! AssertionError<'static> {
  let mut rotated = ArcIter.make(
    Point.new(0.0, 2.0),
    arc(2.0, 1.0, 90.0, false, true, -1.0, 0.0),
    0.25,
  )
  let first = ArcIter.next(&mut rotated)
  let correct = match &first {
    Option<Segment>.Some { value } => match &value {
      Segment.CubicTo { control1, control2, to } => near(control1.x, -0.5522847498307936)
        && near(control1.y, 2.0)
        && near(control2.x, -1.0)
        && near(control2.y, 1.1045694996615872)
        && to.x == -1.0
        && to.y == 0.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(
    correct && count(&mut rotated) == 0,
    "ellipse axis rotation also rotates tangent controls",
  )
  let mut outside = ArcIter.make(
    Point.new(1.0e308, 0.0),
    arc(1.0e308, 1.0e308, 0.0, true, true, 1.0e308, 1.0e307),
    1.0e307,
  )
  while true {
    let next = ArcIter.next(&mut outside)
    match &next {
      Option<Segment>.Some { value } => {
        run Testing.expect(
          Segment.isFinite(&value),
          "iterator never emits unrepresentable controls",
        )
      }
      Option<Segment>.None => {
        break
      }
    }
  }
  run Testing.expect(
    ArcIter.isLimited(&outside),
    "finite input whose ellipse exceeds f64 is explicitly limited",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcCorrectionOutOfRangeRadii
test effect fn tinyRadiiCorrectAcrossFullNumericRange() -> ()
  ! AssertionError<'static> {
  let mut iter = ArcIter.make(
    Point.new(-1.0e300, 0.0),
    arc(1.0e-300, 1.0e-300, 0.0, false, true, 1.0e300, 0.0),
    1.0e298,
  )
  let total = count(&mut iter)
  run Testing.expect(
    total > 0 && total <= 4096 && !ArcIter.isLimited(&iter),
    "radii correction avoids an overflowing 1e600 ratio",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
// Stroke joins need the original ellipse derivatives, not cubic approximations.
test effect fn normalizedEllipsePreservesCurvatureAndCorrectedRadii() -> ()
  ! AssertionError<'static> {
  let result = arcs.normalize(Point.new(4.0, 0.0), arc(4.0, 2.0, 0.0, false, true, 0.0, 2.0))
  match &result {
    NormalizedArc.Ellipse { center, axisX, axisY, sweep, end } => {
      run Testing.expect(
        near(center.x, 0.0) && near(center.y, 0.0) && near(sweep, math.PI * 0.5),
        "ellipse center and signed angular domain",
      )
      let cross = axisX.x * axisY.y - axisX.y * axisY.x
      let startSpeed = math.hypot(axisY.x, axisY.y)
      let endSpeed = math.hypot(axisX.x, axisX.y)
      run Testing.expect(
        near(cross / (startSpeed * startSpeed * startSpeed), 1.0)
          && near(cross / (endSpeed * endSpeed * endSpeed), 0.125),
        "endpoint curvatures are those of the original ellipse",
      )
      run Testing.expect(
        end.x == 0.0 && end.y == 2.0,
        "normalization retains exact source endpoint",
      )
    }
    _ => {
      run Testing.expect(false, "finite nondegenerate endpoint arc normalizes to an ellipse")
    }
  }
  let corrected = arcs.normalize(Point.new(-10.0, 0.0), arc(1.0, 1.0, 0.0, false, true, 10.0, 0.0))
  match &corrected {
    NormalizedArc.Ellipse { center, axisX, axisY, sweep, end } => {
      run Testing.expect(
        near(center.x, 0.0) && near(center.y, 0.0) && near(math.hypot(axisX.x, axisX.y), 10.0)
          && near(math.hypot(axisY.x, axisY.y), 10.0),
        "too-small endpoint radii normalize to the required diameter",
      )
      run Testing.expect(
        near(sweep, math.PI) && axisY.y < 0.0,
        "corrected half circle preserves sweep direction",
      )
    }
    _ => {
      run Testing.expect(false, "radius correction stays an exact ellipse")
    }
  }
}
