//! SVG decimal lexing. Cursor increments are guarded by the input length.
import silk.core.option { Option }
import silk.num.f64
import silk.num.u8
import silk.num.u64
import silk.num.i64
import silk.num.usize
import silk.collections.slice { Slice }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.text.format { Format, ParseError }

pub fn whitespace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn digit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

pub struct Cursor<'a> {
  pub data: &'a [u8],
  pub at: usize,
}

impl<'a> Cursor<'a> {
  pub fn make(data: &'a [u8]) -> Cursor<'a> {
    return Cursor<'a> { data: data, at: 0 }
  }

  pub fn space(self: &mut Cursor<'a>) -> () {
    while self.at < self.data.length && whitespace(self.data[self.at]) {
      self.at = self.at + 1
    }
  }

  // A comma is only legal between parameters, never before the first parameter.
  pub fn separator(self: &mut Cursor<'a>, commaAllowed: bool) -> () {
    Cursor.space(&mut self.*)
    if commaAllowed && self.at < self.data.length && self.data[self.at] == 44 {
      self.at = self.at + 1
      Cursor.space(&mut self.*)
    }
  }

  pub fn requiredSeparator(self: &mut Cursor<'a>) -> bool {
    let before = self.at
    Cursor.separator(&mut self.*, true)
    return self.at != before
  }

  pub fn flag(self: &mut Cursor<'a>) -> Option<f64> {
    if self.at >= self.data.length {
      return Option<f64>.None
    }
    let byte = self.data[self.at]
    if byte != 48 && byte != 49 {
      return Option<f64>.None
    }
    self.at = self.at + 1
    return Option<f64>.some(u8.toF64(byte - 48))
  }

  pub fn number(self: &mut Cursor<'a>) -> Option<f64> {
    let start = self.at
    if self.at < self.data.length && (self.data[self.at] == 43 || self.data[self.at] == 45) {
      self.at = self.at + 1
    }
    let mut digits = false
    while self.at < self.data.length && digit(self.data[self.at]) {
      self.at = self.at + 1
      digits = true
    }
    if self.at < self.data.length && self.data[self.at] == 46 {
      self.at = self.at + 1
      while self.at < self.data.length && digit(self.data[self.at]) {
        self.at = self.at + 1
        digits = true
      }
    }
    if !digits {
      return Option<f64>.None
    }
    if self.at < self.data.length && (self.data[self.at] == 101 || self.data[self.at] == 69) {
      self.at = self.at + 1
      if self.at < self.data.length && (self.data[self.at] == 43 || self.data[self.at] == 45) {
        self.at = self.at + 1
      }
      let exponentStart = self.at
      while self.at < self.data.length && digit(self.data[self.at]) {
        self.at = self.at + 1
      }
      if self.at == exponentStart {
        return Option<f64>.None
      }
    }
    let literal = Slice.view<u8>(self.data, start, self.at - start)
    match &exactDecimal(literal) {
      Option<f64>.Some { value } => {
        return Option<f64>.some(value)
      }
      _ => {}
    }
    let text = String.fromUtf8(literal)
    let parsed = match &text {
      Result<string, InvalidUtf8>.Success { value } => Format.f64Value(value)
      _ => {
        return Option<f64>.None
      }
    }
    return match &parsed {
      Result<f64, ParseError>.Success { value } => if f64.isFinite(value) {
        Option<f64>.some(value)
      } else {
        Option<f64>.None
      }
      _ => Option<f64>.None
    }
  }
}

// Complete token, with no implicit whitespace or comma trimming.
pub fn number(data: &[u8]) -> Option<f64> {
  let mut cursor = Cursor.make(data)
  let result = Cursor.number(&mut cursor)
  if cursor.at != data.length {
    return Option<f64>.None
  }
  return result
}

const EXACT_POWERS: [f64; 23] = [
  1e0,
  1e1,
  1e2,
  1e3,
  1e4,
  1e5,
  1e6,
  1e7,
  1e8,
  1e9,
  1e10,
  1e11,
  1e12,
  1e13,
  1e14,
  1e15,
  1e16,
  1e17,
  1e18,
  1e19,
  1e20,
  1e21,
  1e22,
]

/// Clinger's fast path for a decimal literal (optional sign, digits, optional
/// fraction, optional exponent): when the digits form an integer of at most
/// 2^53 and the decimal scale is within 10^±22, one IEEE multiply or divide of
/// two exact values is correctly rounded. None for anything else, including
/// malformed text; callers fall back to the full parser.
pub fn exactDecimal(bytes: &[u8]) -> Option<f64> {
  let mut i: usize = 0
  let mut negative = false
  if i < bytes.length && (bytes[i] == 43 || bytes[i] == 45) {
    negative = bytes[i] == 45
    i = i + 1
  }
  let mut mantissa: u64 = 0
  let mut digits: usize = 0
  let mut scale: i64 = 0
  while i < bytes.length && digit(bytes[i]) {
    mantissa = mantissa * 10 + u8.toU64(bytes[i] - 48)
    digits = digits + 1
    if digits > 18 {
      return Option<f64>.None
    }
    i = i + 1
  }
  if i < bytes.length && bytes[i] == 46 {
    i = i + 1
    let fraction = i
    while i < bytes.length && digit(bytes[i]) {
      mantissa = mantissa * 10 + u8.toU64(bytes[i] - 48)
      digits = digits + 1
      if digits > 18 {
        return Option<f64>.None
      }
      i = i + 1
    }
    if i == fraction {
      return Option<f64>.None
    }
    scale = scale - usize.toI64(i - fraction)
  }
  if digits == 0 {
    return Option<f64>.None
  }
  if i < bytes.length && (bytes[i] == 101 || bytes[i] == 69) {
    i = i + 1
    let mut exponentNegative = false
    if i < bytes.length && (bytes[i] == 43 || bytes[i] == 45) {
      exponentNegative = bytes[i] == 45
      i = i + 1
    }
    let exponentStart = i
    let mut exponent: i64 = 0
    while i < bytes.length && digit(bytes[i]) {
      if exponent > 1000 {
        return Option<f64>.None
      }
      exponent = exponent * 10 + u8.toI64(bytes[i] - 48)
      i = i + 1
    }
    if i == exponentStart {
      return Option<f64>.None
    }
    scale = if exponentNegative {
      scale - exponent
    } else {
      scale + exponent
    }
  }
  if i != bytes.length || mantissa > 9007199254740992 {
    return Option<f64>.None
  }
  let mut value = u64.toF64(mantissa)
  if scale > 22 || scale < -22 {
    if mantissa != 0 {
      return Option<f64>.None
    }
  } else if scale > 0 {
    value = value * EXACT_POWERS[i64.toUsize(scale)]
  } else if scale < 0 {
    value = value / EXACT_POWERS[i64.toUsize(-scale)]
  }
  return Option<f64>.some(
    if negative {
      -value
    } else {
      value
    },
  )
}
