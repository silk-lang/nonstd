//! SVG decimal lexing. Cursor increments are guarded by the input length.
import silk.core.option { Option }
import silk.num.f64
import silk.num.u8
import silk.collections.slice { Slice }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.text.format { Format, ParseError }

pub fn whitespace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn digit(byte: u8) -> bool {
  return byte >= 48 && byte <= 57
}

pub struct Cursor<'a> {
  pub data: &'a [u8],
  pub at: usize,
}

impl<'a> Cursor<'a> {
  pub fn make(data: &'a [u8]) -> Cursor<'a> {
    return Cursor<'a> { data: data, at: 0 }
  }

  pub fn space(self: &mut Cursor<'a>) -> () {
    while self.at < self.data.length && whitespace(self.data[self.at]) {
      self.at = self.at + 1
    }
  }

  // A comma is only legal between parameters, never before the first parameter.
  pub fn separator(self: &mut Cursor<'a>, commaAllowed: bool) -> () {
    Cursor.space(&mut self.*)
    if commaAllowed && self.at < self.data.length && self.data[self.at] == 44 {
      self.at = self.at + 1
      Cursor.space(&mut self.*)
    }
  }

  pub fn requiredSeparator(self: &mut Cursor<'a>) -> bool {
    let before = self.at
    Cursor.separator(&mut self.*, true)
    return self.at != before
  }

  pub fn flag(self: &mut Cursor<'a>) -> Option<f64> {
    if self.at >= self.data.length {
      return Option<f64>.None
    }
    let byte = self.data[self.at]
    if byte != 48 && byte != 49 {
      return Option<f64>.None
    }
    self.at = self.at + 1
    return Option<f64>.some(u8.toF64(byte - 48))
  }

  pub fn number(self: &mut Cursor<'a>) -> Option<f64> {
    let start = self.at
    if self.at < self.data.length && (self.data[self.at] == 43 || self.data[self.at] == 45) {
      self.at = self.at + 1
    }
    let mut digits = false
    while self.at < self.data.length && digit(self.data[self.at]) {
      self.at = self.at + 1
      digits = true
    }
    if self.at < self.data.length && self.data[self.at] == 46 {
      self.at = self.at + 1
      while self.at < self.data.length && digit(self.data[self.at]) {
        self.at = self.at + 1
        digits = true
      }
    }
    if !digits {
      return Option<f64>.None
    }
    if self.at < self.data.length && (self.data[self.at] == 101 || self.data[self.at] == 69) {
      self.at = self.at + 1
      if self.at < self.data.length && (self.data[self.at] == 43 || self.data[self.at] == 45) {
        self.at = self.at + 1
      }
      let exponentStart = self.at
      while self.at < self.data.length && digit(self.data[self.at]) {
        self.at = self.at + 1
      }
      if self.at == exponentStart {
        return Option<f64>.None
      }
    }
    let text = String.fromUtf8(Slice.view<u8>(self.data, start, self.at - start))
    let parsed = match &text {
      Result<string, InvalidUtf8>.Success { value } => Format.f64Value(value)
      _ => {
        return Option<f64>.None
      }
    }
    return match &parsed {
      Result<f64, ParseError>.Success { value } => if f64.isFinite(value) {
        Option<f64>.some(value)
      } else {
        Option<f64>.None
      }
      _ => Option<f64>.None
    }
  }
}

// Complete token, with no implicit whitespace or comma trimming.
pub fn number(data: &[u8]) -> Option<f64> {
  let mut cursor = Cursor.make(data)
  let result = Cursor.number(&mut cursor)
  if cursor.at != data.length {
    return Option<f64>.None
  }
  return result
}
