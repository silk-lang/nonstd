//! Analytic object bounds; each contract is anchored to the pinned SVG 2 snapshot.
import bounds
import bounds { Result }
import svg
import geometry { Path, Transform, Vector }
import silk.num.f64
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn near(actual: f64, expected: f64) -> bool {
  return f64.abs(actual - expected) <= 0.000000001 * f64.max(1.0, f64.abs(expected))
}

fn box(path: &Path, x0: f64, y0: f64, x1: f64, y1: f64) -> bool {
  let result = bounds.path(path)
  return match &result {
    Result.Finite { rect } => near(rect.xMin, x0) && near(rect.yMin, y0) && near(rect.xMax, x1)
      && near(rect.yMax, y1)
    _ => false
  }
}

fn transformedBox(path: &Path, transform: Transform, x0: f64, y0: f64, x1: f64, y1: f64) -> bool {
  let result = bounds.pathTransformed(path, transform)
  return match &result {
    Result.Finite { rect } => near(rect.xMin, x0) && near(rect.yMin, y0) && near(rect.xMax, x1)
      && near(rect.yMax, y1)
    _ => false
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataMovetoCommands
// Empty storage is absent geometry; the SVG element layer supplies (0,0,0,0).
test effect fn emptyAndPositionedMovesHaveDistinctBounds() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let empty = Path.make()
  let absent = bounds.path(&empty)
  run Testing.expect(
    match &absent {
      Result.Empty => true
      _ => false
    },
    "empty storage is absent",
  )
  let mut allocator = Allocator.systemAllocatorProvider()
  let single = run svg.parsePath(b"M17 -9") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&single.path, 17.0, -9.0, 17.0, -9.0), "moveto retains its position")
  let moves = run svg.parsePath(b"M17 -9 M30 4 M-2 7")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&moves.path, -2.0, -9.0, 30.0, 7.0), "all zero-length subpaths contribute")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataClosePathCommand
test effect fn linesCloseAndMultipleSubpathsBounds() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let line = run svg.parsePath(b"M8 2 L8 20") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&line.path, 8.0, 2.0, 8.0, 20.0), "vertical line retains zero width")
  let closed = run svg.parsePath(b"M10 10 L20 20 Z q-20 0 0 10 M50 -5 L60 -5")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&closed.path, 0.0, -5.0, 60.0, 20.0),
    "close restores start before the next curve",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataQuadraticBezierCommands
test effect fn quadraticInteriorExtremaExcludeControls() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let curve = run svg.parsePath(b"M0 0 Q100 200 20 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&curve.path, 0.0, 0.0, 500.0 / 9.0, 100.0),
    "x and y have different interior extrema",
  )
  let flat = run svg.parsePath(b"M3 4 Q3 4 3 4") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&flat.path, 3.0, 4.0, 3.0, 4.0),
    "constant polynomial is a positioned point",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataCubicBezierCommands
test effect fn cubicBothRootsAndDegenerateDerivatives() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let curve = run svg.parsePath(b"M0 0 C100 100 -100 100 0 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = 50.0 / f64.sqrt(3.0)
  run Testing.expect(
    box(&curve.path, -extent, 0.0, extent, 75.0),
    "both cubic roots, not control hull",
  )
  let linear = run svg.parsePath(b"M0 0 C2 2 2 2 0 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&linear.path, 0.0, 0.0, 1.5, 1.5), "linear derivative root")
  let repeated = run svg.parsePath(b"M0 0 C1 1 0 2 1 3")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&repeated.path, 0.0, 0.0, 1.0, 3.0), "double derivative root is harmless")
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcCorrectionOutOfRangeRadii
test effect fn correctedArcBoundsAndSweep() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let forward = run svg.parsePath(b"M-10 0 A-1 -1 0 0 1 10 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&forward.path, -10.0, -10.0, 10.0, 0.0),
    "negative undersized radii corrected before bounds",
  )
  let reverse = run svg.parsePath(b"M-10 0 A1 1 0 0 0 10 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&reverse.path, -10.0, 0.0, 10.0, 10.0),
    "sweep excludes the opposite semicircle",
  )
  let quarter = run svg.parsePath(b"M1 0 A1 1 0 0 1 0 1")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&quarter.path, 0.0, 0.0, 1.0, 1.0),
    "short arc excludes unused ellipse extrema",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
test effect fn rotatedLargeEllipseBounds() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let curve = run svg.parsePath(
    b"M1.4142135623730951 1.4142135623730951 A2 1 45 1 0 -.7071067811865476 .7071067811865476",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = f64.sqrt(2.5)
  run Testing.expect(
    box(&curve.path, -extent, -extent, extent, f64.sqrt(2.0)),
    "rotated long ellipse uses interior stationary angles",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#ArcOutOfRangeParameters
test effect fn degenerateArcBounds() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let zero = run svg.parsePath(b"M7 8 A0 100 45 1 1 -3 20")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(box(&zero.path, -3.0, 8.0, 7.0, 20.0), "zero radius is an exact line")
  let equal = run svg.parsePath(b"M7 8 A100 200 45 1 1 7 8")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&equal.path, 7.0, 8.0, 7.0, 8.0),
    "equal endpoints omit the ellipse, not moveto",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/types.html#Precision
// Explicit representation failure is library policy, never an approximate hull.
test effect fn boundsAvoidOverflowAndReportUnrepresentableArcs() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let huge = run svg.parsePath(b"M-1e308 0 Q1e308 1e308 -1e308 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&huge.path, -1.0e308, 0.0, 0.0, 5.0e307),
    "quadratic differences do not overflow",
  )
  let cubic = run svg.parsePath(b"M1e308 0 C1e308 1e308 1e308 -1e308 1e308 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = 1.0e308 / (2.0 * f64.sqrt(3.0))
  run Testing.expect(
    box(&cubic.path, 1.0e308, -extent, 1.0e308, extent),
    "scaled derivative and convex evaluation remain finite",
  )
  let tiny = run svg.parsePath(b"M0 0 Q0 1e-300 0 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tinyBounds = bounds.path(&tiny.path)
  run Testing.expect(
    match &tinyBounds {
      Result.Finite { rect } => near(rect.yMax / 1.0e-300, 0.5)
      _ => false
    },
    "tiny derivative is normalized before products",
  )
  let arc = run svg.parsePath(b"M-1e300 0 A1e300 1e300 0 0 1 1e300 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    box(&arc.path, -1.0e300, -1.0e300, 1.0e300, 0.0),
    "exact arc bounds have no subdivision tolerance limit",
  )
  let impossible = run svg.parsePath(b"M0 0 A1e-300 1e300 0 0 1 1 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let failed = bounds.path(&impossible.path)
  run Testing.expect(
    match &failed {
      Result.Limited => true
      _ => false
    },
    "normalization failure differs from empty geometry",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
// The algorithm's space is the requested coordinate system, not a mapped bbox.
test effect fn affineBezierBoundsAreNotMappedSourceBoxes() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let rotate = Transform.new(1.0, 1.0, -1.0, 1.0, 0.0, 0.0)
  let quadratic = run svg.parsePath(b"M0 0 Q2 4 4 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    transformedBox(&quadratic.path, rotate, -0.5, 0.0, 4.0, 4.5),
    "quadratic target-space extrema exclude mapped source-box corners",
  )
  let cubic = run svg.parsePath(b"M0 0 C0 4 4 4 4 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = 4.0 * f64.sqrt(2.0)
  run Testing.expect(
    transformedBox(&cubic.path, rotate, 4.0 - extent, 0.0, 4.0, extent),
    "cubic target-space extrema are analytic",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/implnote.html#ArcConversionEndpointToCenter
// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
test effect fn affineCorrectedArcBoundsIncludeShearAndReflection() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let semicircle = run svg.parsePath(b"M-10 0 A1 1 45 0 1 10 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shear = Transform.new(1.0, 0.0, 1.0, 1.0, 3.0, 4.0)
  run Testing.expect(
    transformedBox(&semicircle.path, shear, 3.0 - 10.0 * f64.sqrt(2.0), -6.0, 13.0, 4.0),
    "radius correction precedes target-space shear extrema",
  )
  let reflect = Transform.new(-1.0, 0.0, 0.0, 2.0, 3.0, 4.0)
  run Testing.expect(
    transformedBox(&semicircle.path, reflect, -7.0, -16.0, 13.0, 4.0),
    "reflection does not reinterpret original sweep",
  )
  let ellipse = run svg.parsePath(
    b"M1.4142135623730951 1.4142135623730951 A2 1 45 1 0 -.7071067811865476 .7071067811865476",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unrotate = Transform.new(1.0, -1.0, 1.0, 1.0, 0.0, 0.0)
  run Testing.expect(
    transformedBox(
      &ellipse.path,
      unrotate,
      -2.0 * f64.sqrt(2.0),
      -f64.sqrt(2.0),
      2.0 * f64.sqrt(2.0),
      f64.sqrt(2.0),
    ),
    "rotated large ellipse retains its original arc domain",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/coords.html#BoundingBoxes
test effect fn singularAffineBoundsRetainPositionAndTopology() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arc = run svg.parsePath(b"M-10 0 A10 10 0 0 1 10 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let project = Transform.new(0.0, 0.0, 1.0, 0.0, 8.0, 9.0)
  run Testing.expect(
    transformedBox(&arc.path, project, -2.0, 9.0, 8.0, 9.0),
    "rank-one ellipse is a positioned exact line interval",
  )
  let collapse = Transform.new(0.0, 0.0, 0.0, 0.0, 8.0, 9.0)
  run Testing.expect(
    transformedBox(&arc.path, collapse, 8.0, 9.0, 8.0, 9.0),
    "zero matrix preserves translation as a point",
  )
  let path = run svg.parsePath(b"M10 10 L20 20 Z q-20 0 0 10 M50 -5 L60 -5")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    transformedBox(&path.path, Transform.translation(Vector.new(3.0, 4.0)), 3.0, -1.0, 63.0, 24.0),
    "source subpath start is preserved after close",
  )
  run Testing.expect(
    transformedBox(&path.path, Transform.identity(), 0.0, -5.0, 60.0, 20.0),
    "identity agrees with path bounds",
  )
  let empty = Path.make()
  let absent = bounds.pathTransformed(&empty, collapse)
  run Testing.expect(
    match &absent {
      Result.Empty => true
      _ => false
    },
    "transform does not invent empty geometry",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/types.html#Precision
test effect fn affineBoundsNumericalLimitsAreExplicit() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let huge = run svg.parsePath(b"M-1e300 0 A1e300 1e300 0 0 1 1e300 0")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    transformedBox(&huge.path, Transform.scale(1.0e-300, 1.0e-300), -1.0, -1.0, 1.0, 0.0),
    "normalized sampling preserves finite rescaled arcs",
  )
  let outside = run svg.parsePath(b"M1e308 -1e308 A1e308 1e308 0 0 1 1e308 1e308")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    transformedBox(&outside.path, Transform.scale(0.25, 0.25), 2.5e307, -2.5e307, 5.0e307, 2.5e307),
    "shrink before expanding a source extremum beyond binary64",
  )
  let sourceLimit = bounds.path(&outside.path)
  run Testing.expect(
    match &sourceLimit {
      Result.Limited => true
      _ => false
    },
    "source extremum overflow remains explicit without a shrinking map",
  )
  let large = run svg.parsePath(b"M1e308 0 L1e308 1")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let overflow = bounds.pathTransformed(&large.path, Transform.scale(2.0, 1.0))
  run Testing.expect(
    match &overflow {
      Result.Limited => true
      _ => false
    },
    "unrepresentable transformed position is not empty",
  )
  let invalid = bounds.pathTransformed(&large.path, Transform.scale(f64.INFINITY, 1.0))
  run Testing.expect(
    match &invalid {
      Result.Limited => true
      _ => false
    },
    "nonfinite matrices fail explicitly",
  )
}
