//! Family names: CSS Fonts 4 #localized-name-matching compares them with Unicode Default
//! Caseless Matching (full case folding, status C and F, no normalization or tailoring).
import casefold_data
import ucd.utf8 as Utf8
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

/// A cursor over the case-folded scalars of a UTF-8 name; invalid bytes decode to U+FFFD.
struct Folded<'a> {
  name: &'a [u8],
  at: usize,
  pending: [u32; 3],
  length: usize,
  index: usize,
}

impl<'a> Folded<'a> {
  fn make(name: &'a [u8]) -> Folded<'a> {
    return Folded { name: name, at: 0, pending: [0, 0, 0], length: 0, index: 0 }
  }

  /// The next folded scalar, or 0x110000 at the end.
  fn next(self: &mut Self) -> u32 {
    if self.index == self.length {
      if self.at >= self.name.length {
        return 0x110000
      }
      let decoded = Utf8.decode(self.name, self.at)
      self.at = decoded.next
      self.length = casefold_data.fold(decoded.cp, &mut self.pending)
      self.index = 0
    }
    let value = self.pending[self.index]
    self.index = self.index + 1
    return value
  }
}

/// True when two UTF-8 family names are equal under Default Caseless Matching.
pub fn same(a: &[u8], b: &[u8]) -> bool {
  let mut left = Folded.make(a)
  let mut right = Folded.make(b)
  while true {
    let x = left.next()
    let y = right.next()
    if x != y {
      return false
    }
    if x == 0x110000 {
      return true
    }
  }
  return true
}

/// Appends `cp` to `out` as UTF-8; surrogates and out-of-range values become U+FFFD.
pub effect fn appendScalar(out: &mut Bytes, cp: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let value = if (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF {
    0xFFFD
  } else {
    cp
  }
  let mut encoded: [u8; 4] = [0; 4]
  let mut length: usize = 1
  if value < 0x80 {
    encoded[0] = u32.toU8(value)
  } else if value < 0x800 {
    encoded[0] = u32.toU8(0xC0 | u32.shiftRight(value, 6))
    encoded[1] = u32.toU8(0x80 | (value & 0x3F))
    length = 2
  } else if value < 0x10000 {
    encoded[0] = u32.toU8(0xE0 | u32.shiftRight(value, 12))
    encoded[1] = u32.toU8(0x80 | (u32.shiftRight(value, 6) & 0x3F))
    encoded[2] = u32.toU8(0x80 | (value & 0x3F))
    length = 3
  } else {
    encoded[0] = u32.toU8(0xF0 | u32.shiftRight(value, 18))
    encoded[1] = u32.toU8(0x80 | (u32.shiftRight(value, 12) & 0x3F))
    encoded[2] = u32.toU8(0x80 | (u32.shiftRight(value, 6) & 0x3F))
    encoded[3] = u32.toU8(0x80 | (value & 0x3F))
    length = 4
  }
  run Bytes.append(&mut out, Slice.view<u8>(&encoded, 0, length))
}
