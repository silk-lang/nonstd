import silk.testing.testing { Testing, AssertionError }

effect fn read(name: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run NativeHostInput.workingDirectory()
  let root = run Path.fromBytes(Bytes.asSlice(&cwd))
  let mut relative = run String.copy("images/svg/tests/fonts/")
  run String.append(&mut relative, name)
  let path = run Path.resolve(&root, String.view(&relative))
  let mut files = run OsFileSystem.make("/")
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

// https://www.w3.org/TR/css-fonts-4/#localized-name-matching
test effect fn familyNamesUseFullCaseFolding() -> ()
  ! AssertionError<'static> {
  run Testing.expect(names.same(b"Noto Sans", b"NOTO sans"), "ASCII case is ignored")
  run Testing.expect(names.same(b"Stra\xc3\x9fe", b"STRASSE"), "sharp s folds to ss")
  run Testing.expect(names.same(b"\xce\xa3\xce\xb1", b"\xcf\x83\xce\x91"), "Greek sigma folds")
  run Testing.expect(
    !names.same(b"a\xcc\x8a", b"\xc3\xa5"),
    "names are not normalized: a + ring differs from a-ring",
  )
  run Testing.expect(!names.same(b"Noto Sans", b"Noto Sans "), "lengths must agree")
}

effect fn loaded() -> FontDatabase
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut fonts = FontDatabase.make()
  let files: &[string] = &[
    "NotoSans-Regular.subset.ttf",
    "NotoSans-Bold.subset.ttf",
    "NotoSans-Italic.subset.ttf",
    "NotoSans-Black.subset.ttf",
    "NotoSans-Light.subset.ttf",
    "NotoSans-Thin.subset.ttf",
    "NotoSerif-Regular.subset.ttf",
    "NotoMono-Regular.subset.ttf",
    "RobotoFlex.subset.ttf",
  ]
  let mut index: usize = 0
  while index < files.length {
    drop run fonts.add(run read(files[index]))
    index = index + 1
  }
  drop run fonts.add(Bytes.make())
  run fonts.addGeneric(Generic.Serif, b"Missing Serif")
  run fonts.addGeneric(Generic.Serif, b"noto serif")
  run fonts.addGeneric(Generic.Monospace, b"Noto Mono")
  return move fonts
}

effect fn pick(fonts: &FontDatabase, family: &[u8], request: Request) -> Selection
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut faces = List<usize>.make()
  run fonts.family(family, &mut faces)
  let view = Fonts.make(fonts)
  return match run matching.select(&view, List<usize>.asSlice(&faces), request) {
    Option<Selection>.Some { value } => value
    Option<Selection>.None => Selection {
      face: 9999,
      weight: 0.0,
      width: 0.0,
      italic: Option<f64>.None,
      oblique: Option<f64>.None,
      syntheticOblique: 0.0,
      syntheticBold: false,
    }
  }
}

fn request(weight: f64, style: Style) -> Request {
  return Request { weight: weight, width: 100.0, style: style }
}

effect fn describesFaces() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  run Testing.expect(fonts.faceCount() == 9, "every font is read, empty data is skipped")
  let black = fonts.face(3)
  run Testing.expect(black.weight.min == 900.0, "usWeightClass gives the weight")
  run Testing.expect(
    List<Bytes>.length(&black.families) == 2,
    "typographic and legacy family names are both kept",
  )
  let italic = fonts.face(2)
  run Testing.expect(
    match italic.italic {
      Option<Range>.Some { value } => value.min == 1.0
      Option<Range>.None => false
    },
    "fsSelection ITALIC maps to italic 1",
  )
  run Testing.expect(
    match italic.oblique {
      Option<Range>.Some { value } => false
      Option<Range>.None => true
    },
    "an italic face has no oblique angles",
  )
  let flex = fonts.face(8)
  run Testing.expect(
    flex.axes == (AXIS_WEIGHT | AXIS_WIDTH | AXIS_SLANT),
    "registered axes are recorded",
  )
  run Testing.expect(
    flex.weight.min == 100.0 && flex.weight.max == 1000.0,
    "the wght axis gives the weight range",
  )
  run Testing.expect(
    match flex.oblique {
      Option<Range>.Some { value } => value.min == 0.0 && value.max == 10.0
      Option<Range>.None => false
    },
    "slnt -10..0 gives oblique angles 0..10",
  )
  let mut serif = List<usize>.make()
  run fonts.generic(Generic.Serif, &mut serif)
  run Testing.expect(
    List<usize>.length(&serif) == 1 && List<usize>.get(&serif, 0) == 6,
    "a generic family resolves to its first installed family",
  )
  let mut cursive = List<usize>.make()
  run fonts.generic(Generic.Cursive, &mut cursive)
  run Testing.expect(List<usize>.length(&cursive) == 0, "an unconfigured generic is empty")
}

// https://www.w3.org/TR/css-fonts-4/#font-style-matching
effect fn matchesStyles() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let sans = b"noto sans"
  run Testing.expect((run pick(&fonts, sans, request(400.0, Style.Normal))).face == 0, "regular")
  run Testing.expect((run pick(&fonts, sans, request(700.0, Style.Normal))).face == 1, "bold")
  run Testing.expect(
    (run pick(&fonts, sans, request(600.0, Style.Normal))).face == 1,
    "above 500 heavier weights are tried first",
  )
  let between = run pick(&fonts, sans, request(450.0, Style.Normal))
  run Testing.expect(between.face == 0, "450 finds nothing up to 500, then 400")
  run Testing.expect(
    (run pick(&fonts, sans, request(350.0, Style.Normal))).face == 4,
    "below 400 lighter weights are tried first",
  )
  run Testing.expect(
    (run pick(&fonts, sans, request(50.0, Style.Normal))).face == 5,
    "with nothing lighter the lightest heavier weight wins",
  )
  run Testing.expect(
    (run pick(&fonts, sans, request(950.0, Style.Normal))).face == 3,
    "with nothing heavier the heaviest lighter weight wins",
  )
  let italic = run pick(&fonts, sans, request(400.0, Style.Italic))
  run Testing.expect(
    italic.face == 2 && italic.syntheticOblique == 0.0,
    "italic picks the italic face",
  )
  let boldItalic = run pick(&fonts, sans, request(700.0, Style.Italic))
  run Testing.expect(
    boldItalic.face == 2 && boldItalic.syntheticBold,
    "style narrows before weight, so bold italic is the italic face emboldened",
  )
  let serif = run pick(&fonts, b"Noto Serif", request(400.0, Style.Italic))
  run Testing.expect(
    serif.face == 6 && serif.syntheticOblique == 14.0,
    "an upright face is sheared for italic",
  )
  let bold = run pick(&fonts, b"Noto Serif", request(700.0, Style.Normal))
  run Testing.expect(bold.syntheticBold, "a family without bold faces is emboldened")
}

// Variable faces support every value of their axis ranges.
effect fn matchesVariableFaces() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run loaded()
  let flex = b"Roboto Flex"
  let heavy = run pick(&fonts, flex, Request { weight: 830.0, width: 60.0, style: Style.Normal })
  run Testing.expect(
    heavy.face == 8 && heavy.weight == 830.0 && heavy.width == 60.0,
    "weights and widths inside the axis ranges are applied as asked",
  )
  run Testing.expect(!heavy.syntheticBold, "a variable bold is real")
  let wide = run pick(&fonts, flex, Request { weight: 400.0, width: 200.0, style: Style.Normal })
  run Testing.expect(wide.width == 151.0, "wider than the axis clamps to its maximum")
  let slanted = run pick(&fonts, flex, request(400.0, Style.Oblique { degrees: 8.0 }))
  run Testing.expect(
    match slanted.oblique {
      Option<f64>.Some { value } => value == 8.0
      Option<f64>.None => false
    }
      && slanted.syntheticOblique == 0.0,
    "an oblique angle inside the slnt range is applied",
  )
  let steep = run pick(&fonts, flex, request(400.0, Style.Oblique { degrees: 20.0 }))
  run Testing.expect(
    match steep.oblique {
      Option<f64>.Some { value } => value == 10.0
      Option<f64>.None => false
    },
    "a steeper request takes the steepest available angle below it",
  )
  let italic = run pick(&fonts, flex, request(400.0, Style.Italic))
  run Testing.expect(
    match italic.oblique {
      Option<f64>.Some { value } => value == 10.0
      Option<f64>.None => false
    },
    "with no italic values, italic takes oblique angles below 11deg descending",
  )
  let back = run pick(&fonts, flex, request(400.0, Style.Oblique { degrees: -5.0 }))
  run Testing.expect(
    match back.oblique {
      Option<f64>.Some { value } => value == 0.0
      Option<f64>.None => false
    }
      && back.syntheticOblique == -5.0,
    "backward angles mirror the search and shear the upright instance",
  )
}

test effect fn faceDescriptors() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run describesFaces() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn styleMatching() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matchesStyles() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn variableMatching() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run matchesVariableFaces() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-fonts-4/#font-face-rule
effect fn overlaysDocumentFaces() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let host = run loaded()
  let mut fonts = Fonts.make(&host)
  run Testing.expect(
    !run fonts.local.addFace(
      Bytes.make(),
      0,
      b"Broken",
      Option<Range>.None,
      Option<Range>.None,
      Option<FaceStyle>.None,
    ),
    "unusable data adds no face",
  )
  run Testing.expect(
    run fonts.local.addFace(
      run read("NotoMono-Regular.subset.ttf"),
      0,
      b"Noto Sans",
      Option<Range>.Some { value: Range { min: 300.0, max: 500.0 } },
      Option<Range>.None,
      Option<FaceStyle>.Some { value: FaceStyle.Italic },
    ),
    "a font file adds its first face",
  )
  run Testing.expect(fonts.faceCount() == 10, "document faces follow the host's")
  let mut faces = List<usize>.make()
  run fonts.family(b"noto sans", &mut faces)
  run Testing.expect(
    List<usize>.length(&faces) == 1 && List<usize>.get(&faces, 0) == 9,
    "a document family hides installed faces of the same name",
  )
  let face = fonts.face(9)
  run Testing.expect(face.weight.min == 300.0 && face.weight.max == 500.0, "weight descriptor")
  run Testing.expect(face.width.min == 100.0, "an absent descriptor keeps the font's value")
  run Testing.expect(face.oblique.isNone(), "italic style descriptor")
  run Testing.expect(
    fonts.data(9).length == Bytes.length(&run read("NotoMono-Regular.subset.ttf")),
    "data comes from the document face",
  )
  let found = fonts.installed(b"notomono")
  run Testing.expect(
    match found {
      Option<usize>.Some { value } => value == 7
      _ => false
    },
    "local() matches PostScript names case-insensitively",
  )
  run Testing.expect(fonts.installed(b"Noto Mono Regular").isNone(), "only whole names match")
  faces.clear()
  run fonts.generic(Generic.Monospace, &mut faces)
  run Testing.expect(
    List<usize>.length(&faces) == 1 && List<usize>.get(&faces, 0) == 7,
    "generic families still resolve through the host",
  )
}

test effect fn documentFaces() -> ()
  ! AssertionError<'static> | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run overlaysDocumentFaces() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn square(unicode: &[u32], form: Form) -> Glyph
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut characters = List<u32>.make()
  run characters.appendSlice(unicode)
  let mut outline = List<Command>.make()
  run outline.append(Command.MoveTo { x: 100.0, y: 0.0 })
  run outline.append(Command.LineTo { x: 500.0, y: 0.0 })
  run outline.append(Command.LineTo { x: 500.0, y: 700.0 })
  run outline.append(Command.Close)
  return Glyph {
    unicode: move characters,
    advance: 600.0,
    verticalAdvance: 1000.0,
    verticalOrigin: 800.0,
    form: form,
    direction: Direction.Any,
    usable: true,
    outline: move outline,
  }
}

fn glyphOf(font: &FontRef, cp: u32) -> u32 {
  return match Charmap.new(font).mapUnicode(cp) {
    Option<GlyphId>.Some { value } => GlyphId.toU32(value)
    _ => 0xffffffff
  }
}

// SVG 1.1 #GlyphSelectionRules: the first glyph in document order whose unicode matches.
effect fn compilesSvgFonts() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut glyphs = List<Glyph>.make()
  run glyphs.append(run square(&[0x41, 0x42], Form.Any))
  run glyphs.append(run square(&[0x41], Form.Any))
  run glyphs.append(run square(&[0x41], Form.Any))
  run glyphs.append(run square(&[0x628], Form.Initial))
  run glyphs.append(run square(&[0x628], Form.Any))
  run glyphs.append(run square(&[], Form.Any))
  let missing = run square(&[], Form.Any)
  let metrics = FontMetrics {
    unitsPerEm: 1000.0,
    ascent: 800.0,
    descent: 200.0,
    xHeight: 500.0,
    capHeight: 700.0,
    underlinePosition: -100.0,
    underlineThickness: 50.0,
    strikethroughPosition: 300.0,
    strikethroughThickness: 50.0,
    weight: 400.0,
    verticalAdvance: 1000.0,
    verticalOrigin: 800.0,
  }
  let data = run compile(b"Test Font", metrics, &missing, glyphs.asSlice(), &[])
  let font = match move FontRef.new(Bytes.asSlice(&data)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "compiled data parses as OpenType")
      return
    }
  }
  run Testing.expect(glyphOf(&font, 0x41) == 2, "the first single glyph for a character wins")
  run Testing.expect(glyphOf(&font, 0x628) == 5, "the cmap holds the isolated form")
  run Testing.expect(
    glyphOf(&font, 0x42) == 7,
    "a character known only inside a ligature maps to a placeholder after the glyphs",
  )
  run Testing.expect(glyphOf(&font, ALTERNATES + 5) == 6, "every glyph has a private character")
  run Testing.expect(glyphOf(&font, 0x43) == 0xffffffff, "other characters stay unmapped")
  let mut database = FontDatabase.make()
  run Testing.expect((run database.add(move data)) == 1, "the font database reads the face")
  run Testing.expect(
    names.same(Bytes.asSlice(&List<Bytes>.asSlice(&database.face(0).families)[0]), b"Test Font"),
    "the family comes from the name table",
  )
}

test effect fn svgFonts() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compilesSvgFonts() |> Effect.provideMut<Allocator>(&mut allocator)
}
