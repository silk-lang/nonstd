//! The look of the notes app: a quiet, document-first palette (warm grays, one blue accent) in
//! light and dark, and the small line icons the sidebar and the page bar use.
import ui_components.lib { Theme, rgb, rgba }
import ui_tree.mutation { CanvasCommand }
import silk.color.rgba { Rgba }

/// The components' theme for the app.
pub fn theme(font: u32, dark: bool) -> Theme {
  let mut look = Theme.light(font)
  look.fontSize = 14.0
  look.smallSize = 12.0
  look.headingSize = 18.0
  look.radius = 6.0
  look.controlHeight = 28.0
  if dark {
    look.background = rgb(0x191919)
    look.surface = rgb(0x252525)
    look.text = rgba(0xFFFFFF, 0.81)
    look.mutedText = rgba(0xFFFFFF, 0.46)
    look.border = rgba(0xFFFFFF, 0.094)
    look.strongBorder = rgba(0xFFFFFF, 0.2)
    look.hover = rgba(0xFFFFFF, 0.055)
    look.pressed = rgba(0xFFFFFF, 0.1)
    look.accent = rgb(0x2383E2)
    look.accentHover = rgb(0x0F6CC9)
    look.highlight = rgba(0xFFFFFF, 0.08)
    look.danger = rgb(0xEB5757)
    look.dangerHover = rgb(0xD94444)
    look.scrim = rgba(0x000000, 0.6)
    look.tooltip = rgb(0x3F3F3F)
    look.tooltipText = rgba(0xFFFFFF, 0.9)
  } else {
    look.background = rgb(0xFFFFFF)
    look.surface = rgb(0xFFFFFF)
    look.text = rgb(0x37352F)
    look.mutedText = rgb(0x787774)
    look.border = rgb(0xE9E9E7)
    look.strongBorder = rgb(0xD3D3D1)
    look.hover = rgba(0x37352F, 0.06)
    look.pressed = rgba(0x37352F, 0.12)
    look.accent = rgb(0x2383E2)
    look.accentHover = rgb(0x0F6CC9)
    look.highlight = rgba(0x37352F, 0.08)
    look.danger = rgb(0xEB5757)
    look.dangerHover = rgb(0xD94444)
    look.scrim = rgba(0x0F0F0F, 0.4)
    look.tooltip = rgb(0x0F0F0F)
    look.tooltipText = rgb(0xFFFFFF)
  }
  return look
}

/// The sidebar's background.
pub fn sidebar(dark: bool) -> Rgba<f32> {
  return if dark {
    rgb(0x202020)
  } else {
    rgb(0xF7F7F5)
  }
}

/// The selected row in the sidebar.
pub fn selectedRow(dark: bool) -> Rgba<f32> {
  return if dark {
    rgba(0xFFFFFF, 0.08)
  } else {
    rgba(0x37352F, 0.08)
  }
}

/// The square behind the workspace initial.
pub fn badge(dark: bool) -> Rgba<f32> {
  return if dark {
    rgb(0x3F4448)
  } else {
    rgb(0xE3E2E0)
  }
}

/// A page: a sheet with a folded corner and two lines of text, 16 by 16.
pub fn pageIcon(color: Rgba<f32>) -> [CanvasCommand; 11] {
  return [
    CanvasCommand.MoveTo { x: 3.5, y: 1.5 },
    CanvasCommand.LineTo { x: 9.5, y: 1.5 },
    CanvasCommand.LineTo { x: 12.5, y: 4.5 },
    CanvasCommand.LineTo { x: 12.5, y: 14.5 },
    CanvasCommand.LineTo { x: 3.5, y: 14.5 },
    CanvasCommand.Close,
    CanvasCommand.MoveTo { x: 5.5, y: 8.0 },
    CanvasCommand.LineTo { x: 10.5, y: 8.0 },
    CanvasCommand.MoveTo { x: 5.5, y: 11.0 },
    CanvasCommand.LineTo { x: 10.5, y: 11.0 },
    CanvasCommand.Stroke { color: color, width: 1.2 },
  ]
}

/// A magnifying glass, 16 by 16.
pub fn searchIcon(color: Rgba<f32>) -> [CanvasCommand; 8] {
  return [
    CanvasCommand.MoveTo { x: 11.0, y: 7.0 },
    CanvasCommand.CubicTo { x1: 11.0, y1: 9.21, x2: 9.21, y2: 11.0, x: 7.0, y: 11.0 },
    CanvasCommand.CubicTo { x1: 4.79, y1: 11.0, x2: 3.0, y2: 9.21, x: 3.0, y: 7.0 },
    CanvasCommand.CubicTo { x1: 3.0, y1: 4.79, x2: 4.79, y2: 3.0, x: 7.0, y: 3.0 },
    CanvasCommand.CubicTo { x1: 9.21, y1: 3.0, x2: 11.0, y2: 4.79, x: 11.0, y: 7.0 },
    CanvasCommand.MoveTo { x: 10.0, y: 10.0 },
    CanvasCommand.LineTo { x: 13.5, y: 13.5 },
    CanvasCommand.Stroke { color: color, width: 1.4 },
  ]
}

/// A plus, 16 by 16.
pub fn plusIcon(color: Rgba<f32>) -> [CanvasCommand; 5] {
  return [
    CanvasCommand.MoveTo { x: 8.0, y: 3.0 },
    CanvasCommand.LineTo { x: 8.0, y: 13.0 },
    CanvasCommand.MoveTo { x: 3.0, y: 8.0 },
    CanvasCommand.LineTo { x: 13.0, y: 8.0 },
    CanvasCommand.Stroke { color: color, width: 1.4 },
  ]
}

/// A pin, 12 by 12.
pub fn pinIcon(color: Rgba<f32>) -> [CanvasCommand; 11] {
  return [
    CanvasCommand.MoveTo { x: 4.0, y: 1.5 },
    CanvasCommand.LineTo { x: 8.0, y: 1.5 },
    CanvasCommand.LineTo { x: 7.5, y: 5.0 },
    CanvasCommand.LineTo { x: 9.5, y: 7.0 },
    CanvasCommand.LineTo { x: 2.5, y: 7.0 },
    CanvasCommand.LineTo { x: 4.5, y: 5.0 },
    CanvasCommand.Close,
    CanvasCommand.Fill { color: color },
    CanvasCommand.MoveTo { x: 6.0, y: 7.0 },
    CanvasCommand.LineTo { x: 6.0, y: 11.0 },
    CanvasCommand.Stroke { color: color, width: 1.2 },
  ]
}
