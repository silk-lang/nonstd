//! Plain text helpers for the notes: word counts, search matching, previews.
import silk.text.string { String }
import silk.core.option { Option }
import silk.num.u8

fn isSpace(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn lower(byte: u8) -> u8 {
  return if byte >= 65 && byte <= 90 {
    byte + 32
  } else {
    byte
  }
}

/// The number of words in `text`: runs of characters between spaces, tabs and line breaks.
pub fn wordCount(text: string) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut count: usize = 0
  let mut inWord = false
  let mut i: usize = 0
  while i < bytes.length {
    if isSpace(bytes[i]) {
      inWord = false
    } else if !inWord {
      inWord = true
      count = count + 1
    }
    i = i + 1
  }
  return count
}

/// The number of characters (Unicode scalars) in `text`.
pub fn characterCount(text: string) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut count: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    // Continuation bytes are 10xxxxxx.
    if u8.bitAnd(bytes[i], 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

/// Whether `text` contains `query`, ignoring ASCII case.
pub fn containsIgnoringCase(text: string, query: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(query)
  if b.length == 0 {
    return true
  }
  if b.length > a.length {
    return false
  }
  let mut i: usize = 0
  while i + b.length <= a.length {
    let mut j: usize = 0
    while j < b.length && lower(a[i + j]) == lower(b[j]) {
      j = j + 1
    }
    if j == b.length {
      return true
    }
    i = i + 1
  }
  return false
}

/// Whether a note with `title` and `body` matches the search `query` (in either, ignoring
/// ASCII case and the spaces around the query). An empty query matches every note.
pub fn matches(title: string, body: string, query: string) -> bool {
  let trimmed = String.trim(query)
  return containsIgnoringCase(title, trimmed) || containsIgnoringCase(body, trimmed)
}

/// The byte length of the first `limit` characters of `text` (all of it when shorter).
fn prefixLength(text: string, limit: usize) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut characters: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if u8.bitAnd(bytes[i], 0xC0) != 0x80 {
      if characters == limit {
        return i
      }
      characters = characters + 1
    }
    i = i + 1
  }
  return bytes.length
}

/// The first line of `text` with something on it, trimmed, cut to `limit` characters. Whether
/// it was cut comes back in `cut`.
pub fn preview<'a>(text: string<'a>, limit: usize, cut: &mut bool) -> string<'a> {
  let mut rest = text
  let mut line = String.slice(text, 0, 0)
  while String.byteLength(rest) != 0 {
    let end = match String.find(rest, "\n") {
      Option<usize>.Some { value } => value
      Option<usize>.None => String.byteLength(rest)
    }
    line = String.trim(String.slice(rest, 0, end))
    if String.byteLength(line) != 0 {
      break
    }
    if end == String.byteLength(rest) {
      break
    }
    rest = String.slice(rest, end + 1, String.byteLength(rest) - end - 1)
  }
  let length = prefixLength(line, limit)
  cut.* = length < String.byteLength(line)
  return String.slice(line, 0, length)
}

/// `title`, or "Untitled" when it is empty or only spaces.
pub fn displayTitle(title: string) -> string {
  let trimmed = String.trim(title)
  return if String.byteLength(trimmed) == 0 {
    "Untitled"
  } else {
    trimmed
  }
}

/// Orders `a` and `b` by their bytes, ignoring ASCII case: negative when `a` comes first, 0
/// when they are the same, positive when `b` does.
pub fn compareIgnoringCase(a: string, b: string) -> i32 {
  let x = String.utf8Bytes(a)
  let y = String.utf8Bytes(b)
  let mut i: usize = 0
  while i < x.length && i < y.length {
    let p = lower(x[i])
    let q = lower(y[i])
    if p != q {
      return if p < q {
        -1
      } else {
        1
      }
    }
    i = i + 1
  }
  return if x.length == y.length {
    0
  } else if x.length < y.length {
    -1
  } else {
    1
  }
}
