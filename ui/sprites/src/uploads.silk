//! Pixels waiting to be copied into atlas textures.
import atlas.atlas { AtlasTile }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Pixels to copy into a texture: `tile.bounds` of texture `tile.texture`, from
/// [`Uploads.bytes`] starting at `offset`, `bytesPerRow` bytes per row, tightly packed. The same
/// shape as font-raster's glyph uploads, so a renderer copies both the same way.
pub struct Upload {
  pub tile: AtlasTile,
  pub offset: usize,
  pub bytesPerRow: u32,
}

impl Copy for Upload {}

/// Tiles allocated since the last [`Uploads.clear`], in allocation order, and their pixels.
pub struct Uploads {
  entries: List<Upload>,
  data: List<u8>,
}

impl Uploads {
  pub fn make() -> Uploads {
    return Uploads { entries: List<Upload>.make(), data: List<u8>.make() }
  }

  /// Queues `pixels`, `bytesPerRow` bytes per row, for `tile`.
  pub effect fn push(self: &mut Self, tile: AtlasTile, pixels: &[u8], bytesPerRow: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let offset = self.data.length()
    run self.data.appendSlice(pixels)
    run self.entries.append(Upload { tile: tile, offset: offset, bytesPerRow: bytesPerRow })
  }

  pub fn list(self: &Self) -> &[Upload] {
    return self.entries.asSlice()
  }

  /// The bytes [`Upload.offset`] points into.
  pub fn bytes(self: &Self) -> &[u8] {
    return self.data.asSlice()
  }

  /// Forgets the queued uploads once the renderer has copied them.
  pub fn clear(self: &mut Self) -> () {
    self.entries.clear()
    self.data.clear()
  }
}
