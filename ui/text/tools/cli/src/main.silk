//! Lays out one paragraph with real fonts and prints its text fragments as JSON, for the
//! Chrome comparison in `ui/text/scripts/chrome-text.mjs`.
//!
//! Input on stdin, one command per line (lengths in hundredths of a pixel):
//!
//! ```text
//! font <path>                          font file, relative to the working directory
//! fallback <family>                    a family tried after the requested ones
//! style <size> <weight> <normal|italic> <family>[|<family>...]
//! block <width> <ltr|rtl> <start|end|left|right|center|justify> <normal|lineHeight> <collapse|preserve|pre-line|break-spaces|nowrap> <style>
//! open <style> [<isolate|embed|bidi-override|isolate-override|plaintext> <ltr|rtl>]
//! text <percent-encoded UTF-8>
//! close
//! ```
import ui_text.lib { TextSystem, TextStyle, FontCollection, Family, Request, Style as FontStyle }
import layout.lib as Engine
import layout.lib {
  Style,
  Display,
  DisplayOutside,
  DisplayInside,
  Dimension,
  Direction,
  UnicodeBidi,
  TextAlign,
  WhiteSpaceCollapse,
  TextWrap,
  LineHeight,
  Tree,
  NodeId,
  LayoutTree,
  OptionalSize,
  InvalidNode,
  TextError,
  FragmentationError,
  FragmentKind
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

import silk.system.host_input { HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }
import silk.io.standard_input_native { OsStandardInput }
import silk.io.standard_input { StandardInput, StreamReadError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.io.writer { Writer, WriterError }
import silk.json.value { Json }
import silk.json.scanner { JsonError }
import silk.json.output { JsonOptions }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String, InvalidUtf8 }
import silk.text.format { ParseError }
import silk.json.codec { Serialize }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.f32
import silk.num.u8

pub struct InputError {}

effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}

effect fn readFile(relative: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let root = run Path.root()
  let path = run Path.resolve(&root, relative)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

effect fn readInput() -> Bytes
  ! StreamReadError | OutOfMemoryError
  ? &mut StandardInput | &mut Allocator {
  let mut bytes = Bytes.make()
  let mut buffer: [u8; 4096] = [0; 4096]
  while true {
    let outcome = run StandardInput.receive(&mut buffer)
    let count = StandardInput.count(&outcome)
    run bytes.append(Slice.view<u8>(&buffer, 0, count))
    if StandardInput.isEndOfInput(&outcome) {
      return move bytes
    }
  }
  return move bytes
}

effect fn number(text: string) -> usize
  ! InputError {
  return match usize.parse(text) {
    Result<usize, ParseError>.Success { value } => value
    _ => {
      fail InputError {}
    }
  }
}

effect fn hundredths(text: string) -> f32
  ! InputError {
  return usize.toF32(run number(text)) / 100.0
}

fn hex(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  return 0
}

effect fn decode(text: string) -> String
  ! OutOfMemoryError | InputError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut out = Bytes.make()
  let mut at: usize = 0
  while at < bytes.length {
    if bytes[at] == 37 && at + 2 < bytes.length + 0 && at + 2 <= bytes.length - 1 {
      let value: u8 = hex(bytes[at + 1]) * 16 + hex(bytes[at + 2])
      run out.append(&[value])
      at = at + 3
    } else {
      run out.append(&[bytes[at]])
      at = at + 1
    }
  }
  return match String.fromBytes(move out) {
    Result<String, InvalidUtf8>.Success { value } => move value
    _ => {
      fail InputError {}
    }
  }
}

// Splits `line` at spaces into at most `limit` fields; the last keeps the rest.
effect fn fields<'a>(line: string<'a>, limit: usize, out: &mut List<string<'a>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  out.clear()
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    if bytes[at] == 32 && out.length() + 1 < limit {
      run out.append(String.slice(line, start, at - start))
      start = at + 1
    }
    at = at + 1
  }
  run out.append(String.slice(line, start, bytes.length - start))
}

effect fn families(text: string) -> List<Family>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Family>.make()
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 124 {
      run out.append(run Family.named(Slice.view<u8>(bytes, start, at - start)))
      start = at + 1
    }
    at = at + 1
  }
  return move out
}

fn bidiOf(text: string) -> UnicodeBidi {
  if text == "isolate" {
    return UnicodeBidi.Isolate
  }
  if text == "embed" {
    return UnicodeBidi.Embed
  }
  if text == "bidi-override" {
    return UnicodeBidi.BidiOverride
  }
  if text == "isolate-override" {
    return UnicodeBidi.IsolateOverride
  }
  if text == "plaintext" {
    return UnicodeBidi.Plaintext
  }
  return UnicodeBidi.Normal
}

fn directionOf(text: string) -> Direction {
  if text == "rtl" {
    return Direction.Rtl
  }
  return Direction.Ltr
}

fn alignOf(text: string) -> TextAlign {
  if text == "end" {
    return TextAlign.End
  }
  if text == "left" {
    return TextAlign.Left
  }
  if text == "right" {
    return TextAlign.Right
  }
  if text == "center" {
    return TextAlign.Center
  }
  if text == "justify" {
    return TextAlign.Justify
  }
  return TextAlign.Start
}

effect fn field<T: Serialize>(name: string, value: &T) -> ()
  ! JsonError | WriterError
  ? &mut Writer {
  run Writer.writeString(",\"")
  run Writer.writeString(name)
  run Writer.writeString("\":")
  run Json.serialize(value, &JsonOptions.compact())
}

effect fn execute(input: string) -> ()
  ! OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | JsonError
    | WriterError
  ? &mut Allocator | &mut Writer {
  let mut collection = FontCollection.make()
  let mut parts = List<string>.make()
  let mut styles = List<TextStyle>.make()

  // First pass: fonts and styles, which the text system borrows.
  let mut lines = String.split(input, "\n")
  while true {
    let line = match lines.next() {
      Option<string>.Some { value } => value
      Option<string>.None => {
        break
      }
    }
    if String.startsWith(line, "font ") {
      drop run collection.add(run readFile(String.slice(line, 5, String.byteLength(line) - 5)))
    } else if String.startsWith(line, "fallback ") {
      run collection.addFallback(
        String.utf8Bytes(String.slice(line, 9, String.byteLength(line) - 9)),
      )
    } else if String.startsWith(line, "style ") {
      run fields(line, 5, &mut parts)
      let mut style = TextStyle.make(run families(parts.get(4)), run hundredths(parts.get(1)))
      style.request.weight = usize.toF64(run number(parts.get(2)))
      if parts.get(3) == "italic" {
        style.request.style = FontStyle.Italic
      }
      run styles.append(move style)
    }
  }
  let mut system = TextSystem.make(&collection)
  let mut keys = List<usize>.make()
  while styles.length() > 0 {
    let style = styles.remove(0)
    run keys.append(run system.addStyle(move style))
  }
  let mut root = Style.make()
  let mut tree = run Tree.make(move root)
  let mut stack = List<NodeId>.make()
  run stack.append(tree.root())
  let mut texts = List<usize>.make()
  let mut width: f32 = 0.0
  let mut blockLineHeight = LineHeight.Normal
  let mut blockSpace = WhiteSpaceCollapse.Collapse
  let mut blockWrap = TextWrap.Wrap
  let mut blockDirection = Direction.Ltr
  lines = String.split(input, "\n")
  while true {
    let line = match lines.next() {
      Option<string>.Some { value } => value
      Option<string>.None => {
        break
      }
    }
    if String.startsWith(line, "block ") {
      run fields(line, 7, &mut parts)
      width = run hundredths(parts.get(1))
      let mut style = Style.make()
      style.width = Dimension.px(width)
      style.direction = directionOf(parts.get(2))
      style.textAlign = alignOf(parts.get(3))
      if parts.get(4) != "normal" {
        style.lineHeight = LineHeight.Number { value: run hundredths(parts.get(4)) }
      }
      let space = parts.get(5)
      if space == "preserve" {
        style.whiteSpaceCollapse = WhiteSpaceCollapse.Preserve
      } else if space == "pre-line" {
        style.whiteSpaceCollapse = WhiteSpaceCollapse.PreserveBreaks
      } else if space == "break-spaces" {
        style.whiteSpaceCollapse = WhiteSpaceCollapse.BreakSpaces
      } else if space == "nowrap" {
        style.textWrap = TextWrap.NoWrap
      }
      style.fontKey = keys.get(run number(parts.get(6)))
      blockLineHeight = style.lineHeight
      blockSpace = style.whiteSpaceCollapse
      blockWrap = style.textWrap
      blockDirection = style.direction
      let parent = stack.get(stack.length() - 1)
      let id = run tree.append(parent, move style)
      run stack.append(id)
    } else if String.startsWith(line, "open ") {
      run fields(line, 4, &mut parts)
      let mut style = Style.make()
      style.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
      style.fontKey = keys.get(run number(parts.get(1)))
      let parent = stack.get(stack.length() - 1)
      style.lineHeight = blockLineHeight
      style.whiteSpaceCollapse = blockSpace
      style.textWrap = blockWrap
      style.direction = blockDirection
      if parts.length() >= 4 {
        style.unicodeBidi = bidiOf(parts.get(2))
        style.direction = directionOf(parts.get(3))
      }
      let id = run tree.append(parent, move style)
      run stack.append(id)
    } else if line == "close" {
      drop stack.pop()
    } else if String.startsWith(line, "text ") {
      let text = run decode(String.slice(line, 5, String.byteLength(line) - 5))
      let parent = stack.get(stack.length() - 1)
      let id = run tree.appendText(parent, move text)
      while texts.length() <= id.index {
        run texts.append(usize.MAX)
      }
      texts.set(id.index, 0)
    }
  }

  // Number text nodes in input order.
  let mut ordinal: usize = 0
  let mut index: usize = 0
  while index < texts.length() {
    if texts.get(index) != usize.MAX {
      texts.set(index, ordinal)
      ordinal = ordinal + 1
    }
    index = index + 1
  }
  let mut output = LayoutTree.make()
  run Engine.compute(&tree, &mut output, &mut system, OptionalSize.definite(width, 100000.0))
  output.fragments.resolveLocations()
  run Writer.writeString("{\"texts\":[")
  let fragments = output.fragments.values.asSlice()
  let mut first = true
  index = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.kind == FragmentKind.Text && fragment.textData != usize.MAX
      && fragment.source < texts.length() {
      let data = output.fragments.texts.get(fragment.textData)
      if !first {
        run Writer.writeString(",")
      }
      first = false
      run Writer.writeString("{\"node\":")
      run Json.serialize(&texts.get(fragment.source), &JsonOptions.compact())
      run field("start", &data.sourceStart)
      run field("end", &data.sourceEnd)
      run field("x", &fragment.worldLocation.x)
      run field("y", &fragment.worldLocation.y)
      run field("width", &fragment.size.width)
      run field("height", &fragment.size.height)
      run field("fontKey", &data.fontKey)
      run field("level", &data.bidiLevel)
      let face = if data.shapeKey < system.glyphs.length() {
        system.glyphRun(data.shapeKey).face
      } else {
        usize.MAX
      }
      run field("face", &face)
      let glyphCount = if data.shapeKey < system.glyphs.length() {
        system.runGlyphs(data.shapeKey).length
      } else {
        0
      }
      run field("glyphs", &glyphCount)
      run Writer.writeString("}")
    }
    index = index + 1
  }
  run Writer.writeString("],\"shapeCalls\":")
  run Json.serialize(&system.shapeCalls, &JsonOptions.compact())
  run Writer.writeString("}\n")
}

effect fn application() -> i32
  ! StreamReadError
    | OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | JsonError
    | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut stdout = StdoutWriter.make()
  let bytes = run readInput()
    |> Effect.provideMut<StandardInput>(&mut input)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = match String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    _ => {
      fail InputError {}
    }
  }
  run execute(text.view())
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut stdout)
  return 0
}

effect fn report(message: string) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("ui-text-cli: ")
  run Writer.writeString(message)
  run Writer.writeString("\n")
}

effect fn failed(
  error: StreamReadError
    | OutOfMemoryError
    | InputError
    | FileError
    | HostInputError
    | InvalidNode
    | TextError
    | FragmentationError
    | JsonError
    | WriterError,
) -> i32 {
  drop error
  let mut stderr = StderrWriter.make()
  let written = run report("request failed: bad input, unreadable font, text error or I/O failure")
    |> Effect.provideMut<Writer>(&mut stderr)
    |> Effect.result
  drop written
  return 1
}

pub fn main() -> i32 {
  return run application() |> Effect.catchAll(failed)
}
