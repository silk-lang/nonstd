//! Inspector protocol tests over the inbox fixture: every command through `Protocol.handle`,
//! and requests over a real Unix socket through `Inspector.poll`. Run from the repository root
//! (the fixtures read fonts from there; the socket file is made there and removed).
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib {
  Protocol,
  Outcome,
  Inspector,
  Address,
  parseAddress,
  describeAddress,
  roleNamed
}
import ui_inspect.lib { InspectOptions, inspectNode }
import ui_tree.lib {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  DescribeOptions,
  Role,
  Event,
  EventKind,
  NONE,
  describe
}
import font_collection.lib { FontCollection }
import codec.png
import codec.png { PngError }
import codec.image { ImageError }
