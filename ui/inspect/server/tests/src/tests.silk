import silk.text.string { String }

effect fn say(text: string) -> () {
  let mut writer = StderrWriter.make()
  drop run Effect.result(Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer))
}

effect fn inbox(collection: &FontCollection) -> UiTree
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.0 })
  return move tree
}

/// Runs one request line and parses the reply.
effect fn ask(protocol: &mut Protocol, tree: &mut UiTree, line: string) -> Value
  ! JsonError | OutOfMemoryError
  ? &mut Allocator {
  let request = run Json.parse(String.utf8Bytes(line))
  let mut out = String.make()
  let outcome = run protocol.handle(&mut tree, &request, 0, &mut out)
  if outcome == Outcome.Pending {
    return run Json.parse(b"{\"pending\":true}")
  }
  let reply = run Json.parse(out.ownedUtf8Bytes())
  return move reply
}

fn ok(reply: &Value) -> bool {
  return match Json.field(reply, "ok") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: b } => b
      _ => false
    }
    Option<&Value>.None => false
  }
}

fn pending(reply: &Value) -> bool {
  return match Json.field(reply, "pending") {
    Option<&Value>.Some { value } => true
    Option<&Value>.None => false
  }
}

fn text<'a>(reply: &'a Value, key: string) -> string<'a> {
  return match Json.asString(Json.field(reply, key)) {
    Option<string>.Some { value } => value
    Option<string>.None => ""
  }
}

fn int(reply: &Value, key: string) -> i64 {
  return match Json.asI64(Json.field(reply, key)) {
    Option<i64>.Some { value } => value
    Option<i64>.None => -1
  }
}

fn nodeId(reply: &Value) -> i64 {
  return match Json.asI64(Json.fieldAt(Json.field(reply, "node"), "id")) {
    Option<i64>.Some { value } => value
    Option<i64>.None => -1
  }
}

fn sameBytes(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn same(a: string, b: string) -> bool {
  return a == b
}

effect fn readOnlyBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()

  let hello = run ask(&mut protocol, &mut tree, "{\"id\":7,\"cmd\":\"hello\"}")
  run Testing.expect(ok(&hello) && int(&hello, "id") == 7, "hello echoes the id")
  run Testing.expect(int(&hello, "protocol") == 1, "protocol version 1")
  run Testing.expect(int(&hello, "root") == 1, "the inbox panel is the root")

  let snap = run ask(&mut protocol, &mut tree, "{\"cmd\":\"snapshot\"}")
  let mut expected = String.make()
  run describe(&tree, DescribeOptions.plain(), &mut expected)
  run Testing.expect(same(text(&snap, "text"), String.view(&expected)), "snapshot is describe")
  let part = run ask(&mut protocol, &mut tree, "{\"cmd\":\"snapshot\",\"node\":10}")
  run Testing.expect(String.startsWith(text(&part, "text"), "box #10"), "a subtree snapshot")

  let buttons = run ask(&mut protocol, &mut tree, "{\"cmd\":\"query\",\"role\":\"button\"}")
  run Testing.expect(int(&buttons, "count") == 3, "three buttons")
  let archive = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"query\",\"query\":{\"role\":\"button\",\"name\":\"archive\"}}",
  )
  run Testing.expect(int(&archive, "count") == 1, "Archive by role and name, nested query")
  let none = run ask(&mut protocol, &mut tree, "{\"cmd\":\"query\",\"role\":\"wizard\"}")
  run Testing.expect(!ok(&none) && same(text(&none, "error"), "unknown role"), "unknown role")

  let view = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"inspect\",\"role\":\"button\",\"name\":\"New\"}",
  )
  let mut panel = String.make()
  run inspectNode(&tree, fixtures.NEW_BUTTON, InspectOptions.all(), &mut panel)
  run Testing.expect(same(text(&view, "text"), String.view(&panel)), "inspect is the node view")
  run Testing.expect(nodeId(&view) == 10, "inspect names the node")
  run Testing.expect(
    same(text(Json.field(&view, "node") |> Option<&Value>.unwrapOr(&view), "name"), "New"),
    "with its accessible name",
  )

  let picked = run ask(&mut protocol, &mut tree, "{\"cmd\":\"pick\",\"x\":40,\"y\":27}")
  run Testing.expect(ok(&picked) && nodeId(&picked) != -1, "pick finds a node under New")

  let missing = run ask(&mut protocol, &mut tree, "{\"cmd\":\"inspect\",\"node\":999}")
  run Testing.expect(!ok(&missing) && same(text(&missing, "error"), "no node matches"), "no node")
  let unknown = run ask(&mut protocol, &mut tree, "{\"cmd\":\"fly\"}")
  run Testing.expect(!ok(&unknown) && same(text(&unknown, "error"), "unknown cmd"), "unknown cmd")
  let array = run ask(&mut protocol, &mut tree, "[1]")
  run Testing.expect(!ok(&array), "a request must be an object")

  let stats = run ask(&mut protocol, &mut tree, "{\"cmd\":\"stats\"}")
  run Testing.expect(ok(&stats) && int(&stats, "nodes") > 10, "stats count the nodes")
  let item = match roleNamed("listitem") {
    Option<Role>.Some { value } => value == Role.ListItem
    Option<Role>.None => false
  }
  run Testing.expect(item, "roles by ARIA name")
}

test effect fn readOnlyCommandsDescribeTheTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run readOnlyBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn decodePng(reply: &Value) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let encoded = String.utf8Bytes(text(reply, "png"))
  let length = match Base64.decodedLength(encoded) {
    Result<usize, Base64Error>.Success { value } => value
    Result<usize, Base64Error>.Failure { error } => 0
  }
  let mut bytes = run Bytes.zeroed(length)
  drop Base64.decodeInto(bytes.asMutSlice(), encoded)
  return move bytes
}

effect fn inputBody() -> ()
  ! AssertionError<'static> | TreeError | JsonError | ImageError | PngError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut protocol = Protocol.make()
  run protocol.afterFrame(&tree)

  // Screenshots: the frame, the frame with a highlight, one node.
  let plain = run ask(&mut protocol, &mut tree, "{\"cmd\":\"screenshot\"}")
  run Testing.expect(int(&plain, "width") == 720 && int(&plain, "height") == 880, "device size")
  let first = run png.decode(Bytes.asSlice(&run decodePng(&plain)))
  run Testing.expect(first.width() == 720, "a PNG of the frame")
  let lit = run ask(&mut protocol, &mut tree, "{\"cmd\":\"highlight\",\"nodes\":[20,999]}")
  run Testing.expect(ok(&lit) && protocol.repaint && protocol.highlighting(), "highlight on")
  let marked = run ask(&mut protocol, &mut tree, "{\"cmd\":\"screenshot\"}")
  let second = run png.decode(Bytes.asSlice(&run decodePng(&marked)))
  run Testing.expect(!sameBytes(first.data(), second.data()), "the highlight is in the screenshot")
  let node = run ask(&mut protocol, &mut tree, "{\"cmd\":\"screenshot\",\"node\":20}")
  run Testing.expect(int(&node, "node") == 20 && int(&node, "width") < 720, "a node crop")
  let off = run ask(&mut protocol, &mut tree, "{\"cmd\":\"highlight\",\"nodes\":[]}")
  run Testing.expect(ok(&off) && !protocol.highlighting(), "highlight off")

  // Click New by role and name: the tree queues a click on it.
  let clicked = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"click\",\"role\":\"button\",\"name\":\"New\"}",
  )
  run Testing.expect(ok(&clicked) && int(&clicked, "node") == 10, "click New")
  run Testing.expect(protocol.dispatched, "input waits for the app")
  let mut records = List<Event>.make()
  run tree.takeEvents(&mut records)
  let mut sawClick = false
  let values = records.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == EventKind.Click && values[i].target == fixtures.NEW_BUTTON {
      sawClick = true
    }
    i = i + 1
  }
  run Testing.expect(sawClick, "the app sees a click record on New")

  // Tab moves focus; scroll moves the list.
  let tabbed = run ask(&mut protocol, &mut tree, "{\"cmd\":\"press\",\"key\":\"Tab\"}")
  run Testing.expect(ok(&tabbed) && tree.focused != NONE, "Tab focuses something")
  let scrolled = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"scroll\",\"x\":340,\"y\":112,\"dy\":60}",
  )
  run Testing.expect(ok(&scrolled), "scroll the list")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run protocol.afterFrame(&tree)
  run Testing.expect(tree.scrollOffset(fixtures.INBOX_LIST).y == 60.0, "the list scrolled by 60")
  let typed = run ask(&mut protocol, &mut tree, "{\"cmd\":\"type\",\"text\":\"hé\\n\"}")
  run Testing.expect(int(&typed, "typed") == 3, "three characters, one of them Enter")
  let point = run ask(&mut protocol, &mut tree, "{\"cmd\":\"hover\",\"x\":5,\"y\":5}")
  run Testing.expect(ok(&point), "hover at a point")
  let nowhere = run ask(&mut protocol, &mut tree, "{\"cmd\":\"click\"}")
  run Testing.expect(!ok(&nowhere), "click needs a target or a point")

  // wait: holds now, does not hold yet, timed out.
  let there = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"wait\",\"role\":\"button\",\"name\":\"Archive\"}",
  )
  run Testing.expect(ok(&there) && nodeId(&there) == 20, "wait for a node that is there")
  let later = run ask(&mut protocol, &mut tree, "{\"cmd\":\"wait\",\"name\":\"nothing like it\"}")
  run Testing.expect(pending(&later), "wait for a node that is not there yet")
  let gone = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"wait\",\"name\":\"nothing like it\",\"gone\":true}",
  )
  run Testing.expect(ok(&gone), "wait for a node to be gone")
  let expired = run ask(
    &mut protocol,
    &mut tree,
    "{\"cmd\":\"wait\",\"name\":\"nothing like it\",\"timeout\":0}",
  )
  run Testing.expect(same(text(&expired, "error"), "timed out"), "wait times out")
}

test effect fn inputCommandsDriveTheTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | ImageError
    | PngError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inputBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn addressBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  match run parseAddress("tcp:4100") {
    Option<Address>.Some { value } => {
      run describeAddress(&value, &mut text)
    }
    Option<Address>.None => {}
  }
  run Testing.expect(same(String.view(&text), "tcp:127.0.0.1:4100"), "tcp addresses")
  text.clear()
  match run parseAddress("1") {
    Option<Address>.Some { value } => {
      run describeAddress(&value, &mut text)
    }
    Option<Address>.None => {}
  }
  run Testing.expect(same(String.view(&text), "unix:silk-ui-inspect.sock"), "the default")
  let bad = match run parseAddress("tcp:http") {
    Option<Address>.Some { value } => false
    Option<Address>.None => true
  }
  run Testing.expect(bad, "a tcp port must be a number")
  run Testing.expect(!Inspector.off().enabled(), "off by default")
}

test effect fn addressesParse() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run addressBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Over a socket.

const SOCKET: string = "/tmp/ui-inspect-server-test.sock"

effect fn send(line: string) -> Connection
  ! NativeSocketError | ByteIoError
  ? &mut MonotonicClock {
  let start = run MonotonicClock.now()
  let mut c = run connectUnixOwned(
    String.utf8Bytes(SOCKET),
    ConnectOptions.defaults(),
    Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
  )
  let bytes = String.utf8Bytes(line)
  drop run ByteDuplex.writeSome(
    bytes,
    Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
  )
    |> Effect.provideMut<ByteDuplex>(&mut c)
  return move c
}

effect fn receive(c: &mut Connection) -> Value
  ! ByteIoError | JsonError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  let start = run MonotonicClock.now()
  let mut all = Bytes.make()
  let mut chunk: [u8; 4096] = [0; 4096]
  while true {
    match run ByteDuplex.readSome(
      &mut chunk,
      Option<Instant>.some(MonotonicClock.deadlineAfter(&start, 2000000000)),
    )
      |> Effect.provideMut<ByteDuplex>(&mut c.*) {
      ReadTransfer.Data { count } => {
        run all.append(Slice.view(&chunk, 0, count))
      }
      ReadTransfer.End => {
        break
      }
    }
  }
  let reply = run Json.parse(all.asSlice())
  return move reply
}

effect fn socketBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | FileError
    | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  let collection = run fixtures.fonts()
  let mut tree = run inbox(&collection)
  let mut inspector = run Inspector.listenAt(Address.Unix { path: run String.copy(SOCKET) }, false)
  run Testing.expect(inspector.enabled(), "listening")
  run Testing.expect(!run inspector.poll(&mut tree), "nothing to serve yet")

  let mut a = run send("{\"id\":1,\"cmd\":\"hello\"}\n")
  run Testing.expect(!run inspector.poll(&mut tree), "hello changes nothing")
  let hello = run receive(&mut a)
  run Testing.expect(ok(&hello) && int(&hello, "protocol") == 1, "hello over the socket")

  // A click, then a query sent before the app drew a frame: the query waits for the frame.
  let mut b = run send("{\"id\":2,\"cmd\":\"click\",\"node\":10}\n")
  let mut c = run send("{\"id\":3,\"cmd\":\"query\",\"role\":\"button\"}\n")
  run Testing.expect(run inspector.poll(&mut tree), "a click is work for the app")
  run Testing.expect(inspector.served == 2, "one request served")
  run Testing.expect(!run inspector.poll(&mut tree), "the next waits for a frame")
  run Testing.expect(inspector.served == 2, "still one")
  let click = run receive(&mut b)
  run Testing.expect(ok(&click) && int(&click, "id") == 2, "the click reply")
  run tree.frame(FrameInput { width: 360.0, height: 440.0, scale: 2.0, time: 0.1 })
  run inspector.afterFrame(&tree)
  drop run inspector.poll(&mut tree)
  let query = run receive(&mut c)
  run Testing.expect(int(&query, "id") == 3 && int(&query, "count") == 3, "served after it")

  // A wait that does not hold yet answers pending; bad JSON is an error.
  let mut d = run send("{\"cmd\":\"wait\",\"name\":\"never\"}\n")
  drop run inspector.poll(&mut tree)
  let wait = run receive(&mut d)
  run Testing.expect(pending(&wait), "pending over the socket")
  let mut e = run send("{oops\n")
  drop run inspector.poll(&mut tree)
  let bad = run receive(&mut e)
  run Testing.expect(!ok(&bad), "bad JSON")

  run inspector.close()
  let mut files = run MachineFileSystem.make()
  let path = run Path.make(SOCKET)

  // exists() fails with WrongType on a socket file, so a clean answer means it is gone.
  let left = run Effect.result(
    FileSystem.exists(&path) |> Effect.provideMut<FileSystem>(&mut files),
  )
  let gone = match move left {
    Result<bool, FileError>.Success { value } => !value
    Result<bool, FileError>.Failure { error } => false
  }
  run Testing.expect(gone, "close removes the socket file")
}

test effect fn requestsOverAUnixSocket() -> ()
  ! AssertionError<'static>
    | TreeError
    | JsonError
    | NativeSocketError
    | ByteIoError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  // std has no Unix sockets on Windows; the protocol itself is covered above.
  static if Intrinsic.targetOperatingSystem() != "windows" {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut clock = OsMonotonicClock.make()
    run socketBody()
      |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<MonotonicClock>(&mut clock)
  }
}
