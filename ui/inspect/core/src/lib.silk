//! The inspector core for ui-tree: find nodes (by id, role, accessible name, label, text and
//! test id, or by position), highlight them with a devtools-style box model overlay, view a
//! node's attributes, states, box model and styles, drive the tree with synthetic input, and
//! record sessions that replay to the same tree.
pub import query {
  Query,
  textMatches,
  textContent,
  accessibleName,
  visible,
  matches,
  queryAll,
  queryFirst,
  hitPath,
  pick
}
pub import overlay { BoxModel, HighlightColors, Highlight, boxModels, paintHighlight, compose }
pub import view { InspectOptions, inspectNode, writeProperty, computedProperties, cursorName }
pub import session {
  Step,
  Session,
  ReplayReport,
  copyMutation,
  copyBatch,
  copyAttribute,
  copyInput,
  copyEvent,
  sameEvent
}
pub import synth { pointOf, click, hover, wheel, press, tab, dispatchAll }
