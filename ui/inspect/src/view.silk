    TextWrap.Wrap => "wrap"
    TextWrap.NoWrap => "nowrap"
  }
}

fn whiteSpaceCollapseName(value: WhiteSpaceCollapse) -> string<'static> {
  return match value {
    WhiteSpaceCollapse.Collapse => "collapse"
    WhiteSpaceCollapse.Discard => "discard"
    WhiteSpaceCollapse.Preserve => "preserve"
    WhiteSpaceCollapse.PreserveBreaks => "preserve-breaks"
    WhiteSpaceCollapse.PreserveSpaces => "preserve-spaces"
    WhiteSpaceCollapse.BreakSpaces => "break-spaces"
  }
}

fn textJustifyName(value: TextJustify) -> string<'static> {
  return match value {
    TextJustify.Auto => "auto"
    TextJustify.None => "none"
    TextJustify.InterWord => "inter-word"
    TextJustify.InterCharacter => "inter-character"
  }
}

fn boxDecorationBreakName(value: BoxDecorationBreak) -> string<'static> {
  return match value {
    BoxDecorationBreak.Slice => "slice"
    BoxDecorationBreak.Clone => "clone"
  }
}

fn marginBreakName(value: MarginBreak) -> string<'static> {
  return match value {
    MarginBreak.Auto => "auto"
    MarginBreak.Keep => "keep"
    MarginBreak.Discard => "discard"
  }
}

fn breakBetweenName(value: BreakBetween) -> string<'static> {
  return match value {
    BreakBetween.Auto => "auto"
    BreakBetween.Avoid => "avoid"
    BreakBetween.Always => "always"
    BreakBetween.All => "all"
    BreakBetween.AvoidPage => "avoid-page"
    BreakBetween.Page => "page"
    BreakBetween.Left => "left"
    BreakBetween.Right => "right"
    BreakBetween.Recto => "recto"
    BreakBetween.Verso => "verso"
    BreakBetween.AvoidColumn => "avoid-column"
    BreakBetween.Column => "column"
    BreakBetween.AvoidRegion => "avoid-region"
    BreakBetween.Region => "region"
  }
}

fn breakInsideName(value: BreakInside) -> string<'static> {
  return match value {
    BreakInside.Auto => "auto"
    BreakInside.Avoid => "avoid"
    BreakInside.AvoidPage => "avoid-page"
    BreakInside.AvoidColumn => "avoid-column"
    BreakInside.AvoidRegion => "avoid-region"
  }
}

fn overflowAlignmentName(value: OverflowAlignment) -> string<'static> {
  return match value {
    OverflowAlignment.Default => "default"
    OverflowAlignment.Safe => "safe"
    OverflowAlignment.Unsafe => "unsafe"
  }
}

fn scrollbarWidthName(value: ScrollbarWidth) -> string<'static> {
  return match value {
    ScrollbarWidth.Auto => "auto"
    ScrollbarWidth.Thin => "thin"
    ScrollbarWidth.None => "none"
