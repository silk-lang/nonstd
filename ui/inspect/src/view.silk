    LayoutTextAlign.Auto => "auto"
    LayoutTextAlign.Start => "start"
    LayoutTextAlign.End => "end"
    LayoutTextAlign.Left => "left"
    LayoutTextAlign.Right => "right"
    LayoutTextAlign.Center => "center"
    LayoutTextAlign.Justify => "justify"
  }
}

fn textWrapName(value: TextWrap) -> string<'static> {
