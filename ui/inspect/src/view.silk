  return match value {
    WritingMode.HorizontalTb => "horizontal-tb"
    WritingMode.VerticalRl => "vertical-rl"
    WritingMode.VerticalLr => "vertical-lr"
    WritingMode.SidewaysRl => "sideways-rl"
    WritingMode.SidewaysLr => "sideways-lr"
