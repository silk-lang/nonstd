fn scrollbarGutterName(value: ScrollbarGutter) -> string<'static> {
  return match value {
    ScrollbarGutter.Auto => "auto"
    ScrollbarGutter.Stable => "stable"
    ScrollbarGutter.StableBothEdges => "stable-both-edges"
  }
}

fn floatName(value: Float) -> string<'static> {
  return match value {
    Float.None => "none"
    Float.Left => "left"
    Float.Right => "right"
  }
}

fn clearName(value: Clear) -> string<'static> {
  return match value {
    Clear.None => "none"
    Clear.Left => "left"
    Clear.Right => "right"
    Clear.Both => "both"
