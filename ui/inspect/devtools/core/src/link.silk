//! How the devtools reach the app they inspect: one request line out, one reply line back. The
//! window provides a link over the inspector socket; tests provide one that runs the protocol
//! against a tree in the same process.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// The connection to the inspected app.
pub service Link {
  /// Sends `line` (one JSON request, without the newline) and writes the reply line to `reply`.
  /// Returns false, with a reason in `reply`, when the app could not be reached.
  effect fn request(line: string, reply: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Link | &mut Allocator
}
