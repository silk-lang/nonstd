#!/usr/bin/env python3
"""Build the devtools window and run it against a Silk UI app, or run its exit test.

  ui/inspect/devtools/scripts/devtools [--connect ADDRESS]    the window (debug build)
  ui/inspect/devtools/scripts/devtools todo                     the todo demo and the window on it
  ui/inspect/devtools/scripts/devtools check                    the exit test

The app to inspect must be a debug build started with SILK_UI_INSPECT set; ADDRESS is in the same
syntax (default `1`: silk-ui-inspect.sock in the working directory). `todo` builds ui/app/demo,
starts it serving the inspector on .cache/ui-devtools/todo.sock and opens the devtools on it.

`check` is the devtools' exit test. It starts the todo demo (serving the inspector) and the
devtools window connected to it, both under Xvfb on Linux. The devtools window is a ui-app app, so
it serves the inspector too, on its own socket, and ui-inspect-cli drives it like a user would:
it waits for the todo app's element tree, clicks the row of the Add button, checks that the todo
app now highlights that button and that the styles panel shows its declarations, opens the box
model tab, clicks Add in the todo app and finds the click in the devtools' event log. Screenshots
of both windows are left in .cache/ui-devtools/.

Needs what ui/app/demo/scripts/demo needs (Linux: libx11-dev libxkbcommon-dev libwayland-dev,
plus xvfb for `check`).
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
REPO = ROOT.parents[2]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402

LAVAPIPE = Path("/usr/share/vulkan/icd.d/lvp_icd.json")
WORK = REPO / ".cache/ui-devtools"


def environment():
    env = dict(os.environ)
    env.pop("SILK_UI_INSPECT", None)
    env.pop("SILK_WINDOW_FIBER", None)
    if sys.platform.startswith("linux"):
        if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
            env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
        env["SILK_WINDOW_SCALE"] = env.get("SILK_WINDOW_SCALE", "1")
    return env


class Display:
    """Xvfb on Linux when there is no display; nothing elsewhere."""

    def __init__(self, env):
        self.env = env
        self.server = None

    def __enter__(self):
        xvfb = shutil.which("Xvfb")
        if sys.platform.startswith("linux") and xvfb and not self.env.get("DISPLAY"):
            number = next(n for n in range(90, 140) if not Path(f"/tmp/.X11-unix/X{n}").exists()
                          and not Path(f"/tmp/.X{n}-lock").exists())
            self.server = subprocess.Popen([xvfb, f":{number}", "-screen", "0", "1600x900x24", "-nolisten", "tcp"],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.env["DISPLAY"] = f":{number}"
            self.env["SILK_WINDOW_BACKEND"] = "x11"
            self.env.pop("WAYLAND_DISPLAY", None)
            deadline = time.monotonic() + 10
            while not Path(f"/tmp/.X11-unix/X{number}").exists():
                if time.monotonic() > deadline:
                    raise SystemExit("Xvfb did not start")
                time.sleep(0.05)
        return self

    def __exit__(self, *exc):
        if self.server:
            self.server.terminate()
            self.server.wait()
        return False


class Program:
    """A program serving the inspector at `socket`, stopped on exit."""

    def __init__(self, name, args, socket, env, cli):
        self.name = name
        self.args = args
        self.socket = socket
        self.env = dict(env, SILK_UI_INSPECT=str(socket))
        self.cli = cli
        self.process = None

    def __enter__(self):
        self.socket.unlink(missing_ok=True)
        self.process = subprocess.Popen(self.args, cwd=REPO, env=self.env)
        deadline = time.monotonic() + 120
        while True:
            hello = self.run("hello", quiet=True)
            if hello.returncode == 0:
                print(f"{self.name}: {hello.stdout.strip()}", flush=True)
                return self
            if self.process.poll() is not None or time.monotonic() > deadline:
                print(hello.stderr, flush=True)
                self.__exit__(None, None, None)
                raise SystemExit(f"{self.name} did not start serving the inspector (exit {self.process.poll()})")
            time.sleep(0.2)

    def __exit__(self, *exc):
        if self.process and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.process.kill()
        return False

    def run(self, *args, quiet=False, timeout=60):
        result = subprocess.run([str(self.cli), "--connect", str(self.socket), *args], cwd=REPO, env=self.env,
                                capture_output=True, text=True, timeout=timeout)
        if not quiet:
            print(f"$ ui-inspect-cli ({self.name}) {' '.join(args)}  -> {result.returncode}", flush=True)
            if result.stderr.strip():
                print(result.stderr.strip(), flush=True)
        return result


class Checks:
    def __init__(self):
        self.failures = []

    def expect(self, condition, what):
        print(("ok   " if condition else "FAIL ") + what, flush=True)
        if not condition:
            self.failures.append(what)


def reply(result):
    try:
        return json.loads(result.stdout)
    except ValueError:
        return {}


def check():
    WORK.mkdir(parents=True, exist_ok=True)
    todo = build(REPO / "ui/app/demo", release=False)
    devtools = build(ROOT / "app", release=False)
    cli = build(REPO / "ui/inspect/cli", release=False)
    shots = [WORK / "devtools.png", WORK / "todo.png"]
    for shot in shots:
        shot.unlink(missing_ok=True)
    checks = Checks()
    expect = checks.expect
    env = environment()
    with Display(env):
        app_socket = WORK / "todo.sock"
        with Program("todo", [str(todo)], app_socket, env, cli) as app, \
                Program("devtools", [str(devtools), "--connect", str(app_socket)], WORK / "devtools.sock", env,
                        cli) as tools:
            found = reply(app.run("query", "--role", "button", "--name", "Add", "--exact"))
            nodes = found.get("nodes", [])
            expect(len(nodes) == 1, "the todo app has an Add button")
            add = nodes[0]["id"] if nodes else 0
            row = f"element-{add}"

            # The devtools read the todo app's tree on their own (live refresh).
            waited = tools.run("wait", "--test-id", row, "--timeout", "20000")
            expect(waited.returncode == 0, "the devtools list the Add button's element")
            snap = tools.run("snapshot")
            expect('label="button \\"Add\\""' in snap.stdout, "its row is labelled by role and name")
            expect("cannot reach" not in snap.stdout, "the status line shows no error")

            # Selecting the row highlights the button in the todo app and shows its styles.
            click = tools.run("click", "--test-id", row)
            expect(click.returncode == 0, "click the row in the devtools window")
            lit = []
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                lit = reply(app.run("hello", quiet=True)).get("highlight", [])
                if lit == [add]:
                    break
                time.sleep(0.1)
            expect(lit == [add], f"the todo app highlights the Add button (highlight {lit})")
            title = tools.run("wait", "--test-id", "detail-title", "--timeout", "10000")
            expect(title.returncode == 0, "the styles panel shows the node")
            styles = tools.run("snapshot", "--node", str(reply(title).get("node", {}).get("id", 0)))
            expect('"button \\"Add\\""' in styles.stdout, "titled button \"Add\"")
            panel = tools.run("snapshot", "--test-id", "panel")
            expect('"  padding-left"' in panel.stdout and '": 10px;"' in panel.stdout,
                   "with the declarations of its look (padding-left: 10px)")

            # The box model tab.
            tab = tools.run("click", "--role", "button", "--name", "Box model", "--exact")
            expect(tab.returncode == 0, "open the box model tab")
            content = tools.run("wait", "--test-id", "content", "--timeout", "10000")
            expect(content.returncode == 0, "the box model is drawn")
            boxes = tools.run("snapshot", "--test-id", "box-model")
            expect('testId="padding"' in boxes.stdout and '"10"' in boxes.stdout,
                   "with the padding widths")

            # Input to the todo app shows in the devtools' event log.
            added = app.run("click", "--role", "button", "--name", "Add", "--exact")
            expect(added.returncode == 0, "click Add in the todo app")
            events = tools.run("click", "--role", "button", "--name", "Events", "--exact")
            expect(events.returncode == 0, "open the events tab")
            logged = tools.run("wait", "--test-id", "event-log", "--timeout", "10000")
            expect(logged.returncode == 0, "the event log has records")
            log = tools.run("snapshot", "--test-id", "event-log")
            expect('"click"' in log.stdout and '"button \\"Add\\""' in log.stdout,
                   "the click on Add is in the log")
            task = tools.run("wait", "--text", "Task 4", "--timeout", "10000")
            expect(task.returncode == 0, "the element tree shows the new item")

            shot = tools.run("screenshot", str(shots[0]))
            expect(shot.returncode == 0 and shots[0].read_bytes()[:4] == b"\x89PNG", "screenshot of the devtools")
            shot = app.run("screenshot", str(shots[1]))
            expect(shot.returncode == 0 and shots[1].read_bytes()[:4] == b"\x89PNG",
                   "screenshot of the todo app with the highlight")
    if checks.failures:
        print(f"{len(checks.failures)} devtools check(s) failed", flush=True)
        return 1
    print(f"devtools checks passed; screenshots in {WORK}", flush=True)
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("mode", nargs="?", choices=["run", "todo", "check"], default="run")
    parser.add_argument("--connect", default=None, help="the app's inspector address")
    parser.add_argument("--build-only", action="store_true")
    args = parser.parse_args()
    if args.mode == "check":
        return check()
    devtools = build(ROOT / "app", release=False)
    if args.build_only:
        print(devtools)
        return 0
    env = dict(os.environ)
    if args.mode == "todo":
        WORK.mkdir(parents=True, exist_ok=True)
        socket = WORK / "todo.sock"
        socket.unlink(missing_ok=True)
        todo = build(REPO / "ui/app/demo", release=False)
        app = subprocess.Popen([str(todo)], cwd=REPO, env=dict(env, SILK_UI_INSPECT=str(socket)))
        try:
            env.pop("SILK_UI_INSPECT", None)
            return subprocess.run([str(devtools), "--connect", str(socket)], cwd=REPO, env=env).returncode
        finally:
            app.terminate()
    command = [str(devtools)] + (["--connect", args.connect] if args.connect else [])
    return subprocess.run(command, cwd=REPO, env=env).returncode


if __name__ == "__main__":
    raise SystemExit(main())
