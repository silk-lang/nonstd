//! The fonts and icon the showcase draws with, and the mutations that define them.
//!
//! Noto Sans regular and bold come from graphics/demo's embedded subsets; Noto Sans Black and
//! Light, Noto Mono and a 12 emoji subset of Twemoji (COLRv0 color glyphs) are this package's.
import generated_assets as embedded
import demo.assets as demoAssets
import ui_tree.lib { Batch }
import font_collection.lib { FontCollection }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The UI font family: Noto Sans in every weight, with Twemoji for the emoji.
pub const SANS: u32 = 1

/// The monospace family for the status line.
pub const MONO: u32 = 2

/// The animated loom icon (SMIL rotate and a pulsing core).
pub const LOOM_ICON: u32 = 1

effect fn copy(data: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes = Bytes.make()
  run Bytes.append(&mut bytes, data)
  return move bytes
}

/// Every face the showcase uses.
pub effect fn fonts() -> FontCollection
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut collection = FontCollection.make()
  drop run collection.add(run copy(demoAssets.regularFont()))
  drop run collection.add(run copy(demoAssets.boldFont()))
  drop run collection.add(run copy(embedded.fontsNotoSansBlackSubset()))
  drop run collection.add(run copy(embedded.fontsNotoSansLightSubset()))
  drop run collection.add(run copy(embedded.fontsNotoMonoRegularSubset()))
  drop run collection.add(run copy(embedded.fontsTwemojiShowcaseSubset()))
  return move collection
}

/// The font families and the icon, as mutations for the tree.
pub effect fn resources(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.fontFamily(SANS, "Noto Sans, Twemoji Mozilla, sans-serif")
  run batch.fontFamily(MONO, "Noto Mono, Twemoji Mozilla, monospace")
  run batch.icon(LOOM_ICON, embedded.iconsLoom())
}
