#!/usr/bin/env python3
"""Record Silk Loom without a window: build ui-showcase-record, render every frame on the CPU
and encode them with ffmpeg.

  ui/showcase/scripts/record [--out build/showcase] [--width 1280] [--height 720]
                             [--scale 1.5] [--fps 30] [--seconds 13] [--stills 2.2,5.8,7.6,10.4]
                             [--gif-width 600] [--frames-only]

Writes silk-loom.mp4 (H.264), silk-loom.gif and silk-loom-<seconds>s.png stills into --out.
`--frames-only` skips ffmpeg and checks that the frames render (CI uses it with a short run).
Needs ffmpeg and Pillow unless --frames-only is given.
"""
import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REPO = ROOT.parents[1]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", default="build/showcase")
    parser.add_argument("--width", type=int, default=1280)
    parser.add_argument("--height", type=int, default=720)
    parser.add_argument("--scale", type=float, default=1.5)
    parser.add_argument("--fps", type=int, default=30)
    parser.add_argument("--seconds", type=float, default=13.0)
    parser.add_argument("--stills", default="2.2,5.8,7.6,10.4")
    parser.add_argument("--gif-width", type=int, default=600)
    parser.add_argument("--frames-only", action="store_true")
    parser.add_argument("--debug", action="store_true", help="build without --release")
    args = parser.parse_args()

    program = build(ROOT / "record", release=not args.debug)
    out = (REPO / args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    width = int(args.width * args.scale + 0.5)
    height = int(args.height * args.scale + 0.5)
    frames = int(round(args.seconds * args.fps))
    size = width * height * 4
    stills = {int(round(float(t) * args.fps)): t for t in args.stills.split(",") if t}

    recorder = subprocess.Popen(
        [str(program), str(args.width), str(args.height), str(args.scale), str(args.fps), str(frames)],
        cwd=REPO,
        stdout=subprocess.PIPE,
    )
    encoder = None
    video = out / "silk-loom.mp4"
    if not args.frames_only:
        from PIL import Image  # noqa: F401
        encoder = subprocess.Popen(
            ["ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgba",
             "-s", f"{width}x{height}", "-r", str(args.fps), "-i", "-",
             "-c:v", "libx264", "-preset", "slow", "-crf", "16", "-pix_fmt", "yuv420p",
             "-movflags", "+faststart", str(video)],
            stdin=subprocess.PIPE,
        )
    count = 0
    while True:
        frame = recorder.stdout.read(size)
        if len(frame) < size:
            break
        if encoder:
            encoder.stdin.write(frame)
            if count in stills:
                from PIL import Image
                image = Image.frombytes("RGBA", (width, height), frame).convert("RGB")
                image.save(out / f"silk-loom-{stills[count]}s.png")
        count += 1
    status = recorder.wait()
    if encoder:
        encoder.stdin.close()
        status = status or encoder.wait()
    if status != 0 or count != frames:
        print(f"record: {count} of {frames} frames, exit status {status}", file=sys.stderr)
        return 1
    print(f"record: {count} frames at {width}x{height}")
    if encoder:
        gif = out / "silk-loom.gif"
        # 15 fps, 160 colors and an ordered dither keep 13 seconds under 15 MB (the X/Twitter GIF limit).
        filters = (f"fps=15,scale={args.gif_width}:-1:flags=lanczos,split[a][b];"
                   "[a]palettegen=max_colors=160:stats_mode=diff[p];"
                   "[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle")
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(video), "-vf", filters,
                        "-loop", "0", str(gif)], check=True)
        print(f"record: wrote {video}, {gif} and {len(stills)} stills")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
