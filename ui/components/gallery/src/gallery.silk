//! The gallery: one app with every component, its state in one model. The tests drive it
//! through the tree like a user (`ui/components/tests`), and `ui/components/demo` runs it in a
//! window.
import ui_components.lib {
  Theme,
  Tone,
  SliderRange,
  MenuState,
  MenuMessage,
  Disclosure,
  NO_SELECTION,
  surface,
  card,
  heading,
  caption,
  paragraph,
  spacer,
  divider,
  scrollView,
  button,
  primaryButton,
  buttonWith,
  buttonLook,
  checkbox,
  checkboxWith,
  switch,
  slider,
  textField,
  textArea,
  list,
  selectList,
  virtualList,
  tabs,
  menu,
  select,
  dialog,
  dialogButton,
  popover,
  tooltip
}
import ui_app.app { App, Context, NoCommand }
import ui_app.ui { Ui, textKey }
import ui_tree.mutation { Property, Length, Align, FlexWrap }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The font family id the gallery defines (`Noto Sans, sans-serif`).
pub const SANS: u32 = 1

/// The list's items.
pub const FRUITS: [string<'static>; 5] = ["Apple", "Banana", "Cherry", "Grape", "Mango"]

/// The virtual list's row count.
pub const ROWS: usize = 10000

const COMMANDS: [string<'static>; 4] = ["New", "Open", "Save", "Close"]

const SIZES: [string<'static>; 3] = ["Small", "Medium", "Large"]

const TABS: [string<'static>; 3] = ["List", "Select", "Virtual"]

/// Tooltip and anchor keys.
const SAVE_TIP: u64 = 11

const SLIDER: u64 = 21

const FILE_MENU: u64 = 31

const SIZE_SELECT: u64 = 32

const INFO: u64 = 33

pub struct Gallery {
  pub theme: Theme,
  /// The last thing that happened, shown at the top.
  pub status: String,
  pub saves: u64,
  pub agree: bool,
  pub notify: bool,
  pub volume: f32,
  pub name: String,
  pub notes: String,
  pub submitted: String,
  pub fruit: usize,
  pub offset: f32,
  pub tab: usize,
  pub fileMenu: MenuState,
  pub command: usize,
  pub sizeMenu: MenuState,
  pub size: usize,
  pub confirm: Disclosure,
  pub deleted: u64,
  pub info: Disclosure,
  /// The key of the tooltip showing, or 0.
  pub tip: u64,
}

pub union Message {
  Save,
  Reset,
  Agree { pub value: bool },
  Notify { pub value: bool },
  Volume { pub value: f32 },
  Name { pub text: String },
  Notes { pub text: String },
  Submit,
  Fruit { pub index: usize },
  Scrolled { pub offset: f32 },
  Tab { pub index: usize },
  File { pub message: MenuMessage },
  Size { pub message: MenuMessage },
  AskDelete,
  CancelDelete,
  Delete,
  Info { pub open: bool },
  Tip { pub key: u64, pub show: bool },
}

fn fruitKey(name: &string) -> u64 {
  return textKey(name.*)
}

impl Gallery {
  pub fn make() -> Gallery {
    return Gallery {
      theme: Theme.light(SANS),
      status: String.make(),
      saves: 0,
      agree: false,
      notify: true,
      volume: 40.0,
      name: String.make(),
      notes: String.make(),
      submitted: String.make(),
      fruit: NO_SELECTION,
      offset: 0.0,
      tab: 0,
      fileMenu: MenuState.make(),
      command: usize.MAX,
      sizeMenu: MenuState.make(),
      size: 1,
      confirm: Disclosure.make(),
      deleted: 0,
      info: Disclosure.make(),
      tip: 0,
    }
  }

  fn say(self: &mut Self, cx: &mut Context<NoCommand>, text: string) -> () {
    self.status = cx.copy(text)
  }
}

impl App<Message, NoCommand> for Gallery {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    let theme = self.theme
    surface(&mut ui, &theme)
    ui.padding(16.0)
    ui.gap(12.0)
    ui.row(
      |ui| {
        ui.gap(12.0)
        ui.style(&[Property.AlignItems { value: Align.Center }])
        heading(&mut ui, &theme, 1, "Components")
        spacer(&mut ui)
        ui.box(
          |ui| {
            ui.testId("status")
            ui.color(theme.mutedText)
            ui.text(String.view(&self.status))
          },
        )
      },
    )
    ui.row(
      |ui| {
        ui.gap(12.0)
        ui.style(&[Property.AlignItems { value: Align.Start }])
        ui.column(
          |ui| {
            ui.gap(12.0)
            ui.style(&[Property.FlexBasis { value: Length.px(0.0) }])
            ui.grow(1.0)
            self.buttons(&mut ui, &theme)
            self.choices(&mut ui, &theme)
            self.fields(&mut ui, &theme)
          },
        )
        ui.column(
          |ui| {
            ui.gap(12.0)
            ui.style(&[Property.FlexBasis { value: Length.px(0.0) }])
            ui.grow(1.0)
            self.popups(&mut ui, &theme)
            self.lists(&mut ui, &theme)
          },
        )
      },
    )
    dialog(
      &mut ui,
      &theme,
      &self.confirm,
      "Delete the draft?",
      || Message.CancelDelete,
      |ui| {
        paragraph(&mut ui, "The name and notes you typed will be cleared.")
        ui.row(
          |ui| {
            ui.gap(8.0)
            ui.style(&[Property.JustifyContent { value: Align.End }])
            ui.pressable(
              || Message.CancelDelete,
              |ui| {
                buttonLook(&mut ui, &theme, Tone.Secondary, false)
                ui.takeFocus()
                ui.text("Cancel")
              },
            )
            buttonWith(&mut ui, &theme, Tone.Danger, false, "Delete", || Message.Delete)
          },
        )
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Save => {
        self.saves = self.saves + 1
        self.say(&mut cx, "Saved")
      }
      Message.Reset => {
        self.saves = 0
        self.say(&mut cx, "Reset")
      }
      Message.Agree { value } => {
        self.agree = value
      }
      Message.Notify { value } => {
        self.notify = value
      }
      Message.Volume { value } => {
        self.volume = value
      }
      Message.Name { text } => {
        self.name = move text
      }
      Message.Notes { text } => {
        self.notes = move text
      }
      Message.Submit => {
        self.submitted = cx.copy(String.view(&self.name))
        self.say(&mut cx, "Submitted")
      }
      Message.Fruit { index } => {
        self.fruit = index
      }
      Message.Scrolled { offset } => {
        self.offset = offset
      }
      Message.Tab { index } => {
        self.tab = index
      }
      Message.File { message: menuMessage } => {
        if let Option<usize>.Some { value } = self.fileMenu.update(menuMessage) {
          self.command = value
          self.say(&mut cx, COMMANDS[value])
        }
      }
      Message.Size { message: menuMessage } => {
        if let Option<usize>.Some { value } = self.sizeMenu.update(menuMessage) {
          self.size = value
        }
      }
      Message.AskDelete => {
        self.confirm.show()
      }
      Message.CancelDelete => {
        self.confirm.hide()
      }
      Message.Delete => {
        self.confirm.hide()
        self.deleted = self.deleted + 1
        self.name = String.make()
        self.notes = String.make()
        self.say(&mut cx, "Deleted")
      }
      Message.Info { open } => {
        self.info.set(open)
      }
      Message.Tip { key, show } => {
        if show {
          self.tip = key
        } else if self.tip == key {
          self.tip = 0
        }
      }
    }
  }
}

impl Gallery {
  fn buttons(self: &Self, ui: &mut Ui<Message>, theme: &Theme) -> () {
    let tip = self.tip
    card(
      &mut ui,
      &theme,
      |ui| {
        heading(&mut ui, &theme, 2, "Buttons")
        ui.row(
          |ui| {
            ui.gap(8.0)
            ui.style(&[Property.FlexWrap { value: FlexWrap.Wrap }])
            ui.pressable(
              || Message.Save,
              |ui| {
                buttonLook(&mut ui, &theme, Tone.Primary, false)
                tooltip(
                  &mut ui,
                  &theme,
                  SAVE_TIP,
                  tip == SAVE_TIP,
                  "Saves the draft",
                  |show| Message.Tip { key: SAVE_TIP, show: show },
                )
                ui.text("Save")
              },
            )
            button(&mut ui, &theme, "Reset", || Message.Reset)
            buttonWith(&mut ui, &theme, Tone.Ghost, false, "Ghost", || Message.Reset)
            buttonWith(&mut ui, &theme, Tone.Secondary, true, "Disabled", || Message.Reset)
          },
        )
        ui.box(
          |ui| {
            ui.testId("saves")
            ui.color(theme.mutedText)
            ui.text("Saved ")
            ui.number(u64.toI64(self.saves))
            ui.text(" times")
          },
        )
      },
    )
  }

  fn choices(self: &Self, ui: &mut Ui<Message>, theme: &Theme) -> () {
    card(
      &mut ui,
      &theme,
      |ui| {
        heading(&mut ui, &theme, 2, "Choices")
        checkbox(&mut ui, &theme, "I agree", self.agree, |value| Message.Agree { value: value })
        checkboxWith(&mut ui, &theme, "Locked", true, true, |value| Message.Agree { value: value })
        switch(
          &mut ui,
          &theme,
          "Notifications",
          self.notify,
          |value| Message.Notify { value: value },
        )
        slider(
          &mut ui,
          &theme,
          SLIDER,
          "Volume",
          self.volume,
          SliderRange { min: 0.0, max: 100.0, step: 5.0, places: 0 },
          |value| Message.Volume { value: value },
        )
      },
    )
  }

  fn fields(self: &Self, ui: &mut Ui<Message>, theme: &Theme) -> () {
    card(
      &mut ui,
      &theme,
      |ui| {
        heading(&mut ui, &theme, 2, "Text")
        textField(
          &mut ui,
          &theme,
          "Name",
          "Your name",
          String.view(&self.name),
          |text| Message.Name { text: move text },
          |ui| {
            ui.testId("name")
            ui.onEnter(|| Message.Submit)
          },
        )
        textArea(
          &mut ui,
          &theme,
          "Notes",
          "Anything else",
          String.view(&self.notes),
          3,
          |text| Message.Notes { text: move text },
          |ui| {
            ui.testId("notes")
          },
        )
        ui.row(
          |ui| {
            ui.gap(8.0)
            ui.style(&[Property.AlignItems { value: Align.Center }])
            dialogButton(
              &mut ui,
              &theme,
              &self.confirm,
              Tone.Danger,
              "Delete draft",
              || Message.AskDelete,
            )
            ui.box(
              |ui| {
                ui.testId("submitted")
                ui.color(theme.mutedText)
                if String.ownedByteLength(&self.submitted) != 0 {
                  ui.text("Hello, ")
                  ui.text(String.view(&self.submitted))
                }
              },
            )
          },
        )
      },
    )
  }

  fn popups(self: &Self, ui: &mut Ui<Message>, theme: &Theme) -> () {
    card(
      &mut ui,
      &theme,
      |ui| {
        heading(&mut ui, &theme, 2, "Menus and popups")
        ui.row(
          |ui| {
            ui.gap(8.0)
            ui.style(&[Property.AlignItems { value: Align.End }])
            menu(
              &mut ui,
              &theme,
              FILE_MENU,
              &self.fileMenu,
              "File",
              &COMMANDS,
              |message| Message.File { message: message },
            )
            select(
              &mut ui,
              &theme,
              SIZE_SELECT,
              &self.sizeMenu,
              "Size",
              &SIZES,
              self.size,
              |message| Message.Size { message: message },
            )
            popover(
              &mut ui,
              &theme,
              INFO,
              &self.info,
              "Info",
              |open| Message.Info { open: open },
              |ui| {
                ui.box(
                  |ui| {
                    ui.style(&[Property.FontWeight { value: 600.0 }])
                    ui.text("About this gallery")
                  },
                )
                caption(&mut ui, &theme, "Every component of ui-components.")
                button(&mut ui, &theme, "Close", || Message.Info { open: false })
              },
            )
          },
        )
      },
    )
  }

  fn lists(self: &Self, ui: &mut Ui<Message>, theme: &Theme) -> () {
    let fruit = self.fruit
    card(
      &mut ui,
      &theme,
      |ui| {
        tabs(
          &mut ui,
          &theme,
          "Lists",
          &TABS,
          self.tab,
          |index| Message.Tab { index: index },
          |ui, index| {
            if index == 0 {
              list(
                &mut ui,
                &theme,
                "Fruits",
                &FRUITS,
                fruitKey,
                |ui, name| {
                  ui.text(name.*)
                },
              )
            } else if index == 1 {
              selectList(
                &mut ui,
                &theme,
                "Pick a fruit",
                &FRUITS,
                fruitKey,
                fruit,
                |index| Message.Fruit { index: index },
                |ui, name, chosen| {
                  ui.text(name.*)
                },
              )
            } else {
              virtualList(
                &mut ui,
                &theme,
                "Rows",
                ROWS,
                28.0,
                196.0,
                self.offset,
                |offset| Message.Scrolled { offset: offset },
                |ui, row| {
                  ui.text("Row ")
                  ui.number(usize.toI64(row + 1))
                },
              )
            }
          },
        )
      },
    )
  }
}
