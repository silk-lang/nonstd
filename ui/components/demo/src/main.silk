//! The component gallery in a native window.
//!
//!   ui-components-demo [--check]
//!
//! Every ui-components component in one window: buttons with a tooltip, a checkbox, a switch, a
//! slider, a text field and area, a dialog, a menu, a select, a popover, tabs, a list, a select
//! list and a virtual list of ten thousand rows. Tab and Shift+Tab move focus, and every
//! component works from the keyboard.
//!
//! In a debug build with `SILK_UI_INSPECT` set it serves the inspector protocol, so the devtools
//! window (ui/inspect/devtools) and ui-inspect-cli can inspect and drive it.
//!
//! `--check` ignores real input: it clicks Save and presses Tab, then compares the window's
//! surface with the CPU reference of the same frame. Exit code 0 within tolerance, 1 outside,
//! 2 on an error.
import ui_gallery.lib { Gallery, Message, SANS }
import ui_app.app { NoCommand }
import ui_app.runtime { Runtime }
import ui_app_window.lib { RunOptions, runWindowWith }
import ui_inspect_server.lib { Inspector, InspectorOptions }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { TreeError, Batch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn checkMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), b"--check") {
        return true
      }
    }
    i = i + 1
  }
  return false
}

effect fn program() -> i32
  ! WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | HostInputError
  ? &mut HostInput | &mut Allocator {
  let check = run checkMode()
  let collection = run fixtures.fonts()
  let mut batch = Batch.make()
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  let options = RunOptions {
    title: "Components",
    width: 880.0,
    height: 680.0,
    check: check,
    checkClick: "Save",
    checkExpect: "Saved",
  }

  // Debug builds with SILK_UI_INSPECT set serve the inspector (ui/inspect/server), so
  // ui-inspect-cli, ui-inspect-mcp and the devtools window can look at the gallery.
  let inspector = run Inspector.start(InspectorOptions.make())
  return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("ui-components-demo: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("ui-components-demo: GPU error {}\n", &(error.code,))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-components-demo: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<GpuError>(Effect.catch<WindowError>(program(), windowFailed), gpuFailed),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
