//! View-builder adapter for tree-owned popup placement.
import ui_app.ui { Ui }
import ui_tree.anchoring { AnchorOptions }

/// Attaches the open popup to a view anchor. The tree owns collision handling and layout updates.
pub fn anchored<M>(
  ui: &mut Ui<M>,
  key: u64,
  gap: f32,
  preferredHeight: f32,
  alignEnd: bool,
  matchWidth: bool,
) -> () {
  ui.anchored(
    key,
    AnchorOptions {
      gap: gap,
      preferredHeight: preferredHeight,
      alignEnd: alignEnd,
      matchWidth: matchWidth,
    },
  )
}
