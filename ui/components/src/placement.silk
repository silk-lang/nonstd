//! Viewport-aware placement shared by menus, popovers and tooltips.
import ui_app.ui { Ui }
import ui_tree.mutation { Property, Position, Side, Length, Overflow, BoxSizing }
import silk.geometry.rect { Rect }
import silk.num.f32

/// Positions the open overlay beside an anchor. It flips above when the lower space cannot
/// hold `preferredHeight` and the upper space is larger, aligns to the nearer horizontal
/// edge, and constrains oversized content to the available viewport with scrolling.
pub fn anchored<M>(
  ui: &mut Ui<M>,
  anchor: Rect<f32>,
  gap: f32,
  preferredHeight: f32,
  alignEnd: bool,
) -> () {
  let viewport = ui.viewport()
  let width = f32.max(0.0, viewport.width())
  let height = f32.max(0.0, viewport.height())
  let left = f32.max(4.0, f32.min(width - 4.0, anchor.xMin))
  let right = f32.max(4.0, f32.min(width - 4.0, width - anchor.xMax))
  let above = f32.max(0.0, anchor.yMin - gap - 4.0)
  let below = f32.max(0.0, height - anchor.yMax - gap - 4.0)
  let up = below < preferredHeight && above > below
  let end = alignEnd || left > width * 0.5
  ui.style(
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset {
        side: if end {
          Side.Right
        } else {
          Side.Left
        },
        value: Length.px(
          if end {
            right
          } else {
            left
          },
        ),
      },
      Property.Inset {
        side: if up {
          Side.Bottom
        } else {
          Side.Top
        },
        value: Length.px(
          if up {
            f32.max(4.0, height - anchor.yMin + gap)
          } else {
            f32.max(4.0, anchor.yMax + gap)
          },
        ),
      },
      Property.MaxWidth {
        value: Length.px(
          f32.max(
            0.0,
            width
              - (if end {
                right
              } else {
                left
              })
              - 4.0,
          ),
        ),
      },
      Property.MaxHeight {
        value: Length.px(
          if up {
            above
          } else {
            below
          },
        ),
      },
      Property.BoxSizing { value: BoxSizing.BorderBox },
      Property.OverflowX { value: Overflow.Auto },
      Property.OverflowY { value: Overflow.Auto },
    ],
  )
}
