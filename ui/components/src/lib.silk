//! Components for ui-app views: buttons, checkboxes and switches, sliders, text fields, lists
//! and virtual lists, scroll views, tabs, menus and selects, dialogs, popovers and tooltips.
//!
//! Every component is a function generic over the app's message type `M`, so it costs what the
//! nodes it opens cost. State that a browser keeps in the element (focus, hover, scroll offset,
//! caret, selection) stays in the tree. State that is the app's (a checkbox's value, the
//! selected tab, whether a menu is open) is in the model: simple components take the value and
//! a message constructor, and the ones with more state (menus, selects, popovers, dialogs) have
//! a small state struct with its own message union and `update`, which the app keeps in its
//! model and wraps in one of its messages.
pub import theme { Theme, rgb, rgba, clear, corners, border, edges, surface, focusRing, raised }
pub import layout {
  spacer,
  divider,
  stack,
  layer,
  scrollView,
  card,
  heading,
  caption,
  paragraph,
  noWrap,
  pad
}
pub import button { Tone, buttonLook, button, primaryButton, buttonWith, buttonBox }
pub import choice { checkbox, checkboxWith, switch }
pub import slider { SliderRange, slider, snap, valueAt, keyValue }
pub import field { textField, textArea }
pub import list { NO_SELECTION, Window, list, selectList, virtualList, visibleRows, moveSelection }
pub import tabs { tabs, moveTab }
pub import menu { MenuState, MenuMessage, menu, select, selectControl, listKey }
pub import dialog { Disclosure, dialog, dialogButton, isEscape }
pub import popover { popover, tooltip }
pub import numeric { NumberOptions, NumberEvent, numberInput }
pub import color { colorPicker, withChannel }
