//! On and off choices: [`checkbox`] and [`switch`]. Each is one focusable row with the
//! control and its label, so clicking the label toggles it too; Space toggles the focused one.
//! The model owns the value: the view passes it in and `onChange(newValue)` comes back.
import theme { Theme, border, corners, focusRing }
import ui_app.ui { Ui }
import ui_tree.mutation { Property, Length, Side, Align, Role, Cursor, CanvasCommand, BoxSizing }
import silk.color.rgba { Rgba }

/// The check mark, drawn in a 16 pixel box.
fn checkMark(color: Rgba<f32>) -> [CanvasCommand; 4] {
  return [
    CanvasCommand.MoveTo { x: 3.5, y: 8.0 },
    CanvasCommand.LineTo { x: 6.5, y: 11.0 },
    CanvasCommand.LineTo { x: 12.5, y: 4.5 },
    CanvasCommand.Stroke { color: color, width: 2.0 },
  ]
}

/// The row a choice sits in: role, state, label, focus and the toggle on click.
fn choiceRow<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  accessRole: Role,
  label: string,
  value: bool,
  disabled: bool,
  onChange: fn(bool) -> M,
  control: fn(&mut Ui<M>) -> (),
) -> () {
  ui.row(
    |ui| {
      ui.accessRole(accessRole)
      ui.label(label)
      ui.checked(value)
      ui.disabled(disabled)
      ui.tabIndex(0)
      ui.cursor(
        if disabled {
          Cursor.NotAllowed
        } else {
          Cursor.Pointer
        },
      )
      ui.gap(8.0)
      ui.style(
        &[
          Property.AlignItems { value: Align.Center },
          Property.BorderRadius { value: corners(theme.radius) },
          Property.AlignSelf { value: Align.Start },
        ],
      )
      if disabled {
        ui.style(&[Property.Opacity { value: 0.5 }])
      }
      focusRing(&mut ui, &theme)
      ui.onClick(|| onChange(!value))
      control(&mut ui)
      ui.text(label)
    },
  )
}

/// A checkbox labeled `label`, checked when `checked`; a click or Space sends
/// `onChange(!checked)`.
pub fn checkbox<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  checked: bool,
  onChange: fn(bool) -> M,
) -> () {
  checkboxWith(&mut ui, &theme, label, checked, false, onChange)
}

/// A checkbox that can be `disabled`.
pub fn checkboxWith<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  checked: bool,
  disabled: bool,
  onChange: fn(bool) -> M,
) -> () {
  choiceRow(
    &mut ui,
    &theme,
    Role.Checkbox,
    label,
    checked,
    disabled,
    onChange,
    |ui| {
      let mark = checkMark(
        if checked {
          theme.accentText
        } else {
          theme.surface
        },
      )
      ui.canvas(
        &mark,
        |ui| {
          ui.style(
            &[
              Property.Width { value: Length.px(16.0) },
              Property.Height { value: Length.px(16.0) },
              Property.FlexShrink { value: 0.0 },
              Property.BoxSizing { value: BoxSizing.BorderBox },
            ],
          )
          if checked {
            border(&mut ui, 1.0, theme.accent, 4.0)
            ui.background(theme.accent)
          } else {
            border(&mut ui, 1.0, theme.strongBorder, 4.0)
            ui.background(theme.surface)
          }
        },
      )
    },
  )
}

/// A switch labeled `label`, on when `on`; a click or Space sends `onChange(!on)`.
pub fn switch<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  on: bool,
  onChange: fn(bool) -> M,
) -> () {
  choiceRow(
    &mut ui,
    &theme,
    Role.Switch,
    label,
    on,
    false,
    onChange,
    |ui| {
      ui.row(
        |ui| {
          ui.style(
            &[
              Property.Width { value: Length.px(34.0) },
              Property.Height { value: Length.px(20.0) },
              Property.FlexShrink { value: 0.0 },
              Property.AlignItems { value: Align.Center },
              Property.JustifyContent {
                value: if on {
                  Align.End
                } else {
                  Align.Start
                },
              },
              Property.Padding { side: Side.Left, value: Length.px(3.0) },
              Property.Padding { side: Side.Right, value: Length.px(3.0) },
              Property.BorderRadius { value: corners(10.0) },
            ],
          )
          ui.background(
            if on {
              theme.accent
            } else {
              theme.strongBorder
            },
          )
          ui.box(
            |ui| {
              ui.width(Length.px(14.0))
              ui.height(Length.px(14.0))
              ui.style(&[Property.BorderRadius { value: corners(7.0) }])
              ui.background(theme.surface)
            },
          )
        },
      )
    },
  )
}
