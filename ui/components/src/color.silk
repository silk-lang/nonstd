//! Reusable RGBA editing, with one controlled color value in 0xRRGGBBAA form.
import theme { Theme, border }
import slider { slider, SliderRange }
import ui_app.ui { Ui }
import ui_tree.mutation { Length }
import silk.color.rgba { Rgba }
import silk.num.u32
import silk.num.usize
import silk.num.f32

pub fn withChannel(color: u32, channel: u32, value: f32) -> u32 {
  if channel > 3 || !f32.isFinite(value) {
    return color
  }
  let shift = (3 - channel) * 8
  let byte = f32.toU32(f32.round(f32.max(0.0, f32.min(255.0, value))))
  return (color & u32.bitNot(u32.shiftLeft(255, shift))) | u32.shiftLeft(byte, shift)
}

/// A swatch and keyboard-accessible RGBA controls. `key` reserves four consecutive anchor ids.
/// Place this body in a dialog, popover or inspector; the containing app owns open/close state.
pub fn colorPicker<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  key: u64,
  value: u32,
  onChange: fn(u32) -> M,
) -> () {
  ui.column(
    |ui| {
      ui.gap(8.0)
      ui.box(
        |ui| {
          ui.height(Length.px(48.0))
          ui.background(
            Rgba<f32> {
              r: u32.toF32(u32.shiftRight(value, 24) & 255) / 255.0,
              g: u32.toF32(u32.shiftRight(value, 16) & 255) / 255.0,
              b: u32.toF32(u32.shiftRight(value, 8) & 255) / 255.0,
              a: u32.toF32(value & 255) / 255.0,
            },
          )
          border(&mut ui, 1.0, theme.border, theme.radius)
        },
      )
      let labels: [string; 4] = ["Red", "Green", "Blue", "Alpha"]
      let mut i: usize = 0
      while i < labels.length {
        let channel = usize.toU32(i)
        slider(
          &mut ui,
          theme,
          key + usize.toU64(i),
          labels[i],
          u32.toF32(u32.shiftRight(value, (3 - channel) * 8) & 255),
          SliderRange { min: 0.0, max: 255.0, step: 1.0, places: 0 },
          |next| onChange(withChannel(value, channel, next)),
        )
        i = i + 1
      }
    },
  )
}
