//! [`popover`]: a button that opens a panel next to it (non-modal), and [`tooltip`], a hint
//! next to a node while the pointer is over it or it has focus.
import theme { Theme, raised, padding2, corners }
import button { Tone, buttonLook }
import dialog { Disclosure, isEscape }
import ui_app.ui { Ui, Reply }
import ui_tree.mutation { Property, Length, Side, Position, Role, WhiteSpace }
import ui_tree.node { Event, EventKind }
import silk.core.option { Option }
import silk.geometry.rect { Rect }

fn rectOr(rect: Option<Rect<f32>>) -> Rect<f32> {
  return match rect {
    Option<Rect<f32>>.Some { value: r } => r
    Option<Rect<f32>>.None => Rect<f32>.new(0.0, 0.0, 0.0, 0.0)
  }
}

/// A button labeled `label` that opens a panel with `body` under it while `state.open`; `key`
/// names the button (unique in the view). The button, Escape in the panel and a press outside
/// send `onToggle(open)`; keep it with `state.set(open)`. The panel takes focus when it opens,
/// and the button takes it back when it closes.
pub fn popover<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  key: u64,
  state: &Disclosure,
  label: string,
  onToggle: fn(bool) -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  let open = state.open
  let back = !open && state.returnFocus
  ui.pressable(
    || onToggle(!open),
    |ui| {
      buttonLook(&mut ui, &theme, Tone.Secondary, false)
      ui.anchor(key)
      ui.expanded(open)
      if back {
        ui.takeFocus()
      }
      ui.text(label)
    },
  )
  if !open {
    return ()
  }
  let rect = rectOr(ui.anchorRect(key))
  ui.overlay(
    key,
    |ui| {
      ui.box(
        |ui| {
          ui.style(
            &[
              Property.Position { value: Position.Fixed },
              Property.Inset { side: Side.Top, value: Length.px(0.0) },
              Property.Inset { side: Side.Right, value: Length.px(0.0) },
              Property.Inset { side: Side.Bottom, value: Length.px(0.0) },
              Property.Inset { side: Side.Left, value: Length.px(0.0) },
            ],
          )
          ui.onPointerDown(|event| Reply<M>.EmitAndStop { message: onToggle(false) })

          // The panel is the backdrop's child, so it is drawn above it.
          ui.column(
            |ui| {
              ui.accessRole(Role.Dialog)
              ui.label(label)
              ui.tabIndex(-1)
              ui.takeFocus()
              ui.style(
                &[
                  Property.Position { value: Position.Absolute },
                  Property.Inset { side: Side.Left, value: Length.px(rect.xMin) },
                  Property.Inset { side: Side.Top, value: Length.px(rect.yMax + 6.0) },
                  Property.MinWidth { value: Length.px(180.0) },
                ],
              )
              raised(&mut ui, &theme)
              ui.padding(12.0)
              ui.gap(8.0)
              ui.onPointerDown(|event| Reply<M>.Stop)
              ui.onKeyDown(
                |event| if isEscape(event) {
                  Reply<M>.EmitAndStop { message: onToggle(false) }
                } else {
                  Reply<M>.Pass
                },
              )
              body(&mut ui)
            },
          )
        },
      )
    },
  )
}

/// Gives the open node a tooltip: `text` under it while `visible`. The node sends
/// `onShow(true)` when the pointer enters it or it takes focus, and `onShow(false)` when the
/// pointer leaves or focus goes; the model keeps which tooltip shows. `key` names the node
/// (unique in the view).
pub fn tooltip<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  key: u64,
  visible: bool,
  text: string,
  onShow: fn(bool) -> M,
) -> () {
  ui.anchor(key)
  ui.on(EventKind.PointerEnter, |event| Reply<M>.Emit { message: onShow(true) })
  ui.on(EventKind.PointerLeave, |event| Reply<M>.Emit { message: onShow(false) })
  ui.on(EventKind.Focus, |event| Reply<M>.Emit { message: onShow(true) })
  ui.on(EventKind.Blur, |event| Reply<M>.Emit { message: onShow(false) })
  if !visible {
    return ()
  }
  let rect = rectOr(ui.anchorRect(key))
  ui.overlay(
    key,
    |ui| {
      ui.box(
        |ui| {
          ui.accessRole(Role.Tooltip)
          ui.label(text)
          ui.style(
            &[
              Property.Position { value: Position.Absolute },
              Property.Inset { side: Side.Left, value: Length.px(rect.xMin) },
              Property.Inset { side: Side.Top, value: Length.px(rect.yMax + 6.0) },
              Property.PointerEvents { value: false },
              Property.WhiteSpace { value: WhiteSpace.NoWrap },
              Property.BorderRadius { value: corners(4.0) },
            ],
          )
          padding2(&mut ui, 4.0, 8.0)
          ui.background(theme.tooltip)
          ui.color(theme.tooltipText)
          ui.fontSize(theme.smallSize)
          ui.style(&[Property.FontFamily { family: theme.font }])
          ui.text(text)
        },
      )
    },
  )
}
