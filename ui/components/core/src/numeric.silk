//! Numeric editing preserves incomplete drafts and separates edits from committed numbers.
import ui_app.ui { Ui, Reply }
import ui_tree.mutation { Role }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64
import silk.num.u8

pub struct NumberOptions {
  pub min: f32,
  pub max: f32,
  pub step: f32
}

impl NumberOptions {
  pub fn defaults() -> NumberOptions {
    return NumberOptions { min: -f32.MAX, max: f32.MAX, step: 1.0 }
  }
}

pub union NumberEvent {
  Edit { pub value: String },
  Commit { pub value: f32 },
  Invalid,
  Cancel,
}

/// Parses a finite decimal, including signs, fractional values and scientific notation.
/// Empty or incomplete drafts, trailing garbage, NaN and infinity return None.
pub fn parse(value: string) -> Option<f32> {
  let bytes = String.utf8Bytes(String.trim(value))
  if bytes.length == 0 {
    return Option<f32>.None
  }
  let mut i: usize = 0
  let mut negative = false
  if bytes[i] == 43 || bytes[i] == 45 {
    negative = bytes[i] == 45
    i = i + 1
  }
  let mut number: f64 = 0.0
  let mut digits: usize = 0
  let mut fraction = false
  let mut scale: f64 = 1.0
  while i < bytes.length {
    let byte = bytes[i]
    if byte >= 48 && byte <= 57 {
      number = number * 10.0 + u8.toF64(byte - 48)
      if fraction {
        scale = scale * 10.0
      }
      digits = digits + 1
    } else if byte == 46 && !fraction {
      fraction = true
    } else {
      break
    }
    i = i + 1
  }
  if digits == 0 {
    return Option<f32>.None
  }
  number = number / scale
  if i < bytes.length && (bytes[i] == 101 || bytes[i] == 69) {
    i = i + 1
    let mut down = false
    if i < bytes.length && (bytes[i] == 43 || bytes[i] == 45) {
      down = bytes[i] == 45
      i = i + 1
    }
    let first = i
    let mut exponent: usize = 0
    while i < bytes.length && bytes[i] >= 48 && bytes[i] <= 57 {
      exponent = exponent * 10 + u8.toUsize(bytes[i] - 48)
      if exponent > 400 {
        return Option<f32>.None
      }
      i = i + 1
    }
    if i == first {
      return Option<f32>.None
    }
    let mut n: usize = 0
    while n < exponent {
      number = if down {
        number / 10.0
      } else {
        number * 10.0
      }
      n = n + 1
    }
  }
  if i != bytes.length || !f64.isFinite(number) || number > f32.toF64(f32.MAX) {
    return Option<f32>.None
  }
  return Option<f32>.some(
    f64.toF32(
      if negative {
        -number
      } else {
        number
      },
    ),
  )
}

pub fn commit(draft: string, options: &NumberOptions) -> NumberEvent {
  return match parse(draft) {
    Option<f32>.Some { value } => NumberEvent.Commit {
      value: f32.max(options.min, f32.min(options.max, value)),
    }
    Option<f32>.None => NumberEvent.Invalid
  }
}

/// A controlled numeric input. Feed Edit drafts back unchanged; format the model after Commit.
/// Enter/blur commit a clamped value. Arrows step, Shift multiplies the step by ten, Escape
/// cancels. Invalid drafts stay editable and report Invalid. `body` supplies the app's styling.
pub fn numberInput<M>(
  ui: &mut Ui<M>,
  label: string,
  draft: string,
  options: &NumberOptions,
  onEvent: fn(NumberEvent) -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  ui.input(
    draft,
    |ui| {
      ui.accessRole(Role.TextBox)
      ui.label(label)
      ui.onInput(|value| onEvent(NumberEvent.Edit { value: move value }))
      ui.onBlur(|| onEvent(commit(draft, options)))
      ui.onKeyDown(
        |event| {
          let key = String.view(&event.key)
          if key == "Enter" {
            return Reply<M>.EmitAndStop { message: onEvent(commit(draft, options)) }
          }
          if key == "Escape" {
            return Reply<M>.EmitAndStop { message: onEvent(NumberEvent.Cancel) }
          }
          if (key == "ArrowUp" || key == "ArrowDown") && (event.modifiers & 14) == 0 {
            let previous = parse(draft).unwrapOr(0.0)
            let multiplier: f32 = if (event.modifiers & 1) != 0 {
              10.0
            } else {
              1.0
            }
            let step = options.step * multiplier
            let next = previous
              + (if key == "ArrowUp" {
                step
              } else {
                -step
              })
            return Reply<M>.EmitAndStop {
              message: onEvent(
                NumberEvent.Commit { value: f32.max(options.min, f32.min(options.max, next)) },
              )
            }
          }
          return Reply<M>.Pass
        },
      )
      body(&mut ui)
    },
  )
}
