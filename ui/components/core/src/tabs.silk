//! [`tabs`]: a row of tabs and the panel of the selected one. The tab list is one tab stop:
//! focused, Left and Right (and Home and End) select the neighboring tab; a click selects a
//! tab. Both send `onSelect(index)`.
import theme { Theme, focusRing, padding2, edges }
import ui_app.ui { Ui, Reply, textKey }
import ui_tree.mutation { Property, Length, Side, Position, Role, Cursor }
import ui_tree.node { Event }
import silk.core.option { Option }
import silk.num.usize
import silk.text.string { String }

/// The tab a key moves to among `count` tabs (wrapping around), or none.
pub fn moveTab(event: &Event, selected: usize, count: usize) -> Option<usize> {
  if count == 0 || event.modifiers != 0 {
    return Option<usize>.None
  }
  let key = String.view(&event.key)
  let current = if selected < count {
    selected
  } else {
    0
  }
  if key == "ArrowRight" {
    return Option<usize>.Some { value: (current + 1) % count }
  }
  if key == "ArrowLeft" {
    return Option<usize>.Some { value: (current + count - 1) % count }
  }
  if key == "Home" {
    return Option<usize>.Some { value: 0 }
  }
  if key == "End" {
    return Option<usize>.Some { value: count - 1 }
  }
  return Option<usize>.None
}

fn indexKey(label: &string) -> u64 {
  return textKey(label.*)
}

/// Tabs labeled `labels` with tab `selected` showing; `panel(ui, selected)` builds the panel.
pub fn tabs<M>(
  ui: &mut Ui<M>,
  theme: &Theme,
  label: string,
  labels: &[string],
  selected: usize,
  onSelect: fn(usize) -> M,
  panel: fn(&mut Ui<M>, usize) -> (),
) -> () {
  let count = labels.length
  ui.column(
    |ui| {
      ui.gap(10.0)
      ui.row(
        |ui| {
          ui.accessRole(Role.TabList)
          ui.label(label)
          ui.tabIndex(0)
          ui.gap(2.0)
          edges(&mut ui, 0.0, 0.0, 1.0, 0.0, theme.border)
          focusRing(&mut ui, &theme)
          ui.onKeyDown(
            |event| match moveTab(event, selected, count) {
              Option<usize>.Some { value: next } => Reply<M>.EmitAndStop { message: onSelect(next) }
              Option<usize>.None => Reply<M>.Pass
            },
          )
          ui.enumerate(
            labels,
            indexKey,
            |ui, index, text| {
              let isSelected = index == selected
              ui.box(
                |ui| {
                  ui.accessRole(Role.Tab)
                  ui.label(text.*)
                  ui.selected(isSelected)
                  ui.cursor(Cursor.Pointer)
                  padding2(&mut ui, 6.0, 12.0)
                  ui.style(&[Property.Position { value: Position.Relative }])
                  if isSelected {
                    ui.color(theme.accent)
                    ui.style(&[Property.FontWeight { value: 600.0 }])
                  } else {
                    ui.color(theme.mutedText)
                    ui.hover(&[Property.Color { color: theme.text }])
                  }
                  ui.onClick(|| onSelect(index))
                  ui.text(text.*)
                  if isSelected {
                    // The underline, over the tab list's bottom border.
                    ui.box(
                      |ui| {
                        ui.style(
                          &[
                            Property.Position { value: Position.Absolute },
                            Property.Inset { side: Side.Left, value: Length.px(0.0) },
                            Property.Inset { side: Side.Right, value: Length.px(0.0) },
                            Property.Inset { side: Side.Bottom, value: Length.px(-1.0) },
                            Property.Height { value: Length.px(2.0) },
                          ],
                        )
                        ui.background(theme.accent)
                      },
                    )
                  }
                },
              )
            },
          )
        },
      )
      if selected < count {
        ui.box(
          |ui| {
            ui.accessRole(Role.TabPanel)
            ui.label(labels[selected])
            panel(&mut ui, selected)
          },
        )
      }
    },
  )
}
