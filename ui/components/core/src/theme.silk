//! [`Theme`]: the colors, radii and sizes every component draws with, and small style helpers.
//!
//! Components take the theme as their second argument, so an app picks or builds one theme
//! and passes it down: `button(&mut ui, &theme, "Save", || Message.Save)`.
import ui_app.ui { Ui }
import ui_tree.mutation { Property, Length, Side, BorderStyle, BoxShadow }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.num.u32

/// The look of the components.
pub struct Theme {
  /// The font family id the app defined (`DefineFontFamily`) for text.
  pub font: u32,
  pub fontSize: f32,
  pub smallSize: f32,
  pub headingSize: f32,
  /// The app background, and the background of raised surfaces (cards, menus, dialogs).
  pub background: Rgba<f32>,
  pub surface: Rgba<f32>,
  pub text: Rgba<f32>,
  pub mutedText: Rgba<f32>,
  pub border: Rgba<f32>,
  pub strongBorder: Rgba<f32>,
  /// The background of a hovered and of a pressed control.
  pub hover: Rgba<f32>,
  pub pressed: Rgba<f32>,
  /// The accent: primary buttons, checked boxes, the selected tab, focus rings.
  pub accent: Rgba<f32>,
  pub accentHover: Rgba<f32>,
  pub accentText: Rgba<f32>,
  /// The background of a highlighted row (menus, lists).
  pub highlight: Rgba<f32>,
  pub danger: Rgba<f32>,
  pub dangerHover: Rgba<f32>,
  /// The scrim behind a modal dialog.
  pub scrim: Rgba<f32>,
  pub tooltip: Rgba<f32>,
  pub tooltipText: Rgba<f32>,
  pub radius: f32,
  /// The height of buttons, fields and other one-line controls.
  pub controlHeight: f32,
}

impl Copy for Theme {}

/// `0xRRGGBB` as a color.
pub fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

/// `0xRRGGBB` with alpha `a`.
pub fn rgba(hex: u32, a: f32) -> Rgba<f32> {
  let mut color = rgb(hex)
  color.a = a
  return color
}

impl Theme {
  /// A light theme with a blue accent, for text in font family `font`.
  pub fn light(font: u32) -> Theme {
    return Theme {
      font: font,
      fontSize: 14.0,
      smallSize: 12.0,
      headingSize: 18.0,
      background: rgb(0xF9FAFB),
      surface: rgb(0xFFFFFF),
      text: rgb(0x1F2937),
      mutedText: rgb(0x6B7280),
      border: rgb(0xD1D5DB),
      strongBorder: rgb(0x9CA3AF),
      hover: rgb(0xF3F4F6),
      pressed: rgb(0xE5E7EB),
      accent: rgb(0x2563EB),
      accentHover: rgb(0x1D4ED8),
      accentText: rgb(0xFFFFFF),
      highlight: rgb(0xDBEAFE),
      danger: rgb(0xDC2626),
      dangerHover: rgb(0xB91C1C),
      scrim: rgba(0x111827, 0.45),
      tooltip: rgb(0x111827),
      tooltipText: rgb(0xFFFFFF),
      radius: 6.0,
      controlHeight: 30.0,
    }
  }

  /// A dark theme with a blue accent.
  pub fn dark(font: u32) -> Theme {
    let mut theme = Theme.light(font)
    theme.background = rgb(0x111827)
    theme.surface = rgb(0x1F2937)
    theme.text = rgb(0xF3F4F6)
    theme.mutedText = rgb(0x9CA3AF)
    theme.border = rgb(0x374151)
    theme.strongBorder = rgb(0x6B7280)
    theme.hover = rgb(0x374151)
    theme.pressed = rgb(0x4B5563)
    theme.accent = rgb(0x3B82F6)
    theme.accentHover = rgb(0x60A5FA)
    theme.highlight = rgb(0x1E3A8A)
    theme.scrim = rgba(0x000000, 0.6)
    theme.tooltip = rgb(0xF3F4F6)
    theme.tooltipText = rgb(0x111827)
    return theme
  }
}

/// The same radius on all four corners.
pub fn corners(radius: f32) -> Corners<f32> {
  return Corners<f32> { topLeft: radius, topRight: radius, bottomRight: radius, bottomLeft: radius }
}

/// A solid border of `width` in `color` on all four sides, with corner radius `radius`.
pub fn border<M>(ui: &mut Ui<M>, width: f32, color: Rgba<f32>, radius: f32) -> () {
  ui.style(
    &[
      Property.BorderWidth { side: Side.Top, value: width },
      Property.BorderWidth { side: Side.Right, value: width },
      Property.BorderWidth { side: Side.Bottom, value: width },
      Property.BorderWidth { side: Side.Left, value: width },
      Property.BorderStyle { value: BorderStyle.Solid },
      Property.BorderColor { color: color },
      Property.BorderRadius { value: corners(radius) },
    ],
  )
}

/// A solid border with its own width on each side (zero hides a side), in `color`.
pub fn edges<M>(
  ui: &mut Ui<M>,
  top: f32,
  right: f32,
  bottom: f32,
  left: f32,
  color: Rgba<f32>,
) -> () {
  ui.style(
    &[
      Property.BorderWidth { side: Side.Top, value: top },
      Property.BorderWidth { side: Side.Right, value: right },
      Property.BorderWidth { side: Side.Bottom, value: bottom },
      Property.BorderWidth { side: Side.Left, value: left },
      Property.BorderStyle { value: BorderStyle.Solid },
      Property.BorderColor { color: color },
    ],
  )
}

/// Fully transparent.
pub fn clear() -> Rgba<f32> {
  return Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
}

/// Padding of `vertical` above and below and `horizontal` left and right.
pub fn padding2<M>(ui: &mut Ui<M>, vertical: f32, horizontal: f32) -> () {
  ui.style(
    &[
      Property.Padding { side: Side.Top, value: Length.px(vertical) },
      Property.Padding { side: Side.Bottom, value: Length.px(vertical) },
      Property.Padding { side: Side.Left, value: Length.px(horizontal) },
      Property.Padding { side: Side.Right, value: Length.px(horizontal) },
    ],
  )
}

/// The theme's text font, size and color on the open node (usually the app's root content).
pub fn surface<M>(ui: &mut Ui<M>, theme: &Theme) -> () {
  ui.style(
    &[
      Property.FontFamily { family: theme.font },
      Property.FontSize { value: theme.fontSize },
      Property.Color { color: theme.text },
      Property.BackgroundColor { color: theme.background },
    ],
  )
}

/// The focus ring: a 2 pixel accent outline drawn as a box shadow, on keyboard focus only.
pub fn focusRing<M>(ui: &mut Ui<M>, theme: &Theme) -> () {
  ui.focusVisible(
    &[
      Property.BoxShadow {
        value: BoxShadow {
          offsetX: 0.0,
          offsetY: 0.0,
          blur: 0.0,
          spread: 2.0,
          color: theme.accent,
          inset: false,
        },
      },
    ],
  )
}

/// The raised look of popups: surface, border, radius and a soft shadow.
pub fn raised<M>(ui: &mut Ui<M>, theme: &Theme) -> () {
  ui.background(theme.surface)
  border(&mut ui, 1.0, theme.border, theme.radius)
  ui.style(
    &[
      Property.BoxShadow {
        value: BoxShadow {
          offsetX: 0.0,
          offsetY: 4.0,
          blur: 12.0,
          spread: 0.0,
          color: rgba(0x000000, 0.15),
          inset: false,
        },
      },
    ],
  )
}
