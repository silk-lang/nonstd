// Popover.

effect fn popoverBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run fonts(&mut tree)
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  run app.start(&mut tree, 0.0)

  let info = run roleId(&mut tree, Role.Button, "Info")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Button, "Info")
  let panel = run boxOf(&mut tree, Role.Dialog, "Info")
  run Testing.expect(focusedId(&tree) == panel.id, "the panel takes focus")
  run Testing.expect((run idOf(&mut tree, "About this gallery")) != 0, "with its content")
  run press(&mut app, &mut tree, viewport(), "Escape", 0)
  run Testing.expect(!app.model.info.open, "Escape closes it")
  run Testing.expect(focusedId(&tree) == info, "focus is back on the button")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Button, "Info")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Button, "Close")
  run Testing.expect(!app.model.info.open, "a button inside can close it")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Button, "Info")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Button, "Info")
  run Testing.expect(!app.model.info.open, "a press on its button closes it")
}

test effect fn popoverOpensAndCloses() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run popoverBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Tabs and lists.

effect fn tabsBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run fonts(&mut tree)
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  run app.start(&mut tree, 0.0)

  let first = run roleId(&mut tree, Role.Tab, "List")
  run Testing.expect(run lineHas(&mut tree, first, "selected"), "the first tab is selected")
  run Testing.expect((run roleId(&mut tree, Role.TabPanel, "List")) != 0, "with its panel")
  run Testing.expect((run roleId(&mut tree, Role.List, "Fruits")) != 0, "the plain list")
  run Testing.expect((run roleId(&mut tree, Role.ListItem, "Mango")) != 0, "with its items")

  drop run clickRole(&mut app, &mut tree, viewport(), Role.Tab, "Virtual")
  run Testing.expect(app.model.tab == 2, "a click selects a tab")
  run Testing.expect((run roleId(&mut tree, Role.TabPanel, "Virtual")) != 0, "its panel shows")
  let tabList = run roleId(&mut tree, Role.TabList, "Lists")
  run Testing.expect(focusedId(&tree) == tabList, "the tab list has focus")
  run press(&mut app, &mut tree, viewport(), "ArrowRight", 0)
  run Testing.expect(app.model.tab == 0, "ArrowRight wraps to the first tab")
  run press(&mut app, &mut tree, viewport(), "ArrowLeft", 0)
  run Testing.expect(app.model.tab == 2, "ArrowLeft wraps to the last")
  run press(&mut app, &mut tree, viewport(), "Home", 0)
  run Testing.expect(app.model.tab == 0, "Home selects the first")
  run press(&mut app, &mut tree, viewport(), "End", 0)
  run Testing.expect(app.model.tab == 2, "End selects the last")
}

test effect fn tabsSelectByPointerAndKeys() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tabsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selectListBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run fonts(&mut tree)
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  run app.start(&mut tree, 0.0)

  drop run clickRole(&mut app, &mut tree, viewport(), Role.Tab, "Select")
  run Testing.expect(app.model.fruit == NO_SELECTION, "nothing selected at first")
  drop run clickRole(&mut app, &mut tree, viewport(), Role.Option, "Cherry")
  run Testing.expect(app.model.fruit == 2, "a click selects a row")
  let cherry = run roleId(&mut tree, Role.Option, "Cherry")
  run Testing.expect(run lineHas(&mut tree, cherry, "selected"), "describe marks it")
  let listBox = run roleId(&mut tree, Role.ListBox, "Pick a fruit")
  run Testing.expect(focusedId(&tree) == listBox, "the list has focus")
  run press(&mut app, &mut tree, viewport(), "ArrowDown", 0)
  run Testing.expect(app.model.fruit == 3, "ArrowDown moves down")
  run press(&mut app, &mut tree, viewport(), "End", 0)
  run press(&mut app, &mut tree, viewport(), "ArrowDown", 0)
  run Testing.expect(app.model.fruit == 4, "and stops at the end")
  run press(&mut app, &mut tree, viewport(), "Home", 0)
  run Testing.expect(app.model.fruit == 0, "Home goes to the first")
  run Testing.expect(!(run lineHas(&mut tree, cherry, "selected")), "Cherry is not selected now")
}

test effect fn selectListMovesWithKeys() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selectListBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn visibleRowsWindow() -> ()
  ! AssertionError<'static> {
  let top = visibleRows(10000, 28.0, 196.0, 0.0, 4)
  run Testing.expect(top.first == 0 && top.end == 11, "7 rows in view and 4 after")
  let middle = visibleRows(10000, 28.0, 196.0, 2800.0, 4)
  run Testing.expect(middle.first == 96 && middle.end == 111, "4 before row 100 and 4 after")
  let bottom = visibleRows(10000, 28.0, 196.0, 279804.0, 4)
  run Testing.expect(bottom.end == 10000, "never past the end")
  let none = visibleRows(0, 28.0, 196.0, 0.0, 4)
  run Testing.expect(none.first == 0 && none.end == 0, "an empty list")
}

effect fn virtualBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run fonts(&mut tree)
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  run app.start(&mut tree, 0.0)

  drop run clickRole(&mut app, &mut tree, viewport(), Role.Tab, "Virtual")
  let nodes = app.stats.nodes
  run Testing.expect(nodes < 400, "ten thousand rows cost a few nodes")
  run Testing.expect((run idOf(&mut tree, "Row ")) != 0, "rows are there")
  run Testing.expect(run wheel(&mut app, &mut tree, viewport(), "Rows", 2800.0), "the list scrolls")
  run Testing.expect(app.model.offset == 2800.0, "the model follows the scroll offset")
  let rows = run boxOf(&mut tree, Role.List, "Rows")

  // Row 101 starts at 2800: the first one in view.
  let mut found = List<u32>.make()
  let snapshotText = run snapshot(&mut tree, viewport())
  run Testing.expect(contains(String.view(&snapshotText), "\"101\""), "row 101 exists")
  run Testing.expect(!contains(String.view(&snapshotText), "\"1\" ["), "row 1 is gone")
  run Testing.expect(app.stats.nodes < 400, "still a few nodes")
  drop found
  drop rows
}

test effect fn virtualListRendersOnlyRowsInView() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run virtualBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Keyboard only: every component reached with Tab and worked with keys.

effect fn keyboardBody() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run fonts(&mut tree)
  let mut app = Runtime<Gallery, Message, NoCommand>.make(Gallery.make())
  run app.start(&mut tree, 0.0)
  let vp = viewport()

  // Tab order: Save, Reset, Ghost (Disabled is skipped), I agree (Locked is skipped),
  // Notifications, Volume, Name, Notes, Delete draft, File, Size, Info, the tab list, the list.
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "Enter", 0)
  run Testing.expect(app.model.saves == 1, "Save with Enter")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run Testing.expect(
    focusedId(&tree) == (run roleId(&mut tree, Role.Checkbox, "I agree")),
    "the checkbox after the buttons",
  )
  run press(&mut app, &mut tree, vp, " ", 0)
  run Testing.expect(app.model.agree, "check it with Space")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, " ", 0)
  run Testing.expect(!app.model.notify, "switch it off with Space")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "ArrowRight", 0)
  run Testing.expect(app.model.volume == 45.0, "slide with ArrowRight")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run typeText(&mut app, &mut tree, vp, "Grace")
  run press(&mut app, &mut tree, vp, "Enter", 0)
  run Testing.expect(String.view(&app.model.submitted) == "Grace", "type a name and submit")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run typeText(&mut app, &mut tree, vp, "hi")
  run Testing.expect(String.view(&app.model.notes) == "hi", "type a note")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "Enter", 0)
  run Testing.expect(app.model.confirm.open, "open the dialog with Enter")
  run press(&mut app, &mut tree, vp, "Escape", 0)
  run Testing.expect(!app.model.confirm.open, "close it with Escape")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "Enter", 0)
  run press(&mut app, &mut tree, vp, "ArrowDown", 0)
  run press(&mut app, &mut tree, vp, "Enter", 0)
  run Testing.expect(String.view(&app.model.status) == "Open", "choose Open from the menu")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "ArrowDown", 0)
  run press(&mut app, &mut tree, vp, "ArrowUp", 0)
  run press(&mut app, &mut tree, vp, " ", 0)
  run Testing.expect(app.model.size == 0, "choose Small from the select")
  run Testing.expect(!app.model.sizeMenu.open, "and it stays closed")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, " ", 0)
  run Testing.expect(app.model.info.open, "open the popover with Space")
  run press(&mut app, &mut tree, vp, "Escape", 0)
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "ArrowRight", 0)
  run Testing.expect(app.model.tab == 1, "next tab with ArrowRight")
  run press(&mut app, &mut tree, vp, "Tab", 0)
  run press(&mut app, &mut tree, vp, "ArrowDown", 0)
  run press(&mut app, &mut tree, vp, "ArrowDown", 0)
  run Testing.expect(app.model.fruit == 1, "pick Banana with the arrows")
  run press(&mut app, &mut tree, vp, "Tab", MOD_SHIFT)
  run Testing.expect(
    focusedId(&tree) == (run roleId(&mut tree, Role.TabList, "Lists")),
    "Shift+Tab goes back",
  )
}

test effect fn keyboardOnlyReachesEveryComponent() -> ()
  ! AssertionError<'static> | TreeError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keyboardBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

import ui_components.numeric { parse, commit, NumberOptions, NumberEvent }
import ui_components.color { withChannel }

test effect fn numericDraftsAndColorChannels() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    parse(" -1.25e2 ").unwrapOr(0.0) == -125.0,
    "numeric inputs accept signed fractional scientific notation",
  )
  run Testing.expect(
    parse("-").isNone() && parse("1e").isNone() && parse("NaN").isNone() && parse("12px").isNone(),
    "incomplete and invalid drafts do not silently commit a number",
  )
  let options = NumberOptions { min: 0.0, max: 100.0, step: 1.0 }
  let result = commit("200", &options)
  run Testing.expect(
    match move result {
      NumberEvent.Commit { value } => value == 100.0
      _ => false
    },
    "commits honor the declared numeric range",
  )
  run Testing.expect(
    withChannel(0x12345678, 1, 255.0) == 0x12ff5678,
    "color controls update one channel without changing alpha",
  )
}
