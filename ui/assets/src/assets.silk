//! The files the demo draws, embedded when it compiles so the native and browser builds carry
//! the same bytes: two Noto Sans subsets (SIL Open Font License, `assets/fonts`), the toolbar and
//! card icons, the animated orbit, and the grid's photos (written by `scripts/generate-photos`).
//! `scripts/embed-assets` turns the files under `assets/` into `generated_assets`.
import generated_assets as files

pub fn regularFont() -> &'static [u8] {
  return files.fontsNotoSansRegularSubset()
}

pub fn boldFont() -> &'static [u8] {
  return files.fontsNotoSansBoldSubset()
}

/// Monochrome icons, drawn as tinted masks, in this order.
pub const ICON_COUNT: u32 = 6

pub const SEARCH: u32 = 0

pub const BELL: u32 = 1

pub const GEAR: u32 = 2

pub const STAR: u32 = 3

pub const HEART: u32 = 4

pub const FOLDER: u32 = 5

pub fn icon(index: u32) -> &'static [u8] {
  return match index {
    0 => files.iconsSearch()
    1 => files.iconsBell()
    2 => files.iconsGear()
    3 => files.iconsStar()
    4 => files.iconsHeart()
    _ => files.iconsFolder()
  }
}

/// The animated SVG: SMIL `animate`, `animateMotion` and `animateTransform`, and a CSS animation.
pub fn orbit() -> &'static [u8] {
  return files.iconsOrbit()
}

pub const PHOTO_COUNT: u32 = 12

/// Photo `index`: even ones are PNG, odd ones JPEG.
pub fn photo(index: u32) -> &'static [u8] {
  return match index {
    0 => files.photosPhoto00()
    1 => files.photosPhoto01()
    2 => files.photosPhoto02()
    3 => files.photosPhoto03()
    4 => files.photosPhoto04()
    5 => files.photosPhoto05()
    6 => files.photosPhoto06()
    7 => files.photosPhoto07()
    8 => files.photosPhoto08()
    9 => files.photosPhoto09()
    10 => files.photosPhoto10()
    _ => files.photosPhoto11()
  }
}

pub fn photoName(index: u32) -> string<'static> {
  return match index {
    0 => "photo-00.png"
    1 => "photo-01.jpg"
    2 => "photo-02.png"
    3 => "photo-03.jpg"
    4 => "photo-04.png"
    5 => "photo-05.jpg"
    6 => "photo-06.png"
    7 => "photo-07.jpg"
    8 => "photo-08.png"
    9 => "photo-09.jpg"
    10 => "photo-10.png"
    _ => "photo-11.jpg"
  }
}
