#!/usr/bin/env python3
"""Build and run the agent browser demo (ui/webview/agent/app).

  scripts/run demo [--build-only] [--release]     open the demo in a window
  scripts/run check [--build-only] [--release]    the scripted check: exits 0 once the agent
                                                  signed the guest book

`demo` talks to Claude when ANTHROPIC_API_KEY is set (SILK_AGENT_MODEL picks another model), and
answers with the scripted agent otherwise. `check` always uses the scripted agent, so it needs
no key and no network, and runs under Xvfb on Linux.

Linux shows pages in Chromium: this script installs the pinned CEF runtime (scripts/install-cef)
and hands its directory to the app as SILK_CEF_RUNTIME. macOS uses WebKit. Windows uses WebView2:
scripts/prepare-windows builds the bridges first, and WebView2Loader.dll goes beside the program.
"""
import argparse
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
APP = PACKAGE / "app"
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402

LAVAPIPE = Path("/usr/share/vulkan/icd.d/lvp_icd.json")


def cef_runtime():
    output = subprocess.run([sys.executable, str(REPO / "scripts/install-cef")], check=True,
                            capture_output=True, text=True).stdout
    return Path(output.strip().splitlines()[-1])


def run(target, build_only, release):
    env = dict(os.environ)
    if target == "check":
        env["SILK_AGENT_CHECK"] = "1"
    if sys.platform == "win32":
        subprocess.run([sys.executable, str(REPO / "scripts/prepare-windows")], check=True)
    runtime = cef_runtime() if sys.platform.startswith("linux") else None
    program = build(APP, release=release)
    if sys.platform == "win32":
        loader = REPO / ".cache/platform-webview/windows/WebView2Loader.dll"
        shutil.copy2(loader, program.parent / "WebView2Loader.dll")
    if build_only:
        print(program)
        return 0
    if runtime is None:
        return subprocess.run([str(program)], cwd=REPO, env=env, timeout=None if target == "demo" else 300).returncode
    env["SILK_CEF_RUNTIME"] = str(runtime)
    log = REPO / ".cache/cef/agent.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    env.setdefault("SILK_CEF_LOG", str(log))
    if target == "demo":
        return subprocess.run([str(program)], cwd=REPO, env=env).returncode
    env["SILK_WINDOW_SCALE"] = "1"
    if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
        env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
    linux = runpy.run_path(str(REPO / "platform/window/scripts/linux"))
    code = linux["run_under_x11"](program, env)
    print(f"--- agent check: {'passed' if code == 0 else f'failed ({code})'}", flush=True)
    if code and log.exists():
        print("--- CEF log (last 200 lines)", flush=True)
        print("\n".join(log.read_text(errors="replace").splitlines()[-200:]), flush=True)
    return code


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", choices=["demo", "check"])
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    return run(args.target, args.build_only, args.release)


if __name__ == "__main__":
    raise SystemExit(main())
