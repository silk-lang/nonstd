//! The web view backend this demo runs on: Chromium (CEF, through ui-webview-chromium) on Linux,
//! the system web views (WKWebView, WebView2) on macOS and Windows.
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

static if Intrinsic.targetOperatingSystem() == "linux" {
  import ui_webview_chromium.lib { ChromiumBackend }
  import chromium.lib { ChromiumWebViews, ChromiumOptions, StartError }
  import silk.core.effect { Effect }

  pub type Views = ChromiumBackend

  /// Starts Chromium from `runtimeDir` (the directory scripts/install-cef prints). `ci` turns off
  /// the sandbox and the GPU process, which CI runners have neither of.
  pub effect fn startViews(runtimeDir: string, ci: bool) -> Option<Views>
    ! OutOfMemoryError
    ? &mut Allocator {
    if String.byteLength(runtimeDir) == 0 {
      StderrWriter.print(
        "agent browser: set SILK_CEF_RUNTIME to the CEF runtime directory (python3 scripts/install-cef prints it)\n",
        &(),
      )
      return Option<Views>.None
    }
    let mut options = run ChromiumOptions.make(runtimeDir)
    if ci {
      options.sandbox = false
      options.gpu = false
    }
    let started = run Effect.catchAll(start(&options), notStarted)
    if Option<ChromiumWebViews>.isNone(&started) {
      let why = run ChromiumWebViews.startError()
      StderrWriter.print("agent browser: Chromium did not start: {}\n", &(why.view(),))
    }
    return match move started {
      Option<ChromiumWebViews>.Some { value } => Option<Views>.some(
        ChromiumBackend.make(move value),
      )
      Option<ChromiumWebViews>.None => Option<Views>.None
    }
  }

  pub fn stopViews(views: &mut Views) -> () {
    views.views.shutdown()
  }

  effect fn start(options: &ChromiumOptions) -> Option<ChromiumWebViews>
    ! StartError
    ? &mut Allocator {
    return Option<ChromiumWebViews>.some(run ChromiumWebViews.start(options))
  }

  effect fn notStarted(error: StartError) -> Option<ChromiumWebViews> {
    drop error
    return Option<ChromiumWebViews>.None
  }
} else {
  import webview.native { NativeWebViews }

  pub type Views = NativeWebViews

  pub effect fn startViews(runtimeDir: string, ci: bool) -> Option<Views>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Option<Views>.some(NativeWebViews.make())
  }

  pub fn stopViews(views: &mut Views) -> () {
    return ()
  }
}
