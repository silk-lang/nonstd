//! A browsing agent for ui-webview pages: [`Agent`] (a conversation with Claude whose tools drive
//! the shared page), [`ClaudeLink`] (Messages API calls on threads) and [`respond`] (a scripted
//! brain for CI and machines without an API key).
pub import agent { Agent, Step, MODEL, SYSTEM }
pub import tools { TOOLS }
pub import script { respond, refOn }
pub import claude { ClaudeLink, Reply }
