//! ui-webview's `WindowBackend` for Chromium (platform-webview-chromium): window input over a
//! view goes to its page, frames are uploaded before each draw, the page's cursor shows over it,
//! and CEF's pump sets when the loop wakes.
//!
//! `ChromiumBackend` wraps the backend (`views` is the `ChromiumWebViews`) so it can carry both
//! interfaces:
//!
//! ```silk,ignore
//! let mut options = run ChromiumOptions.make(runtimeDir)
//! let views = run ChromiumWebViews.start(&options)
//! let mut host = WebViewsHost<ChromiumBackend, Browser, Message>.make(ChromiumBackend.make(move views))
//! run runWindowHosting(&mut runtime, &collection, resources, runOptions, inspector, &mut host)
//! host.views.views.shutdown()
//! ```
import ui_webview.backend { WindowBackend }
import chromium.chromium { ChromiumWebViews }
import webview.command { Command }
import webview.event { WebViewEvent }
import webview.host { WebViewHost }
import webview.types { WebViewOptions, WebViewError, Placement, Backend, Capabilities }
import silk.collections.list { List }
import ui_renderer.renderer { UiRenderer }
import window.event { Event }
import window.types { Cursor }
import webgpu.resources { Queue }
import webgpu.runtime { Device, GpuError }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The Chromium backend with ui-webview's window hooks.
pub struct ChromiumBackend {
  pub views: ChromiumWebViews,
}

impl ChromiumBackend {
  pub fn make(views: ChromiumWebViews) -> ChromiumBackend {
    return ChromiumBackend { views: move views }
  }
}

impl WebViewHost for ChromiumBackend {
  effect fn open(self: &mut Self, view: u32, options: &WebViewOptions) -> ()
    ! WebViewError | OutOfMemoryError
    ? &mut Allocator {
    run self.views.open(view, options)
  }

  effect fn close(self: &mut Self, view: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.views.close(view)
  }

  fn place(self: &mut Self, view: u32, placement: Placement) -> () {
    self.views.place(view, placement)
  }

  effect fn send(self: &mut Self, view: u32, command: Command) -> ()
    ! WebViewError | OutOfMemoryError
    ? &mut Allocator {
    run self.views.send(view, move command)
  }

  effect fn takeEvents(self: &mut Self, out: &mut List<WebViewEvent>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.views.takeEvents(&mut out)
  }

  fn backend(self: &Self) -> Backend {
    return self.views.backend()
  }

  fn capabilities(self: &Self) -> Capabilities {
    return self.views.capabilities()
  }
}

impl WindowBackend for ChromiumBackend {
  effect fn forward(self: &mut Self, event: &Event) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return self.views.forward(event)
  }

  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    run self.views.present(device, queue, &mut renderer)
  }

  fn pointerCursor(self: &Self) -> Option<Cursor> {
    return self.views.cursor()
  }

  fn newFrames(self: &mut Self) -> bool {
    return self.views.hasNewFrames()
  }

  fn nextWork(self: &Self) -> Option<f64> {
    return Option<f64>.some(self.views.nextPump())
  }
}
