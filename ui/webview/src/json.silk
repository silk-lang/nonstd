//! JSON text for the Messages API: string escaping and writing a parsed value back out, so the
//! agent can send Claude's content blocks back exactly as they came.
import silk.core.option { Option }
import silk.json.value { Value, JsonChild }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u8
import silk.text.string { String }

const HEX: string<'static> = "0123456789abcdef"

/// Appends `text` as a JSON string, quotes included.
pub effect fn quote(out: &mut String, text: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append("\"")
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    let escaped = b == 34 || b == 92 || b < 32
    if escaped {
      if i > start {
        run out.append(String.slice(text, start, i - start))
      }
      if b == 34 {
        run out.append("\\\"")
      } else if b == 92 {
        run out.append("\\\\")
      } else if b == 10 {
        run out.append("\\n")
      } else if b == 13 {
        run out.append("\\r")
      } else if b == 9 {
        run out.append("\\t")
      } else {
        run out.append("\\u00")
        let value = u8.toU32(b)
        run out.append(String.slice(HEX, u32.toUsize(value / 16), 1))
        run out.append(String.slice(HEX, u32.toUsize(value % 16), 1))
      }
      start = i + 1
    }
    i = i + 1
  }
  if bytes.length > start {
    run out.append(String.slice(text, start, bytes.length - start))
  }
  run out.append("\"")
}

/// Appends `value` as compact JSON.
pub effect fn write(out: &mut String, value: &Value) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value.* {
    Value.Null => {
      run out.append("null")
    }
    Value.Bool { value: flag } => {
      if flag {
        run out.append("true")
      } else {
        run out.append("false")
      }
    }
    Value.Number { text } => {
      run out.append(String.view(&text))
    }
    Value.String { text } => {
      run quote(&mut out, String.view(&text))
    }
    Value.Array { values } => {
      run out.append("[")
      let list = values.get()[0].asSlice()
      let mut i: usize = 0
      while i < list.length {
        if i > 0 {
          run out.append(",")
        }
        if let JsonChild.Item { value: item } = &list[i] {
          run write(&mut out, &item)
        }
        i = i + 1
      }
      run out.append("]")
    }
    Value.Object { entries } => {
      run out.append("{")
      let list = entries.get()[0].asSlice()
      let mut i: usize = 0
      while i < list.length {
        if i > 0 {
          run out.append(",")
        }
        if let JsonChild.Member { entry } = &list[i] {
          run quote(&mut out, String.view(&entry.key))
          run out.append(":")
          run write(&mut out, &entry.value)
        }
        i = i + 1
      }
      run out.append("}")
    }
  }
}

/// How many elements an array value has (0 for anything else).
pub fn count(value: Option<&Value>) -> usize {
  if let Option<&Value>.Some { value: found } = value {
    if let Value.Array { values } = &found.* {
      return values.get()[0].length()
    }
  }
  return 0
}

/// Element `index` of an array value.
pub fn item<'a>(value: Option<&'a Value>, index: usize) -> Option<&'a Value> {
  if let Option<&Value>.Some { value: found } = value {
    if let Value.Array { values } = &found.* {
      let list = values.get()[0].asSlice()
      if index < list.length {
        if let JsonChild.Item { value: element } = &list[index] {
          return Option<&Value>.some(&element)
        }
      }
    }
  }
  return Option<&Value>.None
}
