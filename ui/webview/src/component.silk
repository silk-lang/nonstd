//! [`webView`]: the node a web view shows on. It is a `ui.hosted` node for the page's view,
//! focusable, labeled with the page's title, that keeps keyboard focus in step with the page:
//! when the page takes focus (a click into it) the node takes the tree's focus, and when the
//! tree focuses the node (Tab) the page gets keyboard focus.
//!
//! Everything around the page (an address bar, back and forward buttons, tabs, a status line) is
//! the app's own UI, built from the same [`Page`] fields.
import page { Page, PageMessage }
import ui_app.ui { Ui }
import ui_tree.mutation { Role }

/// The node `page`'s view shows on. `toMessage` wraps the page's messages in the app's;
/// `body` styles the node (size it with `grow`, `width`, `height` like any box).
pub fn webView<M>(
  ui: &mut Ui<M>,
  page: &Page,
  toMessage: fn(PageMessage) -> M,
  body: fn(&mut Ui<M>) -> (),
) -> () {
  ui.hosted(
    page.view,
    |ui| {
      ui.accessRole(Role.Main)
      ui.label(page.heading())
      if page.focused {
        ui.takeFocus()
      }
      ui.onFocus(|| toMessage(PageMessage.NodeFocused))
      body(&mut ui)
    },
  )
}
