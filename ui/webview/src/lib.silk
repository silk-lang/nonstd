//! Web views as a ui-app component: [`Page`] (the state an app keeps per view), [`webView`]
//! (the node the page shows on), [`WebViewRequests`] (what `update` asks of the views) and
//! [`WebViewsHost`] (the window host that runs them on any platform-webview backend).
pub import page { Page, PageMessage }
pub import requests { WebViewRequests, Request }
pub import component { webView }
pub import backend { WindowBackend }
pub import host { WebViewsHost, WebViewApp }
