//! [`WindowBackend`]: what a web view backend needs from the window loop beyond
//! platform-webview's `WebViewHost`, and its implementations for the backends in
//! platform-webview.
//!
//! Native child views (WKWebView, WebView2) and the headless backend draw nothing through the
//! renderer and take no input from the window, so their implementations do nothing. An
//! offscreen backend (Chromium, through ui-webview-chromium) takes the window's input over its
//! views, uploads frames before each draw, sets the cursor and asks for frames.
import webview.bridge { BridgeWebViews }
import webview.headless { HeadlessWebViews }
import ui_renderer.renderer { UiRenderer }
import window.event { Event }
import window.types { Cursor }
import webgpu.resources { Queue }
import webgpu.runtime { Device, GpuError }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub interface WindowBackend {
  /// A window event before the tree sees it; true when a view took it.
  effect fn forward(self: &mut Self, event: &Event) -> bool ! OutOfMemoryError ? &mut Allocator

  /// Puts new frames where `renderer` draws hosted nodes, before a frame is drawn.
  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator

  /// The cursor the page under the pointer wants, or None.
  fn pointerCursor(self: &Self) -> Option<Cursor>

  /// A frame arrived that `present` has not shown yet.
  fn newFrames(self: &mut Self) -> bool

  /// Seconds until the engine needs a turn of the loop, or None.
  fn nextWork(self: &Self) -> Option<f64>
}

impl WindowBackend for HeadlessWebViews {
  effect fn forward(self: &mut Self, event: &Event) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  fn pointerCursor(self: &Self) -> Option<Cursor> {
    return Option<Cursor>.None
  }

  fn newFrames(self: &mut Self) -> bool {
    return false
  }

  fn nextWork(self: &Self) -> Option<f64> {
    return Option<f64>.None
  }
}

impl WindowBackend for BridgeWebViews {
  effect fn forward(self: &mut Self, event: &Event) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  fn pointerCursor(self: &Self) -> Option<Cursor> {
    return Option<Cursor>.None
  }

  fn newFrames(self: &mut Self) -> bool {
    return false
  }

  fn nextWork(self: &Self) -> Option<f64> {
    return Option<f64>.None
  }
}
