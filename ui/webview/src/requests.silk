//! [`WebViewRequests`]: the web view work a model queues in `update`, which the host
//! ([`host.WebViewsHost`]) takes after each turn of the loop. Opening, closing and every
//! `Command` are plain data here, so an update stays a pure function of the model.
import webview.command { Command }
import webview.types { WebViewOptions }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

/// One piece of work for the host.
pub union Request {
  /// Opens view `view`. The host fills in `options.window` with its window.
  Open { pub view: u32, pub options: WebViewOptions },
  Close { pub view: u32 },
  Send { pub view: u32, pub command: Command },
}

/// The queue a model keeps, and the request numbers its answering commands use.
pub struct WebViewRequests {
  queue: List<Request>,
  next: u32,
}

impl WebViewRequests {
  pub fn make() -> WebViewRequests {
    return WebViewRequests { queue: List<Request>.make(), next: 1 }
  }

  /// A fresh request number for a command that answers (`Snapshot`, `Evaluate`, ...); never 0.
  pub fn request(self: &mut Self) -> u32 {
    let number = self.next
    self.next = u32.wrappingAdd(self.next, 1)
    if self.next == 0 {
      self.next = 1
    }
    return number
  }

  pub effect fn open(self: &mut Self, view: u32, options: WebViewOptions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(Request.Open { view: view, options: move options })
  }

  pub effect fn close(self: &mut Self, view: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(Request.Close { view: view })
  }

  pub effect fn send(self: &mut Self, view: u32, command: Command) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(Request.Send { view: view, command: move command })
  }

  /// How many requests wait.
  pub fn length(self: &Self) -> usize {
    return self.queue.length()
  }

  /// Takes the oldest request.
  pub fn take(self: &mut Self) -> Request {
    return self.queue.remove(0)
  }
}
