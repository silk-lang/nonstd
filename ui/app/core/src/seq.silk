//! Loops as functions over slices (a `List`'s `asSlice()`), for views and updates:
//! [`forEach`], [`enumerate`], [`map`], [`filter`] and [`count`].
//!
//! Silk specializes each lambda, so these cost what the `while` loop they replace costs. A
//! lambda can read and change what it captures, but `break` and an early `return` do not cross
//! it. `map` and `filter` make a new `List`, so they are effects that need an `Allocator`; in a
//! view or an update run them with `ui.alloc(...)` or `cx.alloc(...)`.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Calls `body` with each item, in order.
pub fn forEach<T>(items: &[T], mut body: mut fn(&T) -> ()) -> () {
  let mut i: usize = 0
  while i < items.length {
    body(&items[i])
    i = i + 1
  }
}

/// Calls `body` with each item's index and the item, in order.
pub fn enumerate<T>(items: &[T], mut body: mut fn(usize, &T) -> ()) -> () {
  let mut i: usize = 0
  while i < items.length {
    body(i, &items[i])
    i = i + 1
  }
}

/// How many items `test` accepts.
pub fn count<T>(items: &[T], mut test: mut fn(&T) -> bool) -> usize {
  let mut total: usize = 0
  let mut i: usize = 0
  while i < items.length {
    if test(&items[i]) {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

/// A new list of `transform` applied to each item.
pub effect fn map<T, U>(items: &[T], mut transform: mut fn(&T) -> U) -> List<U>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = run List<U>.makeWithCapacity(items.length)
  let mut i: usize = 0
  while i < items.length {
    run out.append(transform(&items[i]))
    i = i + 1
  }
  return move out
}

/// A new list of the items `keep` accepts, in order.
pub effect fn filter<T: Copy>(items: &[T], mut keep: mut fn(&T) -> bool) -> List<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<T>.make()
  let mut i: usize = 0
  while i < items.length {
    if keep(&items[i]) {
      run out.append(items[i])
    }
    i = i + 1
  }
  return move out
}
