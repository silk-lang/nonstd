//! [`Heap`]: allocation for the plain functions of an app (`view`, `update`).
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }

/// Runs allocating work for code that is not an `effect fn`, such as a view or an update.
///
/// Views and updates are plain functions so that their lambdas can nest freely. When they need
/// memory (a new `String`, a list append), they hand the work to [`Heap.alloc`], which runs it
/// with the process heap. Running out of memory traps.
pub struct Heap {
  allocator: SystemAllocator,
}

impl Heap {
  pub fn make() -> Heap {
    return Heap { allocator: Allocator.systemAllocatorProvider() }
  }

  /// Runs `work` with the process heap and returns its value. Traps when memory runs out.
  pub fn alloc<A>(self: &mut Self, work: once Effect<A ! OutOfMemoryError ? &mut Allocator>) -> A {
    let done = run Effect.result(move work) |> Effect.provideMut<Allocator>(&mut self.allocator)
    return match move done {
      Result<A, OutOfMemoryError>.Success { value } => move value
      Result<A, OutOfMemoryError>.Failure { error } => {
        drop error
        Intrinsic.trap("ui-app: out of memory")
      }
    }
  }
}
