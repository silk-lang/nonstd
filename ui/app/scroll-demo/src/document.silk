//! A fully mounted, deterministic mixed-content document on the ordinary UI tree.
import ui_app.app { App, Context, NoCommand }
import ui_app.ui { Ui, Grid }
import ui_examples.look { button, rgb }
import ui_tree.lib { Batch }
import ui_tree.mutation {
  Property,
  Length,
  Side,
  Overflow,
  Position,
  Align,
  LineHeight,
  ObjectFit,
  BoxSizing,
  WhiteSpace
}
import demo.assets as assets
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

pub struct Document {
  pub sections: usize,
  pub automatic: bool,
  pub reverse: bool,
  pub images: bool,
}

pub union Message {
  Size { pub count: usize },
  Automatic,
  Reverse,
  Images,
}

pub effect fn resources(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.fontFamily(1, "Noto Sans, sans-serif")
  let mut i: u32 = 0
  while i < assets.PHOTO_COUNT {
    run batch.image(100 + i, assets.photo(i))
    i = i + 1
  }
}

fn title(index: usize) -> string<'static> {
  return match index % 6 {
    0 => "Finding a little breathing room"
    1 => "A place for the unexpected"
    2 => "Patterns worth paying attention to"
    3 => "Small details, lasting impressions"
    4 => "Notes from the quieter side"
    _ => "Making space for what comes next"
  }
}

fn paragraph(index: usize) -> string<'static> {
  return match index % 4 {
    0 => "A good document makes room for different kinds of thought. Some ideas need a few clear sentences; others are easier to understand as an image, a small table, or a sketch. This collection moves between them, keeping the rhythm of a notebook rather than a wall of identical cards."
    1 => "We started with a walk through the neighborhood, collecting colors, textures, and fragments of conversation. The interesting part was not how much we collected, but which details we remembered the next morning. Those became the starting points for the next round of work."
    2 => "The first version was deliberately simple. We placed the material on the page, changed the width, and watched where the reading rhythm broke. Short captions made the photographs easier to scan. Longer passages needed a generous line height and a little more space between ideas."
    _ => "Try reading this section at a different window width. The paragraphs wrap, the columns resize, and the photographs keep their proportions. Farther down the document, you will find the same ingredients arranged in different combinations, with enough variation to make each stretch of the journey distinct."
  }
}

fn label(ui: &mut Ui<Message>, value: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(11.0)
      ui.color(rgb(0x6c7b80))
      ui.text(value)
    },
  )
}

fn prose(ui: &mut Ui<Message>, value: string) -> () {
  ui.box(
    |ui| {
      ui.fontSize(16.0)
      ui.style(&[Property.LineHeight { value: LineHeight.Number { value: 1.6 } }])
      ui.text(value)
    },
  )
}

fn section(ui: &mut Ui<Message>, index: usize, images: bool) -> () {
  ui.key(1000 + usize.toU64(index))
  ui.column(
    |ui| {
      ui.testId("document-section")
      ui.gap(18.0)
      ui.padding(28.0)
      ui.background(rgb(0xffffff))
      ui.style(&[Property.FlexShrink { value: 0.0 }])
      ui.row(
        |ui| {
          ui.style(
            &[
              Property.Position { value: Position.Sticky },
              Property.Inset { side: Side.Top, value: Length.px(0.0) },
              Property.AlignItems { value: Align.Center },
            ],
          )
          ui.background(rgb(0xffffff))
          ui.gap(8.0)
          ui.padding(8.0)
          label(&mut ui, "FIELD NOTE")
          ui.number(usize.toI64(index + 1))
          label(&mut ui, " /  OBSERVE · COLLECT · REFINE")
        },
      )
      ui.box(
        |ui| {
          ui.fontSize(28.0)
          ui.style(&[Property.FontWeight { value: 700.0 }])
          ui.text(title(index))
        },
      )
      let mut p: usize = 0
      while p <= index % 3 {
        prose(&mut ui, paragraph(index + p))
        p = p + 1
      }
      if index % 2 == 0 {
        let columns = ui.alloc(Grid.columns(2))
        ui.grid(
          &columns,
          |ui| {
            ui.gap(18.0)
            let mut column: usize = 0
            while column < 2 {
              ui.column(
                |ui| {
                  ui.gap(10.0)
                  if images {
                    ui.imageWith(
                      100 + usize.toU32((index + column) % 12),
                      |ui| {
                        ui.width(Length.percent(100.0))
                        ui.height(Length.px(190.0 + usize.toF32(index % 3) * 24.0))
                        ui.style(&[Property.ObjectFit { value: ObjectFit.Cover }])
                        ui.label("An abstract landscape from the collection")
                      },
                    )
                  } else {
                    ui.box(
                      |ui| {
                        ui.height(Length.px(190.0))
                        ui.background(rgb(0xe7eeea))
                        label(&mut ui, "Images disabled")
                      },
                    )
                  }
                  label(
                    &mut ui,
                    if column == 0 {
                      "01 / A study in light and texture"
                    } else {
                      "02 / Another way of seeing"
                    },
                  )
                },
              )
              column = column + 1
            }
          },
        )
      }
      if index % 3 == 0 {
        ui.column(
          |ui| {
            ui.padding(20.0)
            ui.gap(8.0)
            ui.background(rgb(0xeaf1ed))
            label(&mut ui, "A THOUGHT TO KEEP")
            prose(&mut ui, "Leave enough space between ideas for something new to happen.")
          },
        )
      }
      if index % 3 == 1 {
        ui.column(
          |ui| {
            ui.padding(18.0)
            ui.background(rgb(0x192e35))
            ui.color(rgb(0xd9eee5))
            ui.fontSize(14.0)
            ui.style(&[Property.WhiteSpace { value: WhiteSpace.PreWrap }])
            ui.text(
              "document {\n    rhythm: generous\n    images: worth a second look\n    details: small, but considered\n    next: keep exploring\n}",
            )
          },
        )
      }
      if index % 3 == 2 {
        ui.column(
          |ui| {
            ui.gap(1.0)
            ui.background(rgb(0xe2e8e5))
            let mut row: usize = 0
            while row < 5 {
              let columns = ui.alloc(Grid.columns(3))
              ui.grid(
                &columns,
                |ui| {
                  ui.padding(12.0)
                  ui.background(
                    rgb(
                      if row == 0 {
                        0xeaf1ed
                      } else {
                        0xf8faf8
                      },
                    ),
                  )
                  ui.box(
                    |ui| {
                      ui.text(
                        if row == 0 {
                          "Observation"
                        } else if row % 2 == 0 {
                          "Color study"
                        } else {
                          "Material sample"
                        },
                      )
                    },
                  )
                  ui.box(
                    |ui| {
                      ui.text(
                        if row == 0 {
                          "Status"
                        } else {
                          "Ready for review"
                        },
                      )
                    },
                  )
                  ui.box(
                    |ui| {
                      if row == 0 {
                        ui.text("Collection")
                      } else {
                        ui.number(usize.toI64(index * 5 + row))
                      }
                    },
                  )
                },
              )
              row = row + 1
            }
          },
        )
      }
      label(&mut ui, "From the field notebook · Updated with care")
    },
  )
}

impl App<Message, NoCommand> for Document {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.style(
      &[
        Property.FontFamily { family: 1 },
        Property.FontSize { value: 14.0 },
        Property.Color { color: rgb(0x263e40) },
        Property.BackgroundColor { color: rgb(0xf0f3ef) },
        Property.BoxSizing { value: BoxSizing.BorderBox },
      ],
    )
    ui.column(
      |ui| {
        ui.width(Length.percent(100.0))
        ui.height(Length.percent(100.0))
        ui.row(
          |ui| {
            ui.height(Length.px(70.0))
            ui.padding(18.0)
            ui.gap(12.0)
            ui.background(rgb(0xffffff))
            ui.style(
              &[Property.FlexShrink { value: 0.0 }, Property.AlignItems { value: Align.Center }],
            )
            ui.box(
              |ui| {
                ui.fontSize(20.0)
                ui.text("Fieldnotes")
              },
            )
            label(&mut ui, " /  SCROLL LAB")
            ui.box(
              |ui| {
                ui.grow(1.0)
              },
            )
            button(
              &mut ui,
              if self.automatic {
                "Pause scrolling"
              } else {
                "Auto scroll"
              },
              self.automatic,
              || Message.Automatic,
            )
            button(
              &mut ui,
              if self.reverse {
                "Forward"
              } else {
                "Reverse"
              },
              self.reverse,
              || Message.Reverse,
            )
          },
        )
        ui.row(
          |ui| {
            ui.grow(1.0)
            ui.style(&[Property.MinHeight { value: Length.px(0.0) }])
            ui.column(
              |ui| {
                ui.width(Length.px(218.0))
                ui.padding(22.0)
                ui.gap(18.0)
                ui.style(&[Property.FlexShrink { value: 0.0 }])
                label(&mut ui, "DOCUMENT SIZE")
                button(
                  &mut ui,
                  "100 sections",
                  self.sections == 100,
                  || Message.Size { count: 100 },
                )
                button(
                  &mut ui,
                  "1,000 sections",
                  self.sections == 1000,
                  || Message.Size { count: 1000 },
                )
                button(
                  &mut ui,
                  "10,000 sections",
                  self.sections == 10000,
                  || Message.Size { count: 10000 },
                )
                label(&mut ui, "CONTENT")
                button(
                  &mut ui,
                  if self.images {
                    "Images on"
                  } else {
                    "Images off"
                  },
                  self.images,
                  || Message.Images,
                )
                prose(&mut ui, "Text, photos, tables, code, and sticky headings.")
                label(
                  &mut ui,
                  "All sections stay mounted. Scrolling uses the shared UI tree and renderer.",
                )
                ui.box(
                  |ui| {
                    ui.number(usize.toI64(self.sections))
                    ui.text(" sections")
                  },
                )
              },
            )
            ui.column(
              |ui| {
                ui.testId("document-scroll")
                ui.grow(1.0)
                ui.height(Length.percent(100.0))
                ui.style(
                  &[
                    Property.MinWidth { value: Length.px(0.0) },
                    Property.MinHeight { value: Length.px(0.0) },
                    Property.OverflowY { value: Overflow.Auto },
                    Property.OverflowX { value: Overflow.Hidden },
                  ],
                )
                ui.column(
                  |ui| {
                    ui.padding(32.0)
                    ui.gap(24.0)
                    ui.style(&[Property.FlexShrink { value: 0.0 }])
                    ui.box(
                      |ui| {
                        ui.fontSize(38.0)
                        ui.text("A notebook without an end.")
                      },
                    )
                    prose(
                      &mut ui,
                      "Scroll at your own pace, or start an automatic pass. This is a real, fully laid-out document with a changing mix of content.",
                    )
                    let mut index: usize = 0
                    while index < self.sections {
                      section(&mut ui, index, self.images)
                      index = index + 1
                    }
                  },
                )
              },
            )
          },
        )
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Size { count } => {
        self.sections = count
        self.automatic = false
      }
      Message.Automatic => {
        self.automatic = !self.automatic
      }
      Message.Reverse => {
        self.reverse = !self.reverse
      }
      Message.Images => {
        self.images = !self.images
      }
    }
  }
}
