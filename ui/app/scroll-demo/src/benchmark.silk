//! CPU benchmark of the same document, wheel dispatcher, layout and painter as the window.
import document { Document, Message, resources }
import ui_app.app { NoCommand }
import ui_app.runtime { Runtime, pump }
import ui_tree.lib { UiTree, TreeError, Batch, FrameInput, Input, findAll }
import ui_fixtures.fixtures as fixtures
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.core.effect { Effect }
import silk.io.writer_native { StderrWriter }
import silk.num.i64
import silk.num.usize

pub effect fn milliseconds(clock: &mut OsMonotonicClock) -> f64 {
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&now)) * 1000.0
    + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000.0
}

pub effect fn measure(sections: usize, steps: usize, phases: bool) -> i32
  ! TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run resources(&mut batch)
  run tree.apply(run batch.take())
  let mut app = Runtime<Document, Message, NoCommand>.make(
    Document { sections: sections, automatic: false, reverse: false, images: true },
  )
  let mut clock = OsMonotonicClock.make()
  let start = run milliseconds(&mut clock)
  run app.start(&mut tree, 0.0)
  let mounted = run milliseconds(&mut clock)
  let viewport = FrameInput { width: 1280.0, height: 900.0, scale: 2.0, time: 0.0 }
  run tree.frame(viewport)
  StderrWriter.print(
    "mount-ms: {} nodes={} fragments={}\n",
    &((run milliseconds(&mut clock)) - start, tree.stats.nodes, tree.stats.fragments),
  )
  StderrWriter.print(
    "mount-phases-ms: build={} firstFrame={}\n",
    &(mounted - start, (run milliseconds(&mut clock)) - mounted),
  )
  let mut found = List<u32>.make()
  run findAll(&tree, "document-scroll", &mut found)
  if found.length() != 1 {
    return 1
  }
  let scroll = found.get(0)
  found.clear()
  run findAll(&tree, "document-section", &mut found)
  if found.length() != sections {
    StderrWriter.print("FAIL: document is not fully mounted\n", &())
    return 1
  }
  let mut step: usize = 0
  while step < steps {
    let started = run milliseconds(&mut clock)
    run tree.dispatch(
      Input.Wheel {
        x: 900.0,
        y: 400.0,
        deltaX: 0.0,
        deltaY: if step < steps / 2 {
          96.0
        } else {
          -96.0
        },
        modifiers: 0,
      },
    )
    drop run pump(&mut app, &mut tree)
    let inputEnd = run milliseconds(&mut clock)
    if phases {
      run tree.layoutNow()
    }
    let layoutEnd = run milliseconds(&mut clock)
    let layouts = tree.stats.layout.fullLayouts
    run tree.frame(viewport)
    let end = run milliseconds(&mut clock)
    let offset = tree.scrollOffset(scroll)
    if step == 0 && offset.y <= 0.0 {
      StderrWriter.print("FAIL: wheel did not move the document\n", &())
      return 1
    }
    StderrWriter.print(
      "scroll-ms: input={} frame={} y={} painted={} replayed={} glyphs={} layoutSkipped={}\n",
      &(
        inputEnd - started,
        end - inputEnd,
        offset.y,
        tree.stats.paintedFragments,
        tree.stats.replayedOperations,
        tree.stats.glyphs,
        tree.stats.layoutSkipped
      ),
    )
    if phases {
      StderrWriter.print(
        "phase-ms: layout={} remainingFrame={} fullLayouts={}\n",
        &(layoutEnd - inputEnd, end - layoutEnd, layouts),
      )
    }
    step = step + 1
  }
  if tree.scrollOffset(scroll).y != 0.0 {
    StderrWriter.print("FAIL: reverse wheel pass did not return to the top\n", &())
    return 1
  }
  return 0
}
