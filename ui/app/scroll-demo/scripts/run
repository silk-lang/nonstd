#!/usr/bin/env python3
"""Build/run the native scroll stress demo. --bundle packages the macOS app."""
import argparse
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parents[1]
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / 'gpu/webgpu/scripts'))
from _build import build


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--debug', action='store_true')
    parser.add_argument('--build-only', action='store_true')
    parser.add_argument('--bundle', action='store_true')
    args, forwarded = parser.parse_known_args()
    binary = build(PACKAGE, release=not args.debug)
    if args.bundle:
        if sys.platform != 'darwin':
            parser.error('--bundle requires macOS')
        app = REPO / 'build/Fieldnotes Scroll Lab.app'
        macos = app / 'Contents/MacOS'
        macos.mkdir(parents=True, exist_ok=True)
        staged = macos / 'Fieldnotes.next'
        shutil.copy2(binary, staged)
        staged.replace(macos / 'Fieldnotes')
        with (app / 'Contents/Info.plist').open('wb') as output:
            plistlib.dump(dict(CFBundleName='Fieldnotes Scroll Lab',
                CFBundleIdentifier='org.silk-lang.scroll-lab', CFBundleExecutable='Fieldnotes',
                CFBundlePackageType='APPL', CFBundleShortVersionString='0.1.0',
                CFBundleVersion='1', NSHighResolutionCapable=True), output)
        print(app)
        return 0
    if args.build_only:
        print(binary)
        return 0
    return subprocess.run([str(binary), *forwarded], cwd=REPO).returncode


if __name__ == '__main__':
    raise SystemExit(main())
