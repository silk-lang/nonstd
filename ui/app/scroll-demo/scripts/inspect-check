#!/usr/bin/env python3
"""Check the debug scroll demo through the same socket protocol used by devtools.

Builds a debug binary by default. --binary skips building for a quick regression run.
Requires a desktop display and GPU, like scripts/run.
"""
import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import time

PACKAGE = Path(__file__).resolve().parents[1]
REPO = PACKAGE.parents[2]
sys.path.insert(0, str(REPO / 'gpu/webgpu/scripts'))
from _build import build


def request(address, command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(3)
        connection.connect(str(address))
        connection.sendall((json.dumps(command) + '\n').encode())
        with connection.makefile('rb') as stream:
            reply = json.loads(stream.readline())
    assert reply.get('ok'), reply
    return reply


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path)
    args = parser.parse_args()
    if sys.platform == 'win32':
        parser.error('this socket smoke test requires macOS or Linux')
    binary = args.binary.resolve() if args.binary else build(PACKAGE, release=False)
    with tempfile.TemporaryDirectory(prefix='scroll-inspect-') as temporary:
        directory = Path(temporary).resolve()
        address = directory / 'app.sock'
        with (directory / 'app.log').open('w+') as log:
            app = subprocess.Popen([str(binary)], cwd=REPO,
                env=dict(os.environ, SILK_UI_INSPECT=str(address)),
                stdout=log, stderr=subprocess.STDOUT)
            try:
                deadline = time.monotonic() + 15
                while True:
                    try:
                        hello = request(address, {'cmd': 'hello'})
                        break
                    except (OSError, ValueError):
                        if app.poll() is not None or time.monotonic() >= deadline:
                            raise AssertionError('scroll demo did not answer the inspector socket')
                        time.sleep(.1)
                assert hello['nodes'] > 0, hello
                tree = request(address, {'cmd': 'tree'})
                assert tree['nodes'], tree
                request(address, {'cmd': 'click', 'role': 'button', 'name': 'Reverse', 'exact': True})
                changed = request(address, {'cmd': 'query', 'name': 'Forward', 'exact': True})
                assert changed['count'] > 0, changed
                print('PASS: inspector connects, lists elements, and drives Reverse → Forward')
            except Exception:
                log.flush()
                log.seek(0)
                print(log.read(), file=sys.stderr)
                raise
            finally:
                if app.poll() is None:
                    app.terminate()
                    try:
                        app.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        app.kill()
                        app.wait()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
