//! Runs a ui-app [`Runtime`] in a native window: native/platform/window for the window and input,
//! ui-tree-window to turn window events into tree input, and ui_renderer on WebGPU (Dawn) for
//! the frames.
//!
//! The loop waits for window events, with a timeout at the runtime's next timer, or polls while
//! the app subscribes to animation frames. Input goes to the tree, the tree's records go to the
//! runtime, and a frame is drawn when the tree wants one.
//!
//! An app runs with the inspector (ui/inspect/server) when it passes one that is on to
//! [`runWindowWith`]: requests are served from the loop, input they dispatch is pumped to the app
//! like window input, the records the app takes go to the inspector's event log, and the
//! highlight is drawn over the frame.
//!
//! `check` mode ignores real input: after the first frame it clicks the node named
//! `options.checkClick` and presses Tab through the same path a user's input takes, draws two
//! more frames, reads the window's surface back and compares it with the CPU reference of the
//! same frame. It returns 0 within tolerance, 1 outside and 2 on an error.
import ui_scene.scene { Scene }
import font_collection.system as systemFonts
import font_collection.system { Options as FontOptions }
import silk.system.host_input { HostInput }
import ui_app.app { App, Perform }
import ui_app.runtime { Runtime, pump, tick, resize, frame }
import ui_app.harness { click, press }
import ui_tree.lib { UiTree, TreeError, FrameInput, Mutation }
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import window.event { Event }
import window.native { NativePlatform }
import window.types { WindowError, WindowId, WindowOptions }
import webgpu.runtime { Device, GpuError }
import webgpu.resources { Queue, TextureView }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Custom drawing integrated with the standard window, input, inspection and GPU lifecycle.
/// `frame` runs after layout and before uploads. Its resources use the tree's atlas; `scene`
/// supplies the finished composition, including UI chrome. `poll` collects background work.
pub interface WindowContent<A, M, C> {
  /// Initializes resources before the first view and configures native window options.
  effect fn setup(self: &mut Self, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  fn configure(self: &Self, options: &mut WindowOptions) -> () {}

  effect fn opened(self: &mut Self, platform: &mut NativePlatform, window: WindowId) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {}

  effect fn gpu(self: &mut Self, device: &Device, format: u32) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {}

  /// Native menus and dialogs; true consumes the event before ordinary input dispatch.
  effect fn event(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    event: &Event,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn update(
    self: &mut Self,
    app: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Return false to keep the window open, for example when a document save fails.
  effect fn closing(self: &mut Self, app: &mut Runtime<A, M, C>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return true
  }

  fn needsFrame(self: &Self, app: &Runtime<A, M, C>, tree: &UiTree) -> bool {
    return tree.needsFrame()
  }

  effect fn prepare(self: &mut Self, app: &mut Runtime<A, M, C>, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  fn profile(self: &Self) -> bool {
    return false
  }

  effect fn poll(self: &mut Self, app: &mut Runtime<A, M, C>, tree: &mut UiTree, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// A maximum wait in seconds while work needs polling, or None to wait for ordinary events.
  fn wakeAfter(self: &Self) -> Option<f64> {
    return Option<f64>.None
  }

  effect fn frame(
    self: &mut Self,
    app: &Runtime<A, M, C>,
    tree: &mut UiTree,
    input: FrameInput,
    inspector: &Inspector,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {}

  fn scene<'s>(self: &'s Self, tree: &'s UiTree) -> &'s Scene {
    return tree.scene()
  }

  effect fn draw(
    self: &mut Self,
    app: &Runtime<A, M, C>,
    renderer: &mut UiRenderer,
    device: &Device,
    queue: &Queue,
    tree: &UiTree,
    inspector: &Inspector,
    textures: &GpuAtlas,
    view: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    run renderer.draw(
      device,
      queue,
      inspector.sceneWith(self.scene(tree)),
      textures,
      view,
      width,
      height,
      color.white(),
    )
  }
}

/// The ordinary UI-tree composition, without custom content.
pub struct TreeContent {}

impl<A, M, C> WindowContent<A, M, C> for TreeContent {}

pub import ui_tree_window.host { RunOptions }
import ui_tree_window.host as host
import ui_tree_window.host { WindowClient }

/// Runs an app using fonts discovered in standard system and user font directories.
/// Use `runWindow` when an application supplies its own bundled font collection.
pub effect fn runSystemWindow<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  app: &mut Runtime<A, M, C>,
  resources: List<Mutation>,
  options: RunOptions,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut HostInput | &mut Allocator {
  let mut collection = FontCollection.make()
  drop run systemFonts.load(&mut collection, FontOptions.defaults())
  return run runWindow(&mut app, &collection, move resources, move options)
}

/// Runs `app` in a window until it is closed (or, in check mode, until the check is done).
/// `resources` are the mutations that define fonts, images and icons, applied first. Returns
/// the exit code.
pub effect fn runWindow<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  return run runWindowWith(&mut app, collection, move resources, move options, Inspector.off())
}

/// [`runWindow`] serving `inspector` (from `Inspector.start`, which is off unless the build and
/// `SILK_UI_INSPECT` allow it). Check mode does not serve it.
pub effect fn runWindowWith<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let mut content = TreeContent {}
  return run runWindowHosted(
    &mut app,
    collection,
    move resources,
    move options,
    move inspector,
    &mut content,
  )
}

/// Runs custom drawing and background work inside the standard window lifecycle.
pub effect fn runWindowHosted<
  H: WindowContent<A, M, C>,
  A: App<M, C>,
  M,
  C: Perform<M, E, R>,
  E,
  ? R
>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  content: &mut H,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let mut client: AppClient<A, M, C, H> = AppClient<A, M, C, H> { content: &mut content }
  return run host.runWindow<AppClient<A, M, C, H>, Runtime<A, M, C>, E, R>(
    &mut app,
    collection,
    move resources,
    move options,
    move inspector,
    &mut client,
  )
}

struct AppClient<'a, A, M, C, H> {
  content: &'a mut H
}

impl<'a, A: App<M, C>, M, C: Perform<M, E, R>, H: WindowContent<A, M, C>, E, ? R> WindowClient<
  Runtime<A, M, C>,
  E,
  R
> for AppClient<'a, A, M, C, H> {
  effect fn setup(self: &mut Self, state: &mut Runtime<A, M, C>, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.setup(&mut self.content.*, &mut tree)
  }

  fn configure(self: &Self, state: &Runtime<A, M, C>, options: &mut WindowOptions) -> () {
    return WindowContent<A, M, C>.configure(&self.content.*, &mut options)
  }

  effect fn opened(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.opened(&mut self.content.*, &mut platform, window)
  }

  effect fn gpu(self: &mut Self, state: &mut Runtime<A, M, C>, device: &Device, format: u32) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.gpu(&mut self.content.*, device, format)
  }

  effect fn event(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    event: &Event,
  ) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.event(&mut self.content.*, &mut state, &mut tree, event)
  }

  effect fn update(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.update(
      &mut self.content.*,
      &mut state,
      &mut tree,
      &mut platform,
      window,
    )
  }

  effect fn closing(self: &mut Self, state: &mut Runtime<A, M, C>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.closing(&mut self.content.*, &mut state)
  }

  fn needsFrame(self: &Self, state: &Runtime<A, M, C>, tree: &UiTree) -> bool {
    return WindowContent<A, M, C>.needsFrame(&self.content.*, &state.*, tree)
  }

  effect fn prepare(self: &mut Self, state: &mut Runtime<A, M, C>, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.prepare(&mut self.content.*, &mut state, &mut tree)
  }

  fn profile(self: &Self, state: &Runtime<A, M, C>) -> bool {
    return WindowContent<A, M, C>.profile(&self.content.*)
  }

  effect fn poll(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    time: f64,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.poll(&mut self.content.*, &mut state, &mut tree, time)
  }

  fn wakeAfter(self: &Self, state: &Runtime<A, M, C>) -> Option<f64> {
    return WindowContent<A, M, C>.wakeAfter(&self.content.*)
  }

  effect fn frame(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    input: FrameInput,
    inspector: &Inspector,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.frame(
      &mut self.content.*,
      &state.*,
      &mut tree,
      input,
      inspector,
    )
  }

  fn scene<'s>(self: &'s Self, state: &'s Runtime<A, M, C>, tree: &'s UiTree) -> &'s Scene {
    return WindowContent<A, M, C>.scene(&self.content.*, tree)
  }

  effect fn draw(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    renderer: &mut UiRenderer,
    device: &Device,
    queue: &Queue,
    tree: &UiTree,
    inspector: &Inspector,
    textures: &GpuAtlas,
    view: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    return run WindowContent<A, M, C>.draw(
      &mut self.content.*,
      &state.*,
      &mut renderer,
      device,
      queue,
      tree,
      inspector,
      textures,
      view,
      width,
      height,
    )
  }

  effect fn start(self: &mut Self, state: &mut Runtime<A, M, C>, tree: &mut UiTree) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run state.start(&mut tree, 0.0)
  }

  effect fn pump(self: &mut Self, state: &mut Runtime<A, M, C>, tree: &mut UiTree) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    drop run pump(&mut state, &mut tree)
  }

  effect fn tick(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    time: f64,
    animation: bool,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run tick(&mut state, &mut tree, time, animation)
  }

  effect fn resize(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    width: f32,
    height: f32,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run resize(&mut state, &mut tree, width, height)
  }

  effect fn layout(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    input: FrameInput,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run frame(&mut state, &mut tree, input)
  }

  fn nextDeadline(self: &Self, state: &Runtime<A, M, C>) -> Option<f64> {
    return state.nextDeadline()
  }

  fn wantsFrames(self: &Self, state: &Runtime<A, M, C>) -> bool {
    return state.wantsFrames()
  }

  effect fn checkInput(
    self: &mut Self,
    state: &mut Runtime<A, M, C>,
    tree: &mut UiTree,
    input: FrameInput,
    name: string,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    drop run click(&mut state, &mut tree, input, name)
    run press(&mut state, &mut tree, input, "Tab", 0)
  }
}
