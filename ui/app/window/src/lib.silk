//! Runs a ui-app [`Runtime`] in a native window: platform/window for the window and input,
//! ui-tree-window to turn window events into tree input, and ui_renderer on WebGPU (Dawn) for
//! the frames.
//!
//! The loop waits for window events, with a timeout at the runtime's next timer, or polls while
//! the app subscribes to animation frames. Input goes to the tree, the tree's records go to the
//! runtime, and a frame is drawn when the tree wants one.
//!
//! An app runs with the inspector (ui/inspect/server) when it passes one that is on to
//! [`runWindowWith`]: requests are served from the loop, input they dispatch is pumped to the app
//! like window input, the records the app takes go to the inspector's event log, and the
//! highlight is drawn over the frame.
//!
//! `check` mode ignores real input: after the first frame it clicks the node named
//! `options.checkClick` and presses Tab through the same path a user's input takes, draws two
//! more frames, reads the window's surface back and compares it with the CPU reference of the
//! same frame. It returns 0 within tolerance, 1 outside and 2 on an error.
import ui_app.app { App, Perform }
import ui_app.runtime { Runtime, pump, tick, resize }
import ui_app.harness { click, press }
import ui_tree.inspect { findAll }
import ui_tree.lib { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import ui_tree_window.lib { feed, windowCursor }
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import demo.compare { Tolerance, compare }
import demo_host.frames { copyOut, isBgra, pickFormat, readbackSize, unpack }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import window.event { Event }
import window.native { NativePlatform }
import window.platform { Platform }
import window.types { Cursor, RawSurface, Wait, WindowError, WindowId, WindowOptions }
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources { Queue, Texture, getQueue }
import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.size { Size2 }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64
import silk.num.i64
import silk.num.u64

/// How to open the window.
pub struct RunOptions {
  pub title: string<'static>,
  /// The content size in logical points (CSS pixels).
  pub width: f64,
  pub height: f64,
  /// Script and check the frame instead of taking input (see the module documentation).
  pub check: bool,
  /// The test id, label or text of the node `check` clicks.
  pub checkClick: string<'static>,
  /// The test id, label or text of a node that must exist after the click.
  pub checkExpect: string<'static>,
}

/// The frame `check` reads back: the scripted input goes in after frame 1.
const CHECK_FRAME: u64 = 3

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

fn deviceSize(logical: f64, scale: f64) -> u32 {
  return f64.toU32(f64.floor(logical * scale + 0.5))
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut OsMonotonicClock) -> f64 {
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&now))
    + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000000.0
}

/// Whether a node's test id, label or text is `value`.
effect fn exists(tree: &UiTree, value: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, value, &mut found)
  return found.length() != 0
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns the exit code.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}

/// Runs `app` in a window until it is closed (or, in check mode, until the check is done).
/// `resources` are the mutations that define fonts, images and icons, applied first. Returns
/// the exit code.
pub effect fn runWindow<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  return run runWindowWith(&mut app, collection, move resources, move options, Inspector.off())
}

/// [`runWindow`] serving `inspector` (from `Inspector.start`, which is off unless the build and
/// `SILK_UI_INSPECT` allow it). Check mode does not serve it.
pub effect fn runWindowWith<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let mut host = NoHost {}
  return run runWindowHosting(
    &mut app,
    collection,
    move resources,
    move options,
    move inspector,
    &mut host,
  )
}

/// Native content an app shows in its window next to the tree, such as web views
/// (platform/webview) on `ui.hosted` nodes. The loop calls it at fixed points; everything it
/// tells the app goes in as messages.
///
/// Native child views (WKWebView, WebView2) only need `opened`, `framed` and `poll`. Content
/// drawn offscreen (Chromium) also takes the window's input over its nodes (`input`), uploads
/// its frames before each frame is drawn (`present`), sets the cursor over itself (`cursor`)
/// and asks for frames and turns of the loop (`wantsFrame`, `nextTurn`). `exitCode` ends the loop.
pub interface WindowHost<A, M> {
  /// The window is open (`window` is its `WindowId.value`).
  effect fn opened(self: &mut Self, window: u32) -> () ! OutOfMemoryError ? &mut Allocator

  /// The tree laid out a frame: move native content onto its hosted nodes
  /// (`ui_tree.hosted.hostedPlacements`).
  effect fn framed(self: &mut Self, tree: &UiTree) -> () ! OutOfMemoryError ? &mut Allocator

  /// Once per turn of the loop, after input: take the work the model queued for the host and
  /// append messages for what the host reports. Returns whether any were appended.
  effect fn poll(self: &mut Self, model: &mut A, out: &mut List<M>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator

  /// A window event (input; not resizes, frames or closing) before the tree sees it. Returns
  /// true when the host took it, and the tree then does not get it.
  effect fn input(self: &mut Self, event: &Event) -> bool ! OutOfMemoryError ? &mut Allocator

  /// Just before a frame is drawn: put the host's pixels where `renderer` draws them (surface
  /// textures for hosted nodes).
  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator

  /// The cursor while the pointer is over the host's content, or None for the tree's.
  fn cursor(self: &Self) -> Option<Cursor>

  /// Whether the host has new pixels to show: the loop requests a frame.
  fn wantsFrame(self: &mut Self) -> bool

  /// Seconds until the host needs a turn of the loop without any event, or None.
  fn nextTurn(self: &Self) -> Option<f64>

  /// The exit code once the host wants the app to end (a scripted check that finished), or None.
  fn exitCode(self: &Self) -> Option<i32>
}

/// No native content.
pub struct NoHost {}

impl<A, M> WindowHost<A, M> for NoHost {
  effect fn opened(self: &mut Self, window: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  effect fn framed(self: &mut Self, tree: &UiTree) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  effect fn poll(self: &mut Self, model: &mut A, out: &mut List<M>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn input(self: &mut Self, event: &Event) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn present(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    renderer: &mut UiRenderer,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    return ()
  }

  fn cursor(self: &Self) -> Option<Cursor> {
    return Option<Cursor>.None
  }

  fn wantsFrame(self: &mut Self) -> bool {
    return false
  }

  fn nextTurn(self: &Self) -> Option<f64> {
    return Option<f64>.None
  }

  fn exitCode(self: &Self) -> Option<i32> {
    return Option<i32>.None
  }
}

/// The host's cursor over its content, else the tree's.
fn cursorOf<A, M, H: WindowHost<A, M>>(host: &H, tree: &UiTree) -> Cursor {
  return match host.cursor() {
    Option<Cursor>.Some { value } => value
    Option<Cursor>.None => windowCursor(tree.cursor())
  }
}

/// The sooner of two waits in seconds, negative meaning none.
fn sooner(a: f64, b: Option<f64>) -> f64 {
  return match b {
    Option<f64>.Some { value } => if a < 0.0 || value < a {
      if value < 0.0 {
        0.0
      } else {
        value
      }
    } else {
      a
    }
    Option<f64>.None => a
  }
}

/// [`runWindowWith`] with native content from `host` (see [`WindowHost`]).
pub effect fn runWindowHosting<A: App<M, C>, M, C: Perform<M, E, R>, E, H: WindowHost<A, M>, ? R>(
  app: &mut Runtime<A, M, C>,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  host: &mut H,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let check = options.check
  let mut inspector = if check {
    drop inspector
    Inspector.off()
  } else {
    move inspector
  }
  let mut clock = OsMonotonicClock.make()
  let started = run seconds(&mut clock)
  let mut tree = run UiTree.make(collection)
  run tree.apply(move resources)
  run app.start(&mut tree, 0.0)
  let mut snapshot = CpuSnapshot.make()

  let mut platform = run NativePlatform.start()
  let mut windowOptions = WindowOptions.make(options.title, options.width, options.height)
  windowOptions.minSize = Option<Size2<f64>>.some(Size2<f64>.new(240.0, 200.0))
  let window = run platform.openWindow(&windowOptions)
  run host.opened(window.value)
  let mut hosted = List<M>.make()
  let owner = window
  let raw = platform.rawSurface(window)
  let target = match unsafe targetOf(&owner, raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-app: this backend has no GPU surface\n", &())
      return 2
    }
  }
  let instance = run Instance.create()
  let surface = run Surface.create(&instance, &target, String.utf8Bytes("ui app"))
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&surface))
  let capabilities = run surface.getCapabilities(&adapter)
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-app: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    return 2
  }
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, format)
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  if check {
    let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
    if !canCopy {
      StderrWriter.print("ui-app: the surface cannot be read back\n", &())
      return 2
    }
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
    renderer.setTextSettings(TextSettings.none())
  }
  if capabilities.alphaModes().length != 0 {
    configuration.setAlphaMode(capabilities.alphaModes()[0])
  }

  let initial = platform.contentSize(window)
  let mut width = initial.width
  let mut height = initial.height
  let mut scale = platform.scaleFactor(window)
  let mut configured = false
  let mut drawn: u64 = 0
  let mut status: i32 = 0
  run resize(&mut app, &mut tree, f64.toF32(width), f64.toF32(height))
  platform.requestFrame(owner)
  while true {
    // Wait for input or a frame, at most until the next timer.
    let now = (run seconds(&mut clock)) - started
    let wait = if check {
      Wait.Poll
    } else {
      let deadline = sooner(
        match app.nextDeadline() {
          Option<f64>.Some { value } => if value > now {
            value - now
          } else {
            0.0
          }
          Option<f64>.None => -1.0
        },
        host.nextTurn(),
      )
      match inspector.pollInterval() {
        Option<f64>.Some { value } => Wait.Seconds {
          seconds: if deadline >= 0.0 && deadline < value {
            deadline
          } else {
            value
          },
        }
        Option<f64>.None => if deadline >= 0.0 {
          Wait.Seconds { seconds: deadline }
        } else {
          Wait.Forever
        }
      }
    }
    let next = run platform.nextEvent(wait)
    let time = (run seconds(&mut clock)) - started
    let mut redraw = false
    if !check {
      run tick(&mut app, &mut tree, time, false)
      redraw = tree.needsFrame()
    }
    if run inspector.poll(&mut tree) {
      // Input from the inspector is answered like window input.
      run inspector.observe(&tree)
      drop run pump(&mut app, &mut tree)
      platform.setCursor(owner, cursorOf<A, M, H>(&host, &tree))
      redraw = true
    }
    if let Option<Event>.Some { value } = &next {
      let mut resized = false
      match &value {
        Event.RequestFrame { window: which, targetTime } => {
          if configured || deviceSize(width, scale) > 0 {
            if !configured {
              surface.resize(
                &mut configuration,
                deviceSize(width, scale),
                deviceSize(height, scale),
              )
              configured = true
            }
            let viewport = FrameInput {
              width: f64.toF32(width),
              height: f64.toF32(height),
              scale: f64.toF32(scale),
              time: targetTime,
            }
            if check && drawn == 1 {
              drop run click(&mut app, &mut tree, viewport, options.checkClick)
              run press(&mut app, &mut tree, viewport, "Tab", 0)
            }
            if !check && app.wantsFrames() {
              run tick(&mut app, &mut tree, time, true)
            }
            run tree.frame(viewport)
            run host.framed(&tree)
            run textures.sync(&device, &tree.atlas)
            let pending = tree.pendingUploads()
            let list = pending.entries()
            let mut i: usize = 0
            while i < list.length {
              textures.write(&queue, list[i].tile, pending.pixels(list[i]))
              i = i + 1
            }
            run host.present(&device, &queue, &mut renderer)
            run inspector.afterFrame(&tree)
            run snapshot.sync(&mut tree)
            let deviceWidth = deviceSize(width, scale)
            let deviceHeight = deviceSize(height, scale)
            let texture = run surface.getCurrentTexture()
            let view = run texture.texture.createView(&TextureViewDescriptor.default())
            run renderer.draw(
              &device,
              &queue,
              inspector.scene(&tree),
              &textures,
              &view,
              deviceWidth,
              deviceHeight,
              color.white(),
            )
            drawn = drawn + 1
            if check && drawn == CHECK_FRAME && !(run exists(&tree, options.checkExpect)) {
              StderrWriter.print("check: the scripted click did not reach the app\n", &())
              status = 1
            } else if check && drawn == CHECK_FRAME {
              let reference = run snapshot.render(&tree)
              status = run checkFrame(
                &device,
                &queue,
                &texture.texture,
                isBgra(format),
                reference.data(),
                deviceWidth,
                deviceHeight,
              )
            }
            run surface.present()
            run device.checkErrors()
            if check && drawn >= CHECK_FRAME {
              break
            }
            platform.setCursor(owner, cursorOf<A, M, H>(&host, &tree))
          }
          redraw = check || app.wantsFrames() || tree.needsFrame()
        }
        Event.Resized { window: which, size, scaleFactor } => {
          width = size.width
          height = size.height
          scale = scaleFactor
          resized = true
        }
        Event.ScaleFactorChanged { window: which, scaleFactor } => {
          scale = scaleFactor
          resized = true
        }
        Event.CloseRequested { window: which } => {
          break
        }
        Event.QuitRequested => {
          break
        }
        _ => {
          if !check && run host.input(&value) {
            platform.setCursor(owner, cursorOf<A, M, H>(&host, &tree))
          } else if !check && run feed(&mut tree, &value) {
            run inspector.observe(&tree)
            drop run pump(&mut app, &mut tree)
            platform.setCursor(owner, cursorOf<A, M, H>(&host, &tree))
            redraw = tree.needsFrame()
          }
        }
      }
      if resized {
        let w = deviceSize(width, scale)
        let h = deviceSize(height, scale)
        if w > 0 && h > 0 {
          surface.resize(&mut configuration, w, h)
          configured = true
        }
        run resize(&mut app, &mut tree, f64.toF32(width), f64.toF32(height))
        redraw = true
      }
    }
    if !check && run host.poll(&mut app.model, &mut hosted) {
      while hosted.length() != 0 {
        app.send(hosted.remove(0))
      }
      drop run pump(&mut app, &mut tree)
      redraw = true
    }
    if let Option<i32>.Some { value } = host.exitCode() {
      status = value
      break
    }
    if !check && host.wantsFrame() {
      redraw = true
    }
    if redraw {
      platform.requestFrame(owner)
    }
  }
  run inspector.close()
  surface.unconfigure()
  platform.closeWindow(owner)
  return status
}
