//! Run through tests/http-test, which owns the loopback fixture server.
import ui_app_window.images { Images, ImageState, ImageError }
import ui_tree.lib { UiTree, TreeError }
import ui_fixtures.fixtures as fixtures
import silk.concurrency.thread_native { NativeThread }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn body() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut images = Images.make()
  run images.url(1, "http://127.0.0.1:28183/photo-08.png")
  run images.url(2, "http://127.0.0.1:28183/missing.png")
  while images.pending() {
    drop run images.poll(&mut tree)
    NativeThread.yieldNow()
  }
  run Testing.expect(
    images.state(1) == ImageState.Ready && tree.resources.images.length() == 1,
    "HTTP response bytes are decoded and installed off the UI thread",
  )
  run Testing.expect(
    images.state(2) == ImageState.Failed && images.error(2) == ImageError.HttpStatus,
    "HTTP errors remain distinct from decoding and transport errors",
  )
}

test effect fn httpImages() -> ()
  ! TreeError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}
