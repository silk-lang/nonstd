//! The todo example in a native window.
//!
//!   ui-app-demo [--check]
//!
//! Click the boxes to toggle items, Delete to remove one, Add or Ctrl+N to add one, and the
//! filters to show some. Tab and Shift+Tab move focus; Enter and Space press the focused
//! button. Saving goes to an in-memory store.
//!
//! In a debug build with `SILK_UI_INSPECT` set it serves the inspector protocol, so the devtools
//! window (ui/inspect/devtools) and ui-inspect-cli can inspect and drive it.
//!
//! `--check` ignores real input: it clicks Add and presses Tab, then compares the window's
//! surface with the CPU reference of the same frame. Exit code 0 within tolerance, 1 outside,
//! 2 on an error.
import ui_app_examples.todo { Todo, Message, Command, Store }
import ui_app_examples.look { SANS }
import ui_app.runtime { Runtime }
import ui_app_window.lib { Launched, RunOptions, launch, runWindowWith, startInspector }
import ui_inspect_server.lib { InspectorOptions }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { TreeError, Batch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }

/// Keeps the saved count in memory.
struct MemoryStore {
  saves: u64,
}

impl Store for MemoryStore {
  effect fn save(self: &mut Self, count: u64) -> u64 {
    self.saves = self.saves + 1
    return count
  }
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn checkMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), b"--check") {
        return true
      }
    }
    i = i + 1
  }
  return false
}

effect fn program(check: bool, platform: Option<Launched>) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut batch = Batch.make()
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  let mut app = Runtime<Todo, Message, Command>.make(run Todo.make())
  let mut store = MemoryStore { saves: 0 }
  let options = RunOptions {
    title: "Todos",
    width: 360.0,
    height: 300.0,
    check: check,
    checkClick: "Add",
    checkExpect: "Task 4",
    lowestLatency: false,
    platform: move platform,
  }

  // Debug builds with SILK_UI_INSPECT set serve the inspector (ui/inspect/server), so
  // ui-inspect-cli, ui-inspect-mcp and the devtools window can look at the list.
  let inspector = run startInspector(InspectorOptions.make())
  return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
    |> Effect.provideMut<Store>(&mut store)
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("ui-app-demo: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("ui-app-demo: GPU error {}\n", &.(error.code))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-app-demo: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

effect fn noCheck<E>(error: E) -> bool {
  drop error
  return false
}

/// The app, on the UI thread `launch` made.
fn runApp(check: bool, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<GpuError>(
      Effect.catch<WindowError>(program(check, move platform), windowFailed),
      gpuFailed,
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let check = run Effect.catchAll(checkMode(), noCheck)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      fn(platform: Option<Launched>) -> i32 {
        return runApp(check, move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
