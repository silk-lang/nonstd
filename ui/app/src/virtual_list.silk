//! View bookkeeping for virtual items. Geometry and virtualization policy belong to ui-tree.
pub import ui_tree.virtual_list { VirtualOptions }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.usize

/// One keyed item emitted by the view.
pub struct VirtualRow {
  /// Logical item index.
  pub index: usize,
  /// Entry in the view arena, resolved to a client node ID by the backend adapter.
  pub entry: u32,
}

impl Copy for VirtualRow {}

/// A view's identity and last backend range request, with no layout geometry.
pub struct VirtualList {
  /// Stable view identity.
  pub key: u64,
  /// Configuration forwarded to the backend.
  pub options: VirtualOptions,
  /// Logical item count.
  pub count: usize,
  /// Current view items.
  pub rows: List<VirtualRow>,
  /// Arena entry of the scroll container.
  pub port: u32,
  /// First requested item.
  pub first: usize,
  /// Exclusive requested end.
  pub end: usize,
  /// Whether this render visited the list.
  pub seen: bool,
  /// Item retained by the backend for focus, or `usize.MAX`.
  pub pinned: usize,
  /// Key of the retained item, used when the model reorders items.
  pub pinnedKey: u64,
}

impl VirtualList {
  /// Creates empty view bookkeeping. The backend requests the initial range.
  pub fn make(key: u64, options: VirtualOptions) -> VirtualList {
    return VirtualList {
      key: key,
      options: options,
      count: 0,
      rows: List<VirtualRow>.make(),
      port: 0,
      first: 0,
      end: 0,
      seen: true,
      pinned: usize.MAX,
      pinnedKey: 0,
    }
  }
}
