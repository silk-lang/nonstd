//! Variable-height list geometry used by `Ui.virtualItems` and the app runtime.
//! Only the visible range and an overscan region need UI nodes. Measured heights
//! replace estimates, while the runtime preserves the first visible item.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.usize

/// Configuration for a vertical list with measured item heights.
pub struct VirtualOptions {
  /// Estimated height of each unmeasured item, in CSS pixels. Must be finite and positive.
  pub estimatedHeight: f32,
  /// Extra content mounted above and below the viewport, in CSS pixels. Must be finite and nonnegative.
  pub overscan: f32,
  /// Space after each item, in CSS pixels. Must be finite and nonnegative.
  pub gap: f32,
  /// Change this value when item order or size-affecting content changes.
  pub revision: u64,
}

impl Copy for VirtualOptions {}

/// One mounted item and its entry in the current UI arena.
pub struct VirtualRow {
  /// Logical item index.
  pub index: usize,
  /// UI arena entry of the item's wrapper.
  pub entry: u32,
}

impl Copy for VirtualRow {}

/// Retained geometry for one virtual list. Managed by the UI builder and runtime.
pub struct VirtualList {
  /// Stable identity of this list in the view.
  pub key: u64,
  /// Current list configuration.
  pub options: VirtualOptions,
  /// Estimated or measured item heights, including gaps.
  pub heights: List<f32>,
  sums: List<f64>,
  /// Mounted item entries from the latest render.
  pub rows: List<VirtualRow>,
  /// UI arena entry of the scroll container.
  pub port: u32,
  /// First item in the mounted viewport range.
  pub first: usize,
  /// Exclusive end of the mounted viewport range.
  pub end: usize,
  /// Current vertical offset in CSS pixels.
  pub scroll: f32,
  /// Last measured width of the scroll container.
  pub width: f32,
  /// Last measured height of the scroll container.
  pub height: f32,
  /// Whether the current render visited this list.
  pub seen: bool,
  /// Whether the runtime must restore the scroll anchor.
  pub correction: bool,
  /// Focused item kept mounted outside the viewport range, or `usize.MAX`.
  pub pinned: usize,
  /// Stable key of the focused item.
  pub pinnedKey: u64,
}

impl VirtualList {
  /// Creates empty list geometry for the UI runtime.
  pub fn make(key: u64, options: VirtualOptions) -> VirtualList {
    return VirtualList {
      key: key,
      options: options,
      heights: List<f32>.make(),
      sums: List<f64>.make(),
      rows: List<VirtualRow>.make(),
      port: 0,
      first: 0,
      end: 0,
      scroll: 0.0,
      width: 0.0,
      height: 800.0,
      seen: true,
      correction: false,
      pinned: usize.MAX,
      pinnedKey: 0,
    }
  }

  /// Replaces all measurements with estimates for `count` items.
  pub effect fn reset(self: &mut Self, count: usize, options: VirtualOptions) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.options = options
    self.heights.clear()
    self.sums.clear()
    let estimate = f32.max(1.0, options.estimatedHeight) + f32.max(0.0, options.gap)
    run self.heights.appendRepeated(estimate, count)
    run self.sums.append(0.0)
    let mut i: usize = 1
    while i <= count {
      let low = i - usize.bitAnd(i, i - 1)
      run self.sums.append(usize.toF64(low) * f32.toF64(estimate))
      i = i + 1
    }
    drop self.range(true)
  }

  /// Returns the estimated or measured position before item `end`.
  /// `end` must not exceed the item count.
  pub fn prefix(self: &Self, end: usize) -> f32 {
    let mut i = end
    let mut total = 0.0
    while i > 0 {
      total = total + self.sums.get(i)
      i = usize.bitAnd(i, i - 1)
    }
    return f64.toF32(total)
  }

  /// Returns the item at `position`, or the item count at the end.
  pub fn locate(self: &Self, position: f32) -> usize {
    let mut bit: usize = 1
    while bit <= self.heights.length() / 2 {
      bit = bit * 2
    }
    let mut at: usize = 0
    let mut sum = 0.0
    while bit > 0 {
      let next = at + bit
      if next <= self.heights.length() && sum + self.sums.get(next) <= f32.toF64(position) {
        at = next
        sum = sum + self.sums.get(next)
      }
      bit = bit / 2
    }
    return at
  }

  /// Updates one measured height and returns whether it changed.
  /// `index` must be less than the item count.
  pub fn measure(self: &mut Self, index: usize, height: f32) -> bool {
    let value = f32.max(1.0, height)
    let delta = value - self.heights.get(index)
    if f32.abs(delta) < 0.25 {
      return false
    }
    self.heights.set(index, value)
    let mut i = index + 1
    while i < self.sums.length() {
      let sum = self.sums.get(i) + f32.toF64(delta)
      self.sums.set(i, sum)
      i = i + (i - usize.bitAnd(i, i - 1))
    }
    return true
  }

  /// Updates the mounted range, retaining overscan until its inner margin is crossed.
  pub fn range(self: &mut Self, force: bool) -> bool {
    let overscan = f32.max(0.0, self.options.overscan)
    let margin = overscan * 0.25
    if !force && (self.first == 0 || self.prefix(self.first) <= self.scroll - margin)
      && (self.end == self.heights.length()
        || self.prefix(self.end) >= self.scroll + self.height + margin) {
      return false
    }
    let first = self.locate(f32.max(0.0, self.scroll - overscan))
    let candidate = self.locate(self.scroll + self.height + overscan) + 1
    let end = if candidate < self.heights.length() {
      candidate
    } else {
      self.heights.length()
    }
    let changed = first != self.first || end != self.end
    self.first = first
    self.end = end
    return changed
  }
}
