//! Deterministic Block tests with explicit command simulation and immutable observations.
//!
//! A `Story` owns a real Block instance. Deliver local or parent messages, observe
//! model projections, and consume commands in exact order. Nested child messages
//! use the parent's typed message constructors, so normal binding routing and
//! outgoing-message folds run. `finish` rejects unhandled commands and returns the
//! final instance; dropping it releases the owned implementation and model.
import block { Block, Instance, Layer, build }
import silk.core.option { Option }

/// A Story ended with unhandled commands or an ordered command assertion failed.
pub union StoryError {
  /// Commands remain when the caller attempts to finish the Story.
  PendingCommands {
    /// The number of commands that remain unhandled.
    pub count: usize,
  },
  /// The pending queue and the expected sequence have different lengths.
  CommandCount {
    /// The number of commands supplied by the assertion.
    pub expected: usize,
    /// The number of commands waiting in the Story.
    pub actual: usize,
  },
  /// The command at `index` did not match the expected command.
  CommandMismatch {
    /// The zero-based position of the first unequal command.
    pub index: usize,
  },
}

/// A Block test driver that records outputs instead of automatically performing commands.
pub struct Story<B, S, M, I, O, C, A> {
  /// The real implementation, model and accumulated transition outputs.
  pub instance: Instance<B, S, M, I, O, C, A>,
}

impl<B: Block<S, M, I, O, C, A>, S, M, I, O, C, A> Story<B, S, M, I, O, C, A> {
  /// Starts a Story from a constructed implementation, recording initialization commands.
  pub fn make(implementation: B, args: A) -> Story<B, S, M, I, O, C, A> {
    return Story<B, S, M, I, O, C, A> {
      instance: Instance<B, S, M, I, O, C, A>.make(move implementation, move args),
    }
  }

  /// Constructs a real implementation through its Layer and records model initialization.
  pub effect fn fromLayer<L: Layer<B, E, R>, E, ? R>(layer: L, args: A) -> Story<
    B,
    S,
    M,
    I,
    O,
    C,
    A
  >
    ! E
    ? R {
    return Story<B, S, M, I, O, C, A> {
      instance: run build<B, S, M, I, O, C, A, L, E, R>(move layer, move args),
    }
  }

  /// Delivers a local message through the real Block update.
  pub fn message(self: &mut Self, message: M) -> () {
    self.instance.message(move message)
  }

  /// Delivers a parent request through the Block's separate input channel.
  pub fn receive(self: &mut Self, message: I) -> () {
    self.instance.receive(move message)
  }

  /// Delivers a child event through a typed parent envelope or nested envelope path.
  /// Normal parent handling, binding checks and outgoing-message folds all run.
  pub fn messageIn<N>(self: &mut Self, message: N, path: once fn(N) -> M) -> () {
    self.message(path(move message))
  }

  /// Returns an owned observation of the current model, without borrowing the Story.
  /// Copy a projection or clone owned fields so later updates cannot alter this observation.
  pub fn model<T>(self: &Self, snapshot: fn(&S) -> T) -> T {
    return snapshot(&self.instance.model)
  }

  /// Returns the oldest command, removing it, or `None` if there are no commands.
  pub fn takeCommand(self: &mut Self) -> Option<C> {
    if self.instance.pending.commands.commands.length() == 0 {
      return Option<C>.None
    }
    return Option<C>.Some { value: self.instance.pending.commands.commands.remove(0) }
  }

  /// Returns the oldest outgoing message, removing it, or `None` if none remain.
  pub fn takeOutgoing(self: &mut Self) -> Option<O> {
    if self.instance.pending.outgoing.length() == 0 {
      return Option<O>.None
    }
    return Option<O>.Some { value: self.instance.pending.outgoing.remove(0) }
  }

  /// Simulates the oldest command and dispatches its result; returns false for an empty queue.
  /// The simulator runs once. Commands produced by the result remain pending for later steps.
  pub fn resolve(self: &mut Self, perform: once fn(C) -> M) -> bool {
    match move self.takeCommand() {
      Option<C>.Some { value } => {
        self.message(perform(move value))
        return true
      }
      Option<C>.None => {
        return false
      }
    }
  }

  /// Checks the complete pending command queue in order without consuming it.
  /// Fails with the first mismatch or a count error. Use `resolve` to dispatch results.
  pub effect fn expectExactInOrder(self: &Self, expected: &[C], same: fn(&C, &C) -> bool) -> ()
    ! StoryError {
    let commands = self.instance.pending.commands.commands.asSlice()
    if commands.length != expected.length {
      fail StoryError.CommandCount { expected: expected.length, actual: commands.length }
    }
    let mut i: usize = 0
    while i < commands.length {
      if !same(&commands[i], &expected[i]) {
        fail StoryError.CommandMismatch { index: i }
      }
      i = i + 1
    }
  }

  /// Returns the final instance only when every recorded command has been handled.
  /// Outgoing messages remain on the returned instance for host assertions.
  pub effect fn finish(self: Self) -> Instance<B, S, M, I, O, C, A>
    ! StoryError {
    let count = self.instance.pending.commands.commands.length()
    if count != 0 {
      fail StoryError.PendingCommands { count: count }
    }
    return move self.instance
  }
}
