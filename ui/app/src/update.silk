//! Ordered, pure update composition with shared command and outgoing-message channels.
//!
//! Updates borrow the dispatched message, so an affine payload can be inspected by
//! several steps. Each step sees the model left by the previous step. `observe`
//! takes an owned projection before a transition for undo history or change detection.
import block { BlockContext }

/// Runs two updates in order on the same model, message and output context.
/// The second update sees all model changes and outputs from the first.
pub fn compose<S, M, C, O>(
  model: &mut S,
  message: &M,
  cx: &mut BlockContext<C, O>,
  first: fn(&mut S, &M, &mut BlockContext<C, O>) -> (),
  second: fn(&mut S, &M, &mut BlockContext<C, O>) -> (),
) -> () {
  first(&mut model, &message, &mut cx)
  second(&mut model, &message, &mut cx)
}

/// Applies an update for each operation in slice order, preserving all outputs.
/// An empty slice leaves the model and outputs unchanged.
pub fn each<S, M, C, O, T>(
  model: &mut S,
  message: &M,
  cx: &mut BlockContext<C, O>,
  steps: &[T],
  apply: fn(&T, &mut S, &M, &mut BlockContext<C, O>) -> (),
) -> () {
  let mut i: usize = 0
  while i < steps.length {
    apply(&steps[i], &mut model, &message, &mut cx)
    i = i + 1
  }
}

/// Runs an update only when the message satisfies `matches`.
pub fn on<S, M, C, O>(
  model: &mut S,
  message: &M,
  cx: &mut BlockContext<C, O>,
  matches: fn(&M) -> bool,
  step: fn(&mut S, &M, &mut BlockContext<C, O>) -> (),
) -> () {
  if matches(&message) {
    step(&mut model, &message, &mut cx)
  }
}

/// Runs an update unless the message satisfies `excluded`.
pub fn except<S, M, C, O>(
  model: &mut S,
  message: &M,
  cx: &mut BlockContext<C, O>,
  excluded: fn(&M) -> bool,
  step: fn(&mut S, &M, &mut BlockContext<C, O>) -> (),
) -> () {
  if !excluded(&message) {
    step(&mut model, &message, &mut cx)
  }
}

/// Takes an owned observation before updating, then passes it to an after-update step.
///
/// `snapshot` must return independent data to preserve an immutable observation.
/// Select the needed fields or explicitly clone owned data. The after-update step
/// sees the resulting model and can append history or outputs. Exclude undo/redo
/// messages with `except` when composing an undo-history observer.
pub fn observe<S, M, C, O, T>(
  model: &mut S,
  message: &M,
  cx: &mut BlockContext<C, O>,
  snapshot: fn(&S) -> T,
  step: fn(&mut S, &M, &mut BlockContext<C, O>) -> (),
  after: fn(T, &mut S, &M, &mut BlockContext<C, O>) -> (),
) -> () {
  let before = snapshot(&model)
  step(&mut model, &message, &mut cx)
  after(move before, &mut model, &message, &mut cx)
}
