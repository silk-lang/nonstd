//! Driving an app without a window, for tests, scripts and agents: synthetic input goes through
//! the tree's real dispatch path, so a test clicks a button the way a user does.
//!
//! Each call draws a frame first (the tree hit-tests against the last frame's layout), feeds the
//! input, handles the records, and draws again.
import app { App, Perform }
import runtime { Runtime, pump }
import ui_tree.input { Input, BUTTON_PRIMARY }
import ui_tree.mutation { Role }
import ui_tree.inspect { NodeInfo, DescribeOptions, findAll, info, describe }
import ui_tree.node { FrameInput, NONE }
import silk.num.u32
import ui_tree.tree { UiTree, TreeError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// The center of the first node whose test id, label or text is `value`, after a frame.
pub effect fn locate(tree: &mut UiTree<'_>, viewport: FrameInput, value: string) -> Option<NodeInfo>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(viewport)
  let mut found = List<u32>.make()
  run findAll(&tree, value, &mut found)
  if found.length() == 0 {
    return Option<NodeInfo>.None
  }
  return run info(&tree, found.get(0))
}

/// The first node with role `accessRole` whose label (or test id, or text) is `name`, after a
/// frame: what a person would call "the Save button". A node named by its text, such as a
/// button's label, is found through the text: the nearest ancestor with the role counts,
/// unless a node with another role is in between.
pub effect fn locateRole(
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  accessRole: Role,
  name: string,
) -> Option<NodeInfo>
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(viewport)
  let mut found = List<u32>.make()
  run findAll(&tree, name, &mut found)
  let mut i: usize = 0
  while i < found.length() {
    // The node itself, or the nearest ancestor with the role: a button named by its text.
    let mut slot = tree.slotOf(found.get(i))
    while slot != NONE {
      let node = tree.node(slot)
      if node.accessRole == accessRole {
        return run info(&tree, node.id)
      }
      if node.accessRole != Role.None && slot != tree.slotOf(found.get(i)) {
        break
      }
      slot = node.parent
    }
    i = i + 1
  }
  return Option<NodeInfo>.None
}

/// Clicks the center of the first node with role `accessRole` named `name` (see
/// [`locateRole`]). Returns false when there is no such node.
pub effect fn clickRole<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  accessRole: Role,
  name: string,
) -> bool
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  let found = run locateRole(&mut tree, viewport, accessRole, name)
  let node = match found {
    Option<NodeInfo>.Some { value: node } => node
    Option<NodeInfo>.None => {
      return false
    }
  }
  let x = (node.bounds.xMin + node.bounds.xMax) * 0.5
  let y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  run clickAt(&mut runtime, &mut tree, viewport, x, y)
  return true
}

/// Clicks the center of the first node whose test id, label or text is `value` with the primary
/// button. Returns false when there is no such node.
pub effect fn click<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  value: string,
) -> bool
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  let found = run locate(&mut tree, viewport, value)
  let node = match found {
    Option<NodeInfo>.Some { value: node } => node
    Option<NodeInfo>.None => {
      return false
    }
  }
  let x = (node.bounds.xMin + node.bounds.xMax) * 0.5
  let y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  run clickAt(&mut runtime, &mut tree, viewport, x, y)
  return true
}

/// Clicks (`x`, `y`) in CSS pixels of the viewport with the primary button.
pub effect fn clickAt<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  x: f32,
  y: f32,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  run tree.frame(viewport)
  run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })

  // Hover can change the view and its listeners. Pump before the next input,
  // as the native event loop does, rather than retaining stale queued targets.
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
  run tree.dispatch(
    Input.PointerDown { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 },
  )
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
  run tree.dispatch(Input.PointerUp { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0 })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
}

/// Presses the primary button at (`fromX`, `fromY`), moves to (`toX`, `toY`) in `steps` moves,
/// and releases it there.
pub effect fn drag<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  fromX: f32,
  fromY: f32,
  toX: f32,
  toY: f32,
  steps: u32,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  run tree.frame(viewport)
  run tree.dispatch(Input.PointerMove { x: fromX, y: fromY, modifiers: 0 })
  run tree.dispatch(
    Input.PointerDown { x: fromX, y: fromY, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 },
  )
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
  let count = if steps == 0 {
    1
  } else {
    steps
  }
  let mut i: u32 = 1
  while i <= count {
    let t = u32.toF32(i) / u32.toF32(count)
    let x = fromX + (toX - fromX) * t
    let y = fromY + (toY - fromY) * t
    run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
    drop run pump(&mut runtime, &mut tree)
    run tree.frame(viewport)
    i = i + 1
  }
  run tree.dispatch(Input.PointerUp { x: toX, y: toY, button: BUTTON_PRIMARY, modifiers: 0 })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
}

/// Moves the pointer to the center of the first node whose test id, label or text is `value`.
/// Returns false when there is no such node.
pub effect fn hover<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  value: string,
) -> bool
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  let found = run locate(&mut tree, viewport, value)
  let node = match found {
    Option<NodeInfo>.Some { value: node } => node
    Option<NodeInfo>.None => {
      return false
    }
  }
  let x = (node.bounds.xMin + node.bounds.xMax) * 0.5
  let y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
  return true
}

/// Moves the pointer to (`x`, `y`) in CSS pixels of the viewport, with no button down.
pub effect fn moveTo<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  x: f32,
  y: f32,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  run tree.frame(viewport)
  run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
}

/// Scrolls the wheel by `deltaY` CSS pixels over the center of the first node whose test id,
/// label or text is `value`. Returns false when there is no such node.
pub effect fn wheel<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  value: string,
  deltaY: f32,
) -> bool
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  let found = run locate(&mut tree, viewport, value)
  let node = match found {
    Option<NodeInfo>.Some { value: node } => node
    Option<NodeInfo>.None => {
      return false
    }
  }
  let x = (node.bounds.xMin + node.bounds.xMax) * 0.5
  let y = (node.bounds.yMin + node.bounds.yMax) * 0.5
  run tree.dispatch(Input.Wheel { x: x, y: y, deltaX: 0.0, deltaY: deltaY, modifiers: 0 })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
  return true
}

/// Types `text` into the focused input, as an input method commits it.
pub effect fn typeText<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  text: string,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  run tree.frame(viewport)
  run tree.dispatch(Input.TextInput { text: run String.copy(text) })
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
}

/// The tree id of the focused node, or 0 when nothing has focus.
pub fn focusedId(tree: &UiTree<'_>) -> u32 {
  if tree.focused == NONE {
    return 0
  }
  return tree.node(tree.focused).id
}

/// Presses and releases the key `key` (a UI Events `key`, also used as its `code`) with the
/// `MOD_*` bits `modifiers`.
pub effect fn press<A: App<M, C>, M, C: Perform<M, E, R>, E, ? R>(
  runtime: &mut Runtime<A, M, C>,
  tree: &mut UiTree<'_>,
  viewport: FrameInput,
  key: string,
  modifiers: u32,
) -> ()
  ! E | TreeError | OutOfMemoryError
  ? R | &mut Allocator {
  run tree.frame(viewport)
  run tree.dispatch(
    Input.KeyDown {
      key: run String.copy(key),
      code: run String.copy(key),
      modifiers: modifiers,
      repeat: false,
    },
  )
  drop run pump(&mut runtime, &mut tree)
  run tree.dispatch(
    Input.KeyUp { key: run String.copy(key), code: run String.copy(key), modifiers: modifiers },
  )
  drop run pump(&mut runtime, &mut tree)
  run tree.frame(viewport)
}

/// The tree's `describe` text snapshot, after a frame.
pub effect fn snapshot(tree: &mut UiTree<'_>, viewport: FrameInput) -> String
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(viewport)
  let mut out = String.make()
  run describe(&tree, DescribeOptions.plain(), &mut out)
  return move out
}
