//! Equality for the tree's style and canvas values, which the view diff compares to send only
//! what changed.
import ui_tree.mutation { Property, Length, LineHeight, BoxShadow, CanvasCommand }
import silk.geometry.corners { Corners }

/// Whether two properties are the same property with the same value.
pub fn sameProperty(a: Property, b: Property) -> bool {
  return match a {
    Property.Display { value } => if let Property.Display { value: other } = b {
      value == other
    } else {
      false
    }
    Property.Width { value } => if let Property.Width { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.Height { value } => if let Property.Height { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.MinWidth { value } => if let Property.MinWidth { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.MinHeight { value } => if let Property.MinHeight { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.MaxWidth { value } => if let Property.MaxWidth { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.MaxHeight { value } => if let Property.MaxHeight { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.Margin { side, value } => if let Property.Margin {
      side: otherSide,
      value: other
    } = b {
      side == otherSide && sameLength(value, other)
    } else {
      false
    }
    Property.Padding { side, value } => if let Property.Padding {
      side: otherSide,
      value: other
    } = b {
      side == otherSide && sameLength(value, other)
    } else {
      false
    }
    Property.BorderWidth { side, value } => if let Property.BorderWidth {
      side: otherSide,
      value: other
    } = b {
      side == otherSide && value == other
    } else {
      false
    }
    Property.Inset { side, value } => if let Property.Inset { side: otherSide, value: other } = b {
      side == otherSide && sameLength(value, other)
    } else {
      false
    }
    Property.Position { value } => if let Property.Position { value: other } = b {
      value == other
    } else {
      false
    }
    Property.BoxSizing { value } => if let Property.BoxSizing { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FlexDirection { value } => if let Property.FlexDirection { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FlexWrap { value } => if let Property.FlexWrap { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FlexGrow { value } => if let Property.FlexGrow { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FlexShrink { value } => if let Property.FlexShrink { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FlexBasis { value } => if let Property.FlexBasis { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.JustifyContent { value } => if let Property.JustifyContent { value: other } = b {
      value == other
    } else {
      false
    }
    Property.AlignItems { value } => if let Property.AlignItems { value: other } = b {
      value == other
    } else {
      false
    }
    Property.AlignSelf { value } => if let Property.AlignSelf { value: other } = b {
      value == other
    } else {
      false
    }
    Property.AlignContent { value } => if let Property.AlignContent { value: other } = b {
      value == other
    } else {
      false
    }
    Property.RowGap { value } => if let Property.RowGap { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.ColumnGap { value } => if let Property.ColumnGap { value: other } = b {
      sameLength(value, other)
    } else {
      false
    }
    Property.OverflowX { value } => if let Property.OverflowX { value: other } = b {
      value == other
    } else {
      false
    }
    Property.OverflowY { value } => if let Property.OverflowY { value: other } = b {
      value == other
    } else {
      false
    }
    Property.AspectRatio { value } => if let Property.AspectRatio { value: other } = b {
      value == other
    } else {
      false
    }
    Property.BackgroundColor { color } => if let Property.BackgroundColor { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.BackgroundGradient { angle, from, to } => if let Property.BackgroundGradient {
      angle: otherAngle,
      from: otherFrom,
      to: otherTo
    } = b {
      angle == otherAngle && &from == &otherFrom && &to == &otherTo
    } else {
      false
    }
    Property.BorderColor { color } => if let Property.BorderColor { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.BorderStyle { value } => if let Property.BorderStyle { value: other } = b {
      value == other
    } else {
      false
    }
    Property.BorderRadius { value } => if let Property.BorderRadius { value: other } = b {
      sameCorners(value, other)
    } else {
      false
    }
    Property.BoxShadow { value } => if let Property.BoxShadow { value: other } = b {
      sameShadow(value, other)
    } else {
      false
    }
    Property.NoBoxShadow => if let Property.NoBoxShadow = b {
      true
    } else {
      false
    }
    Property.BackdropBlur { value } => if let Property.BackdropBlur { value: other } = b {
      value == other
    } else {
      false
    }
    Property.Opacity { value } => if let Property.Opacity { value: other } = b {
      value == other
    } else {
      false
    }
    Property.PointerEvents { value } => if let Property.PointerEvents { value: other } = b {
      value == other
    } else {
      false
    }
    Property.Visible { value } => if let Property.Visible { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FontFamily { family } => if let Property.FontFamily { family: other } = b {
      family == other
    } else {
      false
    }
    Property.FontSize { value } => if let Property.FontSize { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FontWeight { value } => if let Property.FontWeight { value: other } = b {
      value == other
    } else {
      false
    }
    Property.FontStyle { value } => if let Property.FontStyle { value: other } = b {
      value == other
    } else {
      false
    }
    Property.LineHeight { value } => if let Property.LineHeight { value: other } = b {
      sameLineHeight(value, other)
    } else {
      false
    }
    Property.Color { color } => if let Property.Color { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.CaretColor { color } => if let Property.CaretColor { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.SelectionColor { color } => if let Property.SelectionColor { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.PlaceholderColor { color } => if let Property.PlaceholderColor { color: other } = b {
      &color == &other
    } else {
      false
    }
    Property.TextAlign { value } => if let Property.TextAlign { value: other } = b {
      value == other
    } else {
      false
    }
    Property.WhiteSpace { value } => if let Property.WhiteSpace { value: other } = b {
      value == other
    } else {
      false
    }
    Property.Direction { value } => if let Property.Direction { value: other } = b {
      value == other
    } else {
      false
    }
    Property.TextDecorationLine { value } => if let Property.TextDecorationLine {
      value: other
    } = b {
      value.underline == other.underline && value.overline == other.overline
        && value.lineThrough == other.lineThrough
    } else {
      false
    }
    Property.TextDecorationColor { color } => if let Property.TextDecorationColor {
      color: other
    } = b {
      &color == &other
    } else {
      false
    }
    Property.TextDecorationWavy { value } => if let Property.TextDecorationWavy {
      value: other
    } = b {
      value == other
    } else {
      false
    }
  }
}

pub fn sameLength(a: Length, b: Length) -> bool {
  return match a {
    Length.Auto => if let Length.Auto = b {
      true
    } else {
      false
    }
    Length.None => if let Length.None = b {
      true
    } else {
      false
    }
    Length.Px { value } => if let Length.Px { value: other } = b {
      value == other
    } else {
      false
    }
    Length.Percent { value } => if let Length.Percent { value: other } = b {
      value == other
    } else {
      false
    }
  }
}

fn sameLineHeight(a: LineHeight, b: LineHeight) -> bool {
  return match a {
    LineHeight.Normal => if let LineHeight.Normal = b {
      true
    } else {
      false
    }
    LineHeight.Number { value } => if let LineHeight.Number { value: other } = b {
      value == other
    } else {
      false
    }
    LineHeight.Px { value } => if let LineHeight.Px { value: other } = b {
      value == other
    } else {
      false
    }
  }
}

fn sameCorners(a: Corners<f32>, b: Corners<f32>) -> bool {
  return a.topLeft == b.topLeft && a.topRight == b.topRight && a.bottomRight == b.bottomRight
    && a.bottomLeft == b.bottomLeft
}

fn sameShadow(a: BoxShadow, b: BoxShadow) -> bool {
  return a.offsetX == b.offsetX && a.offsetY == b.offsetY && a.blur == b.blur
    && a.spread == b.spread
    && &a.color == &b.color
    && a.inset == b.inset
}

/// Whether two canvas commands draw the same thing.
pub fn sameCommand(a: CanvasCommand, b: CanvasCommand) -> bool {
  return match a {
    CanvasCommand.FillRect { x, y, width, height, radius, color } => if let CanvasCommand.FillRect {
      x: x2,
      y: y2,
      width: width2,
      height: height2,
      radius: radius2,
      color: color2,
    } = b {
      x == x2 && y == y2 && width == width2 && height == height2 && radius == radius2
        && &color == &color2
    } else {
      false
    }
    CanvasCommand.MoveTo { x, y } => if let CanvasCommand.MoveTo { x: x2, y: y2 } = b {
      x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.LineTo { x, y } => if let CanvasCommand.LineTo { x: x2, y: y2 } = b {
      x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.QuadTo { x1, y1, x, y } => if let CanvasCommand.QuadTo {
      x1: a1,
      y1: b1,
      x: x2,
      y: y2
    } = b {
      x1 == a1 && y1 == b1 && x == x2 && y == y2
    } else {
      false
    }
    CanvasCommand.CubicTo { x1, y1, x2, y2, x, y } => if let CanvasCommand.CubicTo {
      x1: a1,
      y1: b1,
      x2: a2,
      y2: b2,
      x: x3,
      y: y3,
    } = b {
      x1 == a1 && y1 == b1 && x2 == a2 && y2 == b2 && x == x3 && y == y3
    } else {
      false
    }
    CanvasCommand.Close => if let CanvasCommand.Close = b {
      true
    } else {
      false
    }
    CanvasCommand.Fill { color } => if let CanvasCommand.Fill { color: other } = b {
      &color == &other
    } else {
      false
    }
    CanvasCommand.Stroke { color, width } => if let CanvasCommand.Stroke {
      color: other,
      width: w
    } = b {
      &color == &other && width == w
    } else {
      false
    }
  }
}
