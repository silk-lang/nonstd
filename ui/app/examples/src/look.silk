//! The colors and the button look the examples share.
import ui_app.ui { Ui }
import ui_tree.mutation { Property, Length, Side, BorderStyle, Cursor }
import silk.color.rgba { Rgba }
import silk.geometry.corners { Corners }
import silk.num.u32

/// The font family the examples define (`Noto Sans, sans-serif`), as the tree fixtures do.
pub const SANS: u32 = 1

pub fn rgb(hex: u32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: 1.0 }
}

/// The app surface: font, text color and background on the root.
pub fn surface<M>(ui: &mut Ui<M>) -> () {
  ui.style(
    &[
      Property.FontFamily { family: SANS },
      Property.FontSize { value: 14.0 },
      Property.Color { color: rgb(0x1F2937) },
      Property.BackgroundColor { color: rgb(0xF9FAFB) },
    ],
  )
  ui.padding(16.0)
  ui.gap(10.0)
}

/// A rounded, bordered button look with hover, press and focus ring variants. `selected`
/// fills it.
pub fn buttonLook<M>(ui: &mut Ui<M>, selected: bool) -> () {
  let radius = Corners<f32> { topLeft: 6.0, topRight: 6.0, bottomRight: 6.0, bottomLeft: 6.0 }
  ui.style(
    &[
      Property.Padding { side: Side.Top, value: Length.px(4.0) },
      Property.Padding { side: Side.Bottom, value: Length.px(4.0) },
      Property.Padding { side: Side.Left, value: Length.px(10.0) },
      Property.Padding { side: Side.Right, value: Length.px(10.0) },
      Property.BorderWidth { side: Side.Top, value: 1.0 },
      Property.BorderWidth { side: Side.Right, value: 1.0 },
      Property.BorderWidth { side: Side.Bottom, value: 1.0 },
      Property.BorderWidth { side: Side.Left, value: 1.0 },
      Property.BorderStyle { value: BorderStyle.Solid },
      Property.BorderColor { color: rgb(0xD1D5DB) },
      Property.BorderRadius { value: radius },
    ],
  )
  if selected {
    ui.style(
      &[
        Property.BackgroundColor { color: rgb(0x2563EB) },
        Property.Color { color: rgb(0xFFFFFF) },
        Property.BorderColor { color: rgb(0x2563EB) },
      ],
    )
  } else {
    ui.style(&[Property.BackgroundColor { color: rgb(0xFFFFFF) }])
    ui.hover(&[Property.BackgroundColor { color: rgb(0xF3F4F6) }])
  }
  ui.active(&[Property.BackgroundColor { color: rgb(0xE5E7EB) }])
  ui.focusVisible(&[Property.BorderColor { color: rgb(0x2563EB) }])
}

/// A button with the shared look that sends `onPress`.
pub fn button<M>(ui: &mut Ui<M>, label: string, selected: bool, onPress: fn() -> M) -> () {
  ui.pressable(
    onPress,
    |ui| {
      buttonLook(&mut ui, selected)
      ui.text(label)
    },
  )
}
