//! The counter: buttons, a number, key bindings and a timer subscription. No commands.
import look { surface, button, rgb }
import ui_app.app { App, Context, Subscriptions, NoCommand }
import ui_app.ui { Ui }
import ui_tree.input { MOD_CONTROL }
import ui_tree.mutation { Property, Align }

pub struct Counter {
  pub count: i64,
  /// Whether the timer adds one every second.
  pub running: bool,
  pub ticks: u64,
}

pub union Message {
  Increment,
  Decrement,
  Reset,
  ToggleTimer,
  Tick { pub time: f64 },
}

impl Counter {
  pub fn make() -> Counter {
    return Counter { count: 0, running: false, ticks: 0 }
  }
}

impl App<Message, NoCommand> for Counter {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    surface(&mut ui)
    ui.row(
      |ui| {
        ui.gap(8.0)
        ui.style(&[Property.AlignItems { value: Align.Center }])
        button(&mut ui, "-", false, || Message.Decrement)
        ui.box(
          |ui| {
            ui.testId("count")
            ui.fontSize(20.0)
            ui.number(self.count)
          },
        )
        button(&mut ui, "+", false, || Message.Increment)
      },
    )
    ui.row(
      |ui| {
        ui.gap(8.0)
        button(&mut ui, "Reset", false, || Message.Reset)
        button(
          &mut ui,
          if self.running {
            "Stop"
          } else {
            "Auto"
          },
          self.running,
          || Message.ToggleTimer,
        )
      },
    )
    if self.running {
      ui.box(
        |ui| {
          ui.color(rgb(0x6B7280))
          ui.text("Counting up every second")
        },
      )
    }
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Increment => {
        self.count = self.count + 1
      }
      Message.Decrement => {
        self.count = self.count - 1
      }
      Message.Reset => {
        self.count = 0
      }
      Message.ToggleTimer => {
        self.running = !self.running
      }
      Message.Tick { time } => {
        self.count = self.count + 1
        self.ticks = self.ticks + 1
      }
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    subs.keyBinding(1, "ArrowUp", 0, || Message.Increment)
    subs.keyBinding(2, "ArrowDown", 0, || Message.Decrement)
    subs.keyBinding(3, "r", MOD_CONTROL, || Message.Reset)
    if self.running {
      subs.every(4, 1.0, |time| Message.Tick { time: time })
    }
  }
}
