//! `StderrWriter` for every target the window host builds for. Native targets use std's; in the
//! browser (wasm32, which has no standard error) the text goes to the page's
//! `silk_browser#write` import, which `browser/app-host.js` prints with `console.log`, a line at
//! a time.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.core.effect { Effect }
  import silk.io.writer { Writer, WriterError }
  import silk.mem.pointer { Pointer }
  import silk.text.format { Format }

  @foreign(noCapture: ("bytes",))
  unsafe extern "C" fn hostWrite(bytes: ?[*]const u8, length: usize) -> () as "silk_browser#write"

  /// Debug output for the browser console.
  pub struct StderrWriter {}

  impl StderrWriter {
    pub fn make() -> StderrWriter {
      return StderrWriter {}
    }

    /// Formats `template` with `args` and writes it to the browser console.
    pub fn print<Args>(static template: string<'static>, args: &Args) -> () {
      let mut writer = StderrWriter {}
      let formatted = run Effect.result(
        Format.format<Args>(template, args) |> Effect.provideMut<Writer>(&mut writer),
      )
      drop formatted
      return ()
    }
  }

  impl Writer for StderrWriter {
    effect fn writeAll(self: &mut Self, val: &[u8]) -> ()
      ! WriterError
      ? &mut Writer {
      unsafe hostWrite(Pointer.fromSlice(val), val.length)
    }

    effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {}
  }
} else {
  pub import silk.io.writer_native { StderrWriter }
}
