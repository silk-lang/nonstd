//! The window host's render thread. It owns the GPU: the Dawn instance, the device, the window's
//! surface, the renderer and the atlas textures, all created on that thread, so no GPU object
//! crosses threads. The UI thread lays out and paints as before, then hands each finished frame
//! over with [`RenderThread.submit`]: a copy of the scene, the atlas texture list and the new
//! atlas pixels. The render thread uploads, waits for a drawable, draws and presents, so waiting
//! for the display never blocks input.
//!
//! The hand-over is a one-slot mailbox where the newest frame wins. A frame the render thread
//! has not taken yet is replaced, and its uploads are kept in front of the new frame's, so no
//! atlas pixels are lost. The replaced scene's storage is reused for the next copy.
//!
//! Everything a frame carries lives in the process heap, never in a caller's arena: the copies
//! are made with the system allocator, whatever allocator the caller provides.
import ui_scene.scene { Scene }
import ui_scene.color as color
import ui_tree.lib { Pending }
import atlas.atlas { Atlas, TextureInfo }
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.compare { Tolerance, compare }
import ui_renderer.readback { copyOut, isBgra, pickFormat, readbackSize, unpack }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import window.types { RawSurface, WindowId }
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources { Queue, Texture, getQueue }
import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.concurrency.sync { Arc, Mutex, Parker, Unparker }
import silk.concurrency.thread { Transferable }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.text.string { String }
import silk.num.f64
import silk.num.i64
import silk.num.u64
import silk.num.i32

/// How the render thread sets up the surface.
pub struct RenderSettings {
  /// Check mode: the surface can be read back, and text uses no gamma correction, like the CPU
  /// reference.
  pub check: bool,
}

impl Copy for RenderSettings {}

/// What the render thread last did, for frame timings and the check.
pub struct RenderReport {
  /// Frames presented so far.
  pub frames: u64,
  /// The result of the last compared frame: 0 within tolerance, 1 outside, -1 none yet.
  pub status: i32,
  /// Milliseconds the last frame spent writing atlas pixels, waiting for a drawable, encoding
  /// and submitting the draw, and presenting.
  pub upload: f64,
  pub acquire: f64,
  pub draw: f64,
  pub present: f64,
  /// Milliseconds between the last two presents, 0 before the second.
  pub interval: f64,
}

impl Copy for RenderReport {}

impl RenderReport {
  fn none() -> RenderReport {
    return RenderReport {
      frames: 0,
      status: -1,
      upload: 0.0,
      acquire: 0.0,
      draw: 0.0,
      present: 0.0,
      interval: 0.0,
    }
  }
}

/// The window's native surface, sent once to the render thread. The pointers it holds belong to
/// the window, which outlives the render thread: [`RenderThread.stop`] joins it before the
/// window closes.
struct SurfaceHandle {
  raw: RawSurface,
  window: WindowId,
}

impl Transferable for SurfaceHandle {}

/// One frame for the render thread.
struct FrameJob {
  scene: Scene,
  textures: List<TextureInfo>,
  uploads: Pending,
  width: u32,
  height: u32,
  /// The CPU reference to compare the drawn surface with, when `compare` is set.
  expected: List<u8>,
  compare: bool,
}

impl Transferable for FrameJob {}

struct State {
  job: Option<FrameJob>,
  /// Storage of a drawn or replaced scene, reused for the next copy.
  spare: Option<Scene>,
  quit: bool,
  ready: bool,
  format: u32,
  failure: Option<GpuError>,
  report: RenderReport,
}

impl Transferable for State {}

/// The GPU side of one window, running on its own thread.
pub struct RenderThread {
  shared: Arc<Mutex<State>>,
  /// The UI thread sleeps here while it waits for the render thread.
  parker: Parker,
  /// Wakes the render thread.
  wake: Unparker,
  handle: Option<JoinHandle<i32>>,
}

impl RenderThread {
  /// Starts the render thread for the window's surface `raw`, then waits until its GPU device
  /// is ready. Fails with the thread's error when the surface or device cannot be made.
  pub effect fn start(raw: RawSurface, window: WindowId, settings: RenderSettings) -> RenderThread
    ! GpuError | OutOfMemoryError {
    let mut heap = Allocator.systemAllocatorProvider()
    let shared = run makeShared() |> Effect.provideMut<Allocator>(&mut heap)
    let parker = run Parker.make() |> Effect.provideMut<Allocator>(&mut heap)
    let theirParker = run Parker.make() |> Effect.provideMut<Allocator>(&mut heap)
    let wake = theirParker.unparker()
    let wakeUi = parker.unparker()
    let theirs = shared.clone()
    let surface = SurfaceHandle { raw: raw, window: window }
    let spawned = run Effect.result(
      NativeThread.spawn(
        fn() -> i32 {
          let shared = move theirs
          let surface = move surface
          let parker = move theirParker
          let wakeUi = move wakeUi
          return renderMain(&surface, &shared, &parker, &wakeUi, settings)
        },
      ),
    )
      |> Effect.provideMut<Allocator>(&mut heap)
    let handle = match move spawned {
      Result.Success { value } => move value
      Result.Failure { error } => match move error {
        SpawnError failure => {
          StderrWriter.print("ui-tree: the render thread could not start\n", &())
          fail GpuError.status(i32.wrappingToU32(failure.code))
        }
        OutOfMemoryError failure => {
          fail move failure
        }
      }
    }
    let mut thread = RenderThread {
      shared: move shared,
      parker: move parker,
      wake: move wake,
      handle: Option<JoinHandle<i32>>.some(move handle),
    }
    run thread.waitReady()
    return move thread
  }

  /// The surface's texture format, chosen by the render thread.
  pub fn format(self: &Self) -> u32 {
    return self.shared.get().lock().get().format
  }

  effect fn waitReady(self: &mut Self) -> ()
    ! GpuError {
    while true {
      let ready = readyOrFailed(&self.shared)
      if ready {
        break
      }
      self.parker.park()
    }
    run raise(&self.shared)
  }

  /// Hands a finished frame to the render thread and returns at once. `scene` is copied, with
  /// `atlas`'s texture list and `uploads`'s pixels, so the caller keeps using all three. A
  /// frame the render thread has not taken yet is replaced; its uploads go first. With
  /// `compare` set (check mode), the drawn surface is compared with the RGBA pixels `expected`
  /// and the result shows in [`RenderThread.report`]. Fails with the render thread's error if it has
  /// stopped on one.
  pub effect fn submit(
    self: &mut Self,
    scene: &Scene,
    atlas: &Atlas,
    uploads: &Pending,
    width: u32,
    height: u32,
    compare: bool,
    expected: &[u8],
  ) -> ()
    ! GpuError | OutOfMemoryError {
    run raise(&self.shared)
    let mut heap = Allocator.systemAllocatorProvider()
    let mut copy = match move takeSpare(&self.shared) {
      Option<Scene>.Some { value } => move value
      Option<Scene>.None => Scene.make()
    }
    run copy.copyFrom(scene) |> Effect.provideMut<Allocator>(&mut heap)
    let mut textures = List<TextureInfo>.make()
    let mut i: usize = 0
    while i < atlas.textureCount() {
      run textures.append(atlas.texture(i)) |> Effect.provideMut<Allocator>(&mut heap)
      i = i + 1
    }
    let mut reference = List<u8>.make()
    if compare {
      run reference.appendSlice(expected) |> Effect.provideMut<Allocator>(&mut heap)
    }
    let job = FrameJob {
      scene: move copy,
      textures: move textures,
      uploads: Pending.make(),
      width: width,
      height: height,
      expected: move reference,
      compare: compare,
    }
    run post(&self.shared, move job, uploads) |> Effect.provideMut<Allocator>(&mut heap)
    self.wake.unpark()
  }

  /// What the render thread last reported.
  pub fn report(self: &Self) -> RenderReport {
    return self.shared.get().lock().get().report
  }

  /// Waits until `frames` frames have been presented, or the render thread stopped on an error,
  /// which this then fails with.
  pub effect fn waitFrames(self: &mut Self, frames: u64) -> RenderReport
    ! GpuError {
    while true {
      if presentedOrStopped(&self.shared, frames) {
        break
      }
      self.parker.park()
    }
    run raise(&self.shared)
    return self.report()
  }

  /// Stops the render thread and waits for it, after any frame it is drawing. Call it before
  /// the window closes.
  pub fn stop(self: &mut Self) -> () {
    requestQuit(&self.shared)
    self.wake.unpark()
    match move Intrinsic.replace(self.handle, Option<JoinHandle<i32>>.None) {
      Option<JoinHandle<i32>>.Some { value } => {
        drop value.join()
      }
      Option<JoinHandle<i32>>.None => ()
    }
  }
}

fn readyOrFailed(shared: &Arc<Mutex<State>>) -> bool {
  let guard = shared.get().lock()
  return guard.get().ready || Option<GpuError>.isSome(&guard.get().failure) || guard.get().quit
}

fn presentedOrStopped(shared: &Arc<Mutex<State>>, frames: u64) -> bool {
  let guard = shared.get().lock()
  let state = guard.get()
  return state.report.frames >= frames || Option<GpuError>.isSome(&state.failure) || state.quit
}

fn requestQuit(shared: &Arc<Mutex<State>>) -> () {
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  state.quit = true
}

fn takeSpare(shared: &Arc<Mutex<State>>) -> Option<Scene> {
  let mut guard = shared.get().lock()
  return Intrinsic.replace(guard.getMut().spare, Option<Scene>.None)
}

/// Fails with the render thread's error, if it stopped on one.
effect fn raise(shared: &Arc<Mutex<State>>) -> ()
  ! GpuError {
  let failure = takeFailure(shared)
  match move failure {
    Option<GpuError>.Some { value } => {
      fail move value
    }
    Option<GpuError>.None => ()
  }
}

fn takeFailure(shared: &Arc<Mutex<State>>) -> Option<GpuError> {
  let mut guard = shared.get().lock()
  return Intrinsic.replace(guard.getMut().failure, Option<GpuError>.None)
}

/// Puts `job` in the mailbox. A job still waiting there is replaced: its uploads go in front of
/// `uploads`, and its scene's storage becomes the spare.
effect fn post(shared: &Arc<Mutex<State>>, job: FrameJob, uploads: &Pending) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut next = move job
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  let replaced = Intrinsic.replace(state.job, Option<FrameJob>.None)
  match move replaced {
    Option<FrameJob>.Some { value } => {
      run next.uploads.appendAll(&value.uploads)
      let FrameJob {
        scene: old,
        textures: t,
        uploads: u,
        width: w,
        height: h,
        expected: e,
        compare: c
      } = move value
      drop t
      drop u
      drop e
      state.spare = Option<Scene>.some(move old)
    }
    Option<FrameJob>.None => ()
  }
  run next.uploads.appendAll(uploads)
  state.job = Option<FrameJob>.some(move next)
}

effect fn makeShared() -> Arc<Mutex<State>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let state = State {
    job: Option<FrameJob>.None,
    spare: Option<Scene>.None,
    quit: false,
    ready: false,
    format: 0,
    failure: Option<GpuError>.None,
    report: RenderReport.none(),
  }
  return run Arc<Mutex<State>>.make(run Mutex<State>.make(move state))
}

/// The thread's body: runs the loop and passes its error, if any, to the UI thread.
fn renderMain(
  surface: &SurfaceHandle,
  shared: &Arc<Mutex<State>>,
  parker: &Parker,
  wakeUi: &Unparker,
  settings: RenderSettings,
) -> i32 {
  let mut heap = Allocator.systemAllocatorProvider()
  let result = run Effect.result(renderLoop(surface, shared, parker, wakeUi, settings))
    |> Effect.provideMut<Allocator>(&mut heap)
  let failure = match move result {
    Result.Success { value } => {
      drop value
      requestQuit(shared)
      wakeUi.unpark()
      return 0
    }
    Result.Failure { error } => match move error {
      GpuError failure => move failure
      OutOfMemoryError failure => {
        drop failure
        GpuError.status(0)
      }
    }
  }
  recordFailure(shared, move failure)
  wakeUi.unpark()
  return 2
}

fn recordFailure(shared: &Arc<Mutex<State>>, failure: GpuError) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  values.failure = Option<GpuError>.some(move failure)
  values.quit = true
}

/// Waits for the next job, or None when the thread should stop.
fn nextJob(shared: &Arc<Mutex<State>>, parker: &Parker) -> Option<FrameJob> {
  while true {
    let taken = takeJob(shared)
    match move taken {
      Taken.Job { job } => {
        return Option<FrameJob>.some(move job)
      }
      Taken.Quit => {
        return Option<FrameJob>.None
      }
      Taken.Empty => {
        parker.park()
      }
    }
  }
  return Option<FrameJob>.None
}

union Taken {
  Job { job: FrameJob },
  Quit,
  Empty
}

fn takeJob(shared: &Arc<Mutex<State>>) -> Taken {
  let mut guard = shared.get().lock()
  let state = guard.getMut()
  if state.quit {
    return Taken.Quit
  }
  return match move Intrinsic.replace(state.job, Option<FrameJob>.None) {
    Option<FrameJob>.Some { value } => Taken.Job { job: move value }
    Option<FrameJob>.None => Taken.Empty
  }
}

fn markReady(shared: &Arc<Mutex<State>>, format: u32) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  values.format = format
  values.ready = true
}

/// Records a presented frame and keeps the scene's storage for the next copy.
fn finished(shared: &Arc<Mutex<State>>, job: FrameJob, report: RenderReport) -> () {
  let mut guard = shared.get().lock()
  let values = guard.getMut()
  let previous = values.report
  values.report = report
  values.report.frames = previous.frames + 1
  if report.status < 0 {
    values.report.status = previous.status
  }
  if Option<Scene>.isNone(&values.spare) {
    let FrameJob {
      scene: used,
      textures: t,
      uploads: u,
      width: w,
      height: h,
      expected: e,
      compare: c
    } = move job
    drop t
    drop u
    drop e
    values.spare = Option<Scene>.some(move used)
  } else {
    drop job
  }
}

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut OsMonotonicClock) -> f64 {
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&now))
    + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000000.0
}

effect fn renderLoop(
  surface: &SurfaceHandle,
  shared: &Arc<Mutex<State>>,
  parker: &Parker,
  wakeUi: &Unparker,
  settings: RenderSettings,
) -> ()
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut clock = OsMonotonicClock.make()
  let owner = surface.window
  let target = match unsafe targetOf(&owner, surface.raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-tree: this backend has no GPU surface\n", &())
      fail GpuError.status(0)
    }
  }
  let instance = run Instance.create()
  let gpuSurface = run Surface.create(&instance, &target, String.utf8Bytes("ui tree"))
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&gpuSurface))
  let capabilities = run gpuSurface.getCapabilities(&adapter)
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-tree: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    fail GpuError.status(0)
  }
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, format)
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  if settings.check {
    let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
    if !canCopy {
      StderrWriter.print("ui-tree: the surface cannot be read back\n", &())
      fail GpuError.status(0)
    }
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
    renderer.setTextSettings(TextSettings.none())
  }
  if capabilities.alphaModes().length != 0 {
    configuration.setAlphaMode(capabilities.alphaModes()[0])
  }
  markReady(shared, format)
  wakeUi.unpark()

  let mut configuredWidth: u32 = 0
  let mut configuredHeight: u32 = 0
  let mut previousPresented = 0.0
  while true {
    let job = match move nextJob(shared, parker) {
      Option<FrameJob>.Some { value } => move value
      Option<FrameJob>.None => {
        break
      }
    }
    if job.width == 0 || job.height == 0 {
      finished(shared, move job, RenderReport.none())
      wakeUi.unpark()
      continue
    }
    if job.width != configuredWidth || job.height != configuredHeight {
      gpuSurface.resize(&mut configuration, job.width, job.height)
      configuredWidth = job.width
      configuredHeight = job.height
    }
    let start = run seconds(&mut clock)
    run textures.syncInfos(&device, job.textures.asSlice())
    let list = job.uploads.entries()
    let mut i: usize = 0
    while i < list.length {
      textures.write(&queue, list[i].tile, job.uploads.pixels(list[i]))
      i = i + 1
    }
    let uploaded = run seconds(&mut clock)
    let texture = run gpuSurface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    let acquired = run seconds(&mut clock)
    run renderer.draw(
      &device,
      &queue,
      &job.scene,
      &textures,
      &view,
      job.width,
      job.height,
      color.white(),
    )
    let drawn = run seconds(&mut clock)
    let mut status: i32 = -1
    if job.compare {
      status = run checkFrame(
        &device,
        &queue,
        &texture.texture,
        isBgra(format),
        job.expected.asSlice(),
        job.width,
        job.height,
      )
    }
    run gpuSurface.present()
    run device.checkErrors()
    let presented = run seconds(&mut clock)
    let report = RenderReport {
      frames: 0,
      status: status,
      upload: (uploaded - start) * 1000.0,
      acquire: (acquired - uploaded) * 1000.0,
      draw: (drawn - acquired) * 1000.0,
      present: (presented - drawn) * 1000.0,
      interval: if previousPresented == 0.0 {
        0.0
      } else {
        (presented - previousPresented) * 1000.0
      },
    }
    finished(shared, move job, report)
    wakeUi.unpark()
    previousPresented = presented
  }
  gpuSurface.unconfigure()
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns 0 within
/// tolerance and 1 outside.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}
