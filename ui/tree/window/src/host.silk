//! Native GPU window lifecycle for any retained-tree client.
//! Implement WindowClient to handle events and supply mutations. The host owns the window,
//! GPU surface, input integration, accessibility publication, inspection, and frame scheduling.
import ui_scene.scene { Scene }
import ui_tree.inspect { findAll }
import ui_tree.lib { UiTree, TreeError, FrameInput, CpuSnapshot, Mutation }
import lib { feed, windowCursor, HostState, serve }
import ui_inspect_server.lib { Inspector }
import font_collection.lib { FontCollection }
import demo.compare { Tolerance, compare }
import demo_host.frames { copyOut, isBgra, pickFormat, readbackSize, unpack }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import ui_scene.color as color
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import window.event { Event }
import window.native { NativePlatform }
import window.platform { Platform }
import window.types { RawSurface, Wait, WindowError, WindowId, WindowOptions }
import webgpu.runtime { Device, GpuError, Instance, RequestAdapterOptions }
import webgpu.runtime as runtime
import webgpu.resources { Queue, Texture, TextureView, getQueue }
import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.size { Size2 }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64
import silk.num.i64
import silk.num.u64
import ui_tree.input { Input, BUTTON_PRIMARY }
import ui_tree.inspect { info, NodeInfo }

/// Client lifecycle hooks for the native tree host. Default hooks draw an ordinary tree.
pub interface WindowClient<S, E, ? R> {
  /// Initializes resources before the first view and configures native window options.
  effect fn setup(self: &mut Self, state: &mut S, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  /// Sets platform window options before the window opens.
  fn configure(self: &Self, state: &S, options: &mut WindowOptions) -> () {}

  /// Receives the new native window before the GPU is initialized.
  effect fn opened(
    self: &mut Self,
    state: &mut S,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> ()
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {}

  /// Initializes custom GPU resources for the selected surface format.
  effect fn gpu(self: &mut Self, state: &mut S, device: &Device, format: u32) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {}

  /// Native menus and dialogs; true consumes the event before ordinary input dispatch.
  /// Handles native events before the tree adapter; true consumes the event.
  effect fn event(self: &mut Self, state: &mut S, tree: &mut UiTree, event: &Event) -> bool
    ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Updates native window state after input; true requests a frame.
  effect fn update(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree,
    platform: &mut NativePlatform,
    window: WindowId,
  ) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Return false to keep the window open, for example when a document save fails.
  effect fn closing(self: &mut Self, state: &mut S) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return true
  }

  /// Returns whether tree or client changes require another frame.
  fn needsFrame(self: &Self, state: &S, tree: &UiTree) -> bool {
    return tree.needsFrame()
  }

  /// Applies pending client changes before tree layout.
  effect fn prepare(self: &mut Self, state: &mut S, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {}

  /// Returns whether the host prints CPU frame timings.
  fn profile(self: &Self, state: &S) -> bool {
    return false
  }

  /// Collects background work before waiting for events; true requests a frame.
  effect fn poll(self: &mut Self, state: &mut S, tree: &mut UiTree, time: f64) -> bool
    ! WindowError | TreeError | OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// A maximum wait in seconds while work needs polling, or None to wait for ordinary events.
  fn wakeAfter(self: &Self, state: &S) -> Option<f64> {
    return Option<f64>.None
  }

  /// Prepares optional custom scene content after tree layout and before upload.
  effect fn frame(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree,
    input: FrameInput,
    inspector: &Inspector,
  ) -> ()
    ! TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {}

  /// Returns the completed tree scene or a client composition.
  fn scene<'s>(self: &'s Self, state: &'s S, tree: &'s UiTree) -> &'s Scene {
    return tree.scene()
  }

  /// Draws the completed scene into the acquired surface texture.
  effect fn draw(
    self: &mut Self,
    state: &mut S,
    renderer: &mut UiRenderer,
    device: &Device,
    queue: &Queue,
    tree: &UiTree,
    inspector: &Inspector,
    textures: &GpuAtlas,
    view: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    run renderer.draw(
      device,
      queue,
      inspector.sceneWith(self.scene(&state.*, tree)),
      textures,
      view,
      width,
      height,
      color.white(),
    )
  }

  /// Initializes client nodes after the host applies resource definitions.
  effect fn start(self: &mut Self, state: &mut S, tree: &mut UiTree) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Delivers queued tree events and reconciles client nodes.
  effect fn pump(self: &mut Self, state: &mut S, tree: &mut UiTree) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Advances client timers and optional animation subscriptions.
  effect fn tick(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree,
    time: f64,
    animation: bool,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Updates the client's logical viewport size.
  effect fn resize(self: &mut Self, state: &mut S, tree: &mut UiTree, width: f32, height: f32) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {}

  /// Lays out and paints the tree. Virtual-list clients reconcile requested ranges here.
  effect fn layout(self: &mut Self, state: &mut S, tree: &mut UiTree, input: FrameInput) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run tree.frame(input)
  }

  /// Returns the next timer deadline in host monotonic seconds, or None.
  fn nextDeadline(self: &Self, state: &S) -> Option<f64> {
    return Option<f64>.None
  }

  /// Returns whether the client needs continuous animation frames.
  fn wantsFrames(self: &Self, state: &S) -> bool {
    return false
  }

  /// Runs the input sequence used by the host's rendering check.
  effect fn checkInput(
    self: &mut Self,
    state: &mut S,
    tree: &mut UiTree,
    input: FrameInput,
    name: string,
  ) -> ()
    ! E | TreeError | OutOfMemoryError
    ? R | &mut Allocator {
    run self.layout(&mut state, &mut tree, input)
    let mut found = List<u32>.make()
    run findAll(&tree, name, &mut found)
    if found.length() > 0 {
      if let Option<NodeInfo>.Some { value } = run info(&tree, found.get(0)) {
        let x = (value.bounds.xMin + value.bounds.xMax) * 0.5
        let y = (value.bounds.yMin + value.bounds.yMax) * 0.5
        run tree.dispatch(Input.PointerMove { x: x, y: y, modifiers: 0 })
        run self.pump(&mut state, &mut tree)
        run self.layout(&mut state, &mut tree, input)
        run tree.dispatch(
          Input.PointerDown { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0, clickCount: 1 },
        )
        run self.pump(&mut state, &mut tree)
        run self.layout(&mut state, &mut tree, input)
        run tree.dispatch(Input.PointerUp { x: x, y: y, button: BUTTON_PRIMARY, modifiers: 0 })
        run self.pump(&mut state, &mut tree)
      }
    }
    run self.layout(&mut state, &mut tree, input)
    run tree.dispatch(
      Input.KeyDown {
        key: run String.copy("Tab"),
        code: run String.copy("Tab"),
        modifiers: 0,
        repeat: false,
      },
    )
    run self.pump(&mut state, &mut tree)
    run tree.dispatch(
      Input.KeyUp { key: run String.copy("Tab"), code: run String.copy("Tab"), modifiers: 0 },
    )
    run self.pump(&mut state, &mut tree)
  }
}

/// How to open the window.
pub struct RunOptions {
  /// Native window title.
  pub title: string<'static>,
  /// The content size in logical points (CSS pixels).
  pub width: f64,
  /// Initial content height in logical pixels.
  pub height: f64,
  /// Script and check the frame instead of taking input (see the module documentation).
  pub check: bool,
  /// The test id, label or text of the node `check` clicks.
  pub checkClick: string<'static>,
  /// The test id, label or text of a node that must exist after the click.
  pub checkExpect: string<'static>,
}

/// The frame `check` reads back: the scripted input goes in after frame 1.
const CHECK_FRAME: u64 = 3

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

fn deviceSize(logical: f64, scale: f64) -> u32 {
  return f64.toU32(f64.floor(logical * scale + 0.5))
}

/// Seconds on the monotonic clock.
effect fn seconds(clock: &mut OsMonotonicClock) -> f64 {
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&now))
    + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000000.0
}

/// Whether a node's test id, label or text is `value`.
effect fn exists(tree: &UiTree, value: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<u32>.make()
  run findAll(tree, value, &mut found)
  return found.length() != 0
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns the exit code.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}

/// Runs a retained-tree client until close or until the scripted rendering check completes.
/// Resource mutations apply before `start`. No ui-app runtime or view builder is required.
pub effect fn runWindow<H: WindowClient<S, E, R>, S, E, ? R>(
  state: &mut S,
  collection: &FontCollection,
  resources: List<Mutation>,
  options: RunOptions,
  inspector: Inspector,
  content: &mut H,
) -> i32
  ! E | WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? R | &mut Allocator {
  let check = options.check
  let mut inspector = if check {
    drop inspector
    Inspector.off()
  } else {
    move inspector
  }
  let mut clock = OsMonotonicClock.make()
  let started = run seconds(&mut clock)
  let mut tree = run UiTree.make(collection)
  run content.setup(&mut state, &mut tree)
  run tree.apply(move resources)
  run content.start(&mut state, &mut tree)
  let mut snapshot = CpuSnapshot.make()

  let mut platform = run NativePlatform.start()
  let mut windowOptions = WindowOptions.make(options.title, options.width, options.height)
  windowOptions.minSize = Option<Size2<f64>>.some(Size2<f64>.new(240.0, 200.0))
  content.configure(&state.*, &mut windowOptions)
  let window = run platform.openWindow(&windowOptions)
  let owner = window
  run content.opened(&mut state, &mut platform, owner)
  let mut host = HostState.make()
  let raw = platform.rawSurface(window)
  let target = match unsafe targetOf(&owner, raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-tree: this backend has no GPU surface\n", &())
      return 2
    }
  }
  let instance = run Instance.create()
  let surface = run Surface.create(&instance, &target, String.utf8Bytes("ui tree"))
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&surface))
  let capabilities = run surface.getCapabilities(&adapter)
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-tree: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    return 2
  }
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, format)
  run content.gpu(&mut state, &device, format)
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  if check {
    let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
    if !canCopy {
      StderrWriter.print("ui-tree: the surface cannot be read back\n", &())
      return 2
    }
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
    renderer.setTextSettings(TextSettings.none())
  }
  if capabilities.alphaModes().length != 0 {
    configuration.setAlphaMode(capabilities.alphaModes()[0])
  }

  let initial = platform.contentSize(window)
  let mut width = initial.width
  let mut height = initial.height
  let mut scale = platform.scaleFactor(window)
  let mut configured = false
  let mut drawn: u64 = 0
  let mut previousPresented = 0.0
  let mut status: i32 = 0
  run content.resize(&mut state, &mut tree, f64.toF32(width), f64.toF32(height))
  platform.requestFrame(owner)
  while true {
    // Wait for input or a frame, at most until the next timer.
    let now = (run seconds(&mut clock)) - started
    let backgroundChanged = run content.poll(&mut state, &mut tree, now)
    if backgroundChanged {
      platform.requestFrame(owner)
    }
    let wait = if check {
      Wait.Seconds { seconds: 0.016 }
    } else {
      let mut deadline = match content.nextDeadline(&state.*) {
        Option<f64>.Some { value } => if value > now {
          value - now
        } else {
          0.0
        }
        Option<f64>.None => -1.0
      }
      if let Option<f64>.Some { value } = content.wakeAfter(&state.*) {
        if deadline < 0.0 || value < deadline {
          deadline = f64.max(0.0, value)
        }
      }
      match inspector.pollInterval() {
        Option<f64>.Some { value } => Wait.Seconds {
          seconds: if deadline >= 0.0 && deadline < value {
            deadline
          } else {
            value
          },
        }
        Option<f64>.None => if deadline >= 0.0 {
          Wait.Seconds { seconds: deadline }
        } else {
          Wait.Forever
        }
      }
    }
    let mut next = run platform.nextEvent(wait)
    let time = (run seconds(&mut clock)) - started
    if check && next.isNone() {
      next = Option<Event>.some(Event.RequestFrame { window: owner, targetTime: time })
    }
    let mut redraw = backgroundChanged
    if !check {
      run content.tick(&mut state, &mut tree, time, false)
      redraw = content.needsFrame(&state.*, &tree)
    }
    if run inspector.poll(&mut tree) {
      while true {
        // Input from the inspector is answered like window input.
        run serve(&mut platform, owner, &mut tree, &mut host)
        run inspector.observe(&tree)
        run content.pump(&mut state, &mut tree)
        if !run inspector.dispatchNext(&mut tree) {
          break
        }
      }
      platform.setCursor(owner, windowCursor(tree.cursor()))
      redraw = true
    }
    if let Option<Event>.Some { value } = &next {
      let mut resized = false
      if !check && run content.event(&mut state, &mut tree, &value) {
        redraw = true
      } else {
        match &value {
          Event.RequestFrame { window: which, targetTime } => {
            if configured || deviceSize(width, scale) > 0 {
              if !configured {
                surface.resize(
                  &mut configuration,
                  deviceSize(width, scale),
                  deviceSize(height, scale),
                )
                configured = true
              }
              let viewport = FrameInput {
                width: f64.toF32(width),
                height: f64.toF32(height),
                scale: f64.toF32(scale),
                time: targetTime,
              }
              if check && drawn == 1 {
                run content.checkInput(&mut state, &mut tree, viewport, options.checkClick)
              }
              if !check && content.wantsFrames(&state.*) {
                run content.tick(&mut state, &mut tree, time, true)
              }
              let frameStart = run seconds(&mut clock)
              run content.prepare(&mut state, &mut tree)

              // Publish accessibility geometry after virtual rows have settled.
              run content.layout(&mut state, &mut tree, viewport)
              let layoutEnd = run seconds(&mut clock)
              run content.frame(&mut state, &mut tree, viewport, &inspector)
              let canvasEnd = run seconds(&mut clock)
              run serve(&mut platform, owner, &mut tree, &mut host)
              run textures.sync(&device, &tree.atlas)
              let pending = tree.pendingUploads()
              let list = pending.entries()
              let mut i: usize = 0
              while i < list.length {
                textures.write(&queue, list[i].tile, pending.pixels(list[i]))
                i = i + 1
              }
              run inspector.afterFrameScene(&tree, content.scene(&state.*, &tree))
              run snapshot.sync(&mut tree)
              let deviceWidth = deviceSize(width, scale)
              let deviceHeight = deviceSize(height, scale)
              let prepared = run seconds(&mut clock)
              let texture = run surface.getCurrentTexture()
              let view = run texture.texture.createView(&TextureViewDescriptor.default())
              let uploadEnd = run seconds(&mut clock)
              run content.draw(
                &mut state,
                &mut renderer,
                &device,
                &queue,
                &tree,
                &inspector,
                &textures,
                &view,
                deviceWidth,
                deviceHeight,
              )
              let drawEnd = run seconds(&mut clock)
              drawn = drawn + 1
              if check && drawn == CHECK_FRAME && !(run exists(&tree, options.checkExpect)) {
                StderrWriter.print("check: the scripted click did not reach the client\n", &())
                status = 1
              } else if check && drawn == CHECK_FRAME {
                let reference = run snapshot.renderSceneOver(
                  &tree,
                  content.scene(&state.*, &tree),
                  color.white(),
                )
                status = run checkFrame(
                  &device,
                  &queue,
                  &texture.texture,
                  isBgra(format),
                  reference.data(),
                  deviceWidth,
                  deviceHeight,
                )
              }
              run surface.present()
              run device.checkErrors()
              let presented = run seconds(&mut clock)
              if content.profile(&state.*) {
                StderrWriter.print(
                  "frame-ms: layout={} canvas={} upload={} draw={} present={} interval={} acquire={}\n",
                  &(
                    (layoutEnd - frameStart) * 1000.0,
                    (canvasEnd - layoutEnd) * 1000.0,
                    (prepared - canvasEnd) * 1000.0,
                    (drawEnd - uploadEnd) * 1000.0,
                    (presented - drawEnd) * 1000.0,
                    if previousPresented == 0.0 {
                      0.0
                    } else {
                      (presented - previousPresented) * 1000.0
                    },
                    (uploadEnd - prepared) * 1000.0
                  ),
                )
              }
              previousPresented = presented
              if check && drawn >= CHECK_FRAME {
                break
              }
              run content.pump(&mut state, &mut tree)
              platform.setCursor(owner, windowCursor(tree.cursor()))
            }
            redraw = check || content.wantsFrames(&state.*) || content.needsFrame(&state.*, &tree)
          }
          Event.Resized { window: which, size, scaleFactor } => {
            width = size.width
            height = size.height
            scale = scaleFactor
            resized = true
          }
          Event.ScaleFactorChanged { window: which, scaleFactor } => {
            scale = scaleFactor
            resized = true
          }
          Event.CloseRequested { window: which } => {
            if !check && !run content.closing(&mut state) {
              continue
            }
            break
          }
          Event.QuitRequested => {
            if !check && !run content.closing(&mut state) {
              continue
            }
            break
          }
          _ => {
            if !check && run feed(&mut tree, &value) {
              run serve(&mut platform, owner, &mut tree, &mut host)
              run inspector.observe(&tree)
              run content.pump(&mut state, &mut tree)
              platform.setCursor(owner, windowCursor(tree.cursor()))
              redraw = content.needsFrame(&state.*, &tree)
            }
          }
        }
      }
      if resized {
        let w = deviceSize(width, scale)
        let h = deviceSize(height, scale)
        if w > 0 && h > 0 {
          surface.resize(&mut configuration, w, h)
          configured = true
        }
        run content.resize(&mut state, &mut tree, f64.toF32(width), f64.toF32(height))
        redraw = true
      }
    }
    if !check && run content.update(&mut state, &mut tree, &mut platform, owner) {
      redraw = true
    }
    if inspector.enabled() && (content.needsFrame(&state.*, &tree) || inspector.wantsFrame()) {
      run content.prepare(&mut state, &mut tree)
      run content.layout(
        &mut state,
        &mut tree,
        FrameInput {
          width: f64.toF32(width),
          height: f64.toF32(height),
          scale: f64.toF32(scale),
          time: time,
        },
      )
      run serve(&mut platform, owner, &mut tree, &mut host)
      let composedInput = tree.input
      run content.frame(&mut state, &mut tree, composedInput, &inspector)
      run inspector.afterFrameScene(&tree, content.scene(&state.*, &tree))
      redraw = true
    }
    if redraw {
      platform.requestFrame(owner)
    }
  }
  run inspector.close()
  surface.unconfigure()
  platform.closeWindow(owner)
  return status
}
