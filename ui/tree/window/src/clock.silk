//! Seconds on a monotonic clock, on every target the window host builds for: std's
//! `OsMonotonicClock` natively, the page's `performance.now()` (the `silk_browser#now` import of
//! `browser/app-host.js`) in the browser.
static if Intrinsic.targetArchitecture() == "wasm32" {
  unsafe extern "C" fn hostNow() -> f64 as "silk_browser#now"

  /// A monotonic clock in seconds.
  pub struct Clock {}

  impl Clock {
    pub fn make() -> Clock {
      return Clock {}
    }

    /// Seconds since an arbitrary start.
    pub effect fn seconds(self: &mut Self) -> f64 {
      return unsafe hostNow() / 1000.0
    }
  }
} else {
  import silk.core.effect { Effect }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.monotonic_clock_native { OsMonotonicClock }
  import silk.system.system_clock { SystemClock }
  import silk.num.i64

  /// A monotonic clock in seconds.
  pub struct Clock {
    os: OsMonotonicClock,
  }

  impl Clock {
    pub fn make() -> Clock {
      return Clock { os: OsMonotonicClock.make() }
    }

    /// Seconds since an arbitrary start.
    pub effect fn seconds(self: &mut Self) -> f64 {
      let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut self.os)
      return i64.toF64(SystemClock.seconds(&now))
        + i64.toF64(SystemClock.nanoseconds(&now)) / 1000000000.0
    }
  }
}
