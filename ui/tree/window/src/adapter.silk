//! Window events to tree input. Positions and point deltas are logical points, which are CSS
//! pixels; wheel notches become [`LINE_PIXELS`] each. native/platform/window's scroll deltas are
//! positive when content moves down, the tree's when it scrolls down, so the sign flips.
import accessibility
import accessibility { AxAction, AxNode }
import platform_thread { AccessLink, HostPlatform }
import silk.core.effect { Effect }
import keys { codeName, keyName }
import window.event { Event, Key, MouseButton, Phase, ScrollDelta, Modifiers }
import window.types { Wait }
import silk.geometry.vector { Vector2 }
import window.types { Cursor as WindowCursor, ImeState, WindowId }
import window.platform { Platform }
import ui_tree.lib { UiTree, Input, Cursor, HostRequest, ImeArea, NodeInfo }
import ui_tree.inspect
import ui_tree.mutation { LISTEN_WHEEL, NodeKind }
import ui_tree.scrollbar { usedOverflow, userScrolls }
import render_thread { FastScroll, ScrollerAxes }
import silk.collections.list { List }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.usize
import silk.num.u32
import silk.text.string { String }

/// CSS pixels per wheel notch, as browsers scroll.
pub const LINE_PIXELS: f32 = 40.0

/// The DOM button number of a window mouse button.
pub fn buttonOf(button: MouseButton) -> u32 {
  return match button {
    MouseButton.Left => 0
    MouseButton.Middle => 1
    MouseButton.Right => 2
    MouseButton.Back => 3
    MouseButton.Forward => 4
    MouseButton.Other => 5
  }
}

/// The tree's `MOD_*` bits: shift, control, alt and meta, as native/platform/window packs them.
pub fn modifierBits(modifiers: Modifiers) -> u32 {
  return u32.bitAnd(modifiers.bits(), 15)
}

fn f(value: f64) -> f32 {
  return f64.toF32(value)
}

effect fn keyText(key: &Key) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &key.* {
    Key.Character { text } => run String.copy(String.view(&text))
    Key.Named { key: named } => run String.copy(keyName(named))
  }
}

/// The tree input for a window event, or None for events the tree does not take (frames and
/// window state). Keys the input method handled stay with it.
pub effect fn toInput(event: &Event) -> Option<Input>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &event.* {
    Event.MouseMoved { position, modifiers, .. } => Option<Input>.Some {
      value: Input.PointerMove {
        x: f(position.x),
        y: f(position.y),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.MouseDown { button, position, modifiers, clickCount, .. } => Option<Input>.Some {
      value: Input.PointerDown {
        x: f(position.x),
        y: f(position.y),
        button: buttonOf(button),
        modifiers: modifierBits(modifiers),
        clickCount: clickCount,
      },
    }
    Event.MouseUp { button, position, modifiers, .. } => Option<Input>.Some {
      value: Input.PointerUp {
        x: f(position.x),
        y: f(position.y),
        button: buttonOf(button),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.MouseExited { .. } => Option<Input>.Some { value: Input.PointerLeave }
    Event.Focused { focused, .. } => if focused {
      Option<Input>.None
    } else {
      Option<Input>.Some { value: Input.PointerCancel }
    }
    Event.Scroll { position, delta, modifiers, .. } => {
      let mut dx: f32 = 0.0
      let mut dy: f32 = 0.0
      match delta {
        ScrollDelta.Lines { delta: lines } => {
          dx = -f(lines.x) * LINE_PIXELS
          dy = -f(lines.y) * LINE_PIXELS
        }
        ScrollDelta.Points { delta: points } => {
          dx = -f(points.x)
          dy = -f(points.y)
        }
      }
      return Option<Input>.Some {
        value: Input.Wheel {
          x: f(position.x),
          y: f(position.y),
          deltaX: dx,
          deltaY: dy,
          modifiers: modifierBits(modifiers),
        },
      }
    }
    Event.KeyDown { key, code, modifiers, repeat, imeHandled, .. } => if imeHandled {
      Option<Input>.None
    } else {
      Option<Input>.Some {
        value: Input.KeyDown {
          key: run keyText(&key),
          code: run String.copy(codeName(code)),
          modifiers: modifierBits(modifiers),
          repeat: repeat,
        },
      }
    }
    Event.KeyUp { key, code, modifiers, .. } => Option<Input>.Some {
      value: Input.KeyUp {
        key: run keyText(&key),
        code: run String.copy(codeName(code)),
        modifiers: modifierBits(modifiers),
      },
    }
    Event.TextInput { text, .. } => Option<Input>.Some {
      value: Input.TextInput { text: run String.copy(String.view(&text)) },
    }
    Event.ImePreedit { text, selectionStart, selectionEnd, .. } => Option<Input>.Some {
      value: Input.ImePreedit {
        text: run String.copy(String.view(&text)),
        selectionStart: selectionStart,
        selectionEnd: selectionEnd,
      },
    }
    _ => Option<Input>.None
  }
}

/// Dispatches `event` to `tree` when it is input. Returns whether it was.
pub effect fn feed(tree: &mut UiTree<'_>, event: &Event) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  match run toInput(event) {
    Option<Input>.Some { value } => {
      run tree.dispatch(move value)
      return true
    }
    Option<Input>.None => {
      return false
    }
  }
}

/// What the host last told the platform about the tree, so [`serve`] only calls it on a
/// change.
pub struct HostState {
  pub ime: ImeArea,
  pub imeSet: bool,
  accessibilityFrame: u64,
  /// The platform thread's accessibility link, when the platform runs on its own thread.
  access: Option<AccessLink>,
}

impl HostState {
  pub fn make() -> HostState {
    return HostState {
      ime: ImeArea.none(),
      imeSet: false,
      accessibilityFrame: 18446744073709551615,
      access: Option<AccessLink>.None,
    }
  }

  /// The state for a host whose platform is `platform`.
  pub fn of(platform: &HostPlatform) -> HostState {
    let mut state = HostState.make()
    state.access = platform.accessLink()
    return move state
  }
}

/// Answers the tree's requests through `platform` for `window`: clipboard writes, clipboard
/// reads (pasted back with `Input.Paste`), and the input method's state and caret rectangle,
/// set when they change. Call it after dispatching input and after each frame.
pub effect fn serve<P: Platform>(
  platform: &mut P,
  window: WindowId,
  tree: &mut UiTree<'_>,
  state: &mut HostState,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &state.access {
    Option<AccessLink>.Some { value } => {
      // The platform thread talks to the OS; this side sends snapshots and answers actions.
      let mut actions = List<AxAction>.make()
      run value.take(&mut actions)
      run accessibility.apply(&mut tree, &mut actions)
      if accessibility.supported() && state.accessibilityFrame != tree.semanticRevision
        && !tree.layoutPending() {
        let mut heap = Allocator.systemAllocatorProvider()
        let mut nodes = List<AxNode>.make()
        run accessibility.snapshot(&tree.*, &mut nodes) |> Effect.provideMut<Allocator>(&mut heap)
        run value.publish(window, move nodes)
        state.accessibilityFrame = tree.semanticRevision
      }
    }
    Option<AccessLink>.None => {
      run accessibility.poll(&mut tree, window)
      if state.accessibilityFrame != tree.semanticRevision && !tree.layoutPending() {
        run accessibility.sync(&tree.*, window)
        state.accessibilityFrame = tree.semanticRevision
      }
    }
  }
  let mut requests = List<HostRequest>.make()
  run tree.takeRequests(&mut requests)
  let values = requests.asSlice()
  let mut i: usize = 0
  while i < values.length {
    match &values[i] {
      HostRequest.WriteClipboard { text } => {
        run platform.writeClipboard(String.view(&text))
      }
      HostRequest.ReadClipboard { target } => {
        match run platform.readClipboard() {
          Option<String>.Some { value } => {
            run tree.dispatch(Input.Paste { target: target, text: move value })
          }
          Option<String>.None => {}
        }
      }
    }
    i = i + 1
  }
  let ime = run tree.imeArea()
  if !state.imeSet || !ime.same(&state.ime) {
    state.ime = ime
    state.imeSet = true
    if ime.enabled {
      platform.setIme(
        window,
        ImeState.at(
          Rect<f64>.new(
            f32.toF64(ime.rect.xMin),
            f32.toF64(ime.rect.yMin),
            f32.toF64(ime.rect.xMax),
            f32.toF64(ime.rect.yMax),
          ),
        ),
      )
    } else {
      platform.setIme(window, ImeState.disabled())
    }
  }
}

/// The window cursor for a tree cursor.
pub fn windowCursor(cursor: Cursor) -> WindowCursor {
  return match cursor {
    Cursor.Default => WindowCursor.Arrow
    Cursor.Pointer => WindowCursor.PointingHand
    Cursor.Text => WindowCursor.IBeam
    Cursor.Move => WindowCursor.OpenHand
    Cursor.Grab => WindowCursor.OpenHand
    Cursor.Grabbing => WindowCursor.ClosedHand
    Cursor.NotAllowed => WindowCursor.NotAllowed
    Cursor.ResizeHorizontal => WindowCursor.ResizeLeftRight
    Cursor.ResizeVertical => WindowCursor.ResizeUpDown
    Cursor.ResizeNorthWestSouthEast => WindowCursor.ResizeNorthWestSouthEast
    Cursor.ResizeNorthEastSouthWest => WindowCursor.ResizeNorthEastSouthWest
    Cursor.Crosshair => WindowCursor.Crosshair
  }
}

/// Whether `phase` belongs to the middle of a scroll gesture, where deltas can be summed.
fn mergeablePhase(phase: Phase) -> bool {
  return match phase {
    Phase.None => true
    Phase.Changed => true
    Phase.Momentum => true
    _ => false
  }
}

/// Folds the events already queued behind `first` into it, so a slow frame does not leave a
/// backlog that runs the client once per event: consecutive pointer moves keep the last
/// position, and consecutive scrolls of one kind and phase sum their deltas. The first event
/// that does not fold is left in `pending` for the next pass.
pub effect fn coalesce<P: Platform>(
  platform: &mut P,
  first: Event,
  pending: &mut Option<Event>,
) -> Event
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut current = move first
  while true {
    let folds = match &current {
      Event.MouseMoved { window, position, modifiers } => true
      Event.Scroll { window, position, delta, phase, modifiers } => mergeablePhase(phase)
      _ => false
    }
    if !folds {
      return move current
    }
    let following = match run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => move value
      Option<Event>.None => {
        return move current
      }
    }
    let merged = match &current {
      Event.MouseMoved { window, position, modifiers } => match &following {
        Event.MouseMoved { window: next, position: at, modifiers: keys } => if next.value
          == window.value {
          Option<Event>.some(Event.MouseMoved { window: next, position: at, modifiers: keys })
        } else {
          Option<Event>.None
        }
        _ => Option<Event>.None
      }
      Event.Scroll { window, position, delta, phase, modifiers } => match &following {
        Event.Scroll { window: next, position: at, delta: more, phase: stage, modifiers: keys } => {
          let sameKeys = keys.bits() == modifiers.bits()
          if next.value == window.value && stage == phase && sameKeys {
            match sum(delta, more) {
              Option<ScrollDelta>.Some { value } => Option<Event>.some(
                Event.Scroll {
                  window: next,
                  position: at,
                  delta: value,
                  phase: stage,
                  modifiers: keys,
                },
              )
              Option<ScrollDelta>.None => Option<Event>.None
            }
          } else {
            Option<Event>.None
          }
        }
        _ => Option<Event>.None
      }
      _ => Option<Event>.None
    }
    match move merged {
      Option<Event>.Some { value } => {
        drop current
        drop following
        current = move value
      }
      Option<Event>.None => {
        pending.* = Option<Event>.some(move following)
        return move current
      }
    }
  }
  return move current
}

/// The sum of two scroll deltas of the same unit, or None when the units differ.
fn sum(left: ScrollDelta, right: ScrollDelta) -> Option<ScrollDelta> {
  return match left {
    ScrollDelta.Lines { delta } => match right {
      ScrollDelta.Lines { delta: more } => Option<ScrollDelta>.some(
        ScrollDelta.Lines { delta: Vector2<f64>.new(delta.x + more.x, delta.y + more.y) },
      )
      _ => Option<ScrollDelta>.None
    }
    ScrollDelta.Points { delta } => match right {
      ScrollDelta.Points { delta: more } => Option<ScrollDelta>.some(
        ScrollDelta.Points { delta: Vector2<f64>.new(delta.x + more.x, delta.y + more.y) },
      )
      _ => Option<ScrollDelta>.None
    }
  }
}

/// What the compositor needs to scroll `tree`'s frame on its own, at `scale` device pixels per
/// CSS pixel: the scroll containers the user can scroll, and the bounds of nodes that listen for
/// wheel events (a wheel there goes to the app first). Allocated with the system allocator, to
/// cross to the render thread.
pub effect fn fastScrollOf(tree: &UiTree<'_>, scale: f32) -> FastScroll
  ! OutOfMemoryError {
  let mut heap = Allocator.systemAllocatorProvider()
  let mut fast = FastScroll.make()
  let count = tree.nodes.length()
  let mut slot: usize = 0
  while slot < count {
    let node = tree.node(usize.toU32(slot))
    slot = slot + 1
    if !node.live || node.kind == NodeKind.Text {
      continue
    }
    let x = userScrolls(usedOverflow(&node.computed, true))
    let y = userScrolls(usedOverflow(&node.computed, false))
    if x || y {
      run fast.scrollers.append(ScrollerAxes { node: node.id, x: x, y: y })
        |> Effect.provideMut<Allocator>(&mut heap)
    }
    if (node.listeners & LISTEN_WHEEL) != 0 {
      let found = run inspect.info(tree, node.id) |> Effect.provideMut<Allocator>(&mut heap)
      if let Option<NodeInfo>.Some { value } = found {
        let b = value.bounds
        run fast.blocked.append(
          Rect<f32>.new(b.xMin * scale, b.yMin * scale, b.xMax * scale, b.yMax * scale),
        )
          |> Effect.provideMut<Allocator>(&mut heap)
      }
    }
  }
  return move fast
}
