#!/usr/bin/env python3
"""Build a Silk UI app for the browser and serve it, or test it in the installed Chromium.

  ui/tree/window/scripts/browser serve [PACKAGE] [--port 8050] [--debug]
  ui/tree/window/scripts/browser test [PACKAGE] [--debug] [-- TEST OPTIONS]
  ui/tree/window/scripts/browser build [PACKAGE] [--debug]

PACKAGE is the folder of a program whose wasm32 `main` runs `ui_tree_window.host.runWindow`
(directly or through ui-app-window); the default is the notes app, examples/notes/browser.
`serve` prints the page's address: open it in Chrome or Edge 137 or later (WebGPU and JSPI).
The server reads the module on every request, so after `build` a reload shows the new one.

`test` runs ui/tree/window/browser/test.mjs: the app's rendering check at `?check`, then real
input. Options after `--` go to it (--size W,H, --scale N, --click X,Y, --type TEXT,
--screenshot FILE). It needs Node and an existing Playwright installation (PLAYWRIGHT_MODULE, as
set by native/gpu/webgpu/scripts/setup-ci --browser) and never downloads a browser. On Linux it
runs under xvfb-run, as Chromium's headless mode lacks WebGPU presentation.
"""
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
REPO = HERE.parents[2]
sys.path.insert(0, str(REPO / "native" / "gpu" / "webgpu" / "scripts"))
from _build import build, command_path  # noqa: E402

DEFAULT = REPO / "examples" / "notes" / "browser"

# The stack the module gets, in bytes. The compiler links wasm with 1 MiB, which a deep layout
# (Studio's 100k cards demo) overflows into a trap; native threads get 8 MiB.
STACK = 8 * 1024 * 1024


def linking_clang():
    """A clang that links wasm modules with an 8 MiB stack: the pinned one, with the stack size
    added after the compiler's own (the linker keeps the last)."""
    clang = command_path("install-llvm")
    wrapper = REPO / ".cache" / "browser-clang" / "clang"
    wrapper.parent.mkdir(parents=True, exist_ok=True)
    text = (f"#!{sys.executable}\n"
            "import os, sys\n"
            "args = sys.argv[1:]\n"
            "if not any(a in args for a in ('-c', '-S', '-E', '-v', '--version')):\n"
            f"    args.append('-Wl,-z,stack-size={STACK}')\n"
            f"os.execv({str(clang)!r}, [{str(clang)!r}, *args])\n")
    if not wrapper.exists() or wrapper.read_text() != text:
        wrapper.write_text(text)
        wrapper.chmod(0o755)
    return wrapper


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("mode", choices=["serve", "test", "build"])
    parser.add_argument("package", nargs="?", default=str(DEFAULT), help="the app's package folder")
    parser.add_argument("--port", type=int, default=8050)
    parser.add_argument("--debug", action="store_true", help="a debug build (much slower)")
    argv = sys.argv[1:]
    rest = argv[argv.index("--") + 1:] if "--" in argv else []
    args = parser.parse_args(argv[:argv.index("--")] if "--" in argv else argv)
    module = build(Path(args.package), release=not args.debug, target="wasm32-unknown-unknown",
                   clang=linking_clang())
    if args.mode == "build":
        print(module)
        return 0
    if args.mode == "serve":
        return subprocess.run(["node", str(HERE / "browser" / "serve.mjs"), str(module), str(args.port)]).returncode
    command = ["node", str(HERE / "browser" / "test.mjs"), "--wasm", str(module), *rest]
    if sys.platform == "linux":
        if not shutil.which("xvfb-run") or not shutil.which("xauth"):
            raise SystemExit("the browser test needs xvfb-run and xauth on Linux; run native/gpu/webgpu/scripts/setup-ci --browser")
        command = ["xvfb-run", "--auto-servernum", "--server-args=-screen 0 1280x800x24", *command]
    return subprocess.run(command, timeout=1200).returncode


if __name__ == "__main__":
    raise SystemExit(main())
