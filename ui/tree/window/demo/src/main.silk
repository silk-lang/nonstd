//! A native counter driven only by tree mutations and events. Pass --check for a GPU smoke test.
import ui_tree.lib { UiTree, TreeError, Batch, Mutation, NodeKind, Property, Length, Attribute }
import ui_tree.mutation { Role, LISTEN_CLICK }
import ui_tree.node { Event, EventKind }
import ui_tree_window.host { WindowClient, RunOptions, runWindow }
import ui_tree_window.platform_thread { Launched, launch }
import silk.core.option { Option }
import ui_fixtures.fixtures as fixtures
import ui_inspect_server.lib { Inspector }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import ui_tree_window.console { StderrWriter }
import ui_tree_window.browser { checkRequested }
import silk.text.string { String }

struct Counter {
  clicks: u32
}

struct Client {}

impl WindowClient<Counter, never, never> for Client {
  effect fn start(self: &mut Self, state: &mut Counter, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut batch = Batch.make()
    run batch.create(1, NodeKind.Box)
    run batch.root(1)
    run batch.box(
      1,
      2,
      &[
        Property.Width { value: Length.px(180.0) },
        Property.Height { value: Length.px(70.0) },
        Property.FontSize { value: 24.0 },
      ],
    )
    run batch.attribute(2, Attribute.TestId { value: run String.copy("counter") })
    run batch.attribute(2, Attribute.Role { value: Role.Button })
    run batch.attribute(2, Attribute.TabIndex { value: 0 })
    run batch.push(Mutation.SetListeners { id: 2, flags: LISTEN_CLICK })
    run batch.text(2, 3, "Click me")
    run tree.apply(run batch.take())
  }

  effect fn pump(self: &mut Self, state: &mut Counter, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let mut events = List<Event>.make()
    run tree.takeEvents(&mut events)
    let values = events.asSlice()
    let mut i: usize = 0
    while i < values.length {
      if values[i].kind == EventKind.Click && values[i].target == 2 {
        state.clicks = state.clicks + 1
        let mut batch = Batch.make()
        run batch.setText(3, "Clicked")
        run tree.apply(run batch.take())
      }
      i = i + 1
    }
  }
}

effect fn program(check: bool, platform: Option<Launched>) -> i32
  ! TreeError | WindowError | GpuError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut state = Counter { clicks: 0 }
  let mut client = Client {}
  return run runWindow(
    &mut state,
    &fonts,
    List<Mutation>.make(),
    RunOptions {
      title: "Direct tree client",
      width: 400.0,
      height: 250.0,
      check: check,
      checkClick: "counter",
      checkExpect: "Clicked",
      lowestLatency: false,
      platform: move platform,
    },
    Inspector.off(),
    &mut client,
  )
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("Direct tree host failed\n", &())
  return 2
}

fn runApp(check: bool, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(check, move platform), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

static if Intrinsic.targetArchitecture() == "wasm32" {
  // The browser build (ui/tree/window/browser): the page calls `main` through JSPI. These two
  // modules must be in the program's own package, since a dependency exports no wasm symbols.
  import generated_webgpu_exports
  import libm

  /// Opens the counter on the page's canvas, or verifies its GPU output with `?check`.
  pub fn main() -> i32 {
    return runApp(checkRequested(), Option<Launched>.None)
  }
} else {
  /// Opens the direct-tree counter, or verifies its GPU output with --check.
  pub effect fn main() -> i32
    ? &mut HostInput {
    let mut allocator = Allocator.systemAllocatorProvider()
    let count = run Effect.catchAll(HostInput.argumentCount(), noArguments)
    let check = count > 1

    // The main thread keeps the OS event loop; the app runs on its own thread.
    return run Effect.catchAll(
      launch(
        fn(platform: Option<Launched>) -> i32 {
          return runApp(check, move platform)
        },
      ),
      failed,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  effect fn noArguments<E>(error: E) -> usize {
    drop error
    return 0
  }
}
