#!/usr/bin/env python3
"""Build and run the direct-tree native counter. --check verifies input and GPU output."""
import argparse
from pathlib import Path
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent
REPO = PACKAGE.parents[3]
sys.path.insert(0, str(REPO / 'native/gpu/webgpu/scripts'))
from _build import build

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--debug', action='store_true')
parser.add_argument('--build-only', action='store_true')
args, forwarded = parser.parse_known_args()
binary = build(PACKAGE, release=not args.debug)
if args.build_only:
    print(binary)
else:
    raise SystemExit(subprocess.run([str(binary), *forwarded], cwd=REPO).returncode)
