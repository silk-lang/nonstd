//! Window events through the adapter into the inbox fixture: native/platform/window's headless
//! backend delivers synthetic mouse, wheel and key events, the adapter turns them into tree
//! input, and the tree answers with records, focus and scroll offsets.
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { UiTree, TreeError, Batch, Event as Record, EventKind, Keymap }
import ui_tree_window.lib { feed, serve, windowCursor, HostState, coalesce }
import window.event { Event, Key, MouseButton, Modifiers, Phase, ScrollDelta }
import window.headless { HeadlessPlatform, HeadlessWindow }
import window.keys { KeyCode, NamedKey }
import window.platform { Platform }
import window.types { WindowId, WindowOptions, WindowError, Wait, Cursor, ImeState }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.point { Point2 }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }

fn at(x: f64, y: f64) -> Point2<f64> {
  return Point2<f64>.new(x, y)
}

/// Pulls every queued window event and feeds it to the tree. Returns how many were input.
effect fn pump(platform: &mut HeadlessPlatform, tree: &mut UiTree) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut fed: u32 = 0
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        if run feed(&mut tree, &value) {
          fed = fed + 1
        }
      }
      Option<Event>.None => {
        break
      }
    }
  }
  return fed
}

fn count(events: &List<Record>, kind: EventKind, target: u32) -> usize {
  let values = events.asSlice()
  let mut found: usize = 0
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == kind && values[i].target == target {
      found = found + 1
    }
    i = i + 1
  }
  return found
}

/// Whether the key down record says Tab for both key and code.
fn namesTab(events: &List<Record>) -> bool {
  let values = events.asSlice()
  let mut i: usize = 0
  while i < values.length {
    if values[i].kind == EventKind.KeyDown {
      return String.view(&values[i].key) == "Tab" && String.view(&values[i].code) == "Tab"
    }
    i = i + 1
  }
  return false
}

effect fn body() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.inbox(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(2))

  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("inbox", 360.0, 440.0))
  drop run pump(&mut platform, &mut tree)
  let none = Modifiers.none()

  // Hover and click New.
  run platform.push(Event.MouseMoved { window: window, position: at(40.0, 27.0), modifiers: none })
  run platform.push(
    Event.MouseDown {
      window: window,
      button: MouseButton.Left,
      position: at(40.0, 27.0),
      modifiers: none,
      clickCount: 1,
    },
  )
  run platform.push(
    Event.MouseUp {
      window: window,
      button: MouseButton.Left,
      position: at(40.0, 27.0),
      modifiers: none,
    },
  )
  let fed = run pump(&mut platform, &mut tree)
  run Testing.expect(fed == 3, "three window events became input")
  let mut events = List<Record>.make()
  run tree.takeEvents(&mut events)
  run Testing.expect(count(&events, EventKind.Click, fixtures.NEW_BUTTON) == 1, "New was clicked")
  run Testing.expect(windowCursor(tree.cursor()) == Cursor.PointingHand, "the cursor maps")

  // One wheel notch towards the user scrolls the list down by 40 pixels.
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(340.0, 112.0),
      delta: ScrollDelta.Lines { delta: Vector2<f64> { x: 0.0, y: -1.0 } },
      phase: Phase.None,
      modifiers: none,
    },
  )

  // Tab moves focus from New to Archive.
  run platform.push(
    Event.KeyDown {
      window: window,
      key: Key.Named { key: NamedKey.Tab },
      code: KeyCode.Tab,
      modifiers: none,
      repeat: false,
      imeHandled: false,
    },
  )
  drop run pump(&mut platform, &mut tree)
  events.clear()
  run tree.takeEvents(&mut events)
  run Testing.expect(tree.scrollOffset(fixtures.INBOX_LIST).y == 40.0, "a notch is 40 pixels")
  run Testing.expect(
    count(&events, EventKind.KeyDown, fixtures.NEW_BUTTON) == 1 && namesTab(&events),
    "the key record names the key",
  )
  run Testing.expect(tree.focused == tree.slotOf(fixtures.ARCHIVE_BUTTON), "Tab moved focus")
}

test effect fn windowEventsDriveTheTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn valueOf(tree: &UiTree, id: u32) -> string {
  return String.view(&tree.node(tree.slotOf(id)).text)
}

effect fn shortcut(
  platform: &mut HeadlessPlatform,
  window: WindowId,
  letter: string,
  code: KeyCode,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut modifiers = Modifiers.none()
  modifiers.control = true
  run platform.push(
    Event.KeyDown {
      window: window,
      key: Key.Character { text: run String.copy(letter) },
      code: code,
      modifiers: modifiers,
      repeat: false,
      imeHandled: false,
    },
  )
}

/// Text input, composition and the clipboard through the adapter: the editor's focused
/// search field takes typed and committed text, its caret reaches the platform's input method,
/// and copy and paste go through the headless clipboard.
effect fn editingBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  tree.keymap = Keymap.Standard
  let mut batch = Batch.make()
  run fixtures.editor(&mut batch)
  run tree.apply(run batch.take())
  run tree.frame(fixtures.viewport(3))
  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("editor", 360.0, 300.0))
  drop run pump(&mut platform, &mut tree)
  let mut host = HostState.make()
  run serve(&mut platform, window, &mut tree, &mut host)
  let ime = match platform.window(window) {
    Option<&HeadlessWindow>.Some { value } => value.ime
    Option<&HeadlessWindow>.None => ImeState.disabled()
  }
  run Testing.expect(ime.enabled && ime.cursorArea.xMin > 29.0, "the input method gets the caret")

  // Copy "wonderful", type over it, compose and commit, then paste.
  run shortcut(&mut platform, window, "c", KeyCode.KeyC)
  drop run pump(&mut platform, &mut tree)
  run serve(&mut platform, window, &mut tree, &mut host)
  run platform.push(Event.TextInput { window: window, text: run String.copy("great") })
  run platform.push(
    Event.ImePreedit {
      window: window,
      text: run String.copy("\u{306b}"),
      selectionStart: 3,
      selectionEnd: 3,
    },
  )
  drop run pump(&mut platform, &mut tree)
  run Testing.expect(
    valueOf(&tree, fixtures.SEARCH) == "Hello great world",
    "typed text replaces the selection",
  )
  run platform.push(
    Event.ImePreedit { window: window, text: String.make(), selectionStart: 0, selectionEnd: 0 },
  )
  run platform.push(Event.TextInput { window: window, text: run String.copy("\u{4e8c}") })
  run shortcut(&mut platform, window, "v", KeyCode.KeyV)
  drop run pump(&mut platform, &mut tree)
  run serve(&mut platform, window, &mut tree, &mut host)
  run Testing.expect(
    valueOf(&tree, fixtures.SEARCH) == "Hello great\u{4e8c}wonderful world",
    "the commit and the paste land at the caret",
  )
}

test effect fn textInputImeAndClipboardThroughTheAdapter() -> ()
  ! AssertionError<'static>
    | TreeError
    | WindowError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run editingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Drains the queue so only pushed events follow.
effect fn drain(platform: &mut HeadlessPlatform) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  while true {
    match move run platform.nextEvent(Wait.Poll) {
      Option<Event>.Some { value } => {
        drop value
      }
      Option<Event>.None => {
        break
      }
    }
  }
}

effect fn coalesceBody() -> ()
  ! AssertionError<'static> | WindowError | OutOfMemoryError
  ? &mut Allocator {
  let mut platform = run HeadlessPlatform.start()
  let window = run platform.openWindow(&WindowOptions.make("coalesce", 200.0, 200.0))
  run drain(&mut platform)
  let none = Modifiers.none()
  run platform.push(Event.MouseMoved { window: window, position: at(1.0, 1.0), modifiers: none })
  run platform.push(Event.MouseMoved { window: window, position: at(2.0, 2.0), modifiers: none })
  run platform.push(Event.MouseMoved { window: window, position: at(3.0, 4.0), modifiers: none })
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(5.0, 5.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 0.0, y: -10.0 } },
      phase: Phase.Changed,
      modifiers: none,
    },
  )
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(6.0, 6.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 1.0, y: -15.0 } },
      phase: Phase.Changed,
      modifiers: none,
    },
  )
  run platform.push(
    Event.Scroll {
      window: window,
      position: at(6.0, 6.0),
      delta: ScrollDelta.Points { delta: Vector2<f64> { x: 0.0, y: 0.0 } },
      phase: Phase.Ended,
      modifiers: none,
    },
  )
  let mut pending = Option<Event>.None
  let first = match move run platform.nextEvent(Wait.Poll) {
    Option<Event>.Some { value } => move value
    Option<Event>.None => Event.QuitRequested
  }
  let moved = run coalesce(&mut platform, move first, &mut pending)
  let lastMove = match &moved {
    Event.MouseMoved { window: w, position, modifiers } => position.x == 3.0 && position.y == 4.0
    _ => false
  }
  run Testing.expect(lastMove, "three queued moves fold into the last one")
  let next = match move Intrinsic.replace(pending, Option<Event>.None) {
    Option<Event>.Some { value } => move value
    Option<Event>.None => Event.QuitRequested
  }
  let scrolled = run coalesce(&mut platform, move next, &mut pending)
  let summed = match &scrolled {
    Event.Scroll { window: w, position, delta, phase, modifiers } => match delta {
      ScrollDelta.Points { delta: d } => d.x == 1.0 && d.y == -25.0 && position.x == 6.0
      _ => false
    }
    _ => false
  }
  run Testing.expect(summed, "two scrolls in one phase sum their deltas")
  let ended = match move pending {
    Option<Event>.Some { value } => match move value {
      Event.Scroll { window: w, position, delta, phase, modifiers } => phase == Phase.Ended
      _ => false
    }
    Option<Event>.None => false
  }
  run Testing.expect(ended, "the gesture's end is kept for the next pass")
  drop moved
  drop scrolled
}

test effect fn queuedPointerAndWheelEventsCoalesce() -> ()
  ! AssertionError<'static> | WindowError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run coalesceBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
