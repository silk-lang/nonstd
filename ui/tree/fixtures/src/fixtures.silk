//! The trees the tests and goldens draw: a card list, a sign-in form and an inbox with
//! buttons and nested scrolling, built from mutation
//! batches as a client would send them. Fonts, icons and the photo are graphics/demo's embedded
//! assets, so the native tests and the browser comparison draw the same bytes.
import ui_tree.lib {
  FrameInput,
  UiTree,
  TreeError,
  Batch,
  NodeKind,
  Property,
  Length,
  Side,
  Display,
  FlexDirection,
  Align,
  Overflow,
  BoxSizing,
  BorderStyle,
  LineHeight,
  BoxShadow,
  DecorationLine,
  StyleState,
  Role,
  Attribute,
  CanvasCommand,
  Mutation,
  Cursor,
  LISTEN_ALL
}
import font_collection.lib { FontCollection }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.geometry.corners { Corners }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import demo.assets as assets

/// Noto Sans regular and bold (the subsets graphics/demo embeds).
pub effect fn fonts() -> FontCollection
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut collection = FontCollection.make()
  drop run collection.add(run copy(assets.regularFont()))
  drop run collection.add(run copy(assets.boldFont()))
  return move collection
}

effect fn copy(data: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes = Bytes.make()
  run Bytes.append(&mut bytes, data)
  return move bytes
}

pub fn rgb(hex: u32) -> Rgba<f32> {
  return rgba(hex, 1.0)
}

pub fn rgba(hex: u32, alpha: f32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: alpha }
}

fn px(value: f32) -> Length {
  return Length.Px { value: value }
}

/// Margin, padding or border properties for all four sides.
pub fn padding(value: f32) -> [Property; 4] {
  return [
    Property.Padding { side: Side.Top, value: px(value) },
    Property.Padding { side: Side.Right, value: px(value) },
    Property.Padding { side: Side.Bottom, value: px(value) },
    Property.Padding { side: Side.Left, value: px(value) },
  ]
}

pub fn border(width: f32) -> [Property; 4] {
  return [
    Property.BorderWidth { side: Side.Top, value: width },
    Property.BorderWidth { side: Side.Right, value: width },
    Property.BorderWidth { side: Side.Bottom, value: width },
    Property.BorderWidth { side: Side.Left, value: width },
  ]
}

/// The font family every fixture uses.
pub const SANS: u32 = 1

pub const STAR_ICON: u32 = 1

pub const BELL_ICON: u32 = 2

pub const PHOTO_IMAGE: u32 = 3

/// Card list ids: card `i` (0, 1, 2) is `CARD + 10 * i`.
pub const LIST: u32 = 1

pub const CARD: u32 = 100

pub effect fn resources(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  run batch.icon(STAR_ICON, assets.icon(assets.STAR))
  run batch.icon(BELL_ICON, assets.icon(assets.BELL))
  run batch.image(PHOTO_IMAGE, assets.photo(0))
}

fn cardTitle(index: u32) -> string<'static> {
  return match index {
    0 => "Design review"
    1 => "Release notes"
    _ => "Team sync"
  }
}

fn cardBody(index: u32) -> string<'static> {
  return match index {
    0 => "Walk through the new layout with the whole team before Friday."
    1 => "Version 0.4 ships retained trees, "
    _ => "Short and sweet."
  }
}

/// One card: an icon, a title and body text, and a badge. Card 1's body has a highlighted
/// inline span that wraps across lines.
pub effect fn card(batch: &mut Batch, parent: u32, index: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = CARD + 10 * index
  run batch.box(
    parent,
    id,
    &[
      Property.Display { value: Display.Flex },
      Property.FlexDirection { value: FlexDirection.Row },
      Property.AlignItems { value: Align.Start },
      Property.ColumnGap { value: px(12.0) },
      Property.BackgroundColor { color: rgb(0xffffff) },
      Property.BorderColor { color: rgb(0xe5e7eb) },
      Property.BorderRadius { value: Corners<f32>.uniform(12.0) },
      Property.BoxShadow {
        value: BoxShadow {
          offsetX: 0.0,
          offsetY: 2.0,
          blur: 8.0,
          spread: 0.0,
          color: rgba(0x000000, 0.15),
          inset: false,
        },
      },
    ],
  )
  run batch.style(id, &padding(12.0))
  run batch.style(id, &border(1.0))
  run batch.attribute(id, Attribute.Role { value: Role.ListItem })
  let icon = id + 1
  run batch.create(icon, NodeKind.Icon)
  run batch.source(
    icon,
    if index == 1 {
      BELL_ICON
    } else {
      STAR_ICON
    },
  )
  run batch.style(
    icon,
    &[
      Property.Width { value: px(24.0) },
      Property.Height { value: px(24.0) },
      Property.Display { value: Display.Block },
      Property.Color { color: rgb(0x2563eb) },
    ],
  )
  run batch.append(id, icon)
  let column = id + 2
  run batch.box(
    id,
    column,
    &[Property.FlexGrow { value: 1.0 }, Property.FlexBasis { value: px(0.0) }],
  )
  let title = id + 3
  run batch.box(
    column,
    title,
    &[
      Property.FontWeight { value: 700.0 },
      Property.FontSize { value: 16.0 },
      Property.Color { color: rgb(0x111827) },
    ],
  )
  run batch.text(title, id + 4, cardTitle(index))
  let body = id + 5
  run batch.box(
    column,
    body,
    &[
      Property.FontSize { value: 13.0 },
      Property.Color { color: rgb(0x4b5563) },
      Property.LineHeight { value: LineHeight.Number { value: 1.4 } },
    ],
  )
  run batch.text(body, id + 6, cardBody(index))
  if index == 1 {
    let span = id + 7
    run batch.box(
      body,
      span,
      &[
        Property.Display { value: Display.Inline },
        Property.BackgroundColor { color: rgb(0xfef3c7) },
        Property.BorderRadius { value: Corners<f32>.uniform(3.0) },
        Property.Color { color: rgb(0x92400e) },
        Property.Padding { side: Side.Left, value: px(3.0) },
        Property.Padding { side: Side.Right, value: px(3.0) },
      ],
    )
    run batch.text(span, id + 8, "scene replay and inline fragments")
    run batch.text(body, id + 9, " for text.")
  }
  let badge = id + 50
  run batch.box(
    id,
    badge,
    &[
      Property.BackgroundColor { color: rgb(0xdbeafe) },
      Property.Color { color: rgb(0x1d4ed8) },
      Property.FontSize { value: 12.0 },
      Property.BorderRadius { value: Corners<f32>.uniform(9.0) },
      Property.Padding { side: Side.Top, value: px(1.0) },
      Property.Padding { side: Side.Bottom, value: px(1.0) },
      Property.Padding { side: Side.Left, value: px(8.0) },
      Property.Padding { side: Side.Right, value: px(8.0) },
    ],
  )
  run batch.text(
    badge,
    badge + 1,
    if index == 0 {
      "New"
    } else {
      "Open"
    },
  )
  run batch.testId(
    badge,
    if index == 0 {
      "badge-0"
    } else if index == 1 {
      "badge-1"
    } else {
      "badge-2"
    },
  )
}

/// The card list: three cards, then a row with an image, a half-transparent box and a canvas,
/// then a clipped box of text.
pub effect fn cardList(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run resources(&mut batch)
  run batch.create(LIST, NodeKind.Box)
  run batch.style(
    LIST,
    &[
      Property.FontFamily { family: SANS },
      Property.Display { value: Display.Flex },
      Property.FlexDirection { value: FlexDirection.Column },
      Property.RowGap { value: px(12.0) },
      Property.Height { value: Length.Percent { value: 100.0 } },
      Property.BoxSizing { value: BoxSizing.BorderBox },
      Property.BackgroundColor { color: rgb(0xf3f4f6) },
    ],
  )
  run batch.style(LIST, &padding(16.0))
  run batch.attribute(LIST, Attribute.Role { value: Role.List })
  run batch.label(LIST, "Tasks")
  run batch.root(LIST)
  let mut i: u32 = 0
  while i < 3 {
    run card(&mut batch, LIST, i)
    i = i + 1
  }
  let row: u32 = 10
  run batch.box(
    LIST,
    row,
    &[
      Property.Display { value: Display.Flex },
      Property.ColumnGap { value: px(12.0) },
      Property.AlignItems { value: Align.Center },
    ],
  )
  let photo: u32 = 11
  run batch.create(photo, NodeKind.Image)
  run batch.source(photo, PHOTO_IMAGE)
  run batch.style(
    photo,
    &[
      Property.Width { value: px(64.0) },
      Property.Height { value: px(48.0) },
      Property.BorderRadius { value: Corners<f32>.uniform(8.0) },
    ],
  )
  run batch.append(row, photo)
  run batch.box(
    row,
    12,
    &[
      Property.Width { value: px(48.0) },
      Property.Height { value: px(48.0) },
      Property.BackgroundGradient { angle: 135.0, from: rgb(0x22c55e), to: rgb(0x0ea5e9) },
      Property.BorderRadius { value: Corners<f32>.uniform(24.0) },
      Property.Opacity { value: 0.5 },
    ],
  )
  let chart: u32 = 13
  run batch.create(chart, NodeKind.Canvas)
  run batch.style(chart, &[Property.Width { value: px(96.0) }, Property.Height { value: px(48.0) }])
  run batch.canvas(
    chart,
    &[
      CanvasCommand.FillRect {
        x: 0.0,
        y: 0.0,
        width: 96.0,
        height: 48.0,
        radius: 6.0,
        color: rgb(0x1f2937),
      },
      CanvasCommand.MoveTo { x: 8.0, y: 40.0 },
      CanvasCommand.LineTo { x: 30.0, y: 22.0 },
      CanvasCommand.LineTo { x: 52.0, y: 30.0 },
      CanvasCommand.LineTo { x: 88.0, y: 8.0 },
      CanvasCommand.Stroke { color: rgb(0xfbbf24), width: 2.5 },
      CanvasCommand.MoveTo { x: 8.0, y: 44.0 },
      CanvasCommand.LineTo { x: 20.0, y: 32.0 },
      CanvasCommand.LineTo { x: 32.0, y: 44.0 },
      CanvasCommand.Close,
      CanvasCommand.Fill { color: rgba(0x60a5fa, 0.8) },
    ],
  )
  run batch.append(row, chart)
  let clip: u32 = 20
  run batch.box(
    LIST,
    clip,
    &[
      Property.Height { value: px(38.0) },
      Property.BoxSizing { value: BoxSizing.BorderBox },
      Property.OverflowY { value: Overflow.Hidden },
      Property.OverflowX { value: Overflow.Hidden },
      Property.BackgroundColor { color: rgb(0xe0e7ff) },
      Property.BorderRadius { value: Corners<f32>.uniform(6.0) },
      Property.FontSize { value: 14.0 },
      Property.Color { color: rgb(0x3730a3) },
    ],
  )
  run batch.style(clip, &padding(6.0))
  run batch.text(
    clip,
    21,
    "This box clips its text: the second line is cut in half by overflow hidden, and the third is not drawn.",
  )
}

/// Sign-in form ids.
pub const FORM: u32 = 1

pub const EMAIL: u32 = 30

pub const PASSWORD: u32 = 40

pub const SUBMIT: u32 = 60

pub effect fn input(batch: &mut Batch, parent: u32, id: u32, label: string, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.box(
    parent,
    id - 2,
    &[
      Property.FontSize { value: 13.0 },
      Property.FontWeight { value: 700.0 },
      Property.Color { color: rgb(0x374151) },
    ],
  )
  run batch.text(id - 2, id - 1, label)
  run batch.create(id, NodeKind.Input)
  run batch.style(
    id,
    &[
      Property.Display { value: Display.Block },
      Property.BorderColor { color: rgb(0x9ca3af) },
      Property.BorderRadius { value: Corners<f32>.uniform(6.0) },
      Property.BackgroundColor { color: rgb(0xffffff) },
      Property.FontSize { value: 15.0 },
      Property.Padding { side: Side.Top, value: px(6.0) },
      Property.Padding { side: Side.Bottom, value: px(6.0) },
      Property.Padding { side: Side.Left, value: px(8.0) },
      Property.Padding { side: Side.Right, value: px(8.0) },
    ],
  )
  run batch.style(id, &border(1.0))
  run batch.styleFor(
    id,
    StyleState.Focus,
    &[
      Property.BorderColor { color: rgb(0x2563eb) },
      Property.BoxShadow {
        value: BoxShadow {
          offsetX: 0.0,
          offsetY: 0.0,
          blur: 0.0,
          spread: 3.0,
          color: rgba(0x2563eb, 0.25),
          inset: false,
        },
      },
    ],
  )
  run batch.attribute(id, Attribute.Role { value: Role.TextBox })
  run batch.label(id, label)
  run batch.setText(id, value)
  run batch.append(parent, id)
}

/// The sign-in form: a heading, two inputs (the first focused), a checkbox row, a link, a
/// gradient button and a dashed note.
pub effect fn form(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run resources(&mut batch)
  run batch.create(FORM, NodeKind.Box)
  run batch.style(
    FORM,
    &[
      Property.FontFamily { family: SANS },
      Property.Display { value: Display.Flex },
      Property.FlexDirection { value: FlexDirection.Column },
      Property.RowGap { value: px(8.0) },
      Property.Height { value: Length.Percent { value: 100.0 } },
      Property.BoxSizing { value: BoxSizing.BorderBox },
      Property.BackgroundColor { color: rgb(0xffffff) },
      Property.Color { color: rgb(0x111827) },
    ],
  )
  run batch.style(FORM, &padding(20.0))
  run batch.attribute(FORM, Attribute.Role { value: Role.Form })
  run batch.root(FORM)
  run batch.box(FORM, 2, &[Property.FontSize { value: 22.0 }, Property.FontWeight { value: 700.0 }])
  run batch.attribute(2, Attribute.Role { value: Role.Heading })
  run batch.text(2, 3, "Sign in")
  run input(&mut batch, FORM, EMAIL, "Email", "julia@example.com")
  run input(&mut batch, FORM, PASSWORD, "Password", "********")
  let row: u32 = 50
  run batch.box(
    FORM,
    row,
    &[
      Property.Display { value: Display.Flex },
      Property.AlignItems { value: Align.Center },
      Property.ColumnGap { value: px(8.0) },
      Property.FontSize { value: 14.0 },
    ],
  )
  run batch.box(
    row,
    51,
    &[
      Property.Width { value: px(16.0) },
      Property.Height { value: px(16.0) },
      Property.BorderColor { color: rgb(0x2563eb) },
      Property.BackgroundColor { color: rgb(0x2563eb) },
      Property.BorderRadius { value: Corners<f32>.uniform(4.0) },
    ],
  )
  run batch.style(51, &border(1.0))
  run batch.attribute(51, Attribute.Role { value: Role.Checkbox })
  run batch.text(row, 52, "Remember me on this device")
  run batch.box(
    FORM,
    55,
    &[
      Property.FontSize { value: 13.0 },
      Property.Color { color: rgb(0x2563eb) },
      Property.TextDecorationLine { value: DecorationLine.underlined() },
    ],
  )
  run batch.attribute(55, Attribute.Role { value: Role.Link })
  run batch.text(55, 56, "Forgot your password?")
  run batch.box(
    FORM,
    SUBMIT,
    &[
      Property.BackgroundGradient { angle: 180.0, from: rgb(0x3b82f6), to: rgb(0x1d4ed8) },
      Property.Color { color: rgb(0xffffff) },
      Property.FontWeight { value: 700.0 },
      Property.FontSize { value: 15.0 },
      Property.BorderRadius { value: Corners<f32>.uniform(8.0) },
      Property.Padding { side: Side.Top, value: px(9.0) },
      Property.Padding { side: Side.Bottom, value: px(9.0) },
      Property.Display { value: Display.Flex },
      Property.JustifyContent { value: Align.Center },
    ],
  )
  run batch.attribute(SUBMIT, Attribute.Role { value: Role.Button })
  run batch.testId(SUBMIT, "submit")
  run batch.text(SUBMIT, 61, "Sign in")
  run batch.box(
    FORM,
    70,
    &[
      Property.BorderStyle { value: BorderStyle.Dashed },
      Property.BorderColor { color: rgb(0xd1d5db) },
      Property.BorderRadius { value: Corners<f32>.uniform(6.0) },
      Property.FontSize { value: 12.0 },
      Property.Color { color: rgb(0x6b7280) },
    ],
  )
  run batch.style(70, &padding(8.0))
  run batch.style(70, &border(1.0))
  run batch.text(
    70,
    71,
    "By signing in you accept the terms. Wrapped text keeps the dashed border around it.",
  )
  run batch.push(Mutation.Focus { id: EMAIL })
}

/// Inbox ids: the panel, its toolbar of three buttons (the last one disabled), and a scrolling
/// list of rows; row `i` is `ROW + 10 * i` with its text at `ROW + 10 * i + 1`, and row 3
/// holds a nested scroll box of lines.
pub const PANEL: u32 = 1

pub const TOOLBAR: u32 = 2

pub const NEW_BUTTON: u32 = 10

pub const ARCHIVE_BUTTON: u32 = 20

pub const DELETE_BUTTON: u32 = 30

pub const INBOX_LIST: u32 = 100

pub const ROW: u32 = 110

pub const ROWS: u32 = 10

pub const NESTED: u32 = 300

pub const NESTED_LINES: u32 = 6

fn subject(index: u32) -> string<'static> {
  return match index {
    0 => "Welcome to the retained tree"
    1 => "Hover, press and click"
    2 => "Tab moves focus"
    3 => "Nested scrolling"
    4 => "Wheel deltas chain outwards"
    5 => "Pointer capture"
    6 => "Scroll into view"
    7 => "Focus traps"
    8 => "Overlay scrollbars"
    _ => "The last row"
  }
}

/// A toolbar button: role button, tabbable, with hover, active and focus-visible looks.
pub effect fn button(batch: &mut Batch, parent: u32, id: u32, label: string, disabled: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.box(
    parent,
    id,
    &[
      Property.BackgroundColor { color: rgb(0xe5e7eb) },
      Property.BorderRadius { value: Corners<f32>.uniform(6.0) },
      Property.Padding { side: Side.Top, value: px(6.0) },
      Property.Padding { side: Side.Bottom, value: px(6.0) },
      Property.Padding { side: Side.Left, value: px(12.0) },
      Property.Padding { side: Side.Right, value: px(12.0) },
      Property.FontSize { value: 14.0 },
      Property.FontWeight { value: 700.0 },
    ],
  )
  run batch.styleFor(id, StyleState.Hover, &[Property.BackgroundColor { color: rgb(0xd1d5db) }])
  run batch.styleFor(id, StyleState.Active, &[Property.BackgroundColor { color: rgb(0x9ca3af) }])
  run batch.styleFor(
    id,
    StyleState.FocusVisible,
    &[
      Property.BoxShadow {
        value: BoxShadow {
          offsetX: 0.0,
          offsetY: 0.0,
          blur: 0.0,
          spread: 2.0,
          color: rgb(0x2563eb),
          inset: false,
        },
      },
    ],
  )
  run batch.attribute(id, Attribute.Role { value: Role.Button })
  run batch.attribute(id, Attribute.TabIndex { value: 0 })
  run batch.attribute(id, Attribute.Cursor { value: Cursor.Pointer })
  run batch.label(id, label)
  if disabled {
    run batch.attribute(id, Attribute.Disabled { value: true })
    run batch.style(id, &[Property.Color { color: rgb(0x9ca3af) }])
  }
  run batch.text(id, id + 1, label)
}

/// The inbox: a toolbar and a list taller than its box, with a nested scroll box in row 3.
/// Every node listens for everything, so tests see each record.
pub effect fn inbox(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run resources(&mut batch)
  run batch.create(PANEL, NodeKind.Box)
  run batch.style(
    PANEL,
    &[
      Property.FontFamily { family: SANS },
      Property.Display { value: Display.Flex },
      Property.FlexDirection { value: FlexDirection.Column },
      Property.RowGap { value: px(8.0) },
      Property.Height { value: Length.Percent { value: 100.0 } },
      Property.BoxSizing { value: BoxSizing.BorderBox },
      Property.BackgroundColor { color: rgb(0xffffff) },
      Property.Color { color: rgb(0x111827) },
    ],
  )
  run batch.style(PANEL, &padding(12.0))
  run batch.root(PANEL)
  run batch.box(
    PANEL,
    TOOLBAR,
    &[Property.Display { value: Display.Flex }, Property.ColumnGap { value: px(8.0) }],
  )
  run batch.attribute(TOOLBAR, Attribute.Role { value: Role.Toolbar })
  run button(&mut batch, TOOLBAR, NEW_BUTTON, "New", false)
  run button(&mut batch, TOOLBAR, ARCHIVE_BUTTON, "Archive", false)
  run button(&mut batch, TOOLBAR, DELETE_BUTTON, "Delete", true)
  run batch.box(
    PANEL,
    INBOX_LIST,
    &[
      Property.FlexGrow { value: 1.0 },
      Property.MinHeight { value: px(0.0) },
      Property.OverflowY { value: Overflow.Auto },
      Property.BorderColor { color: rgb(0xd1d5db) },
      Property.BorderRadius { value: Corners<f32>.uniform(8.0) },
    ],
  )
  run batch.style(INBOX_LIST, &border(1.0))
  run batch.attribute(INBOX_LIST, Attribute.Role { value: Role.List })
  let mut i: u32 = 0
  while i < ROWS {
    run row(&mut batch, ROW + 10 * i, subject(i))
    i = i + 1
  }
  let host = ROW + 30
  run batch.box(
    host,
    NESTED,
    &[
      Property.Height { value: px(60.0) },
      Property.OverflowY { value: Overflow.Scroll },
      Property.Margin { side: Side.Top, value: px(6.0) },
      Property.BackgroundColor { color: rgb(0xf9fafb) },
      Property.FontSize { value: 12.0 },
      Property.Color { color: rgb(0x4b5563) },
    ],
  )
  run batch.style(NESTED, &padding(4.0))
  let mut line: u32 = 0
  while line < NESTED_LINES {
    run batch.box(NESTED, NESTED + 10 * (line + 1), &[])
    run batch.text(
      NESTED + 10 * (line + 1),
      NESTED + 10 * (line + 1) + 1,
      "A line inside the nested box",
    )
    line = line + 1
  }
  run listenAll(&mut batch)
}

/// Appends inbox row `id` (its text is `id + 1`): tabbable, with hover and focus-visible
/// looks, listening for every record.
pub effect fn row(batch: &mut Batch, id: u32, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.box(
    INBOX_LIST,
    id,
    &[
      Property.Padding { side: Side.Top, value: px(10.0) },
      Property.Padding { side: Side.Bottom, value: px(10.0) },
      Property.Padding { side: Side.Left, value: px(12.0) },
      Property.Padding { side: Side.Right, value: px(12.0) },
      Property.FontSize { value: 14.0 },
      Property.BorderWidth { side: Side.Bottom, value: 1.0 },
      Property.BorderColor { color: rgb(0xe5e7eb) },
    ],
  )
  run batch.styleFor(id, StyleState.Hover, &[Property.BackgroundColor { color: rgb(0xf3f4f6) }])
  run batch.styleFor(
    id,
    StyleState.FocusVisible,
    &[Property.BackgroundColor { color: rgb(0xdbeafe) }],
  )
  run batch.attribute(id, Attribute.Role { value: Role.ListItem })
  run batch.attribute(id, Attribute.TabIndex { value: 0 })
  run batch.text(id, id + 1, value)
  run batch.listen(id, LISTEN_ALL)
}

/// Makes every inbox node but the rows listen for every record.
effect fn listenAll(batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.listen(PANEL, LISTEN_ALL)
  run batch.listen(TOOLBAR, LISTEN_ALL)
  run batch.listen(NEW_BUTTON, LISTEN_ALL)
  run batch.listen(ARCHIVE_BUTTON, LISTEN_ALL)
  run batch.listen(DELETE_BUTTON, LISTEN_ALL)
  run batch.listen(INBOX_LIST, LISTEN_ALL)
  run batch.listen(NESTED, LISTEN_ALL)
}

/// The number of fixture trees: the card list (0), the sign-in form (1) and the inbox (2).
pub const COUNT: u32 = 3

/// Fixture `index`'s file name stem.
pub fn name(index: u32) -> string<'static> {
  return match index {
    0 => "card-list"
    1 => "form"
    _ => "inbox"
  }
}

/// The frame fixture `index` is drawn at.
pub fn viewport(index: u32) -> FrameInput {
  let height: f32 = if index == 0 {
    470.0
  } else {
    440.0
  }
  return FrameInput { width: 360.0, height: height, scale: 1.0, time: 0.0 }
}

/// Fixture `index`'s mutations.
pub effect fn build(index: u32, batch: &mut Batch) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if index == 0 {
    run cardList(&mut batch)
  } else if index == 1 {
    run form(&mut batch)
  } else {
    run inbox(&mut batch)
  }
}
