#!/usr/bin/env python3
"""Build the interactive inbox demo, then run it in a window. The window bridge and Dawn come
from the manifests.

  ui/tree/demo/scripts/demo [--build-only] [--release]           the demo in a window
  ui/tree/demo/scripts/demo --editor [--release]                   text fields in a window
  ui/tree/demo/scripts/demo check [--backend x11|wayland|all] [--release]
  ui/tree/demo/scripts/demo inspect
  ui/tree/demo/scripts/demo mcp

`inspect` is the inspector's exit test: it builds the demo (debug, as the inspector needs) and
ui-inspect-cli, starts the demo with SILK_UI_INSPECT set (under Xvfb on Linux), and drives it
with the CLI: snapshot, click New, wait for the new row, highlight Archive, inspect a button,
screenshot. The PNG is left in .cache/ui-tree-demo/inspect.png.

`mcp` is the agent-access exit test: the same, but through ui-inspect-mcp, the MCP server an agent
talks to over stdio. It speaks JSON-RPC to it as an MCP client does: initialize, list the tools,
read a snapshot, find the button labelled New in it, click it by that label, wait for the new row
and take a screenshot. The PNG is left in .cache/ui-tree-demo/mcp.png.

`check` runs `ui-tree-demo --check`: a scripted hover, wheel and Tab go into the tree, then the
window's surface is read back and compared with the CPU reference of the same frame. On Linux it
starts Xvfb and a headless Weston itself, like platform/window/scripts/linux, and uses lavapipe
when VK_ICD_FILENAMES is not set; on macOS and Windows it opens a real window.

Needs what graphics/demo/scripts/app needs (Linux: libx11-dev libxkbcommon-dev libwayland-dev,
plus xvfb and weston for `check`).
"""
import argparse
import base64
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
REPO = ROOT.parents[2]
WINDOW = REPO / "platform/window/scripts"
sys.path.insert(0, str(REPO / "gpu/webgpu/scripts"))
from _build import build  # noqa: E402

LAVAPIPE = Path("/usr/share/vulkan/icd.d/lvp_icd.json")


def check(program, backend):
    env = dict(os.environ)
    if sys.platform.startswith("linux"):
        if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
            env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
        env["SILK_WINDOW_SCALE"] = env.get("SILK_WINDOW_SCALE", "1")
        linux = runpy.run_path(str(WINDOW / "linux"))
        # The runners start the program without arguments; a wrapper adds --check.
        wrapper = REPO / ".cache/ui-tree-demo/check"
        wrapper.parent.mkdir(parents=True, exist_ok=True)
        wrapper.write_text(f'#!/bin/sh\ncd "{REPO}"\nexec "{program}" --check\n')
        wrapper.chmod(0o755)
        status = 0
        for name in (["x11", "wayland"] if backend == "all" else [backend]):
            print(f"--- {name}", flush=True)
            runner = linux["run_under_x11"] if name == "x11" else linux["run_under_wayland"]
            code = runner(wrapper, env)
            print(f"--- {name}: {'passed' if code == 0 else f'failed ({code})'}", flush=True)
            status = status or code
        return status
    return subprocess.run([str(program), "--check"], cwd=REPO, env=env, timeout=300).returncode


class DemoApp:
    """The demo (debug build) running with SILK_UI_INSPECT set, under Xvfb on Linux."""

    def __init__(self, socket):
        self.program = build(ROOT, release=False)
        self.cli = build(REPO / "ui/inspect/cli", release=False)
        env = dict(os.environ, SILK_UI_INSPECT=str(socket))
        env.pop("SILK_WINDOW_FIBER", None)
        self.server = None
        if sys.platform.startswith("linux"):
            if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
                env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
            env["SILK_WINDOW_SCALE"] = env.get("SILK_WINDOW_SCALE", "1")
            xvfb = shutil.which("Xvfb")
            if xvfb and not env.get("DISPLAY"):
                number = next(n for n in range(90, 140) if not Path(f"/tmp/.X11-unix/X{n}").exists()
                              and not Path(f"/tmp/.X{n}-lock").exists())
                self.server = subprocess.Popen([xvfb, f":{number}", "-screen", "0", "1280x800x24", "-nolisten", "tcp"],
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                env["DISPLAY"] = f":{number}"
                env["SILK_WINDOW_BACKEND"] = "x11"
                env.pop("WAYLAND_DISPLAY", None)
        self.env = env
        self.app = None

    def __enter__(self):
        try:
            if self.server:
                deadline = time.monotonic() + 10
                while not Path(f"/tmp/.X11-unix/{self.env['DISPLAY'].replace(':', 'X')}").exists():
                    if time.monotonic() > deadline:
                        raise SystemExit("Xvfb did not start")
                    time.sleep(0.05)
            self.app = subprocess.Popen([str(self.program)], cwd=REPO, env=self.env)
            deadline = time.monotonic() + 120
            while True:
                hello = subprocess.run([str(self.cli), "hello"], cwd=REPO, env=self.env, capture_output=True,
                                       text=True)
                if hello.returncode == 0:
                    break
                if self.app.poll() is not None or time.monotonic() > deadline:
                    print(hello.stderr, flush=True)
                    raise SystemExit(f"the demo did not start serving the inspector (exit {self.app.poll()})")
                time.sleep(0.2)
            print(hello.stdout.strip(), flush=True)
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def __exit__(self, *exc):
        if self.app and self.app.poll() is None:
            self.app.terminate()
            try:
                self.app.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.app.kill()
        if self.server:
            self.server.terminate()
            self.server.wait()
            self.server = None
        return False


class Checks:
    def __init__(self):
        self.failures = []

    def expect(self, condition, what):
        print(("ok   " if condition else "FAIL ") + what, flush=True)
        if not condition:
            self.failures.append(what)

    def report(self, name, artifact):
        if self.failures:
            print(f"{len(self.failures)} {name} check(s) failed", flush=True)
            return 1
        print(f"{name} checks passed; screenshot in {artifact}", flush=True)
        return 0


def inspect():
    work = REPO / ".cache/ui-tree-demo"
    work.mkdir(parents=True, exist_ok=True)
    shot = work / "inspect.png"
    shot.unlink(missing_ok=True)
    checks = Checks()
    expect = checks.expect
    with DemoApp(work / "inspect.sock") as demo:
        def run(*args, timeout=60):
            result = subprocess.run([str(demo.cli), *args], cwd=REPO, env=demo.env, capture_output=True,
                                    text=True, timeout=timeout)
            print(f"$ ui-inspect-cli {' '.join(args)}  -> {result.returncode}", flush=True)
            if result.stderr.strip():
                print(result.stderr.strip(), flush=True)
            return result

        snap = run("snapshot")
        expect(snap.returncode == 0 and 'role=button label="New"' in snap.stdout, "snapshot lists the New button")
        expect("A new message" not in snap.stdout, "no new row yet")
        click = run("click", "--role", "button", "--name", "New")
        expect(click.returncode == 0 and '"node":10' in click.stdout, "click New by role and name")
        wait = run("wait", "--text", "A new message", "--timeout", "10000")
        expect(wait.returncode == 0, "the app answered the click with a new row")
        after = run("snapshot")
        expect('"A new message"' in after.stdout, "the snapshot shows the new row")
        lit = run("highlight", "--role", "button", "--name", "Archive")
        expect(lit.returncode == 0 and '"nodes":[20]' in lit.stdout, "highlight Archive")
        view = run("inspect", "--role", "button", "--name", "Archive")
        expect(view.returncode == 0 and view.stdout.startswith("box #20"), "inspect Archive")
        shot_run = run("screenshot", str(shot))
        data = shot.read_bytes() if shot.exists() else b""
        expect(shot_run.returncode == 0 and data[:8] == b"\x89PNG\r\n\x1a\n", "screenshot is a PNG")
        stats = run("stats")
        expect(stats.returncode == 0 and '"nodes":' in stats.stdout, "stats")
        missing = run("click", "--name", "no such button")
        expect(missing.returncode == 1 and "no node matches" in missing.stderr, "a missing node is an error")
    return checks.report("inspector", shot)


class McpClient:
    """A minimal MCP client over stdio: JSON-RPC, one message per line."""

    def __init__(self, program, env):
        self.process = subprocess.Popen([str(program)], cwd=REPO, env=env, stdin=subprocess.PIPE,
                                        stdout=subprocess.PIPE, text=True, bufsize=1)
        self.next_id = 1

    def notify(self, method, params=None):
        message = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            message["params"] = params
        self.process.stdin.write(json.dumps(message) + "\n")
        self.process.stdin.flush()

    def call(self, method, params=None):
        ident = self.next_id
        self.next_id += 1
        message = {"jsonrpc": "2.0", "id": ident, "method": method}
        if params is not None:
            message["params"] = params
        self.process.stdin.write(json.dumps(message) + "\n")
        self.process.stdin.flush()
        line = self.process.stdout.readline()
        if not line:
            raise SystemExit(f"ui-inspect-mcp exited (code {self.process.poll()})")
        response = json.loads(line)
        if response.get("id") != ident:
            raise SystemExit(f"response id {response.get('id')} for request {ident}")
        return response

    def tool(self, tool, **arguments):
        response = self.call("tools/call", {"name": tool, "arguments": arguments})
        result = response.get("result", {})
        content = result.get("content", [])
        first = content[0] if content else {}
        summary = first.get("text", first.get("type", ""))
        print(f"> {tool} {json.dumps(arguments)}  -> {'error' if result.get('isError') else 'ok'}: "
              f"{summary[:200].strip()}", flush=True)
        return result

    def close(self):
        self.process.stdin.close()
        try:
            return self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.process.kill()
            return -1


def mcp():
    work = REPO / ".cache/ui-tree-demo"
    work.mkdir(parents=True, exist_ok=True)
    shot = work / "mcp.png"
    shot.unlink(missing_ok=True)
    server = build(REPO / "ui/inspect/mcp", release=False)
    checks = Checks()
    expect = checks.expect
    with DemoApp(work / "mcp.sock") as demo:
        client = McpClient(server, demo.env)
        try:
            init = client.call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                              "clientInfo": {"name": "demo-script", "version": "1"}})
            info = init.get("result", {})
            expect(info.get("protocolVersion") == "2025-06-18" and "tools" in info.get("capabilities", {}),
                   "initialize")
            client.notify("notifications/initialized")
            tools = {t["name"] for t in client.call("tools/list").get("result", {}).get("tools", [])}
            expect({"ui_snapshot", "ui_click", "ui_wait", "ui_screenshot"} <= tools, f"tools/list ({len(tools)} tools)")

            # As an agent would: read the snapshot, find the button by its label, click it.
            snap = client.tool("ui_snapshot")
            text = snap["content"][0]["text"] if snap.get("content") else ""
            line = next((l for l in text.splitlines() if 'label="New"' in l), "")
            expect("role=button" in line, "the snapshot shows a button labelled New")
            expect("A new message" not in text, "no new row yet")
            click = client.tool("ui_click", label="New", exact=True)
            reply = json.loads(click["content"][0]["text"]) if not click.get("isError") else {}
            expect(reply.get("node") == 10, "ui_click clicks it by its label")
            wait = client.tool("ui_wait", text="A new message", timeout=10000)
            expect(not wait.get("isError"), "the app answered the click with a new row")
            after = client.tool("ui_snapshot")
            expect('"A new message"' in after["content"][0]["text"], "the snapshot shows the new row")
            view = client.tool("ui_inspect", role="button", name="Archive")
            expect(not view.get("isError") and view["content"][0]["text"].startswith("box #20"), "ui_inspect")
            lit = client.tool("ui_highlight", role="button", name="Archive")
            expect(not lit.get("isError"), "ui_highlight")
            picture = client.tool("ui_screenshot")
            image = picture["content"][0] if picture.get("content") else {}
            data = base64.b64decode(image.get("data", "")) if image.get("type") == "image" else b""
            shot.write_bytes(data)
            expect(image.get("mimeType") == "image/png" and data[:8] == b"\x89PNG\r\n\x1a\n",
                   "ui_screenshot returns a PNG image")
            missing = client.tool("ui_click", name="no such button")
            expect(missing.get("isError") and missing["content"][0]["text"] == "no node matches",
                   "a missing node is a tool error")
        finally:
            code = client.close()
        expect(code == 0, "ui-inspect-mcp exits when stdin closes")
    return checks.report("MCP", shot)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("mode", nargs="?", choices=["run", "check", "inspect", "mcp"], default="run")
    parser.add_argument("--backend", choices=["x11", "wayland", "all"], default="all")
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    parser.add_argument("--editor", action="store_true", help="show the text fields instead of the inbox")
    args = parser.parse_args()
    if args.mode == "inspect":
        return inspect()
    if args.mode == "mcp":
        return mcp()
    program = build(ROOT, release=args.release)
    if args.build_only:
        print(program)
        return 0
    if args.mode == "check":
        return check(program, args.backend)
    return subprocess.run([str(program), *(["--editor"] if args.editor else [])], cwd=REPO).returncode


if __name__ == "__main__":
    raise SystemExit(main())
