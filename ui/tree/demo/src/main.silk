import silk.num.u64

/// The frame `--check` reads back, after the scripted input went in before frame 2.
const CHECK_FRAME: u64 = 3

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn checkMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return run hasFlag(b"--check")
}

/// Whether the command line has `flag`.
effect fn hasFlag(flag: &[u8]) -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), flag) {
        return true
      }
    }
    i = i + 1
  }
  return false
}

/// The window's surface target, by backend.
unsafe fn targetOf<'w>(owner: &'w WindowId, raw: RawSurface) -> Option<SurfaceTarget<'w>> {
  return match raw {
    RawSurface.MetalLayer { layer } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.metalLayer(owner, layer),
    )
    RawSurface.Win32 { hwnd, hinstance } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.windows(owner, hwnd, hinstance),
    )
    RawSurface.Wayland { display, surface } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.wayland(owner, display, surface),
    )
    RawSurface.Xlib { display, window } => Option<SurfaceTarget<'w>>.some(
      unsafe SurfaceTarget.x11(owner, display, window),
    )
    _ => Option<SurfaceTarget<'w>>.None
  }
}

/// The client half of the demo: the rows it added and the ids it hands out.
struct Inbox {
  rows: List<u32>,
  next: u32,
}

impl Inbox {
  effect fn make() -> Inbox
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut rows = List<u32>.make()
    let mut i: u32 = 0
    while i < fixtures.ROWS {
      run rows.append(fixtures.ROW + 10 * i)
      i = i + 1
    }
    return Inbox { rows: move rows, next: 1000 }
  }

  /// Answers the tree's records with mutations.
  effect fn react(self: &mut Self, tree: &mut UiTree, records: &List<Record>) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let values = records.asSlice()
    let mut i: usize = 0
    while i < values.length {
      let record = &values[i]
      if record.kind == EventKind.Click && record.target == fixtures.NEW_BUTTON {
        run self.add(&mut tree)
      } else if record.kind == EventKind.Click && record.target == fixtures.ARCHIVE_BUTTON {
        run self.archive(&mut tree)
      }
      i = i + 1
    }
  }

  effect fn add(self: &mut Self, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    let id = self.next
    self.next = self.next + 10
    let mut batch = Batch.make()
    run fixtures.row(&mut batch, id, "A new message")
    run batch.scrollIntoView(id)
    run tree.apply(run batch.take())
    run self.rows.append(id)
  }

  effect fn archive(self: &mut Self, tree: &mut UiTree) -> ()
    ! TreeError | OutOfMemoryError
    ? &mut Allocator {
    if tree.focused == NONE {
      return ()
    }
    let focused = tree.node(tree.focused).id
    let mut i: usize = 0
    while i < self.rows.length() {
      if self.rows.get(i) == focused {
        let mut batch = Batch.make()

        // Focus moves to the next row, or the previous one at the end.
        if i + 1 < self.rows.length() {
          run batch.focus(self.rows.get(i + 1))
        } else if i > 0 {
          run batch.focus(self.rows.get(i - 1))
        }
        run batch.push(Mutation.Destroy { id: focused })
        run tree.apply(run batch.take())
        drop self.rows.remove(i)
        return ()
      }
      i = i + 1
    }
  }
}

/// The scripted input of `--check`: scroll the list by 60 (the wheel moves the pointer there),
/// hover New, Tab to New.
effect fn script(tree: &mut UiTree) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run tree.dispatch(Input.Wheel { x: 340.0, y: 112.0, deltaX: 0.0, deltaY: 60.0, modifiers: 0 })
  run tree.dispatch(Input.PointerMove { x: 40.0, y: 27.0, modifiers: 0 })
  run tree.dispatch(
    Input.KeyDown {
      key: run String.copy("Tab"),
      code: run String.copy("Tab"),
      modifiers: 0,
      repeat: false,
    },
  )
}

/// Whether the scripted input left the tree as it should.
fn scripted(tree: &UiTree) -> bool {
  return tree.scrollOffset(fixtures.INBOX_LIST).y == 60.0
    && tree.focused == tree.slotOf(fixtures.NEW_BUTTON)
    && tree.node(tree.slotOf(fixtures.NEW_BUTTON)).hovered
}

/// Compares the drawn surface with the CPU reference of the same frame. Returns the exit code.
effect fn checkFrame(
  device: &Device,
  queue: &Queue,
  surfaceTexture: &Texture,
  bgra: bool,
  expected: &[u8],
  width: u32,
  height: u32,
) -> i32
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run copyOut(device, queue, surfaceTexture, width, height)
  let padded = run runtime.mapRead(device, &buffer, 0, readbackSize(width, height))
  let pixels = run unpack(padded.asSlice(), width, height, bgra)
  let result = compare(expected, pixels.asSlice(), width)
  let ok = result.within(Tolerance.frame())
  StderrWriter.print(
    "check: {} x {} surface, max delta {} at ({}, {}), {} of {} channels over 8, mean {}: {}\n",
    &(
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      result.channels,
      result.mean,
      if ok {
        "pass"
      } else {
        "FAIL"
      }
    ),
  )
  return if ok {
    0
  } else {
    1
  }
}

fn deviceSize(logical: f64, scale: f64) -> u32 {
  return f64.toU32(f64.floor(logical * scale + 0.5))
}

effect fn program() -> i32
  ! WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | HostInputError
  ? &mut HostInput | &mut Allocator {
  let check = run checkMode()
  let editor = !check && run hasFlag(b"--editor")
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  if editor {
    run fixtures.editor(&mut batch)
  } else {
    run fixtures.inbox(&mut batch)
  }
  run tree.apply(run batch.take())
  let mut host = HostState.make()
  let mut inbox = run Inbox.make()
  let mut snapshot = CpuSnapshot.make()

  // Debug builds with SILK_UI_INSPECT set serve the inspector protocol (ui/inspect/server).
  let mut inspector = if check {
    Inspector.off()
  } else {
    run Inspector.start(InspectorOptions.make())
  }
  let wait = match inspector.pollInterval() {
    Option<f64>.Some { value } => Wait.Seconds { seconds: value }
    Option<f64>.None => Wait.Forever
  }

  let mut platform = run NativePlatform.start()
  let viewport = fixtures.viewport(
    if editor {
      3
    } else {
      2
    },
  )
  let mut options = WindowOptions.make(
    "Silk UI tree",
    f32.toF64(viewport.width),
    f32.toF64(viewport.height),
  )
  options.minSize = Option<Size2<f64>>.some(Size2<f64>.new(240.0, 200.0))
  let window = run platform.openWindow(&options)
  let owner = window
  let raw = platform.rawSurface(window)
  let target = match unsafe targetOf(&owner, raw) {
    Option<SurfaceTarget>.Some { value } => move value
    Option<SurfaceTarget>.None => {
      StderrWriter.print("ui-tree-demo: this backend has no GPU surface\n", &())
      return 2
    }
  }
  let instance = run Instance.create()
  let surface = run Surface.create(&instance, &target, String.utf8Bytes("ui tree"))
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.forSurface(&surface))
  let capabilities = run surface.getCapabilities(&adapter)
  let format = pickFormat(capabilities.formats())
  if format == 0 {
    StderrWriter.print("ui-tree-demo: the surface offers neither BGRA8 nor RGBA8 unorm\n", &())
    return 2
  }
  let device = run adapter.requestDevice(&DeviceDescriptor.default())
  let queue = run getQueue(&device)
  let mut renderer = run UiRenderer.make(&device, format)
  let mut textures = GpuAtlas.make()
  let mut configuration = SurfaceConfiguration.make(&device, format, 1, 1)
  if check {
    let canCopy = u64.bitAnd(capabilities.usages(), flags.WGPUTextureUsage_CopySrc) != 0
    if !canCopy {
      StderrWriter.print("ui-tree-demo: the surface cannot be read back\n", &())
      return 2
    }
    configuration.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
    renderer.setTextSettings(TextSettings.none())
  }
  if capabilities.alphaModes().length != 0 {
    configuration.setAlphaMode(capabilities.alphaModes()[0])
  }

  let initial = platform.contentSize(window)
  let mut width = initial.width
  let mut height = initial.height
  let mut scale = platform.scaleFactor(window)
  let mut configured = false
  let mut drawn: u64 = 0
  let mut status: i32 = 0
  let mut records = List<Record>.make()
  while true {
    let next = run platform.nextEvent(wait)
    if run inspector.poll(&mut tree) {
      while true {
        // Inspector input is answered like window input.
        records.clear()
        run inspector.observe(&tree)
        run tree.takeEvents(&mut records)
        if !editor {
          run inbox.react(&mut tree, &records)
        }
        run serve(&mut platform, owner, &mut tree, &mut host)
        if !run inspector.dispatchNext(&mut tree) {
          break
        }
      }
      platform.setCursor(owner, windowCursor(tree.cursor()))
      platform.requestFrame(owner)
    }
    if let Option<Event>.Some { value } = &next {
      let mut resized = false
      let mut redraw = false
      match &value {
        Event.RequestFrame { window: which, targetTime } => {
          if !configured {
            resized = true
          }
          if configured || deviceSize(width, scale) > 0 {
            if !configured {
              surface.resize(
                &mut configuration,
                deviceSize(width, scale),
                deviceSize(height, scale),
              )
              configured = true
            }
            if check && drawn == 1 {
              run script(&mut tree)
            }
            run tree.frame(
              FrameInput {
                width: f64.toF32(width),
                height: f64.toF32(height),
                scale: f64.toF32(scale),
                time: targetTime,
              },
            )
            run textures.sync(&device, &tree.atlas)
            let pending = tree.pendingUploads()
            let list = pending.entries()
            let mut i: usize = 0
            while i < list.length {
              textures.write(&queue, list[i].tile, pending.pixels(list[i]))
              i = i + 1
            }
            run inspector.afterFrame(&tree)
            run snapshot.sync(&mut tree)
            let deviceWidth = deviceSize(width, scale)
            let deviceHeight = deviceSize(height, scale)
            let texture = run surface.getCurrentTexture()
            let view = run texture.texture.createView(&TextureViewDescriptor.default())
            run renderer.draw(
              &device,
              &queue,
              inspector.scene(&tree),
              &textures,
              &view,
              deviceWidth,
              deviceHeight,
              color.white(),
            )
            drawn = drawn + 1
            if check && drawn == CHECK_FRAME {
              if !scripted(&tree) {
                StderrWriter.print(
                  "check: the scripted input did not reach the tree (list scroll {}, focus slot {}, New slot {}, New hovered {})\n",
                  &(
                    tree.scrollOffset(fixtures.INBOX_LIST).y,
                    tree.focused,
                    tree.slotOf(fixtures.NEW_BUTTON),
                    tree.node(tree.slotOf(fixtures.NEW_BUTTON)).hovered,
                  ),
                )
                status = 1
              } else {
                let reference = run snapshot.render(&tree)
                status = run checkFrame(
                  &device,
                  &queue,
                  &texture.texture,
                  isBgra(format),
                  reference.data(),
                  deviceWidth,
                  deviceHeight,
                )
              }
            }
            run surface.present()
            run device.checkErrors()
            if check && drawn >= CHECK_FRAME {
              break
            }
            platform.setCursor(owner, windowCursor(tree.cursor()))
            run serve(&mut platform, owner, &mut tree, &mut host)
          }

          // A focused caret blinks: keep drawing while it shows.
          redraw = check || tree.needsFrame() || tree.nextBlink() >= 0.0
        }
        Event.Resized { window: which, size, scaleFactor } => {
          width = size.width
          height = size.height
          scale = scaleFactor
          resized = true
        }
        Event.ScaleFactorChanged { window: which, scaleFactor } => {
          scale = scaleFactor
          resized = true
        }
        Event.CloseRequested { window: which } => {
          break
        }
        Event.QuitRequested => {
          break
        }
        _ => {
          if !check && run feed(&mut tree, &value) {
            records.clear()
            run inspector.observe(&tree)
            run tree.takeEvents(&mut records)
            if !editor {
              run inbox.react(&mut tree, &records)
            }
            run serve(&mut platform, owner, &mut tree, &mut host)
            platform.setCursor(owner, windowCursor(tree.cursor()))
            redraw = tree.needsFrame()
          }
        }
      }
      if resized {
        let w = deviceSize(width, scale)
        let h = deviceSize(height, scale)
        if w > 0 && h > 0 {
          surface.resize(&mut configuration, w, h)
          configured = true
        }
        redraw = true
      }
      if redraw {
        platform.requestFrame(owner)
      }
    }
    if inspector.enabled() && (tree.needsFrame() || inspector.wantsFrame()) {
      let inspectionTime = tree.input.time
      run tree.frame(
        FrameInput {
          width: f64.toF32(width),
          height: f64.toF32(height),
          scale: f64.toF32(scale),
          time: inspectionTime,
        },
      )
      run serve(&mut platform, owner, &mut tree, &mut host)
      run inspector.afterFrame(&tree)
      platform.requestFrame(owner)
    }
  }
  run inspector.close()
  surface.unconfigure()
  platform.closeWindow(owner)
  return status
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("ui-tree-demo: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("ui-tree-demo: GPU error {}\n", &(error.code,))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-tree-demo: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<GpuError>(Effect.catch<WindowError>(program(), windowFailed), gpuFailed),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
