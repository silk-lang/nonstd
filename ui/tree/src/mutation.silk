//! The tree's public protocol: plain-data [`Mutation`]s in, [`Event`] records out.
//!
//! Everything here is plain data. Nodes are named by integer ids the client chooses, styles are
//! patches of (property, value) pairs, and resources (font families, images, icons) are defined
//! once under client ids and then referenced by them. A later wire protocol is a serialization of
//! these unions; a Silk client builds them directly.
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.text.string { String }

/// What a node is.
pub enum NodeKind {
  /// The `div` of the tree. Everything else styles a box.
  Box,
  /// A text leaf, laid out by the parent's inline formatting. Text takes its look from its
  /// parent: wrap text in an inline box to style a span of it.
  Text,
  /// A decoded image, drawn over the content box ([`Mutation.SetSource`] names it).
  Image,
  /// An SVG icon drawn as a mask tinted with the text color. Its natural size is 1em square.
  Icon,
  /// An editable text field: one line, or several with the `Multiline` attribute. It owns
  /// its caret, selection, undo history and input method composition, and queues `Input`
  /// records when its value changes.
  Input,
  /// A box whose content the client paints with [`CanvasCommand`]s.
  Canvas,
}

/// Which look a style patch sets: the base look, or a variant the tree switches to by itself.
/// Variants apply over the base in this order: hover, active, focus, focus-visible.
pub enum StyleState {
  Base,
  /// While the pointer is over the node or one of its descendants (CSS `:hover`).
  Hover,
  /// While the primary button went down on the node or a descendant and is not up yet
  /// (CSS `:active`).
  Active,
  /// While the node has focus.
  Focus,
  /// While the node has focus that came from the keyboard, or from a `Focus` mutation after
  /// keyboard use, as CSS `:focus-visible`. Inputs show it for any focus. Use it for focus rings.
  FocusVisible,
}

/// A CSS length: `auto`, pixels, a percentage, or `none` (for max sizes).
pub union Length {
  Auto,
  Px { pub value: f32 },
  /// A percentage, `50.0` for `50%`.
  Percent { pub value: f32 },
  None,
}

impl Copy for Length {}

impl Length {
  pub fn px(value: f32) -> Length {
    return Length.Px { value: value }
  }

  pub fn percent(value: f32) -> Length {
    return Length.Percent { value: value }
  }
}

/// One side of a box.
pub enum Side {
  Top,
  Right,
  Bottom,
  Left,
}

pub enum Display {
  None,
  Block,
  Inline,
  InlineBlock,
  Flex,
  InlineFlex,
}

pub enum FlexDirection {
  Row,
  RowReverse,
  Column,
  ColumnReverse,
}

pub enum FlexWrap {
  NoWrap,
  Wrap,
  WrapReverse,
}

/// Values of `justify-content`, `align-items`, `align-self` and `align-content`.
pub enum Align {
  Auto,
  Normal,
  Start,
  End,
  Center,
  Stretch,
  Baseline,
  SpaceBetween,
  SpaceAround,
  SpaceEvenly,
}

pub enum Position {
  Static,
  Relative,
  Absolute,
  Fixed,
  Sticky,
}

pub enum Overflow {
  Visible,
  Hidden,
  Clip,
  Scroll,
  Auto,
}

pub enum BoxSizing {
  ContentBox,
  BorderBox,
}

pub enum BorderStyle {
  None,
  Solid,
  Dashed,
}

pub enum FontStyle {
  Normal,
  Italic,
}

pub union LineHeight {
  Normal,
  /// A multiple of the font size.
  Number { pub value: f32 },
  Px { pub value: f32 },
}

impl Copy for LineHeight {}

pub enum TextAlign {
  Start,
  End,
  Left,
  Right,
  Center,
  Justify,
}

/// `white-space` shorthand values.
pub enum WhiteSpace {
  Normal,
  NoWrap,
  Pre,
  PreWrap,
  PreLine,
}

pub enum Direction {
  Ltr,
  Rtl,
}

/// `text-decoration-line` as flags.
pub struct DecorationLine {
  pub underline: bool,
  pub overline: bool,
  pub lineThrough: bool,
}

impl Copy for DecorationLine {}

impl DecorationLine {
  pub fn none() -> DecorationLine {
    return DecorationLine { underline: false, overline: false, lineThrough: false }
  }

  pub fn underlined() -> DecorationLine {
    return DecorationLine { underline: true, overline: false, lineThrough: false }
  }
}

/// One `box-shadow`. Offsets, blur and spread are CSS pixels.
pub struct BoxShadow {
  pub offsetX: f32,
  pub offsetY: f32,
  pub blur: f32,
  pub spread: f32,
  pub color: Rgba<f32>,
  pub inset: bool,
}

impl Copy for BoxShadow {}

/// One property of a style patch. Each variant replaces the value of its property (per side or
/// corner for the edge properties); text properties inherit down the tree as in CSS.
pub union Property {
  // Layout.
  Display { pub value: Display },
  Width { pub value: Length },
  Height { pub value: Length },
  MinWidth { pub value: Length },
  MinHeight { pub value: Length },
  MaxWidth { pub value: Length },
  MaxHeight { pub value: Length },
  Margin { pub side: Side, pub value: Length },
  Padding { pub side: Side, pub value: Length },
  BorderWidth { pub side: Side, pub value: f32 },
  Inset { pub side: Side, pub value: Length },
  Position { pub value: Position },
  BoxSizing { pub value: BoxSizing },
  FlexDirection { pub value: FlexDirection },
  FlexWrap { pub value: FlexWrap },
  FlexGrow { pub value: f32 },
  FlexShrink { pub value: f32 },
  FlexBasis { pub value: Length },
  JustifyContent { pub value: Align },
  AlignItems { pub value: Align },
  AlignSelf { pub value: Align },
  AlignContent { pub value: Align },
  RowGap { pub value: Length },
  ColumnGap { pub value: Length },
  OverflowX { pub value: Overflow },
  OverflowY { pub value: Overflow },
  AspectRatio { pub value: f32 },
  // Paint.
  BackgroundColor { pub color: Rgba<f32> },
  /// A two-stop linear gradient at `angle` degrees (CSS `linear-gradient(<angle>, from, to)`).
  BackgroundGradient { pub angle: f32, pub from: Rgba<f32>, pub to: Rgba<f32> },
  BorderColor { pub color: Rgba<f32> },
  BorderStyle { pub value: BorderStyle },
  /// Corner radii in CSS pixels.
  BorderRadius { pub value: Corners<f32> },
  BoxShadow { pub value: BoxShadow },
  NoBoxShadow,
  Opacity { pub value: f32 },
  /// Whether the node can be the target of pointer events (`pointer-events: none` is false).
  PointerEvents { pub value: bool },
  /// `visibility`; inherited.
  Visible { pub value: bool },
  // Text, all inherited.
  /// The font family list defined with [`Mutation.DefineFontFamily`].
  FontFamily { pub family: u32 },
  FontSize { pub value: f32 },
  FontWeight { pub value: f32 },
  FontStyle { pub value: FontStyle },
  LineHeight { pub value: LineHeight },
  Color { pub color: Rgba<f32> },
  TextAlign { pub value: TextAlign },
  WhiteSpace { pub value: WhiteSpace },
  Direction { pub value: Direction },
  TextDecorationLine { pub value: DecorationLine },
  /// The decoration color; without one, decorations use the text color.
  TextDecorationColor { pub color: Rgba<f32> },
  TextDecorationWavy { pub value: bool },
  /// The caret color of inputs (CSS `caret-color`); without one, the text color.
  CaretColor { pub color: Rgba<f32> },
  /// The background of selected text in inputs (CSS `::selection`).
  SelectionColor { pub color: Rgba<f32> },
  /// The color of an input's placeholder (CSS `::placeholder`); without one, the text color
  /// at half its alpha.
  PlaceholderColor { pub color: Rgba<f32> },
}

impl Copy for Property {}

/// Accessibility roles. Stored for clients and inspectors; the platform bridge comes later.
pub enum Role {
  None,
  Generic,
  Button,
  Link,
  Checkbox,
  Radio,
  TextBox,
  Heading,
  Paragraph,
  List,
  ListItem,
  Image,
  Dialog,
  Menu,
  MenuItem,
  Tab,
  TabList,
  TabPanel,
  Toolbar,
  Navigation,
  Main,
  Form,
  Group,
}

pub enum Cursor {
  Default,
  Pointer,
  Text,
  Move,
  Grab,
  Grabbing,
  NotAllowed,
  ResizeHorizontal,
  ResizeVertical,
}

/// A node attribute. Text attributes are cleared by setting them empty.
pub union Attribute {
  Role { pub value: Role },
  /// The accessible name.
  Label { pub value: String },
  /// A stable name for tests and inspectors.
  TestId { pub value: String },
  /// Tab order as in HTML: negative is focusable (by pointer and `Focus`) but not tabbable, 0
  /// is tree order, and positive values come first, lowest first. [`NOT_FOCUSABLE`], the
  /// default for every kind but `Input`, takes the node out of focus again.
  TabIndex { pub value: i32 },
  Cursor { pub value: Cursor },
  /// A disabled node and its subtree take no focus, no active state and no pointer down, up
  /// or click records.
  Disabled { pub value: bool },
  /// While focus is inside this node, Tab and Shift+Tab cycle through its tabbable
  /// descendants only, as a modal dialog wants.
  FocusTrap { pub value: bool },
  /// An input that takes several lines: Enter inserts a line break, text wraps
  /// (`white-space: pre-wrap`) and the box scrolls vertically. Without it, an input is one
  /// line (`white-space: pre`) that scrolls horizontally to keep the caret in view, and line
  /// breaks typed or pasted into it become spaces.
  Multiline { pub value: bool },
  /// An input whose value the user can select and copy but not change.
  ReadOnly { pub value: bool },
  /// The text an empty input shows (CSS `placeholder`), in the placeholder color.
  Placeholder { pub value: String },
}

/// The tab index of a node that is not focusable: the default for all kinds but `Input`
/// (whose default is 0).
pub const NOT_FOCUSABLE: i32 = -2147483648

/// Listener flags for [`Mutation.SetListeners`]: which events the client wants records for.
pub const LISTEN_POINTER_DOWN: u32 = 1

pub const LISTEN_POINTER_UP: u32 = 2

pub const LISTEN_CLICK: u32 = 4

pub const LISTEN_POINTER_MOVE: u32 = 8

pub const LISTEN_POINTER_ENTER: u32 = 16

pub const LISTEN_POINTER_LEAVE: u32 = 32

pub const LISTEN_WHEEL: u32 = 64

pub const LISTEN_KEY_DOWN: u32 = 128

pub const LISTEN_KEY_UP: u32 = 256

pub const LISTEN_FOCUS: u32 = 512

pub const LISTEN_BLUR: u32 = 1024

pub const LISTEN_INPUT: u32 = 2048

pub const LISTEN_SCROLL: u32 = 4096

/// Every listener flag.
pub const LISTEN_ALL: u32 = 8191

/// One drawing command of a canvas node, in CSS pixels from the content box's top-left corner.
/// Path commands build a path that the next `Fill` or `Stroke` draws and then clears.
pub union CanvasCommand {
  FillRect {
    pub x: f32,
    pub y: f32,
    pub width: f32,
    pub height: f32,
    pub radius: f32,
    pub color: Rgba<f32>
  },
  MoveTo { pub x: f32, pub y: f32 },
  LineTo { pub x: f32, pub y: f32 },
  QuadTo { pub x1: f32, pub y1: f32, pub x: f32, pub y: f32 },
  CubicTo { pub x1: f32, pub y1: f32, pub x2: f32, pub y2: f32, pub x: f32, pub y: f32 },
  Close,
  Fill { pub color: Rgba<f32> },
  Stroke { pub color: Rgba<f32>, pub width: f32 },
}

impl Copy for CanvasCommand {}

/// A change to the tree. Apply a batch with `UiTree.apply`.
pub union Mutation {
  /// Makes a detached node `id` of `kind`. Ids are the client's: any `u32` not in use.
  Create { pub id: u32, pub kind: NodeKind },
  /// Inserts `child` into `parent` before `before`, or last without it. A child already in the
  /// tree moves, as in the DOM.
  InsertBefore { pub parent: u32, pub child: u32, pub before: Option<u32> },
  /// Detaches `id` (and its subtree) from its parent. It can be inserted again.
  Remove { pub id: u32 },
  /// Detaches and frees `id` and its whole subtree; their ids can be used again.
  Destroy { pub id: u32 },
  /// Sets `properties` in the `state` look of `id`, each replacing the earlier value of its
  /// property.
  SetStyle { pub id: u32, pub state: StyleState, pub properties: List<Property> },
  /// Forgets every property set in the `state` look of `id`.
  ClearStyle { pub id: u32, pub state: StyleState },
  /// Sets the value of a text or input node. An input whose value changes puts its caret at
  /// the end, ends any composition and forgets its undo history, as setting `value` in the DOM
  /// does; setting the value it already has changes nothing, so a client can echo every
  /// `Input` record back (a controlled input).
  SetText { pub id: u32, pub value: String },
  /// Selects the UTF-8 byte range from `anchor` to `focus` of an input's value (equal for a
  /// caret). Offsets are clamped to the value and moved back to a character boundary.
  SetSelection { pub id: u32, pub anchor: usize, pub focus: usize },
  SetAttribute { pub id: u32, pub attribute: Attribute },
  /// Sets the `LISTEN_*` flags of `id`.
  SetListeners { pub id: u32, pub flags: u32 },
  /// Makes `id` the root node, filling the viewport. The previous root is detached.
  SetRoot { pub id: u32 },
  Focus { pub id: u32 },
  Blur,
  /// Scrolls the scroll container `id` to offset (`x`, `y`) in CSS pixels, clamped to its
  /// scroll range at the next frame.
  ScrollTo { pub id: u32, pub x: f32, pub y: f32 },
  /// At the next frame, scrolls the scroll containers around `id` the least that brings its
  /// border box into view, as `scrollIntoView({ block: "nearest" })`.
  ScrollIntoView { pub id: u32 },
  /// Points an image or icon node at a resource defined with `DefineImage` or `DefineIcon`.
  SetSource { pub id: u32, pub resource: u32 },
  /// Replaces the drawing of a canvas node.
  SetCanvas { pub id: u32, pub commands: List<CanvasCommand> },
  /// Defines font family list `family` from CSS `font-family` text, such as
  /// `"Inter, Noto Sans, sans-serif"`. Generic names map to the collection's generic families.
  DefineFontFamily { pub family: u32, pub names: String },
  /// Decodes a PNG or JPEG file as image resource `resource`.
  DefineImage { pub resource: u32, pub data: Bytes },
  /// Parses an SVG file as icon resource `resource`.
  DefineIcon { pub resource: u32, pub data: Bytes },
}

/// A key that is equal for two properties exactly when one replaces the other: the variant,
/// plus the side for per-side properties.
pub fn propertyKey(property: Property) -> u32 {
  return match property {
    Property.Display { .. } => 0
    Property.Width { .. } => 4
    Property.Height { .. } => 8
    Property.MinWidth { .. } => 12
    Property.MinHeight { .. } => 16
    Property.MaxWidth { .. } => 20
    Property.MaxHeight { .. } => 24
    Property.Margin { side, .. } => 28 + sideIndex(side)
    Property.Padding { side, .. } => 32 + sideIndex(side)
    Property.BorderWidth { side, .. } => 36 + sideIndex(side)
    Property.Inset { side, .. } => 40 + sideIndex(side)
    Property.Position { .. } => 44
    Property.BoxSizing { .. } => 48
    Property.FlexDirection { .. } => 52
    Property.FlexWrap { .. } => 56
    Property.FlexGrow { .. } => 60
    Property.FlexShrink { .. } => 64
    Property.FlexBasis { .. } => 68
    Property.JustifyContent { .. } => 72
    Property.AlignItems { .. } => 76
    Property.AlignSelf { .. } => 80
    Property.AlignContent { .. } => 84
    Property.RowGap { .. } => 88
    Property.ColumnGap { .. } => 92
    Property.OverflowX { .. } => 96
    Property.OverflowY { .. } => 100
    Property.AspectRatio { .. } => 104
    Property.BackgroundColor { .. } => 108
    Property.BackgroundGradient { .. } => 112
    Property.BorderColor { .. } => 116
    Property.BorderStyle { .. } => 120
    Property.BorderRadius { .. } => 124
    Property.BoxShadow { .. } => 128
    Property.NoBoxShadow => 132
    Property.Opacity { .. } => 136
    Property.PointerEvents { .. } => 140
    Property.Visible { .. } => 144
    Property.FontFamily { .. } => 148
    Property.FontSize { .. } => 152
    Property.FontWeight { .. } => 156
    Property.FontStyle { .. } => 160
    Property.LineHeight { .. } => 164
    Property.Color { .. } => 168
    Property.TextAlign { .. } => 172
    Property.WhiteSpace { .. } => 176
    Property.Direction { .. } => 180
    Property.TextDecorationLine { .. } => 184
    Property.TextDecorationColor { .. } => 188
    Property.TextDecorationWavy { .. } => 192
    Property.CaretColor { .. } => 196
    Property.SelectionColor { .. } => 200
    Property.PlaceholderColor { .. } => 204
  }
}

fn sideIndex(side: Side) -> u32 {
  return match side {
    Side.Top => 0
    Side.Right => 1
    Side.Bottom => 2
    Side.Left => 3
  }
}
