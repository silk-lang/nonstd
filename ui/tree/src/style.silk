//! Computed styles: the base look of a node with its active variants applied over it, text
//! properties inherited from the parent, and the css-layout `Style` derived from the result.
import mutation { ObjectFit }
import silk.num.u8
import silk.num.i32
import mutation {
  UnicodeBidi,
  WritingMode,
  TextOrientation,
  VerticalAlign,
  VerticalAlignKind,
  BaselineSource,
  TextWrap,
  WhiteSpaceCollapse,
  TextJustify,
  TextIndent,
  TabSize,
  BoxDecorationBreak,
  MarginBreak,
  BreakBetween,
  BreakInside,
  OverflowAlignment,
  ScrollbarWidth,
  ScrollbarGutter,
  Float,
  Clear,
  Visibility,
  Dimension,
  DimensionKind,
  LayoutTextAlign
}
import mutation {
  Property,
  Length,
  Side,
  Display,
  FlexDirection,
  FlexWrap,
  Align,
  Position,
  Overflow,
  BoxSizing,
  BorderStyle,
  FontStyle,
  LineHeight,
  TextAlign,
  WhiteSpace,
  Direction,
  DecorationLine,
  BoxShadow
}
import layout.lib {
  Style as CssStyle,
  Display as CssDisplay,
  DisplayOutside,
  DisplayInside,
  Edges,
  Position as CssPosition,
  BoxSizing as CssBoxSizing,
  FlexDirection as CssFlexDirection,
  FlexWrap as CssFlexWrap,
  Align as CssAlign,
  Overflow as CssOverflow,
  LineHeight as CssLineHeight,
  TextAlign as CssTextAlign,
  Direction as CssDirection,
}
import silk.collections.hash { Hash, HashSeed }
import silk.color.rgba { Rgba }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }
import silk.num.f32
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Four lengths, one per side.
pub struct Sides {
  pub top: Length,
  pub right: Length,
  pub bottom: Length,
  pub left: Length,
}

impl Copy for Sides {}

impl Sides {
  pub fn all(value: Length) -> Sides {
    return Sides { top: value, right: value, bottom: value, left: value }
  }

  fn set(self: &mut Self, side: Side, value: Length) -> () {
    match side {
      Side.Top => {
        self.top = value
      }
      Side.Right => {
        self.right = value
      }
      Side.Bottom => {
        self.bottom = value
      }
      Side.Left => {
        self.left = value
      }
    }
  }
}

/// What fills a box.
pub union Fill {
  None,
  Solid { pub color: Rgba<f32> },
  Gradient { pub angle: f32, pub from: Rgba<f32>, pub to: Rgba<f32> },
}

impl Copy for Fill {}

/// The inherited text properties.
pub struct TextStyle {
  pub writingMode: WritingMode,
  pub textOrientation: TextOrientation,
  pub textAlignLast: LayoutTextAlign,
  pub textWrap: TextWrap,
  pub whiteSpaceCollapse: WhiteSpaceCollapse,
  pub textJustify: TextJustify,
  pub textIndent: TextIndent,
  pub tabSize: TabSize,
  pub orphans: usize,
  pub widows: usize,
  pub visibility: Visibility,
  pub family: u32,
  pub size: f32,
  pub weight: f32,
  pub style: FontStyle,
  pub lineHeight: LineHeight,
  pub color: Rgba<f32>,
  pub align: TextAlign,
  pub whiteSpace: WhiteSpace,
  pub direction: Direction,
  pub decoration: DecorationLine,
  pub decorationColor: Rgba<f32>,
  pub hasDecorationColor: bool,
  pub wavy: bool,
  pub visible: bool,
  /// Input colors: the caret (when `hasCaretColor`), the selection background and the
  /// placeholder text (when `hasPlaceholderColor`).
  pub caretColor: Rgba<f32>,
  pub hasCaretColor: bool,
  pub selectionColor: Rgba<f32>,
  pub placeholderColor: Rgba<f32>,
  pub hasPlaceholderColor: bool,
}

impl Copy for TextStyle {}

impl TextStyle {
  /// The initial values: family 0, 16 px, weight 400, black, `line-height: normal`.
  pub fn initial() -> TextStyle {
    return TextStyle {
      writingMode: WritingMode.HorizontalTb,
      textOrientation: TextOrientation.Mixed,
      textAlignLast: LayoutTextAlign.Auto,
      textWrap: TextWrap.Wrap,
      whiteSpaceCollapse: WhiteSpaceCollapse.Collapse,
      textJustify: TextJustify.Auto,
      textIndent: TextIndent { value: Dimension.px(0.0), hanging: false, eachLine: false },
      tabSize: TabSize.Number { value: 8.0 },
      orphans: 2,
      widows: 2,
      visibility: Visibility.Visible,
      family: 0,
      size: 16.0,
      weight: 400.0,
      style: FontStyle.Normal,
      lineHeight: LineHeight.Normal,
      color: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      align: TextAlign.Start,
      whiteSpace: WhiteSpace.Normal,
      direction: Direction.Ltr,
      decoration: DecorationLine.none(),
      decorationColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasDecorationColor: false,
      wavy: false,
      visible: true,
      caretColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
      hasCaretColor: false,
      selectionColor: Rgba<f32> { r: 0.706, g: 0.835, b: 0.996, a: 1.0 },
      placeholderColor: Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.5 },
      hasPlaceholderColor: false,
    }
  }

  /// The color decorations are drawn in.
  pub fn lineColor(self: &Self) -> Rgba<f32> {
    if self.hasDecorationColor {
      return self.decorationColor
    }
    return self.color
  }

  /// The color the caret is drawn in.
  pub fn caret(self: &Self) -> Rgba<f32> {
    if self.hasCaretColor {
      return self.caretColor
    }
    return self.color
  }

  /// The color of placeholder text.
  pub fn placeholder(self: &Self) -> Rgba<f32> {
    if self.hasPlaceholderColor {
      return self.placeholderColor
    }
    return Rgba<f32> { r: self.color.r, g: self.color.g, b: self.color.b, a: self.color.a * 0.5 }
  }
}

/// A node's computed style.
pub struct Computed {
  pub objectFit: ObjectFit,
  pub objectX: Length,
  pub objectY: Length,
  pub unicodeBidi: UnicodeBidi,
  pub verticalAlign: VerticalAlign,
  pub baselineSource: BaselineSource,
  pub boxDecorationBreak: BoxDecorationBreak,
  pub marginBreak: MarginBreak,
  pub breakBefore: BreakBetween,
  pub breakAfter: BreakBetween,
  pub breakInside: BreakInside,
  pub order: i32,
  pub justifySelf: Align,
  pub justifyItems: Align,
  pub justifyContentSafety: OverflowAlignment,
  pub alignContentSafety: OverflowAlignment,
  pub alignItemsSafety: OverflowAlignment,
  pub alignSelfSafety: OverflowAlignment,
  pub justifySelfSafety: OverflowAlignment,
  pub justifyItemsSafety: OverflowAlignment,
  pub scrollbarWidth: ScrollbarWidth,
  pub scrollbarGutter: ScrollbarGutter,
  pub float: Float,
  pub clear: Clear,
  pub aspectRatioAuto: bool,
  pub display: Display,
  pub width: Length,
  pub height: Length,
  pub minWidth: Length,
  pub minHeight: Length,
  pub maxWidth: Length,
  pub maxHeight: Length,
  pub margin: Sides,
  pub padding: Sides,
  pub border: Insets<f32>,
  pub inset: Sides,
  pub position: Position,
  pub boxSizing: BoxSizing,
  pub flexDirection: FlexDirection,
  pub flexWrap: FlexWrap,
  pub flexGrow: f32,
  pub flexShrink: f32,
  pub flexBasis: Length,
  pub justifyContent: Align,
  pub alignItems: Align,
  pub alignSelf: Align,
  pub alignContent: Align,
  pub rowGap: Length,
  pub columnGap: Length,
  pub overflowX: Overflow,
  pub overflowY: Overflow,
  pub aspectRatio: f32,
  pub background: Fill,
  pub borderColor: Rgba<f32>,
  pub borderStyle: BorderStyle,
  pub radii: Corners<f32>,
  pub shadow: BoxShadow,
  pub hasShadow: bool,
  pub opacity: f32,
  pub backdropBlur: f32,
  pub pointerEvents: bool,
  pub text: TextStyle,
}

impl Copy for Computed {}

fn black() -> Rgba<f32> {
  return Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
}

impl Computed {
  /// The initial style of an element whose parent's text style is `text`.
  pub fn inheriting(text: TextStyle) -> Computed {
    return Computed {
      objectFit: ObjectFit.Fill,
      objectX: Length.percent(50.0),
      objectY: Length.percent(50.0),
      unicodeBidi: UnicodeBidi.Normal,
      verticalAlign: VerticalAlign { kind: VerticalAlignKind.Baseline, shift: Dimension.px(0.0) },
      baselineSource: BaselineSource.Auto,
      boxDecorationBreak: BoxDecorationBreak.Slice,
      marginBreak: MarginBreak.Auto,
      breakBefore: BreakBetween.Auto,
      breakAfter: BreakBetween.Auto,
      breakInside: BreakInside.Auto,
      order: 0,
      justifySelf: Align.Auto,
      justifyItems: Align.Normal,
      justifyContentSafety: OverflowAlignment.Default,
      alignContentSafety: OverflowAlignment.Default,
      alignItemsSafety: OverflowAlignment.Default,
      alignSelfSafety: OverflowAlignment.Default,
      justifySelfSafety: OverflowAlignment.Default,
      justifyItemsSafety: OverflowAlignment.Default,
      scrollbarWidth: ScrollbarWidth.Auto,
      scrollbarGutter: ScrollbarGutter.Auto,
      float: Float.None,
      clear: Clear.None,
      aspectRatioAuto: false,
      display: Display.Block,
      width: Length.Auto,
      height: Length.Auto,
      minWidth: Length.Auto,
      minHeight: Length.Auto,
      maxWidth: Length.None,
      maxHeight: Length.None,
      margin: Sides.all(Length.Px { value: 0.0 }),
      padding: Sides.all(Length.Px { value: 0.0 }),
      border: Insets<f32>.zero(),
      inset: Sides.all(Length.Auto),
      position: Position.Static,
      boxSizing: BoxSizing.ContentBox,
      flexDirection: FlexDirection.Row,
      flexWrap: FlexWrap.NoWrap,
      flexGrow: 0.0,
      flexShrink: 1.0,
      flexBasis: Length.Auto,
      justifyContent: Align.Normal,
      alignItems: Align.Normal,
      alignSelf: Align.Auto,
      alignContent: Align.Normal,
      rowGap: Length.Auto,
      columnGap: Length.Auto,
      overflowX: Overflow.Visible,
      overflowY: Overflow.Visible,
      aspectRatio: 0.0,
      background: Fill.None,
      borderColor: black(),
      borderStyle: BorderStyle.Solid,
      radii: Corners<f32>.zero(),
      shadow: BoxShadow {
        offsetX: 0.0,
        offsetY: 0.0,
        blur: 0.0,
        spread: 0.0,
        color: black(),
        inset: false,
      },
      hasShadow: false,
      opacity: 1.0,
      backdropBlur: 0.0,
      pointerEvents: true,
      text: text,
    }
  }

  /// Sets one property.
  pub fn apply(self: &mut Self, property: Property) -> () {
    match property {
      Property.ObjectFit { value } => {
        self.objectFit = value
      }
      Property.ObjectPosition { x, y } => {
        self.objectX = x
        self.objectY = y
      }
      Property.UnicodeBidi { value } => {
        self.unicodeBidi = value
      }
      Property.WritingMode { value } => {
        self.text.writingMode = value
      }
      Property.TextOrientation { value } => {
        self.text.textOrientation = value
      }
      Property.VerticalAlign { value } => {
        self.verticalAlign = value
      }
      Property.BaselineSource { value } => {
        self.baselineSource = value
      }
      Property.TextAlignLast { value } => {
        self.text.textAlignLast = value
      }
      Property.TextWrap { value } => {
        self.text.textWrap = value
      }
      Property.WhiteSpaceCollapse { value } => {
        self.text.whiteSpaceCollapse = value
      }
      Property.TextJustify { value } => {
        self.text.textJustify = value
      }
      Property.TextIndent { value } => {
        self.text.textIndent = value
      }
      Property.TabSize { value } => {
        self.text.tabSize = value
      }
      Property.BoxDecorationBreak { value } => {
        self.boxDecorationBreak = value
      }
      Property.MarginBreak { value } => {
        self.marginBreak = value
      }
      Property.BreakBefore { value } => {
        self.breakBefore = value
      }
      Property.BreakAfter { value } => {
        self.breakAfter = value
      }
      Property.BreakInside { value } => {
        self.breakInside = value
      }
      Property.Orphans { value } => {
        self.text.orphans = value
      }
      Property.Widows { value } => {
        self.text.widows = value
      }
      Property.Order { value } => {
        self.order = value
      }
      Property.JustifySelf { value } => {
        self.justifySelf = value
      }
      Property.JustifyItems { value } => {
        self.justifyItems = value
      }
      Property.JustifyContentSafety { value } => {
        self.justifyContentSafety = value
      }
      Property.AlignContentSafety { value } => {
        self.alignContentSafety = value
      }
      Property.AlignItemsSafety { value } => {
        self.alignItemsSafety = value
      }
      Property.AlignSelfSafety { value } => {
        self.alignSelfSafety = value
      }
      Property.JustifySelfSafety { value } => {
        self.justifySelfSafety = value
      }
      Property.JustifyItemsSafety { value } => {
        self.justifyItemsSafety = value
      }
      Property.ScrollbarWidth { value } => {
        self.scrollbarWidth = value
      }
      Property.ScrollbarGutter { value } => {
        self.scrollbarGutter = value
      }
      Property.Float { value } => {
        self.float = value
      }
      Property.Clear { value } => {
        self.clear = value
      }
      Property.Visibility { value } => {
        self.text.visibility = value
        self.text.visible = value == Visibility.Visible
      }
      Property.AspectRatioAuto { value } => {
        self.aspectRatioAuto = value
      }

      Property.Display { value } => {
        self.display = value
      }
      Property.Width { value } => {
        self.width = value
      }
      Property.Height { value } => {
        self.height = value
      }
      Property.MinWidth { value } => {
        self.minWidth = value
      }
      Property.MinHeight { value } => {
        self.minHeight = value
      }
      Property.MaxWidth { value } => {
        self.maxWidth = value
      }
      Property.MaxHeight { value } => {
        self.maxHeight = value
      }
      Property.Margin { side, value } => {
        self.margin.set(side, value)
      }
      Property.Padding { side, value } => {
        self.padding.set(side, value)
      }
      Property.BorderWidth { side, value } => {
        match side {
          Side.Top => {
            self.border.top = value
          }
          Side.Right => {
            self.border.right = value
          }
          Side.Bottom => {
            self.border.bottom = value
          }
          Side.Left => {
            self.border.left = value
          }
        }
      }
      Property.Inset { side, value } => {
        self.inset.set(side, value)
      }
      Property.Position { value } => {
        self.position = value
      }
      Property.BoxSizing { value } => {
        self.boxSizing = value
      }
      Property.FlexDirection { value } => {
        self.flexDirection = value
      }
      Property.FlexWrap { value } => {
        self.flexWrap = value
      }
      Property.FlexGrow { value } => {
        self.flexGrow = value
      }
      Property.FlexShrink { value } => {
        self.flexShrink = value
      }
      Property.FlexBasis { value } => {
        self.flexBasis = value
      }
      Property.JustifyContent { value } => {
        self.justifyContent = value
      }
      Property.AlignItems { value } => {
        self.alignItems = value
      }
      Property.AlignSelf { value } => {
        self.alignSelf = value
      }
      Property.AlignContent { value } => {
        self.alignContent = value
      }
      Property.RowGap { value } => {
        self.rowGap = value
      }
      Property.ColumnGap { value } => {
        self.columnGap = value
      }
      Property.OverflowX { value } => {
        self.overflowX = value
      }
      Property.OverflowY { value } => {
        self.overflowY = value
      }
      Property.AspectRatio { value } => {
        self.aspectRatio = value
      }
      Property.BackgroundColor { color } => {
        self.background = Fill.Solid { color: color }
      }
      Property.BackgroundGradient { angle, from, to } => {
        self.background = Fill.Gradient { angle: angle, from: from, to: to }
      }
      Property.BorderColor { color } => {
        self.borderColor = color
      }
      Property.BorderStyle { value } => {
        self.borderStyle = value
      }
      Property.BorderRadius { value } => {
        self.radii = value
      }
      Property.BoxShadow { value } => {
        self.shadow = value
        self.hasShadow = true
      }
      Property.NoBoxShadow => {
        self.hasShadow = false
      }
      Property.BackdropBlur { value } => {
        self.backdropBlur = f32.max(0.0, value)
      }
      Property.Opacity { value } => {
        self.opacity = value
      }
      Property.PointerEvents { value } => {
        self.pointerEvents = value
      }
      Property.Visible { value } => {
        self.text.visible = value
        self.text.visibility = if value {
          Visibility.Visible
        } else {
          Visibility.Hidden
        }
      }
      Property.FontFamily { family } => {
        self.text.family = family
      }
      Property.FontSize { value } => {
        self.text.size = value
      }
      Property.FontWeight { value } => {
        self.text.weight = value
      }
      Property.FontStyle { value } => {
        self.text.style = value
      }
      Property.LineHeight { value } => {
        self.text.lineHeight = value
      }
      Property.Color { color } => {
        self.text.color = color
      }
      Property.TextAlign { value } => {
        self.text.align = value
      }
      Property.WhiteSpace { value } => {
        self.text.whiteSpace = value
        self.text.textWrap = if value == WhiteSpace.NoWrap || value == WhiteSpace.Pre {
          TextWrap.NoWrap
        } else {
          TextWrap.Wrap
        }
        self.text.whiteSpaceCollapse = if value == WhiteSpace.Pre || value == WhiteSpace.PreWrap {
          WhiteSpaceCollapse.Preserve
        } else if value == WhiteSpace.PreLine {
          WhiteSpaceCollapse.PreserveBreaks
        } else {
          WhiteSpaceCollapse.Collapse
        }
      }
      Property.Direction { value } => {
        self.text.direction = value
      }
      Property.TextDecorationLine { value } => {
        self.text.decoration = value
      }
      Property.TextDecorationColor { color } => {
        self.text.decorationColor = color
        self.text.hasDecorationColor = true
      }
      Property.TextDecorationWavy { value } => {
        self.text.wavy = value
      }
      Property.CaretColor { color } => {
        self.text.caretColor = color
        self.text.hasCaretColor = true
      }
      Property.SelectionColor { color } => {
        self.text.selectionColor = color
      }
      Property.PlaceholderColor { color } => {
        self.text.placeholderColor = color
        self.text.hasPlaceholderColor = true
      }
    }
  }

  /// Whether the node clips its children to its padding box.
  pub fn clips(self: &Self) -> bool {
    return self.overflowX != Overflow.Visible || self.overflowY != Overflow.Visible
  }

  /// Whether the node draws anything of its own box: a background, border or shadow.
  pub fn decorated(self: &Self) -> bool {
    let fills = match self.background {
      Fill.None => false
      Fill.Solid { color } => color.a > 0.0
      Fill.Gradient { angle, from, to } => true
    }
    let border = self.borderStyle != BorderStyle.None && self.borderColor.a > 0.0
      && (self.border.top > 0.0 || self.border.right > 0.0 || self.border.bottom > 0.0
        || self.border.left > 0.0)
    return fills || border || self.hasShadow
  }

  /// A hash of everything that changes layout, with the font key the text style resolved to.
  pub fn layoutHash(self: &Self, seed: &HashSeed, fontKey: usize) -> u64 {
    let mut h = Hash.mix(seed, usize.toU64(fontKey))
    h = Hash.combine(h, displayIndex(self.display))
    h = lengthHash(h, self.width)
    h = lengthHash(h, self.height)
    h = lengthHash(h, self.minWidth)
    h = lengthHash(h, self.minHeight)
    h = lengthHash(h, self.maxWidth)
    h = lengthHash(h, self.maxHeight)
    h = sidesHash(h, self.margin)
    h = sidesHash(h, self.padding)
    h = sidesHash(h, self.inset)
    h = floatHash(h, self.border.top)
    h = floatHash(h, self.border.right)
    h = floatHash(h, self.border.bottom)
    h = floatHash(h, self.border.left)
    h = Hash.combine(h, positionIndex(self.position))
    h = Hash.combine(
      h,
      if self.boxSizing == BoxSizing.BorderBox {
        1
      } else {
        0
      },
    )
    h = Hash.combine(h, flexDirectionIndex(self.flexDirection))
    h = Hash.combine(h, flexWrapIndex(self.flexWrap))
    h = floatHash(h, self.flexGrow)
    h = floatHash(h, self.flexShrink)
    h = lengthHash(h, self.flexBasis)
    h = Hash.combine(h, alignIndex(self.justifyContent))
    h = Hash.combine(h, alignIndex(self.alignItems))
    h = Hash.combine(h, alignIndex(self.alignSelf))
    h = Hash.combine(h, alignIndex(self.alignContent))
    h = lengthHash(h, self.rowGap)
    h = lengthHash(h, self.columnGap)
    h = Hash.combine(h, overflowIndex(self.overflowX))
    h = Hash.combine(h, overflowIndex(self.overflowY))
    h = floatHash(h, self.aspectRatio)
    h = lineHeightHash(h, self.text.lineHeight)
    h = Hash.combine(h, textAlignIndex(self.text.align))
    h = Hash.combine(h, whiteSpaceIndex(self.text.whiteSpace))
    h = Hash.combine(
      h,
      if self.text.direction == Direction.Rtl {
        1
      } else {
        0
      },
    )
    h = Hash.combine(
      h,
      if self.text.visible {
        1
      } else {
        0
      },
    )
    h = Hash.combine(h, u8.toU64(UnicodeBidi.value(self.unicodeBidi)))
    h = Hash.combine(h, u8.toU64(WritingMode.value(self.text.writingMode)))
    h = Hash.combine(h, u8.toU64(TextOrientation.value(self.text.textOrientation)))
    h = dimensionHash(
      Hash.combine(h, u8.toU64(VerticalAlignKind.value(self.verticalAlign.kind))),
      self.verticalAlign.shift,
    )
    h = Hash.combine(h, u8.toU64(BaselineSource.value(self.baselineSource)))
    h = Hash.combine(h, u8.toU64(LayoutTextAlign.value(self.text.textAlignLast)))
    h = Hash.combine(h, u8.toU64(TextWrap.value(self.text.textWrap)))
    h = Hash.combine(h, u8.toU64(WhiteSpaceCollapse.value(self.text.whiteSpaceCollapse)))
    h = Hash.combine(h, u8.toU64(TextJustify.value(self.text.textJustify)))
    h = dimensionHash(
      Hash.combine(
        Hash.combine(
          h,
          if self.text.textIndent.hanging {
            1
          } else {
            0
          },
        ),
        if self.text.textIndent.eachLine {
          1
        } else {
          0
        },
      ),
      self.text.textIndent.value,
    )
    h = tabHash(h, self.text.tabSize)
    h = Hash.combine(h, u8.toU64(BoxDecorationBreak.value(self.boxDecorationBreak)))
    h = Hash.combine(h, u8.toU64(MarginBreak.value(self.marginBreak)))
    h = Hash.combine(h, u8.toU64(BreakBetween.value(self.breakBefore)))
    h = Hash.combine(h, u8.toU64(BreakBetween.value(self.breakAfter)))
    h = Hash.combine(h, u8.toU64(BreakInside.value(self.breakInside)))
    h = Hash.combine(h, usize.toU64(self.text.orphans))
    h = Hash.combine(h, usize.toU64(self.text.widows))
    h = Hash.combine(h, u32.toU64(i32.wrappingToU32(self.order)))
    h = Hash.combine(h, alignIndex(self.justifySelf))
    h = Hash.combine(h, alignIndex(self.justifyItems))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.justifyContentSafety)))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.alignContentSafety)))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.alignItemsSafety)))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.alignSelfSafety)))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.justifySelfSafety)))
    h = Hash.combine(h, u8.toU64(OverflowAlignment.value(self.justifyItemsSafety)))
    h = Hash.combine(h, u8.toU64(ScrollbarWidth.value(self.scrollbarWidth)))
    h = Hash.combine(h, u8.toU64(ScrollbarGutter.value(self.scrollbarGutter)))
    h = Hash.combine(h, u8.toU64(Float.value(self.float)))
    h = Hash.combine(h, u8.toU64(Clear.value(self.clear)))
    h = Hash.combine(h, u8.toU64(Visibility.value(self.text.visibility)))
    h = Hash.combine(
      h,
      if self.aspectRatioAuto {
        1
      } else {
        0
      },
    )
    return h
  }

  /// A hash of everything that changes how the node paints but not its layout.
  pub fn paintHash(self: &Self, seed: &HashSeed) -> u64 {
    let mut h = Hash.mix(seed, 7)
    h = Hash.combine(h, u8.toU64(ObjectFit.value(self.objectFit)))
    h = lengthHash(lengthHash(h, self.objectX), self.objectY)
    match self.background {
      Fill.None => {
        h = Hash.combine(h, 0)
      }
      Fill.Solid { color } => {
        h = colorHash(Hash.combine(h, 1), color)
      }
      Fill.Gradient { angle, from, to } => {
        h = colorHash(colorHash(floatHash(Hash.combine(h, 2), angle), from), to)
      }
    }
    h = colorHash(h, self.borderColor)
    h = Hash.combine(h, borderStyleIndex(self.borderStyle))
    h = floatHash(h, self.radii.topLeft)
    h = floatHash(h, self.radii.topRight)
    h = floatHash(h, self.radii.bottomRight)
    h = floatHash(h, self.radii.bottomLeft)
    if self.hasShadow {
      h = floatHash(h, self.shadow.offsetX)
      h = floatHash(h, self.shadow.offsetY)
      h = floatHash(h, self.shadow.blur)
      h = floatHash(h, self.shadow.spread)
      h = colorHash(h, self.shadow.color)
      h = Hash.combine(
        h,
        if self.shadow.inset {
          3
        } else {
          2
        },
      )
    }
    h = floatHash(h, self.opacity)
    h = floatHash(h, self.backdropBlur)
    h = colorHash(h, self.text.color)
    h = Hash.combine(h, decorationIndex(self.text.decoration))
    h = colorHash(h, self.text.lineColor())
    h = Hash.combine(
      h,
      if self.text.wavy {
        1
      } else {
        0
      },
    )
    h = colorHash(h, self.text.caret())
    h = colorHash(h, self.text.selectionColor)
    h = colorHash(h, self.text.placeholder())
    h = Hash.combine(
      h,
      if self.pointerEvents {
        1
      } else {
        0
      },
    )
    return h
  }

  /// The css-layout style of an element with this computed style and font key.
  pub fn toLayout(self: &Self, fontKey: usize) -> CssStyle {
    let mut style = CssStyle.make()
    style.display = match self.display {
      Display.None => CssDisplay.None
      Display.Block => boxDisplay(DisplayOutside.Block, DisplayInside.Flow)
      Display.Inline => boxDisplay(DisplayOutside.Inline, DisplayInside.Flow)
      Display.InlineBlock => boxDisplay(DisplayOutside.Inline, DisplayInside.FlowRoot)
      Display.Flex => boxDisplay(DisplayOutside.Block, DisplayInside.Flex)
      Display.InlineFlex => boxDisplay(DisplayOutside.Inline, DisplayInside.Flex)
      Display.FlowRoot => boxDisplay(DisplayOutside.Block, DisplayInside.FlowRoot)
      Display.Grid => boxDisplay(DisplayOutside.Block, DisplayInside.Grid)
      Display.InlineGrid => boxDisplay(DisplayOutside.Inline, DisplayInside.Grid)
      Display.Contents => CssDisplay.Contents
    }
    style.width = dimension(self.width)
    style.height = dimension(self.height)
    style.minWidth = dimension(self.minWidth)
    style.minHeight = dimension(self.minHeight)
    style.maxWidth = dimension(self.maxWidth)
    style.maxHeight = dimension(self.maxHeight)
    style.margin = edges(self.margin)
    style.padding = edges(self.padding)
    style.border = borderEdges(self.border)
    if self.borderStyle == BorderStyle.None {
      style.border = Edges.all(Dimension.px(0.0))
    }
    style.inset = edges(self.inset)
    style.position = match self.position {
      Position.Static => CssPosition.Static
      Position.Relative => CssPosition.Relative
      Position.Absolute => CssPosition.Absolute
      Position.Fixed => CssPosition.Fixed
      Position.Sticky => CssPosition.Sticky
    }
    style.boxSizing = match self.boxSizing {
      BoxSizing.ContentBox => CssBoxSizing.ContentBox
      BoxSizing.BorderBox => CssBoxSizing.BorderBox
    }
    style.flexDirection = match self.flexDirection {
      FlexDirection.Row => CssFlexDirection.Row
      FlexDirection.RowReverse => CssFlexDirection.RowReverse
      FlexDirection.Column => CssFlexDirection.Column
      FlexDirection.ColumnReverse => CssFlexDirection.ColumnReverse
    }
    style.flexWrap = match self.flexWrap {
      FlexWrap.NoWrap => CssFlexWrap.NoWrap
      FlexWrap.Wrap => CssFlexWrap.Wrap
      FlexWrap.WrapReverse => CssFlexWrap.WrapReverse
    }
    style.flexGrow = self.flexGrow
    style.flexShrink = self.flexShrink
    style.flexBasis = dimension(self.flexBasis)
    style.justifyContent = align(self.justifyContent)
    style.alignItems = align(self.alignItems)
    style.alignSelf = align(self.alignSelf)
    style.alignContent = align(self.alignContent)
    style.rowGap = gap(self.rowGap)
    style.columnGap = gap(self.columnGap)
    style.overflowX = overflow(self.overflowX)
    style.overflowY = overflow(self.overflowY)
    if self.aspectRatio > 0.0 {
      style.aspectRatio = self.aspectRatio
    }
    style.fontKey = fontKey
    style.lineHeight = match self.text.lineHeight {
      LineHeight.Normal => CssLineHeight.Normal
      LineHeight.Number { value } => CssLineHeight.Number { value: value }
      LineHeight.Px { value } => CssLineHeight.Length { value: value }
    }
    style.textAlign = match self.text.align {
      TextAlign.Auto => CssTextAlign.Auto
      TextAlign.Start => CssTextAlign.Start
      TextAlign.End => CssTextAlign.End
      TextAlign.Left => CssTextAlign.Left
      TextAlign.Right => CssTextAlign.Right
      TextAlign.Center => CssTextAlign.Center
      TextAlign.Justify => CssTextAlign.Justify
    }
    if self.text.direction == Direction.Rtl {
      style.direction = CssDirection.Rtl
    }
    if !self.text.visible {
      style.visibility = Visibility.Hidden
    }
    style.unicodeBidi = self.unicodeBidi
    style.writingMode = self.text.writingMode
    style.textOrientation = self.text.textOrientation
    style.verticalAlign = self.verticalAlign
    style.baselineSource = self.baselineSource
    style.textAlignLast = self.text.textAlignLast
    style.textWrap = self.text.textWrap
    style.whiteSpaceCollapse = self.text.whiteSpaceCollapse
    style.textJustify = self.text.textJustify
    style.textIndent = self.text.textIndent
    style.tabSize = self.text.tabSize
    style.boxDecorationBreak = self.boxDecorationBreak
    style.marginBreak = self.marginBreak
    style.breakBefore = self.breakBefore
    style.breakAfter = self.breakAfter
    style.breakInside = self.breakInside
    style.orphans = self.text.orphans
    style.widows = self.text.widows
    style.order = self.order
    style.justifySelf = align(self.justifySelf)
    style.justifyItems = align(self.justifyItems)
    style.justifyContentSafety = self.justifyContentSafety
    style.alignContentSafety = self.alignContentSafety
    style.alignItemsSafety = self.alignItemsSafety
    style.alignSelfSafety = self.alignSelfSafety
    style.justifySelfSafety = self.justifySelfSafety
    style.justifyItemsSafety = self.justifyItemsSafety
    style.scrollbarWidth = self.scrollbarWidth
    style.scrollbarGutter = self.scrollbarGutter
    style.float = self.float
    style.clear = self.clear
    style.visibility = self.text.visibility
    style.aspectRatioAuto = self.aspectRatioAuto
    return move style
  }
}

fn boxDisplay(outside: DisplayOutside, inside: DisplayInside) -> CssDisplay {
  return CssDisplay.Box { outside: outside, inside: inside }
}

fn borderEdges(border: Insets<f32>) -> Edges {
  return Edges {
    top: Dimension.px(border.top),
    right: Dimension.px(border.right),
    bottom: Dimension.px(border.bottom),
    left: Dimension.px(border.left),
  }
}

/// The css-layout dimension of a length.
pub fn dimension(value: Length) -> Dimension {
  return match value {
    Length.Auto => Dimension.auto()
    Length.Px { value: px } => Dimension.px(px)
    Length.Percent { value: pct } => Dimension.pct(pct / 100.0)
    Length.None => Dimension.keyword(DimensionKind.None)
    Length.Calc { pixels, percent } => Dimension.calc(pixels, percent / 100.0)
    Length.MinContent => Dimension.keyword(DimensionKind.MinContent)
    Length.MaxContent => Dimension.keyword(DimensionKind.MaxContent)
    Length.FitContent => Dimension.keyword(DimensionKind.FitContent)
    Length.Content => Dimension.keyword(DimensionKind.Content)
    Length.Normal => Dimension.keyword(DimensionKind.Normal)
  }
}

fn gap(value: Length) -> Dimension {
  return match value {
    Length.Auto => Dimension.keyword(DimensionKind.Normal)
    Length.None => Dimension.keyword(DimensionKind.Normal)
    _ => dimension(value)
  }
}

fn edges(value: Sides) -> Edges {
  return Edges {
    top: dimension(value.top),
    right: dimension(value.right),
    bottom: dimension(value.bottom),
    left: dimension(value.left),
  }
}

fn align(value: Align) -> CssAlign {
  return match value {
    Align.Auto => CssAlign.Auto
    Align.Normal => CssAlign.Normal
    Align.Start => CssAlign.Start
    Align.End => CssAlign.End
    Align.Center => CssAlign.Center
    Align.Stretch => CssAlign.Stretch
    Align.Baseline => CssAlign.Baseline
    Align.SpaceBetween => CssAlign.SpaceBetween
    Align.SpaceAround => CssAlign.SpaceAround
    Align.SpaceEvenly => CssAlign.SpaceEvenly
    Align.Right => CssAlign.Right
    Align.Left => CssAlign.Left
    Align.SelfEnd => CssAlign.SelfEnd
    Align.SelfStart => CssAlign.SelfStart
    Align.LastBaseline => CssAlign.LastBaseline
    Align.FlexEnd => CssAlign.FlexEnd
    Align.FlexStart => CssAlign.FlexStart
  }
}

fn overflow(value: Overflow) -> CssOverflow {
  return match value {
    Overflow.Visible => CssOverflow.Visible
    Overflow.Hidden => CssOverflow.Hidden
    Overflow.Clip => CssOverflow.Clip
    Overflow.Scroll => CssOverflow.Scroll
    Overflow.Auto => CssOverflow.Auto
  }
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}

fn colorHash(h: u64, color: Rgba<f32>) -> u64 {
  return floatHash(floatHash(floatHash(floatHash(h, color.r), color.g), color.b), color.a)
}

fn lengthHash(h: u64, value: Length) -> u64 {
  return match value {
    Length.Auto => Hash.combine(h, 1)
    Length.Px { value: px } => floatHash(Hash.combine(h, 2), px)
    Length.Percent { value: pct } => floatHash(Hash.combine(h, 3), pct)
    Length.None => Hash.combine(h, 4)
    Length.Calc { pixels, percent } => floatHash(floatHash(Hash.combine(h, 5), pixels), percent)
    Length.MinContent => Hash.combine(h, 6)
    Length.MaxContent => Hash.combine(h, 7)
    Length.FitContent => Hash.combine(h, 8)
    Length.Content => Hash.combine(h, 9)
    Length.Normal => Hash.combine(h, 10)
  }
}

fn sidesHash(h: u64, value: Sides) -> u64 {
  return lengthHash(
    lengthHash(lengthHash(lengthHash(h, value.top), value.right), value.bottom),
    value.left,
  )
}

fn lineHeightHash(h: u64, value: LineHeight) -> u64 {
  return match value {
    LineHeight.Normal => Hash.combine(h, 1)
    LineHeight.Number { value: n } => floatHash(Hash.combine(h, 2), n)
    LineHeight.Px { value: px } => floatHash(Hash.combine(h, 3), px)
  }
}

fn displayIndex(value: Display) -> u64 {
  return match value {
    Display.None => 0
    Display.Block => 1
    Display.Inline => 2
    Display.InlineBlock => 3
    Display.Flex => 4
    Display.InlineFlex => 5
    Display.FlowRoot => 6
    Display.Grid => 7
    Display.InlineGrid => 8
    Display.Contents => 9
  }
}

fn positionIndex(value: Position) -> u64 {
  return match value {
    Position.Static => 0
    Position.Relative => 1
    Position.Absolute => 2
    Position.Fixed => 3
    Position.Sticky => 4
  }
}

fn flexDirectionIndex(value: FlexDirection) -> u64 {
  return match value {
    FlexDirection.Row => 0
    FlexDirection.RowReverse => 1
    FlexDirection.Column => 2
    FlexDirection.ColumnReverse => 3
  }
}

fn flexWrapIndex(value: FlexWrap) -> u64 {
  return match value {
    FlexWrap.NoWrap => 0
    FlexWrap.Wrap => 1
    FlexWrap.WrapReverse => 2
  }
}

fn alignIndex(value: Align) -> u64 {
  return match value {
    Align.Auto => 0
    Align.Normal => 1
    Align.Start => 2
    Align.End => 3
    Align.Center => 4
    Align.Stretch => 5
    Align.Baseline => 6
    Align.SpaceBetween => 7
    Align.SpaceAround => 8
    Align.SpaceEvenly => 9
    Align.Right => 16
    Align.Left => 15
    Align.SelfEnd => 14
    Align.SelfStart => 13
    Align.LastBaseline => 12
    Align.FlexEnd => 11
    Align.FlexStart => 10
  }
}

fn overflowIndex(value: Overflow) -> u64 {
  return match value {
    Overflow.Visible => 0
    Overflow.Hidden => 1
    Overflow.Clip => 2
    Overflow.Scroll => 3
    Overflow.Auto => 4
  }
}

fn textAlignIndex(value: TextAlign) -> u64 {
  return match value {
    TextAlign.Auto => 6
    TextAlign.Start => 0
    TextAlign.End => 1
    TextAlign.Left => 2
    TextAlign.Right => 3
    TextAlign.Center => 4
    TextAlign.Justify => 5
  }
}

fn whiteSpaceIndex(value: WhiteSpace) -> u64 {
  return match value {
    WhiteSpace.Normal => 0
    WhiteSpace.NoWrap => 1
    WhiteSpace.Pre => 2
    WhiteSpace.PreWrap => 3
    WhiteSpace.PreLine => 4
  }
}

fn borderStyleIndex(value: BorderStyle) -> u64 {
  return match value {
    BorderStyle.None => 0
    BorderStyle.Solid => 1
    BorderStyle.Dashed => 2
  }
}

fn decorationIndex(value: DecorationLine) -> u64 {
  let mut bits: u64 = 0
  if value.underline {
    bits = bits + 1
  }
  if value.overline {
    bits = bits + 2
  }
  if value.lineThrough {
    bits = bits + 4
  }
  return bits
}

fn dimensionHash(h: u64, value: Dimension) -> u64 {
  return floatHash(
    floatHash(Hash.combine(h, u8.toU64(DimensionKind.value(value.kind))), value.value),
    value.percent,
  )
}

fn tabHash(h: u64, value: TabSize) -> u64 {
  return match value {
    TabSize.Number { value: n } => floatHash(Hash.combine(h, 0), n)
    TabSize.Length { value: n } => floatHash(Hash.combine(h, 1), n)
  }
}
