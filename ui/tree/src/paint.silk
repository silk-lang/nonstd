//! Painting: a walk over css-layout's fragments that turns box decorations into quads and
//! shadows, inline spans into per-line quads, text fragments into glyph sprites from the runs
//! ui-text shaped during layout, image and icon nodes into sprites, and canvas commands into
//! paths. Clips become content masks and opacity an isolated layer. A subtree whose paint inputs
//! did not change since the previous frame is copied from the previous scene with
//! `Scene.replay`.
import mutation { NodeKind, BorderStyle as StyleBorder, CanvasCommand }
import style { Computed, Fill }
import node { NONE, NO_INDEX, Node, FaceSlot, FrameStats, PaintCache }
import resources { Resources, Resource }
import scrollbar { thumbOf, Thumb }
import edit
import ui_text.system { TextSystem }
import ui_text.glyphs { GlyphRun, PositionedGlyph }
import layout.lib { Tree, LayoutTree, Fragment, FragmentKind, TextFragment, TextFragmentKind }
import font_raster.cache { GlyphCache, RasterGlyph }
import font_raster.face { FontFace }
import font_raster.key { GlyphKey, PenPosition }
import atlas.atlas { Atlas, AtlasError, AtlasTile, Kind }
import ui_scene.primitives {
  Background,
  BorderStyle,
  ContentMask,
  GlyphSprite,
  ImageSprite,
  Isolation,
  Quad,
  Shadow,
  Underline
}
import ui_scene.scene { Scene }
import ui_scene.path_cache { PathCache }
import vector.geometry { Affine }
import vector.geometry_error { GeometryError }
import vector.path { Path as VectorPath }
import vector.strips { NONZERO }
import vector.stroke { Stroke }
import silk.collections.hash { Hash, HashSeed }
import silk.collections.list { List }
import silk.color.rgba { Rgba }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// Everything a frame's paint reads and writes, borrowed from the tree.
pub struct Painter<'p, 'a> {
  pub nodes: &'p mut List<Node>,
  pub slotOfCss: &'p List<u32>,
  pub css: &'p Tree,
  pub output: &'p LayoutTree,
  pub text: &'p TextSystem<'a>,
  pub faces: &'p List<FaceSlot<'a>>,
  pub atlas: &'p mut Atlas,
  pub glyphs: &'p mut GlyphCache,
  pub resources: &'p mut Resources,
  pub paths: &'p mut PathCache,
  pub scene: &'p mut Scene,
  pub previous: &'p Scene,
  pub replayable: bool,
  pub hashes: &'p List<u64>,
  pub stats: &'p mut FrameStats,
  pub order: &'p mut List<u32>,
  pub frame: u64,
  pub scale: f32,
  pub time: f64,
  pub seed: HashSeed,
  /// When set, only the subtree of this slot is painted and nothing is cached.
  pub only: u32,
  pub inside: bool,
}

fn slotIn(slots: &List<u32>, index: usize) -> u32 {
  if index < slots.length() {
    return slots.get(index)
  }
  return NONE
}

/// The slot of the element whose style a fragment of css-layout node `source` paints with: the
/// node itself, or for text, the nearest element above it.
pub fn styleSlot(slots: &List<u32>, css: &Tree, nodes: &List<Node>, source: usize) -> u32 {
  let mut at = source
  while at != NO_INDEX && at < css.nodes.length() {
    let slot = slotIn(slots, at)
    if slot != NONE && nodes.asSlice()[u32.toUsize(slot)].kind != NodeKind.Text {
      return slot
    }
    at = css.nodes.asSlice()[at].parent
  }
  return NONE
}

fn device(rect: Rect<f32>, scale: f32) -> Rect<f32> {
  return Rect<f32>.new(rect.xMin * scale, rect.yMin * scale, rect.xMax * scale, rect.yMax * scale)
}

/// The border box of fragment `f` in CSS pixels of the viewport.
pub fn borderBox(f: &Fragment) -> Rect<f32> {
  return Rect<f32>.new(
    f.worldLocation.x,
    f.worldLocation.y,
    f.worldLocation.x + f.size.width,
    f.worldLocation.y + f.size.height,
  )
}

pub fn paddingBox(f: &Fragment) -> Rect<f32> {
  let x = f.worldLocation.x + f.paddingRect.x
  let y = f.worldLocation.y + f.paddingRect.y
  return Rect<f32>.new(x, y, x + f.paddingRect.width, y + f.paddingRect.height)
}

pub fn contentBox(f: &Fragment) -> Rect<f32> {
  let x = f.worldLocation.x + f.contentRect.x
  let y = f.worldLocation.y + f.contentRect.y
  return Rect<f32>.new(x, y, x + f.contentRect.width, y + f.contentRect.height)
}

fn scaledCorners(radii: Corners<f32>, scale: f32) -> Corners<f32> {
  return Corners<f32>.new(
    radii.topLeft * scale,
    radii.topRight * scale,
    radii.bottomRight * scale,
    radii.bottomLeft * scale,
  )
}

fn backgroundOf(fill: Fill) -> Background {
  return match fill {
    Fill.None => Background.solid(Rgba<f32> { r: 0.0, g: 0.0, b: 0.0, a: 0.0 })
    Fill.Solid { color } => Background.solid(color)
    Fill.Gradient { angle, from, to } => Background.linear(angle, from, to)
  }
}

fn hasEdge(edges: u8, bit: u8) -> bool {
  return u8.bitAnd(edges, bit) != 0
}

/// Draws the shadow, background and border of a box with computed style `c` over `rect`
/// (CSS pixels). `edges` says which edges are drawn (bits top 1, right 2, bottom 4, left 8),
/// as a span split across lines draws only some.
effect fn decorate(
  p: &mut Painter,
  c: &Computed,
  rect: Rect<f32>,
  edges: u8,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let bounds = device(rect, s)
  let mut radii = scaledCorners(c.radii, s)
  if !hasEdge(edges, 1) {
    radii.topLeft = 0.0
    radii.topRight = 0.0
  }
  if !hasEdge(edges, 2) {
    radii.topRight = 0.0
    radii.bottomRight = 0.0
  }
  if !hasEdge(edges, 4) {
    radii.bottomRight = 0.0
    radii.bottomLeft = 0.0
  }
  if !hasEdge(edges, 8) {
    radii.topLeft = 0.0
    radii.bottomLeft = 0.0
  }
  if c.hasShadow && !c.shadow.inset && c.shadow.color.a > 0.0 {
    drop run p.scene.shadow(
      Shadow {
        bounds: bounds,
        mask: mask,
        cornerRadii: radii,
        color: c.shadow.color,
        blurRadius: c.shadow.blur * s,
        offset: Vector2<f32> { x: c.shadow.offsetX * s, y: c.shadow.offsetY * s },
        spread: c.shadow.spread * s,
        inset: false,
      },
    )
  }
  let mut widths = Insets<f32>.zero()
  if c.borderStyle != StyleBorder.None {
    if hasEdge(edges, 1) {
      widths.top = c.border.top * s
    }
    if hasEdge(edges, 2) {
      widths.right = c.border.right * s
    }
    if hasEdge(edges, 4) {
      widths.bottom = c.border.bottom * s
    }
    if hasEdge(edges, 8) {
      widths.left = c.border.left * s
    }
  }
  let background = backgroundOf(c.background)
  let bordered = (widths.top > 0.0 || widths.right > 0.0 || widths.bottom > 0.0
    || widths.left > 0.0)
    && c.borderColor.a > 0.0
  if !background.isTransparent() || bordered {
    let mut quad = Quad.fill(bounds, mask, background)
    quad.cornerRadii = radii
    if bordered {
      quad.borderWidths = widths
      quad.borderColor = c.borderColor
      quad.borderStyle = if c.borderStyle == StyleBorder.Dashed {
        BorderStyle.Dashed
      } else {
        BorderStyle.Solid
      }
    }
    drop run p.scene.quad(quad)
  }
  if c.hasShadow && c.shadow.inset && c.shadow.color.a > 0.0 {
    drop run p.scene.shadow(
      Shadow {
        bounds: bounds,
        mask: mask,
        cornerRadii: radii,
        color: c.shadow.color,
        blurRadius: c.shadow.blur * s,
        offset: Vector2<f32> { x: c.shadow.offsetX * s, y: c.shadow.offsetY * s },
        spread: c.shadow.spread * s,
        inset: true,
      },
    )
  }
}

effect fn noGlyph<E>(error: E) -> Option<RasterGlyph> {
  drop error
  return Option<RasterGlyph>.None
}

effect fn noPath<E>(error: E) -> u32 {
  drop error
  return 0
}

/// Paints a text fragment: its glyph run, as shaped during layout, and its decorations.
effect fn paintText(p: &mut Painter, index: usize, f: Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if f.textData == NO_INDEX {
    return ()
  }
  let t = p.output.fragments.texts.get(f.textData)
  if t.kind != TextFragmentKind.Glyphs {
    return ()
  }
  let slot = styleSlot(&p.slotOfCss.*, &p.css.*, &p.nodes.*, f.source)
  if slot == NONE {
    return ()
  }
  let c = p.nodes.asSlice()[u32.toUsize(slot)].computed
  let mut color = c.text.color

  // An input's text ends where its value does: a filler after it has nothing to draw.
  let mut limit = usize.MAX
  if p.nodes.asSlice()[u32.toUsize(slot)].kind == NodeKind.Input {
    let e = &p.nodes.asSlice()[u32.toUsize(slot)].edit
    if e.showsPlaceholder {
      color = c.text.placeholder()
    }
    if e.filler {
      limit = String.byteLength(String.view(&e.display)) - 3
    }
  }
  if !c.text.visible || color.a <= 0.0 && !c.text.decoration.underline {
    return ()
  }
  let s = p.scale
  let baseline = f.worldLocation.y + f.firstBaselines.alphabetic
  let shaped = p.text.glyphRun(t.shapeKey)
  if t.fontKey < p.faces.length() {
    if let Option<FontFace>.Some { value: face } = &p.faces.asSlice()[t.fontKey].face {
      let glyphs = p.text.runGlyphs(t.shapeKey)
      let mut i: usize = 0
      while i < glyphs.length {
        let g = glyphs[i]
        if g.cluster >= limit {
          i = i + 1
          continue
        }
        let pen = PenPosition.of(
          f32.toF64((f.worldLocation.x + g.x) * s),
          f32.toF64((baseline + g.y) * s),
        )
        let key = GlyphKey {
          font: usize.toU32(shaped.face),
          glyph: g.glyph,
          size: shaped.size,
          scale: s,
          subpixel: pen.subpixel,
          color: true,
        }
        let found = run Effect.catchAll(p.glyphs.glyph(&mut p.atlas, &face, key), noGlyph)
        if let Option<RasterGlyph>.Some { value } = found {
          let left = i32.toF32(pen.x + value.left)
          let top = i32.toF32(pen.y + value.top)
          let bounds = Rect<f32>.new(
            left,
            top,
            left + u32.toF32(value.width()),
            top + u32.toF32(value.height()),
          )
          if &value.kind == &Kind.Polychrome {
            drop run p.scene.image(
              ImageSprite {
                bounds: bounds,
                mask: mask,
                tile: value.tile,
                opacity: color.a,
                cornerRadii: Corners<f32>.zero(),
                grayscale: false,
              },
            )
          } else {
            drop run p.scene.glyph(
              GlyphSprite { bounds: bounds, mask: mask, tile: value.tile, color: color },
            )
          }
          p.stats.glyphs = p.stats.glyphs + 1
        }
        i = i + 1
      }
    }
  }
  let line = c.text.decoration
  if line.underline || line.overline || line.lineThrough {
    let size = shaped.size
    let thickness = f32.max(1.0, size / 16.0 * s)
    let x0 = f.worldLocation.x * s
    let x1 = (f.worldLocation.x + f.size.width) * s
    let color = c.text.lineColor()
    if line.underline {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline + size * 0.1) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
    if line.overline {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline - size * 0.9) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
    if line.lineThrough {
      run underline(
        &mut p,
        x0,
        x1,
        (baseline - size * 0.3) * s,
        thickness,
        color,
        c.text.wavy,
        mask,
      )
    }
  }
}

effect fn underline(
  p: &mut Painter,
  x0: f32,
  x1: f32,
  y: f32,
  thickness: f32,
  color: Rgba<f32>,
  wavy: bool,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let height = if wavy {
    thickness * 3.0
  } else {
    thickness
  }
  drop run p.scene.underline(
    Underline {
      bounds: Rect<f32>.new(x0, y, x1, y + height),
      mask: mask,
      color: color,
      thickness: thickness,
      wavy: wavy,
    },
  )
}

/// Paints the content of an image, icon or canvas node over its content box.
effect fn paintContent(p: &mut Painter, slot: u32, f: &Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let kind = node.kind
  let c = node.computed
  let resource = node.resource
  let s = p.scale
  let content = device(contentBox(f), s)
  if kind == NodeKind.Image {
    if let Option<Resource>.Some { value } = p.resources.get(resource) {
      if let Resource.Image { image, .. } = value {
        let tile = run p.resources.imageTile(&mut p.atlas, image)
        if let Option<AtlasTile>.Some { value: placed } = tile {
          drop run p.scene.image(
            ImageSprite {
              bounds: content,
              mask: mask,
              tile: placed,
              opacity: 1.0,
              cornerRadii: scaledCorners(c.radii, s),
              grayscale: false,
            },
          )
        }
      }
    }
  } else if kind == NodeKind.Icon {
    if let Option<Resource>.Some { value } = p.resources.get(resource) {
      if let Resource.Icon { icon } = value {
        let x = f32.floor(content.xMin + 0.5)
        let y = f32.floor(content.yMin + 0.5)
        let w = f32.floor(content.width() + 0.5)
        let h = f32.floor(content.height() + 0.5)
        if w >= 1.0 && h >= 1.0 {
          let tile = run p.resources.iconTile(
            &mut p.atlas,
            icon,
            f32.toU32(w),
            f32.toU32(h),
            p.time,
          )
          if let Option<AtlasTile>.Some { value: placed } = tile {
            drop run p.scene.glyph(
              GlyphSprite {
                bounds: Rect<f32>.new(x, y, x + w, y + h),
                mask: mask,
                tile: placed,
                color: c.text.color,
              },
            )
          }
        }
      }
    }
  } else if kind == NodeKind.Canvas {
    run paintCanvas(&mut p, slot, contentBox(f), mask)
  }
}

effect fn paintCanvas(p: &mut Painter, slot: u32, origin: Rect<f32>, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let s = p.scale
  let transform = Affine.new(
    f32.toF64(s),
    0.0,
    0.0,
    f32.toF64(s),
    f32.toF64(origin.xMin * s),
    f32.toF64(origin.yMin * s),
  )
  let mut path = VectorPath.make()
  let count = p.nodes.asSlice()[u32.toUsize(slot)].canvas.length()
  let content = p.nodes.asSlice()[u32.toUsize(slot)].content
  let mut i: usize = 0
  while i < count {
    let command = p.nodes.asSlice()[u32.toUsize(slot)].canvas.get(i)
    match command {
      CanvasCommand.FillRect { x, y, width, height, radius, color } => {
        let bounds = Rect<f32>.new(
          (origin.xMin + x) * s,
          (origin.yMin + y) * s,
          (origin.xMin + x + width) * s,
          (origin.yMin + y + height) * s,
        )
        let mut quad = Quad.fill(bounds, mask, Background.solid(color))
        quad.cornerRadii = Corners<f32>.uniform(radius * s)
        drop run p.scene.quad(quad)
      }
      CanvasCommand.MoveTo { x, y } => {
        run path.moveTo(f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.LineTo { x, y } => {
        run path.lineTo(f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.QuadTo { x1, y1, x, y } => {
        run path.quadTo(f32.toF64(x1), f32.toF64(y1), f32.toF64(x), f32.toF64(y))
      }
      CanvasCommand.CubicTo { x1, y1, x2, y2, x, y } => {
        run path.cubicTo(
          f32.toF64(x1),
          f32.toF64(y1),
          f32.toF64(x2),
          f32.toF64(y2),
          f32.toF64(x),
          f32.toF64(y),
        )
      }
      CanvasCommand.Close => {
        run path.close()
      }
      CanvasCommand.Fill { color } => {
        let id = canvasKey(&p.*, slot, content, i, origin)
        drop run Effect.catchAll(
          p.paths.fill(&mut p.scene, id, &path, &transform, NONZERO, Background.solid(color), mask),
          noPath,
        )
        path.clear()
      }
      CanvasCommand.Stroke { color, width } => {
        let id = canvasKey(&p.*, slot, content, i, origin)
        let stroke = Stroke.make(f32.toF64(width))
        drop run Effect.catchAll(
          p.paths.stroke(
            &mut p.scene,
            id,
            &path,
            &stroke,
            &transform,
            Background.solid(color),
            mask,
          ),
          noPath,
        )
        path.clear()
      }
    }
    i = i + 1
  }
}

fn canvasKey(p: &Painter, slot: u32, content: u64, command: usize, origin: Rect<f32>) -> u64 {
  let mut h = Hash.mix(&p.seed, u32.toU64(slot))
  h = Hash.combine(h, content)
  h = Hash.combine(h, usize.toU64(command))
  h = Hash.combine(h, u32.toU64(f32.toBits(p.scale)))
  h = Hash.combine(h, u32.toU64(f32.toBits(origin.xMin)))
  h = Hash.combine(h, u32.toU64(f32.toBits(origin.yMin)))
  return h
}

effect fn paintChildren(p: &mut Painter, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut child = p.output.fragments.values.asSlice()[index].firstChild
  while child != NO_INDEX {
    run paintFragment(&mut p, child, mask)
    child = p.output.fragments.values.asSlice()[child].nextSibling
  }
}

effect fn noteOrder(p: &mut Painter, f: &Fragment) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !f.first {
    return ()
  }
  let slot = slotIn(p.slotOfCss, f.source)
  if slot != NONE {
    run p.order.append(p.nodes.asSlice()[u32.toUsize(slot)].id)
  }
}

/// Paints fragment `index` and its descendants.
pub effect fn paintFragment(p: &mut Painter, index: usize, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let f = p.output.fragments.values.asSlice()[index]
  if f.positioningShell {
    run paintChildren(&mut p, index, mask)
    return ()
  }
  if p.only != NONE && !p.inside {
    let slot = slotIn(p.slotOfCss, f.source)
    if slot == p.only {
      p.inside = true
      run paintFragment(&mut p, index, mask)
      p.inside = false
      return ()
    }
    run paintChildren(&mut p, index, mask)
    return ()
  }
  p.stats.paintedFragments = p.stats.paintedFragments + 1
  match f.kind {
    FragmentKind.Line => {
      run paintChildren(&mut p, index, mask)
    }
    FragmentKind.Text => {
      run noteOrder(&mut p, &f)
      run paintText(&mut p, index, f, mask)
    }
    FragmentKind.Inline => {
      run noteOrder(&mut p, &f)
      let slot = slotIn(p.slotOfCss, f.source)
      if slot != NONE && !f.nonpainting {
        let c = p.nodes.asSlice()[u32.toUsize(slot)].computed
        if c.text.visible && c.decorated() {
          run decorate(&mut p, &c, borderBox(&f), f.decorationEdges, mask)
        }
      }
      run paintChildren(&mut p, index, mask)
    }
    FragmentKind.Box => {
      run paintBox(&mut p, index, f, mask)
    }
  }
}

fn sameRect(a: Rect<f32>, b: Rect<f32>) -> bool {
  return a.xMin == b.xMin && a.yMin == b.yMin && a.xMax == b.xMax && a.yMax == b.yMax
}

/// Moves the cache ranges of the nodes inside a replayed subtree to where the replay put them,
/// and records their paint order.
effect fn shiftCaches(p: &mut Painter, index: usize, from: usize, to: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut child = p.output.fragments.values.asSlice()[index].firstChild
  while child != NO_INDEX {
    let f = p.output.fragments.values.asSlice()[child]
    run noteOrder(&mut p, &f)
    let slot = slotIn(p.slotOfCss, f.source)
    if slot != NONE && f.kind == FragmentKind.Box {
      let node = &mut p.nodes.asMutSlice()[u32.toUsize(slot)]
      if node.cache.frame + 1 == p.frame && node.cache.start >= from {
        node.cache.start = node.cache.start - from + to
        node.cache.end = node.cache.end - from + to
        node.cache.frame = p.frame
      }
    }
    run shiftCaches(&mut p, child, from, to)
    child = p.output.fragments.values.asSlice()[child].nextSibling
  }
}

effect fn paintBox(p: &mut Painter, index: usize, f: Fragment, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let slot = slotIn(p.slotOfCss, f.source)
  if slot == NONE {
    run paintChildren(&mut p, index, mask)
    return ()
  }
  let cacheable = p.only == NONE && f.first && f.last && !f.repeated
  let hash = if index < p.hashes.length() {
    p.hashes.get(index)
  } else {
    0
  }
  if cacheable && p.replayable {
    let cache = p.nodes.asSlice()[u32.toUsize(slot)].cache
    if cache.frame + 1 == p.frame && cache.hash == hash && sameRect(cache.mask, mask.bounds)
      && cache.scale == p.scale {
      let start = p.scene.operationCount()
      run p.scene.replay(p.previous, cache.start, cache.end)
      let end = p.scene.operationCount()
      run noteOrder(&mut p, &f)
      run shiftCaches(&mut p, index, cache.start, start)
      let nodes = p.nodes.asMutSlice()
      nodes[u32.toUsize(slot)].cache = PaintCache {
        hash: hash,
        start: start,
        end: end,
        frame: p.frame,
        mask: mask.bounds,
        scale: p.scale,
      }
      p.stats.replayedSubtrees = p.stats.replayedSubtrees + 1
      p.stats.replayedOperations = p.stats.replayedOperations + (end - start)
      return ()
    }
  }
  run noteOrder(&mut p, &f)
  let start = p.scene.operationCount()
  let c = p.nodes.asSlice()[u32.toUsize(slot)].computed
  let kind = p.nodes.asSlice()[u32.toUsize(slot)].kind
  if c.opacity > 0.0 {
    let layered = c.opacity < 1.0
    if layered {
      drop run p.scene.pushIsolatedLayer(
        mask.bounds,
        mask,
        Isolation { opacity: c.opacity, blend: 0 },
      )
    }
    if c.text.visible && !f.nonpainting {
      if c.decorated() {
        run decorate(&mut p, &c, borderBox(&f), f.decorationEdges, mask)
      }
      if kind == NodeKind.Image || kind == NodeKind.Icon || kind == NodeKind.Canvas {
        run paintContent(&mut p, slot, &f, mask)
      }
    }
    let mut inner = mask
    if c.clips() {
      inner = mask.intersect(ContentMask.new(device(paddingBox(&f), p.scale)))
    }
    let input = kind == NodeKind.Input && c.text.visible
    if input {
      run edit.paintSelection(&mut p, slot, index, inner)
    }
    run paintChildren(&mut p, index, inner)
    if input {
      run edit.paintCaret(&mut p, slot, index, inner)
    }
    if c.clips() && c.text.visible {
      run paintThumbs(&mut p, slot, &c, &f, mask)
    }
    if layered {
      run p.scene.popLayer()
    }
  }
  let end = p.scene.operationCount()
  if cacheable {
    let nodes = p.nodes.asMutSlice()
    nodes[u32.toUsize(slot)].cache = PaintCache {
      hash: hash,
      start: start,
      end: end,
      frame: p.frame,
      mask: mask.bounds,
      scale: p.scale,
    }
    p.stats.repaintedSubtrees = p.stats.repaintedSubtrees + 1
  }
}

/// The color of overlay scrollbar thumbs: a gray that shows on light and dark backgrounds.
const THUMB_COLOR: Rgba<f32> = Rgba<f32> { r: 0.5, g: 0.5, b: 0.5, a: 0.6 }

/// Draws the overlay scrollbar thumbs of a scroll container over its content.
effect fn paintThumbs(
  p: &mut Painter,
  slot: u32,
  c: &Computed,
  f: &Fragment,
  mask: ContentMask,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &p.nodes.asSlice()[u32.toUsize(slot)]
  let vertical = thumbOf(c, f, node.scrollY, true)
  let horizontal = thumbOf(c, f, node.scrollX, false)
  run paintThumb(&mut p, vertical, mask)
  run paintThumb(&mut p, horizontal, mask)
}

effect fn paintThumb(p: &mut Painter, thumb: Thumb, mask: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !thumb.visible {
    return ()
  }
  let mut quad = Quad.fill(device(thumb.rect, p.scale), mask, Background.solid(THUMB_COLOR))
  quad.cornerRadii = Corners<f32>.uniform(3.0 * p.scale)
  drop run p.scene.quad(quad)
}

/// Paints every root fragment (the viewport and anything outside it) into `p.scene`.
pub effect fn paintRoots(p: &mut Painter, window: ContentMask) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = p.output.fragments.values.length()
  let mut index: usize = 0
  while index < count {
    if p.output.fragments.values.asSlice()[index].parent == NO_INDEX {
      run paintFragment(&mut p, index, window)
    }
    index = index + 1
  }
}

fn floatHash(h: u64, value: f32) -> u64 {
  return Hash.combine(h, u32.toU64(f32.toBits(value)))
}

fn kindIndex(kind: FragmentKind) -> u64 {
  return match kind {
    FragmentKind.Box => 1
    FragmentKind.Inline => 2
    FragmentKind.Text => 3
    FragmentKind.Line => 4
  }
}

/// The hash of everything fragment `index` paints from, not counting its descendants.
fn ownHash(
  seed: &HashSeed,
  output: &LayoutTree,
  slots: &List<u32>,
  css: &Tree,
  nodes: &List<Node>,
  index: usize,
) -> u64 {
  let f = output.fragments.values.asSlice()[index]
  let mut h = Hash.mix(seed, kindIndex(f.kind))
  h = Hash.combine(h, usize.toU64(f.source))
  h = floatHash(h, f.worldLocation.x)
  h = floatHash(h, f.worldLocation.y)
  h = floatHash(h, f.size.width)
  h = floatHash(h, f.size.height)
  h = floatHash(h, f.paddingRect.x)
  h = floatHash(h, f.paddingRect.y)
  h = floatHash(h, f.paddingRect.width)
  h = floatHash(h, f.paddingRect.height)
  h = floatHash(h, f.contentRect.x)
  h = floatHash(h, f.contentRect.y)
  h = floatHash(h, f.contentRect.width)
  h = floatHash(h, f.contentRect.height)
  h = floatHash(h, f.firstBaselines.alphabetic)
  h = Hash.combine(h, u8.toU64(f.decorationEdges))
  let mut flags: u64 = 0
  if f.first {
    flags = flags + 1
  }
  if f.last {
    flags = flags + 2
  }
  if f.nonpainting {
    flags = flags + 4
  }
  h = Hash.combine(h, flags)
  if f.textData != NO_INDEX {
    let t = output.fragments.texts.get(f.textData)
    h = Hash.combine(h, usize.toU64(t.shapeKey))
    h = Hash.combine(h, usize.toU64(t.fontKey))
    h = Hash.combine(h, usize.toU64(t.sourceStart))
    h = Hash.combine(h, usize.toU64(t.sourceEnd))
    h = Hash.combine(h, u8.toU64(t.bidiLevel))
  }
  let slot = styleSlot(slots, css, nodes, f.source)
  if slot != NONE {
    let node = &nodes.asSlice()[u32.toUsize(slot)]
    h = Hash.combine(h, node.paintHash)
    if f.kind == FragmentKind.Box {
      h = Hash.combine(h, node.content)
      h = Hash.combine(h, u32.toU64(node.resource))
      h = floatHash(h, node.scrollX)
      h = floatHash(h, node.scrollY)
    }
  }
  return h
}

/// Hashes every fragment's paint inputs together with its descendants', children before
/// parents (css-layout stores parents before their children).
pub effect fn hashFragments(
  seed: &HashSeed,
  output: &LayoutTree,
  slots: &List<u32>,
  css: &Tree,
  nodes: &List<Node>,
  out: &mut List<u64>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = output.fragments.values.length()
  out.clear()
  run out.appendRepeated(0, count)
  let mut index = count
  while index > 0 {
    index = index - 1
    let own = ownHash(seed, output, slots, css, nodes, index)
    let below = out.get(index)
    let combined = Hash.combine(own, below)
    out.set(index, combined)
    let parent = output.fragments.values.asSlice()[index].parent
    if parent != NO_INDEX {
      let previous = out.get(parent)
      out.set(parent, Hash.combine(previous, combined))
    }
  }
}
