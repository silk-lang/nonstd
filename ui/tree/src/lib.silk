  LISTEN_KEY_DOWN,
  LISTEN_KEY_UP,
  LISTEN_FOCUS,
  LISTEN_BLUR,
  LISTEN_INPUT,
  LISTEN_SCROLL,
  LISTEN_LAYOUT,
  LISTEN_ALL
}
