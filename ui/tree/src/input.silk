//! Input for the tree: plain-data pointer, wheel and key records a host feeds to
//! `UiTree.dispatch`, from a window, a test script or an inspector alike.
//!
//! Positions and wheel deltas are CSS pixels in the viewport. Keys use the names of UI Events:
//! `key` is what the key means on the layout (`"a"`, `"A"`, `"Enter"`, `"ArrowLeft"`, `"Tab"`),
//! `code` the physical key (`"KeyA"`, `"Enter"`). The ui-tree-window package turns
//! platform/window events into these.
import silk.text.string { String }

/// Modifier bits in [`Input`] and event records, as platform/window packs them.
pub const MOD_SHIFT: u32 = 1

pub const MOD_CONTROL: u32 = 2

pub const MOD_ALT: u32 = 4

/// Command on macOS, the Windows key elsewhere.
pub const MOD_META: u32 = 8

/// Pointer buttons, numbered as DOM `MouseEvent.button`.
pub const BUTTON_PRIMARY: u32 = 0

pub const BUTTON_AUXILIARY: u32 = 1

pub const BUTTON_SECONDARY: u32 = 2

pub const BUTTON_BACK: u32 = 3

pub const BUTTON_FORWARD: u32 = 4

/// One input record.
pub union Input {
  /// The pointer moved to (`x`, `y`).
  PointerMove { pub x: f32, pub y: f32, pub modifiers: u32 },
  /// A button went down. `clickCount` is 1 for a single click, 2 for a double click.
  PointerDown { pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32, pub clickCount: u32 },
  PointerUp { pub x: f32, pub y: f32, pub button: u32, pub modifiers: u32 },
  /// The pointer left the window: nothing is hovered any more.
  PointerLeave,
  /// The press ended without a release the tree should act on (the window lost focus, a
  /// system gesture took over): active states and pointer capture end, and no click follows.
  PointerCancel,
  /// A wheel or trackpad scroll at (`x`, `y`). Positive `deltaY` scrolls down (shows what is
  /// below), as DOM `WheelEvent.deltaY`.
  Wheel { pub x: f32, pub y: f32, pub deltaX: f32, pub deltaY: f32, pub modifiers: u32 },
  KeyDown { pub key: String, pub code: String, pub modifiers: u32, pub repeat: bool },
  KeyUp { pub key: String, pub code: String, pub modifiers: u32 },
}
