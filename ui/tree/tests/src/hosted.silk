//! Hosted nodes: placements follow layout, scrolling, clips, visibility and the scale.
import ui_fixtures.fixtures as fixtures
import ui_scene.primitives { SurfaceSprite }
import ui_scene.scene { Scene }
import ui_tree.lib {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  NodeKind,
  Property,
  Length,
  Overflow,
  Display,
  Side,
  Mutation,
  HostedPlacement,
  hostedPlacements,
  hostedPlacement,
  NONE
}
import silk.collections.list { List }
import silk.geometry.rect { Rect }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }

const ROOT: u32 = 1

const SCROLLER: u32 = 2

const PAGE: u32 = 3

const HIDDEN: u32 = 4

const FADED: u32 = 5

const FADED_PAGE: u32 = 6

const WEB_VIEW: u32 = 70

fn viewport(scale: f32) -> FrameInput {
  return FrameInput { width: 400.0, height: 300.0, scale: scale, time: 0.0 }
}

/// The surface sprites of every layer of `scene`.
effect fn surfaceSprites(scene: &Scene) -> List<SurfaceSprite>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<SurfaceSprite>.make()
  let mut layer: u32 = 0
  while layer < scene.layerCount() {
    run out.appendSlice(scene.surfaces(layer))
    layer = layer + 1
  }
  return move out
}

fn sameRect(r: Rect<f32>, x: f32, y: f32, w: f32, h: f32) -> bool {
  return r.xMin == x && r.yMin == y && r.xMax == x + w && r.yMax == y + h
}

/// A root with a 200x100 scroll box holding a hosted node with a 160x150 content box and 10px padding at
/// its top and left, a hosted node that is `display: none`, and one inside a transparent box.
effect fn build(tree: &mut UiTree) -> ()
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.create(ROOT, NodeKind.Box)
  run batch.root(ROOT)
  run batch.box(
    ROOT,
    SCROLLER,
    &[
      Property.Width { value: Length.px(200.0) },
      Property.Height { value: Length.px(100.0) },
      Property.Margin { side: Side.Left, value: Length.px(20.0) },
      Property.Margin { side: Side.Top, value: Length.px(30.0) },
      Property.OverflowY { value: Overflow.Scroll },
      Property.OverflowX { value: Overflow.Hidden },
    ],
  )
  run batch.create(PAGE, NodeKind.Hosted)
  run batch.style(
    PAGE,
    &[
      Property.Width { value: Length.px(160.0) },
      Property.Height { value: Length.px(150.0) },
      Property.Padding { side: Side.Left, value: Length.px(10.0) },
      Property.Padding { side: Side.Top, value: Length.px(10.0) },
    ],
  )
  run batch.hostedView(PAGE, WEB_VIEW)
  run batch.append(SCROLLER, PAGE)
  run batch.create(HIDDEN, NodeKind.Hosted)
  run batch.style(HIDDEN, &[Property.Display { value: Display.None }])
  run batch.append(ROOT, HIDDEN)
  run batch.box(ROOT, FADED, &[Property.Opacity { value: 0.0 }])
  run batch.create(FADED_PAGE, NodeKind.Hosted)
  run batch.style(FADED_PAGE, &[Property.Height { value: Length.px(40.0) }])
  run batch.append(FADED, FADED_PAGE)
  run tree.apply(run batch.take())
}

effect fn hostedBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  run build(&mut tree)
  run tree.frame(viewport(2.0))

  let mut placements = List<HostedPlacement>.make()
  run hostedPlacements(&tree, &mut placements)
  run Testing.expect(placements.length() == 3, "every hosted node has a placement")
  let page = hostedPlacement(&tree, PAGE)
  run Testing.expect(page.view == WEB_VIEW, "the placement names the host view")
  run Testing.expect(
    sameRect(page.bounds, 30.0, 40.0, 160.0, 150.0),
    "bounds are the content box in CSS pixels",
  )
  run Testing.expect(
    sameRect(page.clip, 30.0, 40.0, 160.0, 90.0),
    "the scroll box clips the bottom of the page",
  )
  run Testing.expect(page.visible && page.scale == 2.0, "the page shows, at the frame's scale")
  run Testing.expect(
    placements.get(0).id == PAGE,
    "placements come in paint order, unpainted nodes last",
  )

  // The scene draws the page as surface WEB_VIEW over its content box in device pixels, clipped
  // by the scroll box; nodes without a view draw nothing.
  let sprites = run surfaceSprites(tree.scene())
  run Testing.expect(sprites.length() == 1, "only the hosted node with a view draws a surface")
  let sprite = sprites.get(0)
  run Testing.expect(sprite.surface == WEB_VIEW, "the sprite draws the host view's surface")
  run Testing.expect(
    sameRect(sprite.bounds, 60.0, 80.0, 320.0, 300.0),
    "the sprite covers the content box in device pixels",
  )
  run Testing.expect(sprite.mask.bounds.yMax == 260.0, "the scroll box clips the sprite")

  let hidden = hostedPlacement(&tree, HIDDEN)
  run Testing.expect(!hidden.visible && hidden.view == NONE, "display none hides a hosted node")
  let faded = hostedPlacement(&tree, FADED_PAGE)
  run Testing.expect(!faded.visible, "a transparent ancestor hides a hosted node")
  let notHosted = hostedPlacement(&tree, SCROLLER)
  run Testing.expect(!notHosted.visible, "other kinds have no placement")

  // Scrolling moves the page up under the clip; the host sees a different placement.
  let mut scroll = Batch.make()
  run scroll.scrollTo(SCROLLER, 0.0, 40.0)
  run tree.apply(run scroll.take())
  run tree.frame(viewport(2.0))
  let scrolled = hostedPlacement(&tree, PAGE)
  run Testing.expect(
    sameRect(scrolled.bounds, 30.0, 0.0, 160.0, 150.0),
    "scrolling moves the bounds",
  )
  run Testing.expect(
    sameRect(scrolled.clip, 30.0, 30.0, 160.0, 100.0),
    "and the clip stays the scroll box",
  )
  run Testing.expect(scrolled.differs(&page), "the moved placement differs")

  // Removing the scroll box detaches the page.
  let mut remove = Batch.make()
  run remove.push(Mutation.Remove { id: SCROLLER })
  run tree.apply(run remove.take())
  run tree.frame(viewport(2.0))
  run Testing.expect(!hostedPlacement(&tree, PAGE).visible, "a detached hosted node is hidden")

  // Hosted nodes take no children and only they take a host view.
  let mut bad = Batch.make()
  run bad.hostedView(ROOT, 1)
  run Testing.expect(
    run Effect.catch<TreeError>(applied(&mut tree, run bad.take()), refused),
    "a box takes no host view",
  )
}

effect fn applied(tree: &mut UiTree, batch: List<Mutation>) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.apply(move batch)
  return false
}

effect fn refused(error: TreeError) -> bool {
  drop error
  return true
}

test effect fn hostedNodesReportWhereTheyAre() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hostedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
