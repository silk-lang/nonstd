    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inspectionBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Large glyphs can exceed an atlas page even though only a small viewport is visible.
// The vector path must remain bounded by that viewport rather than allocating the glyph bitmap.
effect fn oversizedGlyphBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.fontFamily(1, "Noto Sans")
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[Property.FontFamily { family: 1 }, Property.FontSize { value: 8192.0 }])
  run batch.text(1, 2, "A")
  run tree.apply(run batch.take())
  run tree.frame(FrameInput { width: 128.0, height: 128.0, scale: 1.0, time: 0.0 })

  // Even a fully clipped glyph must complete without an oversized-atlas error.
  run Testing.expect(tree.stats.glyphs == 1, "oversized glyph was painted")
  let mut small = Batch.make()
  run small.style(1, &[Property.FontSize { value: 300.0 }])
  run tree.apply(run small.take())
  run tree.frame(FrameInput { width: 400.0, height: 400.0, scale: 1.0, time: 0.0 })
  run Testing.expect(
    tree.scene().paths(0).length > 0,
    "large monochrome glyph uses vector coverage",
  )
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let pixels = run snapshot.render(&tree)
  run Testing.expect(
    pixels.width() == 400 && pixels.height() == 400,
    "snapshot remains viewport-sized",
  )
}

test effect fn oversizedGlyphsUseClippedVectorCoverage() -> ()
