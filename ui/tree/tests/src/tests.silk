//! Tree tests: replayed frames draw exactly what a full repaint draws, unchanged subtrees are
//! replayed rather than repainted, mutations fail on bad ids and kinds, text styles inherit,
//! focus moves queue event records, and the inspection queries find what they should.
//! Run from the repository root (the fixtures read fonts and icons from there).
import pagination
import vertical
import interaction
import editing
import ui_fixtures.fixtures as fixtures
import ui_tree.lib {
  UiTree,
  FragmentInfo,
  fragmentsOf,
  TreeError,
  Batch,
  FrameInput,
  FrameStats,
  CpuSnapshot,
  DescribeOptions,
  NodeInfo,
  NodeKind,
  Property,
  StyleState,
  Mutation,
  Event,
  EventKind,
  NONE,
  describe,
  describeNodeById,
  findAll,
  info
}
import ui_tree.mutation { LISTEN_FOCUS, LISTEN_BLUR, Length, Position, Side, Overflow }
import font_collection.lib { FontCollection }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
