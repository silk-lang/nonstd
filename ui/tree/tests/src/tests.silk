//! Tree tests: replayed frames draw exactly what a full repaint draws, unchanged subtrees are
//! replayed rather than repainted, mutations fail on bad ids and kinds, text styles inherit,
//! focus moves queue event records, and the inspection queries find what they should.
//! Run from the repository root (the fixtures read fonts and icons from there).
import ui_fixtures.fixtures as fixtures
import ui_tree.lib {
  UiTree,
  TreeError,
  Batch,
  FrameInput,
  FrameStats,
  CpuSnapshot,
  DescribeOptions,
  NodeInfo,
  NodeKind,
  Property,
  StyleState,
  Mutation,
  Event,
  EventKind,
  NONE,
  describe,
  describeNodeById,
  findAll,
  info
}
import ui_tree.mutation { LISTEN_FOCUS, LISTEN_BLUR }
import font_collection.lib { FontCollection }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

fn input() -> FrameInput {
  return FrameInput { width: 360.0, height: 470.0, scale: 1.0, time: 0.0 }
}

fn samePixels(a: &Pixmap, b: &Pixmap) -> bool {
  let x = a.data()
  let y = b.data()
  if a.width() != b.width() || a.height() != b.height() || x.length != y.length {
    return false
  }
  let mut i: usize = 0
  while i < x.length {
    if x[i] != y[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Draws a frame of `tree` and returns its pixels.
effect fn frame(tree: &mut UiTree, snapshot: &mut CpuSnapshot) -> Pixmap
  ! TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(input())
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

/// A fresh card list with `change` applied before its first frame.
effect fn freshCardList(collection: &FontCollection, change: List<Mutation>) -> Pixmap
  ! TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  run tree.apply(move change)
  let mut snapshot = CpuSnapshot.make()
  return run frame(&mut tree, &mut snapshot)
}

effect fn background(id: u32, hex: u32) -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.style(id, &[Property.BackgroundColor { color: fixtures.rgb(hex) }])
  return run batch.take()
}

effect fn replayBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  let first = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.replayedSubtrees == 0, "the first frame paints everything")
  run Testing.expect(!tree.stats.layoutSkipped, "the first frame lays out")
  let painted = tree.stats.paintedFragments

  // Nothing changed: the root's subtree is copied whole and layout is skipped.
  let second = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.layoutSkipped, "an unchanged frame skips layout")
  run Testing.expect(tree.stats.repaintedSubtrees == 0, "an unchanged frame repaints nothing")
  run Testing.expect(tree.stats.replayedSubtrees == 1, "an unchanged frame replays the root")
  run Testing.expect(tree.stats.paintedFragments < painted, "replayed fragments are not visited")
  run Testing.expect(samePixels(&first, &second), "a replayed frame draws the same pixels")

  // One card changes color: the root and that card are painted again, the other cards and
  // the card's own children are replayed.
  run tree.apply(run background(fixtures.CARD + 10, 0xfee2e2))
  let third = run frame(&mut tree, &mut snapshot)
  run Testing.expect(
    tree.stats.repaintedSubtrees == 2,
    "only the root and the changed card repaint",
  )
  run Testing.expect(tree.stats.replayedSubtrees >= 6, "siblings and the card's children replay")
  let expected = run freshCardList(&collection, run background(fixtures.CARD + 10, 0xfee2e2))
  run Testing.expect(
    samePixels(&third, &expected),
    "replay matches a full repaint after a style change",
  )

  // Two more frames: caches moved by replay keep working.
  let fourth = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.repaintedSubtrees == 0, "the frame after a change repaints nothing")
  run Testing.expect(samePixels(&third, &fourth), "and draws the same pixels")
  run tree.apply(run background(fixtures.CARD + 10, 0xffffff))
  let fifth = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.repaintedSubtrees == 2, "changing the card back repaints its path")
  run Testing.expect(samePixels(&first, &fifth), "and draws the first frame again")
}

test effect fn unchangedSubtreesAreReplayedNotRepainted() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replayBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn textChangeBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  drop run frame(&mut tree, &mut snapshot)
  let mut change = Batch.make()
  run change.setText(106, "A much shorter body.")
  run tree.apply(run change.take())
  let changed = run frame(&mut tree, &mut snapshot)
  run Testing.expect(!tree.stats.layoutSkipped, "a text change lays out again")
  let mut again = Batch.make()
  run again.setText(106, "A much shorter body.")
  let expected = run freshCardList(&collection, run again.take())
  run Testing.expect(
    samePixels(&changed, &expected),
    "replay matches a full repaint after a text change",
  )
}

test effect fn textChangesRelayoutAndMatchAFreshTree() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run textChangeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejects(tree: &mut UiTree, mutation: Mutation) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.push(move mutation)
  return run Effect.catch<TreeError>(applied(&mut tree, run batch.take()), refused)
}

effect fn applied(tree: &mut UiTree, batch: List<Mutation>) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  run tree.apply(move batch)
  return false
}

effect fn refused(error: TreeError) -> bool {
  drop error
  return true
}

effect fn mutationsBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.text(1, 2, "hello")
  run batch.box(1, 3, &[])
  run tree.apply(run batch.take())
  run Testing.expect(tree.nodeCount() == 3, "three nodes exist")
  run Testing.expect(
    run rejects(&mut tree, Mutation.Create { id: 2, kind: NodeKind.Box }),
    "ids are unique",
  )
  run Testing.expect(
    run rejects(&mut tree, Mutation.InsertBefore { parent: 2, child: 3, before: Option<u32>.None }),
    "text nodes have no children",
  )
  run Testing.expect(
    run rejects(&mut tree, Mutation.InsertBefore { parent: 3, child: 1, before: Option<u32>.None }),
    "the root does not move",
  )
  run Testing.expect(run rejects(&mut tree, Mutation.Remove { id: 9 }), "unknown ids fail")
  run Testing.expect(
    run rejects(&mut tree, Mutation.SetSource { id: 3, resource: 1 }),
    "only images and icons take a source",
  )
  run Testing.expect(
    !run rejects(
      &mut tree,
      Mutation.InsertBefore { parent: 1, child: 3, before: Option<u32>.Some { value: 2 } },
    ),
    "moving a child before its sibling works",
  )
  let mut children = List<u32>.make()
  run tree.childSlots(tree.slotOf(1), &mut children)
  run Testing.expect(
    children.length() == 2 && tree.node(children.get(0)).id == 3,
    "3 now comes first",
  )
  run Testing.expect(!run rejects(&mut tree, Mutation.Destroy { id: 3 }), "destroy works")
  run Testing.expect(tree.nodeCount() == 2 && !tree.contains(3), "destroyed ids are gone")
  run Testing.expect(
    !run rejects(&mut tree, Mutation.Create { id: 3, kind: NodeKind.Text }),
    "and can be used again",
  )
}

test effect fn badMutationsFailAndIdsCanBeReused() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mutationsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inheritanceBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.style(
    1,
    &[Property.FontSize { value: 20.0 }, Property.Color { color: fixtures.rgb(0xff0000) }],
  )
  run batch.root(1)
  run batch.box(1, 2, &[Property.FontWeight { value: 700.0 }])
  run batch.text(2, 3, "inherited")
  run batch.styleFor(2, StyleState.Focus, &[Property.Color { color: fixtures.rgb(0x0000ff) }])
  run tree.apply(run batch.take())
  run tree.frame(input())
  let inner = tree.node(tree.slotOf(2)).computed.text
  run Testing.expect(inner.size == 20.0 && inner.weight == 700.0, "size inherits, weight is set")
  run Testing.expect(inner.color.r == 1.0 && inner.color.b == 0.0, "color inherits")
  let mut focus = Batch.make()
  run focus.push(Mutation.Focus { id: 2 })
  run tree.apply(run focus.take())
  run tree.frame(input())
  let focused = tree.node(tree.slotOf(2)).computed.text
  run Testing.expect(focused.color.b == 1.0, "the focus variant applies while focused")
  let mut clear = Batch.make()
  run clear.push(Mutation.ClearStyle { id: 1, state: StyleState.Base })
  run clear.push(Mutation.Blur)
  run tree.apply(run clear.take())
  run tree.frame(input())
  let cleared = tree.node(tree.slotOf(2)).computed.text
  run Testing.expect(
    cleared.size == 16.0 && cleared.color.r == 0.0,
    "clearing the parent's style restores the initial values",
  )
}

test effect fn textStylesInheritAndVariantsApply() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inheritanceBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn eventsBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.form(&mut batch)
  run batch.push(Mutation.SetListeners { id: fixtures.EMAIL, flags: LISTEN_FOCUS + LISTEN_BLUR })
  run batch.push(Mutation.SetListeners { id: fixtures.PASSWORD, flags: LISTEN_FOCUS })
  run tree.apply(run batch.take())
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  run Testing.expect(events.length() == 0, "focus before listening queues nothing")
  let mut shift = Batch.make()
  run shift.push(Mutation.Focus { id: fixtures.PASSWORD })
  run tree.apply(run shift.take())
  run tree.takeEvents(&mut events)
  run Testing.expect(events.length() == 2, "a blur and a focus record")
  let blur = &events.asSlice()[0]
  run Testing.expect(
    blur.kind == EventKind.Blur && blur.target == fixtures.EMAIL,
    "the email field blurs first",
  )
  run Testing.expect(
    blur.path.length() == 2 && blur.path.get(0) == fixtures.FORM
      && blur.path.get(1) == fixtures.EMAIL,
    "the path runs from the root to the target",
  )
  let focus = &events.asSlice()[1]
  run Testing.expect(
    focus.kind == EventKind.Focus && focus.target == fixtures.PASSWORD,
    "then the password field focuses",
  )
}

test effect fn focusMovesQueueRecordsWithPaths() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run eventsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inspectionBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.form(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  drop run frame(&mut tree, &mut snapshot)
  let mut found = List<u32>.make()
  run findAll(&tree, "submit", &mut found)
  run Testing.expect(
    found.length() == 1 && found.get(0) == fixtures.SUBMIT,
    "findAll matches test ids",
  )
  run findAll(&tree, "Password", &mut found)
  run Testing.expect(
    found.length() == 2 && found.get(1) == fixtures.PASSWORD,
    "and labels after visible text",
  )
  let button = match run info(&tree, fixtures.SUBMIT) {
    Option<NodeInfo>.Some { value } => value
    Option<NodeInfo>.None => {
      run Testing.expect(false, "the button has info")
      return ()
    }
  }
  run Testing.expect(button.laidOut && button.parent == fixtures.FORM, "info knows the parent")
  run Testing.expect(
    button.bounds.xMin == 20.0 && button.bounds.xMax == 340.0,
    "and the border box",
  )
  run Testing.expect(button.paintIndex != NONE, "and the paint order")
  let pixels = run snapshot.renderNode(&mut tree, fixtures.SUBMIT)
  run Testing.expect(
    pixels.width() == 320 && pixels.height() == 38,
    "a node snapshot is cropped to its box",
  )
  let mut text = String.make()
  run describeNodeById(&tree, fixtures.SUBMIT, DescribeOptions.plain(), &mut text)
  let expected = "box #60 role=button testId=\"submit\" [20,247 320x38]\n  text #61 \"Sign in\" [154.74,256 50.52x20]\n"
  run Testing.expect(String.view(&text) == expected, "describe writes one line per node")
}

test effect fn inspectionFindsDescribesAndSnapshotsNodes() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run inspectionBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
