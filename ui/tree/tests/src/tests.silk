static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

effect fn testDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}

import silk.system.host_input { HostInputError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }
import silk.num.usize

fn input() -> FrameInput {
  return FrameInput { width: 360.0, height: 470.0, scale: 1.0, time: 0.0 }
}

fn samePixels(a: &Pixmap, b: &Pixmap) -> bool {
  let x = a.data()
  let y = b.data()
  if a.width() != b.width() || a.height() != b.height() || x.length != y.length {
    return false
  }
  let mut i: usize = 0
  while i < x.length {
    if x[i] != y[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// Draws a frame of `tree` and returns its pixels.
effect fn frame(tree: &mut UiTree, snapshot: &mut CpuSnapshot) -> Pixmap
  ! TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  run tree.frame(input())
  run snapshot.sync(&mut tree)
  return run snapshot.render(&tree)
}

/// A fresh card list with `change` applied before its first frame.
effect fn freshCardList(collection: &FontCollection, change: List<Mutation>) -> Pixmap
  ! TreeError | GeometryError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut tree = run UiTree.make(collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  run tree.apply(move change)
  let mut snapshot = CpuSnapshot.make()
  return run frame(&mut tree, &mut snapshot)
}

effect fn background(id: u32, hex: u32) -> List<Mutation>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut batch = Batch.make()
  run batch.style(id, &[Property.BackgroundColor { color: fixtures.rgb(hex) }])
  return run batch.take()
}

effect fn replayBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  let first = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.replayedSubtrees == 0, "the first frame paints everything")
  run Testing.expect(!tree.stats.layoutSkipped, "the first frame lays out")
  let painted = tree.stats.paintedFragments

  // Nothing changed: the root's subtree is copied whole and layout is skipped.
  let second = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.layoutSkipped, "an unchanged frame skips layout")
  run Testing.expect(tree.stats.repaintedSubtrees == 0, "an unchanged frame repaints nothing")
  run Testing.expect(tree.stats.replayedSubtrees == 1, "an unchanged frame replays the root")
  run Testing.expect(tree.stats.paintedFragments < painted, "replayed fragments are not visited")
  run Testing.expect(samePixels(&first, &second), "a replayed frame draws the same pixels")

  // One card changes color: the root and that card are painted again, the other cards and
  // the card's own children are replayed.
  run tree.apply(run background(fixtures.CARD + 10, 0xfee2e2))
  let third = run frame(&mut tree, &mut snapshot)
  run Testing.expect(
    tree.stats.repaintedSubtrees == 2,
    "only the root and the changed card repaint",
  )
  run Testing.expect(tree.stats.replayedSubtrees >= 6, "siblings and the card's children replay")
  let expected = run freshCardList(&collection, run background(fixtures.CARD + 10, 0xfee2e2))
  run Testing.expect(
    samePixels(&third, &expected),
    "replay matches a full repaint after a style change",
  )

  // Two more frames: caches moved by replay keep working.
  let fourth = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.repaintedSubtrees == 0, "the frame after a change repaints nothing")
  run Testing.expect(samePixels(&third, &fourth), "and draws the same pixels")
  run tree.apply(run background(fixtures.CARD + 10, 0xffffff))
  let fifth = run frame(&mut tree, &mut snapshot)
  run Testing.expect(tree.stats.repaintedSubtrees == 2, "changing the card back repaints its path")
  run Testing.expect(samePixels(&first, &fifth), "and draws the first frame again")
}

test effect fn unchangedSubtreesAreReplayedNotRepainted() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replayBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn textChangeBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.cardList(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  drop run frame(&mut tree, &mut snapshot)
  let mut change = Batch.make()
  run change.setText(106, "A much shorter body.")
  run tree.apply(run change.take())
  let changed = run frame(&mut tree, &mut snapshot)
  run Testing.expect(!tree.stats.layoutSkipped, "a text change lays out again")
  let mut again = Batch.make()
  run again.setText(106, "A much shorter body.")
  let expected = run freshCardList(&collection, run again.take())
  run Testing.expect(
    samePixels(&changed, &expected),
    "replay matches a full repaint after a text change",
  )
}

