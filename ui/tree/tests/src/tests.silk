effect fn scrollingFixture(batch: &mut Batch)
  ! OutOfMemoryError
  ? &mut Allocator {
  run batch.fontFamily(1, "Noto Sans")
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(
    1,
    &[
      Property.Width { value: Length.px(180.0) },
      Property.Height { value: Length.px(100.0) },
      Property.OverflowY { value: Overflow.Auto },
      Property.FontFamily { family: 1 },
      Property.FontSize { value: 24.0 },
    ],
  )
  run batch.box(1, 2, &[Property.Height { value: Length.px(400.0) }])
  run batch.text(
    2,
    3,
    "Áj Mixed text wraps across many lines. Descenders, accents and spaces must survive clipping and scrolling.",
  )
  run batch.box(1, 4, &[Property.Height { value: Length.px(400.0) }])
  run batch.text(
    4,
    5,
    "Áj Mixed text wraps across many lines. Descenders, accents and spaces must survive clipping and scrolling.",
  )
}

effect fn indexedScrollBody()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run scrollingFixture(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  drop run frame(&mut tree, &mut snapshot)
  let offsets: [f32; 4] = [50.25, 390.75, 440.0, 0.0]
  let mut step: usize = 0
  while step < 4 {
    let mut change = Batch.make()
    run change.scrollTo(1, 0.0, offsets[step])
    run tree.apply(run change.take())
    let actual = run frame(&mut tree, &mut snapshot)
    run Testing.expect(
      tree.stats.layout.fullLayouts == 0,
      "a scroll does not measure the document again",
    )
    let mut fresh = run UiTree.make(&fonts)
    let mut initial = Batch.make()
    run scrollingFixture(&mut initial)
    run fresh.apply(run initial.take())
    fresh.input = input()
    run fresh.layoutNow()
    let mut scroll = Batch.make()
    run scroll.scrollTo(1, 0.0, offsets[step])
    run fresh.apply(run scroll.take())
    fresh.output.invalidate()
    let mut reference = CpuSnapshot.make()
    let expected = run frame(&mut fresh, &mut reference)
    run Testing.expect(
      samePixels(&actual, &expected),
      "warm text ink bounds and scroll positions match a cold render",
    )
    let mut id: u32 = 1
    while id <= 5 {
      let slot = tree.slotOf(id)
      let css = tree.node(slot).css
      let inner = tree.node(slot).inner
      let mut indexed = List<FragmentInfo>.make()
      run fragmentsOf(&tree, slot, &mut indexed)
      let mut index: usize = 0
      let mut count: usize = 0
      while index < tree.output.fragments.values.length() {
        let f = tree.output.fragments.values.get(index)
        if (f.source == css || inner < tree.layout.nodes.length() && f.source == inner)
          && !f.positioningShell {
          run Testing.expect(
            count < indexed.length() && indexed.get(count).index == index,
            "fragment index preserves complete arena ordering",
          )
          count = count + 1
        }
        index = index + 1
      }
      run Testing.expect(
        count == indexed.length(),
        "fragment index contains every source fragment exactly once",
      )
      let mut expectedOrder = NONE
      let mut order: usize = 0
      while order < tree.paintOrder.length() {
        if tree.paintOrder.get(order) == id {
          expectedOrder = usize.toU32(order)
          break
        }
        order = order + 1
      }
      if let Option<NodeInfo>.Some { value } = run info(&tree, id) {
        run Testing.expect(
          value.paintIndex == expectedOrder,
          "indexed paint order agrees with the published order",
        )
      } else {
        run Testing.expect(false, "live nodes remain inspectable")
      }

      id = id + 1
    }
    step = step + 1
  }
}

test effect fn scrollReuseAndIndexedInspectionMatchFreshOutput()
  ! AssertionError<'static> | TreeError | GeometryError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run indexedScrollBody() |> Effect.provideMut<Allocator>(&mut allocator)
}
