effect fn eventsBody() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.form(&mut batch)
  run batch.push(Mutation.SetListeners { id: fixtures.EMAIL, flags: LISTEN_FOCUS + LISTEN_BLUR })
  run batch.push(Mutation.SetListeners { id: fixtures.PASSWORD, flags: LISTEN_FOCUS })
  run tree.apply(run batch.take())
  let mut events = List<Event>.make()
  run tree.takeEvents(&mut events)
  run Testing.expect(events.length() == 0, "focus before listening queues nothing")
  let mut shift = Batch.make()
  run shift.push(Mutation.Focus { id: fixtures.PASSWORD })
  run tree.apply(run shift.take())
  run tree.takeEvents(&mut events)
  run Testing.expect(events.length() == 2, "a blur and a focus record")
  let blur = &events.asSlice()[0]
  run Testing.expect(
    blur.kind == EventKind.Blur && blur.target == fixtures.EMAIL,
    "the email field blurs first",
  )
  run Testing.expect(
    blur.path.length() == 2 && blur.path.get(0) == fixtures.FORM
      && blur.path.get(1) == fixtures.EMAIL,
    "the path runs from the root to the target",
  )
  let focus = &events.asSlice()[1]
  run Testing.expect(
    focus.kind == EventKind.Focus && focus.target == fixtures.PASSWORD,
    "then the password field focuses",
  )
}

test effect fn focusMovesQueueRecordsWithPaths() -> ()
  ! AssertionError<'static> | TreeError | FileError | HostInputError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run eventsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inspectionBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run fixtures.form(&mut batch)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  drop run frame(&mut tree, &mut snapshot)
  let mut found = List<u32>.make()
  run findAll(&tree, "submit", &mut found)
  run Testing.expect(
    found.length() == 1 && found.get(0) == fixtures.SUBMIT,
    "findAll matches test ids",
  )
  run findAll(&tree, "Password", &mut found)
  run Testing.expect(
    found.length() == 2 && found.get(1) == fixtures.PASSWORD,
    "and labels after visible text",
  )
  let button = match run info(&tree, fixtures.SUBMIT) {
    Option<NodeInfo>.Some { value } => value
    Option<NodeInfo>.None => {
      run Testing.expect(false, "the button has info")
      return ()
    }
  }
  run Testing.expect(button.laidOut && button.parent == fixtures.FORM, "info knows the parent")
  run Testing.expect(
    button.bounds.xMin == 20.0 && button.bounds.xMax == 340.0,
    "and the border box",
  )
  run Testing.expect(button.paintIndex != NONE, "and the paint order")
  let pixels = run snapshot.renderNode(&mut tree, fixtures.SUBMIT)
  run Testing.expect(
    pixels.width() == 320 && pixels.height() == 38,
    "a node snapshot is cropped to its box",
  )
  let mut text = String.make()
  run describeNodeById(&tree, fixtures.SUBMIT, DescribeOptions.plain(), &mut text)
  let expected = "box #60 role=button testId=\"submit\" [20,247 320x38]\n  text #61 \"Sign in\" [154.74,256 50.52x20]\n"
  run Testing.expect(String.view(&text) == expected, "describe writes one line per node")
}

