  run oversizedGlyphBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A modal's backdrop must filter earlier siblings, stay clipped to its box, and
// observe changes beneath it even when the modal subtree itself is replayed.
effect fn backdropBody() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.style(1, &[Property.BackgroundColor { color: fixtures.rgb(0xffffff) }])
  run batch.box(
    1,
    2,
    &[
      Property.Width { value: Length.px(40.0) },
      Property.Height { value: Length.px(64.0) },
      Property.BackgroundColor { color: fixtures.rgb(0x000000) },
    ],
  )
  run batch.box(
    1,
    3,
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset { side: Side.Left, value: Length.px(20.0) },
      Property.Inset { side: Side.Top, value: Length.px(20.0) },
      Property.Width { value: Length.px(40.0) },
      Property.Height { value: Length.px(40.0) },
      Property.BackdropBlur { value: 4.0 },
    ],
  )
  run tree.apply(run batch.take())
  let viewport = FrameInput { width: 64.0, height: 64.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  let mut snapshot = CpuSnapshot.make()
  run snapshot.sync(&mut tree)
  let first = run snapshot.render(&tree)
  let edge: usize = (32 * 64 + 39) * 4
  run Testing.expect(
    first.data()[edge] > 20 && first.data()[edge] < 230,
    "backdrop softens an earlier sibling's edge",
  )
  run Testing.expect(first.data()[(10 * 64 + 39) * 4] == 0, "backdrop is clipped to its border box")
  run tree.frame(viewport)
  run snapshot.sync(&mut tree)
  let replayed = run snapshot.render(&tree)
  run Testing.expect(samePixels(&first, &replayed), "replayed blur produces identical pixels")
  run tree.apply(run background(2, 0xff0000))
  run tree.frame(viewport)
  run snapshot.sync(&mut tree)
  let changed = run snapshot.render(&tree)
  run Testing.expect(
    changed.data()[edge] > first.data()[edge],
    "replayed backdrop observes changed earlier siblings",
  )
}

test effect fn backdropBlurClipsAndReplays() -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run backdropBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn variableWeightBody(
  size: f32,
  firstWeight: f32,
  firstText: string,
  nextWeight: f32,
  nextText: string,
) -> ()
  ! AssertionError<'static>
    | TreeError
    | GeometryError
    | FileError
    | HostInputError
    | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run testDirectory()
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  let root = run Path.root()
  let path = run Path.resolve(&root, "images/svg/tests/fonts/RobotoFlex.subset.ttf")
  let bytes = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let mut collection = FontCollection.make()
  drop run collection.add(move bytes)
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.create(1, NodeKind.Box)
  run batch.root(1)
  run batch.fontFamily(1, "Roboto Flex")
  run batch.style(
    1,
    &[
      Property.FontFamily { family: 1 },
      Property.FontSize { value: size },
      Property.FontWeight { value: firstWeight },
    ],
  )
  run batch.text(1, 2, firstText)
  run tree.apply(run batch.take())
  let mut snapshot = CpuSnapshot.make()
  let regular = run frame(&mut tree, &mut snapshot)
  let mut change = Batch.make()
  run change.style(1, &[Property.FontWeight { value: nextWeight }])
  run change.setText(2, nextText)
  run tree.apply(run change.take())
  let bold = run frame(&mut tree, &mut snapshot)
  run Testing.expect(!samePixels(&regular, &bold), "changing variable weight changes the pixels")
  let mut fresh = run UiTree.make(&collection)
  let mut initial = Batch.make()
  run initial.create(1, NodeKind.Box)
  run initial.root(1)
  run initial.fontFamily(1, "Roboto Flex")
  run initial.style(
    1,
    &[
      Property.FontFamily { family: 1 },
      Property.FontSize { value: size },
      Property.FontWeight { value: nextWeight },
    ],
  )
  run initial.text(1, 2, nextText)
  run fresh.apply(run initial.take())
  let mut freshSnapshot = CpuSnapshot.make()
  let expected = run frame(&mut fresh, &mut freshSnapshot)
  run Testing.expect(
    samePixels(&bold, &expected),
    "previously cached glyphs cannot leak into a different variable-font instance",
  )
}

