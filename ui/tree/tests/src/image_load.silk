//! Deterministic stale-result handling for native and browser image hosts.
import ui_tree.image_load { ImageLoad, ImageState, ImageError }
import silk.testing.testing { Testing, AssertionError }

test effect fn replacementRejectsStaleCompletion() -> ()
  ! AssertionError<'static> {
  let mut load = ImageLoad.make(7)
  let old = load.begin()
  let current = load.begin()
  run Testing.expect(!load.finish(old, ImageError.None), "an older request cannot publish pixels")
  run Testing.expect(
    load.state == ImageState.Loading && load.accepts(current),
    "replacement remains pending",
  )
  run Testing.expect(load.finish(current, ImageError.None), "current completion is accepted")
  run Testing.expect(
    !load.finish(current, ImageError.Decode) && load.state == ImageState.Ready,
    "a duplicate completion cannot overwrite success",
  )
  let cancelled = load.begin()
  load.cancel()
  run Testing.expect(
    !load.accepts(cancelled) && load.state == ImageState.Cancelled,
    "cancellation invalidates the token before a worker completes",
  )
}
