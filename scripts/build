#!/usr/bin/env python3
"""Build every workspace package, including its native prerequisites, without running it."""
import argparse
import os
from pathlib import Path
import platform
import runpy
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
GPU_SCRIPTS = ROOT / "gpu/webgpu/scripts"
sys.path.insert(0, str(GPU_SCRIPTS))
from _build import build as build_webgpu, command_path


METAL = {"gpu-metal", "gpu-metal-examples-compute", "gpu-metal-examples-headless-render"}
WEBGPU = {
    "gpu-webgpu-tests-native",
    "gpu-webgpu-examples",
    "gpu-webgpu-examples-window",
    "gpu-webgpu-bench",
    "images-svg-gpu-scene-tests",
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--release", action="store_true", help="Build optimized artifacts")
    args = parser.parse_args()
    if platform.system() != "Darwin":
        parser.error("The full workspace includes Metal and requires macOS. Use the area-specific build helpers on other platforms.")

    workspace = tomllib.loads((ROOT / "silk.toml").read_text())["workspace"]
    packages = {}
    for member in workspace["members"]:
        directory = ROOT / member
        package = tomllib.loads((directory / "silk.toml").read_text())["package"]
        packages[package["name"]] = directory

    compiler_bin = command_path("install-silk")
    clang = command_path("install-llvm")
    compiler = compiler_bin / "silkc"
    env = dict(os.environ, SILK_CLANG=str(clang))
    command = [str(compiler), "build", "--manifest-path", str(ROOT / "silk.toml"),
               "--stdlib", str(compiler_bin.parent / "lib/silk/stdlib"), "--clang", str(clang)]
    if args.release:
        command.append("--release")
    for name in packages:
        if name not in METAL | WEBGPU:
            command.extend(["--package", name])
    subprocess.run(command, cwd=ROOT, env=env, check=True)

    subprocess.run(["make", "-C", str(ROOT / "gpu/metal"), "all", "examples",
                    f"SILK={compiler}", f"SILK_BUILD_FLAGS={'--release' if args.release else ''}"],
                   env=env, check=True)

    for name, directory in packages.items():
        if name not in WEBGPU:
            continue
        if name == "gpu-webgpu-examples-window":
            command = [sys.executable, str(GPU_SCRIPTS / "window"), "--build-only"]
            if args.release:
                command.append("--release")
            subprocess.run(command, cwd=ROOT, env=env, check=True)
        elif name == "gpu-webgpu-bench":
            benchmark = runpy.run_path(str(GPU_SCRIPTS / "bench"))
            print(benchmark["build"](silk_only=True, release=args.release), flush=True)
        else:
            print(build_webgpu(directory, release=args.release), flush=True)
    print(f"Built all {len(packages)} workspace packages ({'release' if args.release else 'debug'}).")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
