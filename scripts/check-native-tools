#!/usr/bin/env python3
"""Exercise native CLI paths, Unicode filenames, SVG resources, fonts and PNG output."""
from pathlib import Path
import os
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "native/gpu/webgpu/tests/pixels"))
from harness import png_bytes, read_png
sys.path.insert(0, str(ROOT / "scripts"))
from _install import target

suffix = ".exe" if os.name == "nt" else ""
bin_dir = ROOT / "build/llvm" / target() / "debug"


def run(name, *args, **kwargs):
    return subprocess.run([str(bin_dir / (name + suffix)), *map(str, args)],
                          capture_output=True, check=True, timeout=120, **kwargs).stdout


with tempfile.TemporaryDirectory(prefix="native ü space ", dir=ROOT / "build") as directory:
    root = Path(directory)
    pixels = bytes([255, 0, 0, 255]) * 4
    (root / "pixel.png").write_bytes(png_bytes(pixels, 2, 2))
    source = root / "input ü.svg"
    source.write_text('<svg xmlns="http://www.w3.org/2000/svg" width="2" height="2">'
                      '<image href="pixel.png" width="2" height="2"/></svg>', encoding="utf-8")
    for name, argument in (("absolute", source), ("relative", source.relative_to(ROOT))):
        output = root / (name + " ü.png")
        run("svg-cli", argument, "-o", output, cwd=ROOT)
        assert read_png(output) == (2, 2, pixels), name
    xml = root / "document ü.xml"
    xml.write_text("<root/>", encoding="utf-8")
    assert run("text-xml-conformance", xml).split() == [b"OK"]
    font = next((ROOT / "svg/tests/fonts").glob("*.ttf"))
    absolute = run("font-parse-dump", font, cwd=ROOT)
    relative = run("font-parse-dump", font.relative_to(ROOT), cwd=ROOT)
    assert absolute and absolute == relative
    text = root / "text ü.txt"
    text.write_text("Hello", encoding="utf-8")
    shaped = run("font-shape-cli", font, "Hello", cwd=ROOT)
    assert shaped.strip()
    for font_path, text_path in ((font, text),
                                 (font.relative_to(ROOT), text.relative_to(ROOT))):
        assert run("font-shape-cli", font_path, f"--text-file={text_path}", cwd=ROOT) == shaped
    assert b"Julia" in run("greet", "--name", "Julia", "--times", "2")
print("PASS native CLI paths, Unicode filenames, local SVG images, PNG pixels, XML and font loading")
