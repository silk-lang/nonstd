#!/usr/bin/env node
import { mkdirSync, openSync, closeSync, readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { spawnSync } from 'node:child_process';
import { root } from './internal.mjs';
import { section, stringArray, stringField, text } from './manifest.mjs';

const requested = [];
for (let i = 2; i < process.argv.length; i++) {
  if (process.argv[i] !== '--package' || !process.argv[i + 1]) throw new Error('Usage: node scripts/check [--package NAME ...]');
  requested.push(process.argv[++i]);
}
const members = stringArray(section(text(join(root, 'silk.toml')), 'workspace'), 'members');
const output = join(root, 'build/test-results');
mkdirSync(output, { recursive: true });
const results = [];
const environment = { ...process.env };
if (process.platform === 'win32') {
  const metadata = join(root, '.cache/windows-runtime.json');
  if (!existsSync(metadata)) throw new Error('Run pwsh -File scripts/prepare-windows.ps1 before Windows tests');
  const paths = JSON.parse(readFileSync(metadata, 'utf8'));
  if (!Array.isArray(paths) || paths.some(path => typeof path !== 'string' || !existsSync(path))) throw new Error('Windows runtime paths are stale; rerun scripts/prepare-windows.ps1');
  // Environment keys are case-insensitive on Windows; avoid passing both Path and PATH.
  const pathKey = Object.keys(environment).find(key => key.toLowerCase() === 'path') ?? 'PATH';
  environment[pathKey] = [...paths, environment[pathKey] ?? ''].join(';');
}
for (const member of members) {
  const manifest = join(root, member, 'silk.toml');
  const name = stringField(section(text(manifest), 'package'), 'name');
  if (requested.length && !requested.includes(name)) continue;
  if (!existsSync(join(root, member, 'src/tests.silk'))) continue;
  console.log(`Testing ${name}`);
  const log = join(output, `${name}.log`);
  const fd = openSync(log, 'w');
  let result;
  try { result = spawnSync(process.env.SILK || 'silk', ['test', '--manifest-path', manifest, '--root', 'src/tests.silk'], { cwd: root, env: environment, stdio: ['ignore', fd, fd] }); }
  finally { closeSync(fd); }
  if (result.error) throw result.error;
  results.push({ package: name, returncode: result.status ?? 1 });
  console.log(`  ${result.status === 0 ? 'PASS' : 'FAIL'} (${log})`);
  if (result.status !== 0) console.log(readFileSync(log, 'utf8').split('\n').slice(-60).join('\n'));
}
if (!results.length) throw new Error('No matching package has src/tests.silk');
for (const name of requested) if (!results.some(result => result.package === name)) throw new Error(`No test root for ${name}`);
writeFileSync(join(output, 'summary.json'), JSON.stringify(results, null, 2) + '\n');
process.exitCode = Number(results.some(result => result.returncode !== 0));
