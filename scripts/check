#!/usr/bin/env python3
"""Run every workspace package's unit-test root on the native host."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "gpu/webgpu/scripts"))
from _build import command_path, executable


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package", action="append", help="Only test this package (repeatable)")
    args = parser.parse_args()
    compiler_bin = command_path("install-silk")
    clang = command_path("install-llvm")
    env = dict(os.environ, SILK_CLANG=str(clang), PYTHONUTF8="1")
    workspace = tomllib.loads((ROOT / "silk.toml").read_text(encoding="utf-8"))["workspace"]
    results = []
    output = ROOT / "build/test-results"
    output.mkdir(parents=True, exist_ok=True)
    for member in workspace["members"]:
        directory = ROOT / member
        package = tomllib.loads((directory / "silk.toml").read_text(encoding="utf-8"))["package"]
        name = package["name"]
        if args.package and name not in args.package:
            continue
        if not (directory / "src/tests.silk").is_file():
            continue
        print(f"Testing {name}", flush=True)
        command = [str(compiler_bin / executable("silkc")), "test", "--manifest-path",
                   str(directory / "silk.toml"), "--root", "src/tests.silk",
                   "--stdlib", str(compiler_bin.parent / "lib/silk/stdlib"), "--clang", str(clang)]
        with (output / f"{name}.log").open("w", encoding="utf-8") as log:
            result = subprocess.run(command, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT)
        results.append({"package": name, "returncode": result.returncode})
        print(f"  {'PASS' if result.returncode == 0 else 'FAIL'} ({output / (name + '.log')})", flush=True)
        if result.returncode != 0:
            # The end of a failed package's log, so the job output shows why.
            lines = (output / f"{name}.log").read_text(encoding="utf-8", errors="replace").splitlines()
            print("\n".join("    " + line for line in lines[-60:]), flush=True)
    if not results:
        parser.error("No matching package has src/tests.silk")
    (output / "summary.json").write_text(json.dumps(results, indent=2) + "\n", encoding="utf-8")
    return int(any(r["returncode"] != 0 for r in results))


if __name__ == "__main__":
    raise SystemExit(main())
