#!/usr/bin/env python3
"""Install the published native compiler locally; print its absolute bin directory."""
import json
from _install import CACHE, LOCK, asset_for, digest, download, fail, install

native, asset = asset_for("silk")
version = LOCK["silk"]["version"]
seed = json.loads(download(LOCK["silk"]["native_seed"]).read_text())
# dev.45 and dev.46 pinned only the x86-64 Linux seed. A target missing from
# the seed relies on the pinned archive checksum alone.
entry = seed["seeds"].get(native)
if entry is not None and (entry["tag"] != "v" + version or entry["target"] != native):
    fail("native-seed.json does not describe the pinned compiler")
executable = "bin/silkc.exe" if "windows" in native else "bin/silkc"
home = install("silk", CACHE / "silk" / version / native, executable)
if entry is not None and digest(home / executable) != entry["sha256"]:
    fail(f"Native compiler checksum differs from published native-seed.json: {home}")
print(home / "bin")
