#!/usr/bin/env python3
"""Regenerate the package index in README.md from silk.toml and layers.toml.

A workspace member with a `description` is a library; every other member is a helper
(tests, benchmarks, tools, demos) of the nearest library above its directory.
"""
import argparse
from pathlib import Path
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
BEGIN = "<!-- package-index:begin (generated by scripts/readme-index) -->"
END = "<!-- package-index:end -->"


def load(path):
    return tomllib.loads(path.read_text(encoding="utf-8"))


def render():
    config = load(ROOT / "layers.toml")
    excluded = config.get("excluded", {})
    members = sorted(set(load(ROOT / "silk.toml")["workspace"]["members"]) | set(excluded))
    layers = config["layer"]
    prefixes = sorted(((p, layer["name"]) for layer in layers for p in layer["paths"]),
                      key=lambda item: len(item[0]), reverse=True)

    def layer_of(path):
        for prefix, name in prefixes:
            if path == prefix or path.startswith(prefix + "/"):
                return name
        return "unassigned"

    packages = {m: load(ROOT / m / "silk.toml")["package"] for m in members}
    libraries = sorted(m for m, p in packages.items() if p.get("description"))
    helpers = {lib: [] for lib in libraries}
    loose = []
    for member in sorted(members):
        if member in helpers:
            continue
        owner = max((lib for lib in libraries if member.startswith(lib + "/")), key=len, default=None)
        (helpers[owner] if owner else loose).append(member)

    lines = [BEGIN, ""]
    order = [layer["name"] for layer in sorted(layers, key=lambda layer: layer["rank"])]
    for name in order + ["unassigned"]:
        rows = [lib for lib in libraries if layer_of(lib) == name]
        rows_loose = [m for m in loose if layer_of(m) == name]
        if not rows and not rows_loose:
            continue
        lines += [f"### {name}", "", "| Path | Package | What it is | Helpers |", "| --- | --- | --- | --- |"]
        for lib in rows:
            own = ", ".join(f"`{h[len(lib) + 1:]}`" for h in helpers[lib])
            note = " (not a workspace member, see layers.toml)" if lib in excluded else ""
            lines.append(f"| [`{lib}`]({lib}) | `{packages[lib]['name']}` | {packages[lib]['description']}{note} | {own} |")
        for member in rows_loose:
            lines.append(f"| [`{member}`]({member}) | `{packages[member]['name']}` | | |")
        lines.append("")
    lines.append(END)
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Fail if README.md is out of date")
    args = parser.parse_args()
    readme = ROOT / "README.md"
    text = readme.read_text(encoding="utf-8")
    start, stop = text.index(BEGIN), text.index(END) + len(END)
    updated = text[:start] + render() + text[stop:]
    if args.check:
        if updated != text:
            print("README.md package index is out of date; run scripts/readme-index", file=sys.stderr)
            return 1
        return 0
    readme.write_text(updated, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
