#!/usr/bin/env node
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { root } from './internal.mjs';
import { workspace } from './workspace.mjs';

const begin = '<!-- package-index:begin (generated by scripts/readme-index) -->';
const end = '<!-- package-index:end -->';
const { packages, layers, layerOf, excluded } = workspace();
const lines = [begin, ''];
for (const layer of layers.sort((a, b) => a.rank - b.rank)) {
  lines.push(`### ${layer.name}`, '', '| Path | Package | Purpose |', '| --- | --- | --- |');
  for (const entry of packages.filter(entry => layerOf(entry.path)?.name === layer.name).sort((a, b) => a.path.localeCompare(b.path))) {
    const note = excluded.has(entry.path) ? ' (excluded from the root workspace; see layers.toml)' : '';
    lines.push(`| [\`${entry.path}\`](${entry.path}) | \`${entry.name}\` | ${entry.description ?? ''}${note} |`);
  }
  lines.push('');
}
lines.push(end);
const file = join(root, 'README.md');
const before = readFileSync(file, 'utf8');
const start = before.indexOf(begin), stop = before.indexOf(end);
if (start < 0 || stop < start) throw new Error('README package-index markers missing');
const after = before.slice(0, start) + lines.join('\n') + before.slice(stop + end.length);
if (process.argv.slice(2).some(arg => arg !== '--check')) throw new Error('Usage: node scripts/readme-index [--check]');
if (process.argv.includes('--check')) {
  if (after !== before) throw new Error('README package index is stale; run node scripts/readme-index');
} else writeFileSync(file, after);
