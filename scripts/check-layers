#!/usr/bin/env python3
"""Check that every package depends only on its own layer or lower ones (see layers.toml)."""
import argparse
from pathlib import Path, PurePosixPath
import posixpath
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent


def load_layers():
    data = tomllib.loads((ROOT / "layers.toml").read_text(encoding="utf-8"))
    prefixes = []
    for layer in data["layer"]:
        for path in layer["paths"]:
            prefixes.append((path, layer["name"], layer["rank"]))
    prefixes.sort(key=lambda item: len(item[0]), reverse=True)
    return prefixes


def layer_of(path, prefixes):
    for prefix, name, rank in prefixes:
        if path == prefix or path.startswith(prefix + "/"):
            return name, rank
    return None


def packages():
    members = tomllib.loads((ROOT / "silk.toml").read_text(encoding="utf-8"))["workspace"]["members"]
    for member in members:
        manifest = tomllib.loads((ROOT / member / "silk.toml").read_text(encoding="utf-8"))
        deps = []
        for entry in manifest.get("dependencies", {}).values():
            if isinstance(entry, dict) and "path" in entry and "git" not in entry:
                deps.append(posixpath.normpath(posixpath.join(member, entry["path"])))
        yield member, deps


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--report-only", action="store_true",
                        help="Print violations but exit 0")
    args = parser.parse_args()
    prefixes = load_layers()
    problems = []
    for member, deps in packages():
        own = layer_of(member, prefixes)
        if own is None:
            problems.append(f"{member}: not in any layer of layers.toml")
            continue
        for dep in deps:
            other = layer_of(dep, prefixes)
            if other is None:
                problems.append(f"{member} -> {dep}: dependency is not in any layer")
            elif other[0] != own[0] and other[1] >= own[1]:
                problems.append(f"{member} ({own[0]}) -> {dep} ({other[0]}): "
                                "depends on a layer that is not lower")
    for problem in problems:
        print(problem)
    print(f"{len(problems)} layer violation(s)")
    return 0 if args.report_only or not problems else 1


if __name__ == "__main__":
    raise SystemExit(main())
