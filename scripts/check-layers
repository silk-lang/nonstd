#!/usr/bin/env node
import { existsSync } from 'node:fs';
import { dirname, isAbsolute, join, relative, resolve } from 'node:path';
import { root } from './internal.mjs';
import { dependencies, section, stringField, text } from './manifest.mjs';
import { repositoryPins, repositoryRoot, repositories } from './dependency-root.mjs';
import { workspace } from './workspace.mjs';

if (process.argv.length !== 2) throw new Error('Usage: node scripts/check-layers');
const { excluded, members, packages, layerOf } = workspace();
const listed = new Set([...members, ...excluded.keys()]);
if (members.length !== new Set(members).size) throw new Error('Duplicate workspace members');
for (const member of members) if (excluded.has(member)) throw new Error(`${member}: both included and excluded`);
for (const entry of packages) if (!listed.delete(entry.path)) throw new Error(`${entry.path}: unlisted retained package`);
if (listed.size) throw new Error(`Missing or obsolete workspace packages: ${[...listed].join(', ')}`);
const pins = repositoryPins();
const visited = new Set();
const named = new Map();
function visit(manifest, ownerRoot, local) {
  if (visited.has(manifest)) return;
  visited.add(manifest);
  const source = text(manifest);
  const name = stringField(section(source, 'package'), 'name');
  if (!name) throw new Error(`${manifest}: missing package name`);
  if (named.has(name) && named.get(name) !== manifest) throw new Error(`Duplicate physical package ${name}: ${named.get(name)} and ${manifest}`);
  named.set(name, manifest);
  const member = relative(root, dirname(manifest)).replaceAll('\\', '/');
  const ownLayer = local ? layerOf(member) : null;
  if (local && !ownLayer) throw new Error(`${member}: not assigned a layer`);
  for (const dep of dependencies(source)) {
    let destination, destinationRoot, destinationLocal;
    if (dep.git) {
      const repo = dep.git.match(/^https:\/\/github\.com\/silk-lang\/(lib-[a-z]+)\.git$/)?.[1];
      if (!repositories.includes(repo) || !/^[0-9a-f]{40}$/.test(dep.rev ?? '') || !dep.path || !dep.package) throw new Error(`${manifest}: noncanonical Git dependency ${dep.alias}`);
      if (pins.get(repo) !== dep.rev) throw new Error(`${manifest}: ${repo}@${dep.rev} disagrees with retained pin ${pins.get(repo)}`);
      destinationRoot = repositoryRoot(repo);
      destination = resolve(destinationRoot, dep.path, 'silk.toml');
      destinationLocal = false;
    } else {
      if (!dep.path) throw new Error(`${manifest}: dependency ${dep.alias} is not an explicit path or Git dependency`);
      destinationRoot = ownerRoot;
      destination = resolve(dirname(manifest), dep.path, 'silk.toml');
      destinationLocal = local;
    }
    const within = relative(destinationRoot, destination);
    if (within.startsWith('..') || isAbsolute(within)) throw new Error(`${manifest}: dependency ${dep.alias} escapes its repository`);
    if (!existsSync(destination)) throw new Error(`${manifest}: missing ${destination}`);
    if (destinationLocal) {
      const path = relative(root, dirname(destination)).replaceAll('\\', '/');
      const other = layerOf(path);
      if (!other || (other.name !== ownLayer.name && other.rank >= ownLayer.rank)) throw new Error(`${member} -> ${path}: obsolete path or upward layer dependency`);
    }
    if (dep.package && stringField(section(text(destination), 'package'), 'name') !== dep.package) throw new Error(`${manifest}: package mismatch for ${dep.alias}`);
    visit(destination, destinationRoot, destinationLocal);
  }
}
for (const entry of packages) visit(entry.manifest, root, true);
console.log(`Checked ${packages.length} retained packages, ${visited.size} reachable packages, and ${pins.size} coherent repository pins`);
