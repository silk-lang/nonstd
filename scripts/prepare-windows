#!/usr/bin/env python3
"""Prepare the Windows natives that a manifest cannot describe, then point Silk at them.

Dawn's Windows archive is a static library built against the dynamic MSVC CRT, and Silk's entry
point does not start the C runtime, so Dawn is wrapped in a DLL first (native/gpu/webgpu/core/scripts/_build.py
windows_dawn). GLFW's Windows release is a zip, which Silk does not extract. native/platform/window's
Win32 bridge and db/sqlite's SQLite build need the Windows SDK headers, which Silk does not pass to
Clang. This script builds or installs all four, then writes them as archive overrides to
$SILK_HOME/native-overrides.toml (default ~/.silk), so plain `silk build` links them:

  python scripts/prepare-windows

Run it once from an x64 Visual Studio developer shell. Other hosts need no preparation.
"""
import json
import os
from pathlib import Path
import runpy
import shutil
import sys

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "native" / "gpu" / "webgpu" / "scripts"))
from _build import command_path, windows_dawn, windows_import_library  # noqa: E402


def silk_path(path):
    """`path` as Silk spells an absolute Windows path, /D:/a/b: an override path that does not
    start with / is read relative to the Silk home."""
    return "/" + Path(path).resolve().as_posix().lstrip("/")


def main():
    if sys.platform != "win32":
        print("Nothing to prepare: only Windows needs scripts/prepare-windows.")
        return 0
    clang = command_path("install-llvm")
    dawn = windows_dawn(clang, command_path("install-webgpu"))
    glfw = command_path("install-glfw")
    # The window example calls kernel32 directly; a `library` entry for it does not reach the linker.
    shutil.copy2(windows_import_library("kernel32"), glfw / "lib-vc2022" / "kernel32.lib")
    # native/platform/window's Win32 bridge, with the import libraries a `library` entry cannot name.
    bridge = Path(runpy.run_path(str(REPO / "native/platform/window/core/scripts/windows"))["native"]()).parent
    for name in ("kernel32", "ucrt", "vcruntime"):
        shutil.copy2(windows_import_library(name), bridge / f"{name}.lib")
    # db/sqlite's SQLite and shim, with the same import libraries.
    sqlite = Path(runpy.run_path(str(REPO / "db/sqlite/scripts/windows"))["native"]()).parent
    for name in ("kernel32", "ucrt", "vcruntime"):
        shutil.copy2(windows_import_library(name), sqlite / f"{name}.lib")
    home = Path(os.environ.get("SILK_HOME") or Path.home() / ".silk")
    home.mkdir(parents=True, exist_ok=True)
    overrides = home / "native-overrides.toml"
    text = (
        "# Written by nonstd's scripts/prepare-windows.\n"
        f"[native.override.dawn]\npath = {json.dumps(silk_path(dawn))}\n\n"
        f"[native.override.dawn-headers]\npath = {json.dumps(silk_path(dawn))}\n\n"
        f"[native.override.glfw]\npath = {json.dumps(silk_path(glfw))}\n\n"
        f"[native.override.win32-bridge]\npath = {json.dumps(silk_path(bridge))}\n\n"
        f"[native.override.sqlite]\npath = {json.dumps(silk_path(sqlite))}\n"
    )
    overrides.write_text(text, encoding="utf-8")
    print(f"Wrote {overrides}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
