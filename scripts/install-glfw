#!/usr/bin/env python3
"""Install the pinned Windows GLFW development package; print its root."""
from _install import CACHE, LOCK, asset_for, install

native, asset = asset_for("glfw")
home = install("glfw", CACHE / "glfw" / LOCK["glfw"]["version"] / native,
               "lib-vc2022/glfw3dll.lib")
print(home)
