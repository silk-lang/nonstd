#!/usr/bin/env python3
"""Install the pinned WebView2 SDK (the Microsoft.Web.WebView2 NuGet package); print its root.

platform/webview's Windows backend compiles against its build/native/include/WebView2.h and ships
its build/native/x64/WebView2Loader.dll beside programs that open web views.
"""
from _install import CACHE, LOCK, asset_for, install

native, asset = asset_for("webview2")
home = install("webview2", CACHE / "webview2" / LOCK["webview2"]["version"] / native,
               "build/native/include/WebView2.h")
print(home)
