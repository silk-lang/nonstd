#!/usr/bin/env python3
"""Install the pinned Chromium Embedded Framework (CEF) for platform-webview-chromium.

  scripts/install-cef            install it; print the runtime directory
  scripts/install-cef --latest   print toolchains.lock.json entries for the newest stable CEF

The pin is CEF's minimal binary distribution for Linux (cef-builds.spotifycdn.com), checked by
SHA-256. Installing also:

- puts the runtime directory together (.cache/cef/<version>/<target>/runtime): libcef.so and the
  files beside it (Release/), its resources and locales (Resources/), and silk-cef-helper, the
  executable of CEF's other processes, built from platform/webview/chromium/native/helper;
- copies the distribution's headers to platform/webview/chromium/native/cef/include, which the
  package's bridge compiles against (not committed).

An app that opens Chromium web views ships the runtime directory and names it in
`ChromiumOptions.runtimeDir`.
"""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import urllib.request

from _install import CACHE, LOCK, ROOT, asset_for, fail, install

PACKAGE = ROOT / "platform/webview/chromium"
INDEX = "https://cef-builds.spotifycdn.com/index.json"
PLATFORMS = {"x86_64-unknown-linux-gnu": "linux64", "aarch64-unknown-linux-gnu": "linuxarm64"}


def clang():
    return os.environ.get("SILK_CLANG") or shutil.which("clang") or fail("No clang: set SILK_CLANG")


def api_version():
    """The CEF API version the bridge compiles for; silk.toml must agree with the lock."""
    version = LOCK["cef"]["api_version"]
    manifest = (PACKAGE / "silk.toml").read_text()
    if f"-DCEF_API_VERSION={version}" not in manifest:
        fail(f"platform/webview/chromium/silk.toml does not build for CEF API version {version}")
    return version


def runtime(home, version):
    """Release/ and Resources/ in one directory, plus the helper executable."""
    directory = home / "runtime"
    marker = directory / ".nonstd-runtime"
    helper = PACKAGE / "native/helper/helper.c"
    stamp = hashlib.sha256(helper.read_bytes() + str(version).encode()).hexdigest()
    if marker.is_file() and marker.read_text().strip() == stamp:
        return directory
    if directory.exists():
        shutil.rmtree(directory)
    shutil.copytree(home / "Release", directory)
    shutil.copytree(home / "Resources", directory, dirs_exist_ok=True)
    for archive in directory.glob("*.a"):
        archive.unlink()
    subprocess.run([clang(), "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
                    f"-DCEF_API_VERSION={version}", f"-I{home}", str(helper),
                    "-o", str(directory / "silk-cef-helper"), "-ldl"], check=True)
    marker.write_text(stamp + "\n")
    return directory


def headers(home):
    destination = PACKAGE / "native/cef/include"
    marker = PACKAGE / "native/cef/.nonstd-cef-version"
    version = LOCK["cef"]["version"]
    if marker.is_file() and marker.read_text().strip() == version and destination.is_dir():
        return
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(home / "include", destination)
    marker.write_text(version + "\n")


def latest():
    with urllib.request.urlopen(INDEX) as response:
        index = json.load(response)
    entries = {}
    for native, name in PLATFORMS.items():
        builds = [build for build in index[name]["versions"] if build.get("channel") == "stable"]
        build = builds[0]
        minimal = next(file for file in build["files"] if file["type"] == "minimal")
        url = "https://cef-builds.spotifycdn.com/" + urllib.request.quote(minimal["name"])
        digest = hashlib.sha256()
        sha1 = hashlib.sha1()
        size = 0
        with urllib.request.urlopen(url) as response:
            while chunk := response.read(1 << 20):
                digest.update(chunk)
                sha1.update(chunk)
                size += len(chunk)
        if sha1.hexdigest() != minimal["sha1"]:
            fail(f"SHA-1 of {minimal['name']} differs from the index")
        entries[native] = {"url": url, "sha256": digest.hexdigest(), "bytes": size}
        print(f"{native}: CEF {build['cef_version']} (Chromium {build['chromium_version']})",
              file=sys.stderr)
    print(json.dumps({"version": build["cef_version"], "platforms": entries}, indent=2))


def main():
    if "--latest" in sys.argv[1:]:
        return latest()
    version = api_version()
    native, _ = asset_for("cef")
    home = install("cef", CACHE / "cef" / LOCK["cef"]["version"] / native, "Release/libcef.so")
    headers(home)
    print(runtime(home, version))


if __name__ == "__main__":
    main()
