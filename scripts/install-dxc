#!/usr/bin/env python3
"""Install the pinned Windows shader compiler used by Dawn's D3D12 backend."""
from _install import CACHE, LOCK, asset_for, install

native, asset = asset_for("dxc")
home = install("dxc", CACHE / "dxc" / LOCK["dxc"]["version"] / native,
               "bin/x64/dxcompiler.dll")
print(home / "bin/x64")
