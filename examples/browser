#!/usr/bin/env node
(async () => {
  const { parseArgs } = await import('node:util');
  const { join } = await import('node:path');
  const { run } = await import('../scripts/internal.mjs');
  const { repositoryRoot } = await import('../scripts/dependency-root.mjs');
  const { buildBrowser } = await import('./browser-build.mjs');
  const args = process.argv.slice(2);
  const separator = args.indexOf('--');
  const forwarded = separator < 0 ? [] : args.splice(separator).slice(1);
  const { values, positionals } = parseArgs({ args, allowPositionals: true, options: {
    port: { type: 'string', default: '8050' }, debug: { type: 'boolean' }
  } });
  const [mode, packagePath = 'examples/notes/browser'] = positionals;
  if (positionals.length > 2 || !['serve', 'test', 'build'].includes(mode)) throw new Error('Usage: node examples/browser serve|test|build [PACKAGE] [--port PORT] [--debug] [-- TEST OPTIONS]');
  const wasm = buildBrowser(packagePath, { release: !values.debug });
  if (mode === 'build') { console.log(wasm); return; }
  const browser = join(repositoryRoot('lib-ui'), 'ui/tree/window/browser');
  if (mode === 'serve') run(process.execPath, [join(browser, 'serve.mjs'), wasm, values.port]);
  else {
    const command = [process.execPath, join(browser, 'test.mjs'), '--wasm', wasm, ...forwarded];
    if (process.platform === 'linux') run('xvfb-run', ['--auto-servernum', '--server-args=-screen 0 1280x800x24', ...command], { timeout: 1200000 });
    else run(command[0], command.slice(1), { timeout: 1200000 });
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
