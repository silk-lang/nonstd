#!/usr/bin/env node
(async () => {
  const { parseArgs } = await import('node:util');
  const { join, resolve } = await import('node:path');
  const { build, run } = await import('../../../scripts/internal.mjs');
  const { repositoryRoot } = await import('../../../scripts/dependency-root.mjs');
  const { values } = parseArgs({ options: { file: { type: 'string' } } });
  const { mkdirSync } = await import('node:fs');
  const { root } = await import('../../../scripts/internal.mjs');
  const work = join(root, '.cache/ui-devtools');
  mkdirSync(work, { recursive: true });
  const notes = build('examples/notes/app');
  run(process.execPath, [join(repositoryRoot('lib-ui'), 'ui/inspect/devtools/scripts/devtools'), 'external', '--app-binary', notes,
    '--app-arg', values.file ? resolve(values.file) : join(work, 'notes.json')]);
})().catch(error => { console.error(error); process.exitCode = 1; });
