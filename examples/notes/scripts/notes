#!/usr/bin/env node
(async () => {
  const { parseArgs } = await import('node:util');
  const { resolve } = await import('node:path');
  const { build, run, root } = await import('../../../scripts/internal.mjs');
  const { windowCheck } = await import('../../internal.mjs');
  const { values, positionals } = parseArgs({ allowPositionals: true, options: {
    backend: { type: 'string', default: 'all' }, release: { type: 'boolean' }, 'build-only': { type: 'boolean' }, file: { type: 'string' }
  } });
  const mode = positionals[0] ?? 'run';
  if (positionals.length > 1 || !['run', 'check'].includes(mode)) throw new Error('Usage: notes [run|check] [--release] [--build-only] [--file FILE] [--backend x11|wayland|all]');
  const program = build('examples/notes/app', { release: values.release });
  if (values['build-only']) console.log(program);
  else if (mode === 'check') process.exitCode = await windowCheck(program, values.backend);
  else run(program, values.file ? [resolve(values.file)] : [], { cwd: root });
})().catch(error => { console.error(error); process.exitCode = 1; });
