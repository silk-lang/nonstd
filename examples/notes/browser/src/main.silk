//! Notes in a browser tab: the same app as `examples/notes/app`, built for wasm32 and run by
//! ui/tree/window/browser's page. The notes are kept in the page's localStorage, so a reload
//! finds them again; the first visit starts from the samples.
//!
//!   node examples/browser serve examples/notes/browser
//!
//! With `?check` in the page's address it runs the window host's rendering check, like the
//! native app's `--check`: it clicks New note, presses Tab and compares the canvas with the CPU
//! reference of the same frame. `main` returns 0 within tolerance, 1 outside and 2 on an error.
static if Intrinsic.targetArchitecture() == "wasm32" {
  // These two modules must be in the program's own package: a dependency exports no wasm
  // symbols.
  import generated_webgpu_exports
  import libm
  import ui_notes.lib { Notes, Message, Command, Store, Library, SANS, decode }
  import ui_tree_window.browser { stored, store }
  import silk.collections.bytes { Bytes }
  import silk.core.result { Result }
  import silk.json.scanner { JsonError }
  import ui_app.runtime { Runtime }
  import ui_app_window.lib { Launched, RunOptions, runWindow }
  import ui_tree_window.browser { checkRequested }
  import ui_tree_window.console { StderrWriter }
  import ui_fixtures.fixtures as fixtures
  import ui_tree.lib { TreeError, Batch }
  import atlas.atlas { AtlasError }
  import vector.geometry_error { GeometryError }
  import window.types { WindowError }
  import webgpu.runtime { GpuError }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.mem.allocator { Allocator, OutOfMemoryError }

  /// The localStorage key of the notes file (the page puts its own prefix before it).
  const KEY: string<'static> = "notes"

  /// Keeps the notes file in the page's localStorage. In check mode the page gives the app no
  /// storage, so nothing is read or kept.
  struct PageStore {}

  impl Store for PageStore {
    effect fn save(self: &mut Self, text: string) -> bool {
      return store(KEY, text)
    }
  }

  /// The kept notes, or the samples on a first visit or when what is kept does not read.
  effect fn initial(check: bool) -> Library
    ! OutOfMemoryError
    ? &mut Allocator {
    if check {
      return run Notes.sample()
    }
    let kept = match run stored(KEY) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        return run Notes.sample()
      }
    }
    let parsed = run Effect.result(decode(Bytes.asSlice(&kept)))
    return match move parsed {
      Result<Library, JsonError | OutOfMemoryError>.Success { value } => move value
      Result<Library, JsonError | OutOfMemoryError>.Failure { error } => {
        drop error
        StderrWriter.print(
          "ui-notes-browser: the kept notes do not read; starting from the samples\n",
          &(),
        )
        run Notes.sample()
      }
    }
  }

  effect fn program(check: bool) -> i32
    ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let collection = run fixtures.fonts()
    let mut batch = Batch.make()
    run batch.fontFamily(SANS, "Noto Sans, sans-serif")
    let options = RunOptions {
      title: "Notes",
      width: 900.0,
      height: 600.0,
      check: check,
      checkClick: "New note",
      checkExpect: "5 notes",
      lowestLatency: false,
      platform: Option<Launched>.None,
    }
    let mut app = Runtime<Notes, Message, Command>.make(run Notes.make(run initial(check)))
    let mut pageStore = PageStore {}
    return run runWindow(&mut app, &collection, run batch.take(), move options)
      |> Effect.provideMut<Store>(&mut pageStore)
  }

  effect fn gpuFailed(error: GpuError) -> i32 {
    StderrWriter.print("ui-notes-browser: GPU error {}\n", &.(error.code))
    return 2
  }

  effect fn failed<E>(error: E) -> i32 {
    drop error
    StderrWriter.print(
      "ui-notes-browser: failed (window, tree, atlas, geometry or allocation)\n",
      &(),
    )
    return 2
  }

  pub fn main() -> i32 {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(Effect.catch<GpuError>(program(checkRequested()), gpuFailed), failed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
} else {
  /// The browser build only; natively, run `examples/notes/app`.
  pub fn main() -> i32 {
    return 0
  }
}
