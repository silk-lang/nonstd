//! Notes in a native window.
//!
//!   ui-notes-app [FILE] [--check]
//!
//! The notes live in FILE (default: `.silk-notes.json` in the home directory, or in the working
//! directory when there is no `HOME`). A missing file starts with a few sample notes; edits are
//! written back a second after they happen, or at once with Ctrl+S (Cmd+S on macOS), replacing
//! the file atomically. A file that is not a notes file is left alone: the app says so and exits.
//!
//! In a debug build with `SILK_UI_INSPECT` set it serves the inspector protocol, so the devtools
//! window (ui/inspect/devtools), ui-inspect-cli and ui-inspect-mcp can inspect and drive it.
//!
//! `--check` ignores real input and FILE: it starts from the sample notes in memory, clicks New
//! note and presses Tab, then compares the window's surface with the CPU reference of the same
//! frame. Exit code 0 within tolerance, 1 outside, 2 on an error.
import ui_notes.lib { Notes, Message, Command, Store, Library, SANS, decode }
import ui_app.runtime { Runtime }
import ui_app_window.lib { RunOptions, runWindowWith }
import ui_inspect_server.lib { Inspector, InspectorOptions }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { TreeError, Batch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.json.scanner { JsonError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, FileError, AtomicWriteError, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

const DEFAULT_NAME: string<'static> = ".silk-notes.json"

/// Writes the notes to a file, replacing it atomically.
struct FileStore {
  files: MachineFileSystem,
  path: Path,
}

impl Store for FileStore {
  effect fn save(self: &mut Self, text: string) -> bool {
    let result = run Effect.result(
      FileSystem.writeFileAtomic(
        &self.path,
        String.utf8Bytes(text),
        FileSystem.replaceExisting(),
        FileSystem.buffered(),
      ),
    )
      |> Effect.provideMut<FileSystem>(&mut self.files)
    return match move result {
      Result<(), AtomicWriteError>.Success { value } => true
      Result<(), AtomicWriteError>.Failure { error } => {
        drop error
        StderrWriter.print("ui-notes-app: could not save the notes\n", &())
        false
      }
    }
  }
}

/// Keeps nothing: the check runs without touching a file.
struct NullStore {}

impl Store for NullStore {
  effect fn save(self: &mut Self, text: string) -> bool {
    return true
  }
}

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

/// The arguments: whether `--check` is there, and the file argument (empty when none).
struct Arguments {
  check: bool,
  file: Bytes,
}

effect fn arguments() -> Arguments
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut parsed = Arguments { check: false, file: Bytes.make() }
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), b"--check") {
        parsed.check = true
      } else {
        parsed.file = move value
      }
    }
    i = i + 1
  }
  return move parsed
}

/// Where the notes live: the file argument resolved against the working directory, or the
/// default name in the home directory (the working directory without one).
effect fn notesPath(file: &Bytes) -> Path
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let given = Bytes.asSlice(file)
  if given.length != 0 {
    return if given[0] == 47 {
      run Path.fromBytes(given)
    } else {
      run Path.resolveBytes(&base, given)
    }
  }
  if let Option<Bytes>.Some { value: home } = run HostInput.variableNamed("HOME") {
    // A home that is not a path here (say, a Windows path) falls back to the working directory.
    let homePath = run Effect.result(Path.fromBytes(Bytes.asSlice(&home)))
    if let Result<Path, FileError | OutOfMemoryError>.Success { value: found } = move homePath {
      return run Path.join(&found, DEFAULT_NAME)
    }
  }
  return run Path.join(&base, DEFAULT_NAME)
}

/// A notes file that is there but cannot be read as one.
struct Unreadable {}

/// The library in `path`: the sample notes when there is no file yet.
effect fn load(path: &Path) -> Library
  ! Unreadable | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(FileSystem.readFile(path))
  let bytes = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => {
        let reason = FileSystem.reasonCode(move failure.reason)
        if reason == FileSystem.reasonCode(FileSystem.notFound()) {
          return run Notes.sample()
        }
        fail Unreadable {}
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  let parsed = run Effect.result(decode(Bytes.asSlice(&bytes)))
  return match move parsed {
    Result<Library, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Library, JsonError | OutOfMemoryError>.Failure { error } => {
      drop error
      fail Unreadable {}
    }
  }
}

effect fn program() -> i32
  ! WindowError
    | GpuError
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | HostInputError
    | FileError
  ? &mut HostInput | &mut Allocator {
  let args = run arguments()
  let collection = run fixtures.fonts()
  let mut batch = Batch.make()
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  let options = RunOptions {
    title: "Notes",
    width: 900.0,
    height: 600.0,
    check: args.check,
    checkClick: "New note",
    checkExpect: "5 notes",
    lowestLatency: false,
  }

  // Debug builds with SILK_UI_INSPECT set serve the inspector (ui/inspect/server), so
  // ui-inspect-cli, ui-inspect-mcp and the devtools window can look at the notes.
  let inspector = run Inspector.start(InspectorOptions.make())
  if args.check {
    let mut app = Runtime<Notes, Message, Command>.make(run Notes.make(run Notes.sample()))
    let mut store = NullStore {}
    return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
      |> Effect.provideMut<Store>(&mut store)
  }

  let path = run notesPath(&args.file)
  let mut files = run MachineFileSystem.make()
  let loaded = run Effect.result(load(&path)) |> Effect.provideMut<FileSystem>(&mut files)
  let library = match move loaded {
    Result<Library, Unreadable | OutOfMemoryError>.Success { value } => move value
    Result<Library, Unreadable | OutOfMemoryError>.Failure { error } => {
      drop error
      let shown = Path.view(&path) |> Option<string>.unwrapOr("the notes file")
      StderrWriter.print(
        "ui-notes-app: could not read {} as a notes file; it is left as it is. Move it away or name another file.\n",
        &(shown,),
      )
      return 2
    }
  }
  let mut app = Runtime<Notes, Message, Command>.make(run Notes.make(move library))
  let mut store = FileStore { files: move files, path: move path }
  return run runWindowWith(&mut app, &collection, run batch.take(), move options, move inspector)
    |> Effect.provideMut<Store>(&mut store)
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("ui-notes-app: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("ui-notes-app: GPU error {}\n", &(error.code,))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-notes-app: failed (files, tree, atlas, geometry or allocation)\n", &())
  return 2
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<GpuError>(Effect.catch<WindowError>(program(), windowFailed), gpuFailed),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
