//! Notes tests: the JSON format, the text helpers, and the app driven through the real tree with
//! synthetic input, the way a person would use it. Run from the repository root.
import ui_notes.lib {
  Notes,
  Note,
  Message,
  Command,
  Store,
  Library,
  SANS,
  encode,
  decode,
  wordCount,
  matches,
  preview,
  displayTitle
}
import ui_notes.text { characterCount, compareIgnoringCase }
import ui_app.runtime { Runtime, tick }
import ui_app.harness { click, clickRole, press, typeText, locate, locateRole, focusedId, snapshot }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { UiTree, TreeError, Batch, FrameInput, NodeInfo, Role, MOD_CONTROL, MOD_SHIFT }
import silk.collections.list { List }
import silk.collections.slice { Slice }
