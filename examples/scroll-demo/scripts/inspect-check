#!/usr/bin/env node
// Check the debug scroll demo through the devtools socket protocol.
(async () => {
  const { build, root } = await import('../../../scripts/internal.mjs');
  const assert = (await import('node:assert/strict')).default;
  const { spawn } = await import('node:child_process');
  const { closeSync, mkdtempSync, openSync, readFileSync, rmSync } = await import('node:fs');
  const { createConnection } = await import('node:net');
  const { tmpdir } = await import('node:os');
  const { join, resolve } = await import('node:path');
  const { setTimeout: sleep } = await import('node:timers/promises');
  const { parseArgs } = await import('node:util');
  const { values } = parseArgs({ options: { binary: { type: 'string' }, help: { type: 'boolean', short: 'h' } } });
  if (values.help) {
    console.log('Usage: examples/scroll-demo/scripts/inspect-check [--binary PATH]\nBuilds a debug app; requires a macOS/Linux desktop display and GPU.');
    return;
  }
  if (process.platform === 'win32') throw new Error('this socket smoke test requires macOS or Linux');
  const binary = values.binary ? resolve(values.binary) : build(join(root, 'examples/scroll-demo'), { release: false });
  const directory = mkdtempSync(join(tmpdir(), 'scroll-inspect-'));
  const address = join(directory, 'app.sock');
  const logPath = join(directory, 'app.log');
  const log = openSync(logPath, 'w');
  const app = spawn(binary, [], { cwd: root, env: { ...process.env, SILK_UI_INSPECT: address }, stdio: ['ignore', log, log] });
  closeSync(log);
  let spawnError;
  const stopped = new Promise(resolve => {
    app.once('error', error => { spawnError = error; resolve(); });
    app.once('exit', resolve);
  });
  function request(command) {
    return new Promise((resolve, reject) => {
      const connection = createConnection(address);
      let text = '';
      const fail = error => { connection.destroy(); reject(error); };
      connection.setEncoding('utf8');
      connection.setTimeout(3000, () => fail(new Error('inspector request timed out')));
      connection.once('error', fail);
      connection.once('connect', () => connection.write(`${JSON.stringify(command)}\n`));
      connection.on('data', chunk => {
        text += chunk;
        const end = text.indexOf('\n');
        if (end < 0) return;
        connection.destroy();
        try { resolve(JSON.parse(text.slice(0, end))); } catch (error) { reject(error); }
      });
      connection.once('end', () => fail(new Error('inspector closed without a reply')));
    }).then(reply => { assert.ok(reply.ok, JSON.stringify(reply)); return reply; });
  }
  try {
    const deadline = performance.now() + 15000;
    let hello;
    while (true) {
      try { hello = await request({ cmd: 'hello' }); break; }
      catch (error) {
        if (error instanceof assert.AssertionError) throw error;
        if (spawnError) throw spawnError;
        if (app.exitCode !== null || app.signalCode !== null || performance.now() >= deadline) {
          throw new Error('scroll demo did not answer the inspector socket');
        }
        await sleep(100);
      }
    }
    assert.ok(hello.nodes > 0, JSON.stringify(hello));
    const tree = await request({ cmd: 'tree' });
    assert.ok(tree.nodes?.length > 0, JSON.stringify(tree));
    await request({ cmd: 'click', role: 'button', name: 'Reverse', exact: true });
    const changed = await request({ cmd: 'query', name: 'Forward', exact: true });
    assert.ok(changed.count > 0, JSON.stringify(changed));
    console.log('PASS: inspector connects, lists elements, and drives Reverse → Forward');
  } catch (error) {
    console.error(readFileSync(logPath, 'utf8'));
    throw error;
  } finally {
    if (!spawnError && app.exitCode === null && app.signalCode === null) {
      app.kill('SIGTERM');
      const kill = setTimeout(() => app.kill('SIGKILL'), 5000);
      try { await stopped; } finally { clearTimeout(kill); }
    }
    rmSync(directory, { recursive: true, force: true });
  }
})().catch(error => { console.error(error.message); process.exitCode = 1; });
