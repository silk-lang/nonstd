#!/usr/bin/env node
// Check compositor pacing, concurrent painting, and click handling during slow updates.
(async () => {
  const { build, root } = await import('../../../scripts/internal.mjs');
  const { withDisplay } = await import('../../internal.mjs');
  const { spawnSync } = await import('node:child_process');
  const { closeSync, mkdtempSync, openSync, readFileSync, rmSync } = await import('node:fs');
  const { tmpdir } = await import('node:os');
  const { join, resolve } = await import('node:path');
  const { parseArgs } = await import('node:util');
  const { values } = parseArgs({ options: {
    backend: { type: 'string', default: 'all' }, mode: { type: 'string', default: 'all' },
    sections: { type: 'string', default: '10000' }, 'slow-update': { type: 'string', default: '200' },
    'max-p95': { type: 'string', default: '25' }, 'max-gap': { type: 'string', default: '50' },
    binary: { type: 'string' }, help: { type: 'boolean', short: 'h' },
  } });
  if (values.help) {
    console.log(`Usage: examples/scroll-demo/scripts/exit-test [OPTIONS]
  --backend x11|wayland|all   Linux display backend (default: all)
  --mode mounted|virtualized|all (default: all)
  --sections N              Fully mounted section count (default: 10000)
  --slow-update MS          Slow update sleep (default: 200)
  --max-p95 MS              Minimum p95 gap limit (default: 25)
  --max-gap MS              Minimum longest gap limit (default: 50)
  --binary PATH             Skip the release build
Runs each mode with fast and slow updates, scrolling for three seconds, then clicking
Reverse. Limits also allow baseline * 1.25 + 2 ms. Requires painting during scrolling
and a click response. Linux uses Xvfb/Weston when installed, otherwise the session's
display; macOS and Windows open a real window.`);
    return;
  }
  if (!['x11', 'wayland', 'all'].includes(values.backend)) throw new Error('backend must be x11, wayland, or all');
  if (!['mounted', 'virtualized', 'all'].includes(values.mode)) throw new Error('mode must be mounted, virtualized, or all');
  for (const key of ['sections', 'slow-update', 'max-p95', 'max-gap']) {
    const text = values[key];
    values[key] = Number(text);
    if (!text.trim() || !Number.isFinite(values[key]) || (['sections', 'slow-update'].includes(key) && !Number.isInteger(values[key]))) {
      throw new Error(`--${key} requires a ${['sections', 'slow-update'].includes(key) ? 'whole ' : ''}number`);
    }
  }
  const binary = values.binary ? resolve(values.binary) : build(join(root, 'examples/scroll-demo'), { release: true });
  const modes = values.mode === 'all' ? ['mounted', 'virtualized'] : [values.mode];
  const backends = process.platform === 'linux' ? (values.backend === 'all' ? ['x11', 'wayland'] : [values.backend]) : [process.platform];
  const directory = mkdtempSync(join(tmpdir(), 'scroll-exit-'));
  const pattern = /exit-test: steps=(\d+) frames=(\d+) fps=([\d.]+) gap-p95-ms=([\d.e+-]+) gap-max-ms=([\d.e+-]+) painted=(\d+) click=(\w+)/;
  function result(path) {
    const text = readFileSync(path, 'utf8');
    const found = pattern.exec(text);
    if (!found) { process.stderr.write(text.slice(-4000)); return null; }
    return { steps: Number(found[1]), frames: Number(found[2]), fps: Number(found[3]), p95: Number(found[4]), longest: Number(found[5]), painted: Number(found[6]), clicked: found[7] === 'ok' };
  }
  function describe(run) {
    return `${run.frames} frames for ${run.steps} wheel steps (${run.fps.toFixed(0)} fps), gap p95 ${run.p95.toFixed(1)} ms, longest ${run.longest.toFixed(1)} ms; the app painted ${run.painted} of them and ${run.clicked ? 'answered' : 'did not answer'} a click`;
  }
  function judge(name, slow, fast) {
    if (!slow || !fast) { console.log(`--- ${name}: failed, no result`); return 1; }
    const limit = Math.max(values['max-p95'], fast.p95 * 1.25 + 2);
    const longest = Math.max(values['max-gap'], fast.longest * 1.25 + 2);
    const least = Math.max(2, Math.trunc(3000 / Math.max(values['slow-update'], 1) / 3));
    const ok = slow.frames > 0 && slow.p95 <= limit && slow.longest <= longest && slow.painted >= least && fast.painted >= least && slow.clicked && fast.clicked;
    console.log(`--- ${name}: baseline (update does not sleep): ${describe(fast)}`);
    console.log(`--- ${name}: update sleeps ${values['slow-update']} ms: ${describe(slow)}`);
    console.log(`--- ${name}: ${ok ? 'passed' : 'failed'} (limits: p95 ${limit.toFixed(1)} ms, longest ${longest.toFixed(1)} ms, the app paints at least ${least} frames and answers the click)`);
    return ok ? 0 : 1;
  }
  let status = 0;
  try {
    for (const backend of backends) {
      for (const mode of modes) {
        const label = `${backend} ${mode}`;
        console.log(`--- ${label}`);
        const runs = new Map();
        let code = 0;
        for (const slow of [0, values['slow-update']]) {
          const flags = mode === 'mounted' ? [`--sections=${values.sections}`, '--fully-mounted'] : ['--sections=100'];
          flags.push(`--slow-update=${slow}`, '--exit-test');
          const logPath = join(directory, `${backend}-${mode}-${slow}.log`);
          const log = openSync(logPath, 'w');
          try {
            const current = await withDisplay(backend, process.env, env => {
              const child = spawnSync(binary, flags, { cwd: root, env, stdio: ['inherit', 'inherit', log], timeout: process.platform === 'linux' ? 120000 : 600000 });
              if (child.error) throw child.error;
              return child.status ?? 1;
            });
            code = current || code;
          } finally { closeSync(log); }
          runs.set(slow, result(logPath));
        }
        status = judge(label, runs.get(values['slow-update']), runs.get(0)) || code || status;
      }
    }
    process.exitCode = status;
  } finally { rmSync(directory, { recursive: true, force: true }); }
})().catch(error => { console.error(error.message); process.exitCode = 1; });
