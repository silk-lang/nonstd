#!/usr/bin/env python3
"""The UI threading exit test: scrolling stays at display rate while the app is slow.

Builds the release scroll demo and runs it with every section mounted (default 10,000) and an
`update` that sleeps 200 ms each pass. A driver thread in the app sends a wheel step every 8 ms
for 3 seconds through the platform thread, where OS input arrives, and counts the frames the
render thread presents meanwhile. It passes when the gaps between frames stay short: p95 at most
--max-p95 ms and the longest at most --max-gap ms. With one thread the gaps would be at least
the 200 ms update.

On Linux it runs under Xvfb (X11) and a headless Weston (Wayland), as
native/platform/window/scripts/linux does, with lavapipe when VK_ICD_FILENAMES is not set; on
macOS and Windows it opens a real window.
"""
import argparse
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile

PACKAGE = Path(__file__).resolve().parents[1]
REPO = PACKAGE.parents[1]
WINDOW = REPO / 'native/platform/window/scripts'
sys.path.insert(0, str(REPO / 'native/gpu/webgpu/scripts'))
from _build import build  # noqa: E402

LAVAPIPE = Path('/usr/share/vulkan/icd.d/lvp_icd.json')
RESULT = re.compile(r'exit-test: steps=(\d+) frames=(\d+) fps=([\d.]+) gap-p95-ms=([\d.]+) gap-max-ms=([\d.]+)')


def judge(name, log, args):
    text = log.read_text(errors='replace') if log.exists() else ''
    found = RESULT.search(text)
    if not found:
        sys.stderr.write(text[-4000:])
        print(f'--- {name}: failed, no result')
        return 1
    steps, frames = int(found[1]), int(found[2])
    fps, p95, longest = float(found[3]), float(found[4]), float(found[5])
    ok = frames > 0 and p95 <= args.max_p95 and longest <= args.max_gap
    print(f'--- {name}: {"passed" if ok else "failed"}: {steps} wheel steps, {frames} frames '
          f'({fps:.0f} fps), gap p95 {p95:.1f} ms, longest {longest:.1f} ms '
          f'(limits {args.max_p95:g} and {args.max_gap:g} ms)', flush=True)
    return 0 if ok else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--backend', choices=['x11', 'wayland', 'all'], default='all')
    parser.add_argument('--sections', type=int, default=10000)
    parser.add_argument('--slow-update', type=int, default=200)
    parser.add_argument('--max-p95', type=float, default=25.0)
    parser.add_argument('--max-gap', type=float, default=50.0)
    parser.add_argument('--binary', type=Path, help='skip building')
    args = parser.parse_args()
    program = args.binary.resolve() if args.binary else build(PACKAGE, release=True)
    flags = [f'--sections={args.sections}', '--fully-mounted', f'--slow-update={args.slow_update}',
             '--exit-test']
    env = dict(os.environ)
    with tempfile.TemporaryDirectory(prefix='scroll-exit-') as temporary:
        directory = Path(temporary)
        if not sys.platform.startswith('linux'):
            log = directory / 'app.log'
            with log.open('w') as output:
                subprocess.run([str(program), *flags], cwd=REPO, env=env, stderr=output, timeout=600)
            return judge(sys.platform, log, args)
        if 'VK_ICD_FILENAMES' not in env and LAVAPIPE.exists():
            env['VK_ICD_FILENAMES'] = str(LAVAPIPE)
        env['SILK_WINDOW_SCALE'] = env.get('SILK_WINDOW_SCALE', '1')
        linux = runpy.run_path(str(WINDOW / 'linux'))
        status = 0
        for name in (['x11', 'wayland'] if args.backend == 'all' else [args.backend]):
            log = directory / f'{name}.log'
            # The runners start the program without arguments; a wrapper adds them.
            wrapper = directory / f'{name}.sh'
            wrapper.write_text(f'#!/bin/sh\ncd "{REPO}"\nexec "{program}" {" ".join(flags)} 2>"{log}"\n')
            wrapper.chmod(0o755)
            print(f'--- {name}', flush=True)
            runner = linux['run_under_x11'] if name == 'x11' else linux['run_under_wayland']
            code = runner(wrapper, env)
            status = judge(name, log, args) or code or status
        return status


if __name__ == '__main__':
    raise SystemExit(main())
