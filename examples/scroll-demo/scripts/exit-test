#!/usr/bin/env python3
"""The UI threading exit test: scrolling stays at display rate while the app is slow.

Builds the release scroll demo and runs it with every section mounted (default 10,000) and an
`update` that sleeps 200 ms each pass. A driver thread in the app sends a wheel step every 8 ms
for 3 seconds through the platform thread, where OS input arrives, and counts the frames the
render thread presents meanwhile. It runs once more with an update that does not sleep, as the baseline of what this
machine's GPU can present. It passes when the slow run's gaps between frames stay short: p95 at
most --max-p95 ms or within a quarter (plus 2 ms) of the baseline's, and the longest at most
--max-gap ms. With one thread the gaps would be at least the 200 ms update.

On Linux it runs under Xvfb (X11) and a headless Weston (Wayland), as
native/platform/window/scripts/linux does, with lavapipe when VK_ICD_FILENAMES is not set; on
macOS and Windows it opens a real window.
"""
import argparse
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile

PACKAGE = Path(__file__).resolve().parents[1]
REPO = PACKAGE.parents[1]
WINDOW = REPO / 'native/platform/window/scripts'
sys.path.insert(0, str(REPO / 'native/gpu/webgpu/scripts'))
from _build import build  # noqa: E402

LAVAPIPE = Path('/usr/share/vulkan/icd.d/lvp_icd.json')
RESULT = re.compile(r'exit-test: steps=(\d+) frames=(\d+) fps=([\d.]+) gap-p95-ms=([\d.]+) gap-max-ms=([\d.]+)')


def result(log):
    text = log.read_text(errors='replace') if log.exists() else ''
    found = RESULT.search(text)
    if not found:
        sys.stderr.write(text[-4000:])
        return None
    return dict(steps=int(found[1]), frames=int(found[2]), fps=float(found[3]),
                p95=float(found[4]), longest=float(found[5]))


def describe(run):
    return (f'{run["frames"]} frames for {run["steps"]} wheel steps ({run["fps"]:.0f} fps), '
            f'gap p95 {run["p95"]:.1f} ms, longest {run["longest"]:.1f} ms')


def judge(name, slow, fast, args):
    if not slow or not fast:
        print(f'--- {name}: failed, no result', flush=True)
        return 1
    limit = max(args.max_p95, fast['p95'] * 1.25 + 2.0)
    ok = slow['frames'] > 0 and slow['p95'] <= limit and slow['longest'] <= args.max_gap
    print(f'--- {name}: baseline (update does not sleep): {describe(fast)}', flush=True)
    print(f'--- {name}: update sleeps {args.slow_update} ms: {describe(slow)}', flush=True)
    print(f'--- {name}: {"passed" if ok else "failed"} (p95 limit {limit:.1f} ms, longest '
          f'{args.max_gap:g} ms)', flush=True)
    return 0 if ok else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--backend', choices=['x11', 'wayland', 'all'], default='all')
    parser.add_argument('--sections', type=int, default=10000)
    parser.add_argument('--slow-update', type=int, default=200)
    parser.add_argument('--max-p95', type=float, default=25.0)
    parser.add_argument('--max-gap', type=float, default=50.0)
    parser.add_argument('--binary', type=Path, help='skip building')
    args = parser.parse_args()
    program = args.binary.resolve() if args.binary else build(PACKAGE, release=True)
    def flags(slow):
        return [f'--sections={args.sections}', '--fully-mounted', f'--slow-update={slow}', '--exit-test']
    env = dict(os.environ)
    with tempfile.TemporaryDirectory(prefix='scroll-exit-') as temporary:
        directory = Path(temporary)
        if not sys.platform.startswith('linux'):
            runs = {}
            for slow in (0, args.slow_update):
                log = directory / f'app-{slow}.log'
                with log.open('w') as output:
                    subprocess.run([str(program), *flags(slow)], cwd=REPO, env=env, stderr=output, timeout=600)
                runs[slow] = result(log)
            return judge(sys.platform, runs[args.slow_update], runs[0], args)
        if 'VK_ICD_FILENAMES' not in env and LAVAPIPE.exists():
            env['VK_ICD_FILENAMES'] = str(LAVAPIPE)
        env['SILK_WINDOW_SCALE'] = env.get('SILK_WINDOW_SCALE', '1')
        linux = runpy.run_path(str(WINDOW / 'linux'))
        status = 0
        for name in (['x11', 'wayland'] if args.backend == 'all' else [args.backend]):
            print(f'--- {name}', flush=True)
            runner = linux['run_under_x11'] if name == 'x11' else linux['run_under_wayland']
            runs = {}
            code = 0
            for slow in (0, args.slow_update):
                log = directory / f'{name}-{slow}.log'
                # The runners start the program without arguments; a wrapper adds them.
                wrapper = directory / f'{name}-{slow}.sh'
                wrapper.write_text(f'#!/bin/sh\ncd "{REPO}"\nexec "{program}" {" ".join(flags(slow))} 2>"{log}"\n')
                wrapper.chmod(0o755)
                code = runner(wrapper, env) or code
                runs[slow] = result(log)
            status = judge(name, runs[args.slow_update], runs[0], args) or code or status
        return status


if __name__ == '__main__':
    raise SystemExit(main())
