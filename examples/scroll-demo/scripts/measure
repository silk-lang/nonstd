#!/usr/bin/env node
// Measure ordinary UI-tree scrolling; build the release demo with scripts/run first.
(async () => {
  const { root, run } = await import('../../../scripts/internal.mjs');
  const assert = (await import('node:assert/strict')).default;
  const { createHash } = await import('node:crypto');
  const { closeSync, existsSync, mkdirSync, openSync, readFileSync, readdirSync, writeFileSync } = await import('node:fs');
  const { machine } = await import('node:os');
  const { join, resolve } = await import('node:path');
  const { parseArgs } = await import('node:util');
  // Node's parser handles repeated values; normalize argparse's --sizes N N syntax.
  const argv = process.argv.slice(2);
  const normalized = [];
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] !== '--sizes') { normalized.push(argv[i]); continue; }
    let count = 0;
    while (i + 1 < argv.length && !argv[i + 1].startsWith('--') && argv[i + 1] !== '-h') {
      normalized.push(`--sizes=${argv[++i]}`);
      count++;
    }
    if (!count) throw new Error('--sizes requires at least one size');
  }
  const { values } = parseArgs({ args: normalized, options: {
    sizes: { type: 'string', multiple: true, default: ['100', '1000'] },
    'fully-mounted': { type: 'boolean', default: false }, phases: { type: 'boolean', default: false },
    timeout: { type: 'string', default: '600' }, steps: { type: 'string', default: '120' },
    directory: { type: 'string', default: join(root, 'build/scroll-lab') },
    help: { type: 'boolean', short: 'h' },
  } });
  if (values.help) {
    console.log(`Usage: examples/scroll-demo/scripts/measure [--sizes N ...] [--fully-mounted]
       [--phases] [--timeout SECONDS] [--steps N] [--directory PATH]
Build the release demo with scripts/run --build-only first. Defaults: sizes 100 1000,
120 steps, 600-second timeout, build/scroll-lab. --phases resolves layout separately
before painting: use it to diagnose, not for the normal baseline.`);
    return;
  }
  function integer(text, name) {
    if (!/^[+-]?\d+$/.test(text) || !Number.isSafeInteger(Number(text))) throw new Error(`${name} requires an integer`);
    return Number(text);
  }
  const sizes = values.sizes.map(value => integer(value, '--sizes'));
  const steps = integer(values.steps, '--steps');
  const timeout = integer(values.timeout, '--timeout');
  if (steps < 2 || steps > 1000 || sizes.some(size => size < 1 || size > 10000)) {
    throw new Error('sizes must be 1..10000 and steps 2..1000');
  }
  const llvm = join(root, 'build/llvm');
  const filename = process.platform === 'win32' ? 'silk-scroll-demo.exe' : 'silk-scroll-demo';
  const candidates = existsSync(llvm) ? readdirSync(llvm, { withFileTypes: true })
    .filter(entry => entry.isDirectory())
    .map(entry => join(llvm, entry.name, 'release', filename))
    .filter(path => existsSync(path)) : [];
  if (candidates.length !== 1) throw new Error('Build the release demo first (exactly one target artifact is required)');
  const binary = candidates[0];
  const directory = resolve(values.directory);
  mkdirSync(directory, { recursive: true });
  function git(args) {
    return run('git', args, { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).stdout.trim();
  }
  const result = {
    date: new Date().toISOString(), machine: machine(), viewport: { width: 1280, height: 900, scale: 2 },
    revision: git(['rev-parse', 'HEAD']), dirty: Boolean(git(['status', '--porcelain'])),
    binarySha256: createHash('sha256').update(readFileSync(binary)).digest('hex'),
    metric: 'CPU wheel dispatch/runtime pump and UI-tree frame (layout/paint); excludes GPU, native accessibility, and presentation',
    phases: values.phases,
    document: values['fully-mounted'] ? 'Fully mounted' : 'Library-virtualized variable-height mixed-content sections', cases: [],
  };
  function stats(values) {
    values.sort((a, b) => a - b);
    const middle = Math.floor(values.length / 2);
    return { medianMs: values.length % 2 ? values[middle] : (values[middle - 1] + values[middle]) / 2,
      p95Ms: values[Math.floor((values.length - 1) * .95)], maxMs: values.at(-1) };
  }
  const row = /scroll-ms: input=(\S+) frame=(\S+) y=(\S+) painted=(\S+) replayed=(\S+) glyphs=(\S+) layoutSkipped=(\S+)/g;
  for (const size of sizes) {
    const logPath = join(directory, `${size}.log`);
    const log = openSync(logPath, 'w');
    const flags = ['--benchmark', `--sections=${size}`, `--steps=${steps}`];
    if (values.phases) flags.push('--phases');
    if (values['fully-mounted']) flags.push('--fully-mounted');
    try { run(binary, flags, { cwd: root, stdio: ['inherit', log, log], timeout: Math.max(1, timeout * 1000) }); }
    finally { closeSync(log); }
    const text = readFileSync(logPath, 'utf8');
    const rows = [...text.matchAll(row)];
    assert.equal(rows.length, steps, `${size} sections: ${rows.length} samples\n${text.slice(-1000)}`);
    const mount = /mount-ms: (\S+) nodes=(\S+) fragments=(\S+)/.exec(text);
    assert.ok(mount, `missing mount metrics\n${text.slice(-1000)}`);
    const entry = {
      sections: size, nodes: Number(mount[2]), fragments: Number(mount[3]), mountMs: Number(mount[1]),
      samples: rows.length, input: stats(rows.map(row => Number(row[1]))), frame: stats(rows.map(row => Number(row[2]))),
      total: stats(rows.map(row => Number(row[1]) + Number(row[2]))),
      paintedFragmentsMax: Math.max(...rows.map(row => Number(row[4]))),
      layoutSkippedFrames: rows.filter(row => row[7] === 'true').length,
    };
    const mountPhases = /mount-phases-ms: build=(\S+) firstFrame=(\S+)/.exec(text);
    if (mountPhases) Object.assign(entry, { buildMs: Number(mountPhases[1]), firstFrameMs: Number(mountPhases[2]) });
    const phases = [...text.matchAll(/phase-ms: layout=(\S+) remainingFrame=(\S+) fullLayouts=(\S+)/g)];
    if (phases.length) Object.assign(entry, {
      layout: stats(phases.map(phase => Number(phase[1]))), remainingFrame: stats(phases.map(phase => Number(phase[2]))),
      fullLayoutsMax: Math.max(...phases.map(phase => Number(phase[3]))),
    });
    const fullLayouts = [...text.matchAll(/layoutSkipped=\S+ fullLayouts=(\d+)/g)];
    if (fullLayouts.length) entry.fullLayoutsMax = Math.max(...fullLayouts.map(match => Number(match[1])));
    entry.glyphsMax = Math.max(...rows.map(row => Number(row[6])));
    result.cases.push(entry);
    writeFileSync(join(directory, 'results.json'), `${JSON.stringify(result, null, 2)}\n`);
    console.log(JSON.stringify(entry));
  }
  console.log(join(directory, 'results.json'));
})().catch(error => { console.error(error.message); process.exitCode = 1; });
