#!/usr/bin/env node
// Build/run the native scroll stress demo; --bundle packages the macOS app.
(async () => {
  const { build, root } = await import('../../../scripts/internal.mjs');
  const { chmodSync, copyFileSync, mkdirSync, renameSync, statSync, utimesSync, writeFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const { spawnSync } = await import('node:child_process');
  const forwarded = [];
  let debug = false, buildOnly = false, bundle = false;
  let forwarding = false;
  for (const arg of process.argv.slice(2)) {
    if (forwarding) { forwarded.push(arg); continue; }
    if (arg === '--') { forwarding = true; forwarded.push(arg); continue; }
    if (arg === '--debug') debug = true;
    else if (arg === '--build-only') buildOnly = true;
    else if (arg === '--bundle') bundle = true;
    else if (arg === '--help' || arg === '-h') {
      console.log('Usage: examples/scroll-demo/scripts/run [--debug] [--build-only] [--bundle] [APP OPTIONS]');
      return;
    } else forwarded.push(arg);
  }
  const binary = build(join(root, 'examples/scroll-demo'), { release: !debug });
  if (bundle) {
    if (process.platform !== 'darwin') throw new Error('--bundle requires macOS');
    const app = join(root, 'build/Fieldnotes Scroll Lab.app');
    const macos = join(app, 'Contents/MacOS');
    mkdirSync(macos, { recursive: true });
    const staged = join(macos, 'Fieldnotes.next');
    copyFileSync(binary, staged);
    const metadata = statSync(binary);
    chmodSync(staged, metadata.mode);
    utimesSync(staged, metadata.atime, metadata.mtime);
    renameSync(staged, join(macos, 'Fieldnotes'));
    writeFileSync(join(app, 'Contents/Info.plist'), `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>Fieldnotes Scroll Lab</string>
<key>CFBundleIdentifier</key><string>org.silk-lang.scroll-lab</string>
<key>CFBundleExecutable</key><string>Fieldnotes</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
`);
    console.log(app);
    return;
  }
  if (buildOnly) {
    console.log(binary);
    return;
  }
  const child = spawnSync(binary, forwarded, { cwd: root, stdio: 'inherit' });
  if (child.error) throw child.error;
  process.exitCode = child.status ?? 1;
})().catch(error => { console.error(error.message); process.exitCode = 1; });
