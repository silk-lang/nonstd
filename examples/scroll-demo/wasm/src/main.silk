//! The Scroll Lab in a browser tab: the document of `examples/scroll-demo` (text, photos,
//! tables, code and sticky headings, virtualized), built for wasm32 and run by
//! ui/tree/window/browser's page. `browser/` next to this package is the DOM version of the same
//! document, for comparing with what Chromium does on its own.
//!
//!   python3 ui/tree/window/scripts/browser serve examples/scroll-demo/wasm
//!
//! With `?check` in the page's address it runs the window host's rendering check, like the
//! native app's `--check`: it clicks Reverse, scrolls and compares the canvas with the CPU
//! reference of the same frame. `main` returns 0 within tolerance, 1 outside and 2 on an error.
static if Intrinsic.targetArchitecture() == "wasm32" {
  // These two modules must be in the program's own package: a dependency exports no wasm
  // symbols.
  import generated_webgpu_exports
  import libm
  import scroll_document.lib { Document, Message, resources }
  import ui_app.app { NoCommand }
  import ui_app.runtime { Runtime }
  import ui_app_window.lib { Launched, RunOptions, WindowContent, runWindowHosted }
  import ui_tree_window.browser { checkRequested }
  import ui_tree_window.console { StderrWriter }
  import ui_inspect_server.lib { Inspector }
  import ui_fixtures.fixtures as fixtures
  import ui_tree.lib { UiTree, TreeError, Batch, Input, FrameInput }
  import atlas.atlas { AtlasError }
  import vector.geometry_error { GeometryError }
  import window.types { WindowError, WindowOptions }
  import webgpu.runtime { GpuError }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.geometry.size { Size2 }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.num.f64

  /// The automatic scroll and the check's scripted scroll, as the native app's host does them.
  struct Host {
    checking: bool,
    running: bool,
    lastScroll: f64,
    frames: u64,
  }

  impl WindowContent<Document, Message, NoCommand> for Host {
    fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
      options.minSize = Option<Size2<f64>>.some(Size2<f64>.new(900.0, 600.0))
    }

    fn wakeAfter(self: &Self) -> Option<f64> {
      return if self.running {
        Option<f64>.some(1.0 / 120.0)
      } else {
        Option<f64>.None
      }
    }

    effect fn poll(
      self: &mut Self,
      app: &mut Runtime<Document, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      time: f64,
    ) -> bool
      ! WindowError | TreeError | OutOfMemoryError
      ? &mut Allocator {
      let active = app.model.automatic
      let elapsed = if self.running {
        f64.min(0.05, time - self.lastScroll)
      } else {
        0.0
      }
      self.running = active
      self.lastScroll = time
      if !active || elapsed <= 0.0 || self.frames == 0 {
        return false
      }
      let x = tree.input.width * 0.7
      let y = tree.input.height * 0.5
      run tree.dispatch(
        Input.Wheel {
          x: x,
          y: y,
          deltaX: 0.0,
          deltaY: f64.toF32(
            elapsed
              * if app.model.reverse {
                -5000.0
              } else {
                5000.0
              },
          ),
          modifiers: 0,
        },
      )
      return true
    }

    effect fn prepare(
      self: &mut Self,
      app: &mut Runtime<Document, Message, NoCommand>,
      tree: &mut UiTree<'_>,
    ) -> ()
      ! TreeError | OutOfMemoryError
      ? &mut Allocator {
      if self.checking && self.frames > 0 {
        run tree.dispatch(
          Input.Wheel { x: 900.0, y: 400.0, deltaX: 0.0, deltaY: 480.0, modifiers: 0 },
        )
      }
    }

    effect fn frame(
      self: &mut Self,
      app: &Runtime<Document, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      input: FrameInput,
      inspector: &Inspector,
    ) -> ()
      ! TreeError | AtlasError | GeometryError | OutOfMemoryError
      ? &mut Allocator {
      self.frames = self.frames + 1
    }
  }

  effect fn program(check: bool) -> i32
    ! TreeError | AtlasError | GeometryError | WindowError | GpuError | OutOfMemoryError
    ? &mut Allocator {
    let collection = run fixtures.fonts()
    let mut batch = Batch.make()
    run resources(&mut batch)
    let mut app = Runtime<Document, Message, NoCommand>.make(
      Document { sections: 100, automatic: false, reverse: false, images: true, virtualized: true },
    )
    let mut host = Host { checking: check, running: false, lastScroll: 0.0, frames: 0 }
    return run runWindowHosted(
      &mut app,
      &collection,
      run batch.take(),
      RunOptions {
        title: "Fieldnotes, Silk Scroll Lab",
        width: 1280.0,
        height: 900.0,
        check: check,
        checkClick: "Reverse",
        checkExpect: "Forward",
        lowestLatency: false,
        platform: Option<Launched>.None,
      },
      Inspector.off(),
      &mut host,
    )
  }

  effect fn gpuFailed(error: GpuError) -> i32 {
    StderrWriter.print("silk-scroll-demo-wasm: GPU error {}\n", &.(error.code))
    return 2
  }

  effect fn failed<E>(error: E) -> i32 {
    drop error
    StderrWriter.print(
      "silk-scroll-demo-wasm: failed (window, tree, atlas, geometry or allocation)\n",
      &(),
    )
    return 2
  }

  pub fn main() -> i32 {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(Effect.catch<GpuError>(program(checkRequested()), gpuFailed), failed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
} else {
  /// The browser build only; natively, run `examples/scroll-demo`.
  pub fn main() -> i32 {
    return 0
  }
}
