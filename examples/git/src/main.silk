import cli.lib { Arg, Cli, Command, Completion, Opt, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

struct Clone {
  pub url: String,
  pub depth: Option<u32>,
}

struct RemoteAdd {
  pub name: String,
  pub url: String,
}

struct Remote {
  pub verbose: bool,
  pub add: Option<RemoteAdd>,
}

struct Git {
  pub quiet: bool,
  pub completions: Option<String>,
  pub clone: Option<Clone>,
  pub remote: Option<Remote>,
}

static fn cloneCommand() -> Command {
  return Command.make("clone", "Copy a repository")
    |> Command.arg(Arg.named("url") |> Arg.describe("Where to copy from") |> Arg.required)
    |> Command.option(Opt.named("depth") |> Opt.describe("How many commits"))
}

static fn remoteCommand() -> Command {
  let add = Command.make("add", "Add a remote") |> Command.arg(Arg.named("name") |> Arg.required)
    |> Command.arg(Arg.named("url") |> Arg.required)
  return Command.make("remote", "Manage remotes")
    |> Command.option(Opt.named("verbose") |> Opt.alias("v"))
    |> Command.subcommand("add", add)
}

static fn git() -> Command {
  return Command.make("git", "A tiny git")
    |> Command.option(Opt.named("quiet") |> Opt.describe("Say less") |> Opt.alias("q"))
    |> Command.option(
    Opt.named("completions") |> Opt.describe("Print a shell completion script")
      |> Opt.choice("bash")
      |> Opt.choice("zsh")
      |> Opt.choice("fish"),
  )
    |> Command.subcommand("clone", cloneCommand())
    |> Command.subcommand("remote", remoteCommand())
}

effect fn defaults() -> Git
  ! OutOfMemoryError
  ? &mut Allocator {
  let add = RemoteAdd { name: run String.copy(""), url: run String.copy("") }
  let remote = Remote { verbose: false, add: Option<RemoteAdd>.some(move add) }
  let clone = Clone { url: run String.copy(""), depth: Option<u32>.none() }
  return Git {
    quiet: false,
    completions: Option<String>.none(),
    clone: Option<Clone>.some(move clone),
    remote: Option<Remote>.some(move remote),
  }
}

effect fn report(git: &Git) -> ()
  ! WriterError
  ? &mut Writer {
  if git.quiet {
    return
  }
  match &git.clone {
    Option.Some { value: clone } => {
      run Writer.writeString("cloning ")
      run Writer.writeString(String.view(&clone.url))
      run Writer.writeString("\n")
      return
    }
    Option.None => {}
  }
  match &git.remote {
    Option.Some { value: remote } => {
      match &remote.add {
        Option.Some { value: add } => {
          run Writer.writeString("adding remote ")
          run Writer.writeString(String.view(&add.name))
          run Writer.writeString(" at ")
          run Writer.writeString(String.view(&add.url))
          run Writer.writeString("\n")
        }
        Option.None => run Writer.writeString("listing remotes\n")
      }
      return
    }
    Option.None => {}
  }
  run Writer.writeString("nothing to do; try --help\n")
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut err = StderrWriter.make()
  let start = run defaults() |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run Cli.fromHost(git(), move start) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      match &value.completions {
        Option.Some { value: shell } => {
          if String.view(&shell) == "zsh" {
            run Completion.writeZsh<Git>(git()) |> Effect.provideMut<Writer>(&mut out)
          } else if String.view(&shell) == "fish" {
            run Completion.writeFish<Git>(git()) |> Effect.provideMut<Writer>(&mut out)
          } else {
            run Completion.writeBash<Git>(git()) |> Effect.provideMut<Writer>(&mut out)
          }
          return 0
        }
        Option.None => {}
      }
      run report(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Help { command } => {
      run Cli.writeHelp<Git>(git(), command) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Version => {
      return 0
    }
    Parsed.Failed { error } => {
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
      return 2
    }
  }
}
