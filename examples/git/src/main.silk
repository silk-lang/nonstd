import cli.lib { Arg, Cli, Command, Opt, Parsed }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.host_input { HostInput, HostInputError }
import silk.option { Option }
import silk.os_writer { StderrWriter, StdoutWriter }
import silk.string { String }
import silk.writer { Writer, WriterError }

struct Clone {
  pub url: String,
  pub depth: Option<u32>,
}

struct RemoteAdd {
  pub name: String,
  pub url: String,
}

struct Remote {
  pub verbose: bool,
  pub add: Option<RemoteAdd>,
}

struct Git {
  pub quiet: bool,
  pub clone: Option<Clone>,
  pub remote: Option<Remote>,
}

static fn cloneCommand() -> Command {
  let mut command = Command.make("clone", "Copy a repository")
  command = Command.arg(command, Arg.required(Arg.describe(Arg.named("url"), "Where to copy from")))
  command = Command.option(command, Opt.describe(Opt.named("depth"), "How many commits"))
  return command
}

static fn remoteCommand() -> Command {
  let mut add = Command.make("add", "Add a remote")
  add = Command.arg(add, Arg.required(Arg.named("name")))
  add = Command.arg(add, Arg.required(Arg.named("url")))
  let mut command = Command.make("remote", "Manage remotes")
  command = Command.option(command, Opt.alias(Opt.named("verbose"), "v"))
  command = Command.subcommand(command, "add", add)
  return command
}

static fn git() -> Command {
  let mut command = Command.make("git", "A tiny git")
  command = Command.option(command, Opt.alias(Opt.describe(Opt.named("quiet"), "Say less"), "q"))
  command = Command.subcommand(command, "clone", cloneCommand())
  command = Command.subcommand(command, "remote", remoteCommand())
  return command
}

effect fn defaults() -> Git
  ! OutOfMemoryError
  ? &mut Allocator {
  let add = RemoteAdd { name: run String.copy(""), url: run String.copy("") }
  let remote = Remote { verbose: false, add: Option<RemoteAdd>.some(move add) }
  let clone = Clone { url: run String.copy(""), depth: Option<u32>.none() }
  return Git {
    quiet: false,
    clone: Option<Clone>.some(move clone),
    remote: Option<Remote>.some(move remote),
  }
}

effect fn report(git: &Git) -> ()
  ! WriterError
  ? &mut Writer {
  if git.quiet {
    return
  }
  match &git.clone {
    Option.Some { value: clone } => {
      run Writer.writeString("cloning ")
      run Writer.writeString(String.view(&clone.url))
      run Writer.writeString("\n")
      return
    }
    Option.None => {}
  }
  match &git.remote {
    Option.Some { value: remote } => {
      match &remote.add {
        Option.Some { value: add } => {
          run Writer.writeString("adding remote ")
          run Writer.writeString(String.view(&add.name))
          run Writer.writeString(" at ")
          run Writer.writeString(String.view(&add.url))
          run Writer.writeString("\n")
        }
        Option.None => run Writer.writeString("listing remotes\n")
      }
      return
    }
    Option.None => {}
  }
  run Writer.writeString("nothing to do; try --help\n")
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut err = StderrWriter.make()
  let start = run defaults() |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run Cli.fromHost(git(), move start) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run report(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Help { command } => {
      run Cli.writeHelp<Git>(git(), command) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Version => {
      return 0
    }
    Parsed.Failed { error } => {
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
      return 2
    }
  }
}
