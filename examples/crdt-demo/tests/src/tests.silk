//! Demo tests: the editor driven through the real tree the way a person would use it, with
//! clicks and typing. Edits reach the other pane, bold applies to typed text on both replicas,
//! offline edits merge when a pane comes back, and the history bar steps back.
import demo.editor { BOLD, BODY, Editor, Message, runsOf, textOf }
import examples.look { SANS }
import ui_app.app { NoCommand }
import ui_app.harness { click, snapshot, typeText }
import ui_app.runtime { Runtime }
import ui_fixtures.fixtures as fixtures
import ui_tree.lib { Batch, FrameInput, TreeError, UiTree }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }

type Failures = AssertionError<'static> | TreeError | OutOfMemoryError

fn viewport() -> FrameInput {
  return FrameInput { width: 1000.0, height: 700.0, scale: 1.0, time: 0.0 }
}

effect fn shows(tree: &mut UiTree<'_>, part: string) -> bool
  ! TreeError | OutOfMemoryError
  ? &mut Allocator {
  let text = run snapshot(&mut tree, viewport())
  return String.contains(String.view(&text), part)
}

effect fn paneText(app: &Runtime<Editor, Message, NoCommand>, pane: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return run textOf(&app.model.panes.asSlice()[pane].document)
}

effect fn editing() -> ()
  ! Failures
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut batch = Batch.make()
  run batch.fontFamily(SANS, "Noto Sans, sans-serif")
  run tree.apply(run batch.take())
  let editor = run Editor.make()
  let mut app = Runtime<Editor, Message, NoCommand>.make(move editor)
  run app.start(&mut tree, 0.0)

  // Ada types; Grace's pane shows it.
  run Testing.expect(
    run click(&mut app, &mut tree, viewport(), "editor-0"),
    "Ada's editor is there",
  )
  run typeText(&mut app, &mut tree, viewport(), "Hello")
  let received = run paneText(&app, 1)
  run Testing.expect(received.view() == "Hello", "Grace's replica gets Ada's text")

  // Grace turns on bold and types after it: the new text is bold on both replicas.
  run Testing.expect(run click(&mut app, &mut tree, viewport(), "editor-1"), "Grace's editor")
  drop run click(&mut app, &mut tree, viewport(), "Bold")
  run Testing.expect(app.model.panes.asSlice()[0].bold, "the first Bold button is Ada's")
  drop run click(&mut app, &mut tree, viewport(), "Bold")
  run Testing.expect(!app.model.panes.asSlice()[0].bold, "clicking again turns it off")
  let grace = &mut app.model.panes.asMutSlice()[1]
  grace.bold = true
  run Testing.expect(run click(&mut app, &mut tree, viewport(), "editor-1"), "Grace's editor again")
  run typeText(&mut app, &mut tree, viewport(), " world")
  let ada = run paneText(&app, 0)
  run Testing.expect(ada.view() == "Hello world", "Ada's replica gets Grace's text")
  let runs = run runsOf(&app.model.panes.asSlice()[0].document)
  let mut boldBytes: usize = 0
  let mut r: usize = 0
  while r < runs.length() {
    let piece = runs.get(r)
    if piece.bold {
      boldBytes = boldBytes + piece.length
    }
    r = r + 1
  }
  run Testing.expect(boldBytes == 6, "the text typed with bold on is bold on the other replica")
  run Testing.expect(run shows(&mut tree, "Hello world"), "the formatted view shows the text")

  // Grace goes offline; both edit; back online the edits merge.
  let offline = &mut app.model.panes.asMutSlice()[1]
  offline.online = false
  run Testing.expect(run click(&mut app, &mut tree, viewport(), "editor-0"), "Ada's editor")
  run typeText(&mut app, &mut tree, viewport(), "!")
  run Testing.expect(run click(&mut app, &mut tree, viewport(), "editor-1"), "Grace's editor")
  run typeText(&mut app, &mut tree, viewport(), "?")
  let apart = run paneText(&app, 1)
  run Testing.expect(apart.view() == "Hello world?", "offline, Grace does not see Ada's edit")
  drop run click(&mut app, &mut tree, viewport(), "Offline")
  let merged0 = run paneText(&app, 0)
  let merged1 = run paneText(&app, 1)
  run Testing.expect(merged0.view() == merged1.view(), "back online, both replicas agree")
  run Testing.expect(
    merged0.view() == "Hello world!?" || merged0.view() == "Hello world?!",
    "and keep both edits",
  )

  // The history bar steps back through the server's deltas.
  run Testing.expect(run shows(&mut tree, "Latest version"), "history starts at the latest version")
  drop run click(&mut app, &mut tree, viewport(), "Back")
  run Testing.expect(run shows(&mut tree, "Delta "), "one step back")
  drop run click(&mut app, &mut tree, viewport(), "Latest")
  run Testing.expect(run shows(&mut tree, "Latest version"), "and back to the latest")
}

test effect fn editingTest() -> ()
  ! Failures {
  let mut allocator = Allocator.systemAllocatorProvider()
  run editing() |> Effect.provideMut<Allocator>(&mut allocator)
}
