#!/usr/bin/env python3
"""Build and run the SVG window using the workspace's pinned Silk and Dawn."""
import argparse
import os
from pathlib import Path
import runpy
import subprocess
import sys

PROJECT = Path(__file__).resolve().parent
REPO = PROJECT.parent.parent
GPU = REPO / "gpu/webgpu"
sys.path.insert(0, str(GPU / "scripts"))
from _build import build


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("svg", nargs="?", type=Path, help="SVG file (default: bundled landscape)")
    parser.add_argument("--release", action="store_true")
    parser.add_argument("--build-only", action="store_true")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("This example requires macOS and its Metal window surface.")
    source = args.svg.resolve() if args.svg else PROJECT / "sample.svg"
    if not source.is_file():
        parser.error(f"SVG file not found: {source}")
    # Reuse the existing GLFW discovery and view-owned CAMetalLayer helper.
    window = runpy.run_path(str(GPU / "scripts/window"))
    links = window["glfw_links"]()
    native = REPO / ".cache" / "svg-window-native"
    native.mkdir(parents=True, exist_ok=True)
    sdk = subprocess.check_output(["xcrun", "--show-sdk-path"], text=True).strip()
    cc = os.environ.get("SILK_CLANG", "/usr/bin/clang")
    obj = native / "metal_layer.o"
    archive = native / "libsvg_window.a"
    subprocess.run([cc, "-isysroot", sdk, "-mmacosx-version-min=26.0", "-fobjc-arc", "-O2", "-c",
                    str(GPU / "examples-window/native/metal_layer.m"), "-o", str(obj)], check=True)
    subprocess.run(["ar", "rcs", str(archive), str(obj)], check=True)
    links.append({"static-archive": str(archive)})
    executable = build(PROJECT, release=args.release, extra_links=links)
    if args.build_only:
        print(executable)
        return 0
    return subprocess.run([str(executable), str(source)], cwd=PROJECT).returncode


if __name__ == "__main__":
    raise SystemExit(main())
