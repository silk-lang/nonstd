//! The terminal view. A transparent input at the cursor receives committed text and IME input.
import ghostty.terminal { Snapshot }
import render { screen, positioned }
import ui_app.app { App, Context, NoCommand, Subscriptions }
import ui_app.ui { Ui, Reply }
import ui_app.heap { Heap }
import ui_tree.mutation { Property, Position, Overflow }
import ui_tree.input { MOD_CONTROL, MOD_ALT, MOD_META, MOD_SHIFT }
import ui_fixtures.fixtures { rgb }
import silk.collections.list { List }
import silk.text.string { String }
import silk.num.f32
import silk.num.u32
import silk.num.i32

fn owned(value: string) -> String {
  let mut heap = Heap.make()
  return heap.alloc(String.copy(value))
}

fn modifiedCharacter(mods: u32) -> bool {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    // Option stays with the macOS input method for accents and composed characters.
    return (mods & MOD_CONTROL) != 0
  } else {
    return (mods & (MOD_CONTROL | MOD_ALT)) != 0
  }
}

pub const CELL_WIDTH: f32 = 10.0

pub const CELL_HEIGHT: f32 = 22.0

pub const LEFT: f32 = 20.0

pub const TOP: f32 = 44.0

pub union Action {
  Text { pub value: String },
  Key { pub value: String, pub modifiers: u32 },
  Resize { pub columns: u16, pub rows: u16 },
  Scroll { pub rows: i64 },
  Paste,
}

pub union Message {
  Action { pub action: Action },
  Focus,
  Resize { pub width: f32, pub height: f32 },
  Frame { pub snapshot: Snapshot, pub exitCode: i32 },
  Failure { pub code: i32 },
}

pub struct TerminalApp {
  pub snapshot: Snapshot,
  pub pending: List<Action>,
  pub inputEpoch: u64,
  pub width: f32,
  pub height: f32,
  pub exitCode: i32,
  pub error: i32,
}

impl TerminalApp {
  pub fn make(snapshot: Snapshot) -> TerminalApp {
    return TerminalApp {
      snapshot: move snapshot,
      pending: List<Action>.make(),
      inputEpoch: 1,
      width: 1000.0,
      height: 680.0,
      exitCode: -1,
      error: 0,
    }
  }
}

impl App<Message, NoCommand> for TerminalApp {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    ui.background(rgb(0x10151d))
    ui.color(rgb(0x8994a3))
    ui.fontSize(12.0)
    ui.style(
      &[
        Property.Position { value: Position.Relative },
        Property.FontFamily { family: 1 },
        Property.OverflowX { value: Overflow.Hidden },
        Property.OverflowY { value: Overflow.Hidden },
      ],
    )
    ui.box(
      |ui| {
        positioned(&mut ui, LEFT, 12.0, 500.0, 20.0)
        ui.text("TERMINAL   /   local session")
      },
    )
    ui.box(
      |ui| {
        positioned(
          &mut ui,
          LEFT,
          TOP,
          u32.toF32(self.snapshot.columns()) * CELL_WIDTH,
          u32.toF32(self.snapshot.rows()) * CELL_HEIGHT,
        )
        ui.testId("terminal-screen")
        ui.label("Terminal")
        ui.onClick(|| Message.Focus)
        screen(&mut ui, &self.snapshot)
        let cursor = self.snapshot.cursor()
        ui.key(self.inputEpoch)
        ui.input(
          "",
          |ui| {
            ui.testId("terminal-input")
            ui.label("Terminal input")
            positioned(
              &mut ui,
              u32.toF32(cursor.column) * CELL_WIDTH,
              u32.toF32(cursor.row) * CELL_HEIGHT,
              CELL_WIDTH,
              CELL_HEIGHT,
            )
            ui.style(&[Property.Opacity { value: 0.0 }])
            ui.takeFocus()
            ui.onInput(|value| Message.Action { action: Action.Text { value: move value } })
            ui.onKeyDown(
              |event| {
                let name = event.key.view()
                let mods = event.modifiers
                let paste = (mods & MOD_META) != 0 && (name == "v" || name == "V")
                  || (mods & (MOD_CONTROL | MOD_SHIFT)) == (MOD_CONTROL | MOD_SHIFT)
                    && (name == "v" || name == "V")
                if paste {
                  return Reply<Message>.EmitAndStop {
                    message: Message.Action { action: Action.Paste }
                  }
                }
                if name == "PageUp" && (mods & MOD_SHIFT) != 0 {
                  return Reply<Message>.EmitAndStop {
                    message: Message.Action { action: Action.Scroll { rows: -10 } }
                  }
                }
                if name == "PageDown" && (mods & MOD_SHIFT) != 0 {
                  return Reply<Message>.EmitAndStop {
                    message: Message.Action { action: Action.Scroll { rows: 10 } }
                  }
                }
                if name == "Shift" || name == "Control" || name == "Alt" || name == "Meta"
                  || name == "CapsLock" {
                  return Reply<Message>.Pass
                }
                if (mods & MOD_META) != 0 {
                  return Reply<Message>.Pass
                }
                if String.byteLength(name) > 1
                  && (name == "Enter" || name == "Tab" || name == "Backspace" || name == "Escape"
                    || name == "Delete"
                    || name == "Insert"
                    || name == "Home"
                    || name == "End"
                    || name == "PageUp"
                    || name == "PageDown"
                    || name == "ArrowUp"
                    || name == "ArrowDown"
                    || name == "ArrowLeft"
                    || name == "ArrowRight"
                    || String.utf8Bytes(name)[0] == 70)
                  || modifiedCharacter(mods) {
                  return Reply<Message>.EmitAndStop {
                    message: Message.Action {
                      action: Action.Key { value: owned(name), modifiers: mods },
                    }
                  }
                }
                return Reply<Message>.Pass
              },
            )
          },
        )
      },
    )
    ui.box(
      |ui| {
        positioned(&mut ui, LEFT, self.height - 27.0, self.width - 40.0, 18.0)
        if self.error != 0 {
          ui.color(rgb(0xe6a080))
          ui.text("Session error: ")
          ui.number(i32.toI64(self.error))
        } else if self.exitCode >= 0 {
          ui.text("Process exited · status ")
          ui.number(i32.toI64(self.exitCode))
        } else {
          ui.text(
            "PTY connected   ·   Ctrl-C interrupt   ·   Cmd-V / Ctrl-Shift-V paste   ·   Shift-PgUp scrollback",
          )
        }
      },
    )
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Action { action } => {
        self.inputEpoch = self.inputEpoch + 1
        if self.error == 0 {
          cx.alloc(self.pending.append(move action))
        }
      }
      Message.Focus => {
        self.inputEpoch = self.inputEpoch + 1
      }
      Message.Resize { width, height } => {
        self.width = width
        self.height = height
        let columns = f32.toU32(
          f32.max(2.0, f32.min(300.0, f32.floor((width - 40.0) / CELL_WIDTH))),
        )
        let rows = f32.toU32(f32.max(2.0, f32.min(150.0, f32.floor((height - 80.0) / CELL_HEIGHT))))
        if columns != self.snapshot.columns() || rows != self.snapshot.rows() {
          cx.alloc(
            self.pending.append(
              Action.Resize { columns: u32.toU16(columns), rows: u32.toU16(rows) },
            ),
          )
        }
      }
      Message.Frame { snapshot, exitCode } => {
        self.snapshot = move snapshot
        self.exitCode = exitCode
      }
      Message.Failure { code } => {
        self.error = code
      }
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    subs.resize(1, |width, height| Message.Resize { width: width, height: height })
  }
}
