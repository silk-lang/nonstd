//! Cell renderer shared by the native host and deterministic rendering checks.
import terminal_app { Message, CELL_WIDTH, CELL_HEIGHT }
import ghostty.terminal { Snapshot, Cell, BOLD, ITALIC, FAINT, INVERSE, INVISIBLE, UNDERLINE_MASK }
import ui_app.ui { Ui }
import ui_tree.mutation { Property, Position, Side, Length, LineHeight, WhiteSpace, FontStyle }
import ui_fixtures.fixtures { rgb }
import silk.core.option { Option }
import silk.num.u32

pub fn positioned(ui: &mut Ui<Message>, x: f32, y: f32, width: f32, height: f32) -> () {
  ui.style(
    &[
      Property.Position { value: Position.Absolute },
      Property.Inset { side: Side.Left, value: Length.px(x) },
      Property.Inset { side: Side.Top, value: Length.px(y) },
      Property.Width { value: Length.px(width) },
      Property.Height { value: Length.px(height) },
    ],
  )
}

pub fn screen(ui: &mut Ui<Message>, frame: &Snapshot) -> () {
  ui.box(
    |ui| {
      ui.testId("terminal-cells")
      ui.label("Terminal viewport")
      ui.width(Length.px(u32.toF32(frame.columns()) * CELL_WIDTH))
      ui.height(Length.px(u32.toF32(frame.rows()) * CELL_HEIGHT))
      ui.background(rgb(frame.background()))
      ui.style(
        &[
          Property.Position { value: Position.Relative },
          Property.FontFamily { family: 2 },
          Property.FontSize { value: 15.0 },
          Property.LineHeight { value: LineHeight.Px { value: CELL_HEIGHT } },
          Property.WhiteSpace { value: WhiteSpace.Pre },
          Property.FlexShrink { value: 0.0 },
        ],
      )
      let mut y: u32 = 0
      while y < frame.rows() {
        let mut x: u32 = 0
        while x < frame.columns() {
          if let Option<Cell<'_>>.Some { value: cell } = frame.cell(x, y) {
            let inverse = (cell.flags & INVERSE) != 0
            let foreground = if inverse {
              cell.background
            } else {
              cell.foreground
            }
            let background = if inverse {
              cell.foreground
            } else {
              cell.background
            }
            if cell.width != 0 && (cell.text != "" || background != frame.background()) {
              ui.box(
                |ui| {
                  positioned(
                    &mut ui,
                    u32.toF32(x) * CELL_WIDTH,
                    u32.toF32(y) * CELL_HEIGHT,
                    u32.toF32(cell.width) * CELL_WIDTH,
                    CELL_HEIGHT,
                  )
                  ui.background(rgb(background))
                  ui.color(rgb(foreground))
                  if (cell.flags & BOLD) != 0 {
                    ui.style(&[Property.FontWeight { value: 700.0 }])
                  }
                  if (cell.flags & ITALIC) != 0 {
                    ui.style(&[Property.FontStyle { value: FontStyle.Italic }])
                  }
                  if (cell.flags & FAINT) != 0 {
                    ui.style(&[Property.Opacity { value: 0.6 }])
                  }
                  if (cell.flags & INVISIBLE) == 0 {
                    ui.text(cell.text)
                  }
                  if (cell.flags & UNDERLINE_MASK) != 0 {
                    ui.box(
                      |ui| {
                        positioned(
                          &mut ui,
                          0.0,
                          CELL_HEIGHT - 2.0,
                          u32.toF32(cell.width) * CELL_WIDTH,
                          1.0,
                        )
                        ui.background(rgb(foreground))
                      },
                    )
                  }
                },
              )
            }
          }
          x = x + 1
        }
        y = y + 1
      }
      let cursor = frame.cursor()
      if cursor.visible {
        ui.box(
          |ui| {
            positioned(
              &mut ui,
              u32.toF32(cursor.column) * CELL_WIDTH,
              u32.toF32(cursor.row) * CELL_HEIGHT + CELL_HEIGHT - 3.0,
              CELL_WIDTH,
              2.0,
            )
            ui.background(rgb(0xc9d1d9))
          },
        )
      }
    },
  )
}
