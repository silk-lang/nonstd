//! The script the showcase plays: six people write one launch plan at the same time, two of them
//! drop offline and keep editing, and everything merges when they come back.
//!
//! The script only says who presses which key when. What happens to the text, where each caret
//! ends up and how the copies merge is all the CRDT's doing.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The number of people.
pub const PLAYERS: usize = 6

/// Mark keys.
pub const BOLD: u32 = 1

pub const UNDERLINE: u32 = 2

/// How long the script runs, in seconds, the closing shot included.
pub const LENGTH: f64 = 19.0

/// Person `index`'s name.
pub fn playerName(index: usize) -> string<'static> {
  let names: [string<'static>; 6] = ["Ada", "Grace", "Linus", "Margaret", "Alan", "Barbara"]
  return names[index]
}

/// Person `index`'s hue, in degrees.
pub fn playerHue(index: usize) -> f32 {
  let hues: [f32; 6] = [330.0, 200.0, 140.0, 40.0, 270.0, 10.0]
  return hues[index]
}

/// What one person does at one moment.
pub union Action {
  /// Types one byte at the caret.
  Key { pub byte: u8 },
  /// Moves the caret to the end of the document.
  End,
  /// Moves the caret just after the first `text`.
  After { pub text: string<'static> },
  /// Deletes the first `text`, leaving the caret where it was.
  Erase { pub text: string<'static> },
  /// Gives the first `text` the style `key`.
  Style { pub text: string<'static>, pub key: u32 },
  Offline,
  Online,
}

impl Copy for Action {}

/// An action at a time, in seconds from the start.
pub struct Step {
  pub time: f64,
  pub player: usize,
  pub action: Action,
}

impl Copy for Step {}

// A small deterministic generator, so every run types with the same rhythm.
struct Random {
  state: u64,
}

impl Random {
  fn unit(self: &mut Self) -> f64 {
    let mut x = self.state
    x = u64.bitXor(x, u64.shiftLeft(x, 13))
    x = u64.bitXor(x, u64.shiftRight(x, 7))
    x = u64.bitXor(x, u64.shiftLeft(x, 17))
    self.state = x
    return u64.toF64(u64.bitAnd(x, 1048575)) / 1048576.0
  }
}

struct Script {
  steps: List<Step>,
  random: Random,
}

impl Script {
  effect fn at(self: &mut Self, time: f64, player: usize, action: Action) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.steps.append(Step { time: time, player: player, action: action })
  }

  // Types `text` from `start`, a key every `gap` seconds give or take, with a longer beat after
  // a space. Returns when the last key lands.
  effect fn keys(self: &mut Self, start: f64, player: usize, text: string<'static>, gap: f64) -> f64
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(text)
    let mut time = start
    let mut k: usize = 0
    while k < bytes.length {
      run self.at(time, player, Action.Key { byte: bytes[k] })
      let mut step = gap * (0.55 + 0.9 * self.random.unit())
      if bytes[k] == 32 {
        step = step + gap * 0.8 * self.random.unit()
      }
      time = time + step
      k = k + 1
    }
    return time
  }
}

/// Every step of the script, in time order.
pub effect fn steps() -> List<Step>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut script = Script { steps: List<Step>.make(), random: Random { state: 88172645463325252 } }

  // Ada starts the document and makes the title bold.
  drop run script.keys(0.5, 0, "Launch plan", 0.06)
  run script.at(1.35, 0, Action.Style { text: "Launch plan", key: BOLD })

  // Everyone adds a line at once. Each line starts at the end of the document and grows from
  // its author's caret, so the lines never mix even though they are typed side by side.
  let lines: [string<'static>; 6] = [
    "\n- Ship the rich text editor",
    "\n- Write the release notes",
    "\n- Fix the flaky sync test",
    "\n- Review the merge rules",
    "\n- Record the demo video",
    "\n- Bake a cake for the team",
  ]
  let mut p: usize = 0
  while p < PLAYERS {
    let start = 1.7 + usize.toF64(p) * 0.28
    run script.at(start, p, Action.End)
    drop run script.keys(start, p, lines[p], 0.075)
    p = p + 1
  }

  // Grace and Linus lose their connection and keep working.
  run script.at(6.4, 1, Action.Offline)
  run script.at(6.6, 2, Action.Offline)

  // Both add to the title at the same spot. Neither sees the other's words yet.
  run script.at(7.0, 1, Action.After { text: "Launch plan" })
  drop run script.keys(7.0, 1, " for Friday", 0.085)
  run script.at(7.3, 2, Action.After { text: "Launch plan" })
  drop run script.keys(7.3, 2, " (v2)", 0.1)
  run script.at(8.6, 2, Action.After { text: "flaky sync test" })
  drop run script.keys(8.6, 2, " on Windows", 0.08)
  run script.at(9.2, 1, Action.After { text: "release notes" })
  drop run script.keys(9.2, 1, " tonight", 0.085)

  // The others carry on online.
  run script.at(7.4, 0, Action.Style { text: "rich text", key: BOLD })
  run script.at(7.9, 3, Action.After { text: "merge rules" })
  run script.at(7.9, 3, Action.Erase { text: "rules" })
  drop run script.keys(8.3, 3, "edge cases", 0.08)
  run script.at(8.8, 5, Action.After { text: "for the team" })
  drop run script.keys(8.8, 5, " with sprinkles", 0.075)
  run script.at(9.8, 4, Action.Style { text: "demo video", key: UNDERLINE })
  run script.at(10.3, 0, Action.End)
  drop run script.keys(10.3, 0, "\n- Celebrate!", 0.08)

  // Back online: their edits merge in, and theirs pick up everyone else's.
  run script.at(12.0, 1, Action.Online)
  run script.at(13.0, 2, Action.Online)
  run script.at(14.0, 3, Action.Style { text: "edge cases", key: BOLD })

  sortByTime(&mut script.steps)
  return move script.steps
}

// Insertion sort, stable, so steps at one time keep the order they were written in.
fn sortByTime(steps: &mut List<Step>) -> () {
  let slice = steps.asMutSlice()
  let mut i: usize = 1
  while i < slice.length {
    let item = slice[i]
    let mut j = i
    while j > 0 && slice[j - 1].time > item.time {
      slice[j] = slice[j - 1]
      j = j - 1
    }
    slice[j] = item
    i = i + 1
  }
}
