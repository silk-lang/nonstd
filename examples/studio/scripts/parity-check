#!/usr/bin/env node
(async () => {
  const { assert, fs, path, root, studio, options, binary, launch, stop, inspector, temporary, primary, sleep } = await import('./internal.mjs');
  const { values: args } = options('Exercise native Studio controls through user-equivalent inspector input.\nUses an isolated copy of the browser fixture at both desktop viewport sizes, with screenshots and semantic snapshots.\nBuild Studio --release --bundle first.', {
    app: { type: 'string' }, artifacts: { type: 'string', default: path.join(root, 'build/native-parity') },
  });
  const app = args.app ? path.resolve(args.app) : binary('silk-studio-native-app');
  for (const [width, height] of [[1440, 960], [1000, 700]]) {
    const output = path.resolve(args.artifacts, `${width}x${height}`);
    fs.mkdirSync(output, { recursive: true });
    const directory = temporary('studio-parity-');
    const document = path.join(directory, 'review.silkdesign');
    const address = path.join(directory, 'ui.sock');
    const log = path.join(output, 'app.log');
    let child;
    try {
      fs.copyFileSync(path.join(studio, 'tests/explorations.silkdesign'), document);
      child = launch(app, ['--inspect', `--width=${width}`, `--height=${height}`, document], log, { env: { ...process.env, SILK_UI_INSPECT: address } });
      const ask = inspector(address, 45000);
      const query = (role, label) => ask('query', { role, label, exact: true });
      const click = async (label, role = 'button') => {
        const nodes = (await query(role, label)).nodes;
        if (nodes.length && nodes[0].x > width - 255 && nodes[0].y > height - 60) {
          await ask('scroll', { x: width - 80, y: height * .6, dx: 0, dy: nodes[0].y - height * .5 });
        }
        return ask('click', { role, label, exact: true });
      };
      const press = (key, modifiers = []) => ask('press', { key, modifiers });
      const edit = async (label, value) => {
        const node = (await query('textbox', label)).nodes[0];
        if (node.x > width - 255 && (node.y < 110 || node.y > height - 60)) {
          await ask('scroll', { x: width - 80, y: height * .6, dx: 0, dy: node.y - height * .5 });
        }
        await click(label, 'textbox');
        await press('a', [primary]);
        await press('Backspace');
        if (value) await ask('type', { text: value });
        await press('Enter');
      };
      const value = async label => {
        const text = (await ask('snapshot', { role: 'textbox', label, exact: true })).text;
        const values = [...text.matchAll(/"((?:[^"\\]|\\.)*)"/g)];
        assert.ok(values.length, text);
        return values.at(-1)[1];
      };
      const capture = async name => {
        // Move away so incidental tooltips do not obscure the captured state.
        await ask('pointer', { phase: 'move', x: width * .5, y: 100 });
        fs.writeFileSync(path.join(output, `${name}.png`), Buffer.from((await ask('screenshot', { maxWidth: 1280 })).png, 'base64'));
        fs.writeFileSync(path.join(output, `${name}.txt`), (await ask('snapshot')).text);
      };
      const canvas = async () => (await ask('query', { testId: 'canvas' })).nodes[0];
      const deadline = performance.now() + 40000;
      for (;;) {
        if (child.failure) throw child.failure;
        assert.ok(child.exitCode === null && child.signalCode === null, fs.readFileSync(log, 'utf8'));
        try {
          if ((await ask('hello')).frame > 0) break;
        } catch (error) {
          if (!['ENOENT', 'ECONNREFUSED'].includes(error.code)) throw error;
        }
        assert.ok(performance.now() < deadline, 'Inspector did not start');
        await sleep(50);
      }
      let c = await canvas();
      assert.equal(c.x, width > 1100 ? 224 : 190, JSON.stringify(c));
      assert.equal(c.width, width > 1100 ? width - 476 : width - 415, JSON.stringify(c));
      await capture('page');
      await click('Collapse layer');
      assert.equal((await ask('query', { label: 'Expand layer', exact: true })).count, 1);
      assert.equal((await ask('query', { label: 'Layer name', exact: true })).count, 0);
      await click('Expand layer');
      await edit('Find a layer', 'sUN');
      await click('Sun');
      assert.equal(await value('Width'), '112');
      await edit('Find a layer', '');
      await capture('ellipse');
      await edit('Width', '160');
      assert.equal(await value('Width'), '160');
      await click('Undo');
      assert.equal(await value('Width'), '112');
      await edit('Fill', '112233');
      assert.equal(await value('Fill'), '112233');
      await click('Undo');
      assert.equal(await value('Fill'), 'E6B84E');
      await click('Fill color');
      await capture('color');
      await click('Red', 'slider');
      await press('Home');
      await press('End');
      await press('Escape');
      assert.equal(await value('Fill'), 'FFB84E');
      await click('Undo');
      assert.equal(await value('Fill'), 'E6B84E', 'Picker changes must be one history entry');
      await click('Commands');
      await edit('Search commands', 'dUPLICATE selection');
      assert.equal(await value('Layer name'), 'Sun');
      // Enter in edit() executed the first matching command.
      await edit('Find a layer', 'Sun');
      assert.equal((await query('button', 'Sun')).count, 2);
      await click('Undo');
      await edit('Find a layer', '');
      await click('Commands');
      await click('Search commands', 'textbox');
      await ask('type', { text: 'fit' });
      await capture('commands');
      await press('Escape');
      assert.equal(await value('Layer name'), 'Sun', 'Closing a menu must retain selection');
      assert.ok((await query('button', 'Commands')).nodes[0].focused, 'Dialog restores trigger focus');
      await click('Keyboard shortcuts');
      await capture('shortcuts');
      await press('Escape');
      await click('File');
      await capture('file');
      await press('Escape');
      await edit('Find a layer', 'Sun');
      await click('Hide Sun');
      assert.equal((await query('button', 'Show Sun')).count, 1);
      await click('Undo');
      await click('Lock Sun');
      assert.equal((await query('button', 'Unlock Sun')).count, 1);
      await click('Undo');
      await edit('Find a layer', 'Explore button');
      await click('Explore button');
      for (const [label, newValue] of [['Stroke width', '3'], ['Layer blur', '2'], ['Backdrop blur', '4'], ['Brightness %', '120'], ['Shadow blur', '8'], ['Inner blur', '3']]) {
        const before = await value(label);
        await edit(label, newValue);
        assert.equal(await value(label), newValue, label);
        await capture('property-' + label.toLowerCase().replaceAll(' ', '-').replaceAll('%', 'percent'));
        await click('Undo');
        assert.equal(await value(label), before, label);
      }
      await ask('scroll', { x: width - 80, y: height * .6, dx: 0, dy: -10000 });
      await edit('Find a layer', 'Make room');
      await click('Make room');
      await capture('typography');
      await click('Font family');
      await press('ArrowDown');
      await press('Enter');
      await click('Undo');
      await click('Font weight');
      await press('End');
      await press('Enter');
      await click('Undo');
      await edit('Find a layer', '');
      await edit('Zoom percentage', '100');
      assert.equal(await value('Zoom percentage'), '100%');
      await click('Fit');
      c = await canvas();
      const zoom = Math.min(2, (c.width - 120) / 860, (c.height - 160) / 560);
      const left = c.x + (c.width - 860 * zoom) * .5;
      const top = 56 + (c.height - 560 * zoom) * .5;
      const x = left + 120 * zoom, y = top + 150 * zoom;
      await ask('pointer', { phase: 'down', x, y, count: 2 });
      await ask('pointer', { phase: 'up', x, y, count: 2 });
      assert.equal((await query('textbox', 'Edit text')).count, 1);
      await click('Edit text', 'textbox');
      await press('a', [primary]);
      await ask('type', { text: 'Do not commit this' });
      await press('Escape');
      assert.equal(await value('Text'), 'Make room');
      await capture('text-cancelled');
      await edit('Find a layer', 'Swatch');
      await click('Swatch 1');
      await ask('key', { phase: 'down', key: 'Shift', code: 'ShiftLeft' });
      await click('Swatch 2');
      await ask('key', { phase: 'up', key: 'Shift', code: 'ShiftLeft' });
      const multiple = async () => assert.ok((await ask('snapshot')).text.includes('2 layers selected'));
      await multiple();
      await capture('multi-selection');
      const before = await value('X');
      await click('Align left');
      await click('Undo');
      assert.equal(await value('X'), before);
      await multiple();
      const beforeX = Number(await value('X'));
      await press('ArrowRight');
      assert.equal(Number(await value('X')), beforeX + 1);
      await click('Undo');
      await press('c', [primary]);
      await press('x', [primary]);
      assert.equal((await query('button', 'Swatch 1')).count, 0);
      await press('v', [primary]);
      assert.equal((await query('button', 'Swatch 1')).count, 1);
      await click('Undo');
      await click('Undo');
      await multiple();
      await press('g', [primary]);
      await capture('group');
      assert.equal(await value('Layer name'), 'Group');
      await press('g', [primary, 'shift']);
      await multiple();
      await click('Undo');
      await click('Undo');
      const swatches = async () => (await ask('query', { role: 'button', label: 'Swatch' })).nodes
        .filter(node => node.name.startsWith('Swatch ')).map(node => node.name);
      const beforeOrder = await swatches();
      await press(']', [primary]);
      assert.notDeepEqual(await swatches(), beforeOrder);
      await click('Undo');
      assert.deepEqual(await swatches(), beforeOrder);
      await ask('pointer', { phase: 'down', x: c.x + 20, y: 100 });
      await ask('pointer', { phase: 'up', x: c.x + 20, y: 100 });
      await press('Tab');
      const hidden = await canvas();
      assert.equal(hidden.x, 0);
      assert.equal(hidden.width, width);
      await capture('panels-hidden');
      await press('Tab');
      assert.equal((await canvas()).x, c.x);
      await edit('Find a layer', 'no matching layer');
      await capture('empty-search');
      assert.ok((await ask('snapshot')).text.includes('No matching layers'));
      await edit('Find a layer', '');
      await click('Add page');
      assert.notEqual(await value('Page name'), 'Explorations');
      await capture('new-page');
      await click('Delete this page');
      assert.equal(await value('Page name'), 'Explorations');
      console.log(`PASS: ${width}x${height} parity interactions and captures`);
    } finally {
      await stop(child, 10000);
      fs.rmSync(directory, { recursive: true, force: true });
    }
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
