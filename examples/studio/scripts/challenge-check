#!/usr/bin/env node
(async () => {
  const { assert, fs, path, root, options, binary, launch, stop, inspector, ready, temporary, primary, summary } = await import('./internal.mjs');
  const { values: args } = options('Exercise 100k tweet cards through native user-event dispatch, without recording.\nBuild Studio --release --build-only first. Uses a fresh isolated document.\nMeasures request-to-composed-frame latency, NOT presentation FPS.', {
    directory: { type: 'string', default: '/tmp/silk-native-tweet' }, 'leave-open': { type: 'boolean' },
  });
  const directory = path.resolve(args.directory);
  fs.mkdirSync(directory, { recursive: true });
  const program = binary('silk-studio-native-app');
  const session = temporary('silk-native-tweet-');
  const address = path.join(session, 'ui.sock');
  const document = path.join(session, 'challenge.silkdesign');
  const log = path.join(directory, 'app.log');
  let child;
  try {
    child = launch(program, ['--inspect', document], log, { env: { ...process.env, SILK_UI_INSPECT: address }, detached: true });
    if (child.pid !== undefined) fs.writeFileSync(path.join(directory, 'pid'), String(child.pid));
    fs.writeFileSync(path.join(directory, 'document-path'), document + '\n');
    const ask = inspector(address, 120000);
    const click = (name, role = 'button') => ask('click', { role, name, exact: true });
    const edit = async (name, value) => {
      await click(name, 'textbox');
      await ask('press', { key: 'a', code: 'KeyA', modifiers: [primary] });
      if (value) await ask('type', { text: value });
      else await ask('press', { key: 'Backspace' });
      await ask('press', { key: 'Enter' });
    };
    const initial = await ready(child, ask, log);
    await click('Commands');
    const started = performance.now();
    await edit('Search commands', 'Add 100k image + text cards');
    await ask('hello');
    const result = {
      description: '100k editable groups, 100k image crops, 100k labels; one source image; three fonts',
      creationOrOpenMs: performance.now() - started, scale: initial.scale,
      metric: 'Inspector event through composed-frame acknowledgment, including IPC; not presentation FPS',
    };
    console.log('PASS: challenge page opens');
    for (const trial of ['coldZoom', 'warmZoom']) {
      await click('Fit');
      const samples = [];
      let previous = (await ask('hello')).frame;
      for (let index = 0; index < 120; index++) {
        const start = performance.now();
        await ask('scroll', { x: 740, y: 550, dx: 0, dy: index < 60 ? -17.5 : 16.35514, modifiers: ['control'] });
        const frame = (await ask('hello')).frame;
        assert.ok(frame > previous, 'Zoom did not compose a new frame');
        previous = frame;
        samples.push(performance.now() - start);
      }
      result[trial] = summary(samples, { upperMedian: true });
      console.log(trial, result[trial]);
    }
    await click('Fit');
    const samples = [];
    for (let index = 0; index < 40; index++) {
      const start = performance.now();
      await ask('scroll', { x: 740, y: 550, dx: index < 20 ? 6 : -6, dy: 0 });
      await ask('hello');
      samples.push(performance.now() - start);
    }
    result.pan = summary(samples, { upperMedian: true });
    // Empty-space start, then span cards: even unchanged selection must repaint.
    await click('Fit');
    await ask('pointer', { phase: 'down', x: 225, y: 850 });
    let previous = (await ask('hello')).frame;
    for (let index = 0; index < 20; index++) {
      await ask('pointer', { phase: 'move', x: 300 + index * 35, y: 800 - index * 10 });
      const frame = (await ask('hello')).frame;
      assert.ok(frame > previous, 'Marquee froze');
      previous = frame;
    }
    await ask('pointer', { phase: 'up', x: 965, y: 610 });
    await ask('press', { key: 'Escape' });
    await edit('Find a layer', 'Label');
    const targets = (await ask('query', { role: 'button', name: 'Label', exact: true, limit: 1 })).nodes;
    assert.ok(targets.length, 'No independently selectable label');
    await ask('click', { node: targets[0].id });
    await click('Commands');
    await edit('Search commands', 'Zoom to selection');
    await ask('hello');
    const handles = (await ask('query', { label: 'Resize handle', exact: true })).nodes;
    assert.ok(handles.length, 'No resize handles');
    const x = (Math.min(...handles.map(h => h.x)) + Math.max(...handles.map(h => h.x))) / 2 + 4;
    const y = (Math.min(...handles.map(h => h.y)) + Math.max(...handles.map(h => h.y))) / 2 + 4;
    await ask('click', { x, y, count: 2 });
    assert.equal((await ask('query', { role: 'textbox', label: 'Edit text', exact: true })).count, 1);
    await edit('Edit text', 'Native zoom test');
    assert.ok((await ask('snapshot', { role: 'textbox', label: 'Text' })).text.includes('Native zoom test'));
    await click('Undo');
    assert.ok(!(await ask('snapshot', { role: 'textbox', label: 'Text' })).text.includes('Native zoom test'));
    await edit('Find a layer', '');
    await ask('press', { key: 'Escape' });
    await click('Fit');
    result.interactionChecks = ['zoom', 'pan', 'marquee redraw', 'direct text entry', 'undo'];
    fs.writeFileSync(path.join(directory, 'results.json'), JSON.stringify(result, null, 2) + '\n');
    console.log('PASS: native zoom, pan, marquee, direct text edit and undo');
    console.log(path.join(directory, 'results.json'));
  } finally {
    if (args['leave-open'] && child && !child.failure && child.exitCode === null && child.signalCode === null) {
      child.unref();
      console.log(`Isolated document retained: ${document}`);
    } else {
      await stop(child, 10000);
      fs.rmSync(session, { recursive: true, force: true });
    }
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
