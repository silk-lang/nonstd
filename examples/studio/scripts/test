#!/usr/bin/env node
(async () => {
  const { assert, fs, path, root, studio, run, build, options, temporary } = await import('./internal.mjs');
  const { values: args } = options('Run Studio contracts and CPU workload timings; use --release for timings.\nOn macOS, set SILK_CLANG to an absolute LLVM 22 clang path for the SDK linker workaround.', {
    release: { type: 'boolean' },
  });
  const directory = temporary('silk-studio-test-');
  const original = process.env.SILK_CLANG;
  try {
    if (process.platform === 'darwin') {
      assert.ok(original && path.isAbsolute(original) && fs.statSync(original).isFile(), 'Set SILK_CLANG to an absolute LLVM 22 clang path');
      const wrapper = path.join(directory, 'clang');
      // The generated libSystem stub omits math symbols used by the CPU renderer.
      // Keep compile/probe invocations unchanged; link against the installed macOS SDK.
      fs.writeFileSync(wrapper, `#!${process.execPath}
(async () => {
  const { spawnSync } = await import('node:child_process');
  const args = process.argv.slice(2);
  if (!args.some(arg => ['-c', '--version', '-v', '-E', '-S'].includes(arg))) {
    for (let i = args.length - 2; i >= 0; i--) {
      if (args[i] === '-L' && args[i + 1].includes('/.silk--')) args.splice(i, 2);
    }
  }
  const result = spawnSync(${JSON.stringify(original)}, args, { stdio: 'inherit' });
  if (result.error) { console.error(result.error); process.exitCode = 1; }
  else if (result.signal) process.kill(process.pid, result.signal);
  else process.exitCode = result.status;
})().catch(error => { console.error(error); process.exitCode = 1; });
`, { mode: 0o755 });
      process.env.SILK_CLANG = wrapper;
    }
    const program = build(path.join(studio, 'tests'), { release: args.release });
    run(program, [], { cwd: root, timeout: 300000 });
  } finally {
    if (original === undefined) delete process.env.SILK_CLANG;
    else process.env.SILK_CLANG = original;
    fs.rmSync(directory, { recursive: true, force: true });
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
