#!/usr/bin/env node
(async () => {
  const { assert, fs, path, root, run, options, binary, launch, stop, waitForExit, inspector, ready, temporary, primary, sleep } = await import('./internal.mjs');
  const { values: args } = options('Drive isolated release Studio through its inspector, without OS clicks or model shortcuts.\nBuild Studio, ui-inspect-cli and ui-inspect-mcp in release mode first.\nArtifacts include ten-frame marquee/resize mosaics, whole-app screenshot and MCP image/timings.\n--stress adds and exercises the 100k page through the command menu.', {
    app: { type: 'string' }, cli: { type: 'string' }, mcp: { type: 'string' },
    artifacts: { type: 'string', default: path.join(root, 'build/native-inspector-check') }, stress: { type: 'boolean' },
  });
  const app = args.app ? path.resolve(args.app) : binary('silk-studio-native-app');
  const cli = args.cli ? path.resolve(args.cli) : binary('ui-inspect-cli');
  const mcp = args.mcp ? path.resolve(args.mcp) : binary('ui-inspect-mcp');
  const artifacts = path.resolve(args.artifacts);
  fs.mkdirSync(artifacts, { recursive: true });
  const directory = temporary('silk-inspect-');
  const address = path.join(directory, 'ui.sock');
  const log = path.join(artifacts, 'app.log');
  let child, capture;
  try {
    child = launch(app, ['--inspect', path.join(directory, 'test.silkdesign')], log, { env: { ...process.env, SILK_UI_INSPECT: address } });
    const ask = inspector(address);
    await ready(child, ask, log, { layout: true });
    const point = (phase, x, y) => ask('pointer', { phase, x, y });
    const click = name => ask('click', { role: 'button', name, exact: true });
    const captureSequence = (image, output) => launch(cli, ['--connect', address, 'capture', path.join(artifacts, image),
      '--count', '10', '--interval', '100', '--columns', '5', '--tile-width', '480', '--test-id', 'canvas'], path.join(artifacts, output));

    await point('down', 250, 100);
    capture = captureSequence('marquee.png', 'sequence.txt');
    const frames = [];
    for (let index = 0; index < 10; index++) {
      await point('move', 310 + index * 55, 125 + index * 2);
      frames.push((await ask('hello')).frame);
      assert.equal((await ask('query', { role: 'textbox', label: 'Layer name' })).count, 0, 'Expected an empty marquee');
      await sleep(100);
    }
    await point('up', 805, 143);
    assert.equal(await waitForExit(capture, 45000), 0, fs.readFileSync(path.join(artifacts, 'sequence.txt'), 'utf8'));
    assert.ok(frames.slice(1).every((frame, i) => frame > frames[i]), JSON.stringify(frames));
    assert.ok((await ask('hello')).frame > frames.at(-1), 'Release did not repaint');
    console.log('PASS: empty marquee advances on all ten moves and clears on release');

    await ask('key', { phase: 'down', key: ' ', code: 'Space' });
    await point('down', 500, 140);
    await point('move', 570, 160);
    await point('up', 570, 160);
    await ask('key', { phase: 'up', key: ' ', code: 'Space' });
    await click('Fit');
    await click('Rectangle');
    await point('down', 450, 300);
    await point('move', 560, 380);
    await point('up', 560, 380);
    const width = async () => (await ask('snapshot', { role: 'textbox', label: 'Width' })).text;
    const original = await width();
    await ask('click', { role: 'textbox', label: 'Width' });
    await ask('press', { key: 'a', code: 'KeyA', modifiers: [primary] });
    await ask('type', { text: '240' });
    await ask('press', { key: 'Enter' });
    assert.ok((await width()).includes('"240"'));
    await click('Undo');
    assert.equal(await width(), original);
    console.log('PASS: held Space, creation, focused text entry, commit and undo');

    const handles = (await ask('query', { label: 'Resize handle', exact: true })).nodes;
    assert.ok(handles.length, 'No resize handles');
    const corner = handles.reduce((best, node) => node.x + node.y > best.x + best.y ? node : best);
    const x = corner.x + corner.width * .5, y = corner.y + corner.height * .5;
    await point('down', x, y);
    capture = captureSequence('resize.png', 'resize-sequence.txt');
    for (let index = 0; index < 10; index++) {
      await point('move', x + (index + 1) * 8, y + (index + 1) * 5);
      await sleep(100);
    }
    await point('up', x + 80, y + 50);
    assert.equal(await waitForExit(capture, 45000), 0);
    assert.notEqual(await width(), original);
    await click('Undo');
    assert.equal(await width(), original);
    console.log('PASS: resize handles, ten-frame capture, and undo through real input');
    const shot = await ask('screenshot');
    fs.writeFileSync(path.join(artifacts, 'studio.png'), Buffer.from(shot.png, 'base64'));
    const call = { jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'ui_capture',
      arguments: { count: 3, intervalMs: 100, columns: 3, tileWidth: 320, testId: 'canvas' } } };
    const result = run(mcp, ['--connect', address], {
      input: JSON.stringify(call) + '\n', encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'], timeout: 45000, cwd: root,
    });
    const response = JSON.parse(result.stdout).result;
    assert.ok(!response.isError, JSON.stringify(response));
    const content = response.content;
    assert.equal(content[0].type, 'image');
    assert.equal(content[0].mimeType, 'image/png');
    const png = Buffer.from(content[0].data, 'base64');
    assert.equal(png.readUInt32BE(16), (320 + 8) * 3 + 8);
    fs.writeFileSync(path.join(artifacts, 'mcp-mosaic.png'), png);
    fs.writeFileSync(path.join(artifacts, 'mcp-timings.txt'), content[1].text);
    console.log('PASS: MCP returns an actual PNG mosaic and sample timing metadata');

    if (args.stress) {
      await click('Commands');
      await click('Add 100k rectangles');
      await ask('press', { key: 'Escape' });
      await click('Select');
      await point('down', 250, 100);
      let previous = (await ask('hello')).frame;
      for (const [x, y] of [[500, 350], [700, 600], [1050, 850], [260, 110], [275, 115]]) {
        await point('move', x, y);
        const now = (await ask('hello')).frame;
        assert.ok(now > previous, '100k marquee stopped updating');
        previous = now;
      }
      await point('up', 275, 115);
      console.log('PASS: 100k page marquee, including the transition back to empty');
    }
    fs.writeFileSync(path.join(artifacts, 'frames.json'), JSON.stringify(frames));
    console.log(`Artifacts: ${artifacts}`);
  } finally {
    try { await stop(capture); }
    finally {
      await stop(child);
      fs.rmSync(directory, { recursive: true, force: true });
    }
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
