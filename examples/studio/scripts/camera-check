#!/usr/bin/env node
(async () => {
  const { assert, fs, path, os, root, run, options, binary, summary } = await import('./internal.mjs');
  const { values: args } = options('Measure native camera CPU submission and compare retained/ordinary GPU pixels.\nBuild the release app first. Default workload is in memory; --file is read without saving.\nWall times include surface waits, not GPU timestamps or display FPS.', {
    file: { type: 'string' }, directory: { type: 'string', default: path.join(root, 'build/native-camera-check') },
  });
  if (args.file && !fs.statSync(args.file).isFile()) throw new Error('--file must name an existing design');
  const directory = path.resolve(args.directory);
  fs.mkdirSync(directory, { recursive: true });
  const program = binary('silk-studio-native-app');
  const result = {
    date: new Date().toISOString(), machine: os.machine(), os: `${os.type()}-${os.release()}-${os.machine()}`,
    viewport: { width: 1440, height: 960 },
    workload: args.file ? `Saved design: ${path.basename(args.file)}` : '100k image/text cards, 300004 editable layers',
    metric: 'Native input/model/layout/scene/upload/draw/present-call wall time, including surface waits; not GPU timestamps or display FPS',
  };
  const stages = ['inputModelLayout', 'canvas', 'atlasAndSurface', 'drawSubmission', 'presentCall'];
  for (const [name, flags] of [['ordinary', ['--no-retained']], ['retained', []], ['gpuParity', ['--check']]]) {
    const log = path.join(directory, `${name}.log`);
    const fd = fs.openSync(log, 'w');
    try {
      run(program, [...(args.file ? ['--benchmark-file', path.resolve(args.file)] : ['--benchmark']), ...flags], {
        cwd: root, stdio: ['ignore', fd, fd], timeout: 180000,
      });
    } finally { fs.closeSync(fd); }
    const text = fs.readFileSync(log, 'utf8');
    const rows = [...text.matchAll(/frame-ms: layout=(\S+) canvas=(\S+) upload=(\S+) draw=(\S+) present=(\S+)/g)]
      .map(match => match.slice(1).map(Number));
    assert.equal(rows.length, 203, `${name}: ${rows.length} frames`);
    if (name === 'gpuParity') {
      assert.ok(text.includes(': pass'), text.slice(-1000));
      result[name] = text.split(/\r?\n/).find(line => line.startsWith('check:'));
      const surface = /check: (\d+) x (\d+) surface/.exec(result[name]);
      assert.ok(surface, result[name]);
      Object.assign(result.viewport, { pixelWidth: Number(surface[1]), pixelHeight: Number(surface[2]), scale: Number(surface[1]) / result.viewport.width });
    } else {
      result[name] = {};
      for (const [phase, part] of [['zoom', rows.slice(1, 121)], ['pan', rows.slice(121, 161)], ['dragStart', rows.slice(161, 162)], ['drag', rows.slice(162, 202)]]) {
        result[name][phase] = summary(part.map(row => row.reduce((sum, value) => sum + value, 0)));
        result[name][phase].stages = Object.fromEntries(stages.map((stage, i) => [stage, summary(part.map(row => row[i]))]));
      }
      console.log(name, 'zoom', result[name].zoom.medianMs, 'pan', result[name].pan.medianMs, 'drag', result[name].drag.medianMs);
    }
  }
  const destination = path.join(directory, 'results.json');
  fs.writeFileSync(destination, JSON.stringify(result, null, 2) + '\n');
  console.log(result.gpuParity);
  console.log(destination);
})().catch(error => { console.error(error); process.exitCode = 1; });
