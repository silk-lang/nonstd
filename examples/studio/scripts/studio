#!/usr/bin/env node
// Build the native app; check uses isolated in-memory content, never the default design.
(async () => {
  const { fs, path, root, studio, run, build, options } = await import('./internal.mjs');
  const { windowCheck } = await import('../../internal.mjs');
  const { values: args, positionals } = options(
    'Studio [run|check] [options]\nRun opens ~/.silk-studio.silkdesign unless --file is supplied.\nCheck dispatches Rectangle and Tab, then compares the window surface with the CPU reference.\nLinux checks start Xvfb/Weston and default to lavapipe; other platforms open a real window.', {
      backend: { type: 'string', default: 'all' },
      'build-only': { type: 'boolean' }, bundle: { type: 'boolean' },
      release: { type: 'boolean' }, inspect: { type: 'boolean' }, file: { type: 'string' },
    }, { positionals: true });
  if (positionals.length > 1 || !['run', 'check'].includes(positionals[0] ?? 'run')) throw new Error('Expected run or check');
  if (!['x11', 'wayland', 'all'].includes(args.backend)) throw new Error('--backend must be x11, wayland or all');
  const program = build(path.join(studio, 'app'), { release: args.release });
  if (args.bundle) {
    if (process.platform !== 'darwin') throw new Error('--bundle currently packages macOS only');
    const destination = path.join(root, 'build/Silk Studio.app');
    const macos = path.join(destination, 'Contents/MacOS');
    const resources = path.join(destination, 'Contents/Resources');
    fs.mkdirSync(macos, { recursive: true });
    fs.mkdirSync(resources, { recursive: true });
    const staged = path.join(macos, 'silk-studio-native-app.next');
    fs.copyFileSync(program, staged);
    fs.chmodSync(staged, fs.statSync(program).mode);
    fs.renameSync(staged, path.join(macos, 'silk-studio-native-app'));
    const fonts = path.join(resources, 'examples/studio/assets/fonts');
    fs.mkdirSync(fonts, { recursive: true });
    for (const name of ['NotoSerif-Regular.subset.ttf', 'NotoMono-Regular.subset.ttf', 'Noto-LICENSE-OFL.txt']) {
      fs.copyFileSync(path.join(studio, 'assets/fonts', name), path.join(fonts, name));
    }
    const launcher = path.join(macos, 'SilkStudio');
    fs.writeFileSync(launcher, '#!/bin/sh\ncd "$(dirname "$0")/../Resources" || exit 1\nexec ../MacOS/silk-studio-native-app "$@"\n', { mode: 0o755 });
    fs.chmodSync(launcher, 0o755);
    fs.writeFileSync(path.join(destination, 'Contents/Info.plist'), `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>Silk Studio</string>
<key>CFBundleDisplayName</key><string>Silk Studio</string>
<key>CFBundleIdentifier</key><string>org.silk-lang.studio.native</string>
<key>CFBundleExecutable</key><string>SilkStudio</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
`);
    console.log(destination);
  } else if (args['build-only']) {
    console.log(program);
  } else if (positionals[0] === 'check') {
    process.exitCode = await windowCheck(program, args.backend);
  } else {
    run(program, [...(args.inspect ? ['--inspect'] : []), ...(args.file ? [path.resolve(args.file)] : [])], { cwd: root });
  }
})().catch(error => { console.error(error.message); process.exitCode = 1; });
