#!/usr/bin/env python3
"""Build the design app, then run it in a window. The window bridge and Dawn come
from the manifests.

  examples/studio/scripts/studio [--build-only] [--release] [--file FILE]   the app in a window
  examples/studio/scripts/studio check [--backend x11|wayland|all] [--release]

Designs are kept in FILE (default ~/.silk-studio.silkdesign).

`check` runs `silk-studio-native-app --check`: a scripted click on Rectangle and a Tab go through the app, then the
window's surface is read back and compared with the CPU reference of the same frame. On Linux it
starts Xvfb and a headless Weston itself, like native/platform/window/scripts/linux, and uses lavapipe
when VK_ICD_FILENAMES is not set; on macOS and Windows it opens a real window.

Needs what examples/graphics-demo/scripts/app needs (Linux: libx11-dev libxkbcommon-dev libwayland-dev,
plus xvfb and weston for `check`).
"""
import argparse
import os
import plistlib
import shutil
from pathlib import Path
import runpy
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
REPO = ROOT.parents[1]
APP = ROOT / "app"
WINDOW = REPO / "native/platform/window/scripts"
sys.path.insert(0, str(REPO / "native/gpu/webgpu/scripts"))
from _build import build  # noqa: E402

LAVAPIPE = Path("/usr/share/vulkan/icd.d/lvp_icd.json")


def check(program, backend):
    env = dict(os.environ)
    if sys.platform.startswith("linux"):
        if "VK_ICD_FILENAMES" not in env and LAVAPIPE.exists():
            env["VK_ICD_FILENAMES"] = str(LAVAPIPE)
        env["SILK_WINDOW_SCALE"] = env.get("SILK_WINDOW_SCALE", "1")
        linux = runpy.run_path(str(WINDOW / "linux"))
        # The runners start the program without arguments; a wrapper adds --check.
        wrapper = REPO / ".cache/silk-studio-native-app/check"
        wrapper.parent.mkdir(parents=True, exist_ok=True)
        wrapper.write_text(f'#!/bin/sh\ncd "{REPO}"\nexec "{program}" --check\n')
        wrapper.chmod(0o755)
        status = 0
        for name in (["x11", "wayland"] if backend == "all" else [backend]):
            print(f"--- {name}", flush=True)
            runner = linux["run_under_x11"] if name == "x11" else linux["run_under_wayland"]
            code = runner(wrapper, env)
            print(f"--- {name}: {'passed' if code == 0 else f'failed ({code})'}", flush=True)
            status = status or code
        return status
    return subprocess.run([str(program), "--check"], cwd=REPO, env=env, timeout=300).returncode


def bundle(program):
    if sys.platform != 'darwin':
        raise SystemExit('--bundle currently packages macOS only')
    destination = REPO / 'build/Silk Studio.app'
    macos = destination / 'Contents/MacOS'
    resources = destination / 'Contents/Resources'
    macos.mkdir(parents=True, exist_ok=True)
    resources.mkdir(parents=True, exist_ok=True)
    staged = macos / 'silk-studio-native-app.next'
    shutil.copy2(program, staged)
    staged.replace(macos / 'silk-studio-native-app')
    for name in ['NotoSerif-Regular.subset.ttf', 'NotoMono-Regular.subset.ttf']:
        source = REPO / 'svg/tests/fonts' / name
        target = resources / 'svg/tests/fonts' / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    launcher = macos / 'SilkStudio'
    launcher.write_text('#!/bin/sh\ncd "$(dirname "$0")/../Resources" || exit 1\nexec ../MacOS/silk-studio-native-app "$@"\n')
    launcher.chmod(0o755)
    with (destination / 'Contents/Info.plist').open('wb') as output:
        plistlib.dump({
            'CFBundleName': 'Silk Studio',
            'CFBundleDisplayName': 'Silk Studio',
            'CFBundleIdentifier': 'org.silk-lang.studio.native',
            'CFBundleExecutable': 'SilkStudio',
            'CFBundlePackageType': 'APPL',
            'CFBundleShortVersionString': '0.1.0',
            'CFBundleVersion': '1',
            'LSMinimumSystemVersion': '14.0',
            'NSHighResolutionCapable': True,
        }, output)
    print(destination)
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("mode", nargs="?", choices=["run", "check"], default="run")
    parser.add_argument("--backend", choices=["x11", "wayland", "all"], default="all")
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--bundle", action="store_true", help="build a standalone macOS .app bundle")
    parser.add_argument("--release", action="store_true")
    parser.add_argument("--inspect", action="store_true", help="opt in to the local inspector in release builds")
    parser.add_argument("--file", help="the design file (default ~/.silk-studio.silkdesign)")
    args = parser.parse_args()
    program = build(APP, release=args.release)
    if args.bundle:
        bundle(program)
        return 0
    if args.build_only:
        print(program)
        return 0
    if args.mode == "check":
        return check(program, args.backend)
    return subprocess.run([str(program)] + (["--inspect"] if args.inspect else []) + ([str(Path(args.file).resolve())] if args.file else []), cwd=REPO).returncode


if __name__ == "__main__":
    raise SystemExit(main())
