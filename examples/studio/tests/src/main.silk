static if Intrinsic.targetOperatingSystem() == "darwin" {
  const PRIMARY: u32 = MOD_META
} else {
  const PRIMARY: u32 = MOD_CONTROL
}

struct Failed {}

effect fn expect(condition: bool, message: string) -> ()
  ! Failed {
  if !condition {
    StderrWriter.print("FAIL: {}\n", &.(message))
    fail Failed {}
  }
}

fn pointer(x: f32, y: f32) -> Pointer {
  return Pointer { x: x, y: y, shift: false, alt: false, pan: false, double: false }
}

effect fn now(clock: &mut OsMonotonicClock) -> f64 {
  let t = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  return i64.toF64(SystemClock.seconds(&t)) * 1000.0
    + i64.toF64(SystemClock.nanoseconds(&t)) / 1000000.0
}

effect fn contracts() -> ()
  ! Failed | OutOfMemoryError | JsonError | format.InvalidDocument
  ? &mut Allocator {
  let mut m = Studio.make()
  samples.starter(&mut m)
  m.cameraX = 0.0
  m.cameraY = 0.0
  m.zoom = 1.0
  let initial = m.elements.length()

  // One drag is one undo operation, and moving a frame moves its descendants once.
  let frame = m.elements.get(0)
  m.select(frame.id, false)
  let child = m.elements.get(1)
  editing.down(&mut m, pointer(244.0, 76.0))
  editing.drag(&mut m, pointer(264.0, 96.0))
  editing.up(&mut m, pointer(264.0, 96.0))
  run expect(m.past.length() == 1, "drag has a single history entry")
  run expect(m.elements.get(1).shape.x == child.shape.x + 20.0, "frame movement carries text")
  editing.undo(&mut m, false)
  run expect(m.elements.get(1).shape.x == child.shape.x, "undo restores descendants")
  editing.undo(&mut m, true)
  run expect(m.elements.get(1).shape.x == child.shape.x + 20.0, "redo restores descendants")

  // Duplicate keeps internal parent references; deleting it leaves the original intact.
  editing.action(&mut m, 3)
  run expect(m.elements.length() > initial, "duplicate includes descendants")
  let duplicate = m.primary
  run expect(duplicate != frame.id, "duplicate has new identity")
  editing.action(&mut m, 2)
  run expect(m.elements.length() == initial, "delete removes only duplicated subtree")

  // Alt-drag is a single duplication transaction, including when cancelled.
  m.select(frame.id, false)
  let originalCount = m.elements.length()
  let mut alt = pointer(264.0, 96.0)
  alt.alt = true
  editing.down(&mut m, alt)
  let mut destination = pointer(304.0, 136.0)
  destination.alt = true
  editing.up(&mut m, destination)
  run expect(m.elements.length() > originalCount, "alt-drag duplicates a subtree")
  editing.undo(&mut m, false)
  run expect(m.elements.length() == originalCount, "alt-drag undo removes duplicate")
  editing.down(&mut m, alt)
  editing.cancel(&mut m)
  run expect(m.elements.length() == originalCount, "cancel removes provisional duplicate")

  // Camera gestures must not snapshot, mutate, or invalidate document geometry.
  let panRevision = m.geometryRevision
  let panHistory = m.past.length()
  let panX = m.elements.get(1).shape.x
  m.tool = 5
  editing.down(&mut m, pointer(600.0, 400.0))
  run expect(m.before.length() == 0, "panning does not copy document layers")
  editing.drag(&mut m, pointer(620.0, 420.0))
  editing.cancel(&mut m)
  run expect(m.elements.length() == originalCount, "cancelled pan preserves every layer")
  run expect(m.elements.get(1).shape.x == panX, "cancelled pan preserves geometry")
  run expect(m.geometryRevision == panRevision, "cancelled pan preserves renderer caches")
  run expect(m.past.length() == panHistory, "camera gestures do not enter document history")
  m.tool = 0

  // JSON round trips Unicode, styles and hierarchy through the browser schema.
  m.title = m.intern("Design \"quoted\" — café")
  let json = run format.encode(&m)
  let restored = run format.decode(String.utf8Bytes(String.view(&json)))
  run expect(restored.elements.length() == m.elements.length(), "file preserves layers")
  run expect(
    restored.string(restored.title) == m.string(m.title),
    "file preserves Unicode and quotes",
  )
  run expect(
    restored.elements.get(1).parent == restored.elements.get(0).id,
    "file preserves parent links",
  )
  let invalid = run Effect.result(
    format.decode(
      b"{\"version\":1,\"activePageId\":\"p\",\"pages\":[{\"id\":\"p\",\"nodes\":[{\"id\":\"a\",\"kind\":\"group\",\"parentId\":\"b\"},{\"id\":\"b\",\"kind\":\"group\",\"parentId\":\"a\"}]}]}",
    ),
  )
  let rejected = match move invalid {
    Result<Studio, JsonError | format.InvalidDocument | OutOfMemoryError>.Success { value } => {
      drop value
      false
    }
    Result<Studio, JsonError | format.InvalidDocument | OutOfMemoryError>.Failure { error } => {
      drop error
      true
    }
  }
  run expect(rejected, "cyclic imported hierarchy is rejected")
  let countBeforeNew = m.elements.length()
  m.draftField = 18
  m.draft = run String.copy("Committed before save")
  editing.action(&mut m, 13)
  run expect(m.string(m.title) == "Committed before save", "save commits the active field")
  editing.action(&mut m, 12)
  run expect(
    m.elements.length() == countBeforeNew && m.exportRequested == 5,
    "new document waits for a separate destination",
  )
  StderrWriter.print("ok: editing, hierarchy, history, portable files\n", &())
}

effect fn snapping() -> ()
  ! Failed {
  let mut m = Studio.make()
  samples.page(&mut m, "Snap test")
  m.zoom = 1.0
  m.cameraX = 0.0
  m.cameraY = 0.0
  let source = m.add(0, "Source", 0.0, 0.0, 50.0, 50.0, 0xff0000ff)
  drop m.add(0, "Target", 100.0, 100.0, 50.0, 50.0, 0x00ff00ff)
  m.select(source, false)
  editing.down(&mut m, pointer(244.0, 76.0))
  editing.drag(&mut m, pointer(292.0, 124.0))
  run expect(
    m.elements.get(0).shape.x == 50.0 && m.hasGuideX,
    "drag snaps edges within five screen pixels",
  )
  let mut unsnapped = pointer(292.0, 124.0)
  unsnapped.alt = true
  editing.drag(&mut m, unsnapped)
  run expect(m.elements.get(0).shape.x == 48.0 && !m.hasGuideX, "Alt bypasses guides during drag")
  editing.up(&mut m, unsnapped)
  run expect(!m.hasGuideX && !m.hasGuideY, "release removes guides")
  let b = editing.bounds(&m)
  run expect(b[0] == 48.0 && b[2] == 98.0, "selection bounds follow edited geometry")
  editing.undo(&mut m, false)
  run expect(editing.bounds(&m)[0] == 0.0, "undo refreshes selection bounds")
  m.clearSelection()
  run expect(editing.bounds(&m)[0] == 1000000.0, "clearing selection invalidates its bounds")
  StderrWriter.print("ok: smart guides, Alt bypass and selection bounds\n", &())
}

effect fn uiContract() -> ()
  ! Failed | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run fixtures.fonts()
  let mut tree = run UiTree.make(&collection)
  let mut iconBatch = Batch.make()
  run view.resources(&mut iconBatch)
  run tree.apply(run iconBatch.take())
  let mut fonts = Batch.make()
  run fonts.fontFamily(1, "Noto Sans")
  run tree.apply(run fonts.take())
  let mut m = Studio.make()
  samples.page(&mut m, "Test page")
  m.title = m.intern("Input test")
  m.cameraX = 0.0
  m.cameraY = 0.0
  m.zoom = 1.0
  let mut app = Runtime<Studio, Message, NoCommand>.make(move m)
  run app.start(&mut tree, 0.0)
  let viewport = FrameInput { width: 1440.0, height: 960.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  run expect(view.windowDragAt(&tree, 800.0, 28.0), "empty header space drags the window")
  run expect(!view.windowDragAt(&tree, 400.0, 250.0), "canvas gestures do not drag the window")
  run expect(!view.windowDragAt(&tree, 1410.0, 28.0), "export button is not a drag region")
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    run expect(
      !view.windowDragAt(&tree, 105.0, 28.0),
      "file button beside traffic lights remains clickable",
    )
    run expect(!view.windowDragAt(&tree, 310.0, 28.0), "document name remains editable")
  }

  run expect(
    run click(&mut app, &mut tree, viewport, "Rectangle"),
    "native rectangle tool is reachable",
  )
  run drag(&mut app, &mut tree, viewport, 400.0, 250.0, 550.0, 350.0, 5)
  run expect(app.model.elements.length() == 1, "native canvas pointer creates a rectangle")
  run expect(
    app.model.elements.get(0).shape.width == 150.0,
    "native drag uses canvas world coordinates",
  )
  run expect(
    run clickRole(&mut app, &mut tree, viewport, Role.TextBox, "Width"),
    "inspector width is reachable",
  )
  run press(&mut app, &mut tree, viewport, "a", PRIMARY)
  run typeText(&mut app, &mut tree, viewport, "240")
  run press(&mut app, &mut tree, viewport, "Enter", 0)
  run expect(
    app.model.elements.get(0).shape.width == 240.0,
    "native text input commits numeric edit",
  )
  run expect(run click(&mut app, &mut tree, viewport, "Undo"), "undo button is reachable")
  run expect(app.model.elements.get(0).shape.width == 150.0, "native undo restores inspector edit")
  let originalFill = app.model.elements.get(0).shape.fill
  run expect(run click(&mut app, &mut tree, viewport, "#e6b84eff"), "fill palette is reachable")
  run expect(app.model.elements.get(0).shape.fill == 0xe6b84eff, "palette applies a document edit")
  drop run click(&mut app, &mut tree, viewport, "Undo")
  run expect(app.model.elements.get(0).shape.fill == originalFill, "palette edit is undoable")
  run expect(run click(&mut app, &mut tree, viewport, "Zoom in"), "zoom control is reachable")
  run expect(app.model.zoom > 1.0, "zoom control changes the camera")
  drop run click(&mut app, &mut tree, viewport, "Zoom out")
  run expect(f32.abs(app.model.zoom - 1.0) < 0.001, "zoom steps are reversible")
  StderrWriter.print("ok: native tool, canvas drag, inspector input and undo\n", &())
}

effect fn layerHierarchy() -> ()
  ! Failed | TreeError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut batch = Batch.make()
  run view.resources(&mut batch)
  run tree.apply(run batch.take())
  let mut model = Studio.make()
  samples.starter(&mut model)
  let mut app = Runtime<Studio, Message, NoCommand>.make(move model)
  run app.start(&mut tree, 0.0)
  let viewport = FrameInput { width: 1440.0, height: 960.0, scale: 1.0, time: 0.0 }
  run expect(
    run click(&mut app, &mut tree, viewport, "Collapse layer"),
    "a frame has a reachable disclosure control",
  )
  run expect(
    app.model.collapsed.length() == 1 && app.model.layerRows.length() < app.model.elements.length(),
    "collapse removes descendants from the virtual list",
  )
  run expect(app.model.selected == 0, "disclosure does not bubble into row selection")
  run expect(
    run click(&mut app, &mut tree, viewport, "Expand layer"),
    "collapsed frame can be expanded",
  )
  run expect(
    app.model.collapsed.length() == 0
      && app.model.layerRows.length() == app.model.elements.length(),
    "expand restores the complete hierarchy",
  )
  let first = app.model.layerRows.get(0)
  let second = app.model.layerRows.get(1)
  run expect(first.depth == 0 && second.depth == 1, "parents precede indented children")
  run expect(
    app.model.elements.get(second.index).parent == app.model.elements.get(first.index).id,
    "row nesting follows the document hierarchy",
  )
  StderrWriter.print("ok: virtual layer hierarchy, collapse and event propagation\n", &())
}

effect fn marqueeRepaint() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut iconBatch = Batch.make()
  run view.resources(&mut iconBatch)
  run tree.apply(run iconBatch.take())
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut text)
  let mut snapshot = CpuSnapshot.make()
  let mut canvas = Canvas.make()
  let mut model = Studio.make()
  samples.page(&mut model, "Empty")
  model.title = model.intern("Marquee regression")
  let mut app = Runtime<Studio, Message, NoCommand>.make(move model)
  run app.start(&mut tree, 0.0)
  let viewport = FrameInput { width: 1440.0, height: 960.0, scale: 1.0, time: 0.0 }
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut text, &mut snapshot, 1.0)
  run tree.dispatch(
    Input.PointerDown { x: 400.0, y: 300.0, button: 0, modifiers: 0, clickCount: 1 },
  )
  drop run pump(&mut app, &mut tree)
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut text, &mut snapshot, 1.0)
  let previous = app.model.currentX
  run tree.dispatch(Input.PointerMove { x: 500.0, y: 400.0, modifiers: 0 })
  drop run pump(&mut app, &mut tree)
  run expect(
    app.model.gesture == 4 && app.model.selected == 0 && app.model.currentX != previous,
    "empty marquee input reaches the model",
  )
  run expect(
    canvas.needsFrame(&app.model, &tree),
    "empty marquee movement schedules a presentation without a selection change",
  )
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut text, &mut snapshot, 1.0)
  run expect(
    !canvas.needsFrame(&app.model, &tree),
    "a presented marquee does not cause idle redraws",
  )
  let quads = canvas.scene.quads(0)
  let mut found = false
  let mut i: usize = 0
  while i < quads.length {
    let b = quads[i].bounds
    if b.xMin == 400.0 && b.yMin == 300.0 && b.xMax == 500.0 && b.yMax == 400.0 {
      found = true
    }
    i = i + 1
  }
  run expect(found, "the presented scene contains the moved marquee")
  run tree.dispatch(Input.PointerUp { x: 500.0, y: 400.0, button: 0, modifiers: 0 })
  drop run pump(&mut app, &mut tree)
  run expect(
    canvas.needsFrame(&app.model, &tree),
    "releasing an empty marquee schedules its removal",
  )
  StderrWriter.print("ok: empty marquee schedules presentation and removal\n", &())
}

// A small scratch atlas makes repeated zoom exhaust old glyph sizes quickly.
// Every letter must still be present in the actual scene rasterized into a label tile.
effect fn zoomGlyphs() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut text = run UiTree.make(&fonts)
  let mut options = AtlasOptions.default()
  options.textureSize = 512
  options.maxTextures = 1
  text.atlas = Atlas.make(options)
  run textResources(&mut text)
  let mut m = Studio.make()
  samples.page(&mut m, "Zoom glyphs")
  let id = m.add(2, "abcdefghijklmnopqrstuvwxyz", 0.0, 0.0, 200.0, 15.0, 0x263e30ff)
  let at = m.index(id)
  let mut e = m.elements.get(at)
  e.fontSize = 7.0
  m.elements.set(at, e)
  let mut canvas = Canvas.make()
  drop run canvas.normalize(&mut m, &mut text)
  let mut snapshot = CpuSnapshot.make()
  let mut step: usize = 0
  while step < 48 {
    m.zoom = 2.0 + usize.toF32(step % 20) * 0.25
    let mut label = m.elements.get(at)
    label.fontFamily = usize.toU32(step % 3)
    m.elements.set(at, label)
    m.geometryRevision = m.geometryRevision + 1
    run canvas.frame(&m, &mut tree, &mut text, &mut snapshot, 2.0)
    run expect(text.stats.glyphs == 26, "every character survives repeated zoom rasterization")
    step = step + 1
  }
  StderrWriter.print(
    "ok: all 26 letters survive 48 zoom/font changes under glyph atlas pressure\n",
    &(),
  )
}

// A warm text raster must survive small camera movements on both sides of a
// density boundary, including when only a viewport-sized portion is cached.
effect fn panRasterBoundary() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut text)
  let mut m = Studio.make()
  samples.page(&mut m, "Pan boundary")
  let id = m.add(2, "Make room", 0.0, 0.0, 300.0, 88.0, 0x263e30ff)
  let at = m.index(id)
  let mut e = m.elements.get(at)
  e.fontSize = 56.0
  e.fontFamily = 1
  m.elements.set(at, e)
  let mut canvas = Canvas.make()
  let mut raster = CpuSnapshot.make()
  drop run canvas.normalize(&mut m, &mut text)
  let zooms: [f32; 4] = [4.0, 4.01, 8.01, 64.0]
  let mut trial: usize = 0
  while trial < zooms.length {
    m.zoom = zooms[trial]
    m.cameraX = 40.0
    m.cameraY = 10.0
    run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
    let before = text.frameNumber
    let mut step: usize = 0
    while step < 8 {
      m.cameraX = m.cameraX + 1.0 / m.zoom
      m.cameraY = m.cameraY + 0.5 / m.zoom
      run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
      step = step + 1
    }
    StderrWriter.print("pan zoom {}: {} extra text rasters\n", &(m.zoom, text.frameNumber - before))
    run expect(text.frameNumber == before, "small pans reuse text pixels across zoom boundaries")
    if trial == 3 {
      // Residency can change without changing document geometry or raster bindings.
      let deadline = tree.atlas.frame() + 1
      let evicted = run tree.atlas.evictUnusedSince(deadline)
      run expect(evicted > 0, "text eviction fixture removes an allocated tile")
      m.cameraX = m.cameraX + 0.25 / m.zoom
      run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
      run expect(text.frameNumber > before, "cached viewport checks notice atlas eviction")
    }
    if trial >= 2 {
      m.cameraX = m.cameraX + m.canvasWidth() / m.zoom
      run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
      run expect(text.frameNumber > before, "panning beyond the cached crop refreshes its pixels")
    }
    trial = trial + 1
  }
}

// Scroll zoom reuses available pixels during motion, then resolves text once idle.
effect fn scrollZoomRaster() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut text)
  let mut m = Studio.make()
  m.width = 800.0
  m.height = 600.0
  run tree.frame(FrameInput { width: m.width, height: m.height, scale: 2.0, time: 0.0 })
  samples.page(&mut m, "Scroll zoom")
  let id = m.add(2, "Make room", 0.0, 0.0, 300.0, 88.0, 0x263e30ff)
  let at = m.index(id)
  let mut e = m.elements.get(at)
  e.fontSize = 56.0
  e.fontFamily = 1
  m.elements.set(at, e)
  let mut canvas = Canvas.make()
  let mut raster = CpuSnapshot.make()
  drop run canvas.normalize(&mut m, &mut text)
  m.zoom = 3.8
  m.cameraX = 40.0
  m.cameraY = 10.0
  run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
  let before = text.frameNumber
  let mut step: usize = 0
  let mut time: f64 = 1.0
  let wheelX = m.leftWidth() + 100.0
  while step < 40 {
    editing.wheel(&mut m, wheelX, 100.0, 0.0, -2.0, true)
    time = time + 0.016
    run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, time, false)
    step = step + 1
  }
  run expect(text.frameNumber == before, "continuous scroll zoom must reuse available text pixels")
  let deadline = match canvas.nextTextDeadline() {
    Option<f64>.Some { value } => value
    Option<f64>.None => 0.0
  }
  run expect(deadline > time + 0.1 && deadline < time + 0.2, "zoom schedules an idle quality frame")
  run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, time + 0.1, false)
  run expect(text.frameNumber == before, "unrelated frames do not refine text during the gesture")
  run expect(canvas.textRefinementDue(deadline), "quality deadline wakes an idle window")
  run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, deadline, false)
  run expect(text.frameNumber == before + 1, "idle zoom refines the heading exactly once")
  run expect(!canvas.textRefinementDue(deadline + 1.0), "settled text does not request more frames")
  run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, deadline + 1.0, false)
  run expect(text.frameNumber == before + 1, "idle frames reuse refined text")

  let mut pixels = CpuSnapshot.make()
  run pixels.sync(&mut tree)
  let actual = run pixels.renderScene(&tree, &canvas.scene)
  let mut fresh = Canvas.make()
  run fresh.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
  run pixels.sync(&mut tree)
  let expected = run pixels.renderScene(&tree, &fresh.scene)
  let mut pixel: usize = 0
  let mut equal = true
  while pixel < actual.data().length {
    equal = equal && actual.data()[pixel] == expected.data()[pixel]
    pixel = pixel + 1
  }
  run expect(equal, "idle refinement pixels match a fresh full-quality render")
  fresh.reset(&mut tree)

  // A capture during motion must force quality even with no further camera change.
  editing.wheel(&mut m, wheelX, 100.0, 0.0, -20.0, true)
  run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, 4.0, false)
  let deferred = text.frameNumber
  run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
  run expect(text.frameNumber == deferred + 1, "captures resolve pending text quality immediately")
  run expect(!canvas.textRefinementDue(10.0), "capture consumes the pending refinement")

  // Deferring density must not defer missing pixels outside a retained crop.
  m.zoom = 8.01
  m.cameraX = 40.0
  m.cameraY = 10.0
  run canvas.frame(&m, &mut tree, &mut text, &mut raster, 2.0)
  let cropped = text.frameNumber
  m.cameraX = m.cameraX + m.canvasWidth() / m.zoom
  run canvas.frameInteractive(&m, &mut tree, &mut text, &mut raster, 2.0, 5.0, false)
  run expect(text.frameNumber > cropped, "camera motion immediately fills newly exposed text")
  StderrWriter.print(
    "ok: scroll zoom reuses text, refines on idle, preserves captures and crop coverage\n",
    &(),
  )
}

// Updating a shared raster must refresh every visible instance that still names its
// old tile, including instances that enter the viewport after a pan.
effect fn sharedTextPan() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut text)
  run tree.frame(FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 })
  let mut m = Studio.make()
  m.width = 800.0
  m.height = 600.0
  samples.page(&mut m, "Shared text")
  let mut i: usize = 0
  while i < 120 {
    let id = m.add(
      2,
      "around those",
      usize.toF32(i % 12) * 80.0,
      usize.toF32(i / 12) * 40.0,
      70.0,
      15.0,
      0x263e30ff,
    )
    let at = m.index(id)
    let mut e = m.elements.get(at)
    e.fontSize = 7.0
    e.fontFamily = usize.toU32(i % 3)
    m.elements.set(at, e)
    i = i + 1
  }
  let mut canvas = Canvas.make()
  let mut raster = CpuSnapshot.make()
  let mut pixels = CpuSnapshot.make()
  drop run canvas.normalize(&mut m, &mut text)
  let mut step: usize = 0
  while step < 6 {
    m.zoom = if step == 0 {
      1.0
    } else if step < 6 {
      5.0
    } else {
      1.0
    }
    m.cameraX = usize.toF32(step % 4) * 80.0
    m.cameraY = 10.0
    run canvas.frame(&m, &mut tree, &mut text, &mut raster, 1.0)
    run pixels.sync(&mut tree)
    let actual = run pixels.renderScene(&tree, &canvas.scene)
    let mut fresh = Canvas.make()
    run fresh.frame(&m, &mut tree, &mut text, &mut raster, 1.0)
    run pixels.sync(&mut tree)
    let expected = run pixels.renderScene(&tree, &fresh.scene)
    let mut different: usize = 0
    let mut y: usize = 100
    while y < 550 {
      let mut x = f32.toUsize(m.leftWidth())
      while x < f32.toUsize(m.width - m.rightWidth()) {
        let pixel = (y * 800 + x) * 4
        if actual.data()[pixel] != expected.data()[pixel] {
          different = different + 1
        }
        x = x + 1
      }
      y = y + 1
    }
    StderrWriter.print("shared text step {}: {} different canvas pixels\n", &(step, different))
    run expect(different == 0, "zoom/pan text pixels match a fresh document render")
    fresh.reset(&mut tree)
    step = step + 1
  }
  StderrWriter.print("ok: shared text zoom/pan matches fresh raster pixels\n", &())
}

effect fn rendering() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError | exports.UnsupportedBackdrop
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut iconBatch = Batch.make()
  run view.resources(&mut iconBatch)
  run tree.apply(run iconBatch.take())
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut tree)
  run textResources(&mut text)
  run tree.frame(FrameInput { width: 800.0, height: 600.0, scale: 1.0, time: 0.0 })
  let mut raster = CpuSnapshot.make()
  let mut snapshot = CpuSnapshot.make()
  let mut canvas = Canvas.make()
  let mut m = Studio.make()
  samples.page(&mut m, "Exports")
  let id = m.add(0, "Red", 10.0, 20.0, 100.0, 80.0, 0xff0000ff)
  drop m.add(0, "Outside selection", 300.0, 20.0, 100.0, 80.0, 0x00ff00ff)
  m.select(id, false)
  let pixels = run canvas.exportPixels(&mut m, &mut tree, &mut text, &mut raster, &mut snapshot)
  run expect(pixels.width() == 100 && pixels.height() == 80, "PNG bounds use the selected subtree")
  let bytes = pixels.data()
  let middle: usize = (40 * 100 + 50) * 4
  run expect(
    bytes[middle] > 240 && bytes[middle + 1] < 10 && bytes[middle + 3] == 255,
    "PNG contains rendered red pixels",
  )
  let svg = run exports.svg(&m)
  run expect(String.contains(String.view(&svg), "width=\"100\""), "SVG exports selected geometry")

  // A heavily magnified glyph must use vector coverage and a viewport-sized tile.
  m.elements.clear()
  m.reindex()
  let label = m.add(2, "A", 0.0, 0.0, 100.0, 100.0, 0x000000ff)
  let at = m.index(label)
  let mut e = m.elements.get(at)
  e.fontSize = 64.0
  m.elements.set(at, e)
  m.zoom = 64.0
  m.cameraX = 30.0
  m.cameraY = 30.0
  m.width = 800.0
  m.height = 600.0
  m.geometryRevision = m.geometryRevision + 1
  run canvas.frame(&m, &mut tree, &mut text, &mut raster, 1.0)
  run expect(text.scene().paths(0).length > 0, "extreme zoom renders glyph outlines")
  canvas.reset(&mut tree)
  m.cameraX = 40.0
  run canvas.frame(&m, &mut tree, &mut text, &mut raster, 1.0)
  StderrWriter.print("ok: PNG selection export, SVG, high-zoom vector text and cache reset\n", &())
}

effect fn selectionFrames(model: Studio) -> Studio
  ! TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  let mut iconBatch = Batch.make()
  run view.resources(&mut iconBatch)
  run tree.apply(run iconBatch.take())
  let mut text = run UiTree.make(&fonts)
  run textResources(&mut text)
  let mut snapshot = CpuSnapshot.make()
  let mut canvas = Canvas.make()
  let mut app = Runtime<Studio, Message, NoCommand>.make(move model)
  run app.start(&mut tree, 0.0)
  let viewport = FrameInput { width: 1440.0, height: 960.0, scale: 1.0, time: 0.0 }
  drop run canvas.normalize(&mut app.model, &mut text)
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut text, &mut snapshot, 1.0)
  let mut clock = OsMonotonicClock.make()
  app.model.clearSelection()
  run tree.dispatch(
    Input.PointerDown { x: 225.0, y: 130.0, button: 0, modifiers: 0, clickCount: 1 },
  )
  drop run pump(&mut app, &mut tree)
  let start = run now(&mut clock)
  let mut i: usize = 0
  while i < 30 {
    run tree.dispatch(
      Input.PointerMove {
        x: 400.0 + usize.toF32(i) * 20.0,
        y: 400.0 + usize.toF32(i) * 10.0,
        modifiers: 0,
      },
    )
    drop run pump(&mut app, &mut tree)
    run tree.frame(viewport)
    run canvas.frame(&app.model, &mut tree, &mut text, &mut snapshot, 1.0)
    i = i + 1
  }
  let end = run now(&mut clock)
  run tree.dispatch(Input.PointerUp { x: 980.0, y: 690.0, button: 0, modifiers: 0 })
  drop run pump(&mut app, &mut tree)
  StderrWriter.print(
    "100k selection frame CPU (input + model + UI layout + scene; excludes GPU): {} ms average\n",
    &.((end - start) / 30.0),
  )
  return move app.model
}

effect fn stress() -> ()
  ! Failed | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut m = Studio.make()
  samples.mosaic(&mut m)
  m.fit(false)
  run expect(
    m.elements.length() == 100002,
    "stress page contains 100k independent rectangles and two labels",
  )
  let mut clock = OsMonotonicClock.make()
  let start = run now(&mut clock)
  editing.down(&mut m, pointer(225.0, 130.0))
  let mut i: usize = 0
  while i < 120 {
    let fraction = usize.toF32(i + 1) / 120.0
    editing.drag(&mut m, pointer(225.0 + fraction * 900.0, 130.0 + fraction * 700.0))
    i = i + 1
  }
  editing.up(&mut m, pointer(1125.0, 830.0))
  let end = run now(&mut clock)
  run expect(m.selected > 10000, "large marquee selects real individual elements")
  StderrWriter.print(
    "100k marquee: {} ms / 120 samples; {} selected\n",
    &((end - start), m.selected),
  )
  let current = move m
  m = run selectionFrames(move current)
  editing.action(&mut m, 6)
  let editStart = run now(&mut clock)
  editing.field(&mut m, 5, "#456789")
  editing.action(&mut m, 25)
  let editEnd = run now(&mut clock)
  run expect(m.elements.get(50000).shape.fill == 0x456789ff, "bulk edit changes all rectangles")
  StderrWriter.print("100k fill + align: {} ms\n", &.(editEnd - editStart))
}

effect fn program() -> i32
  ! Failed
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | JsonError
    | format.InvalidDocument
    | exports.UnsupportedBackdrop
    | JpegError
    | PngError
    | ImageError
  ? &mut Allocator {
  run contracts()
  run snapping()
  run uiContract()
  run layerHierarchy()
  run marqueeRepaint()
  run scrollZoomRaster()
  run panRasterBoundary()
  run zoomGlyphs()
  run sharedTextPan()
  run rendering()
  run stress()
  run challenge()
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(Effect.catch<AtlasError>(program(), atlasFailure), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// This fixture catches accidental per-element raster/measurement caching and crop loss.
effect fn challenge() -> ()
  ! Failed
    | TreeError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | JpegError
    | PngError
    | ImageError
    | JsonError
    | format.InvalidDocument
    | exports.UnsupportedBackdrop
  ? &mut Allocator {
  let mut m = Studio.make()
  samples.challenge(&mut m)
  run expect(
    m.elements.length() == 300004,
    "100k card groups, images, texts and four reference layers",
  )
  let count = m.elements.length()
  samples.challenge(&mut m)
  run expect(m.elements.length() == count, "reopening challenge preserves existing page")
  let fonts = run fixtures.fonts()
  let mut tree = run UiTree.make(&fonts)
  tree.atlas = Atlas.make(Canvas.atlasOptions())
  let mut textTree = run UiTree.make(&fonts)
  run textResources(&mut textTree)
  let mut batch = Batch.make()
  run view.resources(&mut batch)
  run tree.apply(run batch.take())
  let mut canvas = Canvas.make()
  run canvas.loadAssets(&mut tree)
  drop run canvas.normalize(&mut m, &mut textTree)
  m.fit(false)
  let mut snapshot = CpuSnapshot.make()
  let mut app = Runtime<Studio, Message, NoCommand>.make(move m)
  run app.start(&mut tree, 0.0)
  let viewport = FrameInput { width: 1440.0, height: 960.0, scale: 2.0, time: 0.0 }
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  let tiles = canvas.textTileCount()
  run expect(tiles <= 591, "100k labels share at most 588 text/font rasters and three headings")
  run canvas.frameRetained(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  run expect(canvas.retained, "dense image overview uses retained GPU geometry")
  let retainedRevision = canvas.retainedRevision
  app.model.cameraX = app.model.cameraX + 1.0
  run canvas.frameRetained(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  run expect(
    canvas.retained && canvas.retainedRevision == retainedRevision,
    "overview camera motion preserves uploaded geometry",
  )
  app.model.grid = true
  run canvas.frameRetained(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  run expect(!canvas.retained, "grid rendering uses ordinary composition")
  app.model.grid = false
  run canvas.frame(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  let mut clock = OsMonotonicClock.make()
  let started = run now(&mut clock)
  let mut i: usize = 0
  while i < 120 {
    // 60 steps of 1.07x, then its inverse: fit-all through ~180% and back.
    run tree.dispatch(
      Input.Wheel {
        x: 740.0,
        y: 550.0,
        deltaX: 0.0,
        deltaY: if i < 60 {
          -17.5
        } else {
          16.35514
        },
        modifiers: MOD_CONTROL,
      },
    )
    drop run pump(&mut app, &mut tree)
    drop run canvas.normalize(&mut app.model, &mut textTree)
    run tree.frame(viewport)
    run canvas.frame(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
    i = i + 1
  }
  let elapsed = (run now(&mut clock)) - started
  run expect(canvas.textTileCount() == tiles, "wide zoom reuses raster identities")
  run expect(canvas.textPixelCount() < 24000000, "zoom text memory stays bounded")
  StderrWriter.print(
    "100k image/text zoom CPU (real input + UI + scene; excludes GPU): {} ms average; {} shared rasters; {} pixels\n",
    &(elapsed / 120.0, tiles, canvas.textPixelCount()),
  )

  // Move among unrelated labels at extreme zoom, then return to the overview.
  // Evicted tiles must be refreshed and offscreen labels must not all grow huge.
  let mut magnify: usize = 0
  while magnify < 6 {
    app.model.zoom = 64.0
    app.model.cameraX = usize.toF32(magnify) * 80.0
    app.model.cameraY = 20.0
    app.model.paintRevision = app.model.paintRevision + 1
    run tree.frame(viewport)
    run canvas.frame(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
    magnify = magnify + 1
  }
  app.model.fit(false)
  run tree.frame(viewport)
  run canvas.frame(&app.model, &mut tree, &mut textTree, &mut snapshot, 2.0)
  let last = app.model.elements.get(count - 1)
  app.model.select(last.id, false)
  editing.field(&mut app.model, 14, "Native text edit")
  run expect(
    app.model.string(app.model.elements.get(count - 1).text) == "Native text edit",
    "last text remains independently editable",
  )
  editing.undo(&mut app.model, false)
  run expect(app.model.elements.get(count - 1).text == last.text, "undo restores text")

  // A small portable document exercises the exact same crop encoder/decoder and SVG export.
  let mut portable = Studio.make()
  samples.page(&mut portable, "Crop round trip")
  drop portable.add(0, "Crop", 0.0, 0.0, 74.0, 20.0, 0xffffffff)
  let mut image = portable.elements.get(0)
  image.image = 1
  image.shape.source = app.model.elements.get(count - 2).shape.source
  portable.elements.set(0, image)
  let encoded = run format.encode(&portable)
  let decoded = run format.decode(String.utf8Bytes(String.view(&encoded)))
  let crop = decoded.elements.get(0)
  run expect(
    crop.image == 1 && f32.round(crop.shape.source.xMin * 1224.0) == 399.0
      && f32.round(crop.shape.source.yMin * 248.0) == 124.0,
    "last integer crop survives document round trip",
  )
  let svg = run exports.svg(&decoded)
  run expect(
    String.contains(String.view(&svg), "viewBox=\"399 124 700 120\"")
      && String.contains(String.view(&svg), "data:image/png;base64,"),
    "SVG embeds the source image and exact crop",
  )
  StderrWriter.print("ok: 100k image/text cache, editing/undo, crop persistence and SVG\n", &())
}

effect fn atlasFailure(error: AtlasError) -> i32 {
  match error {
    AtlasError.EmptyTile => {
      StderrWriter.print("Silk Studio: empty atlas tile\n", &())
    }
    AtlasError.Full => {
      StderrWriter.print("Silk Studio: atlas exhausted\n", &())
    }
    AtlasError.TooLarge { width, height } => {
      StderrWriter.print("Silk Studio: atlas tile too large: {} x {}\n", &(width, height))
    }
  }
  return 2
}
