//! Silk Studio in a browser tab: the editor of `examples/studio/app`, built for wasm32 and run
//! by lib-ui's published browser page. The document is kept in the page's localStorage, so a reload
//! finds it again; the first visit opens the starter design. There are no native menus or file
//! dialogs, so opening, saving as and exporting files are the desktop app's; shortcuts work.
//!
//!   node examples/browser serve examples/studio/browser
//!
//! With `?check` in the page's address it runs the window host's rendering check, like the
//! native app's `--check`: it clicks Rectangle, presses Tab and compares the canvas with the CPU
//! reference of the same frame. `main` returns 0 within tolerance, 1 outside and 2 on an error.
static if Intrinsic.targetArchitecture() == "wasm32" {
  // These two modules must be in the program's own package: a dependency exports no wasm
  // symbols.
  import generated_webgpu_exports
  import libm
  import studio.model { Studio, Message }
  import studio.render { Canvas, textResources }
  import studio.editing as editing
  import studio.samples as samples
  import studio.view as view
  import studio.format as format
  import ui_tree_window.browser { stored, store }
  import silk.collections.bytes { Bytes }
  import silk.core.result { Result }
  import silk.json.scanner { JsonError }
  import silk.text.string { String }
  import ui_app.app { NoCommand }
  import ui_app.runtime { Runtime, pump }
  import ui_app_window.lib { HostPlatform, Launched, RunOptions, WindowContent, runWindowHosted }
  import ui_tree_window.browser { checkRequested }
  import ui_tree_window.console { StderrWriter }
  import ui_tree_window.lib { feed }
  import ui_inspect_server.lib { Inspector }
  import ui_fixtures.fixtures as fixtures
  import ui_tree.lib { UiTree, TreeError, Batch, FrameInput, CpuSnapshot }
  import ui_scene.scene { Scene }
  import atlas.atlas { Atlas, AtlasError }
  import vector.geometry_error { GeometryError }
  import window.event { Event }
  import window.types { WindowError, WindowId, WindowOptions }
  import webgpu.runtime { GpuError }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.geometry.size { Size2 }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.num.f32
  import silk.num.f64

  /// The localStorage key of the document (the page puts its own prefix before it).
  const KEY: string<'static> = "studio"

  /// Documents with more elements than this are not kept: their JSON outgrows localStorage
  /// (about five million characters per site), and encoding them stalls the page for hundreds of
  /// milliseconds.
  const KEEP_LIMIT: usize = 20000

  /// The kept document, or the starter design on a first visit, in check mode (where the page
  /// keeps nothing) or when what is kept does not read.
  effect fn initial(check: bool) -> Studio
    ! OutOfMemoryError
    ? &mut Allocator {
    if !check {
      if let Option<Bytes>.Some { value: kept } = run stored(KEY) {
        let parsed = run Effect.result(format.decode(Bytes.asSlice(&kept)))
        match move parsed {
          Result<Studio, format.InvalidDocument | JsonError | OutOfMemoryError>.Success {
            value
          } => {
            return move value
          }
          Result<Studio, format.InvalidDocument | JsonError | OutOfMemoryError>.Failure {
            error
          } => {
            drop error
            StderrWriter.print(
              "silk-studio-browser: the kept document does not read; opening the starter design\n",
              &(),
            )
          }
        }
      }
    }
    let mut m = Studio.make()
    samples.starter(&mut m)
    return move m
  }

  /// The design canvas and its text tree, without the desktop's files, menus and dialogs.
  struct Page<'fonts> {
    canvas: Canvas,
    textTree: UiTree<'fonts>,
    textSnapshot: CpuSnapshot,
    check: bool,
    now: f64,
    /// The revision the last save tried to keep.
    attempted: u64,
  }

  impl<'fonts> WindowContent<Studio, Message, NoCommand> for Page<'fonts> {
    effect fn setup(self: &mut Self, tree: &mut UiTree<'_>) -> ()
      ! TreeError | OutOfMemoryError
      ? &mut Allocator {
      tree.atlas = Atlas.make(Canvas.atlasOptions())
      run self.canvas.loadAssets(&mut tree)
    }

    fn configure(self: &Self, options: &mut WindowOptions<'_>) -> () {
      options.minSize = Option<Size2<f64>>.some(Size2<f64>.new(800.0, 600.0))
    }

    /// Saves to localStorage when the document asks (it does after edits), and answers file
    /// requests, which need the desktop app.
    effect fn update(
      self: &mut Self,
      app: &mut Runtime<Studio, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      platform: &mut HostPlatform,
      window: WindowId,
    ) -> bool
      ! WindowError | TreeError | OutOfMemoryError
      ? &mut Allocator {
      let mut changed = false
      if app.model.saveRequested {
        // The document asks again every second while it is unsaved, so each revision is tried
        // once: a failed or skipped save waits for the next edit instead of encoding again.
        app.model.saveRequested = false
        if app.model.revision != self.attempted {
          self.attempted = app.model.revision
          editing.commitDraft(&mut app.model)
          if self.check {
            app.model.savedRevision = app.model.revision
          } else if app.model.elements.length() > KEEP_LIMIT {
            app.model.notice = run String.copy(
              "Too large to keep in this page; it lasts until the tab closes",
            )
          } else {
            let text = run format.encode(&app.model)
            if store(KEY, String.view(&text)) {
              app.model.savedRevision = app.model.revision
            } else {
              app.model.notice = run String.copy(
                "This page cannot keep the design (storage is full or blocked)",
              )
            }
          }
          run app.render(&mut tree)
          changed = true
        }
      }
      if app.model.exportRequested != 0 {
        app.model.exportRequested = 0
        app.model.notice = run String.copy("Opening and exporting files needs the desktop app")
        run app.render(&mut tree)
        changed = true
      }
      return changed
    }

    fn wakeAfter(self: &Self) -> Option<f64> {
      if let Option<f64>.Some { value } = self.canvas.nextTextDeadline() {
        return Option<f64>.some(f64.max(0.008, value - self.now))
      }
      return Option<f64>.None
    }

    effect fn poll(
      self: &mut Self,
      app: &mut Runtime<Studio, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      time: f64,
    ) -> bool
      ! WindowError | TreeError | OutOfMemoryError
      ? &mut Allocator {
      self.now = time
      return self.canvas.textRefinementDue(time) || self.canvas.needsFrame(&app.model, &tree.*)
    }

    fn needsFrame(
      self: &Self,
      app: &Runtime<Studio, Message, NoCommand>,
      tree: &UiTree<'_>,
    ) -> bool {
      return self.canvas.needsFrame(&app.model, &tree.*) || self.canvas.textRefinementDue(self.now)
    }

    effect fn prepare(
      self: &mut Self,
      app: &mut Runtime<Studio, Message, NoCommand>,
      tree: &mut UiTree<'_>,
    ) -> ()
      ! TreeError | OutOfMemoryError
      ? &mut Allocator {
      if run self.canvas.normalize(&mut app.model, &mut self.textTree) {
        run app.render(&mut tree)
      }
    }

    effect fn frame(
      self: &mut Self,
      app: &Runtime<Studio, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      input: FrameInput,
      inspector: &Inspector,
    ) -> ()
      ! TreeError | AtlasError | GeometryError | OutOfMemoryError
      ? &mut Allocator {
      if self.check {
        run self.canvas.frame(
          &app.model,
          &mut tree,
          &mut self.textTree,
          &mut self.textSnapshot,
          input.scale,
        )
      } else {
        run self.canvas.frameInteractive(
          &app.model,
          &mut tree,
          &mut self.textTree,
          &mut self.textSnapshot,
          input.scale,
          self.now,
          false,
        )
      }
    }

    fn scene<'s>(self: &'s Self, tree: &'s UiTree<'_>) -> &'s Scene {
      return &self.canvas.scene
    }

    effect fn event(
      self: &mut Self,
      app: &mut Runtime<Studio, Message, NoCommand>,
      tree: &mut UiTree<'_>,
      event: &Event,
    ) -> bool
      ! WindowError | TreeError | AtlasError | GeometryError | OutOfMemoryError
      ? &mut Allocator {
      match &event.* {
        Event.Pinch { position, delta, .. } => {
          if !self.check {
            editing.wheel(
              &mut app.model,
              f64.toF32(position.x),
              f64.toF32(position.y),
              0.0,
              -f64.toF32(delta) * 250.0,
              true,
            )
            run app.render(&mut tree)
          }
        }
        Event.Focused { focused, .. } => {
          drop run feed(&mut tree, event)
          drop run pump(&mut app, &mut tree)
          if !focused {
            app.model.space = false
            if app.model.gesture != 0 {
              editing.cancel(&mut app.model)
            }
            run app.render(&mut tree)
          }
        }
        _ => {
          return false
        }
      }
      return true
    }
  }

  effect fn program(check: bool) -> i32
    ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let collection = run fixtures.fonts()
    let mut batch = Batch.make()
    run batch.fontFamily(1, "Noto Sans, sans-serif")
    run view.resources(&mut batch)
    run batch.fontFamily(2, "Noto Sans, sans-serif")
    run batch.fontFamily(3, "Noto Serif, serif")
    run batch.fontFamily(4, "Noto Mono, monospace")
    let width: f32 = 1280.0
    let height: f32 = 800.0
    let mut model = run initial(check)
    model.width = width
    model.height = height
    model.fit(false)
    let mut app = Runtime<Studio, Message, NoCommand>.make(move model)
    let mut textTree = run UiTree.make(&collection)
    run textResources(&mut textTree)
    let mut page = Page {
      canvas: Canvas.make(),
      textTree: move textTree,
      textSnapshot: CpuSnapshot.make(),
      check: check,
      now: 0.0,
      attempted: 18446744073709551615,
    }
    return run runWindowHosted(
      &mut app,
      &collection,
      run batch.take(),
      RunOptions {
        title: "Silk Studio",
        width: f32.toF64(width),
        height: f32.toF64(height),
        check: check,
        checkClick: "Rectangle",
        checkExpect: "Design canvas",
        lowestLatency: false,
        platform: Option<Launched>.None,
      },
      Inspector.off(),
      &mut page,
    )
  }

  effect fn gpuFailed(error: GpuError) -> i32 {
    StderrWriter.print("silk-studio-browser: GPU error {}\n", &.(error.code))
    return 2
  }

  effect fn failed<E>(error: E) -> i32 {
    drop error
    StderrWriter.print(
      "silk-studio-browser: failed (window, tree, atlas, geometry or allocation)\n",
      &(),
    )
    return 2
  }

  pub fn main() -> i32 {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(Effect.catch<GpuError>(program(checkRequested()), gpuFailed), failed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
} else {
  /// The browser build only; natively, run `examples/studio/app`.
  pub fn main() -> i32 {
    return 0
  }
}
