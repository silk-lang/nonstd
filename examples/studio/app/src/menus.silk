//! System menu bar for the desktop editor.
import window.menu { MenuBar, SystemItem, Shortcut }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub effect fn make() -> MenuBar
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bar = MenuBar.make()
  run bar.begin("Silk Studio")
  run bar.system(SystemItem.About)
  run bar.separator()
  run bar.system(SystemItem.Services)
  run bar.system(SystemItem.Hide)
  run bar.system(SystemItem.HideOthers)
  run bar.system(SystemItem.ShowAll)
  run bar.separator()
  run bar.system(SystemItem.Quit)
  run bar.end()
  run bar.begin("File")
  run bar.action("New", 12, Option<Shortcut>.some(Shortcut.command('n')))
  run bar.action("Open…", 36, Option<Shortcut>.some(Shortcut.command('o')))
  run bar.action("Save", 13, Option<Shortcut>.some(Shortcut.command('s')))
  run bar.action("Save As…", 37, Option<Shortcut>.some(Shortcut.command('s').withShift()))
  run bar.separator()
  run bar.action("Export PNG…", 15, Option<Shortcut>.None)
  run bar.action("Export SVG…", 14, Option<Shortcut>.None)
  run bar.separator()
  run bar.system(SystemItem.CloseWindow)
  run bar.end()
  run bar.begin("Edit")

  // Editing shortcuts stay in the input path so text fields retain their own undo/clipboard.
  run bar.action("Undo", 0, Option<Shortcut>.None)
  run bar.action("Redo", 1, Option<Shortcut>.None)
  run bar.separator()
  run bar.action("Duplicate", 3, Option<Shortcut>.None)
  run bar.action("Group", 21, Option<Shortcut>.None)
  run bar.action("Ungroup", 22, Option<Shortcut>.None)
  run bar.action("Delete", 2, Option<Shortcut>.None)
  run bar.end()
  run bar.begin("View")
  run bar.action("Fit Page", 7, Option<Shortcut>.None)
  run bar.action("Fit Selection", 8, Option<Shortcut>.None)
  run bar.action("Actual Size", 9, Option<Shortcut>.None)
  run bar.action("Toggle Grid", 19, Option<Shortcut>.None)
  run bar.action("Toggle Snapping", 20, Option<Shortcut>.None)
  run bar.separator()
  run bar.system(SystemItem.ToggleFullScreen)
  run bar.end()
  run bar.begin("Window")
  run bar.system(SystemItem.Minimize)
  run bar.system(SystemItem.Zoom)
  run bar.system(SystemItem.BringAllToFront)
  run bar.end()
  return move bar
}
