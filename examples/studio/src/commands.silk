//! The command palette and layer search share deterministic, case-insensitive matching.
import silk.text.string { String }

pub fn matches(text: string, query: string) -> bool {
  let a = String.utf8Bytes(text)
  let b = String.utf8Bytes(query)
  if b.length > a.length {
    return false
  }
  let mut i: usize = 0
  while i <= a.length - b.length {
    let mut j: usize = 0
    while j < b.length {
      let x = if a[i + j] >= 65 && a[i + j] <= 90 {
        a[i + j] + 32
      } else {
        a[i + j]
      }
      let y = if b[j] >= 65 && b[j] <= 90 {
        b[j] + 32
      } else {
        b[j]
      }
      if x != y {
        break
      }
      j = j + 1
    }
    if j == b.length {
      return true
    }
    i = i + 1
  }
  return false
}
