//! Virtual layer rows in paint order. Adjacency is built once per document/search/collapse
//! change; selecting and moving a marquee reuses the rows, including on the 100k page.
import model { Studio }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }
import commands

pub struct Row {
  pub index: usize,
  pub depth: u32,
  pub children: bool
}

impl Copy for Row {}

pub fn collapsed(m: &Studio, id: u32) -> bool {
  let ids = m.collapsed.asSlice()
  let mut i: usize = 0
  while i < ids.length {
    if ids[i] == id {
      return true
    }
    i = i + 1
  }
  return false
}

pub effect fn build(m: &Studio) -> List<Row>
  ! OutOfMemoryError
  ? &mut Allocator {
  let nodes = m.elements.asSlice()
  let mut first = List<usize>.make()
  let mut next = List<usize>.make()
  run first.appendRepeated(usize.MAX, nodes.length)
  run next.appendRepeated(usize.MAX, nodes.length)
  let mut root = usize.MAX
  let mut i: usize = 0
  while i < nodes.length {
    if nodes[i].page == m.page {
      let parent = m.index(nodes[i].parent)
      if parent != usize.MAX && nodes[parent].page == m.page {
        next.set(i, first.get(parent))
        first.set(parent, i)
      } else {
        next.set(i, root)
        root = i
      }
    }
    i = i + 1
  }
  let mut rows = List<Row>.make()
  let mut stack = List<Row>.make()
  if root != usize.MAX {
    run stack.append(Row { index: root, depth: 0, children: false })
  }
  let searching = String.view(&m.search) != ""
  let mut visited: usize = 0
  while visited < nodes.length {
    let current = match stack.pop() {
      Option<Row>.Some { value } => value
      Option<Row>.None => {
        break
      }
    }
    visited = visited + 1
    let at = current.index
    let node = nodes[at]
    let child = first.get(at)
    let sibling = next.get(at)
    if sibling != usize.MAX {
      run stack.append(Row { index: sibling, depth: current.depth, children: false })
    }
    if !searching || commands.matches(m.string(node.name), String.view(&m.search)) {
      run rows.append(Row { index: at, depth: current.depth, children: child != usize.MAX })
    }
    if child != usize.MAX && (searching || !collapsed(m, node.id)) {
      run stack.append(Row { index: child, depth: current.depth + 1, children: false })
    }
  }
  return move rows
}
