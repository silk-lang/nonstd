//! Native Studio document and interaction state. Drawing elements stay outside the UI tree.
import silk.geometry.rect { Rect }
import ui_components.numeric { NumberEvent }
import ui_components.color { withChannel }
import silk.collections.hash_map { HashMap }
import silk.collections.hash { Hash, HashKey }
import ui_components.lib { MenuState, MenuMessage }
import silk.core.option { Option }
import format
import editor.document { Node }
import ui_app.heap { Heap }
import ui_app.app { App, Context, Subscriptions, NoCommand }
import ui_app.ui { Ui }
import ui_tree.input { MOD_SHIFT, MOD_ALT }
import ui_tree.node { Event }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.text.string { String }
import silk.num.usize
import silk.num.u32
import silk.num.u64
import silk.num.f32
import view
import layers { Row }
import layers
import editing

/// An editable layer: rect, ellipse, text, frame, or group (kind 0 through 4).
pub struct Element {
  pub id: u32,
  pub page: u32,
  pub parent: u32,
  pub kind: u32,
  pub name: u32,
  pub text: u32,
  /// Zero for no image, one for the bundled tweet; crops live in shape.source.
  pub image: u32,
  pub fontSize: f32,
  pub fontWeight: u32,
  pub fontFamily: u32,
  pub shape: Node,
  pub selected: bool,
  pub autoSize: bool,
}

impl Copy for Element {}

pub struct Page {
  pub id: u32,
  pub name: u32
}

impl Copy for Page {}

pub struct Snapshot {
  pub elements: List<Element>,
  pub pages: List<Page>,
  pub page: u32,
  pub title: u32
}

/// A pointer sample in window logical points.
pub struct Pointer {
  pub x: f32,
  pub y: f32,
  pub shift: bool,
  pub alt: bool,
  pub pan: bool,
  pub double: bool
}

impl Copy for Pointer {}

impl Pointer {
  pub fn from(event: &Event) -> Pointer {
    return Pointer {
      x: event.x,
      y: event.y,
      shift: (event.modifiers & MOD_SHIFT) != 0,
      alt: (event.modifiers & MOD_ALT) != 0,
      pan: event.button != 0,
      double: event.detail >= 2,
    }
  }
}

pub union Message {
  Action { pub code: u32 },
  Fill { pub value: u32 },
  ColorOpen { pub field: u32, pub value: u32 },
  ColorChannel { pub channel: u32, pub value: f32 },
  ColorValue { pub value: u32 },
  NumberField { pub field: u32, pub previous: f32, pub event: NumberEvent },
  ColorClose,
  Tool { pub kind: u32 },
  Collapse { pub id: u32 },
  Select { pub id: u32, pub extend: bool },
  Page { pub id: u32 },
  Down { pub point: Pointer },
  Move { pub point: Pointer },
  Up { pub point: Pointer },
  Wheel { pub x: f32, pub y: f32, pub dx: f32, pub dy: f32, pub zoom: bool },
  Field { pub field: u32, pub value: String },
  Search { pub value: String },
  Scroll { pub top: f32 },
  Resize { pub width: f32, pub height: f32 },
  CanvasBounds { pub bounds: Rect<f32> },
  LayerViewport { pub height: f32 },
  Key { pub key: String, pub modifiers: u32 },
  Draft { pub field: u32, pub value: String },
  Commit,
  Blend { pub message: MenuMessage },
  Font { pub message: MenuMessage },
  Weight { pub message: MenuMessage },
  FinishText,
  CancelText,
  CommandSearch { pub value: String },
  LayerFlag { pub id: u32, pub bit: u32 },
  HoverLayer { pub id: u32 },
  Space { pub pressed: bool },
  Tooltip { pub id: u64 },
  FocusReturned { pub action: u32 },
  Tick,
  Saved { pub ok: bool },
}

/// UI and document state. Strings are interned append-only so history shares their storage.
pub struct Studio {
  pub heap: Heap,
  pub stringHashes: HashMap<u64, u32>,
  pub strings: List<String>,
  pub elements: List<Element>,
  pub pages: List<Page>,
  pub indexes: List<usize>,
  pub nextId: u32,
  pub page: u32,
  pub title: u32,
  pub tool: u32,
  pub measuredCanvas: Rect<f32>,
  pub layerViewportHeight: f32,
  pub width: f32,
  pub height: f32,
  pub cameraX: f32,
  pub cameraY: f32,
  pub zoom: f32,
  pub selected: usize,
  /// Selection bounds computed during recount; geometry changes invalidate the cache.
  pub selectionBounds: [f32; 4],
  pub selectionBoundsRevision: u64,
  pub primary: u32,
  pub search: String,
  pub commandSearch: String,
  pub panels: bool,
  pub hoveredLayer: u32,
  pub pageCount: usize,
  pub frames: List<usize>,
  pub collapsed: List<u32>,
  pub layerRows: List<Row>,
  pub layerRevision: u64,
  pub layerPage: u32,
  pub scroll: f32,
  pub past: List<Snapshot>,
  pub future: List<Snapshot>,
  pub before: List<Element>,
  pub beforeDuplicate: List<Element>,
  pub duplicated: bool,
  pub gesture: u32,
  pub startX: f32,
  pub startY: f32,
  pub currentX: f32,
  pub currentY: f32,
  pub startCameraX: f32,
  pub startCameraY: f32,
  pub handle: u32,
  pub revision: u64,
  pub savedRevision: u64,
  pub paintRevision: u64,
  pub geometryRevision: u64,
  pub draftField: u32,
  pub draft: String,
  pub tooltip: u64,
  pub menu: u32,
  pub focusAction: u32,
  pub colorField: u32,
  pub colorValue: u32,
  pub colorChanged: bool,
  pub grid: bool,
  pub snap: bool,
  pub guideX: f32,
  pub guideY: f32,
  pub hasGuideX: bool,
  pub hasGuideY: bool,
  pub space: bool,
  pub saveRequested: bool,
  pub blendMenu: MenuState,
  pub fontMenu: MenuState,
  pub weightMenu: MenuState,
  pub exportRequested: u32,
  pub notice: String,
  pub clipboard: List<Element>,
  pub editing: u32,
}

impl Studio {
  pub fn make() -> Studio {
    return Studio {
      heap: Heap.make(),
      stringHashes: HashMap<u64, u32>.make(Hash.seed(716)),
      strings: List<String>.make(),
      elements: List<Element>.make(),
      pages: List<Page>.make(),
      indexes: List<usize>.make(),
      nextId: 1,
      page: 1,
      title: 0,
      tool: 0,
      measuredCanvas: Rect<f32>.new(0.0, 0.0, 0.0, 0.0),
      layerViewportHeight: 400.0,
      width: 1440.0,
      height: 960.0,
      cameraX: -80.0,
      cameraY: -80.0,
      zoom: 0.8,
      selected: 0,
      selectionBounds: [0.0, 0.0, 0.0, 0.0],
      selectionBoundsRevision: u64.MAX,
      primary: 0,
      search: String.make(),
      commandSearch: String.make(),
      panels: true,
      hoveredLayer: 0,
      pageCount: 0,
      frames: List<usize>.make(),
      collapsed: List<u32>.make(),
      layerRows: List<Row>.make(),
      layerRevision: u64.MAX,
      layerPage: 0,
      scroll: 0.0,
      past: List<Snapshot>.make(),
      future: List<Snapshot>.make(),
      before: List<Element>.make(),
      beforeDuplicate: List<Element>.make(),
      duplicated: false,
      gesture: 0,
      startX: 0.0,
      startY: 0.0,
      currentX: 0.0,
      currentY: 0.0,
      startCameraX: 0.0,
      startCameraY: 0.0,
      handle: 0,
      revision: 0,
      savedRevision: 0,
      paintRevision: 1,
      geometryRevision: 1,
      draftField: 0,
      draft: String.make(),
      tooltip: 0,
      menu: 0,
      focusAction: 0,
      colorField: 0,
      colorValue: 0,
      colorChanged: false,
      grid: false,
      snap: true,
      guideX: 0.0,
      guideY: 0.0,
      hasGuideX: false,
      hasGuideY: false,
      space: false,
      saveRequested: false,
      blendMenu: MenuState.make(),
      fontMenu: MenuState.make(),
      weightMenu: MenuState.make(),
      exportRequested: 0,
      notice: String.make(),
      clipboard: List<Element>.make(),
      editing: 0,
    }
  }

  pub fn intern(self: &mut Self, value: string) -> u32 {
    let hash = HashKey.hash(&value, &Hash.seed(2003))
    if let Option<u32>.Some { value: key } = self.stringHashes.get(hash) {
      if self.string(key) == value {
        return key
      }
    }
    if self.strings.length() > 0
      && String.view(&self.strings.asSlice()[self.strings.length() - 1]) == value {
      return usize.toU32(self.strings.length() - 1)
    }
    let key = usize.toU32(self.strings.length())
    let text = self.heap.alloc(String.copy(value))
    self.heap.alloc(self.strings.append(move text))
    drop self.heap.alloc(self.stringHashes.insert(hash, key))
    return key
  }

  pub fn string(self: &Self, key: u32) -> string {
    if u32.toUsize(key) >= self.strings.length() {
      return ""
    }
    return String.view(&self.strings.asSlice()[u32.toUsize(key)])
  }

  pub fn index(self: &Self, id: u32) -> usize {
    if u32.toUsize(id) >= self.indexes.length() {
      return usize.MAX
    }
    return self.indexes.get(u32.toUsize(id))
  }

  pub fn reindex(self: &mut Self) -> () {
    while self.indexes.length() < u32.toUsize(self.nextId) {
      self.heap.alloc(self.indexes.append(usize.MAX))
    }
    let indices = self.indexes.asMutSlice()
    let mut i: usize = 0
    while i < indices.length {
      indices[i] = usize.MAX
      i = i + 1
    }
    i = 0
    let elements = self.elements.asSlice()
    while i < elements.length {
      indices[u32.toUsize(elements[i].id)] = i
      i = i + 1
    }
  }

  pub fn add(
    self: &mut Self,
    kind: u32,
    name: string,
    x: f32,
    y: f32,
    width: f32,
    height: f32,
    fill: u32,
  ) -> u32 {
    let id = self.nextId
    self.nextId = id + 1
    let nameKey = self.intern(name)
    let mut node = Node.rect(x, y, width, height, fill)
    if kind == 1 {
      node.kind = 1
    }
    let element = Element {
      id: id,
      page: self.page,
      parent: 0,
      kind: kind,
      name: nameKey,
      text: nameKey,
      image: 0,
      autoSize: kind == 2,
      fontSize: 32.0,
      fontWeight: 400,
      fontFamily: 0,
      shape: node,
      selected: false,
    }
    while self.indexes.length() <= u32.toUsize(id) {
      self.heap.alloc(self.indexes.append(usize.MAX))
    }
    self.indexes.set(u32.toUsize(id), self.elements.length())
    self.heap.alloc(self.elements.append(element))
    self.paintRevision = self.paintRevision + 1
    return id
  }

  pub fn copyElements(self: &mut Self) -> List<Element> {
    let mut result = List<Element>.make()
    self.heap.alloc(result.appendSlice(self.elements.asSlice()))
    return move result
  }

  pub fn snapshot(self: &mut Self) -> Snapshot {
    let elements = self.copyElements()
    let mut pages = List<Page>.make()
    self.heap.alloc(pages.appendSlice(self.pages.asSlice()))
    return Snapshot {
      elements: move elements,
      pages: move pages,
      page: self.page,
      title: self.title,
    }
  }

  pub fn checkpoint(self: &mut Self) -> () {
    let state = self.snapshot()
    while self.past.length() >= 50
      || (self.past.length() > 1 && self.past.length() * self.elements.length() > 500000) {
      drop self.past.remove(0)
    }
    self.heap.alloc(self.past.append(move state))
    self.future.clear()
  }

  pub fn changed(self: &mut Self) -> () {
    self.reindex()
    self.geometryRevision = self.geometryRevision + 1
    self.revision = self.revision + 1
    self.paintRevision = self.paintRevision + 1
    self.recount()
  }

  pub fn recount(self: &mut Self) -> () {
    self.selected = 0
    self.primary = 0
    self.selectionBounds = [1000000.0, 1000000.0, -1000000.0, -1000000.0]
    self.selectionBoundsRevision = self.geometryRevision
    let nodes = self.elements.asSlice()
    let mut i: usize = 0
    while i < nodes.length {
      if nodes[i].selected && nodes[i].page == self.page {
        self.selected = self.selected + 1
        self.primary = nodes[i].id
        let n = nodes[i].shape
        self.selectionBounds[0] = f32.min(self.selectionBounds[0], n.x)
        self.selectionBounds[1] = f32.min(self.selectionBounds[1], n.y)
        self.selectionBounds[2] = f32.max(self.selectionBounds[2], n.x + n.width)
        self.selectionBounds[3] = f32.max(self.selectionBounds[3], n.y + n.height)
      }
      i = i + 1
    }
  }

  pub fn clearSelection(self: &mut Self) -> () {
    let nodes = self.elements.asMutSlice()
    let mut i: usize = 0
    while i < nodes.length {
      nodes[i].selected = false
      i = i + 1
    }
    self.selected = 0
    self.primary = 0
    self.selectionBoundsRevision = u64.MAX
  }

  pub fn select(self: &mut Self, id: u32, extend: bool) -> () {
    if !extend {
      self.clearSelection()
    }
    let at = self.index(id)
    if at != usize.MAX {
      let value1 = !self.elements.asSlice()[at].selected
      let index1 = at
      let mut item1 = self.elements.get(index1)
      item1.selected = value1
      self.elements.set(index1, item1)
    }
    self.recount()
    self.paintRevision = self.paintRevision + 1
  }

  pub fn leftWidth(self: &Self) -> f32 {
    if !self.panels {
      return 0.0
    }
    return if self.width <= 850.0 {
      170.0
    } else if self.width <= 1100.0 {
      190.0
    } else {
      224.0
    }
  }

  pub fn rightWidth(self: &Self) -> f32 {
    if !self.panels {
      return 0.0
    }
    return if self.width <= 850.0 {
      210.0
    } else if self.width <= 1100.0 {
      225.0
    } else {
      252.0
    }
  }

  pub fn canvasLeft(self: &Self) -> f32 {
    return if self.measuredCanvas.width() > 0.0 {
      self.measuredCanvas.xMin
    } else {
      self.leftWidth()
    }
  }

  pub fn canvasTop(self: &Self) -> f32 {
    return if self.measuredCanvas.height() > 0.0 {
      self.measuredCanvas.yMin
    } else {
      56.0
    }
  }

  pub fn canvasRight(self: &Self) -> f32 {
    return self.canvasLeft() + self.canvasWidth()
  }

  pub fn canvasBottom(self: &Self) -> f32 {
    return self.canvasTop() + self.canvasHeight()
  }

  pub fn canvasRect(self: &Self) -> Rect<f32> {
    return Rect<f32>.new(
      self.canvasLeft(),
      self.canvasTop(),
      self.canvasRight(),
      self.canvasBottom(),
    )
  }

  pub fn canvasWidth(self: &Self) -> f32 {
    if self.measuredCanvas.width() > 0.0 {
      return self.measuredCanvas.width()
    }
    return f32.max(100.0, self.width - self.leftWidth() - self.rightWidth())
  }

  pub fn canvasHeight(self: &Self) -> f32 {
    if self.measuredCanvas.height() > 0.0 {
      return self.measuredCanvas.height()
    }
    return f32.max(100.0, self.height - 83.0)
  }

  pub fn fit(self: &mut Self, selection: bool) -> () {
    let nodes = self.elements.asSlice()
    let mut i: usize = 0
    let mut x: f32 = 1000000.0
    let mut y = x
    let mut right: f32 = -1000000.0
    let mut bottom = right
    while i < nodes.length {
      let e = nodes[i]
      if e.page == self.page && (e.shape.flags & 1) == 0 && (!selection || e.selected) {
        x = f32.min(x, e.shape.x)
        y = f32.min(y, e.shape.y)
        right = f32.max(right, e.shape.x + e.shape.width)
        bottom = f32.max(bottom, e.shape.y + e.shape.height)
      }
      i = i + 1
    }
    if right < x {
      self.cameraX = -80.0
      self.cameraY = -80.0
      self.zoom = 1.0
      return ()
    }
    let w = f32.max(self.canvasWidth() - 120.0, 100.0)
    let h = f32.max(self.canvasHeight() - 160.0, 100.0)
    self.zoom = f32.max(
      0.02,
      f32.min(2.0, f32.min(w / f32.max(right - x, 1.0), h / f32.max(bottom - y, 1.0))),
    )
    self.cameraX = x - (self.canvasWidth()) / self.zoom * 0.5 + (right - x) * 0.5
    self.cameraY = y - (self.canvasHeight()) / self.zoom * 0.5 + (bottom - y) * 0.5
  }
}

impl App<Message, NoCommand> for Studio {
  fn view(self: &Self, ui: &mut Ui<Message>) -> () {
    view.render(self, &mut ui)
  }

  fn update(self: &mut Self, message: Message, cx: &mut Context<NoCommand>) -> () {
    match move message {
      Message.Action { code } => editing.action(&mut self, code)
      Message.ColorOpen { field, value } => {
        editing.commitDraft(&mut self)
        self.colorField = field
        self.colorValue = value
        self.colorChanged = false
      }
      Message.ColorClose => {
        self.colorField = 0
      }
      Message.ColorChannel { channel, value } => {
        let next = withChannel(self.colorValue, channel, value)
        pickedColor(&mut self, next)
      }
      Message.ColorValue { value } => {
        pickedColor(&mut self, value)
      }
      Message.NumberField { field, previous, event } => match move event {
        NumberEvent.Edit { value } => {
          self.draftField = field
          self.draft = move value
        }
        NumberEvent.Commit { value } => {
          if value != previous {
            self.draftField = field
            self.draft = self.heap.alloc(format.decimal(value))
            editing.commitDraft(&mut self)
          } else {
            self.draftField = 0
            self.draft = String.make()
          }
        }
        NumberEvent.Invalid => {
          self.notice = self.heap.alloc(String.copy("Enter a valid number"))
        }
        NumberEvent.Cancel => {
          self.draftField = 0
          self.draft = String.make()
        }
      }
      Message.Fill { value } => {
        editing.commitDraft(&mut self)
        self.draftField = 5
        self.draft = self.heap.alloc(format.hex(value))
        editing.commitDraft(&mut self)
      }
      Message.Tool { kind } => {
        self.tool = kind
        self.menu = 0
        self.editing = 0
      }
      Message.Collapse { id } => {
        let mut at: usize = 0
        while at < self.collapsed.length() && self.collapsed.get(at) != id {
          at = at + 1
        }
        if at < self.collapsed.length() {
          drop self.collapsed.remove(at)
        } else {
          self.heap.alloc(self.collapsed.append(id))
        }
        self.layerRevision = u64.MAX
      }
      Message.Select { id, extend } => self.select(id, extend)
      Message.HoverLayer { id } => {
        self.hoveredLayer = id
      }
      Message.LayerFlag { id, bit } => {
        let at = self.index(id)
        if at != usize.MAX {
          self.checkpoint()
          let mut e = self.elements.get(at)
          e.shape.flags = e.shape.flags ^ bit
          self.elements.set(at, e)
          self.changed()
        }
      }
      Message.CommandSearch { value } => {
        self.commandSearch = move value
      }
      Message.CancelText => {
        self.draftField = 0
        self.draft = String.make()
        self.editing = 0
        self.geometryRevision = self.geometryRevision + 1
      }
      Message.Page { id } => {
        self.page = id
        self.clearSelection()
        self.scroll = 0.0
        self.fit(false)
        self.paintRevision = self.paintRevision + 1
      }
      Message.Down { point } => editing.down(&mut self, point)
      Message.Move { point } => editing.drag(&mut self, point)
      Message.Up { point } => editing.up(&mut self, point)
      Message.Wheel { x, y, dx, dy, zoom } => editing.wheel(&mut self, x, y, dx, dy, zoom)
      Message.Field { field, value } => editing.field(&mut self, field, String.view(&value))
      Message.Search { value } => {
        self.layerRevision = u64.MAX
        self.search = move value
        self.scroll = 0.0
      }
      Message.Scroll { top } => {
        self.scroll = top
      }
      Message.CanvasBounds { bounds } => {
        self.measuredCanvas = bounds
        self.paintRevision = self.paintRevision + 1
      }
      Message.LayerViewport { height } => {
        self.layerViewportHeight = height
      }
      Message.Resize { width, height } => {
        self.width = width
        self.height = height
        self.paintRevision = self.paintRevision + 1
      }
      Message.Key { key, modifiers } => editing.key(&mut self, String.view(&key), modifiers)
      Message.Draft { field, value } => {
        self.draftField = field
        self.draft = move value
      }
      Message.Commit => {
        if self.draftField != 0 {
          let field = self.draftField
          let value = Intrinsic.replace(self.draft, String.make())
          self.draft = String.make()
          self.draftField = 0
          editing.field(&mut self, field, String.view(&value))
        }
      }
      Message.Blend { message: choice } => {
        if let Option<usize>.Some { value } = self.blendMenu.update(choice) {
          let text = self.heap.alloc(format.decimal(usize.toF32(value)))
          editing.field(&mut self, 25, String.view(&text))
        }
      }
      Message.Font { message: choice } => {
        if let Option<usize>.Some { value } = self.fontMenu.update(choice) {
          let text = self.heap.alloc(format.decimal(usize.toF32(value)))
          editing.field(&mut self, 30, String.view(&text))
        }
      }
      Message.Weight { message: choice } => {
        if let Option<usize>.Some { value } = self.weightMenu.update(choice) {
          let text = self.heap.alloc(format.decimal(400.0 + usize.toF32(value) * 100.0))
          editing.field(&mut self, 16, String.view(&text))
        }
      }
      Message.FinishText => {
        if self.draftField == 14 {
          let text = Intrinsic.replace(self.draft, String.make())
          self.draftField = 0
          editing.field(&mut self, 14, String.view(&text))
        }
        self.editing = 0
        self.geometryRevision = self.geometryRevision + 1
      }
      Message.Space { pressed } => {
        self.space = pressed
      }
      Message.FocusReturned { action } => {
        if self.focusAction == action {
          self.focusAction = 0
        }
      }
      Message.Tooltip { id } => {
        self.tooltip = id
      }
      Message.Tick => {
        if self.revision != self.savedRevision && self.gesture == 0 {
          self.saveRequested = true
        }
      }
      Message.Saved { ok } => {
        if ok {
          self.savedRevision = self.revision
        }
        self.saveRequested = false
      }
    }
    if self.layerRevision != self.revision || self.layerPage != self.page {
      let mut heap = Heap.make()
      self.layerRows = heap.alloc(layers.build(&self.*))
      self.pageCount = 0
      self.frames.clear()
      let mut index: usize = 0
      while index < self.elements.length() {
        let e = self.elements.get(index)
        if e.page == self.page {
          self.pageCount = self.pageCount + 1
          if e.kind == 3 {
            self.heap.alloc(self.frames.append(index))
          }
        }
        index = index + 1
      }
      self.layerRevision = self.revision
      self.layerPage = self.page
    }
  }

  fn subscriptions(self: &Self, subs: &mut Subscriptions<Message>) -> () {
    subs.resize(1, |w, h| Message.Resize { width: w, height: h })
    subs.every(2, 1.0, |time| Message.Tick)
  }
}

fn pickedColor(m: &mut Studio, value: u32) -> () {
  if !m.colorChanged {
    m.checkpoint()
  }
  m.colorChanged = true
  m.colorValue = value
  let mut i: usize = 0
  while i < m.elements.length() {
    let mut e = m.elements.get(i)
    if e.selected && !editing.flag(&m.*, e, 2) {
      if m.colorField == 5 {
        e.shape.fill = m.colorValue
        e.shape.fill2 = m.colorValue
      } else if m.colorField == 9 {
        e.shape.border = m.colorValue
      } else if m.colorField == 10 {
        e.shape.shadow = m.colorValue
      } else if m.colorField == 26 {
        e.shape.innerShadow = m.colorValue
      }
      m.elements.set(i, e)
    }
    i = i + 1
  }
  m.changed()
}
