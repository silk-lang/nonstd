//! Local exports use the selected subtree, or the visible page when nothing is selected.
import model { Studio, Element }
import tweet_asset
import editing
import format
import silk.text.string { String }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.u32
import silk.num.usize
import silk.geometry.rect { Rect }

pub struct UnsupportedBackdrop {}

pub fn included(m: &Studio, e: Element) -> bool {
  return e.page == m.page && e.kind != 4 && !editing.flag(m, e, 1)
    && (m.selected == 0 || editing.selectedAncestor(m, e))
}

pub fn bounds(m: &Studio) -> Rect<f32> {
  let mut l: f32 = 1000000.0
  let mut t = l
  let mut r: f32 = -1000000.0
  let mut b = r
  let mut i: usize = 0
  while i < m.elements.length() {
    let e = m.elements.get(i)
    if included(m, e) {
      let p = e.shape.paintBounds()
      l = f32.min(l, p.xMin)
      t = f32.min(t, p.yMin)
      r = f32.max(r, p.xMax)
      b = f32.max(b, p.yMax)
    }
    i = i + 1
  }
  return if r < l {
    Rect<f32>.new(0.0, 0.0, 800.0, 600.0)
  } else {
    Rect<f32>.new(l, t, r, b)
  }
}

effect fn xml(out: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let c = bytes[i]
    if c == 38 || c == 60 || c == 62 || c == 34 || c == 39 {
      run out.append(String.slice(value, start, i - start))
      run out.append(
        if c == 38 {
          "&amp;"
        } else if c == 60 {
          "&lt;"
        } else if c == 62 {
          "&gt;"
        } else if c == 34 {
          "&quot;"
        } else {
          "&apos;"
        },
      )
      start = i + 1
    }
    i = i + 1
  }
  run out.append(String.slice(value, start, bytes.length - start))
}

effect fn number(out: &mut String, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = run format.decimal(value)
  run out.append(String.view(&n))
}

effect fn attribute(out: &mut String, name: string, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(" ")
  run out.append(name)
  run out.append("=\"")
  run number(&mut out, value)
  run out.append("\"")
}

effect fn paint(out: &mut String, name: string, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let hex = run format.hex(value)
  run out.append(" ")
  run out.append(name)
  run out.append("=\"")
  run out.append(String.view(&hex))
  run out.append("\"")
}

effect fn filter(out: &mut String, e: Element) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = e.shape
  let extent = n.paintBounds()
  run out.append("<filter id=\"e")
  run format.integer(&mut out, u32.toU64(e.id))
  run out.append("\" filterUnits=\"userSpaceOnUse\" color-interpolation-filters=\"sRGB\"")
  run attribute(&mut out, "x", extent.xMin)
  run attribute(&mut out, "y", extent.yMin)
  run attribute(&mut out, "width", extent.xMax - extent.xMin)
  run attribute(&mut out, "height", extent.yMax - extent.yMin)
  run out.append(">")
  if (n.shadow & 255) != 0 {
    run out.append("<feDropShadow result=\"base\"")
    run attribute(&mut out, "dx", n.shadowX)
    run attribute(&mut out, "dy", n.shadowY)
    run attribute(&mut out, "stdDeviation", n.blur * 0.5)
    run paint(&mut out, "flood-color", n.shadow | 255)
    run attribute(&mut out, "flood-opacity", u32.toF32(n.shadow & 255) / 255.0)
    run out.append("/>")
  }
  if (n.innerShadow & 255) != 0 {
    run out.append("<feGaussianBlur in=\"SourceAlpha\" result=\"innerBlur\"")
    run attribute(&mut out, "stdDeviation", n.innerBlur * 0.5)
    run out.append("/><feOffset in=\"innerBlur\" result=\"innerOffset\"")
    run attribute(&mut out, "dx", n.innerX)
    run attribute(&mut out, "dy", n.innerY)
    run out.append(
      "/><feComposite in=\"SourceAlpha\" in2=\"innerOffset\" operator=\"out\" result=\"innerMask\"/><feFlood",
    )
    run paint(&mut out, "flood-color", n.innerShadow | 255)
    run attribute(&mut out, "flood-opacity", u32.toF32(n.innerShadow & 255) / 255.0)
    run out.append(
      "/><feComposite in2=\"innerMask\" operator=\"in\" result=\"innerColor\"/><feMerge><feMergeNode in=\"",
    )
    run out.append(
      if (n.shadow & 255) != 0 {
        "base"
      } else {
        "SourceGraphic"
      },
    )
    run out.append("\"/><feMergeNode in=\"innerColor\"/></feMerge>")
  }
  if n.effects.blur > 0.0 {
    run out.append("<feGaussianBlur")
    run attribute(&mut out, "stdDeviation", n.effects.blur)
    run out.append("/>")
  }
  if n.effects.hasColor() {
    run out.append("<feColorMatrix type=\"matrix\" values=\"")
    let matrix = n.effects.matrix()
    let mut i: usize = 0
    while i < 20 {
      if i > 0 {
        run out.append(" ")
      }
      run number(&mut out, matrix[i])
      i = i + 1
    }
    run out.append("\"/>")
  }
  run out.append("</filter>")
}

/// Produces editable SVG; backdrop blur is rejected because SVG cannot preserve it reliably.
pub effect fn svg(m: &Studio) -> String
  ! UnsupportedBackdrop | OutOfMemoryError
  ? &mut Allocator {
  let b = bounds(m)
  let mut out = run String.copy(
    "<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"isolation:isolate\"",
  )
  run attribute(&mut out, "width", b.xMax - b.xMin)
  run attribute(&mut out, "height", b.yMax - b.yMin)
  run out.append(" viewBox=\"")
  run number(&mut out, b.xMin)
  run out.append(" ")
  run number(&mut out, b.yMin)
  run out.append(" ")
  run number(&mut out, b.xMax - b.xMin)
  run out.append(" ")
  run number(&mut out, b.yMax - b.yMin)
  run out.append("\"><defs>")
  let mut embedded = false
  let mut i: usize = 0
  while i < m.elements.length() {
    let e = m.elements.get(i)
    if included(m, e) {
      if e.image == 1 && !embedded {
        run out.append("<image id=\"tweet\" width=\"1224\" height=\"248\" href=\"")
        run out.append(tweet_asset.uri())
        run out.append("\"/>")
        embedded = true
      }
      if e.shape.effects.backdropBlur > 0.0 {
        fail UnsupportedBackdrop {}
      }
      if (e.shape.shadow & 255) != 0 || (e.shape.innerShadow & 255) != 0
        || e.shape.effects.blur > 0.0
        || e.shape.effects.hasColor() {
        run filter(&mut out, e)
      }
    }
    i = i + 1
  }
  run out.append("</defs>")
  i = 0
  while i < m.elements.length() {
    let e = m.elements.get(i)
    let n = e.shape
    if included(m, e) {
      if e.image == 1 {
        run image(&mut out, m, e)
        i = i + 1
        continue
      }
      run out.append(
        if e.kind == 1 {
          "<ellipse"
        } else if e.kind == 2 {
          "<text"
        } else {
          "<rect"
        },
      )
      if e.kind == 1 {
        run attribute(&mut out, "cx", n.x + n.width * 0.5)
        run attribute(&mut out, "cy", n.y + n.height * 0.5)
        run attribute(&mut out, "rx", n.width * 0.5)
        run attribute(&mut out, "ry", n.height * 0.5)
      } else {
        run attribute(&mut out, "x", n.x)
        run attribute(
          &mut out,
          "y",
          if e.kind == 2 {
            n.y + e.fontSize
          } else {
            n.y
          },
        )
        if e.kind == 2 {
          run attribute(&mut out, "font-size", e.fontSize)
          run attribute(&mut out, "font-weight", u32.toF32(e.fontWeight))
          run out.append(" xml:space=\"preserve\" font-family=\"")
          run out.append(
            if e.fontFamily == 1 {
              "Georgia, serif"
            } else if e.fontFamily == 2 {
              "Courier New, monospace"
            } else {
              "Arial, sans-serif"
            },
          )
          run out.append("\"")
        } else {
          run attribute(&mut out, "width", n.width)
          run attribute(&mut out, "height", n.height)
          run attribute(&mut out, "rx", f32.min(n.radius, f32.min(n.width, n.height) * 0.5))
        }
      }
      run paint(&mut out, "fill", n.fill)
      run paint(&mut out, "stroke", n.border)
      run attribute(&mut out, "stroke-width", n.borderWidth)
      run attribute(&mut out, "opacity", editing.opacity(m, e))
      if (n.shadow & 255) != 0 || (n.innerShadow & 255) != 0 || n.effects.blur > 0.0
        || n.effects.hasColor() {
        run out.append(" filter=\"url(#e")
        run format.integer(&mut out, u32.toU64(e.id))
        run out.append(")\"")
      }
      run out.append(" style=\"mix-blend-mode:")
      run out.append(format.blendName(n.blend))
      run out.append("\"")
      if e.kind == 2 {
        run out.append(">")
        run xml(&mut out, m.string(e.text))
        run out.append("</text>")
      } else {
        run out.append("/>")
      }
    }
    i = i + 1
  }
  run out.append("</svg>\n")
  return move out
}

// A rounded outer clip is in element coordinates; the inner viewport maps the crop.
effect fn image(out: &mut String, m: &Studio, e: Element) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = e.shape
  run out.append("<g")
  run attribute(&mut out, "opacity", editing.opacity(m, e) * u32.toF32(n.fill & 255) / 255.0)
  run out.append(" style=\"mix-blend-mode:")
  run out.append(format.blendName(n.blend))
  run out.append("\"")
  if n.effects.blur > 0.0 || n.effects.hasColor() {
    run out.append(" filter=\"url(#e")
    run format.integer(&mut out, u32.toU64(e.id))
    run out.append(")\"")
  }
  run out.append("><clipPath id=\"c")
  run format.integer(&mut out, u32.toU64(e.id))
  run out.append("\"><rect")
  run attribute(&mut out, "x", n.x)
  run attribute(&mut out, "y", n.y)
  run attribute(&mut out, "width", n.width)
  run attribute(&mut out, "height", n.height)
  run attribute(&mut out, "rx", n.radius)
  run out.append("/></clipPath><g clip-path=\"url(#c")
  run format.integer(&mut out, u32.toU64(e.id))
  run out.append(")\"><svg")
  run attribute(&mut out, "x", n.x)
  run attribute(&mut out, "y", n.y)
  run attribute(&mut out, "width", n.width)
  run attribute(&mut out, "height", n.height)
  run out.append(" preserveAspectRatio=\"none\" viewBox=\"")
  let x = f32.round(n.source.xMin * 1224.0)
  let y = f32.round(n.source.yMin * 248.0)
  run number(&mut out, x)
  run out.append(" ")
  run number(&mut out, y)
  run out.append(" ")
  run number(&mut out, f32.round(n.source.xMax * 1224.0) - x)
  run out.append(" ")
  run number(&mut out, f32.round(n.source.yMax * 248.0) - y)
  run out.append("\"><use href=\"#tweet\"/></svg></g></g>")
}
