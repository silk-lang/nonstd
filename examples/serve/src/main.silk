import cli.lib { Cli, Command, Opt, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

// Try `serve -vp8080 prod`, `PORT=3000 serve`, or `serve --format yaml`.
struct Serve {
  pub verbose: bool,
  pub quiet: bool,
  pub port: u16,
  pub format: String,
  pub mode: String,
}

static fn serve() -> Command<Serve> {
  return Command<Serve>.make("serve", "Serve files")
    |> Command.option(
      "verbose",
      Opt.plain()
        |> Opt.short("v")
        |> Opt.env("SERVE_VERBOSE"),
    )
    |> Command.option("quiet", Opt.plain() |> Opt.short("q"))
    |> Command.option(
      "port",
      Opt.plain()
        |> Opt.short("p")
        |> Opt.describe("Port")
        |> Opt.env("PORT"),
    )
    |> Command.option(
      "format",
      Opt.plain()
        |> Opt.short("f")
        |> Opt.choice("json")
        |> Opt.choice("text"),
    )
    |> Command.arg(
      "mode",
      Opt.about("How")
        |> Opt.choice("dev")
        |> Opt.choice("prod"),
    )
}

effect fn report(args: &Serve) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("mode ")
  run Writer.writeString(String.view(&args.mode))
  run Writer.writeString(", format ")
  run Writer.writeString(String.view(&args.format))
  if args.port == 80 {
    run Writer.writeString(", port 80")
  } else {
    run Writer.writeString(", custom port")
  }
  if args.verbose {
    run Writer.writeString(", verbose")
  }
  if args.quiet {
    run Writer.writeString(", quiet")
  }
  run Writer.writeString("\n")
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut err = StderrWriter.make()
  let defaults = Serve {
    verbose: false,
    quiet: false,
    port: 80,
    format: run String.copy("text") |> Effect.provideMut<Allocator>(&mut allocator),
    mode: run String.copy("dev") |> Effect.provideMut<Allocator>(&mut allocator),
  }
  let parsed = run Cli.fromHost(serve(), move defaults)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run report(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Help { command } => {
      run Cli.writeHelp<Serve>(serve(), command) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Version => {
      return 0
    }
    Parsed.Failed { error } => {
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
      return 2
    }
  }
}
