import cli.lib { Arg, Cli, Command, Opt, Parsed }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.host_input { HostInput, HostInputError }
import silk.list { List }
import silk.os_writer { StderrWriter, StdoutWriter }
import silk.string { String }
import silk.writer { Writer, WriterError }

struct Greet {
  pub name: String,
  pub times: u32,
  pub loud: bool,
  pub files: List<String>,
}

static fn greet() -> Command {
  let mut command = Command.make("greet", "Say hello to someone")
  command = Command.withVersion(command, "0.1.0")
  command = Command.option(command, Opt.alias(Opt.describe(Opt.named("name"), "Who to greet"), "n"))
  command = Command.option(command, Opt.describe(Opt.named("times"), "How many times"))
  command = Command.option(command, Opt.describe(Opt.named("loud"), "Shout it"))
  command = Command.arg(command, Arg.describe(Arg.named("files"), "Files to mention"))
  return command
}

effect fn hello(args: &Greet) -> ()
  ! WriterError
  ? &mut Writer {
  let mut count: u32 = 0
  while count < args.times {
    if args.loud {
      run Writer.writeString("HELLO, ")
    } else {
      run Writer.writeString("Hello, ")
    }
    run Writer.writeString(String.view(&args.name))
    run Writer.writeString("!\n")
    count = count + 1
  }
  let files = List<String>.asSlice(&args.files)
  let mut index: usize = 0
  while index < files.length {
    run Writer.writeString("  and ")
    run Writer.writeString(String.view(&files[index]))
    run Writer.writeString("\n")
    index = index + 1
  }
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut err = StderrWriter.make()
  let defaults = Greet {
    name: run String.copy("world") |> Effect.provideMut<Allocator>(&mut allocator),
    times: 1,
    loud: false,
    files: List<String>.make(),
  }
  let parsed = run Cli.fromHost(greet(), move defaults)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run hello(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Help { command } => {
      run Cli.writeHelp<Greet>(greet(), command) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Version => {
      run Cli.writeVersion(greet()) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Failed { error } => {
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
      run Cli.writeHelp<Greet>(greet(), "") |> Effect.provideMut<Writer>(&mut err)
      return 2
    }
  }
}
