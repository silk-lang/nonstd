import cli.lib { Arg, Cli, Command, Opt, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

struct Greet {
  pub name: String,
  pub times: u32,
  pub loud: bool,
  pub files: List<String>,
}

static fn greet() -> Command {
  return Command.make("greet", "Say hello to someone") |> Command.withVersion("0.1.0")
    |> Command.option(Opt.named("name") |> Opt.describe("Who to greet") |> Opt.alias("n"))
    |> Command.option(Opt.named("times") |> Opt.describe("How many times"))
    |> Command.option(Opt.named("loud") |> Opt.describe("Shout it"))
    |> Command.arg(Arg.named("files") |> Arg.describe("Files to mention"))
}

effect fn hello(args: &Greet) -> ()
  ! WriterError
  ? &mut Writer {
  let mut count: u32 = 0
  while count < args.times {
    if args.loud {
      run Writer.writeString("HELLO, ")
    } else {
      run Writer.writeString("Hello, ")
    }
    run Writer.writeString(String.view(&args.name))
    run Writer.writeString("!\n")
    count = count + 1
  }
  let files = List<String>.asSlice(&args.files)
  let mut index: usize = 0
  while index < files.length {
    run Writer.writeString("  and ")
    run Writer.writeString(String.view(&files[index]))
    run Writer.writeString("\n")
    index = index + 1
  }
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut err = StderrWriter.make()
  let defaults = Greet {
    name: run String.copy("world") |> Effect.provideMut<Allocator>(&mut allocator),
    times: 1,
    loud: false,
    files: List<String>.make(),
  }
  let parsed = run Cli.fromHost(greet(), move defaults)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run hello(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Help { command } => {
      run Cli.writeHelp<Greet>(greet(), command) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Version => {
      run Cli.writeVersion(greet()) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Parsed.Failed { error } => {
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
      run Cli.writeHelp<Greet>(greet(), "") |> Effect.provideMut<Writer>(&mut err)
      return 2
    }
  }
}
