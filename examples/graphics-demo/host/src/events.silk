//! Window events turned into demo input, shared by the native and browser hosts.
import demo.demo { Demo }
import window.event { Event, ScrollDelta }
import window.keys { KeyCode }
import silk.core.ownership { Copy }
import silk.num.f64

/// What the host should do after an event.
pub struct Reaction {
  /// Request a frame.
  pub redraw: bool,
  /// The window's content size or scale changed: reconfigure the surface, then draw.
  pub resized: bool,
  /// Close the window and stop.
  pub quit: bool,
}

impl Copy for Reaction {}

/// The window's content size (logical points) and scale factor, as the last events told them.
pub struct WindowSize {
  pub width: f64,
  pub height: f64,
  pub scale: f64,
}

impl Copy for WindowSize {}

impl WindowSize {
  /// The surface size in device pixels.
  pub fn deviceWidth(self: &Self) -> u32 {
    return f64.toU32(f64.floor(self.width * self.scale + 0.5))
  }

  pub fn deviceHeight(self: &Self) -> u32 {
    return f64.toU32(f64.floor(self.height * self.scale + 0.5))
  }
}

fn nothing() -> Reaction {
  return Reaction { redraw: false, resized: false, quit: false }
}

fn redraw(yes: bool) -> Reaction {
  return Reaction { redraw: yes, resized: false, quit: false }
}

/// A line of a notched wheel, in logical points.
const LINE: f64 = 40.0

/// Applies `event` to `app` and `size`. `RequestFrame` is the host's to handle and gives nothing.
pub fn apply(app: &mut Demo, size: &mut WindowSize, event: &Event) -> Reaction {
  return match &event.* {
    Event.Resized { window: _, size: content, scaleFactor } => {
      size.width = content.width
      size.height = content.height
      size.scale = scaleFactor
      Reaction { redraw: true, resized: true, quit: false }
    }
    Event.ScaleFactorChanged { window: _, scaleFactor } => {
      size.scale = scaleFactor
      Reaction { redraw: true, resized: true, quit: false }
    }
    Event.MouseMoved { window: _, position, modifiers: _ } => redraw(
      app.pointerMoved(f64.toF32(position.x), f64.toF32(position.y)),
    )
    Event.MouseEntered { window: _, position } => redraw(
      app.pointerMoved(f64.toF32(position.x), f64.toF32(position.y)),
    )
    Event.MouseExited { window: _ } => redraw(app.pointerLeft())
    Event.MouseDown { window: _, position, button: _, modifiers: _, clickCount: _ } => {
      drop app.pointerMoved(f64.toF32(position.x), f64.toF32(position.y))
      redraw(app.pointerPressed())
    }
    Event.Scroll { window: _, position, delta, phase: _, modifiers: _ } => {
      drop app.pointerMoved(f64.toF32(position.x), f64.toF32(position.y))
      let dy = match &delta {
        ScrollDelta.Lines { delta: lines } => lines.y * LINE
        ScrollDelta.Points { delta: points } => points.y
      }

      // Positive y shows what is above, which scrolls the grid back.
      redraw(app.scrolled(f64.toF32(-dy)))
    }
    Event.KeyDown { window: _, key: _, code, modifiers: _, repeat, imeHandled } => {
      if imeHandled || repeat {
        nothing()
      } else if code == KeyCode.Space {
        app.toggleAnimation()
        redraw(true)
      } else if code == KeyCode.KeyG {
        app.toggleGrayscale()
        redraw(true)
      } else {
        nothing()
      }
    }
    Event.CloseRequested { window: _ } => Reaction { redraw: false, resized: false, quit: true }
    Event.QuitRequested => Reaction { redraw: false, resized: false, quit: true }
    _ => nothing()
  }
}

/// Only the size and quit events, for a host that draws without input (a check run).
pub fn track(size: &mut WindowSize, event: &Event) -> Reaction {
  return match &event.* {
    Event.Resized { window: _, size: content, scaleFactor } => {
      size.width = content.width
      size.height = content.height
      size.scale = scaleFactor
      Reaction { redraw: true, resized: true, quit: false }
    }
    Event.ScaleFactorChanged { window: _, scaleFactor } => {
      size.scale = scaleFactor
      Reaction { redraw: true, resized: true, quit: false }
    }
    Event.CloseRequested { window: _ } => Reaction { redraw: false, resized: false, quit: true }
    Event.QuitRequested => Reaction { redraw: false, resized: false, quit: true }
    _ => nothing()
  }
}
