//! The demo on WebGPU: paint a frame, copy the tiles it added into the GPU atlas, draw it with
//! `UiRenderer`, and optionally copy the result back for comparison with the CPU reference. The
//! same code runs natively (Dawn) and in the browser (`navigator.gpu`).
import demo.demo { Demo, Frame }
import atlas.atlas { AtlasError }
import ui_scene.color as color
import ui_scene.scene { Scene }
import ui_renderer.atlas_textures { GpuAtlas }
import ui_renderer.renderer { UiRenderer }
import ui_renderer.text { TextSettings }
import vector.geometry_error { GeometryError }
import gpu_scene.renderer { extent }
import webgpu.runtime { Device, GpuError }
import webgpu.resources as gpu
import webgpu.resources { Buffer, Queue, Texture, TextureView }
import webgpu.descriptors {
  BufferDescriptor,
  TexelCopyBufferInfo,
  TexelCopyBufferLayout,
  TexelCopyTextureInfo
}
import webgpu_sys.generated_webgpu as flags
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

/// Keeps a scene, the renderer and the GPU copies of the atlas textures across frames.
pub struct GpuFrames {
  scene: Scene,
  renderer: UiRenderer,
  textures: GpuAtlas,
  format: u32,
}

impl GpuFrames {
  pub effect fn make(device: &Device, format: u32) -> GpuFrames
    ! GpuError {
    return GpuFrames {
      scene: Scene.make(),
      renderer: run UiRenderer.make(device, format),
      textures: GpuAtlas.make(),
      format: format,
    }
  }

  /// Turns the text gamma and contrast correction off, so glyphs blend exactly as the CPU
  /// reference blends them. For comparisons only: windows keep the correction.
  pub fn useReferenceText(self: &mut Self) -> () {
    self.renderer.setTextSettings(TextSettings.none())
  }

  pub fn surfaceFormat(self: &Self) -> u32 {
    return self.format
  }

  pub fn lastScene(self: &Self) -> &Scene {
    return &self.scene
  }

  /// Paints `frame` and uploads the tiles it added: new atlas textures first, then each tile.
  pub effect fn prepare(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    app: &mut Demo,
    frame: Frame,
  ) -> ()
    ! AtlasError | GeometryError | GpuError | OutOfMemoryError
    ? &mut Allocator {
    run app.paint(&mut self.scene, frame)
    run self.textures.sync(device, app.currentAtlas())
    let pending = app.pendingUploads()
    let list = pending.uploads()
    let mut i: usize = 0
    while i < list.length {
      self.textures.write(queue, list[i].tile, pending.pixels(list[i]))
      i = i + 1
    }
    app.clearPending()
  }

  /// Draws the prepared frame into `target`, `width` x `height` device pixels, and submits.
  pub effect fn draw(
    self: &mut Self,
    device: &Device,
    queue: &Queue,
    target: &TextureView,
    width: u32,
    height: u32,
  ) -> ()
    ! GpuError | OutOfMemoryError
    ? &mut Allocator {
    run self.renderer.draw(
      device,
      queue,
      &self.scene,
      &self.textures,
      target,
      width,
      height,
      color.white(),
    )
  }
}
