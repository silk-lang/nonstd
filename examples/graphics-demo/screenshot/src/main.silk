//! Renders demo frames with the CPU reference renderer and writes them as PNG files, without a
//! window or a GPU.
//!
//!   graphics-demo-screenshot OUT.png [WIDTH HEIGHT SCALE TIME]
//!
//! WIDTH and HEIGHT are logical points (default 1024 x 720), SCALE the scale factor (default 1)
//! and TIME the animation time in seconds (default 0.5).
import demo.demo { Demo, DemoError, Frame }
import demo.cpu { renderCpu }
import codec.png
import codec.png { PngError }
import codec.image { ImageError }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format, ParseError }
import silk.text.string { String }
import silk.num.f32
import silk.num.f64

effect fn argument(index: usize, fallback: string<'static>) -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return match run HostInput.argument(index) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => run Bytes.copy(Intrinsic.stringUtf8Bytes(fallback))
  }
}

effect fn number(index: usize, fallback: string<'static>) -> f64
  ! HostInputError | OutOfMemoryError | ParseError
  ? &mut HostInput | &mut Allocator {
  let raw = run argument(index, fallback)
  let text = unsafe String.fromUtf8Unchecked(Bytes.asSlice(&raw))
  return match move Format.f64Value(text) {
    Result<f64, ParseError>.Success { value } => value
    Result<f64, ParseError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn process() -> i32
  ! DemoError
    | AtlasError
    | GeometryError
    | OutOfMemoryError
    | HostInputError
    | ParseError
    | FileError
    | ImageError
    | PngError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  if count < 2 {
    StderrWriter.print("usage: graphics-demo-screenshot OUT.png [WIDTH HEIGHT SCALE TIME]\n", &())
    return 2
  }
  let out = run argument(1, "")
  let frame = Frame {
    width: f64.toF32(run number(2, "1024")),
    height: f64.toF32(run number(3, "720")),
    scale: f64.toF32(run number(4, "1")),
    time: run number(5, "0.5"),
  }
  let mut app = run Demo.make()
  let image = run renderCpu(&mut app, frame)
  let encoded = run png.encodePixels(image.width(), image.height(), image.data())
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let file = run Path.resolveBytes(&base, Bytes.asSlice(&out))
  let mut files = run MachineFileSystem.make()
  run FileSystem.writeFile(&file, Bytes.asSlice(&encoded))
    |> Effect.provideMut<FileSystem>(&mut files)
  let stats = app.stats()
  StderrWriter.print("{} primitives, {} atlas textures\n", &(stats.primitives, stats.atlasTextures))
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("graphics-demo-screenshot: failed\n", &())
  return 1
}

effect fn demoFailed(error: DemoError) -> i32 {
  let what = match error {
    DemoError.Font => "a font"
    DemoError.Icon => "an icon"
    DemoError.Photo => "a photo"
  }
  StderrWriter.print("graphics-demo-screenshot: could not load {}\n", &.(what))
  return 1
}

effect fn atlasFailed(error: AtlasError) -> i32 {
  drop error
  StderrWriter.print("graphics-demo-screenshot: the atlas is full\n", &())
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<AtlasError>(Effect.catch<DemoError>(process(), demoFailed), atlasFailed),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
