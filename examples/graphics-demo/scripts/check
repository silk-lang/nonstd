#!/usr/bin/env node
// Application-owned format, target and rendering checks. Library generation is owned by its pinned release.
(async () => {
  const { parseArgs } = await import('node:util');
  const { readdirSync, readFileSync } = await import('node:fs');
  const { join } = await import('node:path');
  const { build, run, root } = await import('../../../scripts/internal.mjs');
  const { repositoryRoot } = await import('../../../scripts/dependency-root.mjs');
  const { values } = parseArgs({ options: { 'skip-gpu': { type: 'boolean' } } });
  const packageRoot = join(root, 'examples/graphics-demo');
  const canonical = readFileSync(join(repositoryRoot('lib-native'), 'native/gpu/webgpu/browser/generated_webgpu_exports.silk'));
  if (!canonical.equals(readFileSync(join(packageRoot, 'browser/src/generated_webgpu_exports.silk')))) {
    throw new Error('Browser exports differ from pinned lib-native; run node examples/graphics-demo/scripts/browser build');
  }
  for (const name of ['', 'screenshot', 'host', 'tests', 'app', 'browser']) {
    const directory = join(packageRoot, name);
    const manifest = join(directory, 'silk.toml');
    const sources = readdirSync(join(directory, 'src')).filter(name => name.endsWith('.silk') && !name.startsWith('generated_')).sort().map(name => join(directory, 'src', name));
    run('silk', ['format', '--check', '--manifest-path', manifest, ...sources]);
    run('silk', ['check', '--manifest-path', manifest]);
  }
  for (const name of ['', 'host', 'browser']) run('silk', ['check', '--manifest-path', join(packageRoot, name, 'silk.toml'), '--target', 'wasm32-unknown-unknown']);
  for (const target of ['aarch64-apple-darwin', 'x86_64-pc-windows-msvc']) run('silk', ['check', '--manifest-path', join(packageRoot, 'app/silk.toml'), '--target', target]);
  const binary = build('examples/graphics-demo/tests', { release: true });
  run(binary, ['examples/graphics-demo/tests/goldens', ...(values['skip-gpu'] ? ['--skip-gpu'] : [])], { timeout: 600000 });
})().catch(error => { console.error(error); process.exitCode = 1; });
