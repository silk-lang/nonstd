#!/usr/bin/env python3
"""Gate for examples/graphics-demo: fresh generated modules, formatting, package checks (native, wasm32 and
the macOS and Windows targets) and, unless --skip-gpu, the goldens and the GPU comparison on Dawn
(lavapipe in CI). The window and browser runs are scripts/app check and scripts/browser test."""
import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[1]
sys.path.insert(0, str(REPO / "native" / "gpu" / "webgpu" / "scripts"))
from _build import build, command_path, executable  # noqa: E402

PACKAGES = ("", "screenshot", "host", "tests", "app", "browser")

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-gpu", action="store_true", help="check the goldens on the CPU only")
args = parser.parse_args()


def run(command, **kwargs):
    print("+ " + shlex.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=REPO, check=True, **kwargs)


run([sys.executable, REPO / "ui/assets/scripts/embed-assets", "--check"])
run([sys.executable, REPO / "native/gpu/webgpu/scripts/generate-browser", "--check"])
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
silk = compiler_bin / executable("silk")
for package in PACKAGES:
    manifest = ROOT / package / "silk.toml"
    # Generated modules keep their generator's layout.
    sources = sorted(path for path in (ROOT / package / "src").glob("*.silk") if not path.name.startswith("generated_"))
    run([silk, "format", "--check", "--manifest-path", manifest, *sources])
    run([silk, "check", "--manifest-path", manifest])
for package in ("", "host", "browser"):
    run([silk, "check", "--manifest-path", ROOT / package / "silk.toml", "--target", "wasm32-unknown-unknown"])
for target in ("aarch64-apple-darwin", "x86_64-pc-windows-msvc"):
    run([silk, "check", "--manifest-path", ROOT / "app/silk.toml", "--target", target])
# Debug builds of the CPU reference take minutes; the tests are built optimized. The goldens
# path is relative: file access is scoped to the working directory.
binary = build(ROOT / "tests", release=True)
run([binary, (ROOT / "tests/goldens").relative_to(REPO), *(["--skip-gpu"] if args.skip_gpu else [])], timeout=600)
