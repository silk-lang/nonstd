#!/usr/bin/env node
(async () => {
  const { parseArgs } = await import('node:util');
  const { join } = await import('node:path');
  const { run, root } = await import('../../../scripts/internal.mjs');
  const { buildBrowser } = await import('../../browser-build.mjs');
  const { values, positionals } = parseArgs({ allowPositionals: true, options: {
    port: { type: 'string', default: '8040' }, debug: { type: 'boolean' }
  } });
  const [mode] = positionals;
  if (positionals.length !== 1 || !['serve', 'test', 'build'].includes(mode)) throw new Error('Usage: browser serve|test|build [--port PORT] [--debug]');
  const wasm = buildBrowser('examples/graphics-demo/browser', { release: !values.debug });
  if (mode === 'build') { console.log(wasm); return; }
  const web = join(root, 'examples/graphics-demo/web');
  if (mode === 'serve') run(process.execPath, [join(web, 'serve.mjs'), wasm, values.port]);
  else {
    const command = [process.execPath, join(web, 'test.mjs'), '--wasm', wasm];
    if (process.platform === 'linux') run('xvfb-run', ['--auto-servernum', '--server-args=-screen 0 1280x800x24', ...command], { timeout: 900000 });
    else run(command[0], command.slice(1), { timeout: 900000 });
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
