#!/usr/bin/env python3
"""Build the demo for wasm32 and serve it, or test it in the installed Chromium.

  scripts/browser serve [--port 8040]   http://127.0.0.1:8040/ in a WebGPU browser
  scripts/browser test                  the check and an interaction run in Chromium

`test` needs Node and an existing Playwright installation (PLAYWRIGHT_MODULE, as set by
native/gpu/webgpu/scripts/setup-ci --browser); it never downloads a browser. On Linux it runs under
xvfb-run, as Chromium's headless mode lacks WebGPU presentation.
"""
import argparse
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT.parents[1] / "native" / "gpu" / "webgpu" / "scripts"))
from _build import build  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("mode", choices=["serve", "test", "build"])
    parser.add_argument("--port", type=int, default=8040)
    parser.add_argument("--debug", action="store_true", help="a debug build (slow CPU reference)")
    args = parser.parse_args()
    module = build(ROOT / "browser", release=not args.debug, target="wasm32-unknown-unknown")
    if args.mode == "build":
        print(module)
        return 0
    if args.mode == "serve":
        return subprocess.run(["node", str(ROOT / "web/serve.mjs"), str(module), str(args.port)]).returncode
    command = ["node", str(ROOT / "web/test.mjs"), "--wasm", str(module)]
    if sys.platform == "linux":
        if not shutil.which("xvfb-run") or not shutil.which("xauth"):
            raise SystemExit("the browser test needs xvfb-run and xauth on Linux; run native/gpu/webgpu/scripts/setup-ci --browser")
        command = ["xvfb-run", "--auto-servernum", "--server-args=-screen 0 1280x800x24", *command]
    return subprocess.run(command, timeout=900).returncode


if __name__ == "__main__":
    raise SystemExit(main())
