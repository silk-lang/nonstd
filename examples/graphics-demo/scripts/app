#!/usr/bin/env node
(async () => {
  const { parseArgs } = await import('node:util');
  const { build, run, root } = await import('../../../scripts/internal.mjs');
  const { windowCheck } = await import('../../internal.mjs');
  const argv = process.argv.slice(2);
  const separator = argv.indexOf('--');
  const forwarded = separator < 0 ? [] : argv.splice(separator).slice(1);
  const { values, positionals } = parseArgs({ args: argv, allowPositionals: true, options: {
    backend: { type: 'string', default: 'all' }, release: { type: 'boolean' }, 'build-only': { type: 'boolean' }
  } });
  const mode = positionals.shift() ?? 'run';
  if (!['run', 'check'].includes(mode)) throw new Error('Usage: app [run|check] [--release] [--build-only] [--backend x11|wayland|all] [-- ARGS]');
  const program = build('examples/graphics-demo/app', { release: values.release });
  if (values['build-only']) console.log(program);
  else if (mode === 'check') process.exitCode = await windowCheck(program, values.backend);
  else run(program, [...positionals, ...forwarded], { cwd: root });
})().catch(error => { console.error(error); process.exitCode = 1; });
