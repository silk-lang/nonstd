//! A frame drawn by the CPU reference renderer, for headless screenshots and as what the GPU
//! frame is compared with.
import demo { Demo, Frame }
import atlas.atlas { AtlasError }
import ui_scene.cpu { AtlasPixels, CpuRenderer }
import ui_scene.scene { Scene }
import vector.geometry_error { GeometryError }
import vector.pixmap { Pixmap }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32

/// The device size of `frame` in pixels.
pub fn deviceWidth(frame: Frame) -> u32 {
  return f32.toU32(f32.floor(frame.width * frame.scale + 0.5))
}

pub fn deviceHeight(frame: Frame) -> u32 {
  return f32.toU32(f32.floor(frame.height * frame.scale + 0.5))
}

/// Keeps a scene, a CPU renderer and CPU copies of the atlas textures across frames.
pub struct CpuFrames {
  scene: Scene,
  pixels: AtlasPixels,
  renderer: CpuRenderer,
}

impl CpuFrames {
  pub fn make() -> CpuFrames {
    return CpuFrames {
      scene: Scene.make(),
      pixels: AtlasPixels.make(),
      renderer: CpuRenderer.make(),
    }
  }

  /// Paints `frame` and copies its uploads into the CPU textures, without drawing it.
  pub effect fn prepare(self: &mut Self, app: &mut Demo, frame: Frame) -> ()
    ! AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    run app.paint(&mut self.scene, frame)
    run self.pixels.sync(app.currentAtlas())
    let pending = app.pendingUploads()
    let list = pending.uploads()
    let mut i: usize = 0
    while i < list.length {
      self.pixels.write(list[i].tile, pending.pixels(list[i]))
      i = i + 1
    }
    app.clearPending()
  }

  /// Draws the prepared frame.
  pub effect fn render(self: &mut Self, frame: Frame) -> Pixmap
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let mut target = run Pixmap.make(deviceWidth(frame), deviceHeight(frame))
    run self.renderer.draw(&self.scene, &self.pixels, &mut target)
    return move target
  }

  /// Paints, uploads and draws `frame`.
  pub effect fn draw(self: &mut Self, app: &mut Demo, frame: Frame) -> Pixmap
    ! AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    run self.prepare(&mut app, frame)
    return run self.render(frame)
  }

  pub fn lastScene(self: &Self) -> &Scene {
    return &self.scene
  }
}

/// One frame of a fresh CPU pipeline.
pub effect fn renderCpu(app: &mut Demo, frame: Frame) -> Pixmap
  ! AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let mut frames = CpuFrames.make()
  return run frames.draw(&mut app, frame)
}
