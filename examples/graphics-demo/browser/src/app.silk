//! The browser host. A browser cannot block, so the page calls `demo_tick` from
//! `requestAnimationFrame` and whenever the window host queues an event; each tick advances the
//! adapter and device requests, drains the window's events with `Wait.Poll`, and draws when a
//! frame was requested.
//!
//! With `check` set, the tick draws three frames at a fixed time without input, copies the
//! canvas texture back, compares it with the CPU reference drawn by the same module, and reports
//! the result (kind 1); `demo_tick` then returns 1 for a pass and 2 for a failure.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import demo.demo { Demo, DemoError, Frame }
  import demo.cpu { CpuFrames }
  import ui_renderer.compare { Comparison, Tolerance, compare }
  import demo_host.frames { GpuFrames }
  import ui_renderer.readback { copyOut, isBgra, pickFormat, readbackSize, unpack }
  import demo_host.events { Reaction, WindowSize, apply, track }
  import atlas.atlas { AtlasError }
  import vector.geometry_error { GeometryError }
  import window.event { Event }
  import window.native { NativePlatform }
  import window.platform { Platform }
  import window.types { Wait, WindowError, WindowId, WindowOptions }
  import webgpu.runtime {
    Adapter,
    AdapterRequest,
    Device,
    DeviceRequest,
    GpuError,
    Instance,
    MapReadRequest,
    RequestAdapterOptions
  }
  import webgpu.runtime as runtime
  import webgpu.resources { Queue, getQueue }
  import webgpu.surface { Surface, SurfaceConfiguration, SurfaceTarget }
  import webgpu.descriptors { DeviceDescriptor, TextureViewDescriptor }
  import webgpu_sys.generated_webgpu as flags
  import silk.collections.list { List }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.mem.box { Box }
  import silk.mem.pointer { Pointer }
  import silk.num.f32
  import silk.num.f64
  import silk.num.u32
  import silk.num.u64
  import silk.num.usize
  import silk.text.string { String }

  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn hostReport(
    kind: u32,
    bytes: ?[*]const u8,
    length: usize,
  ) -> () as "demo#report"

  /// The canvas the page registers with the window host before `demo_start`.
  fn canvasId() -> &'static [u8] {
    return b"silk-demo"
  }

  const CHECK_FRAME: u64 = 3

  const CHECK_TIME: f64 = 0.75

  fn report(kind: u32, text: &[u8]) -> () {
    unsafe hostReport(kind, Pointer.fromSlice(text), text.length)
  }

  struct Failed {}

  struct FindingAdapter {
    request: AdapterRequest<'static>,
  }

  struct FindingDevice {
    adapter: Adapter,
    request: DeviceRequest,
  }

  struct Running {
    device: Device,
    queue: Queue,
    surface: Surface<'static>,
    format: u32,
    frames: GpuFrames,
    configured: bool,
  }

  struct Reading {
    running: Running,
    request: MapReadRequest,
    width: u32,
    height: u32,
    bgra: bool,
  }

  struct Done {
    status: i32,
  }

  struct Unrooted {}

  struct Root {
    storage: Box<State>,
  }

  struct State {
    instance: Instance,
    platform: NativePlatform,
    window: WindowId,
    app: Demo,
    referenceApp: Demo,
    cpu: CpuFrames,
    size: WindowSize,
    check: bool,
    wantFrame: bool,
    startTime: f64,
    pausedAt: f64,
    pausedFor: f64,
    wasAnimating: bool,
    drawn: u64,
    lastFrame: Frame,
    stage: Failed | FindingAdapter | FindingDevice | Running | Reading | Done,
    root: Unrooted | Root,
  }

  effect fn start(check: bool) -> ?*mut u8
    ! WindowError | GpuError | DemoError | OutOfMemoryError
    ? &mut Allocator {
    let mut platform = run NativePlatform.start()
    let window = run platform.openWindow(&WindowOptions.make("Silk drawing layer", 1024.0, 720.0))
    let initial = platform.contentSize(window)
    let size = WindowSize {
      width: initial.width,
      height: initial.height,
      scale: platform.scaleFactor(window),
    }
    let instance = run Instance.create()
    let request = run instance.requestAdapterStart(&RequestAdapterOptions.default())
    let app = run Demo.make()
    let referenceApp = run Demo.make()
    let mut storage = run Box<State>.make(
      State {
        instance: move instance,
        platform: move platform,
        window: window,
        app: move app,
        referenceApp: move referenceApp,
        cpu: CpuFrames.make(),
        size: size,
        check: check,
        wantFrame: true,
        startTime: -1.0,
        pausedAt: 0.0,
        pausedFor: 0.0,
        wasAnimating: true,
        drawn: 0,
        lastFrame: Frame { width: 0.0, height: 0.0, scale: 1.0, time: 0.0 },
        stage: FindingAdapter { request: move request },
        root: Unrooted {},
      },
    )
    let pinned = Pointer.fromMutRef(&mut storage.getMut()[0])
    let mut anchor = ()

    // The self-rooted Box of native/gpu/webgpu's examples: the page owns the token until demo_drop and
    // never ticks twice at once or after the drop.
    let fresh = unsafe Pointer.borrowMut(&mut anchor, pinned)
    fresh.root = Root { storage: move storage }
    return unsafe Intrinsic.pointerReinterpret<*mut State, *mut u8>(pinned)
  }

  /// Applies queued window events. Returns false when the window asked to quit.
  effect fn drain(state: &mut State) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    while true {
      let next = run state.platform.nextEvent(Wait.Poll)
      match &next {
        Option<Event>.Some { value } => {
          let reaction = match &value {
            Event.RequestFrame { window, targetTime } => {
              if state.startTime < 0.0 {
                state.startTime = targetTime
              }
              state.wantFrame = true
              state.lastFrame.time = targetTime
              Reaction { redraw: false, resized: false, quit: false }
            }
            _ => if state.check {
              track(&mut state.size, &value)
            } else {
              apply(&mut state.app, &mut state.size, &value)
            }
          }
          if reaction.quit {
            return false
          }
          if reaction.resized {
            state.wantFrame = true
            if let Running running = &mut state.stage {
              running.configured = false
            }
          }
          if reaction.redraw {
            state.platform.requestFrame(state.window)
          }
        }
        _ => {
          return true
        }
      }
    }
    return true
  }

  /// The animation time for a frame shown at `targetTime`, minus time spent paused.
  fn animationTime(state: &mut State, targetTime: f64) -> f64 {
    if state.check {
      return CHECK_TIME
    }
    let animating = state.app.isAnimating()
    if animating != state.wasAnimating {
      if animating {
        state.pausedFor = state.pausedFor + (targetTime - state.pausedAt)
      } else {
        state.pausedAt = targetTime
      }
      state.wasAnimating = animating
    }
    return if animating {
      targetTime - state.startTime - state.pausedFor
    } else {
      state.pausedAt - state.startTime - state.pausedFor
    }
  }

  /// Draws a frame. Returns the readback request when this is the checked frame.
  effect fn draw(state: &mut State, running: &mut Running) -> Option<MapReadRequest>
    ! GpuError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let width = state.size.deviceWidth()
    let height = state.size.deviceHeight()
    if width == 0 || height == 0 {
      return Option<MapReadRequest>.None
    }
    if !running.configured {
      let mut configuration = SurfaceConfiguration.make(
        &running.device,
        running.format,
        width,
        height,
      )
      if state.check {
        configuration.setUsage(
          flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc,
        )
      }
      running.surface.configure(&configuration)
      running.configured = true
    }
    let target = state.lastFrame.time
    let frame = Frame {
      width: f64.toF32(state.size.width),
      height: f64.toF32(state.size.height),
      scale: f64.toF32(state.size.scale),
      time: animationTime(&mut state, target),
    }
    state.lastFrame = Frame {
      width: frame.width,
      height: frame.height,
      scale: frame.scale,
      time: target,
    }
    run running.frames.prepare(&running.device, &running.queue, &mut state.app, frame)
    let texture = run running.surface.getCurrentTexture()
    let view = run texture.texture.createView(&TextureViewDescriptor.default())
    run running.frames.draw(&running.device, &running.queue, &view, width, height)
    state.drawn = state.drawn + 1
    let mut readback = Option<MapReadRequest>.None
    if state.check {
      run state.cpu.prepare(&mut state.referenceApp, frame)
      if state.drawn == CHECK_FRAME {
        let buffer = run copyOut(&running.device, &running.queue, &texture.texture, width, height)
        readback = Option<MapReadRequest>.some(
          run runtime.mapReadStart(&running.device, &buffer, 0, readbackSize(width, height)),
        )
      }
    }
    run running.surface.present()
    if state.app.isAnimating() || state.check {
      state.platform.requestFrame(state.window)
    }
    return move readback
  }

  effect fn finishCheck(
    state: &mut State,
    padded: &[u8],
    width: u32,
    height: u32,
    bgra: bool,
  ) -> i32
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let pixels = run unpack(padded, width, height, bgra)
    let frame = Frame {
      width: f64.toF32(state.size.width),
      height: f64.toF32(state.size.height),
      scale: f64.toF32(state.size.scale),
      time: CHECK_TIME,
    }
    let expected = run state.cpu.render(frame)
    let result = compare(expected.data(), pixels.asSlice(), width)
    let ok = result.within(Tolerance.frame())

    // A fixed record the page decodes: width, height, max, worst x, worst y, over, channels,
    // mean x 10000, pass.
    let words: [u32; 9] = [
      width,
      height,
      result.max,
      result.worstX,
      result.worstY,
      result.over,
      usize.toU32(result.channels),
      f64.toU32(f64.floor(f32.toF64(result.mean) * 10000.0 + 0.5)),
      if ok {
        1
      } else {
        0
      },
    ]
    let mut bytes = List<u8>.make()
    let mut i: usize = 0
    while i < 9 {
      let w = words[i]
      run bytes.append(u32.toU8(w % 256))
      run bytes.append(u32.toU8(w / 256 % 256))
      run bytes.append(u32.toU8(w / 65536 % 256))
      run bytes.append(u32.toU8(w / 16777216))
      i = i + 1
    }
    report(1, bytes.asSlice())
    return if ok {
      1
    } else {
      2
    }
  }

  effect fn tick(state: &mut State) -> i32
    ! GpuError | AtlasError | GeometryError | OutOfMemoryError
    ? &mut Allocator {
    if !run drain(&mut state) {
      return 3
    }
    let previous = Intrinsic.replace(state.stage, Failed {})
    match move previous {
      Failed failed => {
        fail GpuError.status(0xffffffff)
      }
      FindingAdapter { request } => {
        let mut pending = move request
        if pending.poll() {
          let adapter = run pending.finish()
          let next = run adapter.requestDeviceStart(&DeviceDescriptor.default())
          state.stage = FindingDevice { adapter: move adapter, request: move next }
        } else {
          state.stage = FindingAdapter { request: move pending }
        }
      }
      FindingDevice { adapter, request } => {
        let mut pending = move request
        if pending.poll() {
          let device = run pending.finish()
          let target = SurfaceTarget.canvasId(canvasId())
          let surface = run Surface.create(&state.instance, &target, b"demo")
          let capabilities = run surface.getCapabilities(&adapter)
          let format = pickFormat(capabilities.formats())
          if format == 0 {
            report(0, b"the canvas offers neither BGRA8 nor RGBA8 unorm")
            fail GpuError.status(flags.WGPUStatus_Error)
          }
          let queue = run getQueue(&device)
          let mut frames = run GpuFrames.make(&device, format)
          if state.check {
            frames.useReferenceText()
          }
          state.stage = Running {
            device: move device,
            queue: move queue,
            surface: move surface,
            format: format,
            frames: move frames,
            configured: false,
          }
          state.wantFrame = false
          state.platform.requestFrame(state.window)
        } else {
          state.stage = FindingDevice { adapter: move adapter, request: move pending }
        }
      }
      Running running => {
        let mut active = move running
        run active.device.checkErrors()
        if state.wantFrame {
          state.wantFrame = false
          let readback = run draw(&mut state, &mut active)
          if let Option<MapReadRequest>.Some { value } = move readback {
            let bgra = isBgra(active.frames.surfaceFormat())
            state.stage = Reading {
              running: move active,
              request: move value,
              width: state.size.deviceWidth(),
              height: state.size.deviceHeight(),
              bgra: bgra,
            }
            return 0
          }
        }
        state.stage = move active
      }
      Reading { running, request, width, height, bgra } => {
        let mut pending = move request
        run running.device.checkErrors()
        if pending.poll() {
          let padded = run pending.finish()
          let status = run finishCheck(&mut state, padded.asSlice(), width, height, bgra)
          state.stage = Done { status: status }
          return status
        }
        state.stage = Reading {
          running: move running,
          request: move pending,
          width: width,
          height: height,
          bgra: bgra,
        }
      }
      Done done => {
        let status = done.status
        state.stage = Done { status: status }
        return status
      }
    }
    return 0
  }

  effect fn startFailed<E>(error: E) -> ?*mut u8 {
    drop error
    report(0, b"demo_start failed: window, adapter, assets or allocation")
    return Pointer.null<u8>()
  }

  effect fn tickFailed<E>(error: E) -> i32 {
    drop error
    report(0, b"demo_tick failed: surface, validation, device loss, atlas, geometry or allocation")
    return -1
  }

  fn stateOf(token: ?*mut u8) -> Option<*mut State> {
    if Pointer.isNull(token) {
      return Option<*mut State>.None
    }
    let pointer = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(token)
    return Option<*mut State>.some(
      unsafe Intrinsic.pointerReinterpret<*mut u8, *mut State>(pointer),
    )
  }

  export "C" fn demoStart(check: u32) -> ?*mut u8 as "demo_start" {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(start(check != 0), startFailed)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }

  /// 0 while running, 1 or 2 once a check passed or failed, 3 when the window closed, -1 on an
  /// error.
  export "C" fn demoTick(token: ?*mut u8) -> i32 as "demo_tick" {
    if let Option<*mut State>.Some { value } = stateOf(token) {
      let mut anchor = ()
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      let mut allocator = Allocator.systemAllocatorProvider()
      return run Effect.catchAll(tick(&mut state), tickFailed)
        |> Effect.provideMut<Allocator>(&mut allocator)
    }
    return -1
  }

  export "C" fn demoDrop(token: ?*mut u8) -> () as "demo_drop" {
    if let Option<*mut State>.Some { value } = stateOf(token) {
      let mut anchor = ()
      let state = unsafe Pointer.borrowMut(&mut anchor, value)
      let root = Intrinsic.replace(state.root, Unrooted {})
      match move root {
        Root { storage } => {
          drop storage
        }
        Unrooted empty => ()
      }
    }
  }
}
