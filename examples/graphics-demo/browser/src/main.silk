//! The demo in a browser: a wasm module the page in `examples/graphics-demo/web` drives from
//! `requestAnimationFrame`. modules/platform/window's browser backend owns the canvas and its input,
//! modules/gpu/webgpu's host maps WebGPU onto `navigator.gpu`. Exports (see `app`): `demo_start(check)`,
//! `demo_tick(token)`, `demo_drop(token)`; import `demo#report(kind, bytes, length)`.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import app
  import libm
  import generated_webgpu_exports

  pub fn main() -> i32 {
    return 0
  }
} else {
  pub fn main() -> i32 {
    return 0
  }
}
