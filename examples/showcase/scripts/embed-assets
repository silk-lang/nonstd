#!/usr/bin/env node
// Optional regeneration of the checked-in bytes; --check detects stale generated assets.
async function main() {
  const { readFileSync, readdirSync, writeFileSync, existsSync } = await import('node:fs');
  const { resolve } = await import('node:path');
  const { parseArgs } = await import('node:util');
  const { values } = parseArgs({ options: {
    check: { type: 'boolean', default: false },
    help: { type: 'boolean', short: 'h', default: false },
  } });
  if (values.help) {
    console.log('Usage: examples/showcase/scripts/embed-assets [--check]\nEmbed local fonts and icons as Silk byte strings; --check reports stale generated assets.');
    return;
  }
  const root = resolve(__dirname, '..');
  const assets = resolve(root, 'assets');
  const output = resolve(root, 'src/generated_assets.silk');
  const files = [
    ...readdirSync(resolve(assets, 'fonts')).filter(name => name.endsWith('.ttf')).map(name => `fonts/${name}`),
    ...readdirSync(resolve(assets, 'icons')).filter(name => name.endsWith('.svg')).map(name => `icons/${name}`),
  ].sort();
  const lines = ['// Generated by scripts/embed-assets from examples/showcase/assets; do not edit.'];
  for (const [index, relative] of files.entries()) {
    if (index > 0) lines.push('');
    const words = relative.slice(0, relative.lastIndexOf('.')).replace(/[^0-9a-zA-Z]+/g, ' ').trim().split(/\s+/);
    const name = words[0].toLowerCase() + words.slice(1).map(word => word[0].toUpperCase() + word.slice(1)).join('');
    let escaped = '';
    for (const byte of readFileSync(resolve(assets, relative))) {
      escaped += byte >= 32 && byte < 127 && byte !== 34 && byte !== 92
        ? String.fromCharCode(byte) : `\\x${byte.toString(16).padStart(2, '0')}`;
    }
    lines.push(`/// assets/${relative}`, `pub fn ${name}() -> &'static [u8] {`, `  return b"${escaped}"`, '}');
  }
  const text = lines.join('\n') + '\n';
  if (values.check) {
    if (!existsSync(output) || readFileSync(output, 'utf8') !== text) {
      throw new Error(`${output} is stale; run examples/showcase/scripts/embed-assets`);
    }
  } else writeFileSync(output, text);
}
main().catch(error => {
  console.error(error.message);
  process.exitCode = 1;
});
