#!/usr/bin/env node
async function main() {
  const { parseArgs } = await import('node:util');
  const { resolve } = await import('node:path');
  const { build, root, run } = await import('../../../scripts/internal.mjs');
  const { windowCheck } = await import('../../internal.mjs');
  const { values, positionals } = parseArgs({ allowPositionals: true, options: {
    backend: { type: 'string', default: 'all' },
    'build-only': { type: 'boolean', default: false },
    release: { type: 'boolean', default: false },
    help: { type: 'boolean', short: 'h', default: false },
  } });
  if (values.help) {
    console.log(`Usage: examples/showcase/scripts/app [run|check] [--backend x11|wayland|all] [--build-only] [--release]
Build Silk Loom and open a native window, or print the executable with --build-only.
check scripts a Reweave click and compares the window surface with its CPU reference.
Linux checks start Xvfb/Weston and default to lavapipe; other platforms open a real window.
Requires Node.js, Silk and native build prerequisites; Linux checks also need Xvfb and Weston.`);
    return;
  }
  const mode = positionals[0] ?? 'run';
  if (positionals.length > 1 || !['run', 'check'].includes(mode)) throw new Error('Expected mode run or check');
  if (!['x11', 'wayland', 'all'].includes(values.backend)) throw new Error('Expected --backend x11, wayland or all');
  const program = build(resolve(root, 'examples/showcase/app'), { release: values.release });
  if (values['build-only']) console.log(program);
  else if (mode === 'check') process.exitCode = await windowCheck(program, values.backend);
  else run(program, [], { cwd: root });
}
main().catch(error => {
  console.error(error.message);
  process.exitCode = error.status ?? 1;
});
