//! Colors: HSV to RGBA, the three thread palettes and the blend between them.
import silk.color.rgba { Rgba }
import silk.num.f32
import silk.num.u32

/// How many ribbons a palette colors.
pub const RIBBONS: u32 = 5

/// How many palettes "Reweave" cycles through.
pub const PALETTES: u32 = 3

/// An sRGB color from hue `h` in degrees, saturation `s`, value `v` and alpha `a` (0 to 1).
pub fn hsv(h: f32, s: f32, v: f32, a: f32) -> Rgba<f32> {
  let hh = h - 360.0 * f32.floor(h / 360.0)
  let sector = hh / 60.0
  let c = v * s
  let wave = sector - 2.0 * f32.floor(sector / 2.0)
  let x = c * (1.0 - f32.abs(wave - 1.0))
  let m = v - c
  let mut r: f32 = 0.0
  let mut g: f32 = 0.0
  let mut b: f32 = 0.0
  if sector < 1.0 {
    r = c
    g = x
  } else if sector < 2.0 {
    r = x
    g = c
  } else if sector < 3.0 {
    g = c
    b = x
  } else if sector < 4.0 {
    g = x
    b = c
  } else if sector < 5.0 {
    r = x
    b = c
  } else {
    r = c
    b = x
  }
  return Rgba<f32> { r: r + m, g: g + m, b: b + m, a: a }
}

/// An opaque color from `0xRRGGBB`.
pub fn rgb(hex: u32) -> Rgba<f32> {
  return rgba(hex, 1.0)
}

/// A color from `0xRRGGBB` and an alpha.
pub fn rgba(hex: u32, alpha: f32) -> Rgba<f32> {
  let r = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 16), 255)) / 255.0
  let g = u32.toF32(u32.bitAnd(u32.shiftRight(hex, 8), 255)) / 255.0
  let b = u32.toF32(u32.bitAnd(hex, 255)) / 255.0
  return Rgba<f32> { r: r, g: g, b: b, a: alpha }
}

/// White at `alpha`.
pub fn white(alpha: f32) -> Rgba<f32> {
  return Rgba<f32> { r: 1.0, g: 1.0, b: 1.0, a: alpha }
}

/// The hue of ribbon `ribbon` in palette `palette`: Aurora, Ember, then Lagoon.
pub fn ribbonHue(palette: u32, ribbon: u32) -> f32 {
  let hues: [f32; 15] = [
    322.0,
    268.0,
    190.0,
    152.0,
    38.0,
    8.0,
    28.0,
    342.0,
    48.0,
    300.0,
    196.0,
    222.0,
    172.0,
    252.0,
    140.0,
  ]
  return hues[u32.toUsize((palette % PALETTES) * RIBBONS + ribbon % RIBBONS)]
}

/// The palette's name, for the status line.
pub fn paletteName(palette: u32) -> string<'static> {
  return match palette % PALETTES {
    0 => "aurora"
    1 => "ember"
    _ => "lagoon"
  }
}

/// `x` clamped to 0..1 and eased with smoothstep.
pub fn ease(x: f32) -> f32 {
  let t = f32.min(f32.max(x, 0.0), 1.0)
  return t * t * (3.0 - 2.0 * t)
}

/// The hue `t` of the way from `from` to `to`, the short way round.
pub fn mixHue(from: f32, to: f32, t: f32) -> f32 {
  let mut delta = to - from
  delta = delta - 360.0 * f32.floor((delta + 180.0) / 360.0)
  return from + delta * t
}
