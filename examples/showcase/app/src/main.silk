//! Silk Loom in a native window (Metal on macOS, D3D12 on Windows, Vulkan on Linux).
//!
//!   ui-showcase-app [--check]
//!
//! Move the pointer through the threads, click anywhere for a ripple, press "Reweave" (or R)
//! for the next palette and Space to pause.
//!
//! `--check` ignores real input: it clicks "Reweave", then compares the window's surface with
//! the CPU reference of the same frame. Exit code 0 within tolerance, 1 outside, 2 on an error.
import showcase.loom { Loom, Message }
import showcase.assets as assets
import ui_app.app { NoCommand }
import ui_app.runtime { Runtime }
import ui_app_window.lib { launch, Launched, RunOptions, runWindow }
import ui_tree.lib { TreeError, Batch }
import atlas.atlas { AtlasError }
import vector.geometry_error { GeometryError }
import window.types { WindowError }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn checkMode() -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value } = run HostInput.argument(i) {
      if same(Bytes.asSlice(&value), b"--check") {
        return true
      }
    }
    i = i + 1
  }
  return false
}

effect fn program(check: bool, platform: Option<Launched>) -> i32
  ! WindowError | GpuError | TreeError | AtlasError | GeometryError | OutOfMemoryError
  ? &mut Allocator {
  let collection = run assets.fonts()
  let mut batch = Batch.make()
  run assets.resources(&mut batch)
  let mut app = Runtime<Loom, Message, NoCommand>.make(Loom.make(1280.0, 720.0, false))
  let options = RunOptions {
    title: "Silk Loom",
    width: 1280.0,
    height: 720.0,
    check: check,
    checkClick: "reweave",
    checkExpect: "status",
    lowestLatency: false,
    platform: move platform,
  }
  return run runWindow(&mut app, &collection, run batch.take(), move options)
}

effect fn windowFailed(error: WindowError) -> i32 {
  drop error
  StderrWriter.print("ui-showcase-app: could not open a window (no display server?)\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32 {
  StderrWriter.print("ui-showcase-app: GPU error {}\n", &(error.code,))
  return 2
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("ui-showcase-app: failed (tree, atlas, geometry or allocation)\n", &())
  return 2
}

/// The app, on the UI thread `launch` made.
fn runApp(check: bool, platform: Option<Launched>) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    Effect.catch<GpuError>(
      Effect.catch<WindowError>(program(check, move platform), windowFailed),
      gpuFailed,
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noCheck<E>(error: E) -> bool {
  drop error
  return false
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let check = run Effect.catchAll(checkMode(), noCheck)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // The main thread keeps the OS event loop; the app runs on its own thread.
  return run Effect.catchAll(
    launch(
      fn(platform: Option<Launched>) -> i32 {
        return runApp(check, move platform)
      },
    ),
    failed,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
