pub struct Resource {}
impl Resource {
    // Returns borrowed +0 object; null preserves upstream optional absence.
    pub unsafe fn device(object: ?*mut u8) -> ?*mut u8 {
        return unsafe metal_Resource_device(object)
    }

    // Returns borrowed NUL-terminated UTF-8 from the owning NSString; may be null for no label.
    pub unsafe fn label(object: ?*mut u8) -> ?[*]const u8 {
        return unsafe metal_Resource_label(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn set_label(object: ?*mut u8, label: ?[*]const u8) -> () {
        unsafe metal_Resource_set_label(object, label)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn cpu_cache_mode(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_cpu_cache_mode(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn storage_mode(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_storage_mode(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn allocated_size(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_allocated_size(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn hazard_tracking_mode(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_hazard_tracking_mode(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn resource_options(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_resource_options(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn heap_offset(object: ?*mut u8) -> u64 {
        return unsafe metal_Resource_heap_offset(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn set_purgeable_state(object: ?*mut u8, state: u64) -> u64 {
        return unsafe metal_Resource_set_purgeable_state(object, state)
    }

    // Returns borrowed +0 object; null preserves upstream optional absence.
    pub unsafe fn heap(object: ?*mut u8) -> ?*mut u8 {
        return unsafe metal_Resource_heap(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn make_aliasable(object: ?*mut u8) -> () {
        unsafe metal_Resource_make_aliasable(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn is_aliasable(object: ?*mut u8) -> bool {
        return unsafe metal_Resource_is_aliasable(object) != 0
    }
}


pub struct Buffer {}
impl Buffer {
    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn length(object: ?*mut u8) -> u64 {
        return unsafe metal_Buffer_length(object)
    }

    // Returns borrowed mutable storage; caller guarantees CPU accessibility and synchronization.
    pub unsafe fn contents(object: ?*mut u8) -> ?[*]mut u8 {
        return unsafe metal_Buffer_contents(object)
    }

    // Takes the range record by value.
    pub unsafe fn did_modify_range(object: ?*mut u8, range: NSRange) -> () {
        unsafe metal_Buffer_did_modify_range(object, range)
    }

    // Returns +1 owned object, or null on allocation failure.
    pub unsafe fn new_texture_with_descriptor(object: ?*mut u8, descriptor: ?*mut u8, offset: u64, bytes_per_row: u64) -> ?*mut u8 {
        return unsafe metal_Buffer_new_texture_with_descriptor(object, descriptor, offset, bytes_per_row)
    }

    // Returns borrowed +0 object; null preserves upstream optional absence.
    pub unsafe fn remote_storage_buffer(object: ?*mut u8) -> ?*mut u8 {
        return unsafe metal_Buffer_remote_storage_buffer(object)
    }

    // Returns +1 owned object, or null on allocation failure.
    pub unsafe fn new_remote_buffer_view_for_device(object: ?*mut u8, device: ?*mut u8) -> ?*mut u8 {
        return unsafe metal_Buffer_new_remote_buffer_view_for_device(object, device)
    }

    // Takes the range record by value.
    pub unsafe fn add_debug_marker(object: ?*mut u8, name: ?[*]const u8, range: NSRange) -> () {
        unsafe metal_Buffer_add_debug_marker(object, name, range)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn remove_all_debug_markers(object: ?*mut u8) -> () {
        unsafe metal_Buffer_remove_all_debug_markers(object)
    }

    // Direct Metal selector; OS availability and receiver validity are caller obligations.
    pub unsafe fn gpu_address(object: ?*mut u8) -> u64 {
        return unsafe metal_Buffer_gpu_address(object)
    }

    // Upstream non-SDK selector: first check Native.responds_to(object, b"gpuResourceID\\0").
    // Prefer gpu_address for public buffer addressing. Returns the record by value.
    pub unsafe fn gpu_resource_id(object: ?*mut u8) -> MTLResourceID {
        return unsafe metal_Buffer_gpu_resource_id(object)
    }
}


