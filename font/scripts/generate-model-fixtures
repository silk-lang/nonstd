#!/usr/bin/env python3
"""Pack immutable upstream model fixtures as static Silk byte strings."""
import argparse
import os
import subprocess
import re
from pathlib import Path
ROOT = Path(__file__).resolve().parents[2]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
fixtures = {
    'hvarNames': 'font/parse/upstream/font-test-data/test_data/ttf/hvar_with_truncated_adv_index_map.ttf',
    'notoSansJp': 'font/parse/upstream/font-test-data/test_data/ttf/NotoSansJP-Regular.subset.otf',
    'ahem': 'font/parse/upstream/font-test-data/test_data/ttf/ahem.ttf',
    'negativeVarAdvances': 'font/parse/upstream/font-test-data/test_data/ttf/negative_var_advances.ttf',
    'verticalCff2': 'font/parse/upstream/font-test-data/test_data/ttf/NotoSansJP-VF.subset.otf',
    'namesOnly': 'font/parse/upstream/font-test-data/test_data/ttf/names_only.ttf',
    'materialSymbols': 'font/parse/upstream/font-test-data/test_data/ttf/material_symbols_subset.ttf',
    'mplusVertical': 'font/parse/upstream/font-test-data/test_data/ttf/mplus1code_vertical_subset.ttf',
    'glyfComponents': 'font/parse/upstream/font-test-data/test_data/ttf/glyf_components.ttf',
    'amstelvar': 'font/parse/upstream/font-test-data/test_data/ttf/Amstelvar-avar2.A.ttf',
    'cmap12Font': 'font/parse/upstream/font-test-data/test_data/ttf/cmap12_font1.ttf',
    'cmap14Font': 'font/parse/upstream/font-test-data/test_data/ttf/cmap14_font1.ttf',
    'cmapSymbolFont': 'font/parse/upstream/font-test-data/test_data/ttf/cmap4_symbol_pua.ttf',
    'cmap6Font': 'font/parse/upstream/font-test-data/test_data/ttf/cmap6.ttf',
    'vazirmatn': 'font/parse/upstream/font-test-data/test_data/ttf/vazirmatn_var_trimmed.ttf',
    'vorgFont': 'font/parse/upstream/font-test-data/test_data/ttf/vorg.ttf',
    'notoEmoji': 'font/parse/upstream/font-test-data/test_data/ttf/noto_color_emoji_flags.ttf',
    'tinos': 'font/parse/upstream/font-test-data/test_data/ttf/tinos_subset.ttf',
}
text = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2026 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
for name, filename in fixtures.items():
    data = (ROOT / filename).read_bytes()
    literal = ''.join(f'\\x{byte:02x}' for byte in data)
    text += f'pub fn {name}() -> &\'static [u8] {{ return b"{literal}" }}\n'
source = (ROOT / 'font/parse/upstream/font-test-data/src/lib.rs').read_text()
body = source.split('pub mod post {', 1)[1].split('pub static SIMPLE:', 1)[1].split('&[', 2)[2].split('];', 1)[0]
body = re.sub(r'//[^\n]*', '', body)
data = bytes(int(x.strip(), 0) for x in body.split(',') if x.strip())
literal = ''.join(f'\\x{byte:02x}' for byte in data)
text += f'pub fn postSimple() -> &\'static [u8] {{ return b"{literal}" }}\n'
# Dynamic fixtures from upstream model/charmap.rs and font-test-data/src/cmap.rs.
def be(value, width=4):
    return value.to_bytes(width, 'big')
def cmap_table(records):
    body = bytearray(be(0, 2) + be(len(records), 2) + bytes(8 * len(records)))
    for i, (platform, encoding, subtable) in enumerate(records):
        body[4+i*8:12+i*8] = be(platform, 2) + be(encoding, 2) + be(len(body))
        body.extend(subtable)
    return bytes(body)
def format12(mappings):
    return be(12, 2) + be(0, 2) + be(16+12*len(mappings)) + be(0) + be(len(mappings)) + b''.join(be(cp)+be(cp)+be(gid) for cp,gid in mappings)
def uvs(fmt, defaults, variants):
    body = bytearray(be(fmt,2) + be(0) + be(1) + be(0xfe0f,3) + bytes(8))
    if defaults:
        body[13:17] = be(len(body))
        body.extend(be(len(defaults)) + b''.join(be(cp,3)+b'\x00' for cp in defaults))
    if variants:
        body[17:21] = be(len(body))
        body.extend(be(len(variants)) + b''.join(be(cp,3)+be(gid,fmt-12) for cp,gid in variants))
    body[2:6] = be(len(body))
    return bytes(body)
def font(cmap=None, dmap=None):
    tables = {b'maxp': bytes.fromhex('00005000ffff')}
    if cmap is not None: tables[b'cmap'] = cmap
    if dmap is not None: tables[b'DMAP'] = dmap
    body = bytearray(be(0x10000)+be(len(tables),2)+bytes(6+16*len(tables)))
    for i,(tag,table) in enumerate(sorted(tables.items())):
        body[12+i*16:28+i*16] = tag+be(0)+be(len(body))+be(len(table))
        body.extend(table)
        body.extend(bytes((-len(body)) % 4))
    return bytes(body)
def format0(platform, encoding, mappings):
    glyphs = bytearray(256)
    for cp,gid in mappings: glyphs[cp] = gid
    return font(cmap_table([(platform,encoding,be(0,2)+be(262,2)+be(0,2)+glyphs)]))
base = cmap_table([(3,10,format12([(65,1),(66,2),(68,5)])),(0,5,uvs(14,[66],[(65,5),(67,6)]))])
delta = cmap_table([(0,4,format12([(65,3),(66,0),(67,4)])),(0,5,uvs(14,[65],[(66,4),(68,7)]))])
synthetic = {
    'dmapBatch': font(cmap_table([(3,10,format12([(65,1),(66,2),(67,3)]))]),cmap_table([(3,10,format12([(66,9),(68,10)]))])),
    'dmapMappings': font(base,delta), 'dmapOnly': font(None,delta),
    'symbolNotdef': font(cmap_table([(3,0,format12([(65,0),(0xf041,3)]))])),
    'macRoman': format0(1,0,[(0x8e,3),(0,5)]),
    'unicodeFormat0': format0(3,1,[(65,3),(66,4)]),
}
old = uvs(14,[],[(65,2),(67,3)])
new = uvs(15,[65],[(66,70000),(68,0xffffff)])
for reverse in range(2):
    variants = [(0,5,old),(0,5,new)]
    if reverse: variants.reverse()
    base = cmap_table([(3,10,format12([(65,1)]))]+variants)
    synthetic[f'cmap15Order{reverse}'] = font(base)
    synthetic[f'cmap15Delta{reverse}'] = font(base,cmap_table([(0,5,old)]))
synthetic['dmap15Only'] = font(None,cmap_table([(0,5,new)]))
for name,data in synthetic.items():
    literal = ''.join(f'\\x{byte:02x}' for byte in data)
    text += f'pub fn {name}() -> &\'static [u8] {{ return b"{literal}" }}\n'
# Re-run upstream drawing and bitmap selection paths for independent expectations.
subprocess.run([os.environ.get('CARGO', 'cargo'), 'build', '--quiet', '--locked',
                '--manifest-path', str(ROOT / 'font/scripts/rust-font-dump/Cargo.toml'),
                '--target-dir', str(ROOT / 'build/rust'), '--bin', 'model-fixtures'], check=True)
for kind in ('glyf', 'cff', 'cff2', 'bitmap-largest', 'bitmap-12', 'bitmap-64', 'varc-cjk', 'varc-static', 'varc-conditionals', 'varc-precision', 'color-variable', 'color-half', 'color-moved', 'color-static', 'color-v0', 'color-no-clip', 'color-gradient', 'orders-tinos', 'orders-cff', 'orders-cbdt', 'orders-colr', 'orders-varc', 'orders-cantarell', 'orders-cantarell650'):
    data = subprocess.check_output([str(ROOT / 'build/rust/debug/model-fixtures'), kind])
    assert data and len(data) % (40 if kind.startswith("orders-") else 36) == 0
    literal = ''.join(f'\\x{byte:02x}' for byte in data)
    parts = kind.split('-')
    name = parts[0] + ''.join(part.title() for part in parts[1:])
    text += f"pub fn {name}DrawnBounds() -> &'static [u8] {{ return b\"{literal}\" }}\n"
path = ROOT / 'font/parse/src/generated_model_fixtures.silk'
if args.check:
    if not path.exists() or path.read_text() != text:
        parser.exit(1, 'Generated model fixtures differ\n')
else:
    path.write_text(text)
fixture_count = text.count("pub fn ")
print(f'{"Checked" if args.check else "Generated"} {fixture_count} model fixtures')
