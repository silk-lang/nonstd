#!/usr/bin/env python3
"""Extract shaping constants from the pinned Harfrust source (no Rust build)."""
from pathlib import Path
import re
import struct

ROOT = Path(__file__).resolve().parents[2]
SOURCE = ROOT / "font/shape/test-data/harfrust/harfrust/src"


from shaping_unicode_helpers import array, numbers, byte_function, script_tags


def generate():
    scripts = script_tags()
    out = ["// THIS FILE IS AUTOGENERATED by font/scripts/generate-shaping-unicode. DO NOT EDIT.\n",
           "// Unicode 18 data from Harfrust 1503ff0. Copyright HarfBuzz developers. MIT.\n"]
    unicode = (SOURCE / "unicode/mod.rs").read_text()
    modified = array(unicode, "MODIFIED_COMBINING_CLASS")
    for module in ("modified_combining_class", "combining_class"):
        body = re.search(rf"mod {module} \{{(.*?)\n\}}", unicode, re.S)[1]
        constants = dict(re.findall(r"pub const (\w+): u8 = (\d+);", body))
        modified = re.sub(rf"\b{module}::(\w+)", lambda m: constants[m[1]], modified)
    out.append(byte_function("modifiedClasses", bytes(numbers(modified))))
    rtl = (SOURCE / "direction.rs").read_text().split("// Unicode-1.1 additions", 1)[1].split("=>", 1)[0]
    arms = "".join(f"    0x{scripts[n].encode().hex()} => true\n" for n in re.findall(r"Script::(\w+)", rtl))
    out.append(f"pub fn isRtlScript(script: u32) -> bool {{\n  return match script {{\n{arms}    _ => false\n  }}\n}}\n")
    arabic = (SOURCE / "ot/shaper/arabic_table.rs").read_text()
    forms = re.findall(r"\((0x\w+), \[(0x\w+), (0x\w+), (0x\w+), (0x\w+)\]\)", arabic)
    out.append(byte_function("arabicForms", b"".join(struct.pack(">HHHHH", *(int(n, 0) for n in row)) for row in forms)))
    states = array((SOURCE / "ot/shaper/arabic.rs").read_text(), "STATE_TABLE")
    actions = {name: i for i, name in enumerate(("ISOL", "FINA", "FIN2", "FIN3", "MEDI", "MED2", "INIT", "NONE"))}
    transitions = re.findall(r"\(arabic_action::(\w+), arabic_action::(\w+), (\d+)\)", states)
    out.append(byte_function("arabicStates", bytes(v for a, b, c in transitions for v in (actions[a], actions[b], int(c)))))
    thai = (SOURCE / "ot/shaper/thai.rs").read_text()
    actions = {"NOP": 0, "SD": 1, "SL": 2, "SDL": 3, "RD": 4}
    edges = re.findall(r"[AB]SME::new\(Action::(\w+), (?:AboveState::T|BelowState::B)(\d)\)", thai)
    out.append(byte_function("thaiStates", bytes(v for a,b in edges for v in (actions[a], int(b)))))
    mappings = []
    for action in ("SD", "SL", "SDL", "RD"):
        for row in re.findall(r"PuaMapping::new\((0x\w+), (0x\w+), (0x\w+)\)", array(thai, action + "_MAPPINGS")):
            mappings.append(struct.pack(">HHHH", actions[action], *(int(n,0) for n in row)))
    out.append(byte_function("thaiMappings", b"".join(mappings)))
    pua = (SOURCE / "ot/shaper/arabic_pua.rs").read_text()
    small = numbers(array(pua, "arabic_pua_u8"))
    wide = numbers(array(pua, "arabic_pua_u16"))
    def nibble(base, i):
        return (small[base + i // 2] >> (4 * (i & 1))) & 15
    mappings = []
    for u in range(65277):
        i = ((13835058055282164225 >> ((u >> 11) * 2)) & 3) * 16 + ((u >> 7) & 15)
        simp = wide[small[31 + nibble(0, i) * 16 + ((u >> 3) & 15)] * 8 + (u & 7)]
        i = nibble(127, u >> 10) * 16 + ((u >> 6) & 15)
        trad = wide[317 + small[197 + nibble(159, i) * 16 + ((u >> 2) & 15)] * 4 + (u & 3)]
        if simp or trad: mappings.append(struct.pack(">IHH", u, simp, trad))
    out.append(byte_function("arabicSymbol", b"".join(mappings)))
    ligatures = []
    for group, name in enumerate(("LIGATURE_3_TABLE", "LIGATURE_TABLE", "LIGATURE_MARK_TABLE")):
        for components, target in re.findall(r"\(\[([^]]+)\], (0x\w+)\)", array(arabic, name)):
            cps = numbers(components)
            ligatures.append(struct.pack(">BBHHHH", group, len(cps), *(cps + [0] * (3 - len(cps))), int(target, 0)))
    out.append(byte_function("arabicLigatures", b"".join(ligatures)))
    win = (SOURCE / "ot/shaper/arabic_fallback.rs").read_text()
    mappings = []
    for group, name in enumerate(("WIN1256_INIT_MAPPINGS", "WIN1256_MEDI_MAPPINGS", "WIN1256_FINA_MAPPINGS")):
        for a,b in re.findall(r"\((\d+), (\d+)\)", array(win,name)):
            mappings.append(struct.pack(">HHH", group,int(a),int(b)))
    out.append(byte_function("arabicWindows", b"".join(mappings)))
    aat = (SOURCE / "aat/layout.rs").read_text()
    constants = {k: int(v, 0) for k, v in re.findall(r"pub const (\w+): u8 = (0x[0-9A-Fa-f]+|[0-9]+);", aat)}
    mappings = []
    for tag, kind, enable, disable in re.findall(r'FeatureMapping::new\(b"(....)", (\w+), (\w+), (\w+)\)', aat):
        values = [constants[v] if v in constants else int(v, 0) for v in (kind, enable, disable)]
        mappings.append(tag.encode() + bytes(values))
    assert len(mappings) > 70
    out.append(byte_function("aatFeatures", b"".join(mappings)))
    (ROOT / "font/shape/src/generated_unicode.silk").write_text("".join(out))


if __name__ == "__main__":
    generate()
