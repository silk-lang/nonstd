#!/usr/bin/env python3
"""Time pinned shaping workloads; compare glyph/position checksums before timing.

Use --callgrind for deterministic instruction counts (requires valgrind).
Both twins reuse the font, buffer, and matching shape plans across lines.
"""
import argparse
from pathlib import Path
import re
import statistics
import subprocess
import time

ROOT = Path(__file__).resolve().parents[2]
DATA = ROOT / 'font/shape/test-data/harfrust/harfrust'
WORKLOADS = [
    ('Roboto-Regular.ttf', 'en-thelittleprince.txt'),
    ('Roboto-Regular.ttf', 'en-words.txt'),
    ('NotoNastaliqUrdu-Regular.ttf', 'fa-thelittleprince.txt'),
    ('NotoNastaliqUrdu-Regular.ttf', 'fa-words.txt'),
    ('NotoSansDevanagari-Regular.ttf', 'hi-words.txt'),
    ('Amiri-Regular.ttf', 'fa-thelittleprince.txt'),
    ('SourceSerifVariable-Roman.ttf', 'react-dom.txt'),
]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--silk', type=Path, default=ROOT / 'build/llvm/x86_64-unknown-linux-gnu/release/font-shape-cli')
    parser.add_argument('--rust', type=Path, default=ROOT / 'build/harfrust-rust/release/rust-hr-shape')
    parser.add_argument('--iterations', type=int, default=3)
    parser.add_argument('--samples', type=int, default=3)
    parser.add_argument('--filter', default='')
    parser.add_argument('--callgrind', action='store_true')
    args = parser.parse_args()
    if not 1 <= args.iterations <= 100000 or not 1 <= args.samples <= 100:
        parser.error('iterations and samples must be positive and bounded')
    ratios = []
    failed = False
    for index, (font, text) in enumerate(WORKLOADS):
        label = f'{font}/{text}'
        if args.filter not in label:
            continue
        commands = [[str(binary), '--bench', str(DATA / 'benches/fonts' / font),
                     str(DATA / 'benches/texts' / text), str(args.iterations)]
                    for binary in (args.silk, args.rust)]
        outputs = [subprocess.check_output(command, cwd=ROOT, timeout=300).strip() for command in commands]
        if outputs[0] != outputs[1]:
            print(f'MISMATCH {label}: Silk {outputs[0]!r}, Rust {outputs[1]!r}', flush=True)
            failed = True
        measurements = []
        for twin, command in zip(('silk', 'rust'), commands):
            if args.callgrind:
                output = ROOT / 'build' / f'shaping-{index}-{twin}.callgrind'
                subprocess.run(['valgrind', '--tool=callgrind', f'--callgrind-out-file={output}',
                                '--quiet', *command], cwd=ROOT, check=True, stdout=subprocess.DEVNULL, timeout=600)
                summary = re.search(rb'^summary: (\d+)', output.read_bytes(), re.M)
                measurements.append(int(summary[1]))
            else:
                samples = []
                for _ in range(args.samples):
                    started = time.perf_counter()
                    subprocess.run(command, cwd=ROOT, check=True, stdout=subprocess.PIPE, timeout=300)
                    samples.append(time.perf_counter() - started)
                measurements.append(statistics.median(samples))
        ratio = measurements[0] / measurements[1]
        ratios.append(ratio)
        unit = 'Ir' if args.callgrind else 'seconds'
        print(f'{label}: Silk {measurements[0]:.6g}, Rust {measurements[1]:.6g} {unit}; {ratio:.2f}x', flush=True)
    if ratios:
        print(f'Geometric mean: {statistics.geometric_mean(ratios):.2f}x', flush=True)
    raise SystemExit(int(failed))


if __name__ == '__main__':
    main()
