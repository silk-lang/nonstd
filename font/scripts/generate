#!/usr/bin/env python3
"""Generate Silk views and fixtures, then format all Silk sources.

--check fails if that changed any tracked file, i.e. if generated or
formatted output was not committed.
"""
import argparse
import os
import re
from pathlib import Path
import subprocess
import tomllib

ROOT = Path(__file__).resolve().parents[2]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--check", action="store_true")
args = parser.parse_args()
subprocess.run([os.environ.get("CARGO", "cargo"), "build", "--locked", "--manifest-path",
                str(ROOT / "font/parse/tools/font-codegen-silk/Cargo.toml"), "--target-dir",
                str(ROOT / "build/codegen"), "--bin", "codegen"], check=True)
plan = tomllib.loads((ROOT / "font/parse/tools/codegen-plan.toml").read_text())
trait_imports = []
trait_impls = []
node_ids = {}
for operation in plan["generate"]:
    generated = subprocess.check_output([str(ROOT / "build/codegen/debug/codegen"), "file",
                                         operation["mode"], str(ROOT / operation["source"])])
    for extension in operation.get("extensions", []):
        generated += (f"\n// Handwritten extension from {extension}\n".encode()
                      + (ROOT / extension).read_bytes())
    if operation["mode"] == "silk-dump":
        module = Path(operation["source"]).stem
        for number, owner in re.findall(rb"DumpPath.visit\(&mut path, (\d+), FontData.len\(&([A-Za-z0-9_]+)", generated):
            identity = (module, owner.decode())
            if number in node_ids and node_ids[number] != identity:
                raise SystemExit(f"Traversal type ID collision: {identity} and {node_ids[number]}")
            node_ids[number] = identity
        lines = re.findall(rb"^// DUMP_IMPL (.+)$", generated, re.M)
        generated = re.sub(rb"^// DUMP_IMPL .+\n", b"", generated, flags=re.M)
        alias = module.title() + "Tables"
        parse_path = {"cff": "ps.cff.v1", "cff2": "ps.cff.v2"}.get(module, f"tables.{module}")
        trait_imports += [f"import read_fonts.{parse_path} as {alias}\n", f"import generated_dump_{module}\n"]
        for raw in lines:
            line = raw.decode()
            provider = re.search(r" for (\w+)<", line).group(1)
            line = line.replace(f"for {provider}<", f"for {alias}.{provider}<")
            line = line.replace(f"run dump{provider}(", f"run generated_dump_{module}.dump{provider}(")
            trait_impls.append(line + "\n")
    if "facade" in operation:
        names = re.findall(rb"^pub (?:struct|union|interface|enum(?:\([^)]*\))?|type) (\w+)", generated, re.M)
        names += re.findall(rb"^pub (?:(?:effect )?fn|const) (\w+)", generated, re.M)
        module = Path(operation["target"]).stem
        facade = (b"// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n"
                  + f"pub import {module} {{ ".encode() + b", ".join(names) + b" }\n")
        facade += b"\n".join(re.findall(rb"^pub import .+$", generated, re.M)) + b"\n"
        dest = ROOT / operation["facade"]
        dest.write_bytes(facade)
    target = ROOT / operation["target"]
    target.write_bytes(generated)
traits = ("// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n"
          "// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n"
          "import read_fonts.lib { FontRead }\nimport dump_support { DumpPath }\n"
          "import silk.io.writer { Writer, WriterError }\n"
          "pub interface DumpTable<'a> { effect fn dump(self: &Self, path: &mut DumpPath) -> () ! WriterError ? &mut Writer }\n"
          + ''.join(trait_imports) + ''.join(trait_impls)).encode()
traits_path = ROOT / 'font/parse/dump/src/generated_dump_traits.silk'
traits_path.write_bytes(traits)
print(f"Generated {len(plan['generate'])} files")

subprocess.run([str(ROOT / "font/scripts/generate-static")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-layout-fixtures")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-variation-fixtures")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-aat-fixtures")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-ps-data")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-cff-fixtures")], check=True)

subprocess.run([str(ROOT / "font/scripts/generate-model-tables")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-model-fixtures")], check=True)
subprocess.run([str(ROOT / "font/scripts/generate-misc-table-fixtures")], check=True)

subprocess.run([str(ROOT / "text/ucd/scripts/generate-unicode")], check=True)
subprocess.run([str(ROOT / "text/ucd/scripts/generate-unicode-dictionaries")], check=True)
for generator in ("unicode", "machines", "languages", "fixtures", "tests"):
    subprocess.run([str(ROOT / f"font/scripts/generate-shaping-{generator}")], check=True)

for generator in ("encodings", "idna"):
    subprocess.run([str(ROOT / f"images/svg/scripts/generate-{generator}")], check=True)

packages = ["font/types", "font/parse", "font/parse/dump", "font/parse/bench", "text/ucd",
            "text/ucd/dictionary", "text/ucd/bench", "font/shape", "font/shape/cli",
            "font/shape/wasm", "images/svg/geometry", "text/xml", "css/style", "images/svg/image",
            "images/svg", "images/svg/raster", "images/svg/filters", "images/svg/render",
            "images/svg/cli", "images/svg/tests", "images/svg/bench"]
for package in packages:
    subprocess.run([os.environ.get("SILK", "silk"), "format", "--manifest-path",
                    str(ROOT / package / "silk.toml")], check=True, stdout=subprocess.DEVNULL)
if args.check:
    changed = subprocess.check_output(["git", "status", "--porcelain", "--"] + packages, cwd=ROOT, text=True)
    if changed:
        parser.exit(1, "Generated or formatted output differs from the committed files:\n" + changed)
    print("Generated and formatted output is committed")
