#!/usr/bin/env python3
"""Compare pinned fixture inputs with Rust outside pull request CI.

The native fixture runner remains the gate. This check additionally detects
mismatches between the fixture expectations and the pinned Rust executable.
"""
import argparse
from pathlib import Path
import runpy
import shlex
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[2]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--silk', type=Path, default=ROOT / 'build/llvm/x86_64-unknown-linux-gnu/release/font-shape-cli')
    parser.add_argument('--rust', type=Path, default=ROOT / 'build/harfrust-rust/release/rust-hr-shape')
    parser.add_argument('--filter', default='')
    args = parser.parse_args()
    rows = runpy.run_path(str(ROOT / 'font/scripts/generate-shaping-tests'))['cases']()
    failed = 0
    checked = 0
    with tempfile.TemporaryDirectory(prefix='silk-shaping-diff-') as directory:
        text_path = Path(directory) / 'text.txt'
        for name, font, text, options, expected in rows:
            if args.filter not in name:
                continue
            font = ROOT / 'font/shape/test-data/harfrust/harfrust' / font
            text_path.write_text(text)
            rust = subprocess.run([str(args.rust), '--case', str(font), str(text_path), options],
                                  cwd=ROOT, capture_output=True, text=True, timeout=30)
            text = f'--text-file={text_path}'
            silk = subprocess.run([str(args.silk), str(font), text, *shlex.split(options)],
                                  cwd=ROOT, capture_output=True, text=True, timeout=30)
            checked += 1
            if rust.returncode or silk.returncode or rust.stdout.strip() != silk.stdout.strip():
                print(f'FAIL {name}: Rust {rust.stdout.strip()[:160]!r} ({len(rust.stdout)} bytes), Silk {silk.stdout.strip()[:160]!r} ({len(silk.stdout)} bytes)', flush=True)
                failed += 1
    print(f'{checked} comparisons, {failed} differences', flush=True)
    return int(failed != 0)


if __name__ == '__main__':
    raise SystemExit(main())
