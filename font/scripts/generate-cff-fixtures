#!/usr/bin/env python3
"""Preserve pinned CFF/CFF2 example and original font fixtures for upstream tests."""
from pathlib import Path
import re
import struct
import sys
ROOT = Path(__file__).resolve().parents[2]
source = (ROOT/'font/parse/upstream/font-test-data/src/lib.rs').read_text()
out = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
def add(name, data):
    global out
    out += f"pub fn {name}() -> &'static [u8] {{ return b\"" + ''.join(f'\\x{x:02x}' for x in data) + '" }\n'
body = source.split('pub mod cff2 {',1)[1].split('pub static EXAMPLE:',1)[1].split('&[',2)[2].split('];',1)[0]
add('exampleCff2', bytes(int(x,16) for x in re.findall(r'0x([0-9A-Fa-f]{2})',body)))
for symbol,name,filename in [('NOTO_SERIF_DISPLAY_TRIMMED','notoSerif','lib.rs'),('CANTARELL_VF_TRIMMED','cantarell','lib.rs'),('MATERIAL_ICONS_SUBSET','icons','lib.rs'),('MATERIAL_ICONS_SUBSET_MATRIX','iconsMatrix','lib.rs'),('CFF_FONT','notoSansCff','ift.rs'),('CFF2_FONT','notoSansCff2','ift.rs')]:
    text=(ROOT/'font/parse/upstream/font-test-data/src'/filename).read_text()
    rel=re.search(r'pub static '+symbol+r':[^=]*=\s*include_bytes!\("([^"]+)"\)',text).group(1)
    data=(ROOT/'font/parse/upstream/font-test-data/src'/rel).read_bytes()
    add(name+'Font',data)
    count=struct.unpack_from('>H',data,4)[0]
    for i in range(count):
        tag,_,offset,length=struct.unpack_from('>4sIII',data,12+i*16)
        if tag in (b'CFF ',b'CFF2'):
            add(name+'Table',data[offset:offset+length])
path=ROOT/'font/parse/src/generated_cff_fixtures.silk'
if '--check' in sys.argv:
    if not path.exists() or path.read_text()!=out:
        raise SystemExit('CFF fixtures differ')
else:
    path.write_text(out)
