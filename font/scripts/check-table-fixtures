#!/usr/bin/env python3
"""Compare focused core-table edge cases with the unchanged Rust parser."""
import argparse
import ast
from pathlib import Path
import re
import struct
import tempfile
import harness

ROOT = Path(__file__).resolve().parents[2]


def sfnt(tables):
    data = bytearray(struct.pack('>IHHHH', 0x10000, len(tables), 0, 0, 0)
                     + bytes(16 * len(tables)))
    for index, (tag, payload) in enumerate(sorted(tables.items())):
        struct.pack_into('>4sIII', data, 12 + index * 16, tag, 0, len(data), len(payload))
        data.extend(payload)
        data.extend(bytes(-len(data) % 4))
    return bytes(data)


def name_table(records, storage):
    return struct.pack('>HHH', 0, len(records), 6 + 12 * len(records)) + b''.join(
        struct.pack('>HHHHHH', *record) for record in records) + storage


def fixtures():
    # Original cmap fixtures retained in the Silk test port, including format 15,
    # overlapping groups, invalid offsets and default/non-default UVS budgets.
    source = (ROOT / 'font/parse/src/cmap_tests.silk').read_text()
    containers = {'vazirmatn', 'simple', 'font6', 'font10', 'font12', 'font14',
                  'vorg', 'symbol', 'format0', 'format6Small', 'prefer15a', 'prefer15b'}
    for name, literal in re.findall(r"fn (\w+)\(\) -> &'static \[u8\] \{\s*return (b\"[^\"]*\")\s*\}", source):
        payload = ast.literal_eval(literal)
        if name == 'limitsFont':
            yield name, payload
            continue
        if name not in containers:
            format_number = int.from_bytes(payload[:2], 'big')
            platform, encoding = (0, 5) if format_number in (14, 15) else (3, 10)
            payload = struct.pack('>HHHHI', 0, 1, platform, encoding, 12) + payload
        yield 'cmap-' + name, sfnt({b'cmap': payload})

    # Every language key and its adjacent holes, including upstream's duplicate IDs.
    text = (ROOT / 'font/parse/upstream/read-fonts/src/tables/name/language.rs').read_text()
    keys = {int(value, 0) for value in re.findall(r'\((0x[0-9a-fA-F]+|\d+),\s*"', text)}
    ids = sorted({candidate for key in keys for candidate in (key - 1, key, key + 1)
                  if 0 <= candidate <= 65535} | {0, 151, 152, 1024, 1025, 65535})
    for platform in (0, 1, 3, 4):
        records = [(platform, 0, language, 1, 0, 0) for language in ids]
        yield f'name-languages-{platform}', sfnt({b'name': name_table(records, b'')})
    strings = [b'', b'\0A', b'\xd8\0', b'\xdc\0', b'\xd8\0\0A', b'\xd8\0\xd8\0',
               b'\xd8\0\xdc\0', b'\xdb\xff\xdf\xff', b'\0A\0', bytes(range(256))]
    for platform, encoding in ((0, 0), (1, 0), (1, 1), (3, 0), (3, 1), (3, 10), (3, 2)):
        storage = b''.join(strings)
        offset = 0
        records = []
        for value in strings:
            records.append((platform, encoding, 0, 1, len(value), offset))
            offset += len(value)
        records.extend([(platform, encoding, 0, 1, 65535, 0),
                        (platform, encoding, 0, 1, 1, 65535)])
        yield f'name-decode-{platform}-{encoding}', sfnt({b'name': name_table(records, storage)})

    for version in (0, 0x10000, 0x20000, 0x25000, 0x30000, 0xffffffff):
        for strings in (b'', b'\0', b'\2ok', b'\5short', b'\7short', b'\1\xff', b'\0\1x\2ok'):
            indices = (0, 257, 258, 259, 260, 65535)
            payload = struct.pack('>I', version) + bytes(28) + struct.pack('>H6H', 6, *indices) + strings
            yield f'post-{version}-{strings.hex()}', sfnt({b'post': payload})

    header = struct.pack('>I', 0x10000) + bytes(30) + struct.pack('>H', 2)
    metrics = struct.pack('>HhHhh', 500, 50, 600, 60, -10)
    for count in (0, 1, 2, 3, 65535, 65536, 0xffffffff):
        wide = header[:34] + struct.pack('>I', count)
        for length in range(len(metrics) + 1):
            yield f'HMTX-{count}-{length}', sfnt({b'HHEA': wide, b'HMTX': metrics[:length]})
    samples = {b'head': bytes(54), b'maxp': struct.pack('>IH', 0x10000, 5) + bytes(26),
               b'hhea': header, b'hmtx': metrics, b'OS/2': b'\0\5' + bytes(98),
               b'post': b'\0\2' + bytes(32) + b'\0\1\1x',
               b'name': name_table([(3, 1, 1033, 1, 2, 0)], b'\0A'),
               b'cmap': struct.pack('>HHHHI', 0, 1, 3, 10, 12) + struct.pack('>HHIII3I', 12, 0, 28, 0, 1, 65, 67, 1)}
    for tag, payload in samples.items():
        for length in range(len(payload) + 1):
            tables = {tag: payload[:length]}
            if tag == b'hmtx':
                tables[b'hhea'] = header
            yield f'{tag.decode()}-prefix-{length}', sfnt(tables)


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--report', type=Path)
parser.add_argument('--reference', type=Path, default=harness.REFERENCE)
parser.add_argument('--silk-dumper', type=Path, default=harness.silk_binary())
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix='font-table-fixtures-') as temporary:
    fonts = []
    for name, data in fixtures():
        path = Path(temporary) / (name.replace('/', '_') + '.ttf')
        path.write_bytes(data)
        fonts.append(path)
    raise SystemExit(harness.compare(fonts, args.reference.resolve(), args.silk_dumper.resolve(), 30, args.report))
