#!/usr/bin/env python3
"""Preserve upstream specification bytes as packed Silk test fixtures."""
import re
import sys
import struct
from pathlib import Path
root = Path(__file__).resolve().parents[2]
out = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
for module in ('layout', 'gdef', 'gsub', 'gpos'):
    source = (root / f'font/parse/upstream/font-test-data/src/{module}.rs').read_text()
    source = re.sub(r'//[^\n]*', '', source)
    for name, body in re.findall(r'pub (?:static|const) (\w+): &\[u8\] = &\[([^]]*)\];', source):
        values = [int(n.strip(), 0) for n in body.split(',') if n.strip()]
        function = module + ''.join(part.title() for part in name.split('_'))
        packed = ''.join(f'\\x{v:02x}' for v in values)
        out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
# Preserve complete GSUB payloads from the fonts used by upstream helper tests.
for name in ('notoserifhebrew_autohint_metrics', 'cantarell_vf_trimmed', 'material_symbols_subset', 'notoserif_autohint_shaping'):
    data = (root / f'font/parse/upstream/font-test-data/test_data/ttf/{name}.ttf').read_bytes()
    count = struct.unpack_from('>H', data, 4)[0]
    entries = [struct.unpack_from('>4sIII', data, 12 + i * 16) for i in range(count)]
    tag, checksum, offset, length = next(e for e in entries if e[0] == b'GSUB')
    payload = data[offset:offset + length]
    assert len(payload) == length
    function = 'font' + ''.join(part.title() for part in name.split('_')) + 'Gsub'
    packed = ''.join(f'\\x{v:02x}' for v in payload)
    out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
target = root / 'font/parse/src/generated_layout_fixtures.silk'
if '--check' in sys.argv:
    if not target.exists() or target.read_text() != out:
        raise SystemExit('Layout fixtures differ')
else:
    target.write_text(out)
