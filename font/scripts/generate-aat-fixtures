#!/usr/bin/env python3
"""Preserve original table payloads used by upstream AAT unit tests."""
import re
import struct
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[2]
out = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
def append(name, payload):
    global out
    packed = ''.join(f'\\x{v:02x}' for v in payload)
    out += f'pub fn {name}() -> &\'static [u8] {{ return b"{packed}" }}\n'
for name, file in [('one', 'One'), ('four', 'Four'), ('eighteen', 'Eighteen'), ('thirtyFour', 'Thirtyfour'), ('fortyOne', 'Fourtyone')]:
    data = (root / f'font/parse/upstream/font-test-data/test_data/ttf/TestMORX{file}.ttf').read_bytes()
    entries = [struct.unpack_from('>4sIII', data, 12 + i * 16) for i in range(struct.unpack_from('>H', data, 4)[0])]
    _, _, offset, length = next(e for e in entries if e[0] == b'morx')
    append(name, data[offset:offset+length])
source = (root / 'font/parse/upstream/read-fonts/src/tables/kern.rs').read_text()
for symbol, function in [('KERN_VER_0_FMT_0_DATA','otKern0'), ('KERN_VER_1_FMT_0_DATA','aatKern0'), ('KERN_FORMAT_2','kern2')]:
    body = source.split(f'const {symbol}: &[u8] = &[', 1)[1].split('];', 1)[0]
    body = re.sub(r'//[^\n]*', '', body)
    append(function, bytes(int(v, 16) for v in re.findall(r'0x([0-9A-Fa-f]+)', body)))
target = root / 'font/parse/src/generated_aat_fixtures.silk'
if '--check' in sys.argv:
    if not target.exists() or target.read_text() != out:
        raise SystemExit('AAT fixtures differ')
else:
    target.write_text(out)
