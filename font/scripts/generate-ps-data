#!/usr/bin/env python3
"""Pack the pinned PostScript standard strings, charsets and encodings."""
import argparse
import ast
from pathlib import Path
import re
import struct
ROOT = Path(__file__).resolve().parents[2]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
def initializer(path, name):
    text = (ROOT / 'font/parse/upstream/read-fonts/src/ps' / path).read_text()
    body = re.search(r'\b' + name + r'\b[^=]*=\s*&?\[(.*?)\];', text, re.S).group(1)
    return re.sub(r'/\*.*?\*/|//[^\n]*', '', body, flags=re.S)
def blob(name, data):
    return f"fn {name}() -> &'static [u8] {{ return b\"" + ''.join(f'\\x{b:02x}' for b in data) + '" }\n'
strings = [ast.literal_eval(s) for s in re.findall(r'"[^"\\]*"', initializer('string.rs', 'STANDARD_STRINGS'))]
assert len(strings) == 391
packed = b''
offsets = []
for value in strings:
    offsets.append(len(packed))
    packed += value.encode('ascii')
offsets.append(len(packed))
out = '''// THIS FILE IS AUTOGENERATED by font/scripts/generate-ps-data. DO NOT EDIT.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_types.lib { readScalar }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
'''
out += blob('stringsData', packed) + blob('stringsOffsets', b''.join(struct.pack('>I', n) for n in offsets))
for filename, name, target in [('encoding.rs','STANDARD_ENCODING','standardEncoding'),('encoding.rs','EXPERT_ENCODING','expertEncoding'),('encoding.rs','ISO_LATIN1_ENCODING','isoLatin1Encoding'),('cff/charset.rs','EXPERT_CHARSET','expertCharsetData'),('cff/charset.rs','EXPERT_SUBSET_CHARSET','expertSubsetCharsetData')]:
    values = [int(x) for x in re.findall(r'\d+', initializer(filename, name))]
    if 'ENCODING' in name:
        assert len(values) == 256
    out += blob(target, b''.join(struct.pack('>H', n) for n in values))
out += '''pub fn standardString(index: usize) -> Option<&'static [u8]> {
  if index >= 391 { return Option<&'static [u8]>.None }
  let start = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4, 4)) |> Option<u32>.unwrapOr(0)
  let end = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4 + 4, 4)) |> Option<u32>.unwrapOr(0)
  return Option<&'static [u8]>.some(Slice.view<u8>(stringsData(), u32.toUsize(start), u32.toUsize(end - start)))
}
pub fn predefinedCode(encoding: u8, code: u8) -> u16 {
  let mut data = standardEncoding()
  if encoding == 1 { data = expertEncoding() } else if encoding == 2 { data = isoLatin1Encoding() }
  return readScalar<u16>(Slice.view<u8>(data, u8.toUsize(code) * 2, 2)) |> Option<u16>.unwrapOr(0)
}
pub fn expertCharset(subset: bool, index: usize) -> Option<u16> {
  let mut data = expertCharsetData() if subset { data = expertSubsetCharsetData() }
  if index >= data.length / 2 { return Option<u16>.None }
  return readScalar<u16>(Slice.view<u8>(data, index * 2, 2))
}
'''
target = ROOT / 'font/parse/src/generated_ps_data.silk'
if args.check:
    if not target.exists() or target.read_text() != out:
        parser.exit(1, 'Generated PostScript data differs\n')
else:
    target.write_text(out)
print(f"{'Checked' if args.check else 'Generated'} packed PostScript data")
