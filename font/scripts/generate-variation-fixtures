#!/usr/bin/env python3
"""Preserve original table payloads used by upstream variation unit tests."""
import struct
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[2]
out = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
for name, filename in [('vazirmatn', 'vazirmatn_var_trimmed'), ('checker', 'avar2checker'), ('amstelvar', 'Amstelvar-avar2.A'), ('truncated', 'hvar_with_truncated_adv_index_map'), ('noto', 'NotoSansJP-VF.subset'), ('colr', 'test_glyphs-glyf_colr_1_variable')]:
    data = (root / f'font/parse/upstream/font-test-data/test_data/ttf/{filename}.{'otf' if name == 'noto' else 'ttf'}').read_bytes()
    count = struct.unpack_from('>H', data, 4)[0]
    entries = [struct.unpack_from('>4sIII', data, 12 + i * 16) for i in range(count)]
    for tag in (b'fvar', b'avar', b'HVAR', b'VVAR', b'MVAR', b'maxp', b'COLR', b'gvar', b'glyf', b'loca'):
        entry = next((e for e in entries if e[0] == tag), None)
        if entry is None:
            continue
        _, _, offset, length = entry
        payload = data[offset:offset + length]
        assert len(payload) == length
        packed = ''.join(f'\\x{v:02x}' for v in payload)
        function = name + tag.decode().title()
        out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
source = (root / 'font/parse/upstream/read-fonts/src/tables/gvar.rs').read_text()
import re
for symbol, function in [('SKIA_GVAR_SHARED_TUPLES_DATA', 'skiaSharedTuples'), ('SKIA_GVAR_I_DATA', 'skiaGlyphI')]:
    body = source.split(f'static {symbol}: FontData = FontData::new(&[', 1)[1].split(']);', 1)[0]
    payload = bytes(int(v, 16) for v in re.findall(r'0x([0-9A-Fa-f]{2})', body))
    packed = ''.join(f'\\x{v:02x}' for v in payload)
    out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
target = root / 'font/parse/src/generated_variation_fixtures.silk'
for name in ('material_symbols_subset', 'names_only', 'vazirmatn_var_trimmed', 'linear_gradient_rect_colr_1', 'cubic_glyf', 'gvar_use_my_metrics', 'vorg'):
    data = (root / f'font/parse/upstream/font-test-data/test_data/ttf/{name}.ttf').read_bytes()
    packed = ''.join(f'\\x{v:02x}' for v in data)
    function = 'font' + ''.join(part.title() for part in name.split('_'))
    out += f'pub fn {function}() -> &\'static [u8] {{ return b"{packed}" }}\n'
if '--check' in sys.argv:
    if not target.exists() or target.read_text() != out:
        raise SystemExit('Variation fixtures differ')
else:
    target.write_text(out)
