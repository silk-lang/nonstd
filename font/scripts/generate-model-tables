#!/usr/bin/env python3
"""Generate model table forwarding from the ported provider and pinned tag catalog."""
import argparse
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parents[2]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
provider = (ROOT / 'font/parse/src/table_provider.silk').read_text()
source = (ROOT / 'font/parse/upstream/read-fonts/data/generated/generated_tables.rs').read_text()
tags = re.findall(r'f\(Tag::new\(b"(.{4})"\), &mut self\.(\w+)\);', source)
assert len(tags) > 50
imports = '\n'.join(line for line in provider.splitlines() if line.startswith('import '))
text = '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n' + imports + '\n'
text += 'pub const MODEL_TABLE_TAGS: [u32; '+str(len(tags))+'] = [' + ','.join(str(int.from_bytes(t.encode(), 'big')) for t, _ in tags) + ']\n'
text += (ROOT / 'font/parse/src/model/font/tables_impl.silk').read_text()
start = provider.index('pub interface TableProvider')
end = provider.index("impl<'a> TableProvider", start)
methods = re.findall(r'\bfn (\w+)\(self:\s*&Self([^)]*)\)\s*->\s*(Result<[^\n{]+>)\s*\{', provider[start:end])
assert len(methods) >= 40
text += "\nimpl<'a> TableProvider<'a> for TablesView<'a> {\n  fn dataForTag(self:&Self,tag:Tag) -> Option<FontData<'a>> { return Option<FontData<'a>>.None }\n"
for name, extra, result in methods:
    if name == 'expectDataForTag':
        continue
    names = re.findall(r',\s*(\w+):', extra)
    callargs = ''.join(',move '+n for n in names)
    text += f'  fn {name}(self:&Self{extra}) -> {result} {{ let raw=RawTables<\'a> {{ tables:self.tables }} return validated(TableProvider.{name}(&raw{callargs})) }}\n'
text += '}\nimpl Tables {\n'
for name, extra, result in methods:
    if name == 'expectDataForTag':
        continue
    names = re.findall(r',\s*(\w+):', extra)
    callargs = ''.join(',move '+n for n in names)
    text += f'  pub fn {name}<\'a>(self:&\'a Self{extra}) -> {result} {{ let view=Tables.view(self) return TableProvider.{name}(&view{callargs}) }}\n'
for tag, raw_name in tags:
    name = re.sub(r'_([a-z])', lambda m: m[1].upper(), raw_name)
    text += f'  pub fn {name}Data<\'a>(self:&\'a Self) -> Option<&\'a [u8]> {{ return match move Tables.rawData(self,Tag.fromU32({int.from_bytes(tag.encode(),"big")})) {{ Option<FontData<\'a>>.Some {{ value }}=>Option<&\'a [u8]>.some(FontData.asBytes(&value)) _=>Option<&\'a [u8]>.None }} }}\n'
text += '}\n'
outputs = {
    'font/parse/src/generated_model_tables.silk': text,
    'font/parse/src/model/font/tables.silk': '// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\npub import generated_model_tables { Tables,TablesView,TableFunction,TableCallback }\n',
}
for target, content in outputs.items():
    path = ROOT / target
    if args.check:
        if not path.exists() or path.read_text() != content:
            parser.exit(1, f'Generated output differs: {target}\n')
    else:
        path.write_text(content)
print(f'{"Checked" if args.check else "Generated"} model table forwarding ({len(tags)} tags, {len(methods)-1} methods)')
