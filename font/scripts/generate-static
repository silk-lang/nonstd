#!/usr/bin/env python3
"""Pack immutable upstream naming data without changing its values or ordering."""
import argparse
import ast
from pathlib import Path
import re
import struct

ROOT = Path(__file__).resolve().parents[2]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()

def source(path):
    return (ROOT / 'font/parse/upstream/read-fonts/src/tables' / path).read_text()

def initializer(text, name):
    value = re.search(r'\b' + name + r'\b[^=]*=\s*(?:&)?\[(.*?)\];', text, re.S).group(1)
    return re.sub(r'/\*.*?\*/|//[^\n]*', '', value, flags=re.S)

def blob(name, data):
    return f"fn get{name}() -> &'static [u8] {{ return b\"" + ''.join(f'\\x{byte:02x}' for byte in data) + '" }\n'

def strings(name, values):
    data = b''
    offsets = []
    for value in values:
        offsets.append(len(data))
        data += value.encode('ascii')
    offsets.append(len(data))
    return blob(name+'Data', data) + blob(name+'Offsets', b''.join(struct.pack('>I', x) for x in offsets))

post = [ast.literal_eval(x) for x in re.findall(r'"[^"\\]*"', initializer(source('post.rs'), 'DEFAULT_GLYPH_NAMES'))]
assert len(post) == 258
mac = [int(x) for x in re.findall(r'\d+', initializer(source('name.rs'), 'MAC_ROMAN_DECODE'))]
assert len(mac) == 128
languages = [(int(key, 0), value) for key, value in re.findall(r'\((0x[0-9a-fA-F]+|\d+),\s*"([^"]+)"\)', initializer(source('name/language.rs'), 'LANGUAGE_ID_TO_BCP47'))]
assert len(languages) > 200 and all(a[0] <= b[0] for a, b in zip(languages, languages[1:]))
ranges = [(int(a,0),int(b,0),int(c)) for a,b,c in re.findall(r'\((0x[0-9A-Fa-f]+|\d+),\s*(0x[0-9A-Fa-f]+|\d+),\s*(\d+)\)', initializer(source('os2.rs'),'OS2_UNICODE_RANGES'))]
assert len(ranges) == 169
out = '''// THIS FILE IS AUTOGENERATED by font/scripts/generate-static. DO NOT EDIT.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
// BCP-47 mappings originate in Skia; see the retained upstream source attribution.
import font_types.lib { readScalar }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String, InvalidUtf8 }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.core.ownership { Copy }
'''
out += strings('postNames',post) + blob('macRomanData',b''.join(struct.pack('>H',x) for x in mac))
out += strings('languages',[v for _,v in languages]) + blob('languageKeys',b''.join(struct.pack('>H',k) for k,_ in languages))
out += '''fn stringAt(data: &'static [u8], offsets: &'static [u8], index: usize) -> Option<string<'static>> {
  if index >= offsets.length / 4 - 1 { return Option<string<'static>>.None }
  let start = readScalar<u32>(Slice.view<u8>(offsets, index * 4, 4)) |> Option<u32>.unwrapOr(0)
  let end = readScalar<u32>(Slice.view<u8>(offsets, index * 4 + 4, 4)) |> Option<u32>.unwrapOr(0)
  return match move String.fromUtf8(Slice.view<u8>(data, u32.toUsize(start), u32.toUsize(end - start))) { Result<string<'static>, InvalidUtf8>.Success { value } => Option<string<'static>>.some(value) Result<string<'static>, InvalidUtf8>.Failure { error } => Option<string<'static>>.None }
}
pub const POST_NAME_COUNT: usize = 258
pub fn postName(index: usize) -> Option<string<'static>> { return stringAt(postNamesData, postNamesOffsets, index) }
pub fn macRomanCode(index: usize) -> Option<u16> {
  if index >= 128 { return Option<u16>.None }
  return readScalar<u16>(Slice.view<u8>(macRomanData, index * 2, 2))
}
pub fn languageIdToBcp47(platformId: u16, languageId: u16) -> Option<string<'static>> {
  if !((platformId == 1 && languageId <= 151) || (platformId == 3 && languageId >= 1025)) { return Option<string<'static>>.None }
  let mut low: usize = 0
  let mut high = languageKeys.length / 2
  while low < high {
    let mid = low + (high - low) / 2
    let key = readScalar<u16>(Slice.view<u8>(languageKeys, mid * 2, 2)) |> Option<u16>.unwrapOr(0)
    if key <= languageId { low = mid + 1 } else { high = mid }
  }
  if low > 0 {
    let index = low - 1
    let key = readScalar<u16>(Slice.view<u8>(languageKeys, index * 2, 2)) |> Option<u16>.unwrapOr(0)
    if key == languageId { return stringAt(languagesData, languagesOffsets, index) }
  }
  return Option<string<'static>>.None
}
pub struct Os2UnicodeRange { pub first: u32, pub last: u32, pub bit: u8, }
impl Copy for Os2UnicodeRange {}
pub const OS2_UNICODE_RANGES: [Os2UnicodeRange; 169] = [
'''
for first,last,bit in ranges:
    out += f'  Os2UnicodeRange {{ first: {first}, last: {last}, bit: {bit} }},\n'
out += ']\n'
for name in ['postNamesData', 'postNamesOffsets', 'macRomanData', 'languagesData', 'languagesOffsets', 'languageKeys']:
    out = re.sub(r'\b' + name + r'\b', 'get' + name + '()', out)
target = ROOT / 'font/parse/src/generated_data.silk'
if args.check:
    if not target.exists() or target.read_text() != out:
        parser.exit(1, 'Generated static data differs\n')
else:
    target.write_text(out)
print(f"{'Checked' if args.check else 'Generated'} packed static data")

tags = re.findall(r'pub const (\w+): Tag = Tag::new\(b"(.{4})"\);', source('mvar.rs'))
assert len(tags) == 38
tag_out = ('// THIS FILE IS AUTOGENERATED by font/scripts/generate-static. DO NOT EDIT.\n'
           '// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n'
           'import font_types.lib { Tag }\n')
for name, value in tags:
    tag_out += f'pub fn {name.lower()}() -> Tag {{ return Tag.fromU32({int.from_bytes(value.encode(), "big")}) }}\n'
tag_path = ROOT / 'font/parse/src/tables/mvar/tags.silk'
if args.check:
    if not tag_path.exists() or tag_path.read_text() != tag_out:
        parser.exit(1, 'Generated MVAR tags differ\n')
else:
    tag_path.parent.mkdir(parents=True, exist_ok=True)
    tag_path.write_text(tag_out)
