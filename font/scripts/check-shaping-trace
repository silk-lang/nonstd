#!/usr/bin/env python3
"""Upstream tracing regressions using only the native Silk executable."""
from pathlib import Path
import argparse
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[2]
FONTS = ROOT / 'font/shape/test-data/harfrust/harfrust/tests/fonts'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path, default=ROOT / 'build/llvm/x86_64-unknown-linux-gnu/release/hr_shape')
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix='silk-trace-') as directory:
        text_file = Path(directory) / 'text.txt'

        def trace(font, text, *options):
            text_file.write_text(text)
            output = subprocess.check_output([str(args.binary), str((FONTS / font).resolve()),
                                              f'--text-file={text_file}', '--trace', *options],
                                             cwd=ROOT, timeout=30, text=True)
            return [line.removeprefix('trace: ').split('\tbuffer: ', 1)[0]
                    for line in output.splitlines() if line.startswith('trace: ')]

        messages = trace('text-rendering-tests/TestKERNOne.otf', 'uT')
        assert [m for m in messages if 'kern' in m or 'subtable' in m] == [
            'start table kern', 'start subtable 0', 'start kern', 'end kern',
            'end subtable 0', 'end table kern'], messages
        assert "start table GSUB script tag ''" in messages
        messages = trace('text-rendering-tests/TestAATMort.ttf', 'ABCEFGX')
        assert 'start table mort' in messages and 'end table mort' in messages
        assert not any('morx' in m for m in messages)
        messages = trace('in-house/a59fd13f1525a91cbe529c882e93d9d1fbb80463.ttf', 'AB')
        assert "start lookup 0 feature '    '" in messages
        assert "end lookup 0 feature '    '" in messages
        messages = trace('aots/gsub_context1_simple_f1.otf', '\0\x14\x15\x16\0', '--features=test')
        assert [m for m in messages if 'recursing' in m] == [
            'start recursing to lookup 0 at 1', 'end recursing to lookup 0',
            'start recursing to lookup 0 at 2', 'end recursing to lookup 0',
            'start recursing to lookup 0 at 3', 'end recursing to lookup 0'], messages
        for font, text in [('../../benches/fonts/Roboto-Regular.ttf', 'At'),
                           ('../../benches/fonts/Roboto-Regular.ttf', 'AV'),
                           ('aots/gpos2_1_simple_f1.otf', '\x12\x13'),
                           ('aots/gpos2_2_font1.otf', '\x12\x13')]:
            messages = trace(font, text, '--features=test')
            assert [m for m in messages if 'kerning glyphs' in m or m.startswith('kerned glyphs')] == [
                'try kerning glyphs at 0,1', 'kerned glyphs at 0,1', 'tried kerning glyphs at 0,1'], messages
    print('8 tracing integration cases passed')


if __name__ == '__main__':
    main()
