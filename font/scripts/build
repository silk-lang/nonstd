#!/usr/bin/env python3
"""Build pinned reference and Silk dumpers without modifying upstream sources."""
import argparse
import os
from pathlib import Path
import subprocess
import tomllib

ROOT = Path(__file__).resolve().parents[2]
VERSION = tomllib.loads((ROOT / "font/parse/dump/silk.toml").read_text())["package"]["silk-version"]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--reference-only", action="store_true")
parser.add_argument("--release", action="store_true")
args = parser.parse_args()
try:
    subprocess.run([os.environ.get("CARGO", "cargo"), "build", "--locked", "--manifest-path",
                    str(ROOT / "font/scripts/rust-font-dump/Cargo.toml"), "--target-dir", str(ROOT / "build/rust")]
                   + (["--release"] if args.release else []), check=True)
    if not args.reference_only:
        silk = os.environ.get("SILK", "silk")
        version = subprocess.check_output([silk, "--version"], text=True).strip()
        if version != f"silk v{VERSION}":
            raise ValueError(f"expected silk v{VERSION}; got {version}")
        subprocess.run([silk, "build", "--workspace"] + (["--release"] if args.release else []), cwd=ROOT, check=True)
except (OSError, ValueError, subprocess.CalledProcessError) as error:
    parser.exit(2, f"build: {error}\n")
