#!/usr/bin/env python3
"""Translate the pinned OpenType language mapping data and predicates."""
from pathlib import Path
import re
import runpy
ROOT = Path(__file__).resolve().parents[2]
SRC = ROOT/'font/shape/test-data/harfrust/harfrust/src/tag_table.rs'
h = runpy.run_path(str(ROOT/'font/scripts/generate-shaping-unicode'))
src = re.sub(r'//[^\n]*', '', SRC.read_text())
rows = []
for lang, tag in re.findall(r'LangTag \{ language: lang\(b"([^"]+)"\),\s*tag: Tag::new\((b"[^"]+"|&\[0; 4\])\) \}', src):
    rows.append(lang.encode().ljust(4,b'\0') + (b'\0'*4 if tag.startswith('&') else tag[2:-1].encode()))
assert len(rows) > 1000
code = src.split('pub fn tags_from_complex_language',1)[1]
code = code[code.index('{')+1:code.rindex('}')]
code = code.replace('match language.as_bytes()[0]', 'match String.utf8Bytes(language)[0]')
code = re.sub(r"b'(.)'",lambda m:str(ord(m[1])),code)
code = code.replace('&language[1..]', 'rest')
code = re.sub(r'let possible_tags = &\[(.*?)\];\s*tags.extend_from_slice\(possible_tags\);', lambda m: '\n'.join(f'add(&mut tags, 0x{tag.encode().hex()})' for tag in re.findall(r'Tag::new\(b"(....)"\)',m[1])),code,flags=re.S)
code = re.sub(r'tags.push\(Tag::new\(b"(....)"\)\);',lambda m:f'add(&mut tags, 0x{m[1].encode().hex()})',code)
code = code.replace('lang_matches','langMatches').replace('subtag_matches','subtagMatches').replace(';','')
code = re.sub(r'}\s*,', '}',code)
code = re.sub(r'\n\s*\n','\n',code)
code = re.sub(r'\bfalse\s*$', 'return false\n', code)
assert 'tags.' not in code and 'Tag::' not in code
out = '// THIS FILE IS AUTOGENERATED by font/scripts/generate-shaping-languages. DO NOT EDIT.\n// Harfrust/HarfBuzz OpenType tag mappings, MIT licensed.\n'
out += 'import language { LanguageTags, add, langMatches, subtagMatches, strncmp }\nimport silk.text.string { String }\n'
out += h['byte_function']('languages', b''.join(rows))
out += 'pub fn complex(language: string, tags: &mut LanguageTags) -> bool {\nif String.byteLength(language) == 0 { return false }\nlet rest = String.slice(language, 1, String.byteLength(language) - 1)\n'+code+'\n}\n'
reverse_source = (SRC.parent/'tag_reverse.rs').read_text()
reverse_rows = re.findall(r'\(\*b"(....)", "([^"]+)"\)', reverse_source)
assert len(reverse_rows) > 400
pool = bytearray()
reverse = bytearray()
for tag, lang in reverse_rows:
    reverse.extend(tag.encode() + len(pool).to_bytes(4, 'big'))
    encoded = lang.encode()
    pool.extend(bytes([len(encoded)]) + encoded)
out += h['byte_function']('reverseLanguages', reverse)
out += h['byte_function']('reverseNames', pool)
(ROOT/'font/shape/src/generated_languages.silk').write_text(out)

scripts = re.findall(r'pub const ([A-Z_0-9]+): Self = Self::from_bytes\(b"(....)"\);', (SRC.parent/'script.rs').read_text())
assert len(scripts) > 150
constants = '// THIS FILE IS AUTOGENERATED by font/scripts/generate-shaping-languages. DO NOT EDIT.\n// ISO 15924 script identifiers from Harfrust, MIT licensed.\nimport script { Script }\n'
for name, tag in scripts:
    method = name.lower().split('_')
    method = method[0] + ''.join(x.title() for x in method[1:])
    constants += f'pub fn {method}() -> Script {{ return Script {{ value: 0x{tag.encode().hex()} }} }}\n'
(ROOT/'font/shape/src/generated_scripts.silk').write_text(constants)


# Port literal tag assertions from upstream tests rather than duplicating their data.
source_tests = (SRC.parent/'tag.rs').read_text()
cases = re.findall(r'test_tag_from_language!\((\w+),\s*"([^"]*)",\s*"([^"]*)"\);', source_tests)
assert len(cases) > 100
case_data = bytearray()
for name, tag, language in cases:
    encoded = language.encode()
    case_data.extend(len(encoded).to_bytes(2, 'big') + tag.encode().ljust(4, b' ') + encoded)
tests = '// THIS FILE IS AUTOGENERATED by font/scripts/generate-shaping-languages. DO NOT EDIT.\n// Upstream tag.rs test cases, MIT licensed.\n'
tests += h['byte_function']('languageCases', case_data)
tests += "pub fn caseName(index: usize) -> string<'static> { return match index {\n"
for i, (name, tag, language) in enumerate(cases):
    tests += f'{i} => \"{name}\"\n'
tests += '_ => \"unknown language case\" } }\n'
(ROOT/'font/shape/src/generated_language_cases.silk').write_text(tests)
