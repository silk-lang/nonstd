#!/usr/bin/env python3
"""Time read_fonts library workloads against Rust read-fonts on the corpus.

Runs font-parse-bench (Silk) and font-bench (Rust) once per font and workload, serially,
and fails if any checksum differs. Reported time is the per-workload sum of wall
times; each process also pays startup and reading the font, so tiny fonts are
dominated by that fixed cost.
"""
import argparse
from pathlib import Path
import subprocess
import sys
import time
import harness

WORKLOADS = ["cmap", "glyf", "hmtx", "cff", "cffsub"]


def timed(binary: Path, workload: str, font: Path) -> tuple[float, bytes]:
    start = time.perf_counter()
    result = subprocess.run([binary, workload, font], capture_output=True, check=True, timeout=600)
    return time.perf_counter() - start, result.stdout


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--fonts", type=Path)
    parser.add_argument("--silk", type=Path,
                        default=harness.ROOT / "build/llvm/x86_64-unknown-linux-gnu/release/font-parse-bench")
    parser.add_argument("--rust", type=Path, default=harness.ROOT / "build/rust/release/font-bench")
    parser.add_argument("--workload", action="append", choices=WORKLOADS)
    parser.add_argument("--top", type=int, default=5, help="slowest fonts to list per workload")
    args = parser.parse_args()
    fonts, _ = harness.font_list(args.fonts)
    mismatches = 0
    for workload in args.workload or WORKLOADS:
        totals = {"silk": 0.0, "rust": 0.0}
        rows = []
        for font in fonts:
            silk_time, silk_sum = timed(args.silk, workload, font)
            rust_time, rust_sum = timed(args.rust, workload, font)
            if silk_sum != rust_sum:
                mismatches += 1
                print(f"MISMATCH {workload} {harness.display(font)}: silk {silk_sum.strip()!r} rust {rust_sum.strip()!r}")
            totals["silk"] += silk_time
            totals["rust"] += rust_time
            rows.append((silk_time - rust_time, silk_time, rust_time, harness.display(font)))
        print(f"{workload}: silk {totals['silk']:.2f}s rust {totals['rust']:.2f}s "
              f"ratio {totals['silk'] / totals['rust']:.2f}")
        for _, silk_time, rust_time, name in sorted(rows, reverse=True)[:args.top]:
            print(f"  {silk_time:7.3f}s {rust_time:7.3f}s {name}")
    return int(bool(mismatches))


if __name__ == "__main__":
    sys.exit(main())
