//! Library workloads for font/scripts/bench-library. Each returns a checksum that the Rust
//! counterpart (font/scripts/rust-font-dump/src/bin/font-bench.rs) must reproduce.
import read_fonts.lib { FontRef, ReadError }
import read_fonts.tables.cmap { Cmap, BestCmapSubtable, CmapSubtable }
import read_fonts.tables.glyf { Glyf, Glyph, SimpleGlyph, CompositeGlyph, CurvePoint, Component }
import read_fonts.tables.loca { Loca, LocaGlyph }
import read_fonts.tables.hmtx { Hmtx }
import read_fonts.ps.cff.v1 { Cff }
import read_fonts.ps.cff.v2 { Cff2 }
import read_fonts.ps.cff.font { CffFontRef, Subfont }
import read_fonts.model.error { Error }
import read_fonts.model.glyph.outline { PathSink }
import read_fonts.lib { FontData }
import font_types.lib { GlyphId, F2Dot14 }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.i16
import silk.num.i32
import silk.num.usize
import silk.num.f32

/// Maps every Unicode scalar value through the best cmap subtable.
pub fn cmap<'a>(font: &FontRef<'a>) -> u64 {
  let table = match move FontRef.cmap(font) {
    Result<Cmap<'a>, ReadError>.Success { value } => value
    _ => {
      return 0
    }
  }
  let best = match move Cmap.bestSubtable(&table) {
    Option<BestCmapSubtable<'a>>.Some { value } => value
    _ => {
      return 0
    }
  }
  let mut sum: u64 = 0
  let mut cp: u32 = 0
  while cp < 0x110000 {
    if let Option<GlyphId>.Some { value } = CmapSubtable.mapCodepoint(&best.subtable, cp) {
      sum = u64.wrappingAdd(sum, u32.toU64(GlyphId.toU32(value)))
    }
    cp = cp + 1
  }
  return sum
}

/// Decodes every glyf glyph: all points of simple glyphs, all components of composites.
pub fn glyf<'a>(font: &FontRef<'a>) -> u64 {
  let loca = match move FontRef.loca(font, Option<bool>.None) {
    Result<Loca<'a>, ReadError>.Success { value } => value
    _ => {
      return 0
    }
  }
  let glyf = match move FontRef.glyf(font) {
    Result<Glyf<'a>, ReadError>.Success { value } => value
    _ => {
      return 0
    }
  }
  let mut sum: u64 = 0
  let count = Loca.len(&loca)
  let mut gid: usize = 0
  while gid < count {
    if let Option<LocaGlyph<'a>>.Some { value } = Loca.get(
      &loca,
      GlyphId.new(usize.toU32(gid)),
      &glyf,
    ) {
      if let LocaGlyph<'a>.Glyph { value: glyph } = value {
        sum = u64.wrappingAdd(sum, glyphSum(glyph))
      }
    }
    gid = gid + 1
  }
  return sum
}

// Offsets a coordinate so the checksum stays unsigned.
fn unsigned(value: i16) -> u64 {
  return i32.toU64(i16.toI32(value) + 32768)
}

fn glyphSum<'a>(glyph: Glyph<'a>) -> u64 {
  let mut sum: u64 = 0
  match glyph {
    Glyph<'a>.Simple { value } => {
      let mut points = SimpleGlyph.points(&value)
      while let Option<CurvePoint>.Some { value: point } = points.next() {
        sum = u64.wrappingAdd(sum, unsigned(point.x) + unsigned(point.y))
        if point.onCurve {
          sum = u64.wrappingAdd(sum, 1)
        }
      }
    }
    Glyph<'a>.Composite { value } => {
      let mut components = CompositeGlyph.components(&value)
      while let Option<Component>.Some { value: component } = components.next() {
        sum = u64.wrappingAdd(sum, u32.toU64(GlyphId.toU32(component.glyph)))
      }
    }
  }
  return sum
}

/// Reads the horizontal advance of every glyph id up to 65535.
pub fn hmtx<'a>(font: &FontRef<'a>) -> u64 {
  let table = match move FontRef.hmtx(font) {
    Result<Hmtx<'a>, ReadError>.Success { value } => value
    _ => {
      return 0
    }
  }
  let mut sum: u64 = 0
  let mut gid: u32 = 0
  while gid < 65536 {
    if let Option<u16>.Some { value } = Hmtx.advance(&table, GlyphId.new(gid)) {
      sum = u64.wrappingAdd(sum, u16.toU64(value))
    }
    gid = gid + 1
  }
  return sum
}

/// Draws every CFF or CFF2 glyph at default coordinates and design units. With
/// `onlySubfont`, only reads each glyph's subfont (its Private DICT).
pub fn cff<'a>(font: &FontRef<'a>, onlySubfont: bool) -> u64 {
  let bytes = match move FontRef.cff(font) {
    Result<Cff<'a>, ReadError>.Success { value } => FontData.asBytes(&Cff.offsetData(&value))
    _ => match move FontRef.cff2(font) {
      Result<Cff2<'a>, ReadError>.Success { value } => FontData.asBytes(&Cff2.offsetData(&value))
      _ => {
        return 0
      }
    }
  }
  let outlines = match move CffFontRef.new(bytes, 0, Option<i32>.None) {
    Result<CffFontRef<'a>, Error>.Success { value } => value
    _ => {
      return 0
    }
  }
  let coords: [F2Dot14; 0] = []
  let mut sink = SumSink { sum: 0 }
  let count = CffFontRef.numGlyphs(&outlines)
  let mut gid: u32 = 0
  while gid < count {
    let glyph = GlyphId.new(gid)
    gid = gid + 1
    let index = match move CffFontRef.subfontIndex(&outlines, glyph) {
      Option<u16>.Some { value } => value
      _ => {
        continue
      }
    }
    let subfont = match move CffFontRef.subfont(&outlines, index, &coords) {
      Result<Subfont, Error>.Success { value } => move value
      _ => {
        continue
      }
    }
    if onlySubfont {
      sink.sum = u64.wrappingAdd(sink.sum, u32.toU64(Subfont.subrsOffset(&subfont)))
      continue
    }
    match move CffFontRef.draw(&outlines, &subfont, glyph, &coords, Option<f32>.None, &mut sink) {
      Result<Option<f32>, Error>.Success { value } => {
        sink.sum = u64.wrappingAdd(sink.sum, 1)
      }
      _ => {}
    }
  }
  return sink.sum
}

// Sums the bit patterns of every coordinate, plus one per command.
struct SumSink {
  sum: u64,
}

impl SumSink {
  fn add(self: &mut Self, x: f32, y: f32) {
    let bits = u64.wrappingAdd(u32.toU64(f32.toBits(x)), u32.toU64(f32.toBits(y)))
    self.sum = u64.wrappingAdd(self.sum, u64.wrappingAdd(bits, 1))
  }
}

impl PathSink for SumSink {
  fn moveTo(self: &mut Self, x: f32, y: f32) {
    SumSink.add(&mut self, x, y)
  }

  fn lineTo(self: &mut Self, x: f32, y: f32) {
    SumSink.add(&mut self, x, y)
  }

  fn quadTo(self: &mut Self, cx: f32, cy: f32, x: f32, y: f32) {
    SumSink.add(&mut self, cx, cy)
    SumSink.add(&mut self, x, y)
  }

  fn curveTo(self: &mut Self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {
    SumSink.add(&mut self, cx0, cy0)
    SumSink.add(&mut self, cx1, cy1)
    SumSink.add(&mut self, x, y)
  }

  fn close(self: &mut Self) {
    self.sum = u64.wrappingAdd(self.sum, 1)
  }
}
