    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "glyphArray")
    let fieldValue = IndexSubtable5<'a>.glyphArray(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, GlyphId16>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, GlyphId16>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<GlyphId16>.Some { value: item } = move ScalarArray<'a, GlyphId16>.get(
        &fieldValue,
        index,
      ) {
        run scalar(&path, GlyphId16.toU16(item))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpBdtComponent<'a>(
  path: &mut DumpPath,
  value: BdtComponent<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "glyphId")
    let fieldValue = BdtComponent<'a>.glyphId(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "xOffset")
    let fieldValue = BdtComponent<'a>.xOffset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "yOffset")
    let fieldValue = BdtComponent<'a>.yOffset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {}

// Handwritten extension from font/parse/dump/src/extensions_dump_bitmap.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
pub effect fn dumpBitmapSubtables<'a>(
  path: &mut DumpPath,
  value: BitmapSize<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "indexSubtableList")
  DumpPath.setArguments(&mut path, [u32.toU64(BitmapSize.numberOfIndexSubtables(&value)), 0, 0])
  match move BitmapSize.indexSubtableList(&value, base) {
    Result<IndexSubtableList<'a>, ReadError>.Success { value: list } => run dumpIndexSubtableList(
      &mut path,
      list,
    )
    Result<IndexSubtableList<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

pub effect fn dumpIndexSubtable<'a>(path: &mut DumpPath, value: IndexSubtable<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "kind")
  run scalar(&path, IndexSubtable.indexFormat(&value))
  DumpPath.pop(&mut path)
  match value {
    IndexSubtable<'a>.Format1 { value: table } => run dumpIndexSubtable1(&mut path, table)
    IndexSubtable<'a>.Format2 { value: table } => run dumpIndexSubtable2(&mut path, table)
    IndexSubtable<'a>.Format3 { value: table } => run dumpIndexSubtable3(&mut path, table)
    IndexSubtable<'a>.Format4 { value: table } => run dumpIndexSubtable4(&mut path, table)
    IndexSubtable<'a>.Format5 { value: table } => run dumpIndexSubtable5(&mut path, table)
  }
}
