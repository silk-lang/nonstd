pub effect fn dumpGlyf<'a>(path: &mut DumpPath, value: Glyf<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3435879749,
    FontData.len(&Glyf<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Glyf<'a>.offsetData(&value)
}

