pub effect fn dumpGlyph<'a>(path: &mut DumpPath, value: Glyph<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    Glyph<'a>.Simple { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Simple")
      DumpPath.pop(&mut path)
      run dumpSimpleGlyph(&mut path, table)
    }
    Glyph<'a>.Composite { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Composite")
      DumpPath.pop(&mut path)
      run dumpCompositeGlyph(&mut path, table)
    }
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "glyf")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1735162214)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1735162214) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Glyf<'a>.read(data) {
          Result<Glyf<'a>, ReadError>.Success { value: table } => run dumpGlyf(&mut path, table)
          Result<Glyf<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
