pub effect fn dumpLtag<'a>(path: &mut DumpPath, value: Ltag<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2843003013,
    FontData.len(&Ltag<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Ltag<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Ltag<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "flags")
    let fieldValue = Ltag<'a>.flags(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numTags")
    let fieldValue = Ltag<'a>.numTags(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "tagRanges")
    let fieldValue = Ltag<'a>.tagRanges(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), FTStringRange<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), FTStringRange<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), FTStringRange<'a>>.get(&fieldValue, index) {
        Result<FTStringRange<'a>, ReadError>.Success { value: item } => run dumpFTStringRange(
          &mut path,
          item,
          base,
        )
        Result<FTStringRange<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpFTStringRange<'a>(
  path: &mut DumpPath,
  value: FTStringRange<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "offset")
    let fieldValue = FTStringRange<'a>.offset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "length")
    let fieldValue = FTStringRange<'a>.length(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "ltag")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1819566439)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1819566439) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Ltag<'a>.read(data) {
          Result<Ltag<'a>, ReadError>.Success { value: table } => run dumpLtag(&mut path, table)
          Result<Ltag<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
