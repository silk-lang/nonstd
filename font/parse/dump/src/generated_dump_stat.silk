pub effect fn dumpStat<'a>(path: &mut DumpPath, value: Stat<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2121924237,
    FontData.len(&Stat<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Stat<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
