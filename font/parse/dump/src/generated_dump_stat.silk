    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "elidedFallbackNameId")
    match move Stat<'a>.elidedFallbackNameId(&value) {
      Option<NameId>.Some { value: fieldValue } => {
        run scalar(&path, NameId.toU16(fieldValue))
      }
      Option<NameId>.None => run absent(&path)
    }
    DumpPath.pop(&mut path)
