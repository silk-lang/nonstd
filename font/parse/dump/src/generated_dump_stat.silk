import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "STAT")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1398030676)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1398030676) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Stat<'a>.read(data) {
          Result<Stat<'a>, ReadError>.Success { value: table } => run dumpStat(&mut path, table)
          Result<Stat<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
