    let fieldValue = Stat<'a>.designAxesOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "designAxes")
    let arrayResult = Stat<'a>.designAxes(&value)
    let resolved = move arrayResult
    match move resolved {
      Result<ComputedArray<'a, (), AxisRecord<'a>>, ReadError>.Failure { error } => run readError(
        &path,
        error,
      )
      Result<ComputedArray<'a, (), AxisRecord<'a>>, ReadError>.Success { value: fieldValue } => {
        DumpPath.push(&mut path, "length")
        run scalar(&path, ComputedArray<'a, (), AxisRecord<'a>>.len(&fieldValue))
        DumpPath.pop(&mut path)
        let mut index: usize = 0
        while index < ComputedArray<'a, (), AxisRecord<'a>>.len(&fieldValue) {
          DumpPath.setIndex(&mut path, index)
          DumpPath.setArguments(&mut path, [0; 3])
          match move ComputedArray<'a, (), AxisRecord<'a>>.get(&fieldValue, index) {
            Result<AxisRecord<'a>, ReadError>.Success { value: item } => run dumpAxisRecord(
              &mut path,
              item,
              base,
            )
            Result<AxisRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
          }
          index = index + 1
        }
        DumpPath.clearIndex(&mut path)
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisValueCount")
    let fieldValue = Stat<'a>.axisValueCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "offsetToAxisValueOffsets")
    let fieldValue = Stat<'a>.offsetToAxisValueOffsets(&value)
    let rawOffset = Nullable<Offset32>.offset(&fieldValue).*
    run scalar(&path, Offset32.toU32(rawOffset))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "offsetToAxisValues")
    let targetArgs: [u64; 3] = [u16.toU64(Stat<'a>.axisValueCount(&value)), 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    match move Stat<'a>.offsetToAxisValues(&value) {
      Option<Result<AxisValueArray<'a>, ReadError>>.None => run absent(&path)
      Option<Result<AxisValueArray<'a>, ReadError>>.Some { value: resolved } => {
        match move resolved {
          Result<AxisValueArray<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
            &table,
            &mut path,
          )
          Result<AxisValueArray<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
