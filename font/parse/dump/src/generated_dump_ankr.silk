pub effect fn dumpAnchorPoint<'a>(
  path: &mut DumpPath,
  value: AnchorPoint<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "x")
    let fieldValue = AnchorPoint<'a>.x(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "y")
    let fieldValue = AnchorPoint<'a>.y(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "ankr")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1634626418)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1634626418) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Ankr<'a>.read(data) {
          Result<Ankr<'a>, ReadError>.Success { value: table } => run dumpAnkr(&mut path, table)
          Result<Ankr<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
