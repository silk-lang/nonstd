pub effect fn dumpAnkr<'a>(path: &mut DumpPath, value: Ankr<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2487919429,
    FontData.len(&Ankr<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Ankr<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Ankr<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "flags")
    let fieldValue = Ankr<'a>.flags(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "lookupTableOffset")
    let fieldValue = Ankr<'a>.lookupTableOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "lookupTable")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = Ankr<'a>.lookupTable(&value)
    match move resolved {
      Result<LookupU16<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<LookupU16<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "glyphDataTableOffset")
    let fieldValue = Ankr<'a>.glyphDataTableOffset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpGlyphDataEntry<'a>(path: &mut DumpPath, value: GlyphDataEntry<'a>) -> ()
  ! WriterError
  ? &mut Writer {
