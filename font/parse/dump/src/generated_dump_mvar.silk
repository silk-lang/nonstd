pub effect fn dumpMvar<'a>(path: &mut DumpPath, value: Mvar<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    1892120077,
    FontData.len(&Mvar<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Mvar<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Mvar<'a>.version(&value)
    DumpPath.push(&mut path, "major")
    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Mvar<'a>.reservedByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "valueRecordSize")
    let fieldValue = Mvar<'a>.valueRecordSize(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "valueRecordCount")
    let fieldValue = Mvar<'a>.valueRecordCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "itemVariationStoreOffset")
    let fieldValue = Mvar<'a>.itemVariationStoreOffset(&value)
    let rawOffset = Nullable<Offset16>.offset(&fieldValue).*
    run scalar(&path, Offset16.toU32(rawOffset))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "itemVariationStore")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    match move Mvar<'a>.itemVariationStore(&value) {
      Option<Result<ItemVariationStore<'a>, ReadError>>.None => run absent(&path)
      Option<Result<ItemVariationStore<'a>, ReadError>>.Some { value: resolved } => {
        match move resolved {
          Result<ItemVariationStore<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
            &table,
            &mut path,
          )
          Result<ItemVariationStore<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "valueRecords")
    let fieldValue = Mvar<'a>.valueRecords(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), ValueRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), ValueRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), ValueRecord<'a>>.get(&fieldValue, index) {
        Result<ValueRecord<'a>, ReadError>.Success { value: item } => run dumpValueRecord(
          &mut path,
          item,
          base,
        )
        Result<ValueRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpValueRecord<'a>(
  path: &mut DumpPath,
  value: ValueRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "valueTag")
    let fieldValue = ValueRecord<'a>.valueTag(&value)
    run scalar(&path, Tag.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "deltaSetOuterIndex")
    let fieldValue = ValueRecord<'a>.deltaSetOuterIndex(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "deltaSetInnerIndex")
    let fieldValue = ValueRecord<'a>.deltaSetInnerIndex(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "MVAR")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1297498450)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1297498450) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Mvar<'a>.read(data) {
          Result<Mvar<'a>, ReadError>.Success { value: table } => run dumpMvar(&mut path, table)
          Result<Mvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
