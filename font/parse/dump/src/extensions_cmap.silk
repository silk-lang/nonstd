import read_fonts.tables.cmap {
  Cmap,
  CmapSubtable,
  CmapSubtableIter,
  CmapIterLimits,
  CmapMapping,
  BestCmapSubtable,
  SelectedUvsSubtable,
  EncodingRecord,
  UvsSubtable,
  UvsSubtableIter,
  UvsMappingEntry,
  MapVariant
}
import font_types.lib { GlyphId }
import dump_support { DumpPath, scalar, absent, integers }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u32

fn mapped(value: Option<GlyphId>) -> i64 {
  return match move value {
    Option<GlyphId>.Some { value: glyph } => u32.toI64(GlyphId.toU32(glyph))
    _ => -1
  }
}

fn variant(value: Option<MapVariant>) -> i64 {
  return match move value {
    Option<MapVariant>.Some { value: mapping } => match mapping {
      MapVariant.UseDefault => -2
      MapVariant.Variant { glyph } => u32.toI64(GlyphId.toU32(glyph))
    }
    _ => -1
  }
}

pub effect fn dumpCmap<'a>(path: &mut DumpPath, table: Cmap<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "bestSubtable")
  match move Cmap<'a>.bestSubtable(&table) {
    Option<BestCmapSubtable<'a>>.None => run absent(&path)
    Option<BestCmapSubtable<'a>>.Some { value } => {
      DumpPath.push(&mut path, "index")
      run scalar(&path, value.index)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "isSymbol")
      run scalar(&path, EncodingRecord<'a>.isSymbol(&value.record))
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "isMacRoman")
      run scalar(&path, EncodingRecord<'a>.isMacRoman(&value.record))
      DumpPath.pop(&mut path)
    }
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "uvsSubtable")
  match move Cmap<'a>.uvsSubtable(&table) {
    Option<SelectedUvsSubtable<'a>>.None => run absent(&path)
    Option<SelectedUvsSubtable<'a>>.Some { value } => {
      DumpPath.push(&mut path, "index")
      run scalar(&path, value.index)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "format")
      run scalar(&path, UvsSubtable<'a>.format(&value.subtable))
      DumpPath.pop(&mut path)
    }
  }
  DumpPath.pop(&mut path)
  let probes: [u32; 15] = [
    0,
    1,
    14,
    32,
    65,
    66,
    96,
    192,
    255,
    256,
    65535,
    65536,
    1114111,
    1114112,
    4294967295,
  ]
  DumpPath.push(&mut path, "mapProbes")
  let mut i: usize = 0
  while i < probes.length {
    DumpPath.setIndex(&mut path, i)
    run scalar(&path, mapped(Cmap<'a>.mapCodepoint(&table, probes[i])))
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

pub effect fn dumpSubtable<'a>(path: &mut DumpPath, table: CmapSubtable<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "mappingLanguage")
  run scalar(&path, CmapSubtable<'a>.language(&table))
  DumpPath.pop(&mut path)
  let mut iter = CmapSubtable<'a>.iterWithLimits(&table, CmapIterLimits.default())
  DumpPath.push(&mut path, "mappings")
  let mut i: usize = 0
  while true {
    match move CmapSubtableIter<'a>.next(&mut iter) {
      Option<CmapMapping>.None => {
        break
      }
      Option<CmapMapping>.Some { value } => {
        DumpPath.setIndex(&mut path, i)
        let fields = [
          u32.toI64(value.codepoint),
          u32.toI64(GlyphId.toU32(value.glyph)),
          mapped(CmapSubtable<'a>.mapCodepoint(&table, value.codepoint)),
        ]
        run integers(&path, &fields)
        i = i + 1
      }
    }
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, i)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
  match table {
    CmapSubtable<'a>.Format14 { value } => run dumpUvs(&mut path, UvsSubtable<'a>.fromCmap14(value))
    CmapSubtable<'a>.Format15 { value } => run dumpUvs(&mut path, UvsSubtable<'a>.fromCmap15(value))
    _ => ()
  }
}

effect fn dumpUvs<'a>(path: &mut DumpPath, table: UvsSubtable<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let mut iter = UvsSubtable<'a>.iterWithLimits(&table, CmapIterLimits.default())
  DumpPath.push(&mut path, "variants")
  let mut i: usize = 0
  while true {
    match move UvsSubtableIter<'a>.next(&mut iter) {
      Option<UvsMappingEntry>.None => {
        break
      }
      Option<UvsMappingEntry>.Some { value } => {
        DumpPath.setIndex(&mut path, i)
        let fields = [
          u32.toI64(value.codepoint),
          u32.toI64(value.selector),
          variant(Option<MapVariant>.some(value.mapping)),
          variant(UvsSubtable<'a>.mapVariant(&table, value.codepoint, value.selector)),
        ]
        run integers(&path, &fields)
        i = i + 1
      }
    }
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, i)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}
