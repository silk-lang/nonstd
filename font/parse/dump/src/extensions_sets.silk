import read_fonts.collections.int_set { IntSet, IntSetIter }
import read_fonts.tables.layout { CoverageTable, ClassDef }
import font_types.lib { GlyphId }
import dump_support { DumpPath, scalar }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u32

// Generated field traversal does not allocate. These evaluated observations own
// a short-lived allocator; failure aborts the dump through its existing error.
effect fn allocationFailed(error: OutOfMemoryError) -> ()
  ! WriterError {
  drop error
  fail Writer.failure()
}

pub effect fn coverage(path: &mut DumpPath, table: CoverageTable) -> ()
  ! WriterError
  ? &mut Writer {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catch<OutOfMemoryError>(coverageBody(&mut path, table), allocationFailed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

pub effect fn classes(path: &mut DumpPath, table: ClassDef) -> ()
  ! WriterError
  ? &mut Writer {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catch<OutOfMemoryError>(classesBody(&mut path, table), allocationFailed)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn query(index: usize) -> IntSet<GlyphId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = IntSet<GlyphId>.empty()
  if index == 1 {
    let ids: [u32; 13] = [
      0,
      1,
      2,
      10,
      255,
      256,
      511,
      512,
      65535,
      65536,
      70000,
      16777215,
      4294967295,
    ]
    let mut i: usize = 0
    while i < ids.length {
      drop run IntSet<GlyphId>.insert(&mut result, GlyphId.new(ids[i]))
      i = i + 1
    }
  }
  if index == 2 {
    let mut i: u32 = 0
    while i <= 64 {
      drop run IntSet<GlyphId>.insert(&mut result, GlyphId.new(i))
      i = i + 1
    }
  }
  return move result
}

effect fn glyphs(path: &mut DumpPath, set: &IntSet<GlyphId>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "length")
  run scalar(&path, IntSet<GlyphId>.len(set))
  DumpPath.pop(&mut path)
  let mut iter = IntSet<GlyphId>.iter(set)
  let mut i: usize = 0
  while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
    DumpPath.setIndex(&mut path, i)
    run scalar(&path, GlyphId.toU32(value))
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
}

effect fn coverageBody(path: &mut DumpPath, table: CoverageTable) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  DumpPath.push(&mut path, "intersections")
  let mut i: usize = 0
  while i < 3 {
    let set = run query(i)
    DumpPath.setIndex(&mut path, i)
    DumpPath.push(&mut path, "intersects")
    run scalar(&path, CoverageTable.intersects(&table, &set))
    DumpPath.pop(&mut path)
    let intersection = run CoverageTable.intersectSet(&table, &set)
    DumpPath.push(&mut path, "glyphs")
    run glyphs(&mut path, &intersection)
    DumpPath.pop(&mut path)
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

effect fn classesBody(path: &mut DumpPath, table: ClassDef) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  DumpPath.push(&mut path, "intersections")
  let mut i: usize = 0
  while i < 3 {
    let set = run query(i)
    DumpPath.setIndex(&mut path, i)
    let classes = run ClassDef.intersectClasses(&table, &set)
    DumpPath.push(&mut path, "classes")
    DumpPath.push(&mut path, "length")
    run scalar(&path, IntSet<u32>.len(&classes))
    DumpPath.pop(&mut path)
    let mut iter = IntSet<u32>.iter(&classes)
    let mut n: usize = 0
    while let Option<u32>.Some { value } = IntSetIter<u32>.next(&mut iter) {
      DumpPath.setIndex(&mut path, n)
      run scalar(&path, value)
      n = n + 1
    }
    DumpPath.pop(&mut path)
    let probes: [u32; 7] = [0, 1, 2, 3, 65535, 65536, 4294967295]
    n = 0
    DumpPath.push(&mut path, "byClass")
    while n < 7 {
      DumpPath.setIndex(&mut path, u32.toUsize(probes[n]))
      DumpPath.push(&mut path, "intersects")
      run scalar(&path, run ClassDef.intersectsClassGlyphs(&table, &set, probes[n]))
      DumpPath.pop(&mut path)
      let intersection = run ClassDef.intersectedClassGlyphs(&table, &set, probes[n])
      DumpPath.push(&mut path, "glyphs")
      run glyphs(&mut path, &intersection)
      DumpPath.pop(&mut path)
      n = n + 1
    }
    DumpPath.pop(&mut path)
    i = i + 1
  }
  DumpPath.pop(&mut path)
}
