//! Command-line entry for the differential font dumper.
import dump { dump }
import buffered_stdout { BufferedStdout }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }
import silk.io.writer { Writer, WriterError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }

effect fn stderr(text: string) -> ()
  ! WriterError {
  let mut writer = StderrWriter.make()
  run Writer.writeString(text) |> Effect.provideMut<Writer>(&mut writer)
}

effect fn process() -> i32
  ! HostInputError | OutOfMemoryError | WriterError | FileError
  ? &mut HostInput | &mut Allocator {
  if (run HostInput.argumentCount()) != 2 {
    run stderr("usage: font_dump FONT\n       font_dump --help | --version\n")
    return 2
  }
  let argument = run HostInput.argument(1)
  if let Option<Bytes>.Some { value } = move argument {
    let mut writer = StdoutWriter.make()
    let flag = HostInput.text(Bytes.asSlice(&value))
    if let Result<string, InvalidUtf8>.Success { value: text } = move flag {
      if text == "--help" {
        run Writer.writeString("usage: font_dump FONT\nDump format 9: tables and model APIs.\n")
          |> Effect.provideMut<Writer>(&mut writer)
        return 0
      }
      if text == "--version" {
        run Writer.writeString("font_dump 0.1.0 (font-dump format 9)\n")
          |> Effect.provideMut<Writer>(&mut writer)
        return 0
      }
    }
    let cwd = run HostInput.workingDirectory()
    let base = run Path.fromBytes(Bytes.asSlice(&cwd))
    let path = run pathFromArgument(&base, Bytes.asSlice(&value))
    let mut files = run OsFileSystem.make("/")
    let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
    let mut buffered = run BufferedStdout.make()
    run dump(Bytes.asSlice(&data)) |> Effect.provideMut<Writer>(&mut buffered)
    run Writer.flush() |> Effect.provideMut<Writer>(&mut buffered)
    return 0
  }
  return 2
}

effect fn pathFromArgument(base: &Path, raw: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if raw.length > 0 && raw[0] == 47 {
    return run Path.fromBytes(raw)
  }
  if let Result<string, InvalidUtf8>.Success { value } = move HostInput.text(raw) {
    return run Path.resolve(base, value)
  }
  return run Path.joinBytes(base, raw)
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  run stderr("font_dump: unable to read input or write dump\n")
  return 2
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(process(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
