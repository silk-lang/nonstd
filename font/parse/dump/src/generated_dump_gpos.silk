    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "markClassCount")
    let fieldValue = MarkMarkPosFormat2<'a>.markClassCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
