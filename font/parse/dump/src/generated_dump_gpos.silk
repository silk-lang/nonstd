pub effect fn dumpCursivePos<'a>(path: &mut DumpPath, value: CursivePos<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    CursivePos<'a>.Format1 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1")
      DumpPath.pop(&mut path)
      run dumpCursivePosFormat1(&mut path, table)
    }
    CursivePos<'a>.Format2 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2")
      DumpPath.pop(&mut path)
      run dumpCursivePosFormat2(&mut path, table)
    }
  }
}

