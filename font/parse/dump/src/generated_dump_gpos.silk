    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "mark2ArrayOffset")
    let fieldValue = MarkMarkPosFormat2<'a>.mark2ArrayOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
