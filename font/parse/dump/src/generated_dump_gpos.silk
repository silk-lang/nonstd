  if true {
    DumpPath.push(&mut path, "mark2Array")
    let targetArgs: [u64; 3] = [u16.toU64(MarkMarkPosFormat2<'a>.markClassCount(&value)), 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = MarkMarkPosFormat2<'a>.mark2Array(&value)
    match move resolved {
