  value: ComponentRecord2<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "ligatureAnchorOffsets")
    let fieldValue = ComponentRecord2<'a>.ligatureAnchorOffsets(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, Nullable<Offset24>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, Nullable<Offset24>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<Nullable<Offset24>>.Some { value: item } = move ScalarArray<
        'a,
        Nullable<Offset24>
      >.get(&fieldValue, index) {
        run scalar(&path, Offset24.toU32(Nullable<Offset24>.offset(&item).*))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "ligatureAnchors")
    let targetArgs: [u64; 3] = [0, 0, 0]
    let resolvedArray = ComponentRecord2<'a>.ligatureAnchors(&value, base)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.len(&resolvedArray))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.len(&resolvedArray) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, targetArgs)
      match move ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.get(
        &resolvedArray,
        index,
      ) {
        Option<Result<AnchorTable<'a>, ReadError>>.None => run absent(&path)
        Option<Result<AnchorTable<'a>, ReadError>>.Some { value: resolved } => {
          match move resolved {
            Result<AnchorTable<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
              &table,
              &mut path,
            )
            Result<AnchorTable<'a>, ReadError>.Failure { error } => run readError(&path, error)
          }
        }
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

