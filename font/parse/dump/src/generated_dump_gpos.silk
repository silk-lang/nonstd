import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "GPOS")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1196445523)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1196445523) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Gpos<'a>.read(data) {
          Result<Gpos<'a>, ReadError>.Success { value: table } => run dumpGpos(&mut path, table)
          Result<Gpos<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}

