import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "VARC")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1447121475)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1447121475) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Varc<'a>.read(data) {
          Result<Varc<'a>, ReadError>.Success { value: table } => run dumpVarc(&mut path, table)
          Result<Varc<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
