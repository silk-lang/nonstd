effect fn global(path: &mut DumpPath, value: &Metrics) -> ()
  ! WriterError
  ? &mut Writer {
  run field(&mut path, "unitsPerEm", value.unitsPerEm)
  run field(&mut path, "rawUnitsPerEm", value.rawUnitsPerEm)
  run field(&mut path, "numGlyphs", value.numGlyphs)
  DumpPath.push(&mut path, "bounds")
  run field(&mut path, "xMin", F48Dot16.toBits(value.bounds.xMin))
  run field(&mut path, "yMin", F48Dot16.toBits(value.bounds.yMin))
  run field(&mut path, "xMax", F48Dot16.toBits(value.bounds.xMax))
  run field(&mut path, "yMax", F48Dot16.toBits(value.bounds.yMax))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "hheaLine")
  run line(&mut path, &value.hheaLine)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "vheaLine")
  run line(&mut path, &value.vheaLine)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "typoLine")
  run line(&mut path, &value.typoLine)
  DumpPath.pop(&mut path)
  run field(&mut path, "useTypoMetrics", value.useTypoMetrics)
  DumpPath.push(&mut path, "winLine")
  run lineEnds(&mut path, &value.winLine)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "hLine")
  run line(&mut path, &Metrics.hLine(value))
  DumpPath.pop(&mut path)
  run optional(&mut path, "maxHAdvance", fixedValue(&value.maxHAdvance))
  run optional(&mut path, "maxVAdvance", fixedValue(&value.maxVAdvance))
  run optional(&mut path, "xHeight", fixedValue(&value.xHeight))
  run optional(&mut path, "capHeight", fixedValue(&value.capHeight))
  run optional(&mut path, "averageCharWidth", fixedValue(&value.averageCharWidth))
}

effect fn charmap(path: &mut DumpPath, map: Charmap) -> ()
  ! WriterError
  ? &mut Writer {
  run field(&mut path, "hasUnicode", Charmap.hasUnicode(&map))
  run field(&mut path, "unicodeIsSymbol", Charmap.unicodeIsSymbol(&map))
  run field(&mut path, "unicodeIsMacRoman", Charmap.unicodeIsMacRoman(&map))
  run field(&mut path, "hasUnicodeVariants", Charmap.hasUnicodeVariants(&map))
  let probes: [u32; 20] = [
    0,
    1,
    32,
    65,
    66,
    127,
    128,
    255,
    256,
    233,
    0x400,
    0xf041,
    0xffff,
    0x10000,
    0x10ffff,
    0x110000,
    4294967295,
    65,
    32,
    0,
  ]
  let mut batch = [GlyphId.new(0); 20]
  let initial = Charmap.mapUnicodeBatched(&map, &probes, &mut batch)
  DumpPath.push(&mut path, "batch")
  run field(&mut path, "initial", initial)
  DumpPath.pop(&mut path)
  let mut i: usize = 0
  DumpPath.push(&mut path, "probes")
  while i < 20 {
    DumpPath.setIndex(&mut path, i)
    run field(&mut path, "code", probes[i])
    run optional(&mut path, "glyph", glyphValue(Charmap.mapUnicode(&map, probes[i])))
    run field(&mut path, "batch", GlyphId.toU32(batch[i]))
    i = i + 1
  }
  DumpPath.pop(&mut path)
  let mut unicodes = Charmap.unicodes(&map)
  i = 0
  DumpPath.push(&mut path, "unicodes")
  while i < 1114112 {
    let e = match move Unicodes.next(&mut unicodes) {
      Option<CmapMapping>.Some { value } => value
      _ => {
        break
      }
    }
    DumpPath.setIndex(&mut path, i)
    run field(&mut path, "code", e.codepoint)
    run field(&mut path, "glyph", GlyphId.toU32(e.glyph))
    run optional(&mut path, "lookup", glyphValue(Charmap.mapUnicode(&map, e.codepoint)))
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
  run field(&mut path, "length", i)
  DumpPath.pop(&mut path)
  let mut variants = Charmap.unicodeVariants(&map)
  i = 0
  DumpPath.push(&mut path, "variants")
  while i < 1114112 {
    let e = match move UnicodeVariants.next(&mut variants) {
      Option<UnicodeVariant>.Some { value } => value
      _ => {
        break
      }
    }
    DumpPath.setIndex(&mut path, i)
    run field(&mut path, "code", e.codepoint)
    run field(&mut path, "selector", e.selector)
    run field(&mut path, "glyph", GlyphId.toU32(e.glyph))
    run optional(
      &mut path,
      "lookup",
      glyphValue(Charmap.mapUnicodeVariant(&map, e.codepoint, e.selector)),
    )
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
  run field(&mut path, "length", i)
  DumpPath.pop(&mut path)
  let mut encodings = Charmap.encodings(&map)
  i = 0
  DumpPath.push(&mut path, "encodings")
  while let Option<Encoding>.Some { value: encoding } = Encodings.next(&mut encodings) {
    DumpPath.setIndex(&mut path, i)
    run field(&mut path, "kind", EncodingKind.value(Encoding.kind(encoding)))
    let mut tag = Option<u32>.None
    let mut index = Option<u32>.None
    let mut platform = Option<u16>.None
    let mut encodingId = Option<u16>.None
    if let Option<SfntIndex>.Some { value } = Encoding.sfntIndex(encoding) {
      tag = Option<u32>.some(Tag.toU32(value.tag))
      index = Option<u32>.some(value.index)
    }
    if let Option<SfntIds>.Some { value } = Encoding.sfntIds(encoding) {
      platform = Option<u16>.some(value.platformId)
      encodingId = Option<u16>.some(value.encodingId)
    }
    run optional(&mut path, "tag", move tag)
    run optional(&mut path, "index", move index)
    run optional(&mut path, "platform", move platform)
    run optional(&mut path, "encoding", move encodingId)
    let mut codes = Charmap.codes(&map, encoding)
    let mapper = Charmap.encodingMapper(&map, encoding)
    let mut n: usize = 0
    DumpPath.push(&mut path, "codes")
    while n < 1114112 {
      let e = match move Codes.next(&mut codes) {
        Option<CmapMapping>.Some { value } => value
        _ => {
          break
        }
      }
      DumpPath.setIndex(&mut path, n)
      run field(&mut path, "code", e.codepoint)
      run field(&mut path, "glyph", GlyphId.toU32(e.glyph))
      run optional(&mut path, "lookup", glyphValue(EncodingMapper.map(&mapper, e.codepoint)))
      n = n + 1
    }
    DumpPath.clearIndex(&mut path)
    run field(&mut path, "length", n)
    DumpPath.pop(&mut path)
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
  run field(&mut path, "length", i)
  DumpPath.pop(&mut path)
}

// Every glyph above uses the complete default chain. These fixed boundary probes
// additionally exercise custom orders and bitmap strike selection at each location.
effect fn sourceProbes<'a, 'c>(path: &mut DumpPath, metrics: GlyphMetrics<'a, 'c>, count: u32) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  let ids: [u32; 7] = [0, 1, 2, 31, u32.saturatingSubtract(count, 1), count, 4294967295]
  let orders = [
    GlyphSourceOrder.outlines(),
    GlyphSourceOrder.baseOutlines(),
    GlyphSourceOrder.bitmaps(),
    GlyphSourceOrder.color(),
    GlyphSourceOrder.empty(),
    GlyphSourceOrder.new(&[GlyphSource.Cff, GlyphSource.Glyf, GlyphSource.Colr]),
  ]
  DumpPath.push(&mut path, "sourceOrders")
  let mut order: usize = 0
  while order < 6 {
    DumpPath.setIndex(&mut path, order)
    let selected = GlyphMetrics.withExtentsSourceOrder(metrics, orders[order])
    DumpPath.push(&mut path, "glyphs")
    let mut i: usize = 0
    while i < 7 {
      DumpPath.setIndex(&mut path, u32.toUsize(ids[i]))
      run extentsExact(&mut path, run GlyphMetrics.extentsExact(&selected, GlyphId.new(ids[i])))
      i = i + 1
    }
    DumpPath.pop(&mut path)
    order = order + 1
  }
  DumpPath.pop(&mut path)
  let sizes: [f32; 2] = [12.0, 64.0]
  DumpPath.push(&mut path, "bitmapSizes")
  let mut size: usize = 0
  while size < 2 {
    DumpPath.setIndex(&mut path, size)
    let selected = GlyphMetrics.scaledF32(metrics, sizes[size])
    run field(&mut path, "ppem", f32.toBits(sizes[size]))
    DumpPath.push(&mut path, "glyphs")
    let mut i: usize = 0
    while i < 7 {
      DumpPath.setIndex(&mut path, u32.toUsize(ids[i]))
      run extentsF32(&mut path, run ScaledGlyphMetrics.extents(&selected, GlyphId.new(ids[i])))
      i = i + 1
    }
    DumpPath.pop(&mut path)
    size = size + 1
  }
  DumpPath.pop(&mut path)
}
