effect fn field<T: DumpValue>(path: &mut DumpPath, key: string<'static>, value: T) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, key)
  run scalar(&path, move value)
  DumpPath.pop(&mut path)
}

effect fn optional<T: DumpValue>(path: &mut DumpPath, key: string<'static>, input: Option<T>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, key)
  match move input {
    Option<T>.Some { value } => run scalar(&path, move value)
    _ => run absent(&path)
  }
  DumpPath.pop(&mut path)
}

fn glyphValue(input: Option<GlyphId>) -> Option<u32> {
  return match move input {
    Option<GlyphId>.Some { value } => Option<u32>.some(GlyphId.toU32(value))
    _ => Option<u32>.None
  }
}

fn fixedValue(input: &Option<F48Dot16>) -> Option<i64> {
  return match &input.* {
    Option<F48Dot16>.Some { value } => Option<i64>.some(F48Dot16.toBits(value))
    _ => Option<i64>.None
  }
}

effect fn name(path: &mut DumpPath, input: Option<GlyphName>, index: &GlyphNameIndex) -> ()
  ! WriterError
  ? &mut Writer {
  let item = match move input {
    Option<GlyphName>.Some { value } => value
    _ => {
      run absent(&path)
      return
    }
  }
  let source = match GlyphName.source(&item) {
    GlyphNameSource.Post => "Post"
    GlyphNameSource.Cff => "Cff"
    GlyphNameSource.Type1 => "Type1"
    GlyphNameSource.Synthesized => "Synthesized"
  }
  run field(&mut path, "source", source)
  DumpPath.push(&mut path, "utf8")
  run bytes(&path, String.utf8Bytes(GlyphName.asStr(&item)))
  DumpPath.pop(&mut path)
  run optional(&mut path, "reverse", glyphValue(GlyphNameIndex.get(index, GlyphName.asStr(&item))))
}

fn metricView<'a, 'c>(view: &TablesView<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(view, coords)
}

fn axes<'a>(tables: &'a Tables) -> usize {
  if let Result<Fvar<'a>, ReadError>.Success { value } = Tables.fvar(tables) {
    if let Result<ComputedArray<'a, (), VariationAxisRecord<'a>>, ReadError>.Success {
      value: records
    } = Fvar.axes(&value) {
      return ComputedArray<'a, (), VariationAxisRecord<'a>>.len(&records)
    }
  }
  return 0
}

pub effect fn dump(path: &mut DumpPath, data: &[u8], index: u32) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  DumpPath.push(&mut path, "model")
  let tables = match move run Tables.new(run Blob.fromBytes(data), index) {
    Option<Tables>.Some { value } => move value
    _ => {
      run field(&mut path, "error", "InvalidFont")
      DumpPath.pop(&mut path)
      return
    }
  }
  let view = Tables.view(&tables)
  let names = GlyphNameMap.new(&view)
  let reverse = run GlyphNameIndex.new(&names)
  let axisCount = axes(&tables)
  run field(&mut path, "glyphProbeLimit", 65536)
  run field(&mut path, "mappingProbeLimit", 1114112)
  run field(&mut path, "axes", axisCount)
  DumpPath.push(&mut path, "charmap")
  run charmap(&mut path, Charmap.new(&view))
  DumpPath.pop(&mut path)
  let count = GlyphNameMap.numGlyphs(&names)
  let mut bounded = count
  if bounded > 65536 {
    bounded = 65536
  }
  let mut ids = List<u32>.make()
  let mut gid: u32 = 0
  while gid < bounded {
    run List<u32>.append(&mut ids, gid)
    gid = gid + 1
  }
  let extra = [u32.saturatingSubtract(count, 1), count, u32.saturatingAdd(count, 1), 4294967295]
  let mut i: usize = 0
  while i < 4 {
    let mut found = false
    let mut n: usize = 0
    while n < List<u32>.length(&ids) {
      if List<u32>.get(&ids, n) == extra[i] {
        found = true
        break
      }
      n = n + 1
    }
    if !found {
      run List<u32>.append(&mut ids, extra[i])
    }
    i = i + 1
  }
  DumpPath.push(&mut path, "names")
  i = 0
  while i < List<u32>.length(&ids) {
    let id = List<u32>.get(&ids, i)
    DumpPath.setIndex(&mut path, u32.toUsize(id))
    run name(&mut path, GlyphNameMap.glyphName(&names, GlyphId.new(id)), &reverse)
    i = i + 1
  }
  DumpPath.pop(&mut path)
  let mut iter = GlyphNameMap.glyphNames(&names)
  i = 0
  DumpPath.push(&mut path, "nameIterator")
  while i < 65536 {
    let entry = match move GlyphNames.next(&mut iter) {
      Option<GlyphNameEntry>.Some { value } => value
      _ => {
        break
      }
    }
    DumpPath.setIndex(&mut path, i)
    run field(&mut path, "glyph", GlyphId.toU32(entry.glyph))
    DumpPath.push(&mut path, "name")
    run name(&mut path, Option<GlyphName>.some(entry.name), &reverse)
    DumpPath.pop(&mut path)
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
  run field(&mut path, "length", i)
  DumpPath.pop(&mut path)
  let locations: [i16; 4] = [0, -8192, 8192, 16384]
  let mut locationCount: usize = 4
  if axisCount == 0 {
    locationCount = 1
  }
  let mut coordinates = [F2Dot14.zero(); 65535]
  let mut location: usize = 0
  DumpPath.push(&mut path, "locations")
  while location < locationCount {
    DumpPath.setIndex(&mut path, location)
    let coord = locations[location]
    let mut axis: usize = 0
    while axis < axisCount {
      coordinates[axis] = F2Dot14.fromBits(coord)
      axis = axis + 1
    }
    let mut activeCount = axisCount
    if coord == 0 {
      activeCount = 0
    }
    let coords = Slice.view<F2Dot14>(&coordinates, 0, activeCount)
    run field(&mut path, "coord", coord)
    run field(&mut path, "coordinates", activeCount)
    DumpPath.push(&mut path, "metrics")
    run global(&mut path, &Metrics.fromSfnt(&view, coords))
    DumpPath.pop(&mut path)
    let metrics = metricView(&view, coords)
    run field(&mut path, "extentsSourceOrder", "default")
    let fine = GlyphMetrics.scaledF32(metrics, 16.0)
    let coarse = GlyphMetrics.scaled26dot6(metrics, 16.0)
    DumpPath.push(&mut path, "glyphs")
    i = 0
    while i < List<u32>.length(&ids) {
      let id = List<u32>.get(&ids, i)
      let glyph = GlyphId.new(id)
      DumpPath.setIndex(&mut path, u32.toUsize(id))
      run field(&mut path, "hAdvance", F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&metrics, glyph)))
      run field(&mut path, "vAdvance", F48Dot16.toBits(GlyphMetrics.vAdvanceExact(&metrics, glyph)))
      run field(
        &mut path,
        "vOriginY",
        F48Dot16.toBits(run GlyphMetrics.vOriginYExact(&metrics, glyph)),
      )
      DumpPath.push(&mut path, "extents")
      run extentsExact(&mut path, run GlyphMetrics.extentsExact(&metrics, glyph))
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "f32")
      run field(&mut path, "hAdvance", f32.toBits(ScaledGlyphMetrics.hAdvance(&fine, glyph)))
      run field(&mut path, "vAdvance", f32.toBits(ScaledGlyphMetrics.vAdvance(&fine, glyph)))
      run field(&mut path, "vOriginY", f32.toBits(run ScaledGlyphMetrics.vOriginY(&fine, glyph)))
      DumpPath.push(&mut path, "extents")
      run extentsF32(&mut path, run ScaledGlyphMetrics.extents(&fine, glyph))
      DumpPath.pop(&mut path)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "f26")
      run field(&mut path, "hAdvance", F26Dot6.toBits(ScaledGlyphMetrics.hAdvance(&coarse, glyph)))
      run field(&mut path, "vAdvance", F26Dot6.toBits(ScaledGlyphMetrics.vAdvance(&coarse, glyph)))
      run field(
        &mut path,
        "vOriginY",
        F26Dot6.toBits(run ScaledGlyphMetrics.vOriginY(&coarse, glyph)),
      )
      DumpPath.push(&mut path, "extents")
      run extentsF26(&mut path, run ScaledGlyphMetrics.extents(&coarse, glyph))
      DumpPath.pop(&mut path)
      DumpPath.pop(&mut path)
      i = i + 1
    }
    DumpPath.pop(&mut path)
    run sourceProbes(&mut path, metrics, count)
    location = location + 1
  }
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

effect fn extentsExact(path: &mut DumpPath, input: Option<GlyphExtents<F48Dot16>>) -> ()
  ! WriterError
  ? &mut Writer {
  let e = match move input {
    Option<GlyphExtents<F48Dot16>>.Some { value } => value
    _ => {
      run absent(&path)
      return
    }
  }
  run field(&mut path, "xBearing", F48Dot16.toBits(e.xBearing))
  run field(&mut path, "yBearing", F48Dot16.toBits(e.yBearing))
  run field(&mut path, "width", F48Dot16.toBits(e.width))
  run field(&mut path, "height", F48Dot16.toBits(e.height))
}

effect fn extentsF32(path: &mut DumpPath, input: Option<GlyphExtents<f32>>) -> ()
