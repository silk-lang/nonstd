  DumpPath.push(&mut path, "subfamilyNameId")
  run scalar(&path, NameId.toU16(value.subfamilyNameId))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "flags")
  run scalar(&path, value.flags)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "coordinates")
  DumpPath.push(&mut path, "length")
  run scalar(&path, ScalarArray<Fixed>.len(&value.coordinates))
  DumpPath.pop(&mut path)
  let mut index: usize = 0
  while index < ScalarArray<Fixed>.len(&value.coordinates) {
    DumpPath.setIndex(&mut path, index)
    if let Option<Fixed>.Some { value: item } = move ScalarArray<Fixed>.get(
      &value.coordinates,
      index,
    ) {
      run scalar(&path, Fixed.toBits(item))
    }
    index = index + 1
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "postScriptNameId")
  match move value.postScriptNameId {
    Option<NameId>.Some { value: item } => run scalar(&path, NameId.toU16(item))
    Option<NameId>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
}
