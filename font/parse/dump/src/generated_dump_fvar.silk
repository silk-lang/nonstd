import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "fvar")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1719034226)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1719034226) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Fvar<'a>.read(data) {
          Result<Fvar<'a>, ReadError>.Success { value: table } => run dumpFvar(&mut path, table)
          Result<Fvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}

