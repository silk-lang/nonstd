    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisInstanceArraysOffset")
    let fieldValue = Fvar<'a>.axisInstanceArraysOffset(&value)
    run scalar(&path, Offset16.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisInstanceArrays")
    let targetArgs: [u64; 3] = [
      u16.toU64(Fvar<'a>.axisCount(&value)),
      u16.toU64(Fvar<'a>.instanceCount(&value)),
      u16.toU64(Fvar<'a>.instanceSize(&value)),
    ]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = Fvar<'a>.axisInstanceArrays(&value)
    match move resolved {
      Result<AxisInstanceArrays<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<AxisInstanceArrays<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Fvar<'a>.reservedByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisCount")
    let fieldValue = Fvar<'a>.axisCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisSize")
    let fieldValue = Fvar<'a>.axisSize(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "instanceCount")
    let fieldValue = Fvar<'a>.instanceCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "instanceSize")
    let fieldValue = Fvar<'a>.instanceSize(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
