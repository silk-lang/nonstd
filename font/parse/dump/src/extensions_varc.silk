import read_fonts.lib { FontRef, ReadError, ArrayOfOffsets }
import read_fonts.tables.varc {
  Varc,
  VarcGlyph,
  VarcComponent,
  VarcComponentIter,
  VarcFlags,
  DecomposedTransform,
  Index2,
  MultiItemVariationStore,
  MultiItemVariationData,
  SparseVariationRegionList,
  SparseVariationRegion
}
import read_fonts.tables.variations { PackedDeltas, DeltaRunIter }
import font_types.lib { GlyphId, F2Dot14, Offset32 }
import silk.geometry.affine { Affine2 }
import dump_support { DumpPath, scalar, absent, readError }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u32
import silk.num.f32

effect fn optional(path: &DumpPath, value: Option<u32>) -> ()
  ! WriterError
  ? &mut Writer {
  match move value {
    Option<u32>.Some { value: item } => run scalar(path, item)
    _ => run absent(path)
  }
}

effect fn deltas<'a>(path: &mut DumpPath, values: PackedDeltas<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "countOrCompute")
  run scalar(&path, PackedDeltas.countOrCompute(&values))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "values")
  let mut iter = PackedDeltas.iter(&values)
  let mut index: usize = 0
  while let Option<i32>.Some { value } = move DeltaRunIter.next(&mut iter) {
    DumpPath.setIndex(&mut path, index)
    run scalar(&path, value)
    index = index + 1
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, index)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

effect fn component<'a>(path: &mut DumpPath, item: &VarcComponent<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "flags")
  run scalar(&path, VarcFlags.bits(&VarcComponent.flags(item)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "gid")
  run scalar(&path, GlyphId.toU32(VarcComponent.gid(item)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "conditionIndex")
  run optional(&path, VarcComponent.conditionIndex(item))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "axisIndicesIndex")
  run optional(&path, VarcComponent.axisIndicesIndex(item))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "axisValuesVarIndex")
  run optional(&path, VarcComponent.axisValuesVarIndex(item))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "transformVarIndex")
  run optional(&path, VarcComponent.transformVarIndex(item))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "axisValues")
  match move VarcComponent.axisValues(item) {
    Option<PackedDeltas<'a>>.Some { value } => run deltas(&mut path, value)
    _ => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "transform")
  let transform = VarcComponent.transform(item)
  DumpPath.push(&mut path, "translateX")
  run scalar(&path, f32.toBits(DecomposedTransform.translateX(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "translateY")
  run scalar(&path, f32.toBits(DecomposedTransform.translateY(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "rotation")
  run scalar(&path, f32.toBits(DecomposedTransform.rotation(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "scaleX")
  run scalar(&path, f32.toBits(DecomposedTransform.scaleX(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "scaleY")
  run scalar(&path, f32.toBits(DecomposedTransform.scaleY(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "skewX")
  run scalar(&path, f32.toBits(DecomposedTransform.skewX(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "skewY")
  run scalar(&path, f32.toBits(DecomposedTransform.skewY(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "centerX")
  run scalar(&path, f32.toBits(DecomposedTransform.centerX(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "centerY")
  run scalar(&path, f32.toBits(DecomposedTransform.centerY(&transform)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "matrix")
  let matrix = (DecomposedTransform.matrix(&transform)).coefficients()
  let mut i: usize = 0
  while i < 6 {
    DumpPath.setIndex(&mut path, i)
    run scalar(&path, f32.toBits(matrix[i]))
    i = i + 1
  }
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let table = match move FontRef.varc(font) {
    Result<Varc<'a>, ReadError>.Success { value } => value
    _ => {
      return
    }
  }
  DumpPath.push(&mut path, "varcQueries")
  if let Option<Result<Index2<'a>, ReadError>>.Some { value: result } = move Varc.axisIndicesList(
    &table,
  ) {
    if let Result<Index2<'a>, ReadError>.Success { value: index } = move result {
      DumpPath.push(&mut path, "axisIndices")
      let mut i: usize = 0
      while i < u32.toUsize(Index2.count(&index)) {
        DumpPath.setIndex(&mut path, i)
        match move Varc.axisIndices(&table, i) {
          Result<PackedDeltas<'a>, ReadError>.Success { value } => run deltas(&mut path, value)
          Result<PackedDeltas<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        i = i + 1
      }
      DumpPath.pop(&mut path)
    }
  }
  if let Result<Index2<'a>, ReadError>.Success { value: index } = move Varc.varCompositeGlyphs(
    &table,
  ) {
    DumpPath.push(&mut path, "glyphs")
    let mut i: usize = 0
    while i < u32.toUsize(Index2.count(&index)) {
      DumpPath.setIndex(&mut path, i)
      match move Varc.glyph(&table, i) {
        Result<VarcGlyph<'a>, ReadError>.Failure { error } => run readError(&path, error)
        Result<VarcGlyph<'a>, ReadError>.Success { value: glyph } => {
          DumpPath.push(&mut path, "components")
          let mut iter = VarcGlyph.components(&glyph)
          let mut j: usize = 0
          while let Option<Result<VarcComponent<'a>, ReadError>>.Some {
            value: result
          } = move VarcComponentIter.next(&mut iter) {
            DumpPath.setIndex(&mut path, j)
            match move result {
              Result<VarcComponent<'a>, ReadError>.Success { value: item } => run component(
                &mut path,
                &item,
              )
              Result<VarcComponent<'a>, ReadError>.Failure { error } => run readError(&path, error)
            }
            j = j + 1
          }
          DumpPath.clearIndex(&mut path)
          DumpPath.push(&mut path, "length")
          run scalar(&path, j)
          DumpPath.pop(&mut path)
          DumpPath.pop(&mut path)
        }
      }
      i = i + 1
    }
    DumpPath.pop(&mut path)
  }
  if let Option<Result<MultiItemVariationStore<'a>, ReadError>>.Some {
    value: result
  } = move Varc.multiVarStore(&table) {
    if let Result<MultiItemVariationStore<'a>, ReadError>.Success { value: store } = move result {
      if let Result<SparseVariationRegionList<'a>, ReadError>.Success {
        value: list
      } = move MultiItemVariationStore.regionList(&store) {
        let regions = SparseVariationRegionList.regions(&list)
        DumpPath.push(&mut path, "regions")
        let mut i: usize = 0
        let coords: [[F2Dot14; 8]; 4] = [
          [F2Dot14.zero(); 8],
          [F2Dot14.fromBits(8192); 8],
          [F2Dot14.one(); 8],
          [F2Dot14.fromBits(-8192); 8],
        ]
        while i < ArrayOfOffsets<'a, (), SparseVariationRegion<'a>, Offset32>.len(&regions) {
          DumpPath.setIndex(&mut path, i)
          match move ArrayOfOffsets<'a, (), SparseVariationRegion<'a>, Offset32>.get(&regions, i) {
            Result<SparseVariationRegion<'a>, ReadError>.Failure { error } => run readError(
              &path,
              error,
            )
            Result<SparseVariationRegion<'a>, ReadError>.Success { value: region } => {
              DumpPath.push(&mut path, "scalar")
              let mut c: usize = 0
              while c < 4 {
                DumpPath.setIndex(&mut path, c)
                run scalar(
                  &path,
                  f32.toBits(SparseVariationRegion.computeScalarF32(&region, &coords[c])),
                )
                c = c + 1
              }
              DumpPath.pop(&mut path)
            }
          }
          i = i + 1
        }
        DumpPath.pop(&mut path)
      }
      let data = MultiItemVariationStore.variationData(&store)
      DumpPath.push(&mut path, "variationData")
      let mut i: usize = 0
      while i < ArrayOfOffsets<'a, (), MultiItemVariationData<'a>, Offset32>.len(&data) {
        DumpPath.setIndex(&mut path, i)
        if let Result<MultiItemVariationData<'a>, ReadError>.Success {
          value: item
        } = move ArrayOfOffsets<'a, (), MultiItemVariationData<'a>, Offset32>.get(&data, i) {
          if let Result<Index2<'a>, ReadError>.Success {
            value: index
          } = move MultiItemVariationData.deltaSets(&item) {
            DumpPath.push(&mut path, "deltaSets")
            let mut j: usize = 0
            while j < u32.toUsize(Index2.count(&index)) {
              DumpPath.setIndex(&mut path, j)
              match move MultiItemVariationData.deltaSet(&item, j) {
                Result<PackedDeltas<'a>, ReadError>.Success { value } => run deltas(
                  &mut path,
                  value,
                )
                Result<PackedDeltas<'a>, ReadError>.Failure { error } => run readError(&path, error)
              }
              j = j + 1
            }
            DumpPath.pop(&mut path)
          }
        }
        i = i + 1
      }
      DumpPath.pop(&mut path)
    }
  }
  DumpPath.pop(&mut path)
}
