import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "COLR")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1129270354)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1129270354) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Colr<'a>.read(data) {
          Result<Colr<'a>, ReadError>.Success { value: table } => run dumpColr(&mut path, table)
          Result<Colr<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
