pub effect fn dumpColorLine<'a>(path: &mut DumpPath, value: ColorLine<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3586393470,
    FontData.len(&ColorLine<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = ColorLine<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "extend")
    let fieldValue = ColorLine<'a>.extend(&value)
    run scalar(&path, Extend.value(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numStops")
    let fieldValue = ColorLine<'a>.numStops(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "colorStops")
    let fieldValue = ColorLine<'a>.colorStops(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), ColorStop<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), ColorStop<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), ColorStop<'a>>.get(&fieldValue, index) {
        Result<ColorStop<'a>, ReadError>.Success { value: item } => run dumpColorStop(
          &mut path,
          item,
          base,
        )
        Result<ColorStop<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

