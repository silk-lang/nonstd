  if true {
    DumpPath.push(&mut path, "colorLine")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = PaintLinearGradient<'a>.colorLine(&value)
    match move resolved {
      Result<ColorLine<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<ColorLine<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
