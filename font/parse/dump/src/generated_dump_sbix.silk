pub effect fn dumpStrikeGlyphs<'a>(path: &mut DumpPath, value: Strike<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let offsets = Strike.glyphDataOffsets(&value)
  let length = ScalarArray<u32>.len(&offsets)
  DumpPath.push(&mut path, "glyphData")
  let mut index: usize = 0
  while index + 1 < length {
    DumpPath.beginTable(&mut path)
    DumpPath.setIndex(&mut path, index)
    match move Strike.glyphData(&value, GlyphId.new(usize.toU32(index))) {
      Result<Option<GlyphData<'a>>, ReadError>.Success { value: glyph } => {
        match move glyph {
          Option<GlyphData<'a>>.Some { value: table } => run dumpGlyphData(&mut path, table)
          Option<GlyphData<'a>>.None => run absent(&path)
        }
      }
      Result<Option<GlyphData<'a>>, ReadError>.Failure { error } => run readError(&path, error)
    }
    index = index + 1
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, index)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

