import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "sbix")
    match move FontRef<'a>.sbix(font) {
      Result<Sbix<'a>, ReadError>.Success { value: table } => run dumpSbix(&mut path, table)
      Result<Sbix<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}

