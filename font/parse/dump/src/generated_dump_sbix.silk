  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Sbix<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "flags")
    let fieldValue = Sbix<'a>.flags(&value)
    run scalar(&path, HeaderFlags.bits(&fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numStrikes")
    let fieldValue = Sbix<'a>.numStrikes(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "strikeOffsets")
    let fieldValue = Sbix<'a>.strikeOffsets(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, Offset32>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, Offset32>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<Offset32>.Some { value: item } = move ScalarArray<'a, Offset32>.get(
        &fieldValue,
        index,
      ) {
        run scalar(&path, Offset32.toU32(item))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "strikes")
    let targetArgs: [u64; 3] = [dumpArgs[0], 0, 0]
    let resolvedArray = Sbix<'a>.strikes(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ArrayOfOffsets<'a, u32, Strike<'a>, Offset32>.len(&resolvedArray))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ArrayOfOffsets<'a, u32, Strike<'a>, Offset32>.len(&resolvedArray) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, targetArgs)
      let resolved = ArrayOfOffsets<'a, u32, Strike<'a>, Offset32>.get(&resolvedArray, index)
      match move resolved {
        Result<Strike<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
          &table,
          &mut path,
        )
        Result<Strike<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

