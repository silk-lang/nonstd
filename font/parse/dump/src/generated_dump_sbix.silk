pub effect fn dumpSbix<'a>(path: &mut DumpPath, value: Sbix<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3649993981,
    FontData.len(&Sbix<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
