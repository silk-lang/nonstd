import read_fonts.lib { FontRef, FontData, ReadError, ComputedArray }
import read_fonts.tables.bitmap {
  BitmapSize,
  BitmapLocation,
  BitmapData,
  BitmapContent,
  BitmapMetrics,
  BitmapDataFormat,
  BdtComponent,
  BigGlyphMetrics
}
import read_fonts.tables.cblc { Cblc }
import read_fonts.tables.cbdt { Cbdt }
import read_fonts.tables.eblc { Eblc }
import read_fonts.tables.ebdt { Ebdt }
import generated_dump_bitmap { dumpSmallGlyphMetrics, dumpBigGlyphMetrics, dumpBdtComponent }
import font_types.lib { GlyphId, GlyphId16 }
import dump_support { DumpPath, scalar, bytes, readError, absent }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u32

effect fn dumpLocation<'a>(
  path: &mut DumpPath,
  location: &BitmapLocation<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "format")
  run scalar(&path, location.format)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "dataOffset")
  run scalar(&path, location.dataOffset)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "dataSize")
  run scalar(&path, location.dataSize)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "bitDepth")
  run scalar(&path, location.bitDepth)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "locationMetrics")
  match &location.metrics {
    Option<BigGlyphMetrics<'a>>.Some { value } => run dumpBigGlyphMetrics(&mut path, value, base)
    _ => run absent(&path)
  }
  DumpPath.pop(&mut path)
}

effect fn dumpData<'a>(path: &mut DumpPath, data: BitmapData<'a>, base: FontData<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "metrics")
  match data.metrics {
    BitmapMetrics<'a>.Small { value } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Small")
      DumpPath.pop(&mut path)
      run dumpSmallGlyphMetrics(&mut path, value, base)
    }
    BitmapMetrics<'a>.Big { value } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Big")
      DumpPath.pop(&mut path)
      run dumpBigGlyphMetrics(&mut path, value, base)
    }
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "content")
  match data.content {
    BitmapContent<'a>.Data { format, bytes: image } => {
      let name = match format {
        BitmapDataFormat.BitAligned => "BitAligned"
        BitmapDataFormat.ByteAligned => "ByteAligned"
        BitmapDataFormat.Png => "Png"
      }
      DumpPath.push(&mut path, "kind")
      run scalar(&path, name)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "bytes")
      run bytes(&path, image)
      DumpPath.pop(&mut path)
    }
    BitmapContent<'a>.Composite { value } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Composite")
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "components")
      DumpPath.push(&mut path, "length")
      run scalar(&path, ComputedArray<'a, (), BdtComponent<'a>>.len(&value))
      DumpPath.pop(&mut path)
      let mut index: usize = 0
      while index < ComputedArray<'a, (), BdtComponent<'a>>.len(&value) {
        DumpPath.setIndex(&mut path, index)
        match move ComputedArray<'a, (), BdtComponent<'a>>.get(&value, index) {
          Result<BdtComponent<'a>, ReadError>.Success { value: item } => run dumpBdtComponent(
            &mut path,
            item,
            base,
          )
          Result<BdtComponent<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        index = index + 1
      }
      DumpPath.clearIndex(&mut path)
      DumpPath.pop(&mut path)
    }
  }
  DumpPath.pop(&mut path)
}

effect fn dumpCblc<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let locations = match move FontRef.cblc(font) {
    Result<Cblc<'a>, ReadError>.Success { value } => value
    Result<Cblc<'a>, ReadError>.Failure { error } => {
      run readError(&path, error)
      return
    }
  }
  let images = match move FontRef.cbdt(font) {
    Result<Cbdt<'a>, ReadError>.Success { value } => value
    Result<Cbdt<'a>, ReadError>.Failure { error } => {
      run readError(&path, error)
      return
    }
  }
  let sizes = Cblc.bitmapSizes(&locations)
  let mut index: usize = 0
  DumpPath.push(&mut path, "strikes")
  while index < ComputedArray<'a, (), BitmapSize<'a>>.len(&sizes) {
    DumpPath.setIndex(&mut path, index)
    match move ComputedArray<'a, (), BitmapSize<'a>>.get(&sizes, index) {
      Result<BitmapSize<'a>, ReadError>.Failure { error } => run readError(&path, error)
      Result<BitmapSize<'a>, ReadError>.Success { value: size } => {
        DumpPath.push(&mut path, "glyphs")
        let mut gid = GlyphId16.toU32(BitmapSize.startGlyphIndex(&size))
        let end = GlyphId16.toU32(BitmapSize.endGlyphIndex(&size))
        while gid <= end {
          DumpPath.setIndex(&mut path, u32.toUsize(gid))
          match move BitmapSize.location(&size, Cblc.offsetData(&locations), GlyphId.new(gid)) {
            Result<BitmapLocation<'a>, ReadError>.Failure { error } => run readError(&path, error)
            Result<BitmapLocation<'a>, ReadError>.Success { value: location } => {
              run dumpLocation(&mut path, &location, Cblc.offsetData(&locations))
              match move Cbdt.data(&images, &location) {
                Result<BitmapData<'a>, ReadError>.Success { value: data } => run dumpData(
                  &mut path,
                  data,
                  Cbdt.offsetData(&images),
                )
                Result<BitmapData<'a>, ReadError>.Failure { error } => run readError(&path, error)
              }
            }
          }
          gid = gid + 1
        }
        DumpPath.clearIndex(&mut path)
        DumpPath.pop(&mut path)
      }
    }
    index = index + 1
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, index)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

effect fn dumpEblc<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let locations = match move FontRef.eblc(font) {
    Result<Eblc<'a>, ReadError>.Success { value } => value
    Result<Eblc<'a>, ReadError>.Failure { error } => {
      run readError(&path, error)
      return
    }
  }
  let images = match move FontRef.ebdt(font) {
    Result<Ebdt<'a>, ReadError>.Success { value } => value
    Result<Ebdt<'a>, ReadError>.Failure { error } => {
      run readError(&path, error)
      return
    }
  }
  let sizes = Eblc.bitmapSizes(&locations)
  let mut index: usize = 0
  DumpPath.push(&mut path, "strikes")
  while index < ComputedArray<'a, (), BitmapSize<'a>>.len(&sizes) {
    DumpPath.setIndex(&mut path, index)
    match move ComputedArray<'a, (), BitmapSize<'a>>.get(&sizes, index) {
      Result<BitmapSize<'a>, ReadError>.Failure { error } => run readError(&path, error)
      Result<BitmapSize<'a>, ReadError>.Success { value: size } => {
        DumpPath.push(&mut path, "glyphs")
        let mut gid = GlyphId16.toU32(BitmapSize.startGlyphIndex(&size))
        let end = GlyphId16.toU32(BitmapSize.endGlyphIndex(&size))
        while gid <= end {
          DumpPath.setIndex(&mut path, u32.toUsize(gid))
          match move BitmapSize.location(&size, Eblc.offsetData(&locations), GlyphId.new(gid)) {
            Result<BitmapLocation<'a>, ReadError>.Failure { error } => run readError(&path, error)
            Result<BitmapLocation<'a>, ReadError>.Success { value: location } => {
              run dumpLocation(&mut path, &location, Eblc.offsetData(&locations))
              match move Ebdt.data(&images, &location) {
                Result<BitmapData<'a>, ReadError>.Success { value: data } => run dumpData(
                  &mut path,
                  data,
                  Ebdt.offsetData(&images),
                )
                Result<BitmapData<'a>, ReadError>.Failure { error } => run readError(&path, error)
              }
            }
          }
          gid = gid + 1
        }
        DumpPath.clearIndex(&mut path)
        DumpPath.pop(&mut path)
      }
    }
    index = index + 1
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, index)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.beginTable(&mut path)
  DumpPath.push(&mut path, "bitmapData")
  DumpPath.push(&mut path, "CBLC")
  run dumpCblc(&mut path, font)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "EBLC")
  run dumpEblc(&mut path, font)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)
}
