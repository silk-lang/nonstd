pub effect fn dumpDeviceRecord<'a>(
  path: &mut DumpPath,
  value: DeviceRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "pixelSize")
  run scalar(&path, DeviceRecord.pixelSize(&value))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "maxWidth")
  run scalar(&path, DeviceRecord.maxWidth(&value))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "widths")
  run bytes(&path, DeviceRecord.widths(&value))
  DumpPath.pop(&mut path)
}
