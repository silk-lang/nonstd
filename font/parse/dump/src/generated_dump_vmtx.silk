import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "vmtx")
    match move FontRef<'a>.vmtx(font) {
      Result<Vmtx<'a>, ReadError>.Success { value: table } => run dumpVmtx(&mut path, table)
      Result<Vmtx<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "VMTX")
    match move FontRef<'a>.vmtxExtended(font) {
      Result<VmtxExtended<'a>, ReadError>.Success { value: table } => run dumpVmtxExtended(
        &mut path,
        table,
      )
      Result<VmtxExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}
