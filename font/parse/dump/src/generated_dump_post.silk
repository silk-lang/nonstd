      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1886352244) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Post<'a>.read(data) {
          Result<Post<'a>, ReadError>.Success { value: table } => run dumpPost(&mut path, table)
          Result<Post<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
