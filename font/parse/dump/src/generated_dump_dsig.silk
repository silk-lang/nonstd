import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "DSIG")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1146308935)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1146308935) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Dsig<'a>.read(data) {
          Result<Dsig<'a>, ReadError>.Success { value: table } => run dumpDsig(&mut path, table)
          Result<Dsig<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
