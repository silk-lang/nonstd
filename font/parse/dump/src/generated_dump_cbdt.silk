pub effect fn dumpCbdt<'a>(path: &mut DumpPath, value: Cbdt<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2718719701,
    FontData.len(&Cbdt<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
