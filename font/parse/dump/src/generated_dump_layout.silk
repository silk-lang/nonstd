pub effect fn dumpChainedSequenceContext<'a>(
  path: &mut DumpPath,
  value: ChainedSequenceContext<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    ChainedSequenceContext<'a>.Format1 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1")
      DumpPath.pop(&mut path)
      run dumpChainedSequenceContextFormat1(&mut path, table)
    }
    ChainedSequenceContext<'a>.Format2 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2")
      DumpPath.pop(&mut path)
      run dumpChainedSequenceContextFormat2(&mut path, table)
    }
    ChainedSequenceContext<'a>.Format3 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format3")
      DumpPath.pop(&mut path)
      run dumpChainedSequenceContextFormat3(&mut path, table)
    }
    ChainedSequenceContext<'a>.Format4 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format4")
      DumpPath.pop(&mut path)
      run dumpChainedSequenceContextFormat4(&mut path, table)
    }
    ChainedSequenceContext<'a>.Format5 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format5")
      DumpPath.pop(&mut path)
      run dumpChainedSequenceContextFormat5(&mut path, table)
    }
  }
}

