  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    Condition<'a>.Format1AxisRange { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1AxisRange")
      DumpPath.pop(&mut path)
      run dumpConditionFormat1(&mut path, table)
    }
    Condition<'a>.Format2VariableValue { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2VariableValue")
      DumpPath.pop(&mut path)
      run dumpConditionFormat2(&mut path, table)
    }
