      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format3And")
      DumpPath.pop(&mut path)
      run dumpConditionFormat3(&mut path, table)
    }
    Condition<'a>.Format4Or { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format4Or")
      DumpPath.pop(&mut path)
      run dumpConditionFormat4(&mut path, table)
    }
    Condition<'a>.Format5Negate { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format5Negate")
      DumpPath.pop(&mut path)
      run dumpConditionFormat5(&mut path, table)
    }
  }
}

