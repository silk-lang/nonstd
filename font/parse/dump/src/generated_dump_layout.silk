  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    1384470618,
    FontData.len(&ConditionFormat5<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = ConditionFormat5<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "format")
    let fieldValue = ConditionFormat5<'a>.format(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "conditionOffset")
    let fieldValue = ConditionFormat5<'a>.conditionOffset(&value)
    run scalar(&path, Offset24.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "condition")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = ConditionFormat5<'a>.condition(&value)
    match move resolved {
      Result<Condition<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<Condition<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpFeatureTableSubstitution<'a>(
  path: &mut DumpPath,
  value: FeatureTableSubstitution<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3760121008,
    FontData.len(&FeatureTableSubstitution<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = FeatureTableSubstitution<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = FeatureTableSubstitution<'a>.version(&value)
    DumpPath.push(&mut path, "major")
    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "substitutionCount")
    let fieldValue = FeatureTableSubstitution<'a>.substitutionCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "substitutions")
    let fieldValue = FeatureTableSubstitution<'a>.substitutions(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>.get(&fieldValue, index) {
        Result<FeatureTableSubstitutionRecord<'a>, ReadError>.Success {
          value: item
        } => run dumpFeatureTableSubstitutionRecord(&mut path, item, base)
        Result<FeatureTableSubstitutionRecord<'a>, ReadError>.Failure { error } => run readError(
          &path,
          error,
        )
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpFeatureTableSubstitutionRecord<'a>(
  path: &mut DumpPath,
  value: FeatureTableSubstitutionRecord<'a>,
