pub effect fn dumpStoreEvaluation<'a>(path: &mut DumpPath, table: ItemVariationStore<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let axisCount = match move ItemVariationStore.variationRegionList(&table) {
    Result<VariationRegionList<'a>, ReadError>.Success { value } => u16.toUsize(
      VariationRegionList.axisCount(&value),
    )
    _ => 0
  }
  let locations: [i16; 4] = [0, -8192, 8192, 16384]
  let mut coordinates = [F2Dot14.zero(); 65535]
  let arrays = ItemVariationStore.itemVariationData(&table)
  DumpPath.push(&mut path, "evaluated")
  let mut location: usize = 0
  while location < 4 {
    DumpPath.setIndex(&mut path, location)
    DumpPath.push(&mut path, "coordinate")
    run scalar(&path, locations[location])
    DumpPath.pop(&mut path)
    let mut axis: usize = 0
    while axis < axisCount {
      coordinates[axis] = F2Dot14.fromBits(locations[location])
      axis = axis + 1
    }
    let coords = Slice.view<F2Dot14>(&coordinates, 0, axisCount)
    DumpPath.push(&mut path, "outer")
    let mut outer: usize = 0
    while outer < ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.len(&arrays) {
      DumpPath.setIndex(&mut path, outer)
      match move ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.get(
        &arrays,
        outer,
      ) {
        Option<Result<ItemVariationData<'a>, ReadError>>.None => run absent(&path)
        Option<Result<ItemVariationData<'a>, ReadError>>.Some {
          value: result
        } => match move result {
          Result<ItemVariationData<'a>, ReadError>.Failure { error } => run readError(&path, error)
          Result<ItemVariationData<'a>, ReadError>.Success { value } => {
            DumpPath.push(&mut path, "inner")
            let mut inner: usize = 0

            // Include an index beyond the declared row count to compare lazy tails.
            while inner <= u16.toUsize(ItemVariationData.itemCount(&value)) && inner < 65536 {
              DumpPath.setIndex(&mut path, inner)
              let index = DeltaSetIndex { outer: usize.toU16(outer), inner: usize.toU16(inner) }
              match move ItemVariationStore.computeDelta(&table, index, coords) {
                Option<F48Dot16>.Some { value: delta } => run scalar(&path, F48Dot16.toBits(delta))
                Option<F48Dot16>.None => run absent(&path)
              }
              inner = inner + 1
            }
            DumpPath.pop(&mut path)
          }
        }
      }
      outer = outer + 1
    }
    DumpPath.pop(&mut path)
    location = location + 1
  }
  DumpPath.pop(&mut path)
}
