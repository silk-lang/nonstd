import read_fonts.lib { FontData, ReadError, ComputedArray }
import read_fonts.tables.name {
  Name,
  NameRecord,
  LangTagRecord,
  NameString,
  CharIter,
  languageIdToBcp47
}
import dump_support { DumpPath, scalar, absent, readError, bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.char
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

effect fn text<'a>(path: &mut DumpPath, value: Result<NameString<'a>, ReadError>) -> ()
  ! WriterError
  ? &mut Writer {
  match move value {
    Result<NameString<'a>, ReadError>.Failure { error } => run readError(&path, error)
    Result<NameString<'a>, ReadError>.Success { value: name } => {
      let mut count: usize = 0
      let mut counter = NameString<'a>.chars(&name)
      while true {
        if let Option<char>.None = move CharIter<'a>.next(&mut counter) {
          break
        }
        count = count + 1
      }
      DumpPath.push(&mut path, "length")
      run scalar(&path, count)
      DumpPath.pop(&mut path)
      let mut iter = NameString<'a>.chars(&name)
      let mut i: usize = 0
      while i < count {
        DumpPath.setIndex(&mut path, i)
        if let Option<char>.Some { value: character } = move CharIter<'a>.next(&mut iter) {
          run scalar(&path, char.toU32(character))
        }
        i = i + 1
      }
      DumpPath.clearIndex(&mut path)
    }
  }
}

pub effect fn dumpNames<'a>(path: &mut DumpPath, table: Name<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let base = Name<'a>.stringData(&table)
  DumpPath.push(&mut path, "storageBytes")
  run bytes(&path, FontData.asBytes(&base))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "decodedNames")
  let records = Name<'a>.nameRecord(&table)
  DumpPath.push(&mut path, "length")
  run scalar(&path, ComputedArray<'a, (), NameRecord<'a>>.len(&records))
  DumpPath.pop(&mut path)
  let mut i: usize = 0
  while i < ComputedArray<'a, (), NameRecord<'a>>.len(&records) {
    DumpPath.setIndex(&mut path, i)
    if let Result<NameRecord<'a>, ReadError>.Success { value } = move ComputedArray<
      'a,
      (),
      NameRecord<'a>
    >.get(&records, i) {
      DumpPath.push(&mut path, "isUnicode")
      run scalar(&path, NameRecord<'a>.isUnicode(&value))
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "language")
      match move languageIdToBcp47(
        NameRecord<'a>.platformId(&value),
        NameRecord<'a>.languageId(&value),
      ) {
        Option<string<'static>>.Some { value: language } => run bytes(
          &path,
          String.utf8Bytes(language),
        )
        Option<string<'static>>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "text")
      run text(&mut path, NameRecord<'a>.string(&value, base))
      DumpPath.pop(&mut path)
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "decodedLanguageTags")
  match move Name<'a>.langTagRecord(&table) {
    Option<ComputedArray<'a, (), LangTagRecord<'a>>>.None => run absent(&path)
    Option<ComputedArray<'a, (), LangTagRecord<'a>>>.Some { value: tagRecords } => {
      DumpPath.push(&mut path, "length")
      run scalar(&path, ComputedArray<'a, (), LangTagRecord<'a>>.len(&tagRecords))
      DumpPath.pop(&mut path)
      i = 0
      while i < ComputedArray<'a, (), LangTagRecord<'a>>.len(&tagRecords) {
        DumpPath.setIndex(&mut path, i)
        if let Result<LangTagRecord<'a>, ReadError>.Success { value } = move ComputedArray<
          'a,
          (),
          LangTagRecord<'a>
        >.get(&tagRecords, i) {
          DumpPath.push(&mut path, "text")
          run text(&mut path, LangTagRecord<'a>.langTag(&value, base))
          DumpPath.pop(&mut path)
        }
        i = i + 1
      }
    }
  }
  DumpPath.pop(&mut path)
}
