pub effect fn dumpValueRecord<'a>(
  path: &mut DumpPath,
  value: ValueRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  DumpPath.push(&mut path, "format")
  run scalar(&path, ValueFormat.bits(&ValueRecord.format(&value)))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "offset")
  run scalar(&path, ValueRecord.offset(&value))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "bytes")
  match move ValueRecord.bytes(&value) {
    Option<&'a [u8]>.Some { value: raw } => run bytes(&path, raw)
    Option<&'a [u8]>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xPlacement")
  match move ValueRecord.xPlacement(&value) {
    Option<i16>.Some { value: field } => run scalar(&path, field)
    Option<i16>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xPlacementDeviceOffset")
  match move ValueRecord.deviceOffset(&value, ValueFormat.xPlacementDevice()) {
    Option<Nullable<Offset16>>.Some { value: field } => run scalar(
      &path,
      Offset16.toU32(Nullable<Offset16>.offset(&field).*),
    )
    Option<Nullable<Offset16>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xPlacementDevice")
  match move ValueRecord.xPlacementDevice(&value) {
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.Some {
      value: result
    } => match move result {
      Result<DeviceOrVariationIndex<'a>, ReadError>.Success { value: device } => run DumpTable.dump(
        &device,
        &mut path,
      )
      Result<DeviceOrVariationIndex<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yPlacement")
  match move ValueRecord.yPlacement(&value) {
    Option<i16>.Some { value: field } => run scalar(&path, field)
    Option<i16>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yPlacementDeviceOffset")
  match move ValueRecord.deviceOffset(&value, ValueFormat.yPlacementDevice()) {
    Option<Nullable<Offset16>>.Some { value: field } => run scalar(
      &path,
      Offset16.toU32(Nullable<Offset16>.offset(&field).*),
    )
    Option<Nullable<Offset16>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yPlacementDevice")
  match move ValueRecord.yPlacementDevice(&value) {
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.Some {
      value: result
    } => match move result {
      Result<DeviceOrVariationIndex<'a>, ReadError>.Success { value: device } => run DumpTable.dump(
        &device,
        &mut path,
      )
      Result<DeviceOrVariationIndex<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xAdvance")
  match move ValueRecord.xAdvance(&value) {
    Option<i16>.Some { value: field } => run scalar(&path, field)
    Option<i16>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xAdvanceDeviceOffset")
  match move ValueRecord.deviceOffset(&value, ValueFormat.xAdvanceDevice()) {
    Option<Nullable<Offset16>>.Some { value: field } => run scalar(
      &path,
      Offset16.toU32(Nullable<Offset16>.offset(&field).*),
    )
    Option<Nullable<Offset16>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "xAdvanceDevice")
  match move ValueRecord.xAdvanceDevice(&value) {
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.Some {
      value: result
    } => match move result {
      Result<DeviceOrVariationIndex<'a>, ReadError>.Success { value: device } => run DumpTable.dump(
        &device,
        &mut path,
      )
      Result<DeviceOrVariationIndex<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yAdvance")
  match move ValueRecord.yAdvance(&value) {
    Option<i16>.Some { value: field } => run scalar(&path, field)
    Option<i16>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yAdvanceDeviceOffset")
  match move ValueRecord.deviceOffset(&value, ValueFormat.yAdvanceDevice()) {
    Option<Nullable<Offset16>>.Some { value: field } => run scalar(
      &path,
      Offset16.toU32(Nullable<Offset16>.offset(&field).*),
    )
    Option<Nullable<Offset16>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "yAdvanceDevice")
  match move ValueRecord.yAdvanceDevice(&value) {
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.Some {
      value: result
    } => match move result {
      Result<DeviceOrVariationIndex<'a>, ReadError>.Success { value: device } => run DumpTable.dump(
        &device,
        &mut path,
      )
      Result<DeviceOrVariationIndex<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None => run absent(&path)
  }
  DumpPath.pop(&mut path)
}
