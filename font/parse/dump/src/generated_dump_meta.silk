pub effect fn dumpMeta<'a>(path: &mut DumpPath, value: Meta<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    622142513,
    FontData.len(&Meta<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Meta<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Meta<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "flags")
    let fieldValue = Meta<'a>.flags(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved")
    let fieldValue = FontData<'a>.readAt<u32>(&base, Meta<'a>.reservedByteRange(&value).start)
      |> Result<u32, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "dataMapsCount")
    let fieldValue = Meta<'a>.dataMapsCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "dataMaps")
    let fieldValue = Meta<'a>.dataMaps(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), DataMapRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), DataMapRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), DataMapRecord<'a>>.get(&fieldValue, index) {
        Result<DataMapRecord<'a>, ReadError>.Success { value: item } => run dumpDataMapRecord(
          &mut path,
          item,
          base,
        )
        Result<DataMapRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpDataMapRecord<'a>(
  path: &mut DumpPath,
  value: DataMapRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "tag")
    let fieldValue = DataMapRecord<'a>.tag(&value)
    run scalar(&path, Tag.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "dataOffset")
    let fieldValue = DataMapRecord<'a>.dataOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "data")
    let targetArgs: [u64; 3] = [
      u32.toU64(Tag.toU32(DataMapRecord<'a>.tag(&value))),
      u32.toU64(DataMapRecord<'a>.dataLength(&value)),
      0,
    ]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = DataMapRecord<'a>.data(&value, base)
    match move resolved {
      Result<Metadata<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<Metadata<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "dataLength")
    let fieldValue = DataMapRecord<'a>.dataLength(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "meta")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1835365473)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1835365473) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Meta<'a>.read(data) {
          Result<Meta<'a>, ReadError>.Success { value: table } => run dumpMeta(&mut path, table)
          Result<Meta<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}

