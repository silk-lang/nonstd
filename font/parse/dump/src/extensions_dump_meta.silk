import silk.text.string { String }

pub effect fn dumpMetadata<'a>(path: &mut DumpPath, value: Metadata<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  match value {
    Metadata<'a>.Other { value: data } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Other")
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "bytes")
      run bytes(&path, data)
      DumpPath.pop(&mut path)
    }
    Metadata<'a>.ScriptLangTags { value: tags } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "ScriptLangTags")
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "tags")
      let mut iter = VarLenArray<'a, ScriptLangTag<'a>>.iter(&tags)
      let mut index: usize = 0
      while let Option<Result<ScriptLangTag<'a>, ReadError>>.Some { value: item } = move VarLenIter<
        'a,
        ScriptLangTag<'a>
      >.next(&mut iter) {
        DumpPath.setIndex(&mut path, index)
        match move item {
          Result<ScriptLangTag<'a>, ReadError>.Success { value: tag } => run bytes(
            &path,
            String.utf8Bytes(ScriptLangTag.asStr(&tag)),
          )
          Result<ScriptLangTag<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        index = index + 1
      }
      DumpPath.clearIndex(&mut path)
      DumpPath.push(&mut path, "length")
      run scalar(&path, index)
      DumpPath.pop(&mut path)
      DumpPath.pop(&mut path)
    }
  }
}
