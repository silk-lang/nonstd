pub effect fn dumpHdmx<'a>(path: &mut DumpPath, value: Hdmx<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    70949281,
    FontData.len(&Hdmx<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Hdmx<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Hdmx<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numRecords")
    let fieldValue = Hdmx<'a>.numRecords(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "sizeDeviceRecord")
    let fieldValue = Hdmx<'a>.sizeDeviceRecord(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "records")
    let fieldValue = Hdmx<'a>.records(&value)
    let targetArgs: [u64; 3] = [dumpArgs[0], u32.toU64(Hdmx<'a>.sizeDeviceRecord(&value)), 0]
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, ReadArgs2<u32, u32>, DeviceRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, ReadArgs2<u32, u32>, DeviceRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, targetArgs)
      match move ComputedArray<'a, ReadArgs2<u32, u32>, DeviceRecord<'a>>.get(&fieldValue, index) {
        Result<DeviceRecord<'a>, ReadError>.Success { value: item } => run dumpDeviceRecord(
          &mut path,
          move item,
          base,
        )
        Result<DeviceRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "hdmx")
    match move FontRef<'a>.hdmx(font) {
      Result<Hdmx<'a>, ReadError>.Success { value: table } => run dumpHdmx(&mut path, table)
      Result<Hdmx<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}

// Handwritten extension from font/parse/dump/src/extensions_dump_hdmx.silk
