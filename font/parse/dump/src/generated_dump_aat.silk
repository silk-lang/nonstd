    let resolved = StxHeader<'a>.entryTable(&value)
    match move resolved {
      Result<RawBytes<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<RawBytes<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpRawWords<'a>(path: &mut DumpPath, value: RawWords<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    4014253930,
    FontData.len(&RawWords<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = RawWords<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "data")
    let fieldValue = RawWords<'a>.data(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, u16>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, u16>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<u16>.Some { value: item } = move ScalarArray<'a, u16>.get(&fieldValue, index) {
        run scalar(&path, item)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {}

// Handwritten extension from font/parse/dump/src/extensions_dump_aat.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
pub effect fn dumpTypedLookup<'a, T>(path: &mut DumpPath, value: TypedLookup<'a, T>) -> ()
  ! WriterError
  ? &mut Writer {
  run dumpLookup(&mut path, value.lookup)
}
