import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "maxp")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1835104368)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1835104368) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Maxp<'a>.read(data) {
          Result<Maxp<'a>, ReadError>.Success { value: table } => run dumpMaxp(&mut path, table)
          Result<Maxp<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "MAXP")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1296128080)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1296128080) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move MaxpExtended<'a>.read(data) {
          Result<MaxpExtended<'a>, ReadError>.Success { value: table } => run dumpMaxpExtended(
            &mut path,
            table,
          )
          Result<MaxpExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
