pub effect fn dumpSvg<'a>(path: &mut DumpPath, value: Svg<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    1844419813,
    FontData.len(&Svg<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Svg<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Svg<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "svgDocumentListOffset")
    let fieldValue = Svg<'a>.svgDocumentListOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "svgDocumentList")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = Svg<'a>.svgDocumentList(&value)
    match move resolved {
      Result<SVGDocumentList<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<SVGDocumentList<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Svg<'a>.reservedByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpSVGDocumentList<'a>(path: &mut DumpPath, value: SVGDocumentList<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    4236786268,
    FontData.len(&SVGDocumentList<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = SVGDocumentList<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "numEntries")
    let fieldValue = SVGDocumentList<'a>.numEntries(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "documentRecords")
    let fieldValue = SVGDocumentList<'a>.documentRecords(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), SVGDocumentRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), SVGDocumentRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), SVGDocumentRecord<'a>>.get(&fieldValue, index) {
        Result<SVGDocumentRecord<'a>, ReadError>.Success {
          value: item
        } => run dumpSVGDocumentRecord(&mut path, item, base)
        Result<SVGDocumentRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpSVGDocumentRecord<'a>(
  path: &mut DumpPath,
  value: SVGDocumentRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "startGlyphId")
    let fieldValue = SVGDocumentRecord<'a>.startGlyphId(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "endGlyphId")
    let fieldValue = SVGDocumentRecord<'a>.endGlyphId(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "svgDocOffset")
    let fieldValue = SVGDocumentRecord<'a>.svgDocOffset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "svgDocLength")
    let fieldValue = SVGDocumentRecord<'a>.svgDocLength(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "SVG ")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1398163232)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1398163232) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Svg<'a>.read(data) {
          Result<Svg<'a>, ReadError>.Success { value: table } => run dumpSvg(&mut path, table)
          Result<Svg<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
