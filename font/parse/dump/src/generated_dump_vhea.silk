import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "vhea")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1986553185)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1986553185) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Vhea<'a>.read(data) {
          Result<Vhea<'a>, ReadError>.Success { value: table } => run dumpVhea(&mut path, table)
          Result<Vhea<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "VHEA")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1447576897)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1447576897) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move VheaExtended<'a>.read(data) {
          Result<VheaExtended<'a>, ReadError>.Success { value: table } => run dumpVheaExtended(
            &mut path,
            table,
          )
          Result<VheaExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
