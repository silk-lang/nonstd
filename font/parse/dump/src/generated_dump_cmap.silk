pub effect fn dumpUvsMapping24<'a>(
  path: &mut DumpPath,
  value: UvsMapping24<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "unicodeValue")
    let fieldValue = UvsMapping24<'a>.unicodeValue(&value)
    run scalar(&path, Uint24.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "glyphId")
    let fieldValue = UvsMapping24<'a>.glyphId(&value)
    run scalar(&path, Uint24.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
}

