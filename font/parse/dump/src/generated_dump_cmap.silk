pub effect fn dumpUnicodeRange<'a>(
  path: &mut DumpPath,
  value: UnicodeRange<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "startUnicodeValue")
    let fieldValue = UnicodeRange<'a>.startUnicodeValue(&value)
    run scalar(&path, Uint24.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "additionalCount")
    let fieldValue = UnicodeRange<'a>.additionalCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "cmap")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1668112752)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1668112752) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Cmap<'a>.read(data) {
          Result<Cmap<'a>, ReadError>.Success { value: table } => run dumpCmap(&mut path, table)
          Result<Cmap<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "DMAP")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1145913680)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1145913680) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Dmap<'a>.read(data) {
          Result<Dmap<'a>, ReadError>.Success { value: table } => run dumpDmap(&mut path, table)
          Result<Dmap<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
