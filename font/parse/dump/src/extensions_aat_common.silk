    DumpPath.setIndex(&mut path, u32.toUsize(gid))
    match move TypedLookup<'a, u32>.value(&value, u32.toU16(gid)) {
      Result<u32, ReadError>.Success { value: found } => run scalar(&path, found)
      Result<u32, ReadError>.Failure { error } => run readError(&path, error)
    }
    gid = gid + 1
  }
  DumpPath.setIndex(&mut path, 65535)
  match move TypedLookup<'a, u32>.value(&value, 65535) {
    Result<u32, ReadError>.Success { value: found } => run scalar(&path, found)
    Result<u32, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

pub effect fn dumpLegacyState<'a, T: FixedSize + FontRead<'a, ()> + StatePayload>(
  path: &mut DumpPath,
  value: StateTable<'a, T>,
  data: FontData<'a>,
  count: u32,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.beginTable(&mut path)
  DumpPath.push(&mut path, "header")
  match move StateHeader.read(data) {
    Result<StateHeader<'a>, ReadError>.Success {
      value: header
    } => run generated_dump_aat.dumpStateHeader(&mut path, header)
    Result<StateHeader<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "nClasses")
  run scalar(&path, value.nClasses)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "classes")
  let mut gid: u32 = 0
  let mut limit = count
  if limit > 65535 {
    limit = 65535
  }
  while gid <= limit {
    DumpPath.setIndex(&mut path, u32.toUsize(gid))
    match move StateTable<'a, T>.class(&value, GlyphId16.new(u32.toU16(gid))) {
      Result<u8, ReadError>.Success { value: found } => run scalar(&path, found)
      Result<u8, ReadError>.Failure { error } => run readError(&path, error)
    }
    gid = gid + 1
  }
  DumpPath.pop(&mut path)
  let states: [u16; 4] = [0, 1, 2, 65535]
  let classes: [u8; 6] = [0, 1, 2, 3, 255, 254]
  DumpPath.push(&mut path, "entries")
  let mut i: usize = 0
  while i < 4 {
    let mut j: usize = 0
    while j < 6 {
      DumpPath.setIndex(&mut path, i * 6 + j)
      match move StateTable<'a, T>.entry(&value, states[i], classes[j]) {
        Result<StateEntry<T>, ReadError>.Success { value: entry } => {
          DumpPath.push(&mut path, "newState")
          run scalar(&path, entry.newState)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "flags")
          run scalar(&path, entry.flags)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "payload")
          run StatePayload.dump(&entry.payload, &mut path)
          DumpPath.pop(&mut path)
        }
        Result<StateEntry<T>, ReadError>.Failure { error } => run readError(&path, error)
      }
      j = j + 1
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

pub effect fn dumpExtendedState<'a, T: FixedSize + FontRead<'a, ()> + StatePayload>(
  path: &mut DumpPath,
  value: ExtendedStateTable<'a, T>,
  data: FontData<'a>,
  count: u32,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.beginTable(&mut path)
  DumpPath.push(&mut path, "header")
  match move StxHeader.read(data) {
    Result<StxHeader<'a>, ReadError>.Success {
      value: header
    } => run generated_dump_aat.dumpStxHeader(&mut path, header)
    Result<StxHeader<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "nClasses")
  run scalar(&path, value.nClasses)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "classes")
  let mut gid: u32 = 0
  let mut limit = count
  if limit > 65535 {
    limit = 65535
  }
  while gid <= limit {
    DumpPath.setIndex(&mut path, u32.toUsize(gid))
    match move ExtendedStateTable<'a, T>.class(&value, GlyphId.new(gid)) {
      Result<u16, ReadError>.Success { value: found } => run scalar(&path, found)
      Result<u16, ReadError>.Failure { error } => run readError(&path, error)
    }
    gid = gid + 1
  }
  DumpPath.pop(&mut path)
  let states: [u16; 4] = [0, 1, 2, 65535]
  let classes: [u16; 6] = [0, 1, 2, 3, 255, 65535]
  DumpPath.push(&mut path, "entries")
  let mut i: usize = 0
  while i < 4 {
    let mut j: usize = 0
    while j < 6 {
      DumpPath.setIndex(&mut path, i * 6 + j)
      match move ExtendedStateTable<'a, T>.entry(&value, states[i], classes[j]) {
        Result<StateEntry<T>, ReadError>.Success { value: entry } => {
          DumpPath.push(&mut path, "newState")
          run scalar(&path, entry.newState)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "flags")
          run scalar(&path, entry.flags)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "payload")
          run StatePayload.dump(&entry.payload, &mut path)
          DumpPath.pop(&mut path)
        }
        Result<StateEntry<T>, ReadError>.Failure { error } => run readError(&path, error)
      }
      j = j + 1
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}
