import read_fonts.lib { FontData, ReadError, FontRead, ScalarArray }
import read_fonts.tables.aat {
  StateTable,
  ExtendedStateTable,
  StateEntry,
  StateHeader,
  StxHeader,
  NoPayload,
  TypedLookup
}
import read_fonts.tables.morx {
  ContextualEntryData as MorxContext,
  InsertionEntryData as MorxInsert
}
import read_fonts.tables.mort {
  ContextualEntryData as MortContext,
  InsertionEntryData as MortInsert
}
import font_types.lib { BigEndian, Scalar, FixedSize, GlyphId, GlyphId16 }
import dump_support { DumpPath, DumpValue, scalar, readError }
import generated_dump_aat
import silk.core.result { Result }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub interface StatePayload {
  effect fn dump(self: &Self, path: &mut DumpPath) -> () ! WriterError ? &mut Writer
}

impl StatePayload for NoPayload {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    run scalar(&path, "none")
  }
}

impl<T: Scalar + Copy + DumpValue> StatePayload for BigEndian<T> {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    run scalar(&path, BigEndian<T>.get(self))
  }
}

impl<'a> StatePayload for MorxContext<'a> {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    DumpPath.push(&mut path, "markIndex")
    run scalar(&path, MorxContext.markIndex(self))
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "currentIndex")
    run scalar(&path, MorxContext.currentIndex(self))
    DumpPath.pop(&mut path)
  }
}

impl<'a> StatePayload for MortContext<'a> {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    DumpPath.push(&mut path, "markOffset")
    run scalar(&path, MortContext.markOffset(self))
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "currentOffset")
    run scalar(&path, MortContext.currentOffset(self))
    DumpPath.pop(&mut path)
  }
}

impl<'a> StatePayload for MorxInsert<'a> {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    DumpPath.push(&mut path, "currentInsertIndex")
    run scalar(&path, MorxInsert.currentInsertIndex(self))
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "markedInsertIndex")
    run scalar(&path, MorxInsert.markedInsertIndex(self))
    DumpPath.pop(&mut path)
  }
}

impl<'a> StatePayload for MortInsert<'a> {
  effect fn dump(self: &Self, path: &mut DumpPath) -> ()
    ! WriterError
    ? &mut Writer {
    DumpPath.push(&mut path, "currentInsertIndex")
    run scalar(&path, MortInsert.currentInsertIndex(self))
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "markedInsertIndex")
    run scalar(&path, MortInsert.markedInsertIndex(self))
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpArray<'a, T: Scalar + Copy + DumpValue>(
  path: &mut DumpPath,
  values: ScalarArray<'a, T>,
) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "length")
  run scalar(&path, ScalarArray<T>.len(&values))
  DumpPath.pop(&mut path)
  let mut i: usize = 0
  while i < ScalarArray<T>.len(&values) {
    DumpPath.setIndex(&mut path, i)
    if let Option<T>.Some { value } = move ScalarArray<T>.get(&values, i) {
      run scalar(&path, move value)
    }
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
}

pub effect fn dumpGlyphs<'a>(path: &mut DumpPath, values: ScalarArray<'a, GlyphId16>) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "length")
  run scalar(&path, ScalarArray<GlyphId16>.len(&values))
  DumpPath.pop(&mut path)
  let mut i: usize = 0
  while i < ScalarArray<GlyphId16>.len(&values) {
    DumpPath.setIndex(&mut path, i)
    if let Option<GlyphId16>.Some { value } = move ScalarArray<GlyphId16>.get(&values, i) {
      run scalar(&path, GlyphId16.toU32(value))
    }
    i = i + 1
  }
  DumpPath.clearIndex(&mut path)
}

pub effect fn dumpLookupU16<'a>(path: &mut DumpPath, value: TypedLookup<'a, u16>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.beginTable(&mut path)
  run generated_dump_aat.dumpLookup(&mut path, value.lookup)
  DumpPath.push(&mut path, "values")
  let mut gid: u32 = 0
  let mut limit = count
  if limit > 65535 {
    limit = 65535
  }
  while gid <= limit {
    DumpPath.setIndex(&mut path, u32.toUsize(gid))
    match move TypedLookup<'a, u16>.value(&value, u32.toU16(gid)) {
      Result<u16, ReadError>.Success { value: found } => run scalar(&path, found)
      Result<u16, ReadError>.Failure { error } => run readError(&path, error)
    }
    gid = gid + 1
  }
  DumpPath.setIndex(&mut path, 65535)
  match move TypedLookup<'a, u16>.value(&value, 65535) {
    Result<u16, ReadError>.Success { value: found } => run scalar(&path, found)
    Result<u16, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

