// upstream model/metrics/glyph.rs::a_varc_composite_measures_by_what_it_draws
test effect fn aVarcCompositeMeasuresByWhatItDraws() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run varcBounds(Fixtures.varcCjkFont(), Expected.varcCjkDrawnBounds())
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn staticConditionalAndPrecisionVarcBounds() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run varcBounds(Fixtures.varcStaticFont(), Expected.varcStaticDrawnBounds())
    |> Effect.provideMut<Allocator>(&mut allocator)
  run varcBounds(Fixtures.varcConditionalsFont(), Expected.varcConditionalsDrawnBounds())
    |> Effect.provideMut<Allocator>(&mut allocator)
  run varcBounds(Fixtures.varcDeltaPrecisionFont(), Expected.varcPrecisionDrawnBounds())
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn varcBounds(bytes: &'static [u8], expectedBytes: &'static [u8]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(bytes))
  let base = metrics(&font, &[])
  let onlyBase = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.baseOutlines())
  let outlines = match VarcOutlines.read(&font) {
    Maybe<VarcOutlines<'static>>.Some { value } => value
    _ => {
      run Testing.expect(false, "VARC source exists")
      return
    }
  }
  let expectedData = FontData.new(expectedBytes)
  let mut gid: u32 = 0
  let mut count: usize = 0
  while gid < GlyphMetrics.numGlyphs(&base) {
    let glyph = GlyphId.new(gid)
    if VarcOutlines.covers(&outlines, glyph) {
      let at = u32.toUsize(gid) * 36
      run Testing.expect(
        (run must(FontData<'static>.readAt<u32>(&expectedData, at))) == gid,
        "reference glyph",
      )
      let e = GlyphExtents<F48Dot16> {
        xBearing: F48Dot16.fromBits(run must(FontData<'static>.readAt<i64>(&expectedData, at + 4))),
        yBearing: F48Dot16.fromBits(
          run must(FontData<'static>.readAt<i64>(&expectedData, at + 12)),
        ),
        width: F48Dot16.fromBits(run must(FontData<'static>.readAt<i64>(&expectedData, at + 20))),
        height: F48Dot16.fromBits(run must(FontData<'static>.readAt<i64>(&expectedData, at + 28))),
      }
      let actual = run some(run GlyphMetrics.extentsExact(&base, glyph))
      run Testing.expect(same(actual, e), "VARC control bounds match independent upstream drawing")
      count = count + 1
    } else {
      let actual = run GlyphMetrics.extentsExact(&base, glyph)
      let expected = run GlyphMetrics.extentsExact(&onlyBase, glyph)
      run Testing.expect(
        sameOptional(move actual, move expected),
        "uncovered glyph uses its base outline",
      )
    }
    gid = gid + 1
  }
  run Testing.expect(count > 0, "fixture covers composites")
}

fn sameOptional(a: Option<GlyphExtents<F48Dot16>>, b: Option<GlyphExtents<F48Dot16>>) -> bool {
  return match move a {
    Option<GlyphExtents<F48Dot16>>.Some { value: left } => match move b {
      Option<GlyphExtents<F48Dot16>>.Some { value: right } => same(left, right)
      _ => false
    }
    _ => none(move b)
  }
}

import model.charmap { Charmap }
import table_provider { TableProvider }
import tables.colr { Colr, ClipBox }
import tables.fvar { Fvar, UserCoordinate }
import tables.avar { Avar }
import font_types.lib { Tag, Fixed }

fn readExpectedAt<'a>(data: &FontData<'a>, at: usize) -> GlyphExtents<F48Dot16> {
  return GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.fromBits(
      FontData<'a>.readAt<i64>(data, at + 4) |> Result<i64, ReadError>.unwrapOr(0),
    ),
    yBearing: F48Dot16.fromBits(
      FontData<'a>.readAt<i64>(data, at + 12) |> Result<i64, ReadError>.unwrapOr(0),
    ),
    width: F48Dot16.fromBits(
      FontData<'a>.readAt<i64>(data, at + 20) |> Result<i64, ReadError>.unwrapOr(0),
    ),
    height: F48Dot16.fromBits(
      FontData<'a>.readAt<i64>(data, at + 28) |> Result<i64, ReadError>.unwrapOr(0),
    ),
  }
}

effect fn colorExpected(bytes: &'static [u8], glyph: GlyphId) -> GlyphExtents<F48Dot16>
  ! AssertionError<'static> {
  let data = FontData.new(bytes)
  let mut at: usize = 0
  while at < bytes.length {
    let gid = run must(FontData<'static>.readAt<u32>(&data, at))
    if gid == GlyphId.toU32(glyph) {
      return readExpectedAt(&data, at)
    }
    at = at + 36
  }
  run Testing.expect(false, "reference color glyph exists")
  return Intrinsic.trap("assertion")
}

effect fn mapped(font: &FontRef, ch: u32) -> GlyphId
  ! AssertionError<'static> {
  return run some(Charmap.mapUnicode(&Charmap.new(font), ch))
}

test effect fn aColorGlyphMeasuresByItsClipBoxOrItsPaint() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run colorClipAndPaint() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn colorClipAndPaint() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(Fixtures.variableColrFont()))
  let base = metrics(&font, &[])
  let clipped = run mapped(&font, 986112)
  let painted = run mapped(&font, 986624)
  let colr = run must(TableProvider.colr(&font))
  run Testing.expect(
    !none(Colr.v1ClipBox(&colr, clipped)) && none(Colr.v1ClipBox(&colr, painted)),
    "clipped and unclipped test glyphs",
  )
  let clip = run some(run GlyphMetrics.extentsExact(&base, clipped))
  run Testing.expect(
    same(clip, run colorExpected(Expected.colorVariableDrawnBounds(), clipped)),
    "clip measures color glyph",
  )
  let layers = run some(run GlyphMetrics.extentsExact(&base, painted))
  run Testing.expect(
    same(layers, run colorExpected(Expected.colorVariableDrawnBounds(), painted)),
    "paint measures color glyph",
  )
  let outlines = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.outlines())
  run Testing.expect(
    !sameOptional(
      run GlyphMetrics.extentsExact(&outlines, clipped),
      Option<GlyphExtents<F48Dot16>>.some(clip),
    ),
    "base outline differs from color clip",
  )
  run Testing.expect(
    sameOptional(
      run GlyphMetrics.extentsExact(&base, GlyphId.new(1)),
      run GlyphMetrics.extentsExact(&outlines, GlyphId.new(1)),
    ),
    "plain glyph falls through",
  )
}

test effect fn aColorOnlyOrderKeepsTheClips() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run compareColor(Fixtures.variableColrFont(), Expected.colorVariableDrawnBounds(), &[], true)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn aVersion0ColorGlyphMeasuresByItsLayers() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run colorV0() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn colorV0() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(Fixtures.colrV0Font()))
  let base = metrics(&font, &[])
  let outlines = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.outlines())
  let glyph = run mapped(&font, 986624)
  run Testing.expect(Colr.version(&run must(TableProvider.colr(&font))) == 0, "actual v0 table")
  let layers = run colorExpected(Expected.colorV0DrawnBounds(), glyph)
  run Testing.expect(
    same(run some(run GlyphMetrics.extentsExact(&base, glyph)), layers),
    "v0 layers determine bounds",
  )
  run Testing.expect(
    !sameOptional(
      run GlyphMetrics.extentsExact(&outlines, glyph),
      Option<GlyphExtents<F48Dot16>>.some(layers),
    ),
    "v0 differs from empty base",
  )
  run Testing.expect(
    sameOptional(
      run GlyphMetrics.extentsExact(&base, GlyphId.new(1)),
      run GlyphMetrics.extentsExact(&outlines, GlyphId.new(1)),
    ),
    "v0 plain fallback",
  )
}

test effect fn aColorGlyphAtALocationMovesItsClipBox() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run movedColorClip() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn movedColorClip() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(Fixtures.variableColrFont()))
  let fvar = run must(TableProvider.fvar(&font))
  let mut coords = [F2Dot14.zero(); 64]
  let user = [UserCoordinate { tag: Tag.fromU32(1129076809), value: Fixed.fromI32(200) }]
  run Fvar.userToNormalized(&fvar, Option<Avar<'static>>.None, &user, &mut coords)
  let glyph = run mapped(&font, 986112)
  let base = metrics(&font, &[])
  let moved = metrics(&font, &coords)
  let original = run some(run GlyphMetrics.extentsExact(&base, glyph))
  let changed = run some(run GlyphMetrics.extentsExact(&moved, glyph))
  run Testing.expect(&original.xBearing != &changed.xBearing, "location moves clip")
  run Testing.expect(
    same(changed, run colorExpected(Expected.colorMovedDrawnBounds(), glyph)),
    "clip deltas round before extents",
  )
}

test effect fn colorModelMatchesAllIndependentPaintFixtures() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run colorFixtureSet() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn colorFixtureSet() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run compareColor(Fixtures.colrFont(), Expected.colorStaticDrawnBounds(), &[], false)
  run compareColor(
    Fixtures.variableColrFont(),
    Expected.colorHalfDrawnBounds(),
    &[F2Dot14.fromF32(0.5); 64],
    false,
  )
  run compareColor(Fixtures.colrV0Font(), Expected.colorV0DrawnBounds(), &[], false)
  run compareColor(Fixtures.unclippedColrFont(), Expected.colorNoClipDrawnBounds(), &[], false)
  run compareColor(Fixtures.gradientFont(), Expected.colorGradientDrawnBounds(), &[], false)
}

effect fn compareColor(
  bytes: &'static [u8],
  expected: &'static [u8],
  coords: &[F2Dot14],
  colorOnly: bool,
) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(bytes))
  let mut base = metrics(&font, coords)
  if colorOnly {
    base = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.color())
  }
  let data = FontData.new(expected)
  let mut at: usize = 0
  let mut tested: usize = 0
  while at < expected.length {
    let glyph = GlyphId.new(run must(FontData<'static>.readAt<u32>(&data, at)))
    let wanted = readExpectedAt(&data, at)
    let actual = run some(run GlyphMetrics.extentsExact(&base, glyph))
    run Testing.expect(same(actual, wanted), "color extents match upstream paint/clip bounds")
    at = at + 36
    tested = tested + 1
  }
  run Testing.expect(tested > 0, "color glyphs measured")
}

import silk.collections.list { List }
import model.metrics { IdentityConverter }
import model.glyph { GlyphSource }
import generated_cff_fixtures as CffFixtures
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.pointer { Pointer }

fn equalOptional(a: &Option<GlyphExtents<F48Dot16>>, b: &Option<GlyphExtents<F48Dot16>>) -> bool {
  return match &a.* {
    Option<GlyphExtents<F48Dot16>>.Some { value: left } => match &b.* {
      Option<GlyphExtents<F48Dot16>>.Some { value: right } => same(left, right)
      _ => false
    }
    _ => match &b.* {
      Option<GlyphExtents<F48Dot16>>.None => true
      _ => false
    }
  }
}

test effect fn mixedSourcesMeasureARunAsTheyMeasureOne() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mixedSourceBatches() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn mixedSourceBatches() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [Fixtures.cbdtFont(), Fixtures.variableColrFont(), Fixtures.varcCjkFont()]
  let mut f: usize = 0
  while f < 3 {
    let font = run must(FontRef.new(fonts[f]))
    let base = metrics(&font, &[])
    let mut glyphs = List<GlyphId>.make()
    let mut outputs = List<Option<GlyphExtents<F48Dot16>>>.make()
    let mut gid: u32 = 0
    while gid < GlyphMetrics.numGlyphs(&base) {
      run List<GlyphId>.append(&mut glyphs, GlyphId.new(gid))
      run List<Option<GlyphExtents<F48Dot16>>>.append(
        &mut outputs,
        Option<GlyphExtents<F48Dot16>>.None,
      )
      gid = gid + 1
    }
    run GlyphMetrics.extentsBatched(
      &base,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&glyphs),
      List<Option<GlyphExtents<F48Dot16>>>.asMutSlice(&mut outputs),
    )
    let results = List<Option<GlyphExtents<F48Dot16>>>.asSlice(&outputs)
    gid = 0
    while gid < GlyphMetrics.numGlyphs(&base) {
      let direct = run GlyphMetrics.extentsExact(&base, GlyphId.new(gid))
      run Testing.expect(
        equalOptional(&results[u32.toUsize(gid)], &direct),
        "mixed source batch agrees per glyph",
      )
      gid = gid + 1
    }
    f = f + 1
  }
}

// This port has one source-dispatch path. Independent Rust expectations exercise
// the upstream shortcut/general-path test's fonts, orders and out-of-range glyph.
test effect fn theBaseOutlineShortcutMatchesEverySource() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sourceOrders() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceOrders() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [
    Expected.tinos(),
    CffFixtures.notoSerifFont(),
    Fixtures.cbdtFont(),
    Fixtures.variableColrFont(),
    Fixtures.varcCjkFont(),
    CffFixtures.cantarellFont(),
    CffFixtures.cantarellFont(),
  ]
  let references = [
    Expected.ordersTinosDrawnBounds(),
    Expected.ordersCffDrawnBounds(),
    Expected.ordersCbdtDrawnBounds(),
    Expected.ordersColrDrawnBounds(),
    Expected.ordersVarcDrawnBounds(),
    Expected.ordersCantarellDrawnBounds(),
    Expected.ordersCantarell650DrawnBounds(),
  ]
  let orders = [
    GlyphSourceOrder.default(),
    GlyphSourceOrder.outlines(),
    GlyphSourceOrder.baseOutlines(),
    GlyphSourceOrder.bitmaps(),
    GlyphSourceOrder.color(),
    GlyphSourceOrder.new(&[GlyphSource.Cff, GlyphSource.Glyf, GlyphSource.Colr]),
    GlyphSourceOrder.empty(),
  ]
  let mut f: usize = 0
  while f < 7 {
    let font = run must(FontRef.new(fonts[f]))
    let mut coords = [F2Dot14.zero(); 64]
    if f == 6 {
      let fvar = run must(TableProvider.fvar(&font))
      let mut avar = Option<Avar<'static>>.None
      if let Result<Avar<'static>, ReadError>.Success { value } = TableProvider.avar(&font) {
        avar = Option<Avar<'static>>.some(value)
      }
      run Fvar.userToNormalized(
        &fvar,
        move avar,
        &[UserCoordinate { tag: Tag.fromU32(2003265652), value: Fixed.fromI32(650) }],
        &mut coords,
      )
    }
    let base = metrics(&font, &coords)
    let data = FontData.new(references[f])
    let mut at: usize = 0
    while at < references[f].length {
      let order = run must(FontData<'static>.readAt<u16>(&data, at))
      let present = run must(FontData<'static>.readAt<u16>(&data, at + 2))
      let glyph = GlyphId.new(run must(FontData<'static>.readAt<u32>(&data, at + 4)))
      let selected = GlyphMetrics.withExtentsSourceOrder(base, orders[u16.toUsize(order)])
      let actual = run GlyphMetrics.extentsExact(&selected, glyph)
      if present == 0 {
        run Testing.expect(none(move actual), "reference order has no source for glyph")
      } else {
        run Testing.expect(
          same(run some(move actual), readExpectedAt(&data, at + 4)),
          "all source orders match upstream",
        )
      }
      at = at + 40
    }
    f = f + 1
  }
}

import silk.num.u16

struct SourceProbe<'a> {
  font: FontRef<'a>,
  calls: *mut u32,
}

impl<'a> TableProvider<'a> for SourceProbe<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    let old = unsafe Atomic.fetchAdd<u32>(self.calls, 1, MemoryOrder.Relaxed)
    drop old
    return FontRef.tableData(&self.font, tag)
  }
}

fn probeMetrics<'a, 'c>(provider: &SourceProbe<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(provider, coords)
}

// Eager metric snapshots capture views at construction; subsequent source-order
// queries neither recall providers nor accidentally measure excluded sources.
test effect fn anOutlineOrderProbesNoOtherTables() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run outlineSourceProbe() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn outlineSourceProbe() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut calls: u32 = 0
  let counter = Pointer.fromMutRef(&mut calls)
  let provider = SourceProbe { font: run must(FontRef.new(Fixtures.cbdtFont())), calls: counter }
  let base = probeMetrics(&provider, &[])
  let captured = unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed)
  let outlines = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.baseOutlines())
  run Testing.expect(
    none(run GlyphMetrics.extentsExact(&outlines, GlyphId.new(2))),
    "outline order excludes bitmaps",
  )
  run Testing.expect(
    !none(run GlyphMetrics.extentsExact(&base, GlyphId.new(2))),
    "default order uses captured bitmap",
  )
  run Testing.expect(
    captured > 0 && unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed) == captured,
    "queries perform no provider reads",
  )
}

// Regression: the mixed path checks maxp while a sole bitmap source does not.
struct BoundarySources<'a> {
  base: FontRef<'a>,
  bitmap: FontRef<'a>,
}

impl<'a> TableProvider<'a> for BoundarySources<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    let value = Tag.toU32(tag)
    if value == 1835104368 {
      return Option<FontData<'a>>.some(FontData.new(b"\x00\x00\x50\x00\x00\x02"))
    }
    if value == 1128416340 || value == 1128418371 {
      return FontRef.tableData(&self.bitmap, tag)
    }
    return FontRef.tableData(&self.base, tag)
  }
}

test effect fn mixedSourcesRejectOutOfRangeButOneBitmapCanAnswer() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mixedBoundary() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn mixedBoundary() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let provider = BoundarySources {
    base: run must(FontRef.new(Expected.tinos())),
    bitmap: run must(FontRef.new(Fixtures.cbdtFont())),
  }
  let coords: [F2Dot14; 0] = []
  let mixed = GlyphMetrics.new(&provider, &coords)
  let glyph = GlyphId.new(2)
  run Testing.expect(GlyphMetrics.numGlyphs(&mixed) == 2, "declared glyph boundary")
  run Testing.expect(
    none(run GlyphMetrics.extentsExact(&mixed, glyph)),
    "multiple sources reject the boundary ID",
  )
  let bitmap = GlyphMetrics.withExtentsSourceOrder(mixed, GlyphSourceOrder.bitmaps())
  run Testing.expect(
    !none(run GlyphMetrics.extentsExact(&bitmap, glyph)),
    "one bitmap source retains upstream boundary behavior",
  )
}

struct ShortLoca<'a> {
  font: FontRef<'a>,
}

impl<'a> TableProvider<'a> for ShortLoca<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    if Tag.toU32(tag) == 1819239265 {
      return Option<FontData<'a>>.some(FontData.new(b"\x00\x00"))
    }
    return FontRef.tableData(&self.font, tag)
  }
}

test effect fn aMissingGlyphInTheSelectedBaseFallsThroughToColor() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run missingBaseColor() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn missingBaseColor() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let provider = ShortLoca { font: run must(FontRef.new(Fixtures.variableColrFont())) }
  let coords: [F2Dot14; 0] = []
  let base = GlyphMetrics.new(&provider, &coords)
  let glyph = run mapped(&provider.font, 986112)
  let outlines = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.baseOutlines())
  run Testing.expect(
    none(run GlyphMetrics.extentsExact(&outlines, glyph)),
    "short loca has no glyph",
  )
  let fallback = GlyphMetrics.withExtentsSourceOrder(
    base,
    GlyphSourceOrder.new(&[GlyphSource.Glyf, GlyphSource.Colr]),
  )
  run Testing.expect(
    same(
      run some(run GlyphMetrics.extentsExact(&fallback, glyph)),
      run colorExpected(Expected.colorVariableDrawnBounds(), glyph),
    ),
    "color clip answers after the chosen base fails",
  )
}

// Independent Rust dumps of these reduced fonts preserve the valid small layer
// when another layer fails after emitting points. Two cubic controls are valid.
test effect fn aMalformedCubicColorLayerDiscardsItsPartialClip() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cubicColorClips() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cubicColorClips() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [Fixtures.colrInvalidCubicFont(), Fixtures.colrValidCubicFont()]
  let top: [i64; 2] = [5242880, 262144000]
  let width: [i64; 2] = [2621440, 131072000]
  let height: [i64; 2] = [3932160, 260833280]
  let mut i: usize = 0
  while i < 2 {
    let font = run must(FontRef.new(fonts[i]))
    let base = metrics(&font, &[])
    let wanted = GlyphExtents<F48Dot16> {
      xBearing: F48Dot16.zero(),
      yBearing: F48Dot16.fromBits(top[i]),
      width: F48Dot16.fromBits(width[i]),
      height: F48Dot16.fromBits(height[i]),
    }
    run Testing.expect(
      same(run some(run GlyphMetrics.extentsExact(&base, GlyphId.new(0))), wanted),
      "invalid partial clip is discarded and valid cubic clip is retained",
    )
    let color = GlyphMetrics.withExtentsSourceOrder(base, GlyphSourceOrder.color())
    run Testing.expect(
      same(run some(run GlyphMetrics.extentsExact(&color, GlyphId.new(0))), wanted),
      "color-only source keeps the same drawing validation",
    )
    i = i + 1
  }
}
