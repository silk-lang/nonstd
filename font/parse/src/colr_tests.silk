import lib { FontData, ReadError }
import tables.colr { Colr, Paint, PaintGlyph2, PaintSolid, PaintWithId, ColorLayer }
import font_types.lib { GlyphId, GlyphId16, GlyphId24, Offset24, F2Dot14 }
import test_font_builder as Builder
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn present<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn none<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

fn failed<T>(result: Result<T, ReadError>) -> bool {
  return match move result {
    Result<T, ReadError>.Failure { error } => true
    _ => false
  }
}

test effect fn paintGlyph2ReadsFullGlyphId() -> ()
  ! AssertionError<'static> {
  let glyphs: [u32; 5] = [0, 65535, 65536, 1193046, 16777215]
  let mut index: usize = 0
  while index < glyphs.length {
    let gid = glyphs[index]
    let mut data: [u8; 12] = [33, 0, 0, 7, 0, 0, 0, 2, 0, 7, 64, 0]
    data[4] = u32.toU8(u32.shiftRight(gid, 16))
    data[5] = u32.toU8(u32.shiftRight(gid, 8) & 255)
    data[6] = u32.toU8(gid & 255)
    let paint = run must(Paint.read(FontData.new(&data)))
    run Testing.expect(Paint.format(&paint) == 33, "shared paint-format accessor")
    match paint {
      Paint.Glyph2 { value } => {
        run Testing.expect(
          GlyphId24.toU32(PaintGlyph2.glyphId(&value)) == gid
            && Offset24.toU32(PaintGlyph2.paintOffset(&value)) == 7,
          "full glyph identifier and child offset",
        )
        let child = run must(PaintGlyph2.paint(&value))
        match child {
          Paint.Solid { value: solid } => {
            run Testing.expect(
              PaintSolid.paletteIndex(&solid) == 7
                && F2Dot14.toBits(PaintSolid.alpha(&solid)) == 16384,
              "solid paint child",
            )
          }
          _ => {
            run Testing.expect(false, "solid child")
          }
        }
      }
      _ => {
        run Testing.expect(false, "extended glyph paint")
      }
    }
    index = index + 1
  }
}

test effect fn paintGlyph2RejectsTruncatedHeaderAndChild() -> ()
  ! AssertionError<'static> {
  let data = b"\x21\x00\x00\x07\x01\x23\x45\x02\x00\x07\x40\x00"
  let mut length: usize = 0
  while length < data.length {
    let parsed = Paint.read(FontData.new(Slice.view<u8>(data, 0, length)))
    if length < 7 {
      run Testing.expect(failed(move parsed), "truncated extended glyph header")
    } else {
      let paint = run must(move parsed)
      match paint {
        Paint.Glyph2 { value } => {
          run Testing.expect(failed(PaintGlyph2.paint(&value)), "truncated paint child")
        }
        _ => {
          run Testing.expect(false, "extended glyph paint")
        }
      }
    }
    length = length + 1
  }
}

test effect fn paletteLayersKeepTheirRangeAndIdentifiers() -> ()
  ! AssertionError<'static> {
  let data = b"\x00\x00\x00\x01\x00\x00\x00\x0e\x00\x00\x00\x14\x00\x02\x00\x07\x00\x00\x00\x02\x00\x08\x00\x03\x00\x09\x00\x04"
  let colr = run must(Colr.read(FontData.new(data)))
  let range = run present(Colr.v0BaseGlyph(&colr, GlyphId.new(7)))
  run Testing.expect(range.start == 0 && range.end == 2, "layer range")
  let first = run present(Colr.v0Layer(&colr, 0))
  let second = run present(Colr.v0Layer(&colr, 1))
  run Testing.expect(
    GlyphId16.toU32(first.glyphId) == 8 && first.paletteIndex == 3
      && GlyphId16.toU32(second.glyphId) == 9
      && second.paletteIndex == 4,
    "layer glyphs and palette indices",
  )
  run Testing.expect(
    none(Colr.v0Layer(&colr, 2)) && none(Colr.v0BaseGlyph(&colr, GlyphId.new(65543)))
      && none(Colr.v1BaseGlyph(&colr, GlyphId.new(7))),
    "absent layers, wide IDs and v1 data",
  )
}

test effect fn paintIdentityMatchesAcrossBothLists() -> ()
  ! AssertionError<'static> {
  let mut data: [u8; 57] = [0; 57]
  Builder.put16(&mut data, 0, 1)
  Builder.put32(&mut data, 14, 34)
  Builder.put32(&mut data, 18, 44)
  Builder.put32(&mut data, 34, 1)
  Builder.put16(&mut data, 38, 7)
  Builder.put32(&mut data, 40, 18)
  Builder.put32(&mut data, 44, 1)
  Builder.put32(&mut data, 48, 8)
  data[52] = 2
  Builder.put16(&mut data, 53, 7)
  Builder.put16(&mut data, 55, 16384)
  let colr = run must(Colr.read(FontData.new(&data)))
  let glyph = run present(Colr.v1BaseGlyph(&colr, GlyphId.new(7)))
  let layer = run present(Colr.v1Layer(&colr, 0))
  run Testing.expect(
    glyph.id == layer.id && glyph.id == 52,
    "shared paint identity across offset bases",
  )
  run Testing.expect(
    none(Colr.v1Layer(&colr, 1)) && none(Colr.v1BaseGlyph(&colr, GlyphId.new(65543)))
      && none(Colr.v1ClipBox(&colr, GlyphId.new(7))),
    "missing layer, wide glyph and clip list",
  )
}
