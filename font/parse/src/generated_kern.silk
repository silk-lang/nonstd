        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let firstGlyphValue = scalarOr<GlyphId16>(data, ranges[0].start, GlyphId16.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let nGlyphsValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(nGlyphsValue), 2))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// First glyph in class range.
  pub fn firstGlyph(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, self._fieldRanges[0].start) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  pub fn firstGlyphByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of glyph in class range.
  pub fn nGlyphs(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn nGlyphsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The offsets array for all of the glyphs in the range.
  pub fn offsets(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn offsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for Subtable2ClassTable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Subtable2ClassTable<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for Subtable2ClassTable<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// The type 3 'kern' subtable.
pub struct Subtable3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 9],
}

impl<'a> Copy for Subtable3<'a> {}

impl<'a> Subtable3<'a> {
  pub fn default() -> Self {
    return Subtable3<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 9] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 9] = [ByteRange { start: 0, end: 0 }; 9]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[1].end = end
    let kernValueCountValue = scalarOr<u8>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[2].end = end
    let leftClassCountValue = scalarOr<u8>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[3].end = end
    let rightClassCountValue = scalarOr<u8>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[4].end = end
    let flagsValue = scalarOr<u8>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u8.toUsize(kernValueCountValue), 2))
    ranges[5].end = end
    ranges[6].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 1))
    ranges[6].end = end
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 1))
    ranges[7].end = end
    ranges[8].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        usize.saturatingMultiply(
          usize.saturatingAdd(u8.toUsize(leftClassCountValue), 0),
          u8.toUsize(rightClassCountValue),
        ),
        1,
      ),
    )
    ranges[8].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// The number of glyphs in this font.
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// The number of kerning values.
  pub fn kernValueCount(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[1].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn kernValueCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The number of left-hand classes.
  pub fn leftClassCount(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[2].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn leftClassCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// The number of right-hand classes.
  pub fn rightClassCount(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[3].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn rightClassCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Set to zero (reserved for future use).
  pub fn flags(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[4].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn flagsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// The kerning values.
  pub fn kernValue(self: &Self) -> ScalarArray<'a, i16> {
    return match move FontData<'a>.readArray<i16>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => ScalarArray<i16>.empty()
    }
  }

  pub fn kernValueByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// The left-hand classes.
  pub fn leftClass(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn leftClassByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// The right-hand classes.
  pub fn rightClass(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn rightClassByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }

  /// The indices into the kernValue array.
  pub fn kernIndex(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[8].start,
      self._fieldRanges[8].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn kernIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[8]
  }
}

impl<'a> FontRead<'a, ()> for Subtable3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Subtable3<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for Subtable3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[8].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[8].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/kern_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import generated_aat { StateTable, NoPayload }
import generated_kerx { pairKerning }

pub union Kern<'a> {
  Ot { pub value: OtKern<'a> },
  Aat { pub value: AatKern<'a> },
}

impl<'a> Copy for Kern<'a> {}

impl<'a> Kern<'a> {
  pub fn tag() -> Tag {
    return Tag.fromU32(1801810542)
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let version = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    if version == 0 {
      let value = match move OtKern.read(data) {
        Result<OtKern<'a>, ReadError>.Success { value } => value
        Result<OtKern<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(Kern<'a>.Ot { value: value })
    }
    if true {
      let value = match move AatKern.read(data) {
        Result<AatKern<'a>, ReadError>.Success { value } => value
        Result<AatKern<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(Kern<'a>.Aat { value: value })
    }
    return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
  }

  pub fn subtables(self: &Self) -> Subtables<'a> {
    return match &self.* {
      Kern<'a>.Ot { value } => Subtables<'a> {
        data: ScalarArray<u8>.offsetData(&OtKern.subtableData(&value)),
        isAat: false,
        nTables: u16.toU32(OtKern.nTables(&value)),
      }
      Kern<'a>.Aat { value } => Subtables<'a> {
        data: ScalarArray<u8>.offsetData(&AatKern.subtableData(&value)),
        isAat: true,
        nTables: AatKern.nTables(&value),
      }
    }
  }
}

impl<'a> FontRead<'a, ()> for Kern<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Kern.read(data)
  }
}

impl<'a> TopLevelTable for Kern<'a> {
  fn tag() -> Tag {
    return Kern.tag()
  }
}

pub struct Subtables<'a> {
  data: FontData<'a>,
  isAat: bool,
  nTables: u32,
}

impl<'a> Copy for Subtables<'a> {}

impl<'a> Subtables<'a> {
  pub fn next(self: &mut Self) -> Option<Result<Subtable<'a>, ReadError>> {
    if self.nTables == 0 || FontData.len(&self.data) == 0 {
      return Option<Result<Subtable<'a>, ReadError>>.None
    }
    self.nTables = self.nTables - 1
    let mut length = FontData.len(&self.data)
    if self.isAat {
      length = match move FontData<'a>.readAt<u32>(&self.data, 0) {
        Result<u32, ReadError>.Success { value } => u32.toUsize(value)
        _ => {
          return Option<Result<Subtable<'a>, ReadError>>.None
        }
      }
    } else if self.nTables != 0 {
      length = match move FontData<'a>.readAt<u16>(&self.data, 2) {
        Result<u16, ReadError>.Success { value } => u16.toUsize(value)
        _ => {
          return Option<Result<Subtable<'a>, ReadError>>.None
        }
      }
    }
    if length == 0 {
      return Option<Result<Subtable<'a>, ReadError>>.None
    }
    let data = match move FontData.takeUpTo(&mut self.data, length) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<Result<Subtable<'a>, ReadError>>.None
      }
    }
    return Option<Result<Subtable<'a>, ReadError>>.some(Subtable<'a>.readWithArgs(data, self.isAat))
  }
}

impl<'a> OtSubtable<'a> {
  pub fn headerLen() -> usize {
    return 6
  }
}

impl<'a> AatSubtable<'a> {
  pub fn headerLen() -> usize {
    return 8
  }
}

pub union Subtable<'a> {
  Ot { pub value: OtSubtable<'a> },
  Aat { pub value: AatSubtable<'a> },
}

impl<'a> Copy for Subtable<'a> {}

impl<'a> Subtable<'a> {
  pub fn readWithArgs(data: FontData<'a>, isAat: bool) -> Result<Self, ReadError> {
    if isAat {
      let value = match move AatSubtable.read(data) {
        Result<AatSubtable<'a>, ReadError>.Success { value } => value
        Result<AatSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(Subtable<'a>.Aat { value: value })
    }
    if true {
      let value = match move OtSubtable.read(data) {
        Result<OtSubtable<'a>, ReadError>.Success { value } => value
        Result<OtSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(Subtable<'a>.Ot { value: value })
    }
    return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
  }

  pub fn isVertical(self: &Self) -> bool {
    return match &self.* {
      Subtable<'a>.Ot { value } => OtSubtable.coverage(&value) & 1 == 0
      Subtable<'a>.Aat { value } => AatSubtable.coverage(&value) & 32768 != 0
    }
  }

  pub fn isHorizontal(self: &Self) -> bool {
    return !Subtable.isVertical(self)
  }

  pub fn isCrossStream(self: &Self) -> bool {
    return match &self.* {
      Subtable<'a>.Ot { value } => OtSubtable.coverage(&value) & 4 != 0
      Subtable<'a>.Aat { value } => AatSubtable.coverage(&value) & 16384 != 0
    }
  }

  pub fn isVariable(self: &Self) -> bool {
    return match &self.* {
      Subtable<'a>.Ot { value } => false
      Subtable<'a>.Aat { value } => AatSubtable.coverage(&value) & 8192 != 0
    }
  }

  pub fn isStateMachine(self: &Self) -> bool {
    return match &self.* {
      Subtable<'a>.Ot { value } => u16.shiftRight(OtSubtable.coverage(&value), 8) == 1
      Subtable<'a>.Aat { value } => AatSubtable.coverage(&value) & 255 == 1
    }
  }

  pub fn kind(self: &Self) -> Result<SubtableKind<'a>, ReadError> {
    return match &self.* {
      Subtable<'a>.Ot { value } => SubtableKind<'a>.readWithArgs(
        ScalarArray<u8>.offsetData(&OtSubtable.data(&value)),
        ReadArgs2<u8, bool> {
          first: u16.toU8(u16.shiftRight(OtSubtable.coverage(&value), 8)),
          second: false,
        },
      )
      Subtable<'a>.Aat { value } => SubtableKind<'a>.readWithArgs(
        ScalarArray<u8>.offsetData(&AatSubtable.data(&value)),
        ReadArgs2<u8, bool> { first: u16.toU8(AatSubtable.coverage(&value) & 255), second: true },
      )
    }
  }
}

impl<'a> FontRead<'a, bool> for Subtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: bool) -> Result<Self, ReadError> {
    return Subtable<'a>.readWithArgs(data, args)
  }
}

pub union SubtableKind<'a> {
  Format0 { pub value: Subtable0<'a> },
  Format1 { pub value: StateTable<'a, NoPayload> },
  Format2 { pub value: Subtable2<'a> },
  Format3 { pub value: Subtable3<'a> },
}

impl<'a> Copy for SubtableKind<'a> {}

impl<'a> SubtableKind<'a> {
  pub fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u8, bool>) -> Result<Self, ReadError> {
    let mut headerLen: usize = 6
    if args.second {
      headerLen = 8
    }
    if args.first == 0 {
      let value = match move Subtable0<'a>.read(data) {
        Result<Subtable0<'a>, ReadError>.Success { value } => value
        Result<Subtable0<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format0 { value: value })
    }
    if args.first == 1 {
      let value = match move StateTable<'a, NoPayload>.read(data) {
        Result<StateTable<'a, NoPayload>, ReadError>.Success { value } => value
        Result<StateTable<'a, NoPayload>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format1 { value: value })
    }
    if args.first == 2 {
      let value = match move Subtable2<'a>.readWithArgs(data, headerLen) {
        Result<Subtable2<'a>, ReadError>.Success { value } => value
        Result<Subtable2<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format2 { value: value })
    }
    if args.first == 3 {
      let value = match move Subtable3<'a>.read(data) {
        Result<Subtable3<'a>, ReadError>.Success { value } => value
        Result<Subtable3<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format3 { value: value })
    }
    return Result<Self, ReadError>.failResult(
      ReadError.InvalidFormat { value: u8.toI64(args.first) },
    )
  }
}

impl<'a> FontRead<'a, ReadArgs2<u8, bool>> for SubtableKind<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u8, bool>) -> Result<Self, ReadError> {
    return SubtableKind<'a>.readWithArgs(data, args)
  }
}

impl<'a> Subtable0<'a> {
  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    return pairKerning(Subtable0.pairs(self), left, right)
  }
}

pub struct Subtable2<'a> {
  pub data: FontData<'a>,
  pub headerLen: usize,
  pub leftOffsetTable: Subtable2ClassTable<'a>,
  pub rightOffsetTable: Subtable2ClassTable<'a>,
  pub arrayOffset: usize,
}

impl<'a> Copy for Subtable2<'a> {}

impl<'a> Subtable2<'a> {
  pub fn readWithArgs(data: FontData<'a>, headerLen: usize) -> Result<Self, ReadError> {
    let leftRaw = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 2) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let leftOffset = match move usize.checkedSubtract(leftRaw, headerLen) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let rightRaw = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 4) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let rightOffset = match move usize.checkedSubtract(rightRaw, headerLen) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let arrayRaw = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 6) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let arrayOffset = match move usize.checkedSubtract(arrayRaw, headerLen) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let leftData = match move FontData.splitOff(&data, leftOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let left = match move Subtable2ClassTable.read(leftData) {
      Result<Subtable2ClassTable<'a>, ReadError>.Success { value } => value
      Result<Subtable2ClassTable<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let rightData = match move FontData.splitOff(&data, rightOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let right = match move Subtable2ClassTable.read(rightData) {
      Result<Subtable2ClassTable<'a>, ReadError>.Success { value } => value
      Result<Subtable2ClassTable<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        data: data,
        headerLen: headerLen,
        leftOffsetTable: left,
        rightOffsetTable: right,
        arrayOffset: arrayOffset,
      },
    )
  }

  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    let l = Subtable2ClassTable.value(&self.leftOffsetTable, left) |> Option<u16>.unwrapOr(0)
    let r = Subtable2ClassTable.value(&self.rightOffsetTable, right) |> Option<u16>.unwrapOr(0)
    let leftOffset = match move usize.checkedSubtract(u16.toUsize(l), self.headerLen) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    if leftOffset < self.arrayOffset {
      return Option<i32>.None
    }
    let offset = match move usize.checkedAdd(leftOffset, u16.toUsize(r)) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    return match move FontData<'a>.readAt<i16>(&self.data, offset) {
      Result<i16, ReadError>.Success { value } => Option<i32>.some(i16.toI32(value))
      _ => Option<i32>.None
    }
  }
}

impl<'a> FontRead<'a, usize> for Subtable2<'a> {
  fn readWithArgs(data: FontData<'a>, args: usize) -> Result<Self, ReadError> {
    return Subtable2<'a>.readWithArgs(data, args)
  }
}

impl<'a> Subtable2ClassTable<'a> {
  fn value(self: &Self, glyph: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyph)
    let first = GlyphId16.toU32(Subtable2ClassTable.firstGlyph(self))
    if gid > 65535 || gid < first {
      return Option<u16>.None
    }
    return ScalarArray<u16>.get(&Subtable2ClassTable.offsets(self), u32.toUsize(gid - first))
  }
}

impl<'a> Subtable3<'a> {
  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    let l = match move ScalarArray<u8>.get(
      &Subtable3.leftClass(self),
      u32.toUsize(GlyphId.toU32(left)),
    ) {
      Option<u8>.Some { value } => u8.toUsize(value)
      _ => {
        return Option<i32>.None
      }
    }
    let r = match move ScalarArray<u8>.get(
      &Subtable3.rightClass(self),
      u32.toUsize(GlyphId.toU32(right)),
    ) {
      Option<u8>.Some { value } => u8.toUsize(value)
      _ => {
        return Option<i32>.None
      }
    }
    let index = match move ScalarArray<u8>.get(
      &Subtable3.kernIndex(self),
      l * u8.toUsize(Subtable3.rightClassCount(self)) + r,
    ) {
      Option<u8>.Some { value } => u8.toUsize(value)
      _ => {
        return Option<i32>.None
      }
    }
    return match move ScalarArray<i16>.get(&Subtable3.kernValue(self), index) {
      Option<i16>.Some { value } => Option<i32>.some(i16.toI32(value))
      _ => Option<i32>.None
    }
  }
}
