// Internal adapters keep the public parser APIs as Result values.
import model.error { Error }
import read { ReadError }
import silk.core.option { Option }
import silk.core.result { Result }

pub effect fn take<T>(result: Result<T, Error>) -> T
  ! Error with Intrinsic.inlineAlways() {
  return match move result {
    Result<T, Error>.Success { value } => move value
    Result<T, Error>.Failure { error } => {
      fail error
    }
  }
}

pub effect fn takeRead<T>(result: Result<T, ReadError>) -> T
  ! Error with Intrinsic.inlineAlways() {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      fail Error.fromReadError(error)
    }
  }
}

pub effect fn require<T>(option: Option<T>, error: Error) -> T
  ! Error with Intrinsic.inlineAlways() {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      fail error
    }
  }
}

/// A failure caught by `Intrinsic.catchFailure<Error>(effect, catchError)`. Hot paths
/// catch with it instead of `Effect.result`, whose `Effect.map` is not inlined
/// and costs tens of nanoseconds per call.
pub struct Failed {
  pub error: Error,
}

pub effect fn catchError(error: Error) -> Failed {
  return Failed { error: error }
}
