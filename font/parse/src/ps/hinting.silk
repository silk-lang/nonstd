import font_types.lib { Fixed }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }

pub const MAX_BLUE_VALUES: usize = 7

pub const MAX_STEM_SNAPS: usize = 12

pub struct BlueRegion {
  pub first: Fixed,
  pub second: Fixed,
}

impl Copy for BlueRegion {}

pub struct Blues {
  regions: [BlueRegion; 7],
  count: usize,
}

impl Copy for Blues {}

impl Blues {
  pub fn default() -> Self {
    return Self { regions: [BlueRegion { first: Fixed.zero(), second: Fixed.zero() }; 7], count: 0 }
  }

  pub fn new(values: &[Fixed]) -> Self {
    let mut result = Blues.default()
    let mut count = values.length / 2
    if count > 7 {
      count = 7
    }
    let mut i: usize = 0
    while i < count {
      result.regions[i] = BlueRegion { first: values[i * 2], second: values[i * 2 + 1] }
      i = i + 1
    }
    result.count = count
    return result
  }

  pub fn values<'a>(self: &'a Self) -> &'a [BlueRegion] {
    return Slice.view<BlueRegion>(&self.regions, 0, self.count)
  }
}

pub struct StemSnaps {
  items: [Fixed; 12],
  count: usize,
}

impl Copy for StemSnaps {}

impl StemSnaps {
  pub fn default() -> Self {
    return Self { items: [Fixed.zero(); 12], count: 0 }
  }

  pub fn new(values: &[Fixed]) -> Self {
    let mut result = StemSnaps.default()
    let mut count = values.length
    if count > 12 {
      count = 12
    }
    let mut i: usize = 0
    while i < count {
      result.items[i] = values[i]
      i = i + 1
    }
    result.count = count
    return result
  }

  pub fn values<'a>(self: &'a Self) -> &'a [Fixed] {
    return Slice.view<Fixed>(&self.items, 0, self.count)
  }
}

pub struct HintingParams {
  pub blues: Blues,
  pub familyBlues: Blues,
  pub otherBlues: Blues,
  pub familyOtherBlues: Blues,
  pub blueScale: Fixed,
  pub blueShift: Fixed,
  pub blueFuzz: Fixed,
  pub languageGroup: i32,
}

impl Copy for HintingParams {}

impl HintingParams {
  pub fn default() -> Self {
    return Self {
      blues: Blues.default(),
      familyBlues: Blues.default(),
      otherBlues: Blues.default(),
      familyOtherBlues: Blues.default(),
      blueScale: Fixed.fromF64(0.039625),
      blueShift: Fixed.fromI32(7),
      blueFuzz: Fixed.one(),
      languageGroup: 0,
    }
  }
}

import silk.core.equal { Equal }

impl Equal for Blues {
  fn equals(a: &Blues, b: &Blues) -> bool {
    if a.count != b.count {
      return false
    }
    let mut i: usize = 0
    while i < a.count {
      if Fixed.toBits(a.regions[i].first) != Fixed.toBits(b.regions[i].first)
        || Fixed.toBits(a.regions[i].second) != Fixed.toBits(b.regions[i].second) {
        return false
      }
      i = i + 1
    }
    return true
  }
}

impl Equal for StemSnaps {
  fn equals(a: &StemSnaps, b: &StemSnaps) -> bool {
    if a.count != b.count {
      return false
    }
    let mut i: usize = 0
    while i < a.count {
      if Fixed.toBits(a.items[i]) != Fixed.toBits(b.items[i]) {
        return false
      }
      i = i + 1
    }
    return true
  }
}
