test effect fn operationLimit()
  ! AssertionError<'static> {
  let bytes: [u8; 1000001] = [0; 1000001]
  let ctx = TestContext.plain(CharstringKind.Type2)
  let mut sink = NullSink {}
  drop run mustCs(evaluate(&ctx, noBlendCs(), Slice.view<u8>(&bytes, 0, 1000000), &mut sink))
  let error = match move evaluate(&ctx, noBlendCs(), &bytes, &mut sink) {
    Result<Option<Fixed>, Error>.Failure { error } => error
    _ => {
      run Testing.expect(false, "operation limit rejects extra instruction")
      return
    }
  }
  run Testing.expect(error == Error.LimitExceeded, "operation-limit error")
}

test effect fn opDiv()
  ! AssertionError<'static> {
