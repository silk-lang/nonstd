  let capture = run evalTest(&[0, 32, 22, 2], CharstringKind.Type2)
  run Testing.expect(capture.count == 2, "reserved operators reset and continue")
  run checkCommand(&capture, 0, 1, &[Fixed.fromI32(-107), Fixed.zero()])
  run checkCommand(&capture, 1, 2, &[Fixed.fromI32(-107), Fixed.zero()])
