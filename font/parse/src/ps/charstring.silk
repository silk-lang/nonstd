}

test effect fn opCallothersubrFlex()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
  let ctx = TestContext.plain(CharstringKind.Type1)
  let mut sink = TestCapture.new()
  run pushInts(&mut state, &[0, 1])
  run operatorTest(&mut state, &ctx, &mut sink, Operator.CallOtherSubr)
  let mut i: usize = 0
  while i < 7 {
    run pushInts(&mut state, &[1, 2])
    run operatorTest(&mut state, &ctx, &mut sink, Operator.RMoveTo)
    i = i + 1
  }
  run pushInts(&mut state, &[0, 100, 200, 3, 0])
  run operatorTest(&mut state, &ctx, &mut sink, Operator.CallOtherSubr)
  run operatorTest(&mut state, &ctx, &mut sink, Operator.SetCurrentPoint)
  run Testing.expect(
    Fixed.toI32(state.x) == 100 && Fixed.toI32(state.y) == 200 && sink.count == 3,
    "legacy flex final position",
  )
  run checkCommand(&sink, 0, 1, &[Fixed.zero(), Fixed.zero()])
  run checkCommand(
    &sink,
    1,
    3,
    &[
      Fixed.fromI32(2),
      Fixed.fromI32(4),
      Fixed.fromI32(3),
      Fixed.fromI32(6),
      Fixed.fromI32(4),
      Fixed.fromI32(8),
    ],
  )
  run checkCommand(
    &sink,
    2,
    3,
    &[
      Fixed.fromI32(5),
      Fixed.fromI32(10),
      Fixed.fromI32(6),
      Fixed.fromI32(12),
      Fixed.fromI32(7),
      Fixed.fromI32(14),
    ],
  )
}

test effect fn nopFilterSink()
  ! AssertionError<'static> {
  let mut capture = TestCapture.new()
  let sx = Fixed.fromF64(10.2)
  let sy = Fixed.fromF64(20.4)
  let mut filter = NopFilterSink.new(&mut capture)
  CommandSink.moveTo(&mut filter, Fixed.zero(), Fixed.zero())
  CommandSink.moveTo(&mut filter, sx, sy)
  CommandSink.lineTo(&mut filter, sx, sy)
  CommandSink.curveTo(
    &mut filter,
    Fixed.fromI32(5),
    Fixed.fromI32(-5),
    Fixed.fromF64(1.5),
    Fixed.fromI32(2),
    Fixed.fromF64(4.5),
    Fixed.fromI32(-10),
  )
  CommandSink.lineTo(&mut filter, Fixed.fromF64(4.5), Fixed.fromI32(-10))
  CommandSink.lineTo(&mut filter, sx, sy)
  CommandSink.close(&mut filter)
  drop move filter
  run Testing.expect(capture.count == 3, "no empty contour or duplicate lines")
  run checkCommand(&capture, 0, 1, &[sx, sy])
  run checkCommand(
    &capture,
    1,
    3,
    &[
      Fixed.fromI32(5),
      Fixed.fromI32(-5),
      Fixed.fromF64(1.5),
      Fixed.fromI32(2),
      Fixed.fromF64(4.5),
      Fixed.fromI32(-10),
    ],
  )
  run checkCommand(&capture, 2, 2, &[sx, sy])
}

fn testTransform() -> FontMatrix {
  return Matrix.fromElements<Fixed>(
    [Fixed.one(), Fixed.zero(), Fixed.fromBits(10945), Fixed.one(), Fixed.zero(), Fixed.zero()],
  )
}

effect fn matrixTransformTest(scaled: bool) -> ()
  ! AssertionError<'static> {
  let input: [[i32; 2]; 4] = [[150, 46], [176, 8], [217, -13], [267, -13]]
  let mut expected: [[i32; 2]; 4] = [[158, 46], [177, 8], [215, -13], [265, -13]]
  let mut scale = Option<Fixed>.None
  let mut shift: i32 = 16
  if scaled {
    expected = [[404, 118], [453, 20], [550, -33], [678, -33]]
    scale = Option<Fixed>.some(Fixed.fromBits(167772))
    shift = 10
  }
  let mut dummy = ()
  let sink = TransformSink.fromMatrixScale(&mut dummy, testTransform(), move scale)
  let mut i: usize = 0
  while i < 4 {
    let point = TransformSink.transform(
      &sink,
      Fixed.fromI32(input[i][0]),
      Fixed.fromI32(input[i][1]),
    )
    run Testing.expect(
      Fixed.toBits(point.x) == i32.shiftLeft(expected[i][0], shift)
        && Fixed.toBits(point.y) == i32.shiftLeft(expected[i][1], shift),
      "matrix transform precision",
    )
    i = i + 1
  }
}

test effect fn scaledMatrixTransformSink()
  ! AssertionError<'static> {
  run matrixTransformTest(true)
}

test effect fn unscaledMatrixTransformSink()
  ! AssertionError<'static> {
  run matrixTransformTest(false)
}

test effect fn unscaledTransformSinkProducesIntegers()
  ! AssertionError<'static> {
  let mut dummy = ()
  let sink = TransformSink.new(&mut dummy, Transform.default())
  let coords: [f64; 5] = [50.0, 50.1, 50.125, 50.5, 50.9]
  let mut i: usize = 0
  while i < 5 {
    let p = TransformSink.transform(&sink, Fixed.fromF64(coords[i]), Fixed.zero())
    run Testing.expect(Fixed.toBits(p.x) == 3276800, "integer outline units")
    i = i + 1
  }
}

test effect fn scaledTransformSink()
  ! AssertionError<'static> {
  let mut dummy = ()
  let scale = Fixed.fromBits(1280) / Fixed.fromBits(1000)
  let sink = TransformSink.fromMatrixScale(
    &mut dummy,
    Matrix.identity<Fixed>(),
    Option<Fixed>.some(scale),
  )
  let inputs: [f64; 6] = [0.0, 8.0, 16.0, 32.0, 72.0, 128.0]
  let expected: [f64; 6] = [0.0, 0.15625, 0.3125, 0.640625, 1.4375, 2.5625]
  let mut i: usize = 0
  while i < 6 {
    let p = TransformSink.transform(&sink, Fixed.fromF64(inputs[i]), Fixed.zero())
    run Testing.expect(
      Fixed.toBits(p.x) == Fixed.toBits(Fixed.fromF64(expected[i])),
      "26.6 intermediate scaling",
    )
    i = i + 1
  }
}

effect fn otherSubrTest<'w, 's>(
  state: &mut Evaluator<'static, 'static, 's>,
  ctx: &TestContext<'w>,
  args: &[i32],
) -> ()
  ! AssertionError<'static> {
  run pushInts(&mut state, args)
  let mut sink = TestCapture.new()
  run operatorTest(&mut state, ctx, &mut sink, Operator.CallOtherSubr)
}

fn otherSubrFails<'w, 's>(
  state: &mut Evaluator<'static, 'static, 's>,
  ctx: &TestContext<'w>,
  args: &[i32],
) -> bool {
  Stack.clear(&mut state.stack)
  let mut i: usize = 0
  while i < args.length {
    drop Stack.push<i32>(&mut state.stack, args[i])
    i = i + 1
  }
  let mut sink = TestCapture.new()
  return match move run Effect.result(handleOtherSubr(&mut state, ctx, &mut sink)) {
    Result<(), Error>.Failure { error } => true
    _ => false
  }
}

effect fn checkStack<'s>(state: &Evaluator<'static, 'static, 's>, expected: &[Fixed]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(Stack.len(&state.stack) == expected.length, "operand stack length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(
      Fixed.toBits(run mustCs(Stack.getFixed(&state.stack, i))) == Fixed.toBits(expected[i]),
      "operand stack value",
    )
    i = i + 1
  }
}

test effect fn mmBlend()
  ! AssertionError<'static> {
  let weights = [Fixed.zero(), Fixed.fromF64(-0.25), Fixed.one()]
  let ctx = TestContext {
    kind: CharstringKind.Type1,
    weights: Option<&[Fixed]>.some(&weights),
    buildLen: 8,
  }
  let mut stack = Stack.new()
  let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
  run otherSubrTest(&mut state, &ctx, &[1, 0, 2, 3, 4, -8, 6, 15])
  run checkStack(&state, &[Fixed.fromF64(3.5), Fixed.fromI32(-9)])
}

test effect fn othersubrArithmetic()
  ! AssertionError<'static> {
  let weights = [Fixed.zero(); 3]
  let ctx = TestContext {
    kind: CharstringKind.Type1,
    weights: Option<&[Fixed]>.some(&weights),
    buildLen: 8,
  }
  let mut index: i32 = 20
  let expected: [f64; 4] = [9.0, 5.0, 14.0, 3.5]
  while index <= 23 {
    let mut stack = Stack.new()
    let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
    run otherSubrTest(&mut state, &ctx, &[7, 2, 2, index])
    run checkStack(&state, &[Fixed.fromF64(expected[i32.toUsize(index - 20)])])
    index = index + 1
  }
  let mut stack = Stack.new()
  let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
  run otherSubrTest(&mut state, &ctx, &[1, 2, 3, 4, 4, 27])
  run checkStack(&state, &[Fixed.one()])
  Stack.clear(&mut state.stack)
  run otherSubrTest(&mut state, &ctx, &[1, 2, 5, 4, 4, 27])
  run checkStack(&state, &[Fixed.fromI32(2)])
  run Testing.expect(
    otherSubrFails(&mut state, &ctx, &[7, 0, 2, 23])
      && otherSubrFails(&mut state, &ctx, &[7, 2, 1, 20]),
    "division by zero and wrong count",
  )
}

test effect fn othersubrBuildCharArray()
  ! AssertionError<'static> {
  let weights = [Fixed.fromF64(0.25), Fixed.fromF64(0.5), Fixed.fromF64(0.25)]
  let ctx = TestContext {
    kind: CharstringKind.Type1,
    weights: Option<&[Fixed]>.some(&weights),
    buildLen: 8,
  }
  let mut stack = Stack.new()
  let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
  run otherSubrTest(&mut state, &ctx, &[5, 3, 2, 24])
  run checkStack(&state, &[])
  run otherSubrTest(&mut state, &ctx, &[3, 1, 25])
  run checkStack(&state, &[Fixed.fromI32(5)])
  Stack.clear(&mut state.stack)
  run otherSubrTest(&mut state, &ctx, &[2, 1, 19])
  run checkStack(&state, &[])
  run otherSubrTest(&mut state, &ctx, &[3, 1, 25])
  run checkStack(&state, &[Fixed.fromF64(0.5)])
  Stack.clear(&mut state.stack)
  run Testing.expect(
    otherSubrFails(&mut state, &ctx, &[1, 8, 2, 24])
      && otherSubrFails(&mut state, &ctx, &[8, 1, 25])
      && otherSubrFails(&mut state, &ctx, &[6, 1, 19]),
    "BuildChar bounds",
  )

  // Exercise the storage transition beyond the upstream inline capacity.
  let large = TestContext {
    kind: CharstringKind.Type1,
    weights: Option<&[Fixed]>.some(&weights),
    buildLen: 64,
  }
  let mut heapStack = Stack.new()
  let mut heapState = testEvaluator(CharstringKind.Type1, &mut heapStack)
  run otherSubrTest(&mut heapState, &large, &[7, 63, 2, 24])
  run otherSubrTest(&mut heapState, &large, &[63, 1, 25])
  run checkStack(&heapState, &[Fixed.fromI32(7)])
}

test effect fn othersubrsWithoutABlendFail()
  ! AssertionError<'static> {
  let ctx = TestContext.plain(CharstringKind.Type1)
  let mut stack = Stack.new()
  let mut state = testEvaluator(CharstringKind.Type1, &mut stack)
  run Testing.expect(
    otherSubrFails(&mut state, &ctx, &[1, 2, 2, 14])
      && otherSubrFails(&mut state, &ctx, &[0, 1, 19])
      && otherSubrFails(&mut state, &ctx, &[5, 0, 2, 24])
      && otherSubrFails(&mut state, &ctx, &[0, 1, 25]),
    "blend required",
  )
  Stack.clear(&mut state.stack)
  run otherSubrTest(&mut state, &ctx, &[7, 2, 2, 20])
  run checkStack(&state, &[Fixed.fromI32(9)])
}

effect fn moveTest(ops: &[u8], kind: CharstringKind) -> Point<Fixed>
  ! AssertionError<'static> {
  let mut bytes: [u8; 128] = [0; 128]
  let mut i: usize = 0
  while i < ops.length {
    bytes[i] = ops[i]
    i = i + 1
  }
  bytes[i] = 21
  bytes[i + 1] = 14
  let capture = run evalTest(Slice.view<u8>(&bytes, 0, i + 2), kind)
  run Testing.expect(capture.count > 0 && capture.items[0].kind == 1, "computed move exists")
  return Point<Fixed> { x: capture.items[0].coords[0], y: capture.items[0].coords[1] }
}

fn numberByte(value: i32) -> u8 {
  return i32.toU8(value + 139)
}

effect fn binaryTest(a: i32, b: i32, op: u8) -> Fixed
  ! AssertionError<'static> {
  return (run moveTest(&[139, numberByte(a), numberByte(b), 12, op], CharstringKind.Type2)).y
}

effect fn checkMove(ops: &[u8], x: i32, y: i32) -> ()
  ! AssertionError<'static> {
  let p = run moveTest(ops, CharstringKind.Type2)
  run Testing.expect(
    Fixed.toBits(p.x) == Fixed.toBits(Fixed.fromI32(x))
      && Fixed.toBits(p.y) == Fixed.toBits(Fixed.fromI32(y)),
    "stack computation reaches move",
  )
}

test effect fn arithmetic()
  ! AssertionError<'static> {
  run Testing.expect(
    Fixed.toBits(run binaryTest(7, 5, 10)) == Fixed.toBits(Fixed.fromI32(12))
      && Fixed.toBits(run binaryTest(7, 5, 11)) == Fixed.toBits(Fixed.fromI32(2))
      && Fixed.toBits(run binaryTest(7, 5, 24)) == Fixed.toBits(Fixed.fromI32(35))
      && Fixed.toBits(run binaryTest(10, 4, 12)) == Fixed.toBits(Fixed.fromF64(2.5)),
    "arithmetic operators",
  )
}

test effect fn logicAnswersWithOneOrZero()
  ! AssertionError<'static> {
  let inputs: [[i32; 4]; 7] = [
    [1, 1, 3, 1],
    [1, 0, 3, 0],
    [0, 0, 3, 0],
    [1, 0, 4, 1],
    [0, 0, 4, 0],
    [5, 5, 15, 1],
    [5, 6, 15, 0],
  ]
  let mut i: usize = 0
  while i < inputs.length {
    run Testing.expect(
      Fixed.toBits(run binaryTest(inputs[i][0], inputs[i][1], i32.toU8(inputs[i][2])))
        == Fixed.toBits(Fixed.fromI32(inputs[i][3])),
      "logical operator result",
    )
    i = i + 1
  }
}

test effect fn unary()
  ! AssertionError<'static> {
  run checkMove(&[139, 139, 12, 5], 0, 1)
  let input: [[i32; 3]; 4] = [[-5, 9, 5], [5, 9, 5], [5, 14, -5], [-5, 14, 5]]
  let mut i: usize = 0
  while i < 4 {
    run checkMove(&[139, numberByte(input[i][0]), 12, i32.toU8(input[i][1])], 0, input[i][2])
    i = i + 1
  }
}

test effect fn sqrtOfASquareIsTheRoot()
  ! AssertionError<'static> {
  let input: [[i32; 2]; 5] = [[1, 1], [4, 2], [9, 3], [16, 4], [100, 10]]
  let mut i: usize = 0
  while i < 5 {
    let point = run moveTest(&[139, numberByte(input[i][0]), 12, 26], CharstringKind.Type2)
    let diff = i32.toI64(Fixed.toBits(point.y))
      - i32.toI64(Fixed.toBits(Fixed.fromI32(input[i][1])))
    run Testing.expect(diff >= -2 && diff <= 2, "Babylonian root precision")
    i = i + 1
  }
  run checkMove(&[139, 139, 12, 26], 0, 0)
  run checkMove(&[139, 135, 12, 26], 0, 0)
}

test effect fn theStackOperatorsRearrangeIt()
  ! AssertionError<'static> {
  run checkMove(&[139, 146, 12, 27], 7, 7)
  run checkMove(&[142, 148, 12, 28], 9, 3)
  run checkMove(&[143, 144, 145, 12, 18], 4, 5)
  run checkMove(&[139, 147, 139, 12, 29], 8, 8)
}

test effect fn rollRotatesTheValuesItIsGiven()
  ! AssertionError<'static> {
  run checkMove(&[140, 141, 142, 142, 140, 12, 30], 1, 2)
}

test effect fn rollLeavesTheValuesBelowAlone()
  ! AssertionError<'static> {
  run checkMove(&[238, 140, 141, 141, 140, 12, 30], 2, 1)
}

test effect fn rollByTheMostNegativeShift()
  ! AssertionError<'static> {
  let point = run moveTest(&[140, 141, 141, 255, 128, 0, 0, 0, 12, 30], CharstringKind.Type1)
  run Testing.expect(
    Fixed.toI32(point.x) == 1 && Fixed.toI32(point.y) == 2,
    "i32 MIN is a whole number of turns",
  )
}

test effect fn theTransientArrayRemembersBetweenOperators()
  ! AssertionError<'static> {
  run checkMove(&[139, 181, 142, 12, 20, 142, 12, 21], 0, 42)
}

test effect fn aSlotTheArrayDoesNotHaveIsIgnored()
  ! AssertionError<'static> {
  run checkMove(&[142, 148, 238, 12, 20, 143], 3, 4)
}

test effect fn ifelsePicksTheFirstWhenTheConditionsAreOrdered()
  ! AssertionError<'static> {
  run checkMove(&[139, 150, 161, 140, 141, 12, 22], 0, 11)
  run checkMove(&[139, 150, 161, 141, 140, 12, 22], 0, 22)
  run checkMove(&[139, 150, 161, 141, 141, 12, 22], 0, 11)
}

import model.glyph.outline { PathSink }

/// Explicit adapter for Rust's blanket CommandSink implementation on PathSink.
pub struct PathSinkAdapter<'s, P> {
  pub inner: &'s mut P,
}

impl<'s, P: PathSink> CommandSink for PathSinkAdapter<'s, P> {
  fn moveTo(self: &mut Self, x: Fixed, y: Fixed) {
    PathSink.moveTo(&mut self.inner.*, Fixed.toF32(x), Fixed.toF32(y))
  }

  fn lineTo(self: &mut Self, x: Fixed, y: Fixed) {
    PathSink.lineTo(&mut self.inner.*, Fixed.toF32(x), Fixed.toF32(y))
  }

  fn curveTo(self: &mut Self, a: Fixed, b: Fixed, c: Fixed, d: Fixed, x: Fixed, y: Fixed) {
    PathSink.curveTo(
      &mut self.inner.*,
      Fixed.toF32(a),
      Fixed.toF32(b),
      Fixed.toF32(c),
      Fixed.toF32(d),
      Fixed.toF32(x),
      Fixed.toF32(y),
    )
  }

  fn close(self: &mut Self) {
    PathSink.close(&mut self.inner.*)
  }
}
