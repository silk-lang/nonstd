effect fn checkSbw(op: Operator, kind: CharstringKind) -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  let mut state = testEvaluator(kind, &mut stack)
  let ctx = TestContext.plain(kind)
  let mut capture = TestCapture.new()
  run mustCs(Stack.push<Fixed>(&mut state.stack, Fixed.fromF64(42.5)))
  if op == Operator.Sbw {
    run pushInts(&mut state, &[0])
  }
  run pushInts(&mut state, &[501, 1000])
  run operatorTest(&mut state, &ctx, &mut capture, op)
  let mut sbx = Fixed.zero()
  let mut wx = Fixed.zero()
  if kind == CharstringKind.Type1 {
    sbx = Fixed.fromF64(42.5)
    wx = Fixed.fromI32(501)
  }
  run Testing.expect(
    Fixed.toBits(state.sbx) == Fixed.toBits(sbx) && Fixed.toBits(state.wx) == Fixed.toBits(wx),
    "Type 1 sidebearing and width only",
  )
}

test effect fn opSbwType1()
  ! AssertionError<'static> {
  run checkSbw(Operator.Sbw, CharstringKind.Type1)
}

test effect fn opHsbwType1()
  ! AssertionError<'static> {
