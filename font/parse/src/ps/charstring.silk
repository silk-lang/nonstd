  let mut capture = TestCapture.new()
  run mustCs(Stack.push<Fixed>(&mut state.stack, Fixed.fromF64(512.5)))
  run pushInts(&mut state, &[2])
  run operatorTest(&mut state, &ctx, &mut capture, Operator.Div)
  run Testing.expect(
    Fixed.toBits(run mustCs(Stack.popFixed(&mut state.stack)))
      == Fixed.toBits(Fixed.fromF64(256.25)),
    "fixed division",
  )
}

