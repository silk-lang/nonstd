import font_data { FontData }
import read { ReadError }
import array { ScalarArray, ComputedArray }
import font_types.lib { GlyphId }
import ps.string { Sid }
import generated_ps_data { expertCharset }
pub import generated_cff {
  CharsetFormat0 as Format0,
  CharsetFormat1 as Format1,
  CharsetFormat2 as Format2,
  CharsetRange1 as Range1,
  CharsetRange2 as Range2,
  CustomCharset
}
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub union CharsetKind<'a> {
  IsoAdobe,
  Expert,
  ExpertSubset,
  Custom { pub value: CustomCharset<'a> },
}

impl<'a> Copy for CharsetKind<'a> {}

pub struct Charset<'a> {
  charsetKind: CharsetKind<'a>,
  glyphCount: u32,
}

impl<'a> Copy for Charset<'a> {}

impl<'a> Charset<'a> {
  pub fn new(cffData: FontData<'a>, charsetOffset: usize, numGlyphs: u32) -> Option<Self> {
    let mut kind = CharsetKind<'a>.IsoAdobe
    if charsetOffset == 1 {
      kind = CharsetKind<'a>.Expert
    } else if charsetOffset == 2 {
      kind = CharsetKind<'a>.ExpertSubset
    } else if charsetOffset > 2 {
      let data = match move FontData.splitOff(&cffData, charsetOffset) {
        Option<FontData<'a>>.Some { value } => value
        _ => {
          return Option<Self>.None
        }
      }
      let custom = match move CustomCharset.read(data) {
        Result<CustomCharset<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<Self>.None
        }
      }
      kind = CharsetKind<'a>.Custom { value: custom }
    }
    return Option<Self>.some(Self { charsetKind: kind, glyphCount: numGlyphs })
  }

  pub fn kind(self: &Self) -> CharsetKind<'a> {
    return self.charsetKind
  }

  pub fn numGlyphs(self: &Self) -> u32 {
    return self.glyphCount
  }

  pub fn stringId(self: &Self, glyphId: GlyphId) -> Option<Sid> {
    let gid = GlyphId.toU32(glyphId)
    if gid >= self.glyphCount {
      return Option<Sid>.None
    }
    return match self.charsetKind {
      CharsetKind<'a>.IsoAdobe => {
        if gid <= 228 {
          return Option<Sid>.some(Sid.new(u32.toU16(gid)))
        }
        return Option<Sid>.None
      }
      CharsetKind<'a>.Expert => toSid(expertCharset(false, u32.toUsize(gid)))
      CharsetKind<'a>.ExpertSubset => toSid(expertCharset(true, u32.toUsize(gid)))
      CharsetKind<'a>.Custom { value } => match value {
        CustomCharset<'a>.Format0 { value: format } => {
          if gid == 0 {
            return Option<Sid>.some(Sid.new(0))
          }
          return toSid(ScalarArray<u16>.get(&Format0.glyph(&format), u32.toUsize(gid - 1)))
        }
        CustomCharset<'a>.Format1 { value: format } => stringIdFromRanges(
          &FormatRanges<'a>.Format1 { value: Format1.ranges(&format) },
          glyphId,
        )
        CustomCharset<'a>.Format2 { value: format } => stringIdFromRanges(
          &FormatRanges<'a>.Format2 { value: Format2.ranges(&format) },
          glyphId,
        )
      }
    }
  }

  pub fn glyphId(self: &Self, stringId: Sid) -> Option<GlyphId> {
    let glyph = match move Charset.glyphIdUnbounded(self, stringId) {
      Option<GlyphId>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if GlyphId.toU32(glyph) >= self.glyphCount {
      return Option<GlyphId>.None
    }
    return Option<GlyphId>.some(glyph)
  }

  fn glyphIdUnbounded(self: &Self, stringId: Sid) -> Option<GlyphId> {
    let sid = Sid.toU16(stringId)
    return match self.charsetKind {
      CharsetKind<'a>.IsoAdobe => {
        if sid <= 228 {
          return Option<GlyphId>.some(GlyphId.new(u16.toU32(sid)))
        }
        return Option<GlyphId>.None
      }
      CharsetKind<'a>.Expert => expertGlyph(false, sid)
      CharsetKind<'a>.ExpertSubset => expertGlyph(true, sid)
      CharsetKind<'a>.Custom { value } => match value {
        CustomCharset<'a>.Format0 { value: format } => {
          if sid == 0 {
            return Option<GlyphId>.some(GlyphId.new(0))
          }
          let glyphs = Format0.glyph(&format)
          let mut i: usize = 0
          while i < ScalarArray<u16>.len(&glyphs) {
            if (ScalarArray<u16>.get(&glyphs, i) |> Option<u16>.unwrapOr(0)) == sid {
              let position = usize.toU16(i & 65535)
              return Option<GlyphId>.some(GlyphId.new(u16.toU32(u16.saturatingAdd(position, 1))))
            }
            i = i + 1
          }
          return Option<GlyphId>.None
        }
        CustomCharset<'a>.Format1 { value: format } => glyphIdFromRanges(
          &FormatRanges<'a>.Format1 { value: Format1.ranges(&format) },
          stringId,
        )
        CustomCharset<'a>.Format2 { value: format } => glyphIdFromRanges(
          &FormatRanges<'a>.Format2 { value: Format2.ranges(&format) },
          stringId,
        )
      }
    }
  }

  pub fn iter(self: &Self) -> Iter<'a> {
    let mut result = Iter<'a> {
      charset: self.*,
      gid: 0,
      rangeIndex: 0,
      first: 0,
      end: 0,
      prevEnd: 0,
      ranged: false,
    }
    match self.charsetKind {
      CharsetKind<'a>.Custom { value } => match value {
        CustomCharset<'a>.Format1 { value: format } => {
          result.ranged = true
        }
        CustomCharset<'a>.Format2 { value: format } => {
          result.ranged = true
        }
        _ => {}
      }
      _ => {}
    }
    if result.ranged {
      match move Iter.nextRange(&mut result) {
        Option<RangeValues>.Some { value } => {
          result.first = value.first
          result.end = value.nLeft
        }
        _ => {}
      }
    }
    return result
  }
}

fn toSid(value: Option<u16>) -> Option<Sid> {
  return match move value {
    Option<u16>.Some { value: number } => Option<Sid>.some(Sid.new(number))
    _ => Option<Sid>.None
  }
}

fn expertGlyph(subset: bool, sid: u16) -> Option<GlyphId> {
  let mut i: usize = 0
  while true {
    match move expertCharset(subset, i) {
      Option<u16>.Some { value } => {
        if value == sid {
          return Option<GlyphId>.some(GlyphId.new(usize.toU32(i)))
        }
      }
      _ => {
        return Option<GlyphId>.None
      }
    }
    i = i + 1
  }
  return Option<GlyphId>.None
}

// Shared range arithmetic is also exercised with u32 boundary records in tests.
pub struct RangeValues {
  pub first: u32,
  pub nLeft: u32,
}

impl Copy for RangeValues {}

pub interface RangeSource {
  fn rangeAt(self: &Self, index: usize) -> Option<RangeValues>
}

union FormatRanges<'a> {
  Format1 { value: ComputedArray<'a, (), Range1<'a>> },
  Format2 { value: ComputedArray<'a, (), Range2<'a>> },
}

impl<'a> Copy for FormatRanges<'a> {}

impl<'a> RangeSource for FormatRanges<'a> {
  fn rangeAt(self: &Self, index: usize) -> Option<RangeValues> {
    return match &self.* {
      FormatRanges<'a>.Format1 { value } => match move ComputedArray<'a, (), Range1<'a>>.get(
        &value,
        index,
      ) {
        Result<Range1<'a>, ReadError>.Success { value: record } => Option<RangeValues>.some(
          RangeValues {
            first: u16.toU32(Range1.first(&record)),
            nLeft: u8.toU32(Range1.nLeft(&record)),
          },
        )
        _ => Option<RangeValues>.None
      }
      FormatRanges<'a>.Format2 { value } => match move ComputedArray<'a, (), Range2<'a>>.get(
        &value,
        index,
      ) {
        Result<Range2<'a>, ReadError>.Success { value: record } => Option<RangeValues>.some(
          RangeValues {
            first: u16.toU32(Range2.first(&record)),
            nLeft: u16.toU32(Range2.nLeft(&record)),
          },
        )
        _ => Option<RangeValues>.None
      }
    }
  }
}

pub fn nextRange<R: RangeSource>(ranges: &R, index: &mut usize) -> Option<RangeValues> {
  let range = match move RangeSource.rangeAt(ranges, index.*) {
    Option<RangeValues>.Some { value } => value
    _ => {
      return Option<RangeValues>.None
    }
  }
  index.* = usize.saturatingAdd(index.*, 1)
  let span = match move u32.checkedAdd(range.nLeft, 1) {
    Option<u32>.Some { value } => value
    _ => {
      return Option<RangeValues>.None
    }
  }
  return Option<RangeValues>.some(RangeValues { first: range.first, nLeft: span })
}

pub fn stringIdFromRanges<R: RangeSource>(ranges: &R, glyphId: GlyphId) -> Option<Sid> {
  let gid = GlyphId.toU32(glyphId)
  if gid == 0 {
    return Option<Sid>.some(Sid.new(0))
  }
  let index = gid - 1
  let mut end: u32 = 0
  let mut i: usize = 0
  while true {
    let range = match move nextRange(ranges, &mut i) {
      Option<RangeValues>.Some { value } => value
      _ => {
        return Option<Sid>.None
      }
    }
    let nextEnd = match move u32.checkedAdd(end, range.nLeft) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<Sid>.None
      }
    }
    if index < nextEnd {
      let sid = match move u32.checkedAdd(index - end, range.first) {
        Option<u32>.Some { value } => value
        _ => {
          return Option<Sid>.None
        }
      }
      return toSid(u32.checkedToU16(sid))
    }
    end = nextEnd
  }
  return Option<Sid>.None
}

pub fn glyphIdFromRanges<R: RangeSource>(ranges: &R, stringId: Sid) -> Option<GlyphId> {
  let sid = u16.toU32(Sid.toU16(stringId))
  if sid == 0 {
    return Option<GlyphId>.some(GlyphId.new(0))
  }
  let mut gid: u32 = 1
  let mut i: usize = 0
  while true {
    let range = match move RangeSource.rangeAt(ranges, i) {
      Option<RangeValues>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    let last = match move u32.checkedAdd(range.first, range.nLeft) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if range.first <= sid && sid <= last {
      return match move u32.checkedAdd(gid, sid - range.first) {
        Option<u32>.Some { value } => Option<GlyphId>.some(GlyphId.new(value))
        _ => Option<GlyphId>.None
      }
    }
    let span = match move u32.checkedAdd(range.nLeft, 1) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    gid = match move u32.checkedAdd(gid, span) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    i = usize.saturatingAdd(i, 1)
  }
  return Option<GlyphId>.None
}

pub struct CharsetEntry {
  pub glyph: GlyphId,
  pub sid: Sid,
}

impl Copy for CharsetEntry {}

pub struct Iter<'a> {
  charset: Charset<'a>,
  gid: u32,
  rangeIndex: usize,
  first: u32,
  end: u32,
  prevEnd: u32,
  ranged: bool,
}

impl<'a> Copy for Iter<'a> {}

impl<'a> Iter<'a> {
  fn nextRange(self: &mut Self) -> Option<RangeValues> {
    return match self.charset.charsetKind {
      CharsetKind<'a>.Custom { value } => match value {
        CustomCharset<'a>.Format1 { value: format } => nextRange(
          &FormatRanges<'a>.Format1 { value: Format1.ranges(&format) },
          &mut self.rangeIndex,
        )
        CustomCharset<'a>.Format2 { value: format } => nextRange(
          &FormatRanges<'a>.Format2 { value: Format2.ranges(&format) },
          &mut self.rangeIndex,
        )
        _ => Option<RangeValues>.None
      }
      _ => Option<RangeValues>.None
    }
  }

  pub fn next(self: &mut Self) -> Option<CharsetEntry> {
    if !self.ranged {
      let gid = GlyphId.new(self.gid)
      let sid = match move Charset.stringId(&self.charset, gid) {
        Option<Sid>.Some { value } => value
        _ => {
          return Option<CharsetEntry>.None
        }
      }
      self.gid = match move u32.checkedAdd(self.gid, 1) {
        Option<u32>.Some { value } => value
        _ => {
          return Option<CharsetEntry>.None
        }
      }
      return Option<CharsetEntry>.some(CharsetEntry { glyph: gid, sid: sid })
    }
    if self.gid >= self.charset.glyphCount {
      return Option<CharsetEntry>.None
    }
    if self.gid == 0 {
      self.gid = 1
      return Option<CharsetEntry>.some(CharsetEntry { glyph: GlyphId.new(0), sid: Sid.new(0) })
    }
    let gid = self.gid - 1
    self.gid = match move u32.checkedAdd(self.gid, 1) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<CharsetEntry>.None
      }
    }
    while gid >= self.end {
      let range = match move Iter.nextRange(&mut self) {
        Option<RangeValues>.Some { value } => value
        _ => {
          return Option<CharsetEntry>.None
        }
      }
      self.prevEnd = self.end
      self.first = range.first
      self.end = match move u32.checkedAdd(self.prevEnd, range.nLeft) {
        Option<u32>.Some { value } => value
        _ => {
          return Option<CharsetEntry>.None
        }
      }
    }
    if gid < self.prevEnd {
      return Option<CharsetEntry>.None
    }
    let sid = match move u32.checkedAdd(self.first, gid - self.prevEnd) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<CharsetEntry>.None
      }
    }
    if sid > 65535 {
      return Option<CharsetEntry>.None
    }
    return Option<CharsetEntry>.some(
      CharsetEntry { glyph: GlyphId.new(gid + 1), sid: Sid.new(u32.toU16(sid)) },
    )
  }
}
