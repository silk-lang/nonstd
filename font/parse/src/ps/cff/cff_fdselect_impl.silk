impl<'a> FdSelect<'a> {
  pub fn fontIndex(self: &Self, glyphId: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyphId)
    return match &self.* {
      FdSelect<'a>.Format0 { value } => match move ScalarArray<u8>.get(
        &FdSelectFormat0.fds(&value),
        u32.toUsize(gid),
      ) {
        Option<u8>.Some { value: entry } => Option<u16>.some(u8.toU16(entry))
        _ => Option<u16>.None
      }
      FdSelect<'a>.Format3 { value } => {
        let ranges = FdSelectFormat3.ranges(&value)
        let mut size = ComputedArray<'a, (), FdSelectRange3<'a>>.len(&ranges)
        let mut low: usize = 0
        if size == 0 {
          return Option<u16>.None
        }

        // Follow Rust slice binary_search_by exactly, including unsorted input.
        while size > 1 {
          let half = size / 2
          let mid = low + half
          let item = match move ComputedArray<'a, (), FdSelectRange3<'a>>.get(&ranges, mid) {
            Result<FdSelectRange3<'a>, ReadError>.Success { value: found } => found
            _ => {
              return Option<u16>.None
            }
          }
          if u16.toU32(FdSelectRange3.first(&item)) <= gid {
            low = mid
          }
          size = size - half
        }
        let mut item = match move ComputedArray<'a, (), FdSelectRange3<'a>>.get(&ranges, low) {
          Result<FdSelectRange3<'a>, ReadError>.Success { value: found } => found
          _ => {
            return Option<u16>.None
          }
        }
        if u16.toU32(FdSelectRange3.first(&item)) > gid && low > 0 {
          item = match move ComputedArray<'a, (), FdSelectRange3<'a>>.get(&ranges, low - 1) {
            Result<FdSelectRange3<'a>, ReadError>.Success { value: found } => found
            _ => {
              return Option<u16>.None
            }
          }
        }
        let sentinel = u16.toU32(FdSelectFormat3.sentinel(&value))
        if gid < u16.toU32(FdSelectRange3.first(&item)) || gid >= sentinel {
          return Option<u16>.None
        }
        return Option<u16>.some(u8.toU16(FdSelectRange3.fd(&item)))
      }
      FdSelect<'a>.Format4 { value } => {
        let ranges = FdSelectFormat4.ranges(&value)
        let mut size = ComputedArray<'a, (), FdSelectRange4<'a>>.len(&ranges)
        let mut low: usize = 0
        if size == 0 {
          return Option<u16>.None
        }

        // Follow Rust slice binary_search_by exactly, including unsorted input.
        while size > 1 {
          let half = size / 2
          let mid = low + half
          let item = match move ComputedArray<'a, (), FdSelectRange4<'a>>.get(&ranges, mid) {
            Result<FdSelectRange4<'a>, ReadError>.Success { value: found } => found
            _ => {
              return Option<u16>.None
            }
          }
          if FdSelectRange4.first(&item) <= gid {
            low = mid
          }
          size = size - half
        }
        let mut item = match move ComputedArray<'a, (), FdSelectRange4<'a>>.get(&ranges, low) {
          Result<FdSelectRange4<'a>, ReadError>.Success { value: found } => found
          _ => {
            return Option<u16>.None
          }
        }
        if FdSelectRange4.first(&item) > gid && low > 0 {
          item = match move ComputedArray<'a, (), FdSelectRange4<'a>>.get(&ranges, low - 1) {
            Result<FdSelectRange4<'a>, ReadError>.Success { value: found } => found
            _ => {
              return Option<u16>.None
            }
          }
        }
        let sentinel = FdSelectFormat4.sentinel(&value)
        if gid < FdSelectRange4.first(&item) || gid >= sentinel {
          return Option<u16>.None
        }
        return Option<u16>.some(FdSelectRange4.fd(&item))
      }
    }
  }
}
