import font_data { FontData }
import read { ReadError }
import font_types.lib { Uint24 }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.collections.slice { Slice }
import table_ref { ByteRange }

pub fn readOffset<'a>(index: usize, count: usize, width: u8, data: FontData<'a>) -> Option<usize> {
  if index > count {
    return Option<usize>.None
  }
  let position = match move usize.checkedMultiply(index, u8.toUsize(width)) {
    Option<usize>.Some { value } => value
    _ => {
      return Option<usize>.None
    }
  }
  let offset = match width {
    1 => match move FontData<'a>.readAt<u8>(&data, position) {
      Result<u8, ReadError>.Success { value } => u8.toUsize(value)
      _ => {
        return Option<usize>.None
      }
    }
    2 => match move FontData<'a>.readAt<u16>(&data, position) {
      Result<u16, ReadError>.Success { value } => u16.toUsize(value)
      _ => {
        return Option<usize>.None
      }
    }
    3 => match move FontData<'a>.readAt<Uint24>(&data, position) {
      Result<Uint24, ReadError>.Success { value } => u32.toUsize(Uint24.toU32(value))
      _ => {
        return Option<usize>.None
      }
    }
    4 => match move FontData<'a>.readAt<u32>(&data, position) {
      Result<u32, ReadError>.Success { value } => u32.toUsize(value)
      _ => {
        return Option<usize>.None
      }
    }
    _ => {
      return Option<usize>.None
    }
  }
  return usize.checkedSubtract(offset, 1)
}

// Reads the big-endian offset of `width` bytes (1 to 4) at `at`. The caller
// has checked the bounds.
@inlineAlways
fn offsetAt(bytes: &[u8], at: usize, width: usize) -> usize {
  let b0 = u8.toUsize(bytes[at])
  if width == 1 {
    return b0
  }
  let b1 = usize.shiftLeft(b0, 8) | u8.toUsize(bytes[at + 1])
  if width == 2 {
    return b1
  }
  let b2 = usize.shiftLeft(b1, 8) | u8.toUsize(bytes[at + 2])
  if width == 3 {
    return b2
  }
  return usize.shiftLeft(b2, 8) | u8.toUsize(bytes[at + 3])
}

/// Returns item `index` of an INDEX whose offset array is `offsets` and whose
/// object data follows it, reading the bytes directly.
@inlineAlways
pub fn indexItem<'a>(
  bytes: &'a [u8],
  count: usize,
  width: u8,
  offsets: ByteRange,
  index: usize,
) -> Option<&'a [u8]> {
  let size = u8.toUsize(width)
  if index >= count || size == 0 || size > 4 || offsets.start > offsets.end
    || offsets.end > bytes.length {
    return Option<&'a [u8]>.None
  }

  // Both offsets (items index and index + 1) must lie inside the offset array.
  let relative = usize.wrappingMultiply(index, size)
  let tableLength = offsets.end - offsets.start
  if relative > tableLength || tableLength - relative < size + size {
    return Option<&'a [u8]>.None
  }
  let at = offsets.start + relative
  let start = offsetAt(bytes, at, size)
  let end = offsetAt(bytes, at + size, size)

  // Offsets are 1-based.
  let dataLength = bytes.length - offsets.end
  if start == 0 || start > end || end - 1 > dataLength {
    return Option<&'a [u8]>.None
  }
  return Option<&'a [u8]>.some(Slice.view<u8>(bytes, offsets.end + start - 1, end - start))
}
