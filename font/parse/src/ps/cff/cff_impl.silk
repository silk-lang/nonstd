import ps.string { Sid }
import ps.cff.charset { Charset }
import ps.cff.dict { entries, Entries, Entry }
import ps.cff.blend { BlendState }
import model.error { Error }

pub struct Cff<'a> {
  _header: CffHeader<'a>,
  _names: Index<'a>,
  _topDicts: Index<'a>,
  _strings: Index<'a>,
  _globalSubrs: Index<'a>,
}

impl<'a> Copy for Cff<'a> {}

fn cffReadIndexAndAdvance<'a>(data: &mut FontData<'a>) -> Result<Index<'a>, ReadError> {
  let index = match move Index.read(data.*) {
    Result<Index<'a>, ReadError>.Success { value } => value
    Result<Index<'a>, ReadError>.Failure { error } => {
      return Result<Index<'a>, ReadError>.failResult(error)
    }
  }
  let size = match move Index.sizeInBytes(&index) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<Index<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  data.* = match move FontData.splitOff(&data, size) {
    Option<FontData<'a>>.Some { value } => value
    _ => {
      return Result<Index<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  return Result<Index<'a>, ReadError>.succeed(index)
}

impl<'a> Cff<'a> {
  pub fn tag() -> Tag {
    return Tag.fromU32(1128678944)
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let header = match move CffHeader.read(data) {
      Result<CffHeader<'a>, ReadError>.Success { value } => value
      Result<CffHeader<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let mut tail = ScalarArray<u8>.offsetData(&CffHeader.trailingData(&header))
    let names = match move cffReadIndexAndAdvance(&mut tail) {
      Result<Index<'a>, ReadError>.Success { value } => value
      Result<Index<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let dicts = match move cffReadIndexAndAdvance(&mut tail) {
      Result<Index<'a>, ReadError>.Success { value } => value
      Result<Index<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let strings = match move cffReadIndexAndAdvance(&mut tail) {
      Result<Index<'a>, ReadError>.Success { value } => value
      Result<Index<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let subrs = match move Index.read(tail) {
      Result<Index<'a>, ReadError>.Success { value } => value
      Result<Index<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        _header: header,
        _names: names,
        _topDicts: dicts,
        _strings: strings,
        _globalSubrs: subrs,
      },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return CffHeader.offsetData(&self._header)
  }

  pub fn header(self: &Self) -> CffHeader<'a> {
    return self._header
  }

  pub fn names(self: &Self) -> Index<'a> {
    return self._names
  }

  pub fn name(self: &Self, index: usize) -> Option<&'a [u8]> {
    return Index.get(&self._names, index)
  }

  pub fn topDicts(self: &Self) -> Index<'a> {
    return self._topDicts
  }

  pub fn strings(self: &Self) -> Index<'a> {
    return self._strings
  }

  pub fn string(self: &Self, id: Sid) -> Option<&'a [u8]> {
    return match move Sid.resolveStandard(id) {
      Result<&'static [u8], usize>.Success { value } => Option<&'a [u8]>.some(value)
      Result<&'static [u8], usize>.Failure { error } => Index.get(&self._strings, error)
    }
  }

  pub fn globalSubrs(self: &Self) -> Index<'a> {
    return self._globalSubrs
  }

  pub fn charset(self: &Self, topDictIndex: usize) -> Option<Charset<'a>> {
    let dict = match move Index.get(&self._topDicts, topDictIndex) {
      Option<&'a [u8]>.Some { value } => value
      _ => {
        return Option<Charset<'a>>.None
      }
    }
    let data = Cff.offsetData(self)
    let mut charsetOffset: usize = 0
    let mut count: u32 = 0
    let mut hasCharset = false
    let mut hasCount = false
    let mut iter = entries(dict, Option<BlendState<'a, 'static>>.None)
    while true {
      let result = match move Entries.next(&mut iter) {
        Option<Result<Entry, Error>>.Some { value } => move value
        _ => {
          break
        }
      }
      match move result {
        Result<Entry, Error>.Success { value: Entry.Charset { value } } => {
          charsetOffset = value
          hasCharset = true
        }
        Result<Entry, Error>.Success { value: Entry.CharstringsOffset { value } } => {
          let tail = match move FontData.splitOff(&data, value) {
            Option<FontData<'a>>.Some { value: tail } => tail
            _ => {
              return Option<Charset<'a>>.None
            }
          }
          let index = match move Index.read(tail) {
            Result<Index<'a>, ReadError>.Success { value: table } => table
            _ => {
              return Option<Charset<'a>>.None
            }
          }
          count = u16.toU32(Index.count(&index))
          hasCount = true
        }
        Result<Entry, Error>.Success { value: Entry.Ros { registry, ordering, supplement } } => {
          return Option<Charset<'a>>.None
        }
        _ => {}
      }
    }
    if !hasCharset || !hasCount {
      return Option<Charset<'a>>.None
    }
    return Charset.new(data, charsetOffset, count)
  }
}

impl<'a> TopLevelTable for Cff<'a> {
  fn tag() -> Tag {
    return Cff.tag()
  }
}

impl<'a> FontRead<'a, ()> for Cff<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cff.read(data)
  }
}
