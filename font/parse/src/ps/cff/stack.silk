import ps.cff.blend { BlendState, Scalars }
import model.error { Error }
import ps.read { take, require }
import font_types.lib { Fixed }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.num.i32
import silk.num.usize
import silk.num.u64

pub union Number {
  I32 { pub value: i32 },
  Fixed { pub value: Fixed },
}

impl Copy for Number {}

pub interface IntoNumber {
  fn intoNumber(self: Self) -> Number
}

impl IntoNumber for i32 {
  fn intoNumber(self: i32) -> Number {
    return Number.I32 { value: self }
  }
}

impl IntoNumber for Fixed {
  fn intoNumber(self: Fixed) -> Number {
    return Number.Fixed { value: self }
  }
}

impl IntoNumber for Number {
  fn intoNumber(self: Number) -> Number {
    return self
  }
}

fn intoNumber<T: IntoNumber>(number: T) -> Number {
  return IntoNumber.intoNumber(move number)
}

pub struct Stack {
  values: [i32; 513],
  // One bit per value: a `[bool; 513]` repeat literal is filled byte by byte.
  fixedBits: [u64; 9],
  top: usize,
}

impl Stack {
  pub fn new() -> Self with Intrinsic.inlineAlways() {
    return Self { values: [0; 513], fixedBits: [0; 9], top: 0 }
  }

  pub fn default() -> Self {
    return Stack.new()
  }

  fn isFixed(self: &Self, index: usize) -> bool with Intrinsic.inlineAlways() {
    return (u64.shiftRight(self.fixedBits[usize.shiftRight(index, 6)], usize.toU64(index & 63)) & 1)
      != 0
  }

  fn setFixed(self: &mut Self, index: usize, fixed: bool) with Intrinsic.inlineAlways() {
    let word = usize.shiftRight(index, 6)
    let bit = u64.shiftLeft(1, usize.toU64(index & 63))
    if fixed {
      self.fixedBits[word] = self.fixedBits[word] | bit
    } else {
      self.fixedBits[word] = self.fixedBits[word] & u64.bitNot(bit)
    }
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.top == 0
  }

  pub fn len(self: &Self) -> usize {
    return self.top
  }

  pub fn lenIsOdd(self: &Self) -> bool {
    return self.top & 1 != 0
  }

  pub fn clear(self: &mut Self) {
    self.top = 0
  }

  pub fn dropValues(self: &mut Self, n: usize) {
    self.top = usize.saturatingSubtract(self.top, n)
  }

  pub fn exch(self: &mut Self) -> Result<(), Error> {
    if self.top < 2 {
      return Result<(), Error>.failResult(Error.InvalidOperation)
    }
    let a = self.top - 1
    let b = a - 1
    let value = self.values[a]
    let flag = Stack.isFixed(&self, a)
    self.values[a] = self.values[b]
    let other = Stack.isFixed(&self, b)
    Stack.setFixed(&mut self, a, other)
    self.values[b] = value
    Stack.setFixed(&mut self, b, flag)
    return Result<(), Error>.succeed(())
  }

  pub fn push<T: IntoNumber>(self: &mut Self, number: T) -> Result<
    (),
    Error
  > with Intrinsic.inlineAlways() {
    let index = self.top
    if index >= 513 {
      return Result<(), Error>.failResult(Error.LimitExceeded)
    }
    match intoNumber(move number) {
      Number.I32 { value } => {
        self.values[index] = value
        Stack.setFixed(&mut self, index, false)
      }
      Number.Fixed { value } => {
        self.values[index] = Fixed.toBits(value)
        Stack.setFixed(&mut self, index, true)
      }
    }
    self.top = index + 1
    return Result<(), Error>.succeed(())
  }

  pub fn set<T: IntoNumber>(self: &mut Self, index: usize, number: T) -> Result<(), Error> {
    if index >= self.top {
      return Result<(), Error>.failResult(Error.LimitExceeded)
    }
    match intoNumber(move number) {
      Number.I32 { value } => {
        self.values[index] = value
        Stack.setFixed(&mut self, index, false)
      }
      Number.Fixed { value } => {
        self.values[index] = Fixed.toBits(value)
        Stack.setFixed(&mut self, index, true)
      }
    }
    return Result<(), Error>.succeed(())
  }

  pub fn getI32(self: &Self, index: usize) -> Result<i32, Error> {
    if index >= 513 {
      return Result<i32, Error>.succeed(0)
    }
    if Stack.isFixed(&self, index) {
      return Result<i32, Error>.failResult(Error.InvalidOperation)
    }
    return Result<i32, Error>.succeed(self.values[index])
  }

  pub fn getFixed(self: &Self, index: usize) -> Result<Fixed, Error> {
    if index >= 513 {
      return Result<Fixed, Error>.succeed(Fixed.zero())
    }
    if Stack.isFixed(&self, index) {
      return Result<Fixed, Error>.succeed(Fixed.fromBits(self.values[index]))
    }
    return Result<Fixed, Error>.succeed(Fixed.fromI32(self.values[index]))
  }

  fn pop(self: &mut Self) -> usize {
    if self.top > 0 {
      self.top = self.top - 1
    }
    return self.top
  }

  pub fn popI32(self: &mut Self) -> Result<i32, Error> {
    let index = Stack.pop(&mut self)
    return Stack.getI32(&self, index)
  }

  pub fn popFixed(self: &mut Self) -> Result<Fixed, Error> {
    let index = Stack.pop(&mut self)
    return Stack.getFixed(&self, index)
  }

  pub fn fixedValues<'s>(self: &'s Self) -> FixedValues<'s> {
    return FixedValues<'s> { stack: self, index: 0 }
  }

  // Caller-owned output replaces Rust's const-generic return array.
  pub fn fixedArray(self: &Self, firstIndex: usize, output: &mut [Fixed]) -> Result<
    (),
    Error
  > with Intrinsic.inlineAlways() {
    let mut available: usize = 0
    if firstIndex < self.top {
      available = self.top - firstIndex
    }
    if available > output.length {
      available = output.length
    }
    let mut i: usize = 0
    while i < available {
      let index = firstIndex + i
      let bits = self.values[index]
      if Stack.isFixed(&self, index) {
        output[i] = Fixed.fromBits(bits)
      } else {
        output[i] = Fixed.fromI32(bits)
      }
      i = i + 1
    }
    while i < output.length {
      output[i] = Fixed.zero()
      i = i + 1
    }
    return Result<(), Error>.succeed(())
  }

  pub fn applyDeltaPrefixSum(self: &mut Self) {
    if self.top <= 1 {
      return
    }
    let mut sum = Fixed.zero()
    let mut i: usize = 0
    while i < self.top {
      let mut value = Fixed.fromI32(self.values[i])
      if Stack.isFixed(&self, i) {
        value = Fixed.fromBits(self.values[i])
      }
      sum = Fixed.wrappingAdd(sum, value)
      self.values[i] = Fixed.toBits(sum)
      Stack.setFixed(&mut self, i, true)
      i = i + 1
    }
  }

  pub fn applyBlend<'a, 'c>(self: &mut Self, state: &BlendState<'a, 'c>) -> Result<(), Error> {
    return run Effect.result(Stack.applyBlendImpl(&mut self, state))
  }

  effect fn applyBlendImpl<'a, 'c>(self: &mut Self, state: &BlendState<'a, 'c>) -> ()
    ! Error {
    let targetRaw = run take(Stack.popI32(&mut self))
    if targetRaw < 0 || i32.toUsize(targetRaw) > self.top {
      fail Error.InvalidOperation
    }
    let targets = i32.toUsize(targetRaw)
    let regions = run take(BlendState.regionCount(state))
    let regionCount = run require(usize.checkedAdd(regions, 1), Error.InvalidOperation)
    let operands = run require(usize.checkedMultiply(targets, regionCount), Error.InvalidOperation)
    if self.top < operands {
      fail Error.InvalidOperation
    }
    let start = self.top - operands
    let end = start + operands
    let mut i = start
    while i < end {
      if !Stack.isFixed(&self, i) {
        self.values[i] = Fixed.toBits(Fixed.fromI32(self.values[i]))
        Stack.setFixed(&mut self, i, true)
      }
      i = i + 1
    }
    let mut scalars = run take(BlendState.scalars(state))
    let mut regionIndex: usize = 0
    while true {
      let scalar = match move Scalars.next(&mut scalars) {
        Option<Result<Fixed, Error>>.Some { value } => run take(move value)
        _ => {
          break
        }
      }
      if Fixed.toBits(scalar) != 0 {
        let mut valueIndex: usize = 0
        while valueIndex < targets {
          let deltaIndex = start + targets + regions * valueIndex + regionIndex
          let delta = Fixed.fromBits(self.values[deltaIndex])
          self.values[start + valueIndex] = Fixed.toBits(
            Fixed.wrappingAdd(Fixed.fromBits(self.values[start + valueIndex]), delta * scalar),
          )
          valueIndex = valueIndex + 1
        }
      }
      regionIndex = regionIndex + 1
    }
    self.top = start + targets
  }

  pub fn roll(self: &mut Self, count: i32, shift: i32) -> Result<(), Error> {
    if count < 2 {
      return Result<(), Error>.succeed(())
    }
    let amount = i32.toUsize(count)
    if amount > self.top {
      return Result<(), Error>.failResult(Error.InvalidOperation)
    }
    let offset = self.top - amount
    let mut rotation = shift % count
    if shift < 0 {
      rotation = -(i32.wrappingNegate(shift) % count)
    }
    if rotation == 0 {
      return Result<(), Error>.succeed(())
    }
    let mut startIndex: i32 = -1
    let mut index: i32 = -1
    let mut last: i32 = 0
    let mut lastFixed = false
    let mut i: usize = 0
    while i < amount {
      if startIndex == index {
        startIndex = startIndex + 1
        index = startIndex
        let u = offset + i32.toUsize(index)
        last = self.values[u]
        lastFixed = Stack.isFixed(&self, u)
      }
      index = index + rotation
      if index >= count {
        index = index - count
      } else if index < 0 {
        index = index + count
      }
      let u = offset + i32.toUsize(index)
      let value = self.values[u]
      let flag = Stack.isFixed(&self, u)
      self.values[u] = last
      Stack.setFixed(&mut self, u, lastFixed)
      last = value
      lastFixed = flag
      i = i + 1
    }
    return Result<(), Error>.succeed(())
  }

  pub fn div(self: &mut Self, isType1: bool) -> Result<(), Error> {
    return run Effect.result(Stack.divImpl(&mut self, isType1))
  }

  effect fn divImpl(self: &mut Self, isType1: bool) -> ()
    ! Error {
    let bIndex = Stack.pop(&mut self)
    let aIndex = Stack.pop(&mut self)
    let mut a = Fixed.zero()
    let mut b = Fixed.zero()
    if Stack.isFixed(&self, aIndex) {
      a = run take(Stack.getFixed(&self, aIndex))
      b = run take(Stack.getFixed(&self, bIndex))
    } else {
      let integer = run take(Stack.getI32(&self, aIndex))
      if isType1 && (integer < -32000 || integer > 32000) {
        a = Fixed.fromBits(integer)
        b = Fixed.fromBits(run take(Stack.getI32(&self, bIndex)))
      } else {
        a = run take(Stack.getFixed(&self, aIndex))
        b = run take(Stack.getFixed(&self, bIndex))
      }
    }
    run take(Stack.push<Fixed>(&mut self, a / b))
  }
}

pub struct FixedValues<'s> {
  stack: &'s Stack,
  index: usize,
}

impl<'s> FixedValues<'s> {
  pub fn next(self: &mut Self) -> Option<Fixed> {
    if self.index >= self.stack.top {
      return Option<Fixed>.None
    }
    let index = self.index
    self.index = self.index + 1
    if Stack.isFixed(&self.stack, index) {
      return Option<Fixed>.some(Fixed.fromBits(self.stack.values[index]))
    }
    return Option<Fixed>.some(Fixed.fromI32(self.stack.values[index]))
  }
}
