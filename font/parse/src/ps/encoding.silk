import ps.string { Sid }
import generated_ps_data { predefinedCode, standardString }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u16

pub enum PredefinedEncoding {
  Standard,
  Expert,
  IsoLatin1,
}

impl PredefinedEncoding {
  pub fn default() -> Self {
    return PredefinedEncoding.Standard
  }

  pub fn name(self: &Self, code: u8) -> string<'static> {
    let mut encoding: u8 = 0
    if self.* == PredefinedEncoding.Expert {
      encoding = 1
    }
    if self.* == PredefinedEncoding.IsoLatin1 {
      if code == 160 {
        return "nonbreakingspace"
      }
      if code == 173 {
        return "softhyphen"
      }
      encoding = 2
    }
    let bytes = standardString(u16.toUsize(predefinedCode(encoding, code)))
      |> Option<&'static [u8]>.unwrapOr(b"")
    return String.fromUtf8(bytes) |> Result<string<'static>, InvalidUtf8>.unwrapOr("")
  }

  pub fn sid(self: &Self, code: u8) -> Option<Sid> {
    if self.* == PredefinedEncoding.IsoLatin1 {
      return Option<Sid>.None
    }
    let mut encoding: u8 = 0
    if self.* == PredefinedEncoding.Expert {
      encoding = 1
    }
    return Option<Sid>.some(Sid.new(predefinedCode(encoding, code)))
  }
}
