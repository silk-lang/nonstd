  /// Minimum y coordinate across all glyph bounding boxes.
  pub fn yMin(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[9].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yMinByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[9]
  }

  /// Maximum x coordinate across all glyph bounding boxes.
  pub fn xMax(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[10].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn xMaxByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[10]
  }

  /// Maximum y coordinate across all glyph bounding boxes.
  pub fn yMax(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[11].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yMaxByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[11]
  }

  /// Bits identifying the font's style; see [MacStyle]
  pub fn macStyle(self: &Self) -> MacStyle {
    return match move FontData<'a>.readAt<MacStyle>(&self._fontData, self._fieldRanges[12].start) {
      Result<MacStyle, ReadError>.Success { value } => value
      Result<MacStyle, ReadError>.Failure { error } => MacStyle.empty()
    }
  }

  pub fn macStyleByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[12]
  }

  /// Smallest readable size in pixels.
  pub fn lowestRecPpem(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[13].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lowestRecPpemByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[13]
  }

  /// Deprecated (Set to 2).
  pub fn fontDirectionHint(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[14].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn fontDirectionHintByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[14]
  }

  /// 0 for short offsets (Offset16), 1 for long (Offset32).
  pub fn indexToLocFormat(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[15].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn indexToLocFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[15]
  }

  /// 0 for current format.
  pub fn glyphDataFormat(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[16].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphDataFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[16]
  }
}

impl<'a> FontRead<'a, ()> for Head<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Head<'a>.read(data)
  }
}

impl<'a> TopLevelTable for Head<'a> {
  fn tag() -> Tag {
    return Head<'a>.tag()
  }
}

impl<'a> MinByteRange<'a> for Head<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[16].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[16].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}
