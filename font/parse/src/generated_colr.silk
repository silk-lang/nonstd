    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let centerYValue = scalarOr<FWord>(data, ranges[3].start, FWord.new(0))
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let startAngleValue = scalarOr<F2Dot14>(data, ranges[4].start, F2Dot14.zero())
