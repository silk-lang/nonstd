/// [ColorLine](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#color-references-colorstop-and-colorline) table
pub struct ColorLine<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for ColorLine<'a> {}

impl<'a> ColorLine<'a> {
  pub fn default() -> Self {
    return ColorLine<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[0].end = end
    let extendValue = scalarOr<Extend>(data, ranges[0].start, Extend.Pad)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let numStopsValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(numStopsValue), 6))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// An Extend enum value.
  pub fn extend(self: &Self) -> Extend {
    return match move FontData<'a>.readAt<Extend>(&self._fontData, self._fieldRanges[0].start) {
      Result<Extend, ReadError>.Success { value } => value
      Result<Extend, ReadError>.Failure { error } => Extend.Pad
    }
  }

  pub fn extendByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ColorStop records.
  pub fn numStops(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn numStopsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  pub fn colorStops(self: &Self) -> ComputedArray<'a, (), ColorStop<'a>> {
    return match move recordArray<ColorStop<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), ColorStop<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), ColorStop<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        ColorStop<'a>
      >.empty(())
    }
  }

  pub fn colorStopsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for ColorLine<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ColorLine<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ColorLine<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
