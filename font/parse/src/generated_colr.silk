/// [Extend](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#color-references-colorstop-and-colorline) enumeration
pub enum(u8) Extend {
  Pad = 0,
  Repeat = 1,
  Reflect = 2,
  Unknown,
}

impl Extend {
  pub fn new(raw: u8) -> Extend {
    return match raw {
      0 => Extend.Pad
      1 => Extend.Repeat
      2 => Extend.Reflect
      _ => Extend.Unknown
    }
  }
}

impl Extend {
  pub fn default() -> Self {
    return Extend.Pad
  }
}

impl Scalar for Extend {
  fn rawByteLen() -> usize {
    return 1
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u8>(bytes) {
      Option<u8>.Some { value } => Option<Self>.some(Extend.new(value))
      Option<u8>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u8>(Extend.value(value), move bytes)
  }
}

impl FixedSize for Extend {
  fn rawByteLen() -> usize {
    return 1
  }
}

/// [Paint](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#paint-tables) tables
pub union Paint<'a> {
  ColrLayers { pub value: PaintColrLayers<'a> },
  Solid { pub value: PaintSolid<'a> },
  VarSolid { pub value: PaintVarSolid<'a> },
  LinearGradient { pub value: PaintLinearGradient<'a> },
  VarLinearGradient { pub value: PaintVarLinearGradient<'a> },
  RadialGradient { pub value: PaintRadialGradient<'a> },
  VarRadialGradient { pub value: PaintVarRadialGradient<'a> },
  SweepGradient { pub value: PaintSweepGradient<'a> },
  VarSweepGradient { pub value: PaintVarSweepGradient<'a> },
  Glyph { pub value: PaintGlyph<'a> },
  ColrGlyph { pub value: PaintColrGlyph<'a> },
  Transform { pub value: PaintTransform<'a> },
  VarTransform { pub value: PaintVarTransform<'a> },
  Translate { pub value: PaintTranslate<'a> },
  VarTranslate { pub value: PaintVarTranslate<'a> },
  Scale { pub value: PaintScale<'a> },
  VarScale { pub value: PaintVarScale<'a> },
  ScaleAroundCenter { pub value: PaintScaleAroundCenter<'a> },
  VarScaleAroundCenter { pub value: PaintVarScaleAroundCenter<'a> },
  ScaleUniform { pub value: PaintScaleUniform<'a> },
  VarScaleUniform { pub value: PaintVarScaleUniform<'a> },
  ScaleUniformAroundCenter { pub value: PaintScaleUniformAroundCenter<'a> },
  VarScaleUniformAroundCenter { pub value: PaintVarScaleUniformAroundCenter<'a> },
  Rotate { pub value: PaintRotate<'a> },
  VarRotate { pub value: PaintVarRotate<'a> },
  RotateAroundCenter { pub value: PaintRotateAroundCenter<'a> },
  VarRotateAroundCenter { pub value: PaintVarRotateAroundCenter<'a> },
  Skew { pub value: PaintSkew<'a> },
  VarSkew { pub value: PaintVarSkew<'a> },
  SkewAroundCenter { pub value: PaintSkewAroundCenter<'a> },
  VarSkewAroundCenter { pub value: PaintVarSkewAroundCenter<'a> },
  Composite { pub value: PaintComposite<'a> },
  Glyph2 { pub value: PaintGlyph2<'a> },
}

impl<'a> Copy for Paint<'a> {}

impl<'a> Paint<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u8>(&data, 0) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move PaintColrLayers<'a>.read(data) {
          Result<PaintColrLayers<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Paint<'a>.ColrLayers { value: value })
          Result<PaintColrLayers<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move PaintSolid<'a>.read(data) {
          Result<PaintSolid<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
            Paint<'a>.Solid { value: value },
          )
          Result<PaintSolid<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(
            error,
          )
        }
      }
