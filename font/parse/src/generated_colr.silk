    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[1].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn numClipsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Clip records. Sorted by startGlyphID.
  pub fn clips(self: &Self) -> ComputedArray<'a, (), Clip<'a>> {
    return match move recordArray<Clip<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), Clip<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), Clip<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        Clip<'a>
      >.empty(())
    }
  }

  pub fn clipsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for ClipList<'a> {
