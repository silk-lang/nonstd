/// [ClipBoxFormat2](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#baseglyphlist-layerlist-and-cliplist) record
pub struct ClipBoxFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for ClipBoxFormat2<'a> {}

impl<'a> ClipBoxFormat2<'a> {
  pub fn minSize() -> usize {
    return 13
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 13 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[0].end = end
    let formatValue = scalarOr<u8>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let xMinValue = scalarOr<FWord>(data, ranges[1].start, FWord.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let yMinValue = scalarOr<FWord>(data, ranges[2].start, FWord.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let xMaxValue = scalarOr<FWord>(data, ranges[3].start, FWord.new(0))
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let yMaxValue = scalarOr<FWord>(data, ranges[4].start, FWord.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[5].end = end
    let varIndexBaseValue = scalarOr<u32>(data, ranges[5].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Set to 2.
  pub fn format(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[0].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Minimum x of clip box. For variation, use varIndexBase + 0.
  pub fn xMin(self: &Self) -> FWord {
    return match move FontData<'a>.readAt<FWord>(&self._fontData, self._fieldRanges[1].start) {
      Result<FWord, ReadError>.Success { value } => value
      Result<FWord, ReadError>.Failure { error } => FWord.new(0)
    }
  }

  pub fn xMinByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Minimum y of clip box. For variation, use varIndexBase + 1.
  pub fn yMin(self: &Self) -> FWord {
