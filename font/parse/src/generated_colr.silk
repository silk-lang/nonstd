  pub fn paintOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, (self.position + 2)) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn paint(self: &Self, data: FontData<'a>) -> Result<Paint<'a>, ReadError> {
    let offset = BaseGlyphPaint<'a>.paintOffset(self)
    return resolveWithArgs<(), Paint<'a>, Offset32>(offset, data, ())
  }
}

