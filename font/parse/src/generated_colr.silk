/// [Clip](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#baseglyphlist-layerlist-and-cliplist) record
pub struct Clip<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for Clip<'a> {}

impl<'a> Clip<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 7 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph ID in the range.
  pub fn startGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Last glyph ID in the range.
  pub fn endGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 2)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Offset to a ClipBox table, from the beginning of the [`ClipList`] table.
  pub fn clipBoxOffset(self: &Self) -> Offset24 {
    return match move FontData<'a>.readAt<Offset24>(&self._fontData, (self.position + 4)) {
      Result<Offset24, ReadError>.Success { value } => value
      Result<Offset24, ReadError>.Failure { error } => Offset24.new(Uint24.new(0))
    }
  }

  pub fn clipBox(self: &Self, data: FontData<'a>) -> Result<ClipBox<'a>, ReadError> {
    let offset = Clip<'a>.clipBoxOffset(self)
    return resolveWithArgs<(), ClipBox<'a>, Offset24>(offset, data, ())
  }
}

impl<'a> FixedSize for Clip<'a> {
  fn rawByteLen() -> usize {
    return 7
  }
}

impl<'a> ComputeSize<()> for Clip<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(7)
  }
}

impl<'a> FontReadAt<'a, ()> for Clip<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return Clip<'a>.readAt(data, position, ())
  }
}

/// [ClipBox](https://learn.microsoft.com/en-us/typography/opentype/spec/colr#baseglyphlist-layerlist-and-cliplist) table
pub union ClipBox<'a> {
  Format1 { pub value: ClipBoxFormat1<'a> },
  Format2 { pub value: ClipBoxFormat2<'a> },
}

impl<'a> Copy for ClipBox<'a> {}

impl<'a> ClipBox<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u8>(&data, 0) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move ClipBoxFormat1<'a>.read(data) {
          Result<ClipBoxFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClipBox<'a>.Format1 { value: value })
          Result<ClipBoxFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ClipBoxFormat2<'a>.read(data) {
          Result<ClipBoxFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClipBox<'a>.Format2 { value: value })
          Result<ClipBoxFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u8.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.offsetData(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.offsetData(&value)
    }
  }

  /// Set to 1.
  pub fn format(self: &Self) -> u8 {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.format(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.format(&value)
    }
  }

  /// Minimum x of clip box.
  pub fn xMin(self: &Self) -> FWord {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.xMin(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.xMin(&value)
    }
  }

  /// Minimum y of clip box.
  pub fn yMin(self: &Self) -> FWord {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.yMin(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.yMin(&value)
    }
  }

  /// Maximum x of clip box.
  pub fn xMax(self: &Self) -> FWord {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.xMax(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.xMax(&value)
    }
  }

  /// Maximum y of clip box.
  pub fn yMax(self: &Self) -> FWord {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => ClipBoxFormat1<'a>.yMax(&value)
      ClipBox<'a>.Format2 { value } => ClipBoxFormat2<'a>.yMax(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for ClipBox<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ClipBox<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ClipBox<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      ClipBox<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      ClipBox<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      ClipBox<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> ClipBox<'a> {
  pub fn default() -> Self {
    return ClipBox<'a>.Format1 { value: ClipBoxFormat1<'a>.default() }
  }
}

