      Result<ComputedArray<'a, (), UvsMapping24<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), UvsMapping24<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        UvsMapping24<'a>
      >.empty(())
    }
  }

  pub fn uvsMappingByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

