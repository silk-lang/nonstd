/// [cmap Format 14](https://docs.microsoft.com/en-us/typography/opentype/spec/cmap#format-14-unicode-variation-sequences): Unicode Variation Sequences
pub struct Cmap14<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for Cmap14<'a> {}

impl<'a> Cmap14<'a> {
  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let lengthValue = scalarOr<u32>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let numVarSelectorRecordsValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(numVarSelectorRecordsValue), 11),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Subtable format. Set to 14.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Byte length of this subtable (including this header)
  pub fn length(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[1].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn lengthByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of variation Selector Records
  pub fn numVarSelectorRecords(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn numVarSelectorRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of VariationSelector records.
  pub fn varSelector(self: &Self) -> ComputedArray<'a, (), VariationSelector<'a>> {
    return match move recordArray<VariationSelector<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), VariationSelector<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), VariationSelector<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), VariationSelector<'a>>.empty(())
    }
  }

  pub fn varSelectorByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for Cmap14<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cmap14<'a>.read(data)
  }
}

impl<'a> Format<u16> for Cmap14<'a> {
  fn formatValue() -> u16 {
    return 14
  }
}

impl<'a> MinByteRange<'a> for Cmap14<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

