/// Used in [Cmap8] and [Cmap12]
pub struct SequentialMapGroup<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for SequentialMapGroup<'a> {}

impl<'a> SequentialMapGroup<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 12 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First character code in this group; note that if this group is
  /// for one or more 16-bit character codes (which is determined
  /// from the is32 array), this 32-bit value will have the high
  /// 16-bits set to zero
  pub fn startCharCode(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 0)) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  /// Last character code in this group; same condition as listed
  /// above for the startCharCode
  pub fn endCharCode(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 4)) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  /// Glyph index corresponding to the starting character code
  pub fn startGlyphId(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, (self.position + 8)) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for SequentialMapGroup<'a> {
  fn rawByteLen() -> usize {
    return 12
  }
}

impl<'a> ComputeSize<()> for SequentialMapGroup<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(12)
  }
}

impl<'a> FontReadAt<'a, ()> for SequentialMapGroup<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return SequentialMapGroup<'a>.readAt(data, position, ())
  }
}

