    end = usize.saturatingAdd(end, usize.saturatingMultiply(256, 1))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 0.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// This is the length in bytes of the subtable.
  pub fn length(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lengthByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// For requirements on use of the language field, see “Use of
  /// the language field in 'cmap' subtables” in this document.
  pub fn language(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn languageByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// An array that maps character codes to glyph index values.
  pub fn glyphIdArray(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn glyphIdArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for Cmap0<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cmap0<'a>.read(data)
  }
}

impl<'a> Format<u16> for Cmap0<'a> {
  fn formatValue() -> u16 {
    return 0
  }
}

impl<'a> MinByteRange<'a> for Cmap0<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [cmap Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/cmap#format-2-high-byte-mapping-through-table): High-byte mapping through table
pub struct Cmap2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for Cmap2<'a> {}

impl<'a> Cmap2<'a> {
  pub fn minSize() -> usize {
    return 518
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 518 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let lengthValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let languageValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(256, 2))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 2.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// This is the length in bytes of the subtable.
  pub fn length(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lengthByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// For requirements on use of the language field, see “Use of
  /// the language field in 'cmap' subtables” in this document.
  pub fn language(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn languageByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array that maps high bytes to subHeaders: value is subHeader
  /// index × 8.
  pub fn subHeaderKeys(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn subHeaderKeysByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for Cmap2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cmap2<'a>.read(data)
  }
}

impl<'a> Format<u16> for Cmap2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for Cmap2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [Cmap2]
pub struct SubHeader<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for SubHeader<'a> {}

impl<'a> SubHeader<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First valid low byte for this SubHeader.
  pub fn firstCode(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Number of valid low bytes for this SubHeader.
  pub fn entryCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 2)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// See text below.
  pub fn idDelta(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, (self.position + 4)) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  /// See text below.
  pub fn idRangeOffset(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 6)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for SubHeader<'a> {
  fn rawByteLen() -> usize {
    return 8
  }
}

impl<'a> ComputeSize<()> for SubHeader<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(8)
  }
}

impl<'a> FontReadAt<'a, ()> for SubHeader<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return SubHeader<'a>.readAt(data, position, ())
  }
}

/// [cmap Format 4](https://docs.microsoft.com/en-us/typography/opentype/spec/cmap#format-4-segment-mapping-to-delta-values): Segment mapping to delta values
pub struct Cmap4<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 13],
}

impl<'a> Copy for Cmap4<'a> {}

impl<'a> Cmap4<'a> {
  pub fn minSize() -> usize {
    return 16
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 16 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 13] = [ByteRange { start: 0, end: 0 }; 13]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let lengthValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let languageValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let segCountX2Value = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let searchRangeValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let entrySelectorValue = scalarOr<u16>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let rangeShiftValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply((u16.toUsize(segCountX2Value) / 2), 2))
    ranges[7].end = end
    ranges[8].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[8].end = end
    let reservedPadValue = scalarOr<u16>(data, ranges[8].start, 0)
    ranges[9].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply((u16.toUsize(segCountX2Value) / 2), 2))
    ranges[9].end = end
    ranges[10].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply((u16.toUsize(segCountX2Value) / 2), 2))
    ranges[10].end = end
    ranges[11].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply((u16.toUsize(segCountX2Value) / 2), 2))
    ranges[11].end = end
    ranges[12].start = end
    end = usize.saturatingAdd(end, (usize.saturatingSubtract(FontData.len(&data), end) / 2 * 2))
    ranges[12].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 4.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// This is the length in bytes of the subtable.
  pub fn length(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lengthByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// For requirements on use of the language field, see “Use of
  /// the language field in 'cmap' subtables” in this document.
  pub fn language(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn languageByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// 2 × segCount.
  pub fn segCountX2(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn segCountX2ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Maximum power of 2 less than or equal to segCount, times 2
  /// ((2**floor(log2(segCount))) * 2, where “**” is an
  /// exponentiation operator)
  pub fn searchRange(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn searchRangeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Log2 of the maximum power of 2 less than or equal to numTables
  /// (log2(searchRange/2), which is equal to floor(log2(segCount)))
  pub fn entrySelector(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[5].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn entrySelectorByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// segCount times 2, minus searchRange ((segCount * 2) -
  /// searchRange)
  pub fn rangeShift(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn rangeShiftByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// End characterCode for each segment, last=0xFFFF.
  pub fn endCode(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn endCodeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }

  pub fn reservedPadByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[8]
  }

  /// Start character code for each segment.
  pub fn startCode(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[9].start,
      self._fieldRanges[9].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn startCodeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[9]
  }

  /// Delta for all character codes in segment.
  pub fn idDelta(self: &Self) -> ScalarArray<'a, i16> {
    return match move FontData<'a>.readArray<i16>(
      &self._fontData,
      self._fieldRanges[10].start,
      self._fieldRanges[10].end,
    ) {
      Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => ScalarArray<i16>.empty()
    }
  }

  pub fn idDeltaByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[10]
  }

  /// Offsets into glyphIdArray or 0
  pub fn idRangeOffsets(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[11].start,
      self._fieldRanges[11].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn idRangeOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[11]
  }

  /// Glyph index array (arbitrary length)
  pub fn glyphIdArray(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[12].start,
      self._fieldRanges[12].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn glyphIdArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[12]
  }
}

impl<'a> FontRead<'a, ()> for Cmap4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cmap4<'a>.read(data)
  }
}

impl<'a> Format<u16> for Cmap4<'a> {
  fn formatValue() -> u16 {
    return 4
  }
}

impl<'a> MinByteRange<'a> for Cmap4<'a> {
