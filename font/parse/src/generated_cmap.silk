// Handwritten extension from font/parse/src/tables/cmap_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
// Handwritten algorithms; concatenated into the generated type module.
import font { FontRef }
import tables.maxp { SelectedMaxp }
import silk.collections.slice { Slice }

pub union MapVariant {
  UseDefault,
  Variant { pub glyph: GlyphId },
}

impl Copy for MapVariant {}

impl Equal for MapVariant {
  fn equals(left: &Self, right: &Self) -> bool {
    return match left.* {
      MapVariant.UseDefault => match right.* {
        MapVariant.UseDefault => true
        _ => false
      }
      MapVariant.Variant { glyph } => match right.* {
        MapVariant.Variant { glyph: other } => &glyph == &other
        _ => false
      }
    }
  }
}

pub struct CmapMapping {
  pub codepoint: u32,
  pub glyph: GlyphId,
}

impl Copy for CmapMapping {}

pub struct CmapIterLimits {
  pub maxChar: u32,
  pub glyphCount: u32,
}

impl Copy for CmapIterLimits {}

impl CmapIterLimits {
  pub fn default() -> Self {
    return Self { maxChar: 1114111, glyphCount: 65535 }
  }

  pub fn defaultForFont<'a>(font: &FontRef<'a>) -> Self {
    let count = match move FontRef<'a>.selectedMaxp(font) {
      Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp<'a>.numGlyphs(&value)
      _ => 65535
    }
    return Self { maxChar: 1114111, glyphCount: count }
  }
}

fn min32(a: u32, b: u32) -> u32 {
  if a < b {
    return a
  }
  return b
}

fn max32(a: u32, b: u32) -> u32 {
  if a > b {
    return a
  }
  return b
}

fn min64(a: u64, b: u64) -> u64 {
  if a < b {
    return a
  }
  return b
}

fn max64(a: u64, b: u64) -> u64 {
  if a > b {
    return a
  }
  return b
}

pub struct Cmap4Segment {
  index: usize,
  startCode: u16,
  first: u16,
  last: u16,
}

impl Copy for Cmap4Segment {}

impl<'a> Cmap4<'a> {
  @inlineAlways
  pub fn mapCodepoint(self: &Self, codepoint: u32) -> Option<GlyphId> {
    if codepoint > 65535 {
      return Option<GlyphId>.None
    }
    let cp = u32.toU16(codepoint)
    let segment = match move Cmap4<'a>.findSegment(self, cp) {
      Option<Cmap4Segment>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    return Cmap4<'a>.lookupGlyphId(self, cp, segment.index, segment.startCode)
  }

  pub fn mapCodepointCached(
    self: &Self,
    codepoint: u32,
    cached: &mut Option<Cmap4Segment>,
  ) -> Option<GlyphId> {
    if codepoint > 65535 {
      return Option<GlyphId>.None
    }
    let cp = u32.toU16(codepoint)
    if let Option<Cmap4Segment>.Some { value } = &cached.* {
      if cp >= value.first && cp <= value.last {
        return Cmap4<'a>.lookupGlyphId(self, cp, value.index, value.startCode)
      }
    }
    let segment = match move Cmap4<'a>.findSegment(self, cp) {
      Option<Cmap4Segment>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    let glyph = Cmap4<'a>.lookupGlyphId(self, cp, segment.index, segment.startCode)
    cached.* = Option<Cmap4Segment>.some(segment)
    return move glyph
  }

  @inlineAlways
  fn findSegment(self: &Self, cp: u16) -> Option<Cmap4Segment> {
    let starts = ScalarArray<'a, u16>.bytes(&Cmap4<'a>.startCode(self))
    let ends = ScalarArray<'a, u16>.bytes(&Cmap4<'a>.endCode(self))
    let mut lo: usize = 0
    let mut hi = u16.toUsize(Cmap4<'a>.segCountX2(self)) / 2
    if starts.length / 2 < hi {
      hi = starts.length / 2
    }
    if ends.length / 2 < hi {
      hi = ends.length / 2
    }
    if hi == 0 {
      return Option<Cmap4Segment>.None
    }

    // Every probe starts at or below `limit` in both arrays; checking that once lets the
    // per-byte bounds checks fold away.
    let limit = usize.wrappingSubtract(usize.wrappingMultiply(hi, 2), 2)
    let startBytes = Slice.view<u8>(starts, 0, limit + 2)
    let endBytes = Slice.view<u8>(ends, 0, limit + 2)
    let mut first: u16 = 0
    let mut last: u16 = 65535
    while lo < hi {
      // i < hi <= the array lengths, so the probes are in bounds and the arithmetic cannot wrap.
      let i = usize.wrappingAdd(lo, (hi - lo) / 2)
      let at = usize.wrappingMultiply(i, 2)
      if at > limit {
        return Option<Cmap4Segment>.None
      }
      let start = readU16(startBytes, at)
      let end = readU16(endBytes, at)
      if cp < start {
        hi = i
        last = u32.toU16(min32(u16.toU32(last), u16.toU32(u16.saturatingSubtract(start, 1))))
      } else if cp > end {
        lo = usize.wrappingAdd(i, 1)
        first = u32.toU16(max32(u16.toU32(first), u16.toU32(u16.saturatingAdd(end, 1))))
      } else {
        return Option<Cmap4Segment>.some(
          Cmap4Segment {
            index: i,
            startCode: start,
            first: u32.toU16(max32(u16.toU32(start), u16.toU32(first))),
            last: u32.toU16(min32(u16.toU32(end), u16.toU32(last))),
          },
        )
      }
    }
    return Option<Cmap4Segment>.None
  }

  fn lookupGlyphId(self: &Self, codepoint: u16, index: usize, startCode: u16) -> Option<GlyphId> {
    let delta = match move ScalarArray<'a, i16>.get(&Cmap4<'a>.idDelta(self), index) {
      Option<i16>.Some { value } => i16.toI32(value)
      _ => {
        return Option<GlyphId>.None
      }
    }
    let offsets = Cmap4<'a>.idRangeOffsets(self)
    let rangeOffset = match move ScalarArray<'a, u16>.get(&offsets, index) {
      Option<u16>.Some { value } => u16.toUsize(value)
      _ => {
        return Option<GlyphId>.None
      }
    }
    if rangeOffset == 0 {
      return Option<GlyphId>.some(GlyphId.new(u16.toU32(wrappedDelta(codepoint, delta))))
    }
    let offset = match move usize.checkedSubtract(
      rangeOffset / 2 + u16.toUsize(codepoint - startCode),
      ScalarArray<'a, u16>.len(&offsets) - index,
    ) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    let gid = match move ScalarArray<'a, u16>.get(&Cmap4<'a>.glyphIdArray(self), offset) {
      Option<u16>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if gid == 0 {
      return Option<GlyphId>.None
    }
    return Option<GlyphId>.some(GlyphId.new(u16.toU32(wrappedDelta(gid, delta))))
  }

  pub fn iter(self: &Self) -> Cmap4Iter<'a> {
    let mut iter = Cmap4Iter<'a> { table: self.*, position: 0, end: 0, startCode: 0, index: 0 }
    drop Cmap4Iter<'a>.loadRange(&mut iter, 0)
    return iter
  }
}

@inlineAlways
fn wrappedDelta(value: u16, delta: i32) -> u16 {
  let sum = u16.toI32(value) + delta

  // At most one wrap is needed: u16 plus i16 is in [-32768, 98302].
  if sum < 0 {
    return i32.toU16(sum + 65536)
  }
  if sum > 65535 {
    return i32.toU16(sum - 65536)
  }
  return i32.toU16(sum)
}

pub struct Cmap4Iter<'a> {
  table: Cmap4<'a>,
  position: u32,
  end: u32,
  startCode: u16,
  index: usize,
}

impl<'a> Copy for Cmap4Iter<'a> {}

impl<'a> Cmap4Iter<'a> {
  fn loadRange(self: &mut Self, index: usize) -> bool {
    let start = match move ScalarArray<'a, u16>.get(&Cmap4<'a>.startCode(&self.table), index) {
      Option<u16>.Some { value } => value
      _ => {
        return false
      }
    }
    let end = match move ScalarArray<'a, u16>.get(&Cmap4<'a>.endCode(&self.table), index) {
      Option<u16>.Some { value } => value
      _ => {
        return false
      }
    }
    self.position = max32(u16.toU32(start), self.end)
    self.end = max32(u16.toU32(end) + 1, self.end)
    self.startCode = start
    return true
  }

  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    while true {
      if self.position < self.end {
        let cp = self.position
        self.position = self.position + 1
        if let Option<GlyphId>.Some { value } = move Cmap4<'a>.lookupGlyphId(
          &self.table,
          u32.toU16(cp),
          self.index,
          self.startCode,
        ) {
          return Option<CmapMapping>.some(CmapMapping { codepoint: cp, glyph: value })
        }
      } else {
        self.index = self.index + 1
        let nextIndex = self.index
        if !Cmap4Iter<'a>.loadRange(&mut self, nextIndex) {
          return Option<CmapMapping>.None
        }
      }
    }
  }
}

impl<'a> Cmap0<'a> {
  pub fn mapCodepoint(self: &Self, codepoint: u32) -> Option<GlyphId> {
    let first: u32 = 0
    if codepoint < first {
      return Option<GlyphId>.None
    }
    return match move ScalarArray<'a, u8>.get(
      &Cmap0<'a>.glyphIdArray(self),
      u32.toUsize(codepoint - first),
    ) {
      Option<u8>.Some { value } => Option<GlyphId>.some(GlyphId.new(u8.toU32(value)))
      _ => Option<GlyphId>.None
    }
  }

  pub fn iter(self: &Self) -> Cmap0Iter<'a> {
    return Cmap0Iter<'a> { first: 0, glyphIds: Cmap0<'a>.glyphIdArray(self), position: 0 }
  }
}

pub struct Cmap0Iter<'a> {
  first: u32,
  glyphIds: ScalarArray<'a, u8>,
  position: u32,
}

impl<'a> Copy for Cmap0Iter<'a> {}

impl<'a> Cmap0Iter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    let glyph = match move ScalarArray<'a, u8>.get(&self.glyphIds, u32.toUsize(self.position)) {
      Option<u8>.Some { value } => GlyphId.new(u8.toU32(value))
      _ => {
        return Option<CmapMapping>.None
      }
    }
    let codepoint = u32.wrappingAdd(self.first, self.position)
    self.position = self.position + 1
    return Option<CmapMapping>.some(CmapMapping { codepoint: codepoint, glyph: glyph })
  }
}

impl<'a> Cmap6<'a> {
  pub fn mapCodepoint(self: &Self, codepoint: u32) -> Option<GlyphId> {
    let first: u32 = u16.toU32(Cmap6<'a>.firstCode(self))
    if codepoint < first {
      return Option<GlyphId>.None
    }
    return match move ScalarArray<'a, u16>.get(
      &Cmap6<'a>.glyphIdArray(self),
      u32.toUsize(codepoint - first),
    ) {
      Option<u16>.Some { value } => Option<GlyphId>.some(GlyphId.new(u16.toU32(value)))
      _ => Option<GlyphId>.None
    }
  }

  pub fn iter(self: &Self) -> Cmap6Iter<'a> {
    return Cmap6Iter<'a> {
      first: u16.toU32(Cmap6<'a>.firstCode(self)),
      glyphIds: Cmap6<'a>.glyphIdArray(self),
      position: 0,
    }
  }
}

pub struct Cmap6Iter<'a> {
  first: u32,
  glyphIds: ScalarArray<'a, u16>,
  position: u32,
}

impl<'a> Copy for Cmap6Iter<'a> {}

impl<'a> Cmap6Iter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    let glyph = match move ScalarArray<'a, u16>.get(&self.glyphIds, u32.toUsize(self.position)) {
      Option<u16>.Some { value } => GlyphId.new(u16.toU32(value))
      _ => {
        return Option<CmapMapping>.None
      }
    }
    let codepoint = u32.wrappingAdd(self.first, self.position)
    self.position = self.position + 1
    return Option<CmapMapping>.some(CmapMapping { codepoint: codepoint, glyph: glyph })
  }
}

impl<'a> Cmap10<'a> {
  pub fn mapCodepoint(self: &Self, codepoint: u32) -> Option<GlyphId> {
    let first: u32 = Cmap10<'a>.startCharCode(self)
    if codepoint < first {
      return Option<GlyphId>.None
    }
    return match move ScalarArray<'a, u16>.get(
      &Cmap10<'a>.glyphIdArray(self),
      u32.toUsize(codepoint - first),
    ) {
      Option<u16>.Some { value } => Option<GlyphId>.some(GlyphId.new(u16.toU32(value)))
      _ => Option<GlyphId>.None
    }
  }

  pub fn iter(self: &Self) -> Cmap10Iter<'a> {
    return Cmap10Iter<'a> {
      first: Cmap10<'a>.startCharCode(self),
      glyphIds: Cmap10<'a>.glyphIdArray(self),
      position: 0,
    }
  }
}

pub struct Cmap10Iter<'a> {
  first: u32,
  glyphIds: ScalarArray<'a, u16>,
  position: u32,
}

impl<'a> Copy for Cmap10Iter<'a> {}

impl<'a> Cmap10Iter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    let glyph = match move ScalarArray<'a, u16>.get(&self.glyphIds, u32.toUsize(self.position)) {
      Option<u16>.Some { value } => GlyphId.new(u16.toU32(value))
      _ => {
        return Option<CmapMapping>.None
      }
    }
    let codepoint = u32.wrappingAdd(self.first, self.position)
    self.position = self.position + 1
    return Option<CmapMapping>.some(CmapMapping { codepoint: codepoint, glyph: glyph })
  }
}

interface AnyMapGroup {
  fn startCode(self: &Self) -> u32

  fn endCode(self: &Self) -> u32

  fn refGlyph(self: &Self) -> u32

  fn isConstant() -> bool
}

impl<'a> AnyMapGroup for SequentialMapGroup<'a> {
  fn startCode(self: &Self) -> u32 {
    return SequentialMapGroup<'a>.startCharCode(self)
  }

  fn endCode(self: &Self) -> u32 {
    return SequentialMapGroup<'a>.endCharCode(self)
  }

  fn refGlyph(self: &Self) -> u32 {
    return SequentialMapGroup<'a>.startGlyphId(self)
  }

  fn isConstant() -> bool {
    return false
  }
}

impl<'a> AnyMapGroup for ConstantMapGroup<'a> {
  fn startCode(self: &Self) -> u32 {
    return ConstantMapGroup<'a>.startCharCode(self)
  }

  fn endCode(self: &Self) -> u32 {
    return ConstantMapGroup<'a>.endCharCode(self)
  }

  fn refGlyph(self: &Self) -> u32 {
    return ConstantMapGroup<'a>.glyphId(self)
  }

  fn isConstant() -> bool {
    return true
  }
}

pub struct Cmap12Group {
  startCode: u32,
  startGlyph: u32,
  first: u32,
  last: u32,
}

impl Copy for Cmap12Group {}

fn groupIsConstant<T: AnyMapGroup>() -> bool {
  return AnyMapGroup.isConstant()
}

// Reads a big-endian u16 at `at`.
@inlineAlways
fn readU16(bytes: &[u8], at: usize) -> u16 {
  return u32.toU16(u32.shiftLeft(u8.toU32(bytes[at]), 8) | u8.toU32(bytes[at + 1]))
}

// Reads a big-endian u32 at a constant offset of a fixed-size record.
@inlineAlways
fn readU32(bytes: &[u8], at: usize) -> u32 {
  return u32.shiftLeft(u8.toU32(bytes[at]), 24) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 16)
    | u32.shiftLeft(u8.toU32(bytes[at + 2]), 8)
    | u8.toU32(bytes[at + 3])
}

// Both group types are 12 bytes: startCharCode, endCharCode, then the glyph. The search decodes
// those fields in place instead of reading a group record per probe.
@inlineAlways
fn findGroup<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + AnyMapGroup>(
  groups: ComputedArray<'a, (), T>,
  cp: u32,
) -> Option<Cmap12Group> {
  return findGroupIn(
    ComputedArray<'a, (), T>.itemsBytes(&groups),
    ComputedArray<'a, (), T>.len(&groups),
    cp,
  )
}

@inlineAlways
fn findGroupIn(records: &[u8], count: usize, cp: u32) -> Option<Cmap12Group> {
  let mut lo: usize = 0
  let mut hi = count
  if hi == 0 || records.length < usize.wrappingMultiply(hi, 12) {
    return Option<Cmap12Group>.None
  }

  // Every probe starts at or below `limit`; checking that once lets the view's own
  // bounds check fold away.
  let limit = records.length - 12
  let mut first: u32 = 0
  let mut last: u32 = 4294967295
  while lo < hi {
    // i < hi and hi * 12 <= records.length, so the arithmetic cannot wrap.
    let i = usize.wrappingAdd(lo, (hi - lo) / 2)
    let at = usize.wrappingMultiply(i, 12)
    if at > limit {
      return Option<Cmap12Group>.None
    }
    let group = Slice.view<u8>(records, at, 12)
    let start = readU32(group, 0)
    let end = readU32(group, 4)
    if cp < start {
      hi = i
      last = min32(last, u32.saturatingSubtract(start, 1))
    } else if cp > end {
      lo = usize.wrappingAdd(i, 1)
      first = max32(first, u32.saturatingAdd(end, 1))
    } else {
      return Option<Cmap12Group>.some(
        Cmap12Group {
          startCode: start,
          startGlyph: readU32(group, 8),
          first: max32(start, first),
          last: min32(end, last),
        },
      )
    }
  }
  return Option<Cmap12Group>.None
}

// The 12-byte group records in `range`, or none when the range is out of bounds or not whole
// records, as `groups()` would report. A lookup reads them directly: building the `ComputedArray`
// costs a `Result` and a division on every call.
@inlineAlways
fn groupRecords<'a>(data: &FontData<'a>, range: ByteRange) -> &'a [u8] {
  let bytes = FontData.asBytes(data)
  if range.start > range.end || range.end > bytes.length || (range.end - range.start) % 12 != 0 {
    return Slice.view<u8>(bytes, 0, 0)
  }
  return Slice.view<u8>(bytes, range.start, range.end - range.start)
}

@inlineAlways
fn mapGroupRecords<T: AnyMapGroup>(records: &[u8], cp: u32) -> Option<GlyphId> {
  let group = match move findGroupIn(records, records.length / 12, cp) {
    Option<Cmap12Group>.Some { value } => value
    _ => {
      return Option<GlyphId>.None
    }
  }
  if groupIsConstant<T>() {
    return Option<GlyphId>.some(GlyphId.new(group.startGlyph))
  }
  return Option<GlyphId>.some(
    GlyphId.new(u32.wrappingAdd(group.startGlyph, u32.wrappingSubtract(cp, group.startCode))),
  )
}

struct Cmap1213Iter<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + AnyMapGroup> {
  groups: ComputedArray<'a, (), T>,
  index: usize,
  position: u64,
  end: u64,
  startCode: u32,
  refGlyph: u32,
  limited: bool,
  limits: CmapIterLimits,
  hasCurrent: bool,
}

impl<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + AnyMapGroup> Copy for Cmap1213Iter<'a, T> {}

impl<'a, T> Cmap1213Iter<'a, T> {
  fn new(groups: ComputedArray<'a, (), T>, limits: Option<CmapIterLimits>) -> Self {
    let mut iter = Self {
      groups: groups,
      index: 0,
      position: 0,
      end: 0,
      startCode: 0,
      refGlyph: 0,
      limited: false,
      limits: CmapIterLimits.default(),
      hasCurrent: false,
    }
    if let Option<CmapIterLimits>.Some { value } = move limits {
      iter.limited = true
      iter.limits = value
    }
    drop Cmap1213Iter<'a, T>.loadGroup(&mut iter, 0)
    return iter
  }

  fn loadGroup(self: &mut Self, index: usize) -> bool {
    let group = match move ComputedArray<'a, (), T>.get(&self.groups, index) {
      Result<T, ReadError>.Success { value } => move value
      _ => {
        self.hasCurrent = false
        return false
      }
    }
    let start = AnyMapGroup.startCode(&group)
    let mut end = u32.toU64(AnyMapGroup.endCode(&group)) + 1
    let refGlyph = AnyMapGroup.refGlyph(&group)
    if self.limited {
      end = min64(end, u32.toU64(self.limits.maxChar) + 1)
      if !groupIsConstant<T>() {
        end = min64(
          end,
          u64.saturatingAdd(
            u64.saturatingSubtract(u32.toU64(self.limits.glyphCount), u32.toU64(refGlyph)),
            u32.toU64(start),
          ),
        )
      }
    }
    self.position = max64(u32.toU64(start), self.end)
    self.end = max64(end, self.end)
    self.startCode = start
    self.refGlyph = refGlyph
    self.hasCurrent = true
    return true
  }

  fn next(self: &mut Self) -> Option<CmapMapping> {
    while self.hasCurrent {
      if self.position < self.end {
        let cp = u64.toU32(self.position)
        self.position = self.position + 1
        let mut glyph = self.refGlyph
        if !groupIsConstant<T>() {
          glyph = u32.wrappingAdd(glyph, u32.wrappingSubtract(cp, self.startCode))
        }
        return Option<CmapMapping>.some(CmapMapping { codepoint: cp, glyph: GlyphId.new(glyph) })
      }
      self.index = self.index + 1
      let nextIndex = self.index
      if !Cmap1213Iter<'a, T>.loadGroup(&mut self, nextIndex) {
        break
      }
    }
    return Option<CmapMapping>.None
  }
}

/// The group records of a format 12 or 13 subtable, located once so repeated lookups skip
/// re-reading the subtable header.
pub struct GroupMap<'a> {
  records: &'a [u8],
  count: usize,
  constant: bool,
}

impl<'a> Copy for GroupMap<'a> {}

impl<'a> GroupMap<'a> {
  pub fn empty() -> Self {
    return Self { records: b"", count: 0, constant: false }
  }

  @inlineAlways
  pub fn map(self: &Self, cp: u32) -> Option<GlyphId> {
    let group = match move findGroupIn(self.records, self.count, cp) {
      Option<Cmap12Group>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if self.constant {
      return Option<GlyphId>.some(GlyphId.new(group.startGlyph))
    }
    return Option<GlyphId>.some(
      GlyphId.new(u32.wrappingAdd(group.startGlyph, u32.wrappingSubtract(cp, group.startCode))),
    )
  }

  /// Writes the glyph `map` gives each code point below `out.length` into `out`, as 0 when
  /// unmapped and 0xFFFF when the glyph does not fit in 16 bits. Returns false, leaving `out`
  /// unchanged, unless the groups are sorted and disjoint, which makes the walk match the
  /// binary search.
  pub fn fill(self: &Self, out: &mut [u16]) -> bool {
    if self.records.length < usize.wrappingMultiply(self.count, 12)
      || self.count > self.records.length {
      return false
    }
    let mut i: usize = 0
    while i < self.count {
      let start = readU32(self.records, i * 12)
      let end = readU32(self.records, i * 12 + 4)
      if start > end || (i > 0 && start <= readU32(self.records, i * 12 - 8)) {
        return false
      }
      i = i + 1
    }
    let mut cp: usize = 0
    while cp < out.length {
      out[cp] = 0
      cp = cp + 1
    }
    i = 0
    while i < self.count {
      let start = readU32(self.records, i * 12)
      if u32.toUsize(start) >= out.length {
        break
      }
      let mut last = u32.toUsize(readU32(self.records, i * 12 + 4))
      if last >= out.length {
        last = out.length - 1
      }
      let first = readU32(self.records, i * 12 + 8)
      let mut code = u32.toUsize(start)
      while code <= last {
        let mut glyph = first
        if !self.constant {
          glyph = u32.wrappingAdd(first, usize.toU32(code) - start)
        }
        out[code] = u32.toU16(min32(glyph, 0xffff))
        code = code + 1
      }
      i = i + 1
    }
    return true
  }
}

/// The arrays of a format 4 subtable, located once so repeated lookups skip re-reading the
/// subtable header. Lookups match `Cmap4.mapCodepoint`.
pub struct SegmentMap<'a> {
  starts: &'a [u8],
  ends: &'a [u8],
  deltas: &'a [u8],
  offsets: &'a [u8],
  glyphs: &'a [u8],
  count: usize,
}

impl<'a> Copy for SegmentMap<'a> {}

impl<'a> SegmentMap<'a> {
  pub fn empty() -> Self {
    return Self { starts: b"", ends: b"", deltas: b"", offsets: b"", glyphs: b"", count: 0 }
  }

  @inlineAlways
  pub fn map(self: &Self, codepoint: u32) -> Option<GlyphId> {
    if codepoint > 65535 || self.count == 0 {
      return Option<GlyphId>.None
    }
    let cp = u32.toU16(codepoint)

    // The same probes as Cmap4.findSegment; `count` is at most both arrays' lengths.
    let limit = usize.wrappingSubtract(usize.wrappingMultiply(self.count, 2), 2)
    let startBytes = Slice.view<u8>(self.starts, 0, limit + 2)
    let endBytes = Slice.view<u8>(self.ends, 0, limit + 2)
    let mut lo: usize = 0
    let mut hi = self.count
    while lo < hi {
      let i = usize.wrappingAdd(lo, (hi - lo) / 2)
      let at = usize.wrappingMultiply(i, 2)
      if at > limit {
        return Option<GlyphId>.None
      }
      let start = readU16(startBytes, at)
      if cp < start {
        hi = i
      } else if cp > readU16(endBytes, at) {
        lo = usize.wrappingAdd(i, 1)
      } else {
        return SegmentMap.lookup(self, cp, i, start)
      }
    }
    return Option<GlyphId>.None
  }

  /// Writes the glyph `map` gives each code point below `out.length` into `out`, as 0 when
  /// unmapped. Returns false, leaving `out` unchanged, unless the segments are sorted and
  /// disjoint, which makes the walk match the binary search.
  pub fn fill(self: &Self, out: &mut [u16]) -> bool {
    let size = usize.wrappingMultiply(self.count, 2)
    if self.count > self.starts.length || size > self.starts.length || size > self.ends.length {
      return false
    }
    let mut i: usize = 0
    while i < self.count {
      let start = readU16(self.starts, i * 2)
      if start > readU16(self.ends, i * 2) || (i > 0 && start <= readU16(self.ends, i * 2 - 2)) {
        return false
      }
      i = i + 1
    }
    let mut cp: usize = 0
    while cp < out.length {
      out[cp] = 0
      cp = cp + 1
    }
    i = 0
    while i < self.count {
      let start = readU16(self.starts, i * 2)
      if u16.toUsize(start) >= out.length {
        break
      }
      let mut last = u16.toUsize(readU16(self.ends, i * 2))
      if last >= out.length {
        last = out.length - 1
      }
      let mut code = u16.toUsize(start)
      while code <= last {
        if let Option<GlyphId>.Some { value } = SegmentMap.lookup(
          self,
          usize.toU16(code),
          i,
          start,
        ) {
          out[code] = u32.toU16(GlyphId.toU32(value))
        }
        code = code + 1
      }
      i = i + 1
    }
    return true
  }

  // Cmap4.lookupGlyphId over the located arrays.
  @inlineAlways
  fn lookup(self: &Self, codepoint: u16, index: usize, startCode: u16) -> Option<GlyphId> {
    let at = index * 2
    if at + 2 > self.deltas.length || at + 2 > self.offsets.length {
      return Option<GlyphId>.None
    }
    let delta = u16.toI32(readU16(self.deltas, at))
    let mut signed = delta
    if delta >= 32768 {
      signed = delta - 65536
    }
    let rangeOffset = u16.toUsize(readU16(self.offsets, at))
    if rangeOffset == 0 {
      return Option<GlyphId>.some(GlyphId.new(u16.toU32(wrappedDelta(codepoint, signed))))
    }
    let offset = match move usize.checkedSubtract(
      rangeOffset / 2 + u16.toUsize(codepoint - startCode),
      self.offsets.length / 2 - index,
    ) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if offset >= self.glyphs.length / 2 {
      return Option<GlyphId>.None
    }
    let gid = readU16(self.glyphs, offset * 2)
    if gid == 0 {
      return Option<GlyphId>.None
    }
    return Option<GlyphId>.some(GlyphId.new(u16.toU32(wrappedDelta(gid, signed))))
  }
}

impl<'a> CmapSubtable<'a> {
  /// The group records of a format 12 or 13 subtable, or `None` for other formats.
  pub fn groupMap(self: &Self) -> Option<GroupMap<'a>> {
    return match &self.* {
      CmapSubtable<'a>.Format12 { value } => {
        let groups = Cmap12<'a>.groups(&value)
        Option<GroupMap<'a>>.some(
          GroupMap<'a> {
            records: ComputedArray<'a, (), SequentialMapGroup<'a>>.itemsBytes(&groups),
            count: ComputedArray<'a, (), SequentialMapGroup<'a>>.len(&groups),
            constant: false,
          },
        )
      }
      CmapSubtable<'a>.Format13 { value } => {
        let groups = Cmap13<'a>.groups(&value)
        Option<GroupMap<'a>>.some(
          GroupMap<'a> {
            records: ComputedArray<'a, (), ConstantMapGroup<'a>>.itemsBytes(&groups),
            count: ComputedArray<'a, (), ConstantMapGroup<'a>>.len(&groups),
            constant: true,
          },
        )
      }
      _ => Option<GroupMap<'a>>.None
    }
  }

  /// The arrays of a format 4 subtable, or `None` for other formats.
  pub fn segmentMap(self: &Self) -> Option<SegmentMap<'a>> {
    return match &self.* {
      CmapSubtable<'a>.Format4 { value } => {
        let starts = ScalarArray<'a, u16>.bytes(&Cmap4<'a>.startCode(&value))
        let ends = ScalarArray<'a, u16>.bytes(&Cmap4<'a>.endCode(&value))
        let mut count = u16.toUsize(Cmap4<'a>.segCountX2(&value)) / 2
        if starts.length / 2 < count {
          count = starts.length / 2
        }
        if ends.length / 2 < count {
          count = ends.length / 2
        }
        Option<SegmentMap<'a>>.some(
          SegmentMap<'a> {
            starts: starts,
            ends: ends,
            deltas: ScalarArray<'a, i16>.bytes(&Cmap4<'a>.idDelta(&value)),
            offsets: ScalarArray<'a, u16>.bytes(&Cmap4<'a>.idRangeOffsets(&value)),
            glyphs: ScalarArray<'a, u16>.bytes(&Cmap4<'a>.glyphIdArray(&value)),
            count: count,
          },
        )
      }
      _ => Option<SegmentMap<'a>>.None
    }
  }
}

impl<'a> Cmap12<'a> {
  pub fn mapCodepointCached(self: &Self, cp: u32, cached: &mut Option<Cmap12Group>) -> Option<
    GlyphId
  > {
    if let Option<Cmap12Group>.Some { value } = &cached.* {
      if cp >= value.first && cp <= value.last {
        return Option<GlyphId>.some(
          GlyphId.new(u32.wrappingAdd(value.startGlyph, u32.wrappingSubtract(cp, value.startCode))),
        )
      }
    }
    let group = match move findGroup<SequentialMapGroup<'a>>(Cmap12<'a>.groups(self), cp) {
      Option<Cmap12Group>.Some { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    cached.* = Option<Cmap12Group>.some(group)
    return Option<GlyphId>.some(
      GlyphId.new(u32.wrappingAdd(group.startGlyph, u32.wrappingSubtract(cp, group.startCode))),
    )
  }
}

impl<'a> Cmap12<'a> {
  @inlineAlways
  pub fn mapCodepoint(self: &Self, cp: u32) -> Option<GlyphId> {
    return mapGroupRecords<SequentialMapGroup<'a>>(
      groupRecords(&self._fontData, Cmap12<'a>.groupsByteRange(self)),
      cp,
    )
  }

  pub fn iter(self: &Self) -> Cmap12Iter<'a> {
    return Cmap12Iter<'a> {
      inner: Cmap1213Iter<'a, SequentialMapGroup<'a>>.new(
        Cmap12<'a>.groups(self),
        Option<CmapIterLimits>.None,
      ),
    }
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> Cmap12Iter<'a> {
    return Cmap12Iter<'a> {
      inner: Cmap1213Iter<'a, SequentialMapGroup<'a>>.new(
        Cmap12<'a>.groups(self),
        Option<CmapIterLimits>.some(limits),
      ),
    }
  }
}

pub struct Cmap12Iter<'a> {
  inner: Cmap1213Iter<'a, SequentialMapGroup<'a>>,
}

impl<'a> Copy for Cmap12Iter<'a> {}

impl<'a> Cmap12Iter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap1213Iter<'a, SequentialMapGroup<'a>>.next(&mut self.inner)
  }
}

impl<'a> Cmap13<'a> {
  @inlineAlways
  pub fn mapCodepoint(self: &Self, cp: u32) -> Option<GlyphId> {
    return mapGroupRecords<ConstantMapGroup<'a>>(
      groupRecords(&self._fontData, Cmap13<'a>.groupsByteRange(self)),
      cp,
    )
  }

  pub fn iter(self: &Self) -> Cmap13Iter<'a> {
    return Cmap13Iter<'a> {
      inner: Cmap1213Iter<'a, ConstantMapGroup<'a>>.new(
        Cmap13<'a>.groups(self),
        Option<CmapIterLimits>.None,
      ),
    }
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> Cmap13Iter<'a> {
    return Cmap13Iter<'a> {
      inner: Cmap1213Iter<'a, ConstantMapGroup<'a>>.new(
        Cmap13<'a>.groups(self),
        Option<CmapIterLimits>.some(limits),
      ),
    }
  }
}

pub struct Cmap13Iter<'a> {
  inner: Cmap1213Iter<'a, ConstantMapGroup<'a>>,
}

impl<'a> Copy for Cmap13Iter<'a> {}

impl<'a> Cmap13Iter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap1213Iter<'a, ConstantMapGroup<'a>>.next(&mut self.inner)
  }
}

impl<'a> CmapSubtable<'a> {
  pub fn language(self: &Self) -> u32 {
    return match &self.* {
      CmapSubtable<'a>.Format0 { value } => u16.toU32(Cmap0<'a>.language(&value))
      CmapSubtable<'a>.Format2 { value } => u16.toU32(Cmap2<'a>.language(&value))
      CmapSubtable<'a>.Format4 { value } => u16.toU32(Cmap4<'a>.language(&value))
      CmapSubtable<'a>.Format6 { value } => u16.toU32(Cmap6<'a>.language(&value))
      CmapSubtable<'a>.Format10 { value } => Cmap10<'a>.language(&value)
      CmapSubtable<'a>.Format12 { value } => Cmap12<'a>.language(&value)
      CmapSubtable<'a>.Format13 { value } => Cmap13<'a>.language(&value)
      _ => 0
    }
  }

  @inlineAlways
  pub fn mapCodepoint(self: &Self, cp: u32) -> Option<GlyphId> {
    // Most fonts' best subtable is format 4, so it is tested before the general dispatch.
    if let CmapSubtable<'a>.Format4 { value } = &self.* {
      return Cmap4<'a>.mapCodepoint(&value, cp)
    }
    return match &self.* {
      CmapSubtable<'a>.Format0 { value } => Cmap0<'a>.mapCodepoint(&value, cp)
      CmapSubtable<'a>.Format6 { value } => Cmap6<'a>.mapCodepoint(&value, cp)
      CmapSubtable<'a>.Format10 { value } => Cmap10<'a>.mapCodepoint(&value, cp)
      CmapSubtable<'a>.Format12 { value } => Cmap12<'a>.mapCodepoint(&value, cp)
      CmapSubtable<'a>.Format13 { value } => Cmap13<'a>.mapCodepoint(&value, cp)
      _ => Option<GlyphId>.None
    }
  }

  pub fn iter(self: &Self) -> CmapSubtableIter<'a> {
    return CmapSubtable<'a>.iterWithLimits(
      self,
      CmapIterLimits { maxChar: 4294967295, glyphCount: 4294967295 },
    )
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> CmapSubtableIter<'a> {
    return match &self.* {
      CmapSubtable<'a>.Format0 { value } => CmapSubtableIter<'a>.Format0 {
        iter: Cmap0<'a>.iter(&value)
      }
      CmapSubtable<'a>.Format4 { value } => CmapSubtableIter<'a>.Format4 {
        iter: Cmap4<'a>.iter(&value)
      }
      CmapSubtable<'a>.Format6 { value } => CmapSubtableIter<'a>.Format6 {
        iter: Cmap6<'a>.iter(&value)
      }
      CmapSubtable<'a>.Format10 { value } => CmapSubtableIter<'a>.Format10 {
        iter: Cmap10<'a>.iter(&value)
      }
      CmapSubtable<'a>.Format12 { value } => CmapSubtableIter<'a>.Format12 {
        iter: Cmap12<'a>.iterWithLimits(&value, limits)
      }
      CmapSubtable<'a>.Format13 { value } => CmapSubtableIter<'a>.Format13 {
        iter: Cmap13<'a>.iterWithLimits(&value, limits)
      }
      _ => CmapSubtableIter<'a>.None
    }
  }
}

pub union CmapSubtableIter<'a> {
  None,
  Format0 { pub iter: Cmap0Iter<'a> },
  Format4 { pub iter: Cmap4Iter<'a> },
  Format6 { pub iter: Cmap6Iter<'a> },
  Format10 { pub iter: Cmap10Iter<'a> },
  Format12 { pub iter: Cmap12Iter<'a> },
  Format13 { pub iter: Cmap13Iter<'a> },
}

impl<'a> Copy for CmapSubtableIter<'a> {}

impl<'a> CmapSubtableIter<'a> {
  pub fn next(self: &mut Self) -> Option<CmapMapping> {
    return match &mut self.* {
      CmapSubtableIter<'a>.None => Option<CmapMapping>.None
      CmapSubtableIter<'a>.Format0 { iter } => Cmap0Iter<'a>.next(&mut iter)
      CmapSubtableIter<'a>.Format4 { iter } => Cmap4Iter<'a>.next(&mut iter)
      CmapSubtableIter<'a>.Format6 { iter } => Cmap6Iter<'a>.next(&mut iter)
      CmapSubtableIter<'a>.Format10 { iter } => Cmap10Iter<'a>.next(&mut iter)
      CmapSubtableIter<'a>.Format12 { iter } => Cmap12Iter<'a>.next(&mut iter)
      CmapSubtableIter<'a>.Format13 { iter } => Cmap13Iter<'a>.next(&mut iter)
    }
  }
}

pub struct UvsSubtable<'a> {
  data: FontData<'a>,
  selectors: ComputedArray<'a, (), VariationSelector<'a>>,
  _format: u16,
}

impl<'a> Copy for UvsSubtable<'a> {}

impl<'a> UvsSubtable<'a> {
  pub fn fromCmap14(table: Cmap14<'a>) -> Self {
    return Self {
      data: Cmap14<'a>.offsetData(&table),
      selectors: Cmap14<'a>.varSelector(&table),
      _format: 14,
    }
  }

  pub fn fromCmap15(table: Cmap15<'a>) -> Self {
    let data = Cmap15<'a>.offsetData(&table)
    let range = Cmap15<'a>.varSelectorByteRange(&table)
    let selectors = recordArray<VariationSelector<'a>>(data, range.start, range.end)
      |> Result<ComputedArray<'a, (), VariationSelector<'a>>, ReadError>.unwrapOr(
        ComputedArray<'a, (), VariationSelector<'a>>.empty(()),
      )
    return Self { data: data, selectors: selectors, _format: 15 }
  }

  pub fn format(self: &Self) -> u16 {
    return self._format
  }

  pub fn varSelector(self: &Self) -> ComputedArray<'a, (), VariationSelector<'a>> {
    return self.selectors
  }

  pub fn mapVariant(self: &Self, codepoint: u32, selector: u32) -> Option<MapVariant> {
    let mut size = ComputedArray<'a, (), VariationSelector<'a>>.len(&self.selectors)
    if size == 0 {
      return Option<MapVariant>.None
    }
    let mut base: usize = 0

    // Match Rust slice::binary_search, including duplicate/unsorted records.
    while size > 1 {
      let half = size / 2
      let mid = base + half
      let record = match move ComputedArray<'a, (), VariationSelector<'a>>.get(
        &self.selectors,
        mid,
      ) {
        Result<VariationSelector<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<MapVariant>.None
        }
      }
      if Uint24.toU32(VariationSelector<'a>.varSelector(&record)) <= selector {
        base = mid
      }
      size = size - half
    }
    let record = match move ComputedArray<'a, (), VariationSelector<'a>>.get(
      &self.selectors,
      base,
    ) {
      Result<VariationSelector<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MapVariant>.None
      }
    }
    if Uint24.toU32(VariationSelector<'a>.varSelector(&record)) != selector {
      return Option<MapVariant>.None
    }
    if let Option<Result<DefaultUvs<'a>, ReadError>>.Some {
      value: result
    } = move VariationSelector<'a>.defaultUvs(&record, self.data) {
      if let Result<DefaultUvs<'a>, ReadError>.Success { value: defaults } = move result {
        let ranges = DefaultUvs<'a>.ranges(&defaults)
        size = ComputedArray<'a, (), UnicodeRange<'a>>.len(&ranges)
        base = 0
        if size > 0 {
          while size > 1 {
            let half = size / 2
            let mid = base + half
            let range = match move ComputedArray<'a, (), UnicodeRange<'a>>.get(&ranges, mid) {
              Result<UnicodeRange<'a>, ReadError>.Success { value } => value
              _ => {
                return Option<MapVariant>.None
              }
            }
            if codepoint >= Uint24.toU32(UnicodeRange<'a>.startUnicodeValue(&range)) {
              base = mid
            }
            size = size - half
          }
          if let Result<UnicodeRange<'a>, ReadError>.Success { value: range } = move ComputedArray<
            'a,
            (),
            UnicodeRange<'a>
          >.get(&ranges, base) {
            let start = Uint24.toU32(UnicodeRange<'a>.startUnicodeValue(&range))
            if codepoint >= start
              && codepoint <= start + u8.toU32(UnicodeRange<'a>.additionalCount(&range)) {
              return Option<MapVariant>.some(MapVariant.UseDefault)
            }
          }
        }
      }
    }
    let mappings = match move UvsSubtable<'a>.nonDefaultUvs(self, record) {
      Option<NonDefaultUvsIter<'a>>.Some { value } => value
      _ => {
        return Option<MapVariant>.None
      }
    }
    return match move NonDefaultUvsIter<'a>.find(&mappings, codepoint) {
      Option<GlyphId>.Some { value } => Option<MapVariant>.some(MapVariant.Variant { glyph: value })
      _ => Option<MapVariant>.None
    }
  }

  fn nonDefaultUvs(self: &Self, record: VariationSelector<'a>) -> Option<NonDefaultUvsIter<'a>> {
    let raw = VariationSelector<'a>.nonDefaultUvsOffset(&record)
    let offset = u32.toUsize(Offset32.toU32(Nullable<Offset32>.offset(&raw).*))
    if offset == 0 {
      return Option<NonDefaultUvsIter<'a>>.None
    }
    let data = match move FontData.splitOff(&self.data, offset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<NonDefaultUvsIter<'a>>.None
      }
    }
    return NonDefaultUvsIter<'a>.new(data, self._format == 15)
  }

  pub fn iter(self: &Self) -> UvsSubtableIter<'a> {
    return UvsSubtableIter<'a>.new(self.*, Option<CmapIterLimits>.None)
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> UvsSubtableIter<'a> {
    return UvsSubtableIter<'a>.new(self.*, Option<CmapIterLimits>.some(limits))
  }
}

struct NonDefaultUvsIter<'a> {
  mappings: FontData<'a>,
  recordLen: usize,
  wide: bool,
  position: usize,
  count: usize,
}

impl<'a> Copy for NonDefaultUvsIter<'a> {}

impl<'a> NonDefaultUvsIter<'a> {
  fn new(data: FontData<'a>, wide: bool) -> Option<Self> {
    let count = match move FontData<'a>.readAt<u32>(&data, 0) {
      Result<u32, ReadError>.Success { value } => u32.toUsize(value)
      _ => {
        return Option<Self>.None
      }
    }
    let mut recordLen: usize = 5
    if wide {
      recordLen = 6
    }
    let size = match move usize.checkedMultiply(count, recordLen) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    let end = match move usize.checkedAdd(size, 4) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    let mappings = match move FontData.slice(&data, 4, end) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    return Option<Self>.some(
      Self { mappings: mappings, recordLen: recordLen, wide: wide, position: 0, count: count },
    )
  }

  fn get(self: &Self, index: usize) -> Option<CmapMapping> {
    if index >= self.count {
      return Option<CmapMapping>.None
    }
    let position = index * self.recordLen
    let cp = match move FontData<'a>.readAt<Uint24>(&self.mappings, position) {
      Result<Uint24, ReadError>.Success { value } => Uint24.toU32(value)
      _ => {
        return Option<CmapMapping>.None
      }
    }
    let mut gid: u32 = 0
    if self.wide {
      gid = match move FontData<'a>.readAt<Uint24>(&self.mappings, position + 3) {
        Result<Uint24, ReadError>.Success { value } => Uint24.toU32(value)
        _ => {
          return Option<CmapMapping>.None
        }
      }
    } else {
      gid = match move FontData<'a>.readAt<u16>(&self.mappings, position + 3) {
        Result<u16, ReadError>.Success { value } => u16.toU32(value)
        _ => {
          return Option<CmapMapping>.None
        }
      }
    }
    return Option<CmapMapping>.some(CmapMapping { codepoint: cp, glyph: GlyphId.new(gid) })
  }

  fn find(self: &Self, codepoint: u32) -> Option<GlyphId> {
    let mut lo = self.position
    let mut hi = self.count
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let item = match move NonDefaultUvsIter<'a>.get(self, mid) {
        Option<CmapMapping>.Some { value } => value
        _ => {
          return Option<GlyphId>.None
        }
      }
      if item.codepoint < codepoint {
        lo = mid + 1
      } else if item.codepoint > codepoint {
        hi = mid
      } else {
        return Option<GlyphId>.some(item.glyph)
      }
    }
    return Option<GlyphId>.None
  }

  fn next(self: &mut Self) -> Option<CmapMapping> {
    if self.position >= self.count {
      return Option<CmapMapping>.None
    }
    let index = self.position
    self.position = self.position + 1
    return NonDefaultUvsIter<'a>.get(&self, index)
  }
}

struct DefaultUvsIter<'a> {
  ranges: ComputedArray<'a, (), UnicodeRange<'a>>,
  index: usize,
  position: u32,
  end: u32,
}

impl<'a> Copy for DefaultUvsIter<'a> {}

impl<'a> DefaultUvsIter<'a> {
  fn new(table: DefaultUvs<'a>) -> Self {
    return Self { ranges: DefaultUvs<'a>.ranges(&table), index: 0, position: 0, end: 0 }
  }

  fn next(self: &mut Self) -> Option<u32> {
    while true {
      if self.position < self.end {
        let cp = self.position
        self.position = self.position + 1
        return Option<u32>.some(cp)
      }
      let range = match move ComputedArray<'a, (), UnicodeRange<'a>>.get(&self.ranges, self.index) {
        Result<UnicodeRange<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<u32>.None
        }
      }
      self.index = self.index + 1
      self.position = Uint24.toU32(UnicodeRange<'a>.startUnicodeValue(&range))
      self.end = self.position + u8.toU32(UnicodeRange<'a>.additionalCount(&range)) + 1
    }
  }
}

pub struct UvsMappingEntry {
  pub codepoint: u32,
  pub selector: u32,
  pub mapping: MapVariant,
}

impl Copy for UvsMappingEntry {}

pub struct UvsSubtableIter<'a> {
  subtable: UvsSubtable<'a>,
  recordIndex: usize,
  hasSelector: bool,
  selector: u32,
  defaultUvs: Option<DefaultUvsIter<'a>>,
  nonDefaultUvs: Option<NonDefaultUvsIter<'a>>,
  defaultUvLeft: u32,
  nonDefaultUvLeft: u32,
}

impl<'a> UvsSubtableIter<'a> {
  fn new(table: UvsSubtable<'a>, limits: Option<CmapIterLimits>) -> Self {
    let mut defaultLeft: u32 = 4294967295
    let mut nonDefaultLeft: u32 = 4294967295
    if let Option<CmapIterLimits>.Some { value } = move limits {
      defaultLeft = u32.saturatingAdd(value.maxChar, 1)
      nonDefaultLeft = value.glyphCount
    }
    return Self {
      subtable: table,
      recordIndex: 0,
      hasSelector: false,
      selector: 0,
      defaultUvs: Option<DefaultUvsIter<'a>>.None,
      nonDefaultUvs: Option<NonDefaultUvsIter<'a>>.None,
      defaultUvLeft: defaultLeft,
      nonDefaultUvLeft: nonDefaultLeft,
    }
  }

  fn advanceSelector(self: &mut Self) -> bool {
    while true {
      let record = match move ComputedArray<'a, (), VariationSelector<'a>>.get(
        &self.subtable.selectors,
        self.recordIndex,
      ) {
        Result<VariationSelector<'a>, ReadError>.Success { value } => value
        _ => {
          return false
        }
      }
      self.recordIndex = self.recordIndex + 1
      let selector = Uint24.toU32(VariationSelector<'a>.varSelector(&record))
      if self.hasSelector && selector <= self.selector {
        continue
      }
      self.hasSelector = true
      self.selector = selector
      self.defaultUvs = Option<DefaultUvsIter<'a>>.None
      if let Option<Result<DefaultUvs<'a>, ReadError>>.Some {
        value: result
      } = move VariationSelector<'a>.defaultUvs(&record, self.subtable.data) {
        if let Result<DefaultUvs<'a>, ReadError>.Success { value } = move result {
          self.defaultUvs = Option<DefaultUvsIter<'a>>.some(DefaultUvsIter<'a>.new(value))
        }
      }
      self.nonDefaultUvs = UvsSubtable<'a>.nonDefaultUvs(&self.subtable, record)
      return true
    }
  }

  pub fn next(self: &mut Self) -> Option<UvsMappingEntry> {
    while true {
      if !self.hasSelector && !UvsSubtableIter<'a>.advanceSelector(&mut self) {
        return Option<UvsMappingEntry>.None
      }
      if let Option<DefaultUvsIter<'a>>.Some { value } = &mut self.defaultUvs {
        if let Option<u32>.Some { value: cp } = move DefaultUvsIter<'a>.next(&mut value) {
          if self.defaultUvLeft == 0 {
            return Option<UvsMappingEntry>.None
          }
          self.defaultUvLeft = self.defaultUvLeft - 1
          return Option<UvsMappingEntry>.some(
            UvsMappingEntry {
              codepoint: cp,
              selector: self.selector,
              mapping: MapVariant.UseDefault,
            },
          )
        }
      }
      if let Option<NonDefaultUvsIter<'a>>.Some { value } = &mut self.nonDefaultUvs {
        if let Option<CmapMapping>.Some { value: item } = move NonDefaultUvsIter<'a>.next(
          &mut value,
        ) {
          if self.nonDefaultUvLeft == 0 {
            return Option<UvsMappingEntry>.None
          }
          self.nonDefaultUvLeft = self.nonDefaultUvLeft - 1
          return Option<UvsMappingEntry>.some(
            UvsMappingEntry {
              codepoint: item.codepoint,
              selector: self.selector,
              mapping: MapVariant.Variant { glyph: item.glyph },
            },
          )
        }
      }
      if !UvsSubtableIter<'a>.advanceSelector(&mut self) {
        return Option<UvsMappingEntry>.None
      }
    }
  }
}

pub type Cmap14Iter<'a> = UvsSubtableIter<'a>

pub type Cmap15Iter<'a> = UvsSubtableIter<'a>

impl<'a> Cmap14<'a> {
  pub fn mapVariant(self: &Self, cp: u32, selector: u32) -> Option<MapVariant> {
    return UvsSubtable<'a>.mapVariant(&UvsSubtable<'a>.fromCmap14(self.*), cp, selector)
  }

  pub fn iter(self: &Self) -> Cmap14Iter<'a> {
    return UvsSubtable<'a>.iter(&UvsSubtable<'a>.fromCmap14(self.*))
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> Cmap14Iter<'a> {
    return UvsSubtable<'a>.iterWithLimits(&UvsSubtable<'a>.fromCmap14(self.*), limits)
  }
}

impl<'a> Cmap15<'a> {
  pub fn mapVariant(self: &Self, cp: u32, selector: u32) -> Option<MapVariant> {
    return UvsSubtable<'a>.mapVariant(&UvsSubtable<'a>.fromCmap15(self.*), cp, selector)
  }

  pub fn iter(self: &Self) -> Cmap15Iter<'a> {
    return UvsSubtable<'a>.iter(&UvsSubtable<'a>.fromCmap15(self.*))
  }

  pub fn iterWithLimits(self: &Self, limits: CmapIterLimits) -> Cmap15Iter<'a> {
    return UvsSubtable<'a>.iterWithLimits(&UvsSubtable<'a>.fromCmap15(self.*), limits)
  }
}

pub struct BestCmapSubtable<'a> {
  pub index: u16,
  pub record: EncodingRecord<'a>,
  pub subtable: CmapSubtable<'a>,
}

impl<'a> Copy for BestCmapSubtable<'a> {}

pub struct SelectedUvsSubtable<'a> {
  pub index: u16,
  pub subtable: UvsSubtable<'a>,
}

impl<'a> Copy for SelectedUvsSubtable<'a> {}

impl<'a> Dmap<'a> {
  pub fn asCmap(self: &Self) -> Cmap<'a> {
    return Cmap<'a>.read(Dmap<'a>.offsetData(self))
      |> Result<Cmap<'a>, ReadError>.unwrapOr(Cmap<'a>.default())
  }
}

impl<'a> EncodingRecord<'a> {
  pub fn isSymbol(self: &Self) -> bool {
    return EncodingRecord<'a>.platformId(self) == PlatformId.Windows
      && EncodingRecord<'a>.encodingId(self) == 0
  }

  pub fn isMacRoman(self: &Self) -> bool {
    return EncodingRecord<'a>.platformId(self) == PlatformId.Macintosh
      && EncodingRecord<'a>.encodingId(self) == 0
  }
}

impl<'a> Cmap<'a> {
  pub fn mapCodepoint(self: &Self, cp: u32) -> Option<GlyphId> {
    let records = Cmap<'a>.encodingRecords(self)
    let mut i: usize = 0
    while i < ComputedArray<'a, (), EncodingRecord<'a>>.len(&records) {
      if let Result<EncodingRecord<'a>, ReadError>.Success { value: record } = move ComputedArray<
        'a,
        (),
        EncodingRecord<'a>
      >.get(&records, i) {
        if let Result<CmapSubtable<'a>, ReadError>.Success {
          value: subtable
        } = move EncodingRecord<'a>.subtable(&record, Cmap<'a>.offsetData(self)) {
          if let Option<GlyphId>.Some { value } = move CmapSubtable<'a>.mapCodepoint(
            &subtable,
            cp,
          ) {
            return Option<GlyphId>.some(value)
          }
        }
      }
      i = i + 1
    }
    return Option<GlyphId>.None
  }

  pub fn subtable(self: &Self, index: u16) -> Result<CmapSubtable<'a>, ReadError> {
    let record = match move ComputedArray<'a, (), EncodingRecord<'a>>.get(
      &Cmap<'a>.encodingRecords(self),
      u16.toUsize(index),
    ) {
      Result<EncodingRecord<'a>, ReadError>.Success { value } => value
      Result<EncodingRecord<'a>, ReadError>.Failure { error } => {
        return Result<CmapSubtable<'a>, ReadError>.failResult(error)
      }
    }
    return EncodingRecord<'a>.subtable(&record, Cmap<'a>.offsetData(self))
  }

  pub fn bestSubtable(self: &Self) -> Option<BestCmapSubtable<'a>> {
    let platforms: [u16; 10] = [3, 3, 0, 0, 3, 0, 0, 0, 0, 1]
    let encodings: [u16; 10] = [0, 10, 6, 4, 1, 3, 2, 1, 0, 0]
    let records = Cmap<'a>.encodingRecords(self)
    let mut priority: usize = 0
    while priority < 10 {
      let mut i: usize = 0
      while i < ComputedArray<'a, (), EncodingRecord<'a>>.len(&records) {
        if let Result<EncodingRecord<'a>, ReadError>.Success { value: record } = move ComputedArray<
          'a,
          (),
          EncodingRecord<'a>
        >.get(&records, i) {
          if PlatformId.value(EncodingRecord<'a>.platformId(&record)) == platforms[priority]
            && EncodingRecord<'a>.encodingId(&record) == encodings[priority] {
            if let Result<CmapSubtable<'a>, ReadError>.Success {
              value: subtable
            } = move EncodingRecord<'a>.subtable(&record, Cmap<'a>.offsetData(self)) {
              let supported = match subtable {
                CmapSubtable<'a>.Format0 { value } => true
                CmapSubtable<'a>.Format4 { value } => true
                CmapSubtable<'a>.Format6 { value } => true
                CmapSubtable<'a>.Format10 { value } => true
                CmapSubtable<'a>.Format12 { value } => true
                CmapSubtable<'a>.Format13 { value } => true
                _ => false
              }
              if supported {
                return Option<BestCmapSubtable<'a>>.some(
                  BestCmapSubtable<'a> {
                    index: usize.toU16(i),
                    record: record,
                    subtable: subtable,
                  },
                )
              }
            }
          }
        }
        i = i + 1
      }
      priority = priority + 1
    }
    return Option<BestCmapSubtable<'a>>.None
  }

  pub fn uvsSubtable(self: &Self) -> Option<SelectedUvsSubtable<'a>> {
    let records = Cmap<'a>.encodingRecords(self)
    let mut i = ComputedArray<'a, (), EncodingRecord<'a>>.len(&records)
    let mut found14 = false
    let mut format14: Option<SelectedUvsSubtable<'a>> = Option<SelectedUvsSubtable<'a>>.None
    while i > 0 {
      i = i - 1
      if let Result<EncodingRecord<'a>, ReadError>.Success { value: record } = move ComputedArray<
        'a,
        (),
        EncodingRecord<'a>
      >.get(&records, i) {
        if EncodingRecord<'a>.platformId(&record) != PlatformId.Unicode
          || EncodingRecord<'a>.encodingId(&record) != 5 {
          continue
        }
        if let Result<CmapSubtable<'a>, ReadError>.Success {
          value: subtable
        } = move EncodingRecord<'a>.subtable(&record, Cmap<'a>.offsetData(self)) {
          match subtable {
            CmapSubtable<'a>.Format15 { value } => {
              return Option<SelectedUvsSubtable<'a>>.some(
                SelectedUvsSubtable<'a> {
                  index: usize.toU16(i),
                  subtable: UvsSubtable<'a>.fromCmap15(value),
                },
              )
            }
            CmapSubtable<'a>.Format14 { value } => {
              if !found14 {
                found14 = true
                format14 = Option<SelectedUvsSubtable<'a>>.some(
                  SelectedUvsSubtable<'a> {
                    index: usize.toU16(i),
                    subtable: UvsSubtable<'a>.fromCmap14(value),
                  },
                )
              }
            }
            _ => ()
          }
        }
      }
    }
    return move format14
  }
}
