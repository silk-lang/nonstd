    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let numUvsMappingsValue = scalarOr<u32>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u32.toUsize(numUvsMappingsValue), 5))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn numUvsMappings(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[0].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn numUvsMappingsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn uvsMapping(self: &Self) -> ComputedArray<'a, (), UvsMapping<'a>> {
    return match move recordArray<UvsMapping<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ComputedArray<'a, (), UvsMapping<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), UvsMapping<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        UvsMapping<'a>
      >.empty(())
    }
  }

  pub fn uvsMappingByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for NonDefaultUvs<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return NonDefaultUvs<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for NonDefaultUvs<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Non-default UVS mappings with 24-bit glyph IDs, used by [Cmap15].
pub struct NonDefaultUvs24<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

