/// [cmap Format 8](https://docs.microsoft.com/en-us/typography/opentype/spec/cmap#format-8-mixed-16-bit-and-32-bit-coverage): mixed 16-bit and 32-bit coverage
pub struct Cmap8<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 7],
}

impl<'a> Copy for Cmap8<'a> {}

impl<'a> Cmap8<'a> {
  pub fn minSize() -> usize {
    return 8208
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8208 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 7] = [ByteRange { start: 0, end: 0 }; 7]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let reservedValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let lengthValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let languageValue = scalarOr<u32>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(8192, 1))
    ranges[4].end = end
    ranges[5].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[5].end = end
    let numGroupsValue = scalarOr<u32>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u32.toUsize(numGroupsValue), 12))
    ranges[6].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Subtable format; set to 8.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn reservedByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Byte length of this subtable (including the header)
  pub fn length(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn lengthByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// For requirements on use of the language field, see “Use of
  /// the language field in 'cmap' subtables” in this document.
  pub fn language(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[3].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn languageByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Tightly packed array of bits (8K bytes total) indicating
  /// whether the particular 16-bit (index) value is the start of a
  /// 32-bit character code
  pub fn is32(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn is32ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Number of groupings which follow
  pub fn numGroups(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[5].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn numGroupsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Array of SequentialMapGroup records.
  pub fn groups(self: &Self) -> ComputedArray<'a, (), SequentialMapGroup<'a>> {
    return match move recordArray<SequentialMapGroup<'a>>(
      self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ComputedArray<'a, (), SequentialMapGroup<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), SequentialMapGroup<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), SequentialMapGroup<'a>>.empty(())
    }
  }

  pub fn groupsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }
}

