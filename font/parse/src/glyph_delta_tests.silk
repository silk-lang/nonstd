effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: result } => move result
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test failed")
    }
  }
}

effect fn present<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: result } => move result
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test failed")
    }
  }
}

fn none<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

fn point(x: i32, y: i32) -> Point<i32> {
  return Point<i32> { x: x, y: y }
}

fn fixedPoint(x: i32, y: i32) -> Point<Fixed> {
  return Point<Fixed> { x: Fixed.fromI32(x), y: Fixed.fromI32(y) }
}

effect fn expectPoint(actual: Point<Fixed>, x: Fixed, y: Fixed) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    Fixed.toBits(actual.x) == Fixed.toBits(x) && Fixed.toBits(actual.y) == Fixed.toBits(y),
    "exact interpolated point",
  )
}

struct Working {
  out: [Point<Fixed>; 6],
  flags: [PointFlags; 6],
}

impl Copy for Working {}

fn working(points: &[Point<i32>], deltas: &[Point<i32>]) -> Working {
  let mut result = Working { out: [fixedPoint(0, 0); 6], flags: [PointFlags.default(); 6] }
  let mut i: usize = 0
  while i < points.length {
    result.out[i] = fixedPoint(points[i].x + deltas[i].x, points[i].y + deltas[i].y)
    if deltas[i].x != 0 || deltas[i].y != 0 {
      PointFlags.setMarker(&mut result.flags[i], PointMarker.hasDelta())
    }
    i = i + 1
  }
  return result
}

test effect fn shift() -> ()
  ! AssertionError<'static> {
  let points = [point(245, 630), point(260, 700), point(305, 680)]
  let deltas = [point(20, -10), point(0, 0), point(0, 0)]
  let mut state = working(&points, &deltas)
  drop run present(interpolateDeltas<i32, Fixed>(&points, &state.flags, &[2], &mut state.out))
  run expectPoint(state.out[0], Fixed.fromI32(265), Fixed.fromI32(620))
  run expectPoint(state.out[1], Fixed.fromI32(280), Fixed.fromI32(690))
  run expectPoint(state.out[2], Fixed.fromI32(325), Fixed.fromI32(670))
}

test effect fn interpolate() -> ()
  ! AssertionError<'static> {
  let points = [point(245, 630), point(260, 700), point(305, 680)]
  let deltas = [point(28, -62), point(0, 0), point(-42, -57)]
  let mut state = working(&points, &deltas)
  drop run present(interpolateDeltas<i32, Fixed>(&points, &state.flags, &[2], &mut state.out))
  run expectPoint(state.out[1], Fixed.fromF64(270.4999237060547), Fixed.fromI32(643))
}

effect fn checkX(xs: &[i32], dx: &[i32], contours: &[u16], expected: &[i32]) -> ()
  ! AssertionError<'static> {
  let mut points = [point(0, 0); 6]
  let mut deltas = [point(0, 0); 6]
  let mut i: usize = 0
  while i < xs.length {
    points[i].x = xs[i]
    deltas[i].x = dx[i]
    i = i + 1
  }
  let view = Slice.view<Point<i32>>(&points, 0, xs.length)
  let mut state = working(view, Slice.view<Point<i32>>(&deltas, 0, xs.length))
  drop run present(interpolateDeltas<i32, Fixed>(view, &state.flags, contours, &mut state.out))
  i = 0
  while i < expected.length {
    run Testing.expect(Fixed.toI32(state.out[i].x) == expected[i], "interpolated x coordinate")
    i = i + 1
  }
}

test effect fn interpolateClampsOutsideTheReferenceRange() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 15, 20, 30], &[0, 4, 0, 14, 0], &[4], &[4, 14, 24, 34, 44])
}

test effect fn contourWithoutDeltasIsUntouched() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 20], &[0, 0, 0], &[2], &[0, 10, 20])
}

test effect fn fullyReferencedContourIsUntouched() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 20], &[1, 2, 3], &[2], &[1, 12, 23])
}

test effect fn contoursAreIndependent() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 20, 100, 110, 120], &[5, 0, 0, 0, 0, 0], &[2, 5], &[5, 15, 25, 100, 110, 120])
}

test effect fn pointsBeforeFirstReferenceWrapAround() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 20, 30], &[0, 6, 6, 0], &[3], &[6, 16, 26, 36])
}

test effect fn equalReferenceCoordsWithDifferentDeltasInferNothing() -> ()
  ! AssertionError<'static> {
  let points = [point(10, 0), point(10, 5), point(10, 10)]
  let deltas = [point(2, 0), point(0, 0), point(6, 0)]
  let mut state = working(&points, &deltas)
  drop run present(interpolateDeltas<i32, Fixed>(&points, &state.flags, &[2], &mut state.out))
  run expectPoint(state.out[1], Fixed.fromI32(10), Fixed.fromI32(5))
}

test effect fn outOfOrderContourEndIsSkipped() -> ()
  ! AssertionError<'static> {
  run checkX(&[0, 10, 20, 30], &[5, 0, 0, 0], &[3, 1], &[5, 15, 25, 35])
}

test effect fn contourEndPastLastPointIsRejected() -> ()
  ! AssertionError<'static> {
  let points = [point(0, 0), point(10, 0)]
  let deltas = [point(5, 0), point(0, 0)]
  let mut state = working(&points, &deltas)
  run Testing.expect(
    none(interpolateDeltas<i32, Fixed>(&points, &state.flags, &[9], &mut state.out)),
    "invalid contour end",
  )
}

struct TestGlyph {
  gvar: Gvar<'static>,
  points: [Point<i32>; 18],
  flags: [PointFlags; 18],
  contours: [u16; 3],
}

impl Copy for TestGlyph {}

effect fn loadGlyph() -> TestGlyph
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.fontVazirmatnVarTrimmed()))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let glyph = run present(run must(Loca.getGlyf(&loca, GlyphId.new(1), &glyf)))
  let simple = match glyph {
    Glyph<'static>.Simple { value } => value
    _ => {
      run Testing.expect(false, "simple outline")
      return Intrinsic.trap("test failure")
    }
  }
  run Testing.expect(SimpleGlyph.numPoints(&simple) == 14, "fixture point count")
  let mut points = [point(0, 0); 14]
  let mut flags = [PointFlags.default(); 14]
  drop run must(SimpleGlyph<'static>.readPointsFast<i32>(&simple, &mut points, &mut flags))
  let mut result = TestGlyph {
    gvar: run must(FontRef.gvar(&font)),
    points: [point(0, 0); 18],
    flags: [PointFlags.default(); 18],
    contours: [0; 3],
  }
  let mut i: usize = 0
  while i < 14 {
    result.points[i] = points[i]
    result.flags[i] = flags[i]
    i = i + 1
  }
  let ends = SimpleGlyph.endPtsOfContours(&simple)
  run Testing.expect(ScalarArray<u16>.len(&ends) == 3, "fixture contours")
  result.contours[0] = run present(ScalarArray<u16>.get(&ends, 0))
  result.contours[1] = run present(ScalarArray<u16>.get(&ends, 1))
  result.contours[2] = run present(ScalarArray<u16>.get(&ends, 2))
  return result
}

struct TestDeltas {
  varied: bool,
  deltas: [Point<Fixed>; 18],
}

impl Copy for TestDeltas {}

effect fn compute(glyph: &mut TestGlyph, gid: u32, coord: f32) -> TestDeltas
  ! AssertionError<'static> {
  let mut result = TestDeltas { varied: false, deltas: [fixedPoint(7, 9); 18] }
  let mut iup = [fixedPoint(0, 0); 18]
  let mut buffers = DeltaBuffers<Fixed> { deltas: &mut result.deltas, iup: &mut iup }
  result.varied = run present(
    Gvar<'static>.simpleDeltas<i32, Fixed>(
      &glyph.gvar,
      GlyphId.new(gid),
      &[F2Dot14.fromF32(coord)],
      &glyph.points,
      &mut glyph.flags,
      &glyph.contours,
      &mut buffers,
    ),
  )
  drop move buffers
  return result
}

fn isZero(deltas: &[Point<Fixed>]) -> bool {
  let mut i: usize = 0
  while i < deltas.length {
    if Fixed.toBits(deltas[i].x) != 0 || Fixed.toBits(deltas[i].y) != 0 {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn same(left: &[Point<Fixed>], right: &[Point<Fixed>]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(left.length == right.length, "same length")
  let mut i: usize = 0
  while i < left.length {
    run expectPoint(left[i], right[i].x, right[i].y)
    i = i + 1
  }
}

test effect fn simpleDeltasAtDefaultLocationAreZero() -> ()
  ! AssertionError<'static> {
  let mut glyph = run loadGlyph()
  let result = run compute(&mut glyph, 1, 0.0)
  run Testing.expect(result.varied && isZero(&result.deltas), "default location has zero deltas")
}

test effect fn simpleDeltasAtExtremeMovePoints() -> ()
  ! AssertionError<'static> {
  let mut glyph = run loadGlyph()
  let result = run compute(&mut glyph, 1, 1.0)
  run Testing.expect(
    result.varied && !isZero(Slice.view<Point<Fixed>>(&result.deltas, 0, 14)),
    "extreme location moves outline",
  )
}

fn magnitude(deltas: &[Point<Fixed>]) -> f64 {
  let mut sum: f64 = 0.0
  let mut i: usize = 0
  while i < deltas.length {
    sum = sum + f64.abs(Fixed.toF64(deltas[i].x)) + f64.abs(Fixed.toF64(deltas[i].y))
    i = i + 1
  }
  return sum
}

test effect fn simpleDeltasScaleAlongTheAxis() -> ()
  ! AssertionError<'static> {
  let mut glyph = run loadGlyph()
  let half = run compute(&mut glyph, 1, 0.5)
  let full = run compute(&mut glyph, 1, 1.0)
  run Testing.expect(
    magnitude(&half.deltas) > 0.0 && magnitude(&half.deltas) < magnitude(&full.deltas),
    "half location moves less",
  )
}

test effect fn deltasDoNotAccumulateAcrossCalls() -> ()
  ! AssertionError<'static> {
  let mut glyph = run loadGlyph()
  let first = run compute(&mut glyph, 1, 1.0)
  let second = run compute(&mut glyph, 1, 1.0)
  run same(&first.deltas, &second.deltas)
}

test effect fn simpleDeltasWithoutVariationDataZeroesBuffer() -> ()
  ! AssertionError<'static> {
  let mut glyph = run loadGlyph()
  let result = run compute(&mut glyph, 0, 1.0)
  run Testing.expect(!result.varied && isZero(&result.deltas), "no variation data zeroes output")
}

test effect fn simpleDeltasRejectsShortIupBuffer() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let points = [point(0, 0); 8]
  let mut flags = [PointFlags.default(); 8]
  let mut deltas = [fixedPoint(0, 0); 8]
  let mut iup = [fixedPoint(0, 0); 4]
  let mut buffers = DeltaBuffers<Fixed> { deltas: &mut deltas, iup: &mut iup }
  run Testing.expect(
    none(
      Gvar<'static>.simpleDeltas<i32, Fixed>(
        &glyph.gvar,
        GlyphId.new(1),
        &[],
        &points,
        &mut flags,
        &[7],
        &mut buffers,
      ),
    ),
    "short IUP buffer rejected",
  )
}

test effect fn simpleDeltasRejectsMissingPhantomPoints() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let points = [point(0, 0); 3]
  let mut flags = [PointFlags.default(); 3]
  let mut deltas = [fixedPoint(0, 0); 3]
  let mut iup = [fixedPoint(0, 0); 3]
  let mut buffers = DeltaBuffers<Fixed> { deltas: &mut deltas, iup: &mut iup }
  run Testing.expect(
    none(
      Gvar<'static>.simpleDeltas<i32, Fixed>(
        &glyph.gvar,
        GlyphId.new(1),
        &[],
        &points,
        &mut flags,
        &[2],
        &mut buffers,
      ),
    ),
    "missing phantom points rejected",
  )
}

test effect fn compositeDeltasWithoutVariationDataZeroesBuffer() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let mut deltas = [fixedPoint(7, 9); 8]
  let varied = run present(
    Gvar<'static>.compositeDeltas<Fixed>(
      &glyph.gvar,
      GlyphId.new(0),
      &[F2Dot14.fromF32(0.5)],
      &mut deltas,
    ),
  )
  run Testing.expect(!varied && isZero(&deltas), "no composite data zeroes output")
}

test effect fn compositeDeltasWithVariationDataReportsTrue() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let mut deltas = [fixedPoint(0, 0); 8]
  run Testing.expect(
    run present(
      Gvar<'static>.compositeDeltas<Fixed>(
        &glyph.gvar,
        GlyphId.new(2),
        &[F2Dot14.one()],
        &mut deltas,
      ),
    ),
    "composite has variations",
  )
}

test effect fn compositeDeltasToleratesShortBuffer() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let mut deltas = [fixedPoint(0, 0); 1]
  run Testing.expect(
    !none(
      Gvar<'static>.compositeDeltas<Fixed>(
        &glyph.gvar,
        GlyphId.new(2),
        &[F2Dot14.one()],
        &mut deltas,
      ),
    ),
    "sparse composite tolerates short output",
  )
}

test effect fn aGlyphWithoutDataStillZeroes() -> ()
  ! AssertionError<'static> {
  let glyph = run loadGlyph()
  let mut deltas = [fixedPoint(7, 9); 8]
  run Testing.expect(
    !(run present(
      Gvar<'static>.compositeDeltas<Fixed>(&glyph.gvar, GlyphId.new(65535), &[], &mut deltas),
    ))
      && isZero(&deltas),
    "missing glyph composite",
  )
  let points = [point(0, 0); 8]
  let mut flags = [PointFlags.default(); 8]
  let mut simpleDeltas = [fixedPoint(7, 9); 8]
  let mut iup = [fixedPoint(0, 0); 8]
  let mut buffers = DeltaBuffers<Fixed> { deltas: &mut simpleDeltas, iup: &mut iup }
  run Testing.expect(
    !(run present(
      Gvar<'static>.simpleDeltas<i32, Fixed>(
        &glyph.gvar,
        GlyphId.new(65535),
        &[],
        &points,
        &mut flags,
        &[7],
        &mut buffers,
      ),
    )),
    "missing glyph simple",
  )
  drop move buffers
  run Testing.expect(isZero(&simpleDeltas), "missing glyph clears simple output")
}

import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

effect fn filled<T: Copy>(value: T, count: usize) -> List<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<T>.make()
  let mut i: usize = 0
  while i < count {
    run List<T>.append(&mut result, value)
    i = i + 1
  }
  return move result
}

test effect fn bothLayersAgree() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run bothLayersImpl() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bothLayersImpl() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(Fixtures.fontVazirmatnVarTrimmed()))
  let gvar = run must(FontRef.gvar(&font))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let coords = [F2Dot14.fromF32(0.5)]
  let mut gid: usize = 0
  while gid < Loca.len(&loca) {
    let id = GlyphId.new(usize.toU32(gid))
    gid = gid + 1
    let maybeOutline = run must(Loca.getGlyf(&loca, id, &glyf))
    let outline = match move maybeOutline {
      Option<Glyph<'static>>.Some { value } => match value {
        Glyph<'static>.Simple { value: simple } => simple
        _ => {
          continue
        }
      }
      _ => {
        continue
      }
    }
    let count = SimpleGlyph.numPoints(&outline) + 4
    let points = run filled(point(0, 0), count)
    let mut flags = run filled(PointFlags.default(), count)
    let mut through = run filled(fixedPoint(0, 0), count)
    let mut iup = run filled(fixedPoint(0, 0), count)
    let mut contours = List<u16>.make()
    let ends = SimpleGlyph.endPtsOfContours(&outline)
    let mut i: usize = 0
    while i < ScalarArray<u16>.len(&ends) {
      run List<u16>.append(&mut contours, run present(ScalarArray<u16>.get(&ends, i)))
      i = i + 1
    }
    let mut buffers = DeltaBuffers<Fixed> {
      deltas: List<Point<Fixed>>.asMutSlice(&mut through),
      iup: List<Point<Fixed>>.asMutSlice(&mut iup),
    }
    let hadData = run present(
      Gvar<'static>.simpleDeltas<i32, Fixed>(
        &gvar,
        id,
        &coords,
        List<Point<i32>>.asSlice(&points),
        List<PointFlags>.asMutSlice(&mut flags),
        List<u16>.asSlice(&contours),
        &mut buffers,
      ),
    )
    drop move buffers
    let maybeData = run must(Gvar.glyphVariationData(&gvar, id))
    let presentData = match &maybeData {
      Option<GlyphVariationData<'static>>.Some { value } => true
      _ => false
    }
    run Testing.expect(hadData == presentData, "wrapper reports data presence")
    if let Option<GlyphVariationData<'static>>.Some { value } = move maybeData {
      let mut direct = run filled(fixedPoint(0, 0), count)
      let mut scratch = run filled(fixedPoint(0, 0), count)
      let mut directFlags = run filled(PointFlags.default(), count)
      let mut directBuffers = DeltaBuffers<Fixed> {
        deltas: List<Point<Fixed>>.asMutSlice(&mut direct),
        iup: List<Point<Fixed>>.asMutSlice(&mut scratch),
      }
      drop run present(
        TupleVariationData<'static, GlyphDelta>.simpleDeltas<i32, Fixed>(
          &value,
          &coords,
          List<Point<i32>>.asSlice(&points),
          List<PointFlags>.asMutSlice(&mut directFlags),
          List<u16>.asSlice(&contours),
          &mut directBuffers,
        ),
      )
      drop move directBuffers
      run same(List<Point<Fixed>>.asSlice(&through), List<Point<Fixed>>.asSlice(&direct))
    }
  }
}

test effect fn shortBuffersAreRejectedByBoth() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shortBuffersImpl() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shortBuffersImpl() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let glyph = run loadGlyph()
  let id = GlyphId.new(2)
  let data = run present(run must(Gvar.glyphVariationData(&glyph.gvar, id)))
  let mut variant: usize = 0
  while variant < 5 {
    let mut pointCount: usize = 8
    let mut flagCount: usize = 8
    let mut deltaCount: usize = 8
    let mut iupCount: usize = 8
    if variant == 0 {
      flagCount = 7
    }
    if variant == 1 {
      deltaCount = 7
    }
    if variant == 2 {
      iupCount = 7
    }
    if variant == 3 {
      pointCount = 3
    }
    let points = run filled(point(0, 0), pointCount)
    let mut flags = run filled(PointFlags.default(), flagCount)
    let mut deltas = run filled(fixedPoint(0, 0), deltaCount)
    let mut iup = run filled(fixedPoint(0, 0), iupCount)
    let mut buffers = DeltaBuffers<Fixed> {
      deltas: List<Point<Fixed>>.asMutSlice(&mut deltas),
      iup: List<Point<Fixed>>.asMutSlice(&mut iup),
    }
    let through = Gvar<'static>.simpleDeltas<i32, Fixed>(
      &glyph.gvar,
      id,
      &[],
      List<Point<i32>>.asSlice(&points),
      List<PointFlags>.asMutSlice(&mut flags),
      &[7],
      &mut buffers,
    )
    let direct = TupleVariationData<'static, GlyphDelta>.simpleDeltas<i32, Fixed>(
      &data,
      &[],
      List<Point<i32>>.asSlice(&points),
      List<PointFlags>.asMutSlice(&mut flags),
      &[7],
      &mut buffers,
    )
    run Testing.expect(
      none(move through) == (variant != 4) && none(move direct) == (variant != 4),
      "both entry points validate every buffer",
    )
    variant = variant + 1
  }
}
