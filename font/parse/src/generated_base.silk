pub union BaseCoord<'a> {
  Format1 { pub value: BaseCoordFormat1<'a> },
  Format2 { pub value: BaseCoordFormat2<'a> },
  Format3 { pub value: BaseCoordFormat3<'a> },
}

impl<'a> Copy for BaseCoord<'a> {}

impl<'a> BaseCoord<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move BaseCoordFormat1<'a>.read(data) {
          Result<BaseCoordFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(BaseCoord<'a>.Format1 { value: value })
          Result<BaseCoordFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move BaseCoordFormat2<'a>.read(data) {
          Result<BaseCoordFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(BaseCoord<'a>.Format2 { value: value })
          Result<BaseCoordFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move BaseCoordFormat3<'a>.read(data) {
          Result<BaseCoordFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(BaseCoord<'a>.Format3 { value: value })
          Result<BaseCoordFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      BaseCoord<'a>.Format1 { value } => BaseCoordFormat1<'a>.offsetData(&value)
      BaseCoord<'a>.Format2 { value } => BaseCoordFormat2<'a>.offsetData(&value)
      BaseCoord<'a>.Format3 { value } => BaseCoordFormat3<'a>.offsetData(&value)
    }
  }

  /// Format identifier — format = 1
  pub fn baseCoordFormat(self: &Self) -> u16 {
    return match &self.* {
      BaseCoord<'a>.Format1 { value } => BaseCoordFormat1<'a>.baseCoordFormat(&value)
      BaseCoord<'a>.Format2 { value } => BaseCoordFormat2<'a>.baseCoordFormat(&value)
      BaseCoord<'a>.Format3 { value } => BaseCoordFormat3<'a>.baseCoordFormat(&value)
    }
  }

  /// X or Y value, in design units
  pub fn coordinate(self: &Self) -> i16 {
    return match &self.* {
      BaseCoord<'a>.Format1 { value } => BaseCoordFormat1<'a>.coordinate(&value)
      BaseCoord<'a>.Format2 { value } => BaseCoordFormat2<'a>.coordinate(&value)
      BaseCoord<'a>.Format3 { value } => BaseCoordFormat3<'a>.coordinate(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for BaseCoord<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return BaseCoord<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for BaseCoord<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      BaseCoord<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      BaseCoord<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      BaseCoord<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      BaseCoord<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      BaseCoord<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      BaseCoord<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> BaseCoord<'a> {
  pub fn default() -> Self {
    return BaseCoord<'a>.Format1 { value: BaseCoordFormat1<'a>.default() }
  }
}

