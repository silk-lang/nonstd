    return resolveNullableWithArgs<(), MinMax<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn defaultMinMaxOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of BaseLangSysRecords defined — may be zero (0)
  pub fn baseLangSysCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn baseLangSysCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of BaseLangSysRecords, in alphabetical order by
  /// BaseLangSysTag
  pub fn baseLangSysRecords(self: &Self) -> ComputedArray<'a, (), BaseLangSysRecord<'a>> {
    return match move recordArray<BaseLangSysRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), BaseLangSysRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), BaseLangSysRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), BaseLangSysRecord<'a>>.empty(())
    }
  }

  pub fn baseLangSysRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

