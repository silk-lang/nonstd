  }
}

impl<'a> FontRead<'a, ()> for BaseCoordFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return BaseCoordFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for BaseCoordFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for BaseCoordFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [BaseCoordFormat2](https://learn.microsoft.com/en-us/typography/opentype/spec/base#basecoord-format-2)
pub struct BaseCoordFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for BaseCoordFormat2<'a> {}

impl<'a> BaseCoordFormat2<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let baseCoordFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coordinateValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let referenceGlyphValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let baseCoordPointValue = scalarOr<u16>(data, ranges[3].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 2
  pub fn baseCoordFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn baseCoordFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// X or Y value, in design units
  pub fn coordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn coordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Glyph ID of control glyph
  pub fn referenceGlyph(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn referenceGlyphByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Index of contour point on the reference glyph
  pub fn baseCoordPoint(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn baseCoordPointByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for BaseCoordFormat2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return BaseCoordFormat2<'a>.read(data)
  }
}

impl<'a> Format<u16> for BaseCoordFormat2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for BaseCoordFormat2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [BaseCoordFormat3](https://learn.microsoft.com/en-us/typography/opentype/spec/base#basecoord-format-3)
pub struct BaseCoordFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for BaseCoordFormat3<'a> {}

impl<'a> BaseCoordFormat3<'a> {
  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let baseCoordFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coordinateValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let deviceOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[2].start,
      Nullable<Offset16>.default(),
    )
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 3
  pub fn baseCoordFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn baseCoordFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// X or Y value, in design units
  pub fn coordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn coordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to Device table (non-variable font) / Variation Index
  /// table (variable font) for X or Y value, from beginning of
  /// BaseCoord table (may be NULL).
  pub fn deviceOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn device(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    let offset = BaseCoordFormat3<'a>.deviceOffset(self)
    return resolveNullableWithArgs<(), DeviceOrVariationIndex<'a>, Offset16>(
      &offset,
      self._fontData,
      (),
    )
  }

  pub fn deviceOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for BaseCoordFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return BaseCoordFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for BaseCoordFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for BaseCoordFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/base_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_types.lib { F48Dot16 }
import tables.baseline_tags as baselineTags

pub enum(u8) BaseAxis {
  Horizontal = 0,
  Vertical = 1,
}

pub struct BaseValue {
  pub value: F48Dot16,
  pub deltaPx: i32,
}

impl Copy for BaseValue {}

impl BaseValue {
  pub fn default() -> Self {
    return Self { value: F48Dot16.zero(), deltaPx: 0 }
  }
}

impl Equal for BaseValue {
  fn equals(a: &Self, b: &Self) -> bool {
    return &a.value == &b.value && a.deltaPx == b.deltaPx
  }
}

pub fn horizontalBaselineTagForScript(script: Tag) -> Tag {
  let hanging: [u32; 21] = [
    1113943655,
    1147500129,
    1198877298,
    1198879349,
    1416192628,
    1281977698,
    1400466543,
    1349017959,
    1299473769,
    1399353956,
    1415670642,
    1299145833,
    1399415908,
    1416196712,
    1298231907,
    1315272545,
    1399814511,
    1516334690,
    1148151666,
    1198485095,
    1315008100,
  ]
  let raw = Tag.toU32(script)
  let mut i: usize = 0
  while i < hanging.length {
    if raw == hanging[i] {
      return baselineTags.hanging()
    }
    i = i + 1
  }
  let ideographic: [u32; 8] = [
    1214344807,
    1214344809,
    1214870113,
    1264676449,
    1114599535,
    1415671399,
    1316186229,
    1265202291,
  ]
  i = 0
  while i < ideographic.length {
    if raw == ideographic[i] {
      return baselineTags.ideoFaceBottomOrLeft()
    }
    i = i + 1
  }
  return baselineTags.roman()
}

fn baseOk<T>(result: Result<T, ReadError>) -> Option<T> {
  return match move result {
    Result<T, ReadError>.Success { value } => Option<T>.some(move value)
    _ => Option<T>.None
  }
}

fn baseFlatten<T>(result: Option<Result<T, ReadError>>) -> Option<T> {
  return match move result {
    Option<Result<T, ReadError>>.Some { value } => baseOk(move value)
    _ => Option<T>.None
  }
}

impl<'a> Base<'a> {
  pub fn axis(self: &Self, axis: BaseAxis) -> Option<Axis<'a>> {
    if axis == BaseAxis.Horizontal {
      return baseFlatten(Base.horizAxis(self))
    }
    return baseFlatten(Base.vertAxis(self))
  }
}

fn findBaseScript<'a>(records: &ComputedArray<'a, (), BaseScriptRecord<'a>>, tag: Tag) -> Option<
  BaseScriptRecord<'a>
> {
  let mut lo: usize = 0
  let mut hi = ComputedArray<'a, (), BaseScriptRecord<'a>>.len(records)
  let target = Tag.toU32(tag)
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let record = match move ComputedArray<'a, (), BaseScriptRecord<'a>>.get(records, mid) {
      Result<BaseScriptRecord<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<BaseScriptRecord<'a>>.None
      }
    }
    let found = Tag.toU32(BaseScriptRecord.baseScriptTag(&record))
    if found < target {
      lo = mid + 1
    } else if found > target {
      hi = mid
    } else {
      return Option<BaseScriptRecord<'a>>.some(record)
    }
  }
  return Option<BaseScriptRecord<'a>>.None
}

impl<'a> Axis<'a> {
  pub fn baseScript(self: &Self, scriptTag: Tag) -> Option<BaseScript<'a>> {
    let list = match move Axis.baseScriptList(self) {
      Result<BaseScriptList<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<BaseScript<'a>>.None
      }
    }
    let records = BaseScriptList.baseScriptRecords(&list)
    let record = match move findBaseScript(&records, scriptTag) {
      Option<BaseScriptRecord<'a>>.Some { value } => value
      _ => match move findBaseScript(&records, Tag.fromU32(1145457748)) {
        Option<BaseScriptRecord<'a>>.Some { value } => value
        _ => {
          return Option<BaseScript<'a>>.None
        }
      }
    }
    return baseOk(BaseScriptRecord.baseScript(&record, BaseScriptList.offsetData(&list)))
  }

  pub fn baselineCoord(self: &Self, baselineTag: Tag, scriptTag: Tag) -> Option<BaseCoord<'a>> {
    let script = match move Axis.baseScript(self, scriptTag) {
      Option<BaseScript<'a>>.Some { value } => value
      _ => {
        return Option<BaseCoord<'a>>.None
      }
    }
    let values = match move baseFlatten(BaseScript.baseValues(&script)) {
      Option<BaseValues<'a>>.Some { value } => value
      _ => {
        return Option<BaseCoord<'a>>.None
      }
    }
    let tags = match move baseFlatten(Axis.baseTagList(self)) {
      Option<BaseTagList<'a>>.Some { value } => BaseTagList.baselineTags(&value)
      _ => {
        return Option<BaseCoord<'a>>.None
      }
    }
    let mut lo: usize = 0
    let mut hi = ScalarArray<Tag>.len(&tags)
    let target = Tag.toU32(baselineTag)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let found = Tag.toU32(ScalarArray<Tag>.get(&tags, mid) |> Option<Tag>.unwrapOr(Tag.default()))
      if found < target {
        lo = mid + 1
      } else if found > target {
        hi = mid
      } else {
        return baseOk(
          ArrayOfOffsets<'a, (), BaseCoord<'a>, Offset16>.get(&BaseValues.baseCoords(&values), mid),
        )
      }
    }
    return Option<BaseCoord<'a>>.None
  }
}

impl<'a> BaseCoord<'a> {
  pub fn device(self: &Self) -> Option<DeviceOrVariationIndex<'a>> {
    return match &self.* {
      BaseCoord<'a>.Format3 { value } => baseFlatten(BaseCoordFormat3.device(&value))
      _ => Option<DeviceOrVariationIndex<'a>>.None
    }
  }
}

pub struct BaseInstance<'a, 'c> {
  baseValue: Base<'a>,
  varStore: Option<ItemVariationStore<'a>>,
  coords: Option<&'c [F2Dot14]>,
}

impl<'a, 'c> BaseInstance<'a, 'c> {
  pub fn new(base: Base<'a>) -> Self {
    let store = baseFlatten(Base.itemVarStore(&base))
    return Self { baseValue: base, varStore: move store, coords: Option<&'c [F2Dot14]>.None }
  }

  pub fn withCoords(base: Base<'a>, coords: &'c [F2Dot14]) -> Self {
    let store = baseFlatten(Base.itemVarStore(&base))
    return Self {
      baseValue: base,
      varStore: move store,
      coords: Option<&'c [F2Dot14]>.some(coords),
    }
  }

  pub fn base(self: &Self) -> Base<'a> {
    return self.baseValue
  }

  pub fn baseline(self: &Self, tag: Tag, axis: BaseAxis, script: Tag) -> Option<F48Dot16> {
    return match move BaseInstance.baselineForPpem(self, tag, axis, script, 0) {
      Option<BaseValue>.Some { value } => Option<F48Dot16>.some(value.value)
      _ => Option<F48Dot16>.None
    }
  }

  pub fn baselineForPpem(self: &Self, tag: Tag, axis: BaseAxis, script: Tag, ppem: u16) -> Option<
    BaseValue
  > {
    let selected = match move Base.axis(&self.baseValue, axis) {
      Option<Axis<'a>>.Some { value } => value
      _ => {
        return Option<BaseValue>.None
      }
    }
    let coord = match move Axis.baselineCoord(&selected, tag, script) {
      Option<BaseCoord<'a>>.Some { value } => value
      _ => {
        return Option<BaseValue>.None
      }
    }
    return Option<BaseValue>.some(BaseInstance.coordForPpem(self, &coord, ppem))
  }

  pub fn coord(self: &Self, coord: &BaseCoord<'a>) -> F48Dot16 {
    return BaseInstance.coordForPpem(self, coord, 0).value
  }

  pub fn coordForPpem(self: &Self, coord: &BaseCoord<'a>, ppem: u16) -> BaseValue {
    let mut value = F48Dot16.fromI32(i16.toI32(BaseCoord.coordinate(coord)))
    let mut pixels: i32 = 0
    if let Option<DeviceOrVariationIndex<'a>>.Some { value: adjustment } = move BaseCoord.device(
      coord,
    ) {
      match adjustment {
        DeviceOrVariationIndex<'a>.Device { value: device } => {
          pixels = Device.deltaForPpem(&device, ppem)
        }
        DeviceOrVariationIndex<'a>.VariationIndex { value: index } => {
          if let Option<ItemVariationStore<'a>>.Some { value: store } = &self.varStore {
            if let Option<&'c [F2Dot14]>.Some { value: coords } = &self.coords {
              if coords.length != 0 {
                if let Option<F48Dot16>.Some {
                  value: delta
                } = move ItemVariationStore.computeDelta(
                  &store,
                  DeltaSetIndex {
                    outer: VariationIndex.deltaSetOuterIndex(&index),
                    inner: VariationIndex.deltaSetInnerIndex(&index),
                  },
                  coords,
                ) {
                  value = value + delta
                }
              }
            }
          }
        }
      }
    }
    return BaseValue { value: value, deltaPx: pixels }
  }
}
