/// [BaseValues](https://learn.microsoft.com/en-us/typography/opentype/spec/base#basevalues-table) table
pub struct BaseValues<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for BaseValues<'a> {}

impl<'a> BaseValues<'a> {
  pub fn default() -> Self {
    return BaseValues<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let defaultBaselineIndexValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let baseCoordCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(baseCoordCountValue), 2))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Index number of default baseline for this script — equals
  /// index position of baseline tag in baselineTags array of the
  /// BaseTagList
  pub fn defaultBaselineIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn defaultBaselineIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of BaseCoord tables defined — should equal
  /// baseTagCount in the BaseTagList
  pub fn baseCoordCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn baseCoordCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of offsets to BaseCoord tables, from beginning of
  /// BaseValues table — order matches baselineTags array in the
  /// BaseTagList
  pub fn baseCoordOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn baseCoords(self: &Self) -> ArrayOfOffsets<'a, (), BaseCoord<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), BaseCoord<'a>, Offset16>.new(
      BaseValues<'a>.baseCoordOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn baseCoordOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for BaseValues<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return BaseValues<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for BaseValues<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [MinMax](https://learn.microsoft.com/en-us/typography/opentype/spec/base#minmax-table) table
pub struct MinMax<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for MinMax<'a> {}

impl<'a> MinMax<'a> {
  pub fn default() -> Self {
    return MinMax<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let minCoordOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[0].start,
      Nullable<Offset16>.default(),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let maxCoordOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[1].start,
      Nullable<Offset16>.default(),
    )
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let featMinMaxCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(featMinMaxCountValue), 8))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Offset to BaseCoord table that defines the minimum extent
  /// value, from the beginning of MinMax table (may be NULL)
  pub fn minCoordOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[0].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn minCoord(self: &Self) -> Option<Result<BaseCoord<'a>, ReadError>> {
    let offset = MinMax<'a>.minCoordOffset(self)
    return resolveNullableWithArgs<(), BaseCoord<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn minCoordOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to BaseCoord table that defines maximum extent value,
  /// from the beginning of MinMax table (may be NULL)
  pub fn maxCoordOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[1].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn maxCoord(self: &Self) -> Option<Result<BaseCoord<'a>, ReadError>> {
    let offset = MinMax<'a>.maxCoordOffset(self)
    return resolveNullableWithArgs<(), BaseCoord<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn maxCoordOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of FeatMinMaxRecords — may be zero (0)
  pub fn featMinMaxCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn featMinMaxCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of FeatMinMaxRecords, in alphabetical order by
  /// featureTableTag
  pub fn featMinMaxRecords(self: &Self) -> ComputedArray<'a, (), FeatMinMaxRecord<'a>> {
    return match move recordArray<FeatMinMaxRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), FeatMinMaxRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), FeatMinMaxRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), FeatMinMaxRecord<'a>>.empty(())
    }
  }

  pub fn featMinMaxRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

