    return match move FontData<'a>.readArray<Nullable<Offset24>>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset24>
      >.empty()
    }
  }

  pub fn chainedClassSeqRuleSets(self: &Self) -> ArrayOfNullableOffsets<
    'a,
    (),
    ChainedClassSequenceRuleSet2<'a>,
    Offset24
  > {
    return ArrayOfNullableOffsets<'a, (), ChainedClassSequenceRuleSet2<'a>, Offset24>.new(
