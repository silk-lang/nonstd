      ClassDef<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      ClassDef<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      ClassDef<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
