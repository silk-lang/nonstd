/// [Condition Table Format 5](https://github.com/fonttools/fonttools/blob/5e6b12d12fa08abafbeb7570f47707fbedf69a45/Lib/fontTools/ttLib/tables/otData.py#L3296-L3308): NOT
pub struct ConditionFormat5<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for ConditionFormat5<'a> {}

impl<'a> ConditionFormat5<'a> {
  pub fn minSize() -> usize {
    return 5
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 5 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[1].end = end
    let conditionOffsetValue = scalarOr<Offset24>(
      data,
      ranges[1].start,
      Offset24.new(Uint24.new(0)),
    )
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format, = 5
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Condition to negate.
  pub fn conditionOffset(self: &Self) -> Offset24 {
    return match move FontData<'a>.readAt<Offset24>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset24, ReadError>.Success { value } => value
      Result<Offset24, ReadError>.Failure { error } => Offset24.new(Uint24.new(0))
    }
  }

  pub fn condition(self: &Self) -> Result<Condition<'a>, ReadError> {
    let offset = ConditionFormat5<'a>.conditionOffset(self)
    return resolveWithArgs<(), Condition<'a>, Offset24>(offset, self._fontData, ())
  }

  pub fn conditionOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for ConditionFormat5<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ConditionFormat5<'a>.read(data)
  }
}

impl<'a> Format<u16> for ConditionFormat5<'a> {
  fn formatValue() -> u16 {
    return 5
  }
}

impl<'a> MinByteRange<'a> for ConditionFormat5<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [FeatureTableSubstitution Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#featuretablesubstitution-table)
pub struct FeatureTableSubstitution<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for FeatureTableSubstitution<'a> {}

impl<'a> FeatureTableSubstitution<'a> {
  pub fn default() -> Self {
    return FeatureTableSubstitution<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let versionValue = scalarOr<MajorMinor>(data, ranges[0].start, MajorMinor.new(0, 0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let substitutionCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(substitutionCountValue), 6))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Major & minor version of the table: (1, 0)
  pub fn version(self: &Self) -> MajorMinor {
    return match move FontData<'a>.readAt<MajorMinor>(&self._fontData, self._fieldRanges[0].start) {
      Result<MajorMinor, ReadError>.Success { value } => value
      Result<MajorMinor, ReadError>.Failure { error } => MajorMinor.new(0, 0)
    }
  }

  pub fn versionByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of feature table substitution records.
  pub fn substitutionCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn substitutionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of feature table substitution records.
  pub fn substitutions(self: &Self) -> ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>> {
    return match move recordArray<FeatureTableSubstitutionRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>, ReadError>.Success {
        value
      } => value
      Result<ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), FeatureTableSubstitutionRecord<'a>>.empty(())
    }
  }

  pub fn substitutionsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for FeatureTableSubstitution<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return FeatureTableSubstitution<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for FeatureTableSubstitution<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Used in [FeatureTableSubstitution]
pub struct FeatureTableSubstitutionRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for FeatureTableSubstitutionRecord<'a> {}

impl<'a> FeatureTableSubstitutionRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// The feature table index to match.
  pub fn featureIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Offset to an alternate feature table, from start of the
  /// FeatureTableSubstitution table.
  pub fn alternateFeatureOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, (self.position + 2)) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }
}

impl<'a> FixedSize for FeatureTableSubstitutionRecord<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for FeatureTableSubstitutionRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for FeatureTableSubstitutionRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return FeatureTableSubstitutionRecord<'a>.readAt(data, position, ())
  }
}

pub struct SizeParams<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for SizeParams<'a> {}

impl<'a> SizeParams<'a> {
  pub fn default() -> Self {
    return SizeParams<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 5] },
      )
  }

  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let designSizeValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let identifierValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let nameEntryValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let rangeStartValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let rangeEndValue = scalarOr<u16>(data, ranges[4].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// The first value represents the design size in 720/inch units (decipoints).
  ///
  /// The design size entry must be non-zero. When there is a design size but
  /// no recommended size range, the rest of the array will consist of zeros.
  pub fn designSize(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn designSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// The second value has no independent meaning, but serves as an identifier that associates fonts in a subfamily.
  ///
  /// All fonts which share a Typographic or Font Family name and which differ
  /// only by size range shall have the same subfamily value, and no fonts
  /// which differ in weight or style shall have the same subfamily value.
  /// If this value is zero, the remaining fields in the array will be ignored.
  pub fn identifier(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn identifierByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The third value enables applications to use a single name for the subfamily identified by the second value.
  ///
  /// If the preceding value is non-zero, this value must be set in the range
  /// 256 – 32767 (inclusive). It records the value of a field in the 'name'
  /// table, which must contain English-language strings encoded in Windows
  /// Unicode and Macintosh Roman, and may contain additional strings localized
  /// to other scripts and languages. Each of these strings is the name
  /// an application should use, in combination with the family name, to
  /// represent the subfamily in a menu. Applications will choose the
  /// appropriate version based on their selection criteria.
  pub fn nameEntry(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn nameEntryByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// The fourth and fifth values represent the small end of the recommended
  /// usage range (exclusive) and the large end of the recommended usage range
  /// (inclusive), stored in 720/inch units (decipoints).
  ///
  /// Ranges must not overlap, and should generally be contiguous.
  pub fn rangeStart(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn rangeStartByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  pub fn rangeEnd(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn rangeEndByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for SizeParams<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SizeParams<'a>.read(data)
