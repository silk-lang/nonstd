  }

  /// Offset to ClassDef table containing input sequence context,
  /// from beginning of ChainedSequenceContextFormat5 table
  pub fn inputClassDefOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[3].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn inputClassDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
