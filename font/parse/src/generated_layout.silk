pub union SequenceContext<'a> {
  Format1 { pub value: SequenceContextFormat1<'a> },
  Format2 { pub value: SequenceContextFormat2<'a> },
  Format3 { pub value: SequenceContextFormat3<'a> },
  Format4 { pub value: SequenceContextFormat4<'a> },
  Format5 { pub value: SequenceContextFormat5<'a> },
  Format6 { pub value: SequenceContextFormat6<'a> },
}

impl<'a> Copy for SequenceContext<'a> {}

impl<'a> SequenceContext<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move SequenceContextFormat1<'a>.read(data) {
          Result<SequenceContextFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format1 { value: value })
          Result<SequenceContextFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move SequenceContextFormat2<'a>.read(data) {
          Result<SequenceContextFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format2 { value: value })
          Result<SequenceContextFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move SequenceContextFormat3<'a>.read(data) {
          Result<SequenceContextFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format3 { value: value })
          Result<SequenceContextFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move SequenceContextFormat4<'a>.read(data) {
          Result<SequenceContextFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format4 { value: value })
          Result<SequenceContextFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      5 => {
        return match move SequenceContextFormat5<'a>.read(data) {
          Result<SequenceContextFormat5<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format5 { value: value })
          Result<SequenceContextFormat5<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      6 => {
        return match move SequenceContextFormat6<'a>.read(data) {
          Result<SequenceContextFormat6<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SequenceContext<'a>.Format6 { value: value })
          Result<SequenceContextFormat6<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      SequenceContext<'a>.Format1 { value } => SequenceContextFormat1<'a>.offsetData(&value)
      SequenceContext<'a>.Format2 { value } => SequenceContextFormat2<'a>.offsetData(&value)
      SequenceContext<'a>.Format3 { value } => SequenceContextFormat3<'a>.offsetData(&value)
      SequenceContext<'a>.Format4 { value } => SequenceContextFormat4<'a>.offsetData(&value)
      SequenceContext<'a>.Format5 { value } => SequenceContextFormat5<'a>.offsetData(&value)
      SequenceContext<'a>.Format6 { value } => SequenceContextFormat6<'a>.offsetData(&value)
    }
  }

  /// Format identifier: format = 1
  pub fn format(self: &Self) -> u16 {
    return match &self.* {
      SequenceContext<'a>.Format1 { value } => SequenceContextFormat1<'a>.format(&value)
      SequenceContext<'a>.Format2 { value } => SequenceContextFormat2<'a>.format(&value)
      SequenceContext<'a>.Format3 { value } => SequenceContextFormat3<'a>.format(&value)
      SequenceContext<'a>.Format4 { value } => SequenceContextFormat4<'a>.format(&value)
      SequenceContext<'a>.Format5 { value } => SequenceContextFormat5<'a>.format(&value)
      SequenceContext<'a>.Format6 { value } => SequenceContextFormat6<'a>.format(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for SequenceContext<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SequenceContext<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for SequenceContext<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      SequenceContext<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      SequenceContext<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      SequenceContext<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      SequenceContext<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
      SequenceContext<'a>.Format5 { value } => MinByteRange.minByteRange(&value)
      SequenceContext<'a>.Format6 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      SequenceContext<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      SequenceContext<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      SequenceContext<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      SequenceContext<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
      SequenceContext<'a>.Format5 { value } => MinByteRange.minTableBytes(&value)
      SequenceContext<'a>.Format6 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> SequenceContext<'a> {
  pub fn default() -> Self {
    return SequenceContext<'a>.Format1 { value: SequenceContextFormat1<'a>.default() }
  }
}

