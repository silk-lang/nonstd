  }

  pub fn lookups(self: &Self) -> ArrayOfOffsets<'a, (), T, Offset32> {
    return ArrayOfOffsets<'a, (), T, Offset32>.new(
      LookupList2<'a, T>.lookupOffsets(self),
      self._fontData,
