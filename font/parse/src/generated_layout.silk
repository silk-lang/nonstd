/// featureParams for ['cv01'-'cv99'](https://docs.microsoft.com/en-us/typography/opentype/spec/features_ae#cv01-cv99)
pub struct CharacterVariantParams<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 8],
}

impl<'a> Copy for CharacterVariantParams<'a> {}

impl<'a> CharacterVariantParams<'a> {
  pub fn default() -> Self {
    return CharacterVariantParams<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 8] },
      )
  }

  pub fn minSize() -> usize {
    return 14
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 14 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 8] = [ByteRange { start: 0, end: 0 }; 8]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let featUiLabelNameIdValue = scalarOr<NameId>(data, ranges[1].start, NameId.default())
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let featUiTooltipTextNameIdValue = scalarOr<NameId>(data, ranges[2].start, NameId.default())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let sampleTextNameIdValue = scalarOr<NameId>(data, ranges[3].start, NameId.default())
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let numNamedParametersValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let firstParamUiLabelNameIdValue = scalarOr<NameId>(data, ranges[5].start, NameId.default())
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let charCountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(charCountValue), 3))
    ranges[7].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 0.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// The 'name' table name ID that specifies a string (or strings,
  /// for multiple languages) for a user-interface label for this
  /// feature. (May be NULL.)
  pub fn featUiLabelNameId(self: &Self) -> NameId {
    return match move FontData<'a>.readAt<NameId>(&self._fontData, self._fieldRanges[1].start) {
      Result<NameId, ReadError>.Success { value } => value
      Result<NameId, ReadError>.Failure { error } => NameId.default()
    }
  }

  pub fn featUiLabelNameIdByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The 'name' table name ID that specifies a string (or strings,
  /// for multiple languages) that an application can use for tooltip
  /// text for this feature. (May be NULL.)
  pub fn featUiTooltipTextNameId(self: &Self) -> NameId {
    return match move FontData<'a>.readAt<NameId>(&self._fontData, self._fieldRanges[2].start) {
      Result<NameId, ReadError>.Success { value } => value
      Result<NameId, ReadError>.Failure { error } => NameId.default()
    }
  }

  pub fn featUiTooltipTextNameIdByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// The 'name' table name ID that specifies sample text that
  /// illustrates the effect of this feature. (May be NULL.)
  pub fn sampleTextNameId(self: &Self) -> NameId {
    return match move FontData<'a>.readAt<NameId>(&self._fontData, self._fieldRanges[3].start) {
      Result<NameId, ReadError>.Success { value } => value
      Result<NameId, ReadError>.Failure { error } => NameId.default()
    }
  }

  pub fn sampleTextNameIdByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of named parameters. (May be zero.)
  pub fn numNamedParameters(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn numNamedParametersByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// The first 'name' table name ID used to specify strings for
  /// user-interface labels for the feature parameters. (Must be zero
  /// if numParameters is zero.)
  pub fn firstParamUiLabelNameId(self: &Self) -> NameId {
    return match move FontData<'a>.readAt<NameId>(&self._fontData, self._fieldRanges[5].start) {
      Result<NameId, ReadError>.Success { value } => value
      Result<NameId, ReadError>.Failure { error } => NameId.default()
    }
  }

  pub fn firstParamUiLabelNameIdByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// The count of characters for which this feature provides glyph
  /// variants. (May be zero.)
  pub fn charCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn charCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// The Unicode Scalar Value of the characters for which this
  /// feature provides glyph variants.
  pub fn character(self: &Self) -> ScalarArray<'a, Uint24> {
    return match move FontData<'a>.readArray<Uint24>(
      &self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ScalarArray<'a, Uint24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Uint24>, ReadError>.Failure { error } => ScalarArray<Uint24>.empty()
    }
  }

  pub fn characterByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }
}

impl<'a> FontRead<'a, ()> for CharacterVariantParams<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CharacterVariantParams<'a>.read(data)
  }
}

