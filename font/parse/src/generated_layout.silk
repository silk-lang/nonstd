    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub struct StylisticSetParams<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for StylisticSetParams<'a> {}

impl<'a> StylisticSetParams<'a> {
  pub fn default() -> Self {
    return StylisticSetParams<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let versionValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let uiNameIdValue = scalarOr<NameId>(data, ranges[1].start, NameId.default())
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn version(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn versionByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// The 'name' table name ID that specifies a string (or strings, for
  /// multiple languages) for a user-interface label for this feature.
  ///
  /// The value of uiLabelNameId is expected to be in the font-specific name
  /// ID range (256-32767), though that is not a requirement in this Feature
