      usize.saturatingMultiply(u16.toUsize(backtrackGlyphCountValue), 2),
    )
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let inputGlyphCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingSubtract(u16.toUsize(inputGlyphCountValue), 1), 2),
    )
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let lookaheadGlyphCountValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(lookaheadGlyphCountValue), 2),
    )
    ranges[5].end = end
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let seqLookupCountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(seqLookupCountValue), 4))
    ranges[7].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of glyphs in the backtrack sequence
  pub fn backtrackGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn backtrackGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of backtrack glyph IDs
  pub fn backtrackSequence(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn backtrackSequenceByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of glyphs in the input sequence
  pub fn inputGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn inputGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of input glyph IDs—start with second glyph
  pub fn inputSequence(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn inputSequenceByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of glyphs in the lookahead sequence
  pub fn lookaheadGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookaheadGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Array of lookahead glyph IDs
  pub fn lookaheadSequence(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn lookaheadSequenceByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Number of SequenceLookupRecords
  pub fn seqLookupCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn seqLookupCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// Array of SequenceLookupRecords
  pub fn seqLookupRecords(self: &Self) -> ComputedArray<'a, (), SequenceLookupRecord<'a>> {
    return match move recordArray<SequenceLookupRecord<'a>>(
      self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), SequenceLookupRecord<'a>>.empty(())
    }
  }

  pub fn seqLookupRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }
}

impl<'a> FontRead<'a, ()> for ChainedSequenceRule<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ChainedSequenceRule<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ChainedSequenceRule<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[7].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[7].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Chained Sequence Context Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#chained-sequence-context-format-2-class-based-glyph-contexts)
pub struct ChainedSequenceContextFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 7],
}

impl<'a> Copy for ChainedSequenceContextFormat2<'a> {}

impl<'a> ChainedSequenceContextFormat2<'a> {
  pub fn minSize() -> usize {
    return 12
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 12 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 7] = [ByteRange { start: 0, end: 0 }; 7]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let backtrackClassDefOffsetValue = scalarOr<Offset16>(data, ranges[2].start, Offset16.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let inputClassDefOffsetValue = scalarOr<Offset16>(data, ranges[3].start, Offset16.new(0))
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let lookaheadClassDefOffsetValue = scalarOr<Offset16>(data, ranges[4].start, Offset16.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let chainedClassSeqRuleSetCountValue = scalarOr<u16>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(chainedClassSeqRuleSetCountValue), 2),
    )
    ranges[6].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of
  /// ChainedSequenceContextFormat2 table
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to ClassDef table containing backtrack sequence context,
  /// from beginning of ChainedSequenceContextFormat2 table
  pub fn backtrackClassDefOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn backtrackClassDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat2<'a>.backtrackClassDefOffset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn backtrackClassDefOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Offset to ClassDef table containing input sequence context,
  /// from beginning of ChainedSequenceContextFormat2 table
  pub fn inputClassDefOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[3].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn inputClassDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat2<'a>.inputClassDefOffset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn inputClassDefOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to ClassDef table containing lookahead sequence context,
  /// from beginning of ChainedSequenceContextFormat2 table
  pub fn lookaheadClassDefOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn lookaheadClassDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat2<'a>.lookaheadClassDefOffset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn lookaheadClassDefOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Number of ChainedClassSequenceRuleSet tables
  pub fn chainedClassSeqRuleSetCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[5].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn chainedClassSeqRuleSetCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Array of offsets to ChainedClassSequenceRuleSet tables, from
  /// beginning of ChainedSequenceContextFormat2 table (may be NULL)
  pub fn chainedClassSeqRuleSetOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset16>> {
    return match move FontData<'a>.readArray<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset16>
      >.empty()
    }
  }

  pub fn chainedClassSeqRuleSets(self: &Self) -> ArrayOfNullableOffsets<
    'a,
    (),
    ChainedClassSequenceRuleSet<'a>,
    Offset16
  > {
    return ArrayOfNullableOffsets<'a, (), ChainedClassSequenceRuleSet<'a>, Offset16>.new(
      ChainedSequenceContextFormat2<'a>.chainedClassSeqRuleSetOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn chainedClassSeqRuleSetOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }
}

impl<'a> FontRead<'a, ()> for ChainedSequenceContextFormat2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ChainedSequenceContextFormat2<'a>.read(data)
  }
}

impl<'a> Format<u16> for ChainedSequenceContextFormat2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for ChainedSequenceContextFormat2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[6].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[6].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

