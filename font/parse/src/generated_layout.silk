/// [Chained Sequence Context Format 3](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#chained-sequence-context-format-3-coverage-based-glyph-contexts)
pub struct ChainedSequenceContextFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 9],
}

impl<'a> Copy for ChainedSequenceContextFormat3<'a> {}

impl<'a> ChainedSequenceContextFormat3<'a> {
  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 9] = [ByteRange { start: 0, end: 0 }; 9]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let backtrackGlyphCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(backtrackGlyphCountValue), 2),
    )
    ranges[2].end = end
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let inputGlyphCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(inputGlyphCountValue), 2))
    ranges[4].end = end
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let lookaheadGlyphCountValue = scalarOr<u16>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(lookaheadGlyphCountValue), 2),
    )
    ranges[6].end = end
    ranges[7].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[7].end = end
    let seqLookupCountValue = scalarOr<u16>(data, ranges[7].start, 0)
    ranges[8].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(seqLookupCountValue), 4))
    ranges[8].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 3
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of glyphs in the backtrack sequence
  pub fn backtrackGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn backtrackGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of offsets to coverage tables for the backtrack sequence
  pub fn backtrackCoverageOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn backtrackCoverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      ChainedSequenceContextFormat3<'a>.backtrackCoverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn backtrackCoverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of glyphs in the input sequence
  pub fn inputGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn inputGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Array of offsets to coverage tables for the input sequence
  pub fn inputCoverageOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn inputCoverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      ChainedSequenceContextFormat3<'a>.inputCoverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn inputCoverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Number of glyphs in the lookahead sequence
  pub fn lookaheadGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[5].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookaheadGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Array of offsets to coverage tables for the lookahead sequence
  pub fn lookaheadCoverageOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn lookaheadCoverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      ChainedSequenceContextFormat3<'a>.lookaheadCoverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn lookaheadCoverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// Number of SequenceLookupRecords
  pub fn seqLookupCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[7].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn seqLookupCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }

  /// Array of SequenceLookupRecords
  pub fn seqLookupRecords(self: &Self) -> ComputedArray<'a, (), SequenceLookupRecord<'a>> {
    return match move recordArray<SequenceLookupRecord<'a>>(
      self._fontData,
      self._fieldRanges[8].start,
      self._fieldRanges[8].end,
    ) {
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), SequenceLookupRecord<'a>>.empty(())
    }
  }

  pub fn seqLookupRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[8]
  }
}

impl<'a> FontRead<'a, ()> for ChainedSequenceContextFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ChainedSequenceContextFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for ChainedSequenceContextFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for ChainedSequenceContextFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[8].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[8].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub union ChainedSequenceContext<'a> {
  Format1 { pub value: ChainedSequenceContextFormat1<'a> },
  Format2 { pub value: ChainedSequenceContextFormat2<'a> },
  Format3 { pub value: ChainedSequenceContextFormat3<'a> },
  Format4 { pub value: ChainedSequenceContextFormat4<'a> },
  Format5 { pub value: ChainedSequenceContextFormat5<'a> },
}

impl<'a> Copy for ChainedSequenceContext<'a> {}

impl<'a> ChainedSequenceContext<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move ChainedSequenceContextFormat1<'a>.read(data) {
          Result<ChainedSequenceContextFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ChainedSequenceContext<'a>.Format1 { value: value })
          Result<ChainedSequenceContextFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ChainedSequenceContextFormat2<'a>.read(data) {
          Result<ChainedSequenceContextFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ChainedSequenceContext<'a>.Format2 { value: value })
          Result<ChainedSequenceContextFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move ChainedSequenceContextFormat3<'a>.read(data) {
          Result<ChainedSequenceContextFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ChainedSequenceContext<'a>.Format3 { value: value })
          Result<ChainedSequenceContextFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move ChainedSequenceContextFormat4<'a>.read(data) {
          Result<ChainedSequenceContextFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ChainedSequenceContext<'a>.Format4 { value: value })
          Result<ChainedSequenceContextFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      5 => {
        return match move ChainedSequenceContextFormat5<'a>.read(data) {
          Result<ChainedSequenceContextFormat5<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ChainedSequenceContext<'a>.Format5 { value: value })
          Result<ChainedSequenceContextFormat5<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      ChainedSequenceContext<'a>.Format1 { value } => ChainedSequenceContextFormat1<'a>.offsetData(
        &value,
      )
      ChainedSequenceContext<'a>.Format2 { value } => ChainedSequenceContextFormat2<'a>.offsetData(
        &value,
      )
      ChainedSequenceContext<'a>.Format3 { value } => ChainedSequenceContextFormat3<'a>.offsetData(
        &value,
      )
      ChainedSequenceContext<'a>.Format4 { value } => ChainedSequenceContextFormat4<'a>.offsetData(
        &value,
      )
      ChainedSequenceContext<'a>.Format5 { value } => ChainedSequenceContextFormat5<'a>.offsetData(
        &value,
      )
    }
  }

  /// Format identifier: format = 1
  pub fn format(self: &Self) -> u16 {
    return match &self.* {
      ChainedSequenceContext<'a>.Format1 { value } => ChainedSequenceContextFormat1<'a>.format(
        &value,
      )
      ChainedSequenceContext<'a>.Format2 { value } => ChainedSequenceContextFormat2<'a>.format(
        &value,
      )
      ChainedSequenceContext<'a>.Format3 { value } => ChainedSequenceContextFormat3<'a>.format(
        &value,
      )
      ChainedSequenceContext<'a>.Format4 { value } => ChainedSequenceContextFormat4<'a>.format(
        &value,
      )
      ChainedSequenceContext<'a>.Format5 { value } => ChainedSequenceContextFormat5<'a>.format(
        &value,
      )
    }
  }
}

impl<'a> FontRead<'a, ()> for ChainedSequenceContext<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ChainedSequenceContext<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ChainedSequenceContext<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      ChainedSequenceContext<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      ChainedSequenceContext<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      ChainedSequenceContext<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      ChainedSequenceContext<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
      ChainedSequenceContext<'a>.Format5 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      ChainedSequenceContext<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      ChainedSequenceContext<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      ChainedSequenceContext<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      ChainedSequenceContext<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
      ChainedSequenceContext<'a>.Format5 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> ChainedSequenceContext<'a> {
  pub fn default() -> Self {
    return ChainedSequenceContext<'a>.Format1 { value: ChainedSequenceContextFormat1<'a>.default() }
  }
}

/// [Device](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#device-and-variationindex-tables)
/// delta formats
pub enum(u16) DeltaFormat {
  /// Signed 2-bit value, 8 values per uint16
  Local2BitDeltas = 1,
  /// Signed 4-bit value, 4 values per uint16
  Local4BitDeltas = 2,
  /// Signed 8-bit value, 2 values per uint16
  Local8BitDeltas = 3,
  /// VariationIndex table, contains a delta-set index pair.
  VariationIndex = 32768,
  Unknown,
}

impl DeltaFormat {
  pub fn new(raw: u16) -> DeltaFormat {
    return match raw {
      1 => DeltaFormat.Local2BitDeltas
      2 => DeltaFormat.Local4BitDeltas
      3 => DeltaFormat.Local8BitDeltas
      32768 => DeltaFormat.VariationIndex
      _ => DeltaFormat.Unknown
    }
  }
}

impl DeltaFormat {
  pub fn default() -> Self {
    return DeltaFormat.Local2BitDeltas
  }
}

impl Scalar for DeltaFormat {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(DeltaFormat.new(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(DeltaFormat.value(value), move bytes)
  }
}

impl FixedSize for DeltaFormat {
  fn rawByteLen() -> usize {
    return 2
  }
}

/// [Device Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#device-and-variationindex-tables)
pub struct Device<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for Device<'a> {}

impl<'a> Device<'a> {
  pub fn default() -> Self {
    return Device<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let startSizeValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let endSizeValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let deltaFormatValue = scalarOr<DeltaFormat>(data, ranges[2].start, DeltaFormat.Local2BitDeltas)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(deltaValueCount(deltaFormatValue, startSizeValue, endSizeValue), 2),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Smallest size to correct, in ppem
  pub fn startSize(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn startSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Largest size to correct, in ppem
  pub fn endSize(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn endSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Format of deltaValue array data: 0x0001, 0x0002, or 0x0003
  pub fn deltaFormat(self: &Self) -> DeltaFormat {
    return match move FontData<'a>.readAt<DeltaFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<DeltaFormat, ReadError>.Success { value } => value
      Result<DeltaFormat, ReadError>.Failure { error } => DeltaFormat.Local2BitDeltas
    }
  }

  pub fn deltaFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of compressed data
  pub fn deltaValue(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn deltaValueByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for Device<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Device<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for Device<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Variation index table
pub struct VariationIndex<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for VariationIndex<'a> {}

impl<'a> VariationIndex<'a> {
  pub fn default() -> Self {
    return VariationIndex<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let deltaSetOuterIndexValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let deltaSetInnerIndexValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let deltaFormatValue = scalarOr<DeltaFormat>(data, ranges[2].start, DeltaFormat.Local2BitDeltas)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// A delta-set outer index — used to select an item variation
  /// data subtable within the item variation store.
  pub fn deltaSetOuterIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn deltaSetOuterIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// A delta-set inner index — used to select a delta-set row
  /// within an item variation data subtable.
  pub fn deltaSetInnerIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn deltaSetInnerIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Format, = 0x8000
  pub fn deltaFormat(self: &Self) -> DeltaFormat {
    return match move FontData<'a>.readAt<DeltaFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<DeltaFormat, ReadError>.Success { value } => value
      Result<DeltaFormat, ReadError>.Failure { error } => DeltaFormat.Local2BitDeltas
    }
  }

  pub fn deltaFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for VariationIndex<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return VariationIndex<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for VariationIndex<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub union DeviceOrVariationIndex<'a> {
  Device { pub value: Device<'a> },
  VariationIndex { pub value: VariationIndex<'a> },
}

impl<'a> Copy for DeviceOrVariationIndex<'a> {}

impl<'a> DeviceOrVariationIndex<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<DeltaFormat>(&data, 4) {
      Result<DeltaFormat, ReadError>.Success { value } => value
      Result<DeltaFormat, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    if format == DeltaFormat.VariationIndex {
      return match move VariationIndex<'a>.read(data) {
        Result<VariationIndex<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          DeviceOrVariationIndex<'a>.VariationIndex { value: value },
        )
        Result<VariationIndex<'a>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    if true {
      return match move Device<'a>.read(data) {
        Result<Device<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          DeviceOrVariationIndex<'a>.Device { value: value },
        )
        Result<Device<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      DeviceOrVariationIndex<'a>.Device { value } => Device<'a>.offsetData(&value)
      DeviceOrVariationIndex<'a>.VariationIndex { value } => VariationIndex<'a>.offsetData(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for DeviceOrVariationIndex<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return DeviceOrVariationIndex<'a>.read(data)
  }
}

/// [FeatureVariations Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#featurevariations-table)
/// Version 1.1 is defined in ISO/IEC 14496-22:2026, 6.2.11.
pub struct FeatureVariations<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for FeatureVariations<'a> {}

impl<'a> FeatureVariations<'a> {
  pub fn default() -> Self {
    return FeatureVariations<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 5] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let versionValue = scalarOr<MajorMinor>(data, ranges[0].start, MajorMinor.new(0, 0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let featureVariationRecordCountValue = scalarOr<u32>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(featureVariationRecordCountValue), 8),
    )
    ranges[2].end = end
    ranges[3].start = end
    if MajorMinor.compatible(&versionValue, MajorMinor.new(1, 1)) {
      end = usize.saturatingAdd(end, 4)
    }
    ranges[3].end = end
    let lookupVariationRecordCountValue = scalarOr<u32>(data, ranges[3].start, 0)
    ranges[4].start = end
    if MajorMinor.compatible(&versionValue, MajorMinor.new(1, 1)) {
      end = usize.saturatingAdd(
        end,
        usize.saturatingMultiply(u32.toUsize(lookupVariationRecordCountValue), 6),
      )
    }
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn version(self: &Self) -> MajorMinor {
    return match move FontData<'a>.readAt<MajorMinor>(&self._fontData, self._fieldRanges[0].start) {
      Result<MajorMinor, ReadError>.Success { value } => value
      Result<MajorMinor, ReadError>.Failure { error } => MajorMinor.new(0, 0)
    }
  }

  pub fn versionByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of feature variation records.
  pub fn featureVariationRecordCount(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[1].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn featureVariationRecordCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of feature variation records.
  pub fn featureVariationRecords(self: &Self) -> ComputedArray<'a, (), FeatureVariationRecord<'a>> {
    return match move recordArray<FeatureVariationRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), FeatureVariationRecord<'a>>, ReadError>.Success {
        value
      } => value
      Result<ComputedArray<'a, (), FeatureVariationRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), FeatureVariationRecord<'a>>.empty(())
    }
  }

  pub fn featureVariationRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of lookup variation records.
  pub fn lookupVariationRecordCount(self: &Self) -> Option<u32> {
    if self._fieldRanges[3].start == self._fieldRanges[3].end {
      return Option<u32>.None
    }
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[3].start) {
      Result<u32, ReadError>.Success { value } => Option<u32>.some(value)
      Result<u32, ReadError>.Failure { error } => Option<u32>.None
    }
  }

  pub fn lookupVariationRecordCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  pub fn lookupVariationRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for FeatureVariations<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return FeatureVariations<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for FeatureVariations<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [FeatureVariations]
pub struct FeatureVariationRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for FeatureVariationRecord<'a> {}

impl<'a> FeatureVariationRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Offset to a condition set table, from beginning of
  /// FeatureVariations table.
  pub fn conditionSetOffset(self: &Self) -> Nullable<Offset32> {
    return match move FontData<'a>.readAt<Nullable<Offset32>>(
      &self._fontData,
      (self.position + 0),
    ) {
      Result<Nullable<Offset32>, ReadError>.Success { value } => value
      Result<Nullable<Offset32>, ReadError>.Failure { error } => Nullable<Offset32>.default()
    }
  }

  pub fn conditionSet(self: &Self, data: FontData<'a>) -> Option<
    Result<ConditionSet<'a>, ReadError>
  > {
    let offset = FeatureVariationRecord<'a>.conditionSetOffset(self)
    return resolveNullableWithArgs<(), ConditionSet<'a>, Offset32>(&offset, data, ())
  }

  /// Offset to a feature table substitution table, from beginning of
  /// the FeatureVariations table.
  pub fn featureTableSubstitutionOffset(self: &Self) -> Nullable<Offset32> {
    return match move FontData<'a>.readAt<Nullable<Offset32>>(
      &self._fontData,
      (self.position + 4),
    ) {
      Result<Nullable<Offset32>, ReadError>.Success { value } => value
      Result<Nullable<Offset32>, ReadError>.Failure { error } => Nullable<Offset32>.default()
    }
  }

  pub fn featureTableSubstitution(self: &Self, data: FontData<'a>) -> Option<
    Result<FeatureTableSubstitution<'a>, ReadError>
  > {
    let offset = FeatureVariationRecord<'a>.featureTableSubstitutionOffset(self)
    return resolveNullableWithArgs<(), FeatureTableSubstitution<'a>, Offset32>(&offset, data, ())
  }
}

impl<'a> FixedSize for FeatureVariationRecord<'a> {
  fn rawByteLen() -> usize {
    return 8
  }
}

impl<'a> ComputeSize<()> for FeatureVariationRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(8)
  }
}

impl<'a> FontReadAt<'a, ()> for FeatureVariationRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return FeatureVariationRecord<'a>.readAt(data, position, ())
  }
}

/// Lookup variations for one feature (ISO/IEC 14496-22:2026, 6.2.11).
pub struct LookupVariationRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for LookupVariationRecord<'a> {}

impl<'a> LookupVariationRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  pub fn featureIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Offset from the beginning of FeatureVariations.
  pub fn featureLookupsOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, (self.position + 2)) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn featureLookups(self: &Self, data: FontData<'a>) -> Result<FeatureLookups<'a>, ReadError> {
    let offset = LookupVariationRecord<'a>.featureLookupsOffset(self)
    return resolveWithArgs<(), FeatureLookups<'a>, Offset32>(offset, data, ())
  }
}

impl<'a> FixedSize for LookupVariationRecord<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for LookupVariationRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for LookupVariationRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return LookupVariationRecord<'a>.readAt(data, position, ())
  }
}

/// Conditional lookup sets for one feature (ISO/IEC 14496-22:2026, 6.2.11).
pub struct FeatureLookups<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for FeatureLookups<'a> {}

impl<'a> FeatureLookups<'a> {
  pub fn default() -> Self {
    return FeatureLookups<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let versionValue = scalarOr<MajorMinor>(data, ranges[0].start, MajorMinor.new(0, 0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let flagsValue = scalarOr<FeatureLookupsFlags>(
      data,
      ranges[1].start,
      FeatureLookupsFlags.empty(),
    )
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let lookupConditionCountValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(lookupConditionCountValue), 8),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn version(self: &Self) -> MajorMinor {
    return match move FontData<'a>.readAt<MajorMinor>(&self._fontData, self._fieldRanges[0].start) {
      Result<MajorMinor, ReadError>.Success { value } => value
      Result<MajorMinor, ReadError>.Failure { error } => MajorMinor.new(0, 0)
    }
  }

  pub fn versionByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn flags(self: &Self) -> FeatureLookupsFlags {
    return match move FontData<'a>.readAt<FeatureLookupsFlags>(
      &self._fontData,
      self._fieldRanges[1].start,
    ) {
      Result<FeatureLookupsFlags, ReadError>.Success { value } => value
      Result<FeatureLookupsFlags, ReadError>.Failure { error } => FeatureLookupsFlags.empty()
    }
  }

  pub fn flagsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  pub fn lookupConditionCount(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookupConditionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  pub fn lookupConditionRecords(self: &Self) -> ComputedArray<'a, (), LookupConditionRecord<'a>> {
    return match move recordArray<LookupConditionRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), LookupConditionRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), LookupConditionRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), LookupConditionRecord<'a>>.empty(())
    }
  }

  pub fn lookupConditionRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for FeatureLookups<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return FeatureLookups<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for FeatureLookups<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Qualifiers for [FeatureLookups].
pub struct FeatureLookupsFlags {
  raw: u16,
}

impl Copy for FeatureLookupsFlags {}

impl FeatureLookupsFlags {
  pub fn bits(self: &Self) -> u16 {
    return self.raw
  }

  pub fn empty() -> FeatureLookupsFlags {
    return FeatureLookupsFlags { raw: 0 }
  }

  pub fn all() -> FeatureLookupsFlags {
    return FeatureLookupsFlags { raw: 1 }
  }

  pub fn fromBitsTruncate(bits: u16) -> FeatureLookupsFlags {
    return FeatureLookupsFlags { raw: bits & 1 }
  }

  pub fn fromBits(bits: u16) -> Option<FeatureLookupsFlags> {
    if (bits & 1) != bits {
      return Option<FeatureLookupsFlags>.None
    }
    return Option<FeatureLookupsFlags>.some(FeatureLookupsFlags { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: FeatureLookupsFlags) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: FeatureLookupsFlags) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: FeatureLookupsFlags) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: FeatureLookupsFlags) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: FeatureLookupsFlags) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// Include the current feature's lookups as well as conditional lookups.
  pub fn addDefaultLookups() -> FeatureLookupsFlags {
    return FeatureLookupsFlags { raw: 1 }
  }
}

impl Equal for FeatureLookupsFlags {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl FeatureLookupsFlags {
  pub fn default() -> Self {
    return FeatureLookupsFlags.empty()
  }
}

impl Order for FeatureLookupsFlags {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for FeatureLookupsFlags {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if FeatureLookupsFlags.contains(self, FeatureLookupsFlags.addDefaultLookups()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("ADD_DEFAULT_LOOKUPS")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<FeatureLookupsFlags, FeatureLookupsFlags> for FeatureLookupsFlags {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<FeatureLookupsFlags, FeatureLookupsFlags> for FeatureLookupsFlags {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<FeatureLookupsFlags, FeatureLookupsFlags> for FeatureLookupsFlags {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<FeatureLookupsFlags, FeatureLookupsFlags> for FeatureLookupsFlags {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<FeatureLookupsFlags> for FeatureLookupsFlags {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 1 }
  }
}

impl Scalar for FeatureLookupsFlags {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(FeatureLookupsFlags.fromBitsTruncate(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.raw, move bytes)
  }
}

impl FixedSize for FeatureLookupsFlags {
  fn rawByteLen() -> usize {
    return 2
  }
}

/// Lookups to include when a condition is true.
pub struct LookupConditionRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for LookupConditionRecord<'a> {}

impl<'a> LookupConditionRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Offset from the beginning of FeatureLookups; null means true.
  pub fn conditionOffset(self: &Self) -> Nullable<Offset32> {
    return match move FontData<'a>.readAt<Nullable<Offset32>>(
      &self._fontData,
      (self.position + 0),
    ) {
      Result<Nullable<Offset32>, ReadError>.Success { value } => value
      Result<Nullable<Offset32>, ReadError>.Failure { error } => Nullable<Offset32>.default()
    }
  }

  pub fn condition(self: &Self, data: FontData<'a>) -> Option<Result<Condition<'a>, ReadError>> {
    let offset = LookupConditionRecord<'a>.conditionOffset(self)
    return resolveNullableWithArgs<(), Condition<'a>, Offset32>(&offset, data, ())
  }

  /// Offset from the beginning of FeatureLookups.
  pub fn lookupIndexListOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, (self.position + 4)) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn lookupIndexList(self: &Self, data: FontData<'a>) -> Result<
    LookupIndexList<'a>,
    ReadError
  > {
    let offset = LookupConditionRecord<'a>.lookupIndexListOffset(self)
    return resolveWithArgs<(), LookupIndexList<'a>, Offset32>(offset, data, ())
  }
}

impl<'a> FixedSize for LookupConditionRecord<'a> {
  fn rawByteLen() -> usize {
    return 8
  }
}

impl<'a> ComputeSize<()> for LookupConditionRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(8)
  }
}

impl<'a> FontReadAt<'a, ()> for LookupConditionRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return LookupConditionRecord<'a>.readAt(data, position, ())
  }
}

/// Indices into the GSUB or GPOS LookupList.
pub struct LookupIndexList<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for LookupIndexList<'a> {}

impl<'a> LookupIndexList<'a> {
  pub fn default() -> Self {
    return LookupIndexList<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let lookupIndexCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(lookupIndexCountValue), 2))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn lookupIndexCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookupIndexCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn lookupIndices(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn lookupIndicesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for LookupIndexList<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LookupIndexList<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for LookupIndexList<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [ConditionSet Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#conditionset-table)
pub struct ConditionSet<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for ConditionSet<'a> {}

impl<'a> ConditionSet<'a> {
  pub fn default() -> Self {
    return ConditionSet<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let conditionCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(conditionCountValue), 4))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of conditions for this condition set.
  pub fn conditionCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn conditionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of offsets to condition tables, from beginning of the
  /// ConditionSet table.
  pub fn conditionOffsets(self: &Self) -> ScalarArray<'a, Offset32> {
    return match move FontData<'a>.readArray<Offset32>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, Offset32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset32>, ReadError>.Failure { error } => ScalarArray<
        Offset32
      >.empty()
    }
  }

  pub fn conditions(self: &Self) -> ArrayOfOffsets<'a, (), Condition<'a>, Offset32> {
    return ArrayOfOffsets<'a, (), Condition<'a>, Offset32>.new(
      ConditionSet<'a>.conditionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn conditionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for ConditionSet<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ConditionSet<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ConditionSet<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Condition Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#condition-table)
/// 
/// Formats 2..5 are defined in ISO/IEC 14496-22:2026, 6.2.10.
pub union Condition<'a> {
  Format1AxisRange { pub value: ConditionFormat1<'a> },
  Format2VariableValue { pub value: ConditionFormat2<'a> },
  Format3And { pub value: ConditionFormat3<'a> },
  Format4Or { pub value: ConditionFormat4<'a> },
  Format5Negate { pub value: ConditionFormat5<'a> },
}

impl<'a> Copy for Condition<'a> {}

impl<'a> Condition<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move ConditionFormat1<'a>.read(data) {
          Result<ConditionFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Condition<'a>.Format1AxisRange { value: value })
          Result<ConditionFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ConditionFormat2<'a>.read(data) {
          Result<ConditionFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Condition<'a>.Format2VariableValue { value: value })
          Result<ConditionFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move ConditionFormat3<'a>.read(data) {
          Result<ConditionFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Condition<'a>.Format3And { value: value })
          Result<ConditionFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move ConditionFormat4<'a>.read(data) {
          Result<ConditionFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Condition<'a>.Format4Or { value: value })
          Result<ConditionFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      5 => {
        return match move ConditionFormat5<'a>.read(data) {
          Result<ConditionFormat5<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(Condition<'a>.Format5Negate { value: value })
          Result<ConditionFormat5<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      Condition<'a>.Format1AxisRange { value } => ConditionFormat1<'a>.offsetData(&value)
      Condition<'a>.Format2VariableValue { value } => ConditionFormat2<'a>.offsetData(&value)
      Condition<'a>.Format3And { value } => ConditionFormat3<'a>.offsetData(&value)
      Condition<'a>.Format4Or { value } => ConditionFormat4<'a>.offsetData(&value)
      Condition<'a>.Format5Negate { value } => ConditionFormat5<'a>.offsetData(&value)
    }
  }

  /// Format, = 1
  pub fn format(self: &Self) -> u16 {
    return match &self.* {
      Condition<'a>.Format1AxisRange { value } => ConditionFormat1<'a>.format(&value)
      Condition<'a>.Format2VariableValue { value } => ConditionFormat2<'a>.format(&value)
      Condition<'a>.Format3And { value } => ConditionFormat3<'a>.format(&value)
      Condition<'a>.Format4Or { value } => ConditionFormat4<'a>.format(&value)
      Condition<'a>.Format5Negate { value } => ConditionFormat5<'a>.format(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for Condition<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Condition<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for Condition<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      Condition<'a>.Format1AxisRange { value } => MinByteRange.minByteRange(&value)
      Condition<'a>.Format2VariableValue { value } => MinByteRange.minByteRange(&value)
      Condition<'a>.Format3And { value } => MinByteRange.minByteRange(&value)
      Condition<'a>.Format4Or { value } => MinByteRange.minByteRange(&value)
      Condition<'a>.Format5Negate { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      Condition<'a>.Format1AxisRange { value } => MinByteRange.minTableBytes(&value)
      Condition<'a>.Format2VariableValue { value } => MinByteRange.minTableBytes(&value)
      Condition<'a>.Format3And { value } => MinByteRange.minTableBytes(&value)
      Condition<'a>.Format4Or { value } => MinByteRange.minTableBytes(&value)
      Condition<'a>.Format5Negate { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> Condition<'a> {
  pub fn default() -> Self {
    return Condition<'a>.Format1AxisRange { value: ConditionFormat1<'a>.default() }
  }
}

/// [Condition Table Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#condition-table-format-1-font-variation-axis-range): Font Variation Axis Range
pub struct ConditionFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for ConditionFormat1<'a> {}

impl<'a> ConditionFormat1<'a> {
  pub fn default() -> Self {
    return ConditionFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let axisIndexValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let filterRangeMinValueValue = scalarOr<F2Dot14>(data, ranges[2].start, F2Dot14.zero())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let filterRangeMaxValueValue = scalarOr<F2Dot14>(data, ranges[3].start, F2Dot14.zero())
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format, = 1
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Index (zero-based) for the variation axis within the 'fvar'
  /// table.
  pub fn axisIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn axisIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Minimum value of the font variation instances that satisfy this
  /// condition.
  pub fn filterRangeMinValue(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, self._fieldRanges[2].start) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  pub fn filterRangeMinValueByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Maximum value of the font variation instances that satisfy this
  /// condition.
  pub fn filterRangeMaxValue(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, self._fieldRanges[3].start) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  pub fn filterRangeMaxValueByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for ConditionFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ConditionFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for ConditionFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for ConditionFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Condition Table Format 2](https://github.com/fonttools/fonttools/blob/5e6b12d12fa08abafbeb7570f47707fbedf69a45/Lib/fontTools/ttLib/tables/otData.py#L3237-L3255): Variation index
pub struct ConditionFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for ConditionFormat2<'a> {}

impl<'a> ConditionFormat2<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let defaultValueValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let varIndexValue = scalarOr<u32>(data, ranges[2].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format, = 2
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Value at default instance.
  pub fn defaultValue(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn defaultValueByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Variation index to vary the value based on current designspace location.
  pub fn varIndex(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn varIndexByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for ConditionFormat2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ConditionFormat2<'a>.read(data)
  }
}

impl<'a> Format<u16> for ConditionFormat2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for ConditionFormat2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Condition Table Format 3](https://github.com/fonttools/fonttools/blob/5e6b12d12fa08abafbeb7570f47707fbedf69a45/Lib/fontTools/ttLib/tables/otData.py#L3257-L3275): AND
pub struct ConditionFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for ConditionFormat3<'a> {}

impl<'a> ConditionFormat3<'a> {
  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[1].end = end
    let conditionCountValue = scalarOr<u8>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u8.toUsize(conditionCountValue), 3))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format, = 3
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of conditions.
  pub fn conditionCount(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[1].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn conditionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of condition tables for this conjunction (AND) expression.
  pub fn conditionOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn conditions(self: &Self) -> ArrayOfOffsets<'a, (), Condition<'a>, Offset24> {
    return ArrayOfOffsets<'a, (), Condition<'a>, Offset24>.new(
      ConditionFormat3<'a>.conditionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn conditionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

