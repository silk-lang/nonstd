/// [Sequence Context Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#sequence-context-format-1-simple-glyph-contexts)
pub struct SequenceContextFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for SequenceContextFormat1<'a> {}

impl<'a> SequenceContextFormat1<'a> {
  pub fn default() -> Self {
    return SequenceContextFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let seqRuleSetCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(seqRuleSetCountValue), 2))
    ranges[3].end = end
