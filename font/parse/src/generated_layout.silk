}

impl<'a> ClassRangeRecord2<'a> {
  pub fn population(self: &Self) -> usize {
    let start = GlyphId24.toU32(ClassRangeRecord2<'a>.startGlyphId(self))
    let end = GlyphId24.toU32(ClassRangeRecord2<'a>.endGlyphId(self))
    if start > end {
      return 0
    }
    return u32.toUsize(end - start) + 1
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyph)
    if gid > 65535 {
      return Option<u16>.None
    }
    let array = CoverageFormat1<'a>.glyphArray(self)
    let mut size = ScalarArray<GlyphId16>.len(&array)
    if size == 0 {
      return Option<u16>.None
    }
    let mut base: usize = 0
    while size > 1 {
      let half = size / 2
      let mid = base + half
      let value = ScalarArray<GlyphId16>.get(&array, mid)
        |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0))
      if GlyphId16.toU32(value) <= gid {
        base = mid
      }
      size = size - half
    }
    let value = ScalarArray<GlyphId16>.get(&array, base)
      |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0))
    if GlyphId16.toU32(value) == gid {
      return Option<u16>.some(usize.toU16(base))
    }
    return Option<u16>.None
  }
}

impl<'a> CoverageFormat3<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    let gid = GlyphId.toU32(glyph)
    if gid > 16777215 {
      return Option<u32>.None
    }
    let array = CoverageFormat3<'a>.glyphArray(self)
    let mut size = ScalarArray<GlyphId24>.len(&array)
    if size == 0 {
      return Option<u32>.None
    }
    let mut base: usize = 0
    while size > 1 {
      let half = size / 2
      let mid = base + half
      let value = ScalarArray<GlyphId24>.get(&array, mid)
        |> Option<GlyphId24>.unwrapOr(GlyphId24.new(0))
      if GlyphId24.toU32(value) <= gid {
        base = mid
      }
      size = size - half
    }
    let value = ScalarArray<GlyphId24>.get(&array, base)
      |> Option<GlyphId24>.unwrapOr(GlyphId24.new(0))
    if GlyphId24.toU32(value) == gid {
      return Option<u32>.some(usize.toU32(base))
    }
    return Option<u32>.None
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyph)
    if gid > 65535 {
      return Option<u16>.None
    }
    if let Option<LayoutRange>.Some { value } = move findRange<RangeRecord<'a>>(
      &CoverageFormat2<'a>.rangeRecords(self),
      gid,
      false,
    ) {
      let index = value.value + gid - value.start
      if index <= 65535 {
        return Option<u16>.some(u32.toU16(index))
      }
    }
    return Option<u16>.None
  }
}

impl<'a> CoverageFormat4<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    let gid = GlyphId.toU32(glyph)
    if let Option<LayoutRange>.Some { value } = move findRange<RangeRecord2<'a>>(
      &CoverageFormat4<'a>.rangeRecords(self),
      gid,
      false,
    ) {
      let index = value.value + gid - value.start
      if index <= 16777215 {
        return Option<u32>.some(index)
      }
    }
    return Option<u32>.None
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn population(self: &Self) -> usize {
    return u16.toUsize(CoverageFormat1<'a>.glyphCount(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(CoverageFormat1<'a>.glyphCount(self)))
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn population(self: &Self) -> usize {
    return rangePopulation<RangeRecord<'a>>(&CoverageFormat2<'a>.rangeRecords(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(CoverageFormat2<'a>.rangeCount(self)))
  }
}

impl<'a> CoverageTable<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => match move CoverageFormat1<'a>.get(&value, glyph) {
        Option<u16>.Some { value: index } => Option<u32>.some(u16.toU32(index))
        Option<u16>.None => Option<u32>.None
      }
      CoverageTable<'a>.Format2 { value } => match move CoverageFormat2<'a>.get(&value, glyph) {
        Option<u16>.Some { value: index } => Option<u32>.some(u16.toU32(index))
        Option<u16>.None => Option<u32>.None
      }
      CoverageTable<'a>.Format3 { value } => CoverageFormat3<'a>.get(&value, glyph)
      CoverageTable<'a>.Format4 { value } => CoverageFormat4<'a>.get(&value, glyph)
    }
  }

  pub fn iter(self: &Self) -> CoverageIter<'a> {
    return CoverageIter<'a> { table: self.*, index: 0, nextGlyph: 0, end: 0 }
  }

  pub fn population(self: &Self) -> usize {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.population(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.population(&value)
      CoverageTable<'a>.Format3 { value } => u32.toUsize(
        Uint24.toU32(CoverageFormat3<'a>.glyphCount(&value)),
      )
      CoverageTable<'a>.Format4 { value } => rangePopulation<RangeRecord2<'a>>(
        &CoverageFormat4<'a>.rangeRecords(&value),
      )
    }
  }

  pub fn cost(self: &Self) -> u32 {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.cost(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.cost(&value)
      CoverageTable<'a>.Format3 { value } => bitStorage(
        Uint24.toU32(CoverageFormat3<'a>.glyphCount(&value)),
      )
      CoverageTable<'a>.Format4 { value } => bitStorage(
        Uint24.toU32(CoverageFormat4<'a>.rangeCount(&value)),
      )
    }
  }
}

pub struct CoverageIter<'a> {
  table: CoverageTable<'a>,
  index: usize,
  nextGlyph: u32,
  end: u32,
}

impl<'a> CoverageIter<'a> {
  pub fn next(self: &mut Self) -> Option<GlyphId> {
    while true {
      if self.nextGlyph < self.end {
        let glyph = self.nextGlyph
        self.nextGlyph = self.nextGlyph + 1
        return Option<GlyphId>.some(GlyphId.new(glyph))
      }
      let index = self.index
      match self.table {
        CoverageTable<'a>.Format1 { value } => {
          if let Option<GlyphId16>.Some { value: glyph } = move ScalarArray<GlyphId16>.get(
            &CoverageFormat1<'a>.glyphArray(&value),
            index,
          ) {
            self.index = self.index + 1
            return Option<GlyphId>.some(GlyphId.new(GlyphId16.toU32(glyph)))
          }
          return Option<GlyphId>.None
        }
        CoverageTable<'a>.Format3 { value } => {
          if let Option<GlyphId24>.Some { value: glyph } = move ScalarArray<GlyphId24>.get(
            &CoverageFormat3<'a>.glyphArray(&value),
            index,
          ) {
            self.index = self.index + 1
            return Option<GlyphId>.some(GlyphId.new(GlyphId24.toU32(glyph)))
          }
          return Option<GlyphId>.None
        }
        CoverageTable<'a>.Format2 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<RangeRecord<'a>>(
            &CoverageFormat2<'a>.rangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
          } else {
            return Option<GlyphId>.None
          }
        }
        CoverageTable<'a>.Format4 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<RangeRecord2<'a>>(
            &CoverageFormat4<'a>.rangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
          } else {
            return Option<GlyphId>.None
          }
        }
      }
    }
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u16 {
    let gid = GlyphId.toU32(glyph)
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    if gid < start || gid > 4294967295 {
      return 0
    }
    let raw = ScalarArray<u16>.get(
      &ClassDefFormat1<'a>.classValueArray(self),
      u32.toUsize(gid - start),
    )
      |> Option<u16>.unwrapOr(0)
    return raw
  }
}

impl<'a> ClassDefFormat3<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    let gid = GlyphId.toU32(glyph)
    let start = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(self))
    if gid < start || gid > 16777215 {
      return 0
    }
    let raw = ScalarArray<Uint24>.get(
      &ClassDefFormat3<'a>.classValueArray(self),
      u32.toUsize(gid - start),
    )
      |> Option<Uint24>.unwrapOr(Uint24.new(0))
    return Uint24.toU32(raw)
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u16 {
    if let Option<LayoutRange>.Some { value } = move findRange<ClassRangeRecord<'a>>(
      &ClassDefFormat2<'a>.classRangeRecords(self),
      GlyphId.toU32(glyph),
      true,
    ) {
      return u32.toU16(value.value)
    }
    return 0
  }
}

impl<'a> ClassDefFormat4<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    if let Option<LayoutRange>.Some { value } = move findRange<ClassRangeRecord2<'a>>(
      &ClassDefFormat4<'a>.classRangeRecords(self),
      GlyphId.toU32(glyph),
      true,
    ) {
      return value.value
    }
    return 0
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub fn iter(self: &Self) -> Class16Iter<'a> {
    return Class16Iter<'a> { inner: ClassDef<'a>.iter(&ClassDef<'a>.Format1 { value: self.* }) }
  }

  pub fn population(self: &Self) -> usize {
    return u16.toUsize(ClassDefFormat1<'a>.glyphCount(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return 1
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub fn iter(self: &Self) -> Class16Iter<'a> {
    return Class16Iter<'a> { inner: ClassDef<'a>.iter(&ClassDef<'a>.Format2 { value: self.* }) }
  }

  pub fn population(self: &Self) -> usize {
    return rangePopulation<ClassRangeRecord<'a>>(&ClassDefFormat2<'a>.classRangeRecords(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(ClassDefFormat2<'a>.classRangeCount(self)))
  }
}

pub struct ClassEntry {
  pub glyph: GlyphId,
  pub class: u32,
}

impl Copy for ClassEntry {}

pub struct ClassEntry16 {
  pub glyph: GlyphId16,
  pub class: u16,
}

impl Copy for ClassEntry16 {}

impl<'a> ClassDef<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => u16.toU32(ClassDefFormat1<'a>.get(&value, glyph))
      ClassDef<'a>.Format2 { value } => u16.toU32(ClassDefFormat2<'a>.get(&value, glyph))
      ClassDef<'a>.Format3 { value } => ClassDefFormat3<'a>.get(&value, glyph)
      ClassDef<'a>.Format4 { value } => ClassDefFormat4<'a>.get(&value, glyph)
    }
  }

  pub fn iter(self: &Self) -> ClassIter<'a> {
    return ClassIter<'a> { table: self.*, index: 0, nextGlyph: 0, end: 0, class: 0 }
  }

  pub fn population(self: &Self) -> usize {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => ClassDefFormat1<'a>.population(&value)
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.population(&value)
      ClassDef<'a>.Format3 { value } => u32.toUsize(
        Uint24.toU32(ClassDefFormat3<'a>.glyphCount(&value)),
      )
      ClassDef<'a>.Format4 { value } => rangePopulation<ClassRangeRecord2<'a>>(
        &ClassDefFormat4<'a>.classRangeRecords(&value),
      )
    }
  }

  pub fn cost(self: &Self) -> u32 {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => 1
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.cost(&value)
      ClassDef<'a>.Format3 { value } => 1
      ClassDef<'a>.Format4 { value } => bitStorage(
        Uint24.toU32(ClassDefFormat4<'a>.classRangeCount(&value)),
      )
    }
  }
}

pub struct ClassIter<'a> {
  table: ClassDef<'a>,
  index: usize,
  nextGlyph: u32,
  end: u32,
  class: u32,
}

impl<'a> ClassIter<'a> {
  pub fn next(self: &mut Self) -> Option<ClassEntry> {
    while true {
      if self.nextGlyph < self.end {
        let glyph = self.nextGlyph
        self.nextGlyph = self.nextGlyph + 1
        return Option<ClassEntry>.some(ClassEntry { glyph: GlyphId.new(glyph), class: self.class })
      }
      let index = self.index
      match self.table {
        ClassDef<'a>.Format1 { value } => {
          if let Option<u16>.Some { value: class } = move ScalarArray<u16>.get(
            &ClassDefFormat1<'a>.classValueArray(&value),
            index,
          ) {
            self.index = self.index + 1
            let glyph = u16.toU32(
              u16.saturatingAdd(
                GlyphId16.toU16(ClassDefFormat1<'a>.startGlyphId(&value)),
                usize.toU16(index),
              ),
            )
            return Option<ClassEntry>.some(
              ClassEntry { glyph: GlyphId.new(glyph), class: u16.toU32(class) },
            )
          }
          return Option<ClassEntry>.None
        }
        ClassDef<'a>.Format3 { value } => {
          if let Option<Uint24>.Some { value: class } = move ScalarArray<Uint24>.get(
            &ClassDefFormat3<'a>.classValueArray(&value),
            index,
          ) {
            self.index = self.index + 1
            let glyph = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(&value))
              + usize.toU32(index)
            if glyph > 16777215 {
              return Option<ClassEntry>.None
            }
            return Option<ClassEntry>.some(
              ClassEntry { glyph: GlyphId.new(glyph), class: Uint24.toU32(class) },
            )
          }
          return Option<ClassEntry>.None
        }
        ClassDef<'a>.Format2 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<ClassRangeRecord<'a>>(
            &ClassDefFormat2<'a>.classRangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
            self.class = range.value
          } else {
            return Option<ClassEntry>.None
          }
        }
        ClassDef<'a>.Format4 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<ClassRangeRecord2<'a>>(
            &ClassDefFormat4<'a>.classRangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
            self.class = range.value
          } else {
            return Option<ClassEntry>.None
          }
        }
      }
    }
  }
}

pub struct Class16Iter<'a> {
  inner: ClassIter<'a>,
}

impl<'a> Class16Iter<'a> {
  pub fn next(self: &mut Self) -> Option<ClassEntry16> {
    return match move ClassIter<'a>.next(&mut self.inner) {
      Option<ClassEntry>.Some { value } => Option<ClassEntry16>.some(
        ClassEntry16 {
          glyph: GlyphId16.new(u32.toU16(GlyphId.toU32(value.glyph))),
          class: u32.toU16(value.class),
        },
      )
      Option<ClassEntry>.None => Option<ClassEntry16>.None
    }
  }
}

pub struct DeviceIter<'a> {
  values: ScalarArray<'a, u16>,
  index: usize,
  count: usize,
  bits: u16,
}

impl<'a> Device<'a> {
  pub fn iter(self: &Self) -> DeviceIter<'a> {
    let bits: u16 = match Device<'a>.deltaFormat(self) {
      DeltaFormat.Local2BitDeltas => 2
      DeltaFormat.Local4BitDeltas => 4
      DeltaFormat.Local8BitDeltas => 8
      _ => 0
    }
    let start = Device<'a>.startSize(self)
    let end = Device<'a>.endSize(self)
    let mut count: usize = 0
    if end >= start && bits != 0 {
      count = u16.toUsize(end - start) + 1
    }
    return DeviceIter<'a> {
      values: Device<'a>.deltaValue(self),
      index: 0,
      count: count,
      bits: bits,
    }
  }

  pub fn deltaForPpem(self: &Self, ppem: u16) -> i32 {
    let start = Device<'a>.startSize(self)
    if ppem == 0 || ppem < start || ppem > Device<'a>.endSize(self) {
      return 0
    }
    let mut iter = Device<'a>.iter(self)
    iter.index = u16.toUsize(ppem - start)
    return i8.toI32(DeviceIter<'a>.next(&mut iter) |> Option<i8>.unwrapOr(0))
  }
}

impl<'a> DeviceIter<'a> {
  pub fn next(self: &mut Self) -> Option<i8> {
    if self.index >= self.count || self.bits == 0 {
      return Option<i8>.None
    }
    let perWord = u16.toUsize(16 / self.bits)
    let word = match move ScalarArray<u16>.get(&self.values, self.index / perWord) {
      Option<u16>.Some { value } => value
      Option<u16>.None => {
        return Option<i8>.None
      }
    }
    let shift = 16 - self.bits - usize.toU16(self.index % perWord) * self.bits
    let mask = u16.shiftLeft(1, self.bits) - 1
    let raw = u16.shiftRight(word, shift) & mask
    let mut value = u16.toI16(raw)
    if (raw & u16.shiftLeft(1, self.bits - 1)) != 0 {
      value = value - u16.toI16(mask + 1)
    }
    self.index = self.index + 1
    return Option<i8>.some(i16.toI8(value))
  }
}

// Upstream layout::tests::bit_storage_tests; kept beside the private helper.
import silk.testing.testing { Testing, AssertionError }

test effect fn bitStorageTests() -> ()
  ! AssertionError<'static> {
  let values: [u32; 9] = [0, 1, 2, 4, 9, 291, 4660, 65535, 4294967295]
  let expected: [u32; 9] = [0, 1, 2, 3, 4, 9, 13, 16, 32]
  let mut i: usize = 0
  while i < 9 {
    run Testing.expect(bitStorage(values[i]) == expected[i], "bits required")
    i = i + 1
  }
}

// Handwritten extension from font/parse/src/tables/layout_intersections.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
// IntSet-dependent layout extensions, appended by font/scripts/generate.
import collections.int_set { IntSet, IntSetIter, Bound }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64

fn glyphSetFirst(glyphs: &IntSet<GlyphId>) -> u32 {
  return GlyphId.toU32(IntSet<GlyphId>.first(glyphs) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)))
}

fn glyphSetLast(glyphs: &IntSet<GlyphId>) -> u32 {
  return GlyphId.toU32(IntSet<GlyphId>.last(glyphs) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)))
}

fn glyphSetRange(glyphs: &IntSet<GlyphId>, first: u32, last: u32) -> IntSetIter<GlyphId> {
  return IntSet<GlyphId>.range(
    glyphs,
    Bound<GlyphId>.Included { value: GlyphId.new(first) },
    Bound<GlyphId>.Included { value: GlyphId.new(last) },
  )
}

effect fn extendGlyphs(out: &mut IntSet<GlyphId>, input: IntSetIter<GlyphId>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut iter = move input
  while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
    drop run IntSet<GlyphId>.insert(&mut out, value)
  }
}

// Preserve the original u32 heuristic's release-mode wrapping without traps.
fn coverageSearchSet(count: u32, glyphs: &IntSet<GlyphId>, cost: u32) -> bool {
  let length = u64.toU32(IntSet<GlyphId>.len(glyphs) & 4294967295)
  return count > u32.wrappingMultiply(length, cost)
}

impl<'a> RangeRecord<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    return IntSet<GlyphId>.intersectsRange(
      glyphs,
      GlyphId.new(GlyphId16.toU32(RangeRecord<'a>.startGlyphId(self))),
      GlyphId.new(GlyphId16.toU32(RangeRecord<'a>.endGlyphId(self))),
    )
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    if coverageSearchSet(
      u16.toU32(CoverageFormat1<'a>.glyphCount(self)),
      glyphs,
      CoverageFormat1<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat1<'a>.get(self, value) {
          return true
        }
      }
    } else {
      let array = CoverageFormat1<'a>.glyphArray(self)
      let mut at: usize = 0
      while let Option<GlyphId16>.Some { value } = ScalarArray<GlyphId16>.get(&array, at) {
        if IntSet<GlyphId>.contains(glyphs, GlyphId.new(GlyphId16.toU32(value))) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if coverageSearchSet(
      u16.toU32(CoverageFormat1<'a>.glyphCount(self)),
      glyphs,
      CoverageFormat1<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat1<'a>.get(self, value) {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let array = CoverageFormat1<'a>.glyphArray(self)
      let mut at: usize = 0
      while let Option<GlyphId16>.Some { value } = ScalarArray<GlyphId16>.get(&array, at) {
        let glyph = GlyphId.new(GlyphId16.toU32(value))
        if IntSet<GlyphId>.contains(glyphs, glyph) {
          drop run IntSet<GlyphId>.insert(&mut out, glyph)
        }
        at = at + 1
      }
    }
    return move out
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    if coverageSearchSet(
      u16.toU32(CoverageFormat2<'a>.rangeCount(self)),
      glyphs,
      CoverageFormat2<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat2<'a>.get(self, value) {
          return true
        }
      }
    } else {
      let array = CoverageFormat2<'a>.rangeRecords(self)
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value } = rangeAt<RangeRecord<'a>>(&array, at) {
        if IntSet<GlyphId>.intersectsRange(
          glyphs,
          GlyphId.new(value.start),
          GlyphId.new(value.end),
        ) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if coverageSearchSet(
      u16.toU32(CoverageFormat2<'a>.rangeCount(self)),
      glyphs,
      CoverageFormat2<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat2<'a>.get(self, value) {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let array = CoverageFormat2<'a>.rangeRecords(self)
      let mut at: usize = 0
      let mut last: u32 = 0
      while let Option<LayoutRange>.Some { value } = rangeAt<RangeRecord<'a>>(&array, at) {
        if value.start < last {
          break
        }
        last = value.end
        let start = GlyphId.new(value.start)
        if IntSet<GlyphId>.contains(glyphs, start) {
          drop run IntSet<GlyphId>.insert(&mut out, start)
        }
        let mut iter = IntSet<GlyphId>.iterAfter(glyphs, start)
        while let Option<GlyphId>.Some { value: glyph } = IntSetIter<GlyphId>.next(&mut iter) {
          if GlyphId.toU32(glyph) > value.end {
            break
          }
          drop run IntSet<GlyphId>.insert(&mut out, glyph)
        }
        at = at + 1
      }
    }
    return move out
  }
}

impl<'a> CoverageTable<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    match &self.* {
      CoverageTable<'a>.Format1 { value } => {
        return CoverageFormat1<'a>.intersects(&value, glyphs)
      }
      CoverageTable<'a>.Format2 { value } => {
        return CoverageFormat2<'a>.intersects(&value, glyphs)
      }
      CoverageTable<'a>.Format3 { value } => {
        let array = CoverageFormat3<'a>.glyphArray(&value)
        let mut at: usize = 0
        while let Option<GlyphId24>.Some { value: glyph } = ScalarArray<GlyphId24>.get(&array, at) {
          if IntSet<GlyphId>.contains(glyphs, GlyphId.new(GlyphId24.toU32(glyph))) {
            return true
          }
          at = at + 1
        }
      }
      CoverageTable<'a>.Format4 { value } => {
        let array = CoverageFormat4<'a>.rangeRecords(&value)
        let mut at: usize = 0
        while let Option<LayoutRange>.Some { value: range } = rangeAt<RangeRecord2<'a>>(
          &array,
          at,
        ) {
          if IntSet<GlyphId>.intersectsRange(
            glyphs,
            GlyphId.new(range.start),
            GlyphId.new(range.end),
          ) {
            return true
          }
          at = at + 1
        }
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      CoverageTable<'a>.Format1 { value } => {
        return run CoverageFormat1<'a>.intersectSet(&value, glyphs)
      }
      CoverageTable<'a>.Format2 { value } => {
        return run CoverageFormat2<'a>.intersectSet(&value, glyphs)
      }
      CoverageTable<'a>.Format3 { value } => {
        let mut out = IntSet<GlyphId>.empty()
        let array = CoverageFormat3<'a>.glyphArray(&value)
        let mut at: usize = 0
        while let Option<GlyphId24>.Some { value: raw } = ScalarArray<GlyphId24>.get(&array, at) {
          let glyph = GlyphId.new(GlyphId24.toU32(raw))
          if IntSet<GlyphId>.contains(glyphs, glyph) {
            drop run IntSet<GlyphId>.insert(&mut out, glyph)
          }
          at = at + 1
        }
        return move out
      }
      CoverageTable<'a>.Format4 { value } => {
        let mut out = IntSet<GlyphId>.empty()
        let array = CoverageFormat4<'a>.rangeRecords(&value)
        let mut at: usize = 0
        while let Option<LayoutRange>.Some { value: range } = rangeAt<RangeRecord2<'a>>(
          &array,
          at,
        ) {
          if range.start <= range.end {
            run IntSet<GlyphId>.insertRange(
              &mut out,
              GlyphId.new(range.start),
              GlyphId.new(range.end),
            )
          }
          at = at + 1
        }
        run IntSet<GlyphId>.intersect(&mut out, glyphs)
        return move out
      }
    }
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u16>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<u16>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let count = ScalarArray<u16>.len(&values)
    if count == 0 {
      drop run IntSet<u16>.insert(&mut out, 0)
      return move out
    }
    let end = start + usize.toU32(count) - 1
    if glyphSetFirst(glyphs) < start || glyphSetLast(glyphs) > end {
      drop run IntSet<u16>.insert(&mut out, 0)
    }
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let class = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: class } => class
        _ => {
          break
        }
      }
      drop run IntSet<u16>.insert(&mut out, class)
    }
    return move out
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let count = u16.toU32(ClassDefFormat1<'a>.glyphCount(self))
    if count == 0 {
      if class == 0 {
        return run IntSet<GlyphId>.clone(glyphs)
      }
      return move out
    }
    let end = start + count - 1
    if class == 0 {
      let first = glyphSetFirst(glyphs)
      let last = glyphSetLast(glyphs)
      if first < start {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, first, start - 1))
      }
      if last > end {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, end + 1, last))
      }
      return move out
    }
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let found = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: found } => found
        _ => {
          break
        }
      }
      if found == class {
        drop run IntSet<GlyphId>.insert(&mut out, value)
      }
    }
    return move out
  }

  pub fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> bool {
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return false
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let count = u16.toU32(ClassDefFormat1<'a>.glyphCount(self))
    if count == 0 {
      return class == 0
    }
    let end = start + count - 1
    if class == 0 && (glyphSetFirst(glyphs) < start || glyphSetLast(glyphs) > end) {
      return true
    }
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let found = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: found } => found
        _ => {
          return false
        }
      }
      if found == class {
        return true
      }
    }
    return false
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u16>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<u16>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    let first = match move rangeAt<ClassRangeRecord<'a>>(&records, 0) {
      Option<LayoutRange>.Some { value } => value
      _ => {
        drop run IntSet<u16>.insert(&mut out, 0)
        return move out
      }
    }
    if glyphSetFirst(glyphs) < first.start {
      drop run IntSet<u16>.insert(&mut out, 0)
    } else {
      let mut glyph = GlyphId.new(first.end)
      let mut at: usize = 1
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        let next = match move IntSet<GlyphId>.nextAfter(glyphs, glyph) {
          Option<GlyphId>.Some { value } => value
          _ => {
            break
          }
        }
        if GlyphId.toU32(next) < range.start {
          drop run IntSet<u16>.insert(&mut out, 0)
          break
        }
        glyph = GlyphId.new(range.end)
        at = at + 1
      }
      if let Option<GlyphId>.Some { value } = IntSet<GlyphId>.nextAfter(glyphs, glyph) {
        drop run IntSet<u16>.insert(&mut out, 0)
      }
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        let class = ClassDefFormat2<'a>.get(self, value)
        if class != 0 {
          drop run IntSet<u16>.insert(&mut out, class)
        }
      }
    } else {
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if IntSet<GlyphId>.intersectsRange(
          glyphs,
          GlyphId.new(range.start),
          GlyphId.new(range.end),
        ) {
          drop run IntSet<u16>.insert(&mut out, u32.toU16(range.value))
        }
        at = at + 1
      }
    }
    return move out
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let first = glyphSetFirst(glyphs)
    let last = glyphSetLast(glyphs)
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    if class == 0 {
      let mut start = first
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if start < range.start {
          run extendGlyphs(&mut out, glyphSetRange(glyphs, start, range.start - 1))
        }
        if range.end >= last {
          break
        }
        start = range.end + 1
        at = at + 1
      }
      if start <= last {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, start, last))
      }
      return move out
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if ClassDefFormat2<'a>.get(self, value) == class {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if range.start > last {
          break
        }
        if range.value == u16.toU32(class) && range.end >= first {
          run extendGlyphs(&mut out, glyphSetRange(glyphs, range.start, range.end))
        }
        at = at + 1
      }
    }
    return move out
  }

  pub fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> bool {
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return false
    }
    if ClassDefFormat2<'a>.classRangeCount(self) == 0 {
      return class == 0
    }
    let first = glyphSetFirst(glyphs)
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    if class == 0 {
      let mut at: usize = 0
      let mut hasPrevious = false
      let mut previous = GlyphId.new(0)
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        let mut next = IntSet<GlyphId>.first(glyphs)
        if hasPrevious {
          next = IntSet<GlyphId>.nextAfter(glyphs, previous)
        }
        let glyph = match move next {
          Option<GlyphId>.Some { value } => value
          _ => {
            break
          }
        }
        if GlyphId.toU32(glyph) < range.start {
          return true
        }
        previous = GlyphId.new(range.end)
        hasPrevious = true
        at = at + 1
      }
      if hasPrevious {
        if let Option<GlyphId>.Some { value } = IntSet<GlyphId>.nextAfter(glyphs, previous) {
          return true
        }
      }
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if ClassDefFormat2<'a>.get(self, value) == class {
          return true
        }
      }
    } else {
      let last = glyphSetLast(glyphs)
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if range.start > last {
          break
        }
        if range.end >= first && range.value == u16.toU32(class)
          && IntSet<GlyphId>.intersectsRange(
            glyphs,
            GlyphId.new(range.start),
            GlyphId.new(range.end),
          ) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }
}

struct WideClassRanges<'a> {
  table: ClassDef<'a>,
  index: usize,
}

impl<'a> WideClassRanges<'a> {
  fn next(self: &mut Self) -> Option<LayoutRange> {
    match self.table {
      ClassDef<'a>.Format3 { value } => {
        let class = match move ScalarArray<Uint24>.get(
          &ClassDefFormat3<'a>.classValueArray(&value),
          self.index,
        ) {
          Option<Uint24>.Some { value: class } => class
          _ => {
            return Option<LayoutRange>.None
          }
        }
        let glyph = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(&value))
          + usize.toU32(self.index)
        self.index = self.index + 1
        if glyph > 16777215 {
          return Option<LayoutRange>.None
        }
        return Option<LayoutRange>.some(
          LayoutRange { start: glyph, end: glyph, value: Uint24.toU32(class) },
        )
      }
      ClassDef<'a>.Format4 { value } => {
        while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord2<'a>>(
          &ClassDefFormat4<'a>.classRangeRecords(&value),
          self.index,
        ) {
          self.index = self.index + 1
          if range.start <= range.end {
            return Option<LayoutRange>.some(range)
          }
        }
        return Option<LayoutRange>.None
      }
      _ => {
        return Option<LayoutRange>.None
      }
    }
  }
}

effect fn widenClasses(input: IntSet<u16>) -> IntSet<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = IntSet<u32>.empty()
  let mut iter = IntSet<u16>.iter(&input)
  while let Option<u16>.Some { value } = IntSetIter<u16>.next(&mut iter) {
    drop run IntSet<u32>.insert(&mut out, u16.toU32(value))
  }
  return move out
}

impl<'a> ClassDef<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u32>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        return run widenClasses(run ClassDefFormat1<'a>.intersectClasses(&value, glyphs))
      }
      ClassDef<'a>.Format2 { value } => {
        return run widenClasses(run ClassDefFormat2<'a>.intersectClasses(&value, glyphs))
      }
      _ => {}
    }
    let mut classes = IntSet<u32>.empty()
    let mut assigned = IntSet<GlyphId>.empty()
    let mut ranges = WideClassRanges<'a> { table: self.*, index: 0 }
    while let Option<LayoutRange>.Some { value: range } = WideClassRanges<'a>.next(&mut ranges) {
      if IntSet<GlyphId>.intersectsRange(glyphs, GlyphId.new(range.start), GlyphId.new(range.end)) {
        drop run IntSet<u32>.insert(&mut classes, range.value)
      }
      run IntSet<GlyphId>.insertRange(
        &mut assigned,
        GlyphId.new(range.start),
        GlyphId.new(range.end),
      )
    }
    if !IntSet<GlyphId>.isSubset(glyphs, &assigned) {
      drop run IntSet<u32>.insert(&mut classes, 0)
    }
    return move classes
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u32) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        if class > 65535 {
          return IntSet<GlyphId>.empty()
        }
        return run ClassDefFormat1<'a>.intersectedClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      ClassDef<'a>.Format2 { value } => {
        if class > 65535 {
          return IntSet<GlyphId>.empty()
        }
        return run ClassDefFormat2<'a>.intersectedClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      _ => {}
    }
    let mut out = IntSet<GlyphId>.empty()
    let mut assigned = IntSet<GlyphId>.empty()
    let mut ranges = WideClassRanges<'a> { table: self.*, index: 0 }
    while let Option<LayoutRange>.Some { value: range } = WideClassRanges<'a>.next(&mut ranges) {
      if range.value == class {
        run IntSet<GlyphId>.insertRange(&mut out, GlyphId.new(range.start), GlyphId.new(range.end))
      }
      if class == 0 {
        run IntSet<GlyphId>.insertRange(
          &mut assigned,
          GlyphId.new(range.start),
          GlyphId.new(range.end),
        )
      }
    }
    if class == 0 {
      IntSet<GlyphId>.invert(&mut assigned)
      run IntSet<GlyphId>.unionValue(&mut out, &assigned)
    }
    run IntSet<GlyphId>.intersect(&mut out, glyphs)
    return move out
  }

  pub effect fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        if class > 65535 {
          return false
        }
        return ClassDefFormat1<'a>.intersectsClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      ClassDef<'a>.Format2 { value } => {
        if class > 65535 {
          return false
        }
        return ClassDefFormat2<'a>.intersectsClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      _ => {
        let intersection = run ClassDef<'a>.intersectedClassGlyphs(self, glyphs, class)
        return !IntSet<GlyphId>.isEmpty(&intersection)
      }
    }
  }
}

// Handwritten extension from font/parse/src/tables/layout_scripts.silk
