      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn coverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      SequenceContextFormat3<'a>.coverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn coverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

