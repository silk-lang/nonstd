    return resolveWithArgs<(), ClassDef<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn inputClassDefOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to ClassDef table containing lookahead sequence context,
  /// from beginning of ChainedSequenceContextFormat5 table
  pub fn lookaheadClassDefOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
