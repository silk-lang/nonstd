/// Part of [SequenceContextFormat1]
pub struct SequenceRule<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for SequenceRule<'a> {}

impl<'a> SequenceRule<'a> {
  pub fn default() -> Self {
    return SequenceRule<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let seqLookupCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingSubtract(u16.toUsize(glyphCountValue), 1), 2),
    )
    ranges[2].end = end
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(seqLookupCountValue), 4))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

