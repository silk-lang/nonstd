  pub fn read(data: FontData<'a>, featureTag: Tag) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    let featureTagValue = featureTag
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let featureParamsOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[0].start,
      Nullable<Offset16>.default(),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let lookupIndexCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(lookupIndexCountValue), 2))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _featureTag: featureTag },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Offset from start of Feature table to FeatureParams table, if defined for the feature and present, else NULL
  pub fn featureParamsOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[0].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn featureParams(self: &Self) -> Option<Result<FeatureParams<'a>, ReadError>> {
    let offset = Feature<'a>.featureParamsOffset(self)
    return resolveNullableWithArgs<Tag, FeatureParams<'a>, Offset16>(
      &offset,
      self._fontData,
      self._featureTag,
    )
  }

  pub fn featureParamsOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of LookupList indices for this feature
  pub fn lookupIndexCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookupIndexCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of indices into the LookupList — zero-based (first
  /// lookup is LookupListIndex = 0)
  pub fn lookupListIndices(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn lookupListIndicesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, Tag> for Feature<'a> {
  fn readWithArgs(data: FontData<'a>, args: Tag) -> Result<Self, ReadError> {
    return Feature<'a>.read(data, args)
  }
}

impl<'a> MinByteRange<'a> for Feature<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Lookup List Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#lookup-list-table)
pub struct LookupList<'a, T: FontRead<'a, ()>> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a, T: FontRead<'a, ()>> Copy for LookupList<'a, T> {}

impl<'a, T> LookupList<'a, T> {
  pub fn default() -> Self {
    return LookupList<'a, T>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let lookupCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(lookupCountValue), 2))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of lookups in this table
  pub fn lookupCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookupCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of offsets to Lookup tables, from beginning of LookupList
  /// — zero based (first lookup is Lookup index = 0)
  pub fn lookupOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn lookups(self: &Self) -> ArrayOfOffsets<'a, (), T, Offset16> {
    return ArrayOfOffsets<'a, (), T, Offset16>.new(
      LookupList<'a, T>.lookupOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn lookupOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a, T: FontRead<'a, ()>> FontRead<'a, ()> for LookupList<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LookupList<'a, T>.read(data)
  }
}

impl<'a, T> LookupList<'a, T> {
  pub fn ofUnitType(self: &Self) -> LookupList<'a, ()> {
    return LookupList<'a, ()> { _fontData: self._fontData, _fieldRanges: self._fieldRanges }
  }
}

impl<'a, T: FontRead<'a, ()>> MinByteRange<'a> for LookupList<'a, T> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Lookup Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#lookup-table)
pub struct Lookup<'a, T: FontRead<'a, ()>> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a, T: FontRead<'a, ()>> Copy for Lookup<'a, T> {}

impl<'a, T> Lookup<'a, T> {
  pub fn default() -> Self {
    return Lookup<'a, T>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 5] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let lookupTypeValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let lookupFlagValue = scalarOr<LookupFlag>(data, ranges[1].start, LookupFlag.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let subTableCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(subTableCountValue), 2))
    ranges[3].end = end
    ranges[4].start = end
    if LookupFlag.contains(&lookupFlagValue, LookupFlag.useMarkFilteringSet()) {
      end = usize.saturatingAdd(end, 2)
    }
    ranges[4].end = end
    let markFilteringSetValue = scalarOr<u16>(data, ranges[4].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Different enumerations for GSUB and GPOS
  pub fn lookupType(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookupTypeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Lookup qualifiers
  pub fn lookupFlag(self: &Self) -> LookupFlag {
    return match move FontData<'a>.readAt<LookupFlag>(&self._fontData, self._fieldRanges[1].start) {
      Result<LookupFlag, ReadError>.Success { value } => value
      Result<LookupFlag, ReadError>.Failure { error } => LookupFlag.new(0)
    }
  }

  pub fn lookupFlagByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of subtables for this lookup
  pub fn subTableCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn subTableCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of offsets to lookup subtables, from beginning of Lookup
  /// table
  pub fn subtableOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn subtables(self: &Self) -> ArrayOfOffsets<'a, (), T, Offset16> {
    return ArrayOfOffsets<'a, (), T, Offset16>.new(
      Lookup<'a, T>.subtableOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn subtableOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Index (base 0) into GDEF mark glyph sets structure. This field
  /// is only present if the USE_MARK_FILTERING_SET lookup flag is
  /// set.
  pub fn markFilteringSet(self: &Self) -> Option<u16> {
    if self._fieldRanges[4].start == self._fieldRanges[4].end {
      return Option<u16>.None
    }
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => Option<u16>.some(value)
      Result<u16, ReadError>.Failure { error } => Option<u16>.None
    }
  }

  pub fn markFilteringSetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a, T: FontRead<'a, ()>> FontRead<'a, ()> for Lookup<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Lookup<'a, T>.read(data)
  }
}

impl<'a, T> Lookup<'a, T> {
  pub fn ofUnitType(self: &Self) -> Lookup<'a, ()> {
    return Lookup<'a, ()> { _fontData: self._fontData, _fieldRanges: self._fieldRanges }
  }

  pub fn readDiscriminant(data: FontData<'a>) -> Result<u16, ReadError> {
    return FontData<'a>.readAt<u16>(&data, 0)
  }
}

impl<'a, T: FontRead<'a, ()>> MinByteRange<'a> for Lookup<'a, T> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Coverage Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#coverage-format-1)
pub struct CoverageFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for CoverageFormat1<'a> {}

impl<'a> CoverageFormat1<'a> {
  pub fn default() -> Self {
    return CoverageFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let coverageFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 2))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 1
  pub fn coverageFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn coverageFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of glyphs in the glyph array
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of glyph IDs — in numerical order
  pub fn glyphArray(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn glyphArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for CoverageFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CoverageFormat1<'a>.read(data)
  }
}

