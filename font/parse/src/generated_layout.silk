  pub fn seqLookupRecords(self: &Self) -> ComputedArray<'a, (), SequenceLookupRecord<'a>> {
    return match move recordArray<SequenceLookupRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), SequenceLookupRecord<'a>>.empty(())
