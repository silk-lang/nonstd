}

/// Used in [CoverageFormat2]
pub struct RangeRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for RangeRecord<'a> {}

impl<'a> RangeRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph ID in the range
  pub fn startGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Last glyph ID in the range
  pub fn endGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 2)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Coverage Index of first glyph ID in range
  pub fn startCoverageIndex(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 4)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for RangeRecord<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for RangeRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for RangeRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return RangeRecord<'a>.readAt(data, position, ())
  }
}

/// [Coverage Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#coverage-table)
pub union CoverageTable<'a> {
  Format1 { pub value: CoverageFormat1<'a> },
  Format2 { pub value: CoverageFormat2<'a> },
  Format3 { pub value: CoverageFormat3<'a> },
  Format4 { pub value: CoverageFormat4<'a> },
}

impl<'a> Copy for CoverageTable<'a> {}

impl<'a> CoverageTable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move CoverageFormat1<'a>.read(data) {
          Result<CoverageFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CoverageTable<'a>.Format1 { value: value })
          Result<CoverageFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move CoverageFormat2<'a>.read(data) {
          Result<CoverageFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CoverageTable<'a>.Format2 { value: value })
          Result<CoverageFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move CoverageFormat3<'a>.read(data) {
          Result<CoverageFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CoverageTable<'a>.Format3 { value: value })
          Result<CoverageFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move CoverageFormat4<'a>.read(data) {
          Result<CoverageFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CoverageTable<'a>.Format4 { value: value })
          Result<CoverageFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.offsetData(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.offsetData(&value)
      CoverageTable<'a>.Format3 { value } => CoverageFormat3<'a>.offsetData(&value)
      CoverageTable<'a>.Format4 { value } => CoverageFormat4<'a>.offsetData(&value)
    }
  }

  /// Format identifier — format = 1
  pub fn coverageFormat(self: &Self) -> u16 {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.coverageFormat(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.coverageFormat(&value)
      CoverageTable<'a>.Format3 { value } => CoverageFormat3<'a>.coverageFormat(&value)
      CoverageTable<'a>.Format4 { value } => CoverageFormat4<'a>.coverageFormat(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for CoverageTable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CoverageTable<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for CoverageTable<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      CoverageTable<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      CoverageTable<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      CoverageTable<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      CoverageTable<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      CoverageTable<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      CoverageTable<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> CoverageTable<'a> {
  pub fn default() -> Self {
    return CoverageTable<'a>.Format1 { value: CoverageFormat1<'a>.default() }
  }
}

/// [Class Definition Table Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#class-definition-table-format-1)
pub struct ClassDefFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for ClassDefFormat1<'a> {}

impl<'a> ClassDefFormat1<'a> {
  pub fn default() -> Self {
    return ClassDefFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let classFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let startGlyphIdValue = scalarOr<GlyphId16>(data, ranges[1].start, GlyphId16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 2))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 1
  pub fn classFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn classFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// First glyph ID of the classValueArray
  pub fn startGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, self._fieldRanges[1].start) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  pub fn startGlyphIdByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Size of the classValueArray
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of Class Values — one per glyph ID
  pub fn classValueArray(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn classValueArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for ClassDefFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ClassDefFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for ClassDefFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for ClassDefFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Class Definition Table Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#class-definition-table-format-2)
pub struct ClassDefFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for ClassDefFormat2<'a> {}

impl<'a> ClassDefFormat2<'a> {
  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let classFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let classRangeCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(classRangeCountValue), 6))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 2
  pub fn classFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn classFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ClassRangeRecords
  pub fn classRangeCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn classRangeCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of ClassRangeRecords — ordered by startGlyphID
  pub fn classRangeRecords(self: &Self) -> ComputedArray<'a, (), ClassRangeRecord<'a>> {
    return match move recordArray<ClassRangeRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), ClassRangeRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), ClassRangeRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), ClassRangeRecord<'a>>.empty(())
    }
  }

  pub fn classRangeRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for ClassDefFormat2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ClassDefFormat2<'a>.read(data)
  }
}

impl<'a> Format<u16> for ClassDefFormat2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for ClassDefFormat2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Used in [ClassDefFormat2]
pub struct ClassRangeRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for ClassRangeRecord<'a> {}

impl<'a> ClassRangeRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph ID in the range
  pub fn startGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Last glyph ID in the range
  pub fn endGlyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 2)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Applied to all glyphs in the range
  pub fn class(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 4)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for ClassRangeRecord<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for ClassRangeRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for ClassRangeRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return ClassRangeRecord<'a>.readAt(data, position, ())
  }
}

/// A [Class Definition Table](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#class-definition-table)
pub union ClassDef<'a> {
  Format1 { pub value: ClassDefFormat1<'a> },
  Format2 { pub value: ClassDefFormat2<'a> },
  Format3 { pub value: ClassDefFormat3<'a> },
  Format4 { pub value: ClassDefFormat4<'a> },
}

impl<'a> Copy for ClassDef<'a> {}

impl<'a> ClassDef<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move ClassDefFormat1<'a>.read(data) {
          Result<ClassDefFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClassDef<'a>.Format1 { value: value })
          Result<ClassDefFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ClassDefFormat2<'a>.read(data) {
          Result<ClassDefFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClassDef<'a>.Format2 { value: value })
          Result<ClassDefFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move ClassDefFormat3<'a>.read(data) {
          Result<ClassDefFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClassDef<'a>.Format3 { value: value })
          Result<ClassDefFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move ClassDefFormat4<'a>.read(data) {
          Result<ClassDefFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ClassDef<'a>.Format4 { value: value })
          Result<ClassDefFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => ClassDefFormat1<'a>.offsetData(&value)
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.offsetData(&value)
      ClassDef<'a>.Format3 { value } => ClassDefFormat3<'a>.offsetData(&value)
      ClassDef<'a>.Format4 { value } => ClassDefFormat4<'a>.offsetData(&value)
    }
  }

  /// Format identifier — format = 1
  pub fn classFormat(self: &Self) -> u16 {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => ClassDefFormat1<'a>.classFormat(&value)
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.classFormat(&value)
      ClassDef<'a>.Format3 { value } => ClassDefFormat3<'a>.classFormat(&value)
      ClassDef<'a>.Format4 { value } => ClassDefFormat4<'a>.classFormat(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for ClassDef<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ClassDef<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ClassDef<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      ClassDef<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      ClassDef<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      ClassDef<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
