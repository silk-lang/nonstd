    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let classFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[1].end = end
    let classRangeCountValue = scalarOr<Uint24>(data, ranges[1].start, Uint24.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(classRangeCountValue)), 8),
    )
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier — format = 4
  pub fn classFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn classFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ClassRangeRecords
  pub fn classRangeCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[1].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn classRangeCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of ClassRangeRecords — ordered by startGlyphID
  pub fn classRangeRecords(self: &Self) -> ComputedArray<'a, (), ClassRangeRecord2<'a>> {
    return match move recordArray<ClassRangeRecord2<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), ClassRangeRecord2<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), ClassRangeRecord2<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), ClassRangeRecord2<'a>>.empty(())
    }
  }

  pub fn classRangeRecordsByteRange(self: &Self) -> ByteRange {
