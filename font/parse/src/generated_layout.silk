/// ChainedSequenceContextFormat5 (ISO/IEC 14496-22:2026).
pub struct ChainedSequenceContextFormat5<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 7],
}

impl<'a> Copy for ChainedSequenceContextFormat5<'a> {}

impl<'a> ChainedSequenceContextFormat5<'a> {
  pub fn minSize() -> usize {
    return 20
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 20 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 7] = [ByteRange { start: 0, end: 0 }; 7]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let backtrackClassDefOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let inputClassDefOffsetValue = scalarOr<Offset32>(data, ranges[3].start, Offset32.new(0))
    ranges[4].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[4].end = end
    let lookaheadClassDefOffsetValue = scalarOr<Offset32>(data, ranges[4].start, Offset32.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let chainedClassSeqRuleSetCountValue = scalarOr<u16>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(chainedClassSeqRuleSetCountValue), 3),
    )
    ranges[6].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 5
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of
  /// ChainedSequenceContextFormat5 table
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat5<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to ClassDef table containing backtrack sequence context,
  /// from beginning of ChainedSequenceContextFormat5 table
  pub fn backtrackClassDefOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn backtrackClassDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = ChainedSequenceContextFormat5<'a>.backtrackClassDefOffset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset32>(offset, self._fontData, ())
