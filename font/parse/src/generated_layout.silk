/// ClassRangeRecord2 (ISO/IEC 14496-22:2026).
pub struct ClassRangeRecord2<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for ClassRangeRecord2<'a> {}

impl<'a> ClassRangeRecord2<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph ID in the range
  pub fn startGlyphId(self: &Self) -> GlyphId24 {
    return match move FontData<'a>.readAt<GlyphId24>(&self._fontData, (self.position + 0)) {
      Result<GlyphId24, ReadError>.Success { value } => value
      Result<GlyphId24, ReadError>.Failure { error } => GlyphId24.new(0)
    }
  }

  /// Last glyph ID in the range
  pub fn endGlyphId(self: &Self) -> GlyphId24 {
    return match move FontData<'a>.readAt<GlyphId24>(&self._fontData, (self.position + 3)) {
      Result<GlyphId24, ReadError>.Success { value } => value
      Result<GlyphId24, ReadError>.Failure { error } => GlyphId24.new(0)
    }
  }

  /// Applied to all glyphs in the range
  pub fn class(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 6)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for ClassRangeRecord2<'a> {
  fn rawByteLen() -> usize {
    return 8
  }
}

impl<'a> ComputeSize<()> for ClassRangeRecord2<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(8)
  }
}

impl<'a> FontReadAt<'a, ()> for ClassRangeRecord2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return ClassRangeRecord2<'a>.readAt(data, position, ())
  }
}

