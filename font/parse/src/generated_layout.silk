        return Result<TaggedElement<LangSys<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move LangSysRecord<'a>.langSys(&record, self._fontData) {
      Result<LangSys<'a>, ReadError>.Success { value } => Result<
        TaggedElement<LangSys<'a>>,
        ReadError
      >.succeed(TaggedElement<LangSys<'a>>.new(LangSysRecord<'a>.langSysTag(&record), value))
      Result<LangSys<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<LangSys<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> ScriptList<'a> {
  pub fn select(self: &Self, tags: &[Tag]) -> Option<SelectedScript> {
    let mut i: usize = 0
    while i < tags.length {
      if let Option<u16>.Some { value } = ScriptList<'a>.indexForTag(self, tags[i]) {
        return Option<SelectedScript>.some(
          SelectedScript { tag: tags[i], index: value, isFallback: false },
        )
      }
      i = i + 1
    }
    let fallbacks: [Tag; 3] = [
      Tag.fromU32(1145457748),
      Tag.fromU32(1684434036),
      Tag.fromU32(1818326126),
    ]
    i = 0
    while i < 3 {
      if let Option<u16>.Some { value } = ScriptList<'a>.indexForTag(self, fallbacks[i]) {
        return Option<SelectedScript>.some(
          SelectedScript { tag: fallbacks[i], index: value, isFallback: true },
        )
      }
      i = i + 1
    }
    return Option<SelectedScript>.None
  }
}

impl<'a> FeatureList<'a> {
  pub fn get(self: &Self, index: u16) -> Result<TaggedElement<Feature<'a>>, ReadError> {
    let record = match move ComputedArray<'a, (), FeatureRecord<'a>>.get(
      &FeatureList<'a>.featureRecords(self),
      u16.toUsize(index),
    ) {
      Result<FeatureRecord<'a>, ReadError>.Success { value } => value
      Result<FeatureRecord<'a>, ReadError>.Failure { error } => {
        return Result<TaggedElement<Feature<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move FeatureRecord<'a>.feature(&record, self._fontData) {
      Result<Feature<'a>, ReadError>.Success { value } => Result<
        TaggedElement<Feature<'a>>,
        ReadError
      >.succeed(TaggedElement<Feature<'a>>.new(FeatureRecord<'a>.featureTag(&record), value))
      Result<Feature<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<Feature<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> LangSys<'a> {
  pub fn featureIndexForTag<'b>(self: &Self, list: &FeatureList<'b>, tag: Tag) -> Option<u16> {
    let indices = LangSys<'a>.featureIndices(self)
    let records = FeatureList.featureRecords(list)
    let mut i: usize = 0
    while i < ScalarArray<u16>.len(&indices) {
      let index = ScalarArray<u16>.get(&indices, i) |> Option<u16>.unwrapOr(0)
      if let Result<FeatureRecord<'b>, ReadError>.Success { value } = ComputedArray<
        'b,
        (),
        FeatureRecord<'b>
      >.get(&records, u16.toUsize(index)) {
        if &FeatureRecord<'b>.featureTag(&value) == &tag {
          return Option<u16>.some(index)
        }
      }
      i = i + 1
    }
    return Option<u16>.None
  }
}

pub struct ScriptTags {
  tags: [Tag; 3],
  length: usize,
}

impl Copy for ScriptTags {}

impl ScriptTags {
  pub fn default() -> Self {
    return Self { tags: [Tag.default(); 3], length: 0 }
  }

  pub fn fromUnicode(unicodeScript: Tag) -> Self {
    let mut result = ScriptTags.default()
    if let Option<Tag>.Some { value } = newTagFromUnicode(unicodeScript) {
      if Tag.toU32(value) != 1836674354 {
        result.tags[0] = Tag.fromU32(Tag.toU32(value) + 1)
        result.length = 1
      }
      result.tags[result.length] = value
      result.length = result.length + 1
    }
    result.tags[result.length] = oldTagFromUnicode(unicodeScript)
    result.length = result.length + 1
    return result
  }

  pub fn asSlice<'s>(self: &'s Self) -> &'s [Tag] {
    return Slice.view(&self.tags, 0, self.length)
  }
}

fn oldTagFromUnicode(tag: Tag) -> Tag {
  if Tag.toU32(tag) == 1517122664 {
    return Tag.fromU32(1835103336)
  }
  if Tag.toU32(tag) == 1214870113 {
    return Tag.fromU32(1801547361)
  }
  if Tag.toU32(tag) == 1281453935 {
    return Tag.fromU32(1818324768)
  }
  if Tag.toU32(tag) == 1500080489 {
    return Tag.fromU32(2036932640)
  }
  if Tag.toU32(tag) == 1315663727 {
    return Tag.fromU32(1852534560)
  }
  if Tag.toU32(tag) == 1449224553 {
    return Tag.fromU32(1986095392)
  }
  let mut bytes = Tag.toBeBytes(tag)
  if bytes[0] >= 65 && bytes[0] <= 90 {
    bytes[0] = bytes[0] + 32
  }
  return Tag.fromBeBytes(bytes)
}

fn newTagFromUnicode(tag: Tag) -> Option<Tag> {
  if Tag.toU32(tag) == 1113943655 {
    return Option<Tag>.some(Tag.fromU32(1651402546))
  }
  if Tag.toU32(tag) == 1147500129 {
    return Option<Tag>.some(Tag.fromU32(1684370994))
  }
  if Tag.toU32(tag) == 1198877298 {
    return Option<Tag>.some(Tag.fromU32(1735029298))
  }
  if Tag.toU32(tag) == 1198879349 {
    return Option<Tag>.some(Tag.fromU32(1735750194))
  }
  if Tag.toU32(tag) == 1265525857 {
    return Option<Tag>.some(Tag.fromU32(1802396722))
  }
  if Tag.toU32(tag) == 1298954605 {
    return Option<Tag>.some(Tag.fromU32(1835822386))
  }
  if Tag.toU32(tag) == 1299803506 {
    return Option<Tag>.some(Tag.fromU32(1836674354))
  }
  if Tag.toU32(tag) == 1332902241 {
    return Option<Tag>.some(Tag.fromU32(1869773106))
  }
  if Tag.toU32(tag) == 1415671148 {
    return Option<Tag>.some(Tag.fromU32(1953328178))
  }
  if Tag.toU32(tag) == 1415933045 {
    return Option<Tag>.some(Tag.fromU32(1952803890))
  }
  return Option<Tag>.None
}

// Handwritten extension from font/parse/src/tables/layout_conditions.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import model.error { Error }

impl<'a> Condition<'a> {
  pub fn evaluate(
    self: &Self,
    coords: &[F2Dot14],
    mut delta: mut fn(u32) -> Result<f64, Error>,
  ) -> Result<bool, Error> {
    let mut budget: usize = 65536
    return evaluateCondition(self, coords, &mut delta, 64, &mut budget)
  }
}

impl<'a> ConditionSet<'a> {
  pub fn evaluate(
    self: &Self,
    coords: &[F2Dot14],
    mut delta: mut fn(u32) -> Result<f64, Error>,
  ) -> Result<bool, Error> {
    let offsets = ConditionSet<'a>.conditionOffsets(self)
    if ScalarArray<Offset32>.len(&offsets) != u16.toUsize(ConditionSet<'a>.conditionCount(self)) {
      return Result<bool, Error>.failResult(Error.Malformed)
    }
    let mut budget: usize = 65536
    let mut i: usize = 0
    while i < ScalarArray<Offset32>.len(&offsets) {
      let offset = ScalarArray<Offset32>.get(&offsets, i)
        |> Option<Offset32>.unwrapOr(Offset32.new(0))
      match move evaluateConditionOffset(
        self._fontData,
        Offset32.toU32(offset),
        coords,
        &mut delta,
        64,
        &mut budget,
      ) {
        Result<bool, Error>.Failure { error } => {
          return Result<bool, Error>.failResult(error)
        }
        Result<bool, Error>.Success { value } => {
          if !value {
            return Result<bool, Error>.succeed(false)
          }
        }
      }
      i = i + 1
    }
    return Result<bool, Error>.succeed(true)
  }
}

impl<'a> LookupConditionRecord<'a> {
  pub fn evaluate(
    self: &Self,
    data: FontData,
    coords: &[F2Dot14],
    mut delta: mut fn(u32) -> Result<f64, Error>,
  ) -> Result<bool, Error> {
    let mut budget: usize = 65536
    return evaluateConditionOffset(
      data,
      Offset32.toU32(Nullable<Offset32>.offset(&LookupConditionRecord<'a>.conditionOffset(self)).*),
      coords,
      &mut delta,
      64,
      &mut budget,
    )
  }
}

fn evaluateConditionOffset<'a>(
  data: FontData<'a>,
  offset: u32,
  coords: &[F2Dot14],
  delta: &mut mut fn(u32) -> Result<f64, Error>,
  depth: usize,
  budget: &mut usize,
) -> Result<bool, Error> {
  if offset == 0 {
    return Result<bool, Error>.succeed(true)
  }
  let data = match move FontData.splitOff(&data, u32.toUsize(offset)) {
    Option<FontData<'a>>.Some { value } => value
    Option<FontData<'a>>.None => {
      return Result<bool, Error>.failResult(Error.Malformed)
    }
  }
  let condition = match move Condition<'a>.read(data) {
    Result<Condition<'a>, ReadError>.Success { value } => value
    Result<Condition<'a>, ReadError>.Failure { error: ReadError.InvalidFormat { value } } => {
      return Result<bool, Error>.succeed(false)
    }
    Result<Condition<'a>, ReadError>.Failure { error } => {
      return Result<bool, Error>.failResult(Error.Malformed)
    }
  }
  return evaluateCondition(&condition, coords, &mut delta, depth, &mut budget)
}

fn evaluateCondition<'a>(
  condition: &Condition<'a>,
  coords: &[F2Dot14],
  delta: &mut mut fn(u32) -> Result<f64, Error>,
  depth: usize,
  budget: &mut usize,
) -> Result<bool, Error> {
  if depth == 0 || budget.* == 0 {
    return Result<bool, Error>.failResult(Error.LimitExceeded)
  }
  budget.* = budget.* - 1
  match condition.* {
    Condition<'a>.Format1AxisRange { value } => {
      let axis = u16.toUsize(ConditionFormat1<'a>.axisIndex(&value))
      let mut coord: i16 = 0
      if axis < coords.length {
        coord = F2Dot14.toBits(coords[axis])
      }
      return Result<bool, Error>.succeed(
        coord >= F2Dot14.toBits(ConditionFormat1<'a>.filterRangeMinValue(&value))
          && coord <= F2Dot14.toBits(ConditionFormat1<'a>.filterRangeMaxValue(&value)),
      )
    }
    Condition<'a>.Format2VariableValue { value } => {
      let index = ConditionFormat2<'a>.varIndex(&value)
      let mut adjustment: f64 = 0.0
      if index != 4294967295 {
        adjustment = match move delta.*(index) {
          Result<f64, Error>.Success { value: amount } => amount
          Result<f64, Error>.Failure { error } => {
            return Result<bool, Error>.failResult(error)
          }
        }
      }
      return Result<bool, Error>.succeed(
        i16.toF64(ConditionFormat2<'a>.defaultValue(&value)) + adjustment > 0.0,
      )
    }
    Condition<'a>.Format3And { value } => {
      let offsets = ConditionFormat3<'a>.conditionOffsets(&value)
      if ScalarArray<Offset24>.len(&offsets)
        != u8.toUsize(ConditionFormat3<'a>.conditionCount(&value)) {
        return Result<bool, Error>.failResult(Error.Malformed)
      }
      let mut i: usize = 0
      while i < ScalarArray<Offset24>.len(&offsets) {
        let offset = ScalarArray<Offset24>.get(&offsets, i)
          |> Option<Offset24>.unwrapOr(Offset24.new(Uint24.new(0)))
        match move evaluateConditionOffset(
          value._fontData,
          Offset24.toU32(offset),
          coords,
          &mut delta,
          depth - 1,
          &mut budget,
        ) {
          Result<bool, Error>.Failure { error } => {
            return Result<bool, Error>.failResult(error)
          }
          Result<bool, Error>.Success { value: matches } => {
            if !matches {
              return Result<bool, Error>.succeed(false)
            }
          }
        }
        i = i + 1
      }
      return Result<bool, Error>.succeed(true)
    }
    Condition<'a>.Format4Or { value } => {
      let offsets = ConditionFormat4<'a>.conditionOffsets(&value)
      if ScalarArray<Offset24>.len(&offsets)
        != u8.toUsize(ConditionFormat4<'a>.conditionCount(&value)) {
        return Result<bool, Error>.failResult(Error.Malformed)
      }
      let mut i: usize = 0
      while i < ScalarArray<Offset24>.len(&offsets) {
        let offset = ScalarArray<Offset24>.get(&offsets, i)
          |> Option<Offset24>.unwrapOr(Offset24.new(Uint24.new(0)))
        match move evaluateConditionOffset(
          value._fontData,
          Offset24.toU32(offset),
          coords,
          &mut delta,
          depth - 1,
          &mut budget,
        ) {
          Result<bool, Error>.Failure { error } => {
            return Result<bool, Error>.failResult(error)
          }
          Result<bool, Error>.Success { value: matches } => {
            if matches {
              return Result<bool, Error>.succeed(true)
            }
          }
        }
        i = i + 1
      }
      return Result<bool, Error>.succeed(false)
    }
    Condition<'a>.Format5Negate { value } => {
      return match move evaluateConditionOffset(
        value._fontData,
        Offset24.toU32(ConditionFormat5<'a>.conditionOffset(&value)),
        coords,
        &mut delta,
        depth - 1,
        &mut budget,
      ) {
        Result<bool, Error>.Success { value: matches } => Result<bool, Error>.succeed(!matches)
        Result<bool, Error>.Failure { error } => Result<bool, Error>.failResult(error)
      }
    }
  }
}

impl<'a> FeatureVariations<'a> {
  pub fn indexForCoords(self: &Self, coords: &[F2Dot14]) -> Option<u32> {
    return FeatureVariations<'a>.indexForCoordsWithDelta<Error>(
      self,
      coords,
      fn(index: u32) -> Result<f64, Error> {
        return Result<f64, Error>.succeed(0.0)
      },
    )
  }

  pub fn indexForCoordsWithDelta<E>(
    self: &Self,
    coords: &[F2Dot14],
    mut delta: mut fn(u32) -> Result<f64, E>,
  ) -> Option<u32> {
    if FeatureVariations<'a>.version(self).major != 1 {
      return Option<u32>.None
    }
    let records = FeatureVariations<'a>.featureVariationRecords(self)
    let mut i: usize = 0
    while i < ComputedArray<'a, (), FeatureVariationRecord<'a>>.len(&records) {
      let index = i
      i = i + 1
      let record = match move ComputedArray<'a, (), FeatureVariationRecord<'a>>.get(
        &records,
        index,
      ) {
        Result<FeatureVariationRecord<'a>, ReadError>.Success { value } => value
        Result<FeatureVariationRecord<'a>, ReadError>.Failure { error } => {
          continue
        }
      }
      if Nullable<Offset32>.isNull(&FeatureVariationRecord<'a>.conditionSetOffset(&record)) {
        return Option<u32>.some(usize.toU32(index))
      }
      let setResult = match move FeatureVariationRecord<'a>.conditionSet(&record, self._fontData) {
        Option<Result<ConditionSet<'a>, ReadError>>.Some { value } => move value
        Option<Result<ConditionSet<'a>, ReadError>>.None => {
          continue
        }
      }
      let set = match move setResult {
        Result<ConditionSet<'a>, ReadError>.Success { value } => value
        Result<ConditionSet<'a>, ReadError>.Failure { error } => {
          continue
        }
      }
      let matches = ConditionSet<'a>.evaluate(
        &set,
        coords,
        fn(index: u32) -> Result<f64, Error> {
          return match move delta(index) {
            Result<f64, E>.Success { value } => Result<f64, Error>.succeed(value)
            Result<f64, E>.Failure { error } => Result<f64, Error>.failResult(Error.Malformed)
          }
        },
      )
        |> Result<bool, Error>.unwrapOr(false)
      if matches {
        return Option<u32>.some(usize.toU32(index))
      }
    }
    return Option<u32>.None
  }
}

impl<'a> FeatureTableSubstitutionRecord<'a> {
  pub fn alternateFeature<'b>(self: &Self, data: FontData<'b>) -> Result<Feature<'b>, ReadError> {
    return FeatureTableSubstitutionRecord<'a>.alternateFeatureWithTag(
      self,
      data,
      Tag.fromU32(1314212940),
    )
  }

  pub fn alternateFeatureWithTag<'b>(self: &Self, data: FontData<'b>, featureTag: Tag) -> Result<
    Feature<'b>,
    ReadError
  > {
    return resolveWithArgs<Tag, Feature<'b>, Offset32>(
      FeatureTableSubstitutionRecord<'a>.alternateFeatureOffset(self),
      data,
      featureTag,
    )
  }
}

import generated_variations { ItemVariationStore, DeltaSetIndex }
import font_types.lib { F48Dot16 }

pub fn storeDeltas<'a>(store: Option<ItemVariationStore<'a>>, coords: &'a [F2Dot14]) -> fn<'a>(
  u32
) -> Result<f64, Error> {
  let mut present = false
  let mut selected = ItemVariationStore<'a>.default()
  match move store {
    Option<ItemVariationStore<'a>>.Some { value } => {
      selected = value
      present = true
    }
    _ => {}
  }
  return fn(index: u32) -> Result<f64, Error> {
    let mut delta = F48Dot16.zero()
    let value = selected
    if present {
      delta = ItemVariationStore.computeDelta(&value, DeltaSetIndex.fromU32(index), coords)
        |> Option<F48Dot16>.unwrapOr(F48Dot16.zero())
    }
    return Result<f64, Error>.succeed(F48Dot16.toF64(delta))
  }
}

// Handwritten extension from font/parse/src/tables/layout_feature_variations.silk
