import silk.collections.slice { Slice }

pub struct TaggedElement<T> {
  pub tag: Tag,
  pub element: T,
}

impl<T: Copy> Copy for TaggedElement<T> {}

impl<T> TaggedElement<T> {
  pub fn new(tag: Tag, element: T) -> Self {
    return Self { tag: tag, element: move element }
  }
}

pub struct SelectedScript {
  pub tag: Tag,
  pub index: u16,
  pub isFallback: bool,
}

impl Copy for SelectedScript {}

impl Equal for SelectedScript {
  fn equals(left: &SelectedScript, right: &SelectedScript) -> bool {
    return &left.tag == &right.tag && left.index == right.index
      && left.isFallback == right.isFallback
  }
}

impl<'a> ScriptList<'a> {
  pub fn indexForTag(self: &Self, tag: Tag) -> Option<u16> {
    let records = ScriptList<'a>.scriptRecords(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), ScriptRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(&records, mid) {
        Result<ScriptRecord<'a>, ReadError>.Success { value } => value
        Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
          return Option<u16>.None
        }
      }
      if Tag.toU32(ScriptRecord<'a>.scriptTag(&record)) <= Tag.toU32(tag) {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo == 0 {
      return Option<u16>.None
    }
    let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(&records, lo - 1) {
      Result<ScriptRecord<'a>, ReadError>.Success { value } => value
      Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
        return Option<u16>.None
      }
    }
    if &ScriptRecord<'a>.scriptTag(&record) == &tag {
      return Option<u16>.some(usize.toU16(lo - 1))
    }
    return Option<u16>.None
  }

  pub fn get(self: &Self, index: u16) -> Result<TaggedElement<Script<'a>>, ReadError> {
    let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(
      &ScriptList<'a>.scriptRecords(self),
      u16.toUsize(index),
    ) {
      Result<ScriptRecord<'a>, ReadError>.Success { value } => value
      Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
        return Result<TaggedElement<Script<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move ScriptRecord<'a>.script(&record, self._fontData) {
      Result<Script<'a>, ReadError>.Success { value } => Result<
        TaggedElement<Script<'a>>,
        ReadError
      >.succeed(TaggedElement<Script<'a>>.new(ScriptRecord<'a>.scriptTag(&record), value))
      Result<Script<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<Script<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> Script<'a> {
  pub fn langSysIndexForTag(self: &Self, tag: Tag) -> Option<u16> {
    let records = Script<'a>.langSysRecords(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), LangSysRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), LangSysRecord<'a>>.get(&records, mid) {
        Result<LangSysRecord<'a>, ReadError>.Success { value } => value
        Result<LangSysRecord<'a>, ReadError>.Failure { error } => {
          return Option<u16>.None
        }
      }
