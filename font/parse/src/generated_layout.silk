/// ChainedSequenceRule2 (ISO/IEC 14496-22:2026).
pub struct ChainedSequenceRule2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 8],
}

impl<'a> Copy for ChainedSequenceRule2<'a> {}

impl<'a> ChainedSequenceRule2<'a> {
  pub fn default() -> Self {
    return ChainedSequenceRule2<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 8] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 8] = [ByteRange { start: 0, end: 0 }; 8]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let backtrackGlyphCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(backtrackGlyphCountValue), 3),
    )
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let inputGlyphCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingSubtract(u16.toUsize(inputGlyphCountValue), 1), 3),
    )
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let lookaheadGlyphCountValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(lookaheadGlyphCountValue), 3),
    )
    ranges[5].end = end
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let seqLookupCountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(seqLookupCountValue), 4))
    ranges[7].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of glyphs in the backtrack sequence
  pub fn backtrackGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn backtrackGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of backtrack glyph IDs
  pub fn backtrackSequence(self: &Self) -> ScalarArray<'a, GlyphId24> {
    return match move FontData<'a>.readArray<GlyphId24>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Failure { error } => ScalarArray<
        GlyphId24
      >.empty()
    }
  }

  pub fn backtrackSequenceByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of glyphs in the input sequence
  pub fn inputGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn inputGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of input glyph IDs—start with second glyph
  pub fn inputSequence(self: &Self) -> ScalarArray<'a, GlyphId24> {
    return match move FontData<'a>.readArray<GlyphId24>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Failure { error } => ScalarArray<
        GlyphId24
      >.empty()
    }
  }

  pub fn inputSequenceByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of glyphs in the lookahead sequence
  pub fn lookaheadGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookaheadGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
