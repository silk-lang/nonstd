    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of conditions.
  pub fn conditionCount(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[1].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn conditionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of condition tables for this disjunction (OR) expression.
  pub fn conditionOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn conditions(self: &Self) -> ArrayOfOffsets<'a, (), Condition<'a>, Offset24> {
    return ArrayOfOffsets<'a, (), Condition<'a>, Offset24>.new(
      ConditionFormat4<'a>.conditionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn conditionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

