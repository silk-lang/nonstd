/// [Sequence Context Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/chapter2#sequence-context-format-2-class-based-glyph-contexts)
pub struct SequenceContextFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for SequenceContextFormat2<'a> {}

impl<'a> SequenceContextFormat2<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let classDefOffsetValue = scalarOr<Offset16>(data, ranges[2].start, Offset16.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let classSeqRuleSetCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(classSeqRuleSetCountValue), 2),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of
  /// SequenceContextFormat2 table
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = SequenceContextFormat2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to ClassDef table, from beginning of
  /// SequenceContextFormat2 table
  pub fn classDefOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn classDef(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = SequenceContextFormat2<'a>.classDefOffset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn classDefOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of ClassSequenceRuleSet tables
  pub fn classSeqRuleSetCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn classSeqRuleSetCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Array of offsets to ClassSequenceRuleSet tables, from beginning
  /// of SequenceContextFormat2 table (may be NULL)
  pub fn classSeqRuleSetOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset16>> {
    return match move FontData<'a>.readArray<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset16>
      >.empty()
    }
  }

  pub fn classSeqRuleSets(self: &Self) -> ArrayOfNullableOffsets<
    'a,
    (),
    ClassSequenceRuleSet<'a>,
    Offset16
  > {
    return ArrayOfNullableOffsets<'a, (), ClassSequenceRuleSet<'a>, Offset16>.new(
      SequenceContextFormat2<'a>.classSeqRuleSetOffsets(self),
      self._fontData,
      (),
    )
  }

