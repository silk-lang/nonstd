    return self._fieldRanges[5]
  }

  /// Number of SequenceLookupRecords
  pub fn seqLookupCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn seqLookupCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// Array of SequenceLookupRecords
  pub fn seqLookupRecords(self: &Self) -> ComputedArray<'a, (), SequenceLookupRecord<'a>> {
    return match move recordArray<SequenceLookupRecord<'a>>(
      self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), SequenceLookupRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), SequenceLookupRecord<'a>>.empty(())
    }
  }

  pub fn seqLookupRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }
}

