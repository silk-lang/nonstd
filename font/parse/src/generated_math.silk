  pub fn constant(self: &Self, constant: MathConstant) -> i32 {
    return match constant {
      MathConstant.ScriptPercentScaleDown => i16.toI32(MathConstants.scriptPercentScaleDown(self))
      MathConstant.ScriptScriptPercentScaleDown => i16.toI32(
        MathConstants.scriptScriptPercentScaleDown(self),
