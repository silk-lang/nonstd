  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[6].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[6].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [MathGlyphConstruction](https://learn.microsoft.com/en-us/typography/opentype/spec/math#mathglyphconstruction-table)
pub struct MathGlyphConstruction<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for MathGlyphConstruction<'a> {}

impl<'a> MathGlyphConstruction<'a> {
  pub fn default() -> Self {
    return MathGlyphConstruction<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let glyphAssemblyOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[0].start,
      Nullable<Offset16>.default(),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let variantCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(variantCountValue), 4))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Offset to the GlyphAssembly table for this shape, from the beginning of
  /// the MathGlyphConstruction table. May be NULL.
  pub fn glyphAssemblyOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[0].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn glyphAssembly(self: &Self) -> Option<Result<GlyphAssembly<'a>, ReadError>> {
    let offset = MathGlyphConstruction<'a>.glyphAssemblyOffset(self)
    return resolveNullableWithArgs<(), GlyphAssembly<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn glyphAssemblyOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Count of glyph growing variants for this glyph.
  pub fn variantCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn variantCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// MathGlyphVariantRecords for alternative variants of the base glyph.
  pub fn mathGlyphVariantRecords(self: &Self) -> ComputedArray<'a, (), MathGlyphVariantRecord<'a>> {
    return match move recordArray<MathGlyphVariantRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), MathGlyphVariantRecord<'a>>, ReadError>.Success {
        value
      } => value
      Result<ComputedArray<'a, (), MathGlyphVariantRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), MathGlyphVariantRecord<'a>>.empty(())
    }
  }

