      10 => Option<Self>.some(MathConstant.SubscriptBaselineDropMin)
      11 => Option<Self>.some(MathConstant.SuperscriptShiftUp)
      12 => Option<Self>.some(MathConstant.SuperscriptShiftUpCramped)
      13 => Option<Self>.some(MathConstant.SuperscriptBottomMin)
      14 => Option<Self>.some(MathConstant.SuperscriptBaselineDropMax)
      15 => Option<Self>.some(MathConstant.SubSuperscriptGapMin)
      16 => Option<Self>.some(MathConstant.SuperscriptBottomMaxWithSubscript)
      17 => Option<Self>.some(MathConstant.SpaceAfterScript)
