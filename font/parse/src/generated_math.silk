/// [MathGlyphVariantRecord](https://learn.microsoft.com/en-us/typography/opentype/spec/math#mathglyphvariantrecord)
pub struct MathGlyphVariantRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for MathGlyphVariantRecord<'a> {}

impl<'a> MathGlyphVariantRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 4 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Glyph ID for the variant.
  pub fn variantGlyph(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Advance width/height, in design units, of the variant, in the direction
  /// of requested glyph extension.
  pub fn advanceMeasurement(self: &Self) -> UfWord {
    return match move FontData<'a>.readAt<UfWord>(&self._fontData, (self.position + 2)) {
      Result<UfWord, ReadError>.Success { value } => value
      Result<UfWord, ReadError>.Failure { error } => UfWord.new(0)
    }
  }
}

impl<'a> FixedSize for MathGlyphVariantRecord<'a> {
  fn rawByteLen() -> usize {
    return 4
  }
}

impl<'a> ComputeSize<()> for MathGlyphVariantRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(4)
  }
}

impl<'a> FontReadAt<'a, ()> for MathGlyphVariantRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return MathGlyphVariantRecord<'a>.readAt(data, position, ())
  }
}

/// [GlyphAssembly](https://learn.microsoft.com/en-us/typography/opentype/spec/math#glyphassembly-table)
pub struct GlyphAssembly<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for GlyphAssembly<'a> {}

impl<'a> GlyphAssembly<'a> {
  pub fn default() -> Self {
    return GlyphAssembly<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let partCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(partCountValue), 10))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Italics correction of this GlyphAssembly. Should not depend on the
  /// assembly size.
  pub fn italicsCorrection(self: &Self) -> MathValueRecord<'a> {
    return match move readAtWithArgs<(), MathValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[0].start,
      (),
    ) {
      Result<MathValueRecord<'a>, ReadError>.Success { value } => value
      Result<MathValueRecord<'a>, ReadError>.Failure { error } => MathValueRecord<'a>.default()
    }
  }

  pub fn italicsCorrectionByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of parts in this assembly.
  pub fn partCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn partCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of part records, from left to right (for assemblies that extend
  /// horizontally) or bottom to top (for assemblies that extend vertically).
  pub fn partRecords(self: &Self) -> ComputedArray<'a, (), GlyphPartRecord<'a>> {
    return match move recordArray<GlyphPartRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), GlyphPartRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), GlyphPartRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), GlyphPartRecord<'a>>.empty(())
    }
  }

  pub fn partRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for GlyphAssembly<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return GlyphAssembly<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for GlyphAssembly<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [GlyphPartRecord](https://learn.microsoft.com/en-us/typography/opentype/spec/math#glyphpartrecord)
pub struct GlyphPartRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for GlyphPartRecord<'a> {}

impl<'a> GlyphPartRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 10 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Glyph ID for the part.
  pub fn glyphId(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Advance width/ height, in design units, of the straight bar connector
  /// material at the start of the glyph in the direction of the extension.
  pub fn startConnectorLength(self: &Self) -> UfWord {
    return match move FontData<'a>.readAt<UfWord>(&self._fontData, (self.position + 2)) {
      Result<UfWord, ReadError>.Success { value } => value
      Result<UfWord, ReadError>.Failure { error } => UfWord.new(0)
    }
  }

  /// Advance width/ height, in design units, of the straight bar connector
  /// material at the end of the glyph in the direction of the extension.
  pub fn endConnectorLength(self: &Self) -> UfWord {
    return match move FontData<'a>.readAt<UfWord>(&self._fontData, (self.position + 4)) {
      Result<UfWord, ReadError>.Success { value } => value
      Result<UfWord, ReadError>.Failure { error } => UfWord.new(0)
    }
  }

  /// Full advance width/height for this part in the direction of the
  /// extension, in design units.
  pub fn fullAdvance(self: &Self) -> UfWord {
    return match move FontData<'a>.readAt<UfWord>(&self._fontData, (self.position + 6)) {
      Result<UfWord, ReadError>.Success { value } => value
      Result<UfWord, ReadError>.Failure { error } => UfWord.new(0)
    }
  }

  /// Part qualifiers.
  pub fn partFlags(self: &Self) -> PartFlags {
    return match move FontData<'a>.readAt<PartFlags>(&self._fontData, (self.position + 8)) {
      Result<PartFlags, ReadError>.Success { value } => value
      Result<PartFlags, ReadError>.Failure { error } => PartFlags.empty()
    }
  }
}

impl<'a> FixedSize for GlyphPartRecord<'a> {
  fn rawByteLen() -> usize {
    return 10
  }
}

impl<'a> ComputeSize<()> for GlyphPartRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(10)
  }
}

impl<'a> FontReadAt<'a, ()> for GlyphPartRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return GlyphPartRecord<'a>.readAt(data, position, ())
  }
}

/// Qualifiers for a [`GlyphPartRecord`].
pub struct PartFlags {
  raw: u16,
}

impl Copy for PartFlags {}

impl PartFlags {
  pub fn bits(self: &Self) -> u16 {
    return self.raw
  }

  pub fn empty() -> PartFlags {
    return PartFlags { raw: 0 }
  }

  pub fn all() -> PartFlags {
    return PartFlags { raw: 1 }
  }

  pub fn fromBitsTruncate(bits: u16) -> PartFlags {
    return PartFlags { raw: bits & 1 }
  }

  pub fn fromBits(bits: u16) -> Option<PartFlags> {
    if (bits & 1) != bits {
      return Option<PartFlags>.None
    }
    return Option<PartFlags>.some(PartFlags { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: PartFlags) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: PartFlags) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: PartFlags) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: PartFlags) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: PartFlags) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// If set, the part can be skipped or repeated.
  pub fn extenderFlag() -> PartFlags {
    return PartFlags { raw: 1 }
  }
}

impl Equal for PartFlags {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl PartFlags {
  pub fn default() -> Self {
    return PartFlags.empty()
  }
}

impl Order for PartFlags {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for PartFlags {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if PartFlags.contains(self, PartFlags.extenderFlag()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("EXTENDER_FLAG")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<PartFlags, PartFlags> for PartFlags {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<PartFlags, PartFlags> for PartFlags {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<PartFlags, PartFlags> for PartFlags {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<PartFlags, PartFlags> for PartFlags {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<PartFlags> for PartFlags {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 1 }
  }
}

impl Scalar for PartFlags {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(PartFlags.fromBitsTruncate(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.raw, move bytes)
  }
}

impl FixedSize for PartFlags {
  fn rawByteLen() -> usize {
    return 2
  }
}

pub enum(u8) MathConstant {
  ScriptPercentScaleDown = 0,
  ScriptScriptPercentScaleDown = 1,
  DelimitedSubFormulaMinHeight = 2,
  DisplayOperatorMinHeight = 3,
  MathLeading = 4,
  AxisHeight = 5,
  AccentBaseHeight = 6,
  FlattenedAccentBaseHeight = 7,
  SubscriptShiftDown = 8,
  SubscriptTopMax = 9,
  SubscriptBaselineDropMin = 10,
