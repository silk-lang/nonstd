/// [MathKernInfoRecord](https://learn.microsoft.com/en-us/typography/opentype/spec/math#mathkerninforecord)
///
/// The offsets are measured from the beginning of the MathKernInfo table.
pub struct MathKernInfoRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for MathKernInfoRecord<'a> {}

impl<'a> MathKernInfoRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Offset to the MathKern table for the top right corner, from the
  /// beginning of the MathKernInfo table. May be NULL.
  pub fn topRightMathKernOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 0),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn topRightMathKern(self: &Self, data: FontData<'a>) -> Option<
    Result<MathKern<'a>, ReadError>
  > {
    let offset = MathKernInfoRecord<'a>.topRightMathKernOffset(self)
    return resolveNullableWithArgs<(), MathKern<'a>, Offset16>(&offset, data, ())
  }

  /// Offset to the MathKern table for the top left corner, from the beginning
  /// of the MathKernInfo table. May be NULL.
  pub fn topLeftMathKernOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 2),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn topLeftMathKern(self: &Self, data: FontData<'a>) -> Option<
    Result<MathKern<'a>, ReadError>
  > {
    let offset = MathKernInfoRecord<'a>.topLeftMathKernOffset(self)
    return resolveNullableWithArgs<(), MathKern<'a>, Offset16>(&offset, data, ())
  }

  /// Offset to the MathKern table for the bottom right corner, from the
  /// beginning of the MathKernInfo table. May be NULL.
  pub fn bottomRightMathKernOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 4),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn bottomRightMathKern(self: &Self, data: FontData<'a>) -> Option<
    Result<MathKern<'a>, ReadError>
