/// [MathKern](https://learn.microsoft.com/en-us/typography/opentype/spec/math#mathkern-table)
pub struct MathKern<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for MathKern<'a> {}

impl<'a> MathKern<'a> {
  pub fn default() -> Self {
    return MathKern<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let heightCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(heightCountValue), 4))
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingAdd(u16.toUsize(heightCountValue), 1), 4),
    )
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of heights at which the kern value changes.
  pub fn heightCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn heightCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of correction heights, in design units, sorted from lowest to
  /// highest.
  pub fn correctionHeight(self: &Self) -> ComputedArray<'a, (), MathValueRecord<'a>> {
    return match move recordArray<MathValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ComputedArray<'a, (), MathValueRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), MathValueRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), MathValueRecord<'a>>.empty(())
    }
  }

  pub fn correctionHeightByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of kerning values for different height ranges, in design units.
  ///
  /// There is one more of these than there are correction heights: the first
  /// applies below the first correction height, and the last above the last.
  pub fn kernValues(self: &Self) -> ComputedArray<'a, (), MathValueRecord<'a>> {
    return match move recordArray<MathValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), MathValueRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), MathValueRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), MathValueRecord<'a>>.empty(())
    }
  }

  pub fn kernValuesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for MathKern<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MathKern<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for MathKern<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [MathVariants](https://learn.microsoft.com/en-us/typography/opentype/spec/math#mathvariants-table)
pub struct MathVariants<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 7],
}

impl<'a> Copy for MathVariants<'a> {}

impl<'a> MathVariants<'a> {
  pub fn default() -> Self {
    return MathVariants<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 7] },
      )
  }

  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 7] = [ByteRange { start: 0, end: 0 }; 7]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let minConnectorOverlapValue = scalarOr<UfWord>(data, ranges[0].start, UfWord.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let vertGlyphCoverageOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[1].start,
      Nullable<Offset16>.default(),
    )
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let horizGlyphCoverageOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[2].start,
      Nullable<Offset16>.default(),
    )
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let vertGlyphCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let horizGlyphCountValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(vertGlyphCountValue), 2))
    ranges[5].end = end
    ranges[6].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(horizGlyphCountValue), 2))
    ranges[6].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Minimum overlap of connecting glyphs during glyph construction, in
  /// design units.
  pub fn minConnectorOverlap(self: &Self) -> UfWord {
    return match move FontData<'a>.readAt<UfWord>(&self._fontData, self._fieldRanges[0].start) {
      Result<UfWord, ReadError>.Success { value } => value
      Result<UfWord, ReadError>.Failure { error } => UfWord.new(0)
    }
  }

  pub fn minConnectorOverlapByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to the Coverage table for shapes growing in the vertical
  /// direction, from the beginning of the MathVariants table. May be NULL.
  pub fn vertGlyphCoverageOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[1].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn vertGlyphCoverage(self: &Self) -> Option<Result<CoverageTable<'a>, ReadError>> {
    let offset = MathVariants<'a>.vertGlyphCoverageOffset(self)
    return resolveNullableWithArgs<(), CoverageTable<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn vertGlyphCoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to the Coverage table for shapes growing in the horizontal
  /// direction, from the beginning of the MathVariants table. May be NULL.
  pub fn horizGlyphCoverageOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn horizGlyphCoverage(self: &Self) -> Option<Result<CoverageTable<'a>, ReadError>> {
    let offset = MathVariants<'a>.horizGlyphCoverageOffset(self)
    return resolveNullableWithArgs<(), CoverageTable<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn horizGlyphCoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of glyphs for which information is provided for vertically
  /// growing variants. Must be the same as the number of glyph IDs referenced
  /// in the vertical Coverage table.
  pub fn vertGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn vertGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of glyphs for which information is provided for horizontally
  /// growing variants. Must be the same as the number of glyph IDs referenced
  /// in the horizontal Coverage table.
  pub fn horizGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn horizGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Array of offsets to MathGlyphConstruction tables, from the beginning of
  /// the MathVariants table, for shapes growing in the vertical direction.
  pub fn vertGlyphConstructionOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn vertGlyphConstructions(self: &Self) -> ArrayOfOffsets<
    'a,
    (),
    MathGlyphConstruction<'a>,
    Offset16
  > {
    return ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.new(
      MathVariants<'a>.vertGlyphConstructionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn vertGlyphConstructionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Array of offsets to MathGlyphConstruction tables, from the beginning of
  /// the MathVariants table, for shapes growing in the horizontal direction.
  pub fn horizGlyphConstructionOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn horizGlyphConstructions(self: &Self) -> ArrayOfOffsets<
    'a,
    (),
    MathGlyphConstruction<'a>,
    Offset16
  > {
    return ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.new(
      MathVariants<'a>.horizGlyphConstructionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn horizGlyphConstructionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }
}

impl<'a> FontRead<'a, ()> for MathVariants<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MathVariants<'a>.read(data)
  }
}

