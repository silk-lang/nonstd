    let offset = MathKernInfoRecord<'a>.bottomRightMathKernOffset(self)
    return resolveNullableWithArgs<(), MathKern<'a>, Offset16>(&offset, data, ())
  }

  /// Offset to the MathKern table for the bottom left corner, from the
