  pub fn bottomLeftMathKernOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 6),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
