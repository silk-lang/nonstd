    Result<MathItalicsCorrectionInfo<'a>, ReadError>
  > {
    let offset = MathGlyphInfo<'a>.mathItalicsCorrectionInfoOffset(self)
    return resolveNullableWithArgs<(), MathItalicsCorrectionInfo<'a>, Offset16>(
      &offset,
      self._fontData,
      (),
    )
  }

  pub fn mathItalicsCorrectionInfoOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to MathTopAccentAttachment table, from the beginning of the
