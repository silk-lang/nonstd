      20 => Option<Self>.some(MathConstant.LowerLimitGapMin)
      21 => Option<Self>.some(MathConstant.LowerLimitBaselineDropMin)
      22 => Option<Self>.some(MathConstant.StackTopShiftUp)
      23 => Option<Self>.some(MathConstant.StackTopDisplayStyleShiftUp)
      24 => Option<Self>.some(MathConstant.StackBottomShiftDown)
      25 => Option<Self>.some(MathConstant.StackBottomDisplayStyleShiftDown)
      26 => Option<Self>.some(MathConstant.StackGapMin)
      27 => Option<Self>.some(MathConstant.StackDisplayStyleGapMin)
      28 => Option<Self>.some(MathConstant.StretchStackTopShiftUp)
      29 => Option<Self>.some(MathConstant.StretchStackBottomShiftDown)
      30 => Option<Self>.some(MathConstant.StretchStackGapAboveMin)
      31 => Option<Self>.some(MathConstant.StretchStackGapBelowMin)
      32 => Option<Self>.some(MathConstant.FractionNumeratorShiftUp)
      33 => Option<Self>.some(MathConstant.FractionNumeratorDisplayStyleShiftUp)
      34 => Option<Self>.some(MathConstant.FractionDenominatorShiftDown)
      35 => Option<Self>.some(MathConstant.FractionDenominatorDisplayStyleShiftDown)
      36 => Option<Self>.some(MathConstant.FractionNumeratorGapMin)
      37 => Option<Self>.some(MathConstant.FractionNumDisplayStyleGapMin)
      38 => Option<Self>.some(MathConstant.FractionRuleThickness)
