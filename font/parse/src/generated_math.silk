    }
  }

  pub fn extendedShapeCoverage(self: &Self) -> Option<Result<CoverageTable<'a>, ReadError>> {
    let offset = MathGlyphInfo<'a>.extendedShapeCoverageOffset(self)
    return resolveNullableWithArgs<(), CoverageTable<'a>, Offset16>(&offset, self._fontData, ())
  }

  pub fn extendedShapeCoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Offset to the MathKernInfo table, from the beginning of the
  /// MathGlyphInfo table. May be NULL.
