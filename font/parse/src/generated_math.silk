pub struct MathGlyphInfo<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for MathGlyphInfo<'a> {}

impl<'a> MathGlyphInfo<'a> {
  pub fn default() -> Self {
    return MathGlyphInfo<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let mathItalicsCorrectionInfoOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[0].start,
      Nullable<Offset16>.default(),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let mathTopAccentAttachmentOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[1].start,
      Nullable<Offset16>.default(),
    )
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let extendedShapeCoverageOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[2].start,
      Nullable<Offset16>.default(),
    )
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let mathKernInfoOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[3].start,
      Nullable<Offset16>.default(),
    )
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

