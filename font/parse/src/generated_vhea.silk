}

impl<'a> MinByteRange<'a> for VheaExtended<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[16].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[16].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/vhea_impl.silk
// Copyright 2026 the Fontations Authors. Licensed under Apache-2.0 or MIT.
pub union SelectedVhea<'a> {
  Original { pub table: Vhea<'a> },
  Extended { pub table: VheaExtended<'a> },
}

impl<'a> Copy for SelectedVhea<'a> {}

impl<'a> SelectedVhea<'a> {
  pub fn numberOfLongVerMetrics(self: &Self) -> u32 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => u16.toU32(Vhea<'a>.numberOfLongVerMetrics(&table))
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.numberOfLongVerMetrics(&table)
    }
  }

  pub fn version(self: &Self) -> Version16Dot16 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.version(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.version(&table)
    }
  }

  pub fn ascender(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.ascender(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.ascender(&table)
    }
  }

  pub fn descender(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.descender(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.descender(&table)
    }
  }

  pub fn lineGap(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.lineGap(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.lineGap(&table)
    }
  }

  pub fn advanceHeightMax(self: &Self) -> UfWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.advanceHeightMax(&table)
      SelectedVhea<'a>.Extended { table } => unsignedAdvance(
        VheaExtended<'a>.advanceHeightMax(&table),
      )
    }
  }

  pub fn minTopSideBearing(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.minTopSideBearing(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.minTopSideBearing(&table)
    }
  }

  pub fn minBottomSideBearing(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.minBottomSideBearing(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.minBottomSideBearing(&table)
    }
  }

  pub fn yMaxExtent(self: &Self) -> FWord {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.yMaxExtent(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.yMaxExtent(&table)
    }
  }

  pub fn caretSlopeRise(self: &Self) -> i16 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.caretSlopeRise(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.caretSlopeRise(&table)
    }
  }

  pub fn caretSlopeRun(self: &Self) -> i16 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.caretSlopeRun(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.caretSlopeRun(&table)
    }
  }

  pub fn caretOffset(self: &Self) -> i16 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.caretOffset(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.caretOffset(&table)
    }
  }

  pub fn metricDataFormat(self: &Self) -> i16 {
    return match &self.* {
      SelectedVhea<'a>.Original { table } => Vhea<'a>.metricDataFormat(&table)
      SelectedVhea<'a>.Extended { table } => VheaExtended<'a>.metricDataFormat(&table)
    }
  }
}

fn unsignedAdvance(value: FWord) -> UfWord {
  let bytes = FWord.toBeBytes(value)
  return UfWord.new(readScalar<u16>(&bytes) |> Option<u16>.unwrapOr(0))
}
