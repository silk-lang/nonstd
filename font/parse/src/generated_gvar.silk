    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[0].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// The [GlyphVariationData](https://learn.microsoft.com/en-us/typography/opentype/spec/gvar#the-glyphvariationdata-table-array) table
pub struct GlyphVariationDataHeader<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for GlyphVariationDataHeader<'a> {}

impl<'a> GlyphVariationDataHeader<'a> {
  pub fn default() -> Self {
    return GlyphVariationDataHeader<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let tupleVariationCountValue = scalarOr<TupleVariationCount>(
      data,
      ranges[0].start,
      TupleVariationCount.new(0),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let serializedDataOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingSubtract(FontData.len(&data), end))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// A packed field. The high 4 bits are flags, and the low 12 bits
  /// are the number of tuple variation tables for this glyph. The
  /// number of tuple variation tables can be any number between 1
  /// and 4095.
  pub fn tupleVariationCount(self: &Self) -> TupleVariationCount {
    return match move FontData<'a>.readAt<TupleVariationCount>(
      &self._fontData,
      self._fieldRanges[0].start,
    ) {
      Result<TupleVariationCount, ReadError>.Success { value } => value
      Result<TupleVariationCount, ReadError>.Failure { error } => TupleVariationCount.new(0)
    }
  }

  pub fn tupleVariationCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset from the start of the GlyphVariationData table to the
  /// serialized data
  pub fn serializedDataOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn serializedData(self: &Self) -> Result<FontData<'a>, ReadError> {
    let offset = GlyphVariationDataHeader<'a>.serializedDataOffset(self)
    return resolveWithArgs<(), FontData<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn serializedDataOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of tuple variation headers.
  pub fn tupleVariationHeaders(self: &Self) -> VarLenArray<'a, TupleVariationHeader<'a>> {
    return match move varLenArray<TupleVariationHeader<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      FontData.len(&self._fontData),
    ) {
      Result<VarLenArray<'a, TupleVariationHeader<'a>>, ReadError>.Success { value } => value
      Result<VarLenArray<'a, TupleVariationHeader<'a>>, ReadError>.Failure { error } => VarLenArray<
        'a,
        TupleVariationHeader<'a>
      >.empty()
    }
  }

  pub fn tupleVariationHeadersByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for GlyphVariationDataHeader<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return GlyphVariationDataHeader<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for GlyphVariationDataHeader<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Per-glyph variation header in GVAR (ISO/IEC 14496-22:2026, 7.3.9.1.3).
pub struct GlyphVariationDataHeaderExtended<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for GlyphVariationDataHeaderExtended<'a> {}

impl<'a> GlyphVariationDataHeaderExtended<'a> {
  pub fn default() -> Self {
    return GlyphVariationDataHeaderExtended<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 5
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 5 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let tupleVariationCountValue = scalarOr<TupleVariationCount>(
      data,
      ranges[0].start,
      TupleVariationCount.new(0),
    )
    ranges[1].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[1].end = end
    let serializedDataOffsetValue = scalarOr<Offset24>(
      data,
      ranges[1].start,
      Offset24.new(Uint24.new(0)),
    )
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingSubtract(FontData.len(&data), end))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn tupleVariationCount(self: &Self) -> TupleVariationCount {
    return match move FontData<'a>.readAt<TupleVariationCount>(
      &self._fontData,
      self._fieldRanges[0].start,
    ) {
      Result<TupleVariationCount, ReadError>.Success { value } => value
      Result<TupleVariationCount, ReadError>.Failure { error } => TupleVariationCount.new(0)
    }
  }

  pub fn tupleVariationCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn serializedDataOffset(self: &Self) -> Offset24 {
    return match move FontData<'a>.readAt<Offset24>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset24, ReadError>.Success { value } => value
      Result<Offset24, ReadError>.Failure { error } => Offset24.new(Uint24.new(0))
    }
  }

  pub fn serializedData(self: &Self) -> Result<FontData<'a>, ReadError> {
    let offset = GlyphVariationDataHeaderExtended<'a>.serializedDataOffset(self)
    return resolveWithArgs<(), FontData<'a>, Offset24>(offset, self._fontData, ())
  }

  pub fn serializedDataOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  pub fn tupleVariationHeaders(self: &Self) -> VarLenArray<'a, TupleVariationHeader<'a>> {
    return match move varLenArray<TupleVariationHeader<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      FontData.len(&self._fontData),
    ) {
      Result<VarLenArray<'a, TupleVariationHeader<'a>>, ReadError>.Success { value } => value
      Result<VarLenArray<'a, TupleVariationHeader<'a>>, ReadError>.Failure { error } => VarLenArray<
        'a,
        TupleVariationHeader<'a>
      >.empty()
    }
  }

  pub fn tupleVariationHeadersByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for GlyphVariationDataHeaderExtended<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return GlyphVariationDataHeaderExtended<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for GlyphVariationDataHeaderExtended<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/gvar_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import read { readWithArgs }

pub struct U16Or32 {
  value: u32,
}

impl Copy for U16Or32 {}

impl U16Or32 {
  pub fn get(self: Self) -> u32 {
    return self.value
  }
}

impl ComputeSize<GvarFlags> for U16Or32 {
  fn computeSize(args: GvarFlags) -> Result<usize, ReadError> {
    if GvarFlags.contains(&args, GvarFlags.longOffsets()) {
      return Result<usize, ReadError>.succeed(4)
    }
    return Result<usize, ReadError>.succeed(2)
  }
}

impl<'a> FontRead<'a, GvarFlags> for U16Or32 {
  fn readWithArgs(data: FontData<'a>, args: GvarFlags) -> Result<Self, ReadError> {
    if GvarFlags.contains(&args, GvarFlags.longOffsets()) {
      return match move FontData<'a>.readAt<u32>(&data, 0) {
        Result<u32, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          Self { value: value },
        )
        Result<u32, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
      }
    }
    return match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
        Self { value: u16.toU32(value) * 2 },
      )
      Result<u16, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
    }
  }
}

impl<'a> FontReadAt<'a, GvarFlags> for U16Or32 {
  fn readAt(data: FontData<'a>, position: usize, args: GvarFlags) -> Result<Self, ReadError> {
    return match move FontData.splitOff(&data, position) {
      Option<FontData<'a>>.Some { value } => readWithArgs<GvarFlags, U16Or32>(value, args)
      _ => Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

impl<'a> Gvar<'a> {
  pub fn sharedTuplesOffset(self: &Self) -> Offset32 {
    return scalarOr<Offset32>(
      self._fontData,
      Gvar.sharedTuplesOffsetByteRange(self).start,
      Offset32.new(0),
    )
  }

  pub fn sharedTuples(self: &Self) -> Result<SharedTuples<'a>, ReadError> {
    let count = Gvar.sharedTupleCount(self)
    let offset = Gvar.sharedTuplesOffset(self)
    if count == 0 && Offset32.toU32(offset) == 0 {
      return SharedTuples.read(self._fontData, 0, Gvar.axisCount(self))
    }
    return resolveWithArgs<ReadArgs2<u16, u16>, SharedTuples<'a>, Offset32>(
      offset,
      self._fontData,
      ReadArgs2<u16, u16> { first: count, second: Gvar.axisCount(self) },
    )
  }
}

impl<'a> GvarExtended<'a> {
  pub fn sharedTuplesOffset(self: &Self) -> Offset32 {
    return scalarOr<Offset32>(
      self._fontData,
      GvarExtended.sharedTuplesOffsetByteRange(self).start,
      Offset32.new(0),
    )
  }

  pub fn sharedTuples(self: &Self) -> Result<SharedTuples<'a>, ReadError> {
    let count = GvarExtended.sharedTupleCount(self)
    let offset = GvarExtended.sharedTuplesOffset(self)
    if count == 0 && Offset32.toU32(offset) == 0 {
      return SharedTuples.read(self._fontData, 0, GvarExtended.axisCount(self))
    }
    return resolveWithArgs<ReadArgs2<u16, u16>, SharedTuples<'a>, Offset32>(
      offset,
      self._fontData,
      ReadArgs2<u16, u16> { first: count, second: GvarExtended.axisCount(self) },
    )
  }
}

import tables.variations {
  TupleDelta,
  TupleVariationData,
  PackedPointNumbers,
  scalarFor,
  notComputed,
  IntermediateTuples
}

pub type GlyphVariationData<'a> = TupleVariationData<'a, GlyphDelta>

pub struct GlyphDelta {
  pub position: u16,
  pub xDelta: i32,
  pub yDelta: i32,
}

impl Copy for GlyphDelta {}

impl Equal for GlyphDelta {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.position == right.position && left.xDelta == right.xDelta
      && left.yDelta == right.yDelta
  }
}

impl GlyphDelta {
  pub fn new(position: u16, x: i32, y: i32) -> Self {
    return Self { position: position, xDelta: x, yDelta: y }
  }
}

impl TupleDelta for GlyphDelta {
  fn isPoint() -> bool {
    return true
  }

  fn new(position: u16, x: i32, y: i32) -> Self {
    return GlyphDelta.new(position, x, y)
  }
}

pub union SelectedGvar<'a> {
  Original { pub table: Gvar<'a> },
  Extended { pub table: GvarExtended<'a> },
}

impl<'a> Copy for SelectedGvar<'a> {}

impl<'a> SelectedGvar<'a> {
  pub fn glyphCount(self: &Self) -> u32 {
    return match &self.* {
      SelectedGvar<'a>.Original { table } => u16.toU32(Gvar.glyphCount(&table))
      SelectedGvar<'a>.Extended { table } => Uint24.toU32(GvarExtended.glyphCount(&table))
    }
  }

  pub fn isExtended(self: &Self) -> bool {
    return match &self.* {
      SelectedGvar<'a>.Extended { table } => true
      _ => false
    }
  }

  pub fn sharedTuples(self: &Self) -> Result<SharedTuples<'a>, ReadError> {
    return match &self.* {
      SelectedGvar<'a>.Original { table } => Gvar.sharedTuples(&table)
      SelectedGvar<'a>.Extended { table } => GvarExtended.sharedTuples(&table)
    }
  }

  pub fn dataRangeForGid(self: &Self, gid: GlyphId) -> Result<ByteRange, ReadError> {
    let first = u32.toUsize(GlyphId.toU32(gid))
    let last = match move usize.checkedAdd(first, 1) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<ByteRange, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let offsets = SelectedGvar.glyphVariationDataOffsets(self)
    let startOffset = match move ComputedArray<'a, GvarFlags, U16Or32>.get(&offsets, first) {
      Result<U16Or32, ReadError>.Success { value } => U16Or32.get(value)
      Result<U16Or32, ReadError>.Failure { error } => {
        return Result<ByteRange, ReadError>.failResult(error)
      }
    }
    let endOffset = match move ComputedArray<'a, GvarFlags, U16Or32>.get(&offsets, last) {
      Result<U16Or32, ReadError>.Success { value } => U16Or32.get(value)
      Result<U16Or32, ReadError>.Failure { error } => {
        return Result<ByteRange, ReadError>.failResult(error)
      }
    }
    let base = SelectedGvar.glyphVariationDataArrayOffset(self)
    let start = match move u32.checkedAdd(base, startOffset) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Result<ByteRange, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move u32.checkedAdd(base, endOffset) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Result<ByteRange, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<ByteRange, ReadError>.succeed(ByteRange { start: start, end: end })
  }

  pub fn dataForGid(self: &Self, gid: GlyphId) -> Result<Option<FontData<'a>>, ReadError> {
    let range = match move SelectedGvar.dataRangeForGid(self, gid) {
      Result<ByteRange, ReadError>.Success { value } => value
      Result<ByteRange, ReadError>.Failure { error } => {
        return Result<Option<FontData<'a>>, ReadError>.failResult(error)
      }
    }

    // Rust Range::is_empty includes reversed ranges, even beyond the table.
    if range.start >= range.end {
      return Result<Option<FontData<'a>>, ReadError>.succeed(Option<FontData<'a>>.None)
    }
    return match move FontData.slice(&SelectedGvar.offsetData(self), range.start, range.end) {
      Option<FontData<'a>>.Some { value } => Result<Option<FontData<'a>>, ReadError>.succeed(
        Option<FontData<'a>>.some(value),
      )
      _ => Result<Option<FontData<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn glyphVariationDataForRange(self: &Self, range: ByteRange) -> Result<
    FontData<'a>,
    ReadError
  > {
    let base = u32.toUsize(SelectedGvar.glyphVariationDataArrayOffset(self))
    let start = match move usize.checkedAdd(base, range.start) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<FontData<'a>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move usize.checkedAdd(base, range.end) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<FontData<'a>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move FontData.slice(&SelectedGvar.offsetData(self), start, end) {
      Option<FontData<'a>>.Some { value } => Result<FontData<'a>, ReadError>.succeed(value)
      _ => Result<FontData<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn asBytes(self: &Self) -> &'a [u8] {
    return FontData.asBytes(&SelectedGvar.offsetData(self))
  }

  pub fn glyphVariationData(self: &Self, gid: GlyphId) -> Result<
    Option<GlyphVariationData<'a>>,
    ReadError
  > {
    let shared = match move SelectedGvar.sharedTuples(self) {
      Result<SharedTuples<'a>, ReadError>.Success { value } => value
      Result<SharedTuples<'a>, ReadError>.Failure { error } => {
        return Result<Option<GlyphVariationData<'a>>, ReadError>.failResult(error)
      }
    }
    let data = match move SelectedGvar.dataForGid(self, gid) {
      Result<Option<FontData<'a>>, ReadError>.Success { value } => move value
      Result<Option<FontData<'a>>, ReadError>.Failure { error } => {
        return Result<Option<GlyphVariationData<'a>>, ReadError>.failResult(error)
      }
    }
    if let Option<FontData<'a>>.Some { value } = move data {
      return match move glyphVariationDataWithFormat(
        value,
        SelectedGvar.axisCount(self),
        shared,
        SelectedGvar.isExtended(self),
      ) {
        Result<GlyphVariationData<'a>, ReadError>.Success { value: variations } => Result<
          Option<GlyphVariationData<'a>>,
          ReadError
        >.succeed(Option<GlyphVariationData<'a>>.some(variations))
        Result<GlyphVariationData<'a>, ReadError>.Failure { error } => Result<
          Option<GlyphVariationData<'a>>,
          ReadError
        >.failResult(error)
      }
    }
    return Result<Option<GlyphVariationData<'a>>, ReadError>.succeed(
      Option<GlyphVariationData<'a>>.None,
    )
  }

  pub fn computeScalars(self: &Self, coords: &[F2Dot14], out: &mut [Fixed]) -> usize {
    let shared = match move SelectedGvar.sharedTuples(self) {
      Result<SharedTuples<'a>, ReadError>.Success { value } => SharedTuples.tuples(&value)
      _ => {
        let mut i: usize = 0
        while i < out.length {
          out[i] = notComputed()
          i = i + 1
        }
        return 0
      }
    }
    let mut count = out.length
    if count > u16.toUsize(SelectedGvar.sharedTupleCount(self)) {
      count = u16.toUsize(SelectedGvar.sharedTupleCount(self))
    }
    let mut i: usize = 0
    while i < count {
      let peak = match move ComputedArray<'a, u16, Tuple<'a>>.get(&shared, i) {
        Result<Tuple<'a>, ReadError>.Success { value } => value
        _ => {
          return i
        }
      }
      out[i] = Fixed.zero()
      if Tuple.len(&peak) == u16.toUsize(SelectedGvar.axisCount(self)) {
        out[i] = scalarFor(&peak, Option<IntermediateTuples<'a>>.None, coords)
          |> Option<Fixed>.unwrapOr(Fixed.zero())
      }
      i = i + 1
    }
    while i < out.length {
      out[i] = notComputed()
      i = i + 1
    }
    return count
  }
}

pub fn glyphVariationDataWithFormat<'a>(
  data: FontData<'a>,
  axisCount: u16,
  shared: SharedTuples<'a>,
  extended: bool,
) -> Result<GlyphVariationData<'a>, ReadError> {
  let mut count = TupleVariationCount.default()
  let mut headers = FontData.new(b"")
  let mut serialized = FontData.new(b"")
  if extended {
    let header = match move GlyphVariationDataHeaderExtended.read(data) {
      Result<GlyphVariationDataHeaderExtended<'a>, ReadError>.Success { value } => value
      Result<GlyphVariationDataHeaderExtended<'a>, ReadError>.Failure { error } => {
        return Result<GlyphVariationData<'a>, ReadError>.failResult(error)
      }
    }
    count = GlyphVariationDataHeaderExtended.tupleVariationCount(&header)
    headers = FontData.splitOff(
      &data,
      GlyphVariationDataHeaderExtended.tupleVariationHeadersByteRange(&header).start,
    )
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    serialized = match move GlyphVariationDataHeaderExtended.serializedData(&header) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<GlyphVariationData<'a>, ReadError>.failResult(error)
      }
    }
  } else {
    let header = match move GlyphVariationDataHeader.read(data) {
      Result<GlyphVariationDataHeader<'a>, ReadError>.Success { value } => value
      Result<GlyphVariationDataHeader<'a>, ReadError>.Failure { error } => {
        return Result<GlyphVariationData<'a>, ReadError>.failResult(error)
      }
    }
    count = GlyphVariationDataHeader.tupleVariationCount(&header)
    headers = FontData.splitOff(
      &data,
      GlyphVariationDataHeader.tupleVariationHeadersByteRange(&header).start,
    )
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    serialized = match move GlyphVariationDataHeader.serializedData(&header) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<GlyphVariationData<'a>, ReadError>.failResult(error)
      }
    }
  }
  let mut points = Option<PackedPointNumbers<'a>>.None
  if TupleVariationCount.sharedPointNumbers(count) {
    let split = PackedPointNumbers.splitOffFront(serialized)
    points = Option<PackedPointNumbers<'a>>.some(split.points)
    serialized = split.remainder
  }
  return Result<GlyphVariationData<'a>, ReadError>.succeed(
    TupleVariationData<'a, GlyphDelta>.new(
      axisCount,
      Option<ComputedArray<'a, u16, Tuple<'a>>>.some(SharedTuples.tuples(&shared)),
      move points,
      count,
      headers,
      serialized,
    ),
  )
}

impl<'a> SelectedGvar<'a> {
  pub fn version(self: &Self) -> MajorMinor {
    return match &self.* {
      SelectedGvar<'a>.Original { table } => Gvar.version(&table)
      SelectedGvar<'a>.Extended { table } => GvarExtended.version(&table)
    }
  }

