import tables.glyf {
  Glyf,
  Glyph,
  SimpleGlyph,
  CompositeGlyph,
  CompositeGlyphFlags,
  ComponentGlyphFlags,
  ComponentGlyphIdFlagsIter,
  PointCoord,
  coordFromI32,
  coordFromFixed
}
import tables.loca { Loca, LocaGlyph }
import tables.variations {
  TupleVariation,
  TupleDeltaIter,
  ActiveTupleVariationIter,
  ActiveTupleVariation
}
import font_types.lib { Point }
import silk.core.ops { Multiply }

impl GlyphDelta {
  pub fn applyScalar<D: PointCoord + Copy + Multiply<D, D>>(self: Self, scalar: Fixed) -> Point<D> {
    let factor = coordFromFixed<D>(scalar)
    return Point<D> {
      x: coordFromI32<D>(self.xDelta) * factor,
      y: coordFromI32<D>(self.yDelta) * factor,
    }
  }
}

pub struct GlyphPointCount {
  pub glyph: GlyphId,
  pub count: usize,
}

impl Copy for GlyphPointCount {}

pub fn findGlyphAndPointCount<'a>(
  glyf: &Glyf<'a>,
  loca: &Loca<'a>,
  glyphId: GlyphId,
  recurseDepth: usize,
) -> Result<GlyphPointCount, ReadError> {
  if recurseDepth > 64 {
    return Result<GlyphPointCount, ReadError>.failResult(
      ReadError.MalformedData { message: "nesting too deep in composite glyph" },
    )
  }
  let glyph = match move Loca.get(loca, glyphId, glyf) {
    Option<LocaGlyph<'a>>.Some { value } => match value {
      LocaGlyph<'a>.Empty => {
        return Result<GlyphPointCount, ReadError>.succeed(
          GlyphPointCount { glyph: glyphId, count: 0 },
        )
      }
      LocaGlyph<'a>.Glyph { value: outline } => outline
    }
    _ => {
      return Result<GlyphPointCount, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  match glyph {
    Glyph<'a>.Simple { value } => {
      return Result<GlyphPointCount, ReadError>.succeed(
        GlyphPointCount { glyph: glyphId, count: SimpleGlyph.numPoints(&value) },
      )
    }
    Glyph<'a>.Composite { value } => {
      let mut iter = CompositeGlyph.componentGlyphsAndFlags(&value)
      let mut count: usize = 0
      let mut inherited = false
      let mut selected = glyphId
      while let Option<ComponentGlyphFlags>.Some {
        value: component
      } = move ComponentGlyphIdFlagsIter.next(&mut iter) {
        count = count + 1
        if CompositeGlyphFlags.contains(&component.flags, CompositeGlyphFlags.useMyMetrics()) {
          selected = component.glyph
          inherited = true
        }
      }
      if inherited {
        return findGlyphAndPointCount(glyf, loca, selected, recurseDepth + 1)
      }
      return Result<GlyphPointCount, ReadError>.succeed(
        GlyphPointCount { glyph: glyphId, count: count },
      )
    }
  }
}

impl<'a> SelectedGvar<'a> {
  pub fn phantomPointDeltas(
    self: &Self,
    glyf: &Glyf<'a>,
    loca: &Loca<'a>,
    coords: &[F2Dot14],
    glyphId: GlyphId,
  ) -> Option<[Point<Fixed>; 4]> {
    return SelectedGvar.phantomPointDeltasWithScalars(self, glyf, loca, coords, &[], glyphId)
  }

  pub fn phantomPointDeltasWithScalars<'b>(
    self: &Self,
    glyf: &Glyf<'a>,
    loca: &Loca<'a>,
    coords: &'b [F2Dot14],
    scalars: &'b [Fixed],
    glyphId: GlyphId,
  ) -> Option<[Point<Fixed>; 4]> {
    let source = match move findGlyphAndPointCount(glyf, loca, glyphId, 0) {
      Result<GlyphPointCount, ReadError>.Success { value } => value
      _ => {
        return Option<[Point<Fixed>; 4]>.None
      }
    }
    let maybeData = match move SelectedGvar.glyphVariationData(self, source.glyph) {
      Result<Option<GlyphVariationData<'a>>, ReadError>.Success { value } => move value
      _ => {
        return Option<[Point<Fixed>; 4]>.None
      }
    }
    let data = match move maybeData {
      Option<GlyphVariationData<'a>>.Some { value } => value
      _ => {
        return Option<[Point<Fixed>; 4]>.None
      }
    }
    let mut out = [Point<Fixed> { x: Fixed.zero(), y: Fixed.zero() }; 4]
    let mut active = TupleVariationData<'a, GlyphDelta>.activeTuplesAtWithScalars(
      &data,
      coords,
      scalars,
    )
    while let Option<ActiveTupleVariation<'a, GlyphDelta>>.Some {
      value
    } = move ActiveTupleVariationIter<'a, 'b, GlyphDelta>.next(&mut active) {
      let mut deltas = TupleVariation<'a, GlyphDelta>.deltas(&value.variation)
      while let Option<GlyphDelta>.Some { value: delta } = move TupleDeltaIter<'a, GlyphDelta>.next(
        &mut deltas,
      ) {
        let index = u16.toUsize(delta.position)
        if index >= source.count && index - source.count < 4 {
          let applied = GlyphDelta.applyScalar<Fixed>(delta, value.scalar)
          let dest = index - source.count
          out[dest].x = out[dest].x + applied.x
          out[dest].y = out[dest].y + applied.y
        }
      }
    }
    return Option<[Point<Fixed>; 4]>.some(out)
  }
}

impl<'a> Gvar<'a> {
  pub fn phantomPointDeltas(
    self: &Self,
    glyf: &Glyf<'a>,
    loca: &Loca<'a>,
    coords: &[F2Dot14],
    glyphId: GlyphId,
  ) -> Option<[Point<Fixed>; 4]> {
