// Handwritten extension from font/parse/src/tables/gvar_deltas.silk
// Copyright 2026 the Fontations Authors. Licensed under Apache-2.0 or MIT.
pub import tables.variations { DeltaBuffers }
import tables.variations { zeroDeltas, checkSimpleBuffers }
import tables.glyf { PointFlags, PointFrom }
import silk.core.ops { Add, Divide }

impl<'a> SelectedGvar<'a> {
  pub fn simpleDeltas<
    C: PointCoord + Copy,
    D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
      D,
      D
    > + Equal
  >(
    self: &Self,
    gid: GlyphId,
    coords: &[F2Dot14],
    points: &[Point<C>],
    flags: &mut [PointFlags],
    contours: &[u16],
    buffers: &mut DeltaBuffers<D>,
  ) -> Option<bool> {
    return SelectedGvar<'a>.simpleDeltasWithScalars<C, D>(
      self,
      gid,
      coords,
      &[],
      points,
      move flags,
      contours,
      move buffers,
    )
  }

  pub fn simpleDeltasWithScalars<
    C: PointCoord + Copy,
    D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
      D,
      D
    > + Equal
  >(
    self: &Self,
    gid: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
    points: &[Point<C>],
    flags: &mut [PointFlags],
    contours: &[u16],
    buffers: &mut DeltaBuffers<D>,
  ) -> Option<bool> {
    if !checkSimpleBuffers<C, D>(points, &flags, &buffers) {
      return Option<bool>.None
    }
    let maybeData = match move SelectedGvar.glyphVariationData(self, gid) {
      Result<Option<GlyphVariationData<'a>>, ReadError>.Success { value } => move value
      _ => Option<GlyphVariationData<'a>>.None
    }
    let data = match move maybeData {
      Option<GlyphVariationData<'a>>.Some { value } => value
      _ => {
        zeroDeltas<D>(&mut buffers.deltas)
        return Option<bool>.some(false)
      }
    }
    if let Option<()>.None = move TupleVariationData<'a, GlyphDelta>.simpleDeltasWithScalars<C, D>(
      &data,
      coords,
      scalars,
      points,
      move flags,
      contours,
      move buffers,
    ) {
      return Option<bool>.None
    }
    return Option<bool>.some(true)
  }

  pub fn compositeDeltas<D: PointCoord + Copy + Add<D, D> + Multiply<D, D>>(
    self: &Self,
    gid: GlyphId,
    coords: &[F2Dot14],
    deltas: &mut [Point<D>],
  ) -> Option<bool> {
    return SelectedGvar<'a>.compositeDeltasWithScalars<D>(self, gid, coords, &[], move deltas)
  }

  pub fn compositeDeltasWithScalars<D: PointCoord + Copy + Add<D, D> + Multiply<D, D>>(
    self: &Self,
    gid: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
    deltas: &mut [Point<D>],
  ) -> Option<bool> {
    let maybeData = match move SelectedGvar.glyphVariationData(self, gid) {
      Result<Option<GlyphVariationData<'a>>, ReadError>.Success { value } => move value
      _ => Option<GlyphVariationData<'a>>.None
    }
    let data = match move maybeData {
      Option<GlyphVariationData<'a>>.Some { value } => value
      _ => {
        zeroDeltas<D>(&mut deltas)
        return Option<bool>.some(false)
      }
    }
    if let Option<()>.None = move TupleVariationData<'a, GlyphDelta>.compositeDeltasWithScalars<D>(
      &data,
      coords,
      scalars,
      move deltas,
    ) {
      return Option<bool>.None
    }
    return Option<bool>.some(true)
  }
}

