import ps.cff.stack { Stack, FixedValues }
import ps.cff.blend { BlendState, Scalars }
import tables.variations { ItemVariationStore }
import generated_cff_fixtures { exampleCff2 }
import font_data { FontData }
import font_types.lib { Fixed, F2Dot14 }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.slice { Slice }

effect fn must<T, E>(result: Result<T, E>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, E>.Success { value } => move value
    _ => {
      run Testing.expect(false, "stack fixture succeeds")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "iterator has value")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn failed<T, E>(result: Result<T, E>) -> bool {
  return match move result {
    Result<T, E>.Failure { error } => true
    _ => false
  }
}

fn absent<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

effect fn ivs() -> ItemVariationStore<'static>
  ! AssertionError<'static> {
  let bytes = exampleCff2()
  return run must(
    ItemVariationStore.read(FontData.new(Slice.view<u8>(bytes, 18, bytes.length - 18))),
  )
}

effect fn checkValues(stack: &Stack, values: &[Fixed]) -> ()
  ! AssertionError<'static> {
  let mut iter = Stack.fixedValues(stack)
  let mut i: usize = 0
  while i < values.length {
    run Testing.expect(
      Fixed.toBits(run some(FixedValues.next(&mut iter))) == Fixed.toBits(values[i]),
      "fixed stack contents",
    )
    i = i + 1
  }
  run Testing.expect(absent(FixedValues.next(&mut iter)), "stack iterator length")
}

test effect fn pushPop() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, 20))
  run must(Stack.push(&mut stack, Fixed.fromF64(42.42)))
  run Testing.expect(!Stack.lenIsOdd(&stack) && Stack.len(&stack) == 2, "stack length")
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == Fixed.toBits(Fixed.fromF64(42.42)),
    "fixed pop",
  )
  run Testing.expect((run must(Stack.popI32(&mut stack))) == 20, "integer pop")
}

test effect fn pushFixedPopI32() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, Fixed.fromF64(42.42)))
  run Testing.expect(failed(Stack.popI32(&mut stack)), "integer access rejects fixed")
}

test effect fn pushI32PopFixed() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, 123))
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == Fixed.toBits(Fixed.fromF64(123.0)),
    "integer coerces to fixed",
  )
}

test effect fn deltaPrefixSum() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, Fixed.fromF64(1.5)))
  run must(Stack.push(&mut stack, 42))
  run must(Stack.push(&mut stack, Fixed.fromF64(4.2)))
  Stack.applyDeltaPrefixSum(&mut stack)
  run Testing.expect(Stack.lenIsOdd(&stack), "odd stack length")
  run checkValues(
    &stack,
    &[Fixed.fromF64(1.5), Fixed.fromF64(43.5), Fixed.fromF64(47.69999694824219)],
  )
}

test effect fn blend() -> ()
  ! AssertionError<'static> {
  let coords = [F2Dot14.fromF64(-0.75)]
  let state = run must(BlendState.new(run ivs(), &coords, 0))
  let mut stack = Stack.new()
  let values: [i32; 7] = [10, 20, 4, -8, -60, 2, 2]
  let mut i: usize = 0
  while i < 7 {
    run must(Stack.push(&mut stack, values[i]))
    i = i + 1
  }
  run must(Stack.applyBlend(&mut stack, &state))
  run checkValues(&stack, &[Fixed.fromF64(8.0), Fixed.fromF64(-9.0)])
}

test effect fn invalidAccessYieldsZero() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run Testing.expect((run must(Stack.popI32(&mut stack))) == 0, "empty integer pop")
  run Testing.expect(Fixed.toBits(run must(Stack.popFixed(&mut stack))) == 0, "empty fixed pop")
  run Testing.expect(
    (run must(Stack.getI32(&stack, 10))) == 0
      && Fixed.toBits(run must(Stack.getFixed(&stack, 10))) == 0,
    "unused slots are zero",
  )
  run must(Stack.push(&mut stack, 5))
  let mut values = [Fixed.one(); 3]
  run must(Stack.fixedArray(&stack, 0, &mut values))
  run Testing.expect(
    Fixed.toBits(values[0]) == 327680 && Fixed.toBits(values[1]) == 0
      && Fixed.toBits(values[2]) == 0,
    "fixed array pads with zero",
  )
}

test effect fn exch() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, 4))
  run must(Stack.push(&mut stack, Fixed.fromF64(2.5)))
  run must(Stack.exch(&mut stack))
  run Testing.expect(
    (run must(Stack.popI32(&mut stack))) == 4
      && Fixed.toBits(run must(Stack.popFixed(&mut stack))) == 163840,
    "exchanged operand types",
  )
  Stack.clear(&mut stack)
  run must(Stack.push(&mut stack, 1))
  run Testing.expect(failed(Stack.exch(&mut stack)), "exchange needs two elements")
}

test effect fn division() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, 200))
  run must(Stack.push(&mut stack, 50))
  run must(Stack.div(&mut stack, false))
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == 262144,
    "integer division",
  )
  run must(Stack.push(&mut stack, Fixed.fromF64(151.0)))
  run must(Stack.push(&mut stack, 2))
  run must(Stack.div(&mut stack, false))
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == 4947968,
    "fixed division",
  )
  run must(Stack.push(&mut stack, 40000))
  run must(Stack.push(&mut stack, 20))
  run must(Stack.div(&mut stack, true))
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == 131072000,
    "large positive division",
  )
  run must(Stack.push(&mut stack, -40000))
  run must(Stack.push(&mut stack, 20))
  run must(Stack.div(&mut stack, true))
  run Testing.expect(
    Fixed.toBits(run must(Stack.popFixed(&mut stack))) == -131072000,
    "large negative division",
  )
}

test effect fn set() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  run must(Stack.push(&mut stack, 0))
  run must(Stack.push(&mut stack, 0))
  run must(Stack.push(&mut stack, 0))
  run must(Stack.set(&mut stack, 0, Fixed.fromF64(-4.2)))
  run must(Stack.set(&mut stack, 2, 25))
  let mut values = [Fixed.zero(); 3]
  run must(Stack.fixedArray(&stack, 0, &mut values))
  run Testing.expect(
    Fixed.toBits(values[0]) == Fixed.toBits(Fixed.fromF64(-4.2)) && Fixed.toBits(values[1]) == 0
      && Fixed.toBits(values[2]) == 1638400,
    "replace stack values",
  )
}

test effect fn dropValues() -> ()
  ! AssertionError<'static> {
  let mut stack = Stack.new()
  let mut i: usize = 0
  while i < 20 {
    run must(Stack.push(&mut stack, 0))
    i = i + 1
  }
  run Testing.expect(Stack.len(&stack) == 20, "stack before drop")
  Stack.dropValues(&mut stack, 4)
  run Testing.expect(Stack.len(&stack) == 16, "first drop")
  Stack.dropValues(&mut stack, 10)
  run Testing.expect(Stack.len(&stack) == 6, "second drop")
  Stack.dropValues(&mut stack, 7)
  run Testing.expect(Stack.len(&stack) == 0, "excess drop clears")
}

test effect fn exampleBlends() -> ()
  ! AssertionError<'static> {
  let coords: [f64; 7] = [-1.0, -0.25, -0.5, -0.75, 0.0, 0.5, 1.0]
  let a: [f64; 7] = [0.0, 0.5, 1.0, 0.5, 0.0, 0.0, 0.0]
  let b: [f64; 7] = [1.0, 0.0, 0.0, 0.5, 0.0, 0.0, 0.0]
  let mut i: usize = 0
  while i < 7 {
    let position = [F2Dot14.fromF64(coords[i])]
    let state = run must(BlendState.new(run ivs(), &position, 0))
    let mut scalars = run must(BlendState.scalars(&state))
    run Testing.expect(
      Fixed.toBits(run must(run some(Scalars.next(&mut scalars))))
        == Fixed.toBits(Fixed.fromF64(a[i])),
      "first region scalar",
    )
    run Testing.expect(
      Fixed.toBits(run must(run some(Scalars.next(&mut scalars))))
        == Fixed.toBits(Fixed.fromF64(b[i])),
      "second region scalar",
    )
    run Testing.expect(absent(Scalars.next(&mut scalars)), "region iterator ends")
    i = i + 1
  }
}
