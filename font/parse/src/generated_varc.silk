test effect fn parseComponentAxesWithVarIndexAndZeroAxisCount() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 8948] = [0; 8948]
  run vzeroAxes(&mut bytes)
  let table = run vtable(&bytes)
  let mut cursor = FontData.cursor(&FontData.new(b"\x16\x00\x01\x00\x81\x23\x00\x06\xaa"))
  let item = run vparse(&table, &mut cursor)
  run Testing.expect(
    (run vsome(VarcComponent.axisIndicesIndex(&item))) == 0
      && vnone(VarcComponent.axisValues(&item))
      && (run vsome(VarcComponent.axisValuesVarIndex(&item))) == 291,
    "empty axes with variation",
  )
  run Testing.expect(
    DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 6.0,
    "translate",
  )
  run vsentinel(&mut cursor)
}

effect fn vbadFetch(data: &'static [u8]) -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(data))
  let item = run vparse(&run vcond(), &mut cursor)
  let deltas = run vsome(VarcComponent.axisValues(&item))
  let mut fetcher = PackedDeltas.fetcher(&deltas)
  let mut out: [f32; 5] = [0.0; 5]
  run Testing.expect(
    voob(PackedDeltaFetcher.addToF32Scaled(&mut fetcher, &mut out, 1.0)),
    "truncated payload fails on fetch",
  )
}

