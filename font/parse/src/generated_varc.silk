test effect fn parseComponentReservedFieldsAreConsumed() -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(b"\xc1\x80\x10\x00\x01\x00\x07\x01\x02\xaa"))
  let item = run vparse(&run vcjk(), &mut cursor)
  run Testing.expect(
    DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 7.0,
    "translate",
  )
  run vsentinel(&mut cursor)
}

