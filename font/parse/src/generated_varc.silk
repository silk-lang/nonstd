test effect fn parseComponentWithAxesZeroCountDoesNotConsumeAxisValues() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 8948] = [0; 8948]
  run vzeroAxes(&mut bytes)
  let table = run vtable(&bytes)
  run Testing.expect(
    PackedDeltas.countOrCompute(&run vmust(Varc.axisIndices(&table, 0))) == 0,
    "empty axes",
  )
  let mut cursor = FontData.cursor(&FontData.new(b"\x12\x00\x01\x00\x00\x05\xaa"))
  let item = run vparse(&table, &mut cursor)
  run Testing.expect(
    DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 5.0,
    "translate after empty axes",
  )
  run vsentinel(&mut cursor)
}

test effect fn parseComponentWithAxesNonzeroCountConsumesAxisValues() -> ()
  ! AssertionError<'static> {
  let table = run vcond()
  run Testing.expect(
    PackedDeltas.countOrCompute(&run vmust(Varc.axisIndices(&table, 1))) == 5,
    "five axes",
  )
  let mut cursor = FontData.cursor(
    &FontData.new(b"\x12\x00\x01\x01\x04\x01\x02\x03\x04\x05\x00\x09\xaa"),
  )
  let item = run vparse(&table, &mut cursor)
  run Testing.expect(
    DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 9.0,
    "translate after axes",
  )
  run vsentinel(&mut cursor)
}

test effect fn parseComponentScaleXOnlyAppliesToScaleY() -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(b"\x81\x00\x00\x01\x08\x00\xaa"))
  let item = run vparse(&run vcjk(), &mut cursor)
  let t = VarcComponent.transform(&item)
  run Testing.expect(
    DecomposedTransform.scaleX(&t) == 2.0 && DecomposedTransform.scaleY(&t) == 2.0,
    "uniform scale",
  )
  run vsentinel(&mut cursor)
}

test effect fn parseComponentScaleXAndScaleYAreIndependent() -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(b"\x83\x00\x00\x01\x08\x00\x0c\x00\xaa"))
  let item = run vparse(&run vcjk(), &mut cursor)
  let t = VarcComponent.transform(&item)
  run Testing.expect(
    DecomposedTransform.scaleX(&t) == 2.0 && DecomposedTransform.scaleY(&t) == 3.0,
    "independent scales",
  )
  run vsentinel(&mut cursor)
}

test effect fn parseComponentMultibyteConditionAndVarIndices() -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(
    &FontData.new(b"\x80\x9c\x00\x01\xa3\x45\x81\x23\x82\x22\x00\x07\xaa"),
  )
  let item = run vparse(&run vcjk(), &mut cursor)
  run Testing.expect(
    (run vsome(VarcComponent.conditionIndex(&item))) == 9029
      && (run vsome(VarcComponent.axisValuesVarIndex(&item))) == 291
      && (run vsome(VarcComponent.transformVarIndex(&item))) == 546,
    "multibyte indices",
  )
  run Testing.expect(
    DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 7.0,
    "translate",
  )
  run vsentinel(&mut cursor)
}

