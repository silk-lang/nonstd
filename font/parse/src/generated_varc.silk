test effect fn computeSparseRegionScalarHandlesBoundariesAndProducts() -> ()
  ! AssertionError<'static> {
  let table = run vcjk()
  let store = run vmust(run vsome(Varc.multiVarStore(&table)))
  let regions = SparseVariationRegionList.regions(
    &run vmust(MultiItemVariationStore.regionList(&store)),
  )
  let region = run vmust(
    ArrayOfOffsets<'static, (), SparseVariationRegion<'static>, Offset32>.get(&regions, 0),
  )
  let coords: [f32; 4] = [1.0, 0.5, 0.0, -0.25]
  let expected: [f32; 4] = [1.0, 0.5, 0.0, 0.0]
  let mut i: usize = 0
  while i < 4 {
    run Testing.expect(
      SparseVariationRegion.computeScalarF32(&region, &[F2Dot14.fromF32(coords[i])]) == expected[i],
      "scalar boundaries",
    )
    i = i + 1
  }
  run Testing.expect(SparseVariationRegion.computeScalarF32(&region, &[]) == 0.0, "missing coord")
  let region2 = run vmust(
    ArrayOfOffsets<'static, (), SparseVariationRegion<'static>, Offset32>.get(&regions, 2),
  )
  run Testing.expect(
    SparseVariationRegion.computeScalarF32(&region2, &[F2Dot14.fromF32(0.5), F2Dot14.fromF32(0.25)])
      == 0.125,
    "product",
  )
}

effect fn vbadOffset(axis: bool) -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 8948] = [0; 8948]
  vcopy(&mut bytes, VarcFixtures.varcCjkFont())
  let data = Varc.offsetData(&run vtable(&bytes))
  let length = FontData.len(&data)
  let base = run vtableOffset(&bytes)
  let mut at: usize = 20
  if axis {
    at = 16
  }
  VarcBuilder.put32(&mut bytes, base + at, usize.toU32(length + 8))
  let table = run vtable(&bytes)
  if axis {
    run Testing.expect(voob(Varc.axisIndices(&table, 0)), "axis offset bounds")
  } else {
    run Testing.expect(voob(Varc.glyph(&table, 0)), "glyph offset bounds")
  }
}

test effect fn axisIndicesOffsetOutOfBoundsErrors() -> ()
