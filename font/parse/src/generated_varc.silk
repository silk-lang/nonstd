effect fn vbadComponent<'t, 'a>(table: &Varc<'t>, data: &'a [u8]) -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(data))
  run Testing.expect(
    voob(run Effect.result(VarcComponent.parse(table, &mut cursor))),
    "component bounds error",
  )
}

