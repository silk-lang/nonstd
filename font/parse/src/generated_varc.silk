    return self._fieldRanges[0]
  }

  pub fn start(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, self._fieldRanges[1].start) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  pub fn startByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  pub fn peak(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, self._fieldRanges[2].start) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  pub fn peakByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  pub fn end(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, self._fieldRanges[3].start) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  pub fn endByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for SparseRegionAxisCoordinates<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SparseRegionAxisCoordinates<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for SparseRegionAxisCoordinates<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub struct MultiItemVariationData<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for MultiItemVariationData<'a> {}

impl<'a> MultiItemVariationData<'a> {
  pub fn default() -> Self {
    return MultiItemVariationData<'a>.read(FontData.defaultFormat1U8TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 7
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 7 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[0].end = end
    let formatValue = scalarOr<u8>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let regionIndexCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(regionIndexCountValue), 2))
    ranges[2].end = end
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let deltaSetsOffsetValue = scalarOr<Offset32>(data, ranges[3].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn format(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[0].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn regionIndexCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn regionIndexCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  pub fn regionIndices(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn regionIndicesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  pub fn deltaSetsOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[3].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn deltaSets(self: &Self) -> Result<Index2<'a>, ReadError> {
    let offset = MultiItemVariationData<'a>.deltaSetsOffset(self)
    return resolveWithArgs<(), Index2<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn deltaSetsOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for MultiItemVariationData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MultiItemVariationData<'a>.read(data)
  }
}

impl<'a> Format<u8> for MultiItemVariationData<'a> {
  fn formatValue() -> u8 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for MultiItemVariationData<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub struct ConditionList<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for ConditionList<'a> {}

impl<'a> ConditionList<'a> {
  pub fn default() -> Self {
    return ConditionList<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let conditionCountValue = scalarOr<u32>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u32.toUsize(conditionCountValue), 4))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  pub fn conditionCount(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[0].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn conditionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  pub fn conditionOffsets(self: &Self) -> ScalarArray<'a, Offset32> {
    return match move FontData<'a>.readArray<Offset32>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, Offset32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset32>, ReadError>.Failure { error } => ScalarArray<
        Offset32
      >.empty()
    }
  }

  pub fn conditions(self: &Self) -> ArrayOfOffsets<'a, (), Condition<'a>, Offset32> {
    return ArrayOfOffsets<'a, (), Condition<'a>, Offset32>.new(
      ConditionList<'a>.conditionOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn conditionOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for ConditionList<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ConditionList<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ConditionList<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Flags used in the [VarcComponent] byte stream
/// 
/// <https://github.com/harfbuzz/boring-expansion-spec/blob/main/VARC.md#variable-component-flags>
pub struct VarcFlags {
  raw: u32,
}

impl Copy for VarcFlags {}

impl VarcFlags {
  pub fn bits(self: &Self) -> u32 {
    return self.raw
  }

  pub fn empty() -> VarcFlags {
    return VarcFlags { raw: 0 }
  }

  pub fn all() -> VarcFlags {
    return VarcFlags { raw: 4294967295 }
  }

  pub fn fromBitsTruncate(bits: u32) -> VarcFlags {
    return VarcFlags { raw: bits & 4294967295 }
  }

  pub fn fromBits(bits: u32) -> Option<VarcFlags> {
    if (bits & 4294967295) != bits {
      return Option<VarcFlags>.None
    }
    return Option<VarcFlags>.some(VarcFlags { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: VarcFlags) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: VarcFlags) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: VarcFlags) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: VarcFlags) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: VarcFlags) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  pub fn resetUnspecifiedAxes() -> VarcFlags {
    return VarcFlags { raw: 1 }
  }

  pub fn haveAxes() -> VarcFlags {
    return VarcFlags { raw: 2 }
  }

  pub fn axisValuesHaveVariation() -> VarcFlags {
    return VarcFlags { raw: 4 }
  }

  pub fn transformHasVariation() -> VarcFlags {
    return VarcFlags { raw: 8 }
  }

  pub fn haveTranslateX() -> VarcFlags {
    return VarcFlags { raw: 16 }
  }

  pub fn haveTranslateY() -> VarcFlags {
    return VarcFlags { raw: 32 }
  }

  pub fn haveRotation() -> VarcFlags {
    return VarcFlags { raw: 64 }
  }

  pub fn haveCondition() -> VarcFlags {
    return VarcFlags { raw: 128 }
  }

  pub fn haveScaleX() -> VarcFlags {
    return VarcFlags { raw: 256 }
  }

  pub fn haveScaleY() -> VarcFlags {
    return VarcFlags { raw: 512 }
  }

  pub fn haveTcenterX() -> VarcFlags {
    return VarcFlags { raw: 1024 }
  }

  pub fn haveTcenterY() -> VarcFlags {
    return VarcFlags { raw: 2048 }
  }

  pub fn gidIs24bit() -> VarcFlags {
    return VarcFlags { raw: 4096 }
  }

  pub fn haveSkewX() -> VarcFlags {
    return VarcFlags { raw: 8192 }
  }

  pub fn haveSkewY() -> VarcFlags {
    return VarcFlags { raw: 16384 }
  }

  pub fn reservedMask() -> VarcFlags {
    return VarcFlags { raw: 4294934528 }
  }
}

impl Equal for VarcFlags {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl VarcFlags {
  pub fn default() -> Self {
    return VarcFlags.empty()
  }
}

impl Order for VarcFlags {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for VarcFlags {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if VarcFlags.contains(self, VarcFlags.resetUnspecifiedAxes()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("RESET_UNSPECIFIED_AXES")
    }
    if VarcFlags.contains(self, VarcFlags.haveAxes()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_AXES")
    }
    if VarcFlags.contains(self, VarcFlags.axisValuesHaveVariation()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("AXIS_VALUES_HAVE_VARIATION")
    }
    if VarcFlags.contains(self, VarcFlags.transformHasVariation()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("TRANSFORM_HAS_VARIATION")
    }
    if VarcFlags.contains(self, VarcFlags.haveTranslateX()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_TRANSLATE_X")
    }
    if VarcFlags.contains(self, VarcFlags.haveTranslateY()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_TRANSLATE_Y")
    }
    if VarcFlags.contains(self, VarcFlags.haveRotation()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_ROTATION")
    }
    if VarcFlags.contains(self, VarcFlags.haveCondition()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_CONDITION")
    }
    if VarcFlags.contains(self, VarcFlags.haveScaleX()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_SCALE_X")
    }
    if VarcFlags.contains(self, VarcFlags.haveScaleY()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_SCALE_Y")
    }
    if VarcFlags.contains(self, VarcFlags.haveTcenterX()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_TCENTER_X")
    }
    if VarcFlags.contains(self, VarcFlags.haveTcenterY()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_TCENTER_Y")
    }
    if VarcFlags.contains(self, VarcFlags.gidIs24bit()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("GID_IS_24BIT")
    }
    if VarcFlags.contains(self, VarcFlags.haveSkewX()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_SKEW_X")
    }
    if VarcFlags.contains(self, VarcFlags.haveSkewY()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("HAVE_SKEW_Y")
    }
    if VarcFlags.contains(self, VarcFlags.reservedMask()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("RESERVED_MASK")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<VarcFlags, VarcFlags> for VarcFlags {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<VarcFlags, VarcFlags> for VarcFlags {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<VarcFlags, VarcFlags> for VarcFlags {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<VarcFlags, VarcFlags> for VarcFlags {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<VarcFlags> for VarcFlags {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 4294967295 }
  }
}

impl Scalar for VarcFlags {
  fn rawByteLen() -> usize {
    return 4
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u32>(bytes) {
      Option<u32>.Some { value } => Option<Self>.some(VarcFlags.fromBitsTruncate(value))
      Option<u32>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u32>(value.raw, move bytes)
  }
}

impl FixedSize for VarcFlags {
  fn rawByteLen() -> usize {
    return 4
  }
}

// Handwritten extension from font/parse/src/tables/varc_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import silk.core.effect { Effect }

// Snapshot views retain font bytes without borrowing a temporary table facade.
effect fn varcTake<T>(result: Result<T, ReadError>) -> T
  ! ReadError {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      fail error
    }
  }
}

fn varcCopy<T: Copy>(option: &Option<T>) -> Option<T> {
  return match &option.* {
    Option<T>.Some { value } => Option<T>.some(value)
    _ => Option<T>.None
  }
}

effect fn varcIndex<'a>(result: Option<Result<Index2<'a>, ReadError>>, nth: usize) -> &'a [u8]
  ! ReadError {
  let index = match move result {
    Option<Result<Index2<'a>, ReadError>>.Some { value } => run varcTake(move value)
    _ => {
      fail ReadError.NullOffset
    }
  }
  return match move Index2.get(&index, nth) {
    Option<&'a [u8]>.Some { value } => value
    _ => {
      fail ReadError.OutOfBounds
    }
  }
}

impl<'a> Varc<'a> {
  pub fn axisIndices(self: &Self, nth: usize) -> Result<PackedDeltas<'a>, ReadError> {
    return run Effect.result(Varc.readAxes(self, nth))
  }

  effect fn readAxes(self: &Self, nth: usize) -> PackedDeltas<'a>
    ! ReadError {
    return PackedDeltas.consumeAll(FontData.new(run varcIndex(Varc.axisIndicesList(self), nth)))
  }

  pub fn glyph(self: &Self, nth: usize) -> Result<VarcGlyph<'a>, ReadError> {
    return run Effect.result(Varc.readGlyph(self, nth))
  }

  effect fn readGlyph(self: &Self, nth: usize) -> VarcGlyph<'a>
    ! ReadError {
    return VarcGlyph<'a> {
      table: self.*,
      data: FontData.new(
        run varcIndex(
          Option<Result<Index2<'a>, ReadError>>.some(Varc.varCompositeGlyphs(self)),
          nth,
        ),
      ),
    }
  }
}

impl<'a> SparseVariationRegion<'a> {
  pub fn computeScalarF32(self: &Self, coords: &[F2Dot14]) -> f32 {
    let axes = SparseVariationRegion.axisCoordinates(self)
    let mut scalar: f32 = 1.0
    let mut i: usize = 0
    while i < ArrayOfOffsets<'a, (), SparseRegionAxisCoordinates<'a>, Offset32>.len(&axes) {
      let axis = match move ArrayOfOffsets<'a, (), SparseRegionAxisCoordinates<'a>, Offset32>.get(
        &axes,
        i,
      ) {
        Result<SparseRegionAxisCoordinates<'a>, ReadError>.Success { value } => value
        _ => {
          return 0.0
        }
      }
      i = i + 1
      let peak = i16.toI32(F2Dot14.toBits(SparseRegionAxisCoordinates.peak(&axis)))
      if peak == 0 {
        continue
      }
      let index = u16.toUsize(SparseRegionAxisCoordinates.axisIndex(&axis))
      let mut coord: i32 = 0
      if index < coords.length {
        coord = i16.toI32(F2Dot14.toBits(coords[index]))
      }
      if coord == peak {
        continue
      }
      if coord == 0 {
        return 0.0
      }
      let start = i16.toI32(F2Dot14.toBits(SparseRegionAxisCoordinates.start(&axis)))
      let end = i16.toI32(F2Dot14.toBits(SparseRegionAxisCoordinates.end(&axis)))
      if start > peak || peak > end || (start < 0 && end > 0) {
        continue
      }
      if coord < start || coord > end {
        return 0.0
      }
      if coord < peak {
        let num = coord - start
        if num == 0 {
          return 0.0
        }
        scalar = scalar * (i32.toF32(num) / i32.toF32(peak - start))
      } else {
        let num = end - coord
        if num == 0 {
          return 0.0
        }
        scalar = scalar * (i32.toF32(num) / i32.toF32(end - peak))
      }
    }
    return scalar
  }
}

pub struct VarcGlyph<'a> {
  table: Varc<'a>,
  data: FontData<'a>,
}

impl<'a> Copy for VarcGlyph<'a> {}

impl<'a> VarcGlyph<'a> {
  pub fn components(self: &Self) -> VarcComponentIter<'a> {
    return VarcComponentIter<'a> { table: self.table, cursor: FontData.cursor(&self.data) }
  }
}

pub struct VarcComponentIter<'a> {
  table: Varc<'a>,
  cursor: Cursor<'a>,
}

impl<'a> Copy for VarcComponentIter<'a> {}

impl<'a> VarcComponentIter<'a> {
  pub fn next(self: &mut Self) -> Option<Result<VarcComponent<'a>, ReadError>> {
    if Cursor.isEmpty(&self.cursor) {
      return Option<Result<VarcComponent<'a>, ReadError>>.None
    }
    return Option<Result<VarcComponent<'a>, ReadError>>.some(
      run Effect.result(VarcComponent.parse(&self.table, &mut self.cursor)),
    )
  }
}

pub struct VarcComponent<'a> {
  _flags: VarcFlags,
  _gid: GlyphId,
  _conditionIndex: Option<u32>,
  _axisIndicesIndex: Option<u32>,
  _axisValues: Option<PackedDeltas<'a>>,
  _axisValuesVarIndex: Option<u32>,
  _transformVarIndex: Option<u32>,
  _transform: DecomposedTransform,
}

impl<'a> VarcComponent<'a> {
  effect fn parse<'t>(table: &Varc<'t>, cursor: &mut Cursor<'a>) -> Self
    ! ReadError {
    let raw = run varcTake(Cursor.readU32Var(&mut cursor))
    let flags = VarcFlags.fromBitsTruncate(raw)
    let mut gid = GlyphId.new(0)
    if (raw & 4096) != 0 {
      gid = GlyphId.new(Uint24.toU32(run varcTake(Cursor<'a>.read<Uint24>(&mut cursor))))
    } else {
      gid = GlyphId.new(u16.toU32(run varcTake(Cursor<'a>.read<u16>(&mut cursor))))
    }
    let mut conditionIndex = Option<u32>.None
    if (raw & 128) != 0 {
      conditionIndex = Option<u32>.some(run varcTake(Cursor.readU32Var(&mut cursor)))
    }
    let mut axisIndex = Option<u32>.None
    let mut axisValues = Option<PackedDeltas<'a>>.None
    if (raw & 2) != 0 {
      let index = run varcTake(Cursor.readU32Var(&mut cursor))
      axisIndex = Option<u32>.some(index)
      let count = PackedDeltas.countOrCompute(
        &run varcTake(Varc.axisIndices(table, u32.toUsize(index))),
      )
      if count > 0 {
        let data = match move Cursor.remaining(&cursor) {
          Option<FontData<'a>>.Some { value } => value
          _ => {
            fail ReadError.OutOfBounds
          }
        }
        let deltas = PackedDeltas.new(data, count)
        cursor.* = DeltaRunIter.end(PackedDeltas.iter(&deltas))
        axisValues = Option<PackedDeltas<'a>>.some(deltas)
      }
    }
    let mut axisVarIndex = Option<u32>.None
    if (raw & 4) != 0 {
      axisVarIndex = Option<u32>.some(run varcTake(Cursor.readU32Var(&mut cursor)))
    }
    let mut transformVarIndex = Option<u32>.None
    if (raw & 8) != 0 {
      transformVarIndex = Option<u32>.some(run varcTake(Cursor.readU32Var(&mut cursor)))
    }
    let mut transform = DecomposedTransform.default()
    if (raw & 16) != 0 {
      transform._translateX = i16.toF32(run varcTake(Cursor<'a>.read<i16>(&mut cursor)))
    }
    if (raw & 32) != 0 {
      transform._translateY = i16.toF32(run varcTake(Cursor<'a>.read<i16>(&mut cursor)))
    }
    if (raw & 64) != 0 {
      transform._rotation = F4Dot12.toF32(run varcTake(Cursor<'a>.read<F4Dot12>(&mut cursor)))
    }
    if (raw & 768) != 0 {
      if (raw & 256) != 0 {
        transform._scaleX = F6Dot10.toF32(run varcTake(Cursor<'a>.read<F6Dot10>(&mut cursor)))
      }
      transform._scaleY = transform._scaleX
      if (raw & 512) != 0 {
        transform._scaleY = F6Dot10.toF32(run varcTake(Cursor<'a>.read<F6Dot10>(&mut cursor)))
      }
    }
    if (raw & 8192) != 0 {
      transform._skewX = F4Dot12.toF32(run varcTake(Cursor<'a>.read<F4Dot12>(&mut cursor)))
    }
    if (raw & 16384) != 0 {
      transform._skewY = F4Dot12.toF32(run varcTake(Cursor<'a>.read<F4Dot12>(&mut cursor)))
    }
    if (raw & 1024) != 0 {
      transform._centerX = i16.toF32(run varcTake(Cursor<'a>.read<i16>(&mut cursor)))
    }
    if (raw & 2048) != 0 {
      transform._centerY = i16.toF32(run varcTake(Cursor<'a>.read<i16>(&mut cursor)))
    }
    let mut reserved = u32.shiftRight(raw & 4294934528, 15)
    while reserved != 0 {
      if (reserved & 1) != 0 {
        let ignored = run varcTake(Cursor.readU32Var(&mut cursor))
      }
      reserved = u32.shiftRight(reserved, 1)
    }
    return Self {
      _flags: flags,
      _gid: gid,
      _conditionIndex: move conditionIndex,
      _axisIndicesIndex: move axisIndex,
      _axisValues: move axisValues,
      _axisValuesVarIndex: move axisVarIndex,
      _transformVarIndex: move transformVarIndex,
      _transform: transform,
    }
  }

  pub fn flags(self: &Self) -> VarcFlags {
    return self._flags
  }

  pub fn gid(self: &Self) -> GlyphId {
    return self._gid
  }

  pub fn conditionIndex(self: &Self) -> Option<u32> {
    return varcCopy(&self._conditionIndex)
  }

  pub fn axisIndicesIndex(self: &Self) -> Option<u32> {
    return varcCopy(&self._axisIndicesIndex)
  }

  pub fn axisValues(self: &Self) -> Option<PackedDeltas<'a>> {
    return varcCopy(&self._axisValues)
  }

  pub fn axisValuesVarIndex(self: &Self) -> Option<u32> {
    return varcCopy(&self._axisValuesVarIndex)
  }

  pub fn transformVarIndex(self: &Self) -> Option<u32> {
    return varcCopy(&self._transformVarIndex)
  }

  pub fn transform(self: &Self) -> DecomposedTransform {
    return self._transform
  }
}

pub struct DecomposedTransform {
  _translateX: f32,
  _translateY: f32,
  _rotation: f32,
  _scaleX: f32,
  _scaleY: f32,
  _skewX: f32,
  _skewY: f32,
  _centerX: f32,
  _centerY: f32,
}

impl Copy for DecomposedTransform {}

// Match upstream's platform f32 trigonometry, including rounding of matrix entries.
unsafe extern "C" fn sinf(value: f32) -> f32

unsafe extern "C" fn cosf(value: f32) -> f32

unsafe extern "C" fn tanf(value: f32) -> f32

impl DecomposedTransform {
  pub fn default() -> Self {
    return Self {
      _translateX: 0.0,
      _translateY: 0.0,
      _rotation: 0.0,
      _scaleX: 1.0,
      _scaleY: 1.0,
      _skewX: 0.0,
      _skewY: 0.0,
      _centerX: 0.0,
      _centerY: 0.0,
    }
  }

  pub fn translateX(self: &Self) -> f32 {
    return self._translateX
  }

  pub fn setTranslateX(self: &mut Self, value: f32) -> () {
    self._translateX = value
  }

  pub fn translateY(self: &Self) -> f32 {
    return self._translateY
  }

  pub fn setTranslateY(self: &mut Self, value: f32) -> () {
    self._translateY = value
  }

  pub fn rotation(self: &Self) -> f32 {
    return self._rotation
  }

  pub fn setRotation(self: &mut Self, value: f32) -> () {
    self._rotation = value
  }

  pub fn scaleX(self: &Self) -> f32 {
    return self._scaleX
  }

  pub fn setScaleX(self: &mut Self, value: f32) -> () {
    self._scaleX = value
  }

  pub fn scaleY(self: &Self) -> f32 {
    return self._scaleY
  }

  pub fn setScaleY(self: &mut Self, value: f32) -> () {
    self._scaleY = value
  }

  pub fn skewX(self: &Self) -> f32 {
    return self._skewX
  }

  pub fn setSkewX(self: &mut Self, value: f32) -> () {
    self._skewX = value
  }

  pub fn skewY(self: &Self) -> f32 {
    return self._skewY
  }

  pub fn setSkewY(self: &mut Self, value: f32) -> () {
    self._skewY = value
  }

  pub fn centerX(self: &Self) -> f32 {
    return self._centerX
  }

  pub fn setCenterX(self: &mut Self, value: f32) -> () {
    self._centerX = value
  }

  pub fn centerY(self: &Self) -> f32 {
    return self._centerY
  }

  pub fn setCenterY(self: &mut Self, value: f32) -> () {
    self._centerY = value
  }

  pub fn matrix(self: &Self) -> Matrix<f32> {
    let mut transform = Matrix.identity<f32>()
    transform.dx = self._translateX + self._centerX
    transform.dy = self._translateY + self._centerY
    let pi: f32 = 3.14159265358979323846
    if self._rotation != 0.0 {
      let angle = self._rotation * pi
      let s = unsafe sinf(angle)
      let c = unsafe cosf(angle)
      transform = transform * Matrix.fromElements<f32>([c, s, -s, c, 0.0, 0.0])
    }
    if self._scaleX != 1.0 || self._scaleY != 1.0 {
      transform = transform
        * Matrix.fromElements<f32>([self._scaleX, 0.0, 0.0, self._scaleY, 0.0, 0.0])
    }
    if self._skewX != 0.0 || self._skewY != 0.0 {
      transform = transform
        * Matrix.fromElements<f32>(
          [1.0, unsafe tanf(self._skewY * pi), unsafe tanf(-self._skewX * pi), 1.0, 0.0, 0.0],
        )
    }
    if self._centerX != 0.0 || self._centerY != 0.0 {
      transform = transform
        * Matrix.fromElements<f32>([1.0, 0.0, 0.0, 1.0, -self._centerX, -self._centerY])
    }
    return transform
  }
}

impl<'a> MultiItemVariationData<'a> {
  pub fn deltaSet(self: &Self, index: usize) -> Result<PackedDeltas<'a>, ReadError> {
    return run Effect.result(MultiItemVariationData.readDeltaSet(self, index))
  }

  effect fn readDeltaSet(self: &Self, index: usize) -> PackedDeltas<'a>
    ! ReadError {
    return PackedDeltas.consumeAll(
      FontData.new(
        run varcIndex(
          Option<Result<Index2<'a>, ReadError>>.some(MultiItemVariationData.deltaSets(self)),
          index,
        ),
      ),
    )
  }
}

