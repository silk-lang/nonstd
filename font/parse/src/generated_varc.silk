effect fn vmust<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "VARC read succeeds")
      return Intrinsic.trap("assertion")
    }
  }
}

effect fn vsome<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "VARC value present")
      return Intrinsic.trap("assertion")
    }
  }
}

fn vnone<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

fn voob<T>(result: Result<T, ReadError>) -> bool {
  return match move result {
    Result<T, ReadError>.Failure { error: ReadError.OutOfBounds } => true
    _ => false
  }
}

effect fn vtable<'a>(bytes: &'a [u8]) -> Varc<'a>
  ! AssertionError<'static> {
  return run vmust(FontRef.varc(&run vmust(FontRef.new(bytes))))
}

effect fn vcjk() -> Varc<'static>
  ! AssertionError<'static> {
  return run vtable(VarcFixtures.varcCjkFont())
}

effect fn vcond() -> Varc<'static>
  ! AssertionError<'static> {
  return run vtable(VarcFixtures.varcConditionalsFont())
}

effect fn vparse<'t, 'a>(table: &Varc<'t>, cursor: &mut Cursor<'a>) -> VarcComponent<'a>
  ! AssertionError<'static> {
  return run vmust(run Effect.result(VarcComponent.parse(table, &mut cursor)))
}

effect fn vsentinel<'a>(cursor: &mut Cursor<'a>) -> ()
  ! AssertionError<'static> {
  run Testing.expect((run vmust(Cursor<'a>.read<u8>(&mut cursor))) == 170, "sentinel not consumed")
}

effect fn vdeltas<'a>(deltas: PackedDeltas<'a>, expected: &[i32]) -> ()
  ! AssertionError<'static> {
  let mut iter = PackedDeltas.iter(&deltas)
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect((run vsome(DeltaRunIter.next(&mut iter))) == expected[i], "packed delta")
    i = i + 1
  }
  run Testing.expect(vnone(DeltaRunIter.next(&mut iter)), "delta sequence exhausted")
}

fn vcopy(out: &mut [u8], bytes: &[u8]) -> () {
  let mut i: usize = 0
  while i < bytes.length {
    out[i] = bytes[i]
    i = i + 1
  }
}

effect fn vzeroAxes(bytes: &mut [u8]) -> ()
  ! AssertionError<'static> {
  vcopy(&mut bytes, VarcFixtures.varcCjkFont())
  let table = run vtable(&bytes)
  let data = Varc.offsetData(&table)
  let base = run vtableOffset(&bytes)
  let relative = u32.toUsize(
    Offset32.toU32(Nullable<Offset32>.offset(&Varc.axisIndicesListOffset(&table)).*),
  )
  let replacement = b"\x00\x00\x00\x01\x01\x01\x01"
  let mut i: usize = 0
  while i < 7 {
    bytes[base + relative + i] = replacement[i]
    i = i + 1
  }
}

fn vvar(out: &mut [u8], at: usize, value: u32) -> usize {
  let mut count: usize = 1
  let mut lead: u32 = value
  if value >= 268435456 {
    count = 5
    lead = 240
  } else if value >= 2097152 {
    count = 4
    lead = 224 | u32.shiftRight(value, 24)
  } else if value >= 16384 {
    count = 3
    lead = 192 | u32.shiftRight(value, 16)
  } else if value >= 128 {
    count = 2
    lead = 128 | u32.shiftRight(value, 8)
  }
  out[at] = u32.toU8(lead)
  let mut i: usize = 1
  while i < count {
    out[at + i] = u32.toU8(u32.shiftRight(value, usize.toU32((count - i - 1) * 8)) & 255)
    i = i + 1
  }
  return at + count
}

fn vstate(value: u32) -> u32 {
  let a = value ^ u32.shiftLeft(value, 13)
  let b = a ^ u32.shiftRight(a, 17)
  return b ^ u32.shiftLeft(b, 5)
}

test effect fn sparseRegionAxisOffsets() -> ()
  ! AssertionError<'static> {
  let data = b"\x00\x00\x00\x02\x00\x00\x00\x0c\x00\x00\x00\x12\x00\x01\x00\x00\x00\x10\x00\x02\x00\x00\x00\x0a\x00\x00\x00\x12\x00\x00\x00\x00\x40\x00\x40\x00\x00\x01\xc0\x00\xc0\x00\x00\x00"
  let list = run vmust(SparseVariationRegionList.read(FontData.new(data)))
  let regions = SparseVariationRegionList.regions(&list)
  let first = run vmust(
    ArrayOfOffsets<'static, (), SparseVariationRegion<'static>, Offset32>.get(&regions, 0),
  )
  let second = run vmust(
    ArrayOfOffsets<'static, (), SparseVariationRegion<'static>, Offset32>.get(&regions, 1),
  )
  run Testing.expect(
    SparseVariationRegion.computeScalarF32(&first, &[F2Dot14.fromF32(0.5)]) == 0.5,
    "first sparse scalar",
  )
  run Testing.expect(
    SparseVariationRegion.computeScalarF32(&second, &[F2Dot14.fromF32(0.5), F2Dot14.fromF32(-1.0)])
      == 0.5,
    "second sparse scalar",
  )
  let axis = run vmust(
    ArrayOfOffsets<'static, (), SparseRegionAxisCoordinates<'static>, Offset32>.get(
      &SparseVariationRegion.axisCoordinates(&second),
      1,
    ),
  )
  run Testing.expect(SparseRegionAxisCoordinates.axisIndex(&axis) == 1, "axis index")
}

test effect fn sparseRegionCountUint32() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 262150] = [0; 262150]
  VarcBuilder.put32(&mut bytes, 0, 65536)
  let mut i: usize = 0
  while i < 65536 {
    VarcBuilder.put32(&mut bytes, 4 + i * 4, 262148)
    i = i + 1
  }
  let list = run vmust(SparseVariationRegionList.read(FontData.new(&bytes)))
  run Testing.expect(SparseVariationRegionList.regionCount(&list) == 65536, "32 bit count")
  let last = run vregion(&list, 65535)
  run Testing.expect(SparseVariationRegion.regionAxisCount(&last) == 0, "last region resolves")
}

