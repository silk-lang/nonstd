import tables.name_string { NameString, Encoding }

impl<'a> Name<'a> {
  pub fn stringData(self: &Self) -> FontData<'a> {
    let base = Name<'a>.offsetData(self)
    return FontData.splitOff(&base, u16.toUsize(Name<'a>.storageOffset(self)))
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
