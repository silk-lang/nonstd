    return HmtxExtended<'a>.read(data, HheaExtended<'a>.numberOfHMetrics(&header))
  }

  fn selectedMaxp(self: &Self) -> Result<SelectedMaxp<'a>, ReadError> {
    match move TableProvider.maxpExtended(self) {
      Result<MaxpExtended<'a>, ReadError>.Success { value } => {
        return Result<SelectedMaxp<'a>, ReadError>.succeed(
          SelectedMaxp<'a>.Extended { table: value },
        )
      }
      Result<MaxpExtended<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, MaxpExtended.tag()) {
          return Result<SelectedMaxp<'a>, ReadError>.failResult(error)
        }
      }
    }
    return match move TableProvider.maxp(self) {
      Result<Maxp<'a>, ReadError>.Success { value } => Result<SelectedMaxp<'a>, ReadError>.succeed(
        SelectedMaxp<'a>.Original { table: value },
      )
      Result<Maxp<'a>, ReadError>.Failure { error } => Result<
        SelectedMaxp<'a>,
        ReadError
