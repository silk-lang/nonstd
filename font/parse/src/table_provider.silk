  fn hGlyphMetricRecords(self: &Self) -> Result<GlyphMetricRecords<'a>, ReadError> {
    match move TableProvider.hmtxExtended(self) {
      Result<HmtxExtended<'a>, ReadError>.Success { value } => {
        return Result<GlyphMetricRecords<'a>, ReadError>.succeed(
          GlyphMetricRecords<'a>.fromHmtxExtended(value),
        )
