  }

  fn selectedHhea(self: &Self) -> Result<SelectedHhea<'a>, ReadError> {
    match move TableProvider.hheaExtended(self) {
      Result<HheaExtended<'a>, ReadError>.Success { value } => {
        return Result<SelectedHhea<'a>, ReadError>.succeed(
          SelectedHhea<'a>.Extended { table: value },
        )
      }
      Result<HheaExtended<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, HheaExtended.tag()) {
          return Result<SelectedHhea<'a>, ReadError>.failResult(error)
        }
      }
    }
    return match move TableProvider.hhea(self) {
      Result<Hhea<'a>, ReadError>.Success { value } => Result<SelectedHhea<'a>, ReadError>.succeed(
        SelectedHhea<'a>.Original { table: value },
      )
      Result<Hhea<'a>, ReadError>.Failure { error } => Result<
        SelectedHhea<'a>,
