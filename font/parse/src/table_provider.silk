impl<'a> TableProvider<'a> for FontRef<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    return FontRef<'a>.tableData(self, tag)
  }
}

pub fn readTable<'a, T: FontRead<'a, ()>, P: TableProvider<'a>>(provider: &P, tag: Tag) -> Result<
  T,
  ReadError
> {
  return match move TableProvider.dataForTag(provider, tag) {
    Option<FontData<'a>>.Some { value } => readWithArgs<(), T>(value, ())
    Option<FontData<'a>>.None => Result<T, ReadError>.failResult(
      ReadError.TableIsMissing { tag: tag },
    )
  }
}

fn isMissingTable(error: ReadError, expected: Tag) -> bool {
  return match error {
    ReadError.TableIsMissing { tag } => &tag == &expected
    _ => false
  }
}

pub struct GlyfLoca<'a> {
  pub glyf: Glyf<'a>,
  pub loca: Loca<'a>,
}

