  }

  fn mvar(self: &Self) -> Result<Mvar<'a>, ReadError> {
    return readTable<Mvar<'a>, Self>(self, Mvar.tag())
  }

  fn fvar(self: &Self) -> Result<Fvar<'a>, ReadError> {
    return readTable<Fvar<'a>, Self>(self, Fvar.tag())
  }

  fn avar(self: &Self) -> Result<Avar<'a>, ReadError> {
    return readTable<Avar<'a>, Self>(self, Avar.tag())
  }

  fn gdef(self: &Self) -> Result<Gdef<'a>, ReadError> {
    return readTable<Gdef<'a>, Self>(self, Gdef.tag())
  }

  fn gsub(self: &Self) -> Result<Gsub<'a>, ReadError> {
    return readTable<Gsub<'a>, Self>(self, Gsub.tag())
  }

  fn gpos(self: &Self) -> Result<Gpos<'a>, ReadError> {
    return readTable<Gpos<'a>, Self>(self, Gpos.tag())
  }

  fn hmtx(self: &Self) -> Result<Hmtx<'a>, ReadError> {
    let header = match move TableProvider.hhea(self) {
      Result<Hhea<'a>, ReadError>.Success { value } => value
      Result<Hhea<'a>, ReadError>.Failure { error } => {
