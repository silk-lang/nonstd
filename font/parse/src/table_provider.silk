pub interface TopLevelTable {
  fn tag() -> Tag
}

pub fn tableTag<T: TopLevelTable>() -> Tag {
  return TopLevelTable.tag()
}

pub interface TableProvider<'a> {
  fn expectTable<T: TopLevelTable + FontRead<'a, ()>>(self: &Self) -> Result<T, ReadError> {
    return readTable<T, Self>(self, tableTag<T>())
  }

  fn varc(self: &Self) -> Result<Varc<'a>, ReadError> {
    return readTable<Varc<'a>, Self>(self, Varc.tag())
  }

  fn math(self: &Self) -> Result<Math<'a>, ReadError> {
    return readTable<Math<'a>, Self>(self, Math.tag())
  }

  fn colr(self: &Self) -> Result<Colr<'a>, ReadError> {
    return readTable<Colr<'a>, Self>(self, Colr.tag())
  }

  fn sbix(self: &Self) -> Result<Sbix<'a>, ReadError> {
    let maxp = match move TableProvider.selectedMaxp(self) {
      Result<SelectedMaxp<'a>, ReadError>.Success { value } => value
      Result<SelectedMaxp<'a>, ReadError>.Failure { error } => {
        return Result<Sbix<'a>, ReadError>.failResult(error)
      }
    }
    let data = match move TableProvider.expectDataForTag(self, Sbix.tag()) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<Sbix<'a>, ReadError>.failResult(error)
      }
    }
    return Sbix.read(data, SelectedMaxp.numGlyphs(&maxp))
  }

  fn cbdt(self: &Self) -> Result<Cbdt<'a>, ReadError> {
    return readTable<Cbdt<'a>, Self>(self, Cbdt.tag())
  }

  fn cblc(self: &Self) -> Result<Cblc<'a>, ReadError> {
    return readTable<Cblc<'a>, Self>(self, Cblc.tag())
  }

  fn ebdt(self: &Self) -> Result<Ebdt<'a>, ReadError> {
    return readTable<Ebdt<'a>, Self>(self, Ebdt.tag())
  }

  fn eblc(self: &Self) -> Result<Eblc<'a>, ReadError> {
    return readTable<Eblc<'a>, Self>(self, Eblc.tag())
  }

  fn base(self: &Self) -> Result<Base<'a>, ReadError> {
    return readTable<Base<'a>, Self>(self, Base.tag())
  }

  fn gasp(self: &Self) -> Result<Gasp<'a>, ReadError> {
    return readTable<Gasp<'a>, Self>(self, Gasp.tag())
  }

  fn hdmx(self: &Self) -> Result<Hdmx<'a>, ReadError> {
    let maxp = match move TableProvider.selectedMaxp(self) {
      Result<SelectedMaxp<'a>, ReadError>.Success { value } => value
      Result<SelectedMaxp<'a>, ReadError>.Failure { error } => {
        return Result<Hdmx<'a>, ReadError>.failResult(error)
      }
    }
    let data = match move TableProvider.expectDataForTag(self, Hdmx.tag()) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<Hdmx<'a>, ReadError>.failResult(error)
      }
    }
    return Hdmx.read(data, SelectedMaxp.numGlyphs(&maxp))
  }

  fn stat(self: &Self) -> Result<Stat<'a>, ReadError> {
    return readTable<Stat<'a>, Self>(self, Stat.tag())
  }

  fn meta(self: &Self) -> Result<Meta<'a>, ReadError> {
    return readTable<Meta<'a>, Self>(self, Meta.tag())
  }

  fn cvar(self: &Self) -> Result<Cvar<'a>, ReadError> {
    return readTable<Cvar<'a>, Self>(self, Cvar.tag())
  }

  fn cpal(self: &Self) -> Result<Cpal<'a>, ReadError> {
    return readTable<Cpal<'a>, Self>(self, Cpal.tag())
  }

  fn svg(self: &Self) -> Result<Svg<'a>, ReadError> {
    return readTable<Svg<'a>, Self>(self, Svg.tag())
  }

  fn dsig(self: &Self) -> Result<Dsig<'a>, ReadError> {
    return readTable<Dsig<'a>, Self>(self, Dsig.tag())
  }

  fn cff2(self: &Self) -> Result<Cff2<'a>, ReadError> {
    return readTable<Cff2<'a>, Self>(self, Cff2.tag())
  }

  fn cff(self: &Self) -> Result<Cff<'a>, ReadError> {
    return readTable<Cff<'a>, Self>(self, Cff.tag())
  }

  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>>

  fn expectDataForTag(self: &Self, tag: Tag) -> Result<FontData<'a>, ReadError> {
    return match move TableProvider.dataForTag(self, tag) {
      Option<FontData<'a>>.Some { value } => Result<FontData<'a>, ReadError>.succeed(value)
      Option<FontData<'a>>.None => Result<FontData<'a>, ReadError>.failResult(
        ReadError.TableIsMissing { tag: tag },
      )
    }
  }

  fn kern(self: &Self) -> Result<Kern<'a>, ReadError> {
    return readTable<Kern<'a>, Self>(self, Kern.tag())
  }

  fn kerx(self: &Self) -> Result<Kerx<'a>, ReadError> {
    return readTable<Kerx<'a>, Self>(self, Kerx.tag())
  }

  fn morx(self: &Self) -> Result<Morx<'a>, ReadError> {
    return readTable<Morx<'a>, Self>(self, Morx.tag())
  }

  fn mort(self: &Self) -> Result<Mort<'a>, ReadError> {
    return readTable<Mort<'a>, Self>(self, Mort.tag())
  }

  fn trak(self: &Self) -> Result<Trak<'a>, ReadError> {
    return readTable<Trak<'a>, Self>(self, Trak.tag())
  }

  fn ankr(self: &Self) -> Result<Ankr<'a>, ReadError> {
    return readTable<Ankr<'a>, Self>(self, Ankr.tag())
  }

  fn feat(self: &Self) -> Result<Feat<'a>, ReadError> {
    return readTable<Feat<'a>, Self>(self, Feat.tag())
  }

  fn ltag(self: &Self) -> Result<Ltag<'a>, ReadError> {
    return readTable<Ltag<'a>, Self>(self, Ltag.tag())
  }

  fn head(self: &Self) -> Result<Head<'a>, ReadError> {
    return readTable<Head<'a>, Self>(self, Head.tag())
  }

  fn maxp(self: &Self) -> Result<Maxp<'a>, ReadError> {
    return readTable<Maxp<'a>, Self>(self, Maxp.tag())
  }

  fn maxpExtended(self: &Self) -> Result<MaxpExtended<'a>, ReadError> {
    return readTable<MaxpExtended<'a>, Self>(self, MaxpExtended.tag())
  }

  fn cmap(self: &Self) -> Result<Cmap<'a>, ReadError> {
    return readTable<Cmap<'a>, Self>(self, Cmap.tag())
  }

  fn dmap(self: &Self) -> Result<Dmap<'a>, ReadError> {
    return readTable<Dmap<'a>, Self>(self, Dmap.tag())
  }

  fn hhea(self: &Self) -> Result<Hhea<'a>, ReadError> {
    return readTable<Hhea<'a>, Self>(self, Hhea.tag())
  }

  fn hheaExtended(self: &Self) -> Result<HheaExtended<'a>, ReadError> {
    return readTable<HheaExtended<'a>, Self>(self, HheaExtended.tag())
  }

  fn name(self: &Self) -> Result<Name<'a>, ReadError> {
    return readTable<Name<'a>, Self>(self, Name.tag())
  }

  fn os2(self: &Self) -> Result<Os2<'a>, ReadError> {
    return readTable<Os2<'a>, Self>(self, Os2.tag())
  }

  fn post(self: &Self) -> Result<Post<'a>, ReadError> {
    return readTable<Post<'a>, Self>(self, Post.tag())
  }

  fn hvar(self: &Self) -> Result<Hvar<'a>, ReadError> {
    return readTable<Hvar<'a>, Self>(self, Hvar.tag())
  }

  fn vvar(self: &Self) -> Result<Vvar<'a>, ReadError> {
    return readTable<Vvar<'a>, Self>(self, Vvar.tag())
  }

  fn glyf(self: &Self) -> Result<Glyf<'a>, ReadError> {
    return readTable<Glyf<'a>, Self>(self, Glyf.tag())
  }

  fn glyfExtended(self: &Self) -> Result<Glyf<'a>, ReadError> {
    return readTable<Glyf<'a>, Self>(self, Tag.fromU32(1196185926))
  }

  fn loca(self: &Self, isLong: Option<bool>) -> Result<Loca<'a>, ReadError> {
    let mut length = false
    match move isLong {
      Option<bool>.Some { value } => {
        length = value
      }
      Option<bool>.None => {
        let header = match move TableProvider.head(self) {
          Result<Head<'a>, ReadError>.Success { value } => value
          Result<Head<'a>, ReadError>.Failure { error } => {
            return Result<Loca<'a>, ReadError>.failResult(error)
          }
        }
        length = Head.indexToLocFormat(&header) == 1
      }
    }
    let data = match move TableProvider.expectDataForTag(self, Loca.tag()) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<Loca<'a>, ReadError>.failResult(error)
      }
    }
    return Loca.read(data, length)
  }

  fn locaExtended(self: &Self, isLong: Option<bool>) -> Result<Loca<'a>, ReadError> {
    let data = match move TableProvider.expectDataForTag(self, Tag.fromU32(1280262977)) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<Loca<'a>, ReadError>.failResult(error)
      }
    }
    let mut length = false
    match move isLong {
      Option<bool>.Some { value } => {
        length = value
      }
      Option<bool>.None => {
        let header = match move TableProvider.head(self) {
          Result<Head<'a>, ReadError>.Success { value } => value
          Result<Head<'a>, ReadError>.Failure { error } => {
            return Result<Loca<'a>, ReadError>.failResult(error)
          }
        }
        length = Head.indexToLocFormat(&header) == 1
      }
    }
    return Loca.read(data, length)
  }

  fn selectedGlyfLoca(self: &Self, isLong: Option<bool>) -> Result<GlyfLoca<'a>, ReadError> {
    match move TableProvider.glyfExtended(self) {
      Result<Glyf<'a>, ReadError>.Success { value: glyf } => {
        return match move TableProvider.locaExtended(self, move isLong) {
          Result<Loca<'a>, ReadError>.Success { value: loca } => Result<
            GlyfLoca<'a>,
            ReadError
          >.succeed(GlyfLoca<'a> { glyf: glyf, loca: loca })
          Result<Loca<'a>, ReadError>.Failure { error } => Result<
            GlyfLoca<'a>,
            ReadError
          >.failResult(error)
        }
      }
      Result<Glyf<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, Tag.fromU32(1196185926)) {
          return Result<GlyfLoca<'a>, ReadError>.failResult(error)
        }
      }
    }
    let glyf = match move TableProvider.glyf(self) {
      Result<Glyf<'a>, ReadError>.Success { value } => value
      Result<Glyf<'a>, ReadError>.Failure { error } => {
        return Result<GlyfLoca<'a>, ReadError>.failResult(error)
      }
    }
    return match move TableProvider.loca(self, move isLong) {
      Result<Loca<'a>, ReadError>.Success { value } => Result<GlyfLoca<'a>, ReadError>.succeed(
        GlyfLoca<'a> { glyf: glyf, loca: value },
      )
      Result<Loca<'a>, ReadError>.Failure { error } => Result<GlyfLoca<'a>, ReadError>.failResult(
        error,
      )
    }
  }

  fn gvar(self: &Self) -> Result<Gvar<'a>, ReadError> {
    return readTable<Gvar<'a>, Self>(self, Gvar.tag())
  }

  fn gvarExtended(self: &Self) -> Result<GvarExtended<'a>, ReadError> {
    return readTable<GvarExtended<'a>, Self>(self, GvarExtended.tag())
  }

  fn selectedGvar(self: &Self) -> Result<SelectedGvar<'a>, ReadError> {
    match move TableProvider.gvarExtended(self) {
      Result<GvarExtended<'a>, ReadError>.Success { value } => {
        return Result<SelectedGvar<'a>, ReadError>.succeed(
          SelectedGvar<'a>.Extended { table: value },
        )
      }
      Result<GvarExtended<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, GvarExtended.tag()) {
          return Result<SelectedGvar<'a>, ReadError>.failResult(error)
        }
      }
    }
    return match move TableProvider.gvar(self) {
      Result<Gvar<'a>, ReadError>.Success { value } => Result<SelectedGvar<'a>, ReadError>.succeed(
        SelectedGvar<'a>.Original { table: value },
      )
      Result<Gvar<'a>, ReadError>.Failure { error } => Result<
        SelectedGvar<'a>,
        ReadError
      >.failResult(error)
    }
  }

  fn vmtx(self: &Self) -> Result<Vmtx<'a>, ReadError> {
    let header = match move TableProvider.vhea(self) {
      Result<Vhea<'a>, ReadError>.Success { value } => value
      Result<Vhea<'a>, ReadError>.Failure { error } => {
        return Result<Vmtx<'a>, ReadError>.failResult(error)
      }
    }
    let data = match move TableProvider.expectDataForTag(self, Vmtx.tag()) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<Vmtx<'a>, ReadError>.failResult(error)
      }
    }
    return Vmtx<'a>.read(data, Vhea<'a>.numberOfLongVerMetrics(&header))
  }

  fn vmtxExtended(self: &Self) -> Result<VmtxExtended<'a>, ReadError> {
    let data = match move TableProvider.expectDataForTag(self, VmtxExtended.tag()) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      Result<FontData<'a>, ReadError>.Failure { error } => {
        return Result<VmtxExtended<'a>, ReadError>.failResult(error)
      }
    }
    let header = match move TableProvider.vheaExtended(self) {
      Result<VheaExtended<'a>, ReadError>.Success { value } => value
      Result<VheaExtended<'a>, ReadError>.Failure { error } => {
        return Result<VmtxExtended<'a>, ReadError>.failResult(error)
      }
    }
    return VmtxExtended<'a>.read(data, VheaExtended<'a>.numberOfLongVerMetrics(&header))
  }

  fn selectedVhea(self: &Self) -> Result<SelectedVhea<'a>, ReadError> {
    match move TableProvider.vheaExtended(self) {
      Result<VheaExtended<'a>, ReadError>.Success { value } => {
        return Result<SelectedVhea<'a>, ReadError>.succeed(
          SelectedVhea<'a>.Extended { table: value },
        )
      }
      Result<VheaExtended<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, VheaExtended.tag()) {
          return Result<SelectedVhea<'a>, ReadError>.failResult(error)
        }
      }
    }
    return match move TableProvider.vhea(self) {
      Result<Vhea<'a>, ReadError>.Success { value } => Result<SelectedVhea<'a>, ReadError>.succeed(
        SelectedVhea<'a>.Original { table: value },
      )
      Result<Vhea<'a>, ReadError>.Failure { error } => Result<
        SelectedVhea<'a>,
        ReadError
      >.failResult(error)
    }
  }

  fn vGlyphMetricRecords(self: &Self) -> Result<GlyphMetricRecords<'a>, ReadError> {
    match move TableProvider.vmtxExtended(self) {
      Result<VmtxExtended<'a>, ReadError>.Success { value } => {
        return Result<GlyphMetricRecords<'a>, ReadError>.succeed(
          GlyphMetricRecords<'a>.fromVmtxExtended(value),
        )
      }
      Result<VmtxExtended<'a>, ReadError>.Failure { error } => {
        if !isMissingTable(error, VmtxExtended.tag()) {
          return Result<GlyphMetricRecords<'a>, ReadError>.failResult(error)
        }
      }
    }
    return match move TableProvider.vmtx(self) {
      Result<Vmtx<'a>, ReadError>.Success { value } => Result<
        GlyphMetricRecords<'a>,
        ReadError
      >.succeed(GlyphMetricRecords<'a>.fromVmtx(value))
      Result<Vmtx<'a>, ReadError>.Failure { error } => Result<
        GlyphMetricRecords<'a>,
        ReadError
      >.failResult(error)
    }
  }

  fn vhea(self: &Self) -> Result<Vhea<'a>, ReadError> {
    return readTable<Vhea<'a>, Self>(self, Vhea.tag())
  }

  fn vheaExtended(self: &Self) -> Result<VheaExtended<'a>, ReadError> {
    return readTable<VheaExtended<'a>, Self>(self, VheaExtended.tag())
  }

  fn vorg(self: &Self) -> Result<Vorg<'a>, ReadError> {
