      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 1] = [ByteRange { start: 0, end: 0 }; 1]
    let mut end: usize = 0
    let numberOfIndexSubtablesValue = numberOfIndexSubtables
    ranges[0].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(numberOfIndexSubtablesValue), 8),
    )
    ranges[0].end = end
    return Result<Self, ReadError>.succeed(
      Self {
        _fontData: data,
        _fieldRanges: ranges,
        _numberOfIndexSubtables: numberOfIndexSubtables,
      },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Array of IndexSubtableRecords.
  pub fn indexSubtableRecords(self: &Self) -> ComputedArray<'a, (), IndexSubtableRecord<'a>> {
    return match move recordArray<IndexSubtableRecord<'a>>(
      self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ComputedArray<'a, (), IndexSubtableRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), IndexSubtableRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), IndexSubtableRecord<'a>>.empty(())
    }
  }

  pub fn indexSubtableRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }
}

impl<'a> FontRead<'a, u32> for IndexSubtableList<'a> {
  fn readWithArgs(data: FontData<'a>, args: u32) -> Result<Self, ReadError> {
    return IndexSubtableList<'a>.read(data, args)
  }
}

impl<'a> MinByteRange<'a> for IndexSubtableList<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[0].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[0].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

pub struct IndexSubtableRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for IndexSubtableRecord<'a> {}

impl<'a> IndexSubtableRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 8 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph ID of this range.
  pub fn firstGlyphIndex(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 0)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Last glyph ID of this range (inclusive).
  pub fn lastGlyphIndex(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, (self.position + 2)) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Offset to an IndexSubtable from the start of the IndexSubtableList.
  pub fn indexSubtableOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, (self.position + 4)) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn indexSubtable(self: &Self, data: FontData<'a>) -> Result<IndexSubtable<'a>, ReadError> {
    let offset = IndexSubtableRecord<'a>.indexSubtableOffset(self)
    return resolveWithArgs<ReadArgs2<GlyphId16, GlyphId16>, IndexSubtable<'a>, Offset32>(
      offset,
      data,
      ReadArgs2<GlyphId16, GlyphId16> {
        first: IndexSubtableRecord<'a>.lastGlyphIndex(self),
        second: IndexSubtableRecord<'a>.firstGlyphIndex(self),
      },
    )
  }
}

impl<'a> FixedSize for IndexSubtableRecord<'a> {
  fn rawByteLen() -> usize {
    return 8
  }
}

impl<'a> ComputeSize<()> for IndexSubtableRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(8)
  }
}

impl<'a> FontReadAt<'a, ()> for IndexSubtableRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return IndexSubtableRecord<'a>.readAt(data, position, ())
  }
}

/// [IndexSubTable1](https://learn.microsoft.com/en-us/typography/opentype/spec/eblc#indexsubtable1-variable-metrics-glyphs-with-4-byte-offsets): variable-metrics glyphs with 4-byte offsets.
pub struct IndexSubtable1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
  _lastGlyphIndex: GlyphId16,
  _firstGlyphIndex: GlyphId16,
}

impl<'a> Copy for IndexSubtable1<'a> {}

impl<'a> IndexSubtable1<'a> {
  pub fn default() -> Self {
    return IndexSubtable1<'a>.read(
      FontData.defaultFormat1U16TableData(),
      GlyphId16.new(0),
      GlyphId16.new(0),
    )
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 4],
          _lastGlyphIndex: GlyphId16.new(0),
          _firstGlyphIndex: GlyphId16.new(0),
        },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>, lastGlyphIndex: GlyphId16, firstGlyphIndex: GlyphId16) -> Result<
    Self,
    ReadError
  > {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    let lastGlyphIndexValue = lastGlyphIndex
    let firstGlyphIndexValue = firstGlyphIndex
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let indexFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let imageFormatValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let imageDataOffsetValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        usize.saturatingAdd(
          usize.saturatingSubtract(
            u32.toUsize(GlyphId16.toU32(lastGlyphIndexValue)),
            u32.toUsize(GlyphId16.toU32(firstGlyphIndexValue)),
          ),
          2,
        ),
        4,
      ),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(
      Self {
        _fontData: data,
        _fieldRanges: ranges,
        _lastGlyphIndex: lastGlyphIndex,
        _firstGlyphIndex: firstGlyphIndex,
      },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format of this IndexSubTable.
  pub fn indexFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn indexFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Format of EBDT image data.
  pub fn imageFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to image data in EBDT table.
  pub fn imageDataOffset(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageDataOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  pub fn sbitOffsets(self: &Self) -> ScalarArray<'a, u32> {
    return match move FontData<'a>.readArray<u32>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u32>, ReadError>.Failure { error } => ScalarArray<u32>.empty()
    }
  }

  pub fn sbitOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ReadArgs2<GlyphId16, GlyphId16>> for IndexSubtable1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<GlyphId16, GlyphId16>) -> Result<
    Self,
    ReadError
  > {
    return IndexSubtable1<'a>.read(data, args.first, args.second)
  }
}

impl<'a> Format<u16> for IndexSubtable1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for IndexSubtable1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [IndexSubTable2](https://learn.microsoft.com/en-us/typography/opentype/spec/eblc#indexsubtable2-all-glyphs-have-identical-metrics): all glyphs have identical metrics.
pub struct IndexSubtable2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for IndexSubtable2<'a> {}

impl<'a> IndexSubtable2<'a> {
  pub fn minSize() -> usize {
    return 20
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 20 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let indexFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let imageFormatValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let imageDataOffsetValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let imageSizeValue = scalarOr<u32>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 8)
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format of this IndexSubTable.
  pub fn indexFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn indexFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Format of EBDT image data.
  pub fn imageFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to image data in EBDT table.
  pub fn imageDataOffset(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageDataOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// All the glyphs are of the same size.
  pub fn imageSize(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[3].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// All glyphs have the same metrics; glyph data may be compressed, byte-aligned, or bit-aligned.
  pub fn bigMetrics(self: &Self) -> BigGlyphMetrics<'a> {
    return match move readAtWithArgs<(), BigGlyphMetrics<'a>>(
      self._fontData,
      self._fieldRanges[4].start,
      (),
    ) {
      Result<BigGlyphMetrics<'a>, ReadError>.Success { value } => value
      Result<BigGlyphMetrics<'a>, ReadError>.Failure { error } => BigGlyphMetrics<'a>.default()
    }
  }

  pub fn bigMetricsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for IndexSubtable2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return IndexSubtable2<'a>.read(data)
  }
}

impl<'a> Format<u16> for IndexSubtable2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for IndexSubtable2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

