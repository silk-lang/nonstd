/// [IndexSubTable4](https://learn.microsoft.com/en-us/typography/opentype/spec/eblc#indexsubtable3-variable-metrics-glyphs-with-2-byte-offsets): variable-metrics glyphs with sparse glyph codes.
pub struct IndexSubtable4<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for IndexSubtable4<'a> {}

impl<'a> IndexSubtable4<'a> {
  pub fn minSize() -> usize {
    return 12
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 12 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let indexFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let imageFormatValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let imageDataOffsetValue = scalarOr<u32>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let numGlyphsValue = scalarOr<u32>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingAdd(u32.toUsize(numGlyphsValue), 1), 4),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format of this IndexSubTable.
  pub fn indexFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn indexFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Format of EBDT image data.
  pub fn imageFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to image data in EBDT table.
  pub fn imageDataOffset(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[2].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn imageDataOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array length.
  pub fn numGlyphs(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[3].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn numGlyphsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// One per glyph.
  pub fn glyphArray(self: &Self) -> ComputedArray<'a, (), GlyphIdOffsetPair<'a>> {
    return match move recordArray<GlyphIdOffsetPair<'a>>(
      self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ComputedArray<'a, (), GlyphIdOffsetPair<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), GlyphIdOffsetPair<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), GlyphIdOffsetPair<'a>>.empty(())
    }
  }

  pub fn glyphArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for IndexSubtable4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return IndexSubtable4<'a>.read(data)
  }
}

impl<'a> Format<u16> for IndexSubtable4<'a> {
  fn formatValue() -> u16 {
    return 4
  }
}

impl<'a> MinByteRange<'a> for IndexSubtable4<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [GlyphIdOffsetPair](https://learn.microsoft.com/en-us/typography/opentype/spec/eblc#glyphidoffsetpair-record) record.
pub struct GlyphIdOffsetPair<'a> {
