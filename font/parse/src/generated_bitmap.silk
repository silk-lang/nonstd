import font_data { Cursor }

pub union IndexSubtable<'a> {
  Format1 { pub value: IndexSubtable1<'a> },
  Format2 { pub value: IndexSubtable2<'a> },
  Format3 { pub value: IndexSubtable3<'a> },
  Format4 { pub value: IndexSubtable4<'a> },
  Format5 { pub value: IndexSubtable5<'a> },
}

impl<'a> Copy for IndexSubtable<'a> {}

impl<'a> IndexSubtable<'a> {
  pub fn read(data: FontData<'a>, last: GlyphId16, first: GlyphId16) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move IndexSubtable1.read(data, last, first) {
          Result<IndexSubtable1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(IndexSubtable<'a>.Format1 { value: value })
          Result<IndexSubtable1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move IndexSubtable2.read(data) {
          Result<IndexSubtable2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(IndexSubtable<'a>.Format2 { value: value })
          Result<IndexSubtable2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move IndexSubtable3.read(data, last, first) {
          Result<IndexSubtable3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(IndexSubtable<'a>.Format3 { value: value })
          Result<IndexSubtable3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move IndexSubtable4.read(data) {
          Result<IndexSubtable4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(IndexSubtable<'a>.Format4 { value: value })
          Result<IndexSubtable4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      5 => {
        return match move IndexSubtable5.read(data) {
          Result<IndexSubtable5<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(IndexSubtable<'a>.Format5 { value: value })
          Result<IndexSubtable5<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => IndexSubtable1.offsetData(&value)
      IndexSubtable<'a>.Format2 { value } => IndexSubtable2.offsetData(&value)
      IndexSubtable<'a>.Format3 { value } => IndexSubtable3.offsetData(&value)
      IndexSubtable<'a>.Format4 { value } => IndexSubtable4.offsetData(&value)
      IndexSubtable<'a>.Format5 { value } => IndexSubtable5.offsetData(&value)
    }
  }

  pub fn indexFormat(self: &Self) -> u16 {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => IndexSubtable1.indexFormat(&value)
      IndexSubtable<'a>.Format2 { value } => IndexSubtable2.indexFormat(&value)
      IndexSubtable<'a>.Format3 { value } => IndexSubtable3.indexFormat(&value)
      IndexSubtable<'a>.Format4 { value } => IndexSubtable4.indexFormat(&value)
      IndexSubtable<'a>.Format5 { value } => IndexSubtable5.indexFormat(&value)
    }
  }

  pub fn imageFormat(self: &Self) -> u16 {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => IndexSubtable1.imageFormat(&value)
      IndexSubtable<'a>.Format2 { value } => IndexSubtable2.imageFormat(&value)
      IndexSubtable<'a>.Format3 { value } => IndexSubtable3.imageFormat(&value)
      IndexSubtable<'a>.Format4 { value } => IndexSubtable4.imageFormat(&value)
      IndexSubtable<'a>.Format5 { value } => IndexSubtable5.imageFormat(&value)
    }
  }

  pub fn imageDataOffset(self: &Self) -> u32 {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => IndexSubtable1.imageDataOffset(&value)
      IndexSubtable<'a>.Format2 { value } => IndexSubtable2.imageDataOffset(&value)
      IndexSubtable<'a>.Format3 { value } => IndexSubtable3.imageDataOffset(&value)
      IndexSubtable<'a>.Format4 { value } => IndexSubtable4.imageDataOffset(&value)
      IndexSubtable<'a>.Format5 { value } => IndexSubtable5.imageDataOffset(&value)
    }
  }
}

impl<'a> FontRead<'a, ReadArgs2<GlyphId16, GlyphId16>> for IndexSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<GlyphId16, GlyphId16>) -> Result<
    Self,
    ReadError
  > {
    return IndexSubtable.read(data, args.first, args.second)
  }
}

impl<'a> MinByteRange<'a> for IndexSubtable<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      IndexSubtable<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      IndexSubtable<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      IndexSubtable<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
      IndexSubtable<'a>.Format5 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      IndexSubtable<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      IndexSubtable<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      IndexSubtable<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      IndexSubtable<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
      IndexSubtable<'a>.Format5 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

pub struct BitmapLocation<'a> {
  pub format: u16,
  pub dataOffset: usize,
  pub dataSize: usize,
  pub bitDepth: u8,
  pub metrics: Option<BigGlyphMetrics<'a>>,
}

impl<'a> BitmapLocation<'a> {
  pub fn default() -> Self {
    return Self {
      format: 0,
      dataOffset: 0,
      dataSize: 0,
      bitDepth: 0,
      metrics: Option<BigGlyphMetrics<'a>>.None,
    }
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.dataSize == 0
  }
}

pub enum(u8) BitmapDataFormat {
  BitAligned = 0,
  ByteAligned = 1,
  Png = 2,
}

pub union BitmapMetrics<'a> {
  Small { pub value: SmallGlyphMetrics<'a> },
  Big { pub value: BigGlyphMetrics<'a> },
}

impl<'a> Copy for BitmapMetrics<'a> {}

pub union BitmapContent<'a> {
  Data { pub format: BitmapDataFormat, pub bytes: &'a [u8] },
  Composite { pub value: ComputedArray<'a, (), BdtComponent<'a>> },
}

impl<'a> Copy for BitmapContent<'a> {}

pub struct BitmapData<'a> {
  pub metrics: BitmapMetrics<'a>,
  pub content: BitmapContent<'a>,
}

impl<'a> Copy for BitmapData<'a> {}

impl<'a> BitmapSize<'a> {
  pub fn indexSubtableList(self: &Self, data: FontData<'a>) -> Result<
    IndexSubtableList<'a>,
    ReadError
  > {
    let rest = match move FontData.splitOff(
      &data,
      u32.toUsize(BitmapSize.indexSubtableListOffset(self)),
    ) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<IndexSubtableList<'a>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }

    // Match FreeType/upstream: declared indexTablesSize does not bound subtables.
    return IndexSubtableList.read(rest, BitmapSize.numberOfIndexSubtables(self))
  }

  pub fn location(self: &Self, data: FontData<'a>, glyphId: GlyphId) -> Result<
    BitmapLocation<'a>,
    ReadError
  > {
    let gid = GlyphId.toU32(glyphId)
    if gid < GlyphId16.toU32(BitmapSize.startGlyphIndex(self))
      || gid > GlyphId16.toU32(BitmapSize.endGlyphIndex(self)) {
      return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let list = match move BitmapSize.indexSubtableList(self, data) {
      Result<IndexSubtableList<'a>, ReadError>.Success { value } => value
      Result<IndexSubtableList<'a>, ReadError>.Failure { error } => {
        return Result<BitmapLocation<'a>, ReadError>.failResult(error)
      }
    }
    let records = IndexSubtableList.indexSubtableRecords(&list)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), IndexSubtableRecord<'a>>.len(&records) {
      let record = match move ComputedArray<'a, (), IndexSubtableRecord<'a>>.get(&records, index) {
        Result<IndexSubtableRecord<'a>, ReadError>.Success { value } => value
        Result<IndexSubtableRecord<'a>, ReadError>.Failure { error } => {
          return Result<BitmapLocation<'a>, ReadError>.failResult(error)
        }
      }
      let subtable = match move IndexSubtableRecord.indexSubtable(
        &record,
        IndexSubtableList.offsetData(&list),
      ) {
        Result<IndexSubtable<'a>, ReadError>.Success { value } => value
        Result<IndexSubtable<'a>, ReadError>.Failure { error } => {
          return Result<BitmapLocation<'a>, ReadError>.failResult(error)
        }
      }
      index = index + 1
      let first = GlyphId16.toU32(IndexSubtableRecord.firstGlyphIndex(&record))
      let last = GlyphId16.toU32(IndexSubtableRecord.lastGlyphIndex(&record))
      if gid < first || gid > last {
        continue
      }
      let glyphIndex = u32.toUsize(gid - first)
      let mut location = BitmapLocation<'a>.default()
      location.bitDepth = BitmapSize.bitDepth(self)
      location.format = IndexSubtable.imageFormat(&subtable)
      let base = u32.toUsize(IndexSubtable.imageDataOffset(&subtable))
      match subtable {
        IndexSubtable<'a>.Format1 { value } => {
          let offsets = IndexSubtable1.sbitOffsets(&value)
          let firstOffset = match move ScalarArray<u32>.get(&offsets, glyphIndex) {
            Option<u32>.Some { value: offset } => u32.toUsize(offset)
            _ => {
              return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
            }
          }
          let secondOffset = match move ScalarArray<u32>.get(&offsets, glyphIndex + 1) {
            Option<u32>.Some { value: offset } => u32.toUsize(offset)
            _ => {
              return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
            }
          }
          return bitmapRange(move location, base, firstOffset, secondOffset)
        }
        IndexSubtable<'a>.Format3 { value } => {
          let offsets = IndexSubtable3.sbitOffsets(&value)
          let firstOffset = match move ScalarArray<u16>.get(&offsets, glyphIndex) {
            Option<u16>.Some { value: offset } => u16.toUsize(offset)
            _ => {
              return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
            }
          }
          let secondOffset = match move ScalarArray<u16>.get(&offsets, glyphIndex + 1) {
            Option<u16>.Some { value: offset } => u16.toUsize(offset)
            _ => {
              return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
            }
          }
          return bitmapRange(move location, base, firstOffset, secondOffset)
        }
        IndexSubtable<'a>.Format2 { value } => {
          location.metrics = Option<BigGlyphMetrics<'a>>.some(IndexSubtable2.bigMetrics(&value))
          return bitmapFixedRange(
            move location,
            base,
            glyphIndex,
            u32.toUsize(IndexSubtable2.imageSize(&value)),
          )
        }
        IndexSubtable<'a>.Format4 { value } => {
          let array = IndexSubtable4.glyphArray(&value)
          let mut lo: usize = 0
          let mut hi = ComputedArray<'a, (), GlyphIdOffsetPair<'a>>.len(&array)
          while lo < hi {
            let mid = lo + (hi - lo) / 2
            let pair = match move ComputedArray<'a, (), GlyphIdOffsetPair<'a>>.get(&array, mid) {
              Result<GlyphIdOffsetPair<'a>, ReadError>.Success { value: item } => item
              Result<GlyphIdOffsetPair<'a>, ReadError>.Failure { error } => {
                return Result<BitmapLocation<'a>, ReadError>.failResult(error)
              }
            }
            let current = GlyphId16.toU32(GlyphIdOffsetPair.glyphId(&pair))
            if current < gid {
              lo = mid + 1
            } else if current > gid {
              hi = mid
            } else {
              let next = match move ComputedArray<'a, (), GlyphIdOffsetPair<'a>>.get(
                &array,
                mid + 1,
              ) {
                Result<GlyphIdOffsetPair<'a>, ReadError>.Success { value: item } => item
                Result<GlyphIdOffsetPair<'a>, ReadError>.Failure { error } => {
                  return Result<BitmapLocation<'a>, ReadError>.failResult(error)
                }
              }
              return bitmapRange(
                move location,
                base,
                u16.toUsize(GlyphIdOffsetPair.sbitOffset(&pair)),
                u16.toUsize(GlyphIdOffsetPair.sbitOffset(&next)),
              )
            }
          }
          return Result<BitmapLocation<'a>, ReadError>.failResult(
            ReadError.InvalidCollectionIndex { index: gid },
          )
        }
        IndexSubtable<'a>.Format5 { value } => {
          let array = IndexSubtable5.glyphArray(&value)
          let mut lo: usize = 0
          let mut hi = ScalarArray<GlyphId16>.len(&array)
          while lo < hi {
            let mid = lo + (hi - lo) / 2
            let item = match move ScalarArray<GlyphId16>.get(&array, mid) {
              Option<GlyphId16>.Some { value: found } => found
              _ => {
                return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
              }
            }
            let current = GlyphId16.toU32(item)
            if current < gid {
              lo = mid + 1
            } else if current > gid {
              hi = mid
            } else {
              location.metrics = Option<BigGlyphMetrics<'a>>.some(IndexSubtable5.bigMetrics(&value))
              return bitmapFixedRange(
                move location,
                base,
                mid,
                u32.toUsize(IndexSubtable5.imageSize(&value)),
              )
            }
          }
          return Result<BitmapLocation<'a>, ReadError>.failResult(
            ReadError.InvalidCollectionIndex { index: gid },
          )
        }
      }
    }
    return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
  }
}

fn bitmapRange<'a>(
  location: BitmapLocation<'a>,
  base: usize,
  first: usize,
  second: usize,
) -> Result<BitmapLocation<'a>, ReadError> {
  let start = match move usize.checkedAdd(base, first) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  let end = match move usize.checkedAdd(base, second) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  if end < start {
    return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
  }
  let mut result = move location
  result.dataOffset = start
  result.dataSize = end - start
  return Result<BitmapLocation<'a>, ReadError>.succeed(move result)
}

fn bitmapFixedRange<'a>(
  location: BitmapLocation<'a>,
  base: usize,
  index: usize,
  size: usize,
) -> Result<BitmapLocation<'a>, ReadError> {
  let offset = match move usize.checkedMultiply(index, size) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  let start = match move usize.checkedAdd(base, offset) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<BitmapLocation<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  let mut result = move location
  result.dataOffset = start
  result.dataSize = size
  return Result<BitmapLocation<'a>, ReadError>.succeed(move result)
}

pub fn bitmapData<'a>(data: FontData<'a>, location: &BitmapLocation<'a>, isColor: bool) -> Result<
  BitmapData<'a>,
  ReadError
> {
  let end = match move usize.checkedAdd(location.dataOffset, location.dataSize) {
    Option<usize>.Some { value } => value
    _ => {
      return Result<BitmapData<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  let image = match move FontData.slice(&data, location.dataOffset, end) {
    Option<FontData<'a>>.Some { value } => value
    _ => {
      return Result<BitmapData<'a>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
  let format = location.format
  if format != 1 && format != 2 && format != 5 && format != 6 && format != 7 && format != 8
    && format != 9
    && !(isColor && (format == 17 || format == 18 || format == 19)) {
    return Result<BitmapData<'a>, ReadError>.failResult(
      ReadError.MalformedData { message: "unexpected bitmap data format" },
    )
  }
  let mut cursor = FontData.cursor(&image)
  let metrics = match move bitmapMetrics(&mut cursor, location) {
    Result<BitmapMetrics<'a>, ReadError>.Success { value } => value
    Result<BitmapMetrics<'a>, ReadError>.Failure { error } => {
      return Result<BitmapData<'a>, ReadError>.failResult(error)
    }
  }
  if format == 8 || format == 9 {
    if format == 8 {
      if let Result<u8, ReadError>.Failure { error } = move Cursor<'a>.read<u8>(&mut cursor) {
        return Result<BitmapData<'a>, ReadError>.failResult(error)
      }
    }
    let count = match move Cursor<'a>.read<u16>(&mut cursor) {
      Result<u16, ReadError>.Success { value } => u16.toUsize(value)
      Result<u16, ReadError>.Failure { error } => {
        return Result<BitmapData<'a>, ReadError>.failResult(error)
      }
    }
    let components = match move Cursor<'a>.readComputedArray<(), BdtComponent<'a>>(
      &mut cursor,
      count,
      (),
    ) {
      Result<ComputedArray<'a, (), BdtComponent<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), BdtComponent<'a>>, ReadError>.Failure { error } => {
        return Result<BitmapData<'a>, ReadError>.failResult(error)
      }
    }
    return Result<BitmapData<'a>, ReadError>.succeed(
      BitmapData<'a> {
        metrics: metrics,
        content: BitmapContent<'a>.Composite { value: components },
      },
    )
  }
  let mut length: usize = 0
  let mut dataFormat = BitmapDataFormat.BitAligned
  if format == 17 || format == 18 || format == 19 {
    length = match move Cursor<'a>.read<u32>(&mut cursor) {
      Result<u32, ReadError>.Success { value } => u32.toUsize(value)
      Result<u32, ReadError>.Failure { error } => {
        return Result<BitmapData<'a>, ReadError>.failResult(error)
      }
    }
    dataFormat = BitmapDataFormat.Png
  } else {
    let width = match metrics {
      BitmapMetrics<'a>.Small { value } => u8.toUsize(SmallGlyphMetrics.width(&value))
      BitmapMetrics<'a>.Big { value } => u8.toUsize(BigGlyphMetrics.width(&value))
    }
    let height = match metrics {
      BitmapMetrics<'a>.Small { value } => u8.toUsize(SmallGlyphMetrics.height(&value))
      BitmapMetrics<'a>.Big { value } => u8.toUsize(BigGlyphMetrics.height(&value))
    }

    // All three factors are u8; these products fit on both 32- and 64-bit hosts.
    let rowBits = width * u8.toUsize(location.bitDepth)
    if format == 1 || format == 6 {
      length = ((rowBits + 7) / 8) * height
      dataFormat = BitmapDataFormat.ByteAligned
    } else {
      length = (rowBits * height + 7) / 8
    }
  }
  let bytes = match move Cursor<'a>.readArray<u8>(&mut cursor, length) {
    Result<ScalarArray<'a, u8>, ReadError>.Success { value } => FontData.asBytes(
      &ScalarArray<u8>.offsetData(&value),
    )
    Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => {
      return Result<BitmapData<'a>, ReadError>.failResult(error)
    }
  }
  return Result<BitmapData<'a>, ReadError>.succeed(
    BitmapData<'a> {
      metrics: metrics,
      content: BitmapContent<'a>.Data { format: dataFormat, bytes: bytes },
    },
  )
}

fn bitmapMetrics<'a>(cursor: &mut Cursor<'a>, location: &BitmapLocation<'a>) -> Result<
  BitmapMetrics<'a>,
  ReadError
> {
  let format = location.format
  if format == 5 || format == 19 {
    return match &location.metrics {
      Option<BigGlyphMetrics<'a>>.Some { value } => Result<BitmapMetrics<'a>, ReadError>.succeed(
        BitmapMetrics<'a>.Big { value: value },
      )
      _ => Result<BitmapMetrics<'a>, ReadError>.failResult(
        ReadError.MalformedData { message: "expected metrics from location table" },
      )
    }
  }
  if format == 1 || format == 2 || format == 8 || format == 17 {
    return match move Cursor<'a>.readAtWithArgs<(), SmallGlyphMetrics<'a>>(&mut cursor, ()) {
      Result<SmallGlyphMetrics<'a>, ReadError>.Success { value } => Result<
        BitmapMetrics<'a>,
        ReadError
      >.succeed(BitmapMetrics<'a>.Small { value: value })
      Result<SmallGlyphMetrics<'a>, ReadError>.Failure { error } => Result<
        BitmapMetrics<'a>,
        ReadError
      >.failResult(error)
    }
  }
  return match move Cursor<'a>.readAtWithArgs<(), BigGlyphMetrics<'a>>(&mut cursor, ()) {
    Result<BigGlyphMetrics<'a>, ReadError>.Success { value } => Result<
      BitmapMetrics<'a>,
      ReadError
    >.succeed(BitmapMetrics<'a>.Big { value: value })
    Result<BigGlyphMetrics<'a>, ReadError>.Failure { error } => Result<
      BitmapMetrics<'a>,
      ReadError
    >.failResult(error)
  }
}
