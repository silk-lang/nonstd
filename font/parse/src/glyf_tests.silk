effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: result } => move result
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test failed")
    }
  }
}

effect fn present<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: result } => move result
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test failed")
    }
  }
}

fn none<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

effect fn simple(bytes: &'static [u8], gid: u32) -> SimpleGlyph<'static>
  ! AssertionError<'static> {
  let font = run must(FontRef.new(bytes))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let glyph = run present(run must(Loca.getGlyf(&loca, GlyphId.new(gid), &glyf)))
  return match glyph {
    Glyph<'static>.Simple { value } => value
    _ => {
      run Testing.expect(false, "simple outline")
      return Intrinsic.trap("test failed")
    }
  }
}

effect fn expectPoints(glyph: &SimpleGlyph<'static>, xs: &[i16], ys: &[i16], onCurve: &[bool]) -> ()
  ! AssertionError<'static> {
  let mut iter = SimpleGlyph.points(glyph)
  let mut i: usize = 0
  while i < xs.length {
    let point = run present(PointIter.next(&mut iter))
    run Testing.expect(
      point.x == xs[i] && point.y == ys[i] && point.onCurve == onCurve[i],
      "outline point",
    )
    i = i + 1
  }
  run Testing.expect(none(PointIter.next(&mut iter)), "point count")
}

test effect fn simpleGlyph() -> ()
  ! AssertionError<'static> {
  let glyph = run simple(Fixtures.fontLinearGradientRectColr1(), 0)
  run Testing.expect(SimpleGlyph.numberOfContours(&glyph) == 2, "two contours")
  let ends = SimpleGlyph.endPtsOfContours(&glyph)
  run Testing.expect(
    ScalarArray<u16>.len(&ends) == 2 && (run present(ScalarArray<u16>.get(&ends, 0))) == 3
      && (run present(ScalarArray<u16>.get(&ends, 1))) == 7,
    "contour endpoints",
  )
  run expectPoints(
    &glyph,
    &[5, 5, 45, 45, 10, 40, 40, 10],
    &[0, 100, 100, 0, 5, 5, 95, 95],
    &[true; 8],
  )
}

test effect fn simpleGlyphOverlappingContourFlag() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.fontVazirmatnVarTrimmed()))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let mut gid: usize = 0
  let mut count: usize = 0
  while gid < Loca.len(&loca) {
    if let Option<Glyph<'static>>.Some { value } = move run must(
      Loca.getGlyf(&loca, GlyphId.new(usize.toU32(gid)), &glyf),
    ) {
      if let Glyph<'static>.Simple { value: outline } = value {
        if SimpleGlyph.hasOverlappingContours(&outline) {
          run Testing.expect(gid == 3, "only grave overlaps")
          count = count + 1
        }
      }
    }
    gid = gid + 1
  }
  run Testing.expect(count == 1, "one overlapping simple glyph")
}

test effect fn compositeGlyphOverlappingContourFlag() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.fontVazirmatnVarTrimmed()))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let mut gid: usize = 0
  let mut count: usize = 0
  while gid < Loca.len(&loca) {
    if let Option<Glyph<'static>>.Some { value } = move run must(
      Loca.getGlyf(&loca, GlyphId.new(usize.toU32(gid)), &glyf),
    ) {
      if let Glyph<'static>.Composite { value: outline } = value {
        let mut iter = CompositeGlyph.components(&outline)
        let mut index: usize = 0
        while let Option<Component>.Some { value: part } = move ComponentIter.next(&mut iter) {
          if CompositeGlyphFlags.contains(&part.flags, CompositeGlyphFlags.overlapCompound()) {
            run Testing.expect(gid == 2 && index == 1, "Agrave second component overlaps")
            count = count + 1
          }
          index = index + 1
        }
      }
    }
    gid = gid + 1
  }
  run Testing.expect(count == 1, "one overlapping component")
}

fn put16(bytes: &mut [u8], position: usize, value: u16) -> () {
  bytes[position] = u16.toU8(value / 256)
  bytes[position + 1] = u16.toU8(value & 255)
}

test effect fn compositeInstructionsFlagOnAnyComponent() -> ()
  ! AssertionError<'static> {
  let mut wide: usize = 0
  while wide < 2 {
    let mut flags: usize = 0
    while flags < 4 {
      let mut bytes: [u8; 28] = [0; 28]
      put16(&mut bytes, 0, 65535)
      let mut first: u16 = 34
      let mut last: u16 = 2
      if wide == 1 {
        first = first | 8192
      }
      if (flags & 1) != 0 {
        first = first | 256
      }
      if (flags & 2) != 0 {
        last = last | 256
      }
      put16(&mut bytes, 10, first)
      let mut pos: usize = 12
      if wide == 1 {
        bytes[pos] = 1
        pos = pos + 3
      } else {
        put16(&mut bytes, pos, 1)
        pos = pos + 2
      }
      pos = pos + 2
      put16(&mut bytes, pos, last)
      pos = pos + 2
      put16(&mut bytes, pos, 2)
      pos = pos + 4
      if flags != 0 {
        put16(&mut bytes, pos, 3)
        bytes[pos + 2] = 64
        bytes[pos + 3] = 1
        bytes[pos + 4] = 42
        pos = pos + 5
      }
      let glyph = run must(CompositeGlyph.read(FontData.new(Slice.view<u8>(&bytes, 0, pos))))
      let mut components = CompositeGlyph.components(&glyph)
      let mut count: usize = 0
      while let Option<Component>.Some { value } = move ComponentIter.next(&mut components) {
        count = count + 1
      }
      run Testing.expect(count == 2, "two components")
      let info = CompositeGlyph.countAndInstructions(&glyph)
      run Testing.expect(info.count == 2, "count with instructions")
      run checkInstructions(move info.instructions, flags != 0)
      run checkInstructions(CompositeGlyph.instructions(&glyph), flags != 0)
      flags = flags + 1
    }
    wide = wide + 1
  }
}

effect fn checkInstructions(value: Option<&[u8]>, expected: bool) -> ()
  ! AssertionError<'static> {
  if expected {
    let bytes = run present(move value)
    run Testing.expect(
      bytes.length == 3 && bytes[0] == 64 && bytes[1] == 1 && bytes[2] == 42,
      "instruction bytes",
    )
  } else {
    run Testing.expect(none(move value), "no instructions")
  }
}

test effect fn computeAnchorFlags() -> ()
  ! AssertionError<'static> {
  let anchors = [
    Anchor.Offset { x: -128, y: 127 },
    Anchor.Offset { x: -129, y: 127 },
    Anchor.Offset { x: -1, y: 128 },
    Anchor.Point { base: 255, component: 20 },
    Anchor.Point { base: 256, component: 20 },
  ]
  let expected: [u16; 5] = [2, 3, 3, 0, 1]
  let mut i: usize = 0
  while i < 5 {
    run Testing.expect(
      CompositeGlyphFlags.bits(&Anchor.computeFlags(&anchors[i])) == expected[i],
      "anchor argument width",
    )
    i = i + 1
  }
}

test effect fn computeTransformFlags() -> ()
  ! AssertionError<'static> {
  let one = F2Dot14.one()
  let two = F2Dot14.fromF32(2.0)
  let zero = F2Dot14.zero()
  let transforms = [
    Transform.default(),
    Transform { xx: two, yx: zero, xy: zero, yy: two },
    Transform { xx: two, yx: zero, xy: zero, yy: one },
    Transform { xx: two, yx: zero, xy: one, yy: one },
  ]
  let expected: [u16; 4] = [0, 8, 64, 128]
  let mut i: usize = 0
  while i < 4 {
    run Testing.expect(
      CompositeGlyphFlags.bits(&Transform.computeFlags(&transforms[i])) == expected[i],
      "transform representation",
    )
    i = i + 1
  }
}

test effect fn pointFlagsAndMarkerBits() -> ()
  ! AssertionError<'static> {
  let mut delta = PointFlags.default()
  PointFlags.setMarker(&mut delta, PointMarker.hasDelta())
  let mut x = PointFlags.default()
  PointFlags.setMarker(&mut x, PointMarker.touchedX())
  let mut y = PointFlags.default()
  PointFlags.setMarker(&mut y, PointMarker.touchedY())
  let bits = [
    PointFlags.toBits(PointFlags.offCurveCubic()),
    PointFlags.toBits(PointFlags.onCurve()),
    PointFlags.toBits(delta),
    PointFlags.toBits(x),
    PointFlags.toBits(y),
  ]
  let mut i: usize = 0
  while i < 5 {
    let mut j = i + 1
    while j < 5 {
      run Testing.expect((bits[i] & bits[j]) == 0, "markers and curve bits do not overlap")
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn cubicGlyf() -> ()
  ! AssertionError<'static> {
  let glyph = run simple(Fixtures.fontCubicGlyf(), 2)
  run Testing.expect(SimpleGlyph.numberOfContours(&glyph) == 1, "one contour")
  run expectPoints(
    &glyph,
    &[278, 278, 300, 800, 998, 998],
    &[710, 470, 500, 500, 470, 710],
    &[true, true, false, false, true, true],
  )
}

test effect fn avoidMidpointOverflow() -> ()
  ! AssertionError<'static> {
  let a = F26Dot6.fromBits(1084092352)
  let b = F26Dot6.fromBits(1085243712)
  run Testing.expect(
    F26Dot6.toBits(coordMidpoint<F26Dot6>(a, b)) == i32.wrappingAdd(1084092352, 1085243712) / 2,
    "midpoint wraps without trapping",
  )
}

test effect fn simpleGlyphTruncatedData() -> ()
  ! AssertionError<'static> {
  let glyph = run must(
    SimpleGlyph.read(FontData.new(b"\x00\x64\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")),
  )
  run Testing.expect(
    SimpleGlyph.numberOfContours(&glyph) == 100 && SimpleGlyph.instructionLength(&glyph) == 0,
    "truncated instruction length defaults",
  )
}

test effect fn readPointsFastLongFlags() -> ()
  ! AssertionError<'static> {
  let glyph = run must(
    SimpleGlyph.read(
      FontData.new(
        b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x39\x00\x39\x00\x39\x00",
      ),
    ),
  )
  run Testing.expect(SimpleGlyph.numPoints(&glyph) == 3, "three points")
  let mut points = [Point2<i32> { x: 0, y: 0 }; 3]
  let mut flags = [PointFlags.default(); 3]
  drop run must(SimpleGlyph<'static>.readPointsFast<i32>(&glyph, &mut points, &mut flags))
  let mut iter = SimpleGlyph.points(&glyph)
  let mut i: usize = 0
  while i < 3 {
    let point = run present(PointIter.next(&mut iter))
    run Testing.expect(
      i32.toI16(points[i].x) == point.x && i32.toI16(points[i].y) == point.y,
      "fast and iterator points agree",
    )
    i = i + 1
  }
  run Testing.expect(none(PointIter.next(&mut iter)), "iterator length")
}

test effect fn pointIterRepeatCount255DoesNotOverflow() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 1040] = [0; 1040]
  put16(&mut bytes, 0, 1)
  put16(&mut bytes, 10, 255)
  bytes[14] = 8
  bytes[15] = 255
  let glyph = run must(SimpleGlyph.read(FontData.new(&bytes)))
  let mut iter = SimpleGlyph.points(&glyph)
  let mut count: usize = 0
  while let Option<CurvePoint>.Some { value } = move PointIter.next(&mut iter) {
    count = count + 1
  }
  run Testing.expect(count == 256, "repeat count 255 encodes 256 points")
}

test effect fn readPointsFastDoesNotPanicOnEmptyGlyphWithPadding() -> ()
  ! AssertionError<'static> {
  let glyph = run must(
    SimpleGlyph.read(FontData.new(b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")),
  )
  let mut points: [Point2<f32>; 0] = []
  let mut flags: [PointFlags; 0] = []
  run Testing.expect(SimpleGlyph.numPoints(&glyph) == 0, "empty glyph")
  drop run must(SimpleGlyph<'static>.readPointsFast<f32>(&glyph, &mut points, &mut flags))
}

test effect fn locaAllOffsetsAreAscending() -> ()
  ! AssertionError<'static> {
  run checkLoca(&[], true)
  run checkLoca(&[0], true)
  run checkLoca(&[0, 0], true)
  run checkLoca(&[0, 1], true)
  run checkLoca(&[1, 2, 2, 3, 7], true)
  run checkLoca(&[1, 0], false)
  run checkLoca(&[1, 3, 2], false)
  run checkLoca(&[2, 1, 3], false)
  run checkLoca(&[1, 2, 3, 2, 7], false)
}

effect fn checkLoca(values: &[u16], expected: bool) -> ()
  ! AssertionError<'static> {
  let mut short: [u8; 10] = [0; 10]
  let mut long: [u8; 20] = [0; 20]
  let mut i: usize = 0
  while i < values.length {
    put16(&mut short, i * 2, values[i])
    put16(&mut long, i * 4 + 2, values[i])
    i = i + 1
  }
  let a = run must(Loca.read(FontData.new(Slice.view<u8>(&short, 0, values.length * 2)), false))
  let b = run must(Loca.read(FontData.new(Slice.view<u8>(&long, 0, values.length * 4)), true))
  run Testing.expect(
    Loca.allOffsetsAreAscending(&a) == expected && Loca.allOffsetsAreAscending(&b) == expected,
    "loca ordering",
  )
}
