/// A [GSUB Extension Substitution](https://learn.microsoft.com/en-us/typography/opentype/spec/gsub#ES) subtable
pub union ExtensionSubtable<'a> {
  Single { pub value: ExtensionSubstFormat1<'a, SingleSubst<'a>> },
  Multiple { pub value: ExtensionSubstFormat1<'a, MultipleSubst<'a>> },
  Alternate { pub value: ExtensionSubstFormat1<'a, AlternateSubst<'a>> },
  Ligature { pub value: ExtensionSubstFormat1<'a, LigatureSubst<'a>> },
  Contextual { pub value: ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>> },
  ChainContextual { pub value: ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>> },
  Reverse { pub value: ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>> },
}

impl<'a> Copy for ExtensionSubtable<'a> {}

impl<'a> ExtensionSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let discriminant = match move ExtensionSubstFormat1<'a, ()>.readDiscriminant(data) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match discriminant {
      1 => {
        return match move ExtensionSubstFormat1<'a, SingleSubst<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, SingleSubst<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.Single { value: value })
          Result<ExtensionSubstFormat1<'a, SingleSubst<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ExtensionSubstFormat1<'a, MultipleSubst<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, MultipleSubst<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Multiple { value: value })
          Result<ExtensionSubstFormat1<'a, MultipleSubst<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      3 => {
        return match move ExtensionSubstFormat1<'a, AlternateSubst<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, AlternateSubst<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Alternate { value: value })
          Result<ExtensionSubstFormat1<'a, AlternateSubst<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      4 => {
        return match move ExtensionSubstFormat1<'a, LigatureSubst<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, LigatureSubst<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Ligature { value: value })
          Result<ExtensionSubstFormat1<'a, LigatureSubst<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      5 => {
        return match move ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Contextual { value: value })
          Result<ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      6 => {
        return match move ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(
            ExtensionSubtable<'a>.ChainContextual { value: value },
          )
          Result<ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      8 => {
        return match move ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>.read(data) {
          Result<ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Reverse { value: value })
          Result<ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(discriminant) },
        )
      }
    }
  }

  pub fn ofUnitType(self: &Self) -> ExtensionSubstFormat1<'a, ()> {
    return match &self.* {
      ExtensionSubtable<'a>.Single { value } => ExtensionSubstFormat1<
        'a,
        SingleSubst<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Multiple { value } => ExtensionSubstFormat1<
        'a,
        MultipleSubst<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Alternate { value } => ExtensionSubstFormat1<
        'a,
        AlternateSubst<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Ligature { value } => ExtensionSubstFormat1<
        'a,
        LigatureSubst<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Contextual { value } => ExtensionSubstFormat1<
        'a,
        SubstitutionSequenceContext<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.ChainContextual { value } => ExtensionSubstFormat1<
        'a,
        SubstitutionChainContext<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Reverse { value } => ExtensionSubstFormat1<
        'a,
        ReverseChainSingleSubst<'a>
      >.ofUnitType(&value)
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return ExtensionSubstFormat1<'a, ()>.offsetData(&ExtensionSubtable<'a>.ofUnitType(self))
  }

  pub fn default() -> Self {
    return ExtensionSubtable<'a>.Single {
      value: ExtensionSubstFormat1<'a, SingleSubst<'a>>.default()
    }
  }
}

impl<'a> FontRead<'a, ()> for ExtensionSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ExtensionSubtable<'a>.read(data)
  }
}

/// [Reverse Chaining Contextual Single Substitution Format 1](https://learn.microsoft.com/en-us/typography/opentype/spec/gsub#81-reverse-chaining-contextual-single-substitution-format-1-coverage-based-glyph-contexts)
pub struct ReverseChainSingleSubstFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 8],
}

impl<'a> Copy for ReverseChainSingleSubstFormat1<'a> {}

impl<'a> ReverseChainSingleSubstFormat1<'a> {
  pub fn default() -> Self {
    return ReverseChainSingleSubstFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 8] },
      )
  }

  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 8] = [ByteRange { start: 0, end: 0 }; 8]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let substFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let backtrackGlyphCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(backtrackGlyphCountValue), 2),
    )
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let lookaheadGlyphCountValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(lookaheadGlyphCountValue), 2),
    )
    ranges[5].end = end
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 2))
    ranges[7].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn substFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn substFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of substitution
  /// subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = ReverseChainSingleSubstFormat1<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of glyphs in the backtrack sequence.
  pub fn backtrackGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn backtrackGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of offsets to coverage tables in backtrack sequence, in
  /// glyph sequence order.
  pub fn backtrackCoverageOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn backtrackCoverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      ReverseChainSingleSubstFormat1<'a>.backtrackCoverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn backtrackCoverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of glyphs in lookahead sequence.
  pub fn lookaheadGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn lookaheadGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Array of offsets to coverage tables in lookahead sequence, in
  /// glyph sequence order.
  pub fn lookaheadCoverageOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn lookaheadCoverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset16>.new(
      ReverseChainSingleSubstFormat1<'a>.lookaheadCoverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn lookaheadCoverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Number of glyph IDs in the substituteGlyphIDs array.
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// Array of substitute glyph IDs — ordered by Coverage index.
  pub fn substituteGlyphIds(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[7].start,
      self._fieldRanges[7].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn substituteGlyphIdsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }
}

impl<'a> FontRead<'a, ()> for ReverseChainSingleSubstFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ReverseChainSingleSubstFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for ReverseChainSingleSubstFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for ReverseChainSingleSubstFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[7].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[7].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// SingleSubstFormat3 (ISO/IEC 14496-22:2026).
pub struct SingleSubstFormat3<'a> {
