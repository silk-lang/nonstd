  }
}

/// Ligature2 (ISO/IEC 14496-22:2026).
pub struct Ligature2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for Ligature2<'a> {}

impl<'a> Ligature2<'a> {
  pub fn default() -> Self {
    return Ligature2<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 5
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 5 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    let ligatureGlyphValue = scalarOr<GlyphId24>(data, ranges[0].start, GlyphId24.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let componentCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(usize.saturatingSubtract(u16.toUsize(componentCountValue), 1), 3),
    )
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// glyph ID of ligature to substitute
  pub fn ligatureGlyph(self: &Self) -> GlyphId24 {
    return match move FontData<'a>.readAt<GlyphId24>(&self._fontData, self._fieldRanges[0].start) {
      Result<GlyphId24, ReadError>.Success { value } => value
      Result<GlyphId24, ReadError>.Failure { error } => GlyphId24.new(0)
    }
  }

  pub fn ligatureGlyphByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of components in the ligature
  pub fn componentCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn componentCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of component glyph IDs — start with the second
  /// component, ordered in writing direction
  pub fn componentGlyphIds(self: &Self) -> ScalarArray<'a, GlyphId24> {
    return match move FontData<'a>.readArray<GlyphId24>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId24>, ReadError>.Failure { error } => ScalarArray<
        GlyphId24
      >.empty()
    }
  }

  pub fn componentGlyphIdsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for Ligature2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Ligature2<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for Ligature2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

