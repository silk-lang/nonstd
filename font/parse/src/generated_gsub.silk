/// [Extension Substitution Subtable Format 1](https://learn.microsoft.com/en-us/typography/opentype/spec/gsub#71-extension-substitution-subtable-format-1)
pub struct ExtensionSubstFormat1<'a, T: FontRead<'a, ()>> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a, T: FontRead<'a, ()>> Copy for ExtensionSubstFormat1<'a, T> {}

impl<'a, T> ExtensionSubstFormat1<'a, T> {
  pub fn default() -> Self {
    return ExtensionSubstFormat1<'a, T>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let substFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let extensionLookupTypeValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let extensionOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier. Set to 1.
  pub fn substFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn substFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Lookup type of subtable referenced by extensionOffset (that is,
  /// the extension subtable).
  pub fn extensionLookupType(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn extensionLookupTypeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to the extension subtable, of lookup type
  /// extensionLookupType, relative to the start of the
  /// ExtensionSubstFormat1 subtable.
  pub fn extensionOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn extension(self: &Self) -> Result<T, ReadError> {
    let offset = ExtensionSubstFormat1<'a, T>.extensionOffset(self)
    return resolveWithArgs<(), T, Offset32>(offset, self._fontData, ())
  }

  pub fn extensionOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a, T: FontRead<'a, ()>> FontRead<'a, ()> for ExtensionSubstFormat1<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ExtensionSubstFormat1<'a, T>.read(data)
  }
}

