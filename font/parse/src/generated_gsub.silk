    end = usize.saturatingAdd(end, 3)
    ranges[6].end = end
    let glyphCountValue = scalarOr<Uint24>(data, ranges[6].start, Uint24.new(0))
    ranges[7].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(glyphCountValue)), 3),
