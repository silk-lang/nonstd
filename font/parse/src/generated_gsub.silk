/// LigatureSet2 (ISO/IEC 14496-22:2026).
pub struct LigatureSet2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for LigatureSet2<'a> {}

impl<'a> LigatureSet2<'a> {
  pub fn default() -> Self {
    return LigatureSet2<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let ligatureCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(ligatureCountValue), 3))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of Ligature tables
  pub fn ligatureCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn ligatureCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of offsets to Ligature tables. Offsets are from beginning
  /// of LigatureSet2 table, ordered by preference.
  pub fn ligatureOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn ligatures(self: &Self) -> ArrayOfOffsets<'a, (), Ligature2<'a>, Offset24> {
    return ArrayOfOffsets<'a, (), Ligature2<'a>, Offset24>.new(
      LigatureSet2<'a>.ligatureOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn ligatureOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for LigatureSet2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LigatureSet2<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for LigatureSet2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
