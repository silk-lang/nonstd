    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[2].end = end
    let deltaGlyphIdValue = scalarOr<Int24>(data, ranges[2].start, Int24.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
