    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 2))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of glyph IDs in the alternateGlyphIDs array
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of alternate glyph IDs, in arbitrary order
  pub fn alternateGlyphIds(self: &Self) -> ScalarArray<'a, GlyphId16> {
    return match move FontData<'a>.readArray<GlyphId16>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => ScalarArray<
        GlyphId16
      >.empty()
    }
  }

  pub fn alternateGlyphIdsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

