pub type OriginalSubstitutionLookupList<'a> = LookupList<'a, SubstitutionLookup<'a>>

pub type SubstitutionLookupList2<'a> = LookupList2<'a, SubstitutionLookup<'a>>

pub type SubstitutionSequenceContext<'a> = SequenceContext<'a>

pub type SubstitutionChainContext<'a> = ChainedSequenceContext<'a>

pub type SubstitutionLookupList<'a> = SelectedLookupList<'a, SubstitutionLookup<'a>>

impl<'a> Gsub<'a> {
  fn selectOffset(
    self: &Self,
    original: Nullable<Offset16>,
    extended: Option<Nullable<Offset32>>,
  ) -> Result<HeaderOffset, ReadError> {
    return HeaderOffset.select(
      original,
      move extended,
      MajorMinor.compatible(&Gsub<'a>.version(self), MajorMinor.new(1, 2)),
    )
  }

  pub fn scriptList(self: &Self) -> Result<ScriptList<'a>, ReadError> {
    let selected = match move Gsub<'a>.selectOffset(
      self,
      Gsub<'a>.scriptListOffset(self),
      Gsub<'a>.scriptList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<ScriptList<'a>, ReadError>.failResult(error)
      }
    }
    return resolve<ScriptList<'a>, Offset32>(selected.offset, self._fontData)
  }

  pub fn originalScriptList(self: &Self) -> Option<Result<ScriptList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), ScriptList<'a>, Offset16>(
      &Gsub<'a>.scriptListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn featureList(self: &Self) -> Result<FeatureList<'a>, ReadError> {
    let selected = match move Gsub<'a>.selectOffset(
      self,
      Gsub<'a>.featureListOffset(self),
      Gsub<'a>.featureList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<FeatureList<'a>, ReadError>.failResult(error)
      }
    }
    return resolve<FeatureList<'a>, Offset32>(selected.offset, self._fontData)
  }

  pub fn originalFeatureList(self: &Self) -> Option<Result<FeatureList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), FeatureList<'a>, Offset16>(
      &Gsub<'a>.featureListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn originalLookupList(self: &Self) -> Option<
    Result<OriginalSubstitutionLookupList<'a>, ReadError>
  > {
    return resolveNullableWithArgs<(), OriginalSubstitutionLookupList<'a>, Offset16>(
      &Gsub<'a>.lookupListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn lookupList(self: &Self) -> Result<SubstitutionLookupList<'a>, ReadError> {
    let selected = match move Gsub<'a>.selectOffset(
      self,
      Gsub<'a>.lookupListOffset(self),
      Gsub<'a>.lookupList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<SubstitutionLookupList<'a>, ReadError>.failResult(error)
      }
    }
    if selected.extended {
      return match move resolve<SubstitutionLookupList2<'a>, Offset32>(
        selected.offset,
        self._fontData,
      ) {
        Result<SubstitutionLookupList2<'a>, ReadError>.Success { value } => Result<
          SubstitutionLookupList<'a>,
          ReadError
        >.succeed(SelectedLookupList<'a, SubstitutionLookup<'a>>.Extended { value: value })
        Result<SubstitutionLookupList2<'a>, ReadError>.Failure { error } => Result<
          SubstitutionLookupList<'a>,
          ReadError
        >.failResult(error)
      }
    }
    return match move resolve<OriginalSubstitutionLookupList<'a>, Offset32>(
      selected.offset,
      self._fontData,
    ) {
      Result<OriginalSubstitutionLookupList<'a>, ReadError>.Success { value } => Result<
        SubstitutionLookupList<'a>,
        ReadError
      >.succeed(SelectedLookupList<'a, SubstitutionLookup<'a>>.Original { value: value })
      Result<OriginalSubstitutionLookupList<'a>, ReadError>.Failure { error } => Result<
        SubstitutionLookupList<'a>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a, T: FontRead<'a, ()>> ExtensionLookup<'a, T> for ExtensionSubstFormat1<'a, T> {
  fn extension(self: &Self) -> Result<T, ReadError> {
    return ExtensionSubstFormat1<'a, T>.extension(self)
  }
}

pub union SubstitutionSubtables<'a> {
  Single { pub value: Subtables<'a, SingleSubst<'a>, ExtensionSubstFormat1<'a, SingleSubst<'a>>> },
  Multiple {
    pub value: Subtables<'a, MultipleSubst<'a>, ExtensionSubstFormat1<'a, MultipleSubst<'a>>>
  },
  Alternate {
    pub value: Subtables<'a, AlternateSubst<'a>, ExtensionSubstFormat1<'a, AlternateSubst<'a>>>
  },
  Ligature {
    pub value: Subtables<'a, LigatureSubst<'a>, ExtensionSubstFormat1<'a, LigatureSubst<'a>>>
  },
  Contextual {
    pub value: Subtables<
      'a,
      SubstitutionSequenceContext<'a>,
      ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>
    >
  },
  ChainContextual {
    pub value: Subtables<
      'a,
      SubstitutionChainContext<'a>,
      ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>
    >
  },
  Reverse {
    pub value: Subtables<
      'a,
      ReverseChainSingleSubst<'a>,
      ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>
    >
  },
  EmptyExtension,
}

impl<'a> Copy for SubstitutionSubtables<'a> {}

impl<'a> SubstitutionLookup<'a> {
  pub fn lookupFlag(self: &Self) -> LookupFlag {
    return Lookup<'a, ()>.lookupFlag(&SubstitutionLookup<'a>.ofUnitType(self))
  }

  pub fn lookupType(self: &Self) -> u16 {
    return Lookup<'a, ()>.lookupType(&SubstitutionLookup<'a>.ofUnitType(self))
  }

  pub fn markFilteringSet(self: &Self) -> Option<u16> {
    return Lookup<'a, ()>.markFilteringSet(&SubstitutionLookup<'a>.ofUnitType(self))
  }

  pub fn subtables(self: &Self) -> Result<SubstitutionSubtables<'a>, ReadError> {
    let raw = SubstitutionLookup<'a>.ofUnitType(self)
    let offsets = Lookup<'a, ()>.subtableOffsets(&raw)
    let data = Lookup<'a, ()>.offsetData(&raw)
    let mut lookupType = Lookup<'a, ()>.lookupType(&raw)
    let mut extended = false
    if lookupType == 7 {
      let mut index: usize = 0
      let mut found = false
      while index < ScalarArray<Offset16>.len(&offsets) {
        let offset = ScalarArray<Offset16>.get(&offsets, index)
          |> Option<Offset16>.unwrapOr(Offset16.new(0))
        if let Result<ExtensionSubstFormat1<'a, ()>, ReadError>.Success { value } = move resolve<
          ExtensionSubstFormat1<'a, ()>,
          Offset16
        >(offset, data) {
          lookupType = ExtensionSubstFormat1<'a, ()>.extensionLookupType(&value)
          found = true
          break
        }
        index = index + 1
      }
      if !found {
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.EmptyExtension,
        )
      }
      extended = true
    }
    match lookupType {
      1 => {
        let mut array = Subtables<
          'a,
          SingleSubst<'a>,
          ExtensionSubstFormat1<'a, SingleSubst<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<'a, SingleSubst<'a>, ExtensionSubstFormat1<'a, SingleSubst<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Single { value: array },
        )
      }
      2 => {
        let mut array = Subtables<
          'a,
          MultipleSubst<'a>,
          ExtensionSubstFormat1<'a, MultipleSubst<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            MultipleSubst<'a>,
            ExtensionSubstFormat1<'a, MultipleSubst<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Multiple { value: array },
        )
      }
      3 => {
        let mut array = Subtables<
          'a,
          AlternateSubst<'a>,
          ExtensionSubstFormat1<'a, AlternateSubst<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            AlternateSubst<'a>,
            ExtensionSubstFormat1<'a, AlternateSubst<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Alternate { value: array },
        )
      }
      4 => {
        let mut array = Subtables<
          'a,
          LigatureSubst<'a>,
          ExtensionSubstFormat1<'a, LigatureSubst<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            LigatureSubst<'a>,
            ExtensionSubstFormat1<'a, LigatureSubst<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Ligature { value: array },
        )
      }
      5 => {
        let mut array = Subtables<
          'a,
          SubstitutionSequenceContext<'a>,
          ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            SubstitutionSequenceContext<'a>,
            ExtensionSubstFormat1<'a, SubstitutionSequenceContext<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Contextual { value: array },
        )
      }
      6 => {
        let mut array = Subtables<
          'a,
          SubstitutionChainContext<'a>,
          ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            SubstitutionChainContext<'a>,
            ExtensionSubstFormat1<'a, SubstitutionChainContext<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.ChainContextual { value: array },
        )
      }
      8 => {
        let mut array = Subtables<
          'a,
          ReverseChainSingleSubst<'a>,
          ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            ReverseChainSingleSubst<'a>,
            ExtensionSubstFormat1<'a, ReverseChainSingleSubst<'a>>
          >.newExt(offsets, data)
        }
        return Result<SubstitutionSubtables<'a>, ReadError>.succeed(
          SubstitutionSubtables<'a>.Reverse { value: array },
        )
      }
      _ => {
        return Result<SubstitutionSubtables<'a>, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(lookupType) },
        )
      }
    }
  }
}

impl<'a> MultipleSubst<'a> {
  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    return match &self.* {
      MultipleSubst<'a>.Format1 { value } => MultipleSubstFormat1<'a>.coverage(&value)
      MultipleSubst<'a>.Format2 { value } => MultipleSubstFormat2<'a>.coverage(&value)
    }
  }
}
