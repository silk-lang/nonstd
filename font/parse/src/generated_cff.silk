    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph in range.
  pub fn first(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Glyphs left in range (excluding first).
  pub fn nLeft(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 2)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for CharsetRange2<'a> {
  fn rawByteLen() -> usize {
    return 4
  }
}

impl<'a> ComputeSize<()> for CharsetRange2<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(4)
  }
}

impl<'a> FontReadAt<'a, ()> for CharsetRange2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return CharsetRange2<'a>.readAt(data, position, ())
  }
}

/// Range struct for Encoding format 1.
pub struct EncodingRange1<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for EncodingRange1<'a> {}

impl<'a> EncodingRange1<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 2 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First code in range.
  pub fn first(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, (self.position + 0)) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  /// Codes left in range (excluding first).
  pub fn nLeft(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, (self.position + 1)) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for EncodingRange1<'a> {
  fn rawByteLen() -> usize {
    return 2
  }
}

impl<'a> ComputeSize<()> for EncodingRange1<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(2)
  }
}

impl<'a> FontReadAt<'a, ()> for EncodingRange1<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return EncodingRange1<'a>.readAt(data, position, ())
  }
}

