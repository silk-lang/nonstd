      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// First glyph index in range.
  pub fn first(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// FD index for all glyphs in range.
  pub fn fd(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, (self.position + 2)) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for FdSelectRange3<'a> {
  fn rawByteLen() -> usize {
    return 3
  }
}

impl<'a> ComputeSize<()> for FdSelectRange3<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(3)
  }
}

impl<'a> FontReadAt<'a, ()> for FdSelectRange3<'a> {
