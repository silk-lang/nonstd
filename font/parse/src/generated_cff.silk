/// FdSelect format 4.
pub struct FdSelectFormat4<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for FdSelectFormat4<'a> {}

impl<'a> FdSelectFormat4<'a> {
  pub fn minSize() -> usize {
    return 9
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 9 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 1)
    ranges[0].end = end
    let formatValue = scalarOr<u8>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let nRangesValue = scalarOr<u32>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u32.toUsize(nRangesValue), 6))
    ranges[2].end = end
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let sentinelValue = scalarOr<u32>(data, ranges[3].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format = 4.
  pub fn format(self: &Self) -> u8 {
    return match move FontData<'a>.readAt<u8>(&self._fontData, self._fieldRanges[0].start) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ranges.
  pub fn nRanges(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[1].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn nRangesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Range4 array.
  pub fn ranges(self: &Self) -> ComputedArray<'a, (), FdSelectRange4<'a>> {
    return match move recordArray<FdSelectRange4<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ComputedArray<'a, (), FdSelectRange4<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), FdSelectRange4<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), FdSelectRange4<'a>>.empty(())
    }
  }

  pub fn rangesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Sentinel GID. Set equal to the number of glyphs in the font.
  pub fn sentinel(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[3].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn sentinelByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for FdSelectFormat4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return FdSelectFormat4<'a>.read(data)
  }
}

impl<'a> Format<u8> for FdSelectFormat4<'a> {
  fn formatValue() -> u8 {
    return 4
  }
}

impl<'a> MinByteRange<'a> for FdSelectFormat4<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

