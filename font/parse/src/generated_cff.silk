/// Charset with custom glyph id to string id mappings.
pub union CustomCharset<'a> {
  Format0 { pub value: CharsetFormat0<'a> },
  Format1 { pub value: CharsetFormat1<'a> },
  Format2 { pub value: CharsetFormat2<'a> },
}

impl<'a> Copy for CustomCharset<'a> {}

impl<'a> CustomCharset<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u8>(&data, 0) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      0 => {
        return match move CharsetFormat0<'a>.read(data) {
          Result<CharsetFormat0<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CustomCharset<'a>.Format0 { value: value })
          Result<CharsetFormat0<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      1 => {
        return match move CharsetFormat1<'a>.read(data) {
          Result<CharsetFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CustomCharset<'a>.Format1 { value: value })
          Result<CharsetFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move CharsetFormat2<'a>.read(data) {
          Result<CharsetFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CustomCharset<'a>.Format2 { value: value })
          Result<CharsetFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u8.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      CustomCharset<'a>.Format0 { value } => CharsetFormat0<'a>.offsetData(&value)
      CustomCharset<'a>.Format1 { value } => CharsetFormat1<'a>.offsetData(&value)
      CustomCharset<'a>.Format2 { value } => CharsetFormat2<'a>.offsetData(&value)
    }
  }

  /// Format; =0
  pub fn format(self: &Self) -> u8 {
    return match &self.* {
      CustomCharset<'a>.Format0 { value } => CharsetFormat0<'a>.format(&value)
      CustomCharset<'a>.Format1 { value } => CharsetFormat1<'a>.format(&value)
      CustomCharset<'a>.Format2 { value } => CharsetFormat2<'a>.format(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for CustomCharset<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CustomCharset<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for CustomCharset<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      CustomCharset<'a>.Format0 { value } => MinByteRange.minByteRange(&value)
      CustomCharset<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      CustomCharset<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      CustomCharset<'a>.Format0 { value } => MinByteRange.minTableBytes(&value)
      CustomCharset<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      CustomCharset<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> CustomCharset<'a> {
  pub fn default() -> Self {
    return CustomCharset<'a>.Format0 { value: CharsetFormat0<'a>.default() }
  }
}

