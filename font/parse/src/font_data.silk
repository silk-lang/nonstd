//! Borrowed font bytes. Every slice is checked before constructing a view.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_types.lib { Scalar, BigEndian, readScalar, rawByteLen }
import read { ReadError, FontRead }
import array { ScalarArray }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.num.u8
import silk.num.u32

pub struct FontData<'a> {
  bytes: &'a [u8],
}

impl<'a> Copy for FontData<'a> {}

impl<'data> FontData<'data> {
  pub fn new<'a>(bytes: &'a [u8]) -> FontData<'a> {
    return FontData { bytes: bytes }
  }

  pub fn len(self: &Self) -> usize {
    return self.bytes.length
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.bytes.length == 0
  }

  pub fn asBytes<'a>(self: &FontData<'a>) -> &'a [u8] {
    return self.bytes
  }

  pub fn slice<'a>(self: &FontData<'a>, start: usize, end: usize) -> Option<FontData<'a>> {
    if start > end || end > self.bytes.length {
      return Option<FontData<'a>>.None
    }
    return Option<FontData<'a>>.some(FontData.new(Slice.view<u8>(self.bytes, start, end - start)))
  }

  pub fn splitOff<'a>(self: &FontData<'a>, pos: usize) -> Option<FontData<'a>> {
    return FontData.slice(self, pos, self.bytes.length)
  }

  pub fn takeUpTo<'a>(self: &mut FontData<'a>, pos: usize) -> Option<FontData<'a>> {
    if pos > self.bytes.length {
      return Option<FontData<'a>>.None
    }
    let head = FontData.new(Slice.view<u8>(self.bytes, 0, pos))
    self.bytes = Slice.view<u8>(self.bytes, pos, self.bytes.length - pos)
    return Option<FontData<'a>>.some(head)
  }

  @inlineAlways
  pub fn readAt<T: Scalar>(self: &Self, offset: usize) -> Result<T, ReadError> {
    let size = rawByteLen<T>()
    if offset > self.bytes.length || size > self.bytes.length - offset {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return match move readScalar<T>(Slice.view<u8>(self.bytes, offset, size)) {
      Option<T>.Some { value } => Result<T, ReadError>.succeed(move value)
      Option<T>.None => Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn readBeAt<T: Scalar>(self: &Self, offset: usize) -> Result<BigEndian<T>, ReadError> {
    let size = rawByteLen<T>()
    if offset > self.bytes.length || size > self.bytes.length - offset {
      return Result<BigEndian<T>, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return match move BigEndian<T>.fromSlice(Slice.view<u8>(self.bytes, offset, size)) {
      Option<BigEndian<T>>.Some { value } => Result<BigEndian<T>, ReadError>.succeed(value)
      Option<BigEndian<T>>.None => Result<BigEndian<T>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn cursor<'a>(self: &FontData<'a>) -> Cursor<'a> {
    return Cursor { pos: 0, data: self.* }
  }

  pub fn readArray<T: Scalar>(self: &Self, start: usize, end: usize) -> Result<
    ScalarArray<'data, T>,
    ReadError
  > {
    return match move FontData.slice(self, start, end) {
      Option<FontData<'data>>.Some { value } => ScalarArray<T>.new(value)
      Option<FontData<'data>>.None => Result<ScalarArray<'data, T>, ReadError>.failResult(
        ReadError.OutOfBounds,
      )
    }
  }
}

impl<'a> FontRead<'a, ()> for FontData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Result<Self, ReadError>.succeed(data)
  }
}

pub struct Cursor<'a> {
  pub pos: usize,
  data: FontData<'a>,
}

impl<'a> Copy for Cursor<'a> {}

impl<'data> Cursor<'data> {
  pub fn advanceBy(self: &mut Self, count: usize) -> () {
    self.pos = usize.saturatingAdd(self.pos, count)
  }

  pub fn advance<T: Scalar>(self: &mut Self) -> () {
    Cursor.advanceBy(&mut self, rawByteLen<T>())
  }

  @inlineAlways
  pub fn read<T: Scalar>(self: &mut Self) -> Result<T, ReadError> {
    let result = FontData<'data>.readAt<T>(&self.data, self.pos)
    Cursor<'data>.advance<T>(&mut self)
    return move result
  }

  pub fn readBe<T: Scalar>(self: &mut Self) -> Result<BigEndian<T>, ReadError> {
    let result = FontData<'data>.readBeAt<T>(&self.data, self.pos)
    Cursor<'data>.advance<T>(&mut self)
    return move result
  }

  pub fn position(self: &Self) -> Result<usize, ReadError> {
    if self.pos > FontData.len(&self.data) {
      return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<usize, ReadError>.succeed(self.pos)
  }

  pub fn remainingBytes(self: &Self) -> usize {
    return usize.saturatingSubtract(FontData.len(&self.data), self.pos)
  }

  pub fn remaining<'a>(self: &Cursor<'a>) -> Option<FontData<'a>> {
    return FontData.splitOff(&self.data, self.pos)
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.pos >= FontData.len(&self.data)
  }

  pub fn readU32Var(self: &mut Self) -> Result<u32, ReadError> {
    let first = match move Cursor<'data>.read<u8>(&mut self) {
      Result<u8, ReadError>.Success { value } => u8.toU32(value)
      Result<u8, ReadError>.Failure { error } => {
        return Result<u32, ReadError>.failResult(error)
      }
    }
    let mut value = first
    let mut remaining: usize = 0
    if first >= 240 {
      value = 0
      remaining = 4
    } else if first >= 224 {
      value = first - 224
      remaining = 3
    } else if first >= 192 {
      value = first - 192
      remaining = 2
    } else if first >= 128 {
      value = first - 128
      remaining = 1
    }
    while remaining > 0 {
      let next = match move Cursor<'data>.read<u8>(&mut self) {
        Result<u8, ReadError>.Success { value: byte } => u8.toU32(byte)
        Result<u8, ReadError>.Failure { error } => {
          return Result<u32, ReadError>.failResult(error)
        }
      }
      value = u32.shiftLeft(value, 8) | next
      remaining = remaining - 1
    }
    return Result<u32, ReadError>.succeed(value)
  }
}

