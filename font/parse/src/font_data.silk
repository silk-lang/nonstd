import read { FontReadAt, ComputeSize, readWithArgs, readAtWithArgs, computeSize }
import array { ComputedArray }

impl<'a> FontData<'a> {
  pub fn readWithArgs<Args, T: FontRead<'a, Args>>(
    self: &Self,
    start: usize,
    end: usize,
    args: Args,
  ) -> Result<T, ReadError> {
    return match move FontData.slice(self, start, end) {
      Option<FontData<'a>>.Some { value } => readWithArgs<Args, T>(value, move args)
      Option<FontData<'a>>.None => Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn readRefAt<T: FontReadAt<'a, ()> + ComputeSize<()>>(self: &Self, offset: usize) -> Result<
    T,
    ReadError
  > {
    let size = match move computeSize<(), T>(()) {
      Result<usize, ReadError>.Success { value } => value
      Result<usize, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    if offset > FontData.len(self) || size > FontData.len(self) - offset {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return readAtWithArgs<(), T>(self.*, offset, ())
  }
}

impl<'a> Cursor<'a> {
  pub fn readArray<T: Scalar>(self: &mut Self, count: usize) -> Result<
    ScalarArray<'a, T>,
    ReadError
  > {
    let size = match move usize.checkedMultiply(count, rawByteLen<T>()) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<ScalarArray<'a, T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move usize.checkedAdd(self.pos, size) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<ScalarArray<'a, T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let result = FontData<'a>.readArray<T>(&self.data, self.pos, end)
    Cursor.advanceBy(&mut self, size)
    return move result
  }

  pub fn readAtWithArgs<Args: Copy, T: FontReadAt<'a, Args> + ComputeSize<Args>>(
    self: &mut Self,
    args: Args,
  ) -> Result<T, ReadError> {
    let size = match move computeSize<Args, T>(args) {
      Result<usize, ReadError>.Success { value } => value
      Result<usize, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    if self.pos > FontData.len(&self.data) || size > FontData.len(&self.data) - self.pos {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let result = readAtWithArgs<Args, T>(self.data, self.pos, args)
    Cursor.advanceBy(&mut self, size)
    return move result
  }

  pub fn readComputedArray<Args: Copy, T: FontReadAt<'a, Args> + ComputeSize<Args>>(
    self: &mut Self,
    count: usize,
    args: Args,
  ) -> Result<ComputedArray<'a, Args, T>, ReadError> {
    let width = match move computeSize<Args, T>(args) {
      Result<usize, ReadError>.Success { value } => value
      Result<usize, ReadError>.Failure { error } => {
        return Result<ComputedArray<'a, Args, T>, ReadError>.failResult(error)
      }
    }
    let size = match move usize.checkedMultiply(count, width) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<ComputedArray<'a, Args, T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move usize.checkedAdd(self.pos, size) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<ComputedArray<'a, Args, T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let result = ComputedArray<'a, Args, T>.new(self.data, self.pos, end, args)
    Cursor.advanceBy(&mut self, size)
    return move result
  }
}
