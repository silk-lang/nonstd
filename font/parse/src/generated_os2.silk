impl<'a> FontRead<'a, ()> for Os2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Os2<'a>.read(data)
  }
}

impl<'a> TopLevelTable for Os2<'a> {
  fn tag() -> Tag {
    return Os2<'a>.tag()
  }
}

impl<'a> MinByteRange<'a> for Os2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[29].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[29].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}
