import tables.trak { Trak, TrackData, TrackTableEntry }
import tables.ankr { Ankr, AnchorPoint }
import tables.feat { Feat, FeatureName, SettingNameArray, SettingName }
import tables.ltag { Ltag, TagIndex, TagIndices }
import font_data { FontData }
import read { ReadError }
import array { ScalarArray, ComputedArray }
import font_types.lib { Fixed, NameId, GlyphId }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.slice { Slice }
import silk.num.usize

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "AAT fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "AAT value exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn none<T>(result: Option<T>) -> bool {
  return match move result {
    Option<T>.None => true
    _ => false
  }
}

fn trakBytes() -> &'static [u8] {
  return b"\x00\x01\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x00\x00\x03\x00\x02\x00\x00\x00\x2c\xff\xff\x00\x00\x01\x00\x00\x34\x00\x00\x00\x00\x01\x02\x00\x3c\x00\x01\x00\x00\x01\x01\x00\x38\x00\x0c\x00\x00\x00\x18\x00\x00\xff\xf1\xff\xf9\x00\x32\x00\x14\x00\x00\x00\x00"
}

effect fn horizontal<'a>(trak: &Trak<'a>) -> TrackData<'a>
  ! AssertionError<'static> {
  return run must(run some(Trak.horiz(trak)))
}

test effect fn trakParseHeader() -> ()
  ! AssertionError<'static> {
  let trak = run must(Trak.read(FontData.new(trakBytes())))
  let version = Trak.version(&trak)
  run Testing.expect(version.major == 1 && version.minor == 0, "tracking version")
  drop run horizontal(&trak)
  run Testing.expect(none(Trak.vert(&trak)), "no vertical tracking")
}

effect fn checkPerSize<'a>(trak: &Trak<'a>, truncated: bool) -> ()
  ! AssertionError<'static> {
  let horiz = run horizontal(trak)
  let tracks = TrackData.trackTable(&horiz)
  let expected: [i16; 6] = [-15, -7, 0, 0, 50, 20]
  let mut i: usize = 0
  while i < 3 {
    let track = run must(ComputedArray<'a, (), TrackTableEntry<'a>>.get(&tracks, i))
    let result = TrackTableEntry.perSizeValues(
      &track,
      Trak.offsetData(trak),
      TrackData.nSizes(&horiz),
    )
    if truncated && i == 1 {
      run Testing.expect(none(move result), "truncated per-size entry")
    } else {
      let values = run some(move result)
      let mut j: usize = 0
      while j < 2 {
        run Testing.expect(
          (run some(ScalarArray<i16>.get(&values, j))) == expected[i * 2 + j],
          "per-size tracking value",
        )
        j = j + 1
      }
    }
    i = i + 1
  }
}

test effect fn trakParseTracks() -> ()
  ! AssertionError<'static> {
  let trak = run must(Trak.read(FontData.new(trakBytes())))
  let horiz = run horizontal(&trak)
  let tracks = TrackData.trackTable(&horiz)
  let values: [i32; 3] = [-65536, 0, 65536]
  let names: [u16; 3] = [256, 258, 257]
  let offsets: [u16; 3] = [52, 60, 56]
  run Testing.expect(
    ComputedArray<'static, (), TrackTableEntry<'static>>.len(&tracks) == 3,
    "three tracks",
  )
  let mut i: usize = 0
  while i < 3 {
    let track = run must(ComputedArray<'static, (), TrackTableEntry<'static>>.get(&tracks, i))
    run Testing.expect(
      Fixed.toBits(TrackTableEntry.track(&track)) == values[i]
        && NameId.toU16(TrackTableEntry.nameIndex(&track)) == names[i]
        && TrackTableEntry.offset(&track) == offsets[i],
      "track fields",
    )
    i = i + 1
  }
  run checkPerSize(&trak, false)
}

test effect fn trakParsePerSizeValues() -> ()
  ! AssertionError<'static> {
  let trak = run must(Trak.read(FontData.new(trakBytes())))
  run checkPerSize(&trak, false)
}

test effect fn trakParseSizes() -> ()
  ! AssertionError<'static> {
  let trak = run must(Trak.read(FontData.new(trakBytes())))
  let horiz = run horizontal(&trak)
  let sizes = run some(TrackData.sizeTable(&horiz, Trak.offsetData(&trak)))
  run Testing.expect(
    ScalarArray<Fixed>.len(&sizes) == 2
      && Fixed.toI32(run some(ScalarArray<Fixed>.get(&sizes, 0))) == 12
      && Fixed.toI32(run some(ScalarArray<Fixed>.get(&sizes, 1))) == 24,
    "tracking sizes",
  )
}

test effect fn trakInsufficientData() -> ()
  ! AssertionError<'static> {
  let bytes = trakBytes()
  let trak = run must(Trak.read(FontData.new(Slice.view<u8>(bytes, 0, bytes.length - 1))))
  run checkPerSize(&trak, true)
}

effect fn firstTrack<'a>(data: &TrackData<'a>) -> TrackTableEntry<'a>
  ! AssertionError<'static> {
  return run must(ComputedArray<'a, (), TrackTableEntry<'a>>.get(&TrackData.trackTable(data), 0))
}

test effect fn trakBadOffset() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 64] = [0; 64]
  let source = trakBytes()
  let mut i: usize = 0
  while i < 64 {
    bytes[i] = source[i]
    i = i + 1
  }
  bytes[26] = 255
  let trak = run must(Trak.read(FontData.new(&bytes)))
  let horiz = run horizontal(&trak)
  let first = run firstTrack(&horiz)
  run Testing.expect(
    none(TrackTableEntry.perSizeValues(&first, Trak.offsetData(&trak), TrackData.nSizes(&horiz))),
    "out-of-bounds track offset",
  )
}

fn featBytes() -> &'static [u8] {
  return b"\x00\x01\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x3c\x00\x00\x01\x04\x00\x01\x00\x01\x00\x00\x00\x40\x00\x00\x01\x00\x00\x03\x00\x03\x00\x00\x00\x44\x80\x00\x01\x06\x00\x06\x00\x02\x00\x00\x00\x50\xc0\x01\x01\x02\x00\x00\x01\x05\x00\x02\x01\x01\x00\x00\x01\x0c\x00\x03\x01\x08\x00\x04\x01\x09\x00\x00\x01\x03\x00\x01\x01\x04"
}

test effect fn featExample() -> ()
  ! AssertionError<'static> {
  let feat = run must(Feat.read(FontData.new(featBytes())))
  let names = Feat.names(&feat)
  let ids: [u16; 4] = [0, 1, 3, 6]
  let counts: [u16; 4] = [1, 1, 3, 2]
  let flags: [u16; 4] = [0, 0, 32768, 49153]
  let nameIds: [u16; 4] = [260, 256, 262, 258]
  let settings: [u16; 7] = [0, 2, 0, 3, 4, 0, 1]
  let settingNames: [u16; 7] = [261, 257, 268, 264, 265, 259, 260]
  let mut i: usize = 0
  let mut at: usize = 0
  while i < 4 {
    let record = run must(ComputedArray<'static, (), FeatureName<'static>>.get(&names, i))
    run Testing.expect(
      FeatureName.feature(&record) == ids[i] && FeatureName.nSettings(&record) == counts[i]
        && FeatureName.featureFlags(&record) == flags[i]
        && NameId.toU16(FeatureName.nameIndex(&record)) == nameIds[i],
      "feature fields",
    )
    run Testing.expect(FeatureName.isExclusive(&record) == (i >= 2), "exclusive feature")
    let mut defaultIndex: u16 = 0
    if i == 3 {
      defaultIndex = 1
    }
    run Testing.expect(FeatureName.defaultSettingIndex(&record) == defaultIndex, "default setting")
    let array = run must(FeatureName.settingTable(&record, Feat.offsetData(&feat)))
    let values = SettingNameArray.settings(&array)
    let mut j: usize = 0
    while j < ComputedArray<'static, (), SettingName<'static>>.len(&values) {
      let setting = run must(ComputedArray<'static, (), SettingName<'static>>.get(&values, j))
      run Testing.expect(
        SettingName.setting(&setting) == settings[at]
          && NameId.toU16(SettingName.nameIndex(&setting)) == settingNames[at],
        "setting and name",
      )
      at = at + 1
      j = j + 1
    }
    i = i + 1
  }
  run Testing.expect(at == 7, "all setting names")
}

test effect fn featFind() -> ()
  ! AssertionError<'static> {
  let feat = run must(Feat.read(FontData.new(featBytes())))
  let mut i: u16 = 0
  while i < 10 {
    let result = Feat.find(&feat, i)
    if i == 0 || i == 1 || i == 3 || i == 6 {
      let name = run some(move result)
      run Testing.expect(FeatureName.feature(&name) == i, "feature found")
    } else {
      run Testing.expect(none(move result), "feature missing")
    }
    i = i + 1
  }
}

test effect fn anchorPoints() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Ankr.read(
      FontData.new(
        b"\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x16\x00\x00\x00\x00\x00\x08\x00\x18\x00\x20\x00\x00\x00\x01\xff\xec\x00\x14\x00\x00\x00\x03\x00\x2a\xff\xf6\xff\x38\x01\x2c\x80\x00\x7f\xff\x00\x00\x00\x01\x00\x00\x00\x04\x00\x00\x00\x02\x00\x00\x00\x00\x00\x40\xff\xc0",
      ),
    ),
  )
  let expected: [i16; 14] = [-20, 20, 42, -10, -200, 300, -32768, 32767, 0, 4, 0, 0, 64, -64]
  let counts: [usize; 4] = [1, 3, 1, 2]
  let mut at: usize = 0
  let mut i: usize = 0
  while i < 4 {
    let points = run must(Ankr.anchorPoints(&table, GlyphId.new(usize.toU32(i))))
    run Testing.expect(
      ComputedArray<'static, (), AnchorPoint<'static>>.len(&points) == counts[i],
      "anchor count",
    )
    let mut j: usize = 0
    while j < counts[i] {
      let point = run must(ComputedArray<'static, (), AnchorPoint<'static>>.get(&points, j))
      run Testing.expect(
        AnchorPoint.x(&point) == expected[at] && AnchorPoint.y(&point) == expected[at + 1],
        "anchor position",
      )
      at = at + 2
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn languageTags() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Ltag.read(
      FontData.new(
        b"\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x18\x00\x02\x00\x1a\x00\x02\x00\x1c\x00\x02\x65\x6e\x73\x70\x73\x72",
      ),
    ),
  )
  let mut iter = Ltag.tagIndices(&table)
  let expected: [string<'static>; 3] = ["en", "sp", "sr"]
  let mut i: usize = 0
  while i < 3 {
    let item = run some(TagIndices<'static>.next(&mut iter))
    run Testing.expect(item.index == usize.toU32(i) && item.tag == expected[i], "tag iteration")
    run Testing.expect(
      (run some(Ltag.indexForTag(&table, expected[i]))) == usize.toU32(i),
      "tag lookup",
    )
    i = i + 1
  }
  run Testing.expect(
    none(TagIndices<'static>.next(&mut iter)) && none(Ltag.indexForTag(&table, "ar"))
      && none(Ltag.indexForTag(&table, "hi")),
    "tag exhaustion and missing values",
  )
}
