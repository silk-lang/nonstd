    return self._fieldRanges[1]
  }

  /// Minimum y for coordinate data.
  pub fn yMin(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[2].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yMinByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Maximum x for coordinate data.
  pub fn xMax(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[3].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn xMaxByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Maximum y for coordinate data.
  pub fn yMax(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[4].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yMaxByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// component flag
  /// glyph index of component
  pub fn componentData(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn componentDataByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }
}

impl<'a> FontRead<'a, ()> for CompositeGlyph<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CompositeGlyph<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for CompositeGlyph<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[5].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[5].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Flags used in [CompositeGlyph]
pub struct CompositeGlyphFlags {
  raw: u16,
}

impl Copy for CompositeGlyphFlags {}

impl CompositeGlyphFlags {
  pub fn bits(self: &Self) -> u16 {
    return self.raw
  }

  pub fn empty() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 0 }
  }

  pub fn all() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 16367 }
  }

  pub fn fromBitsTruncate(bits: u16) -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: bits & 16367 }
  }

  pub fn fromBits(bits: u16) -> Option<CompositeGlyphFlags> {
    if (bits & 16367) != bits {
      return Option<CompositeGlyphFlags>.None
    }
    return Option<CompositeGlyphFlags>.some(CompositeGlyphFlags { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: CompositeGlyphFlags) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: CompositeGlyphFlags) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: CompositeGlyphFlags) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: CompositeGlyphFlags) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: CompositeGlyphFlags) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// Bit 0: If this is set, the arguments are 16-bit (uint16 or
  /// int16); otherwise, they are bytes (uint8 or int8).
  pub fn arg1And2AreWords() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 1 }
  }

  /// Bit 1: If this is set, the arguments are signed xy values,
  /// otherwise, they are unsigned point numbers.
  pub fn argsAreXyValues() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 2 }
  }

  /// Bit 2: If set and ARGS_ARE_XY_VALUES is also set, the xy values
  /// are rounded to the nearest grid line. Ignored if
  /// ARGS_ARE_XY_VALUES is not set.
  pub fn roundXyToGrid() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 4 }
  }

  /// Bit 3: This indicates that there is a simple scale for the
  /// component. Otherwise, scale = 1.0.
  pub fn weHaveAScale() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 8 }
  }

  /// Bit 5: Indicates at least one more glyph after this one.
  pub fn moreComponents() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 32 }
  }

  /// Bit 6: The x direction will use a different scale from the y
  /// direction.
  pub fn weHaveAnXAndYScale() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 64 }
  }

  /// Bit 7: There is a 2 by 2 transformation that will be used to
  /// scale the component.
  pub fn weHaveATwoByTwo() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 128 }
  }

  /// Bit 8: Following the last component are instructions for the
  /// composite character.
  pub fn weHaveInstructions() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 256 }
  }

  /// Bit 9: If set, this forces the aw and lsb (and rsb) for the
  /// composite to be equal to those from this component glyph. This
  /// works for hinted and unhinted glyphs.
  pub fn useMyMetrics() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 512 }
  }

  /// Bit 10: If set, the components of the compound glyph overlap.
  /// Use of this flag is not required in OpenType — that is, it is
  /// valid to have components overlap without having this flag set.
  /// It may affect behaviors in some platforms, however. (See
  /// Apple’s specification for details regarding behavior in Apple
  /// platforms.) When used, it must be set on the flag word for the
  /// first component. See additional remarks, above, for the similar
  /// OVERLAP_SIMPLE flag used in simple-glyph descriptions.
  pub fn overlapCompound() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 1024 }
  }

  /// Bit 11: The composite is designed to have the component offset
  /// scaled. Ignored if ARGS_ARE_XY_VALUES is not set.
  pub fn scaledComponentOffset() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 2048 }
  }

  /// Bit 12: The composite is designed not to have the component
  /// offset scaled. Ignored if ARGS_ARE_XY_VALUES is not set.
  pub fn unscaledComponentOffset() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 4096 }
  }

  /// Bit 13: The component glyph identifier uses 24-bit encoding in GLYF
  /// (ISO/IEC 14496-22:2026, 5.2.8).
  pub fn gidIs24Bit() -> CompositeGlyphFlags {
    return CompositeGlyphFlags { raw: 8192 }
  }
}

impl Equal for CompositeGlyphFlags {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl CompositeGlyphFlags {
  pub fn default() -> Self {
    return CompositeGlyphFlags.empty()
  }
}

impl Order for CompositeGlyphFlags {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for CompositeGlyphFlags {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.arg1And2AreWords()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("ARG_1_AND_2_ARE_WORDS")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.argsAreXyValues()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("ARGS_ARE_XY_VALUES")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.roundXyToGrid()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("ROUND_XY_TO_GRID")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.weHaveAScale()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("WE_HAVE_A_SCALE")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.moreComponents()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("MORE_COMPONENTS")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.weHaveAnXAndYScale()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("WE_HAVE_AN_X_AND_Y_SCALE")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.weHaveATwoByTwo()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("WE_HAVE_A_TWO_BY_TWO")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.weHaveInstructions()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("WE_HAVE_INSTRUCTIONS")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.useMyMetrics()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("USE_MY_METRICS")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.overlapCompound()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("OVERLAP_COMPOUND")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.scaledComponentOffset()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("SCALED_COMPONENT_OFFSET")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.unscaledComponentOffset()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("UNSCALED_COMPONENT_OFFSET")
    }
    if CompositeGlyphFlags.contains(self, CompositeGlyphFlags.gidIs24Bit()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("GID_IS_24_BIT")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<CompositeGlyphFlags, CompositeGlyphFlags> for CompositeGlyphFlags {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<CompositeGlyphFlags, CompositeGlyphFlags> for CompositeGlyphFlags {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<CompositeGlyphFlags, CompositeGlyphFlags> for CompositeGlyphFlags {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<CompositeGlyphFlags, CompositeGlyphFlags> for CompositeGlyphFlags {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<CompositeGlyphFlags> for CompositeGlyphFlags {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 16367 }
  }
}

impl Scalar for CompositeGlyphFlags {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(CompositeGlyphFlags.fromBitsTruncate(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.raw, move bytes)
  }
}

impl FixedSize for CompositeGlyphFlags {
  fn rawByteLen() -> usize {
    return 2
  }
}

pub union Glyph<'a> {
  Simple { pub value: SimpleGlyph<'a> },
  Composite { pub value: CompositeGlyph<'a> },
}

impl<'a> Copy for Glyph<'a> {}

impl<'a> Glyph<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<i16>(&data, 0) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    if format >= 0 {
      return match move SimpleGlyph<'a>.read(data) {
        Result<SimpleGlyph<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          Glyph<'a>.Simple { value: value },
        )
        Result<SimpleGlyph<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(
          error,
        )
      }
    }
    if true {
      return match move CompositeGlyph<'a>.read(data) {
        Result<CompositeGlyph<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          Glyph<'a>.Composite { value: value },
        )
        Result<CompositeGlyph<'a>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.offsetData(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.offsetData(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for Glyph<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Glyph<'a>.read(data)
  }
}

