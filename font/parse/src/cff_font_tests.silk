test effect fn subfontMatrix()
  ! AssertionError<'static> {
  let cff = run font(iconsMatrixTable())
  let sub = run must(CffFontRef.subfont(&cff, 0, &[]))
  run Testing.expect(
    absent(Subfont.defaultWidth(&sub)) && Fixed.toBits(Subfont.nominalWidth(&sub)) == 0
      && Subfont.vsIndex(&sub) == 0,
    "matrix font metrics",
  )
  let matrix = run some(Subfont.matrix(&sub))
  run Testing.expect(
    matrix.scale == 10
      && equal(
        matrix.matrix,
        Matrix.fromElements<Fixed>(
          [
            Fixed.fromI32(5),
            Fixed.zero(),
            Fixed.zero(),
            Fixed.fromI32(5),
            Fixed.zero(),
            Fixed.zero(),
          ],
        ),
      ),
    "raw subfont matrix",
  )
}

test effect fn selectVersion()
  ! AssertionError<'static> {
  let cff2 = run font(cantarellTable())
  let cff = run font(iconsMatrixTable())
  run Testing.expect(
    CffFontRef.version(&cff2) == 2 && CffFontRef.version(&cff) == 1,
    "header selects version",
  )
  let mut version: u8 = 0
  while version < 3 {
    let bytes = [version, 1, 4, 5]
    run Testing.expect(
      failed(CffFontRef.new(&bytes, 0, Option<i32>.None)),
      "spoofed or unknown version rejected",
    )
    version = version + 1
  }
}

test effect fn transform()
  ! AssertionError<'static> {
  let cff = run must(CffFontRef.new(iconsMatrixTable(), 0, Option<i32>.some(512)))
  let sub = run must(CffFontRef.subfont(&cff, 0, &[]))
  let expected = Matrix.fromElements<Fixed>(
    [
      Fixed.fromBits(65536),
      Fixed.zero(),
      Fixed.fromBits(5604),
      Fixed.fromBits(65536),
      Fixed.zero(),
      Fixed.zero(),
    ],
  )
  let unscaled = CffFontRef.transform(&cff, &sub, Option<f32>.None)
  run Testing.expect(
    equal(unscaled.matrix, expected) && Fixed.toBits(run some(move unscaled.scale)) == 2097152,
    "normalized matrix and UPEM adjustment",
  )
  let scaled = CffFontRef.transform(&cff, &sub, Option<f32>.some(16.0))
  run Testing.expect(
    equal(scaled.matrix, expected) && Fixed.toBits(run some(move scaled.scale)) == 65536,
    "16 ppem scale",
  )
}

