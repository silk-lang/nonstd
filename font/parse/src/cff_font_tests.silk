test effect fn captureFamilyOtherBlues()
  ! AssertionError<'static> {
  let data = exampleCff2()
  let store = run must(
    ItemVariationStore.read(FontData.new(Slice.view<u8>(data, 18, data.length - 18))),
  )
  let coords = [F2Dot14.zero()]
  let blend = run must(BlendState.new(store, &coords, 0))
  let hinted = run must(
    Subfont.newHinted(
      data,
      ByteRange { start: 79, end: 193 },
      Option<BlendState>.some(blend),
      Option<ScaledFontMatrix>.None,
    ),
  )
  let expected = Blues.new(&[Fixed.fromI32(-249), Fixed.fromI32(-239)])
  run Testing.expect(
    equal(hinted.hinting.familyOtherBlues, expected),
    "family other blues are independent",
  )
}

effect fn checkSubfont(sub: &Subfont, nominal: i32) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    absent(Subfont.defaultWidth(sub)) && Fixed.toI32(Subfont.nominalWidth(sub)) == nominal
      && Subfont.vsIndex(sub) == 0
      && absent(Subfont.matrix(sub)),
    "private dictionary values",
  )
}

