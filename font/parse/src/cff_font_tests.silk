  let sub = run must(CffFontRef.subfont(&cff, 0, &[]))
  run checkSubfont(&sub, 598)
}

test effect fn subfontCff2()
  ! AssertionError<'static> {
  let cff = run font(cantarellTable())
  let sub = run must(CffFontRef.subfont(&cff, 0, &[]))
  run checkSubfont(&sub, 0)
}

fn makeBlues(values: &[i32]) -> Blues {
  let mut fixed: [Fixed; 14] = [Fixed.zero(); 14]
  let mut i: usize = 0
  while i < values.length {
    fixed[i] = Fixed.fromI32(values[i])
    i = i + 1
  }
  return Blues.new(Slice.view<Fixed>(&fixed, 0, values.length))
}

effect fn checkHinted(
  hinted: &HintedSubfont,
  nominal: i32,
  blues: &[i32],
  other: &[i32],
  scale: f64,
  fuzz: i32,
) -> ()
  ! AssertionError<'static> {
  run checkSubfont(&hinted.subfont, nominal)
  let h = hinted.hinting
  run Testing.expect(
    equal(h.blues, makeBlues(blues)) && equal(h.otherBlues, makeBlues(other))
      && equal(h.familyBlues, Blues.default())
      && equal(h.familyOtherBlues, Blues.default()),
    "all hinting blue regions",
  )
  run Testing.expect(
    Fixed.toBits(h.blueScale) == Fixed.toBits(Fixed.fromF64(scale)) && Fixed.toI32(h.blueShift) == 7
      && Fixed.toI32(h.blueFuzz) == fuzz
      && h.languageGroup == 0,
    "hinting scalars",
  )
}

