effect fn must<T, E>(value: Result<T, E>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, E>.Success { value: item } => move item
    _ => {
      run Testing.expect(false, "CFF font fixture parses")
      return Intrinsic.trap("assertion")
    }
  }
}

effect fn some<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: item } => move item
    _ => {
      run Testing.expect(false, "CFF value exists")
      return Intrinsic.trap("assertion")
    }
  }
}

fn absent<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

fn failed<T, E>(value: Result<T, E>) -> bool {
  return match move value {
    Result<T, E>.Failure { error } => true
    _ => false
  }
}

fn equal<T: Equal>(a: T, b: T) -> bool {
  return &a == &b
}

effect fn font(data: &'static [u8]) -> CffFontRef<'static>
  ! AssertionError<'static> {
  return run must(CffFontRef.new(data, 0, Option<i32>.None))
}

effect fn checkCommon(cff: &CffFontRef<'static>, version: u16, glyphs: u32, globals: u32) -> ()
  ! AssertionError<'static> {
  run Testing.expect(CffFontRef.version(cff) == version, "CFF version")
  run Testing.expect(absent(CffFontRef.varStore(cff)) == (version == 1), "variation store presence")
  run Testing.expect(
    CffFontRef.numGlyphs(cff) == glyphs && CffFontRef.numSubfonts(cff) == 1,
    "glyph and subfont count",
  )
  run Testing.expect(
    (run some(CffFontRef.subfontIndex(cff, GlyphId.new(1)))) == 0,
    "subfont selection",
  )
  run Testing.expect(Index.count(&CffFontRef.globalSubrs(cff)) == globals, "global subroutines")
}

test effect fn readCffStatic()
  ! AssertionError<'static> {
  let cff = run must(CffFontRef.newCff(notoSerifTable(), 0, Option<i32>.None))
  run checkCommon(&cff, 1, 5, 17)
  let range = run some(CffFontRef.sidPrivateDictRange(&cff))
  run Testing.expect(range.end > range.start, "SID private dictionary")
}

test effect fn readCff2Static()
  ! AssertionError<'static> {
  let cff = run must(CffFontRef.newCff2(cantarellTable(), Option<i32>.None))
  run checkCommon(&cff, 2, 6, 0)
  run Testing.expect(absent(CffFontRef.strings(&cff)), "CFF2 has no SID strings")
}

test effect fn readExampleCff2Table()
  ! AssertionError<'static> {
  let cff = run must(CffFontRef.newCff2(exampleCff2(), Option<i32>.None))
  run checkCommon(&cff, 2, 2, 0)
}

effect fn checkMetadata(
  data: &'static [u8],
  name: string,
  full: string,
  family: Option<string<'static>>,
  bbox: [i32; 4],
) -> ()
  ! AssertionError<'static> {
  let cff = run font(data)
  let meta = run some(CffFontRef.metadata(&cff))
  run Testing.expect(
    (run some(Metadata.name(&meta))) == name && (run some(Metadata.fullName(&meta))) == full,
    "PostScript and full names",
  )
  run Testing.expect(
    (Option<string<'static>>.unwrapOr(Metadata.familyName(&meta), "")
      == Option<string<'static>>.unwrapOr(move family, ""))
      && absent(Metadata.weight(&meta)),
    "family and absent weight",
  )
  let b = Metadata.bbox(&meta)
  run Testing.expect(
    Fixed.toBits(b.xMin) == i32.shiftLeft(bbox[0], 16)
      && Fixed.toBits(b.yMin) == i32.shiftLeft(bbox[1], 16)
      && Fixed.toBits(b.xMax) == i32.shiftLeft(bbox[2], 16)
      && Fixed.toBits(b.yMax) == i32.shiftLeft(bbox[3], 16),
    "font bbox",
  )
  run Testing.expect(
    Fixed.toBits(Metadata.italicAngle(&meta)) == 0 && !Metadata.isFixedPitch(&meta),
    "metadata defaults",
  )
  run Testing.expect(
    Fixed.toI32(Metadata.underlinePosition(&meta)) == -100
      && Fixed.toI32(Metadata.underlineThickness(&meta)) == 50,
    "underline defaults",
  )
}

test effect fn readCffMetadata()
  ! AssertionError<'static> {
  run checkMetadata(
    notoSerifTable(),
    "NotoSerifDisplay-Regular",
    "Noto Serif Display Regular",
    Option<string>.some("Noto Serif Display"),
    [-693, -470, 2797, 1048],
  )
  run checkMetadata(
    iconsTable(),
    "GoogleMaterialIcons-Regular",
    "GoogleMaterialIcons-Regular",
    Option<string>.None,
    [-1, 0, 513, 512],
  )
}

test effect fn charset()
  ! AssertionError<'static> {
  let cff = run font(notoSerifTable())
  let chars = run some(CffFontRef.charset(&cff))
  let mut iter = Charset.iter(&chars)
  let expected: [string; 5] = [".notdef", "i", "j", "k", "l"]
  let mut i: usize = 0
  while i < expected.length {
    let item = run some(Iter.next(&mut iter))
    run Testing.expect(GlyphId.toU32(item.glyph) == usize.toU32(i), "charset glyph order")
    run Testing.expect(
      (run must(String.fromUtf8(run must(Sid.resolveStandard(item.sid))))) == expected[i],
      "standard glyph name",
    )
    i = i + 1
  }
  run Testing.expect(absent(Iter.next(&mut iter)), "exact charset length")
}

