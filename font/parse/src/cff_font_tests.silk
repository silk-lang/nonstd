import ps.charstring {
  CommandSink,
  NullSink as NullCommandSink,
  ControlBoundsSink,
  NopFilterSink,
  TransformSink
}
import model.glyph.outline { PathSink, NullSink as NullPathSink }
import generated_cff_fixtures { notoSansCffTable, notoSansCff2Table, notoSansCff2Font }
import font { FontRef }
import tables.fvar { Fvar }
import silk.num.u16

struct CommandCounter {
  count: usize,
}

impl CommandSink for CommandCounter {
  fn moveTo(self: &mut Self, x: Fixed, y: Fixed) {
    self.count = self.count + 1
  }

  fn lineTo(self: &mut Self, x: Fixed, y: Fixed) {
    self.count = self.count + 1
  }

  fn curveTo(self: &mut Self, a: Fixed, b: Fixed, c: Fixed, d: Fixed, x: Fixed, y: Fixed) {
    self.count = self.count + 1
  }

  fn close(self: &mut Self) {
    self.count = self.count + 1
  }
}

effect fn countCommands(data: &'static [u8], expected: usize) -> ()
  ! AssertionError<'static> {
  let cff = run font(data)
  let sub = run must(CffFontRef.subfont(&cff, 0, &[]))
  let mut count = CommandCounter { count: 0 }
  drop run must(CffFontRef.evaluateCharstring(&cff, &sub, GlyphId.new(2), &[], &mut count))
  run Testing.expect(count.count == expected, "correct glyph charstring and subroutines")
}

test effect fn evalCharstringCff()
  ! AssertionError<'static> {
  run countCommands(notoSerifTable(), 18)
}

test effect fn evalCharstringCff2()
  ! AssertionError<'static> {
  run countCommands(cantarellTable(), 11)
}

fn widthEqual(a: Option<Fixed>, b: Option<Fixed>) -> bool {
  return match move a {
    Option<Fixed>.Some { value: x } => match move b {
      Option<Fixed>.Some { value: y } => Fixed.toBits(x) == Fixed.toBits(y)
      _ => false
    }
    _ => absent(move b)
  }
}

fn floatEqual(a: Option<f32>, b: Option<f32>) -> bool {
  return match move a {
    Option<f32>.Some { value: x } => match move b {
      Option<f32>.Some { value: y } => x == y
      _ => false
    }
    _ => absent(move b)
  }
}

fn size(index: usize) -> Option<f32> {
  if index == 0 {
    return Option<f32>.None
  }
  if index == 1 {
    return Option<f32>.some(16.0)
  }
  return Option<f32>.some(72.0)
}

test effect fn theQuickWidthIsWhatAFullRunReports()
  ! AssertionError<'static> {
  let fonts: [&'static [u8]; 3] = [notoSerifTable(), notoSansCffTable(), iconsMatrixTable()]
  let mut mapped: usize = 0
  let mut f: usize = 0
  while f < fonts.length {
    let cff = run font(fonts[f])
    let mut stated: usize = 0
    let mut gid: u32 = 0
    while gid < CffFontRef.numGlyphs(&cff) {
      let glyph = GlyphId.new(gid)
      let index = Option<u16>.unwrapOr(CffFontRef.subfontIndex(&cff, glyph), 0)
      let sub = run must(CffFontRef.subfont(&cff, index, &[]))
      let transform = CffFontRef.transform(&cff, &sub, Option<f32>.None)
      let mut sink = NullCommandSink {}
      let full = run must(CffFontRef.evaluateCharstring(&cff, &sub, glyph, &[], &mut sink))
      let quick = run must(CffFontRef.evaluateWidth(&cff, &sub, glyph, &[]))
      match move full {
        Option<Fixed>.Some { value } => {
          stated = stated + 1
          let q = run some(move quick)
          let transformed = Transform.transformHMetric(&transform, value)
          run Testing.expect(
            Fixed.toBits(q) == Fixed.toBits(transformed),
            "quick width equals transformed full width",
          )
          if Fixed.toBits(q) != Fixed.toBits(value) {
            mapped = mapped + 1
          }
        }
        _ => {
          run Testing.expect(absent(move quick), "no charstring width")
        }
      }
      gid = gid + 1
    }
    run Testing.expect(stated > 0, "font states widths")
    f = f + 1
  }
  run Testing.expect(mapped > 0, "a matrix changes widths")
}

test effect fn theQuickAdvanceIsWhatDrawingReports()
  ! AssertionError<'static> {
  let fonts: [&'static [u8]; 3] = [notoSerifTable(), notoSansCffTable(), iconsMatrixTable()]
  let mut f: usize = 0
  while f < fonts.length {
    let cff = run font(fonts[f])
    let mut s: usize = 0
    while s < 3 {
      let mut gid: u32 = 0
      while gid < CffFontRef.numGlyphs(&cff) {
        let glyph = GlyphId.new(gid)
        let sub = run must(
          CffFontRef.subfont(
            &cff,
            Option<u16>.unwrapOr(CffFontRef.subfontIndex(&cff, glyph), 0),
            &[],
          ),
        )
        let mut sink = NullPathSink {}
        let drawn = run must(CffFontRef.draw(&cff, &sub, glyph, &[], size(s), &mut sink))
        let quick = run must(CffFontRef.advance(&cff, &sub, glyph, &[], size(s)))
        run Testing.expect(floatEqual(move drawn, move quick), "quick advance equals drawn width")
        gid = gid + 1
      }
      s = s + 1
    }
    f = f + 1
  }
}

struct BoundsPen {
  present: bool,
  box: BoundingBox<f32>,
}

impl BoundsPen {
  fn new() -> Self {
    return Self {
      present: false,
      box: BoundingBox<f32> { xMin: 0.0, yMin: 0.0, xMax: 0.0, yMax: 0.0 },
    }
  }

  fn bounds(self: &Self) -> Option<BoundingBox<f32>> {
    if self.present {
      return Option<BoundingBox<f32>>.some(self.box)
    }
    return Option<BoundingBox<f32>>.None
  }

  fn add(self: &mut Self, x: f32, y: f32) {
    if !self.present {
      self.present = true
      self.box = BoundingBox<f32> { xMin: x, yMin: y, xMax: x, yMax: y }
      return
    }
    if x < self.box.xMin {
      self.box.xMin = x
    }
    if x > self.box.xMax {
      self.box.xMax = x
    }
    if y < self.box.yMin {
      self.box.yMin = y
    }
    if y > self.box.yMax {
      self.box.yMax = y
    }
  }
}

impl PathSink for BoundsPen {
  fn moveTo(self: &mut Self, x: f32, y: f32) {
    BoundsPen.add(&mut self, x, y)
  }

  fn lineTo(self: &mut Self, x: f32, y: f32) {
    BoundsPen.add(&mut self, x, y)
  }

  fn quadTo(self: &mut Self, cx: f32, cy: f32, x: f32, y: f32) {
    BoundsPen.add(&mut self, cx, cy)
    BoundsPen.add(&mut self, x, y)
  }

  fn curveTo(self: &mut Self, a: f32, b: f32, c: f32, d: f32, x: f32, y: f32) {
    BoundsPen.add(&mut self, a, b)
    BoundsPen.add(&mut self, c, d)
    BoundsPen.add(&mut self, x, y)
  }

  fn close(self: &mut Self) {}
}

fn boundsEqual(a: Option<BoundingBox<f32>>, b: Option<BoundingBox<f32>>) -> bool {
  return match move a {
    Option<BoundingBox<f32>>.Some { value: x } => match move b {
      Option<BoundingBox<f32>>.Some { value: y } => equal(x, y)
      _ => false
    }
    _ => absent(move b)
  }
}

test effect fn theExtentsAreTheBoxDrawingStaysWithin()
  ! AssertionError<'static> {
  let fonts: [&'static [u8]; 3] = [notoSerifTable(), notoSansCffTable(), iconsMatrixTable()]
  let mut f: usize = 0
  while f < fonts.length {
    let cff = run font(fonts[f])
    let mut s: usize = 0
    while s < 2 {
      let mut gid: u32 = 0
      let mut drew: usize = 0
      while gid < CffFontRef.numGlyphs(&cff) {
        let glyph = GlyphId.new(gid)
        let sub = run must(
          CffFontRef.subfont(
            &cff,
            Option<u16>.unwrapOr(CffFontRef.subfontIndex(&cff, glyph), 0),
            &[],
          ),
        )
        let mut sink = BoundsPen.new()
        drop run must(CffFontRef.draw(&cff, &sub, glyph, &[], size(s), &mut sink))
        let measured = run must(CffFontRef.extents(&cff, &sub, glyph, &[], size(s)))
        run Testing.expect(
          boundsEqual(move measured, BoundsPen.bounds(&sink)),
          "box matches drawn control points",
        )
        if sink.present {
          drew = drew + 1
        }
        gid = gid + 1
      }
      run Testing.expect(drew > 0, "font draws ink")
      s = s + 1
    }
    f = f + 1
  }
}

test effect fn aShearedMatrixMeasuresSmallerThanABoxTurnedAfterwards()
  ! AssertionError<'static> {
  let cff = run font(iconsMatrixTable())
  let mut tighter: usize = 0
  let mut gid: u32 = 0
  while gid < CffFontRef.numGlyphs(&cff) {
    let glyph = GlyphId.new(gid)
    let sub = run must(
      CffFontRef.subfont(&cff, Option<u16>.unwrapOr(CffFontRef.subfontIndex(&cff, glyph), 0), &[]),
    )
    let mut before = ControlBoundsSink.new()
    let mut filter = NopFilterSink.new(&mut before)
    drop run must(CffFontRef.evaluateCharstring(&cff, &sub, glyph, &[], &mut filter))
    drop move filter
    match move ControlBoundsSink.boundingBox(&before) {
      Option<BoundingBox<Fixed>>.Some { value: plain } => {
        let mut turned = ControlBoundsSink.new()
        let mut sink = TransformSink.new(
          &mut turned,
          CffFontRef.transform(&cff, &sub, Option<f32>.None),
        )
        CommandSink.moveTo(&mut sink, plain.xMin, plain.yMin)
        CommandSink.moveTo(&mut sink, plain.xMin, plain.yMax)
        CommandSink.moveTo(&mut sink, plain.xMax, plain.yMin)
        CommandSink.moveTo(&mut sink, plain.xMax, plain.yMax)
        drop move sink
        let box = run some(ControlBoundsSink.boundingBox(&turned))
        let measured = run some(
          run must(CffFontRef.extents(&cff, &sub, glyph, &[], Option<f32>.None)),
        )
        run Testing.expect(
          measured.xMin >= Fixed.toF32(box.xMin) && measured.xMax <= Fixed.toF32(box.xMax),
          "measured ink stays within transformed corners",
        )
        if measured.xMin > Fixed.toF32(box.xMin) || measured.xMax < Fixed.toF32(box.xMax) {
          tighter = tighter + 1
        }
      }
      _ => {}
    }
    gid = gid + 1
  }
  run Testing.expect(tighter > 0, "shear measurably tightens a box")
}

test effect fn aLocationMovesACff2BoxAsItMovesTheDrawing()
  ! AssertionError<'static> {
  let sfnt = run must(FontRef.new(notoSansCff2Font()))
  let fvar = run must(FontRef.fvar(&sfnt))
  let axes = u16.toUsize(Fvar.axisCount(&fvar))
  run Testing.expect(axes <= 64, "fixture axis storage")
  let cff = run font(notoSansCff2Table())
  let mut coords: [F2Dot14; 64] = [F2Dot14.zero(); 64]
  let mut moved: usize = 0
  let values: [f32; 3] = [0.0, -1.0, 1.0]
  let mut loc: usize = 0
  while loc < 3 {
    let mut axis: usize = 0
    while axis < axes {
      coords[axis] = F2Dot14.fromF32(values[loc])
      axis = axis + 1
    }
    let active = Slice.view<F2Dot14>(&coords, 0, axes)
    let mut gid: u32 = 0
    while gid < CffFontRef.numGlyphs(&cff) {
      let glyph = GlyphId.new(gid)
      let index = Option<u16>.unwrapOr(CffFontRef.subfontIndex(&cff, glyph), 0)
      let sub = run must(CffFontRef.subfont(&cff, index, active))
      let measured = run must(CffFontRef.extents(&cff, &sub, glyph, active, Option<f32>.None))
      let mut pen = BoundsPen.new()
      drop run must(CffFontRef.draw(&cff, &sub, glyph, active, Option<f32>.None, &mut pen))
      run Testing.expect(
        boundsEqual(move measured, BoundsPen.bounds(&pen)),
        "variable box matches variable drawing",
      )
      if loc != 0 {
        let defaultSub = run must(CffFontRef.subfont(&cff, index, &[]))
        let defaultBox = run must(
          CffFontRef.extents(&cff, &defaultSub, glyph, &[], Option<f32>.None),
        )
        if !boundsEqual(move defaultBox, BoundsPen.bounds(&pen)) {
          moved = moved + 1
        }
      }
      gid = gid + 1
    }
    loc = loc + 1
  }
  run Testing.expect(moved > 0, "location moves real ink")
}
