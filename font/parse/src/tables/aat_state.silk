import read { readWithArgs }
import font_types.lib { fixedByteLen }

pub struct NoPayload {
  marker: u8,
}

impl Copy for NoPayload {}

impl FixedSize for NoPayload {
  fn rawByteLen() -> usize {
    return 0
  }
}

impl<'a> FontRead<'a, ()> for NoPayload {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Result<Self, ReadError>.succeed(Self { marker: 0 })
  }
}

pub struct StateEntry<T> {
  pub newState: u16,
  pub flags: u16,
  pub payload: T,
}

impl<T: Copy> Copy for StateEntry<T> {}

impl<T: FixedSize> FixedSize for StateEntry<T> {
  fn rawByteLen() -> usize {
    return usize.saturatingAdd(4, fixedByteLen<T>())
  }
}

impl<T> StateEntry<T> {
  pub fn read<'a, T: FixedSize + FontRead<'a, ()>>(data: FontData<'a>) -> Result<
    StateEntry<T>,
    ReadError
  > {
    let state = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<StateEntry<T>, ReadError>.failResult(error)
      }
    }
    let flags = match move FontData<'a>.readAt<u16>(&data, 2) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<StateEntry<T>, ReadError>.failResult(error)
      }
    }
    let remaining = match move FontData.splitOff(&data, 4) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<StateEntry<T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let payload = match move readWithArgs<(), T>(remaining, ()) {
      Result<T, ReadError>.Success { value } => move value
      Result<T, ReadError>.Failure { error } => {
        return Result<StateEntry<T>, ReadError>.failResult(error)
      }
    }
    return Result<StateEntry<T>, ReadError>.succeed(
      StateEntry<T> { newState: state, flags: flags, payload: move payload },
    )
  }
}

impl<'a, T: FixedSize + FontRead<'a, ()>> FontRead<'a, ()> for StateEntry<T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return StateEntry<T>.read(data)
  }
}

pub struct ClassMappings<'a> {
  pub firstGlyph: u16,
  pub classes: &'a [u8],
}

impl<'a> Copy for ClassMappings<'a> {}

pub struct StateTable<'a, T> {
  pub header: StateHeader<'a>,
  pub nClasses: usize,
  classFirstGlyph: u16,
  classArray: ScalarArray<'a, u8>,
  stateArray: FontData<'a>,
  entryTable: FontData<'a>,
  nClassesMagic: u64,
}

impl<'a, T> Copy for StateTable<'a, T> {}

pub struct LegacyStateTableParts {
  pub nClasses: u16,
  pub classTableOffset: u16,
  pub stateArrayOffset: u16,
  pub entryTableOffset: u16,
}

impl Copy for LegacyStateTableParts {}

impl LegacyStateTableParts {
  pub fn read(data: FontData) -> Result<Self, ReadError> {
    let header = match move StateHeader.read(data) {
      Result<StateHeader, ReadError>.Success { value } => value
      Result<StateHeader, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        nClasses: StateHeader.stateSize(&header),
        classTableOffset: u32.toU16(Offset16.toU32(StateHeader.classTableOffset(&header))),
        stateArrayOffset: u32.toU16(Offset16.toU32(StateHeader.stateArrayOffset(&header))),
        entryTableOffset: u32.toU16(Offset16.toU32(StateHeader.entryTableOffset(&header))),
      },
    )
  }

  pub fn default() -> Self {
    return Self { nClasses: 0, classTableOffset: 0, stateArrayOffset: 0, entryTableOffset: 0 }
  }
}

impl<'a, T> StateTable<'a, T> {
  pub fn headerLen() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let header = match move StateHeader.read(data) {
      Result<StateHeader<'a>, ReadError>.Success { value } => value
      Result<StateHeader<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let count = u16.toUsize(StateHeader.stateSize(&header))
    if count == 0 {
      return Result<Self, ReadError>.failResult(
        ReadError.MalformedData { message: "empty AAT state table" },
      )
    }
    let classes = match move StateHeader.classTable(&header) {
      Result<ClassSubtable<'a>, ReadError>.Success { value } => value
      Result<ClassSubtable<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let states = match move StateHeader.stateArray(&header) {
      Result<RawBytes<'a>, ReadError>.Success { value } => ScalarArray<u8>.offsetData(
        &RawBytes.data(&value),
      )
      Result<RawBytes<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let entries = match move StateHeader.entryTable(&header) {
      Result<RawBytes<'a>, ReadError>.Success { value } => ScalarArray<u8>.offsetData(
        &RawBytes.data(&value),
      )
      Result<RawBytes<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        header: header,
        nClasses: count,
        classFirstGlyph: ClassSubtable.firstGlyph(&classes),
        classArray: ClassSubtable.classArray(&classes),
        stateArray: states,
        entryTable: entries,
        nClassesMagic: 4294967296 / usize.toU64(count) + 1,
      },
    )
  }

  pub fn fromParts(data: FontData<'a>, parts: &LegacyStateTableParts) -> Result<Self, ReadError> {
    let count = u16.toUsize(parts.nClasses)
    if count == 0 {
      return Result<Self, ReadError>.failResult(
        ReadError.MalformedData { message: "empty AAT state table" },
      )
    }
    let classData = match move FontData.splitOff(&data, u16.toUsize(parts.classTableOffset)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let classes = match move ClassSubtable.read(classData) {
      Result<ClassSubtable<'a>, ReadError>.Success { value } => value
      Result<ClassSubtable<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let states = match move FontData.splitOff(&data, u16.toUsize(parts.stateArrayOffset)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let entries = match move FontData.splitOff(&data, u16.toUsize(parts.entryTableOffset)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let header = match move StateHeader.read(data) {
      Result<StateHeader<'a>, ReadError>.Success { value } => value
      Result<StateHeader<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        header: header,
        nClasses: count,
        classFirstGlyph: ClassSubtable.firstGlyph(&classes),
        classArray: ClassSubtable.classArray(&classes),
        stateArray: states,
        entryTable: entries,
        nClassesMagic: 4294967296 / usize.toU64(count) + 1,
      },
    )
  }

  pub fn class(self: &Self, glyphId: GlyphId16) -> Result<u8, ReadError> {
    let glyph = GlyphId16.toU16(glyphId)
    if glyph == 65535 {
      return Result<u8, ReadError>.succeed(2)
    }
    if glyph < self.classFirstGlyph {
      return Result<u8, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return match move ScalarArray<u8>.get(
      &self.classArray,
      u16.toUsize(glyph - self.classFirstGlyph),
    ) {
      Option<u8>.Some { value } => Result<u8, ReadError>.succeed(value)
      _ => Result<u8, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn classMappings(self: &Self) -> ClassMappings<'a> {
    return ClassMappings<'a> {
      firstGlyph: self.classFirstGlyph,
      classes: FontData.asBytes(&ScalarArray<u8>.offsetData(&self.classArray)),
    }
  }

  pub fn entry<T: FixedSize + FontRead<'a, ()>>(self: &Self, state: u16, class: u8) -> Result<
    StateEntry<T>,
    ReadError
  > {
    let mut klass = u8.toUsize(class)
    if klass >= self.nClasses {
      klass = 1
    }
    let stateIndex = usize.saturatingAdd(
      usize.saturatingMultiply(u16.toUsize(state), self.nClasses),
      klass,
    )
    let entryIndex = match move FontData<'a>.readAt<u8>(&self.stateArray, stateIndex) {
      Result<u8, ReadError>.Success { value } => u8.toUsize(value)
      Result<u8, ReadError>.Failure { error } => {
        return Result<StateEntry<T>, ReadError>.failResult(error)
      }
    }
    let entryOffset = usize.saturatingMultiply(entryIndex, fixedByteLen<StateEntry<T>>())
    let data = match move FontData.splitOff(&self.entryTable, entryOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<StateEntry<T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let mut entry = match move StateEntry<T>.read(data) {
      Result<StateEntry<T>, ReadError>.Success { value } => move value
      Result<StateEntry<T>, ReadError>.Failure { error } => {
        return Result<StateEntry<T>, ReadError>.failResult(error)
      }
    }
    let difference = u16.toI32(entry.newState)
      - u32.toI32(Offset16.toU32(StateHeader.stateArrayOffset(&self.header)))
    let mut next: i32 = 0
    if difference >= 0 {
      next = u64.toI32(u64.shiftRight(i32.toU64(difference) * self.nClassesMagic, 32))
    } else {
      next = difference / usize.toI32(self.nClasses)
    }
    if next < 0 || next > 65535 {
      return Result<StateEntry<T>, ReadError>.failResult(ReadError.OutOfBounds)
    }
    entry.newState = i32.toU16(next)
    return Result<StateEntry<T>, ReadError>.succeed(move entry)
  }

  pub fn readValue<S: Scalar>(self: &Self, offset: usize) -> Result<S, ReadError> {
    return FontData<'a>.readAt<S>(&StateHeader.offsetData(&self.header), offset)
  }
}

impl<'a, T> FontRead<'a, ()> for StateTable<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return StateTable<'a, T>.read(data)
  }
}

pub fn safeReadArrayToEnd<'a, T: Scalar>(data: &FontData<'a>, offset: usize) -> Result<
  ScalarArray<'a, T>,
  ReadError
> {
  if offset > FontData.len(data) {
    return Result<ScalarArray<'a, T>, ReadError>.failResult(ReadError.OutOfBounds)
  }
  let width = rawByteLen<T>()
  if width == 0 {
    return Result<ScalarArray<'a, T>, ReadError>.failResult(ReadError.InvalidArrayLen)
  }
  let length = FontData.len(data) - offset
  return FontData<'a>.readArray<T>(data, offset, offset + length / width * width)
}

pub struct ExtendedStateTable<'a, T> {
  pub nClasses: usize,
  pub classTable: LookupU16<'a>,
  stateArray: ScalarArray<'a, u16>,
  entryTable: FontData<'a>,
}

impl<'a, T> Copy for ExtendedStateTable<'a, T> {}

pub struct StateTableParts {
  pub nClasses: u32,
  pub classTableOffset: u32,
  pub stateArrayOffset: u32,
  pub entryTableOffset: u32,
}

impl Copy for StateTableParts {}

impl StateTableParts {
  pub fn read(data: FontData) -> Result<Self, ReadError> {
    let header = match move StxHeader.read(data) {
      Result<StxHeader, ReadError>.Success { value } => value
      Result<StxHeader, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        nClasses: StxHeader.nClasses(&header),
        classTableOffset: Offset32.toU32(StxHeader.classTableOffset(&header)),
        stateArrayOffset: Offset32.toU32(StxHeader.stateArrayOffset(&header)),
        entryTableOffset: Offset32.toU32(StxHeader.entryTableOffset(&header)),
      },
    )
  }

  pub fn default() -> Self {
    return Self { nClasses: 0, classTableOffset: 0, stateArrayOffset: 0, entryTableOffset: 0 }
  }
}

impl<'a, T> ExtendedStateTable<'a, T> {
  pub fn headerLen() -> usize {
    return 16
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let header = match move StxHeader.read(data) {
      Result<StxHeader<'a>, ReadError>.Success { value } => value
      Result<StxHeader<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let classes = match move StxHeader.classTable(&header) {
      Result<LookupU16<'a>, ReadError>.Success { value } => value
      Result<LookupU16<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let states = match move StxHeader.stateArray(&header) {
      Result<RawWords<'a>, ReadError>.Success { value } => RawWords.data(&value)
      Result<RawWords<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let entries = match move StxHeader.entryTable(&header) {
      Result<RawBytes<'a>, ReadError>.Success { value } => ScalarArray<u8>.offsetData(
        &RawBytes.data(&value),
      )
      Result<RawBytes<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        nClasses: u32.toUsize(StxHeader.nClasses(&header)),
        classTable: classes,
        stateArray: states,
        entryTable: entries,
      },
    )
  }

  pub fn fromParts(data: FontData<'a>, parts: &StateTableParts) -> Result<Self, ReadError> {
    let classData = match move FontData.splitOff(&data, u32.toUsize(parts.classTableOffset)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let classes = match move TypedLookup<'a, u16>.read(classData) {
      Result<LookupU16<'a>, ReadError>.Success { value } => value
      Result<LookupU16<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let states = match move safeReadArrayToEnd<u16>(&data, u32.toUsize(parts.stateArrayOffset)) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let entries = match move FontData.splitOff(&data, u32.toUsize(parts.entryTableOffset)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        nClasses: u32.toUsize(parts.nClasses),
        classTable: classes,
        stateArray: states,
        entryTable: entries,
      },
    )
  }

  pub fn class(self: &Self, glyphId: GlyphId) -> Result<u16, ReadError> {
    let glyph = GlyphId.toU32(glyphId)
    if glyph > 65535 {
      return Result<u16, ReadError>.failResult(ReadError.OutOfBounds)
    }
    if glyph == 65535 {
      return Result<u16, ReadError>.succeed(2)
    }
    return TypedLookup<'a, u16>.value(&self.classTable, u32.toU16(glyph))
  }

  pub fn entry<T: FixedSize + FontRead<'a, ()>>(self: &Self, state: u16, class: u16) -> Result<
    StateEntry<T>,
    ReadError
  > {
    let mut klass = u16.toUsize(class)
    if klass >= self.nClasses {
      klass = 1
    }
    let stateIndex = usize.saturatingAdd(
      usize.saturatingMultiply(u16.toUsize(state), self.nClasses),
      klass,
    )
    let entryIndex = match move ScalarArray<u16>.get(&self.stateArray, stateIndex) {
      Option<u16>.Some { value } => u16.toUsize(value)
      _ => {
        return Result<StateEntry<T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let entryOffset = usize.saturatingMultiply(entryIndex, fixedByteLen<StateEntry<T>>())
    let data = match move FontData.splitOff(&self.entryTable, entryOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<StateEntry<T>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return StateEntry<T>.read(data)
  }
}

impl<'a, T> FontRead<'a, ()> for ExtendedStateTable<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ExtendedStateTable<'a, T>.read(data)
  }
}
