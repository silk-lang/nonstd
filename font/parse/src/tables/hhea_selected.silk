import generated_hhea { Hhea, HheaExtended }
import font_types.lib { Version16Dot16, MajorMinor, FWord, UfWord, Uint24 }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.u16

pub union SelectedHhea<'a> {
  Original { pub table: Hhea<'a> },
  Extended { pub table: HheaExtended<'a> },
}

impl<'a> Copy for SelectedHhea<'a> {}

impl<'a> SelectedHhea<'a> {
  pub fn numberOfHMetrics(self: &Self) -> u32 {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => u16.toU32(Hhea<'a>.numberOfHMetrics(&table))
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.numberOfHMetrics(&table)
    }
  }

  pub fn version(self: &Self) -> MajorMinor {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.version(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.version(&table)
    }
  }

  pub fn ascender(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.ascender(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.ascender(&table)
    }
  }

  pub fn descender(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.descender(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.descender(&table)
    }
  }

  pub fn lineGap(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.lineGap(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.lineGap(&table)
    }
  }

  pub fn advanceWidthMax(self: &Self) -> UfWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.advanceWidthMax(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.advanceWidthMax(&table)
    }
  }

  pub fn minLeftSideBearing(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.minLeftSideBearing(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.minLeftSideBearing(&table)
    }
  }

  pub fn minRightSideBearing(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.minRightSideBearing(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.minRightSideBearing(&table)
    }
  }

  pub fn xMaxExtent(self: &Self) -> FWord {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.xMaxExtent(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.xMaxExtent(&table)
    }
  }

  pub fn caretSlopeRise(self: &Self) -> i16 {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.caretSlopeRise(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.caretSlopeRise(&table)
    }
  }

  pub fn caretSlopeRun(self: &Self) -> i16 {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.caretSlopeRun(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.caretSlopeRun(&table)
    }
  }

  pub fn caretOffset(self: &Self) -> i16 {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.caretOffset(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.caretOffset(&table)
    }
  }

  pub fn metricDataFormat(self: &Self) -> i16 {
    return match &self.* {
      SelectedHhea<'a>.Original { table } => Hhea<'a>.metricDataFormat(&table)
      SelectedHhea<'a>.Extended { table } => HheaExtended<'a>.metricDataFormat(&table)
    }
  }
}
