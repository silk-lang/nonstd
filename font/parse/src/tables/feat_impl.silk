impl<'a> Feat<'a> {
  pub fn find(self: &Self, feature: u16) -> Option<FeatureName<'a>> {
    let names = Feat.names(self)
    let mut low: usize = 0
    let mut size = ComputedArray<'a, (), FeatureName<'a>>.len(&names)
    if size == 0 {
      return Option<FeatureName<'a>>.None
    }

    // Match Rust slice::binary_search, including malformed unsorted records.
    while size > 1 {
      let half = size / 2
      let mid = low + half
      let item = match move ComputedArray<'a, (), FeatureName<'a>>.get(&names, mid) {
        Result<FeatureName<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<FeatureName<'a>>.None
        }
      }
      if FeatureName.feature(&item) <= feature {
        low = mid
      }
      size = size - half
    }
    let item = match move ComputedArray<'a, (), FeatureName<'a>>.get(&names, low) {
      Result<FeatureName<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<FeatureName<'a>>.None
      }
    }
    if FeatureName.feature(&item) == feature {
      return Option<FeatureName<'a>>.some(item)
    }
    return Option<FeatureName<'a>>.None
  }
}

impl<'a> FeatureName<'a> {
  pub fn isExclusive(self: &Self) -> bool {
    return FeatureName.featureFlags(self) & 32768 != 0
  }

  pub fn defaultSettingIndex(self: &Self) -> u16 {
    let flags = FeatureName.featureFlags(self)
    if flags & 16384 != 0 {
      return flags & 255
    }
    return 0
  }
}
