import read { VarSize }
import silk.text.string { String, InvalidUtf8 }

pub fn dlng() -> Tag {
  return Tag.fromU32(1684827751)
}

pub fn slng() -> Tag {
  return Tag.fromU32(1936485991)
}

pub union Metadata<'a> {
  ScriptLangTags { pub value: VarLenArray<'a, ScriptLangTag<'a>> },
  Other { pub value: &'a [u8] },
}

impl<'a> Copy for Metadata<'a> {}

impl<'a> FontRead<'a, ReadArgs2<Tag, u32>> for Metadata<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<Tag, u32>) -> Result<Self, ReadError> {
    let bytes = match move FontData.slice(&data, 0, u32.toUsize(args.second)) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    if Tag.toU32(args.first) == Tag.toU32(dlng()) || Tag.toU32(args.first) == Tag.toU32(slng()) {
      return match move VarLenArray<'a, ScriptLangTag<'a>>.read(bytes) {
        Result<VarLenArray<'a, ScriptLangTag<'a>>, ReadError>.Success { value } => Result<
          Self,
          ReadError
        >.succeed(Metadata<'a>.ScriptLangTags { value: value })
        Result<VarLenArray<'a, ScriptLangTag<'a>>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Metadata<'a>.Other { value: FontData.asBytes(&bytes) })
  }
}

pub struct ScriptLangTag<'a> {
  text: string<'a>,
}

impl<'a> Copy for ScriptLangTag<'a> {}

impl<'a> ScriptLangTag<'a> {
  pub fn asStr(self: &Self) -> string<'a> {
    return self.text
  }
}

impl<'a> VarSize for ScriptLangTag<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    let suffix = match move FontData.splitOff(&data, position) {
      Option<FontData<'b>>.Some { value } => value
      _ => {
        return Option<usize>.None
      }
    }
    if FontData.isEmpty(&suffix) {
      return Option<usize>.None
    }
    let bytes = FontData.asBytes(&data)
    let mut i: usize = 0
    while i < bytes.length {
      if bytes[i] == 44 {
        return Option<usize>.some(i + 1)
      }
      i = i + 1
    }
    return Option<usize>.some(FontData.len(&suffix))
  }
}

impl<'a> FontRead<'a, ()> for ScriptLangTag<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    let bytes = FontData.asBytes(&data)
    if let Result<string<'a>, InvalidUtf8>.Failure { error } = move String.fromUtf8(bytes) {
      return Result<Self, ReadError>.failResult(
        ReadError.MalformedData { message: "LangScriptTag must be utf8" },
      )
    }
    let mut start: usize = 0
    let mut end = bytes.length
    while start < end && (bytes[start] == 32 || bytes[start] == 44) {
      start = start + 1
    }
    while end > start && (bytes[end - 1] == 32 || bytes[end - 1] == 44) {
      end = end - 1
    }
    let text = String.fromUtf8(Slice.view<u8>(bytes, start, end - start))
      |> Result<string<'a>, InvalidUtf8>.unwrapOr("")
    return Result<Self, ReadError>.succeed(Self { text: text })
  }
}

import silk.collections.slice { Slice }
