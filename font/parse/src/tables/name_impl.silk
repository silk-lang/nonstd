// Included by font/scripts/generate in generated_name, whose nominal types this extends.
import tables.name_string { NameString, Encoding }

impl<'a> Name<'a> {
  pub fn stringData(self: &Self) -> FontData<'a> {
    let base = Name<'a>.offsetData(self)
    return FontData.splitOff(&base, u16.toUsize(Name<'a>.storageOffset(self)))
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
  }
}

impl<'a> NameRecord<'a> {
  pub fn string(self: &Self, data: FontData<'a>) -> Result<NameString<'a>, ReadError> {
    let offset = NameRecord<'a>.stringOffset(self)
    return NameString<'a>.read(
      data,
      u32.toUsize(Offset16.toU32(offset)),
      u16.toUsize(NameRecord<'a>.length(self)),
      Encoding.new(NameRecord<'a>.platformId(self), NameRecord<'a>.encodingId(self)),
    )
  }

  pub fn isUnicode(self: &Self) -> bool {
    let platform = NameRecord<'a>.platformId(self)
    let encoding = NameRecord<'a>.encodingId(self)
    return platform == 0 || (platform == 3 && (encoding == 0 || encoding == 1 || encoding == 10))
  }
}

impl<'a> LangTagRecord<'a> {
  pub fn langTag(self: &Self, data: FontData<'a>) -> Result<NameString<'a>, ReadError> {
    return NameString<'a>.read(
      data,
      u32.toUsize(Offset16.toU32(LangTagRecord<'a>.langTagOffset(self))),
      u16.toUsize(LangTagRecord<'a>.length(self)),
      Encoding.Utf16Be,
    )
  }
}
