import generated_aat { TypedLookup }

impl<'a> Ankr<'a> {
  pub fn anchorPoints(self: &Self, glyphId: GlyphId) -> Result<
    ComputedArray<'a, (), AnchorPoint<'a>>,
    ReadError
  > {
    let gid = GlyphId.toU32(glyphId)
    if gid > 65535 {
      return Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.failResult(
        ReadError.OutOfBounds,
      )
    }
    let lookup = match move Ankr.lookupTable(self) {
      Result<LookupU16<'a>, ReadError>.Success { value } => value
      Result<LookupU16<'a>, ReadError>.Failure { error } => {
        return Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.failResult(error)
      }
    }
    let entry = match move TypedLookup<'a, u16>.value(&lookup, u32.toU16(gid)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.failResult(error)
      }
    }
    let offset = match move usize.checkedAdd(
      u32.toUsize(Ankr.glyphDataTableOffset(self)),
      u16.toUsize(entry),
    ) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.failResult(
          ReadError.OutOfBounds,
        )
      }
    }
    let data = match move FontData.splitOff(&self._fontData, offset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.failResult(
          ReadError.OutOfBounds,
        )
      }
    }
    return match move GlyphDataEntry.read(data) {
      Result<GlyphDataEntry<'a>, ReadError>.Success { value } => Result<
        ComputedArray<'a, (), AnchorPoint<'a>>,
        ReadError
      >.succeed(GlyphDataEntry.anchorPoints(&value))
      Result<GlyphDataEntry<'a>, ReadError>.Failure { error } => Result<
        ComputedArray<'a, (), AnchorPoint<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}
