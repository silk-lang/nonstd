import silk.text.string { String, InvalidUtf8 }

pub struct TagIndex<'a> {
  pub index: u32,
  pub tag: string<'a>,
}

impl<'a> Copy for TagIndex<'a> {}

pub struct TagIndices<'a> {
  data: FontData<'a>,
  ranges: ComputedArray<'a, (), FTStringRange<'a>>,
  index: usize,
}

impl<'a> Copy for TagIndices<'a> {}

impl<'a> Ltag<'a> {
  pub fn tagIndices(self: &Self) -> TagIndices<'a> {
    return TagIndices<'a> { data: self._fontData, ranges: Ltag.tagRanges(self), index: 0 }
  }

  pub fn indexForTag(self: &Self, tag: string) -> Option<u32> {
    let mut iter = Ltag.tagIndices(self)
    while let Option<TagIndex<'a>>.Some { value } = move TagIndices<'a>.next(&mut iter) {
      if value.tag == tag {
        return Option<u32>.some(value.index)
      }
    }
    return Option<u32>.None
  }
}

impl<'a> TagIndices<'a> {
  pub fn next(self: &mut Self) -> Option<TagIndex<'a>> {
    while self.index < ComputedArray<'a, (), FTStringRange<'a>>.len(&self.ranges) {
      let index = self.index
      self.index = self.index + 1
      let range = match move ComputedArray<'a, (), FTStringRange<'a>>.get(&self.ranges, index) {
        Result<FTStringRange<'a>, ReadError>.Success { value } => value
        _ => {
          continue
        }
      }
      let start = u16.toUsize(FTStringRange.offset(&range))
      let data = match move FontData.slice(
        &self.data,
        start,
        start + u16.toUsize(FTStringRange.length(&range)),
      ) {
        Option<FontData<'a>>.Some { value } => value
        _ => {
          continue
        }
      }
      if let Result<string<'a>, InvalidUtf8>.Success { value } = move String.fromUtf8(
        FontData.asBytes(&data),
      ) {
        return Option<TagIndex<'a>>.some(TagIndex<'a> { index: usize.toU32(index), tag: value })
      }
    }
    return Option<TagIndex<'a>>.None
  }
}
