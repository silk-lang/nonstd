//! The lookup flag's high byte is a mark attachment class, not flag bits.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_types.lib { Scalar, FixedSize, readScalar, writeScalar }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.core.ops { BitOr, Subtract }
import silk.num.u16

pub struct LookupFlag {
  raw: u16,
}

impl Copy for LookupFlag {}

impl LookupFlag {
  pub fn new(raw: u16) -> Self {
    return Self { raw: raw }
  }

  pub fn default() -> Self {
    return Self { raw: 0 }
  }

  pub fn empty() -> Self {
    return Self { raw: 0 }
  }

  pub fn rightToLeft() -> Self {
    return Self { raw: 1 }
  }

  pub fn ignoreBaseGlyphs() -> Self {
    return Self { raw: 2 }
  }

  pub fn ignoreLigatures() -> Self {
    return Self { raw: 4 }
  }

  pub fn ignoreMarks() -> Self {
    return Self { raw: 8 }
  }

  pub fn useMarkFilteringSet() -> Self {
    return Self { raw: 16 }
  }

  pub fn fromBitsTruncate(bits: u16) -> Self {
    return Self { raw: bits & 65311 }
  }

  pub fn toBits(self: Self) -> u16 {
    return self.raw
  }

  pub fn contains(self: &Self, other: Self) -> bool {
    let bits = other.raw & 31
    return (self.raw & bits) == bits
  }

  pub fn markAttachmentClass(self: Self) -> Option<u16> {
    let value = u16.shiftRight(self.raw & 65280, 8)
    if value == 0 {
      return Option<u16>.None
    }
    return Option<u16>.some(value)
  }

  pub fn setMarkAttachmentClass(self: &mut Self, value: u16) -> () {
    self.raw = (self.raw & 255) | u16.shiftLeft(value & 255, 8)
  }
}

impl Scalar for LookupFlag {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(LookupFlag.new(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.raw, move bytes)
  }
}

impl FixedSize for LookupFlag {
  fn rawByteLen() -> usize {
    return 2
  }
}

impl Equal for LookupFlag {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl Order for LookupFlag {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl BitOr<LookupFlag, LookupFlag> for LookupFlag {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl Subtract<LookupFlag, LookupFlag> for LookupFlag {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}
