import font_data { FontData }
import read { ReadError, FontRead, VarSize }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u8

pub struct PString<'a> {
  bytes: &'a [u8],
}

impl<'a> Copy for PString<'a> {}

impl<'a> PString<'a> {
  pub fn asStr(self: &Self) -> string<'a> {
    return String.fromUtf8(self.bytes) |> Result<string<'a>, InvalidUtf8>.unwrapOr("")
  }

  pub fn asBytes(self: &Self) -> &'a [u8] {
    return self.bytes
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let length = match move FontData<'a>.readAt<u8>(&data, 0) {
      Result<u8, ReadError>.Success { value } => u8.toUsize(value)
      Result<u8, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let content = match move FontData.slice(&data, 1, length + 1) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let mut i: usize = 0
    while i < content.length {
      if content[i] >= 128 {
        return Result<Self, ReadError>.failResult(
          ReadError.MalformedData { message: "Must be valid ascii" },
        )
      }
      i = i + 1
    }
    return Result<Self, ReadError>.succeed(Self { bytes: content })
  }
}

impl<'a> FontRead<'a, ()> for PString<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return PString<'a>.read(data)
  }
}

impl<'a> VarSize for PString<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    return match move FontData<'b>.readAt<u8>(&data, position) {
      Result<u8, ReadError>.Success { value } => Option<usize>.some(u8.toUsize(value) + 1)
      Result<u8, ReadError>.Failure { error } => Option<usize>.None
    }
  }
}
