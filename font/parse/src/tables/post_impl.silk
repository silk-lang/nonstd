import generated_data { postName, POST_NAME_COUNT }
import read { readLenAt }

impl<'a> Post<'a> {
  pub fn numNames(self: &Self) -> usize {
    let version = Post<'a>.version(self)
    if &version == &Version16Dot16.version1_0() {
      return POST_NAME_COUNT
    }
    if &version == &Version16Dot16.version2_0() {
      return u16.toUsize(Post<'a>.numGlyphs(self) |> Option<u16>.unwrapOr(0))
    }
    return 0
  }

  pub fn glyphName(self: &Self, glyph: GlyphId16) -> Option<string<'a>> {
    let index = u16.toUsize(GlyphId16.toU16(glyph))
    let version = Post<'a>.version(self)
    if &version == &Version16Dot16.version1_0() {
      return postName(index)
    }
    if &version != &Version16Dot16.version2_0() {
      return Option<string<'a>>.None
    }
    let indices = match move Post<'a>.glyphNameIndex(self) {
      Option<ScalarArray<'a, u16>>.Some { value } => value
      _ => {
        return Option<string<'a>>.None
      }
    }
    let actual = match move ScalarArray<'a, u16>.get(&indices, index) {
      Option<u16>.Some { value } => u16.toUsize(value)
      _ => {
        return Option<string<'a>>.None
      }
    }
    if actual < POST_NAME_COUNT {
      return postName(actual)
    }
    let strings = match move Post<'a>.stringData(self) {
      Option<VarLenArray<'a, PString<'a>>>.Some { value } => value
      _ => {
        return Option<string<'a>>.None
      }
    }
    return match move VarLenArray<'a, PString<'a>>.get(&strings, actual - POST_NAME_COUNT) {
      Option<Result<PString<'a>, ReadError>>.Some { value } => match move value {
        Result<PString<'a>, ReadError>.Success { value: name } => Option<string<'a>>.some(
          PString<'a>.asStr(&name),
        )
        _ => Option<string<'a>>.None
      }
      _ => Option<string<'a>>.None
    }
  }

  pub fn glyphNames(self: &Self) -> GlyphNames<'a> {
    let count = Post<'a>.numNames(self)
    let mut stride = (count + 16) / 17
    if stride == 0 {
      stride = 1
    }
    return GlyphNames<'a> {
      post: self.*,
      count: count,
      index: 0,
      stride: stride,
      checkpoints: [4294967295; 16],
      hasLast: false,
      lastIndex: 0,
      lastOffset: 0,
      stringsEnd: usize.MAX,
    }
  }
}

pub struct GlyphNameEntry<'a> {
  pub glyph: GlyphId,
  pub name: string<'a>,
}

impl<'a> Copy for GlyphNameEntry<'a> {}

/// Cached Pascal-string offsets keep monotonic iteration linear and skip unreadable names.
pub struct GlyphNames<'a> {
  post: Post<'a>,
  count: usize,
  index: usize,
  stride: usize,
  checkpoints: [u32; 16],
  hasLast: bool,
  lastIndex: usize,
  lastOffset: usize,
  stringsEnd: usize,
}

impl<'a> Copy for GlyphNames<'a> {}

fn checkpointSlot(index: usize, stride: usize) -> Option<usize> {
  if index % stride == 0 {
    let slot = index / stride
    if slot >= 1 && slot <= 16 {
      return Option<usize>.some(slot - 1)
    }
  }
  return Option<usize>.None
}

impl<'a> GlyphNames<'a> {
  pub fn next(self: &mut Self) -> Option<GlyphNameEntry<'a>> {
    while self.index < self.count {
      let gid = self.index
      self.index = self.index + 1
      if let Option<string<'a>>.Some { value } = move GlyphNames<'a>.nameAt(&mut self, gid) {
        return Option<GlyphNameEntry<'a>>.some(
          GlyphNameEntry<'a> { glyph: GlyphId.new(usize.toU32(gid)), name: value },
        )
      }
    }
    return Option<GlyphNameEntry<'a>>.None
  }

  fn nameAt(self: &mut Self, index: usize) -> Option<string<'a>> {
    if &Post<'a>.version(&self.post) == &Version16Dot16.version1_0() {
      return postName(index)
    }
    let indices = match move Post<'a>.glyphNameIndex(&self.post) {
      Option<ScalarArray<'a, u16>>.Some { value } => value
      _ => {
        return Option<string<'a>>.None
      }
    }
    let rawIndex = match move ScalarArray<'a, u16>.get(&indices, index) {
      Option<u16>.Some { value } => u16.toUsize(value)
      _ => {
        return Option<string<'a>>.None
      }
    }
    if rawIndex < POST_NAME_COUNT {
      return postName(rawIndex)
    }
    let actual = rawIndex - POST_NAME_COUNT
    if actual >= self.stringsEnd {
      return Option<string<'a>>.None
    }
    let range = Post<'a>.stringDataByteRange(&self.post)
    let stringData = match move FontData.slice(
      &Post<'a>.offsetData(&self.post),
      range.start,
      range.end,
    ) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<string<'a>>.None
      }
    }
    let targetSlot = actual / self.stride
    let mut slot = targetSlot
    if slot > 16 {
      slot = 16
    }
    while slot > 0 && self.checkpoints[slot - 1] == 4294967295 {
      slot = slot - 1
    }
    let mut scanIndex = slot * self.stride
    let mut offset: usize = 0
    if slot > 0 {
      offset = u32.toUsize(self.checkpoints[slot - 1])
    }
    if self.hasLast && self.lastIndex <= actual && self.lastIndex > scanIndex {
      scanIndex = self.lastIndex
      offset = self.lastOffset
    }
    while scanIndex < actual {
      let length = match move readLenAt<PString<'a>>(stringData, offset) {
        Option<usize>.Some { value } => value
        _ => {
          self.stringsEnd = scanIndex
          return Option<string<'a>>.None
        }
      }
      offset = match move usize.checkedAdd(offset, length) {
        Option<usize>.Some { value } => value
        _ => {
          self.stringsEnd = scanIndex
          return Option<string<'a>>.None
        }
      }
      scanIndex = scanIndex + 1
      if let Option<usize>.Some { value } = move checkpointSlot(scanIndex, self.stride) {
        self.checkpoints[value] = match move usize.checkedToU32(offset) {
          Option<u32>.Some { value: encoded } => encoded
          _ => {
            return Option<string<'a>>.None
          }
        }
      }
    }
    if let Option<usize>.Some { value } = move checkpointSlot(actual, self.stride) {
      self.checkpoints[value] = match move usize.checkedToU32(offset) {
        Option<u32>.Some { value: encoded } => encoded
        _ => {
          return Option<string<'a>>.None
        }
      }
    }
    self.hasLast = true
    self.lastIndex = actual
    self.lastOffset = offset
    let remaining = match move FontData.splitOff(&stringData, offset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<string<'a>>.None
      }
    }
    return match move PString<'a>.read(remaining) {
      Result<PString<'a>, ReadError>.Success { value } => Option<string<'a>>.some(
        PString<'a>.asStr(&value),
      )
      _ => Option<string<'a>>.None
    }
  }
}
