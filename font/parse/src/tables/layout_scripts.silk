import silk.collections.slice { Slice }

pub struct TaggedElement<T> {
  pub tag: Tag,
  pub element: T,
}

impl<T: Copy> Copy for TaggedElement<T> {}

impl<T> TaggedElement<T> {
  pub fn new(tag: Tag, element: T) -> Self {
    return Self { tag: tag, element: move element }
  }
}

pub struct SelectedScript {
  pub tag: Tag,
  pub index: u16,
  pub isFallback: bool,
}

impl Copy for SelectedScript {}

impl Equal for SelectedScript {
  fn equals(left: &SelectedScript, right: &SelectedScript) -> bool {
    return &left.tag == &right.tag && left.index == right.index
      && left.isFallback == right.isFallback
  }
}

impl<'a> ScriptList<'a> {
  pub fn indexForTag(self: &Self, tag: Tag) -> Option<u16> {
    let records = ScriptList<'a>.scriptRecords(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), ScriptRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(&records, mid) {
        Result<ScriptRecord<'a>, ReadError>.Success { value } => value
        Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
          return Option<u16>.None
        }
      }
      if Tag.toU32(ScriptRecord<'a>.scriptTag(&record)) <= Tag.toU32(tag) {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo == 0 {
      return Option<u16>.None
    }
    let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(&records, lo - 1) {
      Result<ScriptRecord<'a>, ReadError>.Success { value } => value
      Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
        return Option<u16>.None
      }
    }
    if &ScriptRecord<'a>.scriptTag(&record) == &tag {
      return Option<u16>.some(usize.toU16(lo - 1))
    }
    return Option<u16>.None
  }

  pub fn get(self: &Self, index: u16) -> Result<TaggedElement<Script<'a>>, ReadError> {
    let record = match move ComputedArray<'a, (), ScriptRecord<'a>>.get(
      &ScriptList<'a>.scriptRecords(self),
      u16.toUsize(index),
    ) {
      Result<ScriptRecord<'a>, ReadError>.Success { value } => value
      Result<ScriptRecord<'a>, ReadError>.Failure { error } => {
        return Result<TaggedElement<Script<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move ScriptRecord<'a>.script(&record, self._fontData) {
      Result<Script<'a>, ReadError>.Success { value } => Result<
        TaggedElement<Script<'a>>,
        ReadError
      >.succeed(TaggedElement<Script<'a>>.new(ScriptRecord<'a>.scriptTag(&record), value))
      Result<Script<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<Script<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> Script<'a> {
  pub fn langSysIndexForTag(self: &Self, tag: Tag) -> Option<u16> {
    let records = Script<'a>.langSysRecords(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), LangSysRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), LangSysRecord<'a>>.get(&records, mid) {
        Result<LangSysRecord<'a>, ReadError>.Success { value } => value
        Result<LangSysRecord<'a>, ReadError>.Failure { error } => {
          return Option<u16>.None
        }
      }
      if Tag.toU32(LangSysRecord<'a>.langSysTag(&record)) <= Tag.toU32(tag) {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo == 0 {
      return Option<u16>.None
    }
    let record = match move ComputedArray<'a, (), LangSysRecord<'a>>.get(&records, lo - 1) {
      Result<LangSysRecord<'a>, ReadError>.Success { value } => value
      Result<LangSysRecord<'a>, ReadError>.Failure { error } => {
        return Option<u16>.None
      }
    }
    if &LangSysRecord<'a>.langSysTag(&record) == &tag {
      return Option<u16>.some(usize.toU16(lo - 1))
    }
    return Option<u16>.None
  }

  pub fn langSys(self: &Self, index: u16) -> Result<TaggedElement<LangSys<'a>>, ReadError> {
    let record = match move ComputedArray<'a, (), LangSysRecord<'a>>.get(
      &Script<'a>.langSysRecords(self),
      u16.toUsize(index),
    ) {
      Result<LangSysRecord<'a>, ReadError>.Success { value } => value
      Result<LangSysRecord<'a>, ReadError>.Failure { error } => {
        return Result<TaggedElement<LangSys<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move LangSysRecord<'a>.langSys(&record, self._fontData) {
      Result<LangSys<'a>, ReadError>.Success { value } => Result<
        TaggedElement<LangSys<'a>>,
        ReadError
      >.succeed(TaggedElement<LangSys<'a>>.new(LangSysRecord<'a>.langSysTag(&record), value))
      Result<LangSys<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<LangSys<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> ScriptList<'a> {
  pub fn select(self: &Self, tags: &[Tag]) -> Option<SelectedScript> {
    let mut i: usize = 0
    while i < tags.length {
      if let Option<u16>.Some { value } = ScriptList<'a>.indexForTag(self, tags[i]) {
        return Option<SelectedScript>.some(
          SelectedScript { tag: tags[i], index: value, isFallback: false },
        )
      }
      i = i + 1
    }
    let fallbacks: [Tag; 3] = [
      Tag.fromU32(1145457748),
      Tag.fromU32(1684434036),
      Tag.fromU32(1818326126),
    ]
    i = 0
    while i < 3 {
      if let Option<u16>.Some { value } = ScriptList<'a>.indexForTag(self, fallbacks[i]) {
        return Option<SelectedScript>.some(
          SelectedScript { tag: fallbacks[i], index: value, isFallback: true },
        )
      }
      i = i + 1
    }
    return Option<SelectedScript>.None
  }
}

impl<'a> FeatureList<'a> {
  pub fn get(self: &Self, index: u16) -> Result<TaggedElement<Feature<'a>>, ReadError> {
    let record = match move ComputedArray<'a, (), FeatureRecord<'a>>.get(
      &FeatureList<'a>.featureRecords(self),
      u16.toUsize(index),
    ) {
      Result<FeatureRecord<'a>, ReadError>.Success { value } => value
      Result<FeatureRecord<'a>, ReadError>.Failure { error } => {
        return Result<TaggedElement<Feature<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move FeatureRecord<'a>.feature(&record, self._fontData) {
      Result<Feature<'a>, ReadError>.Success { value } => Result<
        TaggedElement<Feature<'a>>,
        ReadError
      >.succeed(TaggedElement<Feature<'a>>.new(FeatureRecord<'a>.featureTag(&record), value))
      Result<Feature<'a>, ReadError>.Failure { error } => Result<
        TaggedElement<Feature<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a> LangSys<'a> {
  pub fn featureIndexForTag<'b>(self: &Self, list: &FeatureList<'b>, tag: Tag) -> Option<u16> {
    let indices = LangSys<'a>.featureIndices(self)
    let records = FeatureList.featureRecords(list)
    let mut i: usize = 0
    while i < ScalarArray<u16>.len(&indices) {
      let index = ScalarArray<u16>.get(&indices, i) |> Option<u16>.unwrapOr(0)
      if let Result<FeatureRecord<'b>, ReadError>.Success { value } = ComputedArray<
        'b,
        (),
        FeatureRecord<'b>
      >.get(&records, u16.toUsize(index)) {
        if &FeatureRecord<'b>.featureTag(&value) == &tag {
          return Option<u16>.some(index)
        }
      }
      i = i + 1
    }
    return Option<u16>.None
  }
}

pub struct ScriptTags {
  tags: [Tag; 3],
  length: usize,
}

impl Copy for ScriptTags {}

impl ScriptTags {
  pub fn default() -> Self {
    return Self { tags: [Tag.default(); 3], length: 0 }
  }

  pub fn fromUnicode(unicodeScript: Tag) -> Self {
    let mut result = ScriptTags.default()
    if let Option<Tag>.Some { value } = newTagFromUnicode(unicodeScript) {
      if Tag.toU32(value) != 1836674354 {
        result.tags[0] = Tag.fromU32(Tag.toU32(value) + 1)
        result.length = 1
      }
      result.tags[result.length] = value
      result.length = result.length + 1
    }
    result.tags[result.length] = oldTagFromUnicode(unicodeScript)
    result.length = result.length + 1
    return result
  }

  pub fn asSlice<'s>(self: &'s Self) -> &'s [Tag] {
    return Slice.view(&self.tags, 0, self.length)
  }
}

fn oldTagFromUnicode(tag: Tag) -> Tag {
  if Tag.toU32(tag) == 1517122664 {
    return Tag.fromU32(1835103336)
  }
  if Tag.toU32(tag) == 1214870113 {
    return Tag.fromU32(1801547361)
  }
  if Tag.toU32(tag) == 1281453935 {
    return Tag.fromU32(1818324768)
  }
  if Tag.toU32(tag) == 1500080489 {
    return Tag.fromU32(2036932640)
  }
  if Tag.toU32(tag) == 1315663727 {
    return Tag.fromU32(1852534560)
  }
  if Tag.toU32(tag) == 1449224553 {
    return Tag.fromU32(1986095392)
  }
  let mut bytes = Tag.toBeBytes(tag)
  if bytes[0] >= 65 && bytes[0] <= 90 {
    bytes[0] = bytes[0] + 32
  }
  return Tag.fromBeBytes(bytes)
}

fn newTagFromUnicode(tag: Tag) -> Option<Tag> {
  if Tag.toU32(tag) == 1113943655 {
    return Option<Tag>.some(Tag.fromU32(1651402546))
  }
  if Tag.toU32(tag) == 1147500129 {
    return Option<Tag>.some(Tag.fromU32(1684370994))
  }
  if Tag.toU32(tag) == 1198877298 {
    return Option<Tag>.some(Tag.fromU32(1735029298))
  }
  if Tag.toU32(tag) == 1198879349 {
    return Option<Tag>.some(Tag.fromU32(1735750194))
  }
  if Tag.toU32(tag) == 1265525857 {
    return Option<Tag>.some(Tag.fromU32(1802396722))
  }
  if Tag.toU32(tag) == 1298954605 {
    return Option<Tag>.some(Tag.fromU32(1835822386))
  }
  if Tag.toU32(tag) == 1299803506 {
    return Option<Tag>.some(Tag.fromU32(1836674354))
  }
  if Tag.toU32(tag) == 1332902241 {
    return Option<Tag>.some(Tag.fromU32(1869773106))
  }
  if Tag.toU32(tag) == 1415671148 {
    return Option<Tag>.some(Tag.fromU32(1953328178))
  }
  if Tag.toU32(tag) == 1415933045 {
    return Option<Tag>.some(Tag.fromU32(1952803890))
  }
  return Option<Tag>.None
}
