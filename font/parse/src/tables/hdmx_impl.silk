pub struct DeviceRecord<'a> {
  pixelSizeValue: u8,
  maxWidthValue: u8,
  widthsValue: &'a [u8],
}

impl<'a> Copy for DeviceRecord<'a> {}

impl<'a> DeviceRecord<'a> {
  pub fn pixelSize(self: &Self) -> u8 {
    return self.pixelSizeValue
  }

  pub fn maxWidth(self: &Self) -> u8 {
    return self.maxWidthValue
  }

  pub fn widths(self: &Self) -> &'a [u8] {
    return self.widthsValue
  }

  pub fn read(data: FontData<'a>, numGlyphs: u32, sizeDeviceRecord: u32) -> Result<
    Self,
    ReadError
  > {
    let pixels = match move FontData<'a>.readAt<u8>(&data, 0) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let maximum = match move FontData<'a>.readAt<u8>(&data, 1) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move usize.checkedAdd(2, u32.toUsize(numGlyphs)) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let bytes = match move FontData.slice(&data, 2, end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { pixelSizeValue: pixels, maxWidthValue: maximum, widthsValue: bytes },
    )
  }
}

impl<'a> ComputeSize<ReadArgs2<u32, u32>> for DeviceRecord<'a> {
  fn computeSize(args: ReadArgs2<u32, u32>) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(u32.toUsize(args.second))
  }
}

impl<'a> FontRead<'a, ReadArgs2<u32, u32>> for DeviceRecord<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u32, u32>) -> Result<Self, ReadError> {
    return DeviceRecord.read(data, args.first, args.second)
  }
}

impl<'a> FontReadAt<'a, ReadArgs2<u32, u32>> for DeviceRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ReadArgs2<u32, u32>) -> Result<
    Self,
    ReadError
  > {
    return match move FontData.splitOff(&data, position) {
      Option<FontData<'a>>.Some { value } => DeviceRecord.read(value, args.first, args.second)
      _ => Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

impl<'a> Hdmx<'a> {
  pub fn recordForSize(self: &Self, size: u8) -> Option<DeviceRecord<'a>> {
    let records = Hdmx.records(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, ReadArgs2<u32, u32>, DeviceRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, ReadArgs2<u32, u32>, DeviceRecord<'a>>.get(
        &records,
        mid,
      ) {
        Result<DeviceRecord<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<DeviceRecord<'a>>.None
        }
      }
      if record.pixelSizeValue < size {
        lo = mid + 1
      } else if record.pixelSizeValue > size {
        hi = mid
      } else {
        return Option<DeviceRecord<'a>>.some(record)
      }
    }
    return Option<DeviceRecord<'a>>.None
  }
}
