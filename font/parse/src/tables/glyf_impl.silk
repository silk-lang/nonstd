import font_data { Cursor }
import font_types.lib { Point, F26Dot6 }
import silk.core.ops { Add, Multiply }
import silk.num.i8
import silk.num.f32

pub const PHANTOM_POINT_COUNT: usize = 4

pub struct PointMarker {
  raw: u8,
}

impl Copy for PointMarker {}

impl PointMarker {
  pub fn hasDelta() -> Self {
    return Self { raw: 4 }
  }

  pub fn touchedX() -> Self {
    return Self { raw: 16 }
  }

  pub fn touchedY() -> Self {
    return Self { raw: 32 }
  }

  pub fn touched() -> Self {
    return Self { raw: 48 }
  }

  pub fn weakInterpolation() -> Self {
    return Self { raw: 2 }
  }

  pub fn near() -> Self {
    return Self { raw: 8 }
  }

  pub fn default() -> Self {
    return Self { raw: 0 }
  }
}

impl Equal for PointMarker {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl BitOr<PointMarker, PointMarker> for PointMarker {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

pub struct PointFlags {
  raw: u8,
}

impl Copy for PointFlags {}

impl Equal for PointFlags {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl PointFlags {
  pub fn default() -> Self {
    return Self { raw: 0 }
  }

  pub fn onCurve() -> Self {
    return Self { raw: 1 }
  }

  pub fn offCurveQuad() -> Self {
    return Self { raw: 0 }
  }

  pub fn offCurveCubic() -> Self {
    return Self { raw: 128 }
  }

  pub fn fromBits(bits: u8) -> Self {
    return Self { raw: bits & 129 }
  }

  pub fn toBits(self: Self) -> u8 {
    return self.raw
  }

  pub fn isOnCurve(self: Self) -> bool {
    return (self.raw & 1) != 0
  }

  pub fn isOffCurveQuad(self: Self) -> bool {
    return (self.raw & 129) == 0
  }

  pub fn isOffCurveCubic(self: Self) -> bool {
    return (self.raw & 129) == 128
  }

  pub fn isOffCurve(self: Self) -> bool {
    return PointFlags.isOffCurveQuad(self) || PointFlags.isOffCurveCubic(self)
  }

  pub fn flipOnCurve(self: &mut Self) -> () {
    self.raw = self.raw ^ 1
  }

  pub fn setOnCurve(self: &mut Self) -> () {
    self.raw = self.raw | 1
  }

  pub fn clearOnCurve(self: &mut Self) -> () {
    self.raw = self.raw & 254
  }

  pub fn hasMarker(self: Self, marker: PointMarker) -> bool {
    return (self.raw & marker.raw) != 0
  }

  pub fn setMarker(self: &mut Self, marker: PointMarker) -> () {
    self.raw = self.raw | marker.raw
  }

  pub fn clearMarker(self: &mut Self, marker: PointMarker) -> () {
    self.raw = self.raw & ~marker.raw
  }

  pub fn withoutMarkers(self: Self) -> Self {
    return PointFlags.fromBits(self.raw)
  }
}

pub interface PointCoord {
  fn fromFixed(value: Fixed) -> Self

  fn fromI32(value: i32) -> Self

  fn toF32(value: Self) -> f32

  fn midpoint(value: Self, other: Self) -> Self

  fn lessEqual(left: Self, right: Self) -> bool

  fn greaterEqual(left: Self, right: Self) -> bool

  fn greater(left: Self, right: Self) -> bool
}

impl PointCoord for Fixed {
  fn lessEqual(left: Self, right: Self) -> bool {
    return &left <= &right
  }

  fn greaterEqual(left: Self, right: Self) -> bool {
    return &left >= &right
  }

  fn greater(left: Self, right: Self) -> bool {
    return &left > &right
  }

  fn fromFixed(value: Fixed) -> Self {
    return value
  }

  fn fromI32(value: i32) -> Self {
    return Fixed.fromI32(value)
  }

  fn toF32(value: Self) -> f32 {
    return Fixed.toF32(value)
  }

  fn midpoint(value: Self, other: Self) -> Self {
    return Fixed.fromBits(i32.wrappingAdd(Fixed.toBits(value), Fixed.toBits(other)) / 2)
  }
}

impl PointCoord for F26Dot6 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return &left <= &right
  }

  fn greaterEqual(left: Self, right: Self) -> bool {
    return &left >= &right
  }

  fn greater(left: Self, right: Self) -> bool {
    return &left > &right
  }

  fn fromFixed(value: Fixed) -> Self {
    return Fixed.toF26dot6(value)
  }

  fn fromI32(value: i32) -> Self {
    return F26Dot6.fromI32(value)
  }

  fn toF32(value: Self) -> f32 {
    return F26Dot6.toF32(value)
  }

  fn midpoint(value: Self, other: Self) -> Self {
    return F26Dot6.fromBits(i32.wrappingAdd(F26Dot6.toBits(value), F26Dot6.toBits(other)) / 2)
  }
}

impl PointCoord for i32 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return left <= right
  }

  fn greaterEqual(left: Self, right: Self) -> bool {
    return left >= right
  }

  fn greater(left: Self, right: Self) -> bool {
    return left > right
  }

  fn fromFixed(value: Fixed) -> Self {
    return Fixed.toI32(value)
  }

  fn fromI32(value: i32) -> Self {
    return value
  }

  fn toF32(value: Self) -> f32 {
    return i32.toF32(value)
  }

  fn midpoint(value: Self, other: Self) -> Self {
    return i32.wrappingAdd(value, other) / 2
  }
}

impl PointCoord for f32 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return left <= right
  }

  fn greaterEqual(left: Self, right: Self) -> bool {
    return left >= right
  }

  fn greater(left: Self, right: Self) -> bool {
    return left > right
  }

  fn fromFixed(value: Fixed) -> Self {
    return Fixed.toF32(value)
  }

  fn fromI32(value: i32) -> Self {
    return i32.toF32(value)
  }

  fn toF32(value: Self) -> f32 {
    return value
  }

  fn midpoint(value: Self, other: Self) -> Self {
    return value + 0.5 * (other - value)
  }
}

pub fn coordFromFixed<C: PointCoord>(value: Fixed) -> C {
  return PointCoord.fromFixed(value)
}

pub fn coordFromI32<C: PointCoord>(value: i32) -> C {
  return PointCoord.fromI32(value)
}

pub fn coordMidpoint<C: PointCoord>(value: C, other: C) -> C {
  return PointCoord.midpoint(move value, move other)
}

pub fn coordToF32<C: PointCoord>(value: C) -> f32 {
  return PointCoord.toF32(move value)
}

impl<'a> SimpleGlyph<'a> {
  pub fn numPoints(self: &Self) -> usize {
    let ends = SimpleGlyph.endPtsOfContours(self)
    let count = ScalarArray<u16>.len(&ends)
    if count == 0 {
      return 0
    }
    return u16.toUsize(ScalarArray<u16>.get(&ends, count - 1) |> Option<u16>.unwrapOr(0)) + 1
  }

  pub fn hasOverlappingContours(self: &Self) -> bool {
    let data = SimpleGlyph.glyphData(self)
    return ((ScalarArray<u8>.get(&data, 0) |> Option<u8>.unwrapOr(0)) & 64) != 0
  }

  pub fn readPointsFast<C: PointCoord>(
    self: &Self,
    points: &mut [Point<C>],
    flags: &mut [PointFlags],
  ) -> Result<(), ReadError> {
    let count = SimpleGlyph.numPoints(self)
    if points.length != count || flags.length != count {
      return Result<(), ReadError>.failResult(ReadError.InvalidArrayLen)
    }
    if count == 0 {
      return Result<(), ReadError>.succeed(())
    }
    let data = ScalarArray<u8>.offsetData(&SimpleGlyph.glyphData(self))
    let mut cursor = FontData.cursor(&data)
    let mut i: usize = 0
    while i < count {
      let bits = match move Cursor<'a>.read<u8>(&mut cursor) {
        Result<u8, ReadError>.Success { value } => value
        _ => {
          break
        }
      }
      let mut repeats: usize = 1
      if (bits & 8) != 0 {
        repeats = match move Cursor<'a>.read<u8>(&mut cursor) {
          Result<u8, ReadError>.Success { value } => u8.toUsize(value) + 1
          Result<u8, ReadError>.Failure { error } => {
            return Result<(), ReadError>.failResult(error)
          }
        }
      }
      if repeats > count - i {
        repeats = count - i
      }
      let end = i + repeats
      while i < end {
        flags[i] = PointFlags { raw: bits }
        i = i + 1
      }
    }

    // A missing flag byte is not consumed by the upstream slice iterator.
    if cursor.pos > FontData.len(&data) {
      cursor.pos = FontData.len(&data)
    }
    let mut x: i32 = 0
    i = 0
    while i < count {
      let delta = match move readPointDelta(&mut cursor, flags[i].raw, 2, 16) {
        Result<i16, ReadError>.Success { value } => i16.toI32(value)
        Result<i16, ReadError>.Failure { error } => {
          return Result<(), ReadError>.failResult(error)
        }
      }
      x = i32.wrappingAdd(x, delta)
      points[i].x = coordFromI32<C>(x)
      i = i + 1
    }
    let mut y: i32 = 0
    i = 0
    while i < count {
      let delta = match move readPointDelta(&mut cursor, flags[i].raw, 4, 32) {
        Result<i16, ReadError>.Success { value } => i16.toI32(value)
        Result<i16, ReadError>.Failure { error } => {
          return Result<(), ReadError>.failResult(error)
        }
      }
      y = i32.wrappingAdd(y, delta)
      points[i].y = coordFromI32<C>(y)
      flags[i].raw = flags[i].raw & 129
      i = i + 1
    }
    return Result<(), ReadError>.succeed(())
  }

  pub fn points(self: &Self) -> PointIter<'a> {
    let count = SimpleGlyph.numPoints(self)
    if count == 0 || count > 65535 {
      return PointIter.empty()
    }
    let data = ScalarArray<u8>.offsetData(&SimpleGlyph.glyphData(self))
    let lengths = match move resolveCoordsLen(data, count) {
      Result<GlyphFieldLengths, ReadError>.Success { value } => value
      _ => {
        return PointIter.empty()
      }
    }
    if lengths.flags + lengths.x + lengths.y > FontData.len(&data) {
      return PointIter.empty()
    }
    let flags = FontData.slice(&data, 0, lengths.flags)
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    let xs = FontData.slice(&data, lengths.flags, lengths.flags + lengths.x)
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    let ys = FontData.splitOff(&data, lengths.flags + lengths.x)
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    return PointIter<'a> {
      flags: FontData.cursor(&flags),
      xs: FontData.cursor(&xs),
      ys: FontData.cursor(&ys),
      repeats: 0,
      bits: 0,
      x: 0,
      y: 0,
    }
  }
}

fn readPointDelta<'a>(cursor: &mut Cursor<'a>, bits: u8, short: u8, same: u8) -> Result<
  i16,
  ReadError
> {
  if (bits & short) != 0 {
    let byte = match move Cursor<'a>.read<u8>(&mut cursor) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<i16, ReadError>.failResult(error)
      }
    }
    let mut delta = u8.toI16(byte)
    if (bits & same) == 0 {
      delta = -delta
    }
    return Result<i16, ReadError>.succeed(delta)
  }
  if (bits & same) == 0 {
    return Cursor<'a>.read<i16>(&mut cursor)
  }
  return Result<i16, ReadError>.succeed(0)
}

struct GlyphFieldLengths {
  flags: usize,
  x: usize,
  y: usize,
}

impl Copy for GlyphFieldLengths {}

fn resolveCoordsLen<'a>(data: FontData<'a>, count: usize) -> Result<GlyphFieldLengths, ReadError> {
  let mut cursor = FontData.cursor(&data)
  let mut left = count
  let mut x: usize = 0
  let mut y: usize = 0
  while left > 0 {
    let bits = match move Cursor<'a>.read<u8>(&mut cursor) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<GlyphFieldLengths, ReadError>.failResult(error)
      }
    }
    let mut repeats: usize = 1
    if (bits & 8) != 0 {
      repeats = match move Cursor<'a>.read<u8>(&mut cursor) {
        Result<u8, ReadError>.Success { value } => u8.toUsize(value) + 1
        Result<u8, ReadError>.Failure { error } => {
          return Result<GlyphFieldLengths, ReadError>.failResult(error)
        }
      }
    }
    if repeats > left {
      return Result<GlyphFieldLengths, ReadError>.failResult(
        ReadError.MalformedData { message: "repeat count too large in glyf" },
      )
    }
    if (bits & 2) != 0 {
      x = x + repeats
    } else {
      if (bits & 18) == 0 {
        x = x + repeats * 2
      }
    }
    if (bits & 4) != 0 {
      y = y + repeats
    } else {
      if (bits & 36) == 0 {
        y = y + repeats * 2
      }
    }
    left = left - repeats
  }
  return Result<GlyphFieldLengths, ReadError>.succeed(
    GlyphFieldLengths { flags: cursor.pos, x: x, y: y },
  )
}

pub struct CurvePoint {
  pub x: i16,
  pub y: i16,
  pub onCurve: bool,
  pub cubic: bool,
}

impl Copy for CurvePoint {}

impl Equal for CurvePoint {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.x == right.x && left.y == right.y && left.onCurve == right.onCurve
      && left.cubic == right.cubic
  }
}

impl CurvePoint {
  pub fn new(x: i16, y: i16, onCurve: bool) -> Self {
    return Self { x: x, y: y, onCurve: onCurve, cubic: false }
  }

  pub fn onCurvePoint(x: i16, y: i16) -> Self {
    return CurvePoint.new(x, y, true)
  }

  pub fn offCurve(x: i16, y: i16) -> Self {
    return CurvePoint.new(x, y, false)
  }

  pub fn offCurveCubic(x: i16, y: i16) -> Self {
    return Self { x: x, y: y, onCurve: false, cubic: true }
  }
}

pub struct PointIter<'a> {
  flags: Cursor<'a>,
  xs: Cursor<'a>,
  ys: Cursor<'a>,
  repeats: u16,
  bits: u8,
  x: i16,
  y: i16,
}

impl<'a> Copy for PointIter<'a> {}

impl<'a> PointIter<'a> {
  fn empty() -> Self {
    return Self {
      flags: FontData.cursor(&FontData.new(b"")),
      xs: FontData.cursor(&FontData.new(b"")),
      ys: FontData.cursor(&FontData.new(b"")),
      repeats: 0,
      bits: 0,
      x: 0,
      y: 0,
    }
  }

  pub fn next(self: &mut Self) -> Option<CurvePoint> {
    if self.repeats == 0 {
      self.bits = match move Cursor<'a>.read<u8>(&mut self.flags) {
        Result<u8, ReadError>.Success { value } => value
        _ => {
          return Option<CurvePoint>.None
        }
      }
      self.repeats = 1
      if (self.bits & 8) != 0 {
        self.repeats = u8.toU16(
          Cursor<'a>.read<u8>(&mut self.flags) |> Result<u8, ReadError>.unwrapOr(0),
        )
          + 1
      }
    }
    self.repeats = self.repeats - 1
    self.x = i16.wrappingAdd(
      self.x,
      readPointDelta(&mut self.xs, self.bits, 2, 16) |> Result<i16, ReadError>.unwrapOr(0),
    )
    self.y = i16.wrappingAdd(
      self.y,
      readPointDelta(&mut self.ys, self.bits, 4, 32) |> Result<i16, ReadError>.unwrapOr(0),
    )
    return Option<CurvePoint>.some(
      CurvePoint {
        x: self.x,
        y: self.y,
        onCurve: (self.bits & 1) != 0,
        cubic: (self.bits & 128) != 0,
      },
    )
  }
}

pub struct Transform {
  pub xx: F2Dot14,
  pub yx: F2Dot14,
  pub xy: F2Dot14,
  pub yy: F2Dot14,
}

impl Copy for Transform {}

impl Equal for Transform {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.xx == &right.xx && &left.yx == &right.yx && &left.xy == &right.xy
      && &left.yy == &right.yy
  }
}

impl Transform {
  pub fn default() -> Self {
    return Self { xx: F2Dot14.one(), yx: F2Dot14.zero(), xy: F2Dot14.zero(), yy: F2Dot14.one() }
  }

  pub fn computeFlags(self: &Self) -> CompositeGlyphFlags {
    if F2Dot14.toBits(self.yx) != 0 || F2Dot14.toBits(self.xy) != 0 {
      return CompositeGlyphFlags.weHaveATwoByTwo()
    }
    if F2Dot14.toBits(self.xx) != F2Dot14.toBits(self.yy) {
      return CompositeGlyphFlags.weHaveAnXAndYScale()
    }
    if F2Dot14.toBits(self.xx) != 16384 {
      return CompositeGlyphFlags.weHaveAScale()
    }
    return CompositeGlyphFlags.empty()
  }
}

pub union Anchor {
  Offset { pub x: i16, pub y: i16 },
  Point { pub base: u16, pub component: u16 },
}

impl Copy for Anchor {}

impl Equal for Anchor {
  fn equals(left: &Self, right: &Self) -> bool {
    return match left.* {
      Anchor.Offset { x, y } => match right.* {
        Anchor.Offset { x: rx, y: ry } => x == rx && y == ry
        _ => false
      }
      Anchor.Point { base, component } => match right.* {
        Anchor.Point { base: rb, component: rc } => base == rb && component == rc
        _ => false
      }
    }
  }
}

impl Anchor {
  pub fn computeFlags(self: &Self) -> CompositeGlyphFlags {
    let mut bits: u16 = 0
    match &self.* {
      Anchor.Offset { x, y } => {
        bits = 2
        if x < -128 || x > 127 || y < -128 || y > 127 {
          bits = bits | 1
        }
      }
      Anchor.Point { base, component } => {
        if base > 255 || component > 255 {
          bits = 1
        }
      }
    }
    return CompositeGlyphFlags.fromBitsTruncate(bits)
  }
}

pub struct Component {
  pub flags: CompositeGlyphFlags,
  pub glyph: GlyphId,
  pub anchor: Anchor,
  pub transform: Transform,
}

impl Copy for Component {}

impl Equal for Component {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.flags == &right.flags && &left.glyph == &right.glyph
      && &left.anchor == &right.anchor
      && &left.transform == &right.transform
  }
}

pub struct ComponentGlyphFlags {
  pub glyph: GlyphId,
  pub flags: CompositeGlyphFlags,
}

impl Copy for ComponentGlyphFlags {}

pub struct ComponentIter<'a> {
  cursor: Cursor<'a>,
  done: bool,
}

impl<'a> Copy for ComponentIter<'a> {}

pub struct ComponentGlyphIdFlagsIter<'a> {
  cursor: Cursor<'a>,
  done: bool,
}

impl<'a> Copy for ComponentGlyphIdFlagsIter<'a> {}

fn readComponentGlyph<'a>(cursor: &mut Cursor<'a>, bits: u16) -> Option<GlyphId> {
  if (bits & 8192) != 0 {
    return match move Cursor<'a>.read<Uint24>(&mut cursor) {
      Result<Uint24, ReadError>.Success { value } => Option<GlyphId>.some(
        GlyphId.new(Uint24.toU32(value)),
      )
      _ => Option<GlyphId>.None
    }
  }
  return match move Cursor<'a>.read<u16>(&mut cursor) {
    Result<u16, ReadError>.Success { value } => Option<GlyphId>.some(GlyphId.new(u16.toU32(value)))
    _ => Option<GlyphId>.None
  }
}

impl<'a> ComponentGlyphIdFlagsIter<'a> {
  pub fn next(self: &mut Self) -> Option<ComponentGlyphFlags> {
    if self.done {
      return Option<ComponentGlyphFlags>.None
    }
    let bits = match move Cursor<'a>.read<u16>(&mut self.cursor) {
      Result<u16, ReadError>.Success { value } => value
      _ => {
        return Option<ComponentGlyphFlags>.None
      }
    }
    let glyph = match move readComponentGlyph(&mut self.cursor, bits) {
      Option<GlyphId>.Some { value } => value
      _ => {
        return Option<ComponentGlyphFlags>.None
      }
    }
    let mut arguments: usize = 2
    if (bits & 1) != 0 {
      arguments = 4
    }
    Cursor.advanceBy(&mut self.cursor, arguments)
    if (bits & 8) != 0 {
      Cursor.advanceBy(&mut self.cursor, 2)
    } else {
      if (bits & 64) != 0 {
        Cursor.advanceBy(&mut self.cursor, 4)
      } else {
        if (bits & 128) != 0 {
          Cursor.advanceBy(&mut self.cursor, 8)
        }
      }
    }
    self.done = (bits & 32) == 0
    return Option<ComponentGlyphFlags>.some(
      ComponentGlyphFlags { glyph: glyph, flags: CompositeGlyphFlags.fromBitsTruncate(bits) },
    )
  }
}

impl<'a> ComponentIter<'a> {
  pub fn next(self: &mut Self) -> Option<Component> {
    if self.done {
      return Option<Component>.None
    }
    let bits = match move Cursor<'a>.read<u16>(&mut self.cursor) {
      Result<u16, ReadError>.Success { value } => value
      _ => {
        return Option<Component>.None
      }
    }
    let glyph = match move readComponentGlyph(&mut self.cursor, bits) {
      Option<GlyphId>.Some { value } => value
      _ => {
        return Option<Component>.None
      }
    }
    let mut anchor = Anchor.Point { base: 0, component: 0 }
    if (bits & 2) != 0 {
      let mut x: i16 = 0
      let mut y: i16 = 0
      if (bits & 1) != 0 {
        x = match move Cursor<'a>.read<i16>(&mut self.cursor) {
          Result<i16, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
        y = match move Cursor<'a>.read<i16>(&mut self.cursor) {
          Result<i16, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
      } else {
        x = match move Cursor<'a>.read<i8>(&mut self.cursor) {
          Result<i8, ReadError>.Success { value } => i8.toI16(value)
          _ => {
            return Option<Component>.None
          }
        }
        y = match move Cursor<'a>.read<i8>(&mut self.cursor) {
          Result<i8, ReadError>.Success { value } => i8.toI16(value)
          _ => {
            return Option<Component>.None
          }
        }
      }
      anchor = Anchor.Offset { x: x, y: y }
    } else {
      let mut base: u16 = 0
      let mut component: u16 = 0
      if (bits & 1) != 0 {
        base = match move Cursor<'a>.read<u16>(&mut self.cursor) {
          Result<u16, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
        component = match move Cursor<'a>.read<u16>(&mut self.cursor) {
          Result<u16, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
      } else {
        base = match move Cursor<'a>.read<u8>(&mut self.cursor) {
          Result<u8, ReadError>.Success { value } => u8.toU16(value)
          _ => {
            return Option<Component>.None
          }
        }
        component = match move Cursor<'a>.read<u8>(&mut self.cursor) {
          Result<u8, ReadError>.Success { value } => u8.toU16(value)
          _ => {
            return Option<Component>.None
          }
        }
      }
      anchor = Anchor.Point { base: base, component: component }
    }
    let mut transform = Transform.default()
    if (bits & 8) != 0 {
      transform.xx = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
        Result<F2Dot14, ReadError>.Success { value } => value
        _ => {
          return Option<Component>.None
        }
      }
      transform.yy = transform.xx
    } else {
      if (bits & 64) != 0 {
        transform.xx = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
          Result<F2Dot14, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
        transform.yy = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
          Result<F2Dot14, ReadError>.Success { value } => value
          _ => {
            return Option<Component>.None
          }
        }
      } else {
        if (bits & 128) != 0 {
          transform.xx = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
            Result<F2Dot14, ReadError>.Success { value } => value
            _ => {
              return Option<Component>.None
            }
          }
          transform.yx = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
            Result<F2Dot14, ReadError>.Success { value } => value
            _ => {
              return Option<Component>.None
            }
          }
          transform.xy = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
            Result<F2Dot14, ReadError>.Success { value } => value
            _ => {
              return Option<Component>.None
            }
          }
          transform.yy = match move Cursor<'a>.read<F2Dot14>(&mut self.cursor) {
            Result<F2Dot14, ReadError>.Success { value } => value
            _ => {
              return Option<Component>.None
            }
          }
        }
      }
    }
    self.done = (bits & 32) == 0
    return Option<Component>.some(
      Component {
        flags: CompositeGlyphFlags.fromBitsTruncate(bits),
        glyph: glyph,
        anchor: anchor,
        transform: transform,
      },
    )
  }
}

pub struct ComponentCountAndInstructions<'a> {
  pub count: usize,
  pub instructions: Option<&'a [u8]>,
}

impl<'a> CompositeGlyph<'a> {
  pub fn components(self: &Self) -> ComponentIter<'a> {
    return ComponentIter<'a> {
      cursor: FontData.cursor(&ScalarArray<u8>.offsetData(&CompositeGlyph.componentData(self))),
      done: false,
    }
  }

  pub fn componentGlyphsAndFlags(self: &Self) -> ComponentGlyphIdFlagsIter<'a> {
    return ComponentGlyphIdFlagsIter<'a> {
      cursor: FontData.cursor(&ScalarArray<u8>.offsetData(&CompositeGlyph.componentData(self))),
      done: false,
    }
  }

  pub fn countAndInstructions(self: &Self) -> ComponentCountAndInstructions<'a> {
    let mut iter = CompositeGlyph.componentGlyphsAndFlags(self)
    let mut count: usize = 0
    let mut hasInstructions = false
    while let Option<ComponentGlyphFlags>.Some { value } = move ComponentGlyphIdFlagsIter.next(
      &mut iter,
    ) {
      count = count + 1
      hasInstructions = hasInstructions || (CompositeGlyphFlags.bits(&value.flags) & 256) != 0
    }
    let mut instructions = Option<&'a [u8]>.None
    if hasInstructions {
      if let Result<u16, ReadError>.Success { value } = move Cursor<'a>.read<u16>(
        &mut iter.cursor,
      ) {
        if let Result<ScalarArray<'a, u8>, ReadError>.Success { value: bytes } = move Cursor<
          'a
        >.readArray<u8>(&mut iter.cursor, u16.toUsize(value)) {
          instructions = Option<&'a [u8]>.some(
            FontData.asBytes(&ScalarArray<u8>.offsetData(&bytes)),
          )
        }
      }
    }
    return ComponentCountAndInstructions<'a> { count: count, instructions: move instructions }
  }

  pub fn instructions(self: &Self) -> Option<&'a [u8]> {
    let value = CompositeGlyph.countAndInstructions(self)
    return move value.instructions
  }
}

impl<'a> Glyph<'a> {
  pub fn numberOfContours(self: &Self) -> i16 {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.numberOfContours(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.numberOfContours(&value)
    }
  }

  pub fn xMin(self: &Self) -> i16 {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.xMin(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.xMin(&value)
    }
  }

  pub fn yMin(self: &Self) -> i16 {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.yMin(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.yMin(&value)
    }
  }

  pub fn xMax(self: &Self) -> i16 {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.xMax(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.xMax(&value)
    }
  }

  pub fn yMax(self: &Self) -> i16 {
    return match &self.* {
      Glyph<'a>.Simple { value } => SimpleGlyph.yMax(&value)
      Glyph<'a>.Composite { value } => CompositeGlyph.yMax(&value)
    }
  }
}

// Coordinate conversions admitted by upstream's From bound.
pub interface PointFrom<C> {
  fn fromCoordinate(value: C) -> Self
}

impl PointFrom<i32> for i32 {
  fn fromCoordinate(value: i32) -> Self {
    return value
  }
}

impl PointFrom<Fixed> for Fixed {
  fn fromCoordinate(value: Fixed) -> Self {
    return value
  }
}

impl PointFrom<F26Dot6> for F26Dot6 {
  fn fromCoordinate(value: F26Dot6) -> Self {
    return value
  }
}

impl PointFrom<f32> for f32 {
  fn fromCoordinate(value: f32) -> Self {
    return value
  }
}

impl PointFrom<i32> for Fixed {
  fn fromCoordinate(value: i32) -> Self {
    return Fixed.fromI32(value)
  }
}

pub fn convertPointCoord<C, D: PointFrom<C>>(value: C) -> D {
  return PointFrom<C>.fromCoordinate(move value)
}

pub fn coordLessEqual<C: PointCoord>(left: C, right: C) -> bool {
  return PointCoord.lessEqual(move left, move right)
}

pub fn coordGreaterEqual<C: PointCoord>(left: C, right: C) -> bool {
  return PointCoord.greaterEqual(move left, move right)
}

pub fn coordGreater<C: PointCoord>(left: C, right: C) -> bool {
  return PointCoord.greater(move left, move right)
}
