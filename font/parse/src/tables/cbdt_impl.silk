import tables.bitmap { BitmapData, BitmapLocation, bitmapData }

impl<'a> Cbdt<'a> {
  pub fn data(self: &Self, location: &BitmapLocation<'a>) -> Result<BitmapData<'a>, ReadError> {
    return bitmapData(Cbdt.offsetData(self), location, true)
  }
}
