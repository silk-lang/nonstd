import font_types.lib { F48Dot16 }
import generated_variations { advanceDeltaWithScalars, itemDeltaWithScalars }

impl<'a> Hvar<'a> {
  pub fn computeScalars(self: &Self, coords: &[F2Dot14], out: &mut [Fixed]) -> usize {
    return match move Hvar.itemVariationStore(self) {
      Result<ItemVariationStore<'a>, ReadError>.Success {
        value
      } => ItemVariationStore.computeScalars(&value, coords, &mut out)
      _ => 0
    }
  }

  pub fn advanceDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Hvar.advanceDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn advanceDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return advanceDeltaWithScalars(
      Hvar.advanceWidthMapping(self),
      Hvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }

  pub fn lsbDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Hvar.lsbDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn lsbDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return itemDeltaWithScalars(
      Hvar.lsbMapping(self),
      Hvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }

  pub fn rsbDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Hvar.rsbDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn rsbDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return itemDeltaWithScalars(
      Hvar.rsbMapping(self),
      Hvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }
}
