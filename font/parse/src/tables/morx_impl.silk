import read { VarSize }

impl<'a> VarSize for Chain<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    let offset = match move usize.checkedAdd(position, 4) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<usize>.None
      }
    }
    return match move FontData<'b>.readAt<u32>(&data, offset) {
      Result<u32, ReadError>.Success { value } => Option<usize>.some(u32.toUsize(value))
      _ => Option<usize>.None
    }
  }
}

impl<'a> VarSize for Subtable<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    return match move FontData<'b>.readAt<u32>(&data, position) {
      Result<u32, ReadError>.Success { value } => Option<usize>.some(u32.toUsize(value))
      _ => Option<usize>.None
    }
  }
}

import generated_aat {
  ExtendedStateTable,
  StateTableParts,
  NoPayload,
  LookupU16,
  TypedLookup,
  safeReadArrayToEnd
}
import font_types.lib { BigEndian }

impl<'a> FontRead<'a, ()> for ContextualEntryData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ContextualEntryData<'a>.readAt(data, 0, ())
  }
}

impl<'a> FontRead<'a, ()> for InsertionEntryData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return InsertionEntryData<'a>.readAt(data, 0, ())
  }
}

impl<'a> Subtable<'a> {
  pub fn isLogical(self: &Self) -> bool {
    return Subtable.coverage(self) & 268435456 != 0
  }

  pub fn isAllDirections(self: &Self) -> bool {
    return Subtable.coverage(self) & 536870912 != 0
  }

  pub fn isBackwards(self: &Self) -> bool {
    return Subtable.coverage(self) & 1073741824 != 0
  }

  pub fn isVertical(self: &Self) -> bool {
    return Subtable.coverage(self) & 2147483648 != 0
  }

  pub fn kind(self: &Self) -> Result<SubtableKind<'a>, ReadError> {
    return SubtableKind<'a>.readWithArgs(
      ScalarArray<u8>.offsetData(&Subtable.data(self)),
      Subtable.coverage(self),
    )
  }
}

pub union SubtableKind<'a> {
  Rearrangement { pub value: ExtendedStateTable<'a, NoPayload> },
  Contextual { pub value: ContextualSubtable<'a> },
  Ligature { pub value: LigatureSubtable<'a> },
  NonContextual { pub value: LookupU16<'a> },
  Insertion { pub value: InsertionSubtable<'a> },
}

impl<'a> Copy for SubtableKind<'a> {}

pub struct SubtableParts {
  pub format: u8,
  pub state: StateTableParts,
  pub extra: [u32; 3],
}

impl Copy for SubtableParts {}

impl SubtableParts {
  pub fn default() -> Self {
    return Self { format: 0, state: StateTableParts.default(), extra: [0; 3] }
  }
}

impl<'a> SubtableKind<'a> {
  pub fn readWithArgs(data: FontData<'a>, coverage: u32) -> Result<Self, ReadError> {
    let format = coverage & 255
    if format == 0 {
      let value = match move ExtendedStateTable<'a, NoPayload>.read(data) {
        Result<ExtendedStateTable<'a, NoPayload>, ReadError>.Success { value } => value
        Result<ExtendedStateTable<'a, NoPayload>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Rearrangement { value: value })
    }
    if format == 1 {
      let value = match move ContextualSubtable<'a>.read(data) {
        Result<ContextualSubtable<'a>, ReadError>.Success { value } => value
        Result<ContextualSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Contextual { value: value })
    }
    if format == 2 {
      let value = match move LigatureSubtable<'a>.read(data) {
        Result<LigatureSubtable<'a>, ReadError>.Success { value } => value
        Result<LigatureSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Ligature { value: value })
    }
    if format == 4 {
      let value = match move TypedLookup<'a, u16>.read(data) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.NonContextual { value: value })
    }
    if format == 5 {
      let value = match move InsertionSubtable<'a>.read(data) {
        Result<InsertionSubtable<'a>, ReadError>.Success { value } => value
        Result<InsertionSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Insertion { value: value })
    }
    return Result<Self, ReadError>.failResult(ReadError.InvalidFormat { value: u32.toI64(format) })
  }

  pub fn parts(data: FontData<'a>, coverage: u32) -> Result<SubtableParts, ReadError> {
    let mut parts = SubtableParts.default()
    parts.format = u32.toU8(coverage & 255)
    if parts.format == 4 {
      return Result<SubtableParts, ReadError>.succeed(parts)
    }
    parts.state = match move StateTableParts.read(data) {
      Result<StateTableParts, ReadError>.Success { value } => value
      Result<StateTableParts, ReadError>.Failure { error } => {
        return Result<SubtableParts, ReadError>.failResult(error)
      }
    }
    if parts.format == 1 || parts.format == 5 {
      parts.extra[0] = match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
    }
    if parts.format == 2 {
      parts.extra[0] = match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
      parts.extra[1] = match move FontData<'a>.readAt<u32>(&data, 20) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
      parts.extra[2] = match move FontData<'a>.readAt<u32>(&data, 24) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
    }
    return Result<SubtableParts, ReadError>.succeed(parts)
  }

  pub fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    if parts.format == 0 {
      let value = match move ExtendedStateTable<'a, NoPayload>.fromParts(data, &parts.state) {
        Result<ExtendedStateTable<'a, NoPayload>, ReadError>.Success { value } => value
        Result<ExtendedStateTable<'a, NoPayload>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Rearrangement { value: value })
    }
    if parts.format == 1 {
      let value = match move ContextualSubtable<'a>.fromParts(data, parts) {
        Result<ContextualSubtable<'a>, ReadError>.Success { value } => value
        Result<ContextualSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Contextual { value: value })
    }
    if parts.format == 2 {
      let value = match move LigatureSubtable<'a>.fromParts(data, parts) {
        Result<LigatureSubtable<'a>, ReadError>.Success { value } => value
        Result<LigatureSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Ligature { value: value })
    }
    if parts.format == 4 {
      let value = match move TypedLookup<'a, u16>.read(data) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.NonContextual { value: value })
    }
    if parts.format == 5 {
      let value = match move InsertionSubtable<'a>.fromParts(data, parts) {
        Result<InsertionSubtable<'a>, ReadError>.Success { value } => value
        Result<InsertionSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Insertion { value: value })
    }
    return Result<Self, ReadError>.failResult(
      ReadError.InvalidFormat { value: u8.toI64(parts.format) },
    )
  }
}

impl<'a> FontRead<'a, u32> for SubtableKind<'a> {
  fn readWithArgs(data: FontData<'a>, args: u32) -> Result<Self, ReadError> {
    return SubtableKind<'a>.readWithArgs(data, args)
  }
}

pub struct ContextualSubtable<'a> {
  pub stateTable: ExtendedStateTable<'a, ContextualEntryData<'a>>,
  lookupOffsets: ScalarArray<'a, Offset32>,
  lookupData: FontData<'a>,
}

impl<'a> Copy for ContextualSubtable<'a> {}

impl<'a> ContextualSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, ContextualEntryData<'a>>.read(data) {
      Result<ExtendedStateTable<'a, ContextualEntryData<'a>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, ContextualEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let offsetsData = match move FontData.splitOff(&data, offset0) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let offsets = match move safeReadArrayToEnd<Offset32>(&offsetsData, 0) {
      Result<ScalarArray<'a, Offset32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset32>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { stateTable: state, lookupOffsets: offsets, lookupData: offsetsData },
    )
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, ContextualEntryData<'a>>.fromParts(
      data,
      &parts.state,
    ) {
      Result<ExtendedStateTable<'a, ContextualEntryData<'a>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, ContextualEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(parts.extra[0])
    let offsetsData = match move FontData.splitOff(&data, offset0) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let offsets = match move safeReadArrayToEnd<Offset32>(&offsetsData, 0) {
      Result<ScalarArray<'a, Offset32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset32>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { stateTable: state, lookupOffsets: offsets, lookupData: offsetsData },
    )
  }

  pub fn lookup(self: &Self, index: usize) -> Option<LookupU16<'a>> {
    let offset = match move ScalarArray<Offset32>.get(&self.lookupOffsets, index) {
      Option<Offset32>.Some { value } => value
      _ => {
        return Option<LookupU16<'a>>.None
      }
    }
    return match move resolve<LookupU16<'a>, Offset32>(offset, self.lookupData) {
      Result<LookupU16<'a>, ReadError>.Success { value } => Option<LookupU16<'a>>.some(value)
      _ => Option<LookupU16<'a>>.None
    }
  }
}

impl<'a> FontRead<'a, ()> for ContextualSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ContextualSubtable<'a>.read(data)
  }
}

pub struct LigatureSubtable<'a> {
  pub stateTable: ExtendedStateTable<'a, BigEndian<u16>>,
  pub ligatureActions: ScalarArray<'a, u32>,
  pub components: ScalarArray<'a, u16>,
  pub ligatures: ScalarArray<'a, GlyphId16>,
}

impl<'a> Copy for LigatureSubtable<'a> {}

impl<'a> LigatureSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, BigEndian<u16>>.read(data) {
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let offset1 = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 20) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let offset2 = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 24) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let actions = match move safeReadArrayToEnd<u32>(&data, offset0) {
      Result<ScalarArray<'a, u32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u32>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let components = match move safeReadArrayToEnd<u16>(&data, offset1) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let ligatures = match move safeReadArrayToEnd<GlyphId16>(&data, offset2) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        stateTable: state,
        ligatureActions: actions,
        components: components,
        ligatures: ligatures,
      },
    )
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, BigEndian<u16>>.fromParts(data, &parts.state) {
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(parts.extra[0])
    let offset1 = u32.toUsize(parts.extra[1])
    let offset2 = u32.toUsize(parts.extra[2])
    let actions = match move safeReadArrayToEnd<u32>(&data, offset0) {
      Result<ScalarArray<'a, u32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u32>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let components = match move safeReadArrayToEnd<u16>(&data, offset1) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let ligatures = match move safeReadArrayToEnd<GlyphId16>(&data, offset2) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        stateTable: state,
        ligatureActions: actions,
        components: components,
        ligatures: ligatures,
      },
    )
  }
}

impl<'a> FontRead<'a, ()> for LigatureSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LigatureSubtable<'a>.read(data)
  }
}

pub struct InsertionSubtable<'a> {
  pub stateTable: ExtendedStateTable<'a, InsertionEntryData<'a>>,
  pub glyphs: ScalarArray<'a, GlyphId16>,
}

impl<'a> Copy for InsertionSubtable<'a> {}

impl<'a> InsertionSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, InsertionEntryData<'a>>.read(data) {
      Result<ExtendedStateTable<'a, InsertionEntryData<'a>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, InsertionEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let glyphs = match move safeReadArrayToEnd<GlyphId16>(&data, offset0) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, glyphs: glyphs })
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, InsertionEntryData<'a>>.fromParts(
      data,
      &parts.state,
    ) {
      Result<ExtendedStateTable<'a, InsertionEntryData<'a>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, InsertionEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u32.toUsize(parts.extra[0])
    let glyphs = match move safeReadArrayToEnd<GlyphId16>(&data, offset0) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, glyphs: glyphs })
  }
}

impl<'a> FontRead<'a, ()> for InsertionSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return InsertionSubtable<'a>.read(data)
  }
}
