//! fvar's externally described, parameterized instance record.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_data { FontData, Cursor }
import read { ReadError, FontRead, FontReadAt, ComputeSize }
import read_args { ReadArgs2 }
import array { ScalarArray }
import font_types.lib { Fixed, NameId }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.num.u16

pub struct InstanceRecord<'a> {
  pub subfamilyNameId: NameId,
  pub flags: u16,
  pub coordinates: ScalarArray<'a, Fixed>,
  pub postScriptNameId: Option<NameId>,
}

impl<'a> InstanceRecord<'a> {
  pub fn read(data: FontData<'a>, axisCount: u16, instanceSize: u16) -> Result<Self, ReadError> {
    let mut cursor = FontData.cursor(&data)
    let name = match move Cursor<'a>.read<NameId>(&mut cursor) {
      Result<NameId, ReadError>.Success { value } => value
      Result<NameId, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let flags = match move Cursor<'a>.read<u16>(&mut cursor) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let coords = match move Cursor<'a>.readArray<Fixed>(&mut cursor, u16.toUsize(axisCount)) {
      Result<ScalarArray<'a, Fixed>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Fixed>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let mut ps = Option<NameId>.None
    if u16.toUsize(instanceSize) >= 6 + u16.toUsize(axisCount) * 4 {
      let id = match move Cursor<'a>.read<NameId>(&mut cursor) {
        Result<NameId, ReadError>.Success { value } => value
        Result<NameId, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      if NameId.toU16(id) != 65535 {
        ps = Option<NameId>.some(id)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { subfamilyNameId: name, flags: flags, coordinates: coords, postScriptNameId: move ps },
    )
  }
}

impl<'a> FontRead<'a, ReadArgs2<u16, u16>> for InstanceRecord<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u16, u16>) -> Result<Self, ReadError> {
    return InstanceRecord<'a>.read(data, args.first, args.second)
  }
}

impl<'a> FontReadAt<'a, ReadArgs2<u16, u16>> for InstanceRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ReadArgs2<u16, u16>) -> Result<
    Self,
    ReadError
  > {
    return match move FontData.splitOff(&data, position) {
      Option<FontData<'a>>.Some { value } => InstanceRecord<'a>.read(value, args.first, args.second)
      Option<FontData<'a>>.None => Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

impl<'a> ComputeSize<ReadArgs2<u16, u16>> for InstanceRecord<'a> {
  fn computeSize(args: ReadArgs2<u16, u16>) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(u16.toUsize(args.second))
  }
}
