impl<'a> TrackData<'a> {
  pub fn sizeTable(self: &Self, offsetData: FontData<'a>) -> Option<ScalarArray<'a, Fixed>> {
    let start = u32.toUsize(TrackData.sizeTableOffset(self))
    return match move FontData<'a>.readArray<Fixed>(
      &offsetData,
      start,
      usize.saturatingAdd(start, u16.toUsize(TrackData.nSizes(self)) * 4),
    ) {
      Result<ScalarArray<'a, Fixed>, ReadError>.Success { value } => Option<
        ScalarArray<'a, Fixed>
      >.some(value)
      _ => Option<ScalarArray<'a, Fixed>>.None
    }
  }
}

impl<'a> TrackTableEntry<'a> {
  pub fn perSizeValues<'b>(self: &Self, offsetData: FontData<'b>, nSizes: u16) -> Option<
    ScalarArray<'b, i16>
  > {
    let start = u16.toUsize(TrackTableEntry.offset(self))
    return match move FontData<'b>.readArray<i16>(
      &offsetData,
      start,
      start + u16.toUsize(nSizes) * 2,
    ) {
      Result<ScalarArray<'b, i16>, ReadError>.Success { value } => Option<
        ScalarArray<'b, i16>
      >.some(value)
      _ => Option<ScalarArray<'b, i16>>.None
    }
  }
}
