test effect fn generatedConditionVarintsRoundtrip() -> ()
  ! AssertionError<'static> {
  let table = run vcjk()
  let mut state: u32 = 305419896
  let mut n: usize = 0
  while n < 256 {
    state = vstate(state)
    let mut bytes: [u8; 10] = [0; 10]
    bytes[0] = 128
    bytes[1] = 128
    bytes[3] = 1
    let end = vvar(&mut bytes, 4, state)
    bytes[end] = 170
    let mut cursor = FontData.cursor(&FontData.new(Slice.view(&bytes, 0, end + 1)))
    let item = run vparse(&table, &mut cursor)
    run Testing.expect(
      (run vsome(VarcComponent.conditionIndex(&item))) == state,
      "generated varint",
    )
    run vsentinel(&mut cursor)
    n = n + 1
  }
}

test effect fn generatedAxisValuesSingleRunRoundtrip() -> ()
  ! AssertionError<'static> {
  let table = run vcond()
  let mut state: u32 = 2779077210
  let mut n: usize = 0
  while n < 128 {
    state = vstate(state)
    let kind = state & 3
    let mut bytes: [u8; 28] = [0; 28]
    bytes[0] = 18
    bytes[2] = 1
    bytes[3] = 1
    bytes[4] = match kind {
      0 => 4
      1 => 68
      2 => 196
      _ => 132
    }
    let mut end: usize = 5
    let mut expected: [f32; 5] = [0.0; 5]
    let mut i: usize = 0
    while i < 5 {
      if kind != 3 {
        state = u32.wrappingAdd(u32.wrappingMultiply(state, 1664525), 1013904223)
      }
      match kind {
        0 => {
          let v = VarcCast.u8ToI8(u32.toU8(u32.shiftRight(state, 24))) % 64
          bytes[end] = VarcCast.i8ToU8(v)
          end = end + 1
          expected[i] = i8.toF32(v)
        }
        1 => {
          let v = VarcCast.u16ToI16(u32.toU16(u32.shiftRight(state, 16))) % 2048
          VarcBuilder.put16(&mut bytes, end, VarcCast.i16ToU16(v))
          end = end + 2
          expected[i] = i16.toF32(v)
        }
        2 => {
          let v = VarcCast.u32ToI32(state) % 1000000
          VarcBuilder.put32(&mut bytes, end, VarcCast.i32ToU32(v))
          end = end + 4
          expected[i] = i32.toF32(v)
        }
        _ => {}
      }
      i = i + 1
    }
    bytes[end] = 0
    bytes[end + 1] = 7
    bytes[end + 2] = 170
    end = end + 3
    let mut cursor = FontData.cursor(&FontData.new(Slice.view(&bytes, 0, end)))
    let item = run vparse(&table, &mut cursor)
    let deltas = run vsome(VarcComponent.axisValues(&item))
    let mut fetcher = PackedDeltas.fetcher(&deltas)
    let mut out: [f32; 5] = [0.0; 5]
    drop run vmust(PackedDeltaFetcher.addToF32Scaled(&mut fetcher, &mut out, 1.0))
    i = 0
    while i < 5 {
      run Testing.expect(out[i] == expected[i], "generated packed values")
      i = i + 1
    }
    run Testing.expect(
      DecomposedTransform.translateX(&VarcComponent.transform(&item)) == 7.0,
      "translate after generated run",
    )
    run vsentinel(&mut cursor)
    n = n + 1
  }
}

test effect fn parseComponentTruncatedConditionVarintBoundariesError() -> ()
  ! AssertionError<'static> {
  let values: [u32; 4] = [128, 16384, 2097152, 268435456]
  let table = run vcjk()
  let mut i: usize = 0
  while i < 4 {
    let mut bytes: [u8; 9] = [0; 9]
    bytes[0] = 128
    bytes[1] = 128
    bytes[3] = 1
    let end = vvar(&mut bytes, 4, values[i])
    run vbadComponent(&table, Slice.view(&bytes, 0, end - 1))
    i = i + 1
  }
}

test effect fn readGlyph6868() -> ()
  ! AssertionError<'static> {
  let font = run vmust(FontRef.new(VarcFixtures.varcCjkFont()))
  let cmap = run vmust(FontRef.cmap(&font))
  let gid = run vsome(Cmap.mapCodepoint(&cmap, 26728))
  let table = run vmust(FontRef.varc(&font))
  let index = run vsome(CoverageTable.get(&run vmust(Varc.coverage(&table)), gid))
  let glyph = run vmust(Varc.glyph(&table, u32.toUsize(index)))
  let mut components = VarcGlyph.components(&glyph)
  let expected: [u32; 3] = [2, 5, 7]
  let mut i: usize = 0
  while i < 3 {
    let item = run vmust(run vsome(VarcComponentIter.next(&mut components)))
    run Testing.expect(GlyphId.toU32(VarcComponent.gid(&item)) == expected[i], "component glyph")
    i = i + 1
  }
  run Testing.expect(vnone(VarcComponentIter.next(&mut components)), "all components")
}

effect fn vmatrix(transform: DecomposedTransform, expected: [f32; 6]) -> ()
  ! AssertionError<'static> {
  let actual = (DecomposedTransform.matrix(&transform)).coefficients()
  let mut i: usize = 0
  while i < 6 {
    run Testing.expect(
      f32.round(actual[i] * 1000000.0) / 1000000.0 == expected[i],
      "matrix rounded to six digits",
    )
    i = i + 1
  }
}

test effect fn decomposedScaleToMatrix() -> ()
  ! AssertionError<'static> {
  let mut t = DecomposedTransform.default()
  t._scaleX = 2.0
  t._scaleY = 3.0
  run vmatrix(t, [2.0, 0.0, 0.0, 3.0, 0.0, 0.0])
}

test effect fn decomposedRotateToMatrix() -> ()
  ! AssertionError<'static> {
  let mut t = DecomposedTransform.default()
  t._rotation = 0.5
  run vmatrix(t, [0.0, 1.0, -1.0, 0.0, 0.0, 0.0])
}

test effect fn decomposedSkewToMatrix() -> ()
  ! AssertionError<'static> {
  let mut t = DecomposedTransform.default()
  t._skewX = 1.0 / 6.0
  t._skewY = -1.0 / 3.0
  let pi: f32 = 3.14159265358979323846
  run vmatrix(
    t,
    [
      1.0,
      f32.round((unsafe tanf(t._skewY * pi)) * 1000000.0) / 1000000.0,
      f32.round((unsafe tanf(-t._skewX * pi)) * 1000000.0) / 1000000.0,
      1.0,
      0.0,
      0.0,
    ],
  )
}

