}

test effect fn readMultivarStoreRegionList() -> ()
  ! AssertionError<'static> {
  let table = run vcjk()
  let store = run vmust(run vsome(Varc.multiVarStore(&table)))
  let regions = SparseVariationRegionList.regions(
    &run vmust(MultiItemVariationStore.regionList(&store)),
  )
  let indices: [usize; 3] = [0, 2, 38]
  let counts: [usize; 3] = [1, 2, 1]
  let mut i: usize = 0
  while i < 3 {
    let region = run vmust(
      ArrayOfOffsets<'static, (), SparseVariationRegion<'static>, Offset32>.get(
        &regions,
        indices[i],
      ),
    )
    let axes = SparseVariationRegion.axisCoordinates(&region)
    run Testing.expect(
      ArrayOfOffsets<'static, (), SparseRegionAxisCoordinates<'static>, Offset32>.len(&axes)
        == counts[i],
      "region axes count",
    )
    let mut j: usize = 0
    while j < counts[i] {
      let axis = run vmust(
        ArrayOfOffsets<'static, (), SparseRegionAxisCoordinates<'static>, Offset32>.get(&axes, j),
      )
      let mut id = usize.toU16(j)
      if i == 2 {
        id = 6
      }
      let mut start: f32 = 0.0
      let mut peak: f32 = 1.0
      let mut end: f32 = 1.0
      if i == 2 {
        start = -1.0
        peak = -1.0
        end = 0.0
      }
      run Testing.expect(
        SparseRegionAxisCoordinates.axisIndex(&axis) == id
          && F2Dot14.toF32(SparseRegionAxisCoordinates.start(&axis)) == start
          && F2Dot14.toF32(SparseRegionAxisCoordinates.peak(&axis)) == peak
          && F2Dot14.toF32(SparseRegionAxisCoordinates.end(&axis)) == end,
        "sparse region coordinates",
      )
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn readMultivarStoreDeltaSets() -> ()
  ! AssertionError<'static> {
  let table = run vcjk()
  let store = run vmust(run vsome(Varc.multiVarStore(&table)))
  let data = MultiItemVariationStore.variationData(&store)
  let regions: [u16; 4] = [3, 33, 10, 25]
  let counts: [u32; 4] = [6, 6, 5, 8]
  run Testing.expect(
    ArrayOfOffsets<'static, (), MultiItemVariationData<'static>, Offset32>.len(&data) == 4,
    "four variation data",
  )
  let mut i: usize = 0
  while i < 4 {
    let item = run vmust(
      ArrayOfOffsets<'static, (), MultiItemVariationData<'static>, Offset32>.get(&data, i),
    )
    run Testing.expect(
      MultiItemVariationData.regionIndexCount(&item) == regions[i]
        && Index2.count(&run vmust(MultiItemVariationData.deltaSets(&item))) == counts[i],
      "variation counts",
    )
    i = i + 1
  }
  let first = run vmust(
    ArrayOfOffsets<'static, (), MultiItemVariationData<'static>, Offset32>.get(&data, 0),
  )
  run vdeltas(run vmust(MultiItemVariationData.deltaSet(&first, 5)), &[-1, 33, 0, 0, 0, 0])
}

effect fn vtableOffset(data: &[u8]) -> usize
  ! AssertionError<'static> {
  let font = run vmust(FontRef.new(data))
  let records = TableDirectory.tableRecords(FontRef.tableDirectory(&font))
  let mut i: usize = 0
  while i < TableRecords.len(&records) {
    let record = run vsome(TableRecords.get(&records, i))
    if Tag.toU32(TableRecord.tag(&record)) == 1447121475 {
      return u32.toUsize(TableRecord.offset(&record))
    }
    i = i + 1
  }
  run Testing.expect(false, "VARC directory record")
  return 0
}

effect fn vregion<'a>(list: &SparseVariationRegionList<'a>, index: usize) -> SparseVariationRegion<
  'a
>
  ! AssertionError<'static> {
  return run vmust(
    ArrayOfOffsets<'a, (), SparseVariationRegion<'a>, Offset32>.get(
      &SparseVariationRegionList.regions(list),
      index,
    ),
  )
}
