test effect fn parseComponentScaleXOnlyAppliesToScaleY() -> ()
  ! AssertionError<'static> {
  let mut cursor = FontData.cursor(&FontData.new(b"\x81\x00\x00\x01\x08\x00\xaa"))
  let item = run vparse(&run vcjk(), &mut cursor)
  let t = VarcComponent.transform(&item)
  run Testing.expect(
    DecomposedTransform.scaleX(&t) == 2.0 && DecomposedTransform.scaleY(&t) == 2.0,
    "uniform scale",
