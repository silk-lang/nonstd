// IntSet-dependent layout extensions, appended by font/scripts/generate.
import collections.int_set { IntSet, IntSetIter, Bound }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64

fn glyphSetFirst(glyphs: &IntSet<GlyphId>) -> u32 {
  return GlyphId.toU32(IntSet<GlyphId>.first(glyphs) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)))
}

fn glyphSetLast(glyphs: &IntSet<GlyphId>) -> u32 {
  return GlyphId.toU32(IntSet<GlyphId>.last(glyphs) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)))
}

fn glyphSetRange(glyphs: &IntSet<GlyphId>, first: u32, last: u32) -> IntSetIter<GlyphId> {
  return IntSet<GlyphId>.range(
    glyphs,
    Bound<GlyphId>.Included { value: GlyphId.new(first) },
    Bound<GlyphId>.Included { value: GlyphId.new(last) },
  )
}

effect fn extendGlyphs(out: &mut IntSet<GlyphId>, input: IntSetIter<GlyphId>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut iter = move input
  while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
    drop run IntSet<GlyphId>.insert(&mut out, value)
  }
}

// Preserve the original u32 heuristic's release-mode wrapping without traps.
fn coverageSearchSet(count: u32, glyphs: &IntSet<GlyphId>, cost: u32) -> bool {
  let length = u64.toU32(IntSet<GlyphId>.len(glyphs) & 4294967295)
  return count > u32.wrappingMultiply(length, cost)
}

impl<'a> RangeRecord<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    return IntSet<GlyphId>.intersectsRange(
      glyphs,
      GlyphId.new(GlyphId16.toU32(RangeRecord<'a>.startGlyphId(self))),
      GlyphId.new(GlyphId16.toU32(RangeRecord<'a>.endGlyphId(self))),
    )
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    if coverageSearchSet(
      u16.toU32(CoverageFormat1<'a>.glyphCount(self)),
      glyphs,
      CoverageFormat1<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat1<'a>.get(self, value) {
          return true
        }
      }
    } else {
      let array = CoverageFormat1<'a>.glyphArray(self)
      let mut at: usize = 0
      while let Option<GlyphId16>.Some { value } = ScalarArray<GlyphId16>.get(&array, at) {
        if IntSet<GlyphId>.contains(glyphs, GlyphId.new(GlyphId16.toU32(value))) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if coverageSearchSet(
      u16.toU32(CoverageFormat1<'a>.glyphCount(self)),
      glyphs,
      CoverageFormat1<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat1<'a>.get(self, value) {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let array = CoverageFormat1<'a>.glyphArray(self)
      let mut at: usize = 0
      while let Option<GlyphId16>.Some { value } = ScalarArray<GlyphId16>.get(&array, at) {
        let glyph = GlyphId.new(GlyphId16.toU32(value))
        if IntSet<GlyphId>.contains(glyphs, glyph) {
          drop run IntSet<GlyphId>.insert(&mut out, glyph)
        }
        at = at + 1
      }
    }
    return move out
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    if coverageSearchSet(
      u16.toU32(CoverageFormat2<'a>.rangeCount(self)),
      glyphs,
      CoverageFormat2<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat2<'a>.get(self, value) {
          return true
        }
      }
    } else {
      let array = CoverageFormat2<'a>.rangeRecords(self)
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value } = rangeAt<RangeRecord<'a>>(&array, at) {
        if IntSet<GlyphId>.intersectsRange(
          glyphs,
          GlyphId.new(value.start),
          GlyphId.new(value.end),
        ) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if coverageSearchSet(
      u16.toU32(CoverageFormat2<'a>.rangeCount(self)),
      glyphs,
      CoverageFormat2<'a>.cost(self),
    ) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if let Option<u16>.Some { value: index } = CoverageFormat2<'a>.get(self, value) {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let array = CoverageFormat2<'a>.rangeRecords(self)
      let mut at: usize = 0
      let mut last: u32 = 0
      while let Option<LayoutRange>.Some { value } = rangeAt<RangeRecord<'a>>(&array, at) {
        if value.start < last {
          break
        }
        last = value.end
        let start = GlyphId.new(value.start)
        if IntSet<GlyphId>.contains(glyphs, start) {
          drop run IntSet<GlyphId>.insert(&mut out, start)
        }
        let mut iter = IntSet<GlyphId>.iterAfter(glyphs, start)
        while let Option<GlyphId>.Some { value: glyph } = IntSetIter<GlyphId>.next(&mut iter) {
          if GlyphId.toU32(glyph) > value.end {
            break
          }
          drop run IntSet<GlyphId>.insert(&mut out, glyph)
        }
        at = at + 1
      }
    }
    return move out
  }
}

impl<'a> CoverageTable<'a> {
  pub fn intersects(self: &Self, glyphs: &IntSet<GlyphId>) -> bool {
    match &self.* {
      CoverageTable<'a>.Format1 { value } => {
        return CoverageFormat1<'a>.intersects(&value, glyphs)
      }
      CoverageTable<'a>.Format2 { value } => {
        return CoverageFormat2<'a>.intersects(&value, glyphs)
      }
      CoverageTable<'a>.Format3 { value } => {
        let array = CoverageFormat3<'a>.glyphArray(&value)
        let mut at: usize = 0
        while let Option<GlyphId24>.Some { value: glyph } = ScalarArray<GlyphId24>.get(&array, at) {
          if IntSet<GlyphId>.contains(glyphs, GlyphId.new(GlyphId24.toU32(glyph))) {
            return true
          }
          at = at + 1
        }
      }
      CoverageTable<'a>.Format4 { value } => {
        let array = CoverageFormat4<'a>.rangeRecords(&value)
        let mut at: usize = 0
        while let Option<LayoutRange>.Some { value: range } = rangeAt<RangeRecord2<'a>>(
          &array,
          at,
        ) {
          if IntSet<GlyphId>.intersectsRange(
            glyphs,
            GlyphId.new(range.start),
            GlyphId.new(range.end),
          ) {
            return true
          }
          at = at + 1
        }
      }
    }
    return false
  }

  pub effect fn intersectSet(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<GlyphId>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      CoverageTable<'a>.Format1 { value } => {
        return run CoverageFormat1<'a>.intersectSet(&value, glyphs)
      }
      CoverageTable<'a>.Format2 { value } => {
        return run CoverageFormat2<'a>.intersectSet(&value, glyphs)
      }
      CoverageTable<'a>.Format3 { value } => {
        let mut out = IntSet<GlyphId>.empty()
        let array = CoverageFormat3<'a>.glyphArray(&value)
        let mut at: usize = 0
        while let Option<GlyphId24>.Some { value: raw } = ScalarArray<GlyphId24>.get(&array, at) {
          let glyph = GlyphId.new(GlyphId24.toU32(raw))
          if IntSet<GlyphId>.contains(glyphs, glyph) {
            drop run IntSet<GlyphId>.insert(&mut out, glyph)
          }
          at = at + 1
        }
        return move out
      }
      CoverageTable<'a>.Format4 { value } => {
        let mut out = IntSet<GlyphId>.empty()
        let array = CoverageFormat4<'a>.rangeRecords(&value)
        let mut at: usize = 0
        while let Option<LayoutRange>.Some { value: range } = rangeAt<RangeRecord2<'a>>(
          &array,
          at,
        ) {
          if range.start <= range.end {
            run IntSet<GlyphId>.insertRange(
              &mut out,
              GlyphId.new(range.start),
              GlyphId.new(range.end),
            )
          }
          at = at + 1
        }
        run IntSet<GlyphId>.intersect(&mut out, glyphs)
        return move out
      }
    }
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u16>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<u16>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let count = ScalarArray<u16>.len(&values)
    if count == 0 {
      drop run IntSet<u16>.insert(&mut out, 0)
      return move out
    }
    let end = start + usize.toU32(count) - 1
    if glyphSetFirst(glyphs) < start || glyphSetLast(glyphs) > end {
      drop run IntSet<u16>.insert(&mut out, 0)
    }
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let class = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: class } => class
        _ => {
          break
        }
      }
      drop run IntSet<u16>.insert(&mut out, class)
    }
    return move out
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let count = u16.toU32(ClassDefFormat1<'a>.glyphCount(self))
    if count == 0 {
      if class == 0 {
        return run IntSet<GlyphId>.clone(glyphs)
      }
      return move out
    }
    let end = start + count - 1
    if class == 0 {
      let first = glyphSetFirst(glyphs)
      let last = glyphSetLast(glyphs)
      if first < start {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, first, start - 1))
      }
      if last > end {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, end + 1, last))
      }
      return move out
    }
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let found = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: found } => found
        _ => {
          break
        }
      }
      if found == class {
        drop run IntSet<GlyphId>.insert(&mut out, value)
      }
    }
    return move out
  }

  pub fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> bool {
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return false
    }
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    let count = u16.toU32(ClassDefFormat1<'a>.glyphCount(self))
    if count == 0 {
      return class == 0
    }
    let end = start + count - 1
    if class == 0 && (glyphSetFirst(glyphs) < start || glyphSetLast(glyphs) > end) {
      return true
    }
    let values = ClassDefFormat1<'a>.classValueArray(self)
    let mut iter = glyphSetRange(glyphs, start, end)
    while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
      let found = match move ScalarArray<u16>.get(
        &values,
        u32.toUsize(GlyphId.toU32(value) - start),
      ) {
        Option<u16>.Some { value: found } => found
        _ => {
          return false
        }
      }
      if found == class {
        return true
      }
    }
    return false
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u16>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<u16>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    let first = match move rangeAt<ClassRangeRecord<'a>>(&records, 0) {
      Option<LayoutRange>.Some { value } => value
      _ => {
        drop run IntSet<u16>.insert(&mut out, 0)
        return move out
      }
    }
    if glyphSetFirst(glyphs) < first.start {
      drop run IntSet<u16>.insert(&mut out, 0)
    } else {
      let mut glyph = GlyphId.new(first.end)
      let mut at: usize = 1
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        let next = match move IntSet<GlyphId>.nextAfter(glyphs, glyph) {
          Option<GlyphId>.Some { value } => value
          _ => {
            break
          }
        }
        if GlyphId.toU32(next) < range.start {
          drop run IntSet<u16>.insert(&mut out, 0)
          break
        }
        glyph = GlyphId.new(range.end)
        at = at + 1
      }
      if let Option<GlyphId>.Some { value } = IntSet<GlyphId>.nextAfter(glyphs, glyph) {
        drop run IntSet<u16>.insert(&mut out, 0)
      }
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        let class = ClassDefFormat2<'a>.get(self, value)
        if class != 0 {
          drop run IntSet<u16>.insert(&mut out, class)
        }
      }
    } else {
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if IntSet<GlyphId>.intersectsRange(
          glyphs,
          GlyphId.new(range.start),
          GlyphId.new(range.end),
        ) {
          drop run IntSet<u16>.insert(&mut out, u32.toU16(range.value))
        }
        at = at + 1
      }
    }
    return move out
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = IntSet<GlyphId>.empty()
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return move out
    }
    let first = glyphSetFirst(glyphs)
    let last = glyphSetLast(glyphs)
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    if class == 0 {
      let mut start = first
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if start < range.start {
          run extendGlyphs(&mut out, glyphSetRange(glyphs, start, range.start - 1))
        }
        if range.end >= last {
          break
        }
        start = range.end + 1
        at = at + 1
      }
      if start <= last {
        run extendGlyphs(&mut out, glyphSetRange(glyphs, start, last))
      }
      return move out
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if ClassDefFormat2<'a>.get(self, value) == class {
          drop run IntSet<GlyphId>.insert(&mut out, value)
        }
      }
    } else {
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if range.start > last {
          break
        }
        if range.value == u16.toU32(class) && range.end >= first {
          run extendGlyphs(&mut out, glyphSetRange(glyphs, range.start, range.end))
        }
        at = at + 1
      }
    }
    return move out
  }

  pub fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u16) -> bool {
    if IntSet<GlyphId>.isEmpty(glyphs) {
      return false
    }
    if ClassDefFormat2<'a>.classRangeCount(self) == 0 {
      return class == 0
    }
    let first = glyphSetFirst(glyphs)
    let records = ClassDefFormat2<'a>.classRangeRecords(self)
    if class == 0 {
      let mut at: usize = 0
      let mut hasPrevious = false
      let mut previous = GlyphId.new(0)
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        let mut next = IntSet<GlyphId>.first(glyphs)
        if hasPrevious {
          next = IntSet<GlyphId>.nextAfter(glyphs, previous)
        }
        let glyph = match move next {
          Option<GlyphId>.Some { value } => value
          _ => {
            break
          }
        }
        if GlyphId.toU32(glyph) < range.start {
          return true
        }
        previous = GlyphId.new(range.end)
        hasPrevious = true
        at = at + 1
      }
      if hasPrevious {
        if let Option<GlyphId>.Some { value } = IntSet<GlyphId>.nextAfter(glyphs, previous) {
          return true
        }
      }
    }
    if u16.toU64(ClassDefFormat2<'a>.classRangeCount(self))
      > IntSet<GlyphId>.len(glyphs) * u32.toU64(ClassDefFormat2<'a>.cost(self)) {
      let mut iter = IntSet<GlyphId>.iter(glyphs)
      while let Option<GlyphId>.Some { value } = IntSetIter<GlyphId>.next(&mut iter) {
        if ClassDefFormat2<'a>.get(self, value) == class {
          return true
        }
      }
    } else {
      let last = glyphSetLast(glyphs)
      let mut at: usize = 0
      while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord<'a>>(
        &records,
        at,
      ) {
        if range.start > last {
          break
        }
        if range.end >= first && range.value == u16.toU32(class)
          && IntSet<GlyphId>.intersectsRange(
            glyphs,
            GlyphId.new(range.start),
            GlyphId.new(range.end),
          ) {
          return true
        }
        at = at + 1
      }
    }
    return false
  }
}

struct WideClassRanges<'a> {
  table: ClassDef<'a>,
  index: usize,
}

impl<'a> WideClassRanges<'a> {
  fn next(self: &mut Self) -> Option<LayoutRange> {
    match self.table {
      ClassDef<'a>.Format3 { value } => {
        let class = match move ScalarArray<Uint24>.get(
          &ClassDefFormat3<'a>.classValueArray(&value),
          self.index,
        ) {
          Option<Uint24>.Some { value: class } => class
          _ => {
            return Option<LayoutRange>.None
          }
        }
        let glyph = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(&value))
          + usize.toU32(self.index)
        self.index = self.index + 1
        if glyph > 16777215 {
          return Option<LayoutRange>.None
        }
        return Option<LayoutRange>.some(
          LayoutRange { start: glyph, end: glyph, value: Uint24.toU32(class) },
        )
      }
      ClassDef<'a>.Format4 { value } => {
        while let Option<LayoutRange>.Some { value: range } = rangeAt<ClassRangeRecord2<'a>>(
          &ClassDefFormat4<'a>.classRangeRecords(&value),
          self.index,
        ) {
          self.index = self.index + 1
          if range.start <= range.end {
            return Option<LayoutRange>.some(range)
          }
        }
        return Option<LayoutRange>.None
      }
      _ => {
        return Option<LayoutRange>.None
      }
    }
  }
}

effect fn widenClasses(input: IntSet<u16>) -> IntSet<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = IntSet<u32>.empty()
  let mut iter = IntSet<u16>.iter(&input)
  while let Option<u16>.Some { value } = IntSetIter<u16>.next(&mut iter) {
    drop run IntSet<u32>.insert(&mut out, u16.toU32(value))
  }
  return move out
}

impl<'a> ClassDef<'a> {
  pub effect fn intersectClasses(self: &Self, glyphs: &IntSet<GlyphId>) -> IntSet<u32>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        return run widenClasses(run ClassDefFormat1<'a>.intersectClasses(&value, glyphs))
      }
      ClassDef<'a>.Format2 { value } => {
        return run widenClasses(run ClassDefFormat2<'a>.intersectClasses(&value, glyphs))
      }
      _ => {}
    }
    let mut classes = IntSet<u32>.empty()
    let mut assigned = IntSet<GlyphId>.empty()
    let mut ranges = WideClassRanges<'a> { table: self.*, index: 0 }
    while let Option<LayoutRange>.Some { value: range } = WideClassRanges<'a>.next(&mut ranges) {
      if IntSet<GlyphId>.intersectsRange(glyphs, GlyphId.new(range.start), GlyphId.new(range.end)) {
        drop run IntSet<u32>.insert(&mut classes, range.value)
      }
      run IntSet<GlyphId>.insertRange(
        &mut assigned,
        GlyphId.new(range.start),
        GlyphId.new(range.end),
      )
    }
    if !IntSet<GlyphId>.isSubset(glyphs, &assigned) {
      drop run IntSet<u32>.insert(&mut classes, 0)
    }
    return move classes
  }

  pub effect fn intersectedClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u32) -> IntSet<
    GlyphId
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        if class > 65535 {
          return IntSet<GlyphId>.empty()
        }
        return run ClassDefFormat1<'a>.intersectedClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      ClassDef<'a>.Format2 { value } => {
        if class > 65535 {
          return IntSet<GlyphId>.empty()
        }
        return run ClassDefFormat2<'a>.intersectedClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      _ => {}
    }
    let mut out = IntSet<GlyphId>.empty()
    let mut assigned = IntSet<GlyphId>.empty()
    let mut ranges = WideClassRanges<'a> { table: self.*, index: 0 }
    while let Option<LayoutRange>.Some { value: range } = WideClassRanges<'a>.next(&mut ranges) {
      if range.value == class {
        run IntSet<GlyphId>.insertRange(&mut out, GlyphId.new(range.start), GlyphId.new(range.end))
      }
      if class == 0 {
        run IntSet<GlyphId>.insertRange(
          &mut assigned,
          GlyphId.new(range.start),
          GlyphId.new(range.end),
        )
      }
    }
    if class == 0 {
      IntSet<GlyphId>.invert(&mut assigned)
      run IntSet<GlyphId>.unionValue(&mut out, &assigned)
    }
    run IntSet<GlyphId>.intersect(&mut out, glyphs)
    return move out
  }

  pub effect fn intersectsClassGlyphs(self: &Self, glyphs: &IntSet<GlyphId>, class: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      ClassDef<'a>.Format1 { value } => {
        if class > 65535 {
          return false
        }
        return ClassDefFormat1<'a>.intersectsClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      ClassDef<'a>.Format2 { value } => {
        if class > 65535 {
          return false
        }
        return ClassDefFormat2<'a>.intersectsClassGlyphs(&value, glyphs, u32.toU16(class))
      }
      _ => {
        let intersection = run ClassDef<'a>.intersectedClassGlyphs(self, glyphs, class)
        return !IntSet<GlyphId>.isEmpty(&intersection)
      }
    }
  }
}
