import silk.core.ownership { Copy }

pub struct ByteRange {
  pub start: usize,
  pub end: usize,
}

impl Copy for ByteRange {}

pub interface MinByteRange<'a> {
  fn minByteRange(self: &Self) -> ByteRange

  fn minTableBytes(self: &Self) -> &'a [u8]
}
