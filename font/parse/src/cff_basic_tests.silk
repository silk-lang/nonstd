effect fn must<T, E>(result: Result<T, E>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, E>.Success { value } => move value
    _ => {
      run Testing.expect(false, "fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "value exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn absent<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

fn put(data: &mut [u8], position: usize, width: usize, value: u32) {
  let mut v = value
  let mut i = width
  while i > 0 {
    i = i - 1
    data[position + i] = u32.toU8(v & 255)
    v = u32.shiftRight(v, 8)
  }
}

effect fn checkIndex(format: u8, width: u8, count: usize) -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 340000] = [0; 340000]
  let mut pos: usize = 2
  if format == 2 {
    pos = 4
  }
  put(&mut bytes, 0, pos, usize.toU32(count))
  bytes[pos] = width
  pos = pos + 1
  let mut offset: u32 = 1
  let mut i: usize = 0
  while i <= count {
    put(&mut bytes, pos, u8.toUsize(width), offset)
    pos = pos + u8.toUsize(width)
    offset = offset + usize.toU32((i + 1) * 10)
    i = i + 1
  }
  i = 0
  while i < count {
    let mut j: usize = 0
    while j < (i + 1) * 10 {
      bytes[pos] = usize.toU8(i)
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  let index = run must(Index.new(Slice.view<u8>(&bytes, 0, pos), format == 2))
  run Testing.expect(
    Index.offSize(&index) == width && Index.count(&index) == usize.toU32(count),
    "INDEX header",
  )
  run Testing.expect((run some(Index.sizeInBytes(&index))) == pos, "INDEX total extent")
  i = 0
  while i < count {
    let object = run some(Index.get(&index, i))
    run Testing.expect(object.length == (i + 1) * 10, "object length")
    let mut j: usize = 0
    while j < object.length {
      run Testing.expect(object[j] == usize.toU8(i), "object bytes")
      j = j + 1
    }
    i = i + 1
  }
  run Testing.expect(
    absent(Index.get(&index, count)) && absent(Index.get(&index, usize.MAX)),
    "objects outside index",
  )
}

test effect fn indexFormat1Offsize1Count4() -> ()
  ! AssertionError<'static> {
  run checkIndex(1, 1, 4)
}

test effect fn indexFormat1Offsize2Count64() -> ()
  ! AssertionError<'static> {
  run checkIndex(1, 2, 64)
}

