effect fn checkSimpleMapping(offset: usize) -> ()
  ! AssertionError<'static> {
  let charset = run some(Charset.new(FontData.new(b""), offset, 64))
  let mut i: u32 = 0
  while i < 64 {
    let mut sid = u32.toU16(i)
    if offset > 0 {
      sid = run some(expertCharset(offset == 2, u32.toUsize(i)))
    }
    run Testing.expect(
      Sid.toU16(run some(Charset.stringId(&charset, GlyphId.new(i)))) == sid,
      "predefined SID",
    )
    run Testing.expect(
      GlyphId.toU32(run some(Charset.glyphId(&charset, Sid.new(sid)))) == i,
      "predefined glyph",
    )
    i = i + 1
  }
  while i < 65535 {
    run Testing.expect(absent(Charset.stringId(&charset, GlyphId.new(i))), "glyph beyond count")
    i = i + 1
  }
}

test effect fn isoAdobeCharset() -> ()
  ! AssertionError<'static> {
  run checkSimpleMapping(0)
}

test effect fn expertCharsetMapping() -> ()
  ! AssertionError<'static> {
  run checkSimpleMapping(1)
}

test effect fn expertSubsetCharset() -> ()
  ! AssertionError<'static> {
  run checkSimpleMapping(2)
}

effect fn checkMapping(data: &'static [u8], expected: &[u16]) -> ()
  ! AssertionError<'static> {
  let charset = run some(Charset.new(FontData.new(data), 4, usize.toU32(expected.length)))
  let mut iter = Charset.iter(&charset)
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(
      Sid.toU16(run some(Charset.stringId(&charset, GlyphId.new(usize.toU32(i))))) == expected[i],
      "charset forward mapping",
    )
    run Testing.expect(
      GlyphId.toU32(run some(Charset.glyphId(&charset, Sid.new(expected[i])))) == usize.toU32(i),
      "charset reverse mapping",
    )
    let entry = run some(Iter.next(&mut iter))
    run Testing.expect(
      GlyphId.toU32(entry.glyph) == usize.toU32(i) && Sid.toU16(entry.sid) == expected[i],
      "charset iteration",
    )
    i = i + 1
  }
  run Testing.expect(absent(Iter.next(&mut iter)), "iterator ends at glyph count")
  while i < 65535 {
    run Testing.expect(
      absent(Charset.stringId(&charset, GlyphId.new(usize.toU32(i)))),
      "glyph beyond count",
    )
    i = i + 1
  }
}

test effect fn customMappingFormat0() -> ()
  ! AssertionError<'static> {
  run checkMapping(
    b"\x00\x00\x00\x00\x00\x00\x02\x00\x04\x00\x06\x00\x08\x00\x0a",
    &[0, 2, 4, 6, 8, 10],
  )
}

test effect fn customMappingFormat1() -> ()
  ! AssertionError<'static> {
  run checkMapping(
    b"\x00\x00\x00\x00\x01\x00\x08\x02\x04\xb0\x00\x00\x14\x01",
    &[0, 8, 9, 10, 1200, 20, 21],
  )
}

test effect fn customMappingFormat2() -> ()
  ! AssertionError<'static> {
  let mut expected: [u16; 806] = [0; 806]
  expected[1] = 8
  expected[2] = 9
  expected[3] = 10
  expected[4] = 1200
  let mut i: usize = 0
  while i <= 800 {
    expected[i + 5] = usize.toU16(i + 20)
    i = i + 1
  }
  run checkMapping(
    b"\x00\x00\x00\x00\x02\x00\x08\x00\x02\x04\xb0\x00\x00\x00\x14\x03\x20",
    &expected,
  )
}

test effect fn glyphIdsStopAtTheGlyphCount() -> ()
  ! AssertionError<'static> {
  let charset = run some(
    Charset.new(FontData.new(b"\x00\x00\x00\x00\x01\x00\x08\x05\x01\x2c\x04"), 4, 4),
  )
  run Testing.expect(
    GlyphId.toU32(run some(Charset.glyphId(&charset, Sid.new(10)))) == 3,
    "last mapped glyph",
  )
  run Testing.expect(
    absent(Charset.glyphId(&charset, Sid.new(11)))
      && absent(Charset.glyphId(&charset, Sid.new(300))),
    "ignore ranges past count",
  )
}

struct TestRanges<'a> {
  values: &'a [RangeValues],
}

impl<'a> RangeSource for TestRanges<'a> {
  fn rangeAt(self: &Self, index: usize) -> Option<RangeValues> {
    if index >= self.values.length {
      return Option<RangeValues>.None
    }
    return Option<RangeValues>.some(self.values[index])
  }
}

test effect fn stringIdFromRangesOverflowDoesNotPanic() -> ()
  ! AssertionError<'static> {
  let ranges = TestRanges { values: &[RangeValues { first: 42, nLeft: 4294967295 }] }
  run Testing.expect(absent(stringIdFromRanges(&ranges, GlyphId.new(1))), "range span overflow")
}

test effect fn glyphIdFromRangesOverflowDoesNotPanic() -> ()
  ! AssertionError<'static> {
  let ranges = TestRanges {
    values: &[RangeValues { first: 2, nLeft: 0 }, RangeValues { first: 2, nLeft: 4294967293 }],
  }
  run Testing.expect(absent(glyphIdFromRanges(&ranges, Sid.new(1))), "glyph accumulation overflow")
}

test effect fn nextRangeOverflowDoesNotPanic() -> ()
  ! AssertionError<'static> {
  let ranges = TestRanges { values: &[RangeValues { first: 7, nLeft: 4294967295 }] }
  let mut index: usize = 0
  run Testing.expect(absent(nextRange(&ranges, &mut index)), "range iterator overflow")
}

effect fn checkPredefinedEncoding(kind: PredefinedEncoding, charsetOffset: usize) -> ()
  ! AssertionError<'static> {
  let encoding = Encoding<'static>.Predefined { value: kind }
  let charset = run some(Charset.new(FontData.new(b""), charsetOffset, 256))
  let mut code: u16 = 0
  while code <= 255 {
    let actual = run some(Encoding.map(&encoding, &charset, u16.toU8(code)))
    let expected = run some(
      Charset.glyphId(&charset, run some(PredefinedEncoding.sid(&kind, u16.toU8(code)))),
    )
    run Testing.expect(
      GlyphId.toU32(actual) == GlyphId.toU32(expected),
      "predefined encoding mapping",
    )
    code = code + 1
  }
}

test effect fn predefinedStandard() -> ()
  ! AssertionError<'static> {
  run checkPredefinedEncoding(PredefinedEncoding.Standard, 0)
}

test effect fn predefinedExpert() -> ()
  ! AssertionError<'static> {
  run checkPredefinedEncoding(PredefinedEncoding.Expert, 1)
}

test effect fn customFormat0() -> ()
  ! AssertionError<'static> {
  let charset = run some(Charset.new(FontData.new(b""), 0, 256))
  let encoding = run some(CustomEncoding.new(b"\x00\x05\x03\x08\x09\x0a\x0b"))
  let codes: [u8; 5] = [3, 8, 9, 10, 11]
  let mut i: usize = 0
  while i < 5 {
    run Testing.expect(
      GlyphId.toU32(run some(CustomEncoding.map(&encoding, &charset, codes[i])))
        == usize.toU32(i + 1),
      "format0 encoding",
    )
    i = i + 1
  }
}

test effect fn customFormat1() -> ()
  ! AssertionError<'static> {
  let charset = run some(Charset.new(FontData.new(b""), 0, 256))
  let encoding = run some(CustomEncoding.new(b"\x01\x02\x33\x04\xfa\x05"))
  let mut code: u16 = 0
  while code <= 255 {
    let actual = CustomEncoding.map(&encoding, &charset, u16.toU8(code))
    if code >= 51 && code <= 55 {
      run Testing.expect(
        GlyphId.toU32(run some(move actual)) == u16.toU32(code - 50),
        "first encoding range",
      )
    } else if code >= 250 {
      run Testing.expect(
        GlyphId.toU32(run some(move actual)) == u16.toU32(code - 250 + 6),
        "last encoding range",
      )
    } else {
      run Testing.expect(absent(move actual), "unmapped code")
    }
    code = code + 1
  }
}

test effect fn supplemental() -> ()
  ! AssertionError<'static> {
  let charset = run some(Charset.new(FontData.new(b""), 0, 256))
  let encoding = run some(CustomEncoding.new(b"\x80\x00\x02\x28\x00\x5b\x7a\x00\x09"))
  run Testing.expect(
    GlyphId.toU32(run some(CustomEncoding.map(&encoding, &charset, 40))) == 91,
    "supplement z",
  )
  run Testing.expect(
    GlyphId.toU32(run some(CustomEncoding.map(&encoding, &charset, 122))) == 9,
    "supplement parenleft",
  )
  run Testing.expect(
    (run must(
      String.fromUtf8(
        run must(Sid.resolveStandard(run some(Charset.stringId(&charset, GlyphId.new(91))))),
      ),
    ))
      == "z",
    "supplement resolved string",
  )
  run Testing.expect(
    (run must(
      String.fromUtf8(
        run must(Sid.resolveStandard(run some(Charset.stringId(&charset, GlyphId.new(9))))),
      ),
    ))
      == "parenleft",
    "supplement resolved string",
  )
}

effect fn checkFdSelect(outOfBounds: bool) -> ()
  ! AssertionError<'static> {
  let firsts: [u16; 5] = [0, 10, 32, 34, 128]
  let fds: [u8; 5] = [0, 4, 1, 12, 2]
  let mut format: u8 = 0
  if outOfBounds {
    format = 3
  }
  while format <= 4 {
    let mut bytes: [u8; 1030] = [0; 1030]
    bytes[0] = format
    let mut length: usize = 1
    if format == 0 {
      let mut gid: usize = 0
      let mut r: usize = 0
      while gid < 1024 {
        if r < 4 && gid >= u16.toUsize(firsts[r + 1]) {
          r = r + 1
        }
        bytes[gid + 1] = fds[r]
        gid = gid + 1
      }
      length = 1025
    } else {
      let mut count: usize = 5
      if outOfBounds {
        count = 2
      }
      let mut width: usize = 2
      if format == 4 {
        width = 4
      }
      put(&mut bytes, 1, width, usize.toU32(count))
      length = 1 + width
      let mut i: usize = 0
      while i < count {
        let mut first = firsts[i]
        let mut fd = fds[i]
        if outOfBounds {
          first = 3
          if i == 1 {
            first = 10
          }
          fd = usize.toU8(i)
        }
        put(&mut bytes, length, width, u16.toU32(first))
        length = length + width
        let mut fdWidth: usize = 1
        if format == 4 {
          fdWidth = 2
        }
        put(&mut bytes, length, fdWidth, u8.toU32(fd))
        length = length + fdWidth
        i = i + 1
      }
      let mut sentinel: u32 = 1024
      if outOfBounds {
        sentinel = 20
      }
      put(&mut bytes, length, width, sentinel)
      length = length + width
    }
    let selected = run must(FdSelect.read(FontData.new(Slice.view<u8>(&bytes, 0, length))))
    if outOfBounds {
      let missing: [u32; 5] = [0, 1, 2, 20, 40]
      let mut i: usize = 0
      while i < 5 {
        run Testing.expect(
          absent(FdSelect.fontIndex(&selected, GlyphId.new(missing[i]))),
          "uncovered FDSelect glyph",
        )
        i = i + 1
      }
    } else {
      let mut gid: u32 = 0
      let mut r: usize = 0
      while gid < 1024 {
        if r < 4 && gid >= u16.toU32(firsts[r + 1]) {
          r = r + 1
        }
        run Testing.expect(
          (run some(FdSelect.fontIndex(&selected, GlyphId.new(gid)))) == u8.toU16(fds[r]),
          "font dictionary index",
        )
        gid = gid + 1
      }
    }
    if format == 0 {
      format = 3
    } else {
      format = format + 1
    }
  }
}

test effect fn selectFontIndex() -> ()
  ! AssertionError<'static> {
  run checkFdSelect(false)
}

test effect fn selectFontIndexOutOfBounds() -> ()
  ! AssertionError<'static> {
  run checkFdSelect(true)
}
