test effect fn standardStrings() -> ()
  ! AssertionError<'static> {
  let mut i: usize = 0
  while i < 391 {
    let actual = run must(Sid.resolveStandard(Sid.new(usize.toU16(i))))
    let expected = run some(standardString(i))
    run Testing.expect(actual.length == expected.length, "standard string extent")
    let mut j: usize = 0
    while j < actual.length {
      run Testing.expect(actual[j] == expected[j] && actual[j] < 128, "standard ASCII string")
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn notAStandardString() -> ()
  ! AssertionError<'static> {
  match move Sid.resolveStandard(Sid.new(391)) {
    Result<&'static [u8], usize>.Failure { error } => {
      run Testing.expect(error == 0, "custom string offset")
    }
    _ => {
      run Testing.expect(false, "SID is custom")
    }
  }
}

