import tables.morx { Morx, Chain, Feature, Subtable, SubtableKind, ContextualSubtable }
import tables.aat { TypedLookup }
import generated_aat_fixtures as Fixtures
import font_data { FontData }
import array { VarLenArray, ComputedArray, ScalarArray }
import read { ReadError }
import font_types.lib { GlyphId16 }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.usize

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "morx fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "morx value exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn chain(bytes: &'static [u8]) -> Chain<'static>
  ! AssertionError<'static> {
  let table = run must(Morx.read(FontData.new(bytes)))
  return run must(run some(VarLenArray<'static, Chain<'static>>.get(&Morx.chains(&table), 0)))
}

effect fn subtable(bytes: &'static [u8], coverage: u32) -> Subtable<'static>
  ! AssertionError<'static> {
  let chain = run chain(bytes)
  let table = run must(
    run some(VarLenArray<'static, Subtable<'static>>.get(&Chain.subtables(&chain), 0)),
  )
  run Testing.expect(Subtable.coverage(&table) == coverage, "subtable coverage")
  return table
}

effect fn kind(bytes: &'static [u8], coverage: u32) -> SubtableKind<'static>
  ! AssertionError<'static> {
  let table = run subtable(bytes, coverage)
  let data = ScalarArray<u8>.offsetData(&Subtable.data(&table))
  let parts = run must(SubtableKind<'static>.parts(data, coverage))
  drop run must(SubtableKind<'static>.fromParts(data, &parts))
  return run must(Subtable.kind(&table))
}

test effect fn parseChainFlagsFeatures() -> ()
  ! AssertionError<'static> {
  let chain = run chain(Fixtures.four())
  run Testing.expect(Chain.defaultFlags(&chain) == 1, "default flags")
  let feature = run must(
    ComputedArray<'static, (), Feature<'static>>.get(&Chain.features(&chain), 0),
  )
  run Testing.expect(
    Feature.featureType(&feature) == 4 && Feature.featureSettings(&feature) == 0
      && Feature.enableFlags(&feature) == 1
      && Feature.disableFlags(&feature) == 4294967295,
    "feature flags",
  )
}

test effect fn parseRearrangement() -> ()
  ! AssertionError<'static> {
  let parsed = run kind(Fixtures.four(), 536870912)
  run Testing.expect(
    match parsed {
      SubtableKind<'static>.Rearrangement { value } => true
      _ => false
    },
    "rearrangement kind",
  )
}

test effect fn parseContextual() -> ()
  ! AssertionError<'static> {
  let parsed = run kind(Fixtures.eighteen(), 536870913)
  match parsed {
    SubtableKind<'static>.Contextual { value } => {
      let lookup = run some(ContextualSubtable.lookup(&value, 0))
      let mut i: u16 = 0
      while i < 7 {
        let result = TypedLookup<'static, u16>.value(&lookup, i)
        if i < 2 {
          run Testing.expect(
            match move result {
              Result<u16, ReadError>.Failure { error } => true
              _ => false
            },
            "absent substitution",
          )
        } else {
          run Testing.expect((run must(move result)) == i + 5, "contextual substitution")
        }
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "contextual kind")
    }
  }
}

fn shorten<'a>(value: SubtableKind<'static>) -> SubtableKind<'a> {
  return value
}

test effect fn subtableKindIsCovariant() -> ()
  ! AssertionError<'static> {
  drop shorten(run kind(Fixtures.one(), 536870916))
}

test effect fn parseLigature() -> ()
  ! AssertionError<'static> {
  let parsed = run kind(Fixtures.fortyOne(), 536870914)
  match parsed {
    SubtableKind<'static>.Ligature { value } => {
      let actions: [u32; 2] = [1073741822, 3221225470]
      let components: [u16; 4] = [0, 1, 0, 0]
      let mut i: usize = 0
      while i < 2 {
        run Testing.expect(
          (run some(ScalarArray<u32>.get(&value.ligatureActions, i))) == actions[i],
          "ligature action",
        )
        i = i + 1
      }
      i = 0
      while i < 4 {
        run Testing.expect(
          (run some(ScalarArray<u16>.get(&value.components, i))) == components[i],
          "ligature component",
        )
        i = i + 1
      }
      run Testing.expect(ScalarArray<GlyphId16>.len(&value.ligatures) == 2, "two ligatures")
      i = 0
      while i < 2 {
        run Testing.expect(
          GlyphId16.toU16(run some(ScalarArray<GlyphId16>.get(&value.ligatures, i)))
            == usize.toU16(i) + 5,
          "ligature glyph",
        )
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "ligature kind")
    }
  }
}

test effect fn parseNonContextual() -> ()
  ! AssertionError<'static> {
  let parsed = run kind(Fixtures.one(), 536870916)
  match parsed {
    SubtableKind<'static>.NonContextual { value } => {
      let mut i: u16 = 0
      while i < 5 {
        let result = TypedLookup<'static, u16>.value(&value, i)
        if i == 2 || i == 4 {
          run Testing.expect((run must(move result)) == i + 3, "noncontextual substitution")
        } else {
          run Testing.expect(
            match move result {
              Result<u16, ReadError>.Failure { error } => true
              _ => false
            },
            "absent substitution",
          )
        }
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "noncontextual kind")
    }
  }
}

test effect fn parseInsertion() -> ()
  ! AssertionError<'static> {
  let parsed = run kind(Fixtures.thirtyFour(), 536870917)
  match parsed {
    SubtableKind<'static>.Insertion { value } => {
      run Testing.expect(
        ScalarArray<GlyphId16>.len(&value.glyphs) == 18,
        "eighteen inserted glyphs",
      )
      let mut i: usize = 0
      while i < 18 {
        run Testing.expect(
          GlyphId16.toU16(run some(ScalarArray<GlyphId16>.get(&value.glyphs, i)))
            == 3 - usize.toU16(i % 2),
          "inserted glyph",
        )
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "insertion kind")
    }
  }
}
