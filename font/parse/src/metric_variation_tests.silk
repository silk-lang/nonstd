effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: item } => move item
    _ => {
      run Testing.expect(false, "metric variation fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: item } => move item
    _ => {
      run Testing.expect(false, "metric variation value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn isNone<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

effect fn deltaIs(value: Option<F48Dot16>, expected: f64) -> ()
  ! AssertionError<'static> {
  let delta = run some(move value)
  run Testing.expect(F48Dot16.toF64(delta) == expected, "exact metric delta")
}

effect fn hvar() -> Hvar<'static>
  ! AssertionError<'static> {
  return run must(Hvar.read(FontData.new(Fixtures.vazirmatnHvar())))
}

effect fn vvar() -> Vvar<'static>
  ! AssertionError<'static> {
  return run must(Vvar.read(FontData.new(Fixtures.notoVvar())))
}

effect fn mvar() -> Mvar<'static>
  ! AssertionError<'static> {
  return run must(Mvar.read(FontData.new(Fixtures.amstelvarMvar())))
}

test effect fn hvarDeltaKeepsFractionVariationStoreComputed() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let coords: [f64; 3] = [-1.0, -0.75, -0.5]
  let expected: [f64; 3] = [-113.0, -84.75, -56.5]
  let mut i: usize = 0
  while i < 3 {
    run deltaIs(
      Hvar.advanceDelta(&table, GlyphId.new(1), &[F2Dot14.fromF64(coords[i])]),
      expected[i],
    )
    i = i + 1
  }
}

test effect fn hvarDefaultLocationMovesNothing() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  run deltaIs(Hvar.advanceDelta(&table, GlyphId.new(1), &[]), 0.0)
  run deltaIs(Hvar.lsbDelta(&table, GlyphId.new(1), &[]), 0.0)
  run deltaIs(Hvar.rsbDelta(&table, GlyphId.new(1), &[]), 0.0)
}

test effect fn hvarCachedScalarChangesNothing() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let coords = [F2Dot14.fromF64(-0.75)]
  let mut buf = [Fixed.zero(); 32]
  let count = Hvar.computeScalars(&table, &coords, &mut buf)
  run Testing.expect(count > 0, "varying regions")
  let maxp = run must(Maxp.read(FontData.new(Fixtures.vazirmatnMaxp())))
  let mut gid: u16 = 0
  while gid < Maxp.numGlyphs(&maxp) {
    let plain = run some(Hvar.advanceDelta(&table, GlyphId.new(u16.toU32(gid)), &coords))
    let sizes = [count, count / 2, 0]
    let mut i: usize = 0
    while i < 3 {
      run deltaIs(
        Hvar.advanceDeltaWithScalars(
          &table,
          GlyphId.new(u16.toU32(gid)),
          &coords,
          Slice.view(&buf, 0, sizes[i]),
        ),
        F48Dot16.toF64(plain),
      )
      i = i + 1
    }
    gid = gid + 1
  }
}

test effect fn hvarComputeScalarsReportsWhatItWrote() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let coords = [F2Dot14.fromF64(-0.75)]
  let mut big = [Fixed.zero(); 32]
  let all = Hvar.computeScalars(&table, &coords, &mut big)
  let mut small = [Fixed.zero(); 1]
  let mut expected = all
  if expected > 1 {
    expected = 1
  }
  run Testing.expect(
    Hvar.computeScalars(&table, &coords, &mut small) == expected
      && Fixed.toBits(small[0]) == Fixed.toBits(big[0]),
    "short output",
  )
  run Testing.expect(Hvar.computeScalars(&table, &coords, &mut []) == 0, "empty output")
}

test effect fn hvarMappingFontDoesNotStateIsAbsent() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let coords = [F2Dot14.fromF64(-0.75)]
  drop run some(Hvar.advanceDelta(&table, GlyphId.new(1), &coords))
  run Testing.expect(
    isNone(Hvar.lsbDelta(&table, GlyphId.new(1), &coords))
      && isNone(Hvar.rsbDelta(&table, GlyphId.new(1), &coords)),
    "absent side bearing mappings",
  )
}

test effect fn hvarAdvanceDeltas() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let coords: [f64; 6] = [-1.0, -0.75, -0.5, 0.0, 0.5, 1.0]
  let expected: [f64; 6] = [-113.0, -84.75, -56.5, 0.0, 29.5, 59.0]
  let mut i: usize = 0
  while i < 6 {
    run deltaIs(
      Hvar.advanceDelta(&table, GlyphId.new(1), &[F2Dot14.fromF64(coords[i])]),
      expected[i],
    )
    i = i + 1
  }
}

test effect fn advanceDeltasFromHvarWithTruncatedAdvIndexMap() -> ()
  ! AssertionError<'static> {
  let table = run must(Hvar.read(FontData.new(Fixtures.truncatedHvar())))
  let maxp = run must(Maxp.read(FontData.new(Fixtures.truncatedMaxp())))
  let mapping = run must(run some(Hvar.advanceWidthMapping(&table)))
  let count = match mapping {
    DeltaSetIndexMap<'static>.Format0 { value } => DeltaSetIndexMapFormat0.mapCount(&value)
    _ => 0
  }
  run Testing.expect(Maxp.numGlyphs(&maxp) == 24 && count == 15, "short mapping count")
  let mut gid: u16 = count - 1
  while gid < 24 {
    run deltaIs(Hvar.advanceDelta(&table, GlyphId.new(u16.toU32(gid)), &[F2Dot14.one()]), 100.0)
    gid = gid + 1
  }
}

test effect fn vvarDefaultLocationMovesNothing() -> ()
  ! AssertionError<'static> {
  let table = run vvar()
  run deltaIs(Vvar.advanceDelta(&table, GlyphId.new(1), &[]), 0.0)
}

test effect fn vvarEveryGlyphAnswersAtLocation() -> ()
  ! AssertionError<'static> {
  let table = run vvar()
  let maxp = run must(Maxp.read(FontData.new(Fixtures.notoMaxp())))
  let coords: [f64; 4] = [-1.0, -0.4, 0.25, 1.0]
  let mut i: usize = 0
  while i < 4 {
    let mut gid: u16 = 0
    while gid < Maxp.numGlyphs(&maxp) {
      drop run some(
        Vvar.advanceDelta(&table, GlyphId.new(u16.toU32(gid)), &[F2Dot14.fromF64(coords[i])]),
      )
      gid = gid + 1
    }
    i = i + 1
  }
}

test effect fn vvarMappingFontDoesNotStateIsAbsent() -> ()
  ! AssertionError<'static> {
  let table = run vvar()
  let coords = [F2Dot14.negOne()]
  drop run some(Vvar.advanceDelta(&table, GlyphId.new(1), &coords))
  drop run some(Vvar.vOriginYDelta(&table, GlyphId.new(1), &coords))
  run Testing.expect(
    isNone(Vvar.tsbDelta(&table, GlyphId.new(1), &coords))
      && isNone(Vvar.bsbDelta(&table, GlyphId.new(1), &coords)),
    "absent vertical bearings",
  )
}

test effect fn mvarDefaultLocationHasNoInstance() -> ()
  ! AssertionError<'static> {
  let table = run mvar()
  run Testing.expect(isNone(Mvar.at(&table, &[])), "default has no instance")
}

test effect fn mvarInstanceAgreesWithSingleMetricAccessor() -> ()
  ! AssertionError<'static> {
  let table = run mvar()
  let coords = [F2Dot14.one(); 12]
  let instance = run some(Mvar.at(&table, &coords))
  let records = Mvar.valueRecords(&table)
  let mut i: usize = 0
  let mut varied: usize = 0
  while i < ComputedArray<'static, (), ValueRecord<'static>>.len(&records) {
    let record = run must(ComputedArray<'static, (), ValueRecord<'static>>.get(&records, i))
    let tag = ValueRecord.valueTag(&record)
    let exact = run some(MvarInstance.get(&instance, tag))
    let rounded = run some(Mvar.metricDelta(&table, tag, &coords))
    run Testing.expect(
      F48Dot16.toI32(exact) == Fixed.toI32(rounded),
      "instance and rounded accessor",
    )
    if F48Dot16.toBits(exact) != 0 {
      varied = varied + 1
    }
    i = i + 1
  }
  run Testing.expect(varied > 0, "metrics vary")
}

test effect fn mvarTagFontDoesNotStateIsAbsent() -> ()
  ! AssertionError<'static> {
  let table = run mvar()
  let coords = [F2Dot14.one(); 12]
  let instance = run some(Mvar.at(&table, &coords))
  run Testing.expect(isNone(MvarInstance.get(&instance, Tag.fromU32(2054847098))), "missing metric")
}

test effect fn mvarInstanceKeepsFractionSingleAccessorDrops() -> ()
  ! AssertionError<'static> {
  let table = run mvar()
  let coords = [F2Dot14.fromF64(0.37); 12]
  let instance = run some(Mvar.at(&table, &coords))
  let records = Mvar.valueRecords(&table)
  let mut i: usize = 0
  let mut fractional = false
  while i < ComputedArray<'static, (), ValueRecord<'static>>.len(&records) {
    let record = run must(ComputedArray<'static, (), ValueRecord<'static>>.get(&records, i))
    match move MvarInstance.get(&instance, ValueRecord.valueTag(&record)) {
      Option<F48Dot16>.Some { value } => {
        if (F48Dot16.toBits(value) & 65535) != 0 {
          fractional = true
        }
      }
      _ => {}
    }
    i = i + 1
  }
  run Testing.expect(fractional, "fractional instance delta")
}

test effect fn ivsRegions() -> ()
  ! AssertionError<'static> {
  let table = run hvar()
  let store = run must(Hvar.itemVariationStore(&table))
  let list = run must(ItemVariationStore.variationRegionList(&store))
  let regions = VariationRegionList.variationRegions(&list)
  let expected: [i16; 6] = [-16384, -16384, 0, 0, 16384, 16384]
  run Testing.expect(
    ComputedArray<'static, u16, VariationRegion<'static>>.len(&regions) == 2,
    "two regions",
  )
  let mut i: usize = 0
  while i < 2 {
    let region = run must(ComputedArray<'static, u16, VariationRegion<'static>>.get(&regions, i))
    let axes = VariationRegion.regionAxes(&region)
    run Testing.expect(
      ComputedArray<'static, (), RegionAxisCoordinates<'static>>.len(&axes) == 1,
      "one region axis",
    )
    let axis = run must(ComputedArray<'static, (), RegionAxisCoordinates<'static>>.get(&axes, 0))
    run Testing.expect(
      F2Dot14.toBits(RegionAxisCoordinates.startCoord(&axis)) == expected[i * 3]
        && F2Dot14.toBits(RegionAxisCoordinates.peakCoord(&axis)) == expected[i * 3 + 1]
        && F2Dot14.toBits(RegionAxisCoordinates.endCoord(&axis)) == expected[i * 3 + 2],
      "region coordinates",
    )
    i = i + 1
  }
}

test effect fn ivsFloatDeltasNearlyMatchFixedDeltas() -> ()
  ! AssertionError<'static> {
  let fvar = run must(Fvar.read(FontData.new(Fixtures.colrFvar())))
  let count = u16.toUsize(Fvar.axisCount(&fvar))
  let data = FontData.new(Fixtures.colrColr())
  let offset = run must(FontData<'static>.readAt<u32>(&data, 30))
  let suffix = run some(FontData.splitOff(&data, u32.toUsize(offset)))
  let store = run must(ItemVariationStore.read(suffix))
  let dataArray = ItemVariationStore.itemVariationData(&store)
  let mut coords = [F2Dot14.zero(); 64]
  run Testing.expect(count <= 64, "fixture axis capacity")
  let mut step: i32 = 0
  while step <= 20 {
    let coord = F2Dot14.fromF32(i32.toF32(step) / 10.0 - 1.0)
    let mut i: usize = 0
    while i < count {
      coords[i] = coord
      i = i + 1
    }
    let mut outer: u16 = 0
    while u16.toUsize(outer)
      < ArrayOfNullableOffsets<'static, (), ItemVariationData<'static>, Offset32>.len(&dataArray) {
      let found = ArrayOfNullableOffsets<'static, (), ItemVariationData<'static>, Offset32>.get(
        &dataArray,
        u16.toUsize(outer),
      )
      match move found {
        Option<Result<ItemVariationData<'static>, ReadError>>.Some {
          value: Result<ItemVariationData<'static>, ReadError>.Success { value: item }
        } => {
          let mut inner: u16 = 0
          while inner < ItemVariationData.itemCount(&item) {
            let delta = run some(
              ItemVariationStore.computeDelta(
                &store,
                DeltaSetIndex { outer: outer, inner: inner },
                Slice.view(&coords, 0, count),
              ),
            )
            let integer = F48Dot16.toI32(delta)
            let float = F48Dot16.toF64(delta)
            let mut rounded = float + 0.5
            if float < 0.0 {
              rounded = float - 0.5
            }
            run Testing.expect(
              integer == f64.toI32(rounded) || integer == f64.toI32(float),
              "integer and float rounding",
            )
            let fixedDiff = Fixed.toF32(Fixed.fromBits(integer))
              - Fixed.applyDelta(Fixed.zero(), delta)
            run Testing.expect(f32.abs(fixedDiff) < 1000000000000.0, "fixed target delta")
            let bytes = Fixed.toBeBytes(Fixed.fromBits(integer))
            let short = run some(readScalar<i16>(Slice.view(&bytes, 2, 2)))
            let shortDiff = F2Dot14.toF32(F2Dot14.fromBits(short))
              - F2Dot14.applyDelta(F2Dot14.zero(), delta)
            run Testing.expect(f32.abs(shortDiff) < 1000000000000.0, "2.14 target delta")
            inner = inner + 1
          }
        }
        _ => {}
      }
      outer = outer + 1
    }
    step = step + 1
  }
}
