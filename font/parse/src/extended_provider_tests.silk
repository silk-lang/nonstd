effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: result } => move result
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test failure")
    }
  }
}

effect fn present<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: result } => move result
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test failure")
    }
  }
}

fn none<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

fn failed<T>(value: Result<T, ReadError>) -> bool {
  return match move value {
    Result<T, ReadError>.Failure { error } => true
    _ => false
  }
}

test effect fn verticalOrigins() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.fontVorg()))
  let vorg = run must(FontRef.vorg(&font))
  let expected: [i16; 4] = [880, 867, 880, 824]
  let mut i: usize = 0
  while i < 4 {
    run Testing.expect(
      Vorg.verticalOriginY(&vorg, GlyphId.new(usize.toU32(i))) == expected[i],
      "vertical origin",
    )
    i = i + 1
  }
}

test effect fn extendedMetricsAreSelectedIndependentlyOfOutlines() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 562000] = [0; 562000]
  let outlines: [u32; 3] = [0, 1735162214, 1196185926]
  let mut outline: usize = 0
  while outline < 3 {
    let mut variant: usize = 0
    while variant < 3 {
      let extended = variant != 2
      let legacy = variant != 0
      let size = Builder.metricsFont(&mut bytes, extended, legacy, outlines[outline])
      let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
      run checkMetrics(&font, extended)
      variant = variant + 1
    }
    outline = outline + 1
  }
}

effect fn checkMetrics<'a>(font: &FontRef<'a>, extended: bool) -> ()
  ! AssertionError<'static> {
  let mut count: u32 = 3
  let mut longCount: usize = 2
  let mut trailing: usize = 1
  let mut hAdvance: u16 = 500
  let mut vAdvance: u16 = 600
  if extended {
    count = 70002
    longCount = 70000
    trailing = 2
    hAdvance = 1000
    vAdvance = 1200
  }
  run Testing.expect(
    SelectedMaxp.numGlyphs(&run must(FontRef.selectedMaxp(font))) == count,
    "selected glyph count",
  )
  run Testing.expect(
    SelectedHhea.numberOfHMetrics(&run must(FontRef.selectedHhea(font))) == usize.toU32(longCount),
    "selected horizontal count",
  )
  run Testing.expect(
    SelectedVhea.numberOfLongVerMetrics(&run must(FontRef.selectedVhea(font)))
      == usize.toU32(longCount),
    "selected vertical count",
  )
  let h = run must(FontRef.hGlyphMetricRecords(font))
  let v = run must(FontRef.vGlyphMetricRecords(font))
  run Testing.expect(
    ComputedArray<'a, (), LongMetric<'a>>.len(&GlyphMetricRecords.longMetrics(&h)) == longCount
      && ComputedArray<'a, (), LongMetric<'a>>.len(&GlyphMetricRecords.longMetrics(&v))
        == longCount,
    "selected long records",
  )
  run Testing.expect(
    ScalarArray<i16>.len(&GlyphMetricRecords.sideBearings(&h)) == trailing,
    "trailing bearings",
  )
  run Testing.expect(
    (run present(GlyphMetricRecords.advance(&h, GlyphId.new(0)))) == hAdvance
      && (run present(GlyphMetricRecords.advance(&v, GlyphId.new(0)))) == vAdvance,
    "selected advances",
  )
  if extended {
    let ids: [u32; 3] = [65535, 65536, 69999]
    let mut i: usize = 0
    while i < 3 {
      let gid = ids[i]
      run Testing.expect(
        (run present(GlyphMetricRecords.advance(&h, GlyphId.new(gid))))
          == 1000 + u32.toU16(gid % 100),
        "wide glyph advance",
      )
      run Testing.expect(
        (run present(GlyphMetricRecords.sideBearing(&h, GlyphId.new(gid))))
          == -u32.toI16(gid % 300),
        "wide glyph bearing",
      )
      i = i + 1
    }
    let mut gid: u32 = 70000
    while gid <= 70001 {
      run Testing.expect(
        (run present(GlyphMetricRecords.advance(&h, GlyphId.new(gid)))) == 1099
          && (run present(GlyphMetricRecords.advance(&v, GlyphId.new(gid)))) == 1299,
        "last advance repeats",
      )
      run Testing.expect(
        (run present(GlyphMetricRecords.sideBearing(&h, GlyphId.new(gid))))
          == -u32.toI16(10 + gid - 70000),
        "trailing bearing lookup",
      )
      gid = gid + 1
    }
    run Testing.expect(
      none(GlyphMetricRecords.sideBearing(&h, GlyphId.new(70002))),
      "out of range bearing",
    )
  }
}

test effect fn extendedMetricsWithTruncatedOrExtremeCounts() -> ()
  ! AssertionError<'static> {
  let mut records: [u8; 10] = [0; 10]
  drop Builder.metricData(&mut records, 2, 1, 500)
  let mut horizontal: [u8; 38] = [0; 38]
  let mut vertical: [u8; 38] = [0; 38]
  let mut bytes: [u8; 200] = [0; 200]
  let counts: [u32; 3] = [0, 3, 4294967295]
  let mut i: usize = 0
  while i < 3 {
    drop Builder.metricHeader(&mut horizontal, counts[i], true, false)
    drop Builder.metricHeader(&mut vertical, counts[i], true, true)
    let tables = [
      Builder.TestTable { tag: 1212695873, data: &horizontal },
      Builder.TestTable { tag: 1213027416, data: &records },
      Builder.TestTable { tag: 1447576897, data: &vertical },
      Builder.TestTable { tag: 1447908440, data: &records },
    ]
    let size = Builder.font(&mut bytes, &tables)
    let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
    run emptyMetrics(&run must(FontRef.hGlyphMetricRecords(&font)), counts[i] != 0)
    run emptyMetrics(&run must(FontRef.vGlyphMetricRecords(&font)), counts[i] != 0)
    i = i + 1
  }
}

effect fn emptyMetrics<'a>(metrics: &GlyphMetricRecords<'a>, emptyBearings: bool) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    ComputedArray<'a, (), LongMetric<'a>>.isEmpty(&GlyphMetricRecords.longMetrics(metrics)),
    "truncated long array defaults empty",
  )
  run Testing.expect(
    none(GlyphMetricRecords.advance(metrics, GlyphId.new(0)))
      && none(GlyphMetricRecords.advance(metrics, GlyphId.new(4294967295))),
    "empty advances",
  )
  if emptyBearings {
    run Testing.expect(
      ScalarArray<i16>.isEmpty(&GlyphMetricRecords.sideBearings(metrics))
        && none(GlyphMetricRecords.sideBearing(metrics, GlyphId.new(0))),
      "truncated trailing bearings",
    )
  }
}

test effect fn extendedOutlineTablesAreSelectedAsAPair() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 450000] = [0; 450000]
  let mut variant: usize = 0
  while variant < 8 {
    let size = Builder.outlinesFont(
      &mut bytes,
      (variant & 1) != 0,
      (variant & 2) != 0,
      (variant & 4) != 0,
      0,
    )
    let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
    let pair = run must(FontRef.selectedGlyfLoca(&font, Option<bool>.None))
    run Testing.expect(Loca.len(&pair.loca) == 65537, "extended locations")
    let outline = run present(
      LocaGlyph.intoGlyph(run present(Loca.get(&pair.loca, GlyphId.new(1), &pair.glyf))),
    )
    let composite = match outline {
      Glyph.Composite { value } => value
      _ => {
        run Testing.expect(false, "composite glyph")
        return
      }
    }
    let mut components = CompositeGlyph.components(&composite)
    let first = run present(ComponentIter.next(&mut components))
    run Testing.expect(GlyphId.toU32(first.glyph) == 65536, "24-bit component glyph")
    let mut ids = CompositeGlyph.componentGlyphsAndFlags(&composite)
    let firstId = run present(ComponentGlyphIdFlagsIter.next(&mut ids))
    run Testing.expect(GlyphId.toU32(firstId.glyph) == 65536, "fast component glyph")
    let info = CompositeGlyph.countAndInstructions(&composite)
    run Testing.expect(
      info.count == 1 && none(move info.instructions),
      "one component without instructions",
    )
    let last = run present(Loca.get(&pair.loca, GlyphId.new(65536), &pair.glyf))
    run Testing.expect(!none(LocaGlyph.glyph(&last)), "last extended outline")
    run Testing.expect(
      none(Loca.get(&pair.loca, GlyphId.new(65537), &pair.glyf)),
      "past extended outline range",
    )
    variant = variant + 1
  }
}

test effect fn extendedOutlinePairDoesNotUseLegacyLocations() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 450000] = [0; 450000]
  let size = Builder.outlinesFont(&mut bytes, true, true, true, 1)
  let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
  let missing = match move FontRef.selectedGlyfLoca(&font, Option<bool>.None) {
    Result<GlyfLoca, ReadError>.Failure { error } => match error {
      ReadError.TableIsMissing { tag } => Tag.toU32(tag) == 1280262977
      _ => false
    }
    _ => false
  }
  run Testing.expect(missing, "GLYF requires LOCA")
  drop run must(FontRef.glyf(&font))
  drop run must(FontRef.loca(&font, Option<bool>.None))
  let nextSize = Builder.outlinesFont(&mut bytes, true, true, true, 2)
  let malformed = run must(FontRef.new(Slice.view<u8>(&bytes, 0, nextSize)))
  run Testing.expect(
    failed(FontRef.selectedGlyfLoca(&malformed, Option<bool>.None)),
    "malformed LOCA does not fall back",
  )
}
