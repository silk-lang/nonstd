import model.glyph { GlyphSource }
import silk.core.result { Result }

pub enum BitmapSource {
  Sbix,
  Cbdt,
  Ebdt,
}

impl BitmapSource {
  pub fn toGlyphSource(self: Self) -> GlyphSource {
    return match self {
      BitmapSource.Sbix => GlyphSource.Sbix
      BitmapSource.Cbdt => GlyphSource.Cbdt
      BitmapSource.Ebdt => GlyphSource.Ebdt
    }
  }

  pub fn tryFrom(source: GlyphSource) -> Result<Self, GlyphSource> {
    return match source {
      GlyphSource.Sbix => Result<Self, GlyphSource>.succeed(BitmapSource.Sbix)
      GlyphSource.Cbdt => Result<Self, GlyphSource>.succeed(BitmapSource.Cbdt)
      GlyphSource.Ebdt => Result<Self, GlyphSource>.succeed(BitmapSource.Ebdt)
      _ => Result<Self, GlyphSource>.failResult(source)
    }
  }
}
