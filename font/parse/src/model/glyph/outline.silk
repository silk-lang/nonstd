// Shared path contract needed by CFF drawing; model loaders are ported separately.
pub interface PathSink {
  fn moveTo(self: &mut Self, x: f32, y: f32)

  fn lineTo(self: &mut Self, x: f32, y: f32)

  fn quadTo(self: &mut Self, cx: f32, cy: f32, x: f32, y: f32)

  fn curveTo(self: &mut Self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32)

  fn close(self: &mut Self)
}

pub struct NullSink {}

impl PathSink for NullSink {
  fn moveTo(self: &mut Self, x: f32, y: f32) {}

  fn lineTo(self: &mut Self, x: f32, y: f32) {}

  fn quadTo(self: &mut Self, cx: f32, cy: f32, x: f32, y: f32) {}

  fn curveTo(self: &mut Self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {}

  fn close(self: &mut Self) {}
}

import model.glyph { GlyphSource }
import silk.core.result { Result }

pub enum OutlineSource {
  Glyf,
  Cff,
  Cff2,
  Varc,
  Type1,
}

impl OutlineSource {
  pub fn toGlyphSource(self: Self) -> GlyphSource {
    return match self {
      OutlineSource.Glyf => GlyphSource.Glyf
      OutlineSource.Cff => GlyphSource.Cff
      OutlineSource.Cff2 => GlyphSource.Cff2
      OutlineSource.Varc => GlyphSource.Varc
      OutlineSource.Type1 => GlyphSource.Type1
    }
  }

  pub fn tryFrom(source: GlyphSource) -> Result<Self, GlyphSource> {
    return match source {
      GlyphSource.Glyf => Result<Self, GlyphSource>.succeed(OutlineSource.Glyf)
      GlyphSource.Cff => Result<Self, GlyphSource>.succeed(OutlineSource.Cff)
      GlyphSource.Cff2 => Result<Self, GlyphSource>.succeed(OutlineSource.Cff2)
      GlyphSource.Varc => Result<Self, GlyphSource>.succeed(OutlineSource.Varc)
      GlyphSource.Type1 => Result<Self, GlyphSource>.succeed(OutlineSource.Type1)
      _ => Result<Self, GlyphSource>.failResult(source)
    }
  }
}
