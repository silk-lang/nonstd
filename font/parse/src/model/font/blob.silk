//! Owned or static font bytes. Borrowed views never outlive their Blob.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub union Blob {
  Static { pub bytes: &'static [u8] },
  Owned { pub bytes: List<u8> },
}

impl Blob {
  pub fn fromStatic(bytes: &'static [u8]) -> Self {
    return Blob.Static { bytes: bytes }
  }

  pub fn fromList(bytes: List<u8>) -> Self {
    return Blob.Owned { bytes: move bytes }
  }

  pub effect fn fromBytes(bytes: &[u8]) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut owned = List<u8>.make()
    run List<u8>.appendBytes(&mut owned, bytes)
    return Blob.Owned { bytes: move owned }
  }

  pub fn asBytes<'a>(self: &'a Self) -> &'a [u8] {
    return match &self.* {
      Blob.Static { bytes } => bytes
      Blob.Owned { bytes } => List<u8>.asSlice(&bytes)
    }
  }

  pub effect fn clone(self: &Self) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    match &self.* {
      Blob.Static { bytes } => {
        return Blob.fromStatic(bytes)
      }
      Blob.Owned { bytes } => {
        return run Blob.fromBytes(List<u8>.asSlice(&bytes))
      }
    }
  }
}
