import font_types.lib { Tag, InvalidTag, F2Dot14 }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.result { Result }
import silk.text.string { String }

pub type NormalizedCoord = F2Dot14

pub struct Variation {
  pub tag: Tag,
  pub value: f32,
}

impl Copy for Variation {}

impl Variation {
  pub fn new(tag: Tag, value: f32) -> Self {
    return Variation { tag: tag, value: value }
  }

  pub fn fromString(tag: string, value: f32) -> Self {
    return Variation.new(
      Tag.newChecked(String.utf8Bytes(tag)) |> Result<Tag, InvalidTag>.unwrapOr(Tag.default()),
      value,
    )
  }
}

impl Equal for Variation {
  fn equals(a: &Self, b: &Self) -> bool {
    return &a.tag == &b.tag && a.value == b.value
  }
}
