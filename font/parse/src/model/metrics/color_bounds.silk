//! Bounds of clips and composite paint groups (model/glyph/color/bounds.rs).
import font_types.lib { BoundingBox, Matrix, Point }
import tables.colr { CompositeMode }
import silk.core.ownership { Copy }
import model.metrics.base_outline { minNumber, maxNumber }

pub union Bounds {
  Unbounded,
  Bounded { pub box: BoundingBox<f32> },
  Empty,
}

impl Copy for Bounds {}

impl Bounds {
  pub fn of(box: BoundingBox<f32>) -> Self {
    if box.xMin < box.xMax && box.yMin < box.yMax {
      return Bounds.Bounded { box: box }
    }
    return Bounds.Empty
  }

  pub fn unionValue(a: Self, b: Self) -> Self {
    match a {
      Bounds.Unbounded => {
        return a
      }
      Bounds.Empty => {
        return b
      }
      Bounds.Bounded { box: left } => match b {
        Bounds.Unbounded => {
          return b
        }
        Bounds.Empty => {
          return a
        }
        Bounds.Bounded { box: right } => {
          return Bounds.Bounded {
            box: BoundingBox<f32> {
              xMin: minNumber(left.xMin, right.xMin),
              yMin: minNumber(left.yMin, right.yMin),
              xMax: maxNumber(left.xMax, right.xMax),
              yMax: maxNumber(left.yMax, right.yMax),
            },
          }
        }
      }
    }
  }

  pub fn intersect(a: Self, b: Self) -> Self {
    match a {
      Bounds.Empty => {
        return a
      }
      Bounds.Unbounded => {
        return b
      }
      Bounds.Bounded { box: left } => match b {
        Bounds.Empty => {
          return b
        }
        Bounds.Unbounded => {
          return a
        }
        Bounds.Bounded { box: right } => {
          return Bounds.of(
            BoundingBox<f32> {
              xMin: maxNumber(left.xMin, right.xMin),
              yMin: maxNumber(left.yMin, right.yMin),
              xMax: minNumber(left.xMax, right.xMax),
              yMax: minNumber(left.yMax, right.yMax),
            },
          )
        }
      }
    }
  }

  pub fn composite(backdrop: Self, source: Self, mode: CompositeMode) -> Self {
    return match mode {
      CompositeMode.Clear => Bounds.Empty
      CompositeMode.Src => source
      CompositeMode.SrcOut => source
      CompositeMode.Dest => backdrop
      CompositeMode.DestOut => backdrop
      CompositeMode.SrcIn => Bounds.intersect(backdrop, source)
      CompositeMode.DestIn => Bounds.intersect(backdrop, source)
      _ => Bounds.unionValue(backdrop, source)
    }
  }

  pub fn finish(self: Self) -> BoundingBox<f32> {
    return match self {
      Bounds.Bounded { box } => box
      _ => BoundingBox<f32> { xMin: 0.0, yMin: 0.0, xMax: 0.0, yMax: 0.0 }
    }
  }
}

pub fn transformBounds(matrix: Matrix<f32>, box: BoundingBox<f32>) -> BoundingBox<f32> {
  let corners = [
    matrix * Point<f32> { x: box.xMin, y: box.yMin },
    matrix * Point<f32> { x: box.xMax, y: box.yMin },
    matrix * Point<f32> { x: box.xMin, y: box.yMax },
    matrix * Point<f32> { x: box.xMax, y: box.yMax },
  ]
  let mut result = BoundingBox<f32> {
    xMin: corners[0].x,
    yMin: corners[0].y,
    xMax: corners[0].x,
    yMax: corners[0].y,
  }
  let mut i: usize = 1
  while i < 4 {
    let p = corners[i]
    result.xMin = minNumber(result.xMin, p.x)
    result.yMin = minNumber(result.yMin, p.y)
    result.xMax = maxNumber(result.xMax, p.x)
    result.yMax = maxNumber(result.yMax, p.y)
    i = i + 1
  }
  return result
}

import silk.testing.testing { Testing, AssertionError }

fn boxed(x: f32, y: f32, right: f32, top: f32) -> Bounds {
  return Bounds.Bounded { box: BoundingBox<f32> { xMin: x, yMin: y, xMax: right, yMax: top } }
}

fn sameBox(a: BoundingBox<f32>, b: BoundingBox<f32>) -> bool {
  return a.xMin == b.xMin && a.yMin == b.yMin && a.xMax == b.xMax && a.yMax == b.yMax
}

fn empty(value: Bounds) -> bool {
  return match value {
    Bounds.Empty => true
    _ => false
  }
}

test effect fn unionAndIntersection() -> ()
  ! AssertionError<'static> {
  let a = Bounds.unionValue(boxed(0.0, 0.0, 10.0, 10.0), boxed(5.0, -5.0, 20.0, 5.0))
  run Testing.expect(
    sameBox(Bounds.finish(a), Bounds.finish(boxed(0.0, -5.0, 20.0, 10.0))),
    "union",
  )
  let b = Bounds.intersect(a, boxed(15.0, 0.0, 30.0, 30.0))
  run Testing.expect(
    sameBox(Bounds.finish(b), Bounds.finish(boxed(15.0, 0.0, 20.0, 10.0))),
    "intersection",
  )
  run Testing.expect(empty(Bounds.intersect(b, boxed(100.0, 100.0, 200.0, 200.0))), "disjoint")
  run Testing.expect(
    sameBox(
      Bounds.finish(Bounds.intersect(Bounds.Unbounded, boxed(1.0, 2.0, 3.0, 4.0))),
      Bounds.finish(boxed(1.0, 2.0, 3.0, 4.0)),
    ),
    "unbounded clips",
  )
  run Testing.expect(
    match Bounds.unionValue(Bounds.Empty, Bounds.Unbounded) {
      Bounds.Unbounded => true
      _ => false
    },
    "unbounded fills",
  )
}

test effect fn aBoxWithoutAreaIsEmpty() -> ()
  ! AssertionError<'static> {
  let line = Bounds.of(BoundingBox<f32> { xMin: 5.0, yMin: 0.0, xMax: 5.0, yMax: 10.0 })
  run Testing.expect(empty(line), "line has no area")
  run Testing.expect(
    empty(Bounds.intersect(boxed(0.0, 0.0, 5.0, 10.0), boxed(5.0, 0.0, 10.0, 10.0))),
    "touching clips",
  )
  let painted = Bounds.unionValue(Bounds.Empty, Bounds.intersect(Bounds.Unbounded, line))
  run Testing.expect(
    sameBox(Bounds.finish(painted), Bounds.finish(Bounds.Empty)),
    "empty clipped fill adds nothing",
  )
}

test effect fn aTransformedBoxIsTheBoxAroundItsCorners() -> ()
  ! AssertionError<'static> {
  let rotate = Matrix<f32> { xx: 0.0, yx: 1.0, xy: -1.0, yy: 0.0, dx: 0.0, dy: 0.0 }
  let actual = transformBounds(rotate, Bounds.finish(boxed(1.0, 2.0, 3.0, 4.0)))
  run Testing.expect(sameBox(actual, Bounds.finish(boxed(-4.0, 1.0, -2.0, 3.0))), "quarter turn")
}
