test effect fn evalConditionShallowIsCorrect() -> ()
  ! AssertionError<'static> {
  let leaf = run vmTable(ModelFixtures.varcNoStoreCondition0(), 1)
  let component = run vmFirst(&leaf)
  run Testing.expect(
    run vmMust(
      run Effect.result(VarcOutlines.condition(&leaf, &component, &[F2Dot14.fromF32(0.5)])),
    ),
    "in axis range",
  )
  run Testing.expect(
    !(run vmMust(
      run Effect.result(VarcOutlines.condition(&leaf, &component, &[F2Dot14.fromF32(1.5)])),
    )),
    "outside axis range",
