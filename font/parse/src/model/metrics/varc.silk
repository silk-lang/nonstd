test effect fn drawGlyphRespectsTotalEdgeBudget() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmDrawBudget() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vmDrawBudget() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let outlines = run vmTable(ModelFixtures.varcCycle(), 0)
  let mut walk = Walk.new()
  walk.edges = 1
  let mut sink = ControlBounds.new(Affine2<f32>.identity())
  let result = run Effect.result(
    VarcOutlines.draw(
      &outlines,
      &vmBase(),
      GlyphId.new(1),
      0,
      &[],
      &[],
      Affine2<f32>.identity(),
      &mut walk,
      &mut sink,
    ),
  )
  run Testing.expect(
    match move result {
      Result<(), Error | OutOfMemoryError>.Failure { error } => match move error {
        Error problem => problem == Error.LimitExceeded
        _ => false
      }
      _ => false
    },
    "recursive edge rejected",
  )
}

