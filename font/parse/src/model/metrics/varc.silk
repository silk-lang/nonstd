}

test effect fn componentZeroDeltasDoNotRequireAStore() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmZeroDeltas() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vmZeroDeltas() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let cases = [
    ModelFixtures.varcZeroDelta0(),
    ModelFixtures.varcZeroDelta1(),
    ModelFixtures.varcZeroDelta2(),
  ]
  let expected: [f32; 3] = [0.25, 0.5, 0.5]
  let translation: [f32; 3] = [0.0, 0.0, 7.0]
  let mut i: usize = 0
  while i < 3 {
    let outlines = run vmTable(cases[i], 1)
    let component = run vmFirst(&outlines)
    let result = run Effect.result(
      VarcOutlines.componentCoords(
        &outlines,
        &component,
        &[F2Dot14.fromF32(0.5)],
        &[F2Dot14.fromF32(0.5)],
      ),
    )
    let values = run vmAlloc(move result)
    run Testing.expect(
      F2Dot14.toF32(List<F2Dot14>.get(&values, 0)) == expected[i],
      "zero tuple needs no store",
    )
    let transform = run vmAlloc(
      run Effect.result(VarcOutlines.transform(&outlines, &component, &[F2Dot14.fromF32(0.5)])),
    )
    run Testing.expect(
      DecomposedTransform.translateX(&transform) == translation[i],
      "zero transform needs no store",
    )
    i = i + 1
  }
}

effect fn vmAlloc<T>(result: Result<T, Error | OutOfMemoryError>) -> T
  ! AssertionError<'static> | OutOfMemoryError {
  return match move result {
    Result<T, Error | OutOfMemoryError>.Success { value } => move value
    Result<T, Error | OutOfMemoryError>.Failure { error } => match move error {
      Error problem => {
        run Testing.expect(false, "VARC operation succeeds")
        return Intrinsic.trap("assertion")
      }
      OutOfMemoryError problem => {
        fail move problem
      }
    }
  }
}

