  let negate = run vmTable(ModelFixtures.varcNoStoreCondition6(), 1)
  let negated = run vmFirst(&negate)
  run Testing.expect(
    !(run vmMust(
      run Effect.result(VarcOutlines.condition(&negate, &negated, &[F2Dot14.fromF32(0.5)])),
    )),
    "negated range",
  )
}

test effect fn expandCoordsPadsAndTruncates() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmExpandCoords() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vmExpandCoords() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let axes: [usize; 2] = [4, 1]
  let coords = [F2Dot14.fromF32(0.25), F2Dot14.fromF32(-0.5)]
  let root = [F2Dot14.fromF32(0.75)]
  let mut i: usize = 0
  while i < 2 {
    let outlines = run vmTable(ModelFixtures.varcPadCoords(), axes[i])
    let component = run vmFirst(&outlines)
    let out = run vmAlloc(
      run Effect.result(VarcOutlines.componentCoords(&outlines, &component, &coords, &root)),
    )
    run Testing.expect(
      List<F2Dot14>.length(&out) == axes[i] && F2Dot14.toF32(List<F2Dot14>.get(&out, 0)) == 0.25,
      "pad or truncate",
    )
    if axes[i] == 4 {
      run Testing.expect(
        F2Dot14.toF32(List<F2Dot14>.get(&out, 1)) == -0.5
          && F2Dot14.toF32(List<F2Dot14>.get(&out, 2)) == 0.0
          && F2Dot14.toF32(List<F2Dot14>.get(&out, 3)) == 0.0,
        "padded coordinates",
      )
    }
    i = i + 1
  }
  let reset = run vmTable(ModelFixtures.varcResetCoords(), 4)
  let component = run vmFirst(&reset)
  let out = run vmAlloc(
    run Effect.result(VarcOutlines.componentCoords(&reset, &component, &coords, &root)),
  )
  run Testing.expect(
    F2Dot14.toF32(List<F2Dot14>.get(&out, 0)) == 0.75
      && F2Dot14.toF32(List<F2Dot14>.get(&out, 1)) == 0.0,
    "reset uses font coordinates",
  )
}

import generated_model_fixtures as ModelExpected
import tables.maxp { Maxp }

test effect fn aCycleDrawsNothing() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmCycle() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vmCycle() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let outlines = run vmTable(ModelFixtures.varcCycle(), 0)
  let font = run vmRead(FontRef.new(ModelExpected.materialSymbols()))
  let mut base = vmBase()
  base.glyf = Maybe<GlyfLoca<'static>>.Some {
    value: run vmRead(TableProvider.selectedGlyfLoca(&font, Option<bool>.None))
  }
  base.hMetrics = run vmRead(TableProvider.hGlyphMetricRecords(&font))
  base.glyphCount = u16.toU32(Maxp.numGlyphs(&run vmRead(TableProvider.maxp(&font))))
  let actual = run vmAlloc(
    run Effect.result(VarcOutlines.controlBox(&outlines, &base, GlyphId.new(1), &[])),
  )
  let mut sink = ControlBounds.new(Affine2<f32>.identity())
  drop run vmAlloc(run Effect.result(BaseOutlines.draw(&base, GlyphId.new(2), &[], &mut sink)))
  let expected = ControlBounds.finish(&sink)
  run Testing.expect(
    actual.xMin == expected.xMin && actual.yMin == expected.yMin && actual.xMax == expected.xMax
      && actual.yMax == expected.yMax
      && expected.xMax > expected.xMin,
    "cycle skips back edge and keeps other leaf",
  )
}

test effect fn applyTransformVariationsMatchesReferencePath() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmTransformReference() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn vmTransformValues(t: &DecomposedTransform) -> [f32; 9] {
  return [
    DecomposedTransform.translateX(t),
    DecomposedTransform.translateY(t),
    DecomposedTransform.rotation(t),
    DecomposedTransform.scaleX(t),
    DecomposedTransform.scaleY(t),
    DecomposedTransform.skewX(t),
    DecomposedTransform.skewY(t),
    DecomposedTransform.centerX(t),
    DecomposedTransform.centerY(t),
  ]
}

effect fn vmTransformReference() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let outlines = run vmReal()
  let mut coords = List<F2Dot14>.make()
  let pattern: [f32; 4] = [0.5, -0.5, 0.25, -0.25]
  let mut i: usize = 0
  while i < outlines.axisCount {
    run List<F2Dot14>.append(&mut coords, F2Dot14.fromF32(pattern[i % 4]))
    i = i + 1
  }
  let mut gid: u32 = 0
  let mut tried: usize = 0
  while gid < 65536 && tried < 32 {
    let index = CoverageTable.get(&outlines.coverage, GlyphId.new(gid))
    gid = gid + 1
    if let Option<u32>.Some { value } = move index {
      let glyph = run vmRead(Varc.glyph(&outlines.table, u32.toUsize(value)))
      let mut components = VarcGlyph.components(&glyph)
      while let Option<Result<VarcComponent<'static>, ReadError>>.Some {
        value: item
      } = VarcComponentIter.next(&mut components) {
        let component = run vmRead(move item)
        let index = VarcComponent.transformVarIndex(&component)
        if let Option<u32>.Some { value: varIndex } = move index {
          let masks: [u32; 9] = [16, 32, 64, 256, 512, 8192, 16384, 1024, 2048]
          let divisors: [f32; 9] = [1.0, 1.0, 4096.0, 1024.0, 1024.0, 4096.0, 4096.0, 1.0, 1.0]
          let flags = VarcFlags.bits(&VarcComponent.flags(&component))
          let mut deltas = List<f64>.make()
          i = 0
          while i < 9 {
            if u32.bitAnd(flags, masks[i]) != 0 {
              run List<f64>.append(&mut deltas, 0.0)
            }
            i = i + 1
          }
          let mut expected = vmTransformValues(&VarcComponent.transform(&component))
          if List<f64>.length(&deltas) != 0 && varIndex != 4294967295 {
            drop run vmMust(
              run Effect.result(
                VarcOutlines.deltas(
                  &outlines,
                  varIndex,
                  List<F2Dot14>.asSlice(&coords),
                  List<f64>.asMutSlice(&mut deltas),
                ),
              ),
            )
            let mut at: usize = 0
            i = 0
            while i < 9 {
              if u32.bitAnd(flags, masks[i]) != 0 {
                expected[i] = expected[i] + f64.toF32(List<f64>.get(&deltas, at)) / divisors[i]
                at = at + 1
              }
              i = i + 1
            }
            if u32.bitAnd(flags, 512) == 0 {
              expected[4] = expected[3]
            }
          }
          let actual = vmTransformValues(
            &run vmAlloc(
              run Effect.result(
                VarcOutlines.transform(&outlines, &component, List<F2Dot14>.asSlice(&coords)),
              ),
            ),
          )
          i = 0
          while i < 9 {
            run Testing.expect(actual[i] == expected[i], "transform delta field order and scaling")
            i = i + 1
          }
          tried = tried + 1
          if tried >= 32 {
            break
          }
        }
      }
    }
  }
  run Testing.expect(tried > 0, "varied component transforms exercised")
}
