// Resolve 24-bit IDs without narrowing before the clip validates font coverage.
test effect fn glyph2BoundsPreserveBoundaryIds() -> ()
  ! AssertionError<'static> {
  let font = run cmFont()
  let sources = cmSources(run cmRead(TableProvider.colr(&font)))
  let coords: [F2Dot14; 0] = []
  let instance = ColorInstance { sources: sources, coords: &coords }
  let ids: [u32; 3] = [65535, 65536, 16777215]
  let mut i: usize = 0
  while i < 3 {
    let gid = ids[i]
    let bytes: [u8; 12] = [
      33,
      0,
      0,
      7,
      u32.toU8(u32.shiftRight(gid, 16)),
      u32.toU8(u32.bitAnd(u32.shiftRight(gid, 8), 255)),
      u32.toU8(u32.bitAnd(gid, 255)),
      2,
      0,
      7,
      64,
      0,
    ]
    let paint = run cmRead(Paint.read(FontData.new(&bytes)))
    let mut state = ColorWalk.new()
    let result = run Effect.result(ColorInstance.resolve(&instance, paint, &mut state))
    run Testing.expect(
      match move result {
        Result<ResolvedPaint, Error>.Success {
          value: ResolvedPaint.Glyph { glyph, child }
        } => GlyphId.toU32(glyph) == gid
        _ => false
      },
      "wide glyph ID retained",
    )
    i = i + 1
  }
}
