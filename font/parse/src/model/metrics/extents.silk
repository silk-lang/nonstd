import font_types.lib { BoundingBox, F48Dot16, Fixed, F26Dot6, F2Dot14, F4Dot12, F6Dot10 }
import silk.core.ownership { Copy }
import silk.core.order { Order }
import silk.core.ops { Subtract }
import silk.num.f32

pub struct GlyphExtents<T> {
  pub xBearing: T,
  pub yBearing: T,
  pub width: T,
  pub height: T,
}

impl<T: Copy> Copy for GlyphExtents<T> {}

impl<T> GlyphExtents<T> {
  pub fn fromBounds<T: Copy + ExtentsCoord>(bounds: BoundingBox<T>) -> Self {
    let mut left = bounds.xMin
    let mut right = bounds.xMax
    let mut bottom = bounds.yMin
    let mut top = bounds.yMax
    if !extentsLessEqual<T>(left, right) {
      left = bounds.xMax
      right = bounds.xMin
    }
    if !extentsLessEqual<T>(bottom, top) {
      bottom = bounds.yMax
      top = bounds.yMin
    }
    return Self {
      xBearing: left,
      yBearing: top,
      width: extentsSubtract<T>(right, left),
      height: extentsSubtract<T>(top, bottom),
    }
  }
}

pub fn zeroExtents() -> GlyphExtents<F48Dot16> {
  return GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.zero(),
    yBearing: F48Dot16.zero(),
    width: F48Dot16.zero(),
    height: F48Dot16.zero(),
  }
}

pub fn narrowExtents(e: GlyphExtents<F48Dot16>) -> GlyphExtents<f32> {
  return GlyphExtents<f32> {
    xBearing: F48Dot16.toF32(e.xBearing),
    yBearing: F48Dot16.toF32(e.yBearing),
    width: F48Dot16.toF32(e.width),
    height: F48Dot16.toF32(e.height),
  }
}

pub fn exactExtents(e: GlyphExtents<f32>) -> GlyphExtents<F48Dot16> {
  return GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.fromF64(f32.toF64(e.xBearing)),
    yBearing: F48Dot16.fromF64(f32.toF64(e.yBearing)),
    width: F48Dot16.fromF64(f32.toF64(e.width)),
    height: F48Dot16.fromF64(f32.toF64(e.height)),
  }
}

pub fn fixedBounds(bounds: BoundingBox<Fixed>) -> GlyphExtents<F48Dot16> {
  return GlyphExtents<F48Dot16>.fromBounds(
    BoundingBox<F48Dot16> {
      xMin: Fixed.toF48dot16(bounds.xMin),
      yMin: Fixed.toF48dot16(bounds.yMin),
      xMax: Fixed.toF48dot16(bounds.xMax),
      yMax: Fixed.toF48dot16(bounds.yMax),
    },
  )
}

pub interface ExtentsCoord {
  fn lessEqual(left: Self, right: Self) -> bool

  fn subtract(left: Self, right: Self) -> Self
}

fn extentsLessEqual<T: ExtentsCoord>(left: T, right: T) -> bool {
  return ExtentsCoord.lessEqual(move left, move right)
}

fn extentsSubtract<T: ExtentsCoord>(left: T, right: T) -> T {
  return ExtentsCoord.subtract(move left, move right)
}

impl ExtentsCoord for f32 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return left <= right
  }

  fn subtract(left: Self, right: Self) -> Self {
    return left - right
  }
}

impl ExtentsCoord for f64 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return left <= right
  }

  fn subtract(left: Self, right: Self) -> Self {
    return left - right
  }
}

impl ExtentsCoord for i16 {
  fn lessEqual(left: Self, right: Self) -> bool {
    return left <= right
  }

  fn subtract(left: Self, right: Self) -> Self {
    return left - right
  }
}

