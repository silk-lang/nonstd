//! Static conversion callbacks for batch APIs.
pub interface MetricConverter<I, O> {
  fn convert(self: &Self, value: I) -> O
}

pub struct IdentityConverter {}

impl<T> MetricConverter<T, T> for IdentityConverter {
  fn convert(self: &Self, value: T) -> T {
    return move value
  }
}
