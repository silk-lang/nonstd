/// [Axis value table flags](https://docs.microsoft.com/en-us/typography/opentype/spec/stat#flags).
pub struct AxisValueTableFlags {
  raw: u16,
}

impl Copy for AxisValueTableFlags {}

impl AxisValueTableFlags {
  pub fn bits(self: &Self) -> u16 {
    return self.raw
  }

  pub fn empty() -> AxisValueTableFlags {
    return AxisValueTableFlags { raw: 0 }
  }

  pub fn all() -> AxisValueTableFlags {
    return AxisValueTableFlags { raw: 3 }
  }

  pub fn fromBitsTruncate(bits: u16) -> AxisValueTableFlags {
    return AxisValueTableFlags { raw: bits & 3 }
  }

  pub fn fromBits(bits: u16) -> Option<AxisValueTableFlags> {
    if (bits & 3) != bits {
      return Option<AxisValueTableFlags>.None
    }
    return Option<AxisValueTableFlags>.some(AxisValueTableFlags { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: AxisValueTableFlags) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: AxisValueTableFlags) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: AxisValueTableFlags) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: AxisValueTableFlags) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: AxisValueTableFlags) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// If set, this axis value table provides axis value information
  /// that is applicable to other fonts within the same font family.
  /// This is used if the other fonts were released earlier and did
  /// not include information about values for some axis. If newer
  /// versions of the other fonts include the information themselves
  /// and are present, then this table is ignored.
  pub fn olderSiblingFontAttribute() -> AxisValueTableFlags {
    return AxisValueTableFlags { raw: 1 }
  }

  /// If set, it indicates that the axis value represents the
  /// “normal” value for the axis and may be omitted when
  /// composing name strings.
  pub fn elidableAxisValueName() -> AxisValueTableFlags {
    return AxisValueTableFlags { raw: 2 }
