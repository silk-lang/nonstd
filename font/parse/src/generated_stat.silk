impl<'a> AxisValue<'a> {
  pub fn value(self: &Self) -> Option<Fixed> {
    return match &self.* {
      AxisValue<'a>.Format1 { value } => Option<Fixed>.some(AxisValueFormat1.value(&value))
      AxisValue<'a>.Format2 { value } => Option<Fixed>.some(AxisValueFormat2.nominalValue(&value))
      AxisValue<'a>.Format3 { value } => Option<Fixed>.some(AxisValueFormat3.value(&value))
      _ => Option<Fixed>.None
    }
  }

  pub fn linkedValue(self: &Self) -> Option<Fixed> {
    return match &self.* {
      AxisValue<'a>.Format3 { value } => Option<Fixed>.some(AxisValueFormat3.linkedValue(&value))
      _ => Option<Fixed>.None
    }
  }

  pub fn axisIndex(self: &Self) -> Option<u16> {
    return match &self.* {
      AxisValue<'a>.Format1 { value } => Option<u16>.some(AxisValueFormat1.axisIndex(&value))
      AxisValue<'a>.Format2 { value } => Option<u16>.some(AxisValueFormat2.axisIndex(&value))
      AxisValue<'a>.Format3 { value } => Option<u16>.some(AxisValueFormat3.axisIndex(&value))
      _ => Option<u16>.None
    }
  }
}
