    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for AxisValueTableFlags {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if AxisValueTableFlags.contains(self, AxisValueTableFlags.olderSiblingFontAttribute()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("OLDER_SIBLING_FONT_ATTRIBUTE")
    }
    if AxisValueTableFlags.contains(self, AxisValueTableFlags.elidableAxisValueName()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("ELIDABLE_AXIS_VALUE_NAME")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

