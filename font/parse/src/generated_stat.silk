}

impl<'a> Copy for AxisValueFormat4<'a> {}

impl<'a> AxisValueFormat4<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let axisCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let flagsValue = scalarOr<AxisValueTableFlags>(
      data,
      ranges[2].start,
      AxisValueTableFlags.empty(),
    )
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueNameIdValue = scalarOr<NameId>(data, ranges[3].start, NameId.default())
    ranges[4].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(axisCountValue), 6))
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

