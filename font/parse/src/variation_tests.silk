  return [
    0,
    1,
    0,
    0,
    0,
    12,
    0,
    1,
    0,
    0,
    0,
    28,
    0,
    1,
    0,
    2,
    0,
    0,
    64,
    0,
    64,
    0,
    192,
    0,
    192,
    0,
    0,
    0,
    0,
    2,
    0,
    2,
    0,
    2,
    0,
    0,
    0,
    1,
    0,
    0,
    0,
    120,
    255,
    216,
    0,
    0,
  ]
}

test effect fn zeroDeltasStillValidateTheirRegions() -> ()
  ! AssertionError<'static> {
  let bytes = storeBytes()
  let store = run must(ItemVariationStore.read(FontData.new(&bytes)))
  let inputs: [f64; 5] = [-1.0, -0.25, 0.0, 0.25, 1.0]
  let mut i: usize = 0
  while i < 5 {
    let coord = inputs[i]
    let coords = [F2Dot14.fromF64(coord)]
    let mut scalars = [Fixed.zero(); 2]
    run Testing.expect(
      ItemVariationStore.computeScalars(&store, &coords, &mut scalars) == 2,
      "two scalars",
    )
    let mut positive: f64 = 0.0
    let mut negative: f64 = 0.0
    if coord < 0.0 {
      negative = -coord
    } else {
      positive = coord
    }
    let expected = [120.0 * negative, -40.0 * positive]
    let mut inner: usize = 0
    while inner < 2 {
      let index = DeltaSetIndex { outer: 0, inner: usize.toU16(inner) }
      run deltaIs(ItemVariationStore.computeDelta(&store, index, &coords), expected[inner])
      let mut count: usize = 0
      while count <= 2 {
        run deltaIs(
          ItemVariationStore.computeDeltaWithScalars(
            &store,
            index,
            &coords,
            Slice.view(&scalars, 0, count),
          ),
          expected[inner],
        )
        count = count + 1
      }
      inner = inner + 1
    }
    i = i + 1
  }
  let mut bad = storeBytes()
  bad[35] = 2
  let leading = run must(ItemVariationStore.read(FontData.new(&bad)))
  run Testing.expect(
    match move ItemVariationStore.computeDelta(
      &leading,
      DeltaSetIndex { outer: 0, inner: 0 },
      &[F2Dot14.one()],
    ) {
      Option<F48Dot16>.None => true
      _ => false
    },
    "leading zero validates region",
  )
  bad[35] = 0
  bad[37] = 2
  let trailing = run must(ItemVariationStore.read(FontData.new(&bad)))
  run Testing.expect(
    match move ItemVariationStore.computeDelta(
      &trailing,
      DeltaSetIndex { outer: 0, inner: 1 },
      &[F2Dot14.one()],
    ) {
      Option<F48Dot16>.None => true
      _ => false
    },
    "trailing zero validates region",
  )
}

test effect fn implicitAdvanceIndicesDoNotTruncateGlyphIds() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x00\x00\x0c\x00\x01\x00\x00\x00\x16\x00\x01\x00\x01\x00\x00\x40\x00\x40\x00\x00\x02\x00\x01\x00\x01\x00\x00\x00\x0a\x00\x64"
  let store = run must(ItemVariationStore.read(FontData.new(bytes)))
  let mapping = run must(DeltaSetIndexMap.read(FontData.new(b"\x00\x00\x00\x01\x00")))
  let coords = [F2Dot14.fromF64(0.75)]
  let mut scalars = [Fixed.zero(); 32]
  let count = ItemVariationStore.computeScalars(&store, &coords, &mut scalars)
  let mut pass: usize = 0
  while pass < 2 {
    let mut size: usize = 0
    if pass == 1 {
      size = count
    }
    let cached = Slice.view(&scalars, 0, size)
    run deltaIs(
      advanceDeltaWithScalars(
        Option<Result<DeltaSetIndexMap<'static>, ReadError>>.None,
        Result<ItemVariationStore<'static>, ReadError>.succeed(store),
        GlyphId.new(1),
        &coords,
        cached,
      ),
      75.0,
    )
    let ids: [u32; 4] = [65535, 65536, 65537, 4294901761]
    let mut i: usize = 0
    while i < 4 {
      run deltaIs(
        advanceDeltaWithScalars(
          Option<Result<DeltaSetIndexMap<'static>, ReadError>>.None,
          Result<ItemVariationStore<'static>, ReadError>.succeed(store),
          GlyphId.new(ids[i]),
          &coords,
          cached,
        ),
        0.0,
      )
      i = i + 1
    }
    i = 1
    while i < 3 {
      run deltaIs(
        advanceDeltaWithScalars(
          Option<Result<DeltaSetIndexMap<'static>, ReadError>>.some(
            Result<DeltaSetIndexMap<'static>, ReadError>.succeed(mapping),
          ),
          Result<ItemVariationStore<'static>, ReadError>.succeed(store),
          GlyphId.new(ids[i]),
          &coords,
          cached,
        ),
        7.5,
      )
      i = i + 1
    }
    pass = pass + 1
  }
}

test effect fn ivsDataLenShort() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 144] = [1; 144]
  let header: [u8; 16] = [0, 2, 0, 3, 0, 5, 0, 0, 0, 1, 0, 2, 0, 3, 0, 4]
  let mut i: usize = 0
  while i < 16 {
    bytes[i] = header[i]
    i = i + 1
  }
  let data = run must(ItemVariationData.read(FontData.new(&bytes)))
  run Testing.expect(
    ScalarArray<u8>.len(&ItemVariationData.deltaSets(&data)) == 16,
    "short rows length",
  )
}

test effect fn ivsDataLenLong() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 140] = [1; 140]
  let header: [u8; 12] = [0, 2, 128, 2, 0, 4, 0, 0, 0, 1, 0, 2]
  let mut i: usize = 0
  while i < 12 {
    bytes[i] = header[i]
    i = i + 1
  }
  let data = run must(ItemVariationData.read(FontData.new(&bytes)))
  run Testing.expect(
    ScalarArray<u8>.len(&ItemVariationData.deltaSets(&data)) == 24,
    "long rows length",
  )
}

test effect fn deltaSetIndexMapEmptyIsIdentity() -> ()
  ! AssertionError<'static> {
  let map = run must(DeltaSetIndexMap.read(FontData.new(b"\x00\x00\x00\x00")))
  let index = run must(DeltaSetIndexMap.get(&map, 65538))
  run Testing.expect(index.outer == 1 && index.inner == 2, "empty map preserves both indices")
}
