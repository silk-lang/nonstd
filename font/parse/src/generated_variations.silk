  }

  pub fn intersects(self: &Self, other: EntryFormat) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: EntryFormat) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: EntryFormat) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: EntryFormat) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// Mask for the low 4 bits, which give the count of bits minus one that are used in each entry for the inner-level index.
  pub fn innerIndexBitCountMask() -> EntryFormat {
    return EntryFormat { raw: 15 }
  }

  /// Mask for bits that indicate the size in bytes minus one of each entry.
  pub fn mapEntrySizeMask() -> EntryFormat {
    return EntryFormat { raw: 48 }
  }
}

impl Equal for EntryFormat {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.raw == right.raw
  }
}

impl EntryFormat {
  pub fn default() -> Self {
    return EntryFormat.empty()
  }
}

impl Order for EntryFormat {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.raw < right.raw {
      return Ordering.Less
    }
    if left.raw > right.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Debug for EntryFormat {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut first = true
    if EntryFormat.contains(self, EntryFormat.innerIndexBitCountMask()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("INNER_INDEX_BIT_COUNT_MASK")
    }
    if EntryFormat.contains(self, EntryFormat.mapEntrySizeMask()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("MAP_ENTRY_SIZE_MASK")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<EntryFormat, EntryFormat> for EntryFormat {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<EntryFormat, EntryFormat> for EntryFormat {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<EntryFormat, EntryFormat> for EntryFormat {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<EntryFormat, EntryFormat> for EntryFormat {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<EntryFormat> for EntryFormat {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 63 }
  }
}

impl Scalar for EntryFormat {
  fn rawByteLen() -> usize {
    return 1
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u8>(bytes) {
      Option<u8>.Some { value } => Option<Self>.some(EntryFormat.fromBitsTruncate(value))
      Option<u8>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u8>(value.raw, move bytes)
  }
}

impl FixedSize for EntryFormat {
  fn rawByteLen() -> usize {
    return 1
  }
}

/// The [VariationRegionList](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#variation-regions) table
pub struct VariationRegionList<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for VariationRegionList<'a> {}

impl<'a> VariationRegionList<'a> {
  pub fn default() -> Self {
    return VariationRegionList<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let axisCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let regionCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(regionCountValue),
        (computeSize<u16, VariationRegion<'a>>(axisCountValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// The number of variation axes for this font. This must be the
  /// same number as axisCount in the 'fvar' table.
  pub fn axisCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn axisCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// The number of variation region tables in the variation region
  /// list. Must be less than 32,768.
  pub fn regionCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn regionCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of variation regions.
  pub fn variationRegions(self: &Self) -> ComputedArray<'a, u16, VariationRegion<'a>> {
    return match move ComputedArray<'a, u16, VariationRegion<'a>>.new(
      self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
      VariationRegionList<'a>.axisCount(self),
    ) {
      Result<ComputedArray<'a, u16, VariationRegion<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, u16, VariationRegion<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, u16, VariationRegion<'a>>.empty(
        VariationRegionList<'a>.axisCount(self),
      )
    }
  }

  pub fn variationRegionsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for VariationRegionList<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return VariationRegionList<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for VariationRegionList<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// The [VariationRegion](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#variation-regions) record
pub struct VariationRegion<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 1],
  _axisCount: u16,
}

impl<'a> Copy for VariationRegion<'a> {}

impl<'a> VariationRegion<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    let axisCountValue = args
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(axisCountValue), 6))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _axisCount: axisCountValue }
    if let Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Failure {
      error
    } = move recordArray<RegionAxisCoordinates<'a>>(data, ranges[0].start, ranges[0].end) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return VariationRegion<'a>.readAt(FontData.defaultTableData(), 0, 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _axisCount: 0,
        },
      )
  }

  /// Array of region axis coordinates records, in the order of axes
  /// given in the 'fvar' table.
  pub fn regionAxes(self: &Self) -> ComputedArray<'a, (), RegionAxisCoordinates<'a>> {
    return match move recordArray<RegionAxisCoordinates<'a>>(
      self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), RegionAxisCoordinates<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), RegionAxisCoordinates<'a>>.empty(())
    }
  }
}

impl<'a> ComputeSize<u16> for VariationRegion<'a> {
  fn computeSize(args: u16) -> Result<usize, ReadError> {
    let axisCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(axisCountValue), 6),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, u16> for VariationRegion<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    return VariationRegion<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, u16> for VariationRegion<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return VariationRegion<'a>.readAt(data, 0, args)
  }
}

/// The [RegionAxisCoordinates](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#variation-regions) record
pub struct RegionAxisCoordinates<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for RegionAxisCoordinates<'a> {}

impl<'a> RegionAxisCoordinates<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// The region start coordinate value for the current axis.
  pub fn startCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 0)) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  /// The region peak coordinate value for the current axis.
  pub fn peakCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 2)) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }

  /// The region end coordinate value for the current axis.
  pub fn endCoord(self: &Self) -> F2Dot14 {
    return match move FontData<'a>.readAt<F2Dot14>(&self._fontData, (self.position + 4)) {
      Result<F2Dot14, ReadError>.Success { value } => value
      Result<F2Dot14, ReadError>.Failure { error } => F2Dot14.zero()
    }
  }
}

impl<'a> FixedSize for RegionAxisCoordinates<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for RegionAxisCoordinates<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for RegionAxisCoordinates<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return RegionAxisCoordinates<'a>.readAt(data, position, ())
  }
}

/// The [ItemVariationStore](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#item-variation-store-header-and-item-variation-data-subtables) table
pub struct ItemVariationStore<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for ItemVariationStore<'a> {}

impl<'a> ItemVariationStore<'a> {
  pub fn default() -> Self {
    return ItemVariationStore<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let variationRegionListOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let itemVariationDataCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(itemVariationDataCountValue), 4),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format— set to 1
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset in bytes from the start of the item variation store to
  /// the variation region list.
  pub fn variationRegionListOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn variationRegionList(self: &Self) -> Result<VariationRegionList<'a>, ReadError> {
    let offset = ItemVariationStore<'a>.variationRegionListOffset(self)
    return resolveWithArgs<(), VariationRegionList<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn variationRegionListOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The number of item variation data subtables.
  pub fn itemVariationDataCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn itemVariationDataCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Offsets in bytes from the start of the item variation store to
  /// each item variation data subtable.
  pub fn itemVariationDataOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset32>> {
    return match move FontData<'a>.readArray<Nullable<Offset32>>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset32>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset32>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset32>
      >.empty()
    }
  }

  pub fn itemVariationData(self: &Self) -> ArrayOfNullableOffsets<
    'a,
    (),
    ItemVariationData<'a>,
    Offset32
  > {
    return ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.new(
      ItemVariationStore<'a>.itemVariationDataOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn itemVariationDataOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for ItemVariationStore<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ItemVariationStore<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ItemVariationStore<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// The [ItemVariationData](https://learn.microsoft.com/en-us/typography/opentype/spec/otvarcommonformats#item-variation-store-header-and-item-variation-data-subtables) subtable
pub struct ItemVariationData<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for ItemVariationData<'a> {}

impl<'a> ItemVariationData<'a> {
  pub fn default() -> Self {
    return ItemVariationData<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 5] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let itemCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let wordDeltaCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let regionIndexCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(regionIndexCountValue), 2))
    ranges[3].end = end
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        itemVariationDataLen(itemCountValue, wordDeltaCountValue, regionIndexCountValue),
        1,
      ),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// The number of delta sets for distinct items.
  pub fn itemCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn itemCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// A packed field: the high bit is a flag—see details below.
  pub fn wordDeltaCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn wordDeltaCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// The number of variation regions referenced.
  pub fn regionIndexCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn regionIndexCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of indices into the variation region list for the regions
  /// referenced by this item variation data table.
  pub fn regionIndexes(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn regionIndexesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Delta-set rows.
  pub fn deltaSets(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn deltaSetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for ItemVariationData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ItemVariationData<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for ItemVariationData<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/variations_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
fn deltaSetIndexData(format: EntryFormat, count: usize) -> usize {
  return usize.saturatingMultiply(
    count,
    u8.toUsize(u8.shiftRight(EntryFormat.bits(&format) & 48, 4)) + 1,
  )
}

fn itemVariationDataLen(count: u16, words: u16, regions: u16) -> usize {
  let longs = u16.toUsize(words & 32767)
  let shorts = usize.saturatingSubtract(u16.toUsize(regions), longs)
  let mut wordSize: usize = 2
  let mut smallSize: usize = 1
  if (words & 32768) != 0 {
    wordSize = 4
    smallSize = 2
  }
  return (longs * wordSize + shorts * smallSize) * u16.toUsize(count)
}

import font_types.lib { F48Dot16 }
import font_data { Cursor }
import silk.num.i8

pub const NO_VARIATION_INDEX: u32 = 4294967295

pub struct DeltaSetIndex {
  pub outer: u16,
  pub inner: u16,
}

impl Copy for DeltaSetIndex {}

impl DeltaSetIndex {
  pub fn default() -> Self {
    return Self { outer: 0, inner: 0 }
  }

  pub fn noVariationIndex() -> Self {
    return Self { outer: 65535, inner: 65535 }
  }

  pub fn fromU32(value: u32) -> Self {
    return Self { outer: u32.toU16(u32.shiftRight(value, 16)), inner: u32.toU16(value & 65535) }
  }
}

impl Equal for DeltaSetIndex {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.outer == right.outer && left.inner == right.inner
  }
}

impl Order for DeltaSetIndex {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.outer < right.outer || (left.outer == right.outer && left.inner < right.inner) {
      return Ordering.Less
    }
    if left.outer > right.outer || left.inner > right.inner {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl EntryFormat {
  pub fn entrySize(self: Self) -> u8 {
    return u8.shiftRight(self.raw & 48, 4) + 1
  }

  pub fn bitCount(self: Self) -> u8 {
    return (self.raw & 15) + 1
  }
}

impl<'a> DeltaSetIndexMap<'a> {
  pub fn get(self: &Self, index: u32) -> Result<DeltaSetIndex, ReadError> {
    let mut format = EntryFormat.empty()
    let mut count: u32 = 0
    let mut data = FontData.new(b"")
    match &self.* {
      DeltaSetIndexMap<'a>.Format0 { value } => {
        format = DeltaSetIndexMapFormat0.entryFormat(&value)
        count = u16.toU32(DeltaSetIndexMapFormat0.mapCount(&value))
        data = ScalarArray<u8>.offsetData(&DeltaSetIndexMapFormat0.mapData(&value))
      }
      DeltaSetIndexMap<'a>.Format1 { value } => {
        format = DeltaSetIndexMapFormat1.entryFormat(&value)
        count = DeltaSetIndexMapFormat1.mapCount(&value)
        data = ScalarArray<u8>.offsetData(&DeltaSetIndexMapFormat1.mapData(&value))
      }
    }
    if count == 0 {
      return Result<DeltaSetIndex, ReadError>.succeed(DeltaSetIndex.fromU32(index))
    }
    let mut selected = index
    if selected >= count {
      selected = count - 1
    }
    let size = EntryFormat.entrySize(format)
    let offset = usize.saturatingMultiply(u32.toUsize(selected), u8.toUsize(size))
    let mut entry: u32 = 0
    let mut i: usize = 0
    while i < u8.toUsize(size) {
      let byte = match move FontData<'a>.readAt<u8>(&data, usize.saturatingAdd(offset, i)) {
        Result<u8, ReadError>.Success { value } => value
        Result<u8, ReadError>.Failure { error } => {
          return Result<DeltaSetIndex, ReadError>.failResult(error)
        }
      }
      entry = u32.shiftLeft(entry, 8) | u8.toU32(byte)
      i = i + 1
    }
    let bits = u8.toU32(EntryFormat.bitCount(format))
    return Result<DeltaSetIndex, ReadError>.succeed(
      DeltaSetIndex {
        outer: u32.toU16(u32.shiftRight(entry, bits) & 65535),
        inner: u32.toU16(entry & (u32.shiftLeft(1, bits) - 1)),
      },
    )
  }
}

impl<'a> ItemVariationData<'a> {
  pub fn deltaRowLen(words: u16, regions: u16) -> usize {
    return itemVariationDataLen(1, words, regions)
  }

  pub fn deltaSetsLen(count: u16, words: u16, regions: u16) -> usize {
    return itemVariationDataLen(count, words, regions)
  }

  pub fn getDeltaRowLen(self: &Self) -> usize {
    return ItemVariationData.deltaRowLen(
      ItemVariationData.wordDeltaCount(self),
      ItemVariationData.regionIndexCount(self),
    )
  }

  pub fn deltaSet(self: &Self, innerIndex: u16) -> ItemDeltas<'a> {
    let words = ItemVariationData.wordDeltaCount(self)
    let bytes = ScalarArray<u8>.offsetData(&ItemVariationData.deltaSets(self))
    let offset = ItemVariationData.getDeltaRowLen(self) * u16.toUsize(innerIndex)
    let data = FontData.splitOff(&bytes, offset) |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    return ItemDeltas<'a> {
      cursor: FontData.cursor(&data),
      wordCount: words & 32767,
      longWords: (words & 32768) != 0,
      len: ItemVariationData.regionIndexCount(self),
      pos: 0,
    }
  }
}

pub struct ItemDeltas<'a> {
  cursor: Cursor<'a>,
  wordCount: u16,
  longWords: bool,
  len: u16,
  pos: u16,
}

impl<'a> Copy for ItemDeltas<'a> {}

impl<'a> ItemDeltas<'a> {
  pub fn next(self: &mut Self) -> Option<i32> {
    if self.pos >= self.len {
      return Option<i32>.None
    }
    let large = self.pos < self.wordCount
    self.pos = self.pos + 1
    if large && self.longWords {
      return match move Cursor<'a>.read<i32>(&mut self.cursor) {
        Result<i32, ReadError>.Success { value } => Option<i32>.some(value)
        _ => Option<i32>.None
      }
    }
    if large || self.longWords {
      return match move Cursor<'a>.read<i16>(&mut self.cursor) {
        Result<i16, ReadError>.Success { value } => Option<i32>.some(i16.toI32(value))
        _ => Option<i32>.None
      }
    }
    return match move Cursor<'a>.read<i8>(&mut self.cursor) {
      Result<i8, ReadError>.Success { value } => Option<i32>.some(i8.toI32(value))
      _ => Option<i32>.None
    }
  }
}

impl<'a> VariationRegion<'a> {
  pub fn computeScalar(self: &Self, coords: &[F2Dot14]) -> Fixed {
    let axes = VariationRegion.regionAxes(self)
    let mut scalar = Fixed.one()
    let mut i: usize = 0
    while i < ComputedArray<'a, (), RegionAxisCoordinates<'a>>.len(&axes) {
      let axis = match move ComputedArray<'a, (), RegionAxisCoordinates<'a>>.get(&axes, i) {
        Result<RegionAxisCoordinates<'a>, ReadError>.Success { value } => value
        _ => {
          return Fixed.zero()
        }
      }
      let peak = RegionAxisCoordinates.peakCoord(&axis)
      let mut coord = F2Dot14.zero()
      if i < coords.length {
        coord = coords[i]
      }
      i = i + 1
      if F2Dot14.toBits(peak) == 0 || F2Dot14.toBits(peak) == F2Dot14.toBits(coord) {
        continue
      }
      let start = F2Dot14.toFixed(RegionAxisCoordinates.startCoord(&axis))
      let end = F2Dot14.toFixed(RegionAxisCoordinates.endCoord(&axis))
      let peakFixed = F2Dot14.toFixed(peak)
      if Fixed.toBits(start) > Fixed.toBits(peakFixed)
        || Fixed.toBits(peakFixed) > Fixed.toBits(end)
        || (Fixed.toBits(start) < 0 && Fixed.toBits(end) > 0) {
        continue
      }
      let point = F2Dot14.toFixed(coord)
      if Fixed.toBits(point) < Fixed.toBits(start) || Fixed.toBits(point) > Fixed.toBits(end) {
        return Fixed.zero()
      }
      if Fixed.toBits(point) < Fixed.toBits(peakFixed) {
        scalar = Fixed.mulDiv(&scalar, point - start, peakFixed - start)
      } else {
        scalar = Fixed.mulDiv(&scalar, end - point, end - peakFixed)
      }
    }
    return scalar
  }
}

impl<'a> ItemVariationStore<'a> {
  pub fn computeDelta(self: &Self, index: DeltaSetIndex, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return ItemVariationStore.computeDeltaWithScalars(self, index, coords, &[])
  }

  pub fn computeDeltaWithScalars(
    self: &Self,
    index: DeltaSetIndex,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    if coords.length == 0 || (index.outer == 65535 && index.inner == 65535) {
      return Option<F48Dot16>.some(F48Dot16.zero())
    }
    let offsets = ItemVariationStore.itemVariationData(self)
    let data = match move ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.get(
      &offsets,
      u16.toUsize(index.outer),
    ) {
      Option<Result<ItemVariationData<'a>, ReadError>>.None => {
        return Option<F48Dot16>.some(F48Dot16.zero())
      }
      Option<Result<ItemVariationData<'a>, ReadError>>.Some { value } => match move value {
        Result<ItemVariationData<'a>, ReadError>.Success { value: item } => item
        _ => {
          return Option<F48Dot16>.None
        }
      }
    }
    let indices = ItemVariationData.regionIndexes(&data)
    let mut deltas = ItemVariationData.deltaSet(&data, index.inner)
    let mut regions = Option<ComputedArray<'a, u16, VariationRegion<'a>>>.None
    let mut accum = F48Dot16.zero()
    let mut i: usize = 0
    while i < ScalarArray<u16>.len(&indices) {
      let delta = match move ItemDeltas.next(&mut deltas) {
        Option<i32>.Some { value } => value
        Option<i32>.None => {
          break
        }
      }
      let regionIndex = u16.toUsize(ScalarArray<u16>.get(&indices, i) |> Option<u16>.unwrapOr(0))
      i = i + 1
      let mut scalar = Fixed.zero()
      if regionIndex < scalars.length {
        scalar = scalars[regionIndex]
      } else {
        if match &regions {
          Option<ComputedArray<'a, u16, VariationRegion<'a>>>.None => true
          _ => false
        } {
          let list = match move ItemVariationStore.variationRegionList(self) {
            Result<VariationRegionList<'a>, ReadError>.Success { value } => value
            _ => {
              return Option<F48Dot16>.None
            }
          }
          regions = Option<ComputedArray<'a, u16, VariationRegion<'a>>>.some(
            VariationRegionList.variationRegions(&list),
          )
        }
        let regionResult = match &regions {
          Option<ComputedArray<'a, u16, VariationRegion<'a>>>.Some { value } => ComputedArray<
            'a,
            u16,
            VariationRegion<'a>
          >.get(&value, regionIndex)
          _ => {
            return Option<F48Dot16>.None
          }
        }
        let region = match move regionResult {
          Result<VariationRegion<'a>, ReadError>.Success { value } => value
          _ => {
            return Option<F48Dot16>.None
          }
        }

        // Resolve even zero deltas: malformed region indices must still fail.
        if delta == 0 {
          continue
        }
        scalar = VariationRegion.computeScalar(&region, coords)
      }
      accum = accum + Fixed.mulI32(scalar, delta)
    }
    return Option<F48Dot16>.some(accum)
  }

  pub fn computeScalars(self: &Self, coords: &[F2Dot14], out: &mut [Fixed]) -> usize {
    let list = match move ItemVariationStore.variationRegionList(self) {
      Result<VariationRegionList<'a>, ReadError>.Success { value } => value
      _ => {
        return 0
      }
    }
    let regions = VariationRegionList.variationRegions(&list)
    let mut count = ComputedArray<'a, u16, VariationRegion<'a>>.len(&regions)
    if count > out.length {
      count = out.length
    }
    let mut i: usize = 0
    while i < count {
      let region = match move ComputedArray<'a, u16, VariationRegion<'a>>.get(&regions, i) {
        Result<VariationRegion<'a>, ReadError>.Success { value } => value
        _ => {
          return i
        }
      }
      out[i] = VariationRegion.computeScalar(&region, coords)
      i = i + 1
    }
    return count
  }
}

pub fn advanceDeltaWithScalars<'a>(
  mapping: Option<Result<DeltaSetIndexMap<'a>, ReadError>>,
  store: Result<ItemVariationStore<'a>, ReadError>,
  glyphId: GlyphId,
  coords: &[F2Dot14],
  scalars: &[Fixed],
) -> Option<F48Dot16> {
  if coords.length == 0 {
    return Option<F48Dot16>.some(F48Dot16.zero())
  }
  let gid = GlyphId.toU32(glyphId)
  let mut index = DeltaSetIndex.default()
  match move mapping {
    Option<Result<DeltaSetIndexMap<'a>, ReadError>>.Some {
      value: Result<DeltaSetIndexMap<'a>, ReadError>.Success { value }
    } => {
      index = match move DeltaSetIndexMap.get(&value, gid) {
        Result<DeltaSetIndex, ReadError>.Success { value: found } => found
        _ => {
          return Option<F48Dot16>.None
        }
      }
    }
    _ => {
      if gid > 65535 {
        return Option<F48Dot16>.some(F48Dot16.zero())
      }
      index = DeltaSetIndex { outer: 0, inner: u32.toU16(gid) }
    }
  }
  return match move store {
    Result<ItemVariationStore<'a>, ReadError>.Success {
      value
    } => ItemVariationStore.computeDeltaWithScalars(&value, index, coords, scalars)
    _ => Option<F48Dot16>.None
  }
}

pub fn itemDeltaWithScalars<'a>(
  mapping: Option<Result<DeltaSetIndexMap<'a>, ReadError>>,
  store: Result<ItemVariationStore<'a>, ReadError>,
  glyphId: GlyphId,
  coords: &[F2Dot14],
  scalars: &[Fixed],
) -> Option<F48Dot16> {
  if coords.length == 0 {
    return Option<F48Dot16>.some(F48Dot16.zero())
  }
  let index = match move mapping {
    Option<Result<DeltaSetIndexMap<'a>, ReadError>>.Some {
      value: Result<DeltaSetIndexMap<'a>, ReadError>.Success { value }
    } => match move DeltaSetIndexMap.get(&value, GlyphId.toU32(glyphId)) {
      Result<DeltaSetIndex, ReadError>.Success { value: index } => index
      _ => {
        return Option<F48Dot16>.None
      }
    }
    _ => {
      return Option<F48Dot16>.None
    }
  }
  return match move store {
    Result<ItemVariationStore<'a>, ReadError>.Success {
      value
    } => ItemVariationStore.computeDeltaWithScalars(&value, index, coords, scalars)
    _ => Option<F48Dot16>.None
  }
}

// Handwritten extension from font/parse/src/tables/variations_packed.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
pub struct PackedPointNumbers<'a> {
  data: FontData<'a>,
}

impl<'a> Copy for PackedPointNumbers<'a> {}

pub struct PackedPointSplit<'a> {
  pub points: PackedPointNumbers<'a>,
  pub remainder: FontData<'a>,
}

impl<'a> Copy for PackedPointSplit<'a> {}

pub struct PackedPointCount {
  pub count: u16,
  pub bytes: usize,
}

impl Copy for PackedPointCount {}

impl<'a> PackedPointNumbers<'a> {
  pub fn default() -> Self {
    return Self { data: FontData.new(b"") }
  }

  pub fn splitOffFront(data: FontData<'a>) -> PackedPointSplit<'a> {
    let points = Self { data: data }
    let length = PackedPointNumbers.totalLen(&points)
    return PackedPointSplit<'a> {
      points: points,
      remainder: FontData.splitOff(&data, length)
        |> Option<FontData<'a>>.unwrapOr(FontData.new(b"")),
    }
  }

  pub fn count(self: &Self) -> u16 {
    return PackedPointNumbers.countAndCountBytes(self).count
  }

  fn countAndCountBytes(self: &Self) -> PackedPointCount {
    let byte = FontData<'a>.readAt<u8>(&self.data, 0) |> Result<u8, ReadError>.unwrapOr(0)
    if byte < 128 {
      return PackedPointCount { count: u8.toU16(byte), bytes: 1 }
    }
    let count = FontData<'a>.readAt<u16>(&self.data, 0) |> Result<u16, ReadError>.unwrapOr(0)
    return PackedPointCount { count: count & 32767, bytes: 2 }
  }

  pub fn totalLen(self: &Self) -> usize {
    let counted = PackedPointNumbers.countAndCountBytes(self)
    let mut bytes = counted.bytes
    if counted.count == 0 {
      return bytes
    }
    let mut cursor = FontData.cursor(&self.data)
    Cursor.advanceBy(&mut cursor, bytes)
    let mut seen: u16 = 0
    while seen < counted.count {
      let control = match move Cursor<'a>.read<u8>(&mut cursor) {
        Result<u8, ReadError>.Success { value } => value
        _ => {
          return bytes
        }
      }
      let count = u8.toU16(control & 127) + 1
      let mut width: usize = 1
      if (control & 128) != 0 {
        width = 2
      }
      let length = u16.toUsize(count) * width
      bytes = usize.saturatingAdd(bytes, length + 1)
      Cursor.advanceBy(&mut cursor, length)
      seen = seen + count
    }
    return bytes
  }

  pub fn iter(self: &Self) -> PackedPointNumbersIter<'a> {
    let counted = PackedPointNumbers.countAndCountBytes(self)
    let mut cursor = FontData.cursor(&self.data)
    Cursor.advanceBy(&mut cursor, counted.bytes)
    return PackedPointNumbersIter<'a> {
      cursor: cursor,
      count: counted.count,
      seen: 0,
      last: 0,
      remaining: 0,
      twoBytes: false,
    }
  }
}

pub struct PackedPointNumbersIter<'a> {
  cursor: Cursor<'a>,
  count: u16,
  seen: u16,
  last: u16,
  remaining: u8,
  twoBytes: bool,
}

impl<'a> Copy for PackedPointNumbersIter<'a> {}

impl<'a> PackedPointNumbersIter<'a> {
  pub fn new(count: u16, cursor: Cursor<'a>) -> Self {
    return Self { cursor: cursor, count: count, seen: 0, last: 0, remaining: 0, twoBytes: false }
  }

  pub fn next(self: &mut Self) -> Option<u16> {
    if self.count == 0 {
      let result = self.last
      self.last = match move u16.checkedAdd(self.last, 1) {
        Option<u16>.Some { value } => value
        _ => {
          return Option<u16>.None
        }
      }
      return Option<u16>.some(result)
    }
    if self.count == self.seen {
      return Option<u16>.None
    }
    self.seen = self.seen + 1
    if self.remaining == 0 {
      let control = match move Cursor<'a>.read<u8>(&mut self.cursor) {
        Result<u8, ReadError>.Success { value } => value
        _ => {
          return Option<u16>.None
        }
      }
      self.remaining = (control & 127) + 1
      self.twoBytes = (control & 128) != 0
    }
    self.remaining = self.remaining - 1
    let mut delta: u16 = 0
    if self.twoBytes {
      delta = match move Cursor<'a>.read<u16>(&mut self.cursor) {
        Result<u16, ReadError>.Success { value } => value
        _ => {
          return Option<u16>.None
        }
      }
    } else {
      delta = match move Cursor<'a>.read<u8>(&mut self.cursor) {
        Result<u8, ReadError>.Success { value } => u8.toU16(value)
        _ => {
          return Option<u16>.None
        }
      }
    }
    self.last = match move u16.checkedAdd(self.last, delta) {
      Option<u16>.Some { value } => value
      _ => {
        return Option<u16>.None
      }
    }
    return Option<u16>.some(self.last)
  }
}

pub enum DeltaRunType {
  Zero,
  I8,
  I16,
  I32
}

impl DeltaRunType {
  pub fn new(control: u8) -> Self {
    return match control & 192 {
      0 => DeltaRunType.I8
      64 => DeltaRunType.I16
      128 => DeltaRunType.Zero
      _ => DeltaRunType.I32
    }
  }

  pub fn byteSize(self: Self) -> usize {
    return match self {
      DeltaRunType.Zero => 0
      DeltaRunType.I8 => 1
      DeltaRunType.I16 => 2
      DeltaRunType.I32 => 4
    }
  }
}

pub struct PackedDeltas<'a> {
  data: FontData<'a>,
  bounded: bool,
  limit: usize,
}

impl<'a> Copy for PackedDeltas<'a> {}

impl<'a> PackedDeltas<'a> {
  pub fn new(data: FontData<'a>, count: usize) -> Self {
    return Self { data: data, bounded: true, limit: count }
  }

  pub fn consumeAll(data: FontData<'a>) -> Self {
    return Self { data: data, bounded: false, limit: 0 }
  }

  pub fn count(self: &Self) -> Option<usize> {
    if self.bounded {
      return Option<usize>.some(self.limit)
    }
    return Option<usize>.None
  }

  pub fn countOrCompute(self: &Self) -> usize {
    if self.bounded {
      return self.limit
    }
    let mut count: usize = 0
    let mut offset: usize = 0
    while true {
      let control = match move FontData<'a>.readAt<u8>(&self.data, offset) {
        Result<u8, ReadError>.Success { value } => value
        _ => {
          return count
        }
      }
      let length = u8.toUsize(control & 63) + 1
      count = usize.saturatingAdd(count, length)
      offset = usize.saturatingAdd(
        offset,
        length * DeltaRunType.byteSize(DeltaRunType.new(control)) + 1,
      )
    }
  }

  pub fn iter(self: &Self) -> DeltaRunIter<'a> {
    return DeltaRunIter<'a> {
      cursor: FontData.cursor(&self.data),
      bounded: self.bounded,
      limit: self.limit,
      remaining: 0,
      valueType: DeltaRunType.I8,
    }
  }

  pub fn xDeltas(self: &Self) -> DeltaRunIter<'a> {
    return PackedDeltas.iter(&PackedDeltas.new(self.data, PackedDeltas.countOrCompute(self) / 2))
  }

  pub fn yDeltas(self: &Self) -> DeltaRunIter<'a> {
    let count = PackedDeltas.countOrCompute(self)
    return DeltaRunIter.skipFast(PackedDeltas.iter(&PackedDeltas.new(self.data, count)), count / 2)
  }

  pub fn fetcher(self: &Self) -> PackedDeltaFetcher<'a> {
    return PackedDeltaFetcher<'a> {
      data: self.data,
      pos: 0,
      runCount: 0,
      valueType: DeltaRunType.I8,
      bounded: self.bounded,
      remaining: self.limit,
    }
  }
}

pub struct DeltaRunIter<'a> {
  cursor: Cursor<'a>,
  bounded: bool,
  limit: usize,
  remaining: u8,
  valueType: DeltaRunType,
}

impl<'a> Copy for DeltaRunIter<'a> {}

impl<'a> DeltaRunIter<'a> {
  fn readNextControl(self: &mut Self) -> bool {
    self.remaining = 0
    let control = match move Cursor<'a>.read<u8>(&mut self.cursor) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return false
      }
    }
    self.valueType = DeltaRunType.new(control)
    self.remaining = (control & 63) + 1
    return true
  }

  pub fn next(self: &mut Self) -> Option<i32> {
    if self.bounded {
      if self.limit == 0 {
        return Option<i32>.None
      }
      self.limit = self.limit - 1
    }
    if self.remaining == 0 && !DeltaRunIter.readNextControl(&mut self) {
      return Option<i32>.None
    }
    self.remaining = self.remaining - 1
    match self.valueType {
      DeltaRunType.Zero => {
        return Option<i32>.some(0)
      }
      DeltaRunType.I8 => {
        return match move Cursor<'a>.read<i8>(&mut self.cursor) {
          Result<i8, ReadError>.Success { value } => Option<i32>.some(i8.toI32(value))
          _ => Option<i32>.None
        }
      }
      DeltaRunType.I16 => {
        return match move Cursor<'a>.read<i16>(&mut self.cursor) {
          Result<i16, ReadError>.Success { value } => Option<i32>.some(i16.toI32(value))
          _ => Option<i32>.None
        }
      }
      DeltaRunType.I32 => {
        return match move Cursor<'a>.read<i32>(&mut self.cursor) {
          Result<i32, ReadError>.Success { value } => Option<i32>.some(value)
          _ => Option<i32>.None
        }
      }
    }
  }

  pub fn skipFast(self: Self, count: usize) -> Self {
    let mut result = self
    let mut wanted = count
    let mut remaining = u8.toUsize(result.remaining)
    let mut valueType = result.valueType
    while true {
      if wanted > remaining {
        Cursor.advanceBy(&mut result.cursor, remaining * DeltaRunType.byteSize(valueType))
        wanted = wanted - remaining
        if !DeltaRunIter.readNextControl(&mut result) {
          result.bounded = true
          result.limit = 0
          break
        }
        remaining = u8.toUsize(result.remaining)
        valueType = result.valueType
        continue
      }
      result.remaining = result.remaining - usize.toU8(wanted)
      Cursor.advanceBy(&mut result.cursor, wanted * DeltaRunType.byteSize(valueType))
      if result.bounded {
        result.limit = usize.saturatingSubtract(result.limit, count)
      }
      break
    }
    return result
  }

  pub fn end(self: Self) -> Cursor<'a> {
    let mut result = self
    if result.bounded {
      return DeltaRunIter.skipFast(result, result.limit).cursor
    }
    Cursor.advanceBy(
      &mut result.cursor,
      u8.toUsize(result.remaining) * DeltaRunType.byteSize(result.valueType),
    )
    result.remaining = 0
    while DeltaRunIter.readNextControl(&mut result) {
      Cursor.advanceBy(
        &mut result.cursor,
        u8.toUsize(result.remaining) * DeltaRunType.byteSize(result.valueType),
      )
      result.remaining = 0
    }
    return result.cursor
  }
}

pub struct PackedDeltaFetcher<'a> {
  data: FontData<'a>,
  pos: usize,
  runCount: usize,
  valueType: DeltaRunType,
  bounded: bool,
  remaining: usize,
}

impl<'a> PackedDeltaFetcher<'a> {
  fn ensureRun(self: &mut Self) -> Result<(), ReadError> {
    if self.runCount > 0 {
      return Result<(), ReadError>.succeed(())
    }
    let control = match move FontData<'a>.readAt<u8>(&self.data, self.pos) {
      Result<u8, ReadError>.Success { value } => value
      Result<u8, ReadError>.Failure { error } => {
        return Result<(), ReadError>.failResult(error)
      }
    }
    self.pos = self.pos + 1
    self.runCount = u8.toUsize(control & 63) + 1
    self.valueType = DeltaRunType.new(control)
    if self.runCount * DeltaRunType.byteSize(self.valueType) > FontData.len(&self.data) - self.pos {
      return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<(), ReadError>.succeed(())
  }

  pub fn skip(self: &mut Self, count: usize) -> Result<(), ReadError> {
    if self.bounded {
      if count > self.remaining {
        return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
      }
      self.remaining = self.remaining - count
    }
    let mut n = count
    while n > 0 {
      if let Result<(), ReadError>.Failure { error } = move PackedDeltaFetcher.ensureRun(
        &mut self,
      ) {
        return Result<(), ReadError>.failResult(error)
      }
      let mut take = n
      if take > self.runCount {
        take = self.runCount
      }
      self.pos = usize.saturatingAdd(self.pos, take * DeltaRunType.byteSize(self.valueType))
      self.runCount = self.runCount - take
      n = n - take
    }
    return Result<(), ReadError>.succeed(())
  }

  fn readDelta(self: &mut Self) -> Option<i32> {
    let mut cursor = FontData.cursor(&self.data)
    cursor.pos = self.pos
    self.pos = usize.saturatingAdd(self.pos, DeltaRunType.byteSize(self.valueType))
    match self.valueType {
      DeltaRunType.Zero => {
        return Option<i32>.some(0)
      }
      DeltaRunType.I8 => {
        return match move Cursor<'a>.read<i8>(&mut cursor) {
          Result<i8, ReadError>.Success { value } => Option<i32>.some(i8.toI32(value))
          _ => Option<i32>.None
        }
      }
      DeltaRunType.I16 => {
        return match move Cursor<'a>.read<i16>(&mut cursor) {
          Result<i16, ReadError>.Success { value } => Option<i32>.some(i16.toI32(value))
          _ => Option<i32>.None
        }
      }
      DeltaRunType.I32 => {
        return match move Cursor<'a>.read<i32>(&mut cursor) {
          Result<i32, ReadError>.Success { value } => Option<i32>.some(value)
          _ => Option<i32>.None
        }
      }
    }
  }

  pub fn addToF32Scaled(self: &mut Self, out: &mut [f32], scale: f32) -> Result<(), ReadError> {
    return fetchScaled<f32>(&mut self, &mut out, scale, i32.toF32)
  }

  pub fn addToF64Scaled(self: &mut Self, out: &mut [f64], scale: f64) -> Result<(), ReadError> {
    return fetchScaled<f64>(&mut self, &mut out, scale, i32.toF64)
  }
}

import silk.core.ops { Add, Multiply }

fn fetchScaled<'a, T: Copy + Add<T, T> + Multiply<T, T>>(
  fetcher: &mut PackedDeltaFetcher<'a>,
  out: &mut [T],
  scale: T,
  convert: fn(i32) -> T,
) -> Result<(), ReadError> {
  if fetcher.bounded {
    if out.length > fetcher.remaining {
      return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
    }
    fetcher.remaining = fetcher.remaining - out.length
  }
  let mut i: usize = 0
  while i < out.length {
    if let Result<(), ReadError>.Failure { error } = move PackedDeltaFetcher.ensureRun(
      &mut fetcher,
    ) {
      return Result<(), ReadError>.failResult(error)
    }
    let mut take = out.length - i
    if take > fetcher.runCount {
      take = fetcher.runCount
    }
    let end = i + take
    while i < end {
      if fetcher.valueType != DeltaRunType.Zero {
        let delta = match move PackedDeltaFetcher.readDelta(&mut fetcher) {
          Option<i32>.Some { value } => value
          _ => {
            return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
          }
        }
        out[i] = out[i] + convert(delta) * scale
      }
      i = i + 1
    }
    fetcher.runCount = fetcher.runCount - take
  }
  return Result<(), ReadError>.succeed(())
}

// Handwritten extension from font/parse/src/tables/variations_tuple.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
impl<'a> Tuple<'a> {
  pub fn len(self: &Self) -> usize {
    return ScalarArray<F2Dot14>.len(&Tuple.values(self))
  }

  pub fn isEmpty(self: &Self) -> bool {
    return Tuple.len(self) == 0
  }

  pub fn get(self: &Self, index: usize) -> Option<F2Dot14> {
    return ScalarArray<F2Dot14>.get(&Tuple.values(self), index)
  }
}

pub struct IntermediateTuples<'a> {
  pub start: Tuple<'a>,
  pub end: Tuple<'a>,
}

impl<'a> Copy for IntermediateTuples<'a> {}

impl<'a> TupleVariationHeader<'a> {
  fn tupleAt(self: &Self, range: ByteRange) -> Option<Tuple<'a>> {
    return match move Tuple<'a>.readAt(self._fontData, range.start, self._axisCount) {
      Result<Tuple<'a>, ReadError>.Success { value } => Option<Tuple<'a>>.some(value)
      _ => Option<Tuple<'a>>.None
    }
  }

  pub fn peakTuple(self: &Self) -> Option<Tuple<'a>> {
    if !TupleIndex.embeddedPeakTuple(TupleVariationHeader.tupleIndex(self)) {
      return Option<Tuple<'a>>.None
    }
    return TupleVariationHeader.tupleAt(self, TupleVariationHeader.peakTupleByteRange(self))
  }

  pub fn intermediateStartTuple(self: &Self) -> Option<Tuple<'a>> {
    if !TupleIndex.intermediateRegion(TupleVariationHeader.tupleIndex(self)) {
      return Option<Tuple<'a>>.None
    }
    return TupleVariationHeader.tupleAt(
      self,
      TupleVariationHeader.intermediateStartTupleByteRange(self),
    )
  }

  pub fn intermediateEndTuple(self: &Self) -> Option<Tuple<'a>> {
    if !TupleIndex.intermediateRegion(TupleVariationHeader.tupleIndex(self)) {
      return Option<Tuple<'a>>.None
    }
    return TupleVariationHeader.tupleAt(
      self,
      TupleVariationHeader.intermediateEndTupleByteRange(self),
    )
  }

  pub fn intermediateTuples(self: &Self) -> Option<IntermediateTuples<'a>> {
    let start = match move TupleVariationHeader.intermediateStartTuple(self) {
      Option<Tuple<'a>>.Some { value } => value
      _ => {
        return Option<IntermediateTuples<'a>>.None
      }
    }
    let end = match move TupleVariationHeader.intermediateEndTuple(self) {
      Option<Tuple<'a>>.Some { value } => value
      _ => {
        return Option<IntermediateTuples<'a>>.None
      }
    }
    return Option<IntermediateTuples<'a>>.some(IntermediateTuples<'a> { start: start, end: end })
  }

  pub fn byteLen(self: &Self, axisCount: u16) -> usize {
    let index = TupleVariationHeader.tupleIndex(self)
    return 4 + TupleIndex.tupleLen(index, axisCount, 0) * 2
      + TupleIndex.tupleLen(index, axisCount, 1) * 4
  }
}

pub struct TupleVariationHeaderIter<'a> {
  data: FontData<'a>,
  count: usize,
  current: usize,
  axisCount: u16,
}

impl<'a> Copy for TupleVariationHeaderIter<'a> {}

impl<'a> TupleVariationHeaderIter<'a> {
  pub fn new(data: FontData<'a>, count: usize, axisCount: u16) -> Self {
    return Self { data: data, count: count, current: 0, axisCount: axisCount }
  }

  pub fn next(self: &mut Self) -> Option<Result<TupleVariationHeader<'a>, ReadError>> {
    if self.current == self.count {
      return Option<Result<TupleVariationHeader<'a>, ReadError>>.None
    }
    self.current = self.current + 1
    let result = TupleVariationHeader.read(self.data, self.axisCount)
    let length = match &result {
      Result<TupleVariationHeader<'a>, ReadError>.Success { value } => TupleVariationHeader.byteLen(
        &value,
        self.axisCount,
      )
      _ => 0
    }
    self.data = match move FontData.splitOff(&self.data, length) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<Result<TupleVariationHeader<'a>, ReadError>>.None
      }
    }
    return Option<Result<TupleVariationHeader<'a>, ReadError>>.some(move result)
  }
}

pub fn notComputed() -> Fixed {
  return Fixed.max()
}

pub fn scalarFor<'a>(
  peak: &Tuple<'a>,
  intermediate: Option<IntermediateTuples<'a>>,
  coords: &[F2Dot14],
) -> Option<Fixed> {
  let mut scalar = Fixed.one()
  let mut i: usize = 0
  while i < Tuple.len(peak) {
    let peakValue = F2Dot14.toBits(Tuple.get(peak, i) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero()))
    let mut coord: i16 = 0
    if i < coords.length {
      coord = F2Dot14.toBits(coords[i])
    }
    let index = i
    i = i + 1
    if peakValue == 0 {
      continue
    }
    if coord == 0 {
      return Option<Fixed>.None
    }
    if peakValue == coord {
      continue
    }
    let point = F2Dot14.toFixed(F2Dot14.fromBits(coord))
    let peakFixed = F2Dot14.toFixed(F2Dot14.fromBits(peakValue))
    match &intermediate {
      Option<IntermediateTuples<'a>>.Some { value } => {
        let start = F2Dot14.toBits(
          Tuple.get(&value.start, index) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero()),
        )
        let end = F2Dot14.toBits(
          Tuple.get(&value.end, index) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero()),
        )
        if start > peakValue || peakValue > end || (start < 0 && end > 0) {
          continue
        }
        if coord <= start || coord >= end {
          return Option<Fixed>.None
        }
        if coord < peakValue {
          let first = F2Dot14.toFixed(F2Dot14.fromBits(start))
          scalar = Fixed.mulDiv(&scalar, point - first, peakFixed - first)
        } else {
          let last = F2Dot14.toFixed(F2Dot14.fromBits(end))
          scalar = Fixed.mulDiv(&scalar, last - point, last - peakFixed)
        }
      }
      Option<IntermediateTuples<'a>>.None => {
        let mut minimum: i16 = 0
        let mut maximum: i16 = 0
        if peakValue < 0 {
          minimum = peakValue
        } else {
          maximum = peakValue
        }
        if coord < minimum || coord > maximum {
          return Option<Fixed>.None
        }
        scalar = Fixed.mulDiv(&scalar, point, peakFixed)
      }
    }
  }
  if Fixed.toBits(scalar) == 0 {
    return Option<Fixed>.None
  }
  return Option<Fixed>.some(scalar)
}

pub interface TupleDelta {
  fn isPoint() -> bool

  fn new(position: u16, x: i32, y: i32) -> Self
}

pub struct TupleVariationData<'a, T> {
  axisCount: u16,
  sharedTuples: ComputedArray<'a, u16, Tuple<'a>>,
  hasSharedTuples: bool,
  sharedPoints: PackedPointNumbers<'a>,
  hasSharedPoints: bool,
  count: TupleVariationCount,
  headers: FontData<'a>,
  serialized: FontData<'a>,
}

impl<'a, T> Copy for TupleVariationData<'a, T> {}

impl<'a, T> TupleVariationData<'a, T> {
  pub fn new(
    axisCount: u16,
    sharedTuples: Option<ComputedArray<'a, u16, Tuple<'a>>>,
    sharedPoints: Option<PackedPointNumbers<'a>>,
    count: TupleVariationCount,
    headers: FontData<'a>,
    serialized: FontData<'a>,
  ) -> Self {
    let mut tuples = ComputedArray<'a, u16, Tuple<'a>>.empty(axisCount)
    let mut hasTuples = false
    if let Option<ComputedArray<'a, u16, Tuple<'a>>>.Some { value } = move sharedTuples {
      tuples = value
      hasTuples = true
    }
    let mut points = PackedPointNumbers.default()
    let mut hasPoints = false
    if let Option<PackedPointNumbers<'a>>.Some { value } = move sharedPoints {
      points = value
      hasPoints = true
    }
    return Self {
      axisCount: axisCount,
      sharedTuples: tuples,
      hasSharedTuples: hasTuples,
      sharedPoints: points,
      hasSharedPoints: hasPoints,
      count: count,
      headers: headers,
      serialized: serialized,
    }
  }

  pub fn tupleCount(self: &Self) -> usize {
    return u16.toUsize(TupleVariationCount.count(self.count))
  }

  pub fn tuples(self: &Self) -> TupleVariationIter<'a, T> {
    return TupleVariationIter<'a, T> {
      current: 0,
      parent: self.*,
      headers: TupleVariationHeaderIter.new(
        self.headers,
        TupleVariationData<'a, T>.tupleCount(self),
        self.axisCount,
      ),
      serialized: self.serialized,
    }
  }

  pub fn activeTuplesAt<'b>(self: &Self, coords: &'b [F2Dot14]) -> ActiveTupleVariationIter<
    'a,
    'b,
    T
  > {
    return ActiveTupleVariationIter<'a, 'b, T> {
      coords: coords,
      scalars: Option<&'b [Fixed]>.None,
      parent: self.*,
      headers: TupleVariationHeaderIter.new(
        self.headers,
        TupleVariationData<'a, T>.tupleCount(self),
        self.axisCount,
      ),
      offset: 0,
    }
  }

  pub fn activeTuplesAtWithScalars<'b>(
    self: &Self,
    coords: &'b [F2Dot14],
    scalars: &'b [Fixed],
  ) -> ActiveTupleVariationIter<'a, 'b, T> {
    return ActiveTupleVariationIter<'a, 'b, T> {
      coords: coords,
      scalars: Option<&'b [Fixed]>.some(scalars),
      parent: self.*,
      headers: TupleVariationHeaderIter.new(
        self.headers,
        TupleVariationData<'a, T>.tupleCount(self),
        self.axisCount,
      ),
      offset: 0,
    }
  }

  fn variation(
    self: &Self,
    header: TupleVariationHeader<'a>,
    serialized: FontData<'a>,
  ) -> TupleVariation<'a, T> {
    return TupleVariation<'a, T> {
      axisCount: self.axisCount,
      header: header,
      sharedTuples: self.sharedTuples,
      hasSharedTuples: self.hasSharedTuples,
      sharedPoints: self.sharedPoints,
      hasSharedPoints: self.hasSharedPoints,
      serialized: serialized,
    }
  }
}

pub struct TupleVariationIter<'a, T> {
  current: usize,
  parent: TupleVariationData<'a, T>,
  headers: TupleVariationHeaderIter<'a>,
  serialized: FontData<'a>,
}

impl<'a, T> Copy for TupleVariationIter<'a, T> {}

impl<'a, T> TupleVariationIter<'a, T> {
  pub fn next(self: &mut Self) -> Option<TupleVariation<'a, T>> {
    if self.current == TupleVariationData<'a, T>.tupleCount(&self.parent) {
      return Option<TupleVariation<'a, T>>.None
    }
    self.current = self.current + 1
    let result = match move TupleVariationHeaderIter.next(&mut self.headers) {
      Option<Result<TupleVariationHeader<'a>, ReadError>>.Some { value } => move value
      _ => {
        return Option<TupleVariation<'a, T>>.None
      }
    }
    let header = match move result {
      Result<TupleVariationHeader<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<TupleVariation<'a, T>>.None
      }
    }
    let data = match move FontData.takeUpTo(
      &mut self.serialized,
      u16.toUsize(TupleVariationHeader.variationDataSize(&header)),
    ) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<TupleVariation<'a, T>>.None
      }
    }
    return Option<TupleVariation<'a, T>>.some(
      TupleVariationData<'a, T>.variation(&self.parent, header, data),
    )
  }
}

pub struct ActiveTupleVariation<'a, T> {
  pub variation: TupleVariation<'a, T>,
  pub scalar: Fixed,
}

impl<'a, T> Copy for ActiveTupleVariation<'a, T> {}

pub struct ActiveTupleVariationIter<'a, 'b, T> {
  coords: &'b [F2Dot14],
  scalars: Option<&'b [Fixed]>,
  parent: TupleVariationData<'a, T>,
  headers: TupleVariationHeaderIter<'a>,
  offset: usize,
}

impl<'a, 'b, T> ActiveTupleVariationIter<'a, 'b, T> {
  pub fn next(self: &mut Self) -> Option<ActiveTupleVariation<'a, T>> {
    while true {
      let result = match move TupleVariationHeaderIter.next(&mut self.headers) {
        Option<Result<TupleVariationHeader<'a>, ReadError>>.Some { value } => move value
        _ => {
          return Option<ActiveTupleVariation<'a, T>>.None
        }
      }
      let header = match move result {
        Result<TupleVariationHeader<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<ActiveTupleVariation<'a, T>>.None
        }
      }
      let start = self.offset
      self.offset = match move usize.checkedAdd(
        start,
        u16.toUsize(TupleVariationHeader.variationDataSize(&header)),
      ) {
        Option<usize>.Some { value } => value
        _ => {
          return Option<ActiveTupleVariation<'a, T>>.None
        }
      }
      let scalar = match &self.scalars {
        Option<&'b [Fixed]>.Some { value } => tupleScalar(
          &header,
          self.parent.axisCount,
          self.parent.hasSharedTuples,
          &self.parent.sharedTuples,
          self.coords,
          value,
        )
        Option<&'b [Fixed]>.None => tupleScalar(
          &header,
          self.parent.axisCount,
          self.parent.hasSharedTuples,
          &self.parent.sharedTuples,
          self.coords,
          &[],
        )
      }
      if let Option<Fixed>.Some { value } = move scalar {
        let data = match move FontData.slice(&self.parent.serialized, start, self.offset) {
          Option<FontData<'a>>.Some { value: bytes } => bytes
          _ => {
            return Option<ActiveTupleVariation<'a, T>>.None
          }
        }
        return Option<ActiveTupleVariation<'a, T>>.some(
          ActiveTupleVariation<'a, T> {
            variation: TupleVariationData<'a, T>.variation(&self.parent, header, data),
            scalar: value,
          },
        )
      }
    }
  }
}

pub struct TupleVariation<'a, T> {
  axisCount: u16,
  header: TupleVariationHeader<'a>,
  sharedTuples: ComputedArray<'a, u16, Tuple<'a>>,
  hasSharedTuples: bool,
  sharedPoints: PackedPointNumbers<'a>,
  hasSharedPoints: bool,
  serialized: FontData<'a>,
}

impl<'a, T> Copy for TupleVariation<'a, T> {}

impl<'a, T> TupleVariation<'a, T> {
  pub fn hasDeltasForAllPoints(self: &Self) -> bool {
    if TupleIndex.privatePointNumbers(TupleVariationHeader.tupleIndex(&self.header)) {
      return PackedPointNumbers.count(&PackedPointNumbers<'a> { data: self.serialized }) == 0
    }
    return self.hasSharedPoints && PackedPointNumbers.count(&self.sharedPoints) == 0
  }

  fn pointNumbersAndPackedDeltas(self: &Self) -> PackedPointSplit<'a> {
    if TupleIndex.privatePointNumbers(TupleVariationHeader.tupleIndex(&self.header)) {
      return PackedPointNumbers.splitOffFront(self.serialized)
    }
    return PackedPointSplit<'a> { points: self.sharedPoints, remainder: self.serialized }
  }

  pub fn pointNumbers(self: &Self) -> PackedPointNumbersIter<'a> {
    return PackedPointNumbers.iter(&TupleVariation<'a, T>.pointNumbersAndPackedDeltas(self).points)
  }

  pub fn peak(self: &Self) -> Tuple<'a> {
    if self.hasSharedTuples {
      if let Option<u16>.Some { value: index } = move TupleIndex.tupleRecordsIndex(
        TupleVariationHeader.tupleIndex(&self.header),
      ) {
        if let Result<Tuple<'a>, ReadError>.Success { value } = move ComputedArray<
          'a,
          u16,
          Tuple<'a>
        >.get(&self.sharedTuples, u16.toUsize(index)) {
          return value
        }
      }
    }
    return TupleVariationHeader.peakTuple(&self.header)
      |> Option<Tuple<'a>>.unwrapOr(Tuple.default())
  }

  pub fn intermediateStart(self: &Self) -> Option<Tuple<'a>> {
    return TupleVariationHeader.intermediateStartTuple(&self.header)
  }

  pub fn intermediateEnd(self: &Self) -> Option<Tuple<'a>> {
    return TupleVariationHeader.intermediateEndTuple(&self.header)
  }

  pub fn computeScalar(self: &Self, coords: &[F2Dot14]) -> Option<Fixed> {
    return tupleScalar(
      &self.header,
      self.axisCount,
      self.hasSharedTuples,
      &self.sharedTuples,
      coords,
      &[],
    )
  }

  pub fn computeScalarF32(self: &Self, coords: &[F2Dot14]) -> Option<f32> {
    let peak = TupleVariation<'a, T>.peak(self)
    if Tuple.len(&peak) != u16.toUsize(self.axisCount) {
      return Option<f32>.None
    }
    let intermediate = TupleVariationHeader.intermediateTuples(&self.header)
    let mut scalar: f32 = 1.0
    let mut i: usize = 0
    while i < u16.toUsize(self.axisCount) {
      let index = i
      i = i + 1
      let mut coord: i32 = 0
      if index < coords.length {
        coord = i16.toI32(F2Dot14.toBits(coords[index]))
      }
      let p = i16.toI32(
        F2Dot14.toBits(Tuple.get(&peak, index) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero())),
      )
      if p == 0 || p == coord {
        continue
      }
      if coord == 0 {
        return Option<f32>.None
      }
      match &intermediate {
        Option<IntermediateTuples<'a>>.Some { value } => {
          let start = i16.toI32(
            F2Dot14.toBits(
              Tuple.get(&value.start, index) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero()),
            ),
          )
          let end = i16.toI32(
            F2Dot14.toBits(
              Tuple.get(&value.end, index) |> Option<F2Dot14>.unwrapOr(F2Dot14.zero()),
            ),
          )
          if start > p || p > end || (start < 0 && end > 0) {
            continue
          }
          if coord < start || coord > end {
            return Option<f32>.None
          }
          if coord < p {
            if p != start {
              scalar = scalar * (i32.toF32(coord - start) / i32.toF32(p - start))
            }
          } else {
            if p != end {
              scalar = scalar * (i32.toF32(end - coord) / i32.toF32(end - p))
            }
          }
        }
        Option<IntermediateTuples<'a>>.None => {
          let mut minimum: i32 = 0
          let mut maximum: i32 = 0
          if p < 0 {
            minimum = p
          } else {
            maximum = p
          }
          if coord < minimum || coord > maximum {
            return Option<f32>.None
          }
          scalar = scalar * (i32.toF32(coord) / i32.toF32(p))
        }
      }
    }
    return Option<f32>.some(scalar)
  }

  pub fn deltas<T: TupleDelta>(self: &Self) -> TupleDeltaIter<'a, T> {
    let split = TupleVariation<'a, T>.pointNumbersAndPackedDeltas(self)
    let count = u16.toUsize(PackedPointNumbers.count(&split.points))
    let mut deltas = PackedDeltas.consumeAll(split.remainder)
    if count != 0 {
      let mut length = count
      if TupleDelta.isPoint() {
        length = length * 2
      }
      deltas = PackedDeltas.new(split.remainder, length)
    }
    return TupleDeltaIter<'a, T>.new(split.points, deltas)
  }
}

fn tupleScalar<'a>(
  header: &TupleVariationHeader<'a>,
  axisCount: u16,
  hasShared: bool,
  shared: &ComputedArray<'a, u16, Tuple<'a>>,
  coords: &[F2Dot14],
  scalars: &[Fixed],
) -> Option<Fixed> {
  let intermediate = TupleVariationHeader.intermediateTuples(header)
  let mut peak = Tuple.default()
  if let Option<u16>.Some { value: index } = move TupleIndex.tupleRecordsIndex(
    TupleVariationHeader.tupleIndex(header),
  ) {
    if let Option<IntermediateTuples<'a>>.None = &intermediate {
      if u16.toUsize(index) < scalars.length {
        let cached = scalars[u16.toUsize(index)]
        if Fixed.toBits(cached) != Fixed.toBits(notComputed()) {
          if Fixed.toBits(cached) == 0 {
            return Option<Fixed>.None
          }
          return Option<Fixed>.some(cached)
        }
      }
    }
    if !hasShared {
      return Option<Fixed>.None
    }
    peak = match move ComputedArray<'a, u16, Tuple<'a>>.get(shared, u16.toUsize(index)) {
      Result<Tuple<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<Fixed>.None
      }
    }
  } else {
    peak = match move TupleVariationHeader.peakTuple(header) {
      Option<Tuple<'a>>.Some { value } => value
      _ => {
        return Option<Fixed>.None
      }
    }
  }
  if Tuple.len(&peak) != u16.toUsize(axisCount) {
    return Option<Fixed>.None
  }
  return scalarFor(&peak, move intermediate, coords)
}

pub struct TupleDeltaIter<'a, T> {
  pub cur: usize,
  points: PackedPointNumbersIter<'a>,
  hasPoints: bool,
  nextPoint: usize,
  x: DeltaRunIter<'a>,
  y: DeltaRunIter<'a>,
}

impl<'a, T> Copy for TupleDeltaIter<'a, T> {}

impl<'a, T> TupleDeltaIter<'a, T> {
  pub fn new<T: TupleDelta>(points: PackedPointNumbers<'a>, deltas: PackedDeltas<'a>) -> Self {
    let mut iter = PackedPointNumbers.iter(&points)
    let first = PackedPointNumbersIter.next(&mut iter)
    let mut hasPoints = false
    let mut nextPoint: usize = 0
    if let Option<u16>.Some { value } = move first {
      hasPoints = true
      nextPoint = u16.toUsize(value)
    }
    let mut x = PackedDeltas.iter(&deltas)
    let mut y = PackedDeltas.iter(&deltas)
    if TupleDelta.isPoint() {
      x = PackedDeltas.xDeltas(&deltas)
      y = PackedDeltas.yDeltas(&deltas)
    }
    return Self { cur: 0, points: iter, hasPoints: hasPoints, nextPoint: nextPoint, x: x, y: y }
  }

  pub fn next<T: TupleDelta>(self: &mut Self) -> Option<T> {
    while true {
      let mut position = self.cur
      if self.hasPoints {
        if self.cur > self.nextPoint {
          self.nextPoint = match move PackedPointNumbersIter.next(&mut self.points) {
            Option<u16>.Some { value } => u16.toUsize(value)
            _ => {
              return Option<T>.None
            }
          }
        }
        position = self.nextPoint
      }
      if position == self.cur {
        let dx = match move DeltaRunIter.next(&mut self.x) {
          Option<i32>.Some { value } => value
          _ => {
            return Option<T>.None
          }
        }
        let mut dy: i32 = 0
        if TupleDelta.isPoint() {
          dy = match move DeltaRunIter.next(&mut self.y) {
            Option<i32>.Some { value } => value
            _ => {
              return Option<T>.None
            }
          }
        }
        self.cur = match move usize.checkedAdd(self.cur, 1) {
          Option<usize>.Some { value } => value
          _ => {
            return Option<T>.None
          }
        }
        return Option<T>.some(TupleDelta.new(usize.toU16(position & 65535), dx, dy))
      }
      self.cur = match move usize.checkedAdd(self.cur, 1) {
        Option<usize>.Some { value } => value
        _ => {
          return Option<T>.None
        }
      }
    }
  }
}

import tables.gvar { GlyphDelta }
import tables.glyf { PointCoord, PointFlags, PointMarker, coordFromI32, coordFromFixed }
import silk.geometry.point { Point2 }
import silk.geometry.vector { Vector2 }

impl<'a, T> TupleVariation<'a, T> {
  pub fn accumulateDenseDeltas<D: PointCoord + Copy + Add<D, D>>(
    self: &TupleVariation<'a, GlyphDelta>,
    deltas: &mut [Vector2<D>],
    scalar: Fixed,
  ) -> Result<(), ReadError> {
    let mut cursor = FontData.cursor(
      &TupleVariation<'a, GlyphDelta>.pointNumbersAndPackedDeltas(self).remainder,
    )
    let mut axis: usize = 0
    while axis < 2 {
      let mut cur: usize = 0
      while cur < deltas.length {
        let control = match move Cursor<'a>.read<u8>(&mut cursor) {
          Result<u8, ReadError>.Success { value } => value
          Result<u8, ReadError>.Failure { error } => {
            return Result<(), ReadError>.failResult(error)
          }
        }
        let count = u8.toUsize(control & 63) + 1
        if count > deltas.length - cur {
          return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
        }
        let kind = DeltaRunType.new(control)
        let bytes = match move Cursor<'a>.readArray<u8>(
          &mut cursor,
          count * DeltaRunType.byteSize(kind),
        ) {
          Result<ScalarArray<'a, u8>, ReadError>.Success { value } => ScalarArray<u8>.offsetData(
            &value,
          )
          Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => {
            return Result<(), ReadError>.failResult(error)
          }
        }
        let mut i: usize = 0
        while i < count {
          if kind != DeltaRunType.Zero {
            let raw = deltaRunValue(bytes, kind, i)
            let mut value = coordFromI32<D>(raw)
            if Fixed.toBits(scalar) != 65536 {
              value = coordFromFixed<D>(Fixed.fromI32(raw) * scalar)
            }
            if axis == 0 {
              deltas[cur + i].x = deltas[cur + i].x + value
            } else {
              deltas[cur + i].y = deltas[cur + i].y + value
            }
          }
          i = i + 1
        }
        cur = cur + count
      }
      axis = axis + 1
    }
    return Result<(), ReadError>.succeed(())
  }

  pub fn accumulateSparseDeltas<D: PointCoord + Copy + Add<D, D>>(
    self: &TupleVariation<'a, GlyphDelta>,
    deltas: &mut [Vector2<D>],
    flags: &mut [PointFlags],
    scalar: Fixed,
  ) -> Result<(), ReadError> {
    let split = TupleVariation<'a, GlyphDelta>.pointNumbersAndPackedDeltas(self)
    let mut cursor = FontData.cursor(&split.remainder)
    let count = u16.toUsize(PackedPointNumbers.count(&split.points))
    let mut axis: usize = 0
    while axis < 2 {
      let mut cur: usize = 0
      let mut points = PackedPointNumbers.iter(&split.points)
      while cur < count {
        let control = match move Cursor<'a>.read<u8>(&mut cursor) {
          Result<u8, ReadError>.Success { value } => value
          Result<u8, ReadError>.Failure { error } => {
            return Result<(), ReadError>.failResult(error)
          }
        }
        let length = u8.toUsize(control & 63) + 1
        let kind = DeltaRunType.new(control)
        let bytes = match move Cursor<'a>.readArray<u8>(
          &mut cursor,
          length * DeltaRunType.byteSize(kind),
        ) {
          Result<ScalarArray<'a, u8>, ReadError>.Success { value } => ScalarArray<u8>.offsetData(
            &value,
          )
          Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => {
            return Result<(), ReadError>.failResult(error)
          }
        }
        let mut i: usize = 0
        while i < length {
          let index = match move PackedPointNumbersIter.next(&mut points) {
            Option<u16>.Some { value } => u16.toUsize(value)
            _ => {
              if kind == DeltaRunType.Zero {
                return Result<(), ReadError>.failResult(ReadError.OutOfBounds)
              }
              break
            }
          }
          if index < deltas.length {
            let raw = deltaRunValue(bytes, kind, i)
            let mut value = coordFromI32<D>(raw)
            if Fixed.toBits(scalar) != 65536 {
              value = coordFromFixed<D>(Fixed.fromI32(raw) * scalar)
            }
            if axis == 0 {
              if index < flags.length {
                deltas[index].x = deltas[index].x + value
                PointFlags.setMarker(&mut flags[index], PointMarker.hasDelta())
              }
            } else {
              deltas[index].y = deltas[index].y + value
            }
          }
          i = i + 1
        }
        cur = cur + length
      }
      axis = axis + 1
    }
    return Result<(), ReadError>.succeed(())
  }
}

fn deltaRunValue<'a>(bytes: FontData<'a>, kind: DeltaRunType, index: usize) -> i32 {
  return match kind {
    DeltaRunType.Zero => 0
    DeltaRunType.I8 => i8.toI32(scalarOr<i8>(bytes, index, 0))
    DeltaRunType.I16 => i16.toI32(scalarOr<i16>(bytes, index * 2, 0))
    DeltaRunType.I32 => scalarOr<i32>(bytes, index * 4, 0)
  }
}

// Handwritten extension from font/parse/src/tables/variations_glyph_deltas.silk
// Copyright 2026 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import tables.glyf { PointFrom, convertPointCoord, coordLessEqual, coordGreaterEqual, coordGreater }
import silk.core.ops { Divide }

pub struct DeltaBuffers<'a, D> {
  pub deltas: &'a mut [Vector2<D>],
  pub iup: &'a mut [Vector2<D>],
}

pub fn checkSimpleBuffers<C, D>(
  points: &[Point2<C>],
  flags: &[PointFlags],
  buffers: &DeltaBuffers<D>,
) -> bool {
  return points.length >= 4 && flags.length >= points.length
    && buffers.deltas.length >= points.length
    && buffers.iup.length >= points.length
}

pub fn zeroDeltas<D: PointCoord + Copy>(deltas: &mut [Vector2<D>]) -> () {
  let zero = coordFromI32<D>(0)
  let mut i: usize = 0
  while i < deltas.length {
    deltas[i] = Vector2<D> { x: zero, y: zero }
    i = i + 1
  }
}

pub fn interpolateDeltas<
  C: PointCoord + Copy,
  D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
    D,
    D
  > + Equal
>(points: &[Point2<C>], flags: &[PointFlags], contours: &[u16], out: &mut [Vector2<D>]) -> Option<
  ()
> {
  let mut start: usize = 0
  let mut ci: usize = 0
  while ci < contours.length {
    let end = u16.toUsize(contours[ci])
    ci = ci + 1
    if end < start {
      continue
    }
    let after = end + 1
    if after > points.length || after > flags.length || after > out.length {
      return Option<()>.None
    }
    let mut first = after
    let mut i = start
    while i < after {
      if PointFlags.hasMarker(flags[i], PointMarker.hasDelta()) {
        first = i
        break
      }
      i = i + 1
    }
    if first != after {
      let mut last = first
      i = first + 1
      while i < after {
        if PointFlags.hasMarker(flags[i], PointMarker.hasDelta()) {
          interpolateRange<C, D>(points, &mut out, last + 1, i, last, i)
          last = i
        }
        i = i + 1
      }
      if last == first {
        let dx = out[first].x - convertPointCoord<C, D>(points[first].x)
        let dy = out[first].y - convertPointCoord<C, D>(points[first].y)
        let zero = coordFromI32<D>(0)
        if &dx != &zero || &dy != &zero {
          i = start
          while i < after {
            if i != first {
              out[i].x = out[i].x + dx
              out[i].y = out[i].y + dy
            }
            i = i + 1
          }
        }
      } else {
        interpolateRange<C, D>(points, &mut out, last + 1, after, last, first)
        interpolateRange<C, D>(points, &mut out, start, first, last, first)
      }
    }
    start = after
  }
  return Option<()>.some(())
}

fn interpolateRange<
  C: PointCoord + Copy,
  D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
    D,
    D
  > + Equal
>(
  points: &[Point2<C>],
  out: &mut [Vector2<D>],
  start: usize,
  end: usize,
  ref1: usize,
  ref2: usize,
) -> () {
  if start >= end {
    return
  }
  let mut axis: usize = 0
  while axis < 2 {
    let mut p1 = points[ref1].x
    let mut p2 = points[ref2].x
    if axis == 1 {
      p1 = points[ref1].y
      p2 = points[ref2].y
    }
    let mut lo = ref1
    let mut hi = ref2
    if coordGreater<C>(p1, p2) {
      lo = ref2
      hi = ref1
    }
    let mut first = points[lo].x
    let mut last = points[hi].x
    let mut out1 = out[lo].x
    let mut out2 = out[hi].x
    if axis == 1 {
      first = points[lo].y
      last = points[hi].y
      out1 = out[lo].y
      out2 = out[hi].y
    }
    let in1 = convertPointCoord<C, D>(first)
    let in2 = convertPointCoord<C, D>(last)
    if &in1 != &in2 || &out1 == &out2 {
      let mut scale = coordFromI32<D>(0)
      if &in1 != &in2 {
        scale = (out2 - out1) / (in2 - in1)
      }
      let d1 = out1 - in1
      let d2 = out2 - in2
      let mut i = start
      while i < end {
        let mut original = points[i].x
        if axis == 1 {
          original = points[i].y
        }
        let coord = convertPointCoord<C, D>(original)
        let mut value = coord
        if coordLessEqual<D>(coord, in1) {
          value = coord + d1
        } else {
          if coordGreaterEqual<D>(coord, in2) {
            value = coord + d2
          } else {
            value = out1 + (coord - in1) * scale
          }
        }
        if axis == 0 {
          out[i].x = value
        } else {
          out[i].y = value
        }
        i = i + 1
      }
    }
    axis = axis + 1
  }
}

impl<'a, T> TupleVariationData<'a, T> {
  pub fn simpleDeltas<
    C: PointCoord + Copy,
    D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
      D,
      D
    > + Equal
  >(
    self: &TupleVariationData<'a, GlyphDelta>,
    coords: &[F2Dot14],
    points: &[Point2<C>],
    flags: &mut [PointFlags],
    contours: &[u16],
    buffers: &mut DeltaBuffers<D>,
  ) -> Option<()> {
    return TupleVariationData<'a, GlyphDelta>.simpleDeltasWithScalars<C, D>(
      self,
      coords,
      &[],
      points,
      move flags,
      contours,
      move buffers,
    )
  }

  pub fn simpleDeltasWithScalars<
    'b,
    C: PointCoord + Copy,
    D: PointCoord + Copy + PointFrom<C> + Add<D, D> + Subtract<D, D> + Multiply<D, D> + Divide<
      D,
      D
    > + Equal
  >(
    self: &TupleVariationData<'a, GlyphDelta>,
    coords: &'b [F2Dot14],
    scalars: &'b [Fixed],
    points: &[Point2<C>],
    flags: &mut [PointFlags],
    contours: &[u16],
    buffers: &mut DeltaBuffers<D>,
  ) -> Option<()> {
    if !checkSimpleBuffers<C, D>(points, &flags, &buffers) {
      return Option<()>.None
    }
    zeroDeltas<D>(&mut buffers.deltas)
    let mut active = TupleVariationData<'a, GlyphDelta>.activeTuplesAtWithScalars(
      self,
      coords,
      scalars,
    )
    while let Option<ActiveTupleVariation<'a, GlyphDelta>>.Some {
      value
    } = move ActiveTupleVariationIter<'a, 'b, GlyphDelta>.next(&mut active) {
      if TupleVariation<'a, GlyphDelta>.hasDeltasForAllPoints(&value.variation) {
        if let Result<(), ReadError>.Failure { error } = move TupleVariation<
          'a,
          GlyphDelta
        >.accumulateDenseDeltas<D>(&value.variation, &mut buffers.deltas, value.scalar) {
          return Option<()>.None
        }
      } else {
        let mut i: usize = 0
        while i < points.length {
          buffers.iup[i] = Vector2<D> {
            x: convertPointCoord<C, D>(points[i].x),
            y: convertPointCoord<C, D>(points[i].y),
          }
          i = i + 1
        }
        i = 0
        while i < flags.length {
          PointFlags.clearMarker(&mut flags[i], PointMarker.hasDelta())
          i = i + 1
        }
        if let Result<(), ReadError>.Failure { error } = move TupleVariation<
          'a,
          GlyphDelta
        >.accumulateSparseDeltas<D>(&value.variation, &mut buffers.iup, &mut flags, value.scalar) {
          return Option<()>.None
        }
        if let Option<()>.None = move interpolateDeltas<C, D>(
          points,
          &flags,
          contours,
          &mut buffers.iup,
        ) {
          return Option<()>.None
        }
        i = 0
        while i < points.length {
          buffers.deltas[i].x = buffers.deltas[i].x
            + (buffers.iup[i].x - convertPointCoord<C, D>(points[i].x))
          buffers.deltas[i].y = buffers.deltas[i].y
            + (buffers.iup[i].y - convertPointCoord<C, D>(points[i].y))
          i = i + 1
        }
      }
    }
    return Option<()>.some(())
  }

  pub fn compositeDeltas<D: PointCoord + Copy + Add<D, D> + Multiply<D, D>>(
    self: &TupleVariationData<'a, GlyphDelta>,
    coords: &[F2Dot14],
    deltas: &mut [Vector2<D>],
  ) -> Option<()> {
    return TupleVariationData<'a, GlyphDelta>.compositeDeltasWithScalars<D>(
      self,
      coords,
      &[],
      move deltas,
    )
  }

  pub fn compositeDeltasWithScalars<'b, D: PointCoord + Copy + Add<D, D> + Multiply<D, D>>(
    self: &TupleVariationData<'a, GlyphDelta>,
    coords: &'b [F2Dot14],
    scalars: &'b [Fixed],
    deltas: &mut [Vector2<D>],
  ) -> Option<()> {
    zeroDeltas<D>(&mut deltas)
    let mut active = TupleVariationData<'a, GlyphDelta>.activeTuplesAtWithScalars(
      self,
      coords,
      scalars,
    )
    while let Option<ActiveTupleVariation<'a, GlyphDelta>>.Some {
      value
    } = move ActiveTupleVariationIter<'a, 'b, GlyphDelta>.next(&mut active) {
      if TupleVariation<'a, GlyphDelta>.hasDeltasForAllPoints(&value.variation) {
        if let Result<(), ReadError>.Failure { error } = move TupleVariation<
          'a,
          GlyphDelta
        >.accumulateDenseDeltas<D>(&value.variation, &mut deltas, value.scalar) {
          return Option<()>.None
        }
      } else {
        let mut iter = TupleVariation<'a, GlyphDelta>.deltas(&value.variation)
        while let Option<GlyphDelta>.Some { value: delta } = move TupleDeltaIter<
          'a,
          GlyphDelta
        >.next(&mut iter) {
          let index = u16.toUsize(delta.position)
          if index < deltas.length {
            let applied = GlyphDelta.applyScalar<D>(delta, value.scalar)
            deltas[index].x = deltas[index].x + applied.x
            deltas[index].y = deltas[index].y + applied.y
          }
        }
      }
    }
    return Option<()>.some(())
  }
}
