      }
      first = false
      run Writer.writeString("Y_ADVANCE")
    }
    if ValueFormat.contains(self, ValueFormat.xPlacementDevice()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("X_PLACEMENT_DEVICE")
    }
    if ValueFormat.contains(self, ValueFormat.yPlacementDevice()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("Y_PLACEMENT_DEVICE")
    }
    if ValueFormat.contains(self, ValueFormat.xAdvanceDevice()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("X_ADVANCE_DEVICE")
    }
    if ValueFormat.contains(self, ValueFormat.yAdvanceDevice()) {
      if !first {
        run Writer.writeString(" | ")
      }
      first = false
      run Writer.writeString("Y_ADVANCE_DEVICE")
    }
    if first {
      run Writer.writeString("(empty)")
    }
  }
}

impl BitAnd<ValueFormat, ValueFormat> for ValueFormat {
  fn bitAnd(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & right.raw }
  }
}

impl BitOr<ValueFormat, ValueFormat> for ValueFormat {
  fn bitOr(left: Self, right: Self) -> Self {
    return Self { raw: left.raw | right.raw }
  }
}

impl BitXor<ValueFormat, ValueFormat> for ValueFormat {
  fn bitXor(left: Self, right: Self) -> Self {
    return Self { raw: left.raw ^ right.raw }
  }
}

impl Subtract<ValueFormat, ValueFormat> for ValueFormat {
  fn subtract(left: Self, right: Self) -> Self {
    return Self { raw: left.raw & ~right.raw }
  }
}

impl Not<ValueFormat> for ValueFormat {
  fn not(value: Self) -> Self {
    return Self { raw: ~value.raw & 255 }
  }
}

impl Scalar for ValueFormat {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<Self>.some(ValueFormat.fromBitsTruncate(value))
      Option<u16>.None => Option<Self>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.raw, move bytes)
  }
}

impl FixedSize for ValueFormat {
  fn rawByteLen() -> usize {
    return 2
  }
}

/// [Anchor Tables](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#anchor-tables)
/// position one glyph with respect to another.
pub union AnchorTable<'a> {
  Format1 { pub value: AnchorFormat1<'a> },
  Format2 { pub value: AnchorFormat2<'a> },
  Format3 { pub value: AnchorFormat3<'a> },
}

impl<'a> Copy for AnchorTable<'a> {}

impl<'a> AnchorTable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move AnchorFormat1<'a>.read(data) {
          Result<AnchorFormat1<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
            AnchorTable<'a>.Format1 { value: value },
          )
          Result<AnchorFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move AnchorFormat2<'a>.read(data) {
          Result<AnchorFormat2<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
            AnchorTable<'a>.Format2 { value: value },
          )
          Result<AnchorFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move AnchorFormat3<'a>.read(data) {
          Result<AnchorFormat3<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
            AnchorTable<'a>.Format3 { value: value },
          )
          Result<AnchorFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => AnchorFormat1<'a>.offsetData(&value)
      AnchorTable<'a>.Format2 { value } => AnchorFormat2<'a>.offsetData(&value)
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.offsetData(&value)
    }
  }

  /// Format identifier, = 1
  pub fn anchorFormat(self: &Self) -> u16 {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => AnchorFormat1<'a>.anchorFormat(&value)
      AnchorTable<'a>.Format2 { value } => AnchorFormat2<'a>.anchorFormat(&value)
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.anchorFormat(&value)
    }
  }

  /// Horizontal value, in design units
  pub fn xCoordinate(self: &Self) -> i16 {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => AnchorFormat1<'a>.xCoordinate(&value)
      AnchorTable<'a>.Format2 { value } => AnchorFormat2<'a>.xCoordinate(&value)
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.xCoordinate(&value)
    }
  }

  /// Vertical value, in design units
  pub fn yCoordinate(self: &Self) -> i16 {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => AnchorFormat1<'a>.yCoordinate(&value)
      AnchorTable<'a>.Format2 { value } => AnchorFormat2<'a>.yCoordinate(&value)
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.yCoordinate(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for AnchorTable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return AnchorTable<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for AnchorTable<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      AnchorTable<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      AnchorTable<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      AnchorTable<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      AnchorTable<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      AnchorTable<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> AnchorTable<'a> {
  pub fn default() -> Self {
    return AnchorTable<'a>.Format1 { value: AnchorFormat1<'a>.default() }
  }
}

/// [Anchor Table Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#anchor-table-format-1-design-units): Design Units
pub struct AnchorFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for AnchorFormat1<'a> {}

impl<'a> AnchorFormat1<'a> {
  pub fn default() -> Self {
    return AnchorFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let anchorFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let xCoordinateValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let yCoordinateValue = scalarOr<i16>(data, ranges[2].start, 0)
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier, = 1
  pub fn anchorFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn anchorFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Horizontal value, in design units
  pub fn xCoordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn xCoordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Vertical value, in design units
  pub fn yCoordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[2].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yCoordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for AnchorFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return AnchorFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for AnchorFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for AnchorFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Anchor Table Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#anchor-table-format-2-design-units-plus-contour-point): Design Units Plus Contour Point
