/// Part of [PairPosFormat2]
pub struct Class1Record<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 1],
  _class2Count: u16,
  _valueFormat1: ValueFormat,
  _valueFormat2: ValueFormat,
}

impl<'a> Copy for Class1Record<'a> {}

impl<'a> Class1Record<'a> {
  pub fn readAt(
    data: FontData<'a>,
    position: usize,
    args: ReadArgs3<u16, ValueFormat, ValueFormat>,
  ) -> Result<Self, ReadError> {
    let class2CountValue = args.first
    let valueFormat1Value = args.second
    let valueFormat2Value = args.third
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(class2CountValue),
        (computeSize<ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>(
          ReadArgs2<ValueFormat, ValueFormat> {
            first: valueFormat1Value,
            second: valueFormat2Value,
          },
        )
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[0].end = end
    let value = Self {
      _fontData: data,
      _fieldRanges: ranges,
      _class2Count: class2CountValue,
      _valueFormat1: valueFormat1Value,
      _valueFormat2: valueFormat2Value,
    }
    if let Result<
      ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>,
      ReadError
    >.Failure {
      error
    } = move ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>.new(
      data,
      ranges[0].start,
      ranges[0].end,
      ReadArgs2<ValueFormat, ValueFormat> {
        first: value._valueFormat1,
        second: value._valueFormat2,
      },
    ) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return Class1Record<'a>.readAt(
      FontData.defaultTableData(),
      0,
      ReadArgs3<u16, ValueFormat, ValueFormat> {
        first: 0,
        second: ValueFormat.empty(),
        third: ValueFormat.empty(),
      },
    )
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _class2Count: 0,
          _valueFormat1: ValueFormat.empty(),
          _valueFormat2: ValueFormat.empty(),
        },
      )
  }

  /// Array of Class2 records, ordered by classes in classDef2.
  pub fn class2Records(self: &Self) -> ComputedArray<
    'a,
    ReadArgs2<ValueFormat, ValueFormat>,
    Class2Record<'a>
  > {
    return match move ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>.new(
      self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
      ReadArgs2<ValueFormat, ValueFormat> { first: self._valueFormat1, second: self._valueFormat2 },
    ) {
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>,
        ReadError
      >.Success {
        value
      } => value
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>,
        ReadError
      >.Failure {
        error
      } => ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'a>>.empty(
        ReadArgs2<ValueFormat, ValueFormat> {
          first: self._valueFormat1,
          second: self._valueFormat2,
        },
      )
    }
  }
}

