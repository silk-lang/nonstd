      'a,
      ReadArgs3<u16, ValueFormat, ValueFormat>,
      Class1Record<'a>
    >.new(
      self._fontData,
      self._fieldRanges[8].start,
      self._fieldRanges[8].end,
      ReadArgs3<u16, ValueFormat, ValueFormat> {
        first: PairPosFormat2<'a>.class2Count(self),
        second: PairPosFormat2<'a>.valueFormat1(self),
        third: PairPosFormat2<'a>.valueFormat2(self),
      },
    ) {
      Result<
        ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>,
        ReadError
      >.Success {
        value
      } => value
      Result<
        ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>,
        ReadError
      >.Failure {
        error
      } => ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>.empty(
        ReadArgs3<u16, ValueFormat, ValueFormat> {
          first: PairPosFormat2<'a>.class2Count(self),
          second: PairPosFormat2<'a>.valueFormat1(self),
