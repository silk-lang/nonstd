  pub fn empty() -> ValueFormat {
    return ValueFormat { raw: 0 }
  }

  pub fn all() -> ValueFormat {
    return ValueFormat { raw: 255 }
  }

  pub fn fromBitsTruncate(bits: u16) -> ValueFormat {
    return ValueFormat { raw: bits & 255 }
  }

  pub fn fromBits(bits: u16) -> Option<ValueFormat> {
    if (bits & 255) != bits {
      return Option<ValueFormat>.None
    }
    return Option<ValueFormat>.some(ValueFormat { raw: bits })
  }

  pub fn isEmpty(self: &Self) -> bool {
    return self.raw == 0
  }

  pub fn contains(self: &Self, other: ValueFormat) -> bool {
    return (self.raw & other.raw) == other.raw
  }

  pub fn intersects(self: &Self, other: ValueFormat) -> bool {
    return (self.raw & other.raw) != 0
  }

  pub fn insert(self: &mut Self, other: ValueFormat) -> () {
    self.raw = self.raw | other.raw
  }

  pub fn remove(self: &mut Self, other: ValueFormat) -> () {
    self.raw = self.raw & ~other.raw
  }

  pub fn toggle(self: &mut Self, other: ValueFormat) -> () {
    self.raw = self.raw ^ other.raw
  }

  pub fn intersection(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & other.raw }
  }

  pub fn unionValue(self: Self, other: Self) -> Self {
    return Self { raw: self.raw | other.raw }
  }

  pub fn difference(self: Self, other: Self) -> Self {
    return Self { raw: self.raw & ~other.raw }
  }

  /// Includes horizontal adjustment for placement
  pub fn xPlacement() -> ValueFormat {
    return ValueFormat { raw: 1 }
  }

  /// Includes vertical adjustment for placement
  pub fn yPlacement() -> ValueFormat {
    return ValueFormat { raw: 2 }
  }

  /// Includes horizontal adjustment for advance
  pub fn xAdvance() -> ValueFormat {
    return ValueFormat { raw: 4 }
  }

  /// Includes vertical adjustment for advance
  pub fn yAdvance() -> ValueFormat {
    return ValueFormat { raw: 8 }
  }

  /// Includes Device table (non-variable font) / VariationIndex
  /// table (variable font) for horizontal placement
  pub fn xPlacementDevice() -> ValueFormat {
    return ValueFormat { raw: 16 }
  }

  /// Includes Device table (non-variable font) / VariationIndex
  /// table (variable font) for vertical placement
  pub fn yPlacementDevice() -> ValueFormat {
    return ValueFormat { raw: 32 }
