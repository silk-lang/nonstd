  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return ComponentRecord<'a>.readAt(data, 0, args)
  }
}

/// [Mark-to-Mark Attachment Positioning Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#mark-to-mark-attachment-positioning-format-1-mark-to-mark-attachment): Mark-to-Mark Attachment
pub struct MarkMarkPosFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for MarkMarkPosFormat1<'a> {}

impl<'a> MarkMarkPosFormat1<'a> {
  pub fn default() -> Self {
    return MarkMarkPosFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 6] },
      )
  }

  pub fn minSize() -> usize {
    return 12
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 12 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let mark1CoverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let mark2CoverageOffsetValue = scalarOr<Offset16>(data, ranges[2].start, Offset16.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let markClassCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let mark1ArrayOffsetValue = scalarOr<Offset16>(data, ranges[4].start, Offset16.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let mark2ArrayOffsetValue = scalarOr<Offset16>(data, ranges[5].start, Offset16.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Combining Mark Coverage table, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark1CoverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn mark1Coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkMarkPosFormat1<'a>.mark1CoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn mark1CoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to Base Mark Coverage table, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark2CoverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn mark2Coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkMarkPosFormat1<'a>.mark2CoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn mark2CoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of Combining Mark classes defined
  pub fn markClassCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn markClassCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to MarkArray table for mark1, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark1ArrayOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn mark1Array(self: &Self) -> Result<MarkArray<'a>, ReadError> {
    let offset = MarkMarkPosFormat1<'a>.mark1ArrayOffset(self)
    return resolveWithArgs<(), MarkArray<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn mark1ArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Offset to Mark2Array table for mark2, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark2ArrayOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[5].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn mark2Array(self: &Self) -> Result<Mark2Array<'a>, ReadError> {
    let offset = MarkMarkPosFormat1<'a>.mark2ArrayOffset(self)
    return resolveWithArgs<u16, Mark2Array<'a>, Offset16>(
      offset,
      self._fontData,
      MarkMarkPosFormat1<'a>.markClassCount(self),
    )
  }

  pub fn mark2ArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }
}

