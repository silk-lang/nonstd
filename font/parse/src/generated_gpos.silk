/// ComponentRecord2 (ISO/IEC 14496-22:2026).
pub struct ComponentRecord2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 1],
  _markClassCount: u16,
}

impl<'a> Copy for ComponentRecord2<'a> {}

impl<'a> ComponentRecord2<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    let markClassCountValue = args
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCountValue }
    if let Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } = move FontData<
      'a
    >.readArray<Nullable<Offset24>>(&data, ranges[0].start, ranges[0].end) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return ComponentRecord2<'a>.readAt(FontData.defaultTableData(), 0, 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _markClassCount: 0,
        },
      )
  }

  /// Array of offsets (one per class) to Anchor tables. Offsets are
  /// from beginning of LigatureAttach table, ordered by class
  /// (offsets may be NULL).
  pub fn ligatureAnchorOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset24>> {
    return match move FontData<'a>.readArray<Nullable<Offset24>>(
      &self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset24>
      >.empty()
    }
  }

  pub fn ligatureAnchors(self: &Self, data: FontData<'a>) -> ArrayOfNullableOffsets<
    'a,
    (),
    AnchorTable<'a>,
    Offset24
  > {
    return ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.new(
      ComponentRecord2<'a>.ligatureAnchorOffsets(self),
      data,
      (),
    )
  }
}

impl<'a> ComputeSize<u16> for ComponentRecord2<'a> {
  fn computeSize(args: u16) -> Result<usize, ReadError> {
    let markClassCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, u16> for ComponentRecord2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    return ComponentRecord2<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, u16> for ComponentRecord2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return ComponentRecord2<'a>.readAt(data, 0, args)
  }
}

/// MarkMarkPosFormat2 (ISO/IEC 14496-22:2026).
pub struct MarkMarkPosFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for MarkMarkPosFormat2<'a> {}

impl<'a> MarkMarkPosFormat2<'a> {
  pub fn minSize() -> usize {
    return 20
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 20 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let mark1CoverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let mark2CoverageOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let markClassCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[4].end = end
    let mark1ArrayOffsetValue = scalarOr<Offset32>(data, ranges[4].start, Offset32.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[5].end = end
    let mark2ArrayOffsetValue = scalarOr<Offset32>(data, ranges[5].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Combining Mark Coverage table, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark1CoverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn mark1Coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkMarkPosFormat2<'a>.mark1CoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn mark1CoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to Base Mark Coverage table, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark2CoverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn mark2Coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkMarkPosFormat2<'a>.mark2CoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn mark2CoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of Combining Mark classes defined
  pub fn markClassCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn markClassCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to MarkArray table for mark1, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark1ArrayOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn mark1Array(self: &Self) -> Result<MarkArray2<'a>, ReadError> {
    let offset = MarkMarkPosFormat2<'a>.mark1ArrayOffset(self)
    return resolveWithArgs<(), MarkArray2<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn mark1ArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Offset to Mark2Array table for mark2, from beginning of
  /// MarkMarkPos subtable.
  pub fn mark2ArrayOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[5].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn mark2Array(self: &Self) -> Result<Mark2Array2<'a>, ReadError> {
    let offset = MarkMarkPosFormat2<'a>.mark2ArrayOffset(self)
    return resolveWithArgs<u16, Mark2Array2<'a>, Offset32>(
      offset,
      self._fontData,
      MarkMarkPosFormat2<'a>.markClassCount(self),
    )
  }

  pub fn mark2ArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }
}

