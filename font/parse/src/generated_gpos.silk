/// LigatureAttach2 (ISO/IEC 14496-22:2026).
pub struct LigatureAttach2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _markClassCount: u16,
}

impl<'a> Copy for LigatureAttach2<'a> {}

impl<'a> LigatureAttach2<'a> {
  pub fn default() -> Self {
    return LigatureAttach2<'a>.read(FontData.defaultTableData(), 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _markClassCount: 0,
        },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>, markClassCount: u16) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let markClassCountValue = markClassCount
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let componentCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(componentCountValue),
        (computeSize<u16, ComponentRecord2<'a>>(markClassCountValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCount },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of ComponentRecords in this ligature
  pub fn componentCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn componentCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of Component records, ordered in writing direction.
  pub fn componentRecords(self: &Self) -> ComputedArray<'a, u16, ComponentRecord2<'a>> {
    return match move ComputedArray<'a, u16, ComponentRecord2<'a>>.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      self._markClassCount,
    ) {
      Result<ComputedArray<'a, u16, ComponentRecord2<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, u16, ComponentRecord2<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, u16, ComponentRecord2<'a>>.empty(self._markClassCount)
    }
  }

  pub fn componentRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, u16> for LigatureAttach2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return LigatureAttach2<'a>.read(data, args)
  }
}

