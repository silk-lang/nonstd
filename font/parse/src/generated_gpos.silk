  fn computeSize(args: ReadArgs3<u16, ValueFormat, ValueFormat>) -> Result<usize, ReadError> {
    let class2CountValue = args.first
    let valueFormat1Value = args.second
    let valueFormat2Value = args.third
    let mut end: usize = 0
    end = match move usize.checkedAdd(
