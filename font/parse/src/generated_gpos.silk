    return resolveWithArgs<u16, LigatureArray2<'a>, Offset32>(
      offset,
      self._fontData,
      MarkLigPosFormat2<'a>.markClassCount(self),
    )
  }

  pub fn ligatureArrayOffsetByteRange(self: &Self) -> ByteRange {
