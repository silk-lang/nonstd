/// EntryExitRecord2 (ISO/IEC 14496-22:2026).
pub struct EntryExitRecord2<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for EntryExitRecord2<'a> {}

impl<'a> EntryExitRecord2<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 6 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Offset to entryAnchor table, from beginning of CursivePos
  /// subtable (may be NULL).
  pub fn entryAnchorOffset(self: &Self) -> Nullable<Offset24> {
    return match move FontData<'a>.readAt<Nullable<Offset24>>(
      &self._fontData,
      (self.position + 0),
    ) {
      Result<Nullable<Offset24>, ReadError>.Success { value } => value
      Result<Nullable<Offset24>, ReadError>.Failure { error } => Nullable<Offset24>.default()
    }
  }

  pub fn entryAnchor(self: &Self, data: FontData<'a>) -> Option<
    Result<AnchorTable<'a>, ReadError>
  > {
    let offset = EntryExitRecord2<'a>.entryAnchorOffset(self)
    return resolveNullableWithArgs<(), AnchorTable<'a>, Offset24>(&offset, data, ())
  }

  /// Offset to exitAnchor table, from beginning of CursivePos
  /// subtable (may be NULL).
  pub fn exitAnchorOffset(self: &Self) -> Nullable<Offset24> {
    return match move FontData<'a>.readAt<Nullable<Offset24>>(
      &self._fontData,
      (self.position + 3),
    ) {
      Result<Nullable<Offset24>, ReadError>.Success { value } => value
      Result<Nullable<Offset24>, ReadError>.Failure { error } => Nullable<Offset24>.default()
    }
  }

  pub fn exitAnchor(self: &Self, data: FontData<'a>) -> Option<Result<AnchorTable<'a>, ReadError>> {
    let offset = EntryExitRecord2<'a>.exitAnchorOffset(self)
    return resolveNullableWithArgs<(), AnchorTable<'a>, Offset24>(&offset, data, ())
  }
}

impl<'a> FixedSize for EntryExitRecord2<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for EntryExitRecord2<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for EntryExitRecord2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return EntryExitRecord2<'a>.readAt(data, position, ())
  }
}

/// MarkBasePosFormat2 (ISO/IEC 14496-22:2026).
pub struct MarkBasePosFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for MarkBasePosFormat2<'a> {}

impl<'a> MarkBasePosFormat2<'a> {
  pub fn minSize() -> usize {
    return 20
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 20 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let markCoverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let baseCoverageOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let markClassCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[4].end = end
    let markArrayOffsetValue = scalarOr<Offset32>(data, ranges[4].start, Offset32.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[5].end = end
    let baseArrayOffsetValue = scalarOr<Offset32>(data, ranges[5].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to markCoverage table, from beginning of MarkBasePos
  /// subtable.
  pub fn markCoverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn markCoverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkBasePosFormat2<'a>.markCoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn markCoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to baseCoverage table, from beginning of MarkBasePos
  /// subtable.
  pub fn baseCoverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn baseCoverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = MarkBasePosFormat2<'a>.baseCoverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn baseCoverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of classes defined for marks
  pub fn markClassCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn markClassCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to MarkArray table, from beginning of MarkBasePos
  /// subtable.
  pub fn markArrayOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn markArray(self: &Self) -> Result<MarkArray2<'a>, ReadError> {
    let offset = MarkBasePosFormat2<'a>.markArrayOffset(self)
    return resolveWithArgs<(), MarkArray2<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn markArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

