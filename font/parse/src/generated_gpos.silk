/// [Cursive Attachment Positioning Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#cursive-attachment-positioning-format1-cursive-attachment): Cursvie attachment
pub struct CursivePosFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for CursivePosFormat1<'a> {}

impl<'a> CursivePosFormat1<'a> {
  pub fn default() -> Self {
    return CursivePosFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let entryExitCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(entryExitCountValue), 4))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of CursivePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = CursivePosFormat1<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of EntryExit records
  pub fn entryExitCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn entryExitCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Array of EntryExit records, in Coverage index order.
  pub fn entryExitRecord(self: &Self) -> ComputedArray<'a, (), EntryExitRecord<'a>> {
    return match move recordArray<EntryExitRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ComputedArray<'a, (), EntryExitRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), EntryExitRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, (), EntryExitRecord<'a>>.empty(())
    }
  }

  pub fn entryExitRecordByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for CursivePosFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CursivePosFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for CursivePosFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for CursivePosFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [CursivePosFormat1]
pub struct EntryExitRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for EntryExitRecord<'a> {}

impl<'a> EntryExitRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 4 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Offset to entryAnchor table, from beginning of CursivePos
  /// subtable (may be NULL).
  pub fn entryAnchorOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 0),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn entryAnchor(self: &Self, data: FontData<'a>) -> Option<
    Result<AnchorTable<'a>, ReadError>
  > {
    let offset = EntryExitRecord<'a>.entryAnchorOffset(self)
    return resolveNullableWithArgs<(), AnchorTable<'a>, Offset16>(&offset, data, ())
  }

  /// Offset to exitAnchor table, from beginning of CursivePos
  /// subtable (may be NULL).
  pub fn exitAnchorOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      (self.position + 2),
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn exitAnchor(self: &Self, data: FontData<'a>) -> Option<Result<AnchorTable<'a>, ReadError>> {
    let offset = EntryExitRecord<'a>.exitAnchorOffset(self)
    return resolveNullableWithArgs<(), AnchorTable<'a>, Offset16>(&offset, data, ())
  }
}

