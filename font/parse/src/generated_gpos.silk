    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCountValue }
    if let Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } = move FontData<
      'a
    >.readArray<Nullable<Offset24>>(&data, ranges[0].start, ranges[0].end) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return Mark2Record2<'a>.readAt(FontData.defaultTableData(), 0, 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _markClassCount: 0,
        },
      )
  }

  /// Array of offsets (one per class) to Anchor tables. Offsets are
  /// from beginning of Mark2Array table, in class order (offsets may
  /// be NULL).
  pub fn mark2AnchorOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset24>> {
    return match move FontData<'a>.readArray<Nullable<Offset24>>(
      &self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset24>
      >.empty()
    }
  }

  pub fn mark2Anchors(self: &Self, data: FontData<'a>) -> ArrayOfNullableOffsets<
    'a,
    (),
    AnchorTable<'a>,
    Offset24
  > {
    return ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.new(
      Mark2Record2<'a>.mark2AnchorOffsets(self),
      data,
      (),
    )
  }
}

impl<'a> ComputeSize<u16> for Mark2Record2<'a> {
  fn computeSize(args: u16) -> Result<usize, ReadError> {
    let markClassCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, u16> for Mark2Record2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    return Mark2Record2<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, u16> for Mark2Record2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return Mark2Record2<'a>.readAt(data, 0, args)
  }
}

/// MarkArray2 (ISO/IEC 14496-22:2026).
pub struct MarkArray2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for MarkArray2<'a> {}

impl<'a> MarkArray2<'a> {
  pub fn default() -> Self {
    return MarkArray2<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    let markCountValue = scalarOr<Uint24>(data, ranges[0].start, Uint24.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(markCountValue)), 5),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of MarkRecords
  pub fn markCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[0].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn markCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of MarkRecords, ordered by corresponding glyphs in the
  /// associated mark Coverage table.
  pub fn markRecords(self: &Self) -> ComputedArray<'a, (), MarkRecord2<'a>> {
    return match move recordArray<MarkRecord2<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ComputedArray<'a, (), MarkRecord2<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), MarkRecord2<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        MarkRecord2<'a>
      >.empty(())
    }
  }

  pub fn markRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for MarkArray2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MarkArray2<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for MarkArray2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// MarkRecord2 (ISO/IEC 14496-22:2026).
pub struct MarkRecord2<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for MarkRecord2<'a> {}

impl<'a> MarkRecord2<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 5 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Class defined for the associated mark.
  pub fn markClass(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Offset to Anchor table, from beginning of MarkArray table.
  pub fn markAnchorOffset(self: &Self) -> Offset24 {
    return match move FontData<'a>.readAt<Offset24>(&self._fontData, (self.position + 2)) {
      Result<Offset24, ReadError>.Success { value } => value
      Result<Offset24, ReadError>.Failure { error } => Offset24.new(Uint24.new(0))
    }
  }

  pub fn markAnchor(self: &Self, data: FontData<'a>) -> Result<AnchorTable<'a>, ReadError> {
    let offset = MarkRecord2<'a>.markAnchorOffset(self)
    return resolveWithArgs<(), AnchorTable<'a>, Offset24>(offset, data, ())
  }
}

impl<'a> FixedSize for MarkRecord2<'a> {
  fn rawByteLen() -> usize {
    return 5
  }
}

impl<'a> ComputeSize<()> for MarkRecord2<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(5)
  }
}

impl<'a> FontReadAt<'a, ()> for MarkRecord2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return MarkRecord2<'a>.readAt(data, position, ())
  }
}

