      SinglePos<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      SinglePos<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
      SinglePos<'a>.Format4 { value } => MinByteRange.minTableBytes(&value)
