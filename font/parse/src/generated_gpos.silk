  }
}

/// [Single Adjustment Positioning Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#single-adjustment-positioning-format-1-single-positioning-value): Single Positioning Value
pub struct SinglePosFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for SinglePosFormat1<'a> {}

impl<'a> SinglePosFormat1<'a> {
  pub fn default() -> Self {
    return SinglePosFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormatValue = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormatValue)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of SinglePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = SinglePosFormat1<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in the ValueRecord.
  pub fn valueFormat(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Defines positioning value(s) — applied to all glyphs in the
  /// Coverage table.
  pub fn valueRecord(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      SinglePosFormat1<'a>.valueFormat(self),
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }

  pub fn valueRecordByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for SinglePosFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SinglePosFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for SinglePosFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for SinglePosFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Single Adjustment Positioning Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#single-adjustment-positioning-format-2-array-of-positioning-values): Array of Positioning Values
pub struct SinglePosFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for SinglePosFormat2<'a> {}

impl<'a> SinglePosFormat2<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormatValue = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(valueCountValue),
        (computeSize<ValueFormat, ValueRecord<'a>>(valueFormatValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of SinglePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = SinglePosFormat2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in the ValueRecords.
  pub fn valueFormat(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of ValueRecords — must equal glyphCount in the
  /// Coverage table.
  pub fn valueCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn valueCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Array of ValueRecords — positioning values applied to glyphs.
  pub fn valueRecords(self: &Self) -> ComputedArray<'a, ValueFormat, ValueRecord<'a>> {
    return match move ComputedArray<'a, ValueFormat, ValueRecord<'a>>.new(
      self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
      SinglePosFormat2<'a>.valueFormat(self),
    ) {
      Result<ComputedArray<'a, ValueFormat, ValueRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, ValueFormat, ValueRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, ValueFormat, ValueRecord<'a>>.empty(
        SinglePosFormat2<'a>.valueFormat(self),
      )
    }
  }

  pub fn valueRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for SinglePosFormat2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SinglePosFormat2<'a>.read(data)
  }
}

impl<'a> Format<u16> for SinglePosFormat2<'a> {
  fn formatValue() -> u16 {
    return 2
  }
}

impl<'a> MinByteRange<'a> for SinglePosFormat2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

