/// BaseArray2 (ISO/IEC 14496-22:2026).
pub struct BaseArray2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _markClassCount: u16,
}

impl<'a> Copy for BaseArray2<'a> {}

impl<'a> BaseArray2<'a> {
  pub fn default() -> Self {
    return BaseArray2<'a>.read(FontData.defaultTableData(), 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _markClassCount: 0,
        },
      )
  }

  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>, markClassCount: u16) -> Result<Self, ReadError> {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let markClassCountValue = markClassCount
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    let baseCountValue = scalarOr<Uint24>(data, ranges[0].start, Uint24.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u32.toUsize(Uint24.toU32(baseCountValue)),
        (computeSize<u16, BaseRecord2<'a>>(markClassCountValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCount },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of BaseRecords
  pub fn baseCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[0].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn baseCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of BaseRecords, in order of baseCoverage Index.
  pub fn baseRecords(self: &Self) -> ComputedArray<'a, u16, BaseRecord2<'a>> {
    return match move ComputedArray<'a, u16, BaseRecord2<'a>>.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      self._markClassCount,
    ) {
      Result<ComputedArray<'a, u16, BaseRecord2<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, u16, BaseRecord2<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        u16,
        BaseRecord2<'a>
      >.empty(self._markClassCount)
    }
  }

  pub fn baseRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, u16> for BaseArray2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return BaseArray2<'a>.read(data, args)
  }
}

impl<'a> MinByteRange<'a> for BaseArray2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// BaseRecord2 (ISO/IEC 14496-22:2026).
pub struct BaseRecord2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 1],
  _markClassCount: u16,
}

impl<'a> Copy for BaseRecord2<'a> {}

impl<'a> BaseRecord2<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    let markClassCountValue = args
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCountValue }
    if let Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } = move FontData<
      'a
    >.readArray<Nullable<Offset24>>(&data, ranges[0].start, ranges[0].end) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return BaseRecord2<'a>.readAt(FontData.defaultTableData(), 0, 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _markClassCount: 0,
        },
      )
  }

  /// Array of offsets (one per mark class) to Anchor tables. Offsets
  /// are from beginning of BaseArray table, ordered by class
  /// (offsets may be NULL).
  pub fn baseAnchorOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset24>> {
    return match move FontData<'a>.readArray<Nullable<Offset24>>(
      &self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset24>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset24>
      >.empty()
    }
  }

  pub fn baseAnchors(self: &Self, data: FontData<'a>) -> ArrayOfNullableOffsets<
    'a,
    (),
    AnchorTable<'a>,
    Offset24
  > {
    return ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset24>.new(
      BaseRecord2<'a>.baseAnchorOffsets(self),
      data,
      (),
    )
  }
}

impl<'a> ComputeSize<u16> for BaseRecord2<'a> {
  fn computeSize(args: u16) -> Result<usize, ReadError> {
    let markClassCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(markClassCountValue), 3),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, u16> for BaseRecord2<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    return BaseRecord2<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, u16> for BaseRecord2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return BaseRecord2<'a>.readAt(data, 0, args)
  }
}

