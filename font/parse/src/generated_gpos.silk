    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(componentCountValue),
        (computeSize<u16, ComponentRecord<'a>>(markClassCountValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCount },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of ComponentRecords in this ligature
  pub fn componentCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn componentCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of Component records, ordered in writing direction.
  pub fn componentRecords(self: &Self) -> ComputedArray<'a, u16, ComponentRecord<'a>> {
    return match move ComputedArray<'a, u16, ComponentRecord<'a>>.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      self._markClassCount,
    ) {
      Result<ComputedArray<'a, u16, ComponentRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, u16, ComponentRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, u16, ComponentRecord<'a>>.empty(self._markClassCount)
    }
  }

  pub fn componentRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, u16> for LigatureAttach<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return LigatureAttach<'a>.read(data, args)
  }
}

impl<'a> MinByteRange<'a> for LigatureAttach<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [MarkLigPosFormat1]
pub struct ComponentRecord<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 1],
  _markClassCount: u16,
}

impl<'a> Copy for ComponentRecord<'a> {}

impl<'a> ComponentRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    let markClassCountValue = args
    let mut ranges = [ByteRange { start: 0, end: 0 }; 1]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markClassCountValue), 2))
    ranges[0].end = end
    let value = Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCountValue }
    if let Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Failure { error } = move FontData<
      'a
    >.readArray<Nullable<Offset16>>(&data, ranges[0].start, ranges[0].end) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return ComponentRecord<'a>.readAt(FontData.defaultTableData(), 0, 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 1],
          _markClassCount: 0,
        },
      )
  }

  /// Array of offsets (one per class) to Anchor tables. Offsets are
  /// from beginning of LigatureAttach table, ordered by class
  /// (offsets may be NULL).
  pub fn ligatureAnchorOffsets(self: &Self) -> ScalarArray<'a, Nullable<Offset16>> {
    return match move FontData<'a>.readArray<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[0].start,
      self._fieldRanges[0].end,
    ) {
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Nullable<Offset16>>, ReadError>.Failure { error } => ScalarArray<
        Nullable<Offset16>
      >.empty()
    }
  }

  pub fn ligatureAnchors(self: &Self, data: FontData<'a>) -> ArrayOfNullableOffsets<
    'a,
    (),
    AnchorTable<'a>,
    Offset16
  > {
    return ArrayOfNullableOffsets<'a, (), AnchorTable<'a>, Offset16>.new(
      ComponentRecord<'a>.ligatureAnchorOffsets(self),
      data,
      (),
    )
  }
}

impl<'a> ComputeSize<u16> for ComponentRecord<'a> {
  fn computeSize(args: u16) -> Result<usize, ReadError> {
    let markClassCountValue = args
    let mut end: usize = 0
    end = match move usize.checkedAdd(
      end,
      usize.saturatingMultiply(u16.toUsize(markClassCountValue), 2),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, u16> for ComponentRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: u16) -> Result<Self, ReadError> {
    return ComponentRecord<'a>.readAt(data, position, args)
  }
}

