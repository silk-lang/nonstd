/// [Extension Positioning Subtable Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#extension-positioning-subtable-format-1)
pub struct ExtensionPosFormat1<'a, T: FontRead<'a, ()>> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a, T: FontRead<'a, ()>> Copy for ExtensionPosFormat1<'a, T> {}

impl<'a, T> ExtensionPosFormat1<'a, T> {
  pub fn default() -> Self {
    return ExtensionPosFormat1<'a, T>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let extensionLookupTypeValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let extensionOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Lookup type of subtable referenced by extensionOffset (i.e. the
  /// extension subtable).
  pub fn extensionLookupType(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn extensionLookupTypeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to the extension subtable, of lookup type
  /// extensionLookupType, relative to the start of the
  /// ExtensionPosFormat1 subtable.
  pub fn extensionOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn extension(self: &Self) -> Result<T, ReadError> {
    let offset = ExtensionPosFormat1<'a, T>.extensionOffset(self)
    return resolveWithArgs<(), T, Offset32>(offset, self._fontData, ())
  }

  pub fn extensionOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a, T: FontRead<'a, ()>> FontRead<'a, ()> for ExtensionPosFormat1<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ExtensionPosFormat1<'a, T>.read(data)
  }
}

impl<'a, T> ExtensionPosFormat1<'a, T> {
  pub fn ofUnitType(self: &Self) -> ExtensionPosFormat1<'a, ()> {
    return ExtensionPosFormat1<'a, ()> {
      _fontData: self._fontData,
      _fieldRanges: self._fieldRanges,
    }
  }

  pub fn readDiscriminant(data: FontData<'a>) -> Result<u16, ReadError> {
    return FontData<'a>.readAt<u16>(&data, 2)
  }
}

impl<'a, T: FontRead<'a, ()>> Format<u16> for ExtensionPosFormat1<'a, T> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a, T: FontRead<'a, ()>> MinByteRange<'a> for ExtensionPosFormat1<'a, T> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// A [GPOS Extension Positioning](https://learn.microsoft.com/en-us/typography/opentype/spec/gpos#lookuptype-9-extension-positioning) subtable
pub union ExtensionSubtable<'a> {
  Single { pub value: ExtensionPosFormat1<'a, SinglePos<'a>> },
  Pair { pub value: ExtensionPosFormat1<'a, PairPos<'a>> },
  Cursive { pub value: ExtensionPosFormat1<'a, CursivePos<'a>> },
  MarkToBase { pub value: ExtensionPosFormat1<'a, MarkBasePos<'a>> },
  MarkToLig { pub value: ExtensionPosFormat1<'a, MarkLigPos<'a>> },
  MarkToMark { pub value: ExtensionPosFormat1<'a, MarkMarkPos<'a>> },
  Contextual { pub value: ExtensionPosFormat1<'a, PositionSequenceContext<'a>> },
  ChainContextual { pub value: ExtensionPosFormat1<'a, PositionChainContext<'a>> },
}

impl<'a> Copy for ExtensionSubtable<'a> {}

impl<'a> ExtensionSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let discriminant = match move ExtensionPosFormat1<'a, ()>.readDiscriminant(data) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match discriminant {
      1 => {
        return match move ExtensionPosFormat1<'a, SinglePos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, SinglePos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.Single { value: value })
          Result<ExtensionPosFormat1<'a, SinglePos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move ExtensionPosFormat1<'a, PairPos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, PairPos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.Pair { value: value })
          Result<ExtensionPosFormat1<'a, PairPos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move ExtensionPosFormat1<'a, CursivePos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, CursivePos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.Cursive { value: value })
          Result<ExtensionPosFormat1<'a, CursivePos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move ExtensionPosFormat1<'a, MarkBasePos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, MarkBasePos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.MarkToBase { value: value })
          Result<ExtensionPosFormat1<'a, MarkBasePos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      5 => {
        return match move ExtensionPosFormat1<'a, MarkLigPos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, MarkLigPos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.MarkToLig { value: value })
          Result<ExtensionPosFormat1<'a, MarkLigPos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      6 => {
        return match move ExtensionPosFormat1<'a, MarkMarkPos<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, MarkMarkPos<'a>>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(ExtensionSubtable<'a>.MarkToMark { value: value })
          Result<ExtensionPosFormat1<'a, MarkMarkPos<'a>>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      7 => {
        return match move ExtensionPosFormat1<'a, PositionSequenceContext<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, PositionSequenceContext<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(ExtensionSubtable<'a>.Contextual { value: value })
          Result<ExtensionPosFormat1<'a, PositionSequenceContext<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      8 => {
        return match move ExtensionPosFormat1<'a, PositionChainContext<'a>>.read(data) {
          Result<ExtensionPosFormat1<'a, PositionChainContext<'a>>, ReadError>.Success {
            value
          } => Result<Self, ReadError>.succeed(
            ExtensionSubtable<'a>.ChainContextual { value: value },
          )
          Result<ExtensionPosFormat1<'a, PositionChainContext<'a>>, ReadError>.Failure {
            error
          } => Result<Self, ReadError>.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(discriminant) },
        )
      }
    }
  }

  pub fn ofUnitType(self: &Self) -> ExtensionPosFormat1<'a, ()> {
    return match &self.* {
      ExtensionSubtable<'a>.Single { value } => ExtensionPosFormat1<'a, SinglePos<'a>>.ofUnitType(
        &value,
      )
      ExtensionSubtable<'a>.Pair { value } => ExtensionPosFormat1<'a, PairPos<'a>>.ofUnitType(
        &value,
      )
      ExtensionSubtable<'a>.Cursive { value } => ExtensionPosFormat1<'a, CursivePos<'a>>.ofUnitType(
        &value,
      )
      ExtensionSubtable<'a>.MarkToBase { value } => ExtensionPosFormat1<
        'a,
        MarkBasePos<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.MarkToLig { value } => ExtensionPosFormat1<
        'a,
        MarkLigPos<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.MarkToMark { value } => ExtensionPosFormat1<
        'a,
        MarkMarkPos<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.Contextual { value } => ExtensionPosFormat1<
        'a,
        PositionSequenceContext<'a>
      >.ofUnitType(&value)
      ExtensionSubtable<'a>.ChainContextual { value } => ExtensionPosFormat1<
        'a,
        PositionChainContext<'a>
      >.ofUnitType(&value)
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return ExtensionPosFormat1<'a, ()>.offsetData(&ExtensionSubtable<'a>.ofUnitType(self))
  }

  pub fn default() -> Self {
    return ExtensionSubtable<'a>.Single { value: ExtensionPosFormat1<'a, SinglePos<'a>>.default() }
  }
}

impl<'a> FontRead<'a, ()> for ExtensionSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ExtensionSubtable<'a>.read(data)
  }
}

/// SinglePosFormat3 (ISO/IEC 14496-22:2026).
pub struct SinglePosFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for SinglePosFormat3<'a> {}

impl<'a> SinglePosFormat3<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormatValue = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormatValue)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 3
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of SinglePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = SinglePosFormat3<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in the ValueRecord.
  pub fn valueFormat(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Defines positioning value(s) — applied to all glyphs in the
  /// Coverage table.
  pub fn valueRecord(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[3].start,
      SinglePosFormat3<'a>.valueFormat(self),
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }

  pub fn valueRecordByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for SinglePosFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SinglePosFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for SinglePosFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for SinglePosFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// SinglePosFormat4 (ISO/IEC 14496-22:2026).
pub struct SinglePosFormat4<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for SinglePosFormat4<'a> {}

impl<'a> SinglePosFormat4<'a> {
  pub fn minSize() -> usize {
    return 11
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 11 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormatValue = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[3].end = end
    let valueCountValue = scalarOr<Uint24>(data, ranges[3].start, Uint24.new(0))
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u32.toUsize(Uint24.toU32(valueCountValue)),
        (computeSize<ValueFormat, ValueRecord<'a>>(valueFormatValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 4
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of SinglePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = SinglePosFormat4<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in the ValueRecords.
  pub fn valueFormat(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Number of ValueRecords — must equal glyphCount in the
  /// Coverage table.
  pub fn valueCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[3].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn valueCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Array of ValueRecords — positioning values applied to glyphs.
  pub fn valueRecords(self: &Self) -> ComputedArray<'a, ValueFormat, ValueRecord<'a>> {
    return match move ComputedArray<'a, ValueFormat, ValueRecord<'a>>.new(
      self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
      SinglePosFormat4<'a>.valueFormat(self),
    ) {
      Result<ComputedArray<'a, ValueFormat, ValueRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, ValueFormat, ValueRecord<'a>>, ReadError>.Failure {
        error
      } => ComputedArray<'a, ValueFormat, ValueRecord<'a>>.empty(
        SinglePosFormat4<'a>.valueFormat(self),
      )
    }
  }

  pub fn valueRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for SinglePosFormat4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SinglePosFormat4<'a>.read(data)
  }
}

impl<'a> Format<u16> for SinglePosFormat4<'a> {
  fn formatValue() -> u16 {
    return 4
  }
}

impl<'a> MinByteRange<'a> for SinglePosFormat4<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// PairPosFormat3 (ISO/IEC 14496-22:2026).
pub struct PairPosFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for PairPosFormat3<'a> {}

impl<'a> PairPosFormat3<'a> {
  pub fn minSize() -> usize {
    return 13
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 13 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormat1Value = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueFormat2Value = scalarOr<ValueFormat>(data, ranges[3].start, ValueFormat.empty())
    ranges[4].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[4].end = end
    let pairSetCountValue = scalarOr<Uint24>(data, ranges[4].start, Uint24.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(pairSetCountValue)), 3),
    )
    ranges[5].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 3
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of PairPos subtable.
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = PairPosFormat3<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in valueRecord1 — for the first
  /// glyph in the pair (may be zero).
  pub fn valueFormat1(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat1ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Defines the types of data in valueRecord2 — for the second
  /// glyph in the pair (may be zero).
  pub fn valueFormat2(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[3].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat2ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of PairSet tables
  pub fn pairSetCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[4].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn pairSetCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Array of offsets to PairSet tables. Offsets are from beginning
  /// of PairPos subtable, ordered by Coverage Index.
  pub fn pairSetOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn pairSets(self: &Self) -> ArrayOfOffsets<
    'a,
    ReadArgs2<ValueFormat, ValueFormat>,
    PairSet2<'a>,
    Offset24
  > {
    return ArrayOfOffsets<'a, ReadArgs2<ValueFormat, ValueFormat>, PairSet2<'a>, Offset24>.new(
      PairPosFormat3<'a>.pairSetOffsets(self),
      self._fontData,
      ReadArgs2<ValueFormat, ValueFormat> {
        first: PairPosFormat3<'a>.valueFormat1(self),
        second: PairPosFormat3<'a>.valueFormat2(self),
      },
    )
  }

  pub fn pairSetOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }
}

impl<'a> FontRead<'a, ()> for PairPosFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return PairPosFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for PairPosFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for PairPosFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[5].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[5].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// PairSet2 (ISO/IEC 14496-22:2026).
pub struct PairSet2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _valueFormat1: ValueFormat,
  _valueFormat2: ValueFormat,
}

impl<'a> Copy for PairSet2<'a> {}

impl<'a> PairSet2<'a> {
  pub fn default() -> Self {
    return PairSet2<'a>.read(FontData.defaultTableData(), ValueFormat.empty(), ValueFormat.empty())
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _valueFormat1: ValueFormat.empty(),
          _valueFormat2: ValueFormat.empty(),
        },
      )
  }

  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>, valueFormat1: ValueFormat, valueFormat2: ValueFormat) -> Result<
    Self,
    ReadError
  > {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let valueFormat1Value = valueFormat1
    let valueFormat2Value = valueFormat2
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    let pairValueCountValue = scalarOr<Uint24>(data, ranges[0].start, Uint24.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u32.toUsize(Uint24.toU32(pairValueCountValue)),
        (computeSize<ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord2<'a>>(
          ReadArgs2<ValueFormat, ValueFormat> {
            first: valueFormat1Value,
            second: valueFormat2Value,
          },
        )
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self {
        _fontData: data,
        _fieldRanges: ranges,
        _valueFormat1: valueFormat1,
        _valueFormat2: valueFormat2,
      },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of PairValueRecords
  pub fn pairValueCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[0].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn pairValueCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of PairValueRecords, ordered by glyph ID of the second
  /// glyph.
  pub fn pairValueRecords(self: &Self) -> ComputedArray<
    'a,
    ReadArgs2<ValueFormat, ValueFormat>,
    PairValueRecord2<'a>
  > {
    return match move ComputedArray<
      'a,
      ReadArgs2<ValueFormat, ValueFormat>,
      PairValueRecord2<'a>
    >.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      ReadArgs2<ValueFormat, ValueFormat> { first: self._valueFormat1, second: self._valueFormat2 },
    ) {
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord2<'a>>,
        ReadError
      >.Success {
        value
      } => value
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord2<'a>>,
        ReadError
      >.Failure {
        error
      } => ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord2<'a>>.empty(
        ReadArgs2<ValueFormat, ValueFormat> {
          first: self._valueFormat1,
          second: self._valueFormat2,
        },
      )
    }
  }

  pub fn pairValueRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairSet2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<
    Self,
    ReadError
  > {
    return PairSet2<'a>.read(data, args.first, args.second)
  }
}

impl<'a> MinByteRange<'a> for PairSet2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// PairValueRecord2 (ISO/IEC 14496-22:2026).
pub struct PairValueRecord2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
  _valueFormat1: ValueFormat,
  _valueFormat2: ValueFormat,
}

impl<'a> Copy for PairValueRecord2<'a> {}

impl<'a> PairValueRecord2<'a> {
  pub fn readAt(
    data: FontData<'a>,
    position: usize,
    args: ReadArgs2<ValueFormat, ValueFormat>,
  ) -> Result<Self, ReadError> {
    let valueFormat1Value = args.first
    let valueFormat2Value = args.second
    let mut ranges = [ByteRange { start: 0, end: 0 }; 3]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat1Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat2Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[2].end = end
    let value = Self {
      _fontData: data,
      _fieldRanges: ranges,
      _valueFormat1: valueFormat1Value,
      _valueFormat2: valueFormat2Value,
    }
    if let Result<GlyphId24, ReadError>.Failure { error } = move FontData<'a>.readAt<GlyphId24>(
      &data,
      ranges[0].start,
    ) {
      return Result<Self, ReadError>.failResult(error)
    }
    if let Result<ValueRecord<'a>, ReadError>.Failure { error } = move readAtWithArgs<
      ValueFormat,
      ValueRecord<'a>
    >(data, ranges[1].start, value._valueFormat1) {
      return Result<Self, ReadError>.failResult(error)
    }
    if let Result<ValueRecord<'a>, ReadError>.Failure { error } = move readAtWithArgs<
      ValueFormat,
      ValueRecord<'a>
    >(data, ranges[2].start, value._valueFormat2) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return PairValueRecord2<'a>.readAt(
      FontData.defaultTableData(),
      0,
      ReadArgs2<ValueFormat, ValueFormat> {
        first: ValueFormat.empty(),
        second: ValueFormat.empty(),
      },
    )
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 3],
          _valueFormat1: ValueFormat.empty(),
          _valueFormat2: ValueFormat.empty(),
        },
      )
  }

  /// Glyph ID of second glyph in the pair (first glyph is listed in
  /// the Coverage table).
  pub fn secondGlyph(self: &Self) -> GlyphId24 {
    return match move FontData<'a>.readAt<GlyphId24>(&self._fontData, self._fieldRanges[0].start) {
      Result<GlyphId24, ReadError>.Success { value } => value
      Result<GlyphId24, ReadError>.Failure { error } => GlyphId24.new(0)
    }
  }

  /// Positioning data for the first glyph in the pair.
  pub fn valueRecord1(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._valueFormat1,
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }

  /// Positioning data for the second glyph in the pair.
  pub fn valueRecord2(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._valueFormat2,
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }
}

impl<'a> ComputeSize<ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord2<'a> {
  fn computeSize(args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<usize, ReadError> {
    let valueFormat1Value = args.first
    let valueFormat2Value = args.second
    let mut end: usize = 0
    end = match move usize.checkedAdd(end, 3) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    end = match move usize.checkedAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat1Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    end = match move usize.checkedAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat2Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord2<'a> {
  fn readAt(
    data: FontData<'a>,
    position: usize,
    args: ReadArgs2<ValueFormat, ValueFormat>,
  ) -> Result<Self, ReadError> {
    return PairValueRecord2<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<
    Self,
    ReadError
  > {
    return PairValueRecord2<'a>.readAt(data, 0, args)
  }
}

/// PairPosFormat4 (ISO/IEC 14496-22:2026).
pub struct PairPosFormat4<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 9],
}

impl<'a> Copy for PairPosFormat4<'a> {}

impl<'a> PairPosFormat4<'a> {
  pub fn minSize() -> usize {
    return 22
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 22 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 9] = [ByteRange { start: 0, end: 0 }; 9]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormat1Value = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueFormat2Value = scalarOr<ValueFormat>(data, ranges[3].start, ValueFormat.empty())
    ranges[4].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[4].end = end
    let classDef1OffsetValue = scalarOr<Offset32>(data, ranges[4].start, Offset32.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[5].end = end
    let classDef2OffsetValue = scalarOr<Offset32>(data, ranges[5].start, Offset32.new(0))
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let class1CountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[7].end = end
    let class2CountValue = scalarOr<u16>(data, ranges[7].start, 0)
    ranges[8].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(class1CountValue),
        (computeSize<ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>(
          ReadArgs3<u16, ValueFormat, ValueFormat> {
            first: class2CountValue,
            second: valueFormat1Value,
            third: valueFormat2Value,
          },
        )
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[8].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 4
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of PairPos subtable.
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = PairPosFormat4<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// ValueRecord definition — for the first glyph of the pair (may
  /// be zero).
  pub fn valueFormat1(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat1ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// ValueRecord definition — for the second glyph of the pair
  /// (may be zero).
  pub fn valueFormat2(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[3].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat2ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to ClassDef table, from beginning of PairPos subtable
  /// — for the first glyph of the pair.
  pub fn classDef1Offset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn classDef1(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = PairPosFormat4<'a>.classDef1Offset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn classDef1OffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Offset to ClassDef table, from beginning of PairPos subtable
  /// — for the second glyph of the pair.
  pub fn classDef2Offset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[5].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn classDef2(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = PairPosFormat4<'a>.classDef2Offset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn classDef2OffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Number of classes in classDef1 table — includes Class 0.
  pub fn class1Count(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[6].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn class1CountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }

  /// Number of classes in classDef2 table — includes Class 0.
  pub fn class2Count(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[7].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn class2CountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[7]
  }

  /// Array of Class1 records, ordered by classes in classDef1.
  pub fn class1Records(self: &Self) -> ComputedArray<
    'a,
    ReadArgs3<u16, ValueFormat, ValueFormat>,
    Class1Record<'a>
  > {
    return match move ComputedArray<
      'a,
      ReadArgs3<u16, ValueFormat, ValueFormat>,
      Class1Record<'a>
    >.new(
      self._fontData,
      self._fieldRanges[8].start,
      self._fieldRanges[8].end,
      ReadArgs3<u16, ValueFormat, ValueFormat> {
        first: PairPosFormat4<'a>.class2Count(self),
        second: PairPosFormat4<'a>.valueFormat1(self),
        third: PairPosFormat4<'a>.valueFormat2(self),
      },
    ) {
      Result<
        ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>,
        ReadError
      >.Success {
        value
      } => value
      Result<
        ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>,
        ReadError
      >.Failure {
        error
      } => ComputedArray<'a, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>.empty(
        ReadArgs3<u16, ValueFormat, ValueFormat> {
          first: PairPosFormat4<'a>.class2Count(self),
          second: PairPosFormat4<'a>.valueFormat1(self),
          third: PairPosFormat4<'a>.valueFormat2(self),
        },
      )
    }
  }

  pub fn class1RecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[8]
  }
}

impl<'a> FontRead<'a, ()> for PairPosFormat4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return PairPosFormat4<'a>.read(data)
  }
}

impl<'a> Format<u16> for PairPosFormat4<'a> {
  fn formatValue() -> u16 {
    return 4
  }
}

impl<'a> MinByteRange<'a> for PairPosFormat4<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[8].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[8].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// CursivePosFormat2 (ISO/IEC 14496-22:2026).
pub struct CursivePosFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for CursivePosFormat2<'a> {}

impl<'a> CursivePosFormat2<'a> {
  pub fn minSize() -> usize {
    return 9
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 9 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[2].end = end
    let entryExitCountValue = scalarOr<Uint24>(data, ranges[2].start, Uint24.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(entryExitCountValue)), 6),
    )
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of CursivePos subtable.
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = CursivePosFormat2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of EntryExit records
  pub fn entryExitCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[2].start) {
