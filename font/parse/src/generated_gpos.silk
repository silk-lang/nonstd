impl<'a> PairPos<'a> {
  pub fn default() -> Self {
    return PairPos<'a>.Format1 { value: PairPosFormat1<'a>.default() }
  }
}

/// [Pair Adjustment Positioning Format 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#pair-adjustment-positioning-format-1-adjustments-for-glyph-pairs): Adjustments for Glyph Pairs
pub struct PairPosFormat1<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 6],
}

impl<'a> Copy for PairPosFormat1<'a> {}

impl<'a> PairPosFormat1<'a> {
  pub fn default() -> Self {
    return PairPosFormat1<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 6] },
      )
  }

  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 6] = [ByteRange { start: 0, end: 0 }; 6]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormat1Value = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueFormat2Value = scalarOr<ValueFormat>(data, ranges[3].start, ValueFormat.empty())
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let pairSetCountValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(pairSetCountValue), 2))
    ranges[5].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of PairPos subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = PairPosFormat1<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Defines the types of data in valueRecord1 — for the first
  /// glyph in the pair (may be zero).
  pub fn valueFormat1(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat1ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Defines the types of data in valueRecord2 — for the second
  /// glyph in the pair (may be zero).
  pub fn valueFormat2(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[3].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat2ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Number of PairSet tables
  pub fn pairSetCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn pairSetCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Array of offsets to PairSet tables. Offsets are from beginning
  /// of PairPos subtable, ordered by Coverage Index.
  pub fn pairSetOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[5].start,
      self._fieldRanges[5].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn pairSets(self: &Self) -> ArrayOfOffsets<
    'a,
    ReadArgs2<ValueFormat, ValueFormat>,
    PairSet<'a>,
    Offset16
  > {
    return ArrayOfOffsets<'a, ReadArgs2<ValueFormat, ValueFormat>, PairSet<'a>, Offset16>.new(
      PairPosFormat1<'a>.pairSetOffsets(self),
      self._fontData,
      ReadArgs2<ValueFormat, ValueFormat> {
        first: PairPosFormat1<'a>.valueFormat1(self),
        second: PairPosFormat1<'a>.valueFormat2(self),
      },
    )
  }

  pub fn pairSetOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }
}

impl<'a> FontRead<'a, ()> for PairPosFormat1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return PairPosFormat1<'a>.read(data)
  }
}

impl<'a> Format<u16> for PairPosFormat1<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for PairPosFormat1<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[5].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[5].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [PairPosFormat1]
pub struct PairSet<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _valueFormat1: ValueFormat,
  _valueFormat2: ValueFormat,
}

impl<'a> Copy for PairSet<'a> {}

impl<'a> PairSet<'a> {
  pub fn default() -> Self {
    return PairSet<'a>.read(FontData.defaultTableData(), ValueFormat.empty(), ValueFormat.empty())
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _valueFormat1: ValueFormat.empty(),
          _valueFormat2: ValueFormat.empty(),
        },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>, valueFormat1: ValueFormat, valueFormat2: ValueFormat) -> Result<
    Self,
    ReadError
  > {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let valueFormat1Value = valueFormat1
    let valueFormat2Value = valueFormat2
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let pairValueCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(pairValueCountValue),
        (computeSize<ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'a>>(
          ReadArgs2<ValueFormat, ValueFormat> {
            first: valueFormat1Value,
            second: valueFormat2Value,
          },
        )
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self {
        _fontData: data,
        _fieldRanges: ranges,
        _valueFormat1: valueFormat1,
        _valueFormat2: valueFormat2,
      },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of PairValueRecords
  pub fn pairValueCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn pairValueCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of PairValueRecords, ordered by glyph ID of the second
  /// glyph.
  pub fn pairValueRecords(self: &Self) -> ComputedArray<
    'a,
    ReadArgs2<ValueFormat, ValueFormat>,
    PairValueRecord<'a>
  > {
    return match move ComputedArray<
      'a,
      ReadArgs2<ValueFormat, ValueFormat>,
      PairValueRecord<'a>
    >.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      ReadArgs2<ValueFormat, ValueFormat> { first: self._valueFormat1, second: self._valueFormat2 },
    ) {
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'a>>,
        ReadError
      >.Success {
        value
      } => value
      Result<
        ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'a>>,
        ReadError
      >.Failure {
        error
      } => ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'a>>.empty(
        ReadArgs2<ValueFormat, ValueFormat> {
          first: self._valueFormat1,
          second: self._valueFormat2,
        },
      )
    }
  }

  pub fn pairValueRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairSet<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<
    Self,
    ReadError
  > {
    return PairSet<'a>.read(data, args.first, args.second)
  }
}

impl<'a> MinByteRange<'a> for PairSet<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [PairSet]
pub struct PairValueRecord<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
  _valueFormat1: ValueFormat,
  _valueFormat2: ValueFormat,
}

impl<'a> Copy for PairValueRecord<'a> {}

impl<'a> PairValueRecord<'a> {
  pub fn readAt(
    data: FontData<'a>,
    position: usize,
    args: ReadArgs2<ValueFormat, ValueFormat>,
  ) -> Result<Self, ReadError> {
    let valueFormat1Value = args.first
    let valueFormat2Value = args.second
    let mut ranges = [ByteRange { start: 0, end: 0 }; 3]
    let mut end = position
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat1Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[1].end = end
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat2Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    )
    ranges[2].end = end
    let value = Self {
      _fontData: data,
      _fieldRanges: ranges,
      _valueFormat1: valueFormat1Value,
      _valueFormat2: valueFormat2Value,
    }
    if let Result<GlyphId16, ReadError>.Failure { error } = move FontData<'a>.readAt<GlyphId16>(
      &data,
      ranges[0].start,
    ) {
      return Result<Self, ReadError>.failResult(error)
    }
    if let Result<ValueRecord<'a>, ReadError>.Failure { error } = move readAtWithArgs<
      ValueFormat,
      ValueRecord<'a>
    >(data, ranges[1].start, value._valueFormat1) {
      return Result<Self, ReadError>.failResult(error)
    }
    if let Result<ValueRecord<'a>, ReadError>.Failure { error } = move readAtWithArgs<
      ValueFormat,
      ValueRecord<'a>
    >(data, ranges[2].start, value._valueFormat2) {
      return Result<Self, ReadError>.failResult(error)
    }
    return Result<Self, ReadError>.succeed(value)
  }

  pub fn default() -> Self {
    return PairValueRecord<'a>.readAt(
      FontData.defaultTableData(),
      0,
      ReadArgs2<ValueFormat, ValueFormat> {
        first: ValueFormat.empty(),
        second: ValueFormat.empty(),
      },
    )
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 3],
          _valueFormat1: ValueFormat.empty(),
          _valueFormat2: ValueFormat.empty(),
        },
      )
  }

  /// Glyph ID of second glyph in the pair (first glyph is listed in
  /// the Coverage table).
  pub fn secondGlyph(self: &Self) -> GlyphId16 {
    return match move FontData<'a>.readAt<GlyphId16>(&self._fontData, self._fieldRanges[0].start) {
      Result<GlyphId16, ReadError>.Success { value } => value
      Result<GlyphId16, ReadError>.Failure { error } => GlyphId16.new(0)
    }
  }

  /// Positioning data for the first glyph in the pair.
  pub fn valueRecord1(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._valueFormat1,
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }

  /// Positioning data for the second glyph in the pair.
  pub fn valueRecord2(self: &Self) -> ValueRecord<'a> {
    return match move readAtWithArgs<ValueFormat, ValueRecord<'a>>(
      self._fontData,
      self._fieldRanges[2].start,
      self._valueFormat2,
    ) {
      Result<ValueRecord<'a>, ReadError>.Success { value } => value
      Result<ValueRecord<'a>, ReadError>.Failure { error } => ValueRecord<'a>.default()
    }
  }
}

impl<'a> ComputeSize<ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord<'a> {
  fn computeSize(args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<usize, ReadError> {
    let valueFormat1Value = args.first
    let valueFormat2Value = args.second
    let mut end: usize = 0
    end = match move usize.checkedAdd(end, 2) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    end = match move usize.checkedAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat1Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    end = match move usize.checkedAdd(
      end,
      (computeSize<ValueFormat, ValueRecord<'a>>(valueFormat2Value)
        |> Result<usize, ReadError>.unwrapOr(0)),
    ) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return Result<usize, ReadError>.succeed(end)
  }
}

impl<'a> FontReadAt<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord<'a> {
  fn readAt(
    data: FontData<'a>,
    position: usize,
    args: ReadArgs2<ValueFormat, ValueFormat>,
  ) -> Result<Self, ReadError> {
    return PairValueRecord<'a>.readAt(data, position, args)
  }
}

impl<'a> FontRead<'a, ReadArgs2<ValueFormat, ValueFormat>> for PairValueRecord<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<ValueFormat, ValueFormat>) -> Result<
    Self,
    ReadError
  > {
    return PairValueRecord<'a>.readAt(data, 0, args)
  }
}

/// [Pair Adjustment Positioning Format 2](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#pair-adjustment-positioning-format-2-class-pair-adjustment): Class Pair Adjustment
pub struct PairPosFormat2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 9],
}

impl<'a> Copy for PairPosFormat2<'a> {}

impl<'a> PairPosFormat2<'a> {
  pub fn minSize() -> usize {
    return 16
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 16 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 9] = [ByteRange { start: 0, end: 0 }; 9]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let posFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[1].start, Offset16.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let valueFormat1Value = scalarOr<ValueFormat>(data, ranges[2].start, ValueFormat.empty())
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let valueFormat2Value = scalarOr<ValueFormat>(data, ranges[3].start, ValueFormat.empty())
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let classDef1OffsetValue = scalarOr<Offset16>(data, ranges[4].start, Offset16.new(0))
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let classDef2OffsetValue = scalarOr<Offset16>(data, ranges[5].start, Offset16.new(0))
    ranges[6].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[6].end = end
    let class1CountValue = scalarOr<u16>(data, ranges[6].start, 0)
    ranges[7].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[7].end = end
    let class2CountValue = scalarOr<u16>(data, ranges[7].start, 0)
    ranges[8].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(class1CountValue),
        (computeSize<ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'a>>(
          ReadArgs3<u16, ValueFormat, ValueFormat> {
            first: class2CountValue,
            second: valueFormat1Value,
            third: valueFormat2Value,
          },
        )
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[8].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier: format = 2
  pub fn posFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn posFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Offset to Coverage table, from beginning of PairPos subtable.
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = PairPosFormat2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// ValueRecord definition — for the first glyph of the pair (may
  /// be zero).
  pub fn valueFormat1(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[2].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat1ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// ValueRecord definition — for the second glyph of the pair
  /// (may be zero).
  pub fn valueFormat2(self: &Self) -> ValueFormat {
    return match move FontData<'a>.readAt<ValueFormat>(
      &self._fontData,
      self._fieldRanges[3].start,
    ) {
      Result<ValueFormat, ReadError>.Success { value } => value
      Result<ValueFormat, ReadError>.Failure { error } => ValueFormat.empty()
    }
  }

  pub fn valueFormat2ByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to ClassDef table, from beginning of PairPos subtable
  /// — for the first glyph of the pair.
  pub fn classDef1Offset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[4].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn classDef1(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = PairPosFormat2<'a>.classDef1Offset(self)
    return resolveWithArgs<(), ClassDef<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn classDef1OffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// Offset to ClassDef table, from beginning of PairPos subtable
  /// — for the second glyph of the pair.
  pub fn classDef2Offset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[5].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn classDef2(self: &Self) -> Result<ClassDef<'a>, ReadError> {
    let offset = PairPosFormat2<'a>.classDef2Offset(self)
