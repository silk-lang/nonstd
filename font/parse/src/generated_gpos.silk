/// Part of [MarkMarkPosFormat1]Class2Record
pub struct Mark2Array<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _markClassCount: u16,
}

impl<'a> Copy for Mark2Array<'a> {}

impl<'a> Mark2Array<'a> {
  pub fn default() -> Self {
    return Mark2Array<'a>.read(FontData.defaultTableData(), 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _markClassCount: 0,
        },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>, markClassCount: u16) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let markClassCountValue = markClassCount
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let mark2CountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        u16.toUsize(mark2CountValue),
        (computeSize<u16, Mark2Record<'a>>(markClassCountValue)
          |> Result<usize, ReadError>.unwrapOr(0)),
      ),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCount },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of Mark2 records
  pub fn mark2Count(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn mark2CountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of Mark2Records, in Coverage order.
  pub fn mark2Records(self: &Self) -> ComputedArray<'a, u16, Mark2Record<'a>> {
    return match move ComputedArray<'a, u16, Mark2Record<'a>>.new(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
      self._markClassCount,
    ) {
      Result<ComputedArray<'a, u16, Mark2Record<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, u16, Mark2Record<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        u16,
        Mark2Record<'a>
      >.empty(self._markClassCount)
    }
  }

  pub fn mark2RecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, u16> for Mark2Array<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return Mark2Array<'a>.read(data, args)
  }
}

