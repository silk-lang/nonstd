/// LigatureArray2 (ISO/IEC 14496-22:2026).
pub struct LigatureArray2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
  _markClassCount: u16,
}

impl<'a> Copy for LigatureArray2<'a> {}

impl<'a> LigatureArray2<'a> {
  pub fn default() -> Self {
    return LigatureArray2<'a>.read(FontData.defaultTableData(), 0)
      |> Result<Self, ReadError>.unwrapOr(
        Self {
          _fontData: FontData.new(b""),
          _fieldRanges: [ByteRange { start: 0, end: 0 }; 2],
          _markClassCount: 0,
        },
      )
  }

  pub fn minSize() -> usize {
    return 3
  }

  pub fn read(data: FontData<'a>, markClassCount: u16) -> Result<Self, ReadError> {
    if FontData.len(&data) < 3 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    let markClassCountValue = markClassCount
    ranges[0].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[0].end = end
    let ligatureCountValue = scalarOr<Uint24>(data, ranges[0].start, Uint24.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(ligatureCountValue)), 3),
    )
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(
      Self { _fontData: data, _fieldRanges: ranges, _markClassCount: markClassCount },
    )
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of LigatureAttach table offsets
  pub fn ligatureCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[0].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn ligatureCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of offsets to LigatureAttach tables. Offsets are from
  /// beginning of LigatureArray2 table, ordered by ligatureCoverage
  /// index.
  pub fn ligatureAttachOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn ligatureAttaches(self: &Self) -> ArrayOfOffsets<'a, u16, LigatureAttach2<'a>, Offset24> {
    return ArrayOfOffsets<'a, u16, LigatureAttach2<'a>, Offset24>.new(
      LigatureArray2<'a>.ligatureAttachOffsets(self),
      self._fontData,
      self._markClassCount,
    )
  }

  pub fn ligatureAttachOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, u16> for LigatureArray2<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return LigatureArray2<'a>.read(data, args)
  }
}

