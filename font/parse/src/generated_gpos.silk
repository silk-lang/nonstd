}

/// [Anchor Table Format 3](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#anchor-table-format-3-design-units-plus-device-or-variationindex-tables): Design Units Plus Device or VariationIndex Tables
pub struct AnchorFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for AnchorFormat3<'a> {}

impl<'a> AnchorFormat3<'a> {
  pub fn minSize() -> usize {
    return 10
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 10 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let anchorFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let xCoordinateValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let yCoordinateValue = scalarOr<i16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let xDeviceOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[3].start,
      Nullable<Offset16>.default(),
    )
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let yDeviceOffsetValue = scalarOr<Nullable<Offset16>>(
      data,
      ranges[4].start,
      Nullable<Offset16>.default(),
    )
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier, = 3
  pub fn anchorFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn anchorFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Horizontal value, in design units
  pub fn xCoordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn xCoordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Vertical value, in design units
  pub fn yCoordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[2].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn yCoordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Offset to Device table (non-variable font) / VariationIndex
  /// table (variable font) for X coordinate, from beginning of
  /// Anchor table (may be NULL)
  pub fn xDeviceOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[3].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn xDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    let offset = AnchorFormat3<'a>.xDeviceOffset(self)
    return resolveNullableWithArgs<(), DeviceOrVariationIndex<'a>, Offset16>(
      &offset,
      self._fontData,
      (),
    )
  }

  pub fn xDeviceOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// Offset to Device table (non-variable font) / VariationIndex
  /// table (variable font) for Y coordinate, from beginning of
  /// Anchor table (may be NULL)
  pub fn yDeviceOffset(self: &Self) -> Nullable<Offset16> {
    return match move FontData<'a>.readAt<Nullable<Offset16>>(
      &self._fontData,
      self._fieldRanges[4].start,
    ) {
      Result<Nullable<Offset16>, ReadError>.Success { value } => value
      Result<Nullable<Offset16>, ReadError>.Failure { error } => Nullable<Offset16>.default()
    }
  }

  pub fn yDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    let offset = AnchorFormat3<'a>.yDeviceOffset(self)
    return resolveNullableWithArgs<(), DeviceOrVariationIndex<'a>, Offset16>(
      &offset,
      self._fontData,
      (),
    )
  }

  pub fn yDeviceOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }
}

impl<'a> FontRead<'a, ()> for AnchorFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return AnchorFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for AnchorFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for AnchorFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[4].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[4].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Mark Array Table](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#mark-array-table)
pub struct MarkArray<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 2],
}

impl<'a> Copy for MarkArray<'a> {}

impl<'a> MarkArray<'a> {
  pub fn default() -> Self {
    return MarkArray<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let markCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markCountValue), 4))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of MarkRecords
  pub fn markCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn markCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of MarkRecords, ordered by corresponding glyphs in the
  /// associated mark Coverage table.
  pub fn markRecords(self: &Self) -> ComputedArray<'a, (), MarkRecord<'a>> {
    return match move recordArray<MarkRecord<'a>>(
      self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ComputedArray<'a, (), MarkRecord<'a>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), MarkRecord<'a>>, ReadError>.Failure { error } => ComputedArray<
        'a,
        (),
        MarkRecord<'a>
      >.empty(())
    }
  }

  pub fn markRecordsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for MarkArray<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MarkArray<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for MarkArray<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Part of [MarkArray]
pub struct MarkRecord<'a> {
  _fontData: FontData<'a>,
  position: usize,
}

impl<'a> Copy for MarkRecord<'a> {}

impl<'a> MarkRecord<'a> {
  pub fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    if position > FontData.len(&data) || 4 > FontData.len(&data) - position {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Class defined for the associated mark.
  pub fn markClass(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// Offset to Anchor table, from beginning of MarkArray table.
  pub fn markAnchorOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, (self.position + 2)) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn markAnchor(self: &Self, data: FontData<'a>) -> Result<AnchorTable<'a>, ReadError> {
    let offset = MarkRecord<'a>.markAnchorOffset(self)
    return resolveWithArgs<(), AnchorTable<'a>, Offset16>(offset, data, ())
  }
}

impl<'a> FixedSize for MarkRecord<'a> {
  fn rawByteLen() -> usize {
    return 4
  }
}

impl<'a> ComputeSize<()> for MarkRecord<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(4)
  }
}

impl<'a> FontReadAt<'a, ()> for MarkRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return MarkRecord<'a>.readAt(data, position, ())
  }
}

/// [Lookup Type 1](https://docs.microsoft.com/en-us/typography/opentype/spec/gpos#lookup-type-1-single-adjustment-positioning-subtable): Single Adjustment Positioning Subtable
pub union SinglePos<'a> {
  Format1 { pub value: SinglePosFormat1<'a> },
  Format2 { pub value: SinglePosFormat2<'a> },
  Format3 { pub value: SinglePosFormat3<'a> },
  Format4 { pub value: SinglePosFormat4<'a> },
}

impl<'a> Copy for SinglePos<'a> {}

impl<'a> SinglePos<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move SinglePosFormat1<'a>.read(data) {
          Result<SinglePosFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SinglePos<'a>.Format1 { value: value })
          Result<SinglePosFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move SinglePosFormat2<'a>.read(data) {
          Result<SinglePosFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SinglePos<'a>.Format2 { value: value })
          Result<SinglePosFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move SinglePosFormat3<'a>.read(data) {
          Result<SinglePosFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SinglePos<'a>.Format3 { value: value })
          Result<SinglePosFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      4 => {
        return match move SinglePosFormat4<'a>.read(data) {
          Result<SinglePosFormat4<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(SinglePos<'a>.Format4 { value: value })
          Result<SinglePosFormat4<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      SinglePos<'a>.Format1 { value } => SinglePosFormat1<'a>.offsetData(&value)
      SinglePos<'a>.Format2 { value } => SinglePosFormat2<'a>.offsetData(&value)
      SinglePos<'a>.Format3 { value } => SinglePosFormat3<'a>.offsetData(&value)
      SinglePos<'a>.Format4 { value } => SinglePosFormat4<'a>.offsetData(&value)
    }
  }

  /// Format identifier: format = 1
  pub fn posFormat(self: &Self) -> u16 {
    return match &self.* {
      SinglePos<'a>.Format1 { value } => SinglePosFormat1<'a>.posFormat(&value)
      SinglePos<'a>.Format2 { value } => SinglePosFormat2<'a>.posFormat(&value)
      SinglePos<'a>.Format3 { value } => SinglePosFormat3<'a>.posFormat(&value)
      SinglePos<'a>.Format4 { value } => SinglePosFormat4<'a>.posFormat(&value)
    }
  }

  /// Defines the types of data in the ValueRecord.
  pub fn valueFormat(self: &Self) -> ValueFormat {
    return match &self.* {
      SinglePos<'a>.Format1 { value } => SinglePosFormat1<'a>.valueFormat(&value)
      SinglePos<'a>.Format2 { value } => SinglePosFormat2<'a>.valueFormat(&value)
      SinglePos<'a>.Format3 { value } => SinglePosFormat3<'a>.valueFormat(&value)
      SinglePos<'a>.Format4 { value } => SinglePosFormat4<'a>.valueFormat(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for SinglePos<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return SinglePos<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for SinglePos<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      SinglePos<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      SinglePos<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      SinglePos<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
      SinglePos<'a>.Format4 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
