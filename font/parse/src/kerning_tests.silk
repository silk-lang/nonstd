        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(88), GlyphId.new(83)))) == -20,
        "class adjustment",
      )
    }
    _ => {
      run Testing.expect(false, "format two")
    }
  }
  let subtable1 = run must(run some(KernSubtables.next(&mut iter)))
  match run must(KernSubtable.kind(&subtable1)) {
    KernSubtableKind<'static>.Format2 { value } => {
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(67)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(69)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(70)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(71)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(73)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(81)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(60), GlyphId.new(83)))) == -100,
        "class adjustment",
      )
    }
    _ => {
      run Testing.expect(false, "format two")
    }
  }
  run Testing.expect(
    match move KernSubtables.next(&mut iter) {
      Option<Result<KernSubtable<'static>, ReadError>>.None => true
      _ => false
    },
    "three subtables",
  )
}

test effect fn format3() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KernSubtable3.read(
      FontData.new(
        b"\x00\x05\x04\x03\x02\x00\x00\x00\xff\xf6\xff\xec\x00\x0c\x00\x02\x01\x01\x02\x00\x01\x01\x00\x01\x00\x01\x02\x03\x02\x01",
      ),
    ),
  )
  let expected: [i32; 25] = [
    0,
    -10,
    -10,
    0,
    -10,
    -20,
    -10,
    -10,
    -20,
    -10,
    -20,
    12,
    12,
    -20,
    12,
    -20,
    12,
    12,
    -20,
    12,
    -20,
    -10,
    -10,
    -20,
    -10,
  ]
  let mut l: u32 = 0
  while l < 5 {
    let mut r: u32 = 0
    while r < 5 {
      run Testing.expect(
        (run some(KernSubtable3.kerning(&table, GlyphId.new(l), GlyphId.new(r))))
          == expected[u32.toUsize(l * 5 + r)],
        "class matrix adjustment",
      )
      r = r + 1
    }
    l = l + 1
  }
}
