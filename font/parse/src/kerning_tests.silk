effect fn checkKern0(table: &KernSubtable<'static>) -> ()
  ! AssertionError<'static> {
  let parsed = run must(KernSubtable.kind(table))
  match parsed {
    KernSubtableKind<'static>.Format0 { value } => {
      let left: [u32; 3] = [4, 4, 5]
      let right: [u32; 3] = [12, 28, 40]
      let adjustment: [i32; 3] = [-40, 40, -50]
      let pairs = KernSubtable0.pairs(&value)
      run Testing.expect(
        ComputedArray<'static, (), KerxSubtable0Pair<'static>>.len(&pairs) == 3,
        "three kerning pairs",
      )
      let mut i: usize = 0
      while i < 3 {
        let pair = run must(ComputedArray<'static, (), KerxSubtable0Pair<'static>>.get(&pairs, i))
        run Testing.expect(
          GlyphId16.toU32(KerxSubtable0Pair.left(&pair)) == left[i]
            && GlyphId16.toU32(KerxSubtable0Pair.right(&pair)) == right[i]
            && i16.toI32(KerxSubtable0Pair.value(&pair)) == adjustment[i],
          "pair fields",
        )
        run Testing.expect(
          (run some(KernSubtable0.kerning(&value, GlyphId.new(left[i]), GlyphId.new(right[i]))))
            == adjustment[i],
          "pair lookup",
        )
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "format zero")
    }
  }
}

test effect fn otFormat0() -> ()
  ! AssertionError<'static> {
  let table = run must(KernKern.read(FontData.new(Fixtures.otKern0())))
  match table {
    KernKern<'static>.Ot { value } => {
      run Testing.expect(KernOtKern.nTables(&value) == 1, "one subtable")
      run Testing.expect(KernOtKern.version(&value) == 0, "OT version")
    }
    _ => {
      run Testing.expect(false, "container version")
    }
  }
  let mut iter = KernKern.subtables(&table)
  let subtable = run must(run some(KernSubtables.next(&mut iter)))
  run Testing.expect(KernSubtable.isHorizontal(&subtable), "horizontal kerning")
  match subtable {
    KernSubtable<'static>.Ot { value } => {
      run Testing.expect(
        KernOtSubtable.coverage(&value) == 1 && KernOtSubtable.length(&value) == 32,
        "subtable header",
      )
    }
    _ => {
      run Testing.expect(false, "subtable version")
    }
  }
  run checkKern0(&subtable)
  run Testing.expect(
    match move KernSubtables.next(&mut iter) {
      Option<Result<KernSubtable<'static>, ReadError>>.None => true
      _ => false
    },
    "subtable exhaustion",
  )
}

test effect fn aatFormat0() -> ()
  ! AssertionError<'static> {
  let table = run must(KernKern.read(FontData.new(Fixtures.aatKern0())))
  match table {
    KernKern<'static>.Aat { value } => {
      run Testing.expect(KernAatKern.nTables(&value) == 1, "one subtable")
      let version = KernAatKern.version(&value)
      run Testing.expect(version.major == 1 && version.minor == 0, "AAT version")
    }
    _ => {
      run Testing.expect(false, "container version")
    }
  }
  let mut iter = KernKern.subtables(&table)
  let subtable = run must(run some(KernSubtables.next(&mut iter)))
  run Testing.expect(KernSubtable.isHorizontal(&subtable), "horizontal kerning")
  match subtable {
    KernSubtable<'static>.Aat { value } => {
      run Testing.expect(
        KernAatSubtable.coverage(&value) == 0 && KernAatSubtable.length(&value) == 34,
        "subtable header",
      )
    }
    _ => {
      run Testing.expect(false, "subtable version")
    }
  }
  run checkKern0(&subtable)
  run Testing.expect(
    match move KernSubtables.next(&mut iter) {
      Option<Result<KernSubtable<'static>, ReadError>>.None => true
      _ => false
    },
    "subtable exhaustion",
  )
}

test effect fn format2() -> ()
  ! AssertionError<'static> {
  let table = run must(KernKern.read(FontData.new(Fixtures.kern2())))
  let mut iter = KernKern.subtables(&table)
  drop run must(run some(KernSubtables.next(&mut iter)))
  let subtable0 = run must(run some(KernSubtables.next(&mut iter)))
  match run must(KernSubtable.kind(&subtable0)) {
    KernSubtableKind<'static>.Format2 { value } => {
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(68), GlyphId.new(60)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(68), GlyphId.new(61)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(68), GlyphId.new(88)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(67)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(69)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(70)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(71)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(73)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(81)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(69), GlyphId.new(83)))) == -30,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(67)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(69)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(70)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(71)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(73)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(81)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(72), GlyphId.new(83)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(81), GlyphId.new(60)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(81), GlyphId.new(61)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(81), GlyphId.new(88)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(82), GlyphId.new(60)))) == -100,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(82), GlyphId.new(61)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(82), GlyphId.new(88)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(67)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(69)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(70)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(71)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(73)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(81)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(84), GlyphId.new(83)))) == -50,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(88), GlyphId.new(67)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(88), GlyphId.new(69)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(88), GlyphId.new(70)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
        (run some(KernSubtable2.kerning(&value, GlyphId.new(88), GlyphId.new(71)))) == -20,
        "class adjustment",
      )
      run Testing.expect(
