effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "kerning fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "kerning value exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

test effect fn parseSubtable0() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KerxSubtable0.read(
      FontData.new(
        b"\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\xff\xf6\x00\x00\x00\x03\xff\xfa\x00\x02\x00\x04\x00\x16\x00\x08\x00\x02\x01\xf4\x00\x09\x00\x0c\xfc\x18\x00\x0a\x00\x01\x00\x2a",
      ),
    ),
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(0), GlyphId.new(1)))) == -10,
    "pair adjustment",
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(0), GlyphId.new(3)))) == -6,
    "pair adjustment",
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(2), GlyphId.new(4)))) == 22,
    "pair adjustment",
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(8), GlyphId.new(2)))) == 500,
    "pair adjustment",
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(9), GlyphId.new(12)))) == -1000,
    "pair adjustment",
  )
  run Testing.expect(
    (run some(KerxSubtable0.kerning(&table, GlyphId.new(10), GlyphId.new(1)))) == 42,
    "pair adjustment",
  )
}

test effect fn parseSubtable1() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KerxSubtable1.read(
      FontData.new(
        b"\x00\x00\x00\x06\x00\x00\x00\x24\x00\x00\x00\x48\x00\x00\x00\x6c\x00\x00\x00\x14\xff\xd8\xff\xec\xff\xf6\x00\x00\x00\x0a\x00\x14\x00\x28\x00\x50\x00\x06\x00\x04\x00\x05\x00\x10\x00\x02\x00\x00\x00\x32\x00\x04\x00\x33\x00\x04\x00\x50\x00\x05\x00\xc9\x00\x04\x00\xca\x00\x04\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x02\x00\x00\x00\x00\x00\x03",
      ),
    ),
  )
  let expected: [i16; 8] = [-40, -20, -10, 0, 10, 20, 40, 80]
  let values = table.values
  let mut i: usize = 0
  while i < 8 {
    run Testing.expect(
      (run some(ScalarArray<i16>.get(&values, i))) == expected[i],
      "state action data",
    )
    i = i + 1
  }
}

test effect fn parseSubtable4ControlPoints() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KerxSubtable4.read(
      FontData.new(
        b"\x00\x00\x00\x06\x00\x00\x00\x24\x00\x00\x00\x48\x00\x00\x00\x6c\x00\x00\x00\x14\x00\x00\x00\x02\x00\x02\x00\x04\x00\x04\x00\x08\x00\x08\x00\x10\x00\x06\x00\x04\x00\x05\x00\x10\x00\x02\x00\x00\x00\x32\x00\x04\x00\x33\x00\x04\x00\x50\x00\x05\x00\xc9\x00\x04\x00\xca\x00\x04\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x02\x00\x00\x00\x00\x00\x03",
      ),
