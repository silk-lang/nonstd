        b"\x00\x00\x00\x06\x00\x00\x00\x34\x00\x00\x00\x58\x00\x00\x00\x7c\x80\x00\x00\x14\xff\xf6\x00\x0a\xff\xec\x00\x14\x00\x01\x00\x02\x00\x03\x00\x04\xff\xff\xff\xfe\xff\xfd\xff\xfc\x00\x0a\xff\xf6\x00\x14\xff\xec\x00\x06\x00\x04\x00\x05\x00\x10\x00\x02\x00\x00\x00\x32\x00\x04\x00\x33\x00\x04\x00\x50\x00\x05\x00\xc9\x00\x04\x00\xca\x00\x04\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x02\x00\x00\x00\x00\x00\x03",
