test effect fn parseSubtable2() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KerxSubtable2.read(
      FontData.new(
        b"\x00\x00\x00\x03\x00\x00\x00\x1c\x00\x00\x00\x26\x00\x00\x00\x30\x00\x00\x00\x00\x00\x06\x00\x03\x00\x06\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x00\x00\x0a\x00\x14\x00\x1e\xff\xf6\xff\xec\x00\x08\x00\x04\xff\xfe",
      ),
    ),
  )
  let expected: [i32; 16] = [0, 10, 20, 0, 8, 4, -2, 8, 30, -10, -20, 30, 8, 4, -2, 8]
  let mut l: u32 = 0
  while l < 4 {
    let mut r: u32 = 0
    while r < 4 {
      run Testing.expect(
        (run some(KerxSubtable2.kerning(&table, GlyphId.new(l), GlyphId.new(r))))
          == expected[u32.toUsize(l * 4 + r)],
        "class kerning adjustment",
      )
      r = r + 1
    }
    l = l + 1
  }
}

test effect fn parseSubtable6Short() -> ()
  ! AssertionError<'static> {
  let table = run must(
    KerxSubtable6.readWithArgs(
      FontData.new(
        b"\x00\x00\x00\x00\x00\x03\x00\x03\x00\x00\x00\x20\x00\x00\x00\x2a\x00\x00\x00\x34\x00\x00\x00\x00\x00\x06\x00\x03\x00\x06\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x00\x00\x0a\x00\x14\x00\x1e\xff\xf6\xff\xec\x00\x08\x00\x04\xff\xfe",
      ),
      0,
    ),
  )
  run Testing.expect(
    match &table {
      KerxSubtable6<'static>.ShortValues { rows, columns, array, vector } => true
      _ => false
    },
    "value width",
  )
  let expected: [i32; 16] = [0, 10, 20, 0, 8, 4, -2, 8, 30, -10, -20, 30, 8, 4, -2, 8]
  let mut l: u32 = 0
  while l < 4 {
    let mut r: u32 = 0
    while r < 4 {
      run Testing.expect(
        (run some(KerxSubtable6.kerning(&table, GlyphId.new(l), GlyphId.new(r))))
          == expected[u32.toUsize(l * 4 + r)],
        "class kerning adjustment",
      )
      r = r + 1
    }
    l = l + 1
  }
}

