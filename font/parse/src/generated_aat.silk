      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<Self, ReadError>.succeed(Self { _fontData: data, position: position })
  }

  pub fn default() -> Self {
    return Self { _fontData: FontData.defaultTableData(), position: 0 }
  }

  /// Last glyph index in this segment.
  pub fn lastGlyph(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 0)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// First glyph index in this segment.
  pub fn firstGlyph(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 2)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  /// A 16-bit offset from the start of the table to the data.
  pub fn valueOffset(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, (self.position + 4)) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }
}

impl<'a> FixedSize for LookupSegment4<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> ComputeSize<()> for LookupSegment4<'a> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(6)
  }
}

impl<'a> FontReadAt<'a, ()> for LookupSegment4<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    return LookupSegment4<'a>.readAt(data, position, ())
  }
}

/// Single table format. The lookup data is a sorted list of
/// <glyph index,lookup value> pairs.
pub struct Lookup6<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 7],
}

impl<'a> Copy for Lookup6<'a> {}

impl<'a> Lookup6<'a> {
  pub fn minSize() -> usize {
    return 12
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 12 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 7] = [ByteRange { start: 0, end: 0 }; 7]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let unitSizeValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let nUnitsValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let searchRangeValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[4].end = end
    let entrySelectorValue = scalarOr<u16>(data, ranges[4].start, 0)
    ranges[5].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[5].end = end
    let rangeShiftValue = scalarOr<u16>(data, ranges[5].start, 0)
    ranges[6].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        usize.saturatingMultiply(
          usize.saturatingAdd(u16.toUsize(unitSizeValue), 0),
          u16.toUsize(nUnitsValue),
        ),
        1,
      ),
    )
    ranges[6].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 6.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Size of a lookup unit for this search in bytes.
  pub fn unitSize(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn unitSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Number of units of the preceding size to be searched.
  pub fn nUnits(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn nUnitsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// The value of unitSize times the largest power of 2 that is less than or equal to the value of nUnits. 
  pub fn searchRange(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn searchRangeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// The log base 2 of the largest power of 2 less than or equal to the value of nUnits.
  pub fn entrySelector(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[4].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn entrySelectorByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[4]
  }

  /// The value of unitSize times the difference of the value of nUnits minus the largest power of 2 less than or equal to the value of nUnits.
  pub fn rangeShift(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[5].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn rangeShiftByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[5]
  }

  /// Values, indexed by glyph index.
  pub fn entriesData(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[6].start,
      self._fieldRanges[6].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn entriesDataByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[6]
  }
}

impl<'a> FontRead<'a, ()> for Lookup6<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Lookup6<'a>.read(data)
  }
}

impl<'a> Format<u16> for Lookup6<'a> {
  fn formatValue() -> u16 {
    return 6
  }
}

impl<'a> MinByteRange<'a> for Lookup6<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[6].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[6].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Trimmed array format. The lookup data is a simple trimmed array
/// indexed by glyph index.
pub struct Lookup8<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for Lookup8<'a> {}

impl<'a> Lookup8<'a> {
  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let firstGlyphValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(glyphCountValue), 2))
    ranges[3].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 8.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// First glyph index included in the trimmed array.
  pub fn firstGlyph(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn firstGlyphByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Total number of glyphs (equivalent to the last glyph minus the value
  /// of firstGlyph plus 1).
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// The lookup values (indexed by the glyph index minus the value of
  /// firstGlyph). Entries in the value array must be two bytes.
  pub fn valueArray(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[3].start,
      self._fieldRanges[3].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn valueArrayByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

impl<'a> FontRead<'a, ()> for Lookup8<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Lookup8<'a>.read(data)
  }
}

impl<'a> Format<u16> for Lookup8<'a> {
  fn formatValue() -> u16 {
    return 8
  }
}

impl<'a> MinByteRange<'a> for Lookup8<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[3].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[3].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// Trimmed array format. The lookup data is a simple trimmed array
/// indexed by glyph index.
pub struct Lookup10<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 5],
}

impl<'a> Copy for Lookup10<'a> {}

impl<'a> Lookup10<'a> {
  pub fn minSize() -> usize {
    return 8
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 8 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 5] = [ByteRange { start: 0, end: 0 }; 5]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let unitSizeValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let firstGlyphValue = scalarOr<u16>(data, ranges[2].start, 0)
    ranges[3].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[3].end = end
    let glyphCountValue = scalarOr<u16>(data, ranges[3].start, 0)
    ranges[4].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(
        usize.saturatingMultiply(
          usize.saturatingAdd(u16.toUsize(glyphCountValue), 0),
          u16.toUsize(unitSizeValue),
        ),
        1,
      ),
    )
    ranges[4].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format number is set to 10.
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Size of a lookup unit for this lookup table in bytes. Allowed values
  /// are 1, 2, 4, and 8.
  pub fn unitSize(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn unitSizeByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// First glyph index included in the trimmed array.
  pub fn firstGlyph(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[2].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn firstGlyphByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Total number of glyphs (equivalent to the last glyph minus the value
  /// of firstGlyph plus 1).
  pub fn glyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[3].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn glyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }

  /// The lookup values (indexed by the glyph index minus the value of
  /// firstGlyph).
  pub fn valuesData(self: &Self) -> ScalarArray<'a, u8> {
    return match move FontData<'a>.readArray<u8>(
      &self._fontData,
      self._fieldRanges[4].start,
      self._fieldRanges[4].end,
    ) {
      Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u8>, ReadError>.Failure { error } => ScalarArray<u8>.empty()
    }
  }

  pub fn valuesDataByteRange(self: &Self) -> ByteRange {
