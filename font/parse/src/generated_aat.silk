/// Header for an extended state table.
pub struct StxHeader<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 4],
}

impl<'a> Copy for StxHeader<'a> {}

impl<'a> StxHeader<'a> {
  pub fn default() -> Self {
    return StxHeader<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 4] },
      )
  }

  pub fn minSize() -> usize {
    return 16
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 16 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 4] = [ByteRange { start: 0, end: 0 }; 4]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let nClassesValue = scalarOr<u32>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[1].end = end
    let classTableOffsetValue = scalarOr<Offset32>(data, ranges[1].start, Offset32.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[2].end = end
    let stateArrayOffsetValue = scalarOr<Offset32>(data, ranges[2].start, Offset32.new(0))
    ranges[3].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[3].end = end
    let entryTableOffsetValue = scalarOr<Offset32>(data, ranges[3].start, Offset32.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of classes, which is the number of 16-bit entry indices in a single line in the state array.
  pub fn nClasses(self: &Self) -> u32 {
    return match move FontData<'a>.readAt<u32>(&self._fontData, self._fieldRanges[0].start) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => 0
    }
  }

  pub fn nClassesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Byte offset from the beginning of the state table to the class subtable.
  pub fn classTableOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[1].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn classTable(self: &Self) -> Result<LookupU16<'a>, ReadError> {
    let offset = StxHeader<'a>.classTableOffset(self)
    return resolveWithArgs<(), LookupU16<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn classTableOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Byte offset from the beginning of the state table to the state array.
  pub fn stateArrayOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn stateArray(self: &Self) -> Result<RawWords<'a>, ReadError> {
    let offset = StxHeader<'a>.stateArrayOffset(self)
    return resolveWithArgs<(), RawWords<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn stateArrayOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }

  /// Byte offset from the beginning of the state table to the entry subtable.
  pub fn entryTableOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[3].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn entryTable(self: &Self) -> Result<RawBytes<'a>, ReadError> {
    let offset = StxHeader<'a>.entryTableOffset(self)
    return resolveWithArgs<(), RawBytes<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn entryTableOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[3]
  }
}

