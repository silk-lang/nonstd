pub interface LookupValue {
  fn fromU16(value: u16) -> Self

  fn fromU32(value: u32) -> Self
}

impl LookupValue for u16 {
  fn fromU16(value: u16) -> Self {
    return value
  }

  fn fromU32(value: u32) -> Self {
    return u32.toU16(value & 65535)
  }
}

impl LookupValue for u32 {
  fn fromU16(value: u16) -> Self {
    return u16.toU32(value)
  }

  fn fromU32(value: u32) -> Self {
    return value
  }
}

impl LookupValue for GlyphId16 {
  fn fromU16(value: u16) -> Self {
    return GlyphId16.new(value)
  }

  fn fromU32(value: u32) -> Self {
    return GlyphId16.new(u32.toU16(value & 65535))
  }
}

fn fromLookupU16<T: LookupValue>(value: u16) -> T {
  return LookupValue.fromU16(value)
}

fn fromLookupU32<T: LookupValue>(value: u32) -> T {
  return LookupValue.fromU32(value)
}

pub struct TypedLookup<'a, T> {
  pub lookup: Lookup<'a>,
}

impl<'a, T> Copy for TypedLookup<'a, T> {}

impl<'a, T> TypedLookup<'a, T> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    return match move Lookup.read(data) {
      Result<Lookup<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
        Self { lookup: value },
      )
      Result<Lookup<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(error)
    }
  }

  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    return Lookup<'a>.value<T>(&self.lookup, index)
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return Lookup.offsetData(&self.lookup)
  }
}

impl<'a, T> FontRead<'a, ()> for TypedLookup<'a, T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return TypedLookup<'a, T>.read(data)
  }
}

pub type LookupU16<'a> = TypedLookup<'a, u16>

pub type LookupU32<'a> = TypedLookup<'a, u32>

pub type LookupGlyphId<'a> = TypedLookup<'a, GlyphId16>

impl<'a> Lookup0<'a> {
  pub fn values<T: LookupValue + Scalar + Copy>(self: &Self) -> Result<
    ScalarArray<'a, T>,
    ReadError
  > {
    let data = ScalarArray<u8>.offsetData(&Lookup0.valuesData(self))
    let width = rawByteLen<T>()
    if width == 0 {
      return Result<ScalarArray<'a, T>, ReadError>.failResult(ReadError.InvalidArrayLen)
    }
    return FontData<'a>.readArray<T>(&data, 0, FontData.len(&data) / width * width)
  }

  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let values = match move Lookup0<'a>.values<T>(self) {
      Result<ScalarArray<'a, T>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, T>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    return match move ScalarArray<T>.get(&values, u16.toUsize(index)) {
      Option<T>.Some { value } => Result<T, ReadError>.succeed(value)
      _ => Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

pub struct LookupSegment2<T> {
  pub lastGlyph: u16,
  pub firstGlyph: u16,
  pub value: T,
}

impl<T: Copy> Copy for LookupSegment2<T> {}

impl<T: Scalar> ComputeSize<()> for LookupSegment2<T> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(4 + rawByteLen<T>())
  }
}

impl<T: Scalar> FixedSize for LookupSegment2<T> {
  fn rawByteLen() -> usize {
    return 4 + rawByteLen<T>()
  }
}

impl<'a, T: Scalar> FontReadAt<'a, ()> for LookupSegment2<T> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    let tail = match move FontData.splitOff(&data, position) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let last = match move FontData<'a>.readAt<u16>(&tail, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let first = match move FontData<'a>.readAt<u16>(&tail, 2) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let value = match move FontData<'a>.readAt<T>(&tail, 4) {
      Result<T, ReadError>.Success { value } => move value
      Result<T, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { lastGlyph: last, firstGlyph: first, value: move value },
    )
  }
}

impl<'a> Lookup2<'a> {
  pub fn segments<T: LookupValue + Scalar + Copy>(self: &Self) -> Result<
    ComputedArray<'a, (), LookupSegment2<T>>,
    ReadError
  > {
    let data = ScalarArray<u8>.offsetData(&Lookup2.segmentsData(self))
    return ComputedArray<'a, (), LookupSegment2<T>>.new(
      data,
      0,
      usize.saturatingMultiply(
        u16.toUsize(Lookup2.nUnits(self)),
        usize.saturatingAdd(4, rawByteLen<T>()),
      ),
      (),
    )
  }

  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let segments = match move Lookup2<'a>.segments<T>(self) {
      Result<ComputedArray<'a, (), LookupSegment2<T>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), LookupSegment2<T>>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    let mut low: usize = 0
    let mut size = ComputedArray<'a, (), LookupSegment2<T>>.len(&segments)
    if size == 0 {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }

    // Preserve Rust's final candidate on unsorted data, as well as equal keys.
    while size > 1 {
      let half = size / 2
      let mid = low + half
      let item = match move ComputedArray<'a, (), LookupSegment2<T>>.get(&segments, mid) {
        Result<LookupSegment2<T>, ReadError>.Success { value } => value
        Result<LookupSegment2<T>, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      if item.firstGlyph <= index {
        low = mid
      }
      size = size - half
    }
    let mut item = match move ComputedArray<'a, (), LookupSegment2<T>>.get(&segments, low) {
      Result<LookupSegment2<T>, ReadError>.Success { value } => value
      Result<LookupSegment2<T>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    if item.firstGlyph > index && low > 0 {
      item = match move ComputedArray<'a, (), LookupSegment2<T>>.get(&segments, low - 1) {
        Result<LookupSegment2<T>, ReadError>.Success { value } => value
        Result<LookupSegment2<T>, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
    }
    if index >= item.firstGlyph && index <= item.lastGlyph {
      return Result<T, ReadError>.succeed(item.value)
    }
    return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
  }
}

impl<'a> Lookup4<'a> {
  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let segments = Lookup4.segments(self)
    let mut low: usize = 0
    let mut size = ComputedArray<'a, (), LookupSegment4<'a>>.len(&segments)
    if size == 0 {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }

    // Preserve Rust's final candidate on unsorted data, as well as equal keys.
    while size > 1 {
      let half = size / 2
      let mid = low + half
      let item = match move ComputedArray<'a, (), LookupSegment4<'a>>.get(&segments, mid) {
        Result<LookupSegment4<'a>, ReadError>.Success { value } => value
        Result<LookupSegment4<'a>, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      if LookupSegment4.firstGlyph(&item) <= index {
        low = mid
      }
      size = size - half
    }
    let mut item = match move ComputedArray<'a, (), LookupSegment4<'a>>.get(&segments, low) {
      Result<LookupSegment4<'a>, ReadError>.Success { value } => value
      Result<LookupSegment4<'a>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    if LookupSegment4.firstGlyph(&item) > index && low > 0 {
      item = match move ComputedArray<'a, (), LookupSegment4<'a>>.get(&segments, low - 1) {
        Result<LookupSegment4<'a>, ReadError>.Success { value } => value
        Result<LookupSegment4<'a>, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
    }
    if index < LookupSegment4.firstGlyph(&item) || index > LookupSegment4.lastGlyph(&item) {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let offset = usize.saturatingAdd(
      u16.toUsize(LookupSegment4.valueOffset(&item)),
      usize.saturatingMultiply(
        u16.toUsize(index - LookupSegment4.firstGlyph(&item)),
        rawByteLen<T>(),
      ),
    )
    return FontData<'a>.readAt<T>(&self._fontData, offset)
  }

  pub fn segmentValues<T: LookupValue + Scalar + Copy>(self: &Self, segment: usize) -> Result<
    ScalarArray<'a, T>,
    ReadError
  > {
    let item = match move ComputedArray<'a, (), LookupSegment4<'a>>.get(
      &Lookup4.segments(self),
      segment,
    ) {
      Result<LookupSegment4<'a>, ReadError>.Success { value } => value
      Result<LookupSegment4<'a>, ReadError>.Failure { error } => {
        return Result<ScalarArray<'a, T>, ReadError>.failResult(error)
      }
    }
    let first = LookupSegment4.firstGlyph(&item)
    let last = LookupSegment4.lastGlyph(&item)
    if last < first {
      return Result<ScalarArray<'a, T>, ReadError>.failResult(
        ReadError.MalformedData { message: "invalid segment in format 4 AAT lookup table" },
      )
    }
    let offset = u16.toUsize(LookupSegment4.valueOffset(&item))
    return FontData<'a>.readArray<T>(
      &self._fontData,
      offset,
      usize.saturatingAdd(
        offset,
        usize.saturatingMultiply(u16.toUsize(last - first) + 1, rawByteLen<T>()),
      ),
    )
  }
}

pub struct LookupSingle<T> {
  pub glyph: u16,
  pub value: T,
}

impl<T: Copy> Copy for LookupSingle<T> {}

impl<T: Scalar> ComputeSize<()> for LookupSingle<T> {
  fn computeSize(args: ()) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(2 + rawByteLen<T>())
  }
}

impl<T: Scalar> FixedSize for LookupSingle<T> {
  fn rawByteLen() -> usize {
    return 2 + rawByteLen<T>()
  }
}

impl<'a, T: Scalar> FontReadAt<'a, ()> for LookupSingle<T> {
  fn readAt(data: FontData<'a>, position: usize, args: ()) -> Result<Self, ReadError> {
    let tail = match move FontData.splitOff(&data, position) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let glyph = match move FontData<'a>.readAt<u16>(&tail, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let value = match move FontData<'a>.readAt<T>(&tail, 2) {
      Result<T, ReadError>.Success { value } => move value
      Result<T, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { glyph: glyph, value: move value })
  }
}

impl<'a> Lookup6<'a> {
  pub fn entries<T: LookupValue + Scalar + Copy>(self: &Self) -> Result<
    ComputedArray<'a, (), LookupSingle<T>>,
    ReadError
  > {
    let data = ScalarArray<u8>.offsetData(&Lookup6.entriesData(self))
    return ComputedArray<'a, (), LookupSingle<T>>.new(
      data,
      0,
      usize.saturatingMultiply(
        u16.toUsize(Lookup6.nUnits(self)),
        usize.saturatingAdd(2, rawByteLen<T>()),
      ),
      (),
    )
  }

  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let entries = match move Lookup6<'a>.entries<T>(self) {
      Result<ComputedArray<'a, (), LookupSingle<T>>, ReadError>.Success { value } => value
      Result<ComputedArray<'a, (), LookupSingle<T>>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    let mut low: usize = 0
    let mut size = ComputedArray<'a, (), LookupSingle<T>>.len(&entries)
    if size == 0 {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }

    // Preserve Rust's final candidate on unsorted data, as well as equal keys.
    while size > 1 {
      let half = size / 2
      let mid = low + half
      let item = match move ComputedArray<'a, (), LookupSingle<T>>.get(&entries, mid) {
        Result<LookupSingle<T>, ReadError>.Success { value } => value
        Result<LookupSingle<T>, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      if item.glyph <= index {
        low = mid
      }
      size = size - half
    }
    let mut item = match move ComputedArray<'a, (), LookupSingle<T>>.get(&entries, low) {
      Result<LookupSingle<T>, ReadError>.Success { value } => value
      Result<LookupSingle<T>, ReadError>.Failure { error } => {
        return Result<T, ReadError>.failResult(error)
      }
    }
    if item.glyph == index {
      return Result<T, ReadError>.succeed(item.value)
    }
    return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
  }
}

impl<'a> Lookup8<'a> {
  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let first = Lookup8.firstGlyph(self)
    if index < first {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return match move ScalarArray<u16>.get(&Lookup8.valueArray(self), u16.toUsize(index - first)) {
      Option<u16>.Some { value } => Result<T, ReadError>.succeed(fromLookupU16<T>(value))
      _ => Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

impl<'a> Lookup10<'a> {
  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    let first = Lookup10.firstGlyph(self)
    if index < first {
      return Result<T, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let width = u16.toUsize(Lookup10.unitSize(self))
    let offset = u16.toUsize(index - first) * width
    let data = ScalarArray<u8>.offsetData(&Lookup10.valuesData(self))
    let value = match width {
      1 => match move FontData<'a>.readAt<u8>(&data, offset) {
        Result<u8, ReadError>.Success { value } => u8.toU32(value)
        Result<u8, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      2 => match move FontData<'a>.readAt<u16>(&data, offset) {
        Result<u16, ReadError>.Success { value } => u16.toU32(value)
        Result<u16, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      4 => match move FontData<'a>.readAt<u32>(&data, offset) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<T, ReadError>.failResult(error)
        }
      }
      _ => {
        return Result<T, ReadError>.failResult(
          ReadError.MalformedData { message: "invalid unit_size in format 10 AAT lookup table" },
        )
      }
    }
    return Result<T, ReadError>.succeed(fromLookupU32<T>(value))
  }
}

impl<'a> Lookup<'a> {
  pub fn value<T: LookupValue + Scalar + Copy>(self: &Self, index: u16) -> Result<T, ReadError> {
    return match &self.* {
      Lookup<'a>.Format0 { value } => Lookup0<'a>.value<T>(&value, index)
      Lookup<'a>.Format2 { value } => Lookup2<'a>.value<T>(&value, index)
      Lookup<'a>.Format4 { value } => Lookup4<'a>.value<T>(&value, index)
      Lookup<'a>.Format6 { value } => Lookup6<'a>.value<T>(&value, index)
      Lookup<'a>.Format8 { value } => Lookup8<'a>.value<T>(&value, index)
      Lookup<'a>.Format10 { value } => Lookup10<'a>.value<T>(&value, index)
    }
  }
}

// Handwritten extension from font/parse/src/tables/aat_state.silk
