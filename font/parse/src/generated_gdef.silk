/// [CaretValue Format 3](https://docs.microsoft.com/en-us/typography/opentype/spec/gdef#caretvalue-format-3)
pub struct CaretValueFormat3<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for CaretValueFormat3<'a> {}

impl<'a> CaretValueFormat3<'a> {
  pub fn minSize() -> usize {
    return 6
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 6 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let caretValueFormatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let coordinateValue = scalarOr<i16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[2].end = end
    let deviceOffsetValue = scalarOr<Offset16>(data, ranges[2].start, Offset16.new(0))
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier-format = 3
  pub fn caretValueFormat(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn caretValueFormatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// X or Y value, in design units
  pub fn coordinate(self: &Self) -> i16 {
    return match move FontData<'a>.readAt<i16>(&self._fontData, self._fieldRanges[1].start) {
      Result<i16, ReadError>.Success { value } => value
      Result<i16, ReadError>.Failure { error } => 0
    }
  }

  pub fn coordinateByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Offset to Device table (non-variable font) / Variation Index
  /// table (variable font) for X or Y value-from beginning of
  /// CaretValue table
  pub fn deviceOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[2].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn device(self: &Self) -> Result<DeviceOrVariationIndex<'a>, ReadError> {
    let offset = CaretValueFormat3<'a>.deviceOffset(self)
    return resolveWithArgs<(), DeviceOrVariationIndex<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn deviceOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for CaretValueFormat3<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CaretValueFormat3<'a>.read(data)
  }
}

impl<'a> Format<u16> for CaretValueFormat3<'a> {
  fn formatValue() -> u16 {
    return 3
  }
}

impl<'a> MinByteRange<'a> for CaretValueFormat3<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Mark Glyph Sets Table](https://docs.microsoft.com/en-us/typography/opentype/spec/gdef#mark-glyph-sets-table)
pub struct MarkGlyphSets<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for MarkGlyphSets<'a> {}

impl<'a> MarkGlyphSets<'a> {
  pub fn default() -> Self {
    return MarkGlyphSets<'a>.read(FontData.defaultFormat1U16TableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let formatValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let markGlyphSetCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(markGlyphSetCountValue), 4))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Format identifier == 1
  pub fn format(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn formatByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of mark glyph sets defined
  pub fn markGlyphSetCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn markGlyphSetCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of offsets to mark glyph set coverage tables, from the
  /// start of the MarkGlyphSets table.
  pub fn coverageOffsets(self: &Self) -> ScalarArray<'a, Offset32> {
    return match move FontData<'a>.readArray<Offset32>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset32>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset32>, ReadError>.Failure { error } => ScalarArray<
        Offset32
      >.empty()
    }
  }

  pub fn coverages(self: &Self) -> ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset32> {
    return ArrayOfOffsets<'a, (), CoverageTable<'a>, Offset32>.new(
      MarkGlyphSets<'a>.coverageOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn coverageOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for MarkGlyphSets<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return MarkGlyphSets<'a>.read(data)
  }
}

impl<'a> Format<u16> for MarkGlyphSets<'a> {
  fn formatValue() -> u16 {
    return 1
  }
}

impl<'a> MinByteRange<'a> for MarkGlyphSets<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// LigCaretList2 (ISO/IEC 14496-22:2026).
pub struct LigCaretList2<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for LigCaretList2<'a> {}

impl<'a> LigCaretList2<'a> {
  pub fn default() -> Self {
    return LigCaretList2<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 7
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 7 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 4)
    ranges[0].end = end
    let coverageOffsetValue = scalarOr<Offset32>(data, ranges[0].start, Offset32.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 3)
    ranges[1].end = end
    let ligGlyphCountValue = scalarOr<Uint24>(data, ranges[1].start, Uint24.new(0))
    ranges[2].start = end
    end = usize.saturatingAdd(
      end,
      usize.saturatingMultiply(u32.toUsize(Uint24.toU32(ligGlyphCountValue)), 3),
    )
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Offset to Coverage table - from beginning of LigCaretList2 table
  pub fn coverageOffset(self: &Self) -> Offset32 {
    return match move FontData<'a>.readAt<Offset32>(&self._fontData, self._fieldRanges[0].start) {
      Result<Offset32, ReadError>.Success { value } => value
      Result<Offset32, ReadError>.Failure { error } => Offset32.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = LigCaretList2<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset32>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ligature glyphs
  pub fn ligGlyphCount(self: &Self) -> Uint24 {
    return match move FontData<'a>.readAt<Uint24>(&self._fontData, self._fieldRanges[1].start) {
      Result<Uint24, ReadError>.Success { value } => value
      Result<Uint24, ReadError>.Failure { error } => Uint24.new(0)
    }
  }

  pub fn ligGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of offsets to LigGlyph tables, from beginning of
  /// LigCaretList2 table —in Coverage Index order
  pub fn ligGlyphOffsets(self: &Self) -> ScalarArray<'a, Offset24> {
    return match move FontData<'a>.readArray<Offset24>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset24>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset24>, ReadError>.Failure { error } => ScalarArray<
        Offset24
      >.empty()
    }
  }

  pub fn ligGlyphs(self: &Self) -> ArrayOfOffsets<'a, (), LigGlyph<'a>, Offset24> {
    return ArrayOfOffsets<'a, (), LigGlyph<'a>, Offset24>.new(
      LigCaretList2<'a>.ligGlyphOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn ligGlyphOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for LigCaretList2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LigCaretList2<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for LigCaretList2<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/gdef_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.

impl<'a> Gdef<'a> {
  fn selectOffset(
    self: &Self,
    original: Nullable<Offset16>,
    extended: Option<Nullable<Offset32>>,
  ) -> Result<HeaderOffset, ReadError> {
    return HeaderOffset.select(
      original,
      move extended,
      MajorMinor.compatible(&Gdef<'a>.version(self), MajorMinor.new(1, 4)),
    )
  }

  pub fn glyphClassDef(self: &Self) -> Option<Result<ClassDef<'a>, ReadError>> {
    return match move Gdef<'a>.selectOffset(
      self,
      Gdef<'a>.glyphClassDefOffset(self),
      Gdef<'a>.glyphClassDef2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => HeaderOffset.resolve<ClassDef<'a>>(
        &value,
        self._fontData,
      )
      Result<HeaderOffset, ReadError>.Failure { error } => Option<
        Result<ClassDef<'a>, ReadError>
      >.some(Result<ClassDef<'a>, ReadError>.failResult(error))
    }
  }

  pub fn originalGlyphClassDef(self: &Self) -> Option<Result<ClassDef<'a>, ReadError>> {
    return resolveNullableWithArgs<(), ClassDef<'a>, Offset16>(
      &Gdef<'a>.glyphClassDefOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn attachList(self: &Self) -> Option<Result<AttachList<'a>, ReadError>> {
    return match move Gdef<'a>.selectOffset(
      self,
      Gdef<'a>.attachListOffset(self),
      Gdef<'a>.attachList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => HeaderOffset.resolve<AttachList<'a>>(
        &value,
        self._fontData,
      )
      Result<HeaderOffset, ReadError>.Failure { error } => Option<
        Result<AttachList<'a>, ReadError>
      >.some(Result<AttachList<'a>, ReadError>.failResult(error))
    }
  }

  pub fn originalAttachList(self: &Self) -> Option<Result<AttachList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), AttachList<'a>, Offset16>(
      &Gdef<'a>.attachListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn markAttachClassDef(self: &Self) -> Option<Result<ClassDef<'a>, ReadError>> {
    return match move Gdef<'a>.selectOffset(
      self,
      Gdef<'a>.markAttachClassDefOffset(self),
      Gdef<'a>.markAttachClassDef2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => HeaderOffset.resolve<ClassDef<'a>>(
        &value,
        self._fontData,
      )
      Result<HeaderOffset, ReadError>.Failure { error } => Option<
        Result<ClassDef<'a>, ReadError>
      >.some(Result<ClassDef<'a>, ReadError>.failResult(error))
    }
  }

  pub fn originalMarkAttachClassDef(self: &Self) -> Option<Result<ClassDef<'a>, ReadError>> {
    return resolveNullableWithArgs<(), ClassDef<'a>, Offset16>(
      &Gdef<'a>.markAttachClassDefOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn markGlyphSetsDef(self: &Self) -> Option<Result<MarkGlyphSets<'a>, ReadError>> {
    return match move Gdef<'a>.selectOffset(
      self,
      (Gdef<'a>.markGlyphSetsDefOffset(self)
        |> Option<Nullable<Offset16>>.unwrapOr(Nullable<Offset16>.default())),
      Gdef<'a>.markGlyphSetsDef2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => HeaderOffset.resolve<MarkGlyphSets<'a>>(
        &value,
        self._fontData,
      )
      Result<HeaderOffset, ReadError>.Failure { error } => Option<
        Result<MarkGlyphSets<'a>, ReadError>
      >.some(Result<MarkGlyphSets<'a>, ReadError>.failResult(error))
    }
  }

  pub fn originalMarkGlyphSetsDef(self: &Self) -> Option<Result<MarkGlyphSets<'a>, ReadError>> {
    return resolveNullableWithArgs<(), MarkGlyphSets<'a>, Offset16>(
      &(Gdef<'a>.markGlyphSetsDefOffset(self)
        |> Option<Nullable<Offset16>>.unwrapOr(Nullable<Offset16>.default())),
      self._fontData,
      (),
    )
  }

  pub fn originalLigCaretList(self: &Self) -> Option<Result<LigCaretList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), LigCaretList<'a>, Offset16>(
      &Gdef<'a>.ligCaretListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn ligCaretList(self: &Self) -> Option<Result<SelectedLigCaretList<'a>, ReadError>> {
    let selected = match move Gdef<'a>.selectOffset(
      self,
      Gdef<'a>.ligCaretListOffset(self),
      Gdef<'a>.ligCaretList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Option<Result<SelectedLigCaretList<'a>, ReadError>>.some(
          Result<SelectedLigCaretList<'a>, ReadError>.failResult(error),
        )
      }
    }
    if HeaderOffset.isNull(&selected) {
      return Option<Result<SelectedLigCaretList<'a>, ReadError>>.None
    }
    if selected.extended {
      return Option<Result<SelectedLigCaretList<'a>, ReadError>>.some(
        match move resolve<LigCaretList2<'a>, Offset32>(selected.offset, self._fontData) {
          Result<LigCaretList2<'a>, ReadError>.Success { value } => Result<
            SelectedLigCaretList<'a>,
            ReadError
          >.succeed(SelectedLigCaretList<'a>.Extended { value: value })
          Result<LigCaretList2<'a>, ReadError>.Failure { error } => Result<
            SelectedLigCaretList<'a>,
            ReadError
          >.failResult(error)
        },
      )
    }
    return Option<Result<SelectedLigCaretList<'a>, ReadError>>.some(
      match move resolve<LigCaretList<'a>, Offset32>(selected.offset, self._fontData) {
        Result<LigCaretList<'a>, ReadError>.Success { value } => Result<
          SelectedLigCaretList<'a>,
          ReadError
        >.succeed(SelectedLigCaretList<'a>.Original { value: value })
        Result<LigCaretList<'a>, ReadError>.Failure { error } => Result<
          SelectedLigCaretList<'a>,
          ReadError
        >.failResult(error)
      },
    )
  }
}

pub union SelectedLigCaretList<'a> {
  Original { pub value: LigCaretList<'a> },
  Extended { pub value: LigCaretList2<'a> },
}

impl<'a> Copy for SelectedLigCaretList<'a> {}

impl<'a> SelectedLigCaretList<'a> {
  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    return match &self.* {
      SelectedLigCaretList<'a>.Original { value } => LigCaretList<'a>.coverage(&value)
      SelectedLigCaretList<'a>.Extended { value } => LigCaretList2<'a>.coverage(&value)
    }
  }

  pub fn ligGlyphCount(self: &Self) -> u32 {
    return match &self.* {
      SelectedLigCaretList<'a>.Original { value } => u16.toU32(
        LigCaretList<'a>.ligGlyphCount(&value),
      )
      SelectedLigCaretList<'a>.Extended { value } => Uint24.toU32(
        LigCaretList2<'a>.ligGlyphCount(&value),
      )
    }
  }

  pub fn ligGlyphs(self: &Self) -> LayoutOffsetArray<'a, LigGlyph<'a>> {
    return match &self.* {
      SelectedLigCaretList<'a>.Original { value } => LayoutOffsetArray<'a, LigGlyph<'a>>.Offset16 {
        value: LigCaretList<'a>.ligGlyphs(&value)
      }
      SelectedLigCaretList<'a>.Extended { value } => LayoutOffsetArray<'a, LigGlyph<'a>>.Offset24 {
        value: LigCaretList2<'a>.ligGlyphs(&value)
      }
    }
  }
}
