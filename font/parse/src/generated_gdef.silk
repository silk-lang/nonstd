/// [Caret Value Tables](https://docs.microsoft.com/en-us/typography/opentype/spec/gdef#caret-value-tables)
pub union CaretValue<'a> {
  Format1 { pub value: CaretValueFormat1<'a> },
  Format2 { pub value: CaretValueFormat2<'a> },
  Format3 { pub value: CaretValueFormat3<'a> },
}

impl<'a> Copy for CaretValue<'a> {}

impl<'a> CaretValue<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let format = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    match format {
      1 => {
        return match move CaretValueFormat1<'a>.read(data) {
          Result<CaretValueFormat1<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CaretValue<'a>.Format1 { value: value })
          Result<CaretValueFormat1<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      2 => {
        return match move CaretValueFormat2<'a>.read(data) {
          Result<CaretValueFormat2<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CaretValue<'a>.Format2 { value: value })
          Result<CaretValueFormat2<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      3 => {
        return match move CaretValueFormat3<'a>.read(data) {
          Result<CaretValueFormat3<'a>, ReadError>.Success { value } => Result<
            Self,
            ReadError
          >.succeed(CaretValue<'a>.Format3 { value: value })
          Result<CaretValueFormat3<'a>, ReadError>.Failure { error } => Result<
            Self,
            ReadError
          >.failResult(error)
        }
      }
      _ => {
        return Result<Self, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(format) },
        )
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      CaretValue<'a>.Format1 { value } => CaretValueFormat1<'a>.offsetData(&value)
      CaretValue<'a>.Format2 { value } => CaretValueFormat2<'a>.offsetData(&value)
      CaretValue<'a>.Format3 { value } => CaretValueFormat3<'a>.offsetData(&value)
    }
  }

  /// Format identifier: format = 1
  pub fn caretValueFormat(self: &Self) -> u16 {
    return match &self.* {
      CaretValue<'a>.Format1 { value } => CaretValueFormat1<'a>.caretValueFormat(&value)
      CaretValue<'a>.Format2 { value } => CaretValueFormat2<'a>.caretValueFormat(&value)
      CaretValue<'a>.Format3 { value } => CaretValueFormat3<'a>.caretValueFormat(&value)
    }
  }
}

impl<'a> FontRead<'a, ()> for CaretValue<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return CaretValue<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for CaretValue<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return match &self.* {
      CaretValue<'a>.Format1 { value } => MinByteRange.minByteRange(&value)
      CaretValue<'a>.Format2 { value } => MinByteRange.minByteRange(&value)
      CaretValue<'a>.Format3 { value } => MinByteRange.minByteRange(&value)
    }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match &self.* {
      CaretValue<'a>.Format1 { value } => MinByteRange.minTableBytes(&value)
      CaretValue<'a>.Format2 { value } => MinByteRange.minTableBytes(&value)
      CaretValue<'a>.Format3 { value } => MinByteRange.minTableBytes(&value)
    }
  }
}

impl<'a> CaretValue<'a> {
  pub fn default() -> Self {
    return CaretValue<'a>.Format1 { value: CaretValueFormat1<'a>.default() }
  }
}

