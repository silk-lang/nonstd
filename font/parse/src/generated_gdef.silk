    return AttachPoint<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 2] },
      )
  }

  pub fn minSize() -> usize {
    return 2
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 2 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 2] = [ByteRange { start: 0, end: 0 }; 2]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let pointCountValue = scalarOr<u16>(data, ranges[0].start, 0)
    ranges[1].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(pointCountValue), 2))
    ranges[1].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Number of attachment points on this glyph
  pub fn pointCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[0].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn pointCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Array of contour point indices -in increasing numerical order
  pub fn pointIndices(self: &Self) -> ScalarArray<'a, u16> {
    return match move FontData<'a>.readArray<u16>(
      &self._fontData,
      self._fieldRanges[1].start,
      self._fieldRanges[1].end,
    ) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => ScalarArray<u16>.empty()
    }
  }

  pub fn pointIndicesByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }
}

impl<'a> FontRead<'a, ()> for AttachPoint<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return AttachPoint<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for AttachPoint<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[1].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[1].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

/// [Ligature Caret List Table](https://docs.microsoft.com/en-us/typography/opentype/spec/gdef#ligature-caret-list-table)
pub struct LigCaretList<'a> {
  _fontData: FontData<'a>,
  _fieldRanges: [ByteRange; 3],
}

impl<'a> Copy for LigCaretList<'a> {}

impl<'a> LigCaretList<'a> {
  pub fn default() -> Self {
    return LigCaretList<'a>.read(FontData.defaultTableData())
      |> Result<Self, ReadError>.unwrapOr(
        Self { _fontData: FontData.new(b""), _fieldRanges: [ByteRange { start: 0, end: 0 }; 3] },
      )
  }

  pub fn minSize() -> usize {
    return 4
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    if FontData.len(&data) < 4 {
      return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let mut ranges: [ByteRange; 3] = [ByteRange { start: 0, end: 0 }; 3]
    let mut end: usize = 0
    ranges[0].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[0].end = end
    let coverageOffsetValue = scalarOr<Offset16>(data, ranges[0].start, Offset16.new(0))
    ranges[1].start = end
    end = usize.saturatingAdd(end, 2)
    ranges[1].end = end
    let ligGlyphCountValue = scalarOr<u16>(data, ranges[1].start, 0)
    ranges[2].start = end
    end = usize.saturatingAdd(end, usize.saturatingMultiply(u16.toUsize(ligGlyphCountValue), 2))
    ranges[2].end = end
    return Result<Self, ReadError>.succeed(Self { _fontData: data, _fieldRanges: ranges })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._fontData
  }

  /// Offset to Coverage table - from beginning of LigCaretList table
  pub fn coverageOffset(self: &Self) -> Offset16 {
    return match move FontData<'a>.readAt<Offset16>(&self._fontData, self._fieldRanges[0].start) {
      Result<Offset16, ReadError>.Success { value } => value
      Result<Offset16, ReadError>.Failure { error } => Offset16.new(0)
    }
  }

  pub fn coverage(self: &Self) -> Result<CoverageTable<'a>, ReadError> {
    let offset = LigCaretList<'a>.coverageOffset(self)
    return resolveWithArgs<(), CoverageTable<'a>, Offset16>(offset, self._fontData, ())
  }

  pub fn coverageOffsetByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[0]
  }

  /// Number of ligature glyphs
  pub fn ligGlyphCount(self: &Self) -> u16 {
    return match move FontData<'a>.readAt<u16>(&self._fontData, self._fieldRanges[1].start) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => 0
    }
  }

  pub fn ligGlyphCountByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[1]
  }

  /// Array of offsets to LigGlyph tables, from beginning of
  /// LigCaretList table —in Coverage Index order
  pub fn ligGlyphOffsets(self: &Self) -> ScalarArray<'a, Offset16> {
    return match move FontData<'a>.readArray<Offset16>(
      &self._fontData,
      self._fieldRanges[2].start,
      self._fieldRanges[2].end,
    ) {
      Result<ScalarArray<'a, Offset16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, Offset16>, ReadError>.Failure { error } => ScalarArray<
        Offset16
      >.empty()
    }
  }

  pub fn ligGlyphs(self: &Self) -> ArrayOfOffsets<'a, (), LigGlyph<'a>, Offset16> {
    return ArrayOfOffsets<'a, (), LigGlyph<'a>, Offset16>.new(
      LigCaretList<'a>.ligGlyphOffsets(self),
      self._fontData,
      (),
    )
  }

  pub fn ligGlyphOffsetsByteRange(self: &Self) -> ByteRange {
    return self._fieldRanges[2]
  }
}

impl<'a> FontRead<'a, ()> for LigCaretList<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LigCaretList<'a>.read(data)
  }
}

impl<'a> MinByteRange<'a> for LigCaretList<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[2].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[2].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
