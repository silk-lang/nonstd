pub fn standardString(index: usize) -> Option<&'static [u8]> {
  if index >= 391 {
    return Option<&'static [u8]>.None
  }
  let start = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4, 4))
    |> Option<u32>.unwrapOr(0)
  let end = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4 + 4, 4))
    |> Option<u32>.unwrapOr(0)
  return Option<&'static [u8]>.some(
    Slice.view<u8>(stringsData(), u32.toUsize(start), u32.toUsize(end - start)),
  )
}

pub fn predefinedCode(encoding: u8, code: u8) -> u16 {
  let mut data = standardEncoding()
  if encoding == 1 {
    data = expertEncoding()
  } else if encoding == 2 {
    data = isoLatin1Encoding()
  }
  return readScalar<u16>(Slice.view<u8>(data, u8.toUsize(code) * 2, 2)) |> Option<u16>.unwrapOr(0)
}

pub fn expertCharset(subset: bool, index: usize) -> Option<u16> {
  let mut data = expertCharsetData()
  if subset {
    data = expertSubsetCharsetData()
  }
  if index >= data.length / 2 {
    return Option<u16>.None
  }
  return readScalar<u16>(Slice.view<u8>(data, index * 2, 2))
}
