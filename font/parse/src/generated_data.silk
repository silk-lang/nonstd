fn stringAt(data: &'static [u8], offsets: &'static [u8], index: usize) -> Option<string<'static>> {
  if index >= offsets.length / 4 - 1 {
    return Option<string<'static>>.None
  }
  let start = readScalar<u32>(Slice.view<u8>(offsets, index * 4, 4)) |> Option<u32>.unwrapOr(0)
  let end = readScalar<u32>(Slice.view<u8>(offsets, index * 4 + 4, 4)) |> Option<u32>.unwrapOr(0)
  return match move String.fromUtf8(
    Slice.view<u8>(data, u32.toUsize(start), u32.toUsize(end - start)),
  ) {
    Result<string<'static>, InvalidUtf8>.Success { value } => Option<string<'static>>.some(value)
    Result<string<'static>, InvalidUtf8>.Failure { error } => Option<string<'static>>.None
  }
}

pub const POST_NAME_COUNT: usize = 258

pub fn postName(index: usize) -> Option<string<'static>> {
  return stringAt(getpostNamesData(), getpostNamesOffsets(), index)
}

pub fn macRomanCode(index: usize) -> Option<u16> {
  if index >= 128 {
    return Option<u16>.None
  }
  return readScalar<u16>(Slice.view<u8>(getmacRomanData(), index * 2, 2))
}

pub fn languageIdToBcp47(platformId: u16, languageId: u16) -> Option<string<'static>> {
  if !((platformId == 1 && languageId <= 151) || (platformId == 3 && languageId >= 1025)) {
    return Option<string<'static>>.None
  }
  let mut low: usize = 0
  let mut high = getlanguageKeys().length / 2
  while low < high {
    let mid = low + (high - low) / 2
    let key = readScalar<u16>(Slice.view<u8>(getlanguageKeys(), mid * 2, 2))
      |> Option<u16>.unwrapOr(0)
    if key <= languageId {
      low = mid + 1
    } else {
      high = mid
    }
  }
  if low > 0 {
    let index = low - 1
    let key = readScalar<u16>(Slice.view<u8>(getlanguageKeys(), index * 2, 2))
      |> Option<u16>.unwrapOr(0)
    if key == languageId {
      return stringAt(getlanguagesData(), getlanguagesOffsets(), index)
    }
  }
  return Option<string<'static>>.None
}

