//! Shared checked operations for grammar-generated borrowed views.
import font_data { FontData }
import read { ReadError, FontReadAt, ComputeSize }
import array { ComputedArray }
import font_types.lib { Scalar, FixedSize, fixedByteLen }
import silk.core.result { Result }
import silk.core.option { Option }
import array { VarLenArray }
import read { FontRead, VarSize, totalLenForCount }

pub fn scalarOr<'a, T: Scalar>(data: FontData<'a>, position: usize, fallback: T) -> T {
  return match move FontData<'a>.readAt<T>(&data, position) {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => move fallback
  }
}

pub fn recordArray<'a, T: FixedSize + FontReadAt<'a, ()> + ComputeSize<()>>(
  data: FontData<'a>,
  start: usize,
  end: usize,
) -> Result<ComputedArray<'a, (), T>, ReadError> {
  if start > end || end > FontData.len(&data) {
    return Result<ComputedArray<'a, (), T>, ReadError>.failResult(ReadError.OutOfBounds)
  }
  let width = fixedByteLen<T>()
  if width == 0 || (end - start) % width != 0 {
    return Result<ComputedArray<'a, (), T>, ReadError>.failResult(ReadError.InvalidArrayLen)
  }
  return ComputedArray<'a, (), T>.new(data, start, end, ())
}

pub fn varLenArray<'a, T>(data: FontData<'a>, start: usize, end: usize) -> Result<
  VarLenArray<'a, T>,
  ReadError
> {
  return match move FontData.slice(&data, start, end) {
    Option<FontData<'a>>.Some { value } => VarLenArray<'a, T>.read(value)
    Option<FontData<'a>>.None => Result<VarLenArray<'a, T>, ReadError>.failResult(
      ReadError.OutOfBounds,
    )
  }
}

pub fn varLenBytes<'a, T: VarSize>(data: FontData<'a>, start: usize, count: usize) -> usize {
  let suffix = FontData.splitOff(&data, start) |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
  return totalLenForCount<T>(suffix, count) |> Result<usize, ReadError>.unwrapOr(0)
}

// Match Rust's signed-to-usize count cast before saturating range arithmetic.
import silk.num.i64
import silk.num.usize

pub fn signedCount(value: i64) -> usize {
  if value < 0 {
    return usize.MAX - i64.toUsize(-(value + 1))
  }
  return i64.toUsize(value)
}
