// Seven upstream IntSet-dependent layout regressions that needed IntSet first.
import generated_layout { ClassDef, ClassDefFormat1, ClassDefFormat2 }
import collections.int_set { IntSet, IntSetIter }
import font_types.lib { GlyphId }
import font_data { FontData }
import read { ReadError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u16

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "layout fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn make(values: &[u32]) -> IntSet<GlyphId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<GlyphId>.empty()
  let mut i: usize = 0
  while i < values.length {
    drop run IntSet<GlyphId>.insert(&mut set, GlyphId.new(values[i]))
    i = i + 1
  }
  return move set
}

effect fn classes(actual: &IntSet<u32>, expected: &[u32]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let values = run IntSet<u32>.fromValues(expected)
  run Testing.expect(IntSet<u32>.equals(actual, &values), "intersected classes")
}

effect fn classes16(actual: &IntSet<u16>, expected: &[u16]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let values = run IntSet<u16>.fromValues(expected)
  run Testing.expect(IntSet<u16>.equals(actual, &values), "intersected classes")
}

test effect fn wideClassZeroIncludesUnassignedGlyphs() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wideClassZeroIncludesUnassignedGlyphsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wideClassZeroIncludesUnassignedGlyphsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(ClassDef.read(FontData.new(&[0, 4, 0, 0, 1, 1, 0, 0, 1, 0, 2, 0, 1])))
  let glyphs = run make(&[65535, 65536, 65538, 65539])
  let found = run ClassDef.intersectClasses(&table, &glyphs)
  run classes(&found, &[0, 1])
  let zeros = run ClassDef.intersectedClassGlyphs(&table, &glyphs, 0)
  let expected = run make(&[65535, 65539])
  run Testing.expect(
    IntSet<GlyphId>.equals(&zeros, &expected),
    "upstream layout intersection expectation",
  )
}

test effect fn classdefFormat1ShortReadNoPanic() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run classdefFormat1ShortReadNoPanicBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn classdefFormat1ShortReadNoPanicBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(ClassDefFormat1.read(FontData.new(&[0, 1, 0, 10, 0, 5, 0, 1])))
  let glyphs = run make(&[10, 11, 14])
  run Testing.expect(
    ClassDefFormat1.get(&table, GlyphId.new(10)) == 0,
    "upstream layout intersection expectation",
  )
  run Testing.expect(
    ClassDefFormat1.get(&table, GlyphId.new(11)) == 0,
    "upstream layout intersection expectation",
  )
  run Testing.expect(
    !ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 2),
    "upstream layout intersection expectation",
  )
  let ones = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 1)
  run Testing.expect(IntSet<GlyphId>.isEmpty(&ones), "upstream layout intersection expectation")
}

test effect fn classdefFormat1Empty() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run classdefFormat1EmptyBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn classdefFormat1EmptyBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(ClassDefFormat1.read(FontData.new(&[0, 1, 0, 0, 0, 0])))
  let glyphs = run make(&[48, 49, 50])
  run Testing.expect(
    ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 0),
    "upstream layout intersection expectation",
  )
  run Testing.expect(
    !ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 1),
    "upstream layout intersection expectation",
  )
  let zeros = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 0)
  run Testing.expect(
    IntSet<GlyphId>.equals(&zeros, &glyphs),
    "upstream layout intersection expectation",
  )
  let ones = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 1)
  run Testing.expect(IntSet<GlyphId>.isEmpty(&ones), "upstream layout intersection expectation")
  let found = run ClassDefFormat1.intersectClasses(&table, &glyphs)
  run classes16(&found, &[0])
  let one = run make(&[48])
  run Testing.expect(
    ClassDefFormat1.intersectsClassGlyphs(&table, &one, 0),
    "upstream layout intersection expectation",
  )
  let none = IntSet<GlyphId>.empty()
  run Testing.expect(
    !ClassDefFormat1.intersectsClassGlyphs(&table, &none, 0),
    "upstream layout intersection expectation",
  )
  let result = run ClassDefFormat1.intersectedClassGlyphs(&table, &none, 0)
  run Testing.expect(IntSet<GlyphId>.isEmpty(&result), "upstream layout intersection expectation")
}

