effect fn classdefFormat1EmptyNonzeroStartGlyphBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(ClassDefFormat1.read(FontData.new(&[0, 1, 0, 60, 0, 0])))
  if true {
    let glyphs = run make(&[48, 49])
    run Testing.expect(
      ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 0),
      "upstream layout intersection expectation",
    )
    run Testing.expect(
      !ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 1),
      "upstream layout intersection expectation",
    )
    let zeros = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 0)
    run Testing.expect(
      IntSet<GlyphId>.equals(&zeros, &glyphs),
      "upstream layout intersection expectation",
    )
  }
  if true {
    let glyphs = run make(&[70, 71])
    run Testing.expect(
      ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 0),
      "upstream layout intersection expectation",
    )
    run Testing.expect(
      !ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 1),
      "upstream layout intersection expectation",
    )
    let zeros = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 0)
    run Testing.expect(
      IntSet<GlyphId>.equals(&zeros, &glyphs),
      "upstream layout intersection expectation",
    )
  }
  if true {
    let glyphs = run make(&[48, 70])
    run Testing.expect(
      ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 0),
      "upstream layout intersection expectation",
    )
    run Testing.expect(
      !ClassDefFormat1.intersectsClassGlyphs(&table, &glyphs, 1),
      "upstream layout intersection expectation",
    )
    let zeros = run ClassDefFormat1.intersectedClassGlyphs(&table, &glyphs, 0)
    run Testing.expect(
      IntSet<GlyphId>.equals(&zeros, &glyphs),
      "upstream layout intersection expectation",
    )
  }
}

test effect fn classdefFormat2IntersectsClassZero() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run classdefFormat2IntersectsClassZeroBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn classdefFormat2IntersectsClassZeroBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  if true {
    let table = run must(
      ClassDefFormat2.read(
        FontData.new(&[0, 2, 0, 3, 0, 10, 0, 20, 0, 1, 0, 30, 0, 40, 0, 1, 0, 41, 0, 50, 0, 1]),
      ),
    )
    if true {
      let glyphs = run make(&[10])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[15, 20, 30, 40, 41, 50])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[9, 15])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[21])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[29])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[51])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[52])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[15, 51])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
      let found = run ClassDefFormat2.intersectClasses(&table, &glyphs)
      run Testing.expect(
        IntSet<u16>.contains(&found, 0) == true,
        "upstream layout intersection expectation",
      )
    }
  }
  if true {
    let table = run must(
      ClassDefFormat2.read(FontData.new(&[0, 2, 0, 2, 0, 10, 0, 20, 0, 1, 0, 30, 0, 40, 0, 1])),
    )
    if true {
      let glyphs = run make(&[35])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[41])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[42])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[35, 41])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
    }
  }
  if true {
    let table = run must(
      ClassDefFormat2.read(FontData.new(&[0, 2, 0, 2, 0, 0, 0, 5, 0, 1, 0, 10, 0, 20, 0, 1])),
    )
    if true {
      let glyphs = run make(&[15])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[3])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[0, 3, 15])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == false,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[7])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
    }
    if true {
      let glyphs = run make(&[3, 21])
      run Testing.expect(
        ClassDefFormat2.intersectsClassGlyphs(&table, &glyphs, 0) == true,
        "upstream layout intersection expectation",
      )
    }
  }
}

test effect fn classdefEmptyFormatsAgree() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run classdefEmptyFormatsAgreeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn classdefEmptyFormatsAgreeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let a = run must(ClassDef.read(FontData.new(&[0, 1, 0, 0, 0, 0])))
  let b = run must(ClassDef.read(FontData.new(&[0, 2, 0, 0])))
  run Testing.expect(
    match a {
      ClassDef.Format1 { value } => true
      _ => false
    },
    "upstream layout intersection expectation",
  )
  run Testing.expect(
    match b {
      ClassDef.Format2 { value } => true
      _ => false
    },
    "upstream layout intersection expectation",
  )
  if true {
    let glyphs = run make(&[0])
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 0))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 0)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 0)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 0)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 1))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 1)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 1)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 1)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    let left = run ClassDef.intersectClasses(&a, &glyphs)
    let right = run ClassDef.intersectClasses(&b, &glyphs)
    run Testing.expect(
      IntSet<u32>.equals(&left, &right),
      "upstream layout intersection expectation",
    )
  }
  if true {
    let glyphs = run make(&[48])
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 0))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 0)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 0)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 0)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 1))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 1)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 1)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 1)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    let left = run ClassDef.intersectClasses(&a, &glyphs)
    let right = run ClassDef.intersectClasses(&b, &glyphs)
    run Testing.expect(
      IntSet<u32>.equals(&left, &right),
      "upstream layout intersection expectation",
    )
  }
  if true {
    let glyphs = run make(&[48, 49, 50])
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 0))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 0)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 0)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 0)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    if true {
      run Testing.expect(
        (run ClassDef.intersectsClassGlyphs(&a, &glyphs, 1))
          == (run ClassDef.intersectsClassGlyphs(&b, &glyphs, 1)),
        "upstream layout intersection expectation",
      )
      let left = run ClassDef.intersectedClassGlyphs(&a, &glyphs, 1)
      let right = run ClassDef.intersectedClassGlyphs(&b, &glyphs, 1)
      run Testing.expect(
        IntSet<GlyphId>.equals(&left, &right),
        "upstream layout intersection expectation",
      )
    }
    let left = run ClassDef.intersectClasses(&a, &glyphs)
    let right = run ClassDef.intersectClasses(&b, &glyphs)
    run Testing.expect(
      IntSet<u32>.equals(&left, &right),
      "upstream layout intersection expectation",
    )
  }
}
