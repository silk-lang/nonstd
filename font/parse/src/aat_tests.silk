}

test effect fn lookupFormat6() -> ()
  ! AssertionError<'static> {
  run check16(
    b"\x00\x06\x00\x04\x00\x04\x00\x10\x00\x02\x00\x00\x00\x32\x02\x58\x00\x33\x02\x59\x00\xc9\x02\x5a\x00\xca\x03\x84",
    &[50, 51, 201, 202],
    &[600, 601, 602, 900],
