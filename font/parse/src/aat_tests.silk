  run check16(
    b"\x00\x04\x00\x06\x00\x03\x00\x0c\x00\x01\x00\x06\x00\x16\x00\x14\x00\x1e\x00\x18\x00\x17\x00\x24\x00\x1c\x00\x19\x00\x28\x00\x03\x00\x02\x00\x01\x00\x64\x00\x96\x00\x08\x00\x06\x00\x07\x00\x09",
    &[20, 21, 22, 23, 24, 25, 26, 27, 28],
    &[3, 2, 1, 100, 150, 8, 6, 7, 9],
