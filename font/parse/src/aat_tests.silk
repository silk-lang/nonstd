import tables.aat { TypedLookup }
import font_data { FontData }
import read { ReadError }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "AAT fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn failed<T>(result: Result<T, ReadError>) -> bool {
  return match move result {
    Result<T, ReadError>.Failure { error } => true
    _ => false
  }
}

effect fn check16(data: &'static [u8], glyphs: &[u16], expected: &[u16], missing: &[u16]) -> ()
  ! AssertionError<'static> {
  let lookup = run must(TypedLookup<'static, u16>.read(FontData.new(data)))
  let mut i: usize = 0
  while i < glyphs.length {
    run Testing.expect(
      (run must(TypedLookup<'static, u16>.value(&lookup, glyphs[i]))) == expected[i],
      "lookup value",
    )
    i = i + 1
  }
  i = 0
  while i < missing.length {
    run Testing.expect(
      failed(TypedLookup<'static, u16>.value(&lookup, missing[i])),
      "uncovered glyph",
    )
    i = i + 1
  }
}

test effect fn lookupFormat0() -> ()
  ! AssertionError<'static> {
  run check16(
    b"\x00\x00\x00\x00\x00\x02\x00\x04\x00\x06\x00\x08\x00\x0a\x00\x0c\x00\x0e\x00\x10",
    &[0, 1, 2, 3, 4, 5, 6, 7, 8],
    &[0, 2, 4, 6, 8, 10, 12, 14, 16],
    &[9],
  )
}

test effect fn lookupFormat2() -> ()
  ! AssertionError<'static> {
  run check16(
    b"\x00\x02\x00\x06\x00\x03\x00\x0c\x00\x01\x00\x06\x00\x16\x00\x14\x00\x04\x00\x18\x00\x17\x00\x05\x00\x1c\x00\x19\x00\x06",
    &[20, 21, 22, 23, 24, 25, 26, 27, 28],
    &[4, 4, 4, 5, 5, 6, 6, 6, 6],
    &[0, 10, 19, 29, 65535],
