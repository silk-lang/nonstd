test effect fn lookupFormat8() -> ()
  ! AssertionError<'static> {
  run check16(
    b"\x00\x08\x00\xc9\x00\x07\x00\x03\x00\x08\x00\x02\x00\x09\x00\x01\x00\xc8\x00\x3c",
    &[201, 202, 203, 204, 205, 206, 207],
    &[3, 8, 2, 9, 1, 200, 60],
    &[0, 10, 200, 210, 65535],
  )
}

test effect fn lookupFormat10() -> ()
  ! AssertionError<'static> {
  let lookup = run must(
    TypedLookup<'static, u32>.read(
      FontData.new(
        b"\x00\x0a\x00\x04\x00\xc9\x00\x07\x00\x00\x00\x03\x00\x00\x00\x08\x00\x2c\x49\x70\x00\x00\x00\x09\x00\x00\x00\x01\xff\xff\xff\xff\x00\x00\x00\x3c",
      ),
    ),
  )
  let expected: [u32; 7] = [3, 8, 2902384, 9, 1, 4294967295, 60]
  let mut i: usize = 0
  while i < 7 {
    run Testing.expect(
      (run must(TypedLookup<'static, u32>.value(&lookup, 201 + usize.toU16(i)))) == expected[i],
      "32-bit lookup value",
    )
    i = i + 1
  }
  let missing: [u16; 5] = [0, 10, 200, 210, 65535]
  i = 0
  while i < 5 {
    run Testing.expect(
      failed(TypedLookup<'static, u32>.value(&lookup, missing[i])),
      "32-bit uncovered glyph",
    )
    i = i + 1
  }
}

import silk.num.usize
import tables.aat {
  StateTable,
  ExtendedStateTable,
  StateEntry,
  NoPayload,
  LegacyStateTableParts,
  StateTableParts
}
import read { FontRead }
import font_types.lib { FixedSize, GlyphId, GlyphId16 }

struct ContextualData {
  pub markIndex: u16,
  pub currentIndex: u16,
}

impl FixedSize for ContextualData {
  fn rawByteLen() -> usize {
    return 4
  }
}

impl<'a> FontRead<'a, ()> for ContextualData {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    let marked = match move FontData<'a>.readAt<u16>(&data, 0) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let current = match move FontData<'a>.readAt<u16>(&data, 2) {
      Result<u16, ReadError>.Success { value } => value
      Result<u16, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { markIndex: marked, currentIndex: current })
  }
}

test effect fn extendedStateTable() -> ()
  ! AssertionError<'static> {
  let data = FontData.new(
    b"\x00\x00\x00\x06\x00\x00\x00\x14\x00\x00\x00\x38\x00\x00\x00\x5c\x00\x00\x00\x00\x00\x06\x00\x04\x00\x05\x00\x10\x00\x02\x00\x00\x00\x32\x00\x04\x00\x33\x00\x04\x00\x50\x00\x05\x00\xc9\x00\x04\x00\xca\x00\x04\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x00\x00\x00\xff\xff\xff\xff\x00\x02\x00\x00\xff\xff\xff\xff\x00\x00\x00\x00\xff\xff\x00\x00",
  )
  let table = run must(ExtendedStateTable<'static, ContextualData>.read(data))
  run Testing.expect(
    (run must(ExtendedStateTable<'static, ContextualData>.class(&table, GlyphId.new(50)))) == 4,
    "class 50",
  )
  run Testing.expect(
    (run must(ExtendedStateTable<'static, ContextualData>.class(&table, GlyphId.new(80)))) == 5,
    "class 80",
  )
  run Testing.expect(
    (run must(ExtendedStateTable<'static, ContextualData>.class(&table, GlyphId.new(201)))) == 4,
    "class 201",
  )
  let first = run must(ExtendedStateTable<'static, ContextualData>.entry(&table, 0, 4))
  run Testing.expect(
    first.newState == 0 && first.payload.currentIndex == 65535,
    "initial transition",
  )
  let second = run must(ExtendedStateTable<'static, ContextualData>.entry(&table, 0, 5))
  run Testing.expect(second.newState == 2, "transition to state 2")
  let third = run must(ExtendedStateTable<'static, ContextualData>.entry(&table, 2, 4))
  run Testing.expect(
    third.newState == 0 && third.payload.currentIndex == 0,
    "return and substitution action",
  )
  let parts = run must(StateTableParts.read(data))
  let rebuilt = run must(ExtendedStateTable<'static, ContextualData>.fromParts(data, &parts))
  let again = run must(ExtendedStateTable<'static, ContextualData>.entry(&rebuilt, 2, 4))
  run Testing.expect(
    again.newState == third.newState && again.payload.currentIndex == third.payload.currentIndex,
    "rebuild from cached parts",
  )
}

test effect fn stateTable() -> ()
  ! AssertionError<'static> {
  let data = FontData.new(
    b"\x00\x07\x00\x0a\x00\x12\x00\x28\x00\x40\x00\x03\x00\x04\x01\x02\x03\x04\x02\x00\x00\x02\x01\x00\x00\x02\x00\x00\x02\x01\x00\x00\x02\x03\x03\x02\x03\x04\x05\x00\x00\x12\x81\x12\x00\x20\x81\x12\x00\x12\x00\x00\x00\x20\x81\x14\x00\x12\x81\x16",
  )
  let table = run must(StateTable<'static, NoPayload>.read(data))
  let mut i: usize = 0
  while i < 4 {
    run Testing.expect(
      (run must(StateTable<'static, NoPayload>.class(&table, GlyphId16.new(usize.toU16(i + 3)))))
        == usize.toU8(i + 1),
      "legacy class lookup",
    )
    i = i + 1
  }
  let states: [u16; 4] = [0, 2, 1, 2]
  let classes: [u8; 4] = [4, 1, 3, 5]
  let next: [u16; 4] = [2, 2, 0, 0]
  let flags: [u16; 4] = [33042, 33044, 0, 33046]
  i = 0
  while i < 4 {
    let entry = run must(StateTable<'static, NoPayload>.entry(&table, states[i], classes[i]))
    run Testing.expect(
      entry.newState == next[i] && entry.flags == flags[i],
      "legacy state and flags",
    )
    i = i + 1
  }
  let parts = run must(LegacyStateTableParts.read(data))
  let rebuilt = run must(StateTable<'static, NoPayload>.fromParts(data, &parts))
  let entry = run must(StateTable<'static, NoPayload>.entry(&rebuilt, 0, 4))
  run Testing.expect(entry.newState == 2 && entry.flags == 33042, "legacy cached parts")
}

// Regression from the differential malformed-kern fixture: an upper-bound
// search agrees on sorted keys but chooses a different unsorted candidate.
import tables.kerx { Subtable0 as KerningPairs }
import tables.feat { Feat, FeatureName }
import font_types.lib { NameId }
import silk.core.option { Option }

test effect fn unsortedSearchesMatchRust() -> ()
  ! AssertionError<'static> {
  let lookup2 = run must(
    TypedLookup<'static, u16>.read(
      FontData.new(
        b"\x00\x02\x00\x06\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x02\x00\x01\x00\x01\x00\x03\x00\x00\x00\x00\x00\x04",
      ),
    ),
  )
  run Testing.expect(
    (run must(TypedLookup<'static, u16>.value(&lookup2, 0))) == 2,
    "Rust search candidate",
  )
  let lookup4 = run must(
    TypedLookup<'static, u16>.read(
      FontData.new(
        b"\x00\x04\x00\x06\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x2a\x00\x00\x00\x00\x00\x2c\x00\x00\x00\x00\x00\x2e\x00\x01\x00\x01\x00\x30\x00\x00\x00\x00\x00\x32\x00\x00\x00\x01\x00\x02\x00\x03\x00\x04",
      ),
    ),
  )
  run Testing.expect(
    (run must(TypedLookup<'static, u16>.value(&lookup4, 0))) == 2,
    "Rust search candidate",
  )
  let lookup6 = run must(
    TypedLookup<'static, u16>.read(
      FontData.new(
        b"\x00\x06\x00\x04\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x02\x00\x01\x00\x03\x00\x00\x00\x04",
      ),
    ),
  )
  run Testing.expect(
    (run must(TypedLookup<'static, u16>.value(&lookup6, 0))) == 2,
    "Rust search candidate",
  )
  let pairs = run must(
    KerningPairs.read(
      FontData.new(
        b"\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x02\x00\x00\x00\x01\x00\x03\x00\x00\x00\x00\x00\x04",
      ),
    ),
  )
  run Testing.expect(
    (KerningPairs.kerning(&pairs, GlyphId.new(0), GlyphId.new(0)) |> Option<i32>.unwrapOr(-1)) == 2,
    "unsorted kerning search",
  )
  let feat = run must(
    Feat.read(
      FontData.new(
        b"\x00\x01\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x65\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x66\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x67\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x68",
      ),
    ),
  )
  match move Feat.find(&feat, 0) {
    Option<FeatureName<'static>>.Some { value } => {
      run Testing.expect(
        NameId.toU16(FeatureName.nameIndex(&value)) == 102,
        "unsorted feature search",
      )
    }
    _ => {
      run Testing.expect(false, "feature search candidate")
    }
  }
}
