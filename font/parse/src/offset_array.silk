//! Borrowed arrays of lazily resolved offsets.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_data { FontData }
import array { ScalarArray }
import read { FontRead, ReadError }
import offset { resolveWithArgs, resolveNullableWithArgs }
import font_types.lib { Scalar, OffsetValue, Nullable }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.usize

pub struct ArrayOfOffsets<'a, Args: Copy, T: FontRead<'a, Args>, O: Scalar + OffsetValue + Copy> {
  offsets: ScalarArray<'a, O>,
  data: FontData<'a>,
  args: Args,
}

impl<'a, Args: Copy, T: FontRead<'a, Args>, O: Scalar + OffsetValue + Copy> Copy for ArrayOfOffsets<
  'a,
  Args,
  T,
  O
> {}

impl<'a, Args, T, O> ArrayOfOffsets<'a, Args, T, O> {
  pub fn new(offsets: ScalarArray<'a, O>, data: FontData<'a>, args: Args) -> Self {
    return Self { offsets: offsets, data: data, args: args }
  }

  pub fn len(self: &Self) -> usize {
    return ScalarArray<O>.len(&self.offsets)
  }

  pub fn isEmpty(self: &Self) -> bool {
    return ScalarArray<O>.isEmpty(&self.offsets)
  }

  pub fn get(self: &Self, index: usize) -> Result<T, ReadError> {
    return match move ScalarArray<O>.get(&self.offsets, index) {
      Option<O>.Some { value } => resolveWithArgs<Args, T, O>(value, self.data, self.args)
      Option<O>.None => Result<T, ReadError>.failResult(
        ReadError.InvalidCollectionIndex { index: usize.toU32(index & 4294967295) },
      )
    }
  }

  pub fn iter(self: &Self) -> OffsetIter<'a, Args, T, O> {
    return OffsetIter<'a, Args, T, O> { array: self.*, index: 0 }
  }
}

pub struct OffsetIter<'a, Args: Copy, T: FontRead<'a, Args>, O: Scalar + OffsetValue + Copy> {
  array: ArrayOfOffsets<'a, Args, T, O>,
  index: usize,
}

impl<'a, Args, T, O> OffsetIter<'a, Args, T, O> {
  pub fn next(self: &mut Self) -> Option<Result<T, ReadError>> {
    if self.index >= ArrayOfOffsets<'a, Args, T, O>.len(&self.array) {
      return Option<Result<T, ReadError>>.None
    }
    let result = ArrayOfOffsets<'a, Args, T, O>.get(&self.array, self.index)
    self.index = self.index + 1
    return Option<Result<T, ReadError>>.some(move result)
  }

  pub fn nextAsNullable(self: &mut Self) -> Option<Option<Result<T, ReadError>>> {
    return match move OffsetIter<'a, Args, T, O>.next(&mut self) {
      Option<Result<T, ReadError>>.None => Option<Option<Result<T, ReadError>>>.None
      Option<Result<T, ReadError>>.Some { value } => match move value {
        Result<T, ReadError>.Failure { error: ReadError.NullOffset } => Option<
          Option<Result<T, ReadError>>
        >.some(Option<Result<T, ReadError>>.None)
        Result<T, ReadError>.Failure { error } => Option<Option<Result<T, ReadError>>>.some(
          Option<Result<T, ReadError>>.some(Result<T, ReadError>.failResult(error)),
        )
        Result<T, ReadError>.Success { value: item } => Option<Option<Result<T, ReadError>>>.some(
          Option<Result<T, ReadError>>.some(Result<T, ReadError>.succeed(move item)),
        )
      }
    }
  }
}

pub struct ArrayOfNullableOffsets<
  'a,
  Args: Copy,
  T: FontRead<'a, Args>,
  O: Scalar + OffsetValue + Copy
> {
  offsets: ScalarArray<'a, Nullable<O>>,
  data: FontData<'a>,
  args: Args,
}

impl<
  'a,
  Args: Copy,
  T: FontRead<'a, Args>,
  O: Scalar + OffsetValue + Copy
> Copy for ArrayOfNullableOffsets<'a, Args, T, O> {}

impl<'a, Args, T, O> ArrayOfNullableOffsets<'a, Args, T, O> {
  pub fn new(offsets: ScalarArray<'a, Nullable<O>>, data: FontData<'a>, args: Args) -> Self {
    return Self { offsets: offsets, data: data, args: args }
  }

  pub fn len(self: &Self) -> usize {
    return ScalarArray<Nullable<O>>.len(&self.offsets)
  }

  pub fn isEmpty(self: &Self) -> bool {
    return ScalarArray<Nullable<O>>.isEmpty(&self.offsets)
  }

  pub fn get(self: &Self, index: usize) -> Option<Result<T, ReadError>> {
    return match move ScalarArray<Nullable<O>>.get(&self.offsets, index) {
      Option<Nullable<O>>.Some { value } => resolveNullableWithArgs<Args, T, O>(
        &value,
        self.data,
        self.args,
      )
      Option<Nullable<O>>.None => Option<Result<T, ReadError>>.some(
        Result<T, ReadError>.failResult(
          ReadError.InvalidCollectionIndex { index: usize.toU32(index & 4294967295) },
        ),
      )
    }
  }

  pub fn iter(self: &Self) -> NullableOffsetIter<'a, Args, T, O> {
    return NullableOffsetIter<'a, Args, T, O> { array: self.*, index: 0 }
  }
}

pub struct NullableOffsetIter<
  'a,
  Args: Copy,
  T: FontRead<'a, Args>,
  O: Scalar + OffsetValue + Copy
> {
  array: ArrayOfNullableOffsets<'a, Args, T, O>,
  index: usize,
}

impl<'a, Args, T, O> NullableOffsetIter<'a, Args, T, O> {
  pub fn next(self: &mut Self) -> Option<Option<Result<T, ReadError>>> {
    if self.index >= ArrayOfNullableOffsets<'a, Args, T, O>.len(&self.array) {
      return Option<Option<Result<T, ReadError>>>.None
    }
    let result = ArrayOfNullableOffsets<'a, Args, T, O>.get(&self.array, self.index)
    self.index = self.index + 1
    return Option<Option<Result<T, ReadError>>>.some(move result)
  }
}
