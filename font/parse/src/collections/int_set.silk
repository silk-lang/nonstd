pub import collections.int_set.bitset { U32Set, U32SetIter, U32SetRangeIter, U32SetBuilder }
pub import collections.int_set.bitpage { U32Range }
import font_types.lib { GlyphId, GlyphId16, NameId, Tag }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub struct InDomain {
  raw: u32,
}

impl Copy for InDomain {}

impl InDomain {
  pub fn value(self: &Self) -> u32 {
    return self.raw
  }
}

// nextFrom/previousFrom make Rust's opaque domain iterator concrete. They return
// the first/last mapped domain member at or beyond/before an inclusive bound.
pub interface Domain {
  fn toU32(self: &Self) -> u32

  fn fromU32(member: InDomain) -> Self

  fn contains(value: u32) -> bool

  fn isContinuous() -> bool

  fn count() -> u64

  fn nextFrom(value: u32) -> Option<u32>

  fn previousFrom(value: u32) -> Option<u32>

  fn orderedValues() -> DomainValues<Self> {
    return DomainValues<Self>.new(0, u32.MAX)
  }

  fn orderedValuesRange(first: Self, last: Self) -> DomainValues<Self> {
    return DomainValues<Self>.new(Domain.toU32(&first), Domain.toU32(&last))
  }
}

pub struct DomainValues<T> {
  front: u64,
  end: u64,
}

impl<T> DomainValues<T> {
  pub fn new(first: u32, last: u32) -> Self {
    return Self { front: u32.toU64(first), end: u32.toU64(last) + 1 }
  }
}

// Separate generic functions keep the Domain witness explicit for static operations.
pub fn domainNext<T: Domain>(value: u32) -> Option<u32> {
  return Domain.nextFrom(value)
}

pub fn domainPrevious<T: Domain>(value: u32) -> Option<u32> {
  return Domain.previousFrom(value)
}

pub fn domainCount<T: Domain>() -> u64 {
  return Domain.count()
}

pub fn domainContinuous<T: Domain>() -> bool {
  return Domain.isContinuous()
}

pub fn orderedValues<T: Domain>() -> DomainValues<T> {
  return Domain.orderedValues()
}

impl<T> DomainValues<T> {
  pub fn next<T: Domain>(self: &mut Self) -> Option<u32> {
    if self.front >= self.end {
      return Option<u32>.None
    }
    let value = match move domainNext<T>(u64.toU32(self.front)) {
      Option<u32>.Some { value } => value
      _ => {
        self.front = self.end
        return Option<u32>.None
      }
    }
    if u32.toU64(value) >= self.end {
      self.front = self.end
      return Option<u32>.None
    }
    self.front = u32.toU64(value) + 1
    return Option<u32>.some(value)
  }

  pub fn nextBack<T: Domain>(self: &mut Self) -> Option<u32> {
    if self.front >= self.end {
      return Option<u32>.None
    }
    let value = match move domainPrevious<T>(u64.toU32(self.end - 1)) {
      Option<u32>.Some { value } => value
      _ => {
        self.end = self.front
        return Option<u32>.None
      }
    }
    if u32.toU64(value) < self.front {
      self.end = self.front
      return Option<u32>.None
    }
    self.end = u32.toU64(value)
    return Option<u32>.some(value)
  }
}

pub struct IntRange<T> {
  pub first: T,
  pub last: T,
}

impl<T: Copy> Copy for IntRange<T> {}

pub union Bound<T> {
  Included { pub value: T },
  Excluded { pub value: T },
  Unbounded,
}

pub struct IntSet<T: Domain + Copy> {
  bits: U32Set,
  inverted: bool,
}

impl<T> IntSet<T> {
  pub fn new() -> Self {
    return IntSet<T>.empty()
  }

  pub fn default() -> Self {
    return IntSet<T>.empty()
  }

  pub fn empty() -> Self {
    return Self { bits: U32Set.empty(), inverted: false }
  }

  pub fn all() -> Self {
    return Self { bits: U32Set.empty(), inverted: true }
  }

  pub fn isInverted(self: &Self) -> bool {
    return self.inverted
  }

  pub fn invert(self: &mut Self) -> () {
    self.inverted = !self.inverted
  }

  pub fn clear(self: &mut Self) -> () {
    U32Set.clear(&mut self.bits)
    self.inverted = false
  }

  pub fn fromBitset(bits: U32Set) -> IntSet<u32> {
    return IntSet<u32> { bits: move bits, inverted: false }
  }

  pub effect fn clone(self: &Self) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return Self { bits: run U32Set.clone(&self.bits), inverted: self.inverted }
  }

  pub fn len(self: &Self) -> u64 {
    let n = U32Set.len(&self.bits)
    if self.inverted {
      return domainCount<T>() - n
    }
    return n
  }

  pub fn isEmpty(self: &Self) -> bool {
    return IntSet<T>.len(self) == 0
  }

  pub fn contains(self: &Self, value: T) -> bool {
    return U32Set.contains(&self.bits, Domain.toU32(&value)) != self.inverted
  }

  pub effect fn insert(self: &mut Self, value: T) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let raw = Domain.toU32(&value)
    if self.inverted {
      return U32Set.remove(&mut self.bits, raw)
    }
    return run U32Set.insert(&mut self.bits, raw)
  }

  pub effect fn remove(self: &mut Self, value: T) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let raw = Domain.toU32(&value)
    if self.inverted {
      return run U32Set.insert(&mut self.bits, raw)
    }
    return U32Set.remove(&mut self.bits, raw)
  }

  pub effect fn insertRange(self: &mut Self, first: T, last: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run IntSet<T>.changeRange(&mut self, first, last, true)
  }

  pub effect fn removeRange(self: &mut Self, first: T, last: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run IntSet<T>.changeRange(&mut self, first, last, false)
  }

  effect fn changeRange(self: &mut Self, first: T, last: T, include: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let start = Domain.toU32(&first)
    let end = Domain.toU32(&last)
    let add = include != self.inverted
    if domainContinuous<T>() {
      if add {
        run U32Set.insertRange(&mut self.bits, start, end)
      } else {
        U32Set.removeRange(&mut self.bits, start, end)
      }
      return
    }
    let mut values = DomainValues<T>.new(start, end)
    while true {
      let value = match move DomainValues<T>.next(&mut values) {
        Option<u32>.Some { value } => value
        _ => {
          break
        }
      }
      if add {
        drop run U32Set.insert(&mut self.bits, value)
      } else {
        drop U32Set.remove(&mut self.bits, value)
      }
    }
  }

  pub effect fn extend(self: &mut Self, values: &[T]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.inverted {
      let mut i: usize = 0
      while i < values.length {
        drop U32Set.remove(&mut self.bits, Domain.toU32(&values[i]))
        i = i + 1
      }
      return
    }
    let mut builder = U32SetBuilder.start(&mut self.bits)
    let mut i: usize = 0
    while i < values.length {
      run U32SetBuilder.insert(&mut builder, Domain.toU32(&values[i]))
      i = i + 1
    }
    U32SetBuilder.finish(move builder)
  }

  pub effect fn extendUnsorted(self: &mut Self, values: &[T]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run IntSet<T>.extend(&mut self, values)
  }

  pub effect fn removeAll(self: &mut Self, values: &[T]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < values.length {
      drop run IntSet<T>.remove(&mut self, values[i])
      i = i + 1
    }
  }

  pub effect fn fromValues(values: &[T]) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = IntSet<T>.empty()
    run IntSet<T>.extend(&mut result, values)
    return move result
  }

  pub effect fn unionValue(self: &mut Self, other: &Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.inverted && !other.inverted {
      run U32Set.unionValue(&mut self.bits, &other.bits)
    } else if !self.inverted {
      run U32Set.reversedSubtract(&mut self.bits, &other.bits)
      self.inverted = true
    } else if !other.inverted {
      run U32Set.subtract(&mut self.bits, &other.bits)
    } else {
      run U32Set.intersect(&mut self.bits, &other.bits)
    }
  }

  pub effect fn intersect(self: &mut Self, other: &Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.inverted && !other.inverted {
      run U32Set.intersect(&mut self.bits, &other.bits)
    } else if !self.inverted {
      run U32Set.subtract(&mut self.bits, &other.bits)
    } else if !other.inverted {
      run U32Set.reversedSubtract(&mut self.bits, &other.bits)
      self.inverted = false
    } else {
      run U32Set.unionValue(&mut self.bits, &other.bits)
    }
  }

  pub effect fn subtract(self: &mut Self, other: &Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !self.inverted && !other.inverted {
      run U32Set.subtract(&mut self.bits, &other.bits)
    } else if !self.inverted {
      run U32Set.intersect(&mut self.bits, &other.bits)
    } else if !other.inverted {
      run U32Set.unionValue(&mut self.bits, &other.bits)
    } else {
      run U32Set.reversedSubtract(&mut self.bits, &other.bits)
      self.inverted = false
    }
  }

  pub fn iter<'a>(self: &'a Self) -> IntSetIter<'a, T> {
    return IntSetIter<'a, T> { set: self, front: 0, end: 4294967296 }
  }

  pub fn inclusiveIter<'a>(self: &'a Self) -> Option<IntSetIter<'a, T>> {
    if self.inverted {
      return Option<IntSetIter<'a, T>>.None
    }
    return Option<IntSetIter<'a, T>>.some(IntSet<T>.iter(self))
  }

  pub fn iterAfter<'a>(self: &'a Self, value: T) -> IntSetIter<'a, T> {
    return IntSetIter<'a, T> {
      set: self,
      front: u32.toU64(Domain.toU32(&value)) + 1,
      end: 4294967296,
    }
  }

  pub fn range<'a>(self: &'a Self, first: Bound<T>, last: Bound<T>) -> IntSetIter<'a, T> {
    let start: u64 = match move first {
      Bound<T>.Included { value } => u32.toU64(Domain.toU32(&value))
      Bound<T>.Excluded { value } => u32.toU64(Domain.toU32(&value)) + 1
      _ => 0
    }
    let end: u64 = match move last {
      Bound<T>.Included { value } => u32.toU64(Domain.toU32(&value)) + 1
      Bound<T>.Excluded { value } => u32.toU64(Domain.toU32(&value))
      _ => 4294967296
    }
    return IntSetIter<'a, T> { set: self, front: start, end: end }
  }

  pub fn nextAfter(self: &Self, value: T) -> Option<T> {
    let mut it = IntSet<T>.iterAfter(self, value)
    return IntSetIter<T>.next(&mut it)
  }

  pub fn first(self: &Self) -> Option<T> {
    let mut it = IntSet<T>.iter(self)
    return IntSetIter<T>.next(&mut it)
  }

  pub fn last(self: &Self) -> Option<T> {
    let mut it = IntSet<T>.iter(self)
    return IntSetIter<T>.nextBack(&mut it)
  }

  pub fn iterRanges<'a>(self: &'a Self) -> IntSetRangeIter<'a, T> {
    return IntSetRangeIter<'a, T> { set: self, inverted: self.inverted, nextValue: 0 }
  }

  pub fn iterExcludedRanges<'a>(self: &'a Self) -> IntSetRangeIter<'a, T> {
    return IntSetRangeIter<'a, T> { set: self, inverted: !self.inverted, nextValue: 0 }
  }

  pub fn intersectsRange(self: &Self, first: T, last: T) -> bool {
    let mut it = IntSet<T>.range(
      self,
      Bound<T>.Included { value: first },
      Bound<T>.Included { value: last },
    )
    return match move IntSetIter<T>.next(&mut it) {
      Option<T>.Some { value } => true
      _ => false
    }
  }

  pub fn intersectsSet(self: &Self, other: &Self) -> bool {
    if !self.inverted && !other.inverted {
      return U32Set.intersectsSet(&self.bits, &other.bits)
    }
    let mut a = self
    let mut b = other
    if U32Set.numPages(&self.bits) <= U32Set.numPages(&other.bits) {
      a = other
      b = self
    }
    let mut ranges = IntSet<T>.iterRanges(b)
    while true {
      let range = match move IntSetRangeIter<T>.next(&mut ranges) {
        Option<IntRange<T>>.Some { value } => value
        _ => {
          break
        }
      }
      if IntSet<T>.intersectsRange(a, range.first, range.last) {
        return true
      }
    }
    return false
  }

  pub fn isSubset(self: &Self, other: &Self) -> bool {
    if IntSet<T>.len(self) > IntSet<T>.len(other) {
      return false
    }
    if !self.inverted && !other.inverted {
      return U32Set.isSubset(&self.bits, &other.bits)
    }
    if !self.inverted {
      return !U32Set.intersectsSet(&self.bits, &other.bits)
    }
    if other.inverted {
      return U32Set.isSubset(&other.bits, &self.bits)
    }
    return U32Set.len(&self.bits) + U32Set.len(&other.bits)
      - U32Set.intersectionLen(&self.bits, &other.bits)
      == domainCount<T>()
  }

  pub fn equals(self: &Self, other: &Self) -> bool {
    if self.inverted == other.inverted {
      return U32Set.equals(&self.bits, &other.bits)
    }
    if IntSet<T>.len(self) != IntSet<T>.len(other) {
      return false
    }
    let mut a = IntSet<T>.iterRanges(self)
    let mut b = IntSet<T>.iterRanges(other)
    while true {
      let left = IntSetRangeIter<T>.nextRaw(&mut a)
      let right = IntSetRangeIter<T>.nextRaw(&mut b)
      match move left {
        Option<U32Range>.Some { value: av } => {
          match move right {
            Option<U32Range>.Some { value: bv } => {
              if av.first != bv.first || av.last != bv.last {
                return false
              }
            }
            _ => {
              return false
            }
          }
        }
        _ => {
          return match move right {
            Option<U32Range>.None => true
            _ => false
          }
        }
      }
    }
    return true
  }

  pub fn compare(self: &Self, other: &Self) -> Ordering {
    if !self.inverted && !other.inverted {
      return U32Set.compare(&self.bits, &other.bits)
    }
    let mut a = IntSet<T>.iterRanges(self)
    let mut b = IntSet<T>.iterRanges(other)
    while true {
      let ar = IntSetRangeIter<T>.nextRaw(&mut a)
      let br = IntSetRangeIter<T>.nextRaw(&mut b)
      let av = match move ar {
        Option<U32Range>.Some { value } => value
        _ => {
          return match move br {
            Option<U32Range>.None => Ordering.Equal
            _ => Ordering.Less
          }
        }
      }
      let bv = match move br {
        Option<U32Range>.Some { value } => value
        _ => {
          return Ordering.Greater
        }
      }
      if av.first < bv.first {
        return Ordering.Less
      }
      if av.first > bv.first {
        return Ordering.Greater
      }
      if av.last < bv.last {
        return match move IntSetRangeIter<T>.nextRaw(&mut a) {
          Option<U32Range>.Some { value } => Ordering.Greater
          _ => Ordering.Less
        }
      }
      if av.last > bv.last {
        return match move IntSetRangeIter<T>.nextRaw(&mut b) {
          Option<U32Range>.Some { value } => Ordering.Less
          _ => Ordering.Greater
        }
      }
    }
    return Ordering.Equal
  }

  pub fn hash(self: &Self, seed: &HashSeed) -> u64 {
    let mut result = Hash.mix(seed, 0)
    let mut ranges = IntSet<T>.iterRanges(self)
    while true {
      let range = match move IntSetRangeIter<T>.nextRaw(&mut ranges) {
        Option<U32Range>.Some { value } => value
        _ => {
          break
        }
      }
      result = Hash.combine(result, u32.toU64(range.first))
      result = Hash.combine(result, u32.toU64(range.last))
    }
    return result
  }
}

impl<T: Domain + Copy> Equal for IntSet<T> {
  fn equals(a: &Self, b: &Self) -> bool {
    return IntSet<T>.equals(a, b)
  }
}

impl<T: Domain + Copy> HashKey for IntSet<T> {
  fn equals(a: &Self, b: &Self) -> bool {
    return IntSet<T>.equals(a, b)
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return IntSet<T>.hash(value, seed)
  }
}

impl<T: Domain + Copy + Order> Order for IntSet<T> {
  fn compare(a: &Self, b: &Self) -> Ordering {
    return IntSet<T>.compare(a, b)
  }
}

fn nextMember<T: Domain>(bits: &U32Set, inverted: bool, start: u32) -> Option<u32> {
  if !inverted {
    return U32Set.firstFrom(bits, start)
  }
  let mut current = start
  while true {
    let candidate = match move domainNext<T>(current) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<u32>.None
      }
    }
    let free = match move U32Set.firstAbsentFrom(bits, candidate) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<u32>.None
      }
    }
    if free == candidate {
      return Option<u32>.some(free)
    }
    current = free
  }
  return Option<u32>.None
}

fn previousMember<T: Domain>(bits: &U32Set, inverted: bool, start: u32) -> Option<u32> {
  if !inverted {
    return U32Set.lastFrom(bits, start)
  }
  let mut current = start
  while true {
    let candidate = match move domainPrevious<T>(current) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<u32>.None
      }
    }
    let free = match move U32Set.lastAbsentFrom(bits, candidate) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<u32>.None
      }
    }
    if free == candidate {
      return Option<u32>.some(free)
    }
    current = free
  }
  return Option<u32>.None
}

pub struct IntSetIter<'a, T: Domain + Copy> {
  set: &'a IntSet<T>,
  front: u64,
  end: u64,
}

impl<'a, T> IntSetIter<'a, T> {
  pub fn next(self: &mut Self) -> Option<T> {
    if self.front >= self.end {
      return Option<T>.None
    }
    let value = match move nextMember<T>(&self.set.bits, self.set.inverted, u64.toU32(self.front)) {
      Option<u32>.Some { value } => value
      _ => {
        self.front = self.end
        return Option<T>.None
      }
    }
    if u32.toU64(value) >= self.end {
      self.front = self.end
      return Option<T>.None
    }
    self.front = u32.toU64(value) + 1
    return Option<T>.some(Domain.fromU32(InDomain { raw: value }))
  }

  pub fn nextBack(self: &mut Self) -> Option<T> {
    if self.front >= self.end {
      return Option<T>.None
    }
    let value = match move previousMember<T>(
      &self.set.bits,
      self.set.inverted,
      u64.toU32(self.end - 1),
    ) {
      Option<u32>.Some { value } => value
      _ => {
        self.end = self.front
        return Option<T>.None
      }
    }
    if u32.toU64(value) < self.front {
      self.end = self.front
      return Option<T>.None
    }
    self.end = u32.toU64(value)
    return Option<T>.some(Domain.fromU32(InDomain { raw: value }))
  }
}

pub struct IntSetRangeIter<'a, T: Domain + Copy> {
  set: &'a IntSet<T>,
  inverted: bool,
  nextValue: u64,
}

impl<'a, T> IntSetRangeIter<'a, T> {
  pub fn next(self: &mut Self) -> Option<IntRange<T>> {
    let value = match move IntSetRangeIter<T>.nextRaw(&mut self) {
      Option<U32Range>.Some { value } => value
      _ => {
        return Option<IntRange<T>>.None
      }
    }
    return Option<IntRange<T>>.some(
      IntRange<T> {
        first: Domain.fromU32(InDomain { raw: value.first }),
        last: Domain.fromU32(InDomain { raw: value.last }),
      },
    )
  }

  pub fn nextRaw(self: &mut Self) -> Option<U32Range> {
    if self.nextValue >= 4294967296 {
      return Option<U32Range>.None
    }
    let first = match move nextMember<T>(&self.set.bits, self.inverted, u64.toU32(self.nextValue)) {
      Option<u32>.Some { value } => value
      _ => {
        self.nextValue = 4294967296
        return Option<U32Range>.None
      }
    }
    let mut last = first
    if self.inverted {
      let excluded = U32Set.firstFrom(&self.set.bits, first)
      let limit = match move excluded {
        Option<u32>.Some { value } => value - 1
        _ => u32.MAX
      }
      last = domainPrevious<T>(limit) |> Option<u32>.unwrapOr(first)
    } else {
      while true {
        last = match move U32Set.firstAbsentFrom(&self.set.bits, last) {
          Option<u32>.Some { value } => value - 1
          _ => u32.MAX
        }
        if domainContinuous<T>() || last == u32.MAX {
          break
        }
        let next = match move domainNext<T>(last + 1) {
          Option<u32>.Some { value } => value
          _ => {
            break
          }
        }
        if !U32Set.contains(&self.set.bits, next) {
          break
        }
        last = next
      }
    }
    self.nextValue = u32.toU64(last) + 1
    return Option<U32Range>.some(U32Range { first: first, last: last })
  }
}

impl Domain for u32 {
  fn toU32(self: &Self) -> u32 {
    return self.*
  }

  fn fromU32(member: InDomain) -> Self {
    return member.raw
  }

  fn contains(value: u32) -> bool {
    return value <= 4294967295
  }

  fn isContinuous() -> bool {
    return true
  }

  fn count() -> u64 {
    return 4294967296
  }

  fn nextFrom(value: u32) -> Option<u32> {
    if value > 4294967295 {
      return Option<u32>.None
    }
    return Option<u32>.some(value)
  }

  fn previousFrom(value: u32) -> Option<u32> {
    if value > 4294967295 {
      return Option<u32>.some(4294967295)
    }
    return Option<u32>.some(value)
  }
}

impl Domain for u16 {
  fn toU32(self: &Self) -> u32 {
    return u16.toU32(self.*)
  }

  fn fromU32(member: InDomain) -> Self {
    return u32.toU16(member.raw)
  }

  fn contains(value: u32) -> bool {
    return value <= 65535
  }

  fn isContinuous() -> bool {
    return true
  }

  fn count() -> u64 {
    return 65536
  }

  fn nextFrom(value: u32) -> Option<u32> {
    if value > 65535 {
      return Option<u32>.None
    }
    return Option<u32>.some(value)
  }

  fn previousFrom(value: u32) -> Option<u32> {
    if value > 65535 {
      return Option<u32>.some(65535)
    }
    return Option<u32>.some(value)
  }
}

impl Domain for u8 {
  fn toU32(self: &Self) -> u32 {
    return u8.toU32(self.*)
  }

  fn fromU32(member: InDomain) -> Self {
    return u32.toU8(member.raw)
  }

  fn contains(value: u32) -> bool {
    return value <= 255
  }

  fn isContinuous() -> bool {
    return true
  }

  fn count() -> u64 {
    return 256
  }

  fn nextFrom(value: u32) -> Option<u32> {
    if value > 255 {
      return Option<u32>.None
    }
    return Option<u32>.some(value)
  }

  fn previousFrom(value: u32) -> Option<u32> {
    if value > 255 {
      return Option<u32>.some(255)
    }
    return Option<u32>.some(value)
  }
}

