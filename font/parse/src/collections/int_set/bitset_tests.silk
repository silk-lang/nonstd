test effect fn hashAndEq() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hashAndEqBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn hashAndEqBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let a = run U32Set.fromValues(&[43, 793])
  let b = run U32Set.fromValues(&[793, 43])
  let c = run U32Set.fromValues(&[43, 793, 794])
  let d = run U32Set.fromValues(&[0])
  run Testing.expect(
    U32Set.equals(&U32Set.empty(), &U32Set.empty()) && U32Set.equals(&a, &b)
      && !U32Set.equals(&a, &c)
      && !U32Set.equals(&b, &c)
      && U32Set.equals(&d, &d),
    "set equality",
  )
  let mut hashed = HashSet<U32Set>.make(Hash.seed(17))
  drop run HashSet<U32Set>.insert(&mut hashed, move a)
  run Testing.expect(
    HashSet<U32Set>.contains(&hashed, move b) && !HashSet<U32Set>.contains(&hashed, move c),
    "set hash",
  )
}

test effect fn hashAndEqWithEmptyPages() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hashAndEqWithEmptyPagesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn hashAndEqWithEmptyPagesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let a = run U32Set.fromValues(&[43])
  let mut b = run U32Set.fromValues(&[793, 43])
  drop U32Set.remove(&mut b, 793)
  let c = run U32Set.fromValues(&[43, 793])
  run Testing.expect(U32Set.equals(&a, &b) && !U32Set.equals(&a, &c), "empty pages ignored")
  let mut hashed = HashSet<U32Set>.make(Hash.seed(17))
  drop run HashSet<U32Set>.insert(&mut hashed, move a)
  run Testing.expect(HashSet<U32Set>.contains(&hashed, move b), "empty pages ignored by hash")
}

test effect fn hashAndEqIgnoreCache() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
