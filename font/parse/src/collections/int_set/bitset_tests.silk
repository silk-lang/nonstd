  drop run U32Set.insert(&mut set, 1000)
  run U32Set.insertRange(&mut set, 300, 511)
  drop U32Set.remove(&mut set, 1000)
  run rangeItems(&set, &[U32Range { first: 300, last: 511 }])
}

effect fn mixed0(set: &U32Set) -> ()
  ! AssertionError<'static> {
  let mut it = U32Set.iter(set)
  run Testing.expect(optional(U32SetIter.next(&mut it), 1), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 6), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 5), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 2), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 3), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 4), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), -1), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), -1), "upstream U32Set expectation")
}

effect fn mixed1(set: &U32Set) -> ()
  ! AssertionError<'static> {
  let mut it = U32Set.iter(set)
  run Testing.expect(optional(U32SetIter.next(&mut it), 1), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 701), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 700), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 6), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), 5), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 2), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 3), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), 4), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.next(&mut it), -1), "upstream U32Set expectation")
  run Testing.expect(optional(U32SetIter.nextBack(&mut it), -1), "upstream U32Set expectation")
}

