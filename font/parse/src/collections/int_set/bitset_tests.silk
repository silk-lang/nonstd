test effect fn insertRange() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run insertRangeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn insertRangeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut s0 = U32Set.empty()
  run U32Set.insertRange(&mut s0, 0, 0)
  let e0 = run individualRange(0, 0)
  run Testing.expect(U32Set.equals(&s0, &e0) && U32Set.len(&s0) == 1, "upstream U32Set expectation")
  let mut s1 = U32Set.empty()
  run U32Set.insertRange(&mut s1, 0, 364)
  let e1 = run individualRange(0, 364)
  run Testing.expect(
    U32Set.equals(&s1, &e1) && U32Set.len(&s1) == 365,
    "upstream U32Set expectation",
  )
  let mut s2 = U32Set.empty()
  run U32Set.insertRange(&mut s2, 0, 511)
  let e2 = run individualRange(0, 511)
  run Testing.expect(
    U32Set.equals(&s2, &e2) && U32Set.len(&s2) == 512,
    "upstream U32Set expectation",
  )
  let mut s3 = U32Set.empty()
  run U32Set.insertRange(&mut s3, 512, 1023)
  let e3 = run individualRange(512, 1023)
  run Testing.expect(
    U32Set.equals(&s3, &e3) && U32Set.len(&s3) == 512,
    "upstream U32Set expectation",
  )
  let mut s4 = U32Set.empty()
  run U32Set.insertRange(&mut s4, 0, 1023)
  let e4 = run individualRange(0, 1023)
  run Testing.expect(
    U32Set.equals(&s4, &e4) && U32Set.len(&s4) == 1024,
    "upstream U32Set expectation",
  )
  let mut s5 = U32Set.empty()
  run U32Set.insertRange(&mut s5, 364, 700)
  let e5 = run individualRange(364, 700)
  run Testing.expect(
    U32Set.equals(&s5, &e5) && U32Set.len(&s5) == 337,
    "upstream U32Set expectation",
  )
  let mut s6 = U32Set.empty()
  run U32Set.insertRange(&mut s6, 364, 6000)
  let e6 = run individualRange(364, 6000)
  run Testing.expect(
    U32Set.equals(&s6, &e6) && U32Set.len(&s6) == 5637,
    "upstream U32Set expectation",
  )
}

