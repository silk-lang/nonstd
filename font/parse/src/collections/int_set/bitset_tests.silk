  run iterRangesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn iterRangesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run checkRanges(&[U32Range { first: 0, last: 0 }])
  run checkRanges(&[U32Range { first: 4578, last: 4578 }])
  run checkRanges(&[U32Range { first: 0, last: 10 }, U32Range { first: 4578, last: 4583 }])
  run checkRanges(&[U32Range { first: 0, last: 700 }])
  run checkRanges(&[U32Range { first: 353, last: 737 }])
  run checkRanges(&[U32Range { first: 4294967295, last: 4294967295 }])
  run checkRanges(&[U32Range { first: 4294967285, last: 4294967295 }])
  run checkRanges(
    &[U32Range { first: 0, last: 5 }, U32Range { first: 4294967290, last: 4294967295 }],
  )
  run checkRanges(&[U32Range { first: 0, last: 511 }, U32Range { first: 513, last: 517 }])
  run checkRanges(&[U32Range { first: 512, last: 1023 }, U32Range { first: 1025, last: 1027 }])
  run checkRanges(&[U32Range { first: 1792, last: 2650 }])
}

