test effect fn removeRange() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run removeRangeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn removeRangeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut s0 = run U32Set.fromValues(&[5, 7, 11, 18, 511, 620, 1023, 1024, 1200])
  run Testing.expect(U32Set.len(&s0) == 9, "initial length")
  U32Set.removeRange(&mut s0, 7, 620)
  run items(&s0, 0, false, &[5, 1023, 1024, 1200])
  run Testing.expect(U32Set.len(&s0) == 4, "upstream U32Set expectation")
  let mut s1 = run U32Set.fromValues(&[5, 7, 11, 18, 511, 620, 1023, 1024, 1200])
  run Testing.expect(U32Set.len(&s1) == 9, "initial length")
  U32Set.removeRange(&mut s1, 7, 1024)
  run items(&s1, 0, false, &[5, 1200])
  run Testing.expect(U32Set.len(&s1) == 2, "upstream U32Set expectation")
  let mut s2 = run U32Set.fromValues(&[5, 7, 11, 18, 511, 620, 1023, 1024, 1200])
  run Testing.expect(U32Set.len(&s2) == 9, "initial length")
  U32Set.removeRange(&mut s2, 2000, 2100)
  run items(&s2, 0, false, &[5, 7, 11, 18, 511, 620, 1023, 1024, 1200])
  run Testing.expect(U32Set.len(&s2) == 9, "upstream U32Set expectation")
  let mut set = run U32Set.fromValues(&[1001, 1002, 1003, 1004])
  U32Set.removeRange(&mut set, 1002, 1003)
  run items(&set, 0, false, &[1001, 1004])
  U32Set.removeRange(&mut set, 100, 200)
  run items(&set, 0, false, &[1001, 1004])
  U32Set.removeRange(&mut set, 100, 1001)
  run items(&set, 0, false, &[1004])
}

test effect fn removeRangeBoundary() -> ()
