}

effect fn hashAndEqIgnoreCacheBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let a = run U32Set.fromValues(&[5, 1027])
  let b = run U32Set.fromValues(&[5, 1027])
  run Testing.expect(
    U32Set.contains(&a, 1027) && U32Set.contains(&b, 5) && U32Set.equals(&a, &b)
      && U32Set.compare(&a, &b) == Ordering.Equal,
    "lookups preserve identity",
  )
  let mut hashed = HashSet<U32Set>.make(Hash.seed(17))
  drop run HashSet<U32Set>.insert(&mut hashed, move a)
  run Testing.expect(HashSet<U32Set>.contains(&hashed, move b), "lookups preserve hash")
}

test effect fn ordering() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run orderingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn orderingBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run orderingCase(&[], &[], Ordering.Equal)
  run orderingCase(&[], &[0], Ordering.Less)
  run orderingCase(&[0], &[0], Ordering.Equal)
  run orderingCase(&[0, 1, 2], &[1, 2, 3], Ordering.Less)
  run orderingCase(&[0, 1, 4], &[1, 2, 3], Ordering.Less)
  run orderingCase(&[1, 2, 3], &[0, 2, 4], Ordering.Greater)
  run orderingCase(&[5, 4, 0], &[1, 2, 3], Ordering.Less)
  run orderingCase(&[1, 2, 3], &[1, 2, 3, 4], Ordering.Less)
  run orderingCase(&[2, 3, 4], &[1, 2, 3, 4, 5], Ordering.Greater)
  run orderingCase(&[1000, 2000, 3000], &[1000, 2000, 3000, 4000], Ordering.Less)
  run orderingCase(&[1000, 1001], &[1000, 2000], Ordering.Less)
  run orderingCase(&[2000, 3000, 4000], &[1000, 2000, 3000, 4000, 5000], Ordering.Greater)
}

test effect fn intersects() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run intersectsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn intersectsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let a = run U32Set.fromValues(&[2, 4, 5, 2057, 7000])
  let b = run U32Set.fromValues(&[3])
  let c = run U32Set.fromValues(&[2058])
  let d = run U32Set.fromValues(&[2057, 3000])
  let e = run U32Set.fromValues(&[3, 7000])
  run Testing.expect(
    U32Set.intersectsSet(&a, &b) == false && U32Set.intersectsSet(&b, &a) == false,
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.intersectsSet(&a, &c) == false && U32Set.intersectsSet(&c, &a) == false,
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.intersectsSet(&e, &d) == false && U32Set.intersectsSet(&d, &e) == false,
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.intersectsSet(&a, &d) == true && U32Set.intersectsSet(&d, &a) == true,
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.intersectsSet(&a, &e) == true && U32Set.intersectsSet(&e, &a) == true,
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.intersectsSet(&b, &e) == true && U32Set.intersectsSet(&e, &b) == true,
    "upstream U32Set expectation",
  )
  let shifted = run U32Set.fromValues(&[4000, 0])
  let other = run U32Set.fromValues(&[4000])
  run Testing.expect(
    U32Set.intersectsSet(&shifted, &other) && U32Set.intersectsSet(&other, &shifted),
    "upstream U32Set expectation",
  )
}

test effect fn isSubset() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isSubsetBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn isSubsetBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = U32Set.empty()
  let a = run U32Set.fromValues(&[2, 4, 5, 2057, 7000])
  let b = run U32Set.fromValues(&[2, 4, 5, 2057, 7000, 8000])
  let c = run U32Set.fromValues(&[2, 4, 5])
  let d = run U32Set.fromValues(&[2, 4, 6, 2057, 7000])
  let e = run U32Set.fromValues(&[2, 4, 5, 3000, 7000])
  run Testing.expect(U32Set.isSubset(&empty, &empty), "upstream U32Set expectation")
  run Testing.expect(U32Set.isSubset(&empty, &a), "upstream U32Set expectation")
  run Testing.expect(U32Set.isSubset(&a, &a), "upstream U32Set expectation")
  run Testing.expect(U32Set.isSubset(&a, &b), "upstream U32Set expectation")
  run Testing.expect(U32Set.isSubset(&c, &a), "upstream U32Set expectation")
  run Testing.expect(U32Set.isSubset(&c, &b), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&b, &a), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&a, &c), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&a, &empty), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&a, &d), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&d, &a), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&a, &e), "upstream U32Set expectation")
  run Testing.expect(!U32Set.isSubset(&e, &a), "upstream U32Set expectation")
  let mut withEmpty = run U32Set.fromValues(&[100, 2057])
  drop U32Set.remove(&mut withEmpty, 100)
  run Testing.expect(U32Set.isSubset(&withEmpty, &b), "upstream U32Set expectation")
}

test effect fn intersectionLen() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run intersectionLenBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn intersectionLenBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = U32Set.empty()
  let a = run U32Set.fromValues(&[2, 4, 5, 2057, 7000])
  let b = run U32Set.fromValues(&[4, 5, 2057, 9000])
  let c = run U32Set.fromValues(&[1, 3, 10000])
  run Testing.expect(U32Set.intersectionLen(&empty, &a) == 0, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&a, &empty) == 0, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&a, &a) == 5, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&a, &b) == 3, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&b, &a) == 3, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&a, &c) == 0, "upstream U32Set expectation")
  run Testing.expect(U32Set.intersectionLen(&c, &a) == 0, "upstream U32Set expectation")
}
