test effect fn containsIndexCache() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run containsIndexCacheBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn containsIndexCacheBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run U32Set.fromValues(&[10, 11, 12, 2023])
  run Testing.expect(U32Set.contains(&set, 9) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 10) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 11) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 12) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 1200) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2022) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2023) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2024) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2023) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 11) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 5000) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 11) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2023) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 12) == true, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 2024) == false, "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 13) == false, "upstream U32Set expectation")
  U32Set.clear(&mut set)
  drop run U32Set.insert(&mut set, 2024)
  drop run U32Set.insert(&mut set, 13)
  run Testing.expect(
    U32Set.contains(&set, 13) && !U32Set.contains(&set, 12) && U32Set.contains(&set, 2024)
      && !U32Set.contains(&set, 2023),
    "upstream U32Set expectation",
  )
}

