effect fn removeRangeBoundaryBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  U32Set.removeRange(&mut set, 4294967285, 4294967295)
  run Testing.expect(!U32Set.contains(&set, 4294967295), "upstream U32Set expectation")
  run U32Set.insertRange(&mut set, 4294967285, 4294967295)
  run Testing.expect(U32Set.contains(&set, 4294967295), "upstream U32Set expectation")
  U32Set.removeRange(&mut set, 4294967285, 4294967295)
  run Testing.expect(!U32Set.contains(&set, 4294967295), "upstream U32Set expectation")
  U32Set.removeRange(&mut set, 0, 10)
  run Testing.expect(!U32Set.contains(&set, 10), "upstream U32Set expectation")
  run U32Set.insertRange(&mut set, 0, 10)
  run Testing.expect(U32Set.contains(&set, 10), "upstream U32Set expectation")
  U32Set.removeRange(&mut set, 0, 10)
  run Testing.expect(!U32Set.contains(&set, 10), "upstream U32Set expectation")
}

