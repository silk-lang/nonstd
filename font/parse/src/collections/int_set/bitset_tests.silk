// All 36 upstream U32Set tests, with explicit allocation and cursor operations.
import collections.int_set.bitset { U32Set, U32SetIter, U32SetRangeIter, U32SetBuilder }
import collections.int_set.bitpage { U32Range }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.order { Ordering }
import silk.collections.hash { Hash }
import silk.collections.hash_set { HashSet }
import silk.num.u32
import silk.num.u64

fn optional(input: Option<u32>, expected: i64) -> bool {
  return match move input {
    Option<u32>.Some { value } => u32.toI64(value) == expected
    _ => expected == -1
  }
}

fn sameOptional(a: Option<u32>, b: Option<u32>) -> bool {
  let left = match move a {
    Option<u32>.Some { value } => u32.toI64(value)
    _ => -1
  }
  return optional(move b, left)
}

effect fn items(set: &U32Set, from: u32, reverse: bool, expected: &[u32]) -> ()
  ! AssertionError<'static> {
  let mut it = U32Set.iterFrom(set, from)
  let mut i: usize = 0
  while i < expected.length {
    let mut got = Option<u32>.None
    if reverse {
      got = U32SetIter.nextBack(&mut it)
    } else {
      got = U32SetIter.next(&mut it)
    }
    run Testing.expect(optional(move got, u32.toI64(expected[i])), "ordered set items")
    i = i + 1
  }
  run Testing.expect(
    optional(U32SetIter.next(&mut it), -1) && optional(U32SetIter.nextBack(&mut it), -1),
    "exhausted both ends",
  )
}

effect fn checkRanges(expected: &[U32Range]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  let mut i: usize = 0
  while i < expected.length {
    run U32Set.insertRange(&mut set, expected[i].first, expected[i].last)
    i = i + 1
  }
  run rangeItems(&set, expected)
}

effect fn rangeItems(set: &U32Set, expected: &[U32Range]) -> ()
  ! AssertionError<'static> {
  let mut iter = U32Set.iterRanges(set)
  let mut i: usize = 0
  while i < expected.length {
    let got = match move U32SetRangeIter.next(&mut iter) {
      Option<U32Range>.Some { value } => value
      _ => {
        run Testing.expect(false, "range exists")
        return
      }
    }
    run Testing.expect(
      got.first == expected[i].first && got.last == expected[i].last,
      "range bounds",
    )
    i = i + 1
  }
  run Testing.expect(
    match move U32SetRangeIter.next(&mut iter) {
      Option<U32Range>.None => true
      _ => false
    },
    "ranges exhausted",
  )
}

effect fn checkProcess(a: &[u32], b: &[u32], expected: &[u32], operation: u8) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut result = run U32Set.fromValues(a)
  let other = run U32Set.fromValues(b)
  let wanted = run U32Set.fromValues(expected)
  if operation == 0 {
    run U32Set.unionValue(&mut result, &other)
  } else if operation == 1 {
    run U32Set.intersect(&mut result, &other)
  } else if operation == 2 {
    run U32Set.subtract(&mut result, &other)
  } else {
    run U32Set.reversedSubtract(&mut result, &other)
  }
  run Testing.expect(
    U32Set.equals(&result, &wanted) && U32Set.len(&result) == U32Set.len(&wanted),
    "set operation",
  )
}

effect fn individualRange(first: u32, last: u32) -> U32Set
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = U32Set.empty()
  let mut n = u32.toU64(first)
  while n <= u32.toU64(last) {
    drop run U32Set.insert(&mut result, u64.toU32(n))
    n = n + 1
  }
  return move result
}

effect fn orderingCase(a: &[u32], b: &[u32], expected: Ordering) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let left = run U32Set.fromValues(a)
  let right = run U32Set.fromValues(b)
  run Testing.expect(U32Set.compare(&left, &right) == expected, "lexicographic order")
}

