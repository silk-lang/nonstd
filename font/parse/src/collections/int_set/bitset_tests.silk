effect fn iterFromBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run U32Set.fromValues(&[5, 7, 10, 1250, 1300, 3001])
  run items(&set, 0, false, &[5, 7, 10, 1250, 1300, 3001])
  run items(&set, 4, false, &[5, 7, 10, 1250, 1300, 3001])
  run items(&set, 5, false, &[5, 7, 10, 1250, 1300, 3001])
  run items(&set, 6, false, &[7, 10, 1250, 1300, 3001])
  run items(&set, 10, false, &[10, 1250, 1300, 3001])
  run items(&set, 700, false, &[1250, 1300, 3001])
  run items(&set, 1250, false, &[1250, 1300, 3001])
  run items(&set, 1251, false, &[1300, 3001])
  run items(&set, 3000, false, &[3001])
  run items(&set, 3001, false, &[3001])
  run items(&set, 3002, false, &[])
  run items(&set, 5000, false, &[])
  run items(&set, 4294967295, false, &[])
  drop run U32Set.insert(&mut set, u32.MAX)
  run items(&set, u32.MAX, false, &[u32.MAX])
  run items(&set, u32.MAX - 1, false, &[u32.MAX])
  let boundary = run U32Set.fromValues(&[510, 511, 512])
  run items(&boundary, 509, false, &[510, 511, 512])
  run items(&boundary, 510, false, &[510, 511, 512])
  run items(&boundary, 511, false, &[511, 512])
  run items(&boundary, 512, false, &[512])
  run items(&boundary, 513, false, &[])
}

test effect fn nextAfter() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAfterBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAfterBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  run Testing.expect(optional(U32Set.nextAfter(&set, 0), -1), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 4294967295), -1),
    "upstream U32Set expectation",
  )
  run U32Set.extend(&mut set, &[5, 7, 10, 63, 64, 511, 512, 1250, 1300, 3001])
  run Testing.expect(optional(U32Set.nextAfter(&set, 0), 5), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 4), 5), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 5), 7), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 10), 63), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 63), 64), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 64), 511), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 511), 512), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 512), 1250), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 700), 1250), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 1300), 3001), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 3001), -1), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 4294967295), -1),
    "upstream U32Set expectation",
  )
  drop run U32Set.insert(&mut set, u32.MAX)
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 3001), 4294967295),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 4294967294), 4294967295),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 4294967295), -1),
    "upstream U32Set expectation",
  )
  U32Set.removeRange(&mut set, 512, 3001)
  run Testing.expect(optional(U32Set.nextAfter(&set, 64), 511), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAfter(&set, 511), 4294967295),
    "upstream U32Set expectation",
  )
}

test effect fn nextAfterMatchesIterFrom() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAfterMatchesIterFromBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAfterMatchesIterFromBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let set = run U32Set.fromValues(&[0, 1, 62, 63, 64, 127, 128, 500, 511, 512, 1023, 1024, 2000])
  let mut n: u32 = 0
  while n <= 2100 {
    let mut it = U32Set.iterFrom(&set, n + 1)
    run Testing.expect(
      sameOptional(U32Set.nextAfter(&set, n), U32SetIter.next(&mut it)),
      "upstream U32Set expectation",
    )
    n = n + 1
  }
}

test effect fn nextAfterWithStalePageLookup() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAfterWithStalePageLookupBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAfterWithStalePageLookupBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run U32Set.fromValues(&[1000, 1100])
  run Testing.expect(optional(U32Set.nextAfter(&set, 1000), 1100), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 999), 1001),
    "upstream U32Set expectation",
  )
  drop run U32Set.insert(&mut set, 5)
  run Testing.expect(optional(U32Set.nextAfter(&set, 1000), 1100), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 0), 5), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAfter(&set, 5), 1000), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 999), 1001),
    "upstream U32Set expectation",
  )
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 4), 6), "upstream U32Set expectation")
}

test effect fn nextAbsentAfter() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAbsentAfterBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAbsentAfterBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 0), 1), "upstream U32Set expectation")
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294967294), 4294967295),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294967295), -1),
    "upstream U32Set expectation",
  )
  run U32Set.extend(&mut set, &[5, 6, 7, 63, 64])
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 3), 4), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 4), 8), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 7), 8), "upstream U32Set expectation")
  run Testing.expect(optional(U32Set.nextAbsentAfter(&set, 62), 65), "upstream U32Set expectation")
  run U32Set.insertRange(&mut set, 1000, 2047)
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 999), 2048),
    "upstream U32Set expectation",
  )
  run U32Set.insertRange(&mut set, 2048, 2500)
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 999), 2501),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 2500), 2501),
    "upstream U32Set expectation",
  )
  U32Set.removeRange(&mut set, 1000, 2500)
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 999), 1000),
    "upstream U32Set expectation",
  )
  U32Set.clear(&mut set)
  run U32Set.insertRange(&mut set, u32.MAX - 1000, u32.MAX)
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294965295), 4294965296),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294966293), 4294966294),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294966294), -1),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    optional(U32Set.nextAbsentAfter(&set, 4294967294), -1),
    "upstream U32Set expectation",
  )
}

test effect fn nextAbsentAfterMatchesContains() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAbsentAfterMatchesContainsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAbsentAfterMatchesContainsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run U32Set.fromValues(&[0, 1, 2, 62, 63, 64, 127, 128, 500, 511, 512, 513])
  run U32Set.insertRange(&mut set, 1024, 1535)
  run U32Set.insertRange(&mut set, 1600, 2100)
  let mut n: u32 = 0
  while n <= 2200 {
    let mut expected = n + 1
    while U32Set.contains(&set, expected) {
      expected = expected + 1
    }
    run Testing.expect(
      optional(U32Set.nextAbsentAfter(&set, n), u32.toI64(expected)),
      "upstream U32Set expectation",
    )
    n = n + 1
  }
}

test effect fn extend() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run extendBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn extendBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let values: [u32; 7] = [3, 8, 534, 700, 10000, 10001, 10002]
  let unsorted: [u32; 7] = [10000, 3, 534, 700, 8, 10001, 10002]
  let mut s0 = U32Set.empty()
  run U32Set.extend(&mut s0, &values)
  run items(&s0, 0, false, &values)
  run Testing.expect(U32Set.len(&s0) == 7, "upstream U32Set expectation")
  let mut s1 = U32Set.empty()
  run U32Set.extendUnsorted(&mut s1, &values)
  run items(&s1, 0, false, &values)
  run Testing.expect(U32Set.len(&s1) == 7, "upstream U32Set expectation")
  let mut s2 = U32Set.empty()
  run U32Set.extend(&mut s2, &unsorted)
  run items(&s2, 0, false, &values)
  run Testing.expect(U32Set.len(&s2) == 7, "upstream U32Set expectation")
  let mut s3 = U32Set.empty()
  run U32Set.extendUnsorted(&mut s3, &unsorted)
  run items(&s3, 0, false, &values)
  run Testing.expect(U32Set.len(&s3) == 7, "upstream U32Set expectation")
}

test effect fn insertUnordered() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run insertUnorderedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn insertUnorderedBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  run Testing.expect(!U32Set.contains(&set, 0), "upstream U32Set expectation")
  run Testing.expect(!U32Set.contains(&set, 768), "upstream U32Set expectation")
  run Testing.expect(!U32Set.contains(&set, 1678), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 0), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 1678), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 768), "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 0), "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 768), "upstream U32Set expectation")
  run Testing.expect(U32Set.contains(&set, 1678), "upstream U32Set expectation")
  run Testing.expect(!U32Set.contains(&set, 1), "upstream U32Set expectation")
  run Testing.expect(!U32Set.contains(&set, 769), "upstream U32Set expectation")
  run Testing.expect(!U32Set.contains(&set, 1679), "upstream U32Set expectation")
  run Testing.expect(U32Set.len(&set) == 3, "upstream U32Set expectation")
}

test effect fn remove() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run removeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn removeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = U32Set.empty()
  run Testing.expect(run U32Set.insert(&mut set, 0), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 511), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 512), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 1678), "upstream U32Set expectation")
  run Testing.expect(run U32Set.insert(&mut set, 768), "upstream U32Set expectation")
  run Testing.expect(U32Set.len(&set) == 5, "upstream U32Set expectation")
  run Testing.expect(
    !U32Set.remove(&mut set, 12) && U32Set.remove(&mut set, 511) && U32Set.remove(&mut set, 512)
      && !U32Set.remove(&mut set, 512),
    "upstream U32Set expectation",
  )
  run Testing.expect(
    U32Set.len(&set) == 3 && U32Set.contains(&set, 0) && !U32Set.contains(&set, 511)
      && !U32Set.contains(&set, 512),
    "upstream U32Set expectation",
  )
}

