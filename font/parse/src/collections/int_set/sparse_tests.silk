effect fn invalidBiasedAndBoundedBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run rejected(&[13, 3, 243], 0, u32.MAX, u32.MAX, true)
  run rejected(&[13, 3, 243], 0, 20, u32.MAX, true)
  run rejected(&[13, 3, 243], 0, 19, u32.MAX, true)
  run rejected(&[13, 3, 243], 0, 18, u32.MAX, true)
  run rejected(&[13, 3, 243], 0, 15, u32.MAX, true)
  run rejected(&[13, 3, 243], 0, 14, u32.MAX, true)
  run rejected(&[13, 3, 243], 1, 20, u32.MAX, true)
  run rejected(&[13, 3, 243], 2, 20, u32.MAX, true)
  run rejected(&[13, 3, 243], 3, 20, u32.MAX, true)
  run rejected(&[13, 3, 243], 6, 20, u32.MAX, true)
}

test effect fn largerThanU32() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run largerThanU32Body() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn largerThanU32Body() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  if true {
    let got = run decoded(
      &[
        31,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        128,
        0,
        0,
        0,
        1,
      ],
    )
    run Testing.expect(IntSet<u32>.isEmpty(&got), "upstream sparse set expectation")
  }
  if true {
    let got = run decoded(&[31, 0, 0, 0, 128, 0, 0, 0, 0])
    run Testing.expect(IntSet<u32>.isEmpty(&got), "upstream sparse set expectation")
  }
}

