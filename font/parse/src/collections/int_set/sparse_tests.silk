effect fn fromSparseBitSetBiasedAndBoundedBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run bounded(&[13, 3, 243, 1], 0, 20, 0, 20, &[])
  run bounded(&[13, 3, 243, 1], 0, 19, 0, 19, &[])
  run bounded(&[13, 3, 243, 1], 1, 20, 1, 20, &[])
  run bounded(&[13, 3, 243, 1], 1, 18, 1, 18, &[])
  run bounded(&[13, 3, 243, 1], 0, 14, 0, 14, &[])
  run bounded(&[13, 3, 243, 1], 6, 20, 6, 20, &[])
  run bounded(&[13, 3, 243, 1], 0, 0, 0, 0, &[])
  run bounded(&[13, 3, 243, 1], 1, 0, 1, 0, &[])
  run bounded(&[0], 5, 0, 1, 0, &[])
}

test effect fn fromSparseBitSetBoundedWithMaxSetSize() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fromSparseBitSetBoundedWithMaxSetSizeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fromSparseBitSetBoundedWithMaxSetSizeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let discrete = run IntSet<u32>.fromValues(&[0, 2, 4, 6, 8, 10])
  let discreteBytes = run toSparseBitSetWithBf(&discrete, BranchFactor.Four)
  run rejected(List<u8>.asSlice(&discreteBytes), 0, u32.MAX, 6, false)
  run rejected(List<u8>.asSlice(&discreteBytes), 0, u32.MAX, 100, false)
  run rejected(List<u8>.asSlice(&discreteBytes), 0, u32.MAX, 5, true)
  run rejected(List<u8>.asSlice(&discreteBytes), 0, u32.MAX, 0, true)
  let filled = run rangeSet(0, 63)
  let fillBytes = run toSparseBitSetWithBf(&filled, BranchFactor.Eight)
  run rejected(List<u8>.asSlice(&fillBytes), 0, u32.MAX, 64, false)
  run rejected(List<u8>.asSlice(&fillBytes), 0, u32.MAX, 63, true)
  let empty = IntSet<u32>.empty()
  let emptyBytes = run toSparseBitSetWithBf(&empty, BranchFactor.Four)
  run rejected(List<u8>.asSlice(&emptyBytes), 0, u32.MAX, 0, false)
}

test effect fn treeHeightFor() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run treeHeightForBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn treeHeightForBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  if true {
    let bf = BranchFactor.Two
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 0) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Two
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 1) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Two
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 2) == 2, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Two
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 117) == 7, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Four
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 0) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Four
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 3) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Four
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 4) == 2, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Four
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 63) == 3, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Four
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 64) == 4, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Eight
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 0) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Eight
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 7) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Eight
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 8) == 2, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.Eight
    run Testing.expect(
      BranchFactor.treeHeightFor(&bf, 32767) == 5,
      "upstream sparse set expectation",
    )
  }
  if true {
    let bf = BranchFactor.Eight
    run Testing.expect(
      BranchFactor.treeHeightFor(&bf, 32768) == 6,
      "upstream sparse set expectation",
    )
  }
  if true {
    let bf = BranchFactor.ThirtyTwo
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 0) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.ThirtyTwo
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 31) == 1, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.ThirtyTwo
    run Testing.expect(BranchFactor.treeHeightFor(&bf, 32) == 2, "upstream sparse set expectation")
  }
  if true {
    let bf = BranchFactor.ThirtyTwo
    run Testing.expect(
      BranchFactor.treeHeightFor(&bf, 1_048_575) == 4,
      "upstream sparse set expectation",
    )
  }
  if true {
    let bf = BranchFactor.ThirtyTwo
    run Testing.expect(
      BranchFactor.treeHeightFor(&bf, 1_048_576) == 5,
      "upstream sparse set expectation",
    )
  }
}

