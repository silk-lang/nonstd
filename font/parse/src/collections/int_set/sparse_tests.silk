effect fn invalidBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run rejected(&[14, 33, 17, 1, 4, 2], 0, u32.MAX, u32.MAX, true)
  run rejected(
    &[
      35,
      0,
      0,
      0,
      128,
      0,
      0,
      0,
      128,
      0,
      0,
      0,
      128,
