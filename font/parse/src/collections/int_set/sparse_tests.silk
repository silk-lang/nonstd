// Ports of all upstream sparse-bit-set tests, including exact encodings.
import collections.int_set {
  IntSet,
  IntSetIter,
  DecodingError,
  DecodedSparseSet,
  BranchFactor,
  toSparseBitSetWithBf
}
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u32

effect fn decoded(data: &[u8]) -> IntSet<u32>
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  match move run IntSet<u32>.fromSparseBitSet(data) {
    Result<IntSet<u32>, DecodingError>.Success { value } => {
      return move value
    }
    _ => {
      run Testing.expect(false, "sparse decoding succeeds")
      return IntSet<u32>.empty()
    }
  }
}

effect fn bytes(actual: &[u8], expected: &[u8]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "sparse byte count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "sparse byte value")
    i = i + 1
  }
}

effect fn rangeSet(first: u32, last: u32) -> IntSet<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run IntSet<u32>.insertRange(&mut set, first, last)
  return move set
}

effect fn encoded(set: &IntSet<u32>, bf: BranchFactor, expected: &[u8]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let actual = run toSparseBitSetWithBf(set, bf)
  run bytes(List<u8>.asSlice(&actual), expected)
}

effect fn bounded<'a>(
  data: &'a [u8],
  bias: u32,
  maximum: u32,
  first: u32,
  last: u32,
  remaining: &[u8],
) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let got = match move run IntSet<u32>.fromSparseBitSetBounded(data, bias, maximum) {
    Result<DecodedSparseSet<'a>, DecodingError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "bounded decoding succeeds")
      return
    }
  }
  let expected = run rangeSet(first, last)
  run Testing.expect(IntSet<u32>.equals(&got.set, &expected), "bounded membership")
  run bytes(got.remaining, remaining)
}

effect fn rejected<'a>(data: &'a [u8], bias: u32, maximum: u32, limit: u32, expected: bool) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let failed = match move run IntSet<u32>.fromSparseBitSetBoundedWithMaxSetSize(
    data,
    bias,
    maximum,
    limit,
  ) {
    Result<DecodedSparseSet<'a>, DecodingError>.Failure { error } => true
    _ => false
  }
  run Testing.expect(failed == expected, "bounded size or malformed rejection")
}

effect fn roundTrip(set: &IntSet<u32>, bf: BranchFactor) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let data = run toSparseBitSetWithBf(set, bf)
  let copy = run decoded(List<u8>.asSlice(&data))
  run Testing.expect(IntSet<u32>.equals(set, &copy), "sparse round trip")
}

test effect fn specExample2() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run specExample2Body() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn specExample2Body() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let got = run decoded(&[14, 33, 17, 1, 4, 2, 8])
  let expected = run IntSet<u32>.fromValues(&[2, 33, 323])
  run Testing.expect(IntSet<u32>.equals(&got, &expected), "upstream sparse set expectation")
}

