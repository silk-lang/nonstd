effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn present<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn none<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

effect fn math() -> Math<'static>
  ! AssertionError<'static> {
  return run must(Math.read(FontData.new(Fixtures.mathTable())))
}

effect fn constants() -> MathConstants<'static>
  ! AssertionError<'static> {
  return run must(Math.mathConstants(&run math()))
}

effect fn kernInfo() -> MathKernInfo<'static>
  ! AssertionError<'static> {
  let info = run must(Math.mathGlyphInfo(&run math()))
  return run must(run present(MathGlyphInfo.mathKernInfo(&info)))
}

effect fn kern() -> MathKern<'static>
  ! AssertionError<'static> {
  return run present(MathKernInfo.kern(&run kernInfo(), GlyphId.new(9), MathKernCorner.TopRight))
}

effect fn value(actual: MathValue, stored: i32, delta: i32) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    actual.value == stored && actual.deltaPx == delta,
    "design value and independent pixel adjustment",
  )
}

test effect fn constantsAreInSpecOrder() -> ()
  ! AssertionError<'static> {
  let constants = run constants()
  run Testing.expect(
    MathConstants.scriptPercentScaleDown(&constants) == 1
      && MathConstants.scriptScriptPercentScaleDown(&constants) == 2
      && UfWord.toU16(MathConstants.delimitedSubFormulaMinHeight(&constants)) == 3
      && UfWord.toU16(MathConstants.displayOperatorMinHeight(&constants)) == 4
      && MathConstants.radicalDegreeBottomRaisePercent(&constants) == 5,
    "bare constants in specification order",
  )
  let values = [
    MathConstants.mathLeading(&constants),
    MathConstants.axisHeight(&constants),
    MathConstants.accentBaseHeight(&constants),
    MathConstants.flattenedAccentBaseHeight(&constants),
    MathConstants.subscriptShiftDown(&constants),
    MathConstants.subscriptTopMax(&constants),
    MathConstants.subscriptBaselineDropMin(&constants),
    MathConstants.superscriptShiftUp(&constants),
    MathConstants.superscriptShiftUpCramped(&constants),
    MathConstants.superscriptBottomMin(&constants),
    MathConstants.superscriptBaselineDropMax(&constants),
    MathConstants.subSuperscriptGapMin(&constants),
    MathConstants.superscriptBottomMaxWithSubscript(&constants),
    MathConstants.spaceAfterScript(&constants),
    MathConstants.upperLimitGapMin(&constants),
    MathConstants.upperLimitBaselineRiseMin(&constants),
    MathConstants.lowerLimitGapMin(&constants),
    MathConstants.lowerLimitBaselineDropMin(&constants),
    MathConstants.stackTopShiftUp(&constants),
    MathConstants.stackTopDisplayStyleShiftUp(&constants),
    MathConstants.stackBottomShiftDown(&constants),
    MathConstants.stackBottomDisplayStyleShiftDown(&constants),
    MathConstants.stackGapMin(&constants),
    MathConstants.stackDisplayStyleGapMin(&constants),
    MathConstants.stretchStackTopShiftUp(&constants),
    MathConstants.stretchStackBottomShiftDown(&constants),
    MathConstants.stretchStackGapAboveMin(&constants),
    MathConstants.stretchStackGapBelowMin(&constants),
    MathConstants.fractionNumeratorShiftUp(&constants),
    MathConstants.fractionNumeratorDisplayStyleShiftUp(&constants),
    MathConstants.fractionDenominatorShiftDown(&constants),
    MathConstants.fractionDenominatorDisplayStyleShiftDown(&constants),
    MathConstants.fractionNumeratorGapMin(&constants),
    MathConstants.fractionNumDisplayStyleGapMin(&constants),
    MathConstants.fractionRuleThickness(&constants),
    MathConstants.fractionDenominatorGapMin(&constants),
    MathConstants.fractionDenomDisplayStyleGapMin(&constants),
    MathConstants.skewedFractionHorizontalGap(&constants),
    MathConstants.skewedFractionVerticalGap(&constants),
    MathConstants.overbarVerticalGap(&constants),
    MathConstants.overbarRuleThickness(&constants),
    MathConstants.overbarExtraAscender(&constants),
    MathConstants.underbarVerticalGap(&constants),
    MathConstants.underbarRuleThickness(&constants),
    MathConstants.underbarExtraDescender(&constants),
    MathConstants.radicalVerticalGap(&constants),
    MathConstants.radicalDisplayStyleVerticalGap(&constants),
    MathConstants.radicalRuleThickness(&constants),
    MathConstants.radicalExtraAscender(&constants),
    MathConstants.radicalKernBeforeDegree(&constants),
    MathConstants.radicalKernAfterDegree(&constants),
  ]
  run Testing.expect(values.length == 51, "all value records")
  let mut i: usize = 0
  while i < values.length {
    run Testing.expect(
      FWord.toI16(MathValueRecord.value(&values[i])) == 100 + usize.toI16(i),
      "named accessor agrees with specification position",
    )
    i = i + 1
  }
}

test effect fn cambriaMathIsRecognizedByAllThreeValues() -> ()
  ! AssertionError<'static> {
  let original = Fixtures.mathTable()
  let mut bytes: [u8; 25723] = [0; 25723]
  let mut index: usize = 0
  while index < original.length {
    bytes[index] = original[index]
    index = index + 1
  }
  Builder.put16(&mut bytes, 14, 3000)
  Builder.put16(&mut bytes, 16, 2500)
  let expected = run must(Math.read(FontData.new(Slice.view<u8>(&bytes, 0, 25722))))
  run Testing.expect(Math.hasSwappedMinHeights(&expected), "complete Cambria fingerprint")
  let longer = run must(Math.read(FontData.new(&bytes)))
  run Testing.expect(!Math.hasSwappedMinHeights(&longer), "length participates in fingerprint")
  Builder.put16(&mut bytes, 14, 2500)
  Builder.put16(&mut bytes, 16, 3000)
  let correct = run must(Math.read(FontData.new(Slice.view<u8>(&bytes, 0, 25722))))
  run Testing.expect(
    !Math.hasSwappedMinHeights(&correct) && !Math.hasSwappedMinHeights(&run math()),
    "normal heights are not swapped",
  )
}

test effect fn constantNumberingMatchesHarfbuzz() -> ()
  ! AssertionError<'static> {
  let all = MathConstant.all()
  run Testing.expect(all.length == 56, "all 56 math constants")
  let mut i: usize = 0
  while i < all.length {
    let selected = run present(MathConstant.new(usize.toU8(i)))
    run Testing.expect(
      MathConstant.value(all[i]) == usize.toU8(i) && selected == all[i],
      "constant roundtrip",
    )
    i = i + 1
  }
  run Testing.expect(
    MathConstant.value(MathConstant.ScriptPercentScaleDown) == 0
      && MathConstant.value(MathConstant.MathLeading) == 4
      && MathConstant.value(MathConstant.AxisHeight) == 5
      && MathConstant.value(MathConstant.RadicalKernAfterDegree) == 54
      && MathConstant.value(MathConstant.RadicalDegreeBottomRaisePercent) == 55
      && none(MathConstant.new(56)),
    "ABI discriminants",
  )
}

test effect fn everyConstantReadsItsOwnField() -> ()
  ! AssertionError<'static> {
  let constants = run constants()
  let all = MathConstant.all()
  let mut i: usize = 0
  while i < all.length {
    let mut expected = 100 + usize.toI32(i) - 4
    if i < 4 {
      expected = usize.toI32(i) + 1
    } else if i == 55 {
      expected = 5
    }
    run Testing.expect(
      MathConstants.constant(&constants, all[i]) == expected
        && MathConstants.constantForPpem(&constants, all[i], 12).value == expected,
      "constant selector reads its own field",
    )
    i = i + 1
  }
}

test effect fn constantDeviceDeltasTrackPpem() -> ()
  ! AssertionError<'static> {
  let constants = run constants()
  let sizes: [u16; 6] = [10, 11, 12, 9, 13, 0]
  let deltas: [i32; 6] = [-2, 3, 7, 0, 0, 0]
  let mut i: usize = 0
  while i < sizes.length {
    run value(
      MathConstants.constantForPpem(&constants, MathConstant.AxisHeight, sizes[i]),
      101,
      deltas[i],
    )
    i = i + 1
  }
}

test effect fn variationIndexYieldsNoAdjustment() -> ()
  ! AssertionError<'static> {
  let constants = run constants()
  run Testing.expect(
    MathConstants.constant(&constants, MathConstant.MathLeading) == 100,
    "stored leading",
  )
  let sizes: [u16; 5] = [0, 10, 11, 12, 100]
  let mut i: usize = 0
  while i < sizes.length {
    run value(MathConstants.constantForPpem(&constants, MathConstant.MathLeading, sizes[i]), 100, 0)
    i = i + 1
  }
}

test effect fn italicsCorrectionResolvesAgainstItsParent() -> ()
  ! AssertionError<'static> {
  let info = run must(Math.mathGlyphInfo(&run math()))
  let italics = run must(run present(MathGlyphInfo.mathItalicsCorrectionInfo(&info)))
  let coverage = run must(MathItalicsCorrectionInfo.coverage(&italics))
  let index = run present(CoverageTable.get(&coverage, GlyphId.new(9)))
  let correction = run present(MathItalicsCorrectionInfo.correction(&italics, GlyphId.new(9)))
  run Testing.expect(
    index == 0 && correction == 37
      && none(MathItalicsCorrectionInfo.correction(&italics, GlyphId.new(10))),
    "italics coverage",
  )
  run value(
    run present(MathItalicsCorrectionInfo.correctionForPpem(&italics, GlyphId.new(9), 11)),
    37,
    5,
  )
  run value(
    run present(MathItalicsCorrectionInfo.correctionForPpem(&italics, GlyphId.new(9), 12)),
    37,
    -1,
  )
  run value(
    run present(MathItalicsCorrectionInfo.correctionForPpem(&italics, GlyphId.new(9), 20)),
    37,
    0,
  )
}

test effect fn glyphInfoLookups() -> ()
  ! AssertionError<'static> {
  let info = run must(Math.mathGlyphInfo(&run math()))
  run Testing.expect(
    none(MathGlyphInfo.mathTopAccentAttachment(&info))
      && !MathGlyphInfo.isExtendedShape(&info, GlyphId.new(9)),
    "absent accent and extended-shape tables",
  )
}

test effect fn mathKernHasOneMoreValueThanHeight() -> ()
  ! AssertionError<'static> {
  let info = run kernInfo()
  let kern = run kern()
  let heights = MathKern.correctionHeight(&kern)
  let values = MathKern.kernValues(&kern)
  run Testing.expect(
    MathKern.heightCount(&kern) == 2
      && ComputedArray<'static, (), MathValueRecord<'static>>.len(&heights) == 2
      && ComputedArray<'static, (), MathValueRecord<'static>>.len(&values) == 3,
    "two heights and three bands",
  )
  let mut i: usize = 0
  while i < 3 {
    let item = run must(ComputedArray<'static, (), MathValueRecord<'static>>.get(&values, i))
    run Testing.expect(
      FWord.toI16(MathValueRecord.value(&item)) == -1 - usize.toI16(i),
      "stored kern",
    )
    if i < 2 {
      let height = run must(ComputedArray<'static, (), MathValueRecord<'static>>.get(&heights, i))
      run Testing.expect(
        FWord.toI16(MathValueRecord.value(&height)) == 20 + 20 * usize.toI16(i),
        "stored height",
      )
    }
    i = i + 1
  }
  run Testing.expect(
    none(MathKernInfo.kern(&info, GlyphId.new(9), MathKernCorner.TopLeft))
      && none(MathKernInfo.kern(&info, GlyphId.new(10), MathKernCorner.TopRight)),
    "absent corner and glyph",
  )
}

test effect fn kerningPicksTheBandTheHeightFallsIn() -> ()
  ! AssertionError<'static> {
  let kern = run kern()
  let heights: [i32; 6] = [0, 19, 20, 39, 40, 1000]
  let expected: [i32; 6] = [-1, -1, -2, -2, -3, -3]
  let mut i: usize = 0
  while i < heights.length {
    let result = run present(MathKern.kerning(&kern, heights[i]))
    run Testing.expect(result == expected[i], "height at boundary starts next band")
    i = i + 1
  }
}

test effect fn kernEntriesCarryTheirOwnAdjustments() -> ()
  ! AssertionError<'static> {
  let kern = run kern()
  let sizes: [u16; 3] = [10, 11, 12]
  let heightDeltas: [i32; 3] = [4, -6, 0]
  let kernDeltas: [i32; 3] = [1, 2, 0]
  let mut i: usize = 0
  while i < sizes.length {
    let mut iter = MathKern.entriesForPpem(&kern, sizes[i])
    let first = run present(MathKernEntryIter.next(&mut iter))
    run value(run present(move first.maxHeight), 20, 0)
    run value(first.kern, -1, 0)
    let second = run present(MathKernEntryIter.next(&mut iter))
    run value(run present(move second.maxHeight), 40, heightDeltas[i])
    run value(second.kern, -2, kernDeltas[i])
    let last = run present(MathKernEntryIter.next(&mut iter))
    run Testing.expect(
      none(move last.maxHeight) && none(MathKernEntryIter.next(&mut iter)),
      "last band is unbounded",
    )
    run value(last.kern, -3, 0)
    i = i + 1
  }
  let actual = run present(MathKern.kerning(&kern, 40))
  run Testing.expect(actual == -3, "kerning uses stored heights")
}

test effect fn variantsAndAssembly() -> ()
  ! AssertionError<'static> {
  let variants = run must(Math.mathVariants(&run math()))
  run Testing.expect(
    UfWord.toU16(MathVariants.minConnectorOverlap(&variants)) == 6,
    "minimum connector overlap",
  )
  let construction = run present(
    MathVariants.glyphConstruction(&variants, GlyphId.new(9), StretchAxis.Vertical),
  )
  let records = MathGlyphConstruction.mathGlyphVariantRecords(&construction)
  run Testing.expect(
    ComputedArray<'static, (), MathGlyphVariantRecord<'static>>.len(&records) == 2,
    "two glyph variants",
  )
  let mut i: usize = 0
  while i < 2 {
    let record = run must(
      ComputedArray<'static, (), MathGlyphVariantRecord<'static>>.get(&records, i),
    )
    run Testing.expect(
      GlyphId16.toU32(MathGlyphVariantRecord.variantGlyph(&record)) == 21 + usize.toU32(i)
        && UfWord.toU16(MathGlyphVariantRecord.advanceMeasurement(&record))
          == 300 + 100 * usize.toU16(i),
      "variant glyph and advance",
    )
    i = i + 1
  }
  run Testing.expect(
    none(MathVariants.glyphConstruction(&variants, GlyphId.new(9), StretchAxis.Horizontal)),
    "no horizontal stretching",
  )
  let assembly = run must(run present(MathGlyphConstruction.glyphAssembly(&construction)))
  run Testing.expect(
    FWord.toI16(MathValueRecord.value(&GlyphAssembly.italicsCorrection(&assembly))) == 17,
    "assembly italics",
  )
  run value(GlyphAssembly.italicsCorrectionForPpem(&assembly, 12), 17, 0)
  let part = run must(
    ComputedArray<'static, (), GlyphPartRecord<'static>>.get(
      &GlyphAssembly.partRecords(&assembly),
      0,
    ),
  )
  run Testing.expect(
    GlyphId16.toU32(GlyphPartRecord.glyphId(&part)) == 23
      && UfWord.toU16(GlyphPartRecord.startConnectorLength(&part)) == 10
      && UfWord.toU16(GlyphPartRecord.endConnectorLength(&part)) == 11
      && UfWord.toU16(GlyphPartRecord.fullAdvance(&part)) == 50
      && PartFlags.contains(&GlyphPartRecord.partFlags(&part), PartFlags.extenderFlag()),
    "extender assembly part",
  )
}

test effect fn accentsAndExtendedShapesUseTheirOwnCoverage() -> ()
  ! AssertionError<'static> {
  let info = run must(
    MathGlyphInfo.read(
      FontData.new(
        b"\x00\x00\x00\x08\x00\x10\x00\x00\x00\x08\x00\x01\x00\x25\x00\x00\x00\x01\x00\x01\x00\x09",
      ),
    ),
  )
  let accent = run must(run present(MathGlyphInfo.mathTopAccentAttachment(&info)))
  let actual = run present(MathTopAccentAttachment.attachment(&accent, GlyphId.new(9)))
  run Testing.expect(
    actual == 37 && none(MathTopAccentAttachment.attachment(&accent, GlyphId.new(10)))
      && MathGlyphInfo.isExtendedShape(&info, GlyphId.new(9))
      && !MathGlyphInfo.isExtendedShape(&info, GlyphId.new(10)),
    "independent accent and shape coverages",
  )
  run value(
    run present(MathTopAccentAttachment.attachmentForPpem(&accent, GlyphId.new(9), 12)),
    37,
    0,
  )
}
