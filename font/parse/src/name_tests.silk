import lib { FontData }
import tables.name { MacRomanMapping, CharIter, Encoding, languageIdToBcp47 }
import silk.core.option { Option }
import silk.text.char
import silk.num.usize
import silk.num.u8
import silk.testing.testing { Testing, AssertionError }

test effect fn macRoman() -> ()
  ! AssertionError<'static> {
  // Exact characters from upstream's "Joachim Müller-Lancé" fixture.
  let codes: [u32; 19] = [
    74,
    111,
    97,
    99,
    104,
    105,
    109,
    32,
    77,
    252,
    108,
    108,
    101,
    114,
    45,
    76,
    97,
    110,
    99,
  ]
  let mut i: usize = 0
  while i < codes.length {
    let c = char.fromU32(codes[i]) |> Option<char>.unwrapOr(' ')
    let encoded = MacRomanMapping.encode(c) |> Option<u8>.unwrapOr(0)
    run Testing.expect(MacRomanMapping.decode(encoded) == c, "Mac Roman character roundtrip")
    i = i + 1
  }
  let accent = MacRomanMapping.encode('é') |> Option<u8>.unwrapOr(0)
  run Testing.expect(MacRomanMapping.decode(accent) == 'é', "final accent")
  i = 0
  while i < 256 {
    let c = MacRomanMapping.decode(usize.toU8(i))
    run Testing.expect(
      (MacRomanMapping.encode(c) |> Option<u8>.unwrapOr(0)) == usize.toU8(i),
      "all encoded bytes roundtrip",
    )
    i = i + 1
  }
}

effect fn checkChars<'a>(bytes: &'a [u8], expected: &[u32]) -> ()
  ! AssertionError<'static> {
  let mut iter = CharIter<'a>.new(FontData.new(bytes), Encoding.Utf16Be)
  let mut i: usize = 0
  while i < expected.length {
    let actual: u32 = match move CharIter<'a>.next(&mut iter) {
      Option<char>.Some { value } => char.toU32(value)
      Option<char>.None => 4294967295
    }
    run Testing.expect(actual == expected[i], "decoded scalar")
    i = i + 1
  }
  let ended = match move CharIter<'a>.next(&mut iter) {
    Option<char>.None => true
    _ => false
  }
  run Testing.expect(ended, "decoder ends")
}

test effect fn loneSurrogateAtEnd() -> ()
  ! AssertionError<'static> {
  run checkChars(b"\x09\x04\xd8\x00", &[2308, 65533])
}

test effect fn highSurrogateFollowedByNonLow() -> ()
  ! AssertionError<'static> {
  run checkChars(b"\xd8\x00\x00\x41", &[65533, 65])
  run checkChars(b"\xd8\x00\xd8\x3d\xde\x00", &[65533, 128512])
}

test effect fn respectsPlatformAndUnknownIds() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    (languageIdToBcp47(1, 0) |> Option<string>.unwrapOr("")) == "en",
    "Mac English",
  )
  run Testing.expect(
    (languageIdToBcp47(3, 1033) |> Option<string>.unwrapOr("")) == "en-US",
    "Windows English",
  )
  run Testing.expect(
    (languageIdToBcp47(1, 1033) |> Option<string>.unwrapOr("")) == "",
    "Windows ID rejected on Mac",
  )
  run Testing.expect(
    (languageIdToBcp47(3, 0) |> Option<string>.unwrapOr("")) == "",
    "Mac ID rejected on Windows",
  )
  run Testing.expect(
    (languageIdToBcp47(0, 0) |> Option<string>.unwrapOr("")) == "",
    "Unicode platform absent",
  )
  run Testing.expect(
    (languageIdToBcp47(3, 65535) |> Option<string>.unwrapOr("")) == "",
    "unknown language absent",
  )
}
