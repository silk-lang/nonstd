import generated_variation_fixtures as Fixtures
import generated_layout { FeatureVariations, SelectedFeatureVariations }
import generated_gsub { Gsub }
import generated_fvar { Fvar, UserCoordinate }
import generated_avar { Avar }
import font { FontRef }
import read { ReadError }
import font_types.lib { Tag, Fixed, F2Dot14 }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: item } => move item
    _ => {
      run Testing.expect(false, "selection fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: item } => move item
    _ => {
      run Testing.expect(false, "selection fixture exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn isNone<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

effect fn coordsAt(font: &FontRef<'static>, value: f64) -> [F2Dot14; 4]
  ! AssertionError<'static> | OutOfMemoryError {
  let fvar = run must(FontRef.fvar(font))
  run Testing.expect(Fvar.axisCount(&fvar) == 4, "four Material Symbols axes")
  let avar = match move FontRef.avar(font) {
    Result<Avar<'static>, ReadError>.Success { value: table } => Option<Avar<'static>>.some(table)
    _ => Option<Avar<'static>>.None
  }
  let mut coords = [F2Dot14.zero(); 4]
  let user = [UserCoordinate { tag: Tag.fromU32(1179208780), value: Fixed.fromF64(value) }]
  let mut allocator = Allocator.systemAllocatorProvider()
  run Fvar.userToNormalized(&fvar, move avar, &user, &mut coords)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return coords
}

test effect fn indexForCoordsHonorsConditionSet() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let font = run must(FontRef.new(Fixtures.fontMaterialSymbolsSubset()))
  let gsub = run must(FontRef.gsub(&font))
  let variations = run must(run some(Gsub.featureVariations(&gsub)))
  let high = run coordsAt(&font, 1.0)
  let middle = run coordsAt(&font, 0.5)
  run Testing.expect(
    (FeatureVariations.indexForCoords(&variations, &high) |> Option<u32>.unwrapOr(99)) == 0,
    "high fill selects feature variation",
  )
  run Testing.expect(
    isNone(FeatureVariations.indexForCoords(&variations, &middle))
      && isNone(FeatureVariations.indexForCoords(&variations, &[])),
    "middle and missing coordinates do not select",
  )
}

test effect fn selectedFeatureVariations() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let font = run must(FontRef.new(Fixtures.fontMaterialSymbolsSubset()))
  let values: [f64; 5] = [0.0, 0.5, 0.98, 0.99, 1.0]
  let mut i: usize = 0
  while i < 5 {
    let coords = run coordsAt(&font, values[i])
    let selected = SelectedFeatureVariations.new(&font, &coords)
    let mut expected: u32 = 99
    if i >= 3 {
      expected = 0
    }
    run Testing.expect(
      (move selected.gsub |> Option<u32>.unwrapOr(99)) == expected && isNone(move selected.gpos),
      "feature variation selection",
    )
    i = i + 1
  }
}

test effect fn fontWithoutLayoutTablesSelectsNothing() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.fontNamesOnly()))
  let selected = SelectedFeatureVariations.new(&font, &[])
  let empty = SelectedFeatureVariations.default()
  run Testing.expect(&selected == &empty, "missing layout is default")
}
