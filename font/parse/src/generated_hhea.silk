impl<'a> MinByteRange<'a> for HheaExtended<'a> {
  fn minByteRange(self: &Self) -> ByteRange {
    return ByteRange { start: 0, end: self._fieldRanges[16].end }
  }

  fn minTableBytes(self: &Self) -> &'a [u8] {
    return match move FontData.slice(&self._fontData, 0, self._fieldRanges[16].end) {
      Option<FontData<'a>>.Some { value } => FontData.asBytes(&value)
      Option<FontData<'a>>.None => b""
    }
  }
}

// Handwritten extension from font/parse/src/tables/hhea_impl.silk
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
impl<'a> Hhea<'a> {
  /// Deprecated upstream alias; prefer numberOfHMetrics.
  pub fn numberOfLongMetrics(self: &Self) -> u16 {
    return Hhea<'a>.numberOfHMetrics(self)
  }
}
