import vector_path { PathRecorder }
import outline { Recorder, Op }
import read_fonts.model.glyph.outline { PathSink }
import vector.path { Path, MOVE, LINE, QUAD, CUBIC, CLOSE }
import vector.geometry { Point }
import silk.testing.testing { AssertionError, Testing }
import silk.collections.list { List }

test effect fn pathRecorderMapsFontUnitsToPixels() -> ()
  ! AssertionError<'static> {
  let mut path = Path.make()
  let mut sink = PathRecorder.new(&mut path, 0.5, 10.0, 100.0)
  PathSink.moveTo(&mut sink, 0.0, 0.0)
  PathSink.lineTo(&mut sink, 20.0, 40.0)
  PathSink.quadTo(&mut sink, 40.0, 40.0, 40.0, 0.0)
  PathSink.curveTo(&mut sink, 30.0, -20.0, 10.0, -20.0, 0.0, 0.0)
  PathSink.close(&mut sink)
  let failed = sink.failed
  run Testing.expect(!failed, "no allocation failure")
  let verbs = path.verbList()
  run Testing.expect(
    verbs.length == 5 && verbs[0] == MOVE && verbs[1] == LINE && verbs[2] == QUAD
      && verbs[3] == CUBIC
      && verbs[4] == CLOSE,
    "verbs in order",
  )
  let points = path.pointList()
  run Testing.expect(
    points.length == 7,
    "one point per move and line, two per quad, three per cubic",
  )
  run Testing.expect(points[0].x == 10.0 && points[0].y == 100.0, "origin is the pen position")
  run Testing.expect(points[1].x == 20.0 && points[1].y == 80.0, "x scales right, y flips down")
  run Testing.expect(points[2].x == 30.0 && points[2].y == 80.0, "quad control")
  run Testing.expect(
    points[4].x == 25.0 && points[4].y == 110.0,
    "cubic control below the baseline",
  )
}

test effect fn recorderWritesOpcodesThenCoordinates() -> ()
  ! AssertionError<'static> {
  let mut commands = List<f32>.make()
  let mut sink = Recorder { out: &mut commands, failed: false }
  PathSink.moveTo(&mut sink, 1.0, 2.0)
  PathSink.close(&mut sink)
  let values = List<f32>.asSlice(&commands)
  run Testing.expect(values.length == 4, "move takes three values, close one")
  run Testing.expect(
    values[0] == 0.0 && values[1] == 1.0 && values[2] == 2.0 && values[3] == 4.0,
    "values",
  )
}
