//! Bit-preserving integer conversions missing from the pinned standard library.
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64

pub fn u8ToI8(value: u8) -> i8 {
  if value <= 127 {
    return u8.toI8(value)
  }
  return -1 - u8.toI8(255 - value)
}

pub fn i8ToU8(value: i8) -> u8 {
  if value >= 0 {
    return i8.toU8(value)
  }
  return 255 - i8.toU8(-(value + 1))
}

pub fn u16ToI16(value: u16) -> i16 {
  if value <= 32767 {
    return u16.toI16(value)
  }
  return -1 - u16.toI16(65535 - value)
}

pub fn i16ToU16(value: i16) -> u16 {
  if value >= 0 {
    return i16.toU16(value)
  }
  return 65535 - i16.toU16(-(value + 1))
}

pub fn u32ToI32(value: u32) -> i32 {
  if value <= 2147483647 {
    return u32.toI32(value)
  }
  return -1 - u32.toI32(4294967295 - value)
}

pub fn i32ToU32(value: i32) -> u32 {
  if value >= 0 {
    return i32.toU32(value)
  }
  return 4294967295 - i32.toU32(-(value + 1))
}

pub fn u64ToI64(value: u64) -> i64 {
  if value <= 9223372036854775807 {
    return u64.toI64(value)
  }
  return -1 - u64.toI64(18446744073709551615 - value)
}

pub fn i64ToU64(value: i64) -> u64 {
  if value >= 0 {
    return i64.toU64(value)
  }
  return 18446744073709551615 - i64.toU64(-(value + 1))
}

pub fn i32ToI16(value: i32) -> i16 {
  return u16ToI16(u32.toU16(i32ToU32(value) & 65535))
}

pub fn i64ToI32(value: i64) -> i32 {
  return u32ToI32(u64.toU32(i64ToU64(value) & 4294967295))
}

pub fn u64ToU32(value: u64) -> u32 {
  return u64.toU32(value & 4294967295)
}
