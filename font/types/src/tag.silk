//! Four-byte OpenType tags, with separate permissive reading and strict validation.
import scalar { Scalar, readScalar, writeScalar }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.num.u8
import silk.num.u32

pub struct Tag {
  value: u32,
}

impl Copy for Tag {}

pub union InvalidTag {
  InvalidLength { pub length: usize, },
  InvalidByte { pub pos: usize, pub byte: u8, },
  ByteAfterSpace { pub pos: usize, },
}

impl Copy for InvalidTag {}

impl Tag {
  pub fn new(bytes: &[u8; 4]) -> Tag {
    return fromArray(bytes)
  }

  pub fn fromU32(value: u32) -> Tag {
    return Tag { value: value }
  }

  pub fn toU32(self: Tag) -> u32 {
    return self.value
  }

  pub fn fromBeBytes(bytes: [u8; 4]) -> Tag {
    return fromArray(&bytes)
  }

  pub fn toBeBytes(self: Tag) -> [u8; 4] {
    let mut bytes: [u8; 4] = [0; 4]
    drop writeScalar<u32>(self.value, &mut bytes)
    return bytes
  }

  pub fn intoBytes(self: Tag) -> [u8; 4] {
    return Tag.toBeBytes(self)
  }

  pub fn newChecked(bytes: &[u8]) -> Result<Tag, InvalidTag> {
    if bytes.length == 0 || bytes.length > 4 {
      return Result<Tag, InvalidTag>.failResult(InvalidTag.InvalidLength { length: bytes.length })
    }
    let mut raw: [u8; 4] = [32; 4]
    let mut seenSpace = false
    let mut i: usize = 0
    while i < bytes.length {
      let byte = bytes[i]
      if byte < 32 || byte > 126 || (byte == 32 && i == 0) || (byte != 32 && seenSpace) {
        return Result<Tag, InvalidTag>.failResult(InvalidTag.InvalidByte { pos: i, byte: byte })
      }
      seenSpace = seenSpace || byte == 32
      raw[i] = byte
      i = i + 1
    }
    return Result<Tag, InvalidTag>.succeed(fromArray(&raw))
  }

  pub fn validate(self: Tag) -> Result<(), InvalidTag> {
    if self.value == 538976288 {
      return Result<(), InvalidTag>.failResult(InvalidTag.InvalidLength { length: 0 })
    }
    let bytes = Tag.toBeBytes(self)
    let mut seenSpace = false
    let mut i: usize = 0
    while i < 4 {
      let byte = bytes[i]
      if byte < 32 || byte > 126 || (byte == 32 && i == 0) {
        return Result<(), InvalidTag>.failResult(InvalidTag.InvalidByte { pos: i, byte: byte })
      }
      if byte != 32 && seenSpace {
        return Result<(), InvalidTag>.failResult(InvalidTag.ByteAfterSpace { pos: i })
      }
      seenSpace = seenSpace || byte == 32
      i = i + 1
    }
    return Result<(), InvalidTag>.succeed(())
  }
}

fn fromArray(bytes: &[u8; 4]) -> Tag {
  return Tag {
    value: u32.shiftLeft(u8.toU32(bytes[0]), 24) | u32.shiftLeft(u8.toU32(bytes[1]), 16)
      | u32.shiftLeft(u8.toU32(bytes[2]), 8)
      | u8.toU32(bytes[3]),
  }
}

impl Scalar for Tag {
  fn rawByteLen() -> usize {
    return 4
  }

  fn read(bytes: &[u8]) -> Option<Tag> {
    if let Option<u32>.Some { value } = readScalar<u32>(bytes) {
      return Option<Tag>.some(Tag { value: value })
    }
    return Option<Tag>.None
  }

  fn write(value: Tag, bytes: &mut [u8]) -> bool {
    return writeScalar<u32>(value.value, move bytes)
  }
}

impl Equal for Tag {
  fn equals(left: &Tag, right: &Tag) -> bool {
    return left.value == right.value
  }
}

impl Order for Tag {
  fn compare(left: &Tag, right: &Tag) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Tag {
  pub fn default() -> Tag {
    return Tag.fromU32(538976288)
  }
}

pub const TTC_HEADER_TAG: Tag = Tag { value: 1953784678 }

import scalar { FixedSize }

impl FixedSize for Tag {
  fn rawByteLen() -> usize {
    return 4
  }
}

import silk.text.format { Display, Debug, Formatter, Format }
import silk.io.writer { Writer, WriterError }

impl Display for Tag {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let bytes = Tag.toBeBytes(self.*)
    let mut i: usize = 0
    while i < 4 {
      if bytes[i] >= 32 && bytes[i] <= 126 {
        let single: [u8; 1] = [bytes[i]]
        run Writer.writeAll(&single)
      } else {
        run Format.format("{{0x{value:02X}}}", &.{ value: bytes[i] })
      }
      i = i + 1
    }
  }
}

impl Debug for Tag {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("Tag(")
    run Display.display(self, &mut formatter)
    run Writer.writeString(")")
  }
}
