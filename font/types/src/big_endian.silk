//! Owned big-endian scalar bytes. Arrays use borrowed views in read_fonts.
import scalar { Scalar, rawByteLen, readScalar, writeScalar }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }

pub struct BigEndian<T: Scalar> {
  bytes: [u8; 8],
}

impl<T: Scalar> Copy for BigEndian<T> {}

impl<T> BigEndian<T> {
  pub fn fromSlice(bytes: &[u8]) -> Option<BigEndian<T>> {
    let size = rawByteLen<T>()
    if bytes.length != size || size > 8 {
      return Option<BigEndian<T>>.None
    }
    let mut raw: [u8; 8] = [0; 8]
    let mut i: usize = 0
    while i < size {
      raw[i] = bytes[i]
      i = i + 1
    }
    return Option<BigEndian<T>>.some(BigEndian<T> { bytes: raw })
  }

  pub fn fromValue(value: T) -> BigEndian<T> {
    let mut raw: [u8; 8] = [0; 8]
    if !writeScalar<T>(move value, &mut raw) {
      return Intrinsic.trap("invalid Scalar width")
    }
    return BigEndian<T> { bytes: raw }
  }

  pub fn get(self: &Self) -> T {
    return match move readScalar<T>(Slice.view<u8>(&self.bytes, 0, rawByteLen<T>())) {
      Option<T>.Some { value } => move value
      Option<T>.None => Intrinsic.trap("invalid BigEndian scalar invariant")
    }
  }

  pub fn set(self: &mut Self, value: T) -> () {
    if !writeScalar<T>(move value, &mut self.bytes) {
      return Intrinsic.trap("invalid Scalar width")
    }
  }

  pub fn beBytes(self: &Self) -> &[u8] {
    return Slice.view<u8>(&self.bytes, 0, rawByteLen<T>())
  }
}

import scalar { FixedSize }

impl<T: Scalar> FixedSize for BigEndian<T> {
  fn rawByteLen() -> usize {
    return rawByteLen<T>()
  }
}

import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.text.format { Display, Debug, Formatter }
import silk.io.writer { Writer, WriterError }

impl<T> BigEndian<T> {
  /// A raw slice replaces Rust's associated fixed-length Raw array type.
  pub fn new(bytes: &[u8]) -> Option<BigEndian<T>> {
    return BigEndian<T>.fromSlice(bytes)
  }
}

impl<T: Scalar> Equal for BigEndian<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    let size = rawByteLen<T>()
    let mut index: usize = 0
    while index < size {
      if left.bytes[index] != right.bytes[index] {
        return false
      }
      index = index + 1
    }
    return true
  }
}

impl<T: Scalar + Order> Order for BigEndian<T> {
  fn compare(left: &Self, right: &Self) -> Ordering {
    let a = BigEndian<T>.get(left)
    let b = BigEndian<T>.get(right)
    if &a < &b {
      return Ordering.Less
    }
    if &a > &b {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl<T: Scalar + Display> Display for BigEndian<T> {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let value = BigEndian<T>.get(self)
    run Display.display(&value, &mut formatter)
  }
}

impl<T: Scalar + Debug> Debug for BigEndian<T> {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let value = BigEndian<T>.get(self)
    run Debug.debug(&value, &mut formatter)
  }
}
