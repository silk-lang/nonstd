// Tests ported from font/parse/upstream/font-types/src/fixed.rs.
import fixed { Fixed, F2Dot14, F4Dot12, F6Dot10, F26Dot6, F48Dot16 }
import silk.testing.testing { Testing, AssertionError }
import silk.core.equal { Equal }
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.f32
import silk.num.f64

fn equal<T: Equal>(left: T, right: T) -> bool {
  return &left == &right
}

test effect fn f2dot14Floats() -> ()
  ! AssertionError<'static> {
  let raw: [i16; 6] = [32767, 28672, 1, 0, -1, -32768]
  let floats: [f32; 6] = [1.999939, 1.75, 0.0000610356, 0.0, -0.000061, -2.0]
  let mut i: usize = 0
  while i < raw.length {
    run Testing.expect(F2Dot14.toBits(F2Dot14.fromF32(floats[i])) == raw[i], "f2dot14 floats")
    i = i + 1
  }
}

test effect fn roundtripF2dot14() -> ()
  ! AssertionError<'static> {
  let mut bits: i32 = -32768
  while bits <= 32767 {
    let value = F2Dot14.fromBits(i32.toI16(bits))
    run Testing.expect(
      equal(value, F2Dot14.fromF32(F2Dot14.toF32(value))),
      "all f2dot14 values roundtrip",
    )
    bits = bits + 1
  }
}

test effect fn roundF2dot14() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    F2Dot14.toBits(F2Dot14.round(F2Dot14.fromBits(28672))) == -32768,
    "round wraps",
  )
  run Testing.expect(F2Dot14.toBits(F2Dot14.round(F2Dot14.fromBits(7936))) == 0, "below half")
  run Testing.expect(F2Dot14.toBits(F2Dot14.round(F2Dot14.fromBits(8192))) == 16384, "half")
}

test effect fn roundFixed() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Fixed.toBits(Fixed.round(Fixed.fromBits(98302))) == 65536, "below half")
  run Testing.expect(
    Fixed.toBits(Fixed.round(Fixed.fromBits(98303))) == 65536,
    "below half last bit",
  )
  run Testing.expect(Fixed.toBits(Fixed.round(Fixed.fromBits(98304))) == 131072, "half")
}

test effect fn fixedFloats() -> ()
  ! AssertionError<'static> {
  let raw: [i32; 6] = [2147418112, 1879048193, 65536, 0, -1, 2147483647]
  let floats: [f64; 6] = [32767.0, 28672.00001525879, 1.0, 0.0, -0.000015259, 32768.0]
  let mut i: usize = 0
  while i < raw.length {
    run Testing.expect(Fixed.toBits(Fixed.fromF64(floats[i])) == raw[i], "fixed floats")
    i = i + 1
  }
}

test effect fn fixedFloatsRounding() -> ()
  ! AssertionError<'static> {
  let inputs: [f64; 5] = [0.05, 0.6, 0.2, 0.4, 0.67755]
  let mut i: usize = 0
  while i < inputs.length {
    run Testing.expect(
      Fixed.toBits(Fixed.fromF64(inputs[i])) == f64.toI32(f64.round(inputs[i] * 65536.0)),
      "positive rounding",
    )
    run Testing.expect(
      Fixed.toBits(Fixed.fromF64(-inputs[i])) == f64.toI32(f64.round(-inputs[i] * 65536.0)),
      "negative rounding",
    )
    i = i + 1
  }
}

test effect fn fixedToInt() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    Fixed.toI32(Fixed.fromF64(1.0)) == 1 && Fixed.toI32(Fixed.fromF64(1.5)) == 2,
    "fixed to integer",
  )
  run Testing.expect(
    F26Dot6.toI32(F26Dot6.fromF64(1.0)) == 1 && F26Dot6.toI32(F26Dot6.fromF64(1.5)) == 2,
    "f26 to integer",
  )
}

test effect fn fixedFromInt() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Fixed.toBits(Fixed.fromI32(1000)) == 65536000, "fixed from integer")
  run Testing.expect(F26Dot6.toBits(F26Dot6.fromI32(1000)) == 64000, "f26 from integer")
}

test effect fn fixedToF26dot6() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    equal(Fixed.toF26dot6(Fixed.fromF64(42.5)), F26Dot6.fromF64(42.5)),
    "fixed to f26",
  )
}

test effect fn fixedMuldiv() -> ()
  ! AssertionError<'static> {
  run Testing.expect(equal(Fixed.fromF64(0.5) * Fixed.fromF64(2.0), Fixed.one()), "fixed multiply")
  run Testing.expect(
    equal(Fixed.fromF64(0.5) / Fixed.fromF64(2.0), Fixed.fromF64(0.25)),
    "fixed divide",
  )
}

test effect fn fixedDivNegOverflow() -> ()
  ! AssertionError<'static> {
  drop (Fixed.fromF64(-92.5) / Fixed.fromF64(0.0028228759765625))
}

test effect fn fixedMulDivNegOverflow() -> ()
  ! AssertionError<'static> {
  let a = Fixed.fromF64(-92.5)
  drop Fixed.mulDiv(&a, Fixed.one(), Fixed.fromF64(0.0028228759765625))
}

test effect fn fixedDivMinValue() -> ()
  ! AssertionError<'static> {
  drop (Fixed.min() / Fixed.one())
  drop (Fixed.min() / Fixed.negOne())
}

test effect fn fixedAbsMinValue() -> ()
  ! AssertionError<'static> {
  run Testing.expect(equal(Fixed.abs(Fixed.min()), Fixed.min()), "wrapping absolute")
}

test effect fn fixedNegMinValue() -> ()
  ! AssertionError<'static> {
  run Testing.expect(equal(-Fixed.min(), Fixed.min()), "wrapping negate")
}

test effect fn f48dot16Floats() -> ()
  ! AssertionError<'static> {
  run Testing.expect(F48Dot16.toBits(F48Dot16.fromF64(1.0)) == 65536, "wide one")
  run Testing.expect(F48Dot16.toBits(F48Dot16.fromF64(0.0)) == 0, "wide zero")
  run Testing.expect(F48Dot16.toBits(F48Dot16.fromF64(1.5)) == 98304, "wide fraction")
  run Testing.expect(F48Dot16.toBits(F48Dot16.fromF64(-1.5)) == -98304, "wide negative")
  run Testing.expect(F48Dot16.toBits(F48Dot16.epsilon()) == 1, "wide epsilon")
  run Testing.expect(
    F48Dot16.toBits(F48Dot16.fromF64(1099511627776.0)) == 72057594037927936,
    "wide outside 16.16",
  )
  run Testing.expect(
    F48Dot16.toF64(F48Dot16.fromF64(1099511627776.5)) == 1099511627776.5,
    "wide roundtrip",
  )
}

test effect fn f48dot16Round() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    F48Dot16.toBits(F48Dot16.round(F48Dot16.fromBits(98303))) == 65536,
    "wide below half",
  )
  run Testing.expect(
    F48Dot16.toBits(F48Dot16.round(F48Dot16.fromBits(98304))) == 131072,
    "wide half",
  )
  run Testing.expect(
    equal(F48Dot16.round(F48Dot16.fromF64(-1.5)), F48Dot16.fromF64(-1.0)),
    "wide negative half",
  )
}

test effect fn f48dot16ToInt() -> ()
  ! AssertionError<'static> {
  run Testing.expect(F48Dot16.toI64(F48Dot16.fromF64(1.0)) == 1, "wide integer")
  run Testing.expect(F48Dot16.toI64(F48Dot16.fromF64(1.5)) == 2, "wide round up")
  run Testing.expect(F48Dot16.toI64(F48Dot16.fromF64(-1.5)) == -1, "wide negative round up")
  run Testing.expect(
    F48Dot16.toI64(F48Dot16.fromF64(1099511627776.25)) == 1099511627776,
    "wide large integer",
  )
}

test effect fn f48dot16FromInt() -> ()
  ! AssertionError<'static> {
  run Testing.expect(F48Dot16.toBits(F48Dot16.fromI64(1000)) == 65536000, "wide from integer")
  run Testing.expect(
    F48Dot16.toBits(F48Dot16.fromI64(1099511627776)) == 72057594037927936,
    "wide large from integer",
  )
}

test effect fn f48dot16FixedConversions() -> ()
  ! AssertionError<'static> {
  let cases: [i32; 6] = [0, 1, -1, 305419896, i32.MAX, i32.MIN]
  let mut i: usize = 0
  while i < cases.length {
    let value = Fixed.fromBits(cases[i])
    let wide = Fixed.toF48dot16(value)
    run Testing.expect(F48Dot16.toBits(wide) == i32.toI64(cases[i]), "wide exact")
    run Testing.expect(equal(F48Dot16.toFixed(wide), value), "narrow exact")
    i = i + 1
  }
  run Testing.expect(
    equal(F48Dot16.toFixed(F48Dot16.fromBits(2147483648)), Fixed.min()),
    "narrow max wraps",
  )
  run Testing.expect(
    equal(F48Dot16.toFixed(F48Dot16.fromBits(-2147483649)), Fixed.max()),
    "narrow min wraps",
  )
}

test effect fn f48dot16MulI32() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    equal(Fixed.mulI32(Fixed.fromF64(0.5), 3), F48Dot16.fromF64(1.5)),
    "wide multiply",
  )
  run Testing.expect(
    equal(Fixed.mulI32(Fixed.one(), -7), F48Dot16.fromI64(-7)),
    "wide negative multiply",
  )
  run Testing.expect(
    equal(Fixed.mulI32(Fixed.zero(), i32.MAX), F48Dot16.zero()),
    "wide zero multiply",
  )
  run Testing.expect(
    F48Dot16.toBits(Fixed.mulI32(Fixed.min(), i32.MIN)) == 4611686018427387904,
    "wide extreme product",
  )
}

test effect fn f48dot16DeltaAccumulation() -> ()
  ! AssertionError<'static> {
  let deltas: [i32; 3] = [100, -250, 37]
  let scalars = [Fixed.one(), Fixed.fromF64(0.5), Fixed.fromF64(0.25)]
  let mut sum = F48Dot16.zero()
  let mut i: usize = 0
  while i < deltas.length {
    sum = sum + Fixed.mulI32(scalars[i], deltas[i])
    i = i + 1
  }
  run Testing.expect(equal(sum, F48Dot16.fromF64(-15.75)), "accumulated deltas")
  run Testing.expect(F48Dot16.toI64(sum) == -16, "round once")
  run Testing.expect(equal(F48Dot16.round(sum), F48Dot16.fromF64(-16.0)), "round sum")
}

test effect fn f48dot16ApplyDelta() -> ()
  ! AssertionError<'static> {
  let raws: [i64; 8] = [0, 1, -1, 100, -32768, 65536, 1099511627776, -1099511627776]
  let mut i: usize = 0
  while i < raws.length {
    let delta = F48Dot16.fromBits(raws[i])
    let raw = F48Dot16.toF64(delta)
    let fixed = Fixed.fromF64(1.5)
    let f2 = F2Dot14.fromF32(0.25)
    run Testing.expect(
      Fixed.applyDelta(fixed, delta) == Fixed.toF32(fixed) + f64.toF32(raw / 65536.0),
      "fixed delta scale",
    )
    run Testing.expect(
      F2Dot14.applyDelta(f2, delta) == F2Dot14.toF32(f2) + f64.toF32(raw / 16384.0),
      "f2 delta scale",
    )
    i = i + 1
  }
  run Testing.expect(
    Fixed.applyDelta(Fixed.zero(), F48Dot16.fromI64(1)) == 1.0 / 65536.0,
    "fixed quantum",
  )
  run Testing.expect(
    F2Dot14.applyDelta(F2Dot14.zero(), F48Dot16.fromI64(1)) == 1.0 / 16384.0,
    "f2 quantum",
  )
  run Testing.expect(
    F2Dot14.applyDelta(F2Dot14.fromF32(0.5), F48Dot16.fromF64(-0.5)) == 0.5 - 0.5 / 16384.0,
    "fractional delta",
  )
}

test effect fn f26dot6Muldiv() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    equal(F26Dot6.fromF64(0.5) * F26Dot6.fromF64(2.0), F26Dot6.one()),
    "f26 multiply",
  )
  run Testing.expect(
    equal(F26Dot6.fromF64(0.5) * F26Dot6.fromF64(-2.4), F26Dot6.fromF64(-1.2)),
    "f26 negative multiply",
  )
  run Testing.expect(equal(F26Dot6.one() * F26Dot6.one(), F26Dot6.one()), "f26 one multiply")
  run Testing.expect(
    equal(F26Dot6.fromF64(0.5) / F26Dot6.fromF64(2.0), F26Dot6.fromF64(0.25)),
    "f26 divide",
  )
  run Testing.expect(
    equal(F26Dot6.fromF64(0.5) / F26Dot6.fromF64(-2.4), F26Dot6.fromF64(-0.20833333333333334)),
    "f26 negative divide",
  )
  run Testing.expect(
    equal(F26Dot6.fromF64(2.0) / F26Dot6.fromF64(3.0), F26Dot6.fromF64(0.6666666666666666)),
    "f26 fractional divide",
  )
  run Testing.expect(equal(F26Dot6.one() / F26Dot6.one(), F26Dot6.one()), "f26 one divide")
  run Testing.expect(F26Dot6.toBits(F26Dot6.one() / F26Dot6.zero()) == i32.MAX, "f26 divide zero")
  run Testing.expect(
    F26Dot6.toBits(-F26Dot6.one() / F26Dot6.zero()) == -2147483647,
    "f26 negative divide zero",
  )
}
