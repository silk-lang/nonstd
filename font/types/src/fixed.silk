import fixed_format { displayShortest }
import silk.text.format { Display, Debug, Formatter, Format }
import silk.io.writer { Writer, WriterError }

impl Display for F2Dot14 {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    if Format.hasPrecision(&formatter) {
      let value = F2Dot14.toF32(self.*)
      return run Display.display(&value, &mut formatter)
    }
    return run displayShortest(i16.toI64(self.bits), 14, &mut formatter)
  }
}

