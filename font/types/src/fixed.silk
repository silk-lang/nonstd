pub struct Fixed {
  bits: i32,
}

impl Copy for Fixed {}

impl Fixed {
  pub fn fromBits(bits: i32) -> Fixed {
    return Fixed { bits: bits }
  }

  pub fn toBits(self: Fixed) -> i32 {
    return self.bits
  }

  pub fn min() -> Fixed {
    return Fixed.fromBits(i32.MIN)
  }

  pub fn max() -> Fixed {
    return Fixed.fromBits(i32.MAX)
  }

  pub fn epsilon() -> Fixed {
    return Fixed.fromBits(1)
  }

  pub fn zero() -> Fixed {
    return Fixed.fromBits(0)
  }

  pub fn one() -> Fixed {
    return Fixed.fromBits(65536)
  }

  pub fn negOne() -> Fixed {
    return Fixed.fromBits(-65536)
  }

  pub fn round(self: Fixed) -> Fixed {
    return Fixed.fromBits(i32.wrappingAdd(self.bits, 32768) & -65536)
  }

  pub fn floor(self: Fixed) -> Fixed {
    return Fixed.fromBits(self.bits & -65536)
  }

  pub fn fract(self: Fixed) -> Fixed {
    return Fixed.fromBits(self.bits - (self.bits & -65536))
  }

  pub fn abs(self: Fixed) -> Fixed {
    if self.bits < 0 {
      return Fixed.fromBits(i32.wrappingNegate(self.bits))
    }
    return self
  }

  pub fn wrappingAdd(self: Fixed, other: Fixed) -> Fixed {
    return Fixed.fromBits(i32.wrappingAdd(self.bits, other.bits))
  }

  pub fn wrappingSub(self: Fixed, other: Fixed) -> Fixed {
    return Fixed.fromBits(i32.wrappingSubtract(self.bits, other.bits))
  }

  pub fn saturatingAdd(self: Fixed, other: Fixed) -> Fixed {
    return Fixed.fromBits(i32.saturatingAdd(self.bits, other.bits))
  }

  pub fn saturatingSub(self: Fixed, other: Fixed) -> Fixed {
    return Fixed.fromBits(i32.saturatingSubtract(self.bits, other.bits))
  }

  pub fn checkedAdd(self: Fixed, other: Fixed) -> Option<Fixed> {
    return match move i32.checkedAdd(self.bits, other.bits) {
      Option<i32>.Some { value } => Option<Fixed>.some(Fixed.fromBits(value))
      Option<i32>.None => Option<Fixed>.None
    }
  }

  pub fn toBeBytes(self: Fixed) -> [u8; 4] {
    let mut bytes: [u8; 4] = [0; 4]
    drop writeScalar<i32>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> Fixed {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 65536.0 + rounding
    if f64.isNaN(scaled) {
      return Fixed.zero()
    }
    if scaled >= i32.toF64(i32.MAX) {
      return Fixed.max()
    }
    if scaled <= i32.toF64(i32.MIN) {
      return Fixed.min()
    }
    return Fixed.fromBits(f64.toI32(scaled))
  }

  pub fn toF64(self: Fixed) -> f64 {
    return i32.toF64(i32.shiftRight(self.bits & -65536, 16))
      + i32.toF64(self.bits & 65535) / 65536.0
  }

  pub fn toF32(self: Fixed) -> f32 {
    return i32.toF32(self.bits) * 1.52587890625e-05
  }

  pub fn fromI32(value: i32) -> Fixed {
    return Fixed.fromBits(i32.shiftLeft(value, 16))
  }

  pub fn toI32(self: Fixed) -> i32 {
    return i32.shiftRight(i32.wrappingAdd(self.bits, 32768), 16)
  }
}

impl Zero for Fixed {
  fn zero() -> Fixed {
    return Fixed.zero()
  }
}

impl One for Fixed {
  fn one() -> Fixed {
    return Fixed.one()
  }
}

impl Equal for Fixed {
  fn equals(left: &Fixed, right: &Fixed) -> bool {
    return left.bits == right.bits
  }
}

impl Order for Fixed {
  fn compare(left: &Fixed, right: &Fixed) -> Ordering {
    if left.bits < right.bits {
      return Ordering.Less
    }
    if left.bits > right.bits {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Add<Fixed, Fixed> for Fixed {
  fn add(left: Fixed, right: Fixed) -> Fixed {
    return Fixed.wrappingAdd(left, right)
  }
}

impl Subtract<Fixed, Fixed> for Fixed {
  fn subtract(left: Fixed, right: Fixed) -> Fixed {
    return Fixed.wrappingSub(left, right)
  }
}

impl Negate<Fixed> for Fixed {
  fn negate(value: Fixed) -> Fixed {
    return Fixed.fromBits(i32.wrappingNegate(value.bits))
  }
}

impl Scalar for Fixed {
  fn rawByteLen() -> usize {
    return 4
  }

  fn read(bytes: &[u8]) -> Option<Fixed> {
    return match move readScalar<i32>(bytes) {
      Option<i32>.Some { value } => Option<Fixed>.some(Fixed.fromBits(value))
      Option<i32>.None => Option<Fixed>.None
    }
  }

  fn write(value: Fixed, bytes: &mut [u8]) -> bool {
    return writeScalar<i32>(value.bits, move bytes)
  }
}

impl Multiply<Fixed, Fixed> for Fixed {
  fn multiply(left: Fixed, right: Fixed) -> Fixed {
    let product = i32.toI64(left.bits) * i32.toI64(right.bits)
    let mut adjustment: i64 = 32768
    if product < 0 {
      adjustment = adjustment - 1
    }
    return Fixed.fromBits(cast.i64ToI32(i64.shiftRight(product + adjustment, 16)))
  }
}

impl Divide<Fixed, Fixed> for Fixed {
  fn divide(left: Fixed, right: Fixed) -> Fixed {
    let a = magnitude(left.bits)
    let b = magnitude(right.bits)
    let mut quotient: u64 = 2147483647
    if b != 0 {
      quotient = (u64.shiftLeft(a, 16) + u64.shiftRight(b, 1)) / b
    }
    let raw = cast.u32ToI32(cast.u64ToU32(quotient))
    if (left.bits < 0) != (right.bits < 0) {
      return Fixed.fromBits(i32.wrappingNegate(raw))
    }
    return Fixed.fromBits(raw)
  }
}

pub struct F26Dot6 {
  bits: i32,
}

impl Copy for F26Dot6 {}

impl F26Dot6 {
  pub fn fromBits(bits: i32) -> F26Dot6 {
    return F26Dot6 { bits: bits }
  }

  pub fn toBits(self: F26Dot6) -> i32 {
    return self.bits
  }

  pub fn min() -> F26Dot6 {
    return F26Dot6.fromBits(i32.MIN)
  }

  pub fn max() -> F26Dot6 {
    return F26Dot6.fromBits(i32.MAX)
  }

  pub fn epsilon() -> F26Dot6 {
    return F26Dot6.fromBits(1)
  }

  pub fn zero() -> F26Dot6 {
    return F26Dot6.fromBits(0)
  }

  pub fn one() -> F26Dot6 {
    return F26Dot6.fromBits(64)
  }

  pub fn negOne() -> F26Dot6 {
    return F26Dot6.fromBits(-64)
  }

  pub fn round(self: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.wrappingAdd(self.bits, 32) & -64)
  }

  pub fn floor(self: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(self.bits & -64)
  }

  pub fn fract(self: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(self.bits - (self.bits & -64))
  }

  pub fn abs(self: F26Dot6) -> F26Dot6 {
    if self.bits < 0 {
      return F26Dot6.fromBits(i32.wrappingNegate(self.bits))
    }
    return self
  }

  pub fn wrappingAdd(self: F26Dot6, other: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.wrappingAdd(self.bits, other.bits))
  }

  pub fn wrappingSub(self: F26Dot6, other: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.wrappingSubtract(self.bits, other.bits))
  }

  pub fn saturatingAdd(self: F26Dot6, other: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.saturatingAdd(self.bits, other.bits))
  }

  pub fn saturatingSub(self: F26Dot6, other: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.saturatingSubtract(self.bits, other.bits))
  }

  pub fn checkedAdd(self: F26Dot6, other: F26Dot6) -> Option<F26Dot6> {
    return match move i32.checkedAdd(self.bits, other.bits) {
      Option<i32>.Some { value } => Option<F26Dot6>.some(F26Dot6.fromBits(value))
      Option<i32>.None => Option<F26Dot6>.None
    }
  }

  pub fn toBeBytes(self: F26Dot6) -> [u8; 4] {
    let mut bytes: [u8; 4] = [0; 4]
    drop writeScalar<i32>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> F26Dot6 {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 64.0 + rounding
    if f64.isNaN(scaled) {
      return F26Dot6.zero()
    }
    if scaled >= i32.toF64(i32.MAX) {
      return F26Dot6.max()
    }
    if scaled <= i32.toF64(i32.MIN) {
      return F26Dot6.min()
    }
    return F26Dot6.fromBits(f64.toI32(scaled))
  }

  pub fn toF64(self: F26Dot6) -> f64 {
    return i32.toF64(i32.shiftRight(self.bits & -64, 6)) + i32.toF64(self.bits & 63) / 64.0
  }

  pub fn toF32(self: F26Dot6) -> f32 {
    return i32.toF32(self.bits) * 0.015625
  }

  pub fn fromI32(value: i32) -> F26Dot6 {
    return F26Dot6.fromBits(i32.shiftLeft(value, 6))
  }

  pub fn toI32(self: F26Dot6) -> i32 {
    return i32.shiftRight(i32.wrappingAdd(self.bits, 32), 6)
  }
}

impl Zero for F26Dot6 {
  fn zero() -> F26Dot6 {
    return F26Dot6.zero()
  }
}

impl One for F26Dot6 {
  fn one() -> F26Dot6 {
    return F26Dot6.one()
  }
}

impl Equal for F26Dot6 {
  fn equals(left: &F26Dot6, right: &F26Dot6) -> bool {
    return left.bits == right.bits
  }
}

impl Order for F26Dot6 {
  fn compare(left: &F26Dot6, right: &F26Dot6) -> Ordering {
    if left.bits < right.bits {
      return Ordering.Less
    }
    if left.bits > right.bits {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Add<F26Dot6, F26Dot6> for F26Dot6 {
  fn add(left: F26Dot6, right: F26Dot6) -> F26Dot6 {
    return F26Dot6.wrappingAdd(left, right)
  }
}

impl Subtract<F26Dot6, F26Dot6> for F26Dot6 {
  fn subtract(left: F26Dot6, right: F26Dot6) -> F26Dot6 {
    return F26Dot6.wrappingSub(left, right)
  }
}

impl Negate<F26Dot6> for F26Dot6 {
  fn negate(value: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.wrappingNegate(value.bits))
  }
}

impl Multiply<F26Dot6, F26Dot6> for F26Dot6 {
  fn multiply(left: F26Dot6, right: F26Dot6) -> F26Dot6 {
    let product = i32.toI64(left.bits) * i32.toI64(right.bits)
    let mut adjustment: i64 = 32
    if product < 0 {
      adjustment = adjustment - 1
    }
    return F26Dot6.fromBits(cast.i64ToI32(i64.shiftRight(product + adjustment, 6)))
  }
}

impl Divide<F26Dot6, F26Dot6> for F26Dot6 {
  fn divide(left: F26Dot6, right: F26Dot6) -> F26Dot6 {
    let a = magnitude(left.bits)
    let b = magnitude(right.bits)
    let mut quotient: u64 = 2147483647
    if b != 0 {
      quotient = (u64.shiftLeft(a, 6) + u64.shiftRight(b, 1)) / b
    }
    let raw = cast.u32ToI32(cast.u64ToU32(quotient))
    if (left.bits < 0) != (right.bits < 0) {
      return F26Dot6.fromBits(i32.wrappingNegate(raw))
    }
    return F26Dot6.fromBits(raw)
  }
}

pub struct F48Dot16 {
  bits: i64,
}

impl Copy for F48Dot16 {}

impl F48Dot16 {
  pub fn fromBits(bits: i64) -> F48Dot16 {
    return F48Dot16 { bits: bits }
  }

  pub fn toBits(self: F48Dot16) -> i64 {
    return self.bits
  }

  pub fn min() -> F48Dot16 {
    return F48Dot16.fromBits(i64.MIN)
  }

  pub fn max() -> F48Dot16 {
    return F48Dot16.fromBits(i64.MAX)
  }

  pub fn epsilon() -> F48Dot16 {
    return F48Dot16.fromBits(1)
  }

  pub fn zero() -> F48Dot16 {
    return F48Dot16.fromBits(0)
  }

  pub fn one() -> F48Dot16 {
    return F48Dot16.fromBits(65536)
  }

  pub fn negOne() -> F48Dot16 {
    return F48Dot16.fromBits(-65536)
  }

  pub fn round(self: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.wrappingAdd(self.bits, 32768) & -65536)
  }

  pub fn floor(self: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(self.bits & -65536)
  }

  pub fn fract(self: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(self.bits - (self.bits & -65536))
  }

  pub fn abs(self: F48Dot16) -> F48Dot16 {
    if self.bits < 0 {
      return F48Dot16.fromBits(i64.wrappingNegate(self.bits))
    }
    return self
  }

  pub fn wrappingAdd(self: F48Dot16, other: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.wrappingAdd(self.bits, other.bits))
  }

  pub fn wrappingSub(self: F48Dot16, other: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.wrappingSubtract(self.bits, other.bits))
  }

  pub fn saturatingAdd(self: F48Dot16, other: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.saturatingAdd(self.bits, other.bits))
  }

  pub fn saturatingSub(self: F48Dot16, other: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.saturatingSubtract(self.bits, other.bits))
  }

  pub fn checkedAdd(self: F48Dot16, other: F48Dot16) -> Option<F48Dot16> {
    return match move i64.checkedAdd(self.bits, other.bits) {
      Option<i64>.Some { value } => Option<F48Dot16>.some(F48Dot16.fromBits(value))
      Option<i64>.None => Option<F48Dot16>.None
    }
  }

  pub fn toBeBytes(self: F48Dot16) -> [u8; 8] {
    let mut bytes: [u8; 8] = [0; 8]
    drop writeScalar<i64>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> F48Dot16 {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 65536.0 + rounding
    if f64.isNaN(scaled) {
      return F48Dot16.zero()
    }
    if scaled >= i64.toF64(i64.MAX) {
      return F48Dot16.max()
    }
    if scaled <= i64.toF64(i64.MIN) {
      return F48Dot16.min()
    }
    return F48Dot16.fromBits(f64.toI64(scaled))
  }

  pub fn toF64(self: F48Dot16) -> f64 {
    return i64.toF64(i64.shiftRight(self.bits & -65536, 16))
      + i64.toF64(self.bits & 65535) / 65536.0
  }

  pub fn toF32(self: F48Dot16) -> f32 {
    return f64.toF32(i64.toF64(self.bits) * 0.0000152587890625)
  }

  pub fn fromI64(value: i64) -> F48Dot16 {
    return F48Dot16.fromBits(i64.shiftLeft(value, 16))
  }

  pub fn fromI32(value: i32) -> F48Dot16 {
    return F48Dot16.fromBits(i64.shiftLeft(i32.toI64(value), 16))
  }

  pub fn toI64(self: F48Dot16) -> i64 {
    return i64.shiftRight(i64.wrappingAdd(self.bits, 32768), 16)
  }

  pub fn toI32(self: F48Dot16) -> i32 {
    return cast.i64ToI32(F48Dot16.toI64(self))
  }

  pub fn toFixed(self: F48Dot16) -> Fixed {
    return Fixed.fromBits(cast.i64ToI32(self.bits))
  }
}

impl Zero for F48Dot16 {
  fn zero() -> F48Dot16 {
    return F48Dot16.zero()
  }
}

impl One for F48Dot16 {
  fn one() -> F48Dot16 {
    return F48Dot16.one()
  }
}

impl Equal for F48Dot16 {
  fn equals(left: &F48Dot16, right: &F48Dot16) -> bool {
    return left.bits == right.bits
  }
}

impl Order for F48Dot16 {
  fn compare(left: &F48Dot16, right: &F48Dot16) -> Ordering {
    if left.bits < right.bits {
      return Ordering.Less
    }
    if left.bits > right.bits {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Add<F48Dot16, F48Dot16> for F48Dot16 {
  fn add(left: F48Dot16, right: F48Dot16) -> F48Dot16 {
    return F48Dot16.wrappingAdd(left, right)
  }
}

impl Subtract<F48Dot16, F48Dot16> for F48Dot16 {
  fn subtract(left: F48Dot16, right: F48Dot16) -> F48Dot16 {
    return F48Dot16.wrappingSub(left, right)
  }
}

impl Negate<F48Dot16> for F48Dot16 {
  fn negate(value: F48Dot16) -> F48Dot16 {
    return F48Dot16.fromBits(i64.wrappingNegate(value.bits))
  }
}

fn magnitude(value: i32) -> u64 {
  if value < 0 {
    return i64.toU64(-i32.toI64(value))
  }
  return i32.toU64(value)
}

impl Fixed {
  pub fn toF26dot6(self: Fixed) -> F26Dot6 {
    return F26Dot6.fromBits(i32.shiftRight(i32.wrappingAdd(self.bits, 512), 10))
  }

  pub fn toF2dot14(self: Fixed) -> F2Dot14 {
    return F2Dot14.fromBits(cast.i32ToI16(i32.shiftRight(i32.wrappingAdd(self.bits, 2), 2)))
  }

  pub fn toF48dot16(self: Fixed) -> F48Dot16 {
    return F48Dot16.fromBits(i32.toI64(self.bits))
  }

  pub fn mulI32(self: Fixed, value: i32) -> F48Dot16 {
    return F48Dot16.fromBits(i32.toI64(self.bits) * i32.toI64(value))
  }

  pub fn applyDelta(self: Fixed, delta: F48Dot16) -> f32 {
    return Fixed.toF32(self) + f64.toF32(F48Dot16.toF64(delta) / 65536.0)
  }

  pub fn mulDiv(self: &Fixed, a: Fixed, b: Fixed) -> Fixed {
    let numerator = magnitude(self.bits) * magnitude(a.bits)
    let denominator = magnitude(b.bits)
    let mut quotient: u64 = 2147483647
    if denominator != 0 {
      quotient = (numerator + u64.shiftRight(denominator, 1)) / denominator
    }
    let raw = cast.u32ToI32(cast.u64ToU32(quotient))
    if ((self.bits < 0) != (a.bits < 0)) != (b.bits < 0) {
      return Fixed.fromBits(i32.wrappingNegate(raw))
    }
    return Fixed.fromBits(raw)
  }
}

impl F2Dot14 {
  pub fn toFixed(self: F2Dot14) -> Fixed {
    return Fixed.fromBits(i16.toI32(self.bits) * 4)
  }

  pub fn applyDelta(self: F2Dot14, delta: F48Dot16) -> f32 {
    return F2Dot14.toF32(self) + f64.toF32(F48Dot16.toF64(delta) / 16384.0)
  }
}

