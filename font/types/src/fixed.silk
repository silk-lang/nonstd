  pub fn checkedAdd(self: F4Dot12, other: F4Dot12) -> Option<F4Dot12> {
    return match move i16.checkedAdd(self.bits, other.bits) {
      Option<i16>.Some { value } => Option<F4Dot12>.some(F4Dot12.fromBits(value))
      Option<i16>.None => Option<F4Dot12>.None
