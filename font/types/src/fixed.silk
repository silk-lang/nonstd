    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<i16>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> F6Dot10 {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 1024.0 + rounding
    if f64.isNaN(scaled) {
      return F6Dot10.zero()
    }
    if scaled >= i16.toF64(i16.MAX) {
      return F6Dot10.max()
