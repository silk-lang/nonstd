import silk.num.f32
import silk.num.f64

pub struct F2Dot14 {
  bits: i16,
}

impl Copy for F2Dot14 {}

impl F2Dot14 {
  pub fn fromBits(bits: i16) -> F2Dot14 {
    return F2Dot14 { bits: bits }
  }

  pub fn toBits(self: F2Dot14) -> i16 {
    return self.bits
  }

  pub fn min() -> F2Dot14 {
    return F2Dot14.fromBits(i16.MIN)
  }

  pub fn max() -> F2Dot14 {
    return F2Dot14.fromBits(i16.MAX)
  }

  pub fn epsilon() -> F2Dot14 {
    return F2Dot14.fromBits(1)
  }

  pub fn zero() -> F2Dot14 {
    return F2Dot14.fromBits(0)
  }

  pub fn one() -> F2Dot14 {
    return F2Dot14.fromBits(16384)
  }

  pub fn negOne() -> F2Dot14 {
    return F2Dot14.fromBits(-16384)
  }

  pub fn round(self: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.wrappingAdd(self.bits, 8192) & -16384)
  }

  pub fn floor(self: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(self.bits & -16384)
  }

  pub fn fract(self: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(self.bits - (self.bits & -16384))
  }

  pub fn abs(self: F2Dot14) -> F2Dot14 {
    if self.bits < 0 {
      return F2Dot14.fromBits(i16.wrappingNegate(self.bits))
    }
    return self
  }

  pub fn wrappingAdd(self: F2Dot14, other: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.wrappingAdd(self.bits, other.bits))
  }

  pub fn wrappingSub(self: F2Dot14, other: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.wrappingSubtract(self.bits, other.bits))
  }

  pub fn saturatingAdd(self: F2Dot14, other: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.saturatingAdd(self.bits, other.bits))
  }

  pub fn saturatingSub(self: F2Dot14, other: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.saturatingSubtract(self.bits, other.bits))
  }

  pub fn checkedAdd(self: F2Dot14, other: F2Dot14) -> Option<F2Dot14> {
    return match move i16.checkedAdd(self.bits, other.bits) {
      Option<i16>.Some { value } => Option<F2Dot14>.some(F2Dot14.fromBits(value))
      Option<i16>.None => Option<F2Dot14>.None
    }
  }

  pub fn toBeBytes(self: F2Dot14) -> [u8; 2] {
    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<i16>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> F2Dot14 {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 16384.0 + rounding
    if f64.isNaN(scaled) {
      return F2Dot14.zero()
    }
    if scaled >= i16.toF64(i16.MAX) {
      return F2Dot14.max()
    }
    if scaled <= i16.toF64(i16.MIN) {
      return F2Dot14.min()
    }
    return F2Dot14.fromBits(f64.toI16(scaled))
  }

  pub fn toF64(self: F2Dot14) -> f64 {
    return i16.toF64(i16.shiftRight(self.bits & -16384, 14))
      + i16.toF64(self.bits & 16383) / 16384.0
  }

  pub fn fromF32(value: f32) -> F2Dot14 {
    let mut rounding: f32 = 0.5
    if f32.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 16384.0 + rounding
    if f32.isNaN(scaled) {
      return F2Dot14.zero()
    }
    if scaled >= 32767.0 {
      return F2Dot14.max()
    }
    if scaled <= -32768.0 {
      return F2Dot14.min()
    }
    return F2Dot14.fromBits(f32.toI16(scaled))
  }

  pub fn toF32(self: F2Dot14) -> f32 {
    return i16.toF32(i16.shiftRight(self.bits & -16384, 14))
      + i16.toF32(self.bits & 16383) / 16384.0
  }
}

impl Zero for F2Dot14 {
  fn zero() -> F2Dot14 {
    return F2Dot14.zero()
  }
}

impl One for F2Dot14 {
  fn one() -> F2Dot14 {
    return F2Dot14.one()
  }
}

impl Equal for F2Dot14 {
  fn equals(left: &F2Dot14, right: &F2Dot14) -> bool {
    return left.bits == right.bits
  }
}

impl Order for F2Dot14 {
  fn compare(left: &F2Dot14, right: &F2Dot14) -> Ordering {
    if left.bits < right.bits {
      return Ordering.Less
    }
    if left.bits > right.bits {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Add<F2Dot14, F2Dot14> for F2Dot14 {
  fn add(left: F2Dot14, right: F2Dot14) -> F2Dot14 {
    return F2Dot14.wrappingAdd(left, right)
  }
}

impl Subtract<F2Dot14, F2Dot14> for F2Dot14 {
  fn subtract(left: F2Dot14, right: F2Dot14) -> F2Dot14 {
    return F2Dot14.wrappingSub(left, right)
  }
}

impl Negate<F2Dot14> for F2Dot14 {
  fn negate(value: F2Dot14) -> F2Dot14 {
    return F2Dot14.fromBits(i16.wrappingNegate(value.bits))
  }
}

impl Scalar for F2Dot14 {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<F2Dot14> {
    return match move readScalar<i16>(bytes) {
      Option<i16>.Some { value } => Option<F2Dot14>.some(F2Dot14.fromBits(value))
      Option<i16>.None => Option<F2Dot14>.None
    }
  }

  fn write(value: F2Dot14, bytes: &mut [u8]) -> bool {
    return writeScalar<i16>(value.bits, move bytes)
  }
}

pub struct F4Dot12 {
  bits: i16,
}

impl Copy for F4Dot12 {}

impl F4Dot12 {
  pub fn fromBits(bits: i16) -> F4Dot12 {
    return F4Dot12 { bits: bits }
  }

  pub fn toBits(self: F4Dot12) -> i16 {
    return self.bits
  }

  pub fn min() -> F4Dot12 {
    return F4Dot12.fromBits(i16.MIN)
