  pub fn epsilon() -> F4Dot12 {
    return F4Dot12.fromBits(1)
  }

  pub fn zero() -> F4Dot12 {
    return F4Dot12.fromBits(0)
  }

  pub fn one() -> F4Dot12 {
    return F4Dot12.fromBits(4096)
  }

  pub fn negOne() -> F4Dot12 {
    return F4Dot12.fromBits(-4096)
  }

  pub fn round(self: F4Dot12) -> F4Dot12 {
    return F4Dot12.fromBits(i16.wrappingAdd(self.bits, 2048) & -4096)
  }

  pub fn floor(self: F4Dot12) -> F4Dot12 {
    return F4Dot12.fromBits(self.bits & -4096)
  }

  pub fn fract(self: F4Dot12) -> F4Dot12 {
    return F4Dot12.fromBits(self.bits - (self.bits & -4096))
  }

  pub fn abs(self: F4Dot12) -> F4Dot12 {
    if self.bits < 0 {
      return F4Dot12.fromBits(i16.wrappingNegate(self.bits))
    }
