    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<i16>(self.bits, &mut bytes)
    return bytes
  }

  pub fn fromF64(value: f64) -> F4Dot12 {
    let mut rounding: f64 = 0.5
    if f64.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 4096.0 + rounding
    if f64.isNaN(scaled) {
      return F4Dot12.zero()
    }
    if scaled >= i16.toF64(i16.MAX) {
      return F4Dot12.max()
    }
    if scaled <= i16.toF64(i16.MIN) {
      return F4Dot12.min()
    }
    return F4Dot12.fromBits(f64.toI16(scaled))
  }

  pub fn toF64(self: F4Dot12) -> f64 {
    return i16.toF64(i16.shiftRight(self.bits & -4096, 12)) + i16.toF64(self.bits & 4095) / 4096.0
  }

  pub fn fromF32(value: f32) -> F4Dot12 {
    let mut rounding: f32 = 0.5
    if f32.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 4096.0 + rounding
    if f32.isNaN(scaled) {
      return F4Dot12.zero()
    }
    if scaled >= 32767.0 {
      return F4Dot12.max()
    }
    if scaled <= -32768.0 {
      return F4Dot12.min()
    }
    return F4Dot12.fromBits(f32.toI16(scaled))
  }

  pub fn toF32(self: F4Dot12) -> f32 {
    return i16.toF32(i16.shiftRight(self.bits & -4096, 12)) + i16.toF32(self.bits & 4095) / 4096.0
  }
}

