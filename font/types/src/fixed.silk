  }

  pub fn toF64(self: F6Dot10) -> f64 {
    return i16.toF64(i16.shiftRight(self.bits & -1024, 10)) + i16.toF64(self.bits & 1023) / 1024.0
  }

  pub fn fromF32(value: f32) -> F6Dot10 {
    let mut rounding: f32 = 0.5
    if f32.isSignNegative(value) {
      rounding = -0.5
    }
    let scaled = value * 1024.0 + rounding
    if f32.isNaN(scaled) {
