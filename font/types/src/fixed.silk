  pub fn one() -> F6Dot10 {
    return F6Dot10.fromBits(1024)
  }

  pub fn negOne() -> F6Dot10 {
    return F6Dot10.fromBits(-1024)
  }

  pub fn round(self: F6Dot10) -> F6Dot10 {
    return F6Dot10.fromBits(i16.wrappingAdd(self.bits, 512) & -1024)
  }

  pub fn floor(self: F6Dot10) -> F6Dot10 {
    return F6Dot10.fromBits(self.bits & -1024)
  }

  pub fn fract(self: F6Dot10) -> F6Dot10 {
