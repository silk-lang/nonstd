// Upstream tests for integer types, versions, tags and geometry.
import integer_types { Uint24, Int24, GlyphId16, GlyphId24, GlyphId, Offset16 }
import nullable { Nullable }
import scalar { readScalar, writeScalar }
import version { MajorMinor, Version16Dot16 }
import tag { Tag, InvalidTag }
import geometry { Point, BoundingBox, Matrix }
import fixed { Fixed, F26Dot6, F48Dot16 }
import fword { FWord, UfWord }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.equal { Equal }
import silk.testing.testing { Testing, AssertionError }
import silk.num.i32
import silk.num.u32
import silk.num.u16

fn equal<T: Equal>(left: T, right: T) -> bool {
  return &left == &right
}

fn ok<T, E>(input: Result<T, E>) -> bool {
  return match move input {
    Result<T, E>.Success { value } => true
    _ => false
  }
}

test effect fn uint24Constructor() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Uint24.toU32(Uint24.new(u32.MAX)) == 16777215, "uint24 saturates")
  let absent = match move Uint24.checkedNew(u32.MAX) {
    Option<Uint24>.None => true
    _ => false
  }
  run Testing.expect(absent, "checked uint24 detects overflow")
}

test effect fn uint24BeBytes() -> ()
  ! AssertionError<'static> {
  let value = Uint24.fromBeBytes([255, 170, 204])
  let bytes = Uint24.toBeBytes(value)
  run Testing.expect(bytes[0] == 255 && bytes[1] == 170 && bytes[2] == 204, "uint24 byte roundtrip")
}

test effect fn int24Constructor() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Int24.toI32(Int24.new(i32.MAX)) == 8388607, "int24 saturates max")
  run Testing.expect(Int24.toI32(Int24.new(i32.MIN)) == -8388608, "int24 saturates min")
  run Testing.expect(
    Int24.toI32(Int24.new(-10)) == -10 && Int24.toI32(Int24.new(10)) == 10,
    "int24 small values",
  )
}

test effect fn int24ToBeBytes() -> ()
  ! AssertionError<'static> {
  let values: [i32; 5] = [0, 123456, -123456, 8388607, -8388608]
  let expected: [[u8; 3]; 5] = [
    [0, 0, 0],
    [1, 226, 64],
    [254, 29, 192],
    [127, 255, 255],
    [128, 0, 0],
  ]
  let mut i: usize = 0
  while i < 5 {
    let bytes = Int24.toBeBytes(Int24.new(values[i]))
    let mut j: usize = 0
    while j < 3 {
      run Testing.expect(bytes[j] == expected[i][j], "signed 24-bit encoding")
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn int24FromBeBytes() -> ()
  ! AssertionError<'static> {
  let values: [i32; 5] = [0, 123456, -123456, 8388607, -8388608]
  let bytes: [[u8; 3]; 5] = [[0, 0, 0], [1, 226, 64], [254, 29, 192], [127, 255, 255], [128, 0, 0]]
  let mut i: usize = 0
  while i < 5 {
    run Testing.expect(
      Int24.toI32(Int24.fromBeBytes(bytes[i])) == values[i],
      "signed 24-bit decoding",
    )
    i = i + 1
  }
}

test effect fn int24RoundTrip() -> ()
  ! AssertionError<'static> {
  let mut raw: i32 = -8388608
  while raw <= 8388607 {
    let value = Int24.new(raw)
    run Testing.expect(
      equal(Int24.fromBeBytes(Int24.toBeBytes(value)), value),
      "all int24 roundtrip",
    )
    raw = raw + 1
  }
}

test effect fn versionSmokeTest() -> ()
  ! AssertionError<'static> {
  let first = Version16Dot16.new(0, 5)
  let second = Version16Dot16.new(1, 1)
  let a = Version16Dot16.toMajorMinor(&first)
  let b = Version16Dot16.toMajorMinor(&second)
  run Testing.expect(
    a.major == 0 && a.minor == 5 && b.major == 1 && b.minor == 1,
    "legacy version components",
  )
  let bytes = Version16Dot16.toBeBytes(&second)
  run Testing.expect(
    bytes[0] == 0 && bytes[1] == 1 && bytes[2] == 16 && bytes[3] == 0,
    "legacy version nibble encoding",
  )
}

test effect fn minorVersionClampedTest() -> ()
  ! AssertionError<'static> {
  let mut minor: u16 = 0
  while minor <= 9 {
    let value = Version16Dot16.new(1, minor)
    let parts = Version16Dot16.toMajorMinor(&value)
    run Testing.expect(parts.major == 1 && parts.minor == minor, "minor preserved")
    minor = minor + 1
  }
  let a = Version16Dot16.new(1, 10)
  let b = Version16Dot16.new(1, 65535)
  run Testing.expect(
    Version16Dot16.toMajorMinor(&a).minor == 9 && Version16Dot16.toMajorMinor(&b).minor == 9,
    "minor clamps to nine",
  )
}

test effect fn tagSmokeTest() -> ()
  ! AssertionError<'static> {
  drop Tag.new(&[104, 101, 97, 100])
  let valid: [&[u8]; 6] = [b"a", b"ab", b"abc", b"abcd", b"!", b"~"]
  let invalid: [&[u8]; 7] = [b"", b" ", b"abcde", b" bc", b"b c", b"\x19", b"\x7f"]
  let mut i: usize = 0
  while i < valid.length {
    run Testing.expect(ok(Tag.newChecked(valid[i])), "checked tag accepts valid input")
    i = i + 1
  }
  i = 0
  while i < invalid.length {
    run Testing.expect(!ok(Tag.newChecked(invalid[i])), "checked tag rejects invalid input")
    i = i + 1
  }
  let padded = Tag.newChecked(b"bc") |> Result<Tag, InvalidTag>.unwrapOr(Tag.default())
  run Testing.expect(equal(padded, Tag.fromBeBytes([98, 99, 32, 32])), "short tag space padding")
}

test effect fn tagValidateTest() -> ()
  ! AssertionError<'static> {
  let valid: [[u8; 4]; 6] = [
    [97, 32, 32, 32],
    [97, 98, 32, 32],
    [97, 98, 99, 32],
    [97, 98, 99, 100],
    [33, 51, 51, 51],
    [126, 51, 51, 51],
  ]
  let invalid: [[u8; 4]; 5] = [
    [32, 32, 32, 32],
    [32, 98, 99, 99],
    [98, 32, 99, 99],
    [25, 51, 51, 51],
    [127, 51, 51, 51],
  ]
  let mut i: usize = 0
  while i < valid.length {
    run Testing.expect(ok(Tag.validate(Tag.fromBeBytes(valid[i]))), "tag validates")
    i = i + 1
  }
  i = 0
  while i < invalid.length {
    run Testing.expect(!ok(Tag.validate(Tag.fromBeBytes(invalid[i]))), "tag fails validation")
    i = i + 1
  }
  let empty = match move Tag.validate(Tag.default()) {
    Result<(), InvalidTag>.Failure { error } => match error {
      InvalidTag.InvalidLength { length } => length == 0
      _ => false
    }
    _ => false
  }
  let zero = match move Tag.validate(Tag.fromU32(0)) {
    Result<(), InvalidTag>.Failure { error } => match error {
      InvalidTag.InvalidByte { pos, byte } => pos == 0 && byte == 0
      _ => false
    }
    _ => false
  }
  run Testing.expect(empty && zero, "empty and invalid-byte errors are distinct")
}

test effect fn pointMap() -> ()
  ! AssertionError<'static> {
  let p = Point<f64>.new(42.5, 20.1)
  let result = Point<f64>.map<F26Dot6>(p, F26Dot6.fromF64)
  run Testing.expect(
    equal(result, Point<F26Dot6>.new(F26Dot6.fromF64(42.5), F26Dot6.fromF64(20.1))),
    "point map",
  )
}

test effect fn pointAdd() -> ()
  ! AssertionError<'static> {
  let mut point = Point<i32>.new(1, 2)
  point = point + Point<i32>.new(3, 4)
  run Testing.expect(equal(point, Point<i32>.new(4, 6)), "point addition")
}

test effect fn pointSub() -> ()
  ! AssertionError<'static> {
  let mut point = Point<i32>.new(1, 2)
  point = point - Point<i32>.new(3, 4)
  run Testing.expect(equal(point, Point<i32>.new(-2, -2)), "point subtraction")
}

test effect fn pointMul() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    equal(Point<i32>.new(1, 2) * Point<i32>.new(3, 4), Point<i32>.new(3, 8)),
    "point product",
  )
  run Testing.expect(equal(Point<i32>.new(1, 2) * 8, Point<i32>.new(8, 16)), "point scalar product")
}

test effect fn pointDiv() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    equal(Point<i32>.new(10, 16) / Point<i32>.new(2, 3), Point<i32>.new(5, 5)),
    "point division",
  )
  run Testing.expect(
    equal(Point<i32>.new(10, 16) / 2, Point<i32>.new(5, 8)),
    "point scalar division",
  )
}

test effect fn pointNeg() -> ()
  ! AssertionError<'static> {
  run Testing.expect(equal(-Point<i32>.new(1, -2), Point<i32>.new(-1, 2)), "point negation")
}

test effect fn normalize() -> ()
  ! AssertionError<'static> {
  let box = BoundingBox<i32> { xMin: 10, yMin: 20, xMax: 5, yMax: 15 }
  run Testing.expect(!BoundingBox.isNormalized(&box), "box initially reversed")
  let fixed = BoundingBox.normalize(&box)
  run Testing.expect(BoundingBox.isNormalized(&fixed), "box normalized")
  run Testing.expect(
    fixed.xMin == 5 && fixed.yMin == 15 && fixed.xMax == 10 && fixed.yMax == 20,
    "box normalized values",
  )
}

test effect fn normalizeNegativeScaled() -> ()
  ! AssertionError<'static> {
  let box = BoundingBox<i32> { xMin: 5, yMin: 5, xMax: 10, yMax: 10 }
  run Testing.expect(equal(BoundingBox.normalize(&box), box), "normalized box unchanged")
  let scaled = BoundingBox.scale(&box, -2)
  run Testing.expect(!BoundingBox.isNormalized(&scaled), "negative scaling reverses box")
  let fixed = BoundingBox.normalize(&scaled)
  run Testing.expect(
    fixed.xMin == -20 && fixed.yMin == -20 && fixed.xMax == -10 && fixed.yMax == -10,
    "scaled normalized box",
  )
}

test effect fn mulMatrixIdentityAndKnownProduct() -> ()
  ! AssertionError<'static> {
  let a = Matrix.fromElements<f32>([0.5, 1.0, -2.0, 0.25, 7.0, -3.0])
  let identity = Matrix.identity<f32>()
  run Testing.expect(equal(identity * a, a) && equal(a * identity, a), "matrix identity")
  let translate = Matrix.fromElements<f32>([1.0, 0.0, 0.0, 1.0, 10.0, 20.0])
  let scale = Matrix.fromElements<f32>([2.0, 0.0, 0.0, 3.0, 0.0, 0.0])
  run Testing.expect(
    equal(translate * scale, Matrix.fromElements<f32>([2.0, 0.0, 0.0, 3.0, 10.0, 20.0])),
    "translate after scale",
  )
  run Testing.expect(
    equal(scale * translate, Matrix.fromElements<f32>([2.0, 0.0, 0.0, 3.0, 20.0, 60.0])),
    "scale after translate",
  )
}

test effect fn transformPoints() -> ()
  ! AssertionError<'static> {
  let translate = Matrix.fromElements<f32>([1.0, 0.0, 0.0, 1.0, 10.0, 20.0])
  let scale = Matrix.fromElements<f32>([2.0, 0.0, 0.0, 3.0, 0.0, 0.0])
  let p = Point<f32>.new(5.0, -22.0)
  run Testing.expect(equal(translate * p, Point<f32>.new(15.0, -2.0)), "translate point")
  run Testing.expect(equal(scale * p, Point<f32>.new(10.0, -66.0)), "scale point")
  run Testing.expect(
    equal((translate * scale) * p, Point<f32>.new(20.0, -46.0)),
    "translate scale point",
  )
  run Testing.expect(
    equal((scale * translate) * p, Point<f32>.new(30.0, -6.0)),
    "scale translate point",
  )
}

test effect fn fwordApplyDelta() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    FWord.applyDelta(FWord.new(100), F48Dot16.fromF64(2.5)) == 102.5,
    "fword positive delta",
  )
  run Testing.expect(
    FWord.applyDelta(FWord.new(-100), F48Dot16.fromF64(-0.25)) == -100.25,
    "fword negative delta",
  )
  run Testing.expect(
    UfWord.applyDelta(UfWord.new(1000), F48Dot16.fromF64(-1.5)) == 998.5,
    "ufword negative delta",
  )
  run Testing.expect(UfWord.applyDelta(UfWord.new(0), F48Dot16.zero()) == 0.0, "ufword zero delta")
}

test effect fn nullableScalarAndGlyphLimits() -> ()
  ! AssertionError<'static> {
  let decoded = readScalar<Nullable<Offset16>>(b"\x01\x00")
    |> Option<Nullable<Offset16>>.unwrapOr(Nullable<Offset16>.default())
  run Testing.expect(!Nullable<Offset16>.isNull(&decoded), "nullable scalar nonzero")
  let mut bytes: [u8; 2] = [0; 2]
  run Testing.expect(writeScalar<Nullable<Offset16>>(decoded, &mut bytes), "nullable scalar write")
  run Testing.expect(bytes[0] == 1 && bytes[1] == 0, "nullable scalar bytes")
  run Testing.expect(!ok(GlyphId16.tryFrom(GlyphId.new(65536))), "glyph16 checked overflow")
  run Testing.expect(!ok(GlyphId24.tryFrom(GlyphId.new(16777216))), "glyph24 checked overflow")
}
