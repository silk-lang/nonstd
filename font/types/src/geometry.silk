//! Generic points, bounding boxes, and affine matrices.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.order { Order }
import silk.core.ops { Add, Subtract, Multiply, Divide, Negate }
import fixed { Fixed }

pub tuple Coordinates<T>(T, T)

pub struct Point<T> {
  pub x: T,
  pub y: T,
}

impl<T: Copy> Copy for Point<T> {}

impl<T> Point<T> {
  pub fn new(x: T, y: T) -> Point<T> {
    return Point<T> { x: move x, y: move y }
  }

  pub fn broadcast<U: Copy>(value: U) -> Point<U> {
    return Point<U> { x: value, y: value }
  }

  pub fn map<U>(self: Point<T>, transform: mut fn(T) -> U) -> Point<U> {
    let mut function = move transform
    return Point<U> { x: function(move self.x), y: function(move self.y) }
  }
}

impl<T: Equal> Equal for Point<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.x == &right.x && &left.y == &right.y
  }
}

pub struct BoundingBox<T> {
  pub xMin: T,
  pub yMin: T,
  pub xMax: T,
  pub yMax: T,
}

impl<T: Copy> Copy for BoundingBox<T> {}

impl<T: Equal> Equal for BoundingBox<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.xMin == &right.xMin && &left.yMin == &right.yMin && &left.xMax == &right.xMax
      && &left.yMax == &right.yMax
  }
}

impl<T> BoundingBox<T> {
  // The method's parameter carries its operation bounds; inherent impl heads cannot.
  pub fn scale<U: Copy + Multiply<U, U>>(self: &BoundingBox<U>, factor: U) -> BoundingBox<U> {
    return BoundingBox<U> {
      xMin: self.xMin * factor,
      yMin: self.yMin * factor,
      xMax: self.xMax * factor,
      yMax: self.yMax * factor,
    }
  }

  pub fn isNormalized<U: Order>(self: &BoundingBox<U>) -> bool {
    return &self.xMin <= &self.xMax && &self.yMin <= &self.yMax
  }

  pub fn normalize<U: Copy + Order>(self: &BoundingBox<U>) -> BoundingBox<U> {
    let mut result = self.*
    if &self.xMin > &self.xMax {
      result.xMin = self.xMax
      result.xMax = self.xMin
    }
    if &self.yMin > &self.yMax {
      result.yMin = self.yMax
      result.yMax = self.yMin
    }
    return result
  }
}

pub interface MatrixElement {
  fn zero() -> Self

  fn one() -> Self
}

impl MatrixElement for f32 {
  fn zero() -> f32 {
    return 0.0
  }

  fn one() -> f32 {
    return 1.0
  }
}

impl MatrixElement for f64 {
  fn zero() -> f64 {
    return 0.0
  }

  fn one() -> f64 {
    return 1.0
  }
}

impl MatrixElement for Fixed {
  fn zero() -> Fixed {
    return Fixed.zero()
  }

  fn one() -> Fixed {
    return Fixed.one()
  }
}

fn zero<T: MatrixElement>() -> T {
  return MatrixElement.zero()
}

fn one<T: MatrixElement>() -> T {
  return MatrixElement.one()
}

pub struct Matrix<T> {
  pub xx: T,
  pub yx: T,
  pub xy: T,
  pub yy: T,
  pub dx: T,
  pub dy: T,
}

impl<T: Copy> Copy for Matrix<T> {}

impl<T: Equal> Equal for Matrix<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.xx == &right.xx && &left.yx == &right.yx && &left.xy == &right.xy
      && &left.yy == &right.yy
      && &left.dx == &right.dx
      && &left.dy == &right.dy
  }
}

impl<T> Matrix<T> {
  pub fn fromElements<U: Copy>(elements: [U; 6]) -> Matrix<U> {
    return Matrix<U> {
      xx: elements[0],
      yx: elements[1],
      xy: elements[2],
      yy: elements[3],
      dx: elements[4],
      dy: elements[5],
    }
  }

  pub fn elements<U: Copy>(self: &Matrix<U>) -> [U; 6] {
    return [self.xx, self.yx, self.xy, self.yy, self.dx, self.dy]
  }

  pub fn map<U>(self: Matrix<T>, transform: mut fn(T) -> U) -> Matrix<U> {
    let mut function = move transform
    return Matrix<U> {
      xx: function(move self.xx),
      yx: function(move self.yx),
      xy: function(move self.xy),
      yy: function(move self.yy),
      dx: function(move self.dx),
      dy: function(move self.dy),
    }
  }

  pub fn identity<U: MatrixElement>() -> Matrix<U> {
    return Matrix<U> {
      xx: one<U>(),
      yx: zero<U>(),
      xy: zero<U>(),
      yy: one<U>(),
      dx: zero<U>(),
      dy: zero<U>(),
    }
  }

  pub fn transform<U: Copy + Add<U, U> + Multiply<U, U>>(
    self: &Matrix<U>,
    x: U,
    y: U,
  ) -> Coordinates<U> {
    return (self.xx * x + self.xy * y + self.dx, self.yx * x + self.yy * y + self.dy)
  }
}

impl<T> Point<T> {
  pub fn add<U: Add<U, U>>(left: Point<U>, right: Point<U>) -> Point<U> {
    return Point<U> { x: move left.x + move right.x, y: move left.y + move right.y }
  }

  pub fn subtract<U: Subtract<U, U>>(left: Point<U>, right: Point<U>) -> Point<U> {
    return Point<U> { x: move left.x - move right.x, y: move left.y - move right.y }
  }

  pub fn multiply<U: Multiply<U, U>>(left: Point<U>, right: Point<U>) -> Point<U> {
    return Point<U> { x: move left.x * move right.x, y: move left.y * move right.y }
  }

  pub fn divide<U: Divide<U, U>>(left: Point<U>, right: Point<U>) -> Point<U> {
    return Point<U> { x: move left.x / move right.x, y: move left.y / move right.y }
  }

  pub fn negate<U: Negate<U>>(value: Point<U>) -> Point<U> {
    return Point<U> { x: -move value.x, y: -move value.y }
  }

  pub fn scale<U: Copy + Multiply<U, U>>(value: Point<U>, factor: U) -> Point<U> {
    return Point<U> { x: value.x * factor, y: value.y * factor }
  }

  pub fn divideScalar<U: Copy + Divide<U, U>>(value: Point<U>, factor: U) -> Point<U> {
    return Point<U> { x: value.x / factor, y: value.y / factor }
  }
}

impl<T> Matrix<T> {
  pub fn multiply<U: Copy + Add<U, U> + Multiply<U, U>>(
    left: Matrix<U>,
    right: Matrix<U>,
  ) -> Matrix<U> {
    return Matrix<U> {
      xx: left.xx * right.xx + left.xy * right.yx,
      yx: left.yx * right.xx + left.yy * right.yx,
      xy: left.xx * right.xy + left.xy * right.yy,
      yy: left.yx * right.xy + left.yy * right.yy,
      dx: left.xx * right.dx + left.xy * right.dy + left.dx,
      dy: left.yx * right.dx + left.yy * right.dy + left.dy,
    }
  }

  pub fn transformPoint<U: Copy + Add<U, U> + Multiply<U, U>>(
    matrix: Matrix<U>,
    point: Point<U>,
  ) -> Point<U> {
    return Point<U> {
      x: matrix.xx * point.x + matrix.xy * point.y + matrix.dx,
      y: matrix.yx * point.x + matrix.yy * point.y + matrix.dy,
    }
  }
}

impl<T: Add<T, T>> Add<Point<T>, Point<T>> for Point<T> {
  fn add(left: Self, right: Self) -> Self {
    return Point.add<T>(move left, move right)
  }
}

impl<T: Subtract<T, T>> Subtract<Point<T>, Point<T>> for Point<T> {
  fn subtract(left: Self, right: Self) -> Self {
    return Point.subtract<T>(move left, move right)
  }
}

impl<T: Multiply<T, T>> Multiply<Point<T>, Point<T>> for Point<T> {
  fn multiply(left: Self, right: Self) -> Self {
    return Point.multiply<T>(move left, move right)
  }
}

impl<T: Divide<T, T>> Divide<Point<T>, Point<T>> for Point<T> {
  fn divide(left: Self, right: Self) -> Self {
    return Point.divide<T>(move left, move right)
  }
}

impl<T: Negate<T>> Negate<Point<T>> for Point<T> {
  fn negate(value: Self) -> Self {
    return Point.negate<T>(move value)
  }
}

impl<T: Copy + Multiply<T, T>> Multiply<T, Point<T>> for Point<T> {
  fn multiply(left: Self, right: T) -> Self {
    return Point.scale<T>(left, right)
  }
}

impl<T: Copy + Divide<T, T>> Divide<T, Point<T>> for Point<T> {
  fn divide(left: Self, right: T) -> Self {
    return Point.divideScalar<T>(left, right)
  }
}

impl<T: Copy + Add<T, T> + Multiply<T, T>> Multiply<Matrix<T>, Matrix<T>> for Matrix<T> {
  fn multiply(left: Self, right: Self) -> Self {
    return Matrix.multiply<T>(left, right)
  }
}

impl<T: Copy + Add<T, T> + Multiply<T, T>> Multiply<Point<T>, Point<T>> for Matrix<T> {
  fn multiply(left: Self, right: Point<T>) -> Point<T> {
    return Matrix.transformPoint<T>(left, right)
  }
}
