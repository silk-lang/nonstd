import scalar { Scalar, rawByteLen, readScalar, writeScalar }
import integer_types { Offset16, Offset24, Offset32, Uint24 }
import silk.core.option { Option }
import silk.core.ownership { Copy }

pub interface OffsetValue {
  fn offsetValue(value: Self) -> u32

  fn null() -> Self
}

impl OffsetValue for Offset16 {
  fn offsetValue(value: Offset16) -> u32 {
    return Offset16.toU32(value)
  }

  fn null() -> Offset16 {
    return Offset16.new(0)
  }
}

impl OffsetValue for Offset24 {
  fn offsetValue(value: Offset24) -> u32 {
    return Offset24.toU32(value)
  }

  fn null() -> Offset24 {
    return Offset24.new(Uint24.new(0))
  }
}

impl OffsetValue for Offset32 {
  fn offsetValue(value: Offset32) -> u32 {
    return Offset32.toU32(value)
  }

  fn null() -> Offset32 {
    return Offset32.new(0)
  }
}

pub fn offsetValue<T: OffsetValue>(value: T) -> u32 {
  return OffsetValue.offsetValue(move value)
}

pub struct Nullable<T: Scalar + OffsetValue + Copy> {
  inner: T,
}

impl<T: Scalar + OffsetValue + Copy> Copy for Nullable<T> {}

impl<T> Nullable<T> {
  pub fn new(value: T) -> Nullable<T> {
    return Nullable<T> { inner: value }
  }

  pub fn offset(self: &Self) -> &T {
    return &self.inner
  }

  pub fn isNull(self: &Self) -> bool {
    return offsetValue<T>(self.inner) == 0
  }

  pub fn default() -> Nullable<T> {
    return Nullable<T> { inner: OffsetValue.null() }
  }
}

impl<T: Scalar + OffsetValue + Copy> Scalar for Nullable<T> {
  fn rawByteLen() -> usize {
    return rawByteLen<T>()
  }

  fn read(bytes: &[u8]) -> Option<Self> {
    return match move readScalar<T>(bytes) {
      Option<T>.Some { value } => Option<Nullable<T>>.some(Nullable<T>.new(value))
      Option<T>.None => Option<Nullable<T>>.None
    }
  }

  fn write(value: Self, bytes: &mut [u8]) -> bool {
    return writeScalar<T>(value.inner, move bytes)
  }
}

import scalar { FixedSize }

impl<T: Scalar + OffsetValue + Copy> FixedSize for Nullable<T> {
  fn rawByteLen() -> usize {
    return rawByteLen<T>()
  }
}

import silk.core.equal { Equal }

impl<T: Scalar + OffsetValue + Copy + Equal> Equal for Nullable<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.inner == &right.inner
  }
}
