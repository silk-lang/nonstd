import cast
import scalar { rawByteLen, readScalar, writeScalar }
import silk.testing.testing { Testing, AssertionError }
import silk.core.option { Option }
import silk.num.i32
import silk.num.u16

test effect fn signedCastBoundaries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(cast.u8ToI8(128) == -128, "i8 minimum")
  run Testing.expect(cast.u16ToI16(32768) == -32768, "i16 minimum")
  run Testing.expect(cast.u32ToI32(2147483648) == i32.MIN, "i32 minimum")
  run Testing.expect(cast.i32ToU32(i32.MIN) == 2147483648, "reverse minimum")
  run Testing.expect(cast.i64ToI32(4294967295) == -1, "truncating cast")
}

test effect fn scalarExactWidths() -> ()
  ! AssertionError<'static> {
  run Testing.expect(rawByteLen<u16>() == 2, "scalar width")
  let value = readScalar<i16>(b"\xff\x80") |> Option<i16>.unwrapOr(0)
  run Testing.expect(value == -128, "signed big endian")
  let tooLong = readScalar<u16>(b"\x00\x01\x02") |> Option<u16>.unwrapOr(999)
  run Testing.expect(tooLong == 999, "exact width required")
  let mut output: [u8; 4] = [0; 4]
  run Testing.expect(writeScalar<i32>(-123456, &mut output), "write width")
  let decoded = readScalar<i32>(&output) |> Option<i32>.unwrapOr(0)
  run Testing.expect(decoded == -123456, "signed roundtrip")
}

import tag { Tag }
import big_endian { BigEndian }

test effect fn rawEndianStorage() -> ()
  ! AssertionError<'static> {
  let mut be = BigEndian<u16>.fromValue(65535)
  run Testing.expect(BigEndian<u16>.get(&be) == 65535, "big endian get")
  BigEndian<u16>.set(&mut be, 4660)
  let bytes = BigEndian<u16>.beBytes(&be)
  run Testing.expect(bytes.length == 2 && bytes[0] == 18 && bytes[1] == 52, "big endian set")
}

