import scalar { Scalar, readScalar, writeScalar }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.num.u16
import silk.num.u32

pub struct MajorMinor {
  pub major: u16,
  pub minor: u16,
}

impl Copy for MajorMinor {}

impl MajorMinor {
  pub fn new(major: u16, minor: u16) -> MajorMinor {
    return MajorMinor { major: major, minor: minor }
  }

  pub fn compatible(self: &Self, other: MajorMinor) -> bool {
    return self.major == other.major && self.minor >= other.minor
  }

  pub fn toBeBytes(self: &Self) -> [u8; 4] {
    let mut bytes: [u8; 4] = [0; 4]
    let done = writeScalar<MajorMinor>(self.*, &mut bytes)
    return bytes
  }
}

impl Equal for MajorMinor {
  fn equals(left: &MajorMinor, right: &MajorMinor) -> bool {
    return left.major == right.major && left.minor == right.minor
  }
}

impl Scalar for MajorMinor {
  fn rawByteLen() -> usize {
    return 4
  }

  fn read(bytes: &[u8]) -> Option<MajorMinor> {
    return match move readScalar<u32>(bytes) {
      Option<u32>.Some { value } => Option<MajorMinor>.some(
        MajorMinor { major: u32.toU16(u32.shiftRight(value, 16)), minor: u32.toU16(value & 65535) },
      )
      Option<u32>.None => Option<MajorMinor>.None
    }
  }

  fn write(value: MajorMinor, bytes: &mut [u8]) -> bool {
    return writeScalar<u32>(
      u32.shiftLeft(u16.toU32(value.major), 16) | u16.toU32(value.minor),
      move bytes,
    )
  }
}

pub struct Version16Dot16 {
  value: u32,
}

impl Copy for Version16Dot16 {}

impl Version16Dot16 {
  pub fn new(major: u16, minor: u16) -> Version16Dot16 {
    let mut clamped = minor
    if clamped > 9 {
      clamped = 9
    }
    return Version16Dot16 {
      value: u32.shiftLeft(u16.toU32(major), 16) | u32.shiftLeft(u16.toU32(clamped), 12),
    }
  }

  pub fn toMajorMinor(self: &Self) -> MajorMinor {
    return MajorMinor {
      major: u32.toU16(u32.shiftRight(self.value, 16)),
      minor: u32.toU16(u32.shiftRight(self.value & 65535, 12)),
    }
  }

  pub fn compatible(self: &Self, other: Version16Dot16) -> bool {
    let version = Version16Dot16.toMajorMinor(self)
    return MajorMinor.compatible(&version, Version16Dot16.toMajorMinor(&other))
  }

  pub fn toBeBytes(self: &Self) -> [u8; 4] {
    let mut bytes: [u8; 4] = [0; 4]
    let done = writeScalar<u32>(self.value, &mut bytes)
    return bytes
  }
}

impl Equal for Version16Dot16 {
  fn equals(left: &Version16Dot16, right: &Version16Dot16) -> bool {
    return left.value == right.value
  }
}

impl Scalar for Version16Dot16 {
  fn rawByteLen() -> usize {
    return 4
  }

  fn read(bytes: &[u8]) -> Option<Version16Dot16> {
    return match move readScalar<u32>(bytes) {
      Option<u32>.Some { value } => Option<Version16Dot16>.some(Version16Dot16 { value: value })
      Option<u32>.None => Option<Version16Dot16>.None
    }
  }

  fn write(value: Version16Dot16, bytes: &mut [u8]) -> bool {
    return writeScalar<u32>(value.value, move bytes)
  }
}

impl MajorMinor {
  pub fn version1_0() -> MajorMinor {
    return MajorMinor.new(1, 0)
  }

  pub fn version1_1() -> MajorMinor {
    return MajorMinor.new(1, 1)
  }

  pub fn version1_2() -> MajorMinor {
    return MajorMinor.new(1, 2)
  }

  pub fn version1_3() -> MajorMinor {
    return MajorMinor.new(1, 3)
  }

  pub fn version2_0() -> MajorMinor {
    return MajorMinor.new(2, 0)
  }
}

impl Version16Dot16 {
  pub fn version0_5() -> Version16Dot16 {
    return Version16Dot16.new(0, 5)
  }

  pub fn version1_0() -> Version16Dot16 {
    return Version16Dot16.new(1, 0)
  }

  pub fn version1_1() -> Version16Dot16 {
    return Version16Dot16.new(1, 1)
  }

  pub fn version2_0() -> Version16Dot16 {
    return Version16Dot16.new(2, 0)
  }

  pub fn version2_5() -> Version16Dot16 {
    return Version16Dot16.new(2, 5)
  }

  pub fn version3_0() -> Version16Dot16 {
    return Version16Dot16.new(3, 0)
  }
}

pub interface Compatible {
  fn compatible(self: &Self, other: Self) -> bool
}

impl Compatible for MajorMinor {
  fn compatible(self: &Self, other: Self) -> bool {
    return MajorMinor.compatible(self, other)
  }
}

impl Compatible for Version16Dot16 {
  fn compatible(self: &Self, other: Self) -> bool {
    return Version16Dot16.compatible(self, other)
  }
}

impl Compatible for u16 {
  fn compatible(self: &u16, other: u16) -> bool {
    return self.* >= other
  }
}

import scalar { FixedSize }

impl FixedSize for MajorMinor {
  fn rawByteLen() -> usize {
    return 4
  }
}

impl FixedSize for Version16Dot16 {
  fn rawByteLen() -> usize {
    return 4
  }
}
