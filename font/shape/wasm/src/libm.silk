//! The libm functions read_fonts declares for COLR transforms (`sinf`, `cosf`, `tanf`,
//! `hypotf`). The standalone wasm32 runtime links no C library, so on wasm32 these forward to the
//! host's `Math` (see `js/`). Other targets link the system libm.
static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.num.f32
  import silk.num.f64

  unsafe extern "C" fn hostSin(
    value: f64,
  ) -> f64 as "hr_host_sin" with Intrinsic.foreign(module: "math", name: "sin")

  unsafe extern "C" fn hostCos(
    value: f64,
  ) -> f64 as "hr_host_cos" with Intrinsic.foreign(module: "math", name: "cos")

  unsafe extern "C" fn hostTan(
    value: f64,
  ) -> f64 as "hr_host_tan" with Intrinsic.foreign(module: "math", name: "tan")

  unsafe extern "C" fn hostHypot(
    x: f64,
    y: f64,
  ) -> f64 as "hr_host_hypot" with Intrinsic.foreign(module: "math", name: "hypot")

  export "C" fn sinf(value: f32) -> f32 as "sinf" {
    unsafe {
      return f64.toF32(hostSin(f32.toF64(value)))
    }
  }

  export "C" fn cosf(value: f32) -> f32 as "cosf" {
    unsafe {
      return f64.toF32(hostCos(f32.toF64(value)))
    }
  }

  export "C" fn tanf(value: f32) -> f32 as "tanf" {
    unsafe {
      return f64.toF32(hostTan(f32.toF64(value)))
    }
  }

  export "C" fn hypotf(x: f32, y: f32) -> f32 as "hypotf" {
    unsafe {
      return f64.toF32(hostHypot(f32.toF64(x), f32.toF64(y)))
    }
  }
}
