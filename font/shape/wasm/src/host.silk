//! The two host imports the exports use to move bytes in and out of wasm memory.
static if Intrinsic.targetArchitecture() == "wasm32" {
  pub unsafe extern "C" fn hostInput(
    slot: u32,
    destination: ?[*]mut u8,
    length: u32,
  ) -> () as "hr_host_input" with Intrinsic.foreign(module: "host", name: "input")

  pub unsafe extern "C" fn hostOutput(
    kind: u32,
    source: ?[*]const u8,
    length: u32,
  ) -> () as "hr_host_output" with Intrinsic.foreign(module: "host", name: "output")
} else {
  // Lets workspace builds for native targets compile; the exports are only usable on wasm32.
  pub unsafe fn hostInput(slot: u32, destination: ?[*]mut u8, length: u32) -> () {
    Intrinsic.trap("hr_wasm needs a wasm32 host")
  }

  pub unsafe fn hostOutput(kind: u32, source: ?[*]const u8, length: u32) -> () {
    Intrinsic.trap("hr_wasm needs a wasm32 host")
  }
}
