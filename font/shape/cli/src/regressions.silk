//! Upstream nonliteral shaping regressions, including attachment-distance limits.
import io
import harfrust.lib {
  Buffer,
  GlyphPosition,
  GlyphInfo,
  ShaperData,
  Shaper,
  Feature,
  Tag,
  shapeWithFeatures as shape,
  ShapeError
}
import read_fonts.lib { FontRef, ReadError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

effect fn apply(
  base: &Path,
  fontPath: string,
  buffer: &mut Buffer,
  scale: i32,
  features: &[Feature],
) -> bool
  ! OutOfMemoryError | FileError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run io.read(base, fontPath)
  let font = match move FontRef.fromIndex(Bytes.asSlice(&bytes), 0) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      return false
    }
  }
  let data = ShaperData.new(&font)
  let mut shaper = Shaper.new(&data)
  if scale != 0 {
    Shaper.setScale(&mut shaper, scale, scale)
  }
  Buffer.guessSegmentProperties(&mut buffer)
  return match move run shape(&shaper, &mut buffer, features) {
    Result<(), ShapeError>.Success { value } => true
    _ => false
  }
}

pub effect fn execute(base: &Path) -> i32
  ! OutOfMemoryError | FileError | WriterError
  ? &mut Allocator | &mut FileSystem | &mut Writer {
  let mut buffer = Buffer.new()
  run Buffer.add(&mut buffer, 101, 0)
  let mut i: usize = 0
  while i < 35000 {
    run Buffer.add(&mut buffer, 0x301, usize.toU32(1 + i * 2))
    i = i + 1
  }
  run Buffer.add(&mut buffer, 88, 70001)
  if !run apply(
    base,
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestGPOSThree.ttf",
    &mut buffer,
    0,
    &[],
  ) {
    run Writer.writeString("FAIL long GPOS cluster\n")
    return 1
  }
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 101, 0)
  i = 0
  while i < 5000 {
    run Buffer.add(&mut buffer, 0x301, usize.toU32(1 + i * 2))
    i = i + 1
  }
  run Buffer.add(&mut buffer, 88, 10001)
  if !run apply(
    base,
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/Calculator-Regular.ttf",
    &mut buffer,
    10000000,
    &[],
  ) {
    run Writer.writeString("FAIL long fallback cluster\n")
    return 1
  }
  Buffer.clear(&mut buffer)
  i = 0
  while i < 35000 {
    run Buffer.add(&mut buffer, 117, usize.toU32(i * 2))
    run Buffer.add(&mut buffer, 84, usize.toU32(i * 2 + 1))
    i = i + 1
  }
  if !run apply(
    base,
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestKERNOne.otf",
    &mut buffer,
    0,
    &[],
  ) {
    run Writer.writeString("FAIL long kern line\n")
    return 1
  }
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 120, 0)
  i = 0
  while i < 32769 {
    run Buffer.add(&mut buffer, 0x301, usize.toU32(1 + i * 2))
    i = i + 1
  }
  if !run apply(
    base,
    "font/shape/test-data/harfrust/harfrust/tests/fonts/rb_custom/BungeeTint-Regular.ttf",
    &mut buffer,
    0,
    &[Feature.new(Tag.fromU32(0x6d6b6d6b), 0)],
  ) {
    run Writer.writeString("FAIL distant mark shaping\n")
    return 1
  }
  let last = Buffer.glyphPosition(&buffer, 32769)
    |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())
  let prior = Buffer.glyphPosition(&buffer, 32768)
    |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())
  let lastInfo = Buffer.glyphInfo(&buffer, 32769)
    |> Option<GlyphInfo>.unwrapOr(GlyphInfo { glyphId: 0, cluster: 0, flags: 0 })
  if lastInfo.glyphId != 975 || Buffer.len(&buffer) != 32770 || prior.xOffset != -369
    || last.xOffset != 0
    || last.xAdvance != 0 {
    run Writer.writeString("FAIL distant mark attachment boundary\n")
    return 1
  }
  let fonts = [
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestGSUBThree.ttf",
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestMORXFourteen.ttf",
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestMORXTwentyfour.ttf",
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestMORXThirtyfour.ttf",
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestMORXThirtysix.ttf",
    "font/shape/test-data/harfrust/harfrust/tests/fonts/text-rendering-tests/TestMORXFourtyone.ttf",
  ]
  let texts = ["lol", "ABBBCCCDDDBCDCE", "ABCDE", "ha", "A", "cc"]
  let lengths: [usize; 6] = [20001, 15, 5, 62084, 359, 2]
  let successful = [false, true, true, true, false, true]
  i = 0
  while i < fonts.length {
    Buffer.reset(&mut buffer)
    run Buffer.pushText(&mut buffer, texts[i], false)
    if !(run apply(base, fonts[i], &mut buffer, 0, &[])) || Buffer.len(&buffer) != lengths[i]
      || Buffer.allocationSuccessful(&buffer) != successful[i] {
      run Writer.writeString("FAIL work-limit buffer state: ")
      run Writer.writeString(fonts[i])
      run Writer.writeString("\n")
      return 1
    }
    i = i + 1
  }
  run Writer.writeString("4 long-input and 6 work-limit regressions passed\n")
  return 0
}
