import silk.collections.bytes { Bytes }
import silk.text.string { String }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub effect fn read(base: &Path, name: string) -> Bytes
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = if String.startsWith(name, "/") {
    run Path.fromBytes(String.utf8Bytes(name))
  } else {
    run Path.resolve(base, name)
  }
  return run FileSystem.readFile(&path)
}
