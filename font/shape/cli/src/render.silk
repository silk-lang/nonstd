import options { Options }
import harfrust.lib {
  Buffer,
  Language,
  Shaper,
  ConfiguredShaper,
  FontFuncs,
  DefaultFontFuncs,
  ShaperData,
  Feature,
  Variation,
  shapeWithFeatures as shape,
  ShapeError,
  serialize
}
import silk.concurrency.sync { Mutex, MutexGuard }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.text.string { String }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub effect fn render(data: &ShaperData, text: string, options: &Options) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  if options.trace {
    let messages = run Mutex<String>.make(String.make())
    let font = ConfiguredShaper<CliTrace>.withFuncs(
      data,
      CliTrace { messages: &messages, flags: options.serializeFlags },
    )
    let output = run renderWithFont(move font, text, options)
    let guard = Mutex<String>.lock(&messages)
    let mut result = run String.copy(String.view(MutexGuard.get(&guard)))
    run String.append(&mut result, String.view(&output))
    return move result
  }
  return run renderWithFont(Shaper.withFuncs(data, DefaultFontFuncs {}), text, options)
}

struct CliTrace<'a> {
  messages: &'a Mutex<String>,
  flags: u32,
}

impl<'a> FontFuncs for CliTrace<'a> {
  fn isDefault(self: &Self) -> bool {
    return true
  }

  fn tracing(self: &Self) -> bool {
    return true
  }

  effect fn message(
    self: &Self,
    font: &ConfiguredShaper<Self>,
    buffer: &Buffer,
    text: string,
  ) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let snapshot = run serialize(font, buffer, self.flags)
    let mut guard = Mutex<String>.lock(self.messages)
    let output = MutexGuard.getMut(&mut guard)
    run String.append(&mut output, "trace: ")
    run String.append(&mut output, text)
    run String.append(&mut output, "\tbuffer: ")
    run String.append(&mut output, String.view(&snapshot))
    run String.append(&mut output, "\n")
    return true
  }
}

effect fn renderWithFont<F: FontFuncs>(
  font: ConfiguredShaper<F>,
  text: string,
  options: &Options,
) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut font = move font
  run ConfiguredShaper.setVariations(&mut font, List<Variation>.asSlice(&options.variations))
  if options.scaled {
    ConfiguredShaper.setScale(&mut font, options.fontSize, options.fontSize)
  }
  font.pointSize = options.pointSize
  let mut buffer = Buffer.new()
  buffer.direction = options.direction
  buffer.script = options.script
  run Buffer.setLanguage(&mut buffer, Language.asString(&options.languageValue))
  buffer.language = options.language
  buffer.languageTags = options.languages
  if let Option<u32>.Some { value: selector } = &options.selector {
    Buffer.setNotFoundVariationSelectorGlyph(&mut buffer, Option<u32>.some(selector))
  }
  let mut contextIndex = List<u32>.length(&options.pre)
  while contextIndex > 0 {
    contextIndex = contextIndex - 1
    run List<u32>.append(&mut buffer.preContext, List<u32>.get(&options.pre, contextIndex))
  }
  contextIndex = 0
  while contextIndex < List<u32>.length(&options.post) {
    run List<u32>.append(&mut buffer.postContext, List<u32>.get(&options.post, contextIndex))
    contextIndex = contextIndex + 1
  }
  buffer.flags = options.flags
  buffer.clusterLevel = options.clusterLevel
  run Buffer.pushText(&mut buffer, text, options.utf8Clusters)
  Buffer.guessSegmentProperties(&mut buffer)
  let result = run shape(&font, &mut buffer, List<Feature>.asSlice(&options.features))
  if let Result<(), ShapeError>.Failure { error } = move result {
    return String.make()
  }
  let mut output = run serialize(&font, &buffer, options.serializeFlags)
  if String.ownedByteLength(&output) == 0 {
    run String.append(&mut output, "[]")
  }
  return move output
}
