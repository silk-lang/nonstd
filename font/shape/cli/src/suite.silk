//! One executable loops over upstream fixtures; no per-case generated Silk bodies.
import options { Options }
import render { render }
import io
import harfrust.lib { ShaperData }
import read_fonts.lib { FontRef, FontData, ReadError }
import silk.collections.bytes { Bytes }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Format }
import silk.num.u32
import silk.num.usize

struct Reader<'a> {
  data: FontData<'a>,
  offset: usize,
  valid: bool,
}

impl<'a> Reader<'a> {
  fn text(self: &mut Self) -> string<'a> {
    let size = match move FontData<'a>.readAt<u32>(&self.data, self.offset) {
      Result<u32, ReadError>.Success { value } => u32.toUsize(value)
      _ => {
        self.valid = false
        return ""
      }
    }
    self.offset = usize.saturatingAdd(self.offset, 4)
    let end = usize.saturatingAdd(self.offset, size)
    let bytes = match move FontData.slice(&self.data, self.offset, end) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        self.valid = false
        return ""
      }
    }
    self.offset = end
    return match move String.fromUtf8(FontData.asBytes(&bytes)) {
      Result<string, InvalidUtf8>.Success { value } => value
      _ => {
        self.valid = false
        return ""
      }
    }
  }
}

pub effect fn runSuite(base: &Path, path: string, knownPath: string, filter: string) -> i32
  ! FileError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  let fixture = run io.read(base, path)
  let data = FontData.new(Bytes.asSlice(&fixture))
  if (read32(&data, 0)) != 0x48525331 {
    run Writer.writeString("invalid shaping fixture\n")
    return 2
  }
  let count = read32(&data, 4)
  let mut knownBytes = Bytes.make()
  if knownPath != "" {
    knownBytes = run io.read(base, knownPath)
  }
  let known = String.fromUtf8(Bytes.asSlice(&knownBytes))
    |> Result<string, InvalidUtf8>.unwrapOr("")
  let mut reader = Reader { data: data, offset: 8, valid: true }
  let mut passed: u32 = 0
  let mut failed: u32 = 0
  let mut skipped: u32 = 0
  let mut i: u32 = 0
  let mut lastFont = String.make()
  let mut fontBytes = Bytes.make()
  while i < count {
    let name = Reader.text(&mut reader)
    let fontPath = Reader.text(&mut reader)
    let text = Reader.text(&mut reader)
    let settings = Reader.text(&mut reader)
    let expected = Reader.text(&mut reader)
    if !reader.valid {
      run Writer.writeString("truncated shaping fixture\n")
      return 2
    }
    i = i + 1
    if filter != "" && !String.contains(name, filter) {
      continue
    }
    let mut needle = String.make()
    run String.append(&mut needle, "\n")
    run String.append(&mut needle, name)
    run String.append(&mut needle, "\n")
    if String.contains(known, String.view(&needle)) {
      skipped = skipped + 1
      continue
    }
    let mut options = Options.new()
    if !run Options.parse(&mut options, settings) {
      failed = failed + 1
      run Writer.writeString("OPTION\t")
      run Writer.writeString(name)
      run Writer.writeString("\t")
      run Writer.writeString(settings)
      run Writer.writeString("\n")
      continue
    }
    if String.view(&lastFont) != fontPath {
      let mut fullPath = String.make()
      run String.append(&mut fullPath, "font/shape/test-data/harfrust/harfrust/")
      run String.append(&mut fullPath, fontPath)
      fontBytes = run io.read(base, String.view(&fullPath))
      lastFont = run String.copy(fontPath)
    }
    let font = match move FontRef.fromIndex(Bytes.asSlice(&fontBytes), options.faceIndex) {
      Result<FontRef, ReadError>.Success { value } => value
      _ => {
        failed = failed + 1
        run Writer.writeString("FONT\t")
        run Writer.writeString(name)
        run Writer.writeString("\n")
        continue
      }
    }
    let shaperData = ShaperData.new(&font)
    let output = run render(&shaperData, text, &options)
    if expected == "" || String.view(&output) == expected {
      passed = passed + 1
    } else {
      failed = failed + 1
      run Writer.writeString("FAIL\t")
      run Writer.writeString(name)
      run Writer.writeString("\t")
      run Writer.writeString(expected)
      run Writer.writeString("\t")
      run Writer.writeString(String.view(&output))
      run Writer.writeString("\n")
    }
  }
  if reader.offset != FontData.len(&data) {
    run Writer.writeString("trailing shaping fixture data\n")
    return 2
  }
  run Format.format(
    "{passed} passed, {failed} failed, {skipped} skipped\n",
    &.{ passed: passed, failed: failed, skipped: skipped },
  )
  if failed != 0 {
    return 1
  }
  return 0
}

fn read32<'a>(data: &FontData<'a>, at: usize) -> u32 {
  return FontData<'a>.readAt<u32>(data, at) |> Result<u32, ReadError>.unwrapOr(0)
}
