//! hr_shape FONT TEXT [options], or the data-driven conformance runner.
import options { Options }
import render { render }
import suite
import bench
import regressions
import io
import harfrust.lib { ShaperData }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.text.string { String, InvalidUtf8 }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_native { OsFileSystem }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }

effect fn process() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput | &mut FileSystem | &mut Writer {
  let mut args = List<String>.make()
  let count = run HostInput.argumentCount()
  let mut i: usize = 1
  while i < count {
    if let Option<Bytes>.Some { value: raw } = run HostInput.argument(i) {
      if let Result<String, InvalidUtf8>.Success { value: text } = move String.fromBytes(move raw) {
        run List<String>.append(&mut args, move text)
      } else {
        run Writer.writeString("hr_shape: arguments must be UTF-8\n")
        return 2
      }
    }
    i = i + 1
  }
  let values = List<String>.asSlice(&args)
  if values.length == 0 || String.view(&values[0]) == "--help" {
    run Writer.writeString(
      "Usage: hr_shape FONT TEXT [--direction=ltr|rtl|ttb|btt] [--script=Latn]\n       [--language=en] [--features=kern,-liga] [--variations=wght=500]\n       [--no-glyph-names] [--no-positions] [--no-clusters] [--show-flags]\n",
    )
    return 0
  }
  if String.view(&values[0]) == "--version" {
    run Writer.writeString("hr_shape 0.1.0 (Harfrust 1503ff0)\n")
    return 0
  }
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  if String.view(&values[0]) == "--regressions" {
    return run regressions.execute(&base)
  }
  if String.view(&values[0]) == "--bench" {
    if values.length != 4 {
      return 2
    }
    return run bench.execute(
      &base,
      String.view(&values[1]),
      String.view(&values[2]),
      String.view(&values[3]),
    )
  }
  if String.view(&values[0]) == "--suite" {
    if values.length < 2 {
      return 2
    }
    let mut filter = String.slice(String.view(&values[0]), 0, 0)
    let mut known = String.slice(String.view(&values[0]), 0, 0)
    i = 2
    while i + 1 < values.length {
      if String.view(&values[i]) == "--filter" {
        filter = String.view(&values[i + 1])
      } else if String.view(&values[i]) == "--known-failures" {
        known = String.view(&values[i + 1])
      } else {
        return 2
      }
      i = i + 2
    }
    return run suite.runSuite(&base, String.view(&values[1]), known, filter)
  }
  if values.length < 2 {
    run Writer.writeString("hr_shape: expected a font path and text\n")
    return 2
  }
  let mut options = Options.new()
  let mut settings = String.make()
  i = 2
  while i < values.length {
    if i != 2 {
      run String.append(&mut settings, " ")
    }
    run String.append(&mut settings, String.view(&values[i]))
    i = i + 1
  }
  if !run Options.parse(&mut options, String.view(&settings)) {
    run Writer.writeString("hr_shape: invalid or unsupported option\n")
    return 2
  }
  let bytes = run io.read(&base, String.view(&values[0]))
  let font = match move FontRef.fromIndex(Bytes.asSlice(&bytes), options.faceIndex) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Writer.writeString("hr_shape: invalid font\n")
      return 2
    }
  }
  let data = ShaperData.new(&font)
  let mut textBytes = Bytes.make()
  let mut text = String.view(&values[1])
  if String.startsWith(text, "--text-file=") {
    textBytes = run io.read(&base, String.slice(text, 12, String.byteLength(text) - 12))
    text = match move String.fromUtf8(Bytes.asSlice(&textBytes)) {
      Result<string, InvalidUtf8>.Success { value } => value
      _ => {
        run Writer.writeString("hr_shape: text file must be UTF-8\n")
        return 2
      }
    }
  }
  let result = run render(&data, text, &options)
  run Writer.writeString(String.view(&result))
  run Writer.writeString("\n")
  return 0
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  let mut writer = StderrWriter.make()
  run Writer.writeString("hr_shape: unable to process input\n")
    |> Effect.provideMut<Writer>(&mut writer)
  return 2
}

effect fn provided() -> i32
  ! OutOfMemoryError | HostInputError | FileError | WriterError
  ? &mut Allocator | &mut HostInput {
  let mut files = run OsFileSystem.make("/")
  let mut writer = StdoutWriter.make()
  return run process() |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(provided(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
