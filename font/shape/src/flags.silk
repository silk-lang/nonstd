//! Public buffer, glyph, and serialization bit masks.
import silk.core.ownership { Copy }

pub struct BufferFlags {
  bits: u32,
}

impl Copy for BufferFlags {}

impl BufferFlags {
  pub fn empty() -> Self {
    return Self { bits: 0 }
  }

  pub fn all() -> Self {
    return Self { bits: 255 }
  }

  pub fn beginningOfText() -> Self {
    return Self { bits: 1 }
  }

  pub fn endOfText() -> Self {
    return Self { bits: 2 }
  }

  pub fn preserveDefaultIgnorables() -> Self {
    return Self { bits: 4 }
  }

  pub fn removeDefaultIgnorables() -> Self {
    return Self { bits: 8 }
  }

  pub fn doNotInsertDottedCircle() -> Self {
    return Self { bits: 16 }
  }

  pub fn verify() -> Self {
    return Self { bits: 32 }
  }

  pub fn produceUnsafeToConcat() -> Self {
    return Self { bits: 64 }
  }

  pub fn produceSafeToInsertTatweel() -> Self {
    return Self { bits: 128 }
  }

  pub fn fromBitsTruncate(bits: u32) -> Self {
    return Self { bits: bits & 255 }
  }

  pub fn toBits(self: Self) -> u32 {
    return self.bits
  }

  pub fn contains(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) == other.bits
  }

  pub fn intersects(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) != 0
  }

  pub fn combined(self: Self, other: Self) -> Self {
    return Self { bits: self.bits | other.bits }
  }

  pub fn without(self: Self, other: Self) -> Self {
    return Self { bits: self.bits & (4294967295 ^ other.bits) }
  }
}

pub struct GlyphFlags {
  bits: u32,
}

impl Copy for GlyphFlags {}

impl GlyphFlags {
  pub fn empty() -> Self {
    return Self { bits: 0 }
  }

  pub fn all() -> Self {
    return Self { bits: 7 }
  }

  pub fn unsafeToBreak() -> Self {
    return Self { bits: 1 }
  }

  pub fn unsafeToConcat() -> Self {
    return Self { bits: 2 }
  }

  pub fn safeToInsertTatweel() -> Self {
    return Self { bits: 4 }
  }

  pub fn fromBitsTruncate(bits: u32) -> Self {
    return Self { bits: bits & 7 }
  }

  pub fn toBits(self: Self) -> u32 {
    return self.bits
  }

  pub fn contains(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) == other.bits
  }

  pub fn intersects(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) != 0
  }

  pub fn combined(self: Self, other: Self) -> Self {
    return Self { bits: self.bits | other.bits }
  }

  pub fn without(self: Self, other: Self) -> Self {
    return Self { bits: self.bits & (4294967295 ^ other.bits) }
  }
}

pub struct SerializeFlags {
  bits: u32,
}

impl Copy for SerializeFlags {}

impl SerializeFlags {
  pub fn empty() -> Self {
    return Self { bits: 0 }
  }

  pub fn all() -> Self {
    return Self { bits: 63 }
  }

  pub fn noClusters() -> Self {
    return Self { bits: 1 }
  }

  pub fn noPositions() -> Self {
    return Self { bits: 2 }
  }

  pub fn noGlyphNames() -> Self {
    return Self { bits: 4 }
  }

  pub fn glyphExtents() -> Self {
    return Self { bits: 8 }
  }

  pub fn glyphFlags() -> Self {
    return Self { bits: 16 }
  }

  pub fn noAdvances() -> Self {
    return Self { bits: 32 }
  }

  pub fn fromBitsTruncate(bits: u32) -> Self {
    return Self { bits: bits & 63 }
  }

  pub fn toBits(self: Self) -> u32 {
    return self.bits
  }

  pub fn contains(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) == other.bits
  }

  pub fn intersects(self: Self, other: Self) -> bool {
    return (self.bits & other.bits) != 0
  }

  pub fn combined(self: Self, other: Self) -> Self {
    return Self { bits: self.bits | other.bits }
  }

  pub fn without(self: Self, other: Self) -> Self {
    return Self { bits: self.bits & (4294967295 ^ other.bits) }
  }
}
