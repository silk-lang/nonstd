import set_digest { SetDigest }
import view { View }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u32

test effect fn lookupCoverageDigests() -> ()
  ! AssertionError<'static> {
  let starts: [u32; 8] = [0, 10, 63, 170, 1020, 65530, 0x10000, 0xfffff0]
  let mut i: usize = 0
  while i < starts.length {
    let mut n: u32 = 0
    while n <= 130 {
      let mut digest = SetDigest.new()
      SetDigest.addRange(&mut digest, starts[i], starts[i] + n)
      let mut cp = starts[i]
      while cp <= starts[i] + n {
        run Testing.expect(
          SetDigest.mayHave(&digest, cp),
          "range digests must never reject a covered glyph",
        )
        cp = cp + 1
      }
      n = n + 1
    }
    i = i + 1
  }
  let mut first = SetDigest.new()
  let mut second = SetDigest.new()
  SetDigest.add(&mut first, 42)
  SetDigest.add(&mut second, 43)
  run Testing.expect(!SetDigest.mayIntersect(&first, &second), "disjoint singletons")
  SetDigest.include(&mut first, &second)
  run Testing.expect(
    SetDigest.mayHave(&first, 42) && SetDigest.mayHave(&first, 43)
      && SetDigest.mayIntersect(&first, &second),
    "digest union",
  )
  SetDigest.clear(&mut first)
  run Testing.expect(!SetDigest.mayHave(&first, 42), "clear digest")
}

test effect fn checkedCoverageAndClassFormats() -> ()
  ! AssertionError<'static> {
  let coverage = View.bytes(b"\x00\x04\x00\x00\x01\x01\x00\x01\x01\x00\x03\x00\x00\x05")
  run Testing.expect(
    (View.coverage(&coverage, 0x10002) |> Option<u32>.unwrapOr(0)) == 6,
    "24-bit coverage ranges",
  )
  let truncated = View.range(&coverage, 0, 13)
  run Testing.expect(
    match move View.coverage(&truncated, 0x10002) {
      Option<u32>.None => true
      _ => false
    },
    "truncated ranges never fabricate coverage",
  )
  let classes = View.bytes(b"\x00\x03\x01\x00\x01\x00\x00\x02\x00\x00\x07\x00\x00\x08")
  run Testing.expect(
    View.class(&classes, 0x10001) == 7 && View.class(&classes, 0x10002) == 8
      && View.class(&classes, 0x10003) == 0,
    "wide class values",
  )
  let ranges = View.bytes(b"\x00\x04\x00\x00\x01\x01\x00\x01\x01\x00\x03\x00\x09")
  run Testing.expect(View.class(&ranges, 0x10002) == 9, "24-bit class ranges with 16-bit classes")
  let mut digest = SetDigest.new()
  SetDigest.addCoverage(&mut digest, coverage)
  run Testing.expect(
    SetDigest.mayHave(&digest, 0x10001) && SetDigest.mayHave(&digest, 0x10003)
      && !SetDigest.mayHave(&digest, 0x10004),
    "wide coverage digest",
  )
}
