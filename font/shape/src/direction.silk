import silk.core.result { Result }
import silk.text.string { String }
import silk.num.u8

pub enum Direction {
  Invalid,
  LeftToRight,
  RightToLeft,
  TopToBottom,
  BottomToTop,
}

pub enum ParseError {
  InvalidSetting,
}

impl Direction {
  pub fn isHorizontal(self: Self) -> bool {
    return self == Direction.LeftToRight || self == Direction.RightToLeft
  }

  pub fn isForward(self: Self) -> bool {
    return self == Direction.LeftToRight || self == Direction.TopToBottom
  }

  pub fn reverse(self: Self) -> Self {
    return match self {
      Direction.LeftToRight => Direction.RightToLeft
      Direction.RightToLeft => Direction.LeftToRight
      Direction.TopToBottom => Direction.BottomToTop
      Direction.BottomToTop => Direction.TopToBottom
      _ => Direction.Invalid
    }
  }

  pub fn parse(text: string) -> Result<Self, ParseError> {
    let bytes = String.utf8Bytes(text)
    if bytes.length > 0 {
      let first = bytes[0] | 32
      if first == 108 {
        return Result<Self, ParseError>.succeed(Direction.LeftToRight)
      }
      if first == 114 {
        return Result<Self, ParseError>.succeed(Direction.RightToLeft)
      }
      if first == 116 {
        return Result<Self, ParseError>.succeed(Direction.TopToBottom)
      }
      if first == 98 {
        return Result<Self, ParseError>.succeed(Direction.BottomToTop)
      }
    }
    return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
  }
}

impl Direction {
  pub fn isVertical(self: Self) -> bool {
    return self == Direction.TopToBottom || self == Direction.BottomToTop
  }

  pub fn isBackward(self: Self) -> bool {
    return self == Direction.RightToLeft || self == Direction.BottomToTop
  }
}
