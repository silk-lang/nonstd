import shape_plan { ShapePlan }
import feature { Feature }
import silk.core.option { Option }

pub struct ShapeOptions<'a: 'p, 'p> {
  pub plan: Option<&'p ShapePlan<'a>>,
  pub features: Option<&'p [Feature]>,
  pub pointSize: Option<f32>,
}

impl<'a: 'p, 'p> ShapeOptions<'a, 'p> {
  pub fn new() -> Self {
    return Self {
      plan: Option<&'p ShapePlan<'a>>.None,
      features: Option<&'p [Feature]>.None,
      pointSize: Option<f32>.None,
    }
  }

  pub fn forPlan(plan: &'p ShapePlan<'a>, features: &'p [Feature]) -> Self {
    return Self {
      plan: Option<&'p ShapePlan<'a>>.some(plan),
      features: Option<&'p [Feature]>.some(features),
      pointSize: Option<f32>.None,
    }
  }

  pub fn forFeatures(features: &'p [Feature]) -> Self {
    return Self {
      plan: Option<&'p ShapePlan<'a>>.None,
      features: Option<&'p [Feature]>.some(features),
      pointSize: Option<f32>.None,
    }
  }

  pub fn withPointSize(self: Self, value: f32) -> Self {
    let mut result = move self
    result.pointSize = Option<f32>.some(value)
    return move result
  }
}
