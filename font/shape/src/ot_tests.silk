import ot
import generated_fixtures as Fixtures
import buffer { Buffer, Glyph }
import direction { Direction }
import font_types.lib { F2Dot14 }
import font { ShaperData, Shaper }
import plan { OtPlan }
import view { View }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.usize

effect fn execute(table: &[u8], glyphs: &[u32], positioning: bool, markClasses: bool) -> Buffer
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  return run executeWithVariation(table, glyphs, positioning, markClasses, &[], false)
}

effect fn executeWithVariation<'a>(
  table: &'a [u8],
  glyphs: &[u32],
  positioning: bool,
  markClasses: bool,
  gdef: &'a [u8],
  fractional: bool,
) -> Buffer
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = match move FontRef<'a>.new(b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00") {
    Result<FontRef<'a>, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "minimal sfnt header")
      return Buffer.new()
    }
  }
  let mut data = ShaperData.new(&font)
  data.gdef = View.bytes(gdef)
  let mut shaper = Shaper.new(&data)
  if fractional {
    run List<F2Dot14>.append(&mut shaper.coords, F2Dot14.fromBits(8192))
  }
  let mut buffer = Buffer.new()
  buffer.direction = Direction.LeftToRight
  let mut i: usize = 0
  while i < glyphs.length {
    let mut glyph = Glyph.new(65, usize.toU32(i))
    glyph.info.glyphId = glyphs[i]
    glyph.glyphClass = 1
    if markClasses {
      glyph.glyphClass = 3
    }
    run List<Glyph>.append(&mut buffer.glyphs, glyph)
    i = i + 1
  }
  let mut plan = OtPlan.forTable(View.bytes(table), positioning)
  run OtPlan.addStep(&mut plan, 0, false, 0x74657374, 1, 0)
  run OtPlan.addAllClasses(&mut plan)
  run ot.apply(&shaper, &mut buffer, &plan, &[])
  return move buffer
}

effect fn substitutionCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let tables: [&[u8]; 3] = [
    Fixtures.singleDelta(),
    Fixtures.singleArray(),
    Fixtures.singleNegativeDelta(),
  ]
  let mut i: usize = 0
  while i < 3 {
    let mut source: u32 = 0x10001
    let mut target: u32 = 0x10003
    if i == 2 {
      source = 0x10003
      target = 0x10001
    }
    let result = run execute(tables[i], &[source], false, false)
    run Testing.expect(
      Buffer.len(&result) == 1 && List<Glyph>.get(&result.glyphs, 0).info.glyphId == target,
      "24-bit singles preserve high bits and signed deltas",
    )
    i = i + 1
  }
  let multiple = run execute(Fixtures.multiple(), &[0x10001], false, false)
  run Testing.expect(
    Buffer.len(&multiple) == 2 && List<Glyph>.get(&multiple.glyphs, 0).info.glyphId == 0x10002
      && List<Glyph>.get(&multiple.glyphs, 1).info.glyphId == 0x10003,
    "wide multiple substitution",
  )
  let alternate = run execute(Fixtures.alternate(), &[0x10001], false, false)
  run Testing.expect(
    List<Glyph>.get(&alternate.glyphs, 0).info.glyphId == 0x10002,
    "wide alternate substitution",
  )
  let ligature = run execute(Fixtures.ligature(), &[0x10001, 0x10002], false, false)
  run Testing.expect(
    Buffer.len(&ligature) == 1 && List<Glyph>.get(&ligature.glyphs, 0).info.glyphId == 0x10003,
    "wide ligature offsets and components",
  )
  let reverse = run execute(Fixtures.reverse(), &[0x10002, 0x10001, 0x10002], false, false)
  run Testing.expect(
    List<Glyph>.get(&reverse.glyphs, 1).info.glyphId == 0x10003,
    "wide reverse substitution checks both contexts",
  )
  let mismatch = run execute(Fixtures.reverse(), &[0x10003, 0x10001, 0x10002], false, false)
  run Testing.expect(
    List<Glyph>.get(&mismatch.glyphs, 1).info.glyphId == 0x10001,
    "reverse context mismatch leaves the glyph intact",
  )
  let contexts: [&[u8]; 5] = [
    Fixtures.context4(),
    Fixtures.context5(),
    Fixtures.context6(),
    Fixtures.chain4(),
    Fixtures.chain5(),
  ]
  i = 0
  while i < 5 {
    let result = run execute(contexts[i], &[0x10001, 0x10002], false, false)
    run Testing.expect(
      List<Glyph>.get(&result.glyphs, 0).info.glyphId == 0x10003,
      "wide contextual lookup reaches its nested lookup",
    )
    let mismatch = run execute(contexts[i], &[0x10001, 0x10003], false, false)
    run Testing.expect(
      List<Glyph>.get(&mismatch.glyphs, 0).info.glyphId == 0x10001,
      "wide contextual lookup rejects a mismatching glyph or class",
    )
    i = i + 1
  }
}

effect fn positionCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let varied = run executeWithVariation(
    Fixtures.fractionalPosition(),
    &[0x10001],
    true,
    false,
    Fixtures.fractionalGdef(),
    true,
  )
  run Testing.expect(
    List<Glyph>.get(&varied.glyphs, 0).position.xAdvance == 2,
    "fractional GPOS deltas round only after scaling",
  )
  let singles: [&[u8]; 2] = [Fixtures.position3(), Fixtures.position4()]
  let mut i: usize = 0
  while i < 2 {
    let result = run execute(singles[i], &[0x10001], true, false)
    run Testing.expect(
      List<Glyph>.get(&result.glyphs, 0).position.xAdvance == -37,
      "wide single positioning",
    )
    i = i + 1
  }
  let pairs: [&[u8]; 2] = [Fixtures.pair3(), Fixtures.pair4()]
  i = 0
  while i < 2 {
    let result = run execute(pairs[i], &[0x10001, 0x10002], true, false)
    run Testing.expect(
      List<Glyph>.get(&result.glyphs, 0).position.xAdvance == -37
        && List<Glyph>.get(&result.glyphs, 1).position.xOffset == 19,
      "wide pair glyph and class records",
    )
    i = i + 1
  }
  let cursive = run execute(Fixtures.cursive2(), &[0x10001, 0x10002], true, false)
  run Testing.expect(
    List<Glyph>.get(&cursive.glyphs, 0).position.xAdvance == 100
      && List<Glyph>.get(&cursive.glyphs, 1).position.yOffset == 180
      && List<Glyph>.get(&cursive.glyphs, 1).attach == -1,
    "wide cursive entry and exit anchors",
  )
  let marks: [&[u8]; 3] = [Fixtures.markBase2(), Fixtures.markLigature2(), Fixtures.markMark2()]
  i = 0
  while i < 3 {
    let result = run execute(marks[i], &[0x10001, 0x10002], true, i == 2)
    let glyph = List<Glyph>.get(&result.glyphs, 1)
    run Testing.expect(
      glyph.position.xOffset == 90 && glyph.position.yOffset == 180 && glyph.attach == -1,
      "wide mark, base, component and mark2 arrays",
    )
    i = i + 1
  }
}

test effect fn wideSubstitutionFormats() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run substitutionCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn widePositioningFormats() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run positionCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
