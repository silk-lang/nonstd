import feature { Feature }
import direction { Direction, ParseError }
import scale { Scale }
import font_types.lib { Tag }
import silk.testing.testing { Testing, AssertionError }
import silk.core.result { Result }

effect fn check(text: string, value: u32, start: u32, end: u32) -> ()
  ! AssertionError<'static> {
  match move Feature.parse(text) {
    Result<Feature, ParseError>.Success { value: feature } => {
      run Testing.expect(Tag.toU32(feature.tag) == 0x6b65726e, "feature tag")
      run Testing.expect(
        feature.value == value && feature.start == start && feature.end == end,
        "feature value and half-open range",
      )
    }
    _ => {
      run Testing.expect(false, "valid feature parses")
    }
  }
}

test effect fn upstreamFeatureSyntax() -> ()
  ! AssertionError<'static> {
  run check("kern", 1, 0, 4294967295)
  run check("+kern", 1, 0, 4294967295)
  run check("-kern", 0, 0, 4294967295)
  run check("kern=0", 0, 0, 4294967295)
  run check("kern=1", 1, 0, 4294967295)
  run check("kern=2", 2, 0, 4294967295)
  run check("kern[]", 1, 0, 4294967295)
  run check("kern[:]", 1, 0, 4294967295)
  run check("kern[5:]", 1, 5, 4294967295)
  run check("kern[:5]", 1, 0, 5)
  run check("kern[3:5]", 1, 3, 5)
  run check("kern[3]", 1, 3, 4)
  run check("kern[3:5]=2", 2, 3, 5)
  run check("kern[3;5]=2", 2, 3, 5)
  run check("kern[:-1]", 1, 0, 4294967295)
  run check("kern[-1]", 1, 4294967295, 4294967295)
  run check("kern=on", 1, 0, 4294967295)
  run check("kern=off", 0, 0, 4294967295)
  run check("kern=oN", 1, 0, 4294967295)
  run check("kern=oFf", 0, 0, 4294967295)
  run check(" 'kern'[2:4]=3 ", 3, 2, 4)
}

test effect fn rejectsMalformedFeatures() -> ()
  ! AssertionError<'static> {
  let cases = [
    "",
    "kern=",
    "kern[",
    "kern[1:2",
    "kerning",
    "kern=2147483648",
    "kern=banana",
    "kern[1]junk",
  ]
  let mut i: usize = 0
  while i < 8 {
    let rejected = match move Feature.parse(cases[i]) {
      Result<Feature, ParseError>.Failure { error } => true
      _ => false
    }
    run Testing.expect(rejected, "malformed feature rejected")
    i = i + 1
  }
}

test effect fn fixedPointScalingRoundsNegativeHalvesUp() -> ()
  ! AssertionError<'static> {
  let half = Scale.new(500, -500, 1000)
  run Testing.expect(
    Scale.x(&half, 3) == 2 && Scale.x(&half, -3) == -1,
    "fixed point half rounding",
  )
  run Testing.expect(Scale.y(&half, 3) == -1 && Scale.y(&half, -3) == 2, "negative scale")
  run Testing.expect(Scale.x(&Scale.new(0, 0, 0), 123) == 123, "zero upem gives identity")
}
