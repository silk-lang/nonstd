import shape { shape, ShapeError }
import shape_plan { ShapePlan, ShapePlanKey }
import options { ShapeOptions }
import plan { LookupStep }
import font { Shaper, ShaperData }
import buffer { Buffer, Glyph, ClusterLevel, ContentType }
import feature { Feature }
import direction { Direction }
import generated_fixtures as Fixtures
import font_types.lib { Tag, GlyphId }
import silk.core.option { Option }
import read_fonts.lib { FontRef, ReadError }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

effect fn planCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = match move FontRef.new(Fixtures.plannedFont()) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "synthetic shaping font")
      return
    }
  }
  let data = ShaperData.new(&font)
  let shaper = Shaper.new(&data)
  let features = [Feature.new(Tag.fromU32(0x74657374), 1)]
  let mut buffer = Buffer.new()
  run Buffer.pushStr(&mut buffer, "AB")
  Buffer.guessSegmentProperties(&mut buffer)
  let plan = run ShapePlan.new(&shaper, &buffer, &features)
  run Testing.expect(
    ShapePlanKey.matches(&ShapePlanKey.new(&shaper, &buffer, &features), &plan),
    "a fresh plan matches its key",
  )
  let result = run shape(&shaper, &mut buffer, ShapeOptions.forPlan(&plan, &features))
  run Testing.expect(
    match &result {
      Result<(), ShapeError>.Success { value } => true
      _ => false
    },
    "shape with a reusable plan",
  )
  run Testing.expect(
    Buffer.len(&buffer) == 1 && List<Glyph>.get(&buffer.glyphs, 0).info.glyphId == 0x10003,
    "plan resolves wide ScriptList, FeatureList and LookupList offsets",
  )
  let twice = run shape(&shaper, &mut buffer, ShapeOptions.new())
  run Testing.expect(
    match &twice {
      Result<(), ShapeError>.Failure { error: ShapeError.AlreadyShaped } => true
      _ => false
    },
    "already-shaped buffers are rejected without mutation",
  )
  run Testing.expect(
    Buffer.len(&buffer) == 1 && List<Glyph>.get(&buffer.glyphs, 0).info.glyphId == 0x10003,
    "rejected shaping leaves glyphs untouched",
  )
  buffer.flags = 64
  buffer.clusterLevel = ClusterLevel.Characters
  Buffer.setInvisibleGlyph(&mut buffer, Option<GlyphId>.some(GlyphId.new(42)))
  Buffer.clear(&mut buffer)
  run Testing.expect(
    buffer.flags == 64 && buffer.clusterLevel == ClusterLevel.Characters
      && GlyphId.toU32(
        Buffer.getInvisibleGlyph(&buffer) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)),
      )
        == 42,
    "clear retains buffer configuration",
  )
  run Buffer.pushStr(&mut buffer, "AB")
  Buffer.guessSegmentProperties(&mut buffer)
  buffer.direction = Direction.RightToLeft
  let mismatch = run shape(&shaper, &mut buffer, ShapeOptions.forPlan(&plan, &[]))
  run Testing.expect(
    match &mismatch {
      Result<(), ShapeError>.Failure {
        error: ShapeError.DirectionMismatch { plan: planDirection, buffer: bufferDirection }
      } => true
      _ => false
    },
    "a plan with a different direction is rejected",
  )
  run Testing.expect(
    Buffer.len(&buffer) == 2 && buffer.contentType == ContentType.Unicode,
    "plan mismatch preserves input",
  )
  buffer.direction = Direction.LeftToRight
  buffer.script = 0x41726162
  let scriptMismatch = run shape(&shaper, &mut buffer, ShapeOptions.forPlan(&plan, &[]))
  run Testing.expect(
    match &scriptMismatch {
      Result<(), ShapeError>.Failure {
        error: ShapeError.ScriptMismatch { plan: planDirection, buffer: bufferDirection }
      } => true
      _ => false
    },
    "a plan with a different script is rejected",
  )
  Buffer.reset(&mut buffer)
  run Testing.expect(
    buffer.flags == 0 && buffer.clusterLevel == ClusterLevel.MonotoneGraphemes
      && GlyphId.toU32(
        Buffer.getInvisibleGlyph(&buffer) |> Option<GlyphId>.unwrapOr(GlyphId.new(0)),
      )
        == 0,
    "reset also resets buffer configuration",
  )
  let requiredSource = match move FontRef.new(Fixtures.requiredFont()) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "required-feature fixture")
      return
    }
  }
  let requiredData = ShaperData.new(&requiredSource)
  let requiredFont = ShaperData.shaper(&requiredData)
  Buffer.reset(&mut buffer)
  run Buffer.pushStr(&mut buffer, "AB")
  Buffer.guessSegmentProperties(&mut buffer)
  let disabled = [Feature.new(Tag.fromU32(0x74657374), 0)]
  let requiredPlan = run ShapePlan.new(&requiredFont, &buffer, &disabled)
  run Testing.expect(
    List<LookupStep>.get(&requiredPlan.substitutions.steps, 0).stage == 0,
    "an otherwise disabled required feature runs in the first stage",
  )
  drop run shape(&requiredFont, &mut buffer, ShapeOptions.forFeatures(&disabled))
  run Testing.expect(
    Buffer.len(&buffer) == 1,
    "required features cannot be disabled by user feature settings",
  )
}

test effect fn reusablePlansAndBufferLifecycle() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run planCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
