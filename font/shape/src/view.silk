//! Checked, table-relative reads. Invalid offsets yield an empty view.
import read_fonts.lib { FontData, ReadError }
import read_fonts.tables.layout { CoverageTable, ClassDef }
import font_types.lib { GlyphId }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub struct View<'a> {
  pub data: FontData<'a>,
}

impl<'a> Copy for View<'a> {}

impl<'a> View<'a> {
  pub fn bytes(data: &'a [u8]) -> Self {
    return Self { data: FontData.new(data) }
  }

  pub fn new(data: FontData<'a>) -> Self {
    return Self { data: data }
  }

  pub fn empty() -> Self {
    return View.new(FontData.new(b""))
  }

  pub fn len(self: &Self) -> usize {
    return FontData.len(&self.data)
  }

  pub fn u8(self: &Self, at: usize) -> u8 with Intrinsic.inlineAlways() {
    let bytes = FontData.asBytes(&self.data)
    if at >= bytes.length {
      return 0
    }
    return bytes[at]
  }

  // Big-endian reads decode the bytes in place. These run on every coverage, class and
  // lookup probe, so they skip FontData.readAt and its Result.
  pub fn u16(self: &Self, at: usize) -> u16 with Intrinsic.inlineAlways() {
    let bytes = FontData.asBytes(&self.data)
    if at >= bytes.length || bytes.length - at < 2 {
      return 0
    }
    return u16.shiftLeft(u8.toU16(bytes[at]), 8) | u8.toU16(bytes[at + 1])
  }

  pub fn uint(self: &Self, at: usize, width: usize) -> u32 with Intrinsic.inlineAlways() {
    if width == 2 {
      return u16.toU32(View.u16(self, at))
    }
    if width == 4 {
      return View.u32(self, at)
    }
    let bytes = FontData.asBytes(&self.data)
    if width != 3 || at >= bytes.length || bytes.length - at < 3 {
      return 0
    }
    return u32.shiftLeft(u8.toU32(bytes[at]), 16) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8)
      | u8.toU32(bytes[at + 2])
  }

  pub fn offset(self: &Self, at: usize, width: usize) -> Self with Intrinsic.inlineAlways() {
    let value = View.uint(self, at, width)
    if value == 0 {
      return View.empty()
    }
    return View.tail(self, u32.toUsize(value))
  }

  // Version 1.2's optional 32-bit lists override the original 16-bit lists.
  pub fn layoutList(self: &Self, index: usize) -> Self {
    if View.u16(self, 0) == 1 && View.u16(self, 2) >= 2 && View.u32(self, 14 + index * 4) != 0 {
      return View.offset32(self, 14 + index * 4)
    }
    return View.offset16(self, 4 + index * 2)
  }

  pub fn i16(self: &Self, at: usize) -> i16 {
    return FontData<'a>.readAt<i16>(&self.data, at) |> Result<i16, ReadError>.unwrapOr(0)
  }

  pub fn u32(self: &Self, at: usize) -> u32 with Intrinsic.inlineAlways() {
    let bytes = FontData.asBytes(&self.data)
    if at >= bytes.length || bytes.length - at < 4 {
      return 0
    }
    return u32.shiftLeft(u8.toU32(bytes[at]), 24) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 16)
      | u32.shiftLeft(u8.toU32(bytes[at + 2]), 8)
      | u8.toU32(bytes[at + 3])
  }

  pub fn i32(self: &Self, at: usize) -> i32 {
    return FontData<'a>.readAt<i32>(&self.data, at) |> Result<i32, ReadError>.unwrapOr(0)
  }

  pub fn range(self: &Self, start: usize, end: usize) -> Self {
    return View.new(
      FontData.slice(&self.data, start, end) |> Option<FontData<'a>>.unwrapOr(FontData.new(b"")),
    )
  }

  /// Optional GDEF 1.4 offsets override the original class/attachment lists.
  pub fn gdefVarStore(self: &Self) -> Self {
    if View.u16(self, 0) != 1 || View.u16(self, 2) < 3 {
      return View.empty()
    }
    return View.offset32(self, 14)
  }

  pub fn gdefList(self: &Self, index: usize) -> Self {
    if View.u16(self, 0) == 1 && View.u16(self, 2) >= 4 && View.u32(self, 18 + index * 4) != 0 {
      return View.offset32(self, 18 + index * 4)
    }
    if index == 4 && View.u16(self, 2) < 2 {
      return View.empty()
    }
    return View.offset16(self, 4 + index * 2)
  }

  // Offsets are followed for every rule and subtable probe, so tail slices the bytes directly
  // instead of going through FontData.slice and its Option.
  pub fn tail(self: &Self, at: usize) -> Self with Intrinsic.inlineAlways() {
    let bytes = FontData.asBytes(&self.data)
    if at > bytes.length {
      return View.empty()
    }
    return View.bytes(Slice.view<u8>(bytes, at, bytes.length - at))
  }

  pub fn offset16(self: &Self, at: usize) -> Self with Intrinsic.inlineAlways() {
    let offset = View.u16(self, at)
    if offset == 0 {
      return View.empty()
    }
    return View.tail(self, u16.toUsize(offset))
  }

  pub fn offset32(self: &Self, at: usize) -> Self {
    let offset = View.u32(self, at)
    if offset == 0 {
      return View.empty()
    }
    return View.tail(self, u32.toUsize(offset))
  }

  pub fn coverage(self: &Self, glyph: u32) -> Option<u32> {
    let bytes = FontData.asBytes(&self.data)
    if bytes.length < 4 {
      return Option<u32>.None
    }
    let format = be16(bytes, 0)

    // 16-bit formats, which nearly every font uses, search the bytes directly. Counts are
    // at most 65535, so the index arithmetic below cannot overflow.
    if format == 1 {
      let count = u16.toUsize(be16(bytes, 2))
      if count > (bytes.length - 4) / 2 {
        return Option<u32>.None
      }
      let mut lo: usize = 0
      let mut hi = count
      while lo < hi {
        let mid = usize.wrappingAdd(lo, hi) / 2
        let start = u16.toU32(be16(bytes, usize.wrappingAdd(4, usize.wrappingMultiply(mid, 2))))
        if glyph < start {
          hi = mid
        } else if glyph == start {
          return Option<u32>.some(usize.toU32(mid))
        } else {
          lo = mid + 1
        }
      }
      return Option<u32>.None
    }
    if format == 2 {
      let count = u16.toUsize(be16(bytes, 2))
      if count > (bytes.length - 4) / 6 {
        return Option<u32>.None
      }
      let mut lo: usize = 0
      let mut hi = count
      while lo < hi {
        let mid = usize.wrappingAdd(lo, hi) / 2
        let at = usize.wrappingAdd(4, usize.wrappingMultiply(mid, 6))
        let start = u16.toU32(be16(bytes, at))
        if glyph < start {
          hi = mid
        } else if glyph <= u16.toU32(be16(bytes, at + 2)) {
          return Option<u32>.some(u16.toU32(be16(bytes, at + 4)) + glyph - start)
        } else {
          lo = mid + 1
        }
      }
      return Option<u32>.None
    }
    if format < 1 || format > 4 {
      return Option<u32>.None
    }
    let mut width: usize = 2
    if format >= 3 {
      width = 3
    }
    let header = 2 + width
    let count = u32.toUsize(View.uint(self, 2, width))
    let mut stride = width
    if format == 2 || format == 4 {
      stride = width * 3
    }
    if header > View.len(self) || count > (View.len(self) - header) / stride {
      return Option<u32>.None
    }
    let mut lo: usize = 0
    let mut hi = count
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let at = header + mid * stride
      let start = View.uint(self, at, width)
      if glyph < start {
        hi = mid
      } else {
        if stride == width {
          if glyph == start {
            return Option<u32>.some(usize.toU32(mid))
          }
        } else if glyph <= View.uint(self, at + width, width) {
          return Option<u32>.some(View.uint(self, at + width * 2, width) + glyph - start)
        }
        lo = mid + 1
      }
    }
    return Option<u32>.None
  }

  pub fn class(self: &Self, glyph: u32) -> u32 {
    let format = View.u16(self, 0)
    if format < 1 || format > 4 {
      return 0
    }
    let mut width: usize = 2
    if format >= 3 {
      width = 3
    }
    if format == 1 || format == 3 {
      let start = View.uint(self, 2, width)
      let count = View.uint(self, 2 + width, width)
      if glyph < start || glyph - start >= count {
        return 0
      }
      let header = 2 + width * 2
      if header > View.len(self) || u32.toUsize(count) > (View.len(self) - header) / width {
        return 0
      }
      return View.uint(self, header + u32.toUsize(glyph - start) * width, width)
    }
    let header = 2 + width
    let stride = width * 2 + 2
    let count = u32.toUsize(View.uint(self, 2, width))
    if header > View.len(self) || count > (View.len(self) - header) / stride {
      return 0
    }
    let mut lo: usize = 0
    let mut hi = count
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let at = header + mid * stride
      let start = View.uint(self, at, width)
      if glyph < start {
        hi = mid
      } else {
        if glyph <= View.uint(self, at + width, width) {
          return u16.toU32(View.u16(self, at + width * 2))
        }
        lo = mid + 1
      }
    }
    return 0
  }
}

/// A big-endian u16 at `at`; the caller has checked that two bytes are there.
fn be16(bytes: &[u8], at: usize) -> u16 with Intrinsic.inlineAlways() {
  return u16.shiftLeft(u8.toU16(bytes[at]), 8) | u8.toU16(bytes[at + 1])
}

/// A big-endian u16 at `at` as a usize, or 0 past the end, like `View.u16`.
/// Bytes in a value record: two per bit set in the low byte of its format. The bits are
/// counted in parallel, since this runs for every pair adjustment.
pub fn valueSize(format: u16) -> usize with Intrinsic.inline() {
  let bits = format & 255
  let pairs = bits - ((bits / 2) & 0x55)
  let nibbles = (pairs & 0x33) + ((pairs / 4) & 0x33)
  return u16.toUsize((nibbles + nibbles / 16) & 15) * 2
}

pub fn read16(bytes: &[u8], at: usize) -> usize with Intrinsic.inlineAlways() {
  if at >= bytes.length || bytes.length - at < 2 {
    return 0
  }
  return u8.toUsize(bytes[at]) * 256 + u8.toUsize(bytes[at + 1])
}

pub fn offset(base: usize, index: usize, size: usize) -> usize with Intrinsic.inlineAlways() {
  return usize.saturatingAdd(base, usize.saturatingMultiply(index, size))
}
