//! HarfBuzz fixed-point metric rounding, including deliberately negative scales.
import read_fonts.model.metrics { Scale as MetricScale }
import read_fonts.model.metrics.extents { GlyphExtents }
import font_types.lib { F48Dot16 }
import silk.geometry.rect { Rect }
import silk.num.f64
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.i64
import silk.num.f32

pub struct Scale {
  xMult: i64,
  yMult: i64,
  xfMult: f32,
  yfMult: f32,
}

impl Copy for Scale {}

impl Scale {
  pub fn same(self: &Self, other: &Self) -> bool {
    return self.xMult == other.xMult && self.yMult == other.yMult && self.xfMult == other.xfMult
      && self.yfMult == other.yfMult
  }

  /// Whether `xf` and `yf` leave whole values unchanged.
  pub fn isUnit(self: &Self) -> bool {
    return self.xfMult == 1.0 && self.yfMult == 1.0
  }

  pub fn identity() -> Self {
    return Self { xMult: 65536, yMult: 65536, xfMult: 1.0, yfMult: 1.0 }
  }

  pub fn new(x: i32, y: i32, upem: i32) -> Self {
    if upem == 0 {
      return Scale.identity()
    }
    return Self {
      xMult: i32.toI64(x) * 65536 / i32.toI64(upem),
      yMult: i32.toI64(y) * 65536 / i32.toI64(upem),
      xfMult: i32.toF32(x) / i32.toF32(upem),
      yfMult: i32.toF32(y) / i32.toF32(upem),
    }
  }

  pub fn x(self: &Self, value: i32) -> i32 {
    return clamp(
      i64.shiftRight(
        i64.saturatingAdd(i64.saturatingMultiply(i32.toI64(value), self.xMult), 32768),
        16,
      ),
    )
  }

  pub fn y(self: &Self, value: i32) -> i32 {
    return clamp(
      i64.shiftRight(
        i64.saturatingAdd(i64.saturatingMultiply(i32.toI64(value), self.yMult), 32768),
        16,
      ),
    )
  }

  pub fn clampXAdvance(self: &Self, value: i32) -> i32 {
    if (self.xfMult < 0.0 && value > 0) || (self.xfMult >= 0.0 && value < 0) {
      return 0
    }
    return value
  }

  pub fn clampYAdvance(self: &Self, value: i32) -> i32 {
    if (self.yfMult < 0.0 && value > 0) || (self.yfMult >= 0.0 && value < 0) {
      return 0
    }
    return value
  }

  pub fn xf(self: &Self, value: f32) -> i32 {
    return rounded(value * self.xfMult)
  }

  pub fn yf(self: &Self, value: f32) -> i32 {
    return rounded(value * self.yfMult)
  }
}

pub fn clamp(value: i64) -> i32 {
  if value > 2147483647 {
    return 2147483647
  }
  if value < -2147483648 {
    return -2147483648
  }
  return i64.toI32(value)
}

pub fn rounded(value: f32) -> i32 {
  if value >= 2147483647.0 {
    return 2147483647
  }
  if value <= -2147483648.0 {
    return -2147483648
  }
  if value != value {
    return 0
  }
  if value < 0.0 {
    return f32.toI32(value - 0.5)
  }
  return f32.toI32(value + 0.5)
}

pub fn add(a: i32, b: i32) -> i32 {
  return clamp(i32.toI64(a) + i32.toI64(b))
}

pub fn sub(a: i32, b: i32) -> i32 {
  return clamp(i32.toI64(a) - i32.toI64(b))
}

impl MetricScale<i32> for Scale {
  fn add(a: i32, b: i32) -> i32 {
    return clamp(i32.toI64(a) + i32.toI64(b))
  }

  fn sub(a: i32, b: i32) -> i32 {
    return clamp(i32.toI64(a) - i32.toI64(b))
  }

  fn half(value: i32) -> i32 {
    return i32.shiftRight(value, 1)
  }

  fn scaleX(self: &Self, value: F48Dot16) -> i32 {
    if (F48Dot16.toBits(value) & 65535) == 0 {
      return Scale.x(self, F48Dot16.toI32(value))
    }
    return Scale.xf(self, F48Dot16.toF32(value))
  }

  fn scaleY(self: &Self, value: F48Dot16) -> i32 {
    if (F48Dot16.toBits(value) & 65535) == 0 {
      return Scale.y(self, F48Dot16.toI32(value))
    }
    return Scale.yf(self, F48Dot16.toF32(value))
  }

  fn scaleGlyphExtents(self: &Self, value: GlyphExtents<F48Dot16>) -> GlyphExtents<i32> {
    let left = f32.floor(F48Dot16.toF32(value.xBearing) * self.xfMult)
    let top = f32.floor(F48Dot16.toF32(value.yBearing) * self.yfMult)
    let right = f32.ceil(F48Dot16.toF32(value.xBearing + value.width) * self.xfMult)
    let bottom = f32.ceil(F48Dot16.toF32(value.yBearing - value.height) * self.yfMult)
    return GlyphExtents<i32> {
      xBearing: fromDouble(f32.toF64(left)),
      yBearing: fromDouble(f32.toF64(top)),
      width: fromDouble(f32.toF64(right) - f32.toF64(left)),
      height: fromDouble(f32.toF64(top) - f32.toF64(bottom)),
    }
  }

  fn scaleRect(self: &Self, value: Rect<F48Dot16>) -> Rect<i32> {
    return Rect<i32> {
      xMin: Scale.xf(self, F48Dot16.toF32(value.xMin)),
      yMin: Scale.yf(self, F48Dot16.toF32(value.yMin)),
      xMax: Scale.xf(self, F48Dot16.toF32(value.xMax)),
      yMax: Scale.yf(self, F48Dot16.toF32(value.yMax)),
    }
  }
}

fn fromDouble(value: f64) -> i32 {
  if value >= 2147483647.0 {
    return 2147483647
  }
  if value <= -2147483648.0 {
    return -2147483648
  }
  if value != value {
    return 0
  }
  return f64.toI32(value)
}
