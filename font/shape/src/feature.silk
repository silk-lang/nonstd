import direction { ParseError }
import font_types.lib { Tag, InvalidTag }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.u8
import silk.num.u32
import silk.num.i64

pub struct Feature {
  pub tag: Tag,
  pub value: u32,
  pub start: u32,
  pub end: u32,
}

impl Copy for Feature {}

impl Feature {
  pub fn new(tag: Tag, value: u32) -> Self {
    return Self { tag: tag, value: value, start: 0, end: 4294967295 }
  }

  pub fn ranged(tag: Tag, value: u32, start: u32, end: u32) -> Self {
    return Self { tag: tag, value: value, start: start, end: end }
  }

  pub fn isGlobal(self: &Self) -> bool {
    return self.start == 0 && self.end == 4294967295
  }

  pub fn parse(input: string) -> Result<Self, ParseError> {
    let text = String.trim(input)
    let raw = String.utf8Bytes(text)
    let mut pos: usize = 0
    let mut value: u32 = 1
    if raw.length > 0 && (raw[0] == 43 || raw[0] == 45) {
      if raw[0] == 45 {
        value = 0
      }
      pos = 1
    }
    spaces(raw, &mut pos)
    let mut quote: u8 = 0
    if pos < raw.length && (raw[pos] == 39 || raw[pos] == 34) {
      quote = raw[pos]
      pos = pos + 1
    }
    let startTag = pos
    while pos < raw.length
      && ((raw[pos] >= 65 && raw[pos] <= 90) || (raw[pos] >= 97 && raw[pos] <= 122)
        || (raw[pos] >= 48 && raw[pos] <= 57)
        || raw[pos] == 95) {
      pos = pos + 1
    }
    let tag = match move Tag.newChecked(
      String.utf8Bytes(String.slice(text, startTag, pos - startTag)),
    ) {
      Result<Tag, InvalidTag>.Success { value: parsed } => parsed
      _ => {
        return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
      }
    }
    if quote != 0 {
      if pos >= raw.length || raw[pos] != quote {
        return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
      }
      pos = pos + 1
    }
    spaces(raw, &mut pos)
    let mut first: u32 = 0
    let mut last: u32 = 4294967295
    if pos < raw.length && raw[pos] == 91 {
      pos = pos + 1
      let before = pos
      first = number(raw, &mut pos, 0)
      let hadFirst = before != pos
      spaces(raw, &mut pos)
      if pos < raw.length && (raw[pos] == 58 || raw[pos] == 59) {
        pos = pos + 1
        last = number(raw, &mut pos, 4294967295)
      } else if hadFirst && first != 4294967295 {
        last = first + 1
      }
      spaces(raw, &mut pos)
      if pos >= raw.length || raw[pos] != 93 {
        return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
      }
      pos = pos + 1
    }
    spaces(raw, &mut pos)
    let mut equal = false
    if pos < raw.length && raw[pos] == 61 {
      equal = true
      pos = pos + 1
    }
    spaces(raw, &mut pos)
    if pos < raw.length {
      if pos + 2 <= raw.length && (raw[pos] | 32) == 111 && (raw[pos + 1] | 32) == 110 {
        value = 1
        pos = pos + 2
      } else if pos + 3 <= raw.length && (raw[pos] | 32) == 111 && (raw[pos + 1] | 32) == 102
        && (raw[pos + 2] | 32) == 102 {
        value = 0
        pos = pos + 3
      } else {
        let before = pos
        value = number(raw, &mut pos, value)
        if before == pos {
          return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
        }
      }
    } else if equal {
      return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
    }
    spaces(raw, &mut pos)
    if pos != raw.length {
      return Result<Self, ParseError>.failResult(ParseError.InvalidSetting)
    }
    return Result<Self, ParseError>.succeed(Feature.ranged(tag, value, first, last))
  }
}

fn spaces(raw: &[u8], pos: &mut usize) -> () {
  while pos.* < raw.length && raw[pos.*] == 32 {
    pos.* = pos.* + 1
  }
}

fn number(raw: &[u8], pos: &mut usize, default: u32) -> u32 {
  spaces(raw, &mut pos)
  let old = pos.*
  let mut negative = false
  if pos.* < raw.length && raw[pos.*] == 45 {
    negative = true
    pos.* = pos.* + 1
  }
  let begin = pos.*
  let mut value: i64 = 0
  while pos.* < raw.length && raw[pos.*] >= 48 && raw[pos.*] <= 57 {
    value = value * 10 + u8.toI64(raw[pos.*] - 48)
    if value > 2147483648 {
      pos.* = old
      return default
    }
    pos.* = pos.* + 1
  }
  if begin == pos.* || (!negative && value > 2147483647) {
    pos.* = old
    return default
  }
  if negative {
    value = -value
  }
  if value < 0 {
    return 4294967295 - i64.toU32(-value - 1)
  }
  return i64.toU32(value)
}
