//! BCP 47 to OpenType language-system candidates, including private-use tags.
import generated_languages as Data
import view { View }
import silk.core.ownership { Copy }
import silk.text.string { String, InvalidUtf8 }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import font_types.lib { Tag }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Owned, normalized BCP 47 bytes. Invalid UTF-8 is retained by asBytes.
pub struct Language {
  bytes: List<u8>,
}

impl Language {
  pub fn empty() -> Self {
    return Self { bytes: List<u8>.make() }
  }

  /// Makes the language empty, keeping its storage for reuse.
  pub fn clear(self: &mut Self) -> () {
    List<u8>.clear(&mut self.bytes)
  }

  pub effect fn new(bytes: &[u8]) -> Option<Self>
    ! OutOfMemoryError
    ? &mut Allocator {
    if bytes.length == 0 {
      return Option<Self>.None
    }
    let mut result = Language.empty()
    let mut i: usize = 0
    while i < bytes.length {
      let mut b = bytes[i]
      if b >= 65 && b <= 90 {
        b = b + 32
      } else if b == 95 {
        b = 45
      }
      run List<u8>.append(&mut result.bytes, b)
      i = i + 1
    }
    return Option<Self>.some(move result)
  }

  pub effect fn parse(text: string) -> Option<Self>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run Language.new(String.utf8Bytes(text))
  }

  pub fn asBytes(self: &Self) -> &[u8] {
    return List<u8>.asSlice(&self.bytes)
  }

  pub fn asString(self: &Self) -> string {
    return String.fromUtf8(Language.asBytes(self)) |> Result<string, InvalidUtf8>.unwrapOr("")
  }

  pub fn isEmpty(self: &Self) -> bool {
    return List<u8>.length(&self.bytes) == 0
  }
}

pub struct LanguageTags {
  pub values: [u32; 3],
  pub length: usize,
}

impl Copy for LanguageTags {}

impl LanguageTags {
  pub fn new() -> Self {
    return Self { values: [0; 3], length: 0 }
  }

  pub effect fn parse(text: string) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = run Language.parse(text)
    return match &value {
      Option<Language>.Some { value: language } => LanguageTags.fromLanguage(&language)
      _ => LanguageTags.new()
    }
  }

  pub fn asSlice(self: &Self) -> &[u32] {
    return Slice.view(&self.values, 0, self.length)
  }

  pub fn fromLanguage(language: &Language) -> Self {
    let bytes = Language.asBytes(language)
    let mut tags = LanguageTags.new()
    if bytes.length == 0 {
      return tags
    }
    if let Option<u32>.Some { value: private } = privateTag(bytes, "-hbot", true) {
      add(&mut tags, private)
      return tags
    }
    let mut end = bytes.length
    if bytes.length >= 2 && bytes[0] == 120 && bytes[1] == 45 {
      end = 0
    } else {
      let mut i: usize = 1
      while i + 1 < bytes.length {
        if bytes[i - 1] == 45 && bytes[i + 1] == 45 {
          if bytes[i] == 120 {
            if end == bytes.length {
              end = i - 1
            }
            break
          }
          end = i - 1
        }
        i = i + 1
      }
    }
    if end == 0 {
      return tags
    }
    let prefix = Slice.view(bytes, 0, end)
    if let Result<string, InvalidUtf8>.Success { value } = String.fromUtf8(prefix) {
      if Data.complex(value, &mut tags) {
        return tags
      }
    }
    let mut first: usize = 0
    let mut length: usize = 0
    while length < prefix.length && prefix[length] != 45 && prefix[length] != 0 {
      length = length + 1
    }
    if prefix.length >= 6 && length < prefix.length {
      let at = length + 1
      let mut n: usize = 0
      while at + n < prefix.length && prefix[at + n] != 45 {
        n = n + 1
      }
      if n == 3
        && ((prefix[at] >= 97 && prefix[at] <= 122) || (prefix[at] >= 65 && prefix[at] <= 90)) {
        first = at
        length = 3
      }
    }
    if length > 4 {
      return tags
    }
    let mut key: u32 = 0
    let mut i: usize = 0
    while i < 4 {
      key = key * 256
      if i < length {
        key = key + u8.toU32(prefix[first + i])
      }
      i = i + 1
    }
    let data = View.bytes(Data.languages())
    let mut lo: usize = 0
    let mut hi = View.len(&data) / 8
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if View.u32(&data, mid * 8) < key {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    let mut found = false
    while lo * 8 < View.len(&data) && View.u32(&data, lo * 8) == key {
      found = true
      let tag = View.u32(&data, lo * 8 + 4)
      if tag == 0 {
        return tags
      }
      add(&mut tags, tag)
      lo = lo + 1
    }
    if !found && prefix.length == 3 {
      add(&mut tags, (key & 0xdfdfdf00) | 32)
    }
    return tags
  }
}

pub fn add(tags: &mut LanguageTags, tag: u32) -> () {
  if tags.length < 3 {
    tags.values[tags.length] = tag
    tags.length = tags.length + 1
  }
}

pub fn langMatches(value: string, prefix: string) -> bool {
  return value == prefix
    || (String.startsWith(value, prefix) && String.byteLength(value) > String.byteLength(prefix)
      && String.utf8Bytes(value)[String.byteLength(prefix)] == 45)
}

pub fn subtagMatches(value: string, subtag: string) -> bool {
  let bytes = String.utf8Bytes(value)
  let needle = String.utf8Bytes(subtag)
  let mut i: usize = 0
  while i <= bytes.length && needle.length <= bytes.length - i {
    let mut n: usize = 0
    while n < needle.length && bytes[i + n] == needle[n] {
      n = n + 1
    }
    if n == needle.length && (i + n == bytes.length || !alphanumeric(bytes[i + n])) {
      return true
    }
    i = i + 1
  }
  return false
}

pub fn strncmp(a: string, b: string, n: usize) -> bool {
  let mut x = n
  let mut y = n
  if x > String.byteLength(a) {
    x = String.byteLength(a)
  }
  if y > String.byteLength(b) {
    y = String.byteLength(b)
  }
  return String.slice(a, 0, x) == String.slice(b, 0, y)
}

fn alphanumeric(c: u8) -> bool {
  return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
}

pub fn privateTag(bytes: &[u8], prefix: string, uppercase: bool) -> Option<u32> {
  let mut start = bytes.length
  if bytes.length >= 2 && bytes[0] == 120 && bytes[1] == 45 {
    start = 0
  } else {
    let mut i: usize = 1
    while i + 1 < bytes.length {
      if bytes[i - 1] == 45 && bytes[i] == 120 && bytes[i + 1] == 45 {
        start = i
        break
      }
      i = i + 1
    }
  }
  let needle = String.utf8Bytes(prefix)
  while start < bytes.length {
    if needle.length <= bytes.length - start {
      let mut n: usize = 0
      while n < needle.length && needle[n] == bytes[start + n] {
        n = n + 1
      }
      if n == needle.length {
        start = start + n
        break
      }
    }
    start = start + 1
  }
  if start >= bytes.length {
    return Option<u32>.None
  }
  let mut result: u32 = 0
  let mut i: usize = 0
  if bytes[start] == 45 {
    if bytes.length - start < 9 {
      return Option<u32>.None
    }
    while i < 8 {
      let c = bytes[start + 1 + i] | 32
      let mut digit: u8 = 255
      if c >= 48 && c <= 57 {
        digit = c - 48
      } else if c >= 97 && c <= 102 {
        digit = c - 87
      }
      if digit == 255 {
        return Option<u32>.None
      }
      result = result * 16 + u8.toU32(digit)
      i = i + 1
    }
  } else {
    let mut stopped = false
    while i < 4 {
      let mut c: u8 = 32
      if !stopped && start + i < bytes.length && alphanumeric(bytes[start + i]) {
        c = bytes[start + i]
        if uppercase && c >= 97 && c <= 122 {
          c = c - 32
        } else if !uppercase && c >= 65 && c <= 90 {
          c = c + 32
        }
      } else {
        if i == 0 {
          return Option<u32>.None
        }
        stopped = true
      }
      result = result * 256 + u8.toU32(c)
      i = i + 1
    }
  }
  if (result & 0xdfdfdfdf) == 0x44464c54 {
    result = result ^ 0x20202020
  }
  return Option<u32>.some(result)
}

impl Language {
  pub effect fn fromTag(tag: Tag) -> Option<Self>
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = Tag.toU32(tag)
    if value == 0x64666c74 {
      return Option<Self>.None
    }
    let data = View.bytes(Data.reverseLanguages())
    let names = View.bytes(Data.reverseNames())
    let mut lo: usize = 0
    let mut hi = View.len(&data) / 8
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if View.u32(&data, mid * 8) < value {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo * 8 < View.len(&data) && View.u32(&data, lo * 8) == value {
      let at = u32.toUsize(View.u32(&data, lo * 8 + 4))
      let bytes = Data.reverseNames()
      return run Language.new(Slice.view(bytes, at + 1, u8.toUsize(View.u8(&names, at))))
    }
    let mut text = String.make()
    let bytes = [
      u32.toU8(u32.shiftRight(value, 24)),
      u32.toU8(u32.shiftRight(value, 16) & 255),
      u32.toU8(u32.shiftRight(value, 8) & 255),
      u32.toU8(value & 255),
    ]
    let mut alpha = bytes[3] == 32
    let mut i: usize = 0
    while i < 3 {
      let c = bytes[i] | 32
      if c < 97 || c > 122 {
        alpha = false
      }
      i = i + 1
    }
    if alpha {
      let lower = [bytes[0] | 32, bytes[1] | 32, bytes[2] | 32, 45]
      run String.append(
        &mut text,
        String.fromUtf8(&lower) |> Result<string, InvalidUtf8>.unwrapOr(""),
      )
    }
    run String.append(&mut text, "x-hbot-")
    let digits = b"0123456789abcdef"
    i = 0
    while i < 4 {
      let hex = [digits[u8.toUsize(bytes[i] / 16)], digits[u8.toUsize(bytes[i] & 15)]]
      run String.append(
        &mut text,
        String.fromUtf8(&hex) |> Result<string, InvalidUtf8>.unwrapOr(""),
      )
      i = i + 1
    }
    return run Language.parse(String.view(&text))
  }
}
