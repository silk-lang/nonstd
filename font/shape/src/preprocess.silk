//! Hangul syllable composition and Thai/Lao character preprocessing.
import buffer { Buffer, Glyph, ClusterLevel }
import font { ConfiguredShaper, FontFuncs, Shaper, ShaperData }
import complex { moveGlyph }
import view { View }
import generated_unicode as data
import unicode
import read_fonts.model.metrics.glyph { GlyphMetrics }
import font_types.lib { GlyphId, F2Dot14 }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silk.num.u8

pub effect fn apply<F: FontFuncs>(font: &ConfiguredShaper<F>, buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if buffer.script == 0x54686169 || buffer.script == 0x4c616f6f {
    run thai(font, &mut buffer)
  }
  if buffer.script == 0x48616e67 {
    run hangul(font, &mut buffer)
  }
}

fn above(cp: u32) -> bool {
  let u = cp & 4294967167
  return (u >= 0x0e34 && u <= 0x0e37) || (u >= 0x0e47 && u <= 0x0e4e) || u == 0x0e31 || u == 0x0e3b
}

effect fn thai<F: FontFuncs>(font: &ConfiguredShaper<F>, buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    let item = List<Glyph>.get(&buffer.glyphs, i)
    if (item.codepoint & 4294967167) == 0x0e33 {
      let mut nikhahit = Glyph.new(item.codepoint + 26, item.info.cluster)
      nikhahit.combiningClass = 0
      let aa = Glyph.new(item.codepoint - 1, item.info.cluster)
      List<Glyph>.set(&mut buffer.glyphs, i, nikhahit)
      run List<Glyph>.insert(&mut buffer.glyphs, i + 1, aa)
      let mut start = i
      while start > 0 && above(List<Glyph>.get(&buffer.glyphs, start - 1).codepoint) {
        start = start - 1
      }
      if start < i {
        Buffer.mergeClusters(&mut buffer, start, i + 2)
        moveGlyph(&mut buffer, i, start)
      }
      if start > 0 && ClusterLevel.isGraphemes(buffer.clusterLevel) {
        Buffer.mergeGraphemeClusters(&mut buffer, start - 1, i + 2)
      }
      i = i + 1
    }
    i = i + 1
  }
  if buffer.script != 0x54686169 {
    return
  }
  let scripts = View.offset16(&font.data.gsub, 4)
  i = 0
  while i < u16.toUsize(View.u16(&scripts, 0)) {
    if View.u32(&scripts, 2 + i * 6) == 0x74686169 {
      return
    }
    i = i + 1
  }
  let transitions = data.thaiStates()
  let mappings = View.bytes(data.thaiMappings())
  let mut aboveState: usize = 3
  let mut belowState: usize = 2
  let mut base: usize = 0
  i = 0
  while i < Buffer.len(&buffer.*) {
    let cp = List<Glyph>.get(&buffer.glyphs, i).codepoint
    let mut mark: usize = 3
    if cp == 0x0e31 || (cp >= 0x0e34 && cp <= 0x0e37) || cp == 0x0e47
      || (cp >= 0x0e4d && cp <= 0x0e4e) {
      mark = 0
    }
    if cp >= 0x0e38 && cp <= 0x0e3a {
      mark = 1
    }
    if cp >= 0x0e48 && cp <= 0x0e4c {
      mark = 2
    }
    if mark == 3 {
      aboveState = 0
      belowState = 0
      if cp == 0x0e1b || cp == 0x0e1d || cp == 0x0e1f {
        aboveState = 1
      } else if cp == 0x0e0d || cp == 0x0e10 {
        belowState = 1
      } else if cp == 0x0e0e || cp == 0x0e0f {
        belowState = 2
      } else if cp < 0x0e01 || cp > 0x0e2e {
        aboveState = 3
        belowState = 2
      }
      base = i
      i = i + 1
      continue
    }
    let edge = (aboveState * 3 + mark) * 2
    let below = 24 + (belowState * 3 + mark) * 2
    let mut action = transitions[edge]
    aboveState = u8.toUsize(transitions[edge + 1])
    if action == 0 {
      action = transitions[below]
    }
    belowState = u8.toUsize(transitions[below + 1])
    Buffer.unsafeToBreak(&mut buffer, base, i)
    let mut target = i
    if action == 4 {
      target = base
    }
    let mut item = List<Glyph>.get(&buffer.glyphs, target)
    let mut p: usize = 0
    while p + 8 <= View.len(&mappings) {
      if View.u16(&mappings, p) == u8.toU16(action)
        && u16.toU32(View.u16(&mappings, p + 2)) == item.codepoint {
        let win = u16.toU32(View.u16(&mappings, p + 4))
        let mac = u16.toU32(View.u16(&mappings, p + 6))
        if ConfiguredShaper.hasGlyph(font, win) {
          item.codepoint = win
        } else if ConfiguredShaper.hasGlyph(font, mac) {
          item.codepoint = mac
        }
        List<Glyph>.set(&mut buffer.glyphs, target, item)
        break
      }
      p = p + 8
    }
    i = i + 1
  }
}

fn isL(u: u32) -> bool {
  return (u >= 0x1100 && u <= 0x115f) || (u >= 0xa960 && u <= 0xa97c)
}

fn isV(u: u32) -> bool {
  return (u >= 0x1160 && u <= 0x11a7) || (u >= 0xd7b0 && u <= 0xd7c6)
}

fn isT(u: u32) -> bool {
  return (u >= 0x11a8 && u <= 0x11ff) || (u >= 0xd7cb && u <= 0xd7fb)
}

pub fn isJamo(u: u32) -> bool {
  return isL(u) || isV(u) || isT(u)
}

fn zero<F: FontFuncs>(font: &ConfiguredShaper<F>, u: u32) -> bool {
  let g = ConfiguredShaper.glyphFor(font, u)
  return ConfiguredShaper.mappedGlyphExists(font, u, g)
    && ConfiguredShaper.glyphHAdvance(font, GlyphId.new(g)) == 0
}

fn combine(buffer: &mut Buffer, at: usize, count: usize, cp: u32) -> () {
  Buffer.mergeClusters(&mut buffer, at, at + count)
  let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
  slots[at].codepoint = cp
  let mut n: usize = 1
  while n < count {
    drop List<Glyph>.remove(&mut buffer.glyphs, at + 1)
    n = n + 1
  }
}

fn jamo(buffer: &mut Buffer, start: usize, end: usize) -> () {
  let tags: [u32; 3] = [0x6c6a6d6f, 0x766a6d6f, 0x746a6d6f]
  let mut i = start
  while i < end && i - start < 3 {
    let updated = tags[i - start]
    let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
    slots[i].form = updated
    i = i + 1
  }
  if ClusterLevel.isGraphemes(buffer.clusterLevel) {
    Buffer.mergeGraphemeClusters(&mut buffer, start, end)
  }
}

effect fn hangul<F: FontFuncs>(font: &ConfiguredShaper<F>, buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut start: usize = 0
  let mut end: usize = 0
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    let item = List<Glyph>.get(&buffer.glyphs, i)
    let u = item.codepoint
    if u == 0x302e || u == 0x302f {
      if start < end && end == i {
        Buffer.unsafeToBreak(&mut buffer, start, i)
        if !zero(font, u) {
          Buffer.mergeClusters(&mut buffer, start, i + 1)
          moveGlyph(&mut buffer, i, start)
        }
      } else if (buffer.flags & 16) == 0 && ConfiguredShaper.hasGlyph(font, 0x25cc) {
        let mut at = i + 1
        if zero(font, u) {
          at = i
        }
        run List<Glyph>.insert(&mut buffer.glyphs, at, Glyph.new(0x25cc, item.info.cluster))
        i = i + 1
      }
      i = i + 1
      start = i
      end = i
      continue
    }
    start = i
    if isL(u) && i + 1 < Buffer.len(&buffer.*)
      && isV(List<Glyph>.get(&buffer.glyphs, i + 1).codepoint) {
      let v = List<Glyph>.get(&buffer.glyphs, i + 1).codepoint
      let mut t: u32 = 0
      if i + 2 < Buffer.len(&buffer.*) && isT(List<Glyph>.get(&buffer.glyphs, i + 2).codepoint) {
        t = List<Glyph>.get(&buffer.glyphs, i + 2).codepoint
      }
      let mut count: usize = 2
      if t != 0 {
        count = 3
      }
      Buffer.unsafeToBreak(&mut buffer, i, i + count)
      if u < 0x1113 && v >= 0x1161 && v < 0x1176 && (t == 0 || (t > 0x11a7 && t < 0x11c3)) {
        let mut cp = 0xac00 + (u - 0x1100) * 588 + (v - 0x1161) * 28
        if t != 0 {
          cp = cp + t - 0x11a7
        }
        if ConfiguredShaper.hasGlyph(font, cp) {
          combine(&mut buffer, i, count, cp)
          end = i + 1
          i = end
          continue
        }
      }
      jamo(&mut buffer, i, i + count)
      end = i + count
      i = end
      continue
    }
    if u >= 0xac00 && u <= 0xd7a3 {
      let supported = ConfiguredShaper.hasGlyph(font, u)
      let l = 0x1100 + (u - 0xac00) / 588
      let v = 0x1161 + ((u - 0xac00) % 588) / 28
      let ti = (u - 0xac00) % 28
      let mut following: u32 = 0
      if i + 1 < Buffer.len(&buffer.*) {
        following = List<Glyph>.get(&buffer.glyphs, i + 1).codepoint
      }
      if ti == 0 && following > 0x11a7 && following < 0x11c3 {
        let cp = u + following - 0x11a7
        if ConfiguredShaper.hasGlyph(font, cp) {
          combine(&mut buffer, i, 2, cp)
          end = i + 1
          i = end
          continue
        }
        Buffer.unsafeToBreak(&mut buffer, i, i + 2)
      }
      if (!supported || (ti == 0 && isT(following))) && ConfiguredShaper.hasGlyph(font, l)
        && ConfiguredShaper.hasGlyph(font, v)
        && (ti == 0 || ConfiguredShaper.hasGlyph(font, 0x11a7 + ti)) {
        List<Glyph>.set(&mut buffer.glyphs, i, Glyph.new(l, item.info.cluster))
        run List<Glyph>.insert(&mut buffer.glyphs, i + 1, Glyph.new(v, item.info.cluster))
        let mut count: usize = 2
        if ti != 0 {
          run List<Glyph>.insert(
            &mut buffer.glyphs,
            i + 2,
            Glyph.new(0x11a7 + ti, item.info.cluster),
          )
          count = 3
        } else if supported && isT(following) {
          count = 3
        }
        jamo(&mut buffer, i, i + count)
        end = i + count
        i = end
        continue
      }
      if supported {
        end = i + 1
        i = end
        continue
      }
    }
    i = i + 1
  }
}
