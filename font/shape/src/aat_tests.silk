import aat_kern
import aat_map { Range }
import aat_map
import generated_fixtures as Fixtures
import language { Language }
import font { ShaperData, Shaper }
import font_types.lib { Tag }
import read_fonts.lib { FontRef, ReadError }
import silk.core.result { Result }
import buffer { Buffer, Glyph }
import direction { Direction }
import feature { Feature }
import scale { Scale }
import view { View }
import silk.collections.list { List }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

// Two glyph classes drive a push/mark followed by an action. All offsets are
// table-relative, including the byte-indexed classic state table.
fn extended() -> View<'static> {
  return View.bytes(
    b"\x00\x00\x00\x06\x00\x00\x00\x14\x00\x00\x00\x1e\x00\x00\x00\x36\x00\x00\x00\x48\x00\x08\x00\x01\x00\x02\x00\x04\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\x00\x01\x80\x00\xff\xff\x00\x00\x00\x00\x00\x00\xff\xd9",
  )
}

fn classic() -> View<'static> {
  return View.bytes(
    b"\x00\x06\x00\x08\x00\x0e\x00\x1a\x00\x01\x00\x02\x04\x05\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x02\x00\x0e\x00\x00\x00\x14\x80\x00\x00\x0e\x00\x26\xff\xd9",
  )
}

fn coordinates() -> View<'static> {
  return View.bytes(
    b"\x00\x00\x00\x06\x00\x00\x00\x14\x00\x00\x00\x1e\x00\x00\x00\x36\x80\x00\x00\x48\x00\x08\x00\x01\x00\x02\x00\x04\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\x00\x01\x80\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x64\x00\xc8\x00\x0a\x00\x14",
  )
}

effect fn stateCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = Buffer.new()
  run Buffer.add(&mut buffer, 1, 0)
  run Buffer.add(&mut buffer, 2, 1)
  buffer.direction = Direction.LeftToRight
  let features: [Feature; 0] = []
  aat_kern.machine(
    Scale.identity(),
    &mut buffer,
    &features,
    extended(),
    View.empty(),
    1,
    false,
    false,
    0,
    false,
  )
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).position.xAdvance == -40
      && List<Glyph>.get(&buffer.glyphs, 0).position.xOffset == -40,
    "kerx state actions pop and adjust the saved glyph",
  )
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).position.xAdvance == 0
      && (List<Glyph>.get(&buffer.glyphs, 1).info.flags & 1) != 0,
    "action marks the boundary unsafe",
  )
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 1, 0)
  run Buffer.add(&mut buffer, 2, 1)
  buffer.direction = Direction.LeftToRight
  aat_kern.machine(
    Scale.identity(),
    &mut buffer,
    &features,
    classic(),
    View.empty(),
    1,
    true,
    false,
    0,
    false,
  )
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).position.xAdvance == -40,
    "classic kern byte offsets and stack actions",
  )
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 1, 0)
  run Buffer.add(&mut buffer, 2, 1)
  buffer.direction = Direction.LeftToRight
  aat_kern.machine(
    Scale.identity(),
    &mut buffer,
    &features,
    coordinates(),
    View.empty(),
    4,
    false,
    false,
    0,
    false,
  )
  let glyph = List<Glyph>.get(&buffer.glyphs, 1)
  run Testing.expect(
    glyph.position.xOffset == 90 && glyph.position.yOffset == 180 && glyph.attach == -1
      && glyph.attachType == 1,
    "kerx coordinate actions attach to the marked glyph",
  )
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 1, 0)
  run Buffer.add(&mut buffer, 2, 1)
  buffer.direction = Direction.TopToBottom
  aat_kern.pair(Scale.new(2000, 3000, 1000), &mut buffer, 0, 1, -5, false)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).position.yAdvance == -8
      && List<Glyph>.get(&buffer.glyphs, 1).position.yAdvance == -7
      && List<Glyph>.get(&buffer.glyphs, 1).position.yOffset == -7,
    "vertical pairs use the Y scale and preserve odd totals",
  )
  aat_kern.pair(Scale.new(2000, 3000, 1000), &mut buffer, 0, 1, 10, true)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).position.xOffset == 20,
    "vertical cross-stream pairs use the X scale",
  )
  aat_kern.machine(
    Scale.identity(),
    &mut buffer,
    &features,
    View.bytes(b"\x00\x00\x00\x06\xff\xff\xff\xff"),
    View.empty(),
    1,
    false,
    false,
    0,
    false,
  )
  run Testing.expect(Buffer.len(&buffer) == 2, "out-of-bounds state offsets are ignored")
}

test effect fn appleStateMachinesAndVerticalKerning() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run stateCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn tupleKerning() -> ()
  ! AssertionError<'static> {
  let data = View.bytes(b"\x00\x00\xff\xd8")
  run Testing.expect(
    aat_kern.resolveTuple(-40, 0, data) == -40,
    "ordinary kerning is a signed value",
  )
  run Testing.expect(
    aat_kern.resolveTuple(2, 3, data) == -40,
    "tuple kerning selects the first tuple by byte offset",
  )
  run Testing.expect(
    aat_kern.resolveTuple(-1, 3, data) == 0 && aat_kern.resolveTuple(4, 3, data) == 0,
    "invalid tuple offsets do not trap",
  )
}

effect fn featureCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = match move FontRef.new(Fixtures.aatFeatureFont()) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "synthetic Apple font")
      return
    }
  }
  let data = ShaperData.new(&font)
  let shaper = Shaper.new(&data)
  let mut buffer = Buffer.new()
  run Buffer.setLanguage(&mut buffer, "TR_tr")
  run Testing.expect(
    Language.asString(&buffer.languageValue) == "tr-tr",
    "language normalization retains its full tag",
  )
  let features = [
    Feature.ranged(Tag.fromU32(0x6c696761), 0, 1, 3),
    Feature.ranged(Tag.fromU32(0x736d6370), 1, 2, 4),
    Feature.new(Tag.fromU32(0x73733031), 1),
    Feature.new(Tag.fromU32(0x61616c74), 7),
  ]
  let ranges = run aat_map.compile(
    &shaper,
    View.bytes(Fixtures.aatFeatureChain()),
    16,
    7,
    &features,
    &buffer.languageValue,
  )
  run Testing.expect(
    aat_map.flags(List<Range>.asSlice(&ranges), 0) == 29
      && aat_map.flags(List<Range>.asSlice(&ranges), 1) == 28,
    "ligature ranges preserve independent stylistic and language flags",
  )
  run Testing.expect(
    aat_map.flags(List<Range>.asSlice(&ranges), 2) == 30
      && aat_map.flags(List<Range>.asSlice(&ranges), 3) == 31
      && aat_map.flags(List<Range>.asSlice(&ranges), 4) == 29,
    "overlapping ranges and deprecated small-caps selectors",
  )
  run Testing.expect(
    aat_map.flags(List<Range>.asSlice(&ranges), 4294967295) == 29,
    "global feature range includes the last cluster",
  )
}

test effect fn appleFeatureAndLanguageRanges() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run featureCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
