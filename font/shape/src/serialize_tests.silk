import buffer { Buffer, ContentType, GlyphInfo, GlyphPosition, GlyphInfosMut, GlyphPositionsMut }
import serialize { serializeWithoutFont }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = Buffer.new()
  let empty = run serializeWithoutFont(&buffer, 0)
  run Testing.expect(String.view(&empty) == "", "empty buffers serialize to empty strings")
  run Buffer.pushStr(&mut buffer, "A\u{1f600}")
  let unicode = run serializeWithoutFont(&buffer, 0)
  run Testing.expect(
    String.view(&unicode) == "<U+0041=0|U+1F600=1>",
    "Unicode codepoints use hexadecimal and byte clusters",
  )
  if true {
    let mut infos = Buffer.glyphInfosMut(&mut buffer)
    drop GlyphInfosMut.set(&mut infos, 0, GlyphInfo { glyphId: 42, cluster: 7, flags: 3 })
  }
  Buffer.setContentType(&mut buffer, ContentType.Glyphs)
  drop Buffer.setGlyphPosition(
    &mut buffer,
    0,
    GlyphPosition { xAdvance: 500, yAdvance: 0, xOffset: -2, yOffset: 3 },
  )
  if true {
    let mut positions = Buffer.glyphPositionsMut(&mut buffer)
    drop GlyphPositionsMut.set(
      &mut positions,
      1,
      GlyphPosition { xAdvance: 400, yAdvance: -10, xOffset: 0, yOffset: 0 },
    )
  }
  let numeric = run serializeWithoutFont(&buffer, 20)
  run Testing.expect(
    String.view(&numeric) == "[42=7@-2,3+500#3|128512=1+400,-10]",
    "mutable projected views feed glyph serialization",
  )
  let absolute = run serializeWithoutFont(&buffer, 37)
  run Testing.expect(
    String.view(&absolute) == "[42@-2,3|128512@500,0]",
    "no-advance output accumulates absolute origins",
  )
}

test effect fn bufferSerialization() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
