import buffer {
  Buffer,
  Glyph,
  GlyphInfo,
  GlyphPosition,
  GlyphInfos,
  GlyphPositions,
  GlyphPositionsMut,
  ContentType,
  ClusterLevel
}
import silk.core.option { Option }
import normalize
import syllable
import direction { Direction }
import silk.collections.list { List }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = Buffer.new()
  run Testing.expect(buffer.contentType == ContentType.None, "new buffers have no content type")
  run Buffer.pushStr(&mut buffer, "aé世")
  let infos = Buffer.glyphInfos(&buffer)
  run Testing.expect(
    buffer.contentType == ContentType.Unicode
      && (GlyphInfos.get(&infos, 1)
        |> Option<GlyphInfo>.unwrapOr(GlyphInfo { glyphId: 0, cluster: 0, flags: 0 })).glyphId
        == 233,
    "unshaped glyph views expose Unicode",
  )
  run Testing.expect(
    GlyphPositions.len(&Buffer.glyphPositions(&buffer)) == 0,
    "positions are absent until requested",
  )
  if true {
    let mut positions = Buffer.glyphPositionsMut(&mut buffer)
    run Testing.expect(
      GlyphPositionsMut.len(&positions) == 3
        && (GlyphPositionsMut.get(&positions, 2)
          |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())).xAdvance
          == 0,
      "mutable positions initialize on demand",
    )
    let mut first = GlyphPosition.zero()
    first.xAdvance = 123
    drop GlyphPositionsMut.set(&mut positions, 0, first)
  }
  run Testing.expect(
    (Buffer.glyphPosition(&buffer, 0)
      |> Option<GlyphPosition>.unwrapOr(GlyphPosition.zero())).xAdvance
      == 123,
    "projected mutable positions update the buffer",
  )
  run Testing.expect(
    Buffer.len(&buffer) == 3 && List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 3,
    "UTF-8 byte clusters",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "aé世", false)
  run Testing.expect(List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 2, "character clusters")
  Buffer.guessSegmentProperties(&mut buffer)
  run Testing.expect(
    buffer.direction == Direction.LeftToRight && buffer.script == 0x4c61746e,
    "guess segment properties",
  )
  Buffer.mergeClusters(&mut buffer, 1, 3)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 1,
    "monotone cluster merging",
  )
  Buffer.reverse(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 0x4e16,
    "reversal preserves metadata",
  )
  Buffer.clear(&mut buffer)
  buffer.clusterLevel = ClusterLevel.Graphemes
  run Buffer.pushText(&mut buffer, "x\u{030a}X\u{030a}", false)
  normalize.formClusters(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.cluster == 0
      && List<Glyph>.get(&buffer.glyphs, 3).info.cluster == 2,
    "nonmonotone grapheme clusters remain intact",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "\u{1f469}\u{200d}\u{1f4bb}x", false)
  buffer.direction = Direction.RightToLeft
  normalize.formClusters(&mut buffer)
  normalize.nativeDirection(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 120
      && List<Glyph>.get(&buffer.glyphs, 1).codepoint == 0x1f469
      && List<Glyph>.get(&buffer.glyphs, 3).codepoint == 0x1f4bb,
    "reverse-direction shaping preserves emoji sequences",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "abc", false)
  Buffer.reverse(&mut buffer)
  Buffer.deleteGlyph(&mut buffer, 1)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).info.cluster == 1,
    "deleting a backward cluster preserves its boundary",
  )
  let mut glyph = Glyph.new(65, 0)
  glyph.glyphClass = 2
  glyph.ligatureId = 1
  glyph.numComponents = 3
  glyph.ligated = true
  run Testing.expect(
    Glyph.ligNumComps(&glyph) == 3 && glyph.component == 0,
    "ligature counts are separate from attached mark components",
  )
  glyph.multiplied = true
  glyph.component = 1
  run Testing.expect(
    Glyph.ligContribution(&glyph) == 0,
    "later pieces of a multiple substitution do not add ligature components",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "ab", false)
  buffer.flags = 128
  Buffer.safeToInsertTatweel(&mut buffer, 0, 2)
  Buffer.propagateFlags(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.flags == 5,
    "tatweel-safe boundaries become unsafe to break",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "abc", false)
  buffer.flags = 192
  Buffer.safeToInsertTatweel(&mut buffer, 0, 3)
  Buffer.unsafeToBreak(&mut buffer, 1, 3)
  Buffer.propagateFlags(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 1).info.flags == 7
      && List<Glyph>.get(&buffer.glyphs, 2).info.flags == 3,
    "later substitutions remove tatweel safety inside unsafe spans",
  )
  Buffer.clear(&mut buffer)
  run Buffer.add(&mut buffer, 0xd800, 0)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).codepoint == 0xd800,
    "raw codepoints are preserved for custom font mapping",
  )
  Buffer.clear(&mut buffer)
  run Buffer.setPreContext(&mut buffer, "abcdefg")
  run Buffer.setPostContext(&mut buffer, "abcdefg")
  let pre = Buffer.preContextCodepoints(&buffer)
  let post = Buffer.postContextCodepoints(&buffer)
  run Testing.expect(
    pre.length == 5 && pre[0] == 103 && pre[4] == 99 && post.length == 5 && post[0] == 97
      && post[4] == 101,
    "context is bounded to five codepoints, with pre-context reversed",
  )
  run Buffer.pushCodepoints(&mut buffer, &[65, 66])
  run Buffer.pushCodepoints(&mut buffer, &[67])
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 2).info.cluster == 0,
    "codepoint clusters restart on each append",
  )
  drop run Buffer.setLength(&mut buffer, 5)
  run Testing.expect(
    Buffer.len(&buffer) == 5 && List<Glyph>.get(&buffer.glyphs, 4).info.glyphId == 0,
    "growing the buffer zeroes new infos",
  )
  Buffer.resetClusters(&mut buffer)
  Buffer.reverseClusters(&mut buffer)
  run Testing.expect(
    List<Glyph>.get(&buffer.glyphs, 0).info.cluster == 4,
    "reverse clusters retains the logical cluster value",
  )
  Buffer.clear(&mut buffer)
  run Buffer.pushText(&mut buffer, "אב", false)
  Buffer.guessSegmentProperties(&mut buffer)
  run Testing.expect(
    buffer.direction == Direction.RightToLeft && buffer.script == 0x48656272,
    "Hebrew direction",
  )
}

test effect fn bufferOwnershipAndClusters() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn glyphAt(buffer: &Buffer, at: usize) -> Glyph {
  return List<Glyph>.asSlice(&buffer.glyphs)[at]
}

fn idsAre(buffer: &Buffer, ids: &[u32]) -> bool {
  if Buffer.len(buffer) != ids.length {
    return false
  }
  let mut i: usize = 0
  while i < ids.length {
    if glyphAt(buffer, i).info.glyphId != ids[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn clustersAre(buffer: &Buffer, clusters: &[u32]) -> bool {
  if Buffer.len(buffer) != clusters.length {
    return false
  }
  let mut i: usize = 0
  while i < clusters.length {
    if glyphAt(buffer, i).info.cluster != clusters[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn flagsAre(buffer: &Buffer, flags: &[u32]) -> bool {
  if Buffer.len(buffer) != flags.length {
    return false
  }
  let mut i: usize = 0
  while i < flags.length {
    if glyphAt(buffer, i).info.flags != flags[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn outputCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut buffer = Buffer.new()
  run Buffer.pushCodepoints(&mut buffer, &[65, 66, 67, 68])
  Buffer.enter(&mut buffer)

  // A pass that only advances shares the input list and copies nothing.
  Buffer.clearOutput(&mut buffer)
  while buffer.idx < Buffer.len(&buffer) {
    run Buffer.nextGlyph(&mut buffer)
  }
  run Testing.expect(
    !buffer.separateOutput && buffer.outLen == 4,
    "an unedited pass keeps the output in place",
  )
  run Testing.expect(run Buffer.syncOutput(&mut buffer), "an unedited pass syncs")
  run Testing.expect(
    idsAre(&buffer, &[65, 66, 67, 68]) && !buffer.haveOutput,
    "an unedited pass leaves the glyphs as they were",
  )

  // A ligature shrinks the buffer in place.
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyph(&mut buffer)
  run Buffer.replaceGlyphs(&mut buffer, 2, &[99])
  run Testing.expect(
    !buffer.separateOutput && Buffer.backtrackLen(&buffer) == 2
      && Buffer.lookaheadLen(&buffer) == 1,
    "a ligature writes in front of the unread input",
  )
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    idsAre(&buffer, &[65, 99, 68]) && clustersAre(&buffer, &[0, 1, 3]),
    "a ligature takes the merged cluster of its components",
  )

  // A multiple substitution outgrows the input and moves the output aside.
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyph(&mut buffer)
  run Buffer.replaceGlyphs(&mut buffer, 1, &[7, 8, 9])
  run Testing.expect(buffer.separateOutput, "growing output moves to its own list")
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    idsAre(&buffer, &[65, 7, 8, 9, 68]) && clustersAre(&buffer, &[0, 1, 1, 1, 3]),
    "a multiple substitution repeats the replaced glyph's cluster",
  )

  // Replacing, outputting and copying single glyphs.
  Buffer.clearOutput(&mut buffer)
  run Buffer.replaceGlyph(&mut buffer, 40)
  run Buffer.outputGlyph(&mut buffer, 41)
  run Buffer.copyGlyph(&mut buffer)
  Buffer.skipGlyph(&mut buffer)
  run Testing.expect(
    Buffer.outGlyphs(&buffer).length == 3 && Buffer.outGlyphs(&buffer)[2].info.glyphId == 7,
    "outputGlyph and copyGlyph copy the current glyph without advancing",
  )
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(idsAre(&buffer, &[40, 41, 7, 8, 9, 68]), "skipGlyph drops the current glyph")
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyphs(&mut buffer, 6)
  run Buffer.outputGlyph(&mut buffer, 42)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    idsAre(&buffer, &[40, 41, 7, 8, 9, 68, 42]) && glyphAt(&buffer, 6).info.cluster == 3,
    "outputGlyph at the end copies the last output glyph",
  )

  // Deleting merges a lone glyph's cluster backward, or forward at the start.
  Buffer.clear(&mut buffer)
  run Buffer.pushCodepoints(&mut buffer, &[65, 66, 67])
  Buffer.enter(&mut buffer)
  if true {
    let slots = Buffer.glyphDataMut(&mut buffer)
    slots[0].info.cluster = 2
    slots[2].info.cluster = 0
  }
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyph(&mut buffer)
  Buffer.deleteCurrent(&mut buffer)
  run Buffer.nextGlyph(&mut buffer)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    idsAre(&buffer, &[65, 67]) && clustersAre(&buffer, &[1, 0]),
    "deleting merges the cluster backward into the output",
  )
  Buffer.clearOutput(&mut buffer)
  Buffer.deleteCurrent(&mut buffer)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    idsAre(&buffer, &[67]) && clustersAre(&buffer, &[0]),
    "deleting the first glyph merges forward",
  )

  // Moving the output position forward and back.
  Buffer.clear(&mut buffer)
  run Buffer.pushCodepoints(&mut buffer, &[65, 66, 67, 68])
  Buffer.enter(&mut buffer)
  Buffer.clearOutput(&mut buffer)
  drop run Buffer.moveTo(&mut buffer, 3)
  drop run Buffer.moveTo(&mut buffer, 1)
  run Testing.expect(
    buffer.idx == 1 && buffer.outLen == 1,
    "rewinding in place moves the read position back",
  )
  run Buffer.replaceGlyphs(&mut buffer, 1, &[5, 6, 7])
  run Testing.expect(buffer.idx == 2 && buffer.outLen == 4, "output overtakes the input")
  run Testing.expect(run Buffer.moveTo(&mut buffer, 0), "rewinding past the input start")
  run Testing.expect(
    buffer.idx == 0 && buffer.outLen == 0 && Buffer.lookaheadLen(&buffer) == 6,
    "rewinding past the input start opens a gap",
  )
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(idsAre(&buffer, &[65, 5, 6, 7, 67, 68]), "rewound output reads back as input")

  // Cluster merges that reach the end of the output continue into the input.
  Buffer.clear(&mut buffer)
  run Buffer.pushCodepoints(&mut buffer, &[65, 66, 67, 68, 69])
  Buffer.enter(&mut buffer)
  if true {
    let slots = Buffer.glyphDataMut(&mut buffer)
    slots[3].info.cluster = 2
  }
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyphs(&mut buffer, 3)
  Buffer.mergeOutClusters(&mut buffer, 1, 3)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    clustersAre(&buffer, &[0, 1, 1, 1, 4]),
    "merging the output tail merges the input head",
  )

  // Flags across the output tail and the input head.
  Buffer.clear(&mut buffer)
  run Buffer.pushCodepoints(&mut buffer, &[65, 66, 67, 68])
  Buffer.enter(&mut buffer)
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyphs(&mut buffer, 2)
  Buffer.unsafeToBreakFromOutput(&mut buffer, 1, 3)
  Buffer.unsafeToConcatFromOutput(&mut buffer, 0, 4)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(
    flagsAre(&buffer, &[0, 0, 3, 0]),
    "unsafe to break skips the lowest cluster; concat needs its buffer flag",
  )
  buffer.flags = 64
  Buffer.clearOutput(&mut buffer)
  run Buffer.nextGlyphs(&mut buffer, 2)
  Buffer.unsafeToConcatFromOutput(&mut buffer, 0, 4)
  drop run Buffer.syncOutput(&mut buffer)
  run Testing.expect(flagsAre(&buffer, &[2, 2, 3, 2]), "unsafe to concat marks every glyph")
}

test effect fn bufferOutput() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run outputCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
