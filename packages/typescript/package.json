{
  "name": "silk-typescript",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: import Silk functions from TypeScript, with types from a TypeScript 7.1 content mapper and code from a wasm32 build",
  "type": "module",
  "exports": {
    "./register": "./src/register.js",
    "./vite": "./src/vite.js",
    "./build": "./src/build.js"
  },
  "typescript": {
    "contentMapper": {
      "exec": ["node", "src/mapper.js"],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "dependencies": {
    "ts-content-mapper": "0.1.1"
  },
  "devDependencies": {
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "node": ">=22.18"
  }
}
