import silk.num.f64

/// Adds two integers.
pub fn add(a: i32, b: i32) -> i32 {
  return a + b
}

/// The hypotenuse of a right triangle.
pub fn hypot(a: f64, b: f64) -> f64 {
  return f64.sqrt(a * a + b * b)
}

/// The n-th Fibonacci number, as a 64-bit integer.
pub fn fib(n: u32) -> u64 {
  let mut a: u64 = 0
  let mut b: u64 = 1
  let mut i: u32 = 0
  while i < n {
    let next = a + b
    a = b
    b = next
    i = i + 1
  }
  return a
}

/// Whether `n` is prime.
pub fn isPrime(n: u32) -> bool {
  if n < 2 {
    return false
  }
  let mut d: u32 = 2
  while d * d <= n {
    if n % d == 0 {
      return false
    }
    d = d + 1
  }
  return true
}
