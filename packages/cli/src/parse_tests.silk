import command { Arg, Command, Opt }
import parse { Cli, CliError, Parsed }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.writer { Writer, WriterError }

struct Greet {
  pub name: String,
  pub times: u32,
  pub loud: bool,
  pub nickName: Option<String>,
  pub files: List<String>,
}

static fn greet() -> Command {
  let mut command = Command.make("greet", "Say hello to someone")
  command = Command.withVersion(command, "1.2.3")
  command = Command.option(command, Opt.alias(Opt.describe(Opt.named("name"), "Who to greet"), "n"))
  command = Command.option(command, Opt.describe(Opt.named("times"), "How many times"))
  command = Command.option(command, Opt.alias(Opt.describe(Opt.named("loud"), "Shout it"), "l"))
  command = Command.arg(command, Arg.describe(Arg.named("files"), "Files to greet"))
  return command
}

struct Required {
  pub target: String,
  pub port: u16,
}

static fn required() -> Command {
  let mut command = Command.make("connect", "")
  command = Command.arg(command, Arg.required(Arg.named("target")))
  command = Command.option(command, Opt.required(Opt.named("port")))
  return command
}

effect fn defaults() -> Greet
  ! OutOfMemoryError
  ? &mut Allocator {
  return Greet {
    name: run String.copy("world"),
    times: 1,
    loud: false,
    nickName: Option<String>.none(),
    files: List<String>.make(),
  }
}

effect fn parseGreet(arguments: &[string]) -> Parsed<Greet>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parse(greet(), run defaults(), arguments)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn keepsDefaults() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["greet"]
  let parsed = run parseGreet(&arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run Testing.expect(same(&value.name, "world"), "name keeps its default")
      run Testing.expect(value.times == 1, "times keeps its default")
      run Testing.expect(!value.loud, "loud is off")
      run Testing.expect(List<String>.length(&value.files) == 0, "no files")
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn readsEveryForm() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = [
    "greet",
    "-n",
    "Julia",
    "--times=3",
    "--loud",
    "a.txt",
    "--nick-name",
    "jo",
    "--",
    "--b.txt"
  ]
  let parsed = run parseGreet(&arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run Testing.expect(same(&value.name, "Julia"), "name from the alias")
      run Testing.expect(value.times == 3, "times from --times=3")
      run Testing.expect(value.loud, "loud flag")
      run Testing.expect(List<String>.length(&value.files) == 2, "two files")
      run Testing.expect(same(&List<String>.asSlice(&value.files)[1], "--b.txt"), "after --")
      match move value.nickName {
        Option.Some { value: nick } => run Testing.expect(same(&nick, "jo"), "kebab-case name")
        Option.None => run Testing.expect(false, "nick name is present")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn reportsErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let unknown = ["greet", "--nmae", "x"]
  match run parseGreet(&unknown) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnknownOption { token } } => run Testing.expect(
      same(&token, "--nmae"),
      "unknown token"
    )
    _ => run Testing.expect(false, "unknown option")
  }
  let missing = ["greet", "--name"]
  match run parseGreet(&missing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingValue { option } } => run Testing.expect(
      option == "--name",
      "missing value"
    )
    _ => run Testing.expect(false, "missing value")
  }
  let invalid = ["greet", "--times", "lots"]
  match run parseGreet(&invalid) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.InvalidValue { option, token } } => run Testing.expect(
      option == "--times" && same(&token, "lots"),
      "invalid value"
    )
    _ => run Testing.expect(false, "invalid value")
  }
  let flagged = ["greet", "--loud=yes"]
  match run parseGreet(&flagged) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnexpectedValue { option } } => run Testing.expect(
      option == "--loud",
      "flag value"
    )
    _ => run Testing.expect(false, "flag value")
  }
}

test effect fn answersHelpAndVersion() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let help = ["greet", "--times", "2", "-h"]
  match run parseGreet(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help => {}
    _ => run Testing.expect(false, "help")
  }
  let version = ["greet", "--version"]
  match run parseGreet(&version) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Version => {}
    _ => run Testing.expect(false, "version")
  }
}

test effect fn checksRequired() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let empty = Required {
    target: run String.copy("") |> Effect.provideMut<Allocator>(&mut allocator),
    port: 0
  }
  let noPort = ["connect", "example.com"]
  match run Cli.parse(required(), move empty, &noPort)
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingRequired { option } } => run Testing.expect(
      option == "--port",
      "port is required"
    )
    _ => run Testing.expect(false, "missing port")
  }
  let blank = Required {
    target: run String.copy("") |> Effect.provideMut<Allocator>(&mut allocator),
    port: 0
  }
  let extra = ["connect", "a", "b", "--port", "80"]
  match run Cli.parse(required(), move blank, &extra)
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnexpectedArgument { token } } => run Testing.expect(
      same(&token, "b"),
      "one target only"
    )
    _ => run Testing.expect(false, "extra argument")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

test effect fn writesHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Greet>(greet()) |> Effect.provideMut<Writer>(&mut out)
  let expected = b"Usage: greet [options] <files>\n\nSay hello to someone\n\nOptions:\n  -n, --name <value>       Who to greet\n      --times <value>      How many times\n  -l, --loud               Shout it\n      --nick-name <value>  \n  -h, --help               Print this help\n      --version            Print the version\n\nArguments:\n  <files>                  Files to greet\n"
  let mut same = out.length == expected.length
  let mut index: usize = 0
  while same && index < out.length {
    same = out.bytes[index] == expected[index]
    index = index + 1
  }
  run Testing.expect(same, "help text")
}
