//! Static descriptions of a command line: the command, its options, and its positional arguments.
//!
//! # When to use
//! Describe a command with [`Command`], [`Opt`], and [`Arg`] in a `static fn`, then give it to
//! `cli.parse.Cli.parse` together with the struct that holds the parsed values.
//!
//! # Details
//! Every operation here is `static`, so a description is a compile-time value. A description names
//! struct fields by their labels. The struct's field types choose how each value is read; the
//! description only adds names, aliases, help text, and whether a field is positional or required.
//! A field that the description does not mention is still an option, named after its label.
//!
//! @category Command line

import silk.reflect { Reflect, labeledFieldKind }
import silk.static_sequence { StaticSequence }
import silk.static_text { StaticText }

/// The description of one struct field as an option or a positional argument.
pub struct OptionSpec {
  /// The label of the struct field that receives the value.
  pub field: string<'static>,
  /// The long name without dashes. Empty means the kebab-case form of `field`.
  pub long: string<'static>,
  /// The one-letter alias without the dash. Empty means no alias.
  pub short: string<'static>,
  /// The help text.
  pub description: string<'static>,
  /// Whether the command line must give this value.
  pub required: bool,
  /// Whether the value comes from a positional argument instead of a named option.
  pub positional: bool,
  /// Whether the field is a subcommand: an `Option` of the subcommand's struct.
  pub subcommand: bool,
  /// The subcommand path that owns this entry, such as `remote` or `remote.add`. Empty for the
  /// entries in `Command.options`.
  pub scope: string<'static>,
}

/// The description of a command.
pub struct Command {
  /// The program name shown in the usage line.
  pub name: string<'static>,
  /// The help text shown under the usage line.
  pub description: string<'static>,
  /// The text that `--version` prints. Empty means the command has no `--version`.
  pub version: string<'static>,
  /// The options and positional arguments, in the order they were added.
  pub options: Intrinsic.StaticSequence<OptionSpec>,
  /// The entries of the subcommands, each with the path of its subcommand in `scope`.
  pub nested: Intrinsic.StaticSequence<OptionSpec>,
}

impl Command {
  /// Returns a command named `name` with the help text `description` and no options.
  pub static fn make(name: string<'static>, description: string<'static>) -> Command {
    return Command {
      name: name,
      description: description,
      version: "",
      options: StaticSequence.empty<OptionSpec>(),
      nested: StaticSequence.empty<OptionSpec>(),
    }
  }

  /// Returns `command` with a `--version` option that prints `version`.
  pub static fn withVersion(command: Command, version: string<'static>) -> Command {
    return Command {
      name: command.name,
      description: command.description,
      version: version,
      options: command.options,
      nested: command.nested,
    }
  }

  /// Returns `command` with the option `option`.
  pub static fn option(command: Command, option: OptionSpec) -> Command {
    return Command {
      name: command.name,
      description: command.description,
      version: command.version,
      options: StaticSequence.append<OptionSpec>(command.options, option),
      nested: command.nested,
    }
  }

  /// Returns `command` with the positional argument `argument`. Positional arguments are read in
  /// the order they are added.
  pub static fn arg(command: Command, argument: OptionSpec) -> Command {
    return Command.option(command, argument)
  }

  /// Returns the description of `field`: the one added to `command`, or the default option named
  /// after the field.
  pub static fn find(command: Command, field: string<'static>) -> OptionSpec {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.options, index)
      if option.field == field {
        return option
      }
      index = index + 1
    }
    return Opt.named(field)
  }

  /// Returns the zero-based position of `field` among the positional arguments of `command`.
  pub static fn position(command: Command, field: string<'static>) -> usize {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    let mut position: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.options, index)
      if option.field == field {
        return position
      }
      if option.positional {
        position = position + 1
      }
      index = index + 1
    }
    return position
  }

  /// Returns the number of positional arguments of `command`.
  pub static fn positionalCount(command: Command) -> usize {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    let mut positional: usize = 0
    while index < count {
      if StaticSequence.at<OptionSpec>(command.options, index).positional {
        positional = positional + 1
      }
      index = index + 1
    }
    return positional
  }

  /// Returns `--` and the long name of `option`.
  pub static fn longFlag(option: OptionSpec) -> string<'static> {
    if option.long == "" {
      return StaticText.concat("--", kebab(option.field))
    }
    return StaticText.concat("--", option.long)
  }

  /// Returns `-` and the alias of `option`, or empty text when it has none.
  pub static fn shortFlag(option: OptionSpec) -> string<'static> {
    if option.short == "" {
      return ""
    }
    return StaticText.concat("-", option.short)
  }

  /// Returns the name of a positional argument in the usage line, such as `<files>`.
  pub static fn placeholder(option: OptionSpec) -> string<'static> {
    let mut name = option.long
    if name == "" {
      name = kebab(option.field)
    }
    return StaticText.concat(StaticText.concat("<", name), ">")
  }

  /// Checks `command` against the fields of `T` and stops compilation with a message when they do
  /// not agree. Returns `true` when they agree.
  pub static fn validate<T>(command: Command) -> bool {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.options, index)
      if !hasField<T>(option.field) {
        compileError(StaticText.concat(
          StaticText.concat(StaticText.concat("command ", command.name), " has no field "),
          option.field
        ))
      }
      let mut other = index + 1
      while other < count {
        let next = StaticSequence.at<OptionSpec>(command.options, other)
        if next.field == option.field {
          compileError(StaticText.concat("field described twice: ", option.field))
        }
        if !option.positional && !next.positional && option.subcommand == next.subcommand
          && Command.longFlag(next) == Command.longFlag(option) {
          compileError(StaticText.concat("two options share the name ", Command.longFlag(option)))
        }
        if option.short != "" && next.short == option.short {
          compileError(StaticText.concat("two options share the alias -", option.short))
        }
        other = other + 1
      }
      if option.short != "" && StaticText.byteLength(option.short) != 1 {
        compileError(StaticText.concat("an alias is one letter: -", option.short))
      }
      if option.positional && option.short != "" {
        compileError(StaticText.concat("a positional argument has no alias: ", option.field))
      }
      if option.short == "h" {
        compileError("-h is the help option")
      }
      index = index + 1
    }
    if Command.positionalCount(command) != 0 && Command.subcommandCount(command) != 0 {
      compileError(StaticText.concat(
        "a command with subcommands takes no positional arguments: ",
        command.name
      ))
    }
    return true
  }

  /// Returns `command` with the subcommand `sub`, stored in the struct field `field`. The field's
  /// type is `Option` of the struct that `sub` describes. The subcommand is named `sub.name` on
  /// the command line.
  ///
  /// # Details
  ///
  /// Give the field `Option.some(defaults)` in the value passed to `Cli.parse`. After parsing,
  /// only the subcommand that the command line chose is present; the others are `none`.
  pub static fn subcommand(command: Command, field: string<'static>, sub: Command) -> Command {
    let entry = OptionSpec {
      field: field,
      long: sub.name,
      short: "",
      description: sub.description,
      required: false,
      positional: false,
      subcommand: true,
      scope: "",
    }
    let mut nested = command.nested
    let count = StaticSequence.length<OptionSpec>(sub.options)
    let mut index: usize = 0
    while index < count {
      nested = StaticSequence.append<OptionSpec>(
        nested,
        withScope(StaticSequence.at<OptionSpec>(sub.options, index), field)
      )
      index = index + 1
    }
    let deep = StaticSequence.length<OptionSpec>(sub.nested)
    index = 0
    while index < deep {
      let option = StaticSequence.at<OptionSpec>(sub.nested, index)
      nested = StaticSequence.append<OptionSpec>(
        nested,
        withScope(option, StaticText.concat(StaticText.concat(field, "."), option.scope))
      )
      index = index + 1
    }
    return Command {
      name: command.name,
      description: command.description,
      version: command.version,
      options: StaticSequence.append<OptionSpec>(command.options, entry),
      nested: nested,
    }
  }

  /// Returns the description of the subcommand in `field`: its name is the command name and the
  /// subcommand name, such as `git clone`.
  pub static fn scoped(command: Command, field: string<'static>) -> Command {
    let entry = Command.find(command, field)
    let prefix = StaticText.concat(field, ".")
    let prefixLength = StaticText.byteLength(prefix)
    let mut options = StaticSequence.empty<OptionSpec>()
    let mut nested = StaticSequence.empty<OptionSpec>()
    let count = StaticSequence.length<OptionSpec>(command.nested)
    let mut index: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.nested, index)
      if option.scope == field {
        options = StaticSequence.append<OptionSpec>(options, withScope(option, ""))
      } else {
        let length = StaticText.byteLength(option.scope)
        if length > prefixLength && StaticText.slice(option.scope, 0, prefixLength) == prefix {
          nested = StaticSequence.append<OptionSpec>(
            nested,
            withScope(option, StaticText.slice(option.scope, prefixLength, length))
          )
        }
      }
      index = index + 1
    }
    return Command {
      name: StaticText.concat(StaticText.concat(command.name, " "), entry.long),
      description: entry.description,
      version: "",
      options: options,
      nested: nested,
    }
  }

  /// Returns the number of subcommands of `command`.
  pub static fn subcommandCount(command: Command) -> usize {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    let mut subcommands: usize = 0
    while index < count {
      if StaticSequence.at<OptionSpec>(command.options, index).subcommand {
        subcommands = subcommands + 1
      }
      index = index + 1
    }
    return subcommands
  }
}

/// The static builders of one option.
pub struct Opt {}

impl Opt {
  /// Returns an option for the struct field `field`, named `--` and the kebab-case form of `field`.
  pub static fn named(field: string<'static>) -> OptionSpec {
    return OptionSpec {
      field: field,
      long: "",
      short: "",
      description: "",
      required: false,
      positional: false,
      subcommand: false,
      scope: "",
    }
  }

  /// Returns `option` with the one-letter alias `short`, written without the dash.
  pub static fn alias(option: OptionSpec, short: string<'static>) -> OptionSpec {
    return OptionSpec {
      field: option.field,
      long: option.long,
      short: short,
      description: option.description,
      required: option.required,
      positional: option.positional,
      subcommand: option.subcommand,
      scope: option.scope,
    }
  }

  /// Returns `option` with the long name `long`, written without the dashes.
  pub static fn long(option: OptionSpec, long: string<'static>) -> OptionSpec {
    return OptionSpec {
      field: option.field,
      long: long,
      short: option.short,
      description: option.description,
      required: option.required,
      positional: option.positional,
      subcommand: option.subcommand,
      scope: option.scope,
    }
  }

  /// Returns `option` with the help text `description`.
  pub static fn describe(option: OptionSpec, description: string<'static>) -> OptionSpec {
    return OptionSpec {
      field: option.field,
      long: option.long,
      short: option.short,
      description: description,
      required: option.required,
      positional: option.positional,
      subcommand: option.subcommand,
      scope: option.scope,
    }
  }

  /// Returns `option` as one that the command line must give.
  pub static fn required(option: OptionSpec) -> OptionSpec {
    return OptionSpec {
      field: option.field,
      long: option.long,
      short: option.short,
      description: option.description,
      required: true,
      positional: option.positional,
      subcommand: option.subcommand,
      scope: option.scope,
    }
  }
}

/// The static builders of one positional argument.
pub struct Arg {}

impl Arg {
  /// Returns a positional argument for the struct field `field`. A `List` field takes every
  /// remaining positional argument.
  pub static fn named(field: string<'static>) -> OptionSpec {
    return OptionSpec {
      field: field,
      long: "",
      short: "",
      description: "",
      required: false,
      positional: true,
      subcommand: false,
      scope: "",
    }
  }

  /// Returns `argument` with the help text `description`.
  pub static fn describe(argument: OptionSpec, description: string<'static>) -> OptionSpec {
    return Opt.describe(argument, description)
  }

  /// Returns `argument` as one that the command line must give.
  pub static fn required(argument: OptionSpec) -> OptionSpec {
    return Opt.required(argument)
  }
}

static fn hasField<T>(label: string<'static>) -> bool {
  let mut found = false
  static for field in Reflect.fields<T>() {
    static if Reflect.fieldKind(field) == labeledFieldKind {
      if Reflect.fieldLabel(field) == label {
        found = true
      }
    }
  }
  return found
}

static fn kebab(label: string<'static>) -> string<'static> {
  let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  let lower = "abcdefghijklmnopqrstuvwxyz"
  let length = StaticText.byteLength(label)
  let mut result = ""
  let mut index: usize = 0
  while index < length {
    let byte = StaticText.byteAt(label, index)
    let mut letter: usize = 0
    let mut replaced = false
    while letter < 26 {
      if StaticText.byteAt(upper, letter) == byte {
        if index != 0 {
          result = StaticText.concat(result, "-")
        }
        result = StaticText.concat(result, StaticText.slice(lower, letter, letter + 1))
        replaced = true
      }
      letter = letter + 1
    }
    if !replaced {
      result = StaticText.concat(result, StaticText.slice(label, index, index + 1))
    }
    index = index + 1
  }
  return result
}

static fn withScope(option: OptionSpec, scope: string<'static>) -> OptionSpec {
  return OptionSpec {
    field: option.field,
    long: option.long,
    short: option.short,
    description: option.description,
    required: option.required,
    positional: option.positional,
    subcommand: option.subcommand,
    scope: scope,
  }
}
