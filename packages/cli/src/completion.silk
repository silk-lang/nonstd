//! Shell completion scripts for a command, written during compilation from its description.
//!
//! # When to use
//! Give your program a way to print the script, such as a `--completions bash` option, and tell
//! users to load it: `source <(mytool --completions bash)` in `~/.bashrc`, the same with `zsh` in
//! `~/.zshrc`, or `mytool --completions fish | source` in `~/.config/fish/config.fish`.
//!
//! # Details
//! The script completes subcommand names, option names and aliases, and the choices of an option
//! or positional argument (see `Opt.choice`). It follows the subcommands already typed, so
//! `git remote <Tab>` offers the options and subcommands of `remote`. Where a command takes
//! positional arguments without choices, the script completes file names too. The zsh script
//! loads zsh's completion system and its bash support if needed, and uses the bash script.
//!
//! @category Command line

import command { Command, OptionSpec }
import silk.option { Option }
import silk.reflect { Reflect }
import silk.static_sequence { StaticSequence }
import silk.static_text { StaticText }
import silk.writer { Writer, WriterError }

/// The owner type of the completion writers. It has no fields and is never constructed.
pub struct Completion {}

impl Completion {
  /// Writes a bash completion script for `command` and the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeBash<T>(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    let static function = StaticText.concat("_", functionName(command.name))
    run Writer.writeString(function)
    run Writer.writeString("() {\n")
    run Writer.writeString("  local cur prev path words files i\n")
    run Writer.writeString("  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n")
    run Writer.writeString("  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n")
    run Writer.writeString("  path=\"\"\n")
    run Writer.writeString("  files=\"\"\n")
    run Writer.writeString("  for ((i = 1; i < COMP_CWORD; i++)); do\n")
    run Writer.writeString("    case \"$path:${COMP_WORDS[i]}\" in\n")
    run writeTransitions<T>(command, "", false)
    run Writer.writeString("    esac\n")
    run Writer.writeString("  done\n")
    run Writer.writeString("  case \"$path\" in\n")
    run writeWords<T>(command, "", false)
    run Writer.writeString("  esac\n")
    run Writer.writeString("  case \"$path:$prev\" in\n")
    run writeChoices<T>(command, "", false)
    run Writer.writeString("  esac\n")
    run Writer.writeString("  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))\n")
    run Writer.writeString("  if [ -n \"$files\" ]; then\n")
    run Writer.writeString("    COMPREPLY+=($(compgen -f -- \"$cur\"))\n")
    run Writer.writeString("  fi\n")
    run Writer.writeString("}\n")
    run Writer.writeString("complete -F ")
    run Writer.writeString(function)
    run Writer.writeString(" ")
    run Writer.writeString(command.name)
    run Writer.writeString("\n")
  }

  /// Writes a zsh completion script for `command` and the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeZsh<T>(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString(
      "(( $+functions[compdef] )) || { autoload -U +X compinit && compinit; }\n",
    )
    run Writer.writeString("autoload -U +X bashcompinit && bashcompinit\n")
    run Completion.writeBash<T>(command)
  }

  /// Writes a fish completion script for `command` and the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeFish<T>(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    let static function = StaticText.concat("__", functionName(command.name))
    run Writer.writeString("function ")
    run Writer.writeString(function)
    run Writer.writeString("\n")
    run Writer.writeString("  set -l words (commandline -opc)\n")
    run Writer.writeString("  set -l path ''\n")
    run Writer.writeString("  set -l files ''\n")
    run Writer.writeString("  for word in $words[2..-1]\n")
    run Writer.writeString("    switch \"$path:$word\"\n")
    run writeTransitions<T>(command, "", true)
    run Writer.writeString("    end\n")
    run Writer.writeString("  end\n")
    run Writer.writeString("  switch \"$path:$words[-1]\"\n")
    run writeChoices<T>(command, "", true)
    run Writer.writeString("  end\n")
    run Writer.writeString("  switch \"$path\"\n")
    run writeWords<T>(command, "", true)
    run Writer.writeString("  end\n")
    run Writer.writeString("  if test -n \"$files\"\n")
    run Writer.writeString("    __fish_complete_path (commandline -ct)\n")
    run Writer.writeString("  end\n")
    run Writer.writeString("end\n")
    run Writer.writeString("complete -c ")
    run Writer.writeString(command.name)
    run Writer.writeString(" -f -a '(")
    run Writer.writeString(function)
    run Writer.writeString(")'\n")
  }
}

// Writes the start of a `case` arm that matches `pattern`, in bash or fish.
effect fn writeArm(pattern: string, fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  if fish {
    run Writer.writeString("case '")
    run Writer.writeString(pattern)
    run Writer.writeString("'\n")
  } else {
    run Writer.writeString("\"")
    run Writer.writeString(pattern)
    run Writer.writeString("\") ")
  }
}

// Writes `words` as the completions of an arm: an assignment in bash, printed lines in fish.
effect fn writeWordList(words: string, fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  if fish {
    run Writer.writeString("      printf '%s\\n' ")
    run Writer.writeString(words)
    run Writer.writeString("\n")
  } else {
    run Writer.writeString("words=\"")
    run Writer.writeString(words)
    run Writer.writeString("\" ;;\n")
  }
}

// Writes one arm per subcommand: typing its name at `at` moves to its path.
effect fn writeTransitions<T>(
  static command: Command,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      let static below = joinPath(at, option.field)
      run Writer.writeString("      ")
      run writeArm(StaticText.concat(StaticText.concat(at, ":"), option.long), fish)
      static if fish {
        run Writer.writeString("        set path ")
        run Writer.writeString(below)
        run Writer.writeString("\n")
      } else {
        run Writer.writeString("path=\"")
        run Writer.writeString(below)
        run Writer.writeString("\" ;;\n")
      }
      run transitionsBelow(command, below, field, fish)
    }
  }
}

effect fn transitionsBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeTransitions<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at, fish)
}

// Writes the arm of the words that complete at `at`, then the arms of its subcommands.
effect fn writeWords<T>(
  static command: Command,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("    ")
  run writeArm(at, fish)
  static if takesFiles<T>(command) {
    static if fish {
      run Writer.writeString("      set files 1\n")
    } else {
      run Writer.writeString("files=1; ")
    }
  }
  run writeWordList(wordsOf<T>(command), fish)
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      run wordsBelow(command, joinPath(at, option.field), field, fish)
    }
  }
}

effect fn wordsBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeWords<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at, fish)
}

// Writes one arm per option with choices: after the option, only its choices complete.
effect fn writeChoices<T>(
  static command: Command,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      run choicesBelow(command, joinPath(at, option.field), field, fish)
    } else {
      static if !option.positional && StaticSequence.length<string<'static>>(option.choices) != 0 {
        let static long = StaticText.concat(StaticText.concat(at, ":"), Command.longFlag(option))
        run Writer.writeString("    ")
        static if option.short != "" {
          let static short = StaticText.concat(
            StaticText.concat(at, ":"),
            Command.shortFlag(option),
          )
          static if fish {
            run Writer.writeString("case '")
            run Writer.writeString(long)
            run Writer.writeString("' '")
            run Writer.writeString(short)
            run Writer.writeString("'\n")
          } else {
            run Writer.writeString("\"")
            run Writer.writeString(long)
            run Writer.writeString("\"|\"")
            run Writer.writeString(short)
            run Writer.writeString("\") ")
          }
        } else {
          run writeArm(long, fish)
        }
        run writeWordList(choiceWords(option), fish)
        static if fish {
          run Writer.writeString("      return\n")
        }
      }
    }
  }
}

effect fn choicesBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeChoices<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at, fish)
}

// The words that complete in `command`: subcommands, options with their aliases, and the choices
// of positional arguments.
static fn wordsOf<T>(command: Command) -> string<'static> {
  let mut words = ""
  static for field in Reflect.fields<T>() {
    let option = Command.find(command, Reflect.fieldLabel(field))
    if option.subcommand {
      words = StaticText.concat(StaticText.concat(words, option.long), " ")
    } else {
      if option.positional {
        static for choice in option.choices {
          words = StaticText.concat(StaticText.concat(words, choice), " ")
        }
      } else {
        words = StaticText.concat(StaticText.concat(words, Command.longFlag(option)), " ")
        if option.short != "" {
          words = StaticText.concat(StaticText.concat(words, Command.shortFlag(option)), " ")
        }
      }
    }
  }
  words = StaticText.concat(words, "--help -h")
  if command.version != "" {
    words = StaticText.concat(words, " --version")
  }
  return words
}

// Whether `command` has a positional argument without choices, which completes file names.
static fn takesFiles<T>(command: Command) -> bool {
  let mut files = false
  static for field in Reflect.fields<T>() {
    let option = Command.find(command, Reflect.fieldLabel(field))
    if option.positional && StaticSequence.length<string<'static>>(option.choices) == 0 {
      files = true
    }
  }
  return files
}

static fn choiceWords(option: OptionSpec) -> string<'static> {
  let mut words = ""
  static for choice in option.choices {
    if words != "" {
      words = StaticText.concat(words, " ")
    }
    words = StaticText.concat(words, choice)
  }
  return words
}

static fn joinPath(path: string<'static>, label: string<'static>) -> string<'static> {
  if path == "" {
    return label
  }
  return StaticText.concat(StaticText.concat(path, "."), label)
}

// The command name with every byte that a shell function name cannot hold replaced by `_`.
static fn functionName(name: string<'static>) -> string<'static> {
  let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
  let length = StaticText.byteLength(name)
  let mut result = ""
  let mut index: usize = 0
  while index < length {
    let byte = StaticText.byteAt(name, index)
    let mut kept = false
    let mut at: usize = 0
    while at < 63 {
      if StaticText.byteAt(allowed, at) == byte {
        kept = true
      }
      at = at + 1
    }
    if kept {
      result = StaticText.concat(result, StaticText.slice(name, index, index + 1))
    } else {
      result = StaticText.concat(result, "_")
    }
    index = index + 1
  }
  return result
}
