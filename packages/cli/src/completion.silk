//! Shell completion scripts for a command, written during compilation from its description.
//!
//! # When to use
//! Give your program a way to print the script, such as a `--completions bash` option, and tell
//! users to load it: `source <(mytool --completions bash)` in `~/.bashrc`, or the same with `zsh`
//! in `~/.zshrc`.
//!
//! # Details
//! The script completes subcommand names, option names and aliases, and the choices of an option
//! or positional argument (see `Opt.choice`). It follows the subcommands already typed, so
//! `git remote <Tab>` offers the options and subcommands of `remote`. The zsh script loads zsh's
//! bash completion support and uses the bash script.
//!
//! @category Command line

import command { Command, OptionSpec }
import silk.option { Option }
import silk.reflect { Reflect }
import silk.static_sequence { StaticSequence }
import silk.static_text { StaticText }
import silk.writer { Writer, WriterError }

/// The owner type of the completion writers. It has no fields and is never constructed.
pub struct Completion {}

impl Completion {
  /// Writes a bash completion script for `command` and the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeBash<T>(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    let static function = StaticText.concat("_", functionName(command.name))
    run Writer.writeString(function)
    run Writer.writeString("() {\n")
    run Writer.writeString("  local cur prev path words i\n")
    run Writer.writeString("  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n")
    run Writer.writeString("  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n")
    run Writer.writeString("  path=\"\"\n")
    run Writer.writeString("  for ((i = 1; i < COMP_CWORD; i++)); do\n")
    run Writer.writeString("    case \"$path:${COMP_WORDS[i]}\" in\n")
    run writeTransitions<T>(command, "")
    run Writer.writeString("    esac\n")
    run Writer.writeString("  done\n")
    run Writer.writeString("  case \"$path\" in\n")
    run writeWords<T>(command, "")
    run Writer.writeString("  esac\n")
    run Writer.writeString("  case \"$path:$prev\" in\n")
    run writeChoices<T>(command, "")
    run Writer.writeString("  esac\n")
    run Writer.writeString("  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))\n")
    run Writer.writeString("}\n")
    run Writer.writeString("complete -F ")
    run Writer.writeString(function)
    run Writer.writeString(" ")
    run Writer.writeString(command.name)
    run Writer.writeString("\n")
  }

  /// Writes a zsh completion script for `command` and the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeZsh<T>(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("autoload -U +X bashcompinit && bashcompinit\n")
    run Completion.writeBash<T>(command)
  }
}

// Writes one `case` arm per subcommand: typing its name at `at` moves to its path.
effect fn writeTransitions<T>(static command: Command, static at: string<'static>) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      let static below = joinPath(at, option.field)
      run Writer.writeString("      \"")
      run Writer.writeString(at)
      run Writer.writeString(":")
      run Writer.writeString(option.long)
      run Writer.writeString("\") path=\"")
      run Writer.writeString(below)
      run Writer.writeString("\" ;;\n")
      run transitionsBelow(command, below, field)
    }
  }
}

effect fn transitionsBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeTransitions<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at)
}

// Writes the `case` arm of the words that complete at `at`, then the arms of its subcommands.
effect fn writeWords<T>(static command: Command, static at: string<'static>) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("    \"")
  run Writer.writeString(at)
  run Writer.writeString("\") words=\"")
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      run Writer.writeString(option.long)
      run Writer.writeString(" ")
    } else {
      static if option.positional {
        static for choice in option.choices {
          run Writer.writeString(choice)
          run Writer.writeString(" ")
        }
      } else {
        run Writer.writeString(Command.longFlag(option))
        run Writer.writeString(" ")
        static if option.short != "" {
          run Writer.writeString(Command.shortFlag(option))
          run Writer.writeString(" ")
        }
      }
    }
  }
  run Writer.writeString("--help -h")
  static if command.version != "" {
    run Writer.writeString(" --version")
  }
  run Writer.writeString("\" ;;\n")
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      run wordsBelow(command, joinPath(at, option.field), field)
    }
  }
}

effect fn wordsBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeWords<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at)
}

// Writes one `case` arm per option with choices: after the option, only its choices complete.
effect fn writeChoices<T>(static command: Command, static at: string<'static>) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      run choicesBelow(command, joinPath(at, option.field), field)
    } else {
      static if !option.positional && StaticSequence.length<string<'static>>(option.choices) != 0 {
        run Writer.writeString("    \"")
        run Writer.writeString(at)
        run Writer.writeString(":")
        run Writer.writeString(Command.longFlag(option))
        static if option.short != "" {
          run Writer.writeString("\"|\"")
          run Writer.writeString(at)
          run Writer.writeString(":")
          run Writer.writeString(Command.shortFlag(option))
        }
        run Writer.writeString("\") words=\"")
        run Writer.writeString(choiceWords(option))
        run Writer.writeString("\" ;;\n")
      }
    }
  }
}

effect fn choicesBelow<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeChoices<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at)
}

static fn choiceWords(option: OptionSpec) -> string<'static> {
  let mut words = ""
  static for choice in option.choices {
    if words != "" {
      words = StaticText.concat(words, " ")
    }
    words = StaticText.concat(words, choice)
  }
  return words
}

static fn joinPath(path: string<'static>, label: string<'static>) -> string<'static> {
  if path == "" {
    return label
  }
  return StaticText.concat(StaticText.concat(path, "."), label)
}

// The command name with every byte that a shell function name cannot hold replaced by `_`.
static fn functionName(name: string<'static>) -> string<'static> {
  let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
  let length = StaticText.byteLength(name)
  let mut result = ""
  let mut index: usize = 0
  while index < length {
    let byte = StaticText.byteAt(name, index)
    let mut kept = false
    let mut at: usize = 0
    while at < 63 {
      if StaticText.byteAt(allowed, at) == byte {
        kept = true
      }
      at = at + 1
    }
    if kept {
      result = StaticText.concat(result, StaticText.slice(name, index, index + 1))
    } else {
      result = StaticText.concat(result, "_")
    }
    index = index + 1
  }
  return result
}
