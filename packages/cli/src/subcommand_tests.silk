import command { Arg, Command, Opt }
import completion { Completion }
import parse { Cli, CliError, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.io.writer { Writer, WriterError }

struct Clone {
  pub url: String,
  pub depth: Option<u32>,
}

struct RemoteAdd {
  pub name: String,
  pub url: String,
}

struct Remote {
  pub verbose: bool,
  pub add: Option<RemoteAdd>,
}

struct Git {
  pub quiet: bool,
  pub clone: Option<Clone>,
  pub remote: Option<Remote>,
}

static fn cloneCommand() -> Command {
  return Command.make("clone", "Copy a repository")
    |> Command.arg(Arg.named("url") |> Arg.describe("Where to copy from") |> Arg.required)
    |> Command.option(Opt.named("depth") |> Opt.describe("How many commits"))
}

static fn remoteCommand() -> Command {
  let add = Command.make("add", "Add a remote") |> Command.arg(Arg.named("name") |> Arg.required)
    |> Command.arg(Arg.named("url") |> Arg.required)
  return Command.make("remote", "Manage remotes")
    |> Command.option(Opt.named("verbose") |> Opt.alias("v"))
    |> Command.subcommand("add", add)
}

static fn git() -> Command {
  return Command.make("git", "A tiny git")
    |> Command.option(Opt.named("quiet") |> Opt.describe("Say less") |> Opt.alias("q"))
    |> Command.subcommand("clone", cloneCommand())
    |> Command.subcommand("remote", remoteCommand())
}

effect fn defaults() -> Git
  ! OutOfMemoryError
  ? &mut Allocator {
  let add = RemoteAdd { name: run String.copy(""), url: run String.copy("") }
  let remote = Remote { verbose: false, add: Option<RemoteAdd>.some(move add) }
  let clone = Clone { url: run String.copy(""), depth: Option<u32>.none() }
  return Git {
    quiet: false,
    clone: Option<Clone>.some(move clone),
    remote: Option<Remote>.some(move remote),
  }
}

effect fn parseGit(arguments: &[string]) -> Parsed<Git>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parse(git(), run defaults(), arguments)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn choosesOneSubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "-q", "clone", "https://example.com/r", "--depth", "1"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.quiet, "root flag before the subcommand")
      match move value.clone {
        Option.Some { value: clone } => {
          run Testing.expect(same(&clone.url, "https://example.com/r"), "clone url")
          match move clone.depth {
            Option.Some { value: depth } => run Testing.expect(depth == 1, "depth")
            Option.None => run Testing.expect(false, "depth is present")
          }
        }
        Option.None => run Testing.expect(false, "clone is chosen")
      }
      match move value.remote {
        Option.Some { value: _ } => run Testing.expect(false, "remote is cleared")
        Option.None => {}
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn nestsSubcommands() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "remote", "-v", "add", "origin", "https://example.com/r"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.remote {
        Option.Some { value: remote } => {
          run Testing.expect(remote.verbose, "remote flag")
          match move remote.add {
            Option.Some { value: add } => {
              run Testing.expect(
                same(&add.name, "origin") && same(&add.url, "https://example.com/r"),
                "add arguments",
              )
            }
            Option.None => run Testing.expect(false, "add is chosen")
          }
        }
        Option.None => run Testing.expect(false, "remote is chosen")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn clearsWithoutSubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.clone {
        Option.Some { value: _ } => run Testing.expect(false, "no clone")
        Option.None => {}
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn reportsSubcommandHelpAndErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let help = ["git", "remote", "add", "--help"]
  match run parseGit(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command } => run Testing.expect(command == "remote.add", "help path")
    _ => run Testing.expect(false, "help")
  }
  let missing = ["git", "clone"]
  match run parseGit(&missing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingRequired { option } } => run Testing.expect(
      option == "<url>",
      "url is required",
    )
    _ => run Testing.expect(false, "missing url")
  }
  let noDefaults = Git { quiet: false, clone: Option<Clone>.none(), remote: Option<Remote>.none() }
  let arguments = ["git", "clone", "x"]
  match run Cli.parse(git(), move noDefaults, &arguments)
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.NoDefaults { command } } => run Testing.expect(
      command == "clone",
      "no defaults",
    )
    _ => run Testing.expect(false, "no defaults")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn captured(out: &Captured, expected: &[u8]) -> bool {
  if out.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < out.length {
    if out.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

test effect fn writesSubcommandHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut root = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>(git(), "") |> Effect.provideMut<Writer>(&mut root)
  run Testing.expect(
    captured(
      &root,
      b"Usage: git [options] <command>\n\nA tiny git\n\nOptions:\n  -q, --quiet          Say less\n  -h, --help           Print this help\n\nCommands:\n  clone                Copy a repository\n  remote               Manage remotes\n",
    ),
    "root help",
  )
  let mut nested = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>(git(), "remote.add") |> Effect.provideMut<Writer>(&mut nested)
  run Testing.expect(
    captured(
      &nested,
      b"Usage: git remote add [options] <name> <url>\n\nAdd a remote\n\nOptions:\n  -h, --help     Print this help\n\nArguments:\n  <name>         (required)\n  <url>          (required)\n",
    ),
    "nested help",
  )
}

struct SetName {
  pub name: String,
}

struct User {
  pub set: Option<SetName>,
}

struct Config {
  pub user: Option<User>,
}

struct Tool {
  pub config: Option<Config>,
}

static fn tool() -> Command {
  let set = Command.make("set", "Set the name") |> Command.arg(Arg.named("name") |> Arg.required)
  let user = Command.make("user", "User settings") |> Command.subcommand("set", set)
  let config = Command.make("config", "Settings") |> Command.subcommand("user", user)
  return Command.make("tool", "") |> Command.subcommand("config", config)
}

effect fn toolDefaults() -> Tool
  ! OutOfMemoryError
  ? &mut Allocator {
  let set = SetName { name: run String.copy("") }
  let user = User { set: Option<SetName>.some(move set) }
  let config = Config { user: Option<User>.some(move user) }
  return Tool { config: Option<Config>.some(move config) }
}

test effect fn nestsThreeLevels() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["tool", "config", "user", "set", "ana"]
  match run Cli.parse(
    tool(),
    run toolDefaults() |> Effect.provideMut<Allocator>(&mut allocator),
    &arguments,
  )
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.config {
        Option.Some { value: config } => {
          match move config.user {
            Option.Some { value: user } => {
              match move user.set {
                Option.Some { value: set } => run Testing.expect(same(&set.name, "ana"), "name")
                Option.None => run Testing.expect(false, "set is chosen")
              }
            }
            Option.None => run Testing.expect(false, "user is chosen")
          }
        }
        Option.None => run Testing.expect(false, "config is chosen")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
  let help = ["tool", "config", "user", "set", "-h"]
  match run Cli.parse(
    tool(),
    run toolDefaults() |> Effect.provideMut<Allocator>(&mut allocator),
    &help,
  )
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command } => run Testing.expect(command == "config.user.set", "help path")
    _ => run Testing.expect(false, "help")
  }
}

test effect fn writesDeepSubcommandHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Tool>(tool(), "config.user.set") |> Effect.provideMut<Writer>(&mut out)
  run Testing.expect(
    captured(
      &out,
      b"Usage: tool config user set [options] <name>\n\nSet the name\n\nOptions:\n  -h, --help     Print this help\n\nArguments:\n  <name>         (required)\n",
    ),
    "deep help",
  )
}

test effect fn writesCompletions() -> ()
  ! AssertionError<'static> | WriterError {
  let mut bash = Captured { bytes: [0; 2048], length: 0 }
  run Completion.writeBash<Git>(git()) |> Effect.provideMut<Writer>(&mut bash)
  run Testing.expect(
    captured(
      &bash,
      b"_git() {\n  local cur prev path words files i\n  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n  path=\"\"\n  files=\"\"\n  for ((i = 1; i < COMP_CWORD; i++)); do\n    case \"$path:${COMP_WORDS[i]}\" in\n      \":clone\") path=\"clone\" ;;\n      \":remote\") path=\"remote\" ;;\n      \"remote:add\") path=\"remote.add\" ;;\n    esac\n  done\n  case \"$path\" in\n    \"\") words=\"--quiet -q clone remote --help -h\" ;;\n    \"clone\") files=1; words=\"--depth --help -h\" ;;\n    \"remote\") words=\"--verbose -v add --help -h\" ;;\n    \"remote.add\") files=1; words=\"--help -h\" ;;\n  esac\n  case \"$path:$prev\" in\n  esac\n  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))\n  if [ -n \"$files\" ]; then\n    COMPREPLY+=($(compgen -f -- \"$cur\"))\n  fi\n}\ncomplete -F _git git\n",
    ),
    "bash script",
  )
  let mut fish = Captured { bytes: [0; 2048], length: 0 }
  run Completion.writeFish<Git>(git()) |> Effect.provideMut<Writer>(&mut fish)
  run Testing.expect(
    captured(
      &fish,
      b"function __git\n  set -l words (commandline -opc)\n  set -l path ''\n  set -l files ''\n  for word in $words[2..-1]\n    switch \"$path:$word\"\n      case ':clone'\n        set path clone\n      case ':remote'\n        set path remote\n      case 'remote:add'\n        set path remote.add\n    end\n  end\n  switch \"$path:$words[-1]\"\n  end\n  switch \"$path\"\n    case ''\n      printf '%s\\n' --quiet -q clone remote --help -h\n    case 'clone'\n      set files 1\n      printf '%s\\n' --depth --help -h\n    case 'remote'\n      printf '%s\\n' --verbose -v add --help -h\n    case 'remote.add'\n      set files 1\n      printf '%s\\n' --help -h\n  end\n  if test -n \"$files\"\n    __fish_complete_path (commandline -ct)\n  end\nend\ncomplete -c git -f -a '(__git)'\n",
    ),
    "fish script",
  )
}
