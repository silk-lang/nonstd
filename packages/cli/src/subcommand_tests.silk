import command { Arg, Command, Opt }
import parse { Cli, CliError, Parsed }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.writer { Writer, WriterError }

struct Clone {
  pub url: String,
  pub depth: Option<u32>,
}

struct RemoteAdd {
  pub name: String,
  pub url: String,
}

struct Remote {
  pub verbose: bool,
  pub add: Option<RemoteAdd>,
}

struct Git {
  pub quiet: bool,
  pub clone: Option<Clone>,
  pub remote: Option<Remote>,
}

static fn cloneCommand() -> Command {
  return Command.make("clone", "Copy a repository")
    |> Command.arg(Arg.named("url") |> Arg.describe("Where to copy from") |> Arg.required)
    |> Command.option(Opt.named("depth") |> Opt.describe("How many commits"))
}

static fn remoteCommand() -> Command {
  let add = Command.make("add", "Add a remote") |> Command.arg(Arg.named("name") |> Arg.required)
    |> Command.arg(Arg.named("url") |> Arg.required)
  return Command.make("remote", "Manage remotes")
    |> Command.option(Opt.named("verbose") |> Opt.alias("v"))
    |> Command.subcommand("add", add)
}

static fn git() -> Command {
  return Command.make("git", "A tiny git")
    |> Command.option(Opt.named("quiet") |> Opt.describe("Say less") |> Opt.alias("q"))
    |> Command.subcommand("clone", cloneCommand())
    |> Command.subcommand("remote", remoteCommand())
}

effect fn defaults() -> Git
  ! OutOfMemoryError
  ? &mut Allocator {
  let add = RemoteAdd { name: run String.copy(""), url: run String.copy("") }
  let remote = Remote { verbose: false, add: Option<RemoteAdd>.some(move add) }
  let clone = Clone { url: run String.copy(""), depth: Option<u32>.none() }
  return Git {
    quiet: false,
    clone: Option<Clone>.some(move clone),
    remote: Option<Remote>.some(move remote),
  }
}

effect fn parseGit(arguments: &[string]) -> Parsed<Git>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parse(git(), run defaults(), arguments)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn choosesOneSubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "-q", "clone", "https://example.com/r", "--depth", "1"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.quiet, "root flag before the subcommand")
      match move value.clone {
        Option.Some { value: clone } => {
          run Testing.expect(same(&clone.url, "https://example.com/r"), "clone url")
          match move clone.depth {
            Option.Some { value: depth } => run Testing.expect(depth == 1, "depth")
            Option.None => run Testing.expect(false, "depth is present")
          }
        }
        Option.None => run Testing.expect(false, "clone is chosen")
      }
      match move value.remote {
        Option.Some { value: _ } => run Testing.expect(false, "remote is cleared")
        Option.None => {}
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn nestsSubcommands() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "remote", "-v", "add", "origin", "https://example.com/r"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.remote {
        Option.Some { value: remote } => {
          run Testing.expect(remote.verbose, "remote flag")
          match move remote.add {
            Option.Some { value: add } => {
              run Testing.expect(
                same(&add.name, "origin") && same(&add.url, "https://example.com/r"),
                "add arguments",
              )
            }
            Option.None => run Testing.expect(false, "add is chosen")
          }
        }
        Option.None => run Testing.expect(false, "remote is chosen")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn clearsWithoutSubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.clone {
        Option.Some { value: _ } => run Testing.expect(false, "no clone")
        Option.None => {}
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn reportsSubcommandHelpAndErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let help = ["git", "remote", "add", "--help"]
  match run parseGit(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command } => run Testing.expect(command == "remote.add", "help path")
    _ => run Testing.expect(false, "help")
  }
  let missing = ["git", "clone"]
  match run parseGit(&missing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingRequired { option } } => run Testing.expect(
      option == "<url>",
      "url is required",
    )
    _ => run Testing.expect(false, "missing url")
  }
  let noDefaults = Git { quiet: false, clone: Option<Clone>.none(), remote: Option<Remote>.none() }
  let arguments = ["git", "clone", "x"]
  match run Cli.parse(git(), move noDefaults, &arguments)
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.NoDefaults { command } } => run Testing.expect(
      command == "clone",
      "no defaults",
    )
    _ => run Testing.expect(false, "no defaults")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn captured(out: &Captured, expected: &[u8]) -> bool {
  if out.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < out.length {
    if out.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

test effect fn writesSubcommandHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut root = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>(git(), "") |> Effect.provideMut<Writer>(&mut root)
  run Testing.expect(
    captured(
      &root,
      b"Usage: git [options] <command>\n\nA tiny git\n\nOptions:\n  -q, --quiet          Say less\n  -h, --help           Print this help\n\nCommands:\n  clone                Copy a repository\n  remote               Manage remotes\n",
    ),
    "root help",
  )
  let mut nested = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>(git(), "remote.add") |> Effect.provideMut<Writer>(&mut nested)
  run Testing.expect(
    captured(
      &nested,
      b"Usage: git remote add [options] <name> <url>\n\nAdd a remote\n\nOptions:\n  -h, --help     Print this help\n\nArguments:\n  <name>         (required)\n  <url>          (required)\n",
    ),
    "nested help",
  )
}
