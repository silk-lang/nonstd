//! Parse a command line into a struct, and write the help text of a command.
//!
//! # When to use
//! Call [`Cli.fromHost`] from `main` to read the process arguments, or [`Cli.parse`] to parse a list of
//! arguments that you already have, such as in a test.
//!
//! # Details
//! The command description and the struct are checked against each other during compilation. The
//! loop over the struct fields is expanded during compilation too, so the parser that runs only
//! compares each argument with the option names and calls the reader of the matching field type.
//!
//! The parser accepts `--name value`, `--name=value`, `-n value`, `-n5`, flags such as `--loud`,
//! grouped one-letter flags such as `-abc`, positional arguments, and `--`, after which every
//! argument is positional. `--help` and `-h` give
//! [`Parsed.Help`], and `--version` gives [`Parsed.Version`] when the command has a version.
//!
//! # Gotchas
//! A command struct has at most 64 fields.
//!
//! @category Command line

import command { Command, OptionSpec }
import value { ArgValue }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.host_input { HostInput, HostInputError }
import silk.list { List }
import silk.option { Option }
import silk.ownership { Copy }
import silk.pointer { Pointer }
import silk.reflect { Reflect, labeledFieldKind, namedKind }
import silk.result { Result }
import silk.static_sequence { StaticSequence }
import silk.static_text { StaticText }
import silk.string { String }
import silk.writer { Writer, WriterError }

/// Why a command line was not accepted.
pub union CliError {
  /// An argument looks like an option, but no option has that name.
  UnknownOption {
    /// The argument as given.
    pub token: String
  },
  /// An option that takes a value is the last argument.
  MissingValue {
    /// The option, such as `--name`.
    pub option: string<'static>
  },
  /// The value of an option or positional argument is not one of its choices.
  NotAChoice {
    /// The option, such as `--format`, or the positional argument, such as `<format>`.
    pub option: string<'static>,
    /// The value as given.
    pub token: String,
    /// The choices, separated by commas, such as `json, text`.
    pub choices: string<'static>
  },
  /// The value of an option or positional argument is not valid for its field type.
  InvalidValue {
    /// The option, such as `--times`, or the positional argument, such as `<files>`.
    pub option: string<'static>,
    /// The value as given.
    pub token: String
  },
  /// A flag was given a value with `=`.
  UnexpectedValue {
    /// The flag, such as `--loud`.
    pub option: string<'static>
  },
  /// A required option or positional argument is missing.
  MissingRequired {
    /// The option, such as `--name`, or the positional argument, such as `<files>`.
    pub option: string<'static>
  },
  /// There are more positional arguments than the command takes.
  UnexpectedArgument {
    /// The argument as given.
    pub token: String
  },
  /// The command line chose a subcommand whose field had `none` in the defaults. Give every
  /// subcommand field `Option.some(defaults)`.
  NoDefaults {
    /// The subcommand path, such as `remote.add`.
    pub command: string<'static>
  },
  /// An argument is not valid UTF-8.
  InvalidText {
    /// The position of the argument; 0 is the program name.
    pub index: usize
  }
}

/// The result of parsing a command line.
pub union Parsed<T> {
  /// The command line was accepted. `value` holds the parsed fields.
  Run {
    /// The parsed struct.
    pub value: T
  },
  /// The command line asked for the help text.
  Help {
    /// The subcommand path whose help was asked for, such as `remote.add`. Empty for the root
    /// command. Give it to [`Cli.writeHelp`].
    pub command: string<'static>
  },
  /// The command line asked for the version.
  Version,
  /// The command line was not accepted.
  Failed {
    /// Why.
    pub error: CliError
  }
}

/// One environment variable, for [`Cli.parseWith`].
pub struct Variable<'a> {
  /// The variable name, such as `HOME`.
  pub name: string<'a>,
  /// The variable value.
  pub value: string<'a>,
}

impl<'a> Copy for Variable<'a> {}

/// The owner type of the parser. It has no fields and is never constructed.
pub struct Cli {}

impl Cli {
  /// Parses `arguments` into a copy of `defaults`, as `command` describes. `arguments[0]` is the
  /// program name and is skipped.
  ///
  /// # Details
  ///
  /// Each field of `T` is an option unless `command` marks it positional. A field that the
  /// command line does not give keeps its value from `defaults`. A description that names a field
  /// `T` does not have, or a field type without `ArgValue`, is a compile error.
  pub effect fn parse<T>(static command: Command, defaults: T, arguments: &[string]) -> Parsed<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let environment: [Variable<'static>; 0] = []
    return run parseFrom<T>(command, "", move defaults, arguments, &environment, 1)
  }

  /// Parses like [`Cli.parse`], and reads an option that the command line does not give from
  /// `environment` when the option names a variable with `Opt.env`. The command line wins over the
  /// environment, and the environment wins over `defaults`.
  pub effect fn parseWith<T>(
    static command: Command,
    defaults: T,
    arguments: &[string],
    environment: &[Variable],
  ) -> Parsed<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run parseFrom<T>(command, "", move defaults, arguments, environment, 1)
  }

  /// Reads the process arguments, and the environment variables that `command` names, and parses
  /// them with [`Cli.parseWith`].
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the arguments cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  pub effect fn fromHost<T>(static command: Command, defaults: T) -> Parsed<T>
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let raw = run HostInput.arguments()
    let mut texts = List<string>.make()
    let mut index: usize = 0
    while index < List<Bytes>.length(&raw) {
      match HostInput.text(Bytes.asSlice(&List<Bytes>.asSlice(&raw)[index])) {
        Result.Success { value: text } => {
          run List<string>.append(&mut texts, text)
        }
        Result.Failure { error: _ } => {
          return Parsed<T>.Failed { error: CliError.InvalidText { index: index } }
        }
      }
      index = index + 1
    }
    let mut names = List<string>.make()
    let mut found = List<Bytes>.make()
    static for name in environmentNames(command) {
      match run HostInput.variableNamed(name) {
        Option.Some { value: bytes } => {
          run List<string>.append(&mut names, name)
          run List<Bytes>.append(&mut found, move bytes)
        }
        Option.None => {}
      }
    }
    let mut environment = List<Variable>.make()
    let mut at: usize = 0
    while at < List<Bytes>.length(&found) {
      match HostInput.text(Bytes.asSlice(&List<Bytes>.asSlice(&found)[at])) {
        Result.Success { value: text } => {
          let variable = Variable { name: List<string>.asSlice(&names)[at], value: text }
          run List<Variable>.append(&mut environment, variable)
        }
        Result.Failure { error: _ } => {}
      }
      at = at + 1
    }
    return run Cli.parseWith(
      command,
      move defaults,
      List<string>.asSlice(&texts),
      List<Variable>.asSlice(&environment),
    )
  }

  /// Writes the help text of the command or subcommand at `path` (from [`Parsed.Help`]; empty
  /// for the root command) of `command`, for the struct `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeHelp<T>(static command: Command, path: string) -> ()
    ! WriterError
    ? &mut Writer {
    return run writeHelpAt<T>(command, "", path)
  }

  /// Writes `command`'s version and a line break.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeVersion(static command: Command) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString(command.name)
    run Writer.writeString(" ")
    run Writer.writeString(command.version)
    run Writer.writeString("\n")
  }

  /// Writes a one-line message for `error`, such as `error: unknown option --nmae`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeError(error: &CliError) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("error: ")
    match &error.* {
      CliError.UnknownOption { token } => {
        run Writer.writeString("unknown option ")
        run Writer.writeString(String.view(&token))
      }
      CliError.MissingValue { option } => {
        run Writer.writeString(option)
        run Writer.writeString(" needs a value")
      }
      CliError.NotAChoice { option, token, choices } => {
        run Writer.writeString("invalid value '")
        run Writer.writeString(String.view(&token))
        run Writer.writeString("' for ")
        run Writer.writeString(option)
        run Writer.writeString(" (choose from ")
        run Writer.writeString(choices)
        run Writer.writeString(")")
      }
      CliError.InvalidValue { option, token } => {
        run Writer.writeString("invalid value '")
        run Writer.writeString(String.view(&token))
        run Writer.writeString("' for ")
        run Writer.writeString(option)
      }
      CliError.UnexpectedValue { option } => {
        run Writer.writeString(option)
        run Writer.writeString(" takes no value")
      }
      CliError.MissingRequired { option } => {
        run Writer.writeString("missing ")
        run Writer.writeString(option)
      }
      CliError.UnexpectedArgument { token } => {
        run Writer.writeString("unexpected argument ")
        run Writer.writeString(String.view(&token))
      }
      CliError.NoDefaults { command } => {
        run Writer.writeString("the defaults have no value for the subcommand ")
        run Writer.writeString(command)
      }
      CliError.InvalidText { index: _ } => {
        run Writer.writeString("an argument is not valid UTF-8")
      }
    }
    run Writer.writeString("\n")
  }
}

effect fn parseFrom<T>(
  static command: Command,
  static path: string<'static>,
  defaults: T,
  arguments: &[string],
  environment: &[Variable],
  start: usize,
) -> Parsed<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  static if Reflect.typeKind(Reflect.typeOf<T>()) != namedKind {
    compileError("Cli.parse needs a struct with named fields")
  }
  static if !Command.validate<T>(command) {
    compileError("the command description does not match its struct")
  }
  let mut value = move defaults
  let mut seen = [false; 64]
  let mut positionalOnly = false
  let mut positional: usize = 0
  let mut index = start
  while index < arguments.length {
    let token = arguments[index]
    index = index + 1
    if !positionalOnly && token == "--" {
      positionalOnly = true
      continue
    }
    if !positionalOnly && (token == "--help" || token == "-h") {
      return Parsed<T>.Help { command: path }
    }
    static if command.version != "" {
      if !positionalOnly && token == "--version" {
        return Parsed<T>.Version
      }
    }
    if !positionalOnly && String.startsWith(token, "-") && token != "-" {
      if String.startsWith(token, "--") || String.byteLength(token) == 2 {
        let mut name = token
        let mut hasInline = false
        let mut inline = ""
        if String.startsWith(token, "--") {
          match String.find(token, "=") {
            Option.Some { value: at } => {
              name = String.slice(token, 0, at)
              hasInline = true
              inline = String.slice(token, at + 1, String.byteLength(token) - at - 1)
            }
            Option.None => {}
          }
        }
        let applied = run applyOption<T>(
          command,
          &mut value,
          &mut seen,
          name,
          false,
          inline,
          hasInline,
          arguments,
          &mut index,
        )
        match move applied {
          Applied.Unknown => {
            return Parsed<T>.Failed {
              error: CliError.UnknownOption { token: run String.copy(token) }
            }
          }
          Applied.Failed { error } => {
            return Parsed<T>.Failed { error: move error }
          }
          _ => {}
        }
        continue
      }

      // A group of one-letter options, such as `-abc`. An option that takes a value takes the rest
      // of the group, such as `-n5`, or else the next argument.
      let length = String.byteLength(token)
      let mut at: usize = 1
      while at < length {
        if String.utf8Bytes(token)[at] >= 128 {
          return Parsed<T>.Failed {
            error: CliError.UnknownOption { token: run String.copy(token) }
          }
        }
        let letter = String.slice(token, at, 1)
        let rest = String.slice(token, at + 1, length - at - 1)
        let applied = run applyOption<T>(
          command,
          &mut value,
          &mut seen,
          letter,
          true,
          rest,
          rest != "",
          arguments,
          &mut index,
        )
        match move applied {
          Applied.Flag => {
            at = at + 1
          }
          Applied.Value => {
            at = length
          }
          Applied.Unknown => {
            return Parsed<T>.Failed {
              error: CliError.UnknownOption { token: run String.copy(token) }
            }
          }
          Applied.Failed { error } => {
            return Parsed<T>.Failed { error: move error }
          }
        }
      }
      continue
    }
    static if Command.subcommandCount(command) != 0 {
      static for field in Reflect.fields<T>() {
        let static option = Command.find(command, Reflect.fieldLabel(field))
        static if option.subcommand {
          let static name = option.long
          if token == name {
            let fromEnvironment = run applyEnvironment<T>(
              command,
              &mut value,
              &mut seen,
              environment,
            )
            match move fromEnvironment {
              Option.Some { value: error } => {
                return Parsed<T>.Failed { error: move error }
              }
              Option.None => {}
            }
            let missing = run missingRequired<T>(command, &seen)
            match move missing {
              Option.Some { value: error } => {
                return Parsed<T>.Failed { error: move error }
              }
              Option.None => {}
            }
            static for other in Reflect.fields<T>() {
              let static sibling = Command.find(command, Reflect.fieldLabel(other))
              static if sibling.subcommand && sibling.field != option.field {
                clearSubcommand(&mut value, other)
              }
            }
            return run enter(command, path, field, move value, arguments, environment, index)
          }
        }
      }
    }
    let mut taken = false
    static for field in Reflect.fields<T>() {
      let static option = Command.find(command, Reflect.fieldLabel(field))
      static if option.positional {
        let static at = Command.position(command, option.field)
        let static slot = fieldIndex<T>(Reflect.fieldLabel(field))
        if !taken && (positional == at || (repeats(field) && positional > at)) {
          taken = true
          seen[slot] = true
          static if StaticSequence.length<string<'static>>(option.choices) != 0 {
            if !isChoice(option, token) {
              let static name = Command.placeholder(option)
              return Parsed<T>.Failed {
                error: CliError.NotAChoice {
                  option: name,
                  token: run String.copy(token),
                  choices: choiceList(option),
                }
              }
            }
          }
          let place = fieldMut(&mut value, field)
          let accepted = run ArgValue.accept(&mut place, token)
          if !accepted {
            let static name = Command.placeholder(option)
            return Parsed<T>.Failed {
              error: CliError.InvalidValue { option: name, token: run String.copy(token) }
            }
          }
        }
      }
    }
    if !taken {
      return Parsed<T>.Failed {
        error: CliError.UnexpectedArgument { token: run String.copy(token) }
      }
    }
    positional = positional + 1
  }
  let fromEnvironment = run applyEnvironment<T>(command, &mut value, &mut seen, environment)
  match move fromEnvironment {
    Option.Some { value: error } => {
      return Parsed<T>.Failed { error: move error }
    }
    Option.None => {}
  }
  let missing = run missingRequired<T>(command, &seen)
  match move missing {
    Option.Some { value: error } => {
      return Parsed<T>.Failed { error: move error }
    }
    Option.None => {}
  }
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      clearSubcommand(&mut value, field)
    }
  }
  return Parsed<T>.Run { value: move value }
}

// How one option of a command line was applied.
union Applied {
  Flag,
  Value,
  Unknown,
  Failed { error: CliError }
}

// Applies the option `name` to `value`: a long name or an alias with its dash, or with `letter`, an
// alias letter alone. `attached` is the text after `=` or after the letter, if any.
effect fn applyOption<T>(
  static command: Command,
  value: &mut T,
  seen: &mut [bool; 64],
  name: string,
  letter: bool,
  attached: string,
  hasAttached: bool,
  arguments: &[string],
  index: &mut usize,
) -> Applied
  ! OutOfMemoryError
  ? &mut Allocator {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if !option.positional && !option.subcommand {
      let static long = Command.longFlag(option)
      let static short = Command.shortFlag(option)
      let static slot = fieldIndex<T>(Reflect.fieldLabel(field))
      let mut hit = false
      if letter {
        hit = option.short != "" && name == option.short
      } else {
        hit = name == long || (short != "" && name == short)
      }
      if hit {
        seen[slot] = true
        let place = fieldMut(&mut value, field)
        if takesValue(field) {
          let mut text = attached
          if hasAttached {
            if letter && String.startsWith(attached, "=") {
              text = String.slice(attached, 1, String.byteLength(attached) - 1)
            }
          } else {
            if index.* >= arguments.length {
              return Applied.Failed { error: CliError.MissingValue { option: long } }
            }
            text = arguments[index.*]
            index.* = index.* + 1
          }
          static if StaticSequence.length<string<'static>>(option.choices) != 0 {
            if !isChoice(option, text) {
              return Applied.Failed {
                error: CliError.NotAChoice {
                  option: long,
                  token: run String.copy(text),
                  choices: choiceList(option),
                },
              }
            }
          }
          let accepted = run ArgValue.accept(&mut place, text)
          if !accepted {
            return Applied.Failed {
              error: CliError.InvalidValue { option: long, token: run String.copy(text) },
            }
          }
          return Applied.Value
        }
        if hasAttached && !letter {
          return Applied.Failed { error: CliError.UnexpectedValue { option: long } }
        }
        let flagged = run ArgValue.accept(&mut place, "")
        return Applied.Flag
      }
    }
  }
  return Applied.Unknown
}

// Reads every option that the command line did not give and that names an environment variable
// from `environment`. A flag is set unless its variable is empty, `0`, or `false`.
effect fn applyEnvironment<T>(
  static command: Command,
  value: &mut T,
  seen: &mut [bool; 64],
  environment: &[Variable],
) -> Option<CliError>
  ! OutOfMemoryError
  ? &mut Allocator {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.env != "" && !option.positional && !option.subcommand {
      let static long = Command.longFlag(option)
      let static slot = fieldIndex<T>(Reflect.fieldLabel(field))
      let mut at: usize = 0
      while !seen[slot] && at < environment.length {
        if environment[at].name == option.env {
          let text = environment[at].value
          let place = fieldMut(&mut value, field)
          if takesValue(field) {
            seen[slot] = true
            static if StaticSequence.length<string<'static>>(option.choices) != 0 {
              if !isChoice(option, text) {
                return Option<CliError>.some(
                  CliError.NotAChoice {
                    option: option.env,
                    token: run String.copy(text),
                    choices: choiceList(option),
                  },
                )
              }
            }
            let accepted = run ArgValue.accept(&mut place, text)
            if !accepted {
              return Option<CliError>.some(
                CliError.InvalidValue { option: option.env, token: run String.copy(text) },
              )
            }
          } else {
            if text != "" && text != "0" && text != "false" {
              seen[slot] = true
              let flagged = run ArgValue.accept(&mut place, "")
            }
          }
        }
        at = at + 1
      }
    }
  }
  return Option<CliError>.none()
}

fn isChoice(static option: OptionSpec, text: string) -> bool {
  static for choice in option.choices {
    if text == choice {
      return true
    }
  }
  return false
}

static fn choiceList(option: OptionSpec) -> string<'static> {
  let mut list = ""
  static for choice in option.choices {
    if list != "" {
      list = StaticText.concat(list, ", ")
    }
    list = StaticText.concat(list, choice)
  }
  return list
}

// The environment variables that `command` and its subcommands name, without repeats.
static fn environmentNames(command: Command) -> Intrinsic.StaticSequence<string<'static>> {
  let mut names = StaticSequence.empty<string<'static>>()
  static for option in command.options {
    if option.env != "" {
      names = withName(names, option.env)
    }
  }
  static for option in command.nested {
    if option.env != "" {
      names = withName(names, option.env)
    }
  }
  return names
}

static fn withName(
  names: Intrinsic.StaticSequence<string<'static>>,
  name: string<'static>,
) -> Intrinsic.StaticSequence<string<'static>> {
  static for known in names {
    if known == name {
      return names
    }
  }
  return StaticSequence.append<string<'static>>(names, name)
}

effect fn missingRequired<T>(static command: Command, seen: &[bool; 64]) -> Option<CliError> {
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.required {
      let static slot = fieldIndex<T>(Reflect.fieldLabel(field))
      if !seen[slot] {
        static if option.positional {
          let static name = Command.placeholder(option)
          return Option<CliError>.some(CliError.MissingRequired { option: name })
        } else {
          let static name = Command.longFlag(option)
          return Option<CliError>.some(CliError.MissingRequired { option: name })
        }
      }
    }
  }
  return Option<CliError>.none()
}

// Parses the rest of the command line into the subcommand in `field`, and puts the parsed
// subcommand back into `owner`. It recurses through `parseFrom` for nested subcommands.
effect fn enter<Owner, Sub>(
  static command: Command,
  static path: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
  owner: Owner,
  arguments: &[string],
  environment: &[Variable],
  start: usize,
) -> Parsed<Owner>
  ! OutOfMemoryError
  ? &mut Allocator {
  let static label = Reflect.fieldLabel(field)
  let static subPath = joinPath(path, label)
  let mut value = move owner
  let place = fieldMut(&mut value, field)
  let defaults = Intrinsic.replace(place.*, Option<Sub>.none())
  match move defaults {
    Option.None => {
      return Parsed<Owner>.Failed { error: CliError.NoDefaults { command: subPath } }
    }
    Option.Some { value: subDefaults } => {
      let parsed = run parseFrom<Sub>(
        Command.scoped(command, label),
        subPath,
        move subDefaults,
        arguments,
        environment,
        start,
      )
      match move parsed {
        Parsed.Run { value: sub } => {
          let slot = fieldMut(&mut value, field)
          slot.* = Option<Sub>.some(move sub)
          return Parsed<Owner>.Run { value: move value }
        }
        Parsed.Help { command: asked } => {
          return Parsed<Owner>.Help { command: asked }
        }
        Parsed.Version => {
          return Parsed<Owner>.Version
        }
        Parsed.Failed { error } => {
          return Parsed<Owner>.Failed { error: move error }
        }
      }
    }
  }
}

fn clearSubcommand<Owner, Sub>(
  owner: &mut Owner,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
) -> () {
  let place = fieldMut(&mut owner, field)
  place.* = Option<Sub>.none()
}

static fn joinPath(path: string<'static>, label: string<'static>) -> string<'static> {
  if path == "" {
    return label
  }
  return StaticText.concat(StaticText.concat(path, "."), label)
}

effect fn writeHelpAt<T>(static command: Command, static at: string<'static>, path: string) -> ()
  ! WriterError
  ? &mut Writer {
  if path == at {
    return run writeCommandHelp<T>(command)
  }
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if option.subcommand {
      let static below = joinPath(at, option.field)
      if path == below || String.startsWith(path, StaticText.concat(below, ".")) {
        return run writeSubcommandHelp(command, below, field, path)
      }
    }
  }
  return run writeCommandHelp<T>(command)
}

effect fn writeSubcommandHelp<Owner, Sub>(
  static command: Command,
  static at: string<'static>,
  static field: Intrinsic.Field<Owner, Option<Sub>>,
  path: string,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeHelpAt<Sub>(Command.scoped(command, Reflect.fieldLabel(field)), at, path)
}

effect fn writeCommandHelp<T>(static command: Command) -> ()
  ! WriterError
  ? &mut Writer {
  let static usage = usageLine<T>(command)
  run Writer.writeString(usage)
  static if command.description != "" {
    run Writer.writeString("\n")
    run Writer.writeString(command.description)
    run Writer.writeString("\n")
  }
  run Writer.writeString("\nOptions:\n")
  static for field in Reflect.fields<T>() {
    let static option = Command.find(command, Reflect.fieldLabel(field))
    static if !option.positional && !option.subcommand {
      let static short = Command.shortFlag(option)
      let static long = Command.longFlag(option)
      let mut width: usize = 6 + String.byteLength(long)
      static if short != "" {
        run Writer.writeString("  ")
        run Writer.writeString(short)
        run Writer.writeString(", ")
      } else {
        run Writer.writeString("      ")
      }
      run Writer.writeString(long)
      if takesValue(field) {
        run Writer.writeString(" <value>")
        width = width + 8
      }
      static if hasNotes(option) {
        run pad(width, optionColumn<T>(command))
      }
      run Writer.writeString(option.description)
      static if option.required {
        run Writer.writeString(" (required)")
      }
      run writeNotes(option)
      run Writer.writeString("\n")
    }
  }
  run Writer.writeString("  -h, --help")
  run pad(12, optionColumn<T>(command))
  run Writer.writeString("Print this help\n")
  static if command.version != "" {
    run Writer.writeString("      --version")
    run pad(15, optionColumn<T>(command))
    run Writer.writeString("Print the version\n")
  }
  static if Command.positionalCount(command) != 0 {
    run Writer.writeString("\nArguments:\n")
    static for field in Reflect.fields<T>() {
      let static option = Command.find(command, Reflect.fieldLabel(field))
      static if option.positional {
        let static name = Command.placeholder(option)
        run Writer.writeString("  ")
        run Writer.writeString(name)
        static if hasNotes(option) {
          run pad(2 + String.byteLength(name), optionColumn<T>(command))
        }
        run Writer.writeString(option.description)
        static if option.required {
          static if option.description == "" {
            run Writer.writeString("(required)")
          } else {
            run Writer.writeString(" (required)")
          }
        }
        run writeNotes(option)
        run Writer.writeString("\n")
      }
    }
  }
  static if Command.subcommandCount(command) != 0 {
    run Writer.writeString("\nCommands:\n")
    static for field in Reflect.fields<T>() {
      let static option = Command.find(command, Reflect.fieldLabel(field))
      static if option.subcommand {
        run Writer.writeString("  ")
        run Writer.writeString(option.long)
        run pad(2 + String.byteLength(option.long), optionColumn<T>(command))
        run Writer.writeString(option.description)
        run Writer.writeString("\n")
      }
    }
  }
}

// Whether the help line of `option` has text after its name.
static fn hasNotes(option: OptionSpec) -> bool {
  return option.description != "" || option.required
    || StaticSequence.length<string<'static>>(option.choices) != 0
    || option.env != ""
}

// Writes the choices and the environment variable of `option` after its help text.
effect fn writeNotes(static option: OptionSpec) -> ()
  ! WriterError
  ? &mut Writer {
  static if StaticSequence.length<string<'static>>(option.choices) != 0 {
    static if option.description != "" || option.required {
      run Writer.writeString(" ")
    }
    run Writer.writeString("[choices: ")
    run Writer.writeString(choiceList(option))
    run Writer.writeString("]")
  }
  static if option.env != "" {
    static if option.description != "" || option.required
      || StaticSequence.length<string<'static>>(option.choices) != 0 {
      run Writer.writeString(" ")
    }
    run Writer.writeString("[env: ")
    run Writer.writeString(option.env)
    run Writer.writeString("]")
  }
}

// The one unsafe step: a shared field borrow, requalified as exclusive. `owner` is exclusive for
// the whole result lifetime, so no other borrow of the field can exist. This waits for a mutable
// field projection in `silk.reflect`.
fn fieldMut<'owner, Owner, Value>(
  owner: &'owner mut Owner,
  static field: Intrinsic.Field<Owner, Value>,
) -> &'owner mut Value {
  let place = Pointer.fromRef<Value>(Reflect.borrowField<Owner, Value>(&owner.*, field))
  unsafe {
    return Pointer.borrowMut<Owner, Value>(
      move owner,
      Intrinsic.pointerRequalify<*const Value, *mut Value>(place),
    )
  }
}

fn takesValue<Owner, Value: ArgValue>(static field: Intrinsic.Field<Owner, Value>) -> bool {
  return ArgValue.takesValue()
}

fn repeats<Owner, Value: ArgValue>(static field: Intrinsic.Field<Owner, Value>) -> bool {
  return ArgValue.repeats()
}

effect fn pad(used: usize, column: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let mut at = used
  if at + 2 > column {
    run Writer.writeString("  ")
    return
  }
  while at < column {
    run Writer.writeString(" ")
    at = at + 1
  }
}

static fn fieldIndex<T>(label: string<'static>) -> usize {
  let mut index: usize = 0
  let mut found: usize = 0
  static for field in Reflect.fields<T>() {
    if Reflect.fieldLabel(field) == label {
      found = index
    }
    index = index + 1
  }
  if index > 64 {
    compileError("a command struct has at most 64 fields")
  }
  return found
}

// The column where option descriptions start: the widest `-n, --long <value>` plus two spaces.
static fn optionColumn<T>(command: Command) -> usize {
  let mut widest: usize = 15
  static for field in Reflect.fields<T>() {
    let option = Command.find(command, Reflect.fieldLabel(field))
    let mut width = 6 + StaticText.byteLength(Command.longFlag(option)) + 8
    if option.subcommand {
      width = 2 + StaticText.byteLength(option.long)
    }
    if option.positional {
      width = 2 + StaticText.byteLength(Command.placeholder(option))
    }
    if width > widest {
      widest = width
    }
  }
  return widest + 2
}

static fn usageLine<T>(command: Command) -> string<'static> {
  let mut line = StaticText.concat(StaticText.concat("Usage: ", command.name), " [options]")
  static for field in Reflect.fields<T>() {
    let option = Command.find(command, Reflect.fieldLabel(field))
    if option.positional {
      line = StaticText.concat(StaticText.concat(line, " "), Command.placeholder(option))
    }
  }
  if Command.subcommandCount(command) != 0 {
    line = StaticText.concat(line, " <command>")
  }
  return StaticText.concat(line, "\n")
}
