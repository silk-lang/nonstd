//! A declarative command-line parser: describe a command with a struct or a union and a static description,
//! and get a parser and help text that are planned during compilation.
//!
//! Import the parts from `cli.command`, `cli.parse`, and `cli.value`, or all of them from here.
//!
//! @category Command line

pub import command { Command, CommandLine, Opt, OptionSpec, VariantSpec }
pub import completion { Completion }
pub import parse { Cli, CliError, Parsed, Variable }
pub import value { ArgValue, FromArg }
