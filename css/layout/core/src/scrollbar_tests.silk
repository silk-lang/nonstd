import fragmentation { FragmentationError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.usize
import text { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import style { Style, Dimension, Overflow, Position }
import geometry { Measure, MeasureRequest, Measured, BaselineSet, NaturalDimensions, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, Size, Rect, Point, OptionalSize }
import tree { Tree, LayoutTree, InvalidNode }
import engine { compute, repositionScroll }

struct Host { horizontal: f32, vertical: f32 }
impl Measure for Host {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop request
    return ScrollbarMetrics { horizontal: provider.horizontal, vertical: provider.vertical, overlay: false, horizontalOnTop: false, verticalOnLeft: false }
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest) -> Measured {
    drop provider
    drop key
    let mut size = Size.zero()
    if request.known.widthDefinite { size.width = request.known.width }
    if request.known.heightDefinite { size.height = request.known.height }
    return Measured { size: size, contentBlockSize: 0.0, firstBaselines: BaselineSet.zero(), lastBaselines: BaselineSet.zero(), hasBaseline: false, hasLineBoxes: false, scrollableOverflow: Rect.zero() }
  }
}
impl TextMeasure for Host {
  fn beginTextLayout(provider: &mut Self) { drop provider }
  effect fn analyze(provider: &mut Self, context: TextContext, output: &mut List<TextBreak>) -> TextAnalysis ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if context.tokens.length > 0 { source = context.tokens[0].source }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }
  effect fn shape(provider: &mut Self, request: TextShapeRequest, output: &mut List<TextRun>) ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if request.start.unit < request.context.tokens.length { source = request.context.tokens[request.start.unit].source }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }
}

test effect fn providerReplacementAndExactFitClearPriorScrollbarSelection() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(100.0)
  style.height = Dimension.px(100.0)
  style.overflowX = Overflow.Auto
  style.overflowY = Overflow.Auto
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut childStyle = Style.make()
  childStyle.width = Dimension.px(100.0)
  childStyle.height = Dimension.px(101.0)
  let child = run tree.append(root, move childStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut original = Host { horizontal: 12.0, vertical: 15.0 }
  run compute(&tree, &mut output, &mut original, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = output.boxes.get(output.firstBySource.get(root.index))
  run Testing.expect(first.contentSize.width == 85.0 && first.contentSize.height == 88.0 && first.horizontalScrollbar && first.verticalScrollbar, "vertical overflow induces the other scrollbar through reduced content space")
  let mut replacement = Host { horizontal: 7.0, vertical: 5.0 }
  run compute(&tree, &mut output, &mut replacement, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = output.boxes.get(output.firstBySource.get(root.index))
  run Testing.expect(second.contentSize.width == 95.0 && second.contentSize.height == 93.0 && second.scrollbarGutter.right == 5.0 && second.scrollbarGutter.bottom == 7.0, "replacing the host refreshes scrollbar metrics without modifying the tree")
  let childStyleIndex = tree.nodes.asSlice()[child.index].styleIndex
  let styles = tree.styles.asMutSlice()
  styles[childStyleIndex].height = Dimension.px(100.0)
  drop styles
  run compute(&tree, &mut output, &mut replacement, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let exact = output.boxes.get(output.firstBySource.get(root.index))
  run Testing.expect(exact.contentSize.width == 100.0 && exact.contentSize.height == 100.0 && !exact.horizontalScrollbar && !exact.verticalScrollbar && exact.scrollbarGutter.horizontal() == 0.0 && exact.scrollbarGutter.vertical() == 0.0, "a new compute starts without stale auto bars even though those bars would perpetuate overflow")
}

// Differential regression: retained scroll positioning must match a complete layout,
// including nested scrollports, relative/sticky offsets, fixed boxes and clamping.
effect fn retainedScrolling(overflow: Overflow) ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(300.0)
  style.height = Dimension.px(200.0)
  style.overflowY = overflow
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut containerStyle = Style.make()
  containerStyle.height = Dimension.px(400.0)
  containerStyle.overflowY = overflow
  containerStyle.position = Position.Relative
  containerStyle.inset.left = Dimension.px(12.0)
  let container = run tree.append(root, move containerStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut stickyStyle = Style.make()
  stickyStyle.position = Position.Sticky
  stickyStyle.inset.top = Dimension.px(8.0)
  stickyStyle.height = Dimension.px(30.0)
  drop run tree.append(container, move stickyStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut tall = Style.make()
  tall.height = Dimension.px(900.0)
  drop run tree.append(container, move tall) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fixed = Style.make()
  fixed.position = Position.Fixed
  fixed.inset.top = Dimension.px(20.0)
  fixed.height = Dimension.px(12.0)
  drop run tree.append(container, move fixed) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut absolute = Style.make()
  absolute.position = Position.Absolute
  absolute.inset.bottom = Dimension.px(10.0)
  absolute.height = Dimension.px(20.0)
  drop run tree.append(container, move absolute) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut host = Host { horizontal: 12.0, vertical: 15.0 }
  let viewport = OptionalSize.definite(300.0, 200.0)
  let mut output = LayoutTree.make()
  run compute(&tree, &mut output, &mut host, viewport) |> Effect.provideMut<Allocator>(&mut allocator)
  let offsets: [f32; 5] = [40.0, 110.0, 10000.0, -20.0, 0.0]
  let mut step: usize = 0
  while step < 5 {
    run tree.setScrollOffset(container, Point { x: 0.0, y: offsets[step] })
    run tree.setScrollOffset(root, Point { x: 0.0, y: offsets[step] * 0.5 })
    let reused = run repositionScroll(&tree, &mut output, viewport) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(reused && output.stats.fullLayouts == 0, "scrolling must reuse geometry without full layouts")
    output.fragments.resolveLocations()
    let mut fresh = LayoutTree.make()
    run compute(&tree, &mut fresh, &mut host, viewport) |> Effect.provideMut<Allocator>(&mut allocator)
    fresh.fragments.resolveLocations()
    run Testing.expect(output.fragments.values.length() == fresh.fragments.values.length(), "same fragment count")
    let mut i: usize = 0
    while i < output.fragments.values.length() {
      let a = output.fragments.values.get(i)
      let b = fresh.fragments.values.get(i)
      run Testing.expect(a.worldLocation.x == b.worldLocation.x && a.worldLocation.y == b.worldLocation.y && a.size.width == b.size.width && a.size.height == b.size.height, "retained scroll geometry matches fresh layout")
      i = i + 1
    }
    step = step + 1
  }
  output.invalidate()
  run Testing.expect(!(run repositionScroll(&tree, &mut output, viewport) |> Effect.provideMut<Allocator>(&mut allocator)), "invalidated geometry cannot be reused")
}


test effect fn retainedScrollingMatchesFreshLayout() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  run retainedScrolling(Overflow.Auto)
  run retainedScrolling(Overflow.Scroll)
}
