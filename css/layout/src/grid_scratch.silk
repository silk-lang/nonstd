import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.box { Box }
import silk.num.usize
import silk.num.i32
import grid_lines { GridSpan }
import grid_placement { GridItem, GridBounds, PlacementScratch }
import grid_tracks { TrackState, TrackContribution, TrackPolicy }
import grid_lines { LineNames }
import grid_template { ExpandedAxis }
import grid_baselines { GridBaselines }
import grid_fragment_scratch { GridFragmentScratch }
import grid_style { GridArea }
import grid_subgrid { SubgridPool }
import grid_contributions { ItemContribution }
import context { Input }
import geometry { OptionalSize, Size }
import layout_cache { LayoutCache }
import tree { NO_NODE }

pub struct GridAxisScratch {
  pub tracks: List<TrackState>,
  pub contributions: List<TrackContribution>,
  pub inherited: List<TrackState>,
  pub members: List<GridItem>,
  pub policies: List<TrackPolicy>,
  pub crossPolicies: List<TrackPolicy>,
  // Two per item, for the sizing pass and the re-check (see
  // collectContributions): what measuring it last returned.
  pub memos: ContributionMemos,
}

// An item's measured contribution and what it was measured for. It stands
// while the cache has cleared nothing of the item since `clock` (see
// LayoutCache.clearedAt) and the same area and track policy come again under
// the list's base request.
pub struct ContributionMemo {
  pub id: usize, pub clock: usize, pub area: OptionalSize, pub minimum: Size,
  pub horizontal: bool, pub automatic: bool, pub cap: f32, pub crossCap: f32,
  pub needMin: bool, pub needMax: bool,
  pub result: ItemContribution,
  // The pass (ContributionMemos.stamp) that last found it standing, and the
  // tracks it was measured in, or NO_NODE (see ContributionMemos.kept).
  pub pass: usize, pub track: usize, pub trackEnd: usize, pub crossTrack: usize, pub crossEnd: usize,
}
impl Copy for ContributionMemo {}

// What a sizing pass's keys took from its tracks: each track's policy and
// each cross track's policy and, once final, its size.
struct MemoPass {
  stamp: usize,
  horizontal: bool,
  gap: f32,
  crossGap: f32,
  ownFinal: bool,
  crossFinal: bool,
  policies: List<TrackPolicy>,
  crossPolicies: List<TrackPolicy>,
  crossSizes: List<f32>,
  sizes: List<f32>,
}

impl MemoPass {
  fn make() -> MemoPass {
    return MemoPass {
      stamp: 0, horizontal: false, gap: 0.0, crossGap: 0.0, ownFinal: false, crossFinal: false, policies: List<TrackPolicy>.make(),
      crossPolicies: List<TrackPolicy>.make(), crossSizes: List<f32>.make(), sizes: List<f32>.make(),
    }
  }

  fn reset(self: &mut Self) {
    self.stamp = 0
    self.policies.clear()
    self.crossPolicies.clear()
    self.crossSizes.clear()
    self.sizes.clear()
  }
}

fn samePolicy(a: &TrackPolicy, b: &TrackPolicy) -> bool {
  return a.automatic == b.automatic && a.fixed == b.fixed && a.cap == b.cap && a.intrinsic == b.intrinsic
    && a.needMin == b.needMin && a.needMax == b.needMax
}

// Compares `policies` (and, when `final`, `tracks`' sizes) with `seen`'s,
// then makes them `seen`'s. changed[i] counts the tracks before i that differ
// or that `seen` lacked; every track differs unless `comparable`.
effect fn compareTracks(
  seenPolicies: &mut List<TrackPolicy>, seenSizes: &mut List<f32>, policies: &[TrackPolicy], tracks: &[TrackState],
  final: bool, comparable: bool, changed: &mut List<usize>,
) ! OutOfMemoryError ? &mut Allocator {
  let count = policies.length
  changed.clear()
  run changed.reserve(count + 1)
  if !comparable {
    let mut index: usize = 0
    while index <= count {
      run changed.append(index)
      index = index + 1
    }
    seenPolicies.clear()
    run seenPolicies.appendSlice(policies)
    if final { run copySizes(&mut seenSizes, tracks) }
    return
  }
  let mut common = seenPolicies.length()
  if count < common { common = count }
  let mut sizeCommon: usize = 0
  if final {
    sizeCommon = seenSizes.length()
    if tracks.length < sizeCommon { sizeCommon = tracks.length }
  }
  let mut differing: usize = 0
  run changed.append(0)
  let seen = seenPolicies.asMutSlice()
  let sizes = seenSizes.asSlice()
  let mut index: usize = 0
  while index < count {
    let mut same = index < common && samePolicy(&seen[index], &policies[index])
    if final && index < tracks.length {
      same = same && index < sizeCommon && sizes[index] == tracks[index].base
    }
    if index < common { seen[index] = policies[index] }
    if !same { differing = differing + 1 }
    run changed.append(differing)
    index = index + 1
  }
  seenPolicies.truncate(count)
  let mut tail = common
  while tail < count {
    run seenPolicies.append(policies[tail])
    tail = tail + 1
  }
  if final { run copySizes(&mut seenSizes, tracks) }
}

effect fn copySizes(seen: &mut List<f32>, tracks: &[TrackState]) ! OutOfMemoryError ? &mut Allocator {
  seen.clear()
  run seen.reserve(tracks.length)
  let mut index: usize = 0
  while index < tracks.length {
    run seen.append(tracks[index].base)
    index = index + 1
  }
}

// Item requests are the grid's base request plus each item's area, so a memo
// list compares the base once per pass instead of whole requests per item.
//
// A pass whose tracks keep their policies, and cross tracks their areas, from
// the previous pass of its kind finds its items' keys unchanged:
// such an item's entry stands if that pass found it standing and the cache
// cleared nothing of it since (`kept`), with no key built or compared.
pub struct ContributionMemos {
  base: Input,
  entries: List<ContributionMemo>,
  stamp: usize,
  previous: usize,
  sizing: MemoPass,
  recheck: MemoPass,
  // How many tracks before each one changed (see spanSame).
  changed: List<usize>,
  crossChanged: List<usize>,
  // By item, for final requests (see laidOut).
  marks: List<ItemMark>,
}

// An item laid out by a final pass in `area`, when the cache had cleared
// nothing of it since `clock`.
struct ItemMark { id: usize, pass: usize, area: TrackArea, clock: usize }
impl Copy for ItemMark {}

// The tracks an item spans, by index.
pub struct TrackArea { pub column: usize, pub columnEnd: usize, pub row: usize, pub rowEnd: usize }
impl Copy for TrackArea {}

impl TrackArea {
  pub fn same(self: &Self, other: &TrackArea) -> bool {
    return self.column == other.column && self.columnEnd == other.columnEnd && self.row == other.row
      && self.rowEnd == other.rowEnd
  }
}

impl ContributionMemos {
  pub fn make() -> ContributionMemos {
    return ContributionMemos {
      base: Input.make(OptionalSize.none()), entries: List<ContributionMemo>.make(), stamp: 0, previous: 0,
      sizing: MemoPass.make(), recheck: MemoPass.make(),
      changed: List<usize>.make(), crossChanged: List<usize>.make(),
      marks: List<ItemMark>.make(),
    }
  }

  pub fn clear(self: &mut Self) {
    self.entries.clear()
    self.marks.clear()
    self.sizing.reset()
    self.recheck.reset()
  }

  // Keeps the entries only if they were measured under the same base.
  pub fn begin(self: &mut Self, base: &Input) {
    if (self.entries.length() != 0 || self.marks.length() != 0) && LayoutCache.sameBase(&self.base, base) { return }
    self.clear()
    self.base = base.*
  }

  // Room for `count` entries, so storing them one slot at a time doesn't
  // regrow the list; kept entries stay where they are.
  pub effect fn reserveSlots(self: &mut Self, count: usize) ! OutOfMemoryError ? &mut Allocator {
    let length = self.entries.length()
    if self.entries.capacity() < count { run self.entries.reserveExact(count - length) }
  }

  // Starts a sizing pass (or re-check pass) over `tracks` with `policies`,
  // across `crossTracks` with `crossPolicies`. Keys read each axis's sizes
  // only once final (`ownFinal`, `crossFinal`).
  pub effect fn startPass(
    self: &mut Self, recheck: bool, horizontal: bool, ownFinal: bool, crossFinal: bool, gap: f32, crossGap: f32,
    policies: &[TrackPolicy], crossPolicies: &[TrackPolicy], tracks: &[TrackState], crossTracks: &[TrackState],
  ) ! OutOfMemoryError ? &mut Allocator {
    self.stamp = self.stamp + 1
    if recheck {
      self.previous = run startKind(&mut self.recheck, &mut self.changed, &mut self.crossChanged, self.stamp,
        horizontal, ownFinal, crossFinal, gap, crossGap, policies, crossPolicies, tracks, crossTracks)
    } else {
      self.previous = run startKind(&mut self.sizing, &mut self.changed, &mut self.crossChanged, self.stamp,
        horizontal, ownFinal, crossFinal, gap, crossGap, policies, crossPolicies, tracks, crossTracks)
    }
  }

  // Whether tracks `start` to `end` all kept what keys read of them.
  fn spanSame(changed: &List<usize>, start: usize, end: usize) -> bool {
    let counts = changed.asSlice()
    return end < counts.length && counts[end] == counts[start]
  }

  // The entry of an item in tracks `track` to `trackEnd` and `crossTrack` to
  // `crossEnd`, if the previous pass of this kind found it standing and
  // nothing changed since.
  pub fn kept(
    self: &mut Self, slot: usize, id: usize, track: usize, trackEnd: usize, crossTrack: usize, crossEnd: usize,
    cleared: usize,
  ) -> Option<ItemContribution> {
    if slot >= self.entries.length() || self.previous == 0 { return Option<ItemContribution>.None }
    let memo = &mut self.entries.asMutSlice()[slot]
    if memo.pass == self.previous && memo.id == id && memo.track == track && memo.trackEnd == trackEnd
      && memo.crossTrack == crossTrack && memo.crossEnd == crossEnd && cleared <= memo.clock
      && ContributionMemos.spanSame(&self.changed, track, trackEnd)
      && ContributionMemos.spanSame(&self.crossChanged, crossTrack, crossEnd) {
      memo.pass = self.stamp
      return Option<ItemContribution>.Some { value: memo.result }
    }
    return Option<ItemContribution>.None
  }

  // Whether the previous final pass laid out the item at `index` in the same
  // tracks, unchanged since: if so its request is the one it made then.
  pub fn laidOut(self: &mut Self, index: usize, id: usize, area: &TrackArea, cleared: usize) -> bool {
    if index >= self.marks.length() || self.previous == 0 { return false }
    let mark = &mut self.marks.asMutSlice()[index]
    if mark.pass == self.previous && mark.id == id && mark.area.same(area) && cleared <= mark.clock
      && ContributionMemos.spanSame(&self.changed, area.column, area.columnEnd)
      && ContributionMemos.spanSame(&self.crossChanged, area.row, area.rowEnd) {
      mark.pass = self.stamp
      return true
    }
    return false
  }

  pub fn forgetLaidOut(self: &mut Self) { self.marks.clear() }

  pub effect fn markLaidOut(self: &mut Self, index: usize, id: usize, area: TrackArea, clock: usize)
    ! OutOfMemoryError ? &mut Allocator {
    let mark = ItemMark { id: id, pass: self.stamp, area: area, clock: clock }
    while self.marks.length() <= index { run self.marks.append(ItemMark { id: NO_NODE, pass: 0, area: area, clock: 0 }) }
    self.marks.set(index, mark)
  }

  pub fn lookup(self: &mut Self, slot: usize, key: &ContributionMemo, cleared: usize) -> Option<ItemContribution> {
    if slot >= self.entries.length() { return Option<ItemContribution>.None }
    let memo = &mut self.entries.asMutSlice()[slot]
    if memo.id == key.id && cleared <= memo.clock && sameOptional(&memo.area, &key.area)
      && memo.minimum.width == key.minimum.width && memo.minimum.height == key.minimum.height
      && memo.horizontal == key.horizontal && memo.automatic == key.automatic
      && memo.cap == key.cap && memo.crossCap == key.crossCap
      && memo.needMin == key.needMin && memo.needMax == key.needMax {
      memo.pass = self.stamp
      memo.track = key.track
      memo.trackEnd = key.trackEnd
      memo.crossTrack = key.crossTrack
      memo.crossEnd = key.crossEnd
      return Option<ItemContribution>.Some { value: memo.result }
    }
    return Option<ItemContribution>.None
  }

  pub effect fn store(self: &mut Self, slot: usize, value: ContributionMemo) ! OutOfMemoryError ? &mut Allocator {
    let mut stored = value
    stored.pass = self.stamp
    let mut gap = value
    gap.id = NO_NODE
    while self.entries.length() <= slot { run self.entries.append(gap) }
    self.entries.set(slot, stored)
  }
}

// Compares a pass with the previous one of its kind, `seen`, and returns that
// pass's stamp, or 0 if its keys took anything else from the pass itself.
effect fn startKind(
  seen: &mut MemoPass, changed: &mut List<usize>, crossChanged: &mut List<usize>, stamp: usize,
  horizontal: bool, ownFinal: bool, crossFinal: bool, gap: f32, crossGap: f32,
  policies: &[TrackPolicy], crossPolicies: &[TrackPolicy], tracks: &[TrackState], crossTracks: &[TrackState],
) -> usize ! OutOfMemoryError ? &mut Allocator {
  let comparable = seen.stamp != 0 && seen.horizontal == horizontal && seen.ownFinal == ownFinal
    && seen.crossFinal == crossFinal && seen.gap == gap && seen.crossGap == crossGap
  let previous = seen.stamp
  seen.stamp = stamp
  seen.horizontal = horizontal
  seen.gap = gap
  seen.crossGap = crossGap
  seen.ownFinal = ownFinal
  seen.crossFinal = crossFinal
  run compareTracks(&mut seen.policies, &mut seen.sizes, policies, tracks, ownFinal, comparable, &mut changed)
  run compareTracks(&mut seen.crossPolicies, &mut seen.crossSizes, crossPolicies, crossTracks, crossFinal, comparable,
    &mut crossChanged)
  if !comparable { return 0 }
  return previous
}

fn sameOptional(a: &OptionalSize, b: &OptionalSize) -> bool {
  return a.widthDefinite == b.widthDefinite && a.heightDefinite == b.heightDefinite
    && (!a.widthDefinite || a.width == b.width) && (!a.heightDefinite || a.height == b.height)
}

impl GridAxisScratch {
  pub fn make() -> GridAxisScratch {
    return GridAxisScratch {
      tracks: List<TrackState>.make(),
      contributions: List<TrackContribution>.make(),
      inherited: List<TrackState>.make(),
      members: List<GridItem>.make(),
      policies: List<TrackPolicy>.make(),
      crossPolicies: List<TrackPolicy>.make(),
      memos: ContributionMemos.make(),
    }
  }

  pub fn clear(self: &mut Self) {
    self.tracks.clear()
    self.contributions.clear()
    self.inherited.clear()
    self.members.clear()
    self.policies.clear()
    self.crossPolicies.clear()
    self.memos.clear()
  }
}

pub struct GridTemplateScratch {
  pub columns: ExpandedAxis,
  pub rows: ExpandedAxis,
  pub columnNames: LineNames,
  pub rowNames: LineNames,
  pub collapsedColumns: List<usize>,
  pub collapsedRows: List<usize>,
  pub columnRepeat: usize,
  pub rowRepeat: usize,
  pub context: usize,
  pub areas: List<GridArea>,
  pub areaMasks: List<usize>,
}

impl GridTemplateScratch {
  pub fn make() -> GridTemplateScratch {
    return GridTemplateScratch {
      columns: ExpandedAxis.make(),
      rows: ExpandedAxis.make(),
      columnNames: LineNames.make(),
      rowNames: LineNames.make(),
      collapsedColumns: List<usize>.make(),
      collapsedRows: List<usize>.make(),
      columnRepeat: 0,
      rowRepeat: 0,
      context: 0,
      areas: List<GridArea>.make(),
      areaMasks: List<usize>.make(),
    }
  }
}

// Placement survives computes while its box identity and styles remain valid.
// Track sizes are request-dependent and initialized again before each sizing pass.
pub struct GridScratch {
  pub items: List<GridItem>,
  pub bounds: GridBounds,
  pub placement: PlacementScratch,
  pub columns: GridAxisScratch,
  pub rows: GridAxisScratch,
  pub trackWork: List<usize>,
  // Lazy zero-or-one payload: ordinary numeric grids need no expanded-template
  // vectors, and leases do not move all those empty vectors on every probe.
  pub template: List<GridTemplateScratch>,
  pub baselines: List<GridBaselines>,
  // Two per item, for its automatic minimum on each axis (see requestItem).
  pub finalMemos: ContributionMemos,
  // Final passes' items, by what they requested (see ContributionMemos.laidOut).
  pub finals: ContributionMemos,
  // Each final track's policy, for single-track items' requests.
  pub finalColumns: List<TrackPolicy>,
  pub finalRows: List<TrackPolicy>,
  pub columnGap: f32,
  pub rowGap: f32,
}

impl GridScratch {
  pub fn make() -> GridScratch {
    return GridScratch {
      items: List<GridItem>.make(),
      bounds: GridBounds.empty(),
      placement: PlacementScratch.make(),
      columns: GridAxisScratch.make(),
      rows: GridAxisScratch.make(),
      trackWork: List<usize>.make(),
      template: List<GridTemplateScratch>.make(),
      baselines: List<GridBaselines>.make(),
      finalMemos: ContributionMemos.make(),
      finals: ContributionMemos.make(),
      finalColumns: List<TrackPolicy>.make(),
      finalRows: List<TrackPolicy>.make(),
      columnGap: 0.0,
      rowGap: 0.0,
    }
  }
}

// Moving the list out lets recursive child layout borrow the pool independently.
// A box must return its lease before taking that same box again.
// The scratch is boxed so a lease moves one pointer, not the whole struct.
pub struct GridLease {
  pub fresh: bool,
  pub value: Box<GridScratch>,
  slot: usize
}

struct GridMemoSlot {
  valid: bool,
  // None while the box's lease is out.
  value: Option<Box<GridScratch>>,
}

// Cache-owned placement and pooled sizing storage share one lease: retaining
// placement must not copy item lists or add a second set of scratch allocations.
pub struct GridMemos {
  index: List<usize>,
  slots: List<GridMemoSlot>,
  used: usize,
  // A recursion-depth pool, separate from ordinary per-box sizing leases.
  // Continuous layout neither allocates nor moves fragment-item vectors.
  pub fragmentScratch: List<GridFragmentScratch>,
}

impl GridMemos {
  pub fn make() -> GridMemos {
    return GridMemos {
      index: List<usize>.make(),
      slots: List<GridMemoSlot>.make(),
      used: 0,
      fragmentScratch: List<GridFragmentScratch>.make(),
    }
  }

  // A fresh cache or remapped box identity invalidates placement, not capacity.
  pub fn clear(self: &mut Self) {
    self.index.clear()
    self.used = 0
    let values = self.fragmentScratch.asMutSlice()
    let mut at: usize = 0
    while at < values.length {
      let items = values[at].items.asMutSlice()
      let mut item: usize = 0
      while item < items.length { items[item].gridContext = 0
        item = item + 1 }
      at = at + 1
    }
  }

  pub fn markContexts(self: &Self, pool: &mut SubgridPool) {
    let mut at: usize = 0
    while at < self.used {
      match &self.slots.asSlice()[at].value {
        Option<Box<GridScratch>>.Some { value } => {
          let template = value.get()[0].template.asSlice()
          if template.length != 0 { pool.mark(template[0].context) }
        }
        Option<Box<GridScratch>>.None => {}
      }
      at = at + 1
    }
    at = 0
    while at < self.fragmentScratch.length() {
      let items = self.fragmentScratch.asSlice()[at].items.asSlice()
      let mut item: usize = 0
      while item < items.length { pool.mark(items[item].gridContext)
        item = item + 1 }
      at = at + 1
    }
  }

  // The placement bounds a box's valid memo holds, if any.
  pub fn bounds(self: &Self, id: usize) -> Option<GridBounds> {
    if id >= self.index.length() { return Option<GridBounds>.None }
    let slot = self.index.get(id)
    if slot == usize.MAX || !self.slots.asSlice()[slot].valid { return Option<GridBounds>.None }
    match &self.slots.asSlice()[slot].value {
      Option<Box<GridScratch>>.Some { value } => { return Option<GridBounds>.Some { value: value.get()[0].bounds } }
      Option<Box<GridScratch>>.None => { return Option<GridBounds>.None }
    }
  }

  // Whether a grid's valid memo places an item off its first and last rows,
  // whose items alone may give the grid its baselines (Grid §11.8).
  pub fn innerRow(self: &Self, id: usize, item: usize) -> bool {
    if id >= self.index.length() { return false }
    let slot = self.index.get(id)
    if slot == usize.MAX || !self.slots.asSlice()[slot].valid { return false }
    match &self.slots.asSlice()[slot].value {
      Option<Box<GridScratch>>.Some { value } => {
        let items = value.get()[0].items.asSlice()
        let mut first = i32.MAX
        let mut last = i32.MIN
        let mut found = false
        let mut row = GridSpan { start: 0, end: 0, definite: false }
        let mut at: usize = 0
        while at < items.length {
          if items[at].row.start < first { first = items[at].row.start }
          if items[at].row.end > last { last = items[at].row.end }
          if items[at].id == item { row = items[at].row
            found = true }
          at = at + 1
        }
        return found && row.start > first && row.end < last
      }
      Option<Box<GridScratch>>.None => { return false }
    }
  }

  pub fn dropBox(self: &mut Self, id: usize) {
    if id >= self.index.length() {
      return
    }
    let slot = self.index.get(id)
    if slot != usize.MAX {
      let slots = self.slots.asMutSlice()
      slots[slot].valid = false
    }
  }

  pub effect fn take(self: &mut Self, boxId: usize, boxCount: usize) -> GridLease
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.index.length() < boxCount {
      let additional = boxCount - self.index.length()
      run self.index.appendRepeated(usize.MAX, additional)
    }
    let mut slot = self.index.get(boxId)
    let mut fresh = slot == usize.MAX
    if fresh {
      slot = self.used
      if slot == self.slots.length() {
        run self.slots.append(GridMemoSlot { valid: false, value: Option<Box<GridScratch>>.None })
      }
      self.used = self.used + 1
      self.index.set(boxId, slot)
    }
    let slots = self.slots.asMutSlice()
    fresh = fresh || !slots[slot].valid

    // An abandoned lease cannot leave an empty slot marked as prepared.
    slots[slot].valid = false
    let taken = Intrinsic.replace(slots[slot].value, Option<Box<GridScratch>>.None)
    let mut value = match move taken {
      Option<Box<GridScratch>>.Some { value } => move value
      Option<Box<GridScratch>>.None => run Box<GridScratch>.make(GridScratch.make())
    }
    if fresh {
      let scratch = &mut value.getMut()[0]
      scratch.items.clear()
      scratch.bounds = GridBounds.empty()
      scratch.columns.clear()
      scratch.rows.clear()
      scratch.finalMemos.clear()
      scratch.finals.clear()
    }
    return GridLease { fresh: fresh, value: move value, slot: slot }
  }

  pub fn put(self: &mut Self, lease: GridLease) {
    let slots = self.slots.asMutSlice()
    let slot = lease.slot
    slots[slot].value = Option<Box<GridScratch>>.Some { value: move lease.value }
    slots[slot].valid = true
  }
}
