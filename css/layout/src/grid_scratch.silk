import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.box { Box }
import silk.num.usize
import silk.num.i32
import grid_lines { GridSpan }
import grid_placement { GridItem, GridBounds, PlacementScratch }
import grid_tracks { TrackState, TrackContribution, TrackPolicy }
import grid_lines { LineNames }
import grid_template { ExpandedAxis }
import grid_baselines { GridBaselines }
import grid_fragment_scratch { GridFragmentScratch }
import grid_style { GridArea }
import grid_subgrid { SubgridPool }
import grid_contributions { ItemContribution }
import context { Input }
import geometry { OptionalSize }

pub struct GridAxisScratch {
  pub tracks: List<TrackState>,
  pub contributions: List<TrackContribution>,
  pub inherited: List<TrackState>,
  pub members: List<GridItem>,
  pub policies: List<TrackPolicy>,
  pub crossPolicies: List<TrackPolicy>,
  // Two per item, for the sizing pass and the re-check (see
  // collectContributions): what measuring it last returned.
  pub memos: List<ContributionMemo>,
}

// An item's measured contribution and what it was measured for. It stands
// while the cache has cleared nothing of the item since `clock` (see
// LayoutCache.clearedAt) and the same request comes again.
pub struct ContributionMemo {
  pub id: usize, pub clock: usize, pub request: Input,
  pub horizontal: bool, pub automatic: bool, pub cap: f32, pub crossCap: f32,
  pub needMin: bool, pub needMax: bool,
  pub result: ItemContribution,
}
impl Copy for ContributionMemo {}
impl ContributionMemo {
  pub fn none() -> ContributionMemo {
    return ContributionMemo {
      id: usize.MAX, clock: 0, request: Input.make(OptionalSize.none()),
      horizontal: false, automatic: false, cap: 0.0, crossCap: 0.0, needMin: false, needMax: false,
      result: ItemContribution { minimum: 0.0, minContent: 0.0, maxContent: 0.0, usedMinimum: 0.0 },
    }
  }
}

impl GridAxisScratch {
  pub fn make() -> GridAxisScratch {
    return GridAxisScratch {
      tracks: List<TrackState>.make(),
      contributions: List<TrackContribution>.make(),
      inherited: List<TrackState>.make(),
      members: List<GridItem>.make(),
      policies: List<TrackPolicy>.make(),
      crossPolicies: List<TrackPolicy>.make(),
      memos: List<ContributionMemo>.make(),
    }
  }

  pub fn clear(self: &mut Self) {
    self.tracks.clear()
    self.contributions.clear()
    self.inherited.clear()
    self.members.clear()
    self.policies.clear()
    self.crossPolicies.clear()
    self.memos.clear()
  }
}

pub struct GridTemplateScratch {
  pub columns: ExpandedAxis,
  pub rows: ExpandedAxis,
  pub columnNames: LineNames,
  pub rowNames: LineNames,
  pub collapsedColumns: List<usize>,
  pub collapsedRows: List<usize>,
  pub columnRepeat: usize,
  pub rowRepeat: usize,
  pub context: usize,
  pub areas: List<GridArea>,
  pub areaMasks: List<usize>,
}

impl GridTemplateScratch {
  pub fn make() -> GridTemplateScratch {
    return GridTemplateScratch {
      columns: ExpandedAxis.make(),
      rows: ExpandedAxis.make(),
      columnNames: LineNames.make(),
      rowNames: LineNames.make(),
      collapsedColumns: List<usize>.make(),
      collapsedRows: List<usize>.make(),
      columnRepeat: 0,
      rowRepeat: 0,
      context: 0,
      areas: List<GridArea>.make(),
      areaMasks: List<usize>.make(),
    }
  }
}

// Placement survives computes while its box identity and styles remain valid.
// Track sizes are request-dependent and initialized again before each sizing pass.
pub struct GridScratch {
  pub items: List<GridItem>,
  pub bounds: GridBounds,
  pub placement: PlacementScratch,
  pub columns: GridAxisScratch,
  pub rows: GridAxisScratch,
  pub trackWork: List<usize>,
  // Lazy zero-or-one payload: ordinary numeric grids need no expanded-template
  // vectors, and leases do not move all those empty vectors on every probe.
  pub template: List<GridTemplateScratch>,
  pub baselines: List<GridBaselines>,
  // Two per item, for its automatic minimum on each axis (see requestItem).
  pub finalMemos: List<ContributionMemo>,
  pub columnGap: f32,
  pub rowGap: f32,
}

impl GridScratch {
  pub fn make() -> GridScratch {
    return GridScratch {
      items: List<GridItem>.make(),
      bounds: GridBounds.empty(),
      placement: PlacementScratch.make(),
      columns: GridAxisScratch.make(),
      rows: GridAxisScratch.make(),
      trackWork: List<usize>.make(),
      template: List<GridTemplateScratch>.make(),
      baselines: List<GridBaselines>.make(),
      finalMemos: List<ContributionMemo>.make(),
      columnGap: 0.0,
      rowGap: 0.0,
    }
  }
}

// Moving the list out lets recursive child layout borrow the pool independently.
// A box must return its lease before taking that same box again.
// The scratch is boxed so a lease moves one pointer, not the whole struct.
pub struct GridLease {
  pub fresh: bool,
  pub value: Box<GridScratch>,
  slot: usize
}

struct GridMemoSlot {
  valid: bool,
  // None while the box's lease is out.
  value: Option<Box<GridScratch>>,
}

// Cache-owned placement and pooled sizing storage share one lease: retaining
// placement must not copy item lists or add a second set of scratch allocations.
pub struct GridMemos {
  index: List<usize>,
  slots: List<GridMemoSlot>,
  used: usize,
  // A recursion-depth pool, separate from ordinary per-box sizing leases.
  // Continuous layout neither allocates nor moves fragment-item vectors.
  pub fragmentScratch: List<GridFragmentScratch>,
}

impl GridMemos {
  pub fn make() -> GridMemos {
    return GridMemos {
      index: List<usize>.make(),
      slots: List<GridMemoSlot>.make(),
      used: 0,
      fragmentScratch: List<GridFragmentScratch>.make(),
    }
  }

  // A fresh cache or remapped box identity invalidates placement, not capacity.
  pub fn clear(self: &mut Self) {
    self.index.clear()
    self.used = 0
    let values = self.fragmentScratch.asMutSlice()
    let mut at: usize = 0
    while at < values.length {
      let items = values[at].items.asMutSlice()
      let mut item: usize = 0
      while item < items.length { items[item].gridContext = 0
        item = item + 1 }
      at = at + 1
    }
  }

  pub fn markContexts(self: &Self, pool: &mut SubgridPool) {
    let mut at: usize = 0
    while at < self.used {
      match &self.slots.asSlice()[at].value {
        Option<Box<GridScratch>>.Some { value } => {
          let template = value.get()[0].template.asSlice()
          if template.length != 0 { pool.mark(template[0].context) }
        }
        Option<Box<GridScratch>>.None => {}
      }
      at = at + 1
    }
    at = 0
    while at < self.fragmentScratch.length() {
      let items = self.fragmentScratch.asSlice()[at].items.asSlice()
      let mut item: usize = 0
      while item < items.length { pool.mark(items[item].gridContext)
        item = item + 1 }
      at = at + 1
    }
  }

  // The placement bounds a box's valid memo holds, if any.
  pub fn bounds(self: &Self, id: usize) -> Option<GridBounds> {
    if id >= self.index.length() { return Option<GridBounds>.None }
    let slot = self.index.get(id)
    if slot == usize.MAX || !self.slots.asSlice()[slot].valid { return Option<GridBounds>.None }
    match &self.slots.asSlice()[slot].value {
      Option<Box<GridScratch>>.Some { value } => { return Option<GridBounds>.Some { value: value.get()[0].bounds } }
      Option<Box<GridScratch>>.None => { return Option<GridBounds>.None }
    }
  }

  // Whether a grid's valid memo places an item off its first and last rows,
  // whose items alone may give the grid its baselines (Grid §11.8).
  pub fn innerRow(self: &Self, id: usize, item: usize) -> bool {
    if id >= self.index.length() { return false }
    let slot = self.index.get(id)
    if slot == usize.MAX || !self.slots.asSlice()[slot].valid { return false }
    match &self.slots.asSlice()[slot].value {
      Option<Box<GridScratch>>.Some { value } => {
        let items = value.get()[0].items.asSlice()
        let mut first = i32.MAX
        let mut last = i32.MIN
        let mut found = false
        let mut row = GridSpan { start: 0, end: 0, definite: false }
        let mut at: usize = 0
        while at < items.length {
          if items[at].row.start < first { first = items[at].row.start }
          if items[at].row.end > last { last = items[at].row.end }
          if items[at].id == item { row = items[at].row
            found = true }
          at = at + 1
        }
        return found && row.start > first && row.end < last
      }
      Option<Box<GridScratch>>.None => { return false }
    }
  }

  pub fn dropBox(self: &mut Self, id: usize) {
    if id >= self.index.length() {
      return
    }
    let slot = self.index.get(id)
    if slot != usize.MAX {
      let slots = self.slots.asMutSlice()
      slots[slot].valid = false
    }
  }

  pub effect fn take(self: &mut Self, boxId: usize, boxCount: usize) -> GridLease
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.index.length() < boxCount {
      let additional = boxCount - self.index.length()
      run self.index.appendRepeated(usize.MAX, additional)
    }
    let mut slot = self.index.get(boxId)
    let mut fresh = slot == usize.MAX
    if fresh {
      slot = self.used
      if slot == self.slots.length() {
        run self.slots.append(GridMemoSlot { valid: false, value: Option<Box<GridScratch>>.None })
      }
      self.used = self.used + 1
      self.index.set(boxId, slot)
    }
    let slots = self.slots.asMutSlice()
    fresh = fresh || !slots[slot].valid

    // An abandoned lease cannot leave an empty slot marked as prepared.
    slots[slot].valid = false
    let taken = Intrinsic.replace(slots[slot].value, Option<Box<GridScratch>>.None)
    let mut value = match move taken {
      Option<Box<GridScratch>>.Some { value } => move value
      Option<Box<GridScratch>>.None => run Box<GridScratch>.make(GridScratch.make())
    }
    if fresh {
      let scratch = &mut value.getMut()[0]
      scratch.items.clear()
      scratch.bounds = GridBounds.empty()
      scratch.columns.clear()
      scratch.rows.clear()
      scratch.finalMemos.clear()
    }
    return GridLease { fresh: fresh, value: move value, slot: slot }
  }

  pub fn put(self: &mut Self, lease: GridLease) {
    let slots = self.slots.asMutSlice()
    let slot = lease.slot
    slots[slot].value = Option<Box<GridScratch>>.Some { value: move lease.value }
    slots[slot].valid = true
  }
}
