import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import fragmentation { FragmentationError }
import style { Style, Dimension, Display, DisplayOutside, DisplayInside }
import geometry { Measure, MeasureRequest, Measured, BaselineSet, NaturalDimensions, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, Size, Rect, OptionalSize }
import text { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import tree { Tree, LayoutTree, NodeId, InvalidNode, NO_NODE }
import engine { compute }

// Boxes only: these trees hold no text to measure.
struct BoxHost {}
impl Measure for BoxHost {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest<'_>) -> Measured {
    drop provider
    drop key
    drop request
    return Measured { size: Size { width: 0.0, height: 0.0 }, scrollableOverflow: Rect.zero(), contentBlockSize: 0.0, firstBaselines: BaselineSet.zero(), lastBaselines: BaselineSet.zero(), hasBaseline: false, hasLineBoxes: false }
  }
}
impl TextMeasure for BoxHost {
  fn beginTextLayout(provider: &mut Self) { drop provider }
  effect fn analyze(provider: &mut Self, context: TextContext<'_, '_>, output: &mut List<TextBreak>) -> TextAnalysis ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    return TextAnalysis.uniform(context.tokens.length, 0, 0, true)
  }
  effect fn shape(provider: &mut Self, request: TextShapeRequest<'_, '_>, output: &mut List<TextRun>) ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop request
    drop output
  }
}

fn row(height: f32) -> Style {
  let mut result = Style.make()
  result.height = Dimension.px(height)
  return move result
}
fn flexRow() -> Style {
  let mut result = Style.make()
  result.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  return move result
}

// The children of `parent`, read forwards and checked against the backward links.
effect fn children(tree: &Tree, parent: NodeId) -> List<usize> ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let nodes = tree.nodes.asSlice()
  let mut result = List<usize>.make()
  let mut previous = NO_NODE
  let mut child = nodes[parent.index].firstChild
  while child != NO_NODE {
    run Testing.expect(nodes[child].parent == parent.index && nodes[child].previousSibling == previous, "sibling links agree both ways")
    run result.append(child)
    previous = child
    child = nodes[child].nextSibling
  }
  run Testing.expect(nodes[parent.index].lastChild == previous, "the last child closes the list")
  return move result
}
fn failed(result: &Result<(), InvalidNode>) -> bool {
  return match &result.* {
    Result<(), InvalidNode>.Success { value: _ } => false
    Result<(), InvalidNode>.Failure { error: _ } => true
  }
}
effect fn expectChildren(tree: &Tree, parent: NodeId, expected: &[usize]) ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let actual = run children(tree, parent)
  let mut same = actual.length() == expected.length
  let mut at: usize = 0
  while same && at < expected.length {
    same = actual.get(at) == expected[at]
    at = at + 1
  }
  run Testing.expect(same, "children follow the edits in order")
}

effect fn linksAndReuse() ! OutOfMemoryError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let a = run tree.append(root, row(10.0))
  let b = run tree.append(root, row(20.0))
  let c = run tree.append(root, row(30.0))
  let inner = run tree.appendText(b, run String.copy("x"))
  run expectChildren(&tree, root, &[a.index, b.index, c.index])
  // Moving before a sibling, before itself, and last.
  run tree.insertBefore(root, c, Option<NodeId>.Some { value: a })
  run expectChildren(&tree, root, &[c.index, a.index, b.index])
  run tree.insertBefore(root, a, Option<NodeId>.Some { value: a })
  run expectChildren(&tree, root, &[c.index, a.index, b.index])
  run tree.insertBefore(root, c, Option<NodeId>.None)
  run expectChildren(&tree, root, &[a.index, b.index, c.index])
  // A moved text node takes its new parent's style.
  run tree.insertBefore(c, inner, Option<NodeId>.None)
  run Testing.expect(tree.nodes.asSlice()[inner.index].styleIndex == tree.nodes.asSlice()[c.index].styleIndex, "moved text shares its new parent's style")
  run expectChildren(&tree, b, &[])
  // A removed node stays for a later insert; its subtree goes with it.
  run tree.remove(c)
  run expectChildren(&tree, root, &[a.index, b.index])
  run Testing.expect(tree.contains(c) && !tree.attached(c) && !tree.attached(inner), "a removed subtree is kept outside the tree")
  run tree.insertBefore(a, c, Option<NodeId>.None)
  run Testing.expect(tree.attached(inner), "reinserting a subtree attaches its descendants")
  // A node cannot go inside itself, and the root cannot move.
  let cycle = run Effect.result(tree.insertBefore(c, a, Option<NodeId>.None))
  run Testing.expect(failed(&cycle), "a node cannot become its own descendant")
  let rootMove = run Effect.result(tree.remove(root))
  run Testing.expect(failed(&rootMove), "the root cannot be removed")
  let foreign = run Effect.result(tree.insertBefore(root, b, Option<NodeId>.Some { value: inner }))
  run Testing.expect(failed(&foreign), "before must be a child of parent")
  // Destroying frees the subtree in tree order; creates take the last freed first.
  let nodeCount = tree.nodes.length()
  let styleCount = tree.styles.length()
  run tree.destroy(a)
  run Testing.expect(!tree.contains(a) && !tree.contains(c) && !tree.contains(inner), "a destroyed subtree is gone")
  let stale = run Effect.result(tree.setStyle(c, row(1.0)))
  run Testing.expect(failed(&stale), "a destroyed id is invalid until reused")
  let first = run tree.append(root, row(5.0))
  let second = run tree.appendText(root, run String.copy("y"))
  let third = run tree.append(root, row(6.0))
  run Testing.expect(first.index == inner.index && second.index == c.index && third.index == a.index, "ids are reused last freed first")
  run Testing.expect(tree.nodes.length() == nodeCount && tree.styles.length() == styleCount, "reused ids and style slots do not grow the tree")
  run expectChildren(&tree, root, &[b.index, first.index, second.index, third.index])
}

test effect fn treeMutationsKeepLinksAndReuseIds() ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run linksAndReuse() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn expectBounds(output: &LayoutTree, source: NodeId, x: f32, y: f32, width: f32, height: f32) ! InvalidNode | AssertionError<'static> {
  let actual = run output.sourceBounds(source)
  run Testing.expect(actual.x == x && actual.y == y && actual.width == width && actual.height == height, "kept layout after a structural edit matches the expected geometry")
}

effect fn keptLayoutFollowsEdits() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  let a = run tree.append(root, row(10.0))
  let b = run tree.append(root, row(20.0))
  let line = run tree.append(root, flexRow())
  let mut item = row(5.0)
  item.width = Dimension.px(40.0)
  let x = run tree.append(line, move item)
  let mut output = LayoutTree.make()
  let mut host = BoxHost {}
  let viewport = OptionalSize.definite(200.0, 100.0)
  run compute(&tree, &mut output, &mut host, viewport)
  run expectBounds(&output, line, 0.0, 30.0, 200.0, 5.0)
  // Reorder: b, a.
  run tree.insertBefore(root, b, Option<NodeId>.Some { value: a })
  run compute(&tree, &mut output, &mut host, viewport)
  run expectBounds(&output, b, 0.0, 0.0, 200.0, 20.0)
  run expectBounds(&output, a, 0.0, 20.0, 200.0, 10.0)
  // Move the flex item out to the root's start.
  run tree.insertBefore(root, x, Option<NodeId>.Some { value: b })
  run compute(&tree, &mut output, &mut host, viewport)
  run expectBounds(&output, x, 0.0, 0.0, 40.0, 5.0)
  run expectBounds(&output, line, 0.0, 35.0, 200.0, 0.0)
  // Remove a, then destroy b and reuse its id for a taller row in the line.
  run tree.remove(a)
  run tree.destroy(b)
  let y = run tree.append(line, row(50.0))
  run Testing.expect(y.index == b.index, "the destroyed id is reused")
  run compute(&tree, &mut output, &mut host, viewport)
  run expectBounds(&output, line, 0.0, 5.0, 200.0, 50.0)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut host, viewport)
  run expectBounds(&fresh, line, 0.0, 5.0, 200.0, 50.0)
  run expectBounds(&fresh, y, 0.0, 5.0, 0.0, 50.0)
  run expectBounds(&output, y, 0.0, 5.0, 0.0, 50.0)
}

test effect fn keptLayoutFollowsStructuralEdits() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run keptLayoutFollowsEdits() |> Effect.provideMut<Allocator>(&mut allocator)
}
