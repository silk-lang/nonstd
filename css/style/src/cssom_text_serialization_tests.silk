import lexer
import values { Store }
import text_values
import text_values { TextValue }
import dimensions { Context }
import colors { Color, Context as ColorContext }
import cssom_text_serialization
import properties { Property }
import input { Input }
import value_cursor { Cursor }
import tokens { Limits, CssError, equal }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn serializes(
  sourceProperty: Property,
  source: &[u8],
  property: Property,
  expected: &[u8],
) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut store = Store.make()
  let parsed = run text_values.parse(
    &mut store.numerics,
    sourceProperty,
    &input,
    &mut cursor,
    false,
  )
  match &parsed {
    Option<TextValue>.Some { value } => {
      run Testing.expect(cursor.done(&input), "entire font/text fixture parses")
      let serialized = run cssom_text_serialization.value(&store, &value, sourceProperty, property)
      run Testing.expect(
        equal(Bytes.asSlice(&serialized), expected),
        "canonical font/text CSSOM serialization",
      )
    }
    _ => {
      run Testing.expect(false, "font/text serialization fixture parses")
    }
  }
}

test effect fn fontFamiliesStringsAndSettingsSerialization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serializes(
    Property.FontFamily,
    b"Gill Sans, 'serif', serif, generic(kai)",
    Property.FontFamily,
    b"\"Gill Sans\", \"serif\", serif, generic(kai)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontFamily, b"'A\\\"B'", Property.FontFamily, b"\"A\\\"B\"")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontLanguageOverride, b"'TRK'", Property.FontLanguageOverride, b"\"TRK\"")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontFeatureSettings,
    b"'liga' on, 'kern' off, 'swsh' 2",
    Property.FontFeatureSettings,
    b"\"liga\", \"kern\" 0, \"swsh\" 2",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontVariationSettings,
    b"'wght' 432.5, 'slnt' -12",
    Property.FontVariationSettings,
    b"\"wght\" 432.5, \"slnt\" -12",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontStyle, b"oblique 14deg", Property.FontStyle, b"oblique")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontStyle, b"oblique 20deg", Property.FontStyle, b"oblique 20deg")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn fontShorthandSerializationAndProjection() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serializes(
    Property.Font,
    b"bold italic 16px/1.5 Gill Sans, serif",
    Property.Font,
    b"italic bold 16px / 1.5 \"Gill Sans\", serif",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.Font, b"normal 16px serif", Property.Font, b"16px serif")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.Font,
    b"bold italic 16px/1.5 Gill Sans, serif",
    Property.FontFamily,
    b"\"Gill Sans\", serif",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.Font, b"16px serif", Property.FontWeight, b"normal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.Font, b"16px serif", Property.FontSizeAdjust, b"none")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.Font, b"caption", Property.Font, b"caption")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.Font, b"caption", Property.FontFamily, b"")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontVariant,
    b"ordinal small-caps oldstyle-nums",
    Property.FontVariant,
    b"small-caps oldstyle-nums ordinal",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontVariant, b"none", Property.FontVariantLigatures, b"none")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontVariant, b"small-caps", Property.FontVariantNumeric, b"normal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontSynthesis,
    b"small-caps weight",
    Property.FontSynthesis,
    b"weight small-caps",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.FontSynthesis, b"weight", Property.FontSynthesisStyle, b"none")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn textGroupsAndAlternatesCanonicalOrdering() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serializes(
    Property.FontVariantAlternates,
    b"annotation(note) styleset(one, two) historical-forms stylistic(fancy)",
    Property.FontVariantAlternates,
    b"stylistic(fancy) historical-forms styleset(one, two) annotation(note)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.TextIndent,
    b"each-line 2em hanging",
    Property.TextIndent,
    b"2em hanging each-line",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.TextDecorationLine,
    b"line-through underline overline",
    Property.TextDecorationLine,
    b"underline overline line-through",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.TextDecoration, b"solid underline", Property.TextDecoration, b"underline")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.TextDecoration,
    b"underline",
    Property.TextDecorationColor,
    b"currentcolor",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.TextEmphasis, b"circle filled", Property.TextEmphasis, b"circle")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.TextUnderlinePosition,
    b"right under",
    Property.TextUnderlinePosition,
    b"under right",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.TextShadow,
    b"1px 2px 0px, 3px 4px 5px",
    Property.TextShadow,
    b"1px 2px, 3px 4px 5px",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.VerticalAlign, b"baseline", Property.VerticalAlign, b"baseline")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.VerticalAlign, b"super", Property.AlignmentBaseline, b"baseline")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn whitespaceAndPaletteSerialization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serializes(Property.WhiteSpace, b"preserve nowrap", Property.WhiteSpace, b"pre")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.WhiteSpace, b"pre-line", Property.WhiteSpaceCollapse, b"preserve-breaks")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(Property.WhiteSpace, b"normal", Property.WhiteSpaceTrim, b"none")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.WhiteSpace,
    b"discard-inner discard-before nowrap preserve-spaces",
    Property.WhiteSpace,
    b"preserve-spaces nowrap discard-before discard-inner",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontPalette,
    b"palette-mix(in oklab, --day 20%, dark)",
    Property.FontPalette,
    b"palette-mix(--day 20%, dark)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontPalette,
    b"palette-mix(in oklch longer hue, light, palette-mix(dark, --day))",
    Property.FontPalette,
    b"palette-mix(in oklch longer hue, light, palette-mix(dark, --day))",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn paletteWeightsShortenWithoutLosingAlpha() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run serializes(
    Property.FontPalette,
    b"palette-mix(light 50%, dark 50%)",
    Property.FontPalette,
    b"palette-mix(light, dark)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontPalette,
    b"palette-mix(light 20%, dark 80%)",
    Property.FontPalette,
    b"palette-mix(light 20%, dark)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run serializes(
    Property.FontPalette,
    b"palette-mix(light 20%, dark 20%)",
    Property.FontPalette,
    b"palette-mix(light 20%, dark 20%)",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn computedSerializes(property: Property, source: &[u8], expected: &[u8]) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut store = Store.make()
  let parsed = run text_values.parse(&mut store.numerics, property, &input, &mut cursor, false)
  match &parsed {
    Option<TextValue>.Some { value } => {
      run Testing.expect(cursor.done(&input), "computed text fixture parses")
      let context = Context.make(640.0, 480.0, 20.0)
      let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
      let colorContext = ColorContext.make(black, [black; 19])
      let systems = [
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
      ]
      let computed = run text_values.compute(
        &value,
        &mut store.numerics,
        &context,
        &colorContext,
        &systems,
      )
      let result = run cssom_text_serialization.computedValue(&store, &computed, property, property)
      run Testing.expect(
        equal(Bytes.asSlice(&result), expected),
        "computed text removes resolved math wrappers",
      )
    }
    _ => {
      run Testing.expect(false, "computed text fixture is supported")
    }
  }
}

test effect fn computedTextNumericSerialization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run computedSerializes(Property.FontSize, b"calc(2px + 3px)", b"5px")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedSerializes(Property.LetterSpacing, b"calc(1px + 2px)", b"3px")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedSerializes(Property.FontVariationSettings, b"'wght' calc(400 + 25)", b"\"wght\" 425")
    |> Effect.provideMut<Allocator>(&mut allocator)
}
