//! CSS Fonts font-family-name and src descriptor grammars.
import cssom_serialization
import tokens { TokenBuffer, TokenRange, Kind, insensitive }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn skip(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let mut i = at
  while i < end
    && match &buffer.tokens.asSlice()[i].kind {
      Kind.Whitespace => true
      _ => false
    } {
    i = i + 1
  }
  return i
}

fn reserved(name: &[u8]) -> bool {
  let names = [
    b"initial",
    b"inherit",
    b"unset",
    b"revert",
    b"revert-layer",
    b"default",
    b"serif",
    b"sans-serif",
    b"monospace",
    b"cursive",
    b"fantasy",
    b"system-ui",
    b"ui-serif",
    b"ui-sans-serif",
    b"ui-monospace",
    b"ui-rounded",
    b"math",
    b"fangsong",
  ]
  let mut i: usize = 0
  while i < names.length {
    if insensitive(name, names[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Returns the decoded family name; callers choose string versus identifier serialization.
pub effect fn family(buffer: &TokenBuffer, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = skip(buffer, range.start, range.end)
  if at == range.end {
    return Option<Bytes>.None
  }
  match &buffer.tokens.asSlice()[at].kind {
    Kind.String { text } => {
      if skip(buffer, at + 1, range.end) != range.end {
        return Option<Bytes>.None
      }
      return Option<Bytes>.some(run Bytes.copy(buffer.text(text)))
    }
    _ => {}
  }
  let mut out = Bytes.make()
  let mut count: usize = 0
  let mut firstReserved = false
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => {
        if count == 0 {
          firstReserved = reserved(buffer.text(text))
        }
        if count != 0 {
          run Bytes.append(&mut out, b" ")
        }
        run Bytes.append(&mut out, buffer.text(text))
        count = count + 1
      }
      _ => {
        return Option<Bytes>.None
      }
    }
    at = skip(buffer, at + 1, range.end)
  }
  if count == 1 && firstReserved {
    return Option<Bytes>.None
  }
  return Option<Bytes>.some(move out)
}

fn formatKeyword(name: &[u8]) -> &'static [u8] {
  let names = [
    b"collection",
    b"embedded-opentype",
    b"opentype",
    b"svg",
    b"truetype",
    b"woff",
    b"woff2",
  ]
  let mut i: usize = 0
  while i < names.length {
    if insensitive(name, names[i]) {
      return names[i]
    }
    i = i + 1
  }
  return b""
}

fn techKeyword(name: &[u8]) -> &'static [u8] {
  let names = [
    b"features-opentype",
    b"features-aat",
    b"features-graphite",
    b"color-COLRv0",
    b"color-COLRv1",
    b"color-SVG",
    b"color-sbix",
    b"color-CBDT",
    b"variations",
    b"palettes",
    b"incremental",
  ]
  let mut i: usize = 0
  while i < names.length {
    if insensitive(name, names[i]) {
      return names[i]
    }
    i = i + 1
  }
  return b""
}

effect fn source(buffer: &TokenBuffer, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = skip(buffer, range.start, range.end)
  if at == range.end {
    return Option<Bytes>.None
  }
  let mut out = Bytes.make()
  let mut local = false
  match &buffer.tokens.asSlice()[at].kind {
    Kind.Url { text } => {
      out = run cssom_serialization.url(buffer.text(text))
      at = at + 1
    }
    Kind.Function { name } => {
      let close = buffer.tokens.asSlice()[at].matching
      let end = if close < range.end {
        close
      } else {
        range.end
      }
      let start = skip(buffer, at + 1, end)
      if insensitive(buffer.text(name), b"local") {
        let decoded = run family(buffer, TokenRange { start: start, end: end })
        match move decoded {
          Option<Bytes>.Some { value } => {
            run Bytes.append(&mut out, b"local(")
            let quoted = run cssom_serialization.string(Bytes.asSlice(&value))
            run Bytes.append(&mut out, Bytes.asSlice(&quoted))
            run Bytes.append(&mut out, b")")
            local = true
          }
          _ => {
            return Option<Bytes>.None
          }
        }
      } else if insensitive(buffer.text(name), b"url") && start < end {
        match &buffer.tokens.asSlice()[start].kind {
          Kind.String { text } => {
            if skip(buffer, start + 1, end) != end {
              return Option<Bytes>.None
            }
            out = run cssom_serialization.url(buffer.text(text))
          }
          _ => {
            return Option<Bytes>.None
          }
        }
      } else {
        return Option<Bytes>.None
      }
      at = if close < range.end {
        close + 1
      } else {
        range.end
      }
    }
    _ => {
      return Option<Bytes>.None
    }
  }
  at = skip(buffer, at, range.end)
  if local && at != range.end {
    return Option<Bytes>.None
  }
  let mut formatSeen = false
  let mut techSeen = false
  while at < range.end {
    let name = match &buffer.tokens.asSlice()[at].kind {
      Kind.Function { name } => buffer.text(name)
      _ => {
        return Option<Bytes>.None
      }
    }
    let isFormat = insensitive(name, b"format")
    let isTech = insensitive(name, b"tech")
    if (!isFormat && !isTech) || (isFormat && (formatSeen || techSeen)) || (isTech && techSeen) {
      return Option<Bytes>.None
    }
    let close = buffer.tokens.asSlice()[at].matching
    let end = if close < range.end {
      close
    } else {
      range.end
    }
    let mut inner = skip(buffer, at + 1, end)
    if inner == end {
      return Option<Bytes>.None
    }
    run Bytes.append(
      &mut out,
      if isFormat {
        b" format("
      } else {
        b" tech("
      },
    )
    let mut count: usize = 0
    while inner < end {
      if count != 0 {
        run Bytes.append(&mut out, b", ")
      }
      match &buffer.tokens.asSlice()[inner].kind {
        Kind.String { text } => {
          if !isFormat {
            return Option<Bytes>.None
          }
          let quoted = run cssom_serialization.string(buffer.text(text))
          run Bytes.append(&mut out, Bytes.asSlice(&quoted))
        }
        Kind.Ident { text } => {
          let keyword = if isFormat {
            formatKeyword(buffer.text(text))
          } else {
            techKeyword(buffer.text(text))
          }
          if keyword.length == 0 {
            return Option<Bytes>.None
          }
          if isFormat {
            let quoted = run cssom_serialization.string(keyword)
            run Bytes.append(&mut out, Bytes.asSlice(&quoted))
          } else {
            run Bytes.append(&mut out, keyword)
          }
        }
        _ => {
          return Option<Bytes>.None
        }
      }
      inner = skip(buffer, inner + 1, end)
      count = count + 1
      if inner < end {
        if isFormat
          || !match &buffer.tokens.asSlice()[inner].kind {
            Kind.Comma => true
            _ => false
          } {
          return Option<Bytes>.None
        }
        inner = skip(buffer, inner + 1, end)
        if inner == end {
          return Option<Bytes>.None
        }
      }
    }
    run Bytes.append(&mut out, b")")
    formatSeen = formatSeen || isFormat
    techSeen = techSeen || isTech
    at = skip(
      buffer,
      if close < range.end {
        close + 1
      } else {
        range.end
      },
      range.end,
    )
  }
  return Option<Bytes>.some(move out)
}

pub effect fn parse(buffer: &TokenBuffer, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut start = range.start
  while start < range.end {
    let mut at = start
    while at < range.end {
      let token = &buffer.tokens.asSlice()[at]
      if match &token.kind {
        Kind.Comma => true
        _ => false
      } {
        break
      }
      at = if token.matching > at && token.matching < range.end {
        token.matching + 1
      } else {
        at + 1
      }
    }

    // Fonts uses parse-a-list: a malformed source invalidates only that list item.
    match move run source(buffer, TokenRange { start: start, end: at }) {
      Option<Bytes>.Some { value } => {
        if Bytes.length(&out) != 0 {
          run Bytes.append(&mut out, b", ")
        }
        run Bytes.append(&mut out, Bytes.asSlice(&value))
      }
      _ => {}
    }
    start = at + 1
  }
  if Bytes.length(&out) == 0 {
    return Option<Bytes>.None
  }
  return Option<Bytes>.some(move out)
}
