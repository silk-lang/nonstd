//! Shadow selector behavior uses immutable node IDs and explicit tree-scope ownership.
//! CSS Shadow 1 pin: c84bdd0453ff210fa95fb95b118d7a8d365f189ea8fab1ee7db791f199fe1db4.
//! Selectors 4 pin: 5d3b3f7e1fcc562dcec1a01ad2c5651e9f0bac294b255a75352e9df202604e6d.
import selectors { SelectorList, Specificity, SubjectKey, SubjectKind, NamespaceBinding }
import selectors
import lexer
import tokens { Limits, CssError, CssErrorKind, Span, TokenRange }
import element { ElementTree, MatchContext, NO_ELEMENT }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

// Light: svg.theme(0) > use.outer(1), circle(2).
// Shadow of 1: g.wrap(3) > use.hot(5), circle.peer(6); g has sibling circle(4).
// Shadow of 5: symbol.leaf(7). Its raw sibling circle.light(8) is a light child of 5.
// Parent links include both boundaries; raw child lists intentionally mix scopes.
struct Tree {}

impl ElementTree for Tree {
  fn containingHost(self: &Self, node: usize) -> usize {
    return if node == 7 {
      5
    } else if node >= 3 {
      1
    } else {
      NO_ELEMENT
    }
  }

  fn parent(self: &Self, node: usize) -> usize {
    return if node == 0 {
      NO_ELEMENT
    } else if node <= 2 {
      0
    } else if node == 3 || node == 4 {
      1
    } else if node == 7 || node == 8 {
      5
    } else {
      3
    }
  }

  fn firstChild(self: &Self, node: usize) -> usize {
    return if node == 0 {
      1
    } else if node == 1 {
      3
    } else if node == 3 {
      5
    } else if node == 5 {
      7
    } else {
      NO_ELEMENT
    }
  }

  fn nextSibling(self: &Self, node: usize) -> usize {
    return if node == 1 || node == 3 || node == 5 || node == 7 {
      node + 1
    } else {
      NO_ELEMENT
    }
  }

  fn previousSibling(self: &Self, node: usize) -> usize {
    return if node == 2 || node == 4 || node == 6 || node == 8 {
      node - 1
    } else {
      NO_ELEMENT
    }
  }

  fn localName(self: &Self, node: usize) -> &[u8] {
    return if node == 0 {
      b"svg"
    } else if node == 1 || node == 5 {
      b"use"
    } else if node == 3 {
      b"g"
    } else if node == 7 {
      b"symbol"
    } else {
      b"circle"
    }
  }

  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    return b"urn:svg"
  }

  fn attributeCount(self: &Self, node: usize) -> usize {
    return 2
  }

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if attribute == 0 {
      b"id"
    } else {
      b"class"
    }
  }

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return b""
  }

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if attribute == 0 {
      return if node == 5 {
        b"inner"
      } else {
        b"other"
      }
    }
    return if node == 0 {
      b"theme"
    } else if node == 1 {
      b"outer"
    } else if node == 3 {
      b"wrap"
    } else if node == 5 {
      b"hot"
    } else if node == 6 {
      b"peer"
    } else if node == 7 {
      b"leaf"
    } else if node == 8 {
      b"light"
    } else {
      b""
    }
  }

  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return attribute == 0
  }

  fn language(self: &Self, node: usize) -> &[u8] {
    return b"en"
  }

  fn isRoot(self: &Self, node: usize) -> bool {
    return node == 0
  }

  fn isEmpty(self: &Self, node: usize) -> bool {
    return node == 2 || node == 4 || node >= 6
  }

  fn isLink(self: &Self, node: usize) -> bool {
    return false
  }
}

effect fn check(
  source: &[u8],
  node: usize,
  host: usize,
  yes: bool,
  ids: usize,
  classes: usize,
  types: usize,
) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      context.shadowHost = host
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: s } => yes && s.ids == ids && s.classes == classes
            && s.types == types
          _ => !yes
        },
        "shadow selector match and specificity",
      )
      run Testing.expect(context.shadowHost == host, "normal argument context must be restored")
    }
    _ => {
      run Testing.expect(false, "shadow selector must parse")
    }
  }
}

effect fn invalid(source: &[u8]) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &parsed {
      Option<SelectorList>.None => true
      _ => false
    },
    "host functions require one valid compound selector",
  )
}

// https://drafts.csswg.org/css-shadow-1/#host-selector (pin lines 1257-1274,1325-1335).
test effect fn hostSelectorsSelectOnlyTheCurrentHost() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":host", 5, 5, true, 0, 1, 0)
  run check(b":host", 7, 5, false, 0, 0, 0)
  run check(b":host", 1, 5, false, 0, 0, 0)
  run check(b":host(use.hot#inner)", 5, 5, true, 1, 2, 1)
  run check(b":host(circle)", 5, 5, false, 0, 0, 0)
  run check(b":host(*)", 5, 5, true, 0, 1, 0)
  run check(b":host-context(.theme)", 5, 5, true, 0, 2, 0)
  run check(b":host-context(.hot)", 5, 5, true, 0, 2, 0)
  run check(b":host-context(.peer)", 5, 5, false, 0, 0, 0)
  run check(b":host-context(.theme)", 7, 5, false, 0, 0, 0)
}

test effect fn hostSelectorsMatchNothingWithoutAShadowContext() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":host", 5, NO_ELEMENT, false, 0, 0, 0)
  run check(b":host(use)", 5, NO_ELEMENT, false, 0, 0, 0)
  run check(b":host-context(.theme)", 5, NO_ELEMENT, false, 0, 0, 0)
}

// https://drafts.csswg.org/css-shadow-1/#host-element-in-tree (pin lines 1214-1224).
// https://www.w3.org/TR/selectors-4/#featureless-elements (pin lines 1980-2033).
test effect fn featurelessHostsRejectOrdinarySimpleSelectors() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"*", 5, 5, false, 0, 0, 0)
  run check(b"use", 5, 5, false, 0, 0, 0)
  run check(b".hot", 5, 5, false, 0, 0, 0)
  run check(b"#inner", 5, 5, false, 0, 0, 0)
  run check(b"[class]", 5, 5, false, 0, 0, 0)
  run check(b"*:host", 5, 5, false, 0, 0, 0)
  run check(b"use:host", 5, 5, false, 0, 0, 0)
  run check(b":host.hot", 5, 5, false, 0, 0, 0)
  run check(b":host[class]", 5, 5, false, 0, 0, 0)
  run check(b":host:lang(en)", 5, 5, false, 0, 0, 0)
}

test effect fn featurelessHostsHonorLogicalEligibility() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":is(:host, :root)", 5, 5, true, 0, 1, 0)
  run check(b":where(:host)", 5, 5, true, 0, 0, 0)
  run check(b":not(:host(.missing))", 5, 5, true, 0, 2, 0)
  run check(b":not(.missing)", 5, 5, false, 0, 0, 0)
  run check(b":not(.missing:host)", 5, 5, false, 0, 0, 0)
  run check(b":not(:host > .leaf)", 5, 5, false, 0, 0, 0)
  run check(b":host:not(.missing)", 5, 5, false, 0, 0, 0)
  run check(b":has(.leaf)", 5, 5, false, 0, 0, 0)
  run check(b":host:has(> .leaf)", 5, 5, true, 0, 2, 0)
  run check(b":has(> .leaf):where(:host)", 5, 5, true, 0, 1, 0)
  run check(b":is(:has(.leaf), :host(.missing))", 5, 5, false, 0, 0, 0)
}

// https://drafts.csswg.org/css-shadow-1/#host-element-in-tree (pin lines 1214-1224).
test effect fn ordinaryAncestorAndSiblingTraversalStopsAtHost() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":host > symbol", 7, 5, true, 0, 1, 1)
  run check(b":host(use.hot) > symbol", 7, 5, true, 0, 2, 2)
  run check(b"use > symbol", 7, 5, false, 0, 0, 0)
  run check(b"* > symbol", 7, 5, false, 0, 0, 0)
  run check(b".wrap symbol", 7, 5, false, 0, 0, 0)
  run check(b".theme :host > symbol", 7, 5, false, 0, 0, 0)
  run check(b"g > :host", 5, 5, false, 0, 0, 0)
  run check(b":host + .peer", 6, 5, false, 0, 0, 0)
  run check(b":host ~ .peer", 6, 5, false, 0, 0, 0)
  run check(b"use + .peer", 6, 1, true, 0, 1, 1)
  run check(b":host:has(+ .peer)", 5, 5, false, 0, 0, 0)
  run check(b":host:has(~ .peer)", 5, 5, false, 0, 0, 0)
  run check(b":host > .light", 8, 5, false, 0, 0, 0)
  run check(b":host:has(> .light)", 5, 5, false, 0, 0, 0)
  run check(b"symbol:last-child", 7, 5, true, 0, 1, 1)
  run check(b".light:first-child", 8, 1, true, 0, 2, 0)
}

// Host arguments use the host's own scope, preserving the enclosing host boundary.
// https://drafts.csswg.org/css-shadow-1/#host-selector (pin lines 1265-1269,1325-1335).
test effect fn normalArgumentContextsPreserveNestedShadowBoundaries() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":host(:is(.hot, .missing))", 5, 5, true, 0, 2, 0)
  run check(b":host(:where(.hot):not(.missing))", 5, 5, true, 0, 2, 0)
  run check(b":host(:has(+ .peer))", 5, 5, true, 0, 2, 0)
  run check(b":host(:has(> .light))", 5, 5, true, 0, 2, 0)
  run check(b":host(:has(> .leaf))", 5, 5, false, 0, 0, 0)
  run check(b":host(:is(:host))", 5, 5, false, 0, 0, 0)
  run check(b":host(:not(:where(:host)))", 5, 5, true, 0, 1, 0)
  run check(b":host-context(:is(.outer))", 5, 5, true, 0, 2, 0)
  run check(b":host-context(:where(.theme))", 5, 5, true, 0, 1, 0)
  run check(b":host-context(:has(> .leaf))", 5, 5, false, 0, 0, 0)
  run check(b":host-context(:is(:has(> .wrap)))", 5, 5, false, 0, 0, 0)
  run check(b":host-context(:not(:where(:not(.theme))))", 5, 5, true, 0, 1, 0)
}

// https://drafts.csswg.org/css-shadow-1/#host-selector (pin lines 1264,1272-1274,1324,1331-1332).
test effect fn hostFunctionGrammarAndSpecificity() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":host(:is(.hot, #missing))", 5, 5, true, 1, 1, 0)
  run check(b":host(:where(#inner))", 5, 5, true, 0, 1, 0)
  run check(b":host-context(svg.theme)", 5, 5, true, 0, 2, 1)

  // Logical combinations inherit the compound-only grammar (Selectors 4 #logical-combination).
  run check(b":host(:is(svg use, .hot))", 5, 5, true, 0, 2, 0)
  run check(b":host(:where(svg use))", 5, 5, false, 0, 0, 0)
  run invalid(b":host(:not(svg use))")
  run invalid(b":host-context(:not(svg use))")
  run invalid(b":host()")
  run invalid(b":host(.hot, .outer)")
  run invalid(b":host(g > use)")
  run invalid(b":host-context()")
  run invalid(b":host-context(.theme, .hot)")
  run invalid(b":host-context(svg use)")
  run invalid(b":host-context")
}

// Shared matching work is an implementation bound, not a false/no-match result.
test effect fn shadowArgumentWorkSharesAndExhaustsTheCallerBudget() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b":host-context(:not(.missing))", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      context.shadowHost = 5
      context.remainingSteps = 10000
      let first = run selectors.matchElement(&value, &buffer, &tree, 5, &mut context)
      run Testing.expect(
        match &first {
          Option<Specificity>.Some { value: s } => true
          _ => false
        },
        "host-context traverses in normal context",
      )
      let spent = 10000 - context.remainingSteps
      run Testing.expect(spent > 1, "argument and ancestor work charge the shared budget")
      context.remainingSteps = spent - 1
      let result = run Effect.result(
        selectors.matchElement(&value, &buffer, &tree, 5, &mut context),
      )
      run Testing.expect(
        match &result {
          Result<Option<Specificity>, CssError>.Failure { error } => error.kind
            == CssErrorKind.MatchLimit
          _ => false
        },
        "normal-context evaluation cannot reset or hide exhaustion",
      )
      run Testing.expect(context.shadowHost == 5, "scope survives error propagation")
    }
    _ => {
      run Testing.expect(false, "host-context selector must parse before budget test")
    }
  }
}

// Default namespaces do not constrain featureless hosts, but explicit universal selectors do.
// https://www.w3.org/TR/selectors-4/#featureless-elements (pin lines 2005-2008).
test effect fn hostEligibilityIgnoresOnlyImplicitNamespaces() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"urn:foreign; :host", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bindings = [
    NamespaceBinding { prefix: Span { start: 0, end: 0 }, uri: Span { start: 0, end: 11 } },
  ]
  let mut start: usize = 0
  while start < buffer.tokens.length() && buffer.tokens.asSlice()[start].source.start < 13 {
    start = start + 1
  }
  let parsed = run selectors.parse(
    &buffer,
    TokenRange { start: start, end: buffer.all().end },
    &bindings,
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      context.shadowHost = 5
      let result = run selectors.matchElement(&value, &buffer, &tree, 5, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: s } => s.classes == 1
          _ => false
        },
        "default namespace does not hide a featureless host",
      )
    }
    _ => {
      run Testing.expect(false, "namespaced host selector parses")
    }
  }
}

test effect fn hostArgumentKeysNeverExcludeHostCandidates() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(
    b":host(use.hot#inner), :host-context(.theme), :is(:host(.hot)), :host > symbol",
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let mut keys = value.subjectKeys()
      let mut index: usize = 0
      while index < 4 {
        let key = keys.next()
        run Testing.expect(
          match &key {
            Option<SubjectKey>.Some { value: subject } => subject.kind
              == if index == 3 {
                SubjectKind.LocalName
              } else {
                SubjectKind.Any
              }
            _ => false
          },
          "host arguments are not necessary conditions on the subject",
        )
        index = index + 1
      }
      run Testing.expect(
        match keys.next() {
          Option<SubjectKey>.None => true
          _ => false
        },
        "one conservative key per arm",
      )
    }
    _ => {
      run Testing.expect(false, "host candidate selectors parse")
    }
  }
}
