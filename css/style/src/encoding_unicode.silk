//! Replacement-mode Unicode decoders from the pinned Encoding Standard.
import encoding_output { Output, scalar }
import tokens { CssError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8

// https://encoding.spec.whatwg.org/#utf-8-decoder
// The stdlib streaming decoder validates scalar bounds only after the last byte.
// Here the first continuation is constrained immediately, preserving the standard's
// required replacement partitions for overlongs, surrogates and out-of-range scalars.
pub effect fn utf8(data: &[u8], output: &mut Output) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  let mut needed: u8 = 0
  let mut cp: u32 = 0
  let mut lower: u8 = 128
  let mut upper: u8 = 191
  let mut start: usize = 0
  while at < data.length {
    let byte = data[at]
    if needed == 0 {
      start = at
      at = at + 1
      if byte < 128 {
        run scalar(&mut output.*, u8.toU32(byte), start)
      } else if byte >= 194 && byte <= 223 {
        needed = 1
        cp = u8.toU32(byte - 192)
      } else if byte >= 224 && byte <= 239 {
        needed = 2
        cp = u8.toU32(byte - 224)
        if byte == 224 {
          lower = 160
        }
        if byte == 237 {
          upper = 159
        }
      } else if byte >= 240 && byte <= 244 {
        needed = 3
        cp = u8.toU32(byte - 240)
        if byte == 240 {
          lower = 144
        }
        if byte == 244 {
          upper = 143
        }
      } else {
        run scalar(&mut output.*, 65533, start)
      }
    } else if byte < lower || byte > upper {
      needed = 0
      cp = 0
      lower = 128
      upper = 191
      run scalar(&mut output.*, 65533, start)
      // Reconsume the current byte after replacing the incomplete prefix.
    } else {
      at = at + 1
      lower = 128
      upper = 191
      cp = cp * 64 + u8.toU32(byte - 128)
      needed = needed - 1
      if needed == 0 {
        run scalar(&mut output.*, cp, start)
      }
    }
  }
  if needed != 0 {
    run scalar(&mut output.*, 65533, start)
  }
}

// https://encoding.spec.whatwg.org/#shared-utf-16-decoder
pub effect fn utf16(data: &[u8], bigEndian: bool, output: &mut Output) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  let mut lead: u32 = 0
  let mut leadOffset: usize = 0
  while data.length - at >= 2 {
    let offset = at
    let first = u8.toU32(data[at])
    let second = u8.toU32(data[at + 1])
    let unit = if bigEndian {
      first * 256 + second
    } else {
      second * 256 + first
    }
    at = at + 2
    if lead != 0 {
      if unit >= 56320 && unit <= 57343 {
        run scalar(&mut output.*, 65536 + (lead - 55296) * 1024 + unit - 56320, leadOffset)
        lead = 0
        continue
      }
      run scalar(&mut output.*, 65533, leadOffset)
      lead = 0
      // Restoring the current pair is equivalent to processing this code unit
      // below with the leading surrogate reset; no byte queue is allocated.
    }
    if unit >= 55296 && unit <= 56319 {
      lead = unit
      leadOffset = offset
    } else if unit >= 56320 && unit <= 57343 {
      run scalar(&mut output.*, 65533, offset)
    } else {
      run scalar(&mut output.*, unit, offset)
    }
  }

  // EOF with both a leading surrogate and an odd byte is ONE decoder error.
  if lead != 0 || at < data.length {
    run scalar(
      &mut output.*,
      65533,
      if lead != 0 {
        leadOffset
      } else {
        at
      },
    )
  }
}
