//! Grammar boundaries from Selectors 4, Nesting 1, Pseudo 4 and Shadow 1.
//! CSSOM validation is deliberately separate from a resolved nesting matching AST.
import selectors { SelectorList, Specificity }
import selectors
import lexer
import tokens { Limits, CssError, CssErrorKind }
import element { ElementTree, AttributeText, MatchContext, NO_ELEMENT }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

struct Tree {}

impl ElementTree for Tree {
  fn parent(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn containingHost(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn firstChild(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn nextSibling(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn previousSibling(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn localName(self: &Self, node: usize) -> &[u8] {
    return b"rect"
  }

  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    return b""
  }

  fn attributeCount(self: &Self, node: usize) -> usize {
    return 0
  }

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return b""
  }

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return b""
  }

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return b""
  }

  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return false
  }

  fn attribute<'a>(self: &'a Self, node: usize, attribute: usize) -> AttributeText<'a> {
    return AttributeText<'a> { namespace: b"", name: b"", value: b"" }
  }

  fn language(self: &Self, node: usize) -> &[u8] {
    return b"en"
  }

  fn isRoot(self: &Self, node: usize) -> bool {
    return true
  }

  fn isEmpty(self: &Self, node: usize) -> bool {
    return true
  }

  fn isLink(self: &Self, node: usize) -> bool {
    return false
  }
}

effect fn grammar(source: &[u8], nested: bool, expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let valid = run selectors.validateCssom(&buffer, buffer.all(), &[], &limits, nested)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(valid == expected, "CSSOM selector grammar boundary")
}

effect fn staticMatch(source: &[u8], expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      let result = run selectors.matchElement(&value, &buffer, &tree, 0, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: specificity } => expected
          _ => !expected
        },
        "pseudo-elements never match ordinary elements",
      )
    }
    _ => {
      run Testing.expect(false, "static selector parses")
    }
  }
}

// https://drafts.csswg.org/selectors-4/#pseudo-element-syntax
// https://drafts.csswg.org/css-pseudo-4/#element-backed
// https://drafts.csswg.org/css-shadow-1/#slotted-pseudo
// https://drafts.csswg.org/css-shadow-1/#part
// These checks distinguish syntactic validity from the absence of pseudo nodes.
test effect fn corePseudoElementsAndAllowedSuffixes() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run grammar(b"rect:before, rect::after, ::first-line, ::first-letter", false, true)
  run grammar(b"::marker, ::placeholder, ::file-selector-button, ::backdrop", false, true)
  run grammar(b"::selection, ::target-text, ::spelling-error, ::grammar-error", false, true)
  run grammar(b"::before:hover:focus-visible:not(:active)", false, true)
  run grammar(b"::first-line:is(:hover, .invalid):where(:focus)", false, true)
  run grammar(b"::before::marker:hover, ::after::marker", false, true)
  run grammar(b"::first-letter::prefix, ::first-letter::suffix", false, true)
  run grammar(b"::search-text:current", false, true)
  run grammar(b"::part(label)::before::marker, ::part(label):nth-child(2)", false, true)
  run grammar(b"::part(label)::part(inner)", false, true)
  run grammar(b"::slotted(rect.hot)::before", false, true)
  run grammar(b"::unknown", false, false)
  run grammar(b":marker", false, false)
  run grammar(b"::before.hot", false, false)
  run grammar(b"::before#id", false, false)
  run grammar(b"::before[attr]", false, false)
  run grammar(b"::before&", true, false)
  run grammar(b"::before:empty", false, false)
  run grammar(b"::before:not(.hot)", false, false)
  run grammar(b"::before:not(:hover > :active)", false, false)
  run grammar(b"::before::after", false, false)
  run grammar(b"::marker::before", false, false)
  run grammar(b"::prefix", false, false)
  run grammar(b"::slotted(rect)::first-line", false, false)
  run grammar(b"::before > rect", false, false)
  run grammar(b"::first-letter rect", false, false)
}

// Every non-forgiving argument must consume its complete grammar, not a prefix.
// https://drafts.csswg.org/css-pseudo-4/#highlight-pseudos
test effect fn functionalPseudoElementsConsumeWholeArguments() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run grammar(b"::highlight(MyName), ::highlight(*)", false, true)
  run grammar(b"::part(foo bar), ::part(initial)", false, true)
  run grammar(b"::slotted(rect:is(.a, .b))", false, true)
  run grammar(b"::highlight()", false, false)
  run grammar(b"::highlight(initial)", false, false)
  run grammar(b"::highlight(revert-layer)", false, false)
  run grammar(b"::highlight(default)", false, false)
  run grammar(b"::highlight(foo bar)", false, false)
  run grammar(b"::highlight(foo, bar)", false, false)
  run grammar(b"::highlight('foo')", false, false)
  run grammar(b"::highlight(* foo)", false, false)
  run grammar(b"::part()", false, false)
  run grammar(b"::part(foo, bar)", false, false)
  run grammar(b"::part('foo')", false, false)
  run grammar(b"::part(foo.bar)", false, false)
  run grammar(b"::slotted()", false, false)
  run grammar(b"::slotted(rect, circle)", false, false)
  run grammar(b"::slotted(rect > circle)", false, false)
  run grammar(b"::slotted(::before)", false, false)
  run grammar(b"::before(foo)", false, false)
  run grammar(b":dir(ltr), :dir(RTL)", false, true)
  run grammar(b":dir(ltr extra)", false, false)
  run grammar(b":dir('ltr')", false, false)
  run grammar(b":lang(en, 'fr')", false, true)
  run grammar(b":lang(en extra)", false, false)
  run grammar(b":nth-child(2n junk)", false, false)
}

// https://drafts.csswg.org/selectors-4/#forgiving-selector
// https://drafts.csswg.org/selectors-4/#relational
test effect fn forgivingAndUnforgivingPseudoListsStayDistinct() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run grammar(b":is(::before, rect), :where(::marker)", false, true)
  run grammar(b":is(, :unknown, rect,)", false, true)
  run grammar(b"rect, ::unknown", false, false)
  run grammar(b":not(::before, rect)", false, false)
  run grammar(b":has(> rect, ::before)", false, false)
  run grammar(b":has(:has(rect))", false, false)
  run grammar(b":nth-child(2n of rect, ::marker)", false, false)
  run grammar(b":host(::before)", false, false)
  run grammar(b":has()", false, false)
  run grammar(b":not()", false, false)
  run staticMatch(b":is(::before, rect)", true)
  run staticMatch(b":where(::marker)", false)
}

// https://drafts.csswg.org/css-nesting-1/#syntax
// https://drafts.csswg.org/css-nesting-1/#nest-selector
test effect fn nestingRequiresRelativeContextButAmpersandDoesNot() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run grammar(b"&", false, true)
  run grammar(b"& > rect, .parent &", true, true)
  run grammar(b"rect&, &.hot, &&, :is(&, rect)", true, true)
  run grammar(b"> rect, + circle, ~ g", true, true)
  run grammar(b"rect, ::before, > ::marker", true, true)
  run grammar(b"&:has(> &)", true, true)
  run grammar(b":is(:unknown(&), rect)", true, true)
  run grammar(b"> rect", false, false)
  run grammar(b"&rect", true, false)
  run grammar(b"&-suffix", true, false)
  run grammar(b"&|rect", true, false)
  run grammar(b">", true, false)
  run grammar(b"> > rect", true, false)
  run grammar(b":not(> rect)", true, false)
  run grammar(b"&::before&", true, false)
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"&", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &parsed {
      Option<SelectorList>.None => true
      _ => false
    },
    "static matching does not invent parent specificity for nesting",
  )
}

test effect fn pseudoElementsAndDynamicStatesNeverMatchStaticElements() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run staticMatch(b"rect::before:hover, rect::after::marker", false)
  run staticMatch(b"::part(label), ::slotted(rect), ::highlight(foo)", false)
  run staticMatch(b"::selection, ::marker, ::placeholder, ::file-selector-button", false)
  run staticMatch(b":hover, :active, :focus, :visited, :enabled, :checked, :dir(ltr)", false)
  run staticMatch(b"rect, rect::before", true)
}

test effect fn forgivingListsDoNotSwallowResourceLimits() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut limits = Limits.make()
  let buffer = run lexer.tokenize(b":is(:is(:is(rect)))", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  limits.maxDepth = 2
  let result = run Effect.result(selectors.validateCssom(&buffer, buffer.all(), &[], &limits, true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &result {
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        _ => false
      }
      _ => false
    },
    "resource failures escape forgiving selector parsing",
  )
}
