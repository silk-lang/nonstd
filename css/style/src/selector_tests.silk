//! Selector tests use the real tokenizer and parser and an element-only host tree.
import selectors { SelectorList, Specificity, NamespaceBinding }
import selectors
import lexer
import tokens { Limits, CssError, CssErrorKind, Span, TokenRange }
import element { ElementTree, MatchContext, NO_ELEMENT }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

// svg(0) > g(1) > rect(2), circle(3), rect(4); svg > foreign rect(5).
// The host reports whitespace-only content at 2, but non-whitespace text at 4.
// Both have no element children: :empty must use host semantics, not firstChild.
struct Tree {}

impl ElementTree for Tree {
  fn containingHost(self: &Self, node: usize) -> usize {
    return NO_ELEMENT
  }

  fn parent(self: &Self, node: usize) -> usize {
    if node == 0 {
      return NO_ELEMENT
    }
    return if node == 1 || node == 5 {
      0
    } else {
      1
    }
  }

  fn firstChild(self: &Self, node: usize) -> usize {
    return if node == 0 {
      1
    } else if node == 1 {
      2
    } else {
      NO_ELEMENT
    }
  }

  fn nextSibling(self: &Self, node: usize) -> usize {
    return if node == 1 {
      5
    } else if node == 2 || node == 3 {
      node + 1
    } else {
      NO_ELEMENT
    }
  }

  fn previousSibling(self: &Self, node: usize) -> usize {
    return if node == 5 {
      1
    } else if node == 3 || node == 4 {
      node - 1
    } else {
      NO_ELEMENT
    }
  }

  fn localName(self: &Self, node: usize) -> &[u8] {
    return if node == 0 {
      b"svg"
    } else if node == 1 {
      b"g"
    } else if node == 3 {
      b"circle"
    } else {
      b"rect"
    }
  }

  fn namespaceUri(self: &Self, node: usize) -> &[u8] {
    return if node == 5 {
      b"urn:foreign"
    } else {
      b"urn:svg"
    }
  }

  fn attributeCount(self: &Self, node: usize) -> usize {
    return if node == 5 {
      4
    } else if node == 2 || node == 4 {
      3
    } else {
      0
    }
  }

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if attribute == 0 {
      b"id"
    } else if attribute == 1 {
      b"class"
    } else if attribute == 3 {
      b"key"
    } else {
      b"label"
    }
  }

  // The foreign vocabulary declares key as ID; its attribute named id is untyped.
  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool {
    return if node == 5 {
      attribute == 3
    } else {
      attribute == 0
    }
  }

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8] {
    return if attribute == 2 {
      b"urn:foreign"
    } else {
      b""
    }
  }

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8] {
    if attribute == 3 {
      return b"AliasCase"
    }
    if attribute == 0 {
      return if node == 2 {
        b"chosen"
      } else {
        b"other"
      }
    }
    return if attribute == 1 {
      b"hot selected"
    } else {
      b"AbC-def word"
    }
  }

  fn language(self: &Self, node: usize) -> &[u8] {
    return b"en-Latn-US"
  }

  fn isRoot(self: &Self, node: usize) -> bool {
    return node == 0
  }

  fn isEmpty(self: &Self, node: usize) -> bool {
    return node >= 2 && node != 4
  }

  fn isLink(self: &Self, node: usize) -> bool {
    return node == 4
  }
}

effect fn check(
  source: &[u8],
  node: usize,
  yes: bool,
  ids: usize,
  classes: usize,
  types: usize,
) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(1, 2)
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: specificity } => yes && specificity.ids == ids
            && specificity.classes == classes
            && specificity.types == types
          _ => !yes
        },
        "parsed selector match and specificity",
      )
    }
    _ => {
      run Testing.expect(false, "selector must parse")
    }
  }
}

effect fn invalid(source: &[u8]) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(source, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match &parsed {
      Option<SelectorList>.None => true
      _ => false
    },
    "invalid selector rejected",
  )
}

// https://www.w3.org/TR/selectors-4/#specificity-rules
// https://www.w3.org/TR/selectors-4/#matches
// https://www.w3.org/TR/selectors-4/#negation
test effect fn competingMatchingArmsAndFunctionalSpecificity() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"rect, #missing, .hot", 2, true, 0, 1, 0)
  run check(b"rect, #chosen, .hot", 2, true, 1, 0, 0)
  run check(b":is(rect, #missing)", 2, true, 1, 0, 0)
  run check(b".hot:where(#chosen#chosen, rect)", 2, true, 0, 1, 0)
  run check(b":not(circle, #missing)", 2, true, 1, 0, 0)
  run check(b":is(:unknown, rect)", 2, true, 0, 0, 1)
  run check(b":where(:unknown)", 2, false, 0, 0, 0)
  run check(b":is(#missing#missing, .hot)", 2, true, 2, 0, 0)
  run check(b":is(, :unknown, rect,)", 2, true, 0, 0, 1)
  run check(b":not(:is(circle, #other))", 2, true, 1, 0, 0)
  run check(b"r\\65 ct.\\68 ot#ch\\6f sen", 2, true, 1, 1, 1)
  run invalid(b"rect, :unknown")
  run invalid(b":not(rect, :unknown)")
}

// https://www.w3.org/TR/selectors-4/#relational
// https://www.w3.org/TR/selectors-4/#grammar
test effect fn combinatorsRelativeSelectorsAndHasBoundaries() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"svg g > rect + circle ~ rect", 4, true, 0, 0, 5)
  run check(b"g:has(> rect + circle)", 1, true, 0, 0, 3)
  run check(b"rect:has(+ circle)", 2, true, 0, 0, 2)
  run check(b"rect:has(~ rect)", 2, true, 0, 0, 2)
  run check(b"g:has(> rect, #absent)", 1, true, 1, 0, 1)
  run check(b"svg:has(> g > rect:last-child)", 0, true, 0, 1, 3)
  run check(b"g:has(+ rect)", 1, true, 0, 0, 2)
  run check(b"rect:has(+ rect)", 2, false, 0, 0, 0)
  run check(b"g:has(> rect > circle)", 1, false, 0, 0, 0)
  run check(b"g:has(:scope > rect)", 1, false, 0, 0, 0)
  run invalid(b"g:has(:has(rect))")
  run invalid(b"g:has(rect, :unknown)")
  run invalid(b"g:has(::before)")
  run invalid(b"rect >")
  run invalid(b"rect,,circle")
}

// https://www.w3.org/TR/selectors-4/#the-nth-child-pseudo
// https://www.w3.org/TR/selectors-4/#specificity-rules
test effect fn structuralAndFilteredNth() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"rect:nth-child(2n + 1)", 4, true, 0, 1, 1)
  run check(b"rect:nth-child(-n+2)", 4, false, 0, 0, 0)
  run check(b"rect:nth-child(2 of .hot, #missing)", 4, true, 1, 1, 1)
  run check(b"rect:nth-last-child(1 of .hot)", 4, true, 0, 2, 1)
  run check(b"rect:nth-of-type(even):last-of-type", 4, true, 0, 2, 1)
  run check(b"rect:first-child:first-of-type", 2, true, 0, 2, 1)
  run check(b"rect:only-child", 2, false, 0, 0, 0)
  run check(b"circle:only-of-type", 3, true, 0, 1, 1)
  run check(b":nth-child(+n- 1)", 2, true, 0, 1, 0)
  run check(b":nth-child(n-1)", 4, true, 0, 1, 0)
  run check(b":nth-child(0n+3)", 4, true, 0, 1, 0)
  run check(b":nth-child(-2n+5)", 4, true, 0, 1, 0)
  run check(b":nth-child(odd of .hot)", 3, false, 0, 0, 0)
  run invalid(b":nth-child(2-n)")
  run invalid(b":nth-child(n + -1)")
  run invalid(b":nth-child(2n 1)")
  run invalid(b":nth-child(2 n+1)")
  run invalid(b":nth-child(2 of :unknown)")
  run invalid(b":nth-of-type(2 of rect)")
}

// https://www.w3.org/TR/selectors-4/#attribute-case
// https://www.w3.org/TR/selectors-4/#lang-pseudo
// https://www.w3.org/TR/selectors-4/#empty-pseudo
test effect fn attributesAndStaticHostSemantics() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"[class~=selected][*|label^=abc i][*|label$=word][*|label*=def]", 2, true, 0, 4, 0)
  run check(b"[*|label^=abc s]", 2, false, 0, 0, 0)
  run check(b"[label]", 2, false, 0, 0, 0)
  run check(b"[*|label^='']", 2, false, 0, 0, 0)
  run check(b"[*|label|=AbC]", 2, true, 0, 1, 0)
  run check(b":lang(en):lang('en-*-US'):empty:target", 2, true, 0, 4, 0)
  run check(b":empty", 4, false, 0, 0, 0)
  run check(b":scope > :link", 4, true, 0, 2, 0)
  run check(b":root", 0, true, 0, 1, 0)
  run check(
    b":hover, :active, :focus, :visited, :enabled, :disabled, :checked, ::before",
    2,
    false,
    0,
    0,
    0,
  )
  run invalid(b"[class=hot unknown]")
}

// https://www.w3.org/TR/selectors-4/#id-selectors
test effect fn idSelectorsUseHostTypingAndCaseSensitiveRawValues() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b"#AliasCase", 5, true, 1, 0, 0)
  run check(b"#Alias\\43 ase", 5, true, 1, 0, 0)
  run check(b"#aliascase", 5, false, 0, 0, 0)
  run check(b"#other", 5, false, 0, 0, 0)
  run check(b"[id=other][key=AliasCase]", 5, true, 0, 2, 0)
  run check(b"#chosen", 2, true, 1, 0, 0)
}

// https://www.w3.org/TR/selectors-4/#type-nmsp
// https://www.w3.org/TR/selectors-4/#matches
test effect fn namespaceBindingsAndImplicitSubjectNamespace() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()

  // Namespace text is tokenized into the same arena, outside the selector range.
  let buffer = run lexer.tokenize(b"urn:svg p urn:foreign; *|*:is(.hot), p|rect", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bindings = [
    NamespaceBinding { prefix: Span { start: 0, end: 0 }, uri: Span { start: 0, end: 7 } },
    NamespaceBinding { prefix: Span { start: 8, end: 9 }, uri: Span { start: 10, end: 21 } },
  ]
  let mut start: usize = 0
  while start < buffer.tokens.length() {
    if buffer.tokens.asSlice()[start].source.start >= 23 {
      break
    }
    start = start + 1
  }
  let parsed = run selectors.parse(
    &buffer,
    TokenRange { start: start, end: buffer.all().end },
    &bindings,
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tree = Tree {}
  let mut context = MatchContext.make(0, NO_ELEMENT)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let result = run selectors.matchElement(&value, &buffer, &tree, 5, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: s } => s.classes == 1 && s.types == 0
          _ => false
        },
        "is subject ignores implicit default namespace; matching arm wins",
      )
    }
    _ => {
      run Testing.expect(false, "bound prefixes parse")
    }
  }
  run invalid(b"undeclared|rect")
  run check(b"|rect", 2, false, 0, 0, 0)
  run check(b"*|rect", 5, true, 0, 0, 1)
}

// https://www.w3.org/TR/selectors-4/#grammar
test effect fn matchingWorkIsSharedAndTyped() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"rect", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run selectors.parse(&buffer, buffer.all(), &[], &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext {
        scope: 0,
        target: NO_ELEMENT,
        shadowHost: NO_ELEMENT,
        remainingSteps: 6,
      }
      let first = run selectors.matchElement(&value, &buffer, &tree, 2, &mut context)
      run Testing.expect(
        match &first {
          Option<Specificity>.Some { value: s } => context.remainingSteps == 0
          _ => false
        },
        "successful matching consumes the shared work budget",
      )
      let result = run Effect.result(
        selectors.matchElement(&value, &buffer, &tree, 2, &mut context),
      )
      run Testing.expect(
        match &result {
          Result<Option<Specificity>, CssError>.Failure { error } => error.kind
            == CssErrorKind.MatchLimit
          _ => false
        },
        "budget exhaustion propagates rather than becoming a nonmatch",
      )
    }
    _ => {
      run Testing.expect(false, "selector parses")
    }
  }
}

effect fn namespaceCheck(source: &[u8], node: usize, yes: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let mut input = run Bytes.copy(b"urn:svg p urn:foreign; ")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Bytes.append(&mut input, source) |> Effect.provideMut<Allocator>(&mut allocator)
  let buffer = run lexer.tokenize(Bytes.asSlice(&input), &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bindings = [
    NamespaceBinding { prefix: Span { start: 0, end: 0 }, uri: Span { start: 0, end: 7 } },
    NamespaceBinding { prefix: Span { start: 8, end: 9 }, uri: Span { start: 10, end: 21 } },
  ]
  let mut start: usize = 0
  while start < buffer.tokens.length() && buffer.tokens.asSlice()[start].source.start < 23 {
    start = start + 1
  }
  let parsed = run selectors.parse(
    &buffer,
    TokenRange { start: start, end: buffer.all().end },
    &bindings,
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<SelectorList>.Some { value } => {
      let tree = Tree {}
      let mut context = MatchContext.make(0, NO_ELEMENT)
      let result = run selectors.matchElement(&value, &buffer, &tree, node, &mut context)
      run Testing.expect(
        match &result {
          Option<Specificity>.Some { value: s } => yes
          _ => !yes
        },
        "namespace-aware real parser match",
      )
    }
    _ => {
      run Testing.expect(false, "namespace selector parses")
    }
  }
}

// https://www.w3.org/TR/selectors-4/#type-nmsp
// https://www.w3.org/TR/selectors-4/#matches
// https://www.w3.org/TR/selectors-4/#the-nth-child-pseudo
test effect fn namespaceRestrictionsDoNotLeakIntoLogicalSubjects() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run namespaceCheck(b".hot", 5, false)
  run namespaceCheck(b"rect", 5, false)
  run namespaceCheck(b"p|rect", 5, true)
  run namespaceCheck(b"*|*:is(.hot)", 5, true)
  run namespaceCheck(b"*|*:is(*.hot)", 5, false)
  run namespaceCheck(b"*|*:not(.hot)", 5, false)
  run namespaceCheck(b"*|*:not(*.hot)", 5, true)
  run namespaceCheck(b"*|*:where(.hot)", 5, true)
  run namespaceCheck(b"[p|label]", 2, true)
  run namespaceCheck(b"[|label]", 2, false)
  run namespaceCheck(b"*|*:nth-child(1 of .hot)", 5, false)
  run namespaceCheck(b"*|*:nth-child(1 of *|*.hot)", 5, true)
}

// https://www.w3.org/TR/selectors-4/#grammar
// https://www.w3.org/TR/selectors-4/#typedef-forgiving-selector-list
test effect fn selectorDepthErrorsSurviveForgivingLists() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let normal = Limits.make()
  let buffer = run lexer.tokenize(b":is(:is(:is(rect)), rect)", &normal)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut limits = Limits.make()
  limits.maxDepth = 2
  let result = run Effect.result(
    selectors.parse(&buffer, buffer.all(), &[], &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &result {
      Result<Option<SelectorList>, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "forgiving syntax must not hide nesting exhaustion",
  )
}

// https://www.w3.org/TR/css-syntax-3/#consume-function
// https://www.w3.org/TR/css-syntax-3/#consume-simple-block
test effect fn implicitComponentClosuresDoNotBecomeUnmatchedClosers() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run check(b":is(circle, rect", 2, true, 0, 0, 1)
  run check(b"[class~=hot", 2, true, 0, 1, 0)
  run check(b":not(:is(circle", 2, true, 0, 0, 1)
  run invalid(b"rect)")
  run invalid(b"[class=hot)]")
}
