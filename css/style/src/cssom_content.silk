//! Generated content grammar used by page-margin declaration blocks.
import tokens { TokenBuffer, TokenRange, Kind, insensitive }
import cssom_serialization
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn skip(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let mut at = start
  while at < end
    && match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => true
      _ => false
    } {
    at = at + 1
  }
  return at
}

fn reserved(name: &[u8]) -> bool {
  return insensitive(name, b"initial") || insensitive(name, b"inherit")
    || insensitive(name, b"unset")
    || insensitive(name, b"revert")
    || insensitive(name, b"revert-layer")
    || insensitive(name, b"none")
    || insensitive(name, b"default")
}

effect fn counter(buffer: &TokenBuffer, range: TokenRange, plural: bool) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = skip(buffer, range.start, range.end)
  if at == range.end {
    return Option<Bytes>.None
  }
  let name = match &buffer.tokens.asSlice()[at].kind {
    Kind.Ident { text } => buffer.text(text)
    _ => {
      return Option<Bytes>.None
    }
  }
  if reserved(name) {
    return Option<Bytes>.None
  }
  let mut out = run Bytes.copy(
    if plural {
      b"counters("
    } else {
      b"counter("
    },
  )
  let escaped = run cssom_serialization.identifier(name)
  run Bytes.append(&mut out, Bytes.asSlice(&escaped))
  at = skip(buffer, at + 1, range.end)
  if plural {
    if at == range.end
      || !match &buffer.tokens.asSlice()[at].kind {
        Kind.Comma => true
        _ => false
      } {
      return Option<Bytes>.None
    }
    at = skip(buffer, at + 1, range.end)
    if at == range.end {
      return Option<Bytes>.None
    }
    match &buffer.tokens.asSlice()[at].kind {
      Kind.String { text } => {
        run Bytes.append(&mut out, b", ")
        let separator = run cssom_serialization.string(buffer.text(text))
        run Bytes.append(&mut out, Bytes.asSlice(&separator))
      }
      _ => {
        return Option<Bytes>.None
      }
    }
    at = skip(buffer, at + 1, range.end)
  }
  if at < range.end {
    if !match &buffer.tokens.asSlice()[at].kind {
      Kind.Comma => true
      _ => false
    } {
      return Option<Bytes>.None
    }
    at = skip(buffer, at + 1, range.end)
    if at == range.end {
      return Option<Bytes>.None
    }
    let style = match &buffer.tokens.asSlice()[at].kind {
      Kind.Ident { text } => buffer.text(text)
      _ => {
        return Option<Bytes>.None
      }
    }
    if reserved(style) && !insensitive(style, b"none") {
      return Option<Bytes>.None
    }
    if !insensitive(style, b"decimal") {
      run Bytes.append(&mut out, b", ")
      let escapedStyle = run cssom_serialization.identifier(style)
      run Bytes.append(&mut out, Bytes.asSlice(&escapedStyle))
    }
    at = skip(buffer, at + 1, range.end)
  }
  if at != range.end {
    return Option<Bytes>.None
  }
  run Bytes.append(&mut out, b")")
  return Option<Bytes>.some(move out)
}

pub effect fn parse(buffer: &TokenBuffer, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at = skip(buffer, range.start, range.end)
  while at < range.end {
    let mut part = Bytes.make()
    let token = &buffer.tokens.asSlice()[at]
    let mut next = at + 1
    match &token.kind {
      Kind.String { text } => {
        part = run cssom_serialization.string(buffer.text(text))
      }
      Kind.Url { text } => {
        part = run cssom_serialization.url(buffer.text(text))
      }
      Kind.Ident { text } => {
        let name = buffer.text(text)
        let mut found = false
        let keywords = [
          b"normal",
          b"none",
          b"open-quote",
          b"close-quote",
          b"no-open-quote",
          b"no-close-quote",
        ]
        let mut i: usize = 0
        while i < keywords.length {
          if insensitive(name, keywords[i]) {
            if i < 2 && (Bytes.length(&out) != 0 || skip(buffer, next, range.end) != range.end) {
              return Option<Bytes>.None
            }
            part = run Bytes.copy(keywords[i])
            found = true
            break
          }
          i = i + 1
        }
        if !found {
          return Option<Bytes>.None
        }
      }
      Kind.Function { name } => {
        let close = if token.matching < range.end {
          token.matching
        } else {
          range.end
        }
        let inner = TokenRange { start: at + 1, end: close }
        let function = buffer.text(name)
        if insensitive(function, b"counter") || insensitive(function, b"counters") {
          match move run counter(buffer, inner, insensitive(function, b"counters")) {
            Option<Bytes>.Some { value } => {
              part = move value
            }
            _ => {
              return Option<Bytes>.None
            }
          }
        } else if insensitive(function, b"url") {
          let first = skip(buffer, inner.start, close)
          if first == close || skip(buffer, first + 1, close) != close {
            return Option<Bytes>.None
          }
          match &buffer.tokens.asSlice()[first].kind {
            Kind.String { text } => {
              part = run cssom_serialization.url(buffer.text(text))
            }
            _ => {
              return Option<Bytes>.None
            }
          }
        } else if insensitive(function, b"attr") {
          let first = skip(buffer, inner.start, close)
          if first == close || skip(buffer, first + 1, close) != close {
            return Option<Bytes>.None
          }
          match &buffer.tokens.asSlice()[first].kind {
            Kind.Ident { text } => {
              run Bytes.append(&mut part, b"attr(")
              let attr = run cssom_serialization.identifier(buffer.text(text))
              run Bytes.append(&mut part, Bytes.asSlice(&attr))
              run Bytes.append(&mut part, b")")
            }
            _ => {
              return Option<Bytes>.None
            }
          }
        } else {
          return Option<Bytes>.None
        }
        next = if close < range.end {
          close + 1
        } else {
          range.end
        }
      }
      _ => {
        return Option<Bytes>.None
      }
    }
    if Bytes.length(&out) != 0 {
      run Bytes.append(&mut out, b" ")
    }
    run Bytes.append(&mut out, Bytes.asSlice(&part))
    at = skip(buffer, next, range.end)
  }
  if Bytes.length(&out) == 0 {
    return Option<Bytes>.None
  }
  return Option<Bytes>.some(move out)
}
