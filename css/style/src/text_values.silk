//! Validated SVG font/text values, including CSS Text4 whitespace longhands and shorthand expansion.
//! Semantic strings are owned; numeric expressions remain in dimensions.Store.
import dimensions { ExprId, Dimension, Unit, Expr }
import colors { Color }
import dimensions
import colors
import properties { Property }
import input { Input, TokenView }
import value_cursor { Cursor }
import tokens { Kind, Span, insensitive, equal }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.usize

pub enum Keyword {
  Normal,
  None,
  Auto,
  Italic,
  Oblique,
  Left,
  Right,
  Bold,
  Bolder,
  Lighter,
  XxSmall,
  XSmall,
  Small,
  Medium,
  Large,
  XLarge,
  XxLarge,
  XxxLarge,
  Smaller,
  Larger,
  Math,
  UltraCondensed,
  ExtraCondensed,
  Condensed,
  SemiCondensed,
  SemiExpanded,
  Expanded,
  ExtraExpanded,
  UltraExpanded,
  SmallCaps,
  AllSmallCaps,
  PetiteCaps,
  AllPetiteCaps,
  Unicase,
  TitlingCaps,
  CommonLigatures,
  NoCommonLigatures,
  DiscretionaryLigatures,
  NoDiscretionaryLigatures,
  HistoricalLigatures,
  NoHistoricalLigatures,
  Contextual,
  NoContextual,
  LiningNums,
  OldstyleNums,
  ProportionalNums,
  TabularNums,
  DiagonalFractions,
  StackedFractions,
  Ordinal,
  SlashedZero,
  Jis78,
  Jis83,
  Jis90,
  Jis04,
  Simplified,
  Traditional,
  FullWidth,
  ProportionalWidth,
  Ruby,
  HistoricalForms,
  Sub,
  Super,
  Text,
  Emoji,
  Unicode,
  Weight,
  Style,
  Position,
  ObliqueOnly,
  Baseline,
  TextBottom,
  Alphabetic,
  Ideographic,
  Middle,
  Central,
  Mathematical,
  Hanging,
  TextTop,
  BeforeEdge,
  TextBeforeEdge,
  AfterEdge,
  TextAfterEdge,
  UseScript,
  NoChange,
  ResetSize,
  Top,
  Center,
  Bottom,
  First,
  Last,
  EachLine,
  Underline,
  Overline,
  LineThrough,
  Blink,
  Solid,
  Double,
  Dotted,
  Dashed,
  Wavy,
  Under,
  Clip,
  Ellipsis,
  Capitalize,
  Uppercase,
  Lowercase,
  FullSizeKana,
  ForceEnd,
  AllowEnd,
  Filled,
  Open,
  Dot,
  Circle,
  DoubleCircle,
