fn sizeKeyword(value: Keyword) -> bool {
  return match value {
    Keyword.XxSmall => true
    Keyword.XSmall => true
    Keyword.Small => true
    Keyword.Medium => true
    Keyword.Large => true
    Keyword.XLarge => true
    Keyword.XxLarge => true
    Keyword.XxxLarge => true
    Keyword.Smaller => true
    Keyword.Larger => true
    Keyword.Math => true
    _ => false
  }
}

fn widthKeyword(value: Keyword) -> bool {
  return match value {
    Keyword.Normal => true
    Keyword.UltraCondensed => true
    Keyword.ExtraCondensed => true
    Keyword.Condensed => true
    Keyword.SemiCondensed => true
    Keyword.SemiExpanded => true
    Keyword.Expanded => true
    Keyword.ExtraExpanded => true
    Keyword.UltraExpanded => true
    _ => false
  }
}

fn simpleKeyword(property: Property, value: Keyword) -> bool {
  return match property {
    Property.FontSize => sizeKeyword(value)
    Property.FontSizeAdjust => value == Keyword.None
    Property.FontStretch => widthKeyword(value)
    Property.FontWidth => widthKeyword(value)
    Property.FontStyle => value == Keyword.Normal || value == Keyword.Italic
      || value == Keyword.Oblique
      || value == Keyword.Left
      || value == Keyword.Right
    Property.FontWeight => value == Keyword.Normal || value == Keyword.Bold
      || value == Keyword.Bolder
      || value == Keyword.Lighter
    Property.FontKerning => value == Keyword.Auto || value == Keyword.Normal
      || value == Keyword.None
    Property.FontOpticalSizing => value == Keyword.Auto || value == Keyword.None
    Property.FontSynthesisWeight => value == Keyword.Auto || value == Keyword.None
    Property.FontSynthesisStyle => value == Keyword.Auto || value == Keyword.None
      || value == Keyword.ObliqueOnly
    Property.FontSynthesisSmallCaps => value == Keyword.Auto || value == Keyword.None
    Property.FontSynthesisPosition => value == Keyword.Auto || value == Keyword.None
    Property.LineHeight => value == Keyword.Normal
    Property.LetterSpacing => value == Keyword.Normal
    Property.WordSpacing => value == Keyword.Normal
    Property.BaselineShift => value == Keyword.Baseline || value == Keyword.Sub
      || value == Keyword.Super
      || value == Keyword.Top
      || value == Keyword.Center
      || value == Keyword.Bottom
    Property.AlignmentBaseline => value == Keyword.Auto || value == Keyword.Baseline
      || value == Keyword.TextBottom
      || value == Keyword.Alphabetic
      || value == Keyword.Ideographic
      || value == Keyword.Middle
      || value == Keyword.Central
      || value == Keyword.Mathematical
      || value == Keyword.Hanging
      || value == Keyword.TextTop
      || value == Keyword.BeforeEdge
      || value == Keyword.TextBeforeEdge
      || value == Keyword.AfterEdge
      || value == Keyword.TextAfterEdge
    Property.DominantBaseline => value == Keyword.Auto || value == Keyword.TextBottom
      || value == Keyword.Alphabetic
      || value == Keyword.Ideographic
      || value == Keyword.Middle
      || value == Keyword.Central
      || value == Keyword.Mathematical
      || value == Keyword.Hanging
      || value == Keyword.TextTop
      || value == Keyword.UseScript
      || value == Keyword.NoChange
      || value == Keyword.ResetSize
      || value == Keyword.TextBeforeEdge
      || value == Keyword.TextAfterEdge
    Property.TextDecorationStyle => value == Keyword.Solid || value == Keyword.Double
      || value == Keyword.Dotted
      || value == Keyword.Dashed
      || value == Keyword.Wavy
    Property.TextDecorationThickness => value == Keyword.Auto || value == Keyword.FromFont
    Property.TextOverflow => value == Keyword.Clip || value == Keyword.Ellipsis
    Property.GlyphOrientationVertical => value == Keyword.Auto
    Property.FontLanguageOverride => value == Keyword.Normal
    _ => false
  }
}

effect fn single(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  match keyword(input, &mut cursor.*) {
    Option<Keyword>.Some { value } => {
      if simpleKeyword(property, value) {
        if property == Property.FontStyle && value == Keyword.Oblique {
          let angle = run dimensions.parse(
            &mut store.*,
            input,
            &mut cursor.*,
            Dimension.Angle,
            false,
          )
          match &angle {
            Option<ExprId>.Some { value: id } => {
              match &store.get(id).* {
                Expr.Literal { value: number, unit } => {
                  let degrees = if unit == Unit.Turn {
                    number * 360.0
                  } else if unit == Unit.Grad {
                    number * 0.9
                  } else if unit == Unit.Rad {
                    number * 57.29577951308232
                  } else {
                    number
                  }
                  if degrees < -90.0 || degrees > 90.0 {
                    cursor.position = start
                    return false
                  }
                }
                _ => {}
              }
              run key(&mut out.*, property, value)
              run add(&mut out.*, property, Atom.Numeric { value: id })
              return true
            }
            _ => {}
          }
        }
        run key(&mut out.*, property, value)
        return true
      }
    }
    _ => {}
  }
  cursor.position = start
  if property == Property.FontLanguageOverride {
    cursor.skip(input)
    match input.at(cursor.position) {
      Option<TokenView>.Some { value: view } => match &view.token.kind {
        Kind.String { text } => {
          let span = run own(&mut out.*, view.text(text))
          run add(&mut out.*, property, Atom.String { text: span })
          cursor.position = cursor.position + 1
          return true
        }
        _ => {}
      }
      _ => {}
    }
    return false
  }
  if property == Property.FontWeight {
    let id = match run dimensions.parse(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Number,
      false,
    ) {
      Option<ExprId>.Some { value } => value
      _ => {
        return false
      }
    }
    match literalValue(&store.*, id) {
      Option<f64>.Some { value } => {
        if value < 1.0 || value > 1000.0 {
          cursor.position = start
          return false
        }
      }
      _ => {}
    }
    run add(&mut out.*, property, Atom.Numeric { value: id })
    return true
  }
  if property == Property.GlyphOrientationVertical
    || property == Property.GlyphOrientationHorizontal {
    cursor.skip(input)
    let view = match input.at(cursor.position) {
      Option<TokenView>.Some { value } => value
      _ => {
        return false
      }
    }
    let angle = match &view.token.kind {
      Kind.Number { value, integer } => value
      Kind.Dimension { value, integer, unit } => {
        if property == Property.GlyphOrientationVertical && !insensitive(view.text(unit), b"deg") {
          return false
        }
        if insensitive(view.text(unit), b"deg") {
          value
        } else if insensitive(view.text(unit), b"grad") {
          value * 0.9
        } else if insensitive(view.text(unit), b"rad") {
          value * 57.29577951308232
        } else {
          return false
        }
      }
      _ => {
        return false
      }
    }
    if property == Property.GlyphOrientationVertical && angle != 0.0 && angle != 90.0 {
      return false
    }
    cursor.position = cursor.position + 1
    let id = run dimensions.literal(&mut store.*, angle, Unit.Deg)
    run add(&mut out.*, property, Atom.Numeric { value: id })
    return true
  }
  if property == Property.LineHeight || property == Property.TabSize {
    if run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Number,
      false,
      true,
    ) {
      return true
    }
  }
  return match property {
    Property.FontSize => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.LengthPercentage,
      presentation,
      true,
    )
    Property.FontSizeAdjust => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Number,
      false,
      true,
    )
    Property.FontStretch => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Percentage,
      false,
      true,
    )
    Property.FontWidth => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Percentage,
      false,
      true,
    )
    Property.LineHeight => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.LengthPercentage,
      presentation,
      true,
    )
    Property.LetterSpacing => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Length,
      presentation,
      false,
    )
    Property.WordSpacing => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Length,
      presentation,
      false,
    )
    Property.BaselineShift => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.LengthPercentage,
      presentation,
      false,
    )
    Property.TextDecorationThickness => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.LengthPercentage,
      false,
      true,
    )
    Property.TabSize => run numeric(
      &mut out.*,
      &mut store.*,
      property,
      input,
      &mut cursor.*,
      Dimension.Length,
      false,
      true,
    )
    _ => false
  }
}

fn compoundGroup(property: Property, value: Keyword) -> usize {
  return match property {
    Property.FontSynthesis => match value {
      Keyword.Weight => 1
      Keyword.Style => 2
      Keyword.SmallCaps => 3
      Keyword.Position => 4
      _ => 0
    }
    Property.TextDecorationLine => match value {
      Keyword.Underline => 1
      Keyword.Overline => 2
      Keyword.LineThrough => 3
      Keyword.Blink => 4
      _ => 0
    }
    Property.TextUnderlinePosition => match value {
      Keyword.Under => 1
      Keyword.Left => 2
      Keyword.Right => 2
      _ => 0
    }
    Property.TextTransform => match value {
      Keyword.Capitalize => 1
      Keyword.Uppercase => 1
      Keyword.Lowercase => 1
      Keyword.FullWidth => 2
      Keyword.FullSizeKana => 3
      _ => 0
    }
    Property.HangingPunctuation => match value {
      Keyword.First => 1
      Keyword.Last => 2
      Keyword.ForceEnd => 3
      Keyword.AllowEnd => 3
      _ => 0
    }
    Property.TextEmphasisStyle => match value {
      Keyword.Filled => 1
      Keyword.Open => 1
      Keyword.Dot => 2
      Keyword.Circle => 2
      Keyword.DoubleCircle => 2
      Keyword.Triangle => 2
      Keyword.Sesame => 2
      _ => 0
    }
    Property.TextEmphasisPosition => match value {
      Keyword.Over => 1
      Keyword.Under => 1
      Keyword.Right => 2
      Keyword.Left => 2
      _ => 0
    }
    _ => 0
  }
}

effect fn compound(
  out: &mut TextValue,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  let exclusive = if property == Property.TextUnderlinePosition {
    Keyword.Auto
  } else {
    Keyword.None
  }
  match keyword(input, &mut cursor.*) {
    Option<Keyword>.Some { value } => {
      if property != Property.TextEmphasisPosition && value == exclusive {
        run key(&mut out.*, property, value)
        return true
      }
    }
    _ => {}
  }
  cursor.position = start
  if property == Property.TextEmphasisStyle {
    cursor.skip(input)
    match input.at(cursor.position) {
      Option<TokenView>.Some { value: view } => match &view.token.kind {
        Kind.String { text } => {
          let span = run own(&mut out.*, view.text(text))
          run add(&mut out.*, property, Atom.String { text: span })
          cursor.position = cursor.position + 1
          return true
        }
        _ => {}
      }
      _ => {}
    }
  }
  let mut seen: [bool; 5] = [false; 5]
  let mut count: usize = 0
  while true {
    let before = cursor.position
    let value = match keyword(input, &mut cursor.*) {
      Option<Keyword>.Some { value } => value
      _ => {
        break
      }
    }
    let group = compoundGroup(property, value)
    if group == 0 {
      cursor.position = before
      break
    }
    if seen[group] {
      return false
    }
    seen[group] = true
    run key(&mut out.*, property, value)
    count = count + 1
  }
  if property == Property.TextEmphasisPosition && !seen[1] {
    return false
  }
  return count > 0
}

effect fn indent(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut length = false
  let mut hanging = false
  let mut each = false
  while true {
    if cursor.ident(input, b"hanging") {
      if hanging {
        return false
      }
      hanging = true
      run key(&mut out.*, Property.TextIndent, Keyword.Hanging)
    } else if cursor.ident(input, b"each-line") {
      if each {
        return false
      }
      each = true
      run key(&mut out.*, Property.TextIndent, Keyword.EachLine)
    } else if !length
      && run numeric(
        &mut out.*,
        &mut store.*,
        Property.TextIndent,
        input,
        &mut cursor.*,
        Dimension.LengthPercentage,
        presentation,
        false,
      ) {
      length = true
    } else {
      break
    }
  }
  return length
}

effect fn decoration(out: &mut TextValue, input: &Input, cursor: &mut Cursor) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut seen: [bool; 7] = [false; 7]
  let mut none = false
  let mut count: usize = 0
  while true {
    let start = cursor.position
    let mut recognized = false
    match keyword(input, &mut cursor.*) {
      Option<Keyword>.Some { value } => {
        let group = compoundGroup(Property.TextDecorationLine, value)
        if group != 0 {
          if seen[group] || none {
            return false
          }
          seen[group] = true
          run key(&mut out.*, Property.TextDecorationLine, value)
          recognized = true
        } else if value == Keyword.None {
          if none || seen[1] || seen[2] || seen[3] || seen[4] {
            return false
          }
          none = true
          run key(&mut out.*, Property.TextDecorationLine, Keyword.None)
          recognized = true
        } else if simpleKeyword(Property.TextDecorationStyle, value) {
          if seen[5] {
            return false
          }
          seen[5] = true
          run key(&mut out.*, Property.TextDecorationStyle, value)
          recognized = true
        }
      }
      _ => {}
    }
    if !recognized {
      cursor.position = start
      if seen[6] {
        break
      }
      match run colors.parse(input, &mut cursor.*) {
        Option<Color>.Some { value } => {
          run add(&mut out.*, Property.TextDecorationColor, Atom.Color { value: value })
          seen[6] = true
        }
        _ => {
          break
        }
      }
    }
    count = count + 1
  }
  if count == 0 {
    return false
  }
  if !none && !seen[1] && !seen[2] && !seen[3] && !seen[4] {
    run key(&mut out.*, Property.TextDecorationLine, Keyword.None)
  }
  if !seen[5] {
    run key(&mut out.*, Property.TextDecorationStyle, Keyword.Solid)
  }
  if !seen[6] {
    run add(&mut out.*, Property.TextDecorationColor, Atom.Color { value: Color.current() })
  }
  return true
}

effect fn emphasis(out: &mut TextValue, input: &Input, cursor: &mut Cursor) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let leading = run colors.parse(input, &mut cursor.*)
  match &leading {
    Option<Color>.Some { value } => {
      run add(&mut out.*, Property.TextEmphasisColor, Atom.Color { value: value })
    }
    _ => {}
  }
  let style = run compound(&mut out.*, Property.TextEmphasisStyle, input, &mut cursor.*)
  if !has(&out.*, Property.TextEmphasisColor) {
    match run colors.parse(input, &mut cursor.*) {
      Option<Color>.Some { value } => {
        run add(&mut out.*, Property.TextEmphasisColor, Atom.Color { value: value })
      }
      _ => {}
    }
  }
  if !style && !has(&out.*, Property.TextEmphasisColor) {
    return false
  }
  if !style {
    run key(&mut out.*, Property.TextEmphasisStyle, Keyword.None)
  }
  if !has(&out.*, Property.TextEmphasisColor) {
    run add(&mut out.*, Property.TextEmphasisColor, Atom.Color { value: Color.current() })
  }
  return true
}

effect fn vertical(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut count: usize = 0
  while true {
    if !has(&out.*, Property.BaselineSource) && cursor.ident(input, b"first") {
      run key(&mut out.*, Property.BaselineSource, Keyword.First)
    } else if !has(&out.*, Property.BaselineSource) && cursor.ident(input, b"last") {
      run key(&mut out.*, Property.BaselineSource, Keyword.Last)
    } else if !has(&out.*, Property.AlignmentBaseline)
      && run single(
        &mut out.*,
        &mut store.*,
        Property.AlignmentBaseline,
        input,
        &mut cursor.*,
        presentation,
      ) {} else if !has(&out.*, Property.BaselineShift)
      && run single(
        &mut out.*,
        &mut store.*,
        Property.BaselineShift,
        input,
        &mut cursor.*,
        presentation,
      ) {} else {
      break
    }
    count = count + 1
  }
  if count == 0 {
    return false
  }
  if !has(&out.*, Property.BaselineSource) {
    run key(&mut out.*, Property.BaselineSource, Keyword.Auto)
  }
  if !has(&out.*, Property.AlignmentBaseline) {
    run key(&mut out.*, Property.AlignmentBaseline, Keyword.Baseline)
  }
  if !has(&out.*, Property.BaselineShift) {
    let zero = run dimensions.literal(&mut store.*, 0.0, Unit.Px)
    run add(&mut out.*, Property.BaselineShift, Atom.Numeric { value: zero })
  }
  return true
}

fn systemKeyword(value: Keyword) -> bool {
  return value == Keyword.Caption || value == Keyword.Icon || value == Keyword.Menu
    || value == Keyword.MessageBox
    || value == Keyword.SmallCaption
    || value == Keyword.StatusBar
}

effect fn fontDefaults(out: &mut TextValue) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let normal: [Property; 14] = [
    Property.FontStyle,
    Property.FontVariantLigatures,
    Property.FontVariantCaps,
    Property.FontVariantNumeric,
    Property.FontVariantEastAsian,
    Property.FontVariantPosition,
    Property.FontVariantAlternates,
    Property.FontVariantEmoji,
    Property.FontWeight,
    Property.FontWidth,
    Property.LineHeight,
    Property.FontFeatureSettings,
    Property.FontVariationSettings,
    Property.FontLanguageOverride,
  ]
  let mut i: usize = 0
  while i < normal.length {
    if !has(&out.*, normal[i]) {
      run key(&mut out.*, normal[i], Keyword.Normal)
    }
    i = i + 1
  }
  run key(&mut out.*, Property.FontKerning, Keyword.Auto)
  run key(&mut out.*, Property.FontOpticalSizing, Keyword.Auto)
  run key(&mut out.*, Property.FontSizeAdjust, Keyword.None)
}

effect fn font(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  match keyword(input, &mut cursor.*) {
    Option<Keyword>.Some { value } => {
      if systemKeyword(value) {
        run key(&mut out.*, Property.Font, value)
        return true
      }
    }
    _ => {}
  }
  cursor.position = start
  let mut normalCount: usize = 0
  let mut componentCount: usize = 0
  while true {
    // Size comes first in the disambiguation: a percentage is always the size, never shorthand stretch.
    if run single(&mut out.*, &mut store.*, Property.FontSize, input, &mut cursor.*, presentation) {
      break
    }
    if cursor.ident(input, b"normal") {
      normalCount = normalCount + 1
      if normalCount + componentCount > 4 {
        return false
      }
    } else if !has(&out.*, Property.FontStyle)
      && run single(
        &mut out.*,
        &mut store.*,
        Property.FontStyle,
        input,
        &mut cursor.*,
        presentation,
      ) {
      componentCount = componentCount + 1
    } else if !has(&out.*, Property.FontVariantCaps) && cursor.ident(input, b"small-caps") {
      run key(&mut out.*, Property.FontVariantCaps, Keyword.SmallCaps)
      componentCount = componentCount + 1
    } else if !has(&out.*, Property.FontWeight)
      && run single(
        &mut out.*,
        &mut store.*,
        Property.FontWeight,
        input,
        &mut cursor.*,
        presentation,
      ) {
      componentCount = componentCount + 1
    } else if !has(&out.*, Property.FontWidth) {
      let before = cursor.position
      match keyword(input, &mut cursor.*) {
        Option<Keyword>.Some { value } => {
          if !widthKeyword(value) {
            cursor.position = before
            return false
          }
          run key(&mut out.*, Property.FontWidth, value)
          componentCount = componentCount + 1
        }
        _ => {
          return false
        }
      }
    } else {
      return false
    }
    if normalCount + componentCount > 4 {
      return false
    }
  }
  if cursor.delim(input, 47) {
    if !run single(
      &mut out.*,
      &mut store.*,
      Property.LineHeight,
      input,
      &mut cursor.*,
      presentation,
    ) {
      return false
    }
  }
  if !run families(&mut out.*, input, &mut cursor.*) {
    return false
  }
  run fontDefaults(&mut out.*)
  return true
}

effect fn shadows(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(input, b"none") {
    run key(&mut out.*, Property.TextShadow, Keyword.None)
    return true
  }
  while true {
    let leading = run colors.parse(input, &mut cursor.*)
    let x = match run dimensions.parse(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      presentation,
    ) {
      Option<ExprId>.Some { value } => value
      _ => {
        return false
      }
    }
    let y = match run dimensions.parse(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      presentation,
    ) {
      Option<ExprId>.Some { value } => value
      _ => {
        return false
      }
    }
    let blur = match run dimensions.parse(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      presentation,
    ) {
      Option<ExprId>.Some { value } => {
        if dimensions.negativeLiteral(&store.*, value) {
          return false
        }
        value
      }
      _ => run dimensions.literal(&mut store.*, 0.0, Unit.Px)
    }
    let color = match &leading {
      Option<Color>.Some { value } => value
      _ => match run colors.parse(input, &mut cursor.*) {
        Option<Color>.Some { value } => value
        _ => Color.current()
      }
    }
    run add(&mut out.*, Property.TextShadow, Atom.Shadow { x: x, y: y, blur: blur, color: color })
    if !cursor.comma(input) {
      return true
    }
  }
}

fn interpolation(input: &Input, cursor: &mut Cursor) -> Option<InterpolationSpace> {
  if cursor.ident(input, b"srgb") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Srgb)
  }
  if cursor.ident(input, b"srgb-linear") {
    return Option<InterpolationSpace>.some(InterpolationSpace.SrgbLinear)
  }
  if cursor.ident(input, b"display-p3") {
    return Option<InterpolationSpace>.some(InterpolationSpace.DisplayP3)
  }
  if cursor.ident(input, b"display-p3-linear") {
    return Option<InterpolationSpace>.some(InterpolationSpace.DisplayP3Linear)
  }
  if cursor.ident(input, b"a98-rgb") {
    return Option<InterpolationSpace>.some(InterpolationSpace.A98Rgb)
  }
  if cursor.ident(input, b"prophoto-rgb") {
    return Option<InterpolationSpace>.some(InterpolationSpace.ProphotoRgb)
  }
  if cursor.ident(input, b"rec2020") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Rec2020)
  }
  if cursor.ident(input, b"lab") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Lab)
  }
  if cursor.ident(input, b"oklab") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Oklab)
  }
  if cursor.ident(input, b"xyz-d50") {
    return Option<InterpolationSpace>.some(InterpolationSpace.XyzD50)
  }
  if cursor.ident(input, b"xyz-d65") || cursor.ident(input, b"xyz") {
    return Option<InterpolationSpace>.some(InterpolationSpace.XyzD65)
  }
  if cursor.ident(input, b"hsl") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Hsl)
  }
  if cursor.ident(input, b"hwb") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Hwb)
  }
  if cursor.ident(input, b"lch") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Lch)
  }
  if cursor.ident(input, b"oklch") {
    return Option<InterpolationSpace>.some(InterpolationSpace.Oklch)
  }
  return Option<InterpolationSpace>.None
}

effect fn palette(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
) -> Option<usize>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut node = PaletteNode {
    kind: PaletteKind.Normal,
    name: Span { start: 0, end: 0 },
    firstStop: 0,
    space: InterpolationSpace.Oklab,
    hue: HueMethod.Shorter,
    alphaMultiplier: 1.0,
    valid: true,
  }
  if cursor.ident(input, b"normal") {
    node.kind = PaletteKind.Normal
  } else if cursor.ident(input, b"light") {
    node.kind = PaletteKind.Light
  } else if cursor.ident(input, b"dark") {
    node.kind = PaletteKind.Dark
  } else if cursor.function(input, b"palette-mix") {
    node.kind = PaletteKind.Mix
    if cursor.ident(input, b"in") {
      node.space = match interpolation(input, &mut cursor.*) {
        Option<InterpolationSpace>.Some { value } => value
        _ => {
          return Option<usize>.None
        }
      }
      let polar = node.space == InterpolationSpace.Hsl || node.space == InterpolationSpace.Hwb
        || node.space == InterpolationSpace.Lch
        || node.space == InterpolationSpace.Oklch
      let mut hue = false
      if cursor.ident(input, b"shorter") {
        node.hue = HueMethod.Shorter
        hue = true
      } else if cursor.ident(input, b"longer") {
        node.hue = HueMethod.Longer
        hue = true
      } else if cursor.ident(input, b"increasing") {
        node.hue = HueMethod.Increasing
        hue = true
      } else if cursor.ident(input, b"decreasing") {
        node.hue = HueMethod.Decreasing
        hue = true
      }
      if hue && (!polar || !cursor.ident(input, b"hue")) {
        return Option<usize>.None
      }
      if !cursor.comma(input) {
        return Option<usize>.None
      }
    }
    let mut previous: usize = 0
    let mut total = 0.0
    let mut hasUnspecified = false
    let mut hasExpression = false
    while true {
      let mut weight = run dimensions.parse(
        &mut store.*,
        input,
        &mut cursor.*,
        Dimension.Percentage,
        false,
      )
      let child = match run palette(&mut out.*, &mut store.*, input, &mut cursor.*) {
        Option<usize>.Some { value } => value
        _ => {
          return Option<usize>.None
        }
      }
      match &weight {
        Option<ExprId>.None => {
          weight = run dimensions.parse(
            &mut store.*,
            input,
            &mut cursor.*,
            Dimension.Percentage,
            false,
          )
        }
        _ => {}
      }
      match &weight {
        Option<ExprId>.Some { value } => match literalValue(&store.*, value) {
          Option<f64>.Some { value: amount } => {
            if amount < 0.0 || amount > 100.0 {
              return Option<usize>.None
            }
            total = total + amount
          }
          _ => {
            hasExpression = true
          }
        }
        _ => {
          hasUnspecified = true
        }
      }
      let link = out.paletteStops.length() + 1
      run out.paletteStops.append(PaletteStop { palette: child, weight: weight, next: 0 })
      if previous == 0 {
        node.firstStop = link
      } else {
        let mut slice = out.paletteStops.asMutSlice()
        slice[previous - 1].next = link
      }
      previous = link
      if !cursor.comma(input) {
        break
      }
    }
    if !hasUnspecified && !hasExpression && total == 0.0 {
      return Option<usize>.None
    }
    if !cursor.close(input) {
      return Option<usize>.None
    }
  } else {
    cursor.skip(input)
    let view = match input.at(cursor.position) {
      Option<TokenView>.Some { value } => value
      _ => {
        return Option<usize>.None
      }
    }
    let name = match &view.token.kind {
      Kind.Ident { text } => view.text(text)
      _ => {
        return Option<usize>.None
      }
    }
    if name.length < 3 || name[0] != 45 || name[1] != 45 {
      return Option<usize>.None
    }
    node.kind = PaletteKind.Named
    node.name = run own(&mut out.*, name)
    cursor.position = cursor.position + 1
  }
  let index = out.palettes.length()
  run out.palettes.append(node)
  return Option<usize>.some(index)
}

// CSS Text4 #white-space-property, #propdef-white-space-collapse,
// #white-space-trim and #text-wrap-mode (pinned 106c5cd086ab23b0edea5aa3ff6876b61cc623154f728aa269b74f0527dba19d).
// Longhands retain only canonical keyword atoms. Trim order is before, after, inner;
// none is a single atom, never combined with discard flags.
fn whitespaceCollapse(input: &Input, cursor: &mut Cursor) -> Option<Keyword> {
  if cursor.ident(input, b"collapse") {
    return Option<Keyword>.some(Keyword.Collapse)
  }
  if cursor.ident(input, b"discard") {
    return Option<Keyword>.some(Keyword.Discard)
  }
  if cursor.ident(input, b"preserve") {
    return Option<Keyword>.some(Keyword.Preserve)
  }
  if cursor.ident(input, b"preserve-breaks") {
    return Option<Keyword>.some(Keyword.PreserveBreaks)
  }
  if cursor.ident(input, b"preserve-spaces") {
    return Option<Keyword>.some(Keyword.PreserveSpaces)
  }
  if cursor.ident(input, b"break-spaces") {
    return Option<Keyword>.some(Keyword.BreakSpaces)
  }
  return Option<Keyword>.None
}

fn whitespaceWrap(input: &Input, cursor: &mut Cursor) -> Option<Keyword> {
  if cursor.ident(input, b"wrap") {
    return Option<Keyword>.some(Keyword.Wrap)
  }
  if cursor.ident(input, b"nowrap") {
    return Option<Keyword>.some(Keyword.Nowrap)
  }
  return Option<Keyword>.None
}

fn whitespaceTrim(input: &Input, cursor: &mut Cursor) -> Option<[bool; 3]> {
  let mut flags = [false; 3]
  if cursor.ident(input, b"none") {
    return Option<[bool; 3]>.some(flags)
  }
  let mut count: usize = 0
  while true {
    let index: usize = if cursor.ident(input, b"discard-before") {
      0
    } else if cursor.ident(input, b"discard-after") {
      1
    } else if cursor.ident(input, b"discard-inner") {
      2
    } else {
      break
    }
    if flags[index] {
      return Option<[bool; 3]>.None
    }
    flags[index] = true
    count = count + 1
  }
  return if count == 0 {
    Option<[bool; 3]>.None
  } else {
    Option<[bool; 3]>.some(flags)
  }
}

effect fn whitespace(
  out: &mut TextValue,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let shorthand = property == Property.WhiteSpace
  let mut collapse = Keyword.Collapse
  let mut wrapping = Keyword.Wrap
  let mut trim = [false; 3]
  let mut collapseSeen = false
  let mut wrapSeen = false
  let mut trimSeen = false
  let mut special = false
  if shorthand {
    if cursor.ident(input, b"normal") {
      special = true
    } else if cursor.ident(input, b"pre") {
      special = true
      collapse = Keyword.Preserve
      wrapping = Keyword.Nowrap
    } else if cursor.ident(input, b"pre-wrap") {
      special = true
      collapse = Keyword.Preserve
    } else if cursor.ident(input, b"pre-line") {
      special = true
      collapse = Keyword.PreserveBreaks
    }
  }
  if !special {
    while !cursor.done(input) {
      if (shorthand || property == Property.WhiteSpaceCollapse) && !collapseSeen {
        match &whitespaceCollapse(input, &mut cursor.*) {
          Option<Keyword>.Some { value } => {
            collapse = value
            collapseSeen = true
            continue
          }
          _ => {}
        }
      }
      if (shorthand || property == Property.TextWrapMode) && !wrapSeen {
        match &whitespaceWrap(input, &mut cursor.*) {
          Option<Keyword>.Some { value } => {
            wrapping = value
            wrapSeen = true
            continue
          }
          _ => {}
        }
      }
      if (shorthand || property == Property.WhiteSpaceTrim) && !trimSeen {
        match &whitespaceTrim(input, &mut cursor.*) {
          Option<[bool; 3]>.Some { value } => {
            trim = value
            trimSeen = true
            continue
          }
          _ => {}
        }
      }
      return false
    }
    if !collapseSeen && !wrapSeen && !trimSeen {
      return false
    }
  }
  if !cursor.done(input) {
    return false
  }
  if shorthand || property == Property.WhiteSpaceCollapse {
    run key(&mut out.*, Property.WhiteSpaceCollapse, collapse)
  }
  if shorthand || property == Property.TextWrapMode {
    run key(&mut out.*, Property.TextWrapMode, wrapping)
  }
  if shorthand || property == Property.WhiteSpaceTrim {
    let keywords = [Keyword.DiscardBefore, Keyword.DiscardAfter, Keyword.DiscardInner]
    let mut i: usize = 0
    while i < trim.length {
      if trim[i] {
        run key(&mut out.*, Property.WhiteSpaceTrim, keywords[i])
      }
      i = i + 1
    }
    if !trim[0] && !trim[1] && !trim[2] {
      run key(&mut out.*, Property.WhiteSpaceTrim, Keyword.None)
    }
  }
  return true
}

pub effect fn parse(
  numerics: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<TextValue>
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  let mut out = TextValue.make(property)
  let valid = match property {
    Property.WhiteSpace => run whitespace(&mut out, property, input, &mut cursor.*)
    Property.WhiteSpaceCollapse => run whitespace(&mut out, property, input, &mut cursor.*)
    Property.TextWrapMode => run whitespace(&mut out, property, input, &mut cursor.*)
    Property.WhiteSpaceTrim => run whitespace(&mut out, property, input, &mut cursor.*)
    Property.Font => run font(&mut out, &mut numerics.*, input, &mut cursor.*, presentation)
    Property.FontFamily => run families(&mut out, input, &mut cursor.*)
    Property.FontVariant => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantLigatures => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantCaps => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantNumeric => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantEastAsian => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantPosition => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontVariantAlternates => run variants(&mut out, property, input, &mut cursor.*)
    Property.FontFeatureSettings => run settings(
      &mut out,
      &mut numerics.*,
      property,
      input,
      &mut cursor.*,
    )
    Property.FontVariationSettings => run settings(
      &mut out,
      &mut numerics.*,
      property,
      input,
      &mut cursor.*,
    )
    Property.FontSynthesis => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextTransform => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextUnderlinePosition => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextDecorationLine => run compound(&mut out, property, input, &mut cursor.*)
    Property.HangingPunctuation => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextEmphasisStyle => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextEmphasisPosition => run compound(&mut out, property, input, &mut cursor.*)
    Property.TextIndent => run indent(&mut out, &mut numerics.*, input, &mut cursor.*, presentation)
    Property.TextDecoration => run decoration(&mut out, input, &mut cursor.*)
    Property.TextEmphasis => run emphasis(&mut out, input, &mut cursor.*)
    Property.VerticalAlign => run vertical(
      &mut out,
      &mut numerics.*,
      input,
      &mut cursor.*,
      presentation,
    )
    Property.TextDecorationColor => match run colors.parse(input, &mut cursor.*) {
      Option<Color>.Some { value } => {
        run add(&mut out, property, Atom.Color { value: value })
        true
      }
      _ => false
    }
    Property.TextEmphasisColor => match run colors.parse(input, &mut cursor.*) {
      Option<Color>.Some { value } => {
        run add(&mut out, property, Atom.Color { value: value })
        true
      }
      _ => false
    }
    Property.TextShadow => run shadows(
      &mut out,
      &mut numerics.*,
      input,
      &mut cursor.*,
      presentation,
    )
    Property.FontPalette => match run palette(&mut out, &mut numerics.*, input, &mut cursor.*) {
      Option<usize>.Some { value } => {
        run add(&mut out, property, Atom.Palette { root: value })
        true
      }
      _ => false
    }
    _ => run single(&mut out, &mut numerics.*, property, input, &mut cursor.*, presentation)
  }
  if !valid {
    cursor.position = start
    return Option<TextValue>.None
  }
  run expandShorthand(&mut out)
  return Option<TextValue>.some(move out)
}

fn clamp(value: f64, minimum: f64, maximum: f64) -> f64 {
  if value < minimum {
    return minimum
  }
  if value > maximum {
    return maximum
  }
  return value
}

fn weightKeyword(value: Keyword, parent: f64) -> f64 {
  if value == Keyword.Bold {
    return 700.0
  }
  if value == Keyword.Bolder {
    if parent < 350.0 {
      return 400.0
    }
    if parent < 550.0 {
      return 700.0
    }
    if parent < 900.0 {
      return 900.0
    }
    return parent
  }
  if value == Keyword.Lighter {
    if parent < 100.0 {
      return parent
    }
    if parent < 550.0 {
      return 100.0
    }
    if parent < 750.0 {
      return 400.0
    }
    return 700.0
  }
  return 400.0
}

fn widthValue(value: Keyword) -> f64 {
  return match value {
    Keyword.UltraCondensed => 50.0
    Keyword.ExtraCondensed => 62.5
    Keyword.Condensed => 75.0
    Keyword.SemiCondensed => 87.5
    Keyword.SemiExpanded => 112.5
    Keyword.Expanded => 125.0
    Keyword.ExtraExpanded => 150.0
    Keyword.UltraExpanded => 200.0
    _ => 100.0
  }
}

fn sizeValue(value: Keyword, context: &dimensions.Context) -> f64 {
  return match value {
    Keyword.XxSmall => context.fontSizeKeywords[0]
    Keyword.XSmall => context.fontSizeKeywords[1]
    Keyword.Small => context.fontSizeKeywords[2]
    Keyword.Medium => context.fontSizeKeywords[3]
    Keyword.Large => context.fontSizeKeywords[4]
    Keyword.XLarge => context.fontSizeKeywords[5]
    Keyword.XxLarge => context.fontSizeKeywords[6]
    Keyword.XxxLarge => context.fontSizeKeywords[7]
    Keyword.Math => context.mathFontSize
    Keyword.Larger => relativeSize(context, true)
    Keyword.Smaller => relativeSize(context, false)
    _ => context.initialFontSize
  }
}

// Interpolate between adjacent host size-table entries, extrapolating only beyond the table.
fn relativeSize(context: &dimensions.Context, larger: bool) -> f64 {
  let parent = context.parentFontSize
  let sizes = context.fontSizeKeywords
  let mut i: usize = 0
  while i + 1 < sizes.length {
    if parent >= sizes[i] && parent <= sizes[i + 1] && sizes[i + 1] > sizes[i] {
      let fraction = (parent - sizes[i]) / (sizes[i + 1] - sizes[i])
      let first = if larger {
        sizes[i + 1]
      } else if i > 0 {
        sizes[i - 1]
      } else {
        sizes[i] / 1.2
      }
      let second = if larger {
        if i + 2 < sizes.length {
          sizes[i + 2]
        } else {
          sizes[i + 1] * 1.2
        }
      } else {
        sizes[i]
      }
      return first + fraction * (second - first)
    }
    i = i + 1
  }
  return if larger {
    parent * 1.2
  } else {
    parent / 1.2
  }
}

fn parentMetrics(context: &dimensions.Context) -> dimensions.Context {
  let mut metrics = context.*
  metrics.fontSize = context.parentFontSize
  metrics.xHeight = context.parentXHeight
  metrics.capHeight = context.parentCapHeight
  metrics.zeroAdvance = context.parentZeroAdvance
  metrics.ideographAdvance = context.parentIdeographAdvance
  metrics.lineHeight = context.parentLineHeight
  return metrics
}

effect fn computeNumeric(
  property: Property,
  id: ExprId,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut metrics = context.*
  if property == Property.FontSize || property == Property.FontStyle
    || property == Property.FontWeight
    || property == Property.FontWidth
    || property == Property.FontStretch
    || property == Property.FontSizeAdjust {
    metrics = parentMetrics(context)
  }
  if property == Property.LineHeight {
    metrics.lineHeight = context.parentLineHeight
  }
  let result = run dimensions.compute(&mut numerics.*, id, &metrics)
  if property == Property.FontSize {
    let number = dimensions.evaluate(&numerics.*, result, context.parentFontSize)
    return run dimensions.literal(
      &mut numerics.*,
      if number < 0.0 {
        0.0
      } else {
        number
      },
      Unit.Px,
    )
  }
  if property == Property.LineHeight && !dimensions.numberResult(&numerics.*, result)
    && dimensions.containsPercentage(&numerics.*, result) {
    let number = dimensions.evaluate(&numerics.*, result, context.fontSize)
    return run dimensions.literal(
      &mut numerics.*,
      if number < 0.0 {
        0.0
      } else {
        number
      },
      Unit.Px,
    )
  }
  if property == Property.FontWeight {
    let number = dimensions.evaluate(&numerics.*, result, 0.0)
    return run dimensions.literal(&mut numerics.*, clamp(number, 1.0, 1000.0), Unit.Number)
  }
  if property == Property.FontStyle {
    let number = dimensions.evaluate(&numerics.*, result, 0.0)
    return run dimensions.literal(&mut numerics.*, clamp(number, -90.0, 90.0), Unit.Deg)
  }
  if property == Property.FontStretch || property == Property.FontWidth {
    let number = dimensions.evaluate(&numerics.*, result, 100.0)
    return run dimensions.literal(
      &mut numerics.*,
      if number < 0.0 {
        0.0
      } else {
        number
      },
      Unit.Percent,
    )
  }
  if property == Property.FontSizeAdjust || property == Property.TabSize
    || property == Property.LineHeight {
    // These have no unresolved percentages after the line-height branch.
    let number = dimensions.evaluate(&numerics.*, result, 0.0)
    if number < 0.0 {
      let unit = if dimensions.numberResult(&numerics.*, result) {
        Unit.Number
      } else {
        Unit.Px
      }
      return run dimensions.literal(&mut numerics.*, 0.0, unit)
    }
  }
  if property == Property.TextDecorationThickness {
    return run dimensions.nonnegative(&mut numerics.*, result)
  }
  if property == Property.GlyphOrientationHorizontal {
    let mut degrees = dimensions.evaluate(&numerics.*, result, 0.0)
    degrees = degrees % 360.0
    if degrees < 0.0 {
      degrees = degrees + 360.0
    }
    let quadrant = f64.toU32((degrees + 45.0) / 90.0)
    return run dimensions.literal(&mut numerics.*, u32.toF64(quadrant % 4) * 90.0, Unit.Deg)
  }
  return result
}

effect fn computeAtom(
  item: &Item,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> Atom
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &item.atom {
    Atom.Keyword { value } => {
      if item.property == Property.FontWeight {
        return Atom.Numeric {
          value: run dimensions.literal(
            &mut numerics.*,
            weightKeyword(value, context.parentFontWeight),
            Unit.Number,
          ),
        }
      }
      if item.property == Property.FontSize {
        return Atom.Numeric {
          value: run dimensions.literal(&mut numerics.*, sizeValue(value, context), Unit.Px),
        }
      }
      if item.property == Property.FontWidth || item.property == Property.FontStretch {
        return Atom.Numeric {
          value: run dimensions.literal(&mut numerics.*, widthValue(value), Unit.Percent),
        }
      }
      if (item.property == Property.WordSpacing || item.property == Property.LetterSpacing)
        && value == Keyword.Normal {
        return Atom.Numeric { value: run dimensions.literal(&mut numerics.*, 0.0, Unit.Px) }
      }
      if item.property == Property.BaselineShift && value == Keyword.Baseline {
        return Atom.Numeric { value: run dimensions.literal(&mut numerics.*, 0.0, Unit.Px) }
      }
      item.atom
    }
    Atom.Numeric { value } => Atom.Numeric {
      value: run computeNumeric(item.property, value, &mut numerics.*, context),
    }
    Atom.Color { value } => Atom.Color { value: colors.compute(value, colorContext) }
    Atom.Setting { tag, value } => {
      let metrics = parentMetrics(context)
      let computed = run dimensions.compute(&mut numerics.*, value, &metrics)
      if item.property == Property.FontFeatureSettings {
        let amount = dimensions.evaluate(&numerics.*, computed, 0.0)
        let integer = if amount < 0.0 {
          0.0
        } else {
          -f64.ceil(-(amount + 0.5))
        }
        return Atom.Setting {
          tag: tag,
          value: run dimensions.literal(&mut numerics.*, integer, Unit.Number),
        }
      }
      Atom.Setting { tag: tag, value: computed }
    }
    Atom.Shadow { x, y, blur, color } => {
      let computedBlur = run dimensions.compute(&mut numerics.*, blur, context)
      let amount = dimensions.evaluate(&numerics.*, computedBlur, 0.0)
      Atom.Shadow {
        x: run dimensions.compute(&mut numerics.*, x, context),
        y: run dimensions.compute(&mut numerics.*, y, context),
        blur: if amount < 0.0 {
          run dimensions.literal(&mut numerics.*, 0.0, Unit.Px)
        } else {
          computedBlur
        },
        color: colors.compute(color, colorContext),
      }
    }
    _ => item.atom
  }
}

fn samePalette(value: &TextValue, a: usize, b: usize, numerics: &dimensions.Store) -> bool {
  if a == b {
    return true
  }
  let left = value.palettes.asSlice()[a]
  let right = value.palettes.asSlice()[b]
  if left.kind != right.kind || left.alphaMultiplier != right.alphaMultiplier
    || left.valid != right.valid {
    return false
  }
  if left.kind == PaletteKind.Named {
    return equal(value.text(left.name), value.text(right.name))
  }
  if left.kind != PaletteKind.Mix {
    return true
  }
  if left.space != right.space || left.hue != right.hue {
    return false
  }
  let mut l = left.firstStop
  let mut r = right.firstStop
  while l != 0 && r != 0 {
    let ls = value.paletteStops.asSlice()[l - 1]
    let rs = value.paletteStops.asSlice()[r - 1]
    if !samePalette(value, ls.palette, rs.palette, numerics) {
      return false
    }
    let lw = match &ls.weight {
      Option<ExprId>.Some { value: id } => dimensions.evaluate(numerics, id, 100.0)
      _ => 0.0
    }
    let rw = match &rs.weight {
      Option<ExprId>.Some { value: id } => dimensions.evaluate(numerics, id, 100.0)
      _ => 0.0
    }
    if lw != rw {
      return false
    }
    l = ls.next
    r = rs.next
  }
  return l == r
}

effect fn computePalettes(
  out: &mut TextValue,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut index: usize = 0
  while index < out.palettes.length() {
    let node = out.palettes.asSlice()[index]
    if node.kind == PaletteKind.Mix {
      let mut link = node.firstStop
      let mut sum = 0.0
      let mut missing: usize = 0
      while link != 0 {
        let stop = out.paletteStops.asSlice()[link - 1]
        match &stop.weight {
          Option<ExprId>.Some { value } => {
            let computed = run dimensions.compute(&mut numerics.*, value, context)
            let number = clamp(dimensions.evaluate(&numerics.*, computed, 100.0), 0.0, 100.0)
            let id = run dimensions.literal(&mut numerics.*, number, Unit.Percent)
            let mut slice = out.paletteStops.asMutSlice()
            slice[link - 1].weight = Option<ExprId>.some(id)
            sum = sum + number
          }
          _ => {
            missing = missing + 1
          }
        }
        link = stop.next
      }
      let remainder = if sum < 100.0 {
        100.0 - sum
      } else {
        0.0
      }
      let missingWeight = if missing == 0 {
        0.0
      } else {
        remainder / usize.toF64(missing)
      }
      let total = sum + missingWeight * usize.toF64(missing)
      let mut palettes = out.palettes.asMutSlice()
      palettes[index].alphaMultiplier = node.alphaMultiplier
        * (if total < 100.0 {
          total / 100.0
        } else {
          1.0
        })
      palettes[index].valid = node.valid && total > 0.0
      drop palettes
      link = node.firstStop
      let mut first: Option<usize> = Option<usize>.None
      let mut equivalent = total >= 100.0 && node.alphaMultiplier == 1.0
        && node.hue != HueMethod.Longer
      while link != 0 {
        let stop = out.paletteStops.asSlice()[link - 1]
        let raw = match &stop.weight {
          Option<ExprId>.Some { value } => dimensions.evaluate(&numerics.*, value, 100.0)
          _ => missingWeight
        }
        let normalized = if total > 0.0 {
          raw * 100.0 / total
        } else {
          0.0
        }
        let id = run dimensions.literal(&mut numerics.*, normalized, Unit.Percent)
        let mut stops = out.paletteStops.asMutSlice()
        stops[link - 1].weight = Option<ExprId>.some(id)
        drop stops
        if normalized > 0.0 {
          match &first {
            Option<usize>.Some { value } => {
              if !samePalette(&out.*, value, stop.palette, &numerics.*) {
                equivalent = false
              }
            }
            _ => {
              first = Option<usize>.some(stop.palette)
            }
          }
        }
        link = stop.next
      }
      if equivalent {
        match &first {
          Option<usize>.Some { value } => {
            let replacement = out.palettes.asSlice()[value]
            let mut slice = out.palettes.asMutSlice()
            slice[index] = replacement
          }
          _ => {}
        }
      }
    }
    index = index + 1
  }
}

fn systemIndex(value: Keyword) -> usize {
  return match value {
    Keyword.Caption => 0
    Keyword.Icon => 1
    Keyword.Menu => 2
    Keyword.MessageBox => 3
    Keyword.SmallCaption => 4
    Keyword.StatusBar => 5
    _ => 0
  }
}

// systemFonts are host-selected, parsed non-system font shorthands in the documented six-keyword order.
pub effect fn compute(
  value: &TextValue,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
  systemFonts: &[TextValue; 6],
) -> TextValue
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut source = value
  if value.property == Property.Font && value.items.length() == 1 {
    match &value.items.asSlice()[0].atom {
      Atom.Keyword { value: name } => {
        if systemKeyword(name) {
          source = &systemFonts[systemIndex(name)]
        }
      }
      _ => {}
    }
  }
  let mut out = TextValue.make(value.property)
  run Bytes.append(&mut out.strings, Bytes.asSlice(&source.strings))
  let mut metrics = context.*
  let mut i: usize = 0

  // A shorthand's line-height percentage/em uses its new size, not the parent's or the previous declaration.
  while i < source.items.length() {
    let item = &source.items.asSlice()[i]
    if source.property == Property.Font && item.property == Property.FontSize {
      let atom = run computeAtom(item, &mut numerics.*, context, colorContext)
      match &atom {
        Atom.Numeric { value: id } => {
          metrics.fontSize = dimensions.evaluate(&numerics.*, id, 0.0)
        }
        _ => {}
      }
      run add(&mut out, item.property, atom)
    }
    i = i + 1
  }
  i = 0
  while i < source.items.length() {
    let item = &source.items.asSlice()[i]
    let mut skip = source.property == Property.Font && item.property == Property.FontSize
    match &item.atom {
      Atom.Setting { tag, value: id } => {
        let mut later = i + 1
        while later < source.items.length() {
          let next = &source.items.asSlice()[later]
          if next.property == item.property {
            match &next.atom {
              Atom.Setting { tag: nextTag, value: nextValue } => {
                if tag == nextTag {
                  skip = true
                }
              }
              _ => {}
            }
          }
          later = later + 1
        }
      }
      _ => {}
    }
    if !skip {
      let atom = run computeAtom(item, &mut numerics.*, &metrics, colorContext)
      run add(&mut out, item.property, atom)
      match &atom {
        Atom.Setting { tag, value: id } => {
          let mut position = out.items.length() - 1
          while position > 0 {
            let prior = out.items.asSlice()[position - 1]
            let greater = match &prior.atom {
              Atom.Setting { tag: previous, value: previousValue } => prior.property
                == item.property
                && previous > tag
              _ => false
            }
            if !greater {
              break
            }
            let mut slice = out.items.asMutSlice()
            slice[position] = prior
            position = position - 1
          }
          let mut slice = out.items.asMutSlice()
          slice[position] = Item { property: item.property, atom: atom }
        }
        _ => {}
      }
    }
    i = i + 1
  }
  run completeEmphasis(&mut out, &metrics)
  i = 0
  while i < source.palettes.length() {
    run out.palettes.append(source.palettes.asSlice()[i])
    i = i + 1
  }
  i = 0
  while i < source.paletteStops.length() {
    run out.paletteStops.append(source.paletteStops.asSlice()[i])
    i = i + 1
  }
  run computePalettes(&mut out, &mut numerics.*, &metrics)
  return move out
}

effect fn expandShorthand(out: &mut TextValue) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if out.property == Property.FontVariant {
    let mut none = false
    if out.items.length() == 1 && out.items.asSlice()[0].property == Property.FontVariant {
      match &out.items.asSlice()[0].atom {
        Atom.Keyword { value } => {
          none = value == Keyword.None
        }
        _ => {}
      }
      out.items = List<Item>.make()
    }
    let targets: [Property; 7] = [
      Property.FontVariantLigatures,
      Property.FontVariantCaps,
      Property.FontVariantNumeric,
      Property.FontVariantEastAsian,
      Property.FontVariantPosition,
      Property.FontVariantAlternates,
      Property.FontVariantEmoji,
    ]
    let mut i: usize = 0
    while i < targets.length {
      if !has(&out.*, targets[i]) {
        run key(
          &mut out.*,
          targets[i],
          if i == 0 && none {
            Keyword.None
          } else {
            Keyword.Normal
          },
        )
      }
      i = i + 1
    }
  }
  if out.property == Property.FontSynthesis {
    let mut enabled: [bool; 4] = [false; 4]
    let mut i: usize = 0
    while i < out.items.length() {
      match &out.items.asSlice()[i].atom {
        Atom.Keyword { value } => {
          let group = compoundGroup(Property.FontSynthesis, value)
          if group > 0 {
            enabled[group - 1] = true
          }
        }
        _ => {}
      }
      i = i + 1
    }
    out.items = List<Item>.make()
    let targets: [Property; 4] = [
      Property.FontSynthesisWeight,
      Property.FontSynthesisStyle,
      Property.FontSynthesisSmallCaps,
      Property.FontSynthesisPosition,
    ]
    i = 0
    while i < targets.length {
      run key(
        &mut out.*,
        targets[i],
        if enabled[i] {
          Keyword.Auto
        } else {
          Keyword.None
        },
      )
      i = i + 1
    }
  }
}

effect fn completeEmphasis(out: &mut TextValue, context: &dimensions.Context) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut fill = false
  let mut shape = false
  let mut position = false
  let mut side = false
  let mut i: usize = 0
  while i < out.items.length() {
    let item = &out.items.asSlice()[i]
    if item.property == Property.TextEmphasisStyle {
      match &item.atom {
        Atom.Keyword { value } => {
          let group = compoundGroup(Property.TextEmphasisStyle, value)
          if group == 1 {
            fill = true
          }
          if group == 2 {
            shape = true
          }
        }
        _ => {}
      }
    }
    if item.property == Property.TextEmphasisPosition {
      position = true
      match &item.atom {
        Atom.Keyword { value } => {
          if value == Keyword.Left || value == Keyword.Right {
            side = true
          }
        }
        _ => {}
      }
    }
    i = i + 1
  }
  if fill && !shape {
    run key(
      &mut out.*,
      Property.TextEmphasisStyle,
      if context.vertical {
        Keyword.Sesame
      } else {
        Keyword.Circle
      },
    )
  }
  if shape && !fill {
    run key(&mut out.*, Property.TextEmphasisStyle, Keyword.Filled)
  }
  if position && !side {
    run key(&mut out.*, Property.TextEmphasisPosition, Keyword.Right)
  }
}

pub fn validComputed(value: &TextValue) -> bool {
  let mut i: usize = 0
  while i < value.palettes.length() {
    if !value.palettes.asSlice()[i].valid {
      return false
    }
    i = i + 1
  }
  return true
}
