}

pub enum GenericFamily {
  Named,
  Serif,
  SansSerif,
  Cursive,
  Fantasy,
  Monospace,
  SystemUi,
  UiSerif,
  UiSansSerif,
  UiMonospace,
  UiRounded,
  Math,
  Fangsong,
  Kai,
  KhmerMul,
  Nastaliq
}

pub enum AlternateKind {
  Stylistic,
  Styleset,
  CharacterVariant,
  Swash,
  Ornaments,
  Annotation
}

pub enum PaletteKind {
  Normal,
  Light,
  Dark,
  Named,
  Mix
}

pub enum InterpolationSpace {
  Srgb,
  SrgbLinear,
  DisplayP3,
  DisplayP3Linear,
  A98Rgb,
  ProphotoRgb,
  Rec2020,
  Lab,
  Oklab,
  XyzD50,
  XyzD65,
  Hsl,
  Hwb,
  Lch,
  Oklch
}

pub enum HueMethod {
  Shorter,
  Longer,
  Increasing,
  Decreasing
}

pub struct PaletteNode {
  pub kind: PaletteKind,
  pub name: Span,
  /// One-based linked PaletteStop index; zero terminates a stop chain.
  pub firstStop: usize,
  pub space: InterpolationSpace,
  pub hue: HueMethod,
  pub alphaMultiplier: f64,
  pub valid: bool,
}

impl Copy for PaletteNode {}

pub struct PaletteStop {
  pub palette: usize,
  pub weight: Option<ExprId>,
  pub next: usize
}

impl Copy for PaletteStop {}

pub union Atom {
  Keyword { pub value: Keyword },
  Numeric { pub value: ExprId },
  Family { pub generic: GenericFamily, pub name: Span },
  Setting { pub tag: u32, pub value: ExprId },
  Alternate { pub kind: AlternateKind, pub name: Span },
  String { pub text: Span },
  Color { pub value: Color },
  Shadow { pub x: ExprId, pub y: ExprId, pub blur: ExprId, pub color: Color },
  Palette { pub root: usize },
}

impl Copy for Atom {}

pub struct Item {
  pub property: Property,
  pub atom: Atom
}

impl Copy for Item {}

pub struct TextValue {
  pub property: Property,
  pub items: List<Item>,
  pub strings: Bytes,
  pub palettes: List<PaletteNode>,
  pub paletteStops: List<PaletteStop>,
}

impl TextValue {
  pub fn make(property: Property) -> TextValue {
    return TextValue {
      property: property,
      items: List<Item>.make(),
      strings: Bytes.make(),
      palettes: List<PaletteNode>.make(),
      paletteStops: List<PaletteStop>.make(),
    }
  }

  pub fn text(self: &TextValue, span: Span) -> &[u8] {
    return Slice.view<u8>(Bytes.asSlice(&self.strings), span.start, span.end - span.start)
  }
}

fn reserved(name: &[u8]) -> bool {
  return insensitive(name, b"initial") || insensitive(name, b"inherit")
    || insensitive(name, b"unset")
    || insensitive(name, b"revert")
    || insensitive(name, b"revert-layer")
    || insensitive(name, b"default")
}

effect fn own(out: &mut TextValue, text: &[u8]) -> Span
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = Bytes.asSlice(&out.strings).length
  run Bytes.append(&mut out.strings, text)
  return Span { start: start, end: start + text.length }
}

effect fn add(out: &mut TextValue, property: Property, atom: Atom) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.items.append(Item { property: property, atom: atom })
}

effect fn key(out: &mut TextValue, property: Property, keyword: Keyword) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run add(&mut out.*, property, Atom.Keyword { value: keyword })
}

fn has(out: &TextValue, property: Property) -> bool {
  let mut i: usize = 0
  while i < out.items.length() {
    if out.items.asSlice()[i].property == property {
      return true
    }
    i = i + 1
  }
  return false
}

// A keyword is accepted only by its property's grammar, never merely because it is known.
fn keyword(input: &Input, cursor: &mut Cursor) -> Option<Keyword> {
  cursor.skip(input)
  let view = match input.at(cursor.position) {
    Option<TokenView>.Some { value } => value
    _ => {
      return Option<Keyword>.None
    }
  }
  let name = match &view.token.kind {
    Kind.Ident { text } => view.text(text)
    _ => {
      return Option<Keyword>.None
    }
  }
  let result = keywordName(name)
  match &result {
    Option<Keyword>.Some { value } => {
      cursor.position = cursor.position + 1
    }
    _ => {}
  }
  return result
}

fn generic(name: &[u8]) -> GenericFamily {
  if insensitive(name, b"serif") {
    return GenericFamily.Serif
  }
  if insensitive(name, b"sans-serif") {
    return GenericFamily.SansSerif
  }
  if insensitive(name, b"cursive") {
    return GenericFamily.Cursive
  }
  if insensitive(name, b"fantasy") {
    return GenericFamily.Fantasy
  }
  if insensitive(name, b"monospace") {
    return GenericFamily.Monospace
  }
  if insensitive(name, b"system-ui") {
    return GenericFamily.SystemUi
  }
  if insensitive(name, b"ui-serif") {
    return GenericFamily.UiSerif
  }
  if insensitive(name, b"ui-sans-serif") {
    return GenericFamily.UiSansSerif
  }
  if insensitive(name, b"ui-monospace") {
    return GenericFamily.UiMonospace
  }
  if insensitive(name, b"ui-rounded") {
    return GenericFamily.UiRounded
  }
  if insensitive(name, b"math") {
    return GenericFamily.Math
  }
  return GenericFamily.Named
}

effect fn families(out: &mut TextValue, input: &Input, cursor: &mut Cursor) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  while true {
    cursor.skip(input)
    let view = match input.at(cursor.position) {
      Option<TokenView>.Some { value } => value
      _ => {
        return false
      }
    }
    match &view.token.kind {
      Kind.String { text } => {
        let name = run own(&mut out.*, view.text(text))
        run add(
          &mut out.*,
          Property.FontFamily,
          Atom.Family { generic: GenericFamily.Named, name: name },
        )
        cursor.position = cursor.position + 1
      }
      Kind.Ident { text } => {
        let first = view.text(text)
        if reserved(first) {
          return false
        }
        let family = generic(first)
        let mut name = Span { start: 0, end: 0 }
        if family == GenericFamily.Named {
          name = run own(&mut out.*, first)
        }
        cursor.position = cursor.position + 1
        while true {
          cursor.skip(input)
          let next = match input.at(cursor.position) {
            Option<TokenView>.Some { value } => value
            _ => {
              break
            }
          }
          match &next.token.kind {
            Kind.Ident { text: part } => {
              if family != GenericFamily.Named || generic(next.text(part)) != GenericFamily.Named
                || reserved(next.text(part)) {
                return false
              }
              run Bytes.append(&mut out.strings, b" ")
              run Bytes.append(&mut out.strings, next.text(part))
              name.end = Bytes.asSlice(&out.strings).length
              cursor.position = cursor.position + 1
            }
            _ => {
              break
            }
          }
        }
        run add(&mut out.*, Property.FontFamily, Atom.Family { generic: family, name: name })
      }
      Kind.Function { name } => {
        if !insensitive(view.text(name), b"generic") {
          return false
        }
        cursor.position = cursor.position + 1
        let family = if cursor.ident(input, b"fangsong") {
          GenericFamily.Fangsong
        } else if cursor.ident(input, b"kai") {
          GenericFamily.Kai
        } else if cursor.ident(input, b"khmer-mul") {
          GenericFamily.KhmerMul
        } else if cursor.ident(input, b"nastaliq") {
          GenericFamily.Nastaliq
        } else {
          return false
        }
        if !cursor.close(input) {
          return false
        }
        run add(
          &mut out.*,
          Property.FontFamily,
          Atom.Family { generic: family, name: Span { start: 0, end: 0 } },
        )
      }
      _ => {
        return false
      }
    }
    if !cursor.comma(input) {
      return true
    }
  }
}

fn literalValue(store: &dimensions.Store, id: ExprId) -> Option<f64> {
  return match &store.get(id).* {
    Expr.Literal { value, unit } => Option<f64>.some(value)
    _ => Option<f64>.None
  }
}

effect fn numeric(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
  dimension: Dimension,
  presentation: bool,
  nonnegative: bool,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  let id = match run dimensions.parse(&mut store.*, input, &mut cursor.*, dimension, presentation) {
    Option<ExprId>.Some { value } => value
    _ => {
      return false
    }
  }
  if nonnegative && dimensions.negativeLiteral(&store.*, id) {
    cursor.position = start
    return false
  }
  run add(&mut out.*, property, Atom.Numeric { value: id })
  return true
}

// Mutually exclusive alternatives share a group number. A zero group is not in this grammar.
fn variantGroup(property: Property, value: Keyword) -> u32 {
  let all = property == Property.FontVariant
  if all || property == Property.FontVariantLigatures {
    match value {
      Keyword.CommonLigatures => {
        return 1
      }
      Keyword.NoCommonLigatures => {
        return 1
      }
      Keyword.DiscretionaryLigatures => {
        return 2
      }
      Keyword.NoDiscretionaryLigatures => {
        return 2
      }
      Keyword.HistoricalLigatures => {
        return 3
      }
      Keyword.NoHistoricalLigatures => {
        return 3
      }
      Keyword.Contextual => {
        return 4
      }
      Keyword.NoContextual => {
        return 4
      }
      _ => {}
    }
  }
  if all || property == Property.FontVariantCaps {
    match value {
      Keyword.SmallCaps => {
        return 5
      }
      Keyword.AllSmallCaps => {
        return 5
      }
      Keyword.PetiteCaps => {
        return 5
      }
      Keyword.AllPetiteCaps => {
        return 5
      }
      Keyword.Unicase => {
        return 5
      }
      Keyword.TitlingCaps => {
        return 5
      }
      _ => {}
    }
  }
  if all || property == Property.FontVariantNumeric {
    match value {
      Keyword.LiningNums => {
        return 6
      }
      Keyword.OldstyleNums => {
        return 6
      }
      Keyword.ProportionalNums => {
        return 7
      }
      Keyword.TabularNums => {
        return 7
      }
      Keyword.DiagonalFractions => {
        return 8
      }
      Keyword.StackedFractions => {
        return 8
      }
      Keyword.Ordinal => {
        return 9
      }
      Keyword.SlashedZero => {
        return 10
      }
      _ => {}
    }
  }
  if all || property == Property.FontVariantEastAsian {
    match value {
      Keyword.Jis78 => {
        return 11
      }
      Keyword.Jis83 => {
        return 11
      }
      Keyword.Jis90 => {
        return 11
      }
      Keyword.Jis04 => {
        return 11
      }
      Keyword.Simplified => {
        return 11
      }
      Keyword.Traditional => {
        return 11
      }
      Keyword.FullWidth => {
        return 12
      }
      Keyword.ProportionalWidth => {
        return 12
      }
      Keyword.Ruby => {
        return 13
      }
      _ => {}
    }
  }
  if all || property == Property.FontVariantPosition {
    if value == Keyword.Sub || value == Keyword.Super {
      return 14
    }
  }
  if all || property == Property.FontVariantAlternates {
    if value == Keyword.HistoricalForms {
      return 15
    }
  }
  if all {
    if value == Keyword.Text || value == Keyword.Emoji || value == Keyword.Unicode {
      return 16
    }
  }
  return 0
}

fn variantProperty(group: u32) -> Property {
  if group <= 4 {
    return Property.FontVariantLigatures
  }
  if group == 5 {
    return Property.FontVariantCaps
  }
  if group <= 10 {
    return Property.FontVariantNumeric
  }
  if group <= 13 {
    return Property.FontVariantEastAsian
  }
  if group == 14 {
    return Property.FontVariantPosition
  }
  if group == 16 {
    return Property.FontVariantEmoji
  }
  return Property.FontVariantAlternates
}

effect fn variants(
  out: &mut TextValue,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(input, b"normal") {
    run key(&mut out.*, property, Keyword.Normal)
    return true
  }
  if (property == Property.FontVariant || property == Property.FontVariantLigatures)
    && cursor.ident(input, b"none") {
    run key(&mut out.*, property, Keyword.None)
    return true
  }
  let mut seen: [bool; 23] = [false; 23]
  let mut count: usize = 0
  while true {
    let start = cursor.position
    match keyword(input, &mut cursor.*) {
      Option<Keyword>.Some { value } => {
        let group = variantGroup(property, value)
        if group == 0 {
          cursor.position = start
          break
        }
        if seen[u32.toUsize(group)] {
          return false
        }
        seen[u32.toUsize(group)] = true
        run key(
          &mut out.*,
          if property == Property.FontVariant {
            variantProperty(group)
          } else {
            property
          },
          value,
        )
        count = count + 1
      }
      _ => {
        cursor.position = start
        if property != Property.FontVariant && property != Property.FontVariantAlternates {
          break
        }
        let mut kind = AlternateKind.Stylistic
        let mut group: usize = 17
        if cursor.function(input, b"stylistic") {
          kind = AlternateKind.Stylistic
        } else if cursor.function(input, b"styleset") {
          kind = AlternateKind.Styleset
          group = 18
        } else if cursor.function(input, b"character-variant") {
          kind = AlternateKind.CharacterVariant
          group = 19
        } else if cursor.function(input, b"swash") {
          kind = AlternateKind.Swash
          group = 20
        } else if cursor.function(input, b"ornaments") {
          kind = AlternateKind.Ornaments
          group = 21
        } else if cursor.function(input, b"annotation") {
          kind = AlternateKind.Annotation
          group = 22
        } else {
          break
        }
        if seen[group] {
          return false
        }
        seen[group] = true
        while true {
          cursor.skip(input)
          let view = match input.at(cursor.position) {
            Option<TokenView>.Some { value } => value
            _ => {
              return false
            }
          }
          let text = match &view.token.kind {
            Kind.Ident { text } => view.text(text)
            _ => {
              return false
            }
          }
          if reserved(text) {
            return false
          }
          let name = run own(&mut out.*, text)
          run add(
            &mut out.*,
            Property.FontVariantAlternates,
            Atom.Alternate { kind: kind, name: name },
          )
          cursor.position = cursor.position + 1
          if !cursor.comma(input) {
            break
          }
          if kind != AlternateKind.Styleset && kind != AlternateKind.CharacterVariant {
            return false
          }
        }
        if !cursor.close(input) {
          return false
        }
        count = count + 1
      }
    }
  }
  return count > 0
}

effect fn settings(
  out: &mut TextValue,
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(input, b"normal") {
    run key(&mut out.*, property, Keyword.Normal)
    return true
  }
  while true {
    cursor.skip(input)
    let view = match input.at(cursor.position) {
      Option<TokenView>.Some { value } => value
      _ => {
        return false
      }
    }
    let text = match &view.token.kind {
      Kind.String { text } => view.text(text)
      _ => {
        return false
      }
    }
    if text.length != 4 {
      return false
    }
    let mut tag: u32 = 0
    let mut i: usize = 0
    while i < 4 {
      if text[i] < 32 || text[i] > 126 {
        return false
      }
      tag = tag * 256 + u8.toU32(text[i])
      i = i + 1
    }
    cursor.position = cursor.position + 1
    let id = if property == Property.FontFeatureSettings && cursor.ident(input, b"on") {
      run dimensions.literal(&mut store.*, 1.0, Unit.Number)
    } else if property == Property.FontFeatureSettings && cursor.ident(input, b"off") {
      run dimensions.literal(&mut store.*, 0.0, Unit.Number)
    } else {
      cursor.skip(input)
      if property == Property.FontFeatureSettings {
        match input.at(cursor.position) {
          Option<TokenView>.Some { value: next } => match &next.token.kind {
            Kind.Number { value, integer } => {
              if !integer || value < 0.0 {
                return false
              }
            }
            _ => {}
          }
          _ => {}
        }
      }
      match run dimensions.parse(&mut store.*, input, &mut cursor.*, Dimension.Number, false) {
        Option<ExprId>.Some { value } => value
        _ => {
          if property == Property.FontVariationSettings {
            return false
          }
          run dimensions.literal(&mut store.*, 1.0, Unit.Number)
        }
      }
    }
    run add(&mut out.*, property, Atom.Setting { tag: tag, value: id })
    if !cursor.comma(input) {
      return true
    }
  }
}

fn keywordName(name: &[u8]) -> Option<Keyword> {
  if insensitive(name, b"normal") {
    return Option<Keyword>.some(Keyword.Normal)
  }
  if insensitive(name, b"none") {
    return Option<Keyword>.some(Keyword.None)
  }
  if insensitive(name, b"auto") {
    return Option<Keyword>.some(Keyword.Auto)
  }
  if insensitive(name, b"italic") {
    return Option<Keyword>.some(Keyword.Italic)
  }
  if insensitive(name, b"oblique") {
    return Option<Keyword>.some(Keyword.Oblique)
  }
  if insensitive(name, b"left") {
    return Option<Keyword>.some(Keyword.Left)
  }
  if insensitive(name, b"right") {
    return Option<Keyword>.some(Keyword.Right)
  }
  if insensitive(name, b"bold") {
    return Option<Keyword>.some(Keyword.Bold)
  }
  if insensitive(name, b"bolder") {
    return Option<Keyword>.some(Keyword.Bolder)
  }
  if insensitive(name, b"lighter") {
    return Option<Keyword>.some(Keyword.Lighter)
  }
  if insensitive(name, b"xx-small") {
    return Option<Keyword>.some(Keyword.XxSmall)
  }
  if insensitive(name, b"x-small") {
    return Option<Keyword>.some(Keyword.XSmall)
  }
  if insensitive(name, b"small") {
    return Option<Keyword>.some(Keyword.Small)
  }
  if insensitive(name, b"medium") {
    return Option<Keyword>.some(Keyword.Medium)
  }
  if insensitive(name, b"large") {
    return Option<Keyword>.some(Keyword.Large)
  }
  if insensitive(name, b"x-large") {
    return Option<Keyword>.some(Keyword.XLarge)
  }
  if insensitive(name, b"xx-large") {
    return Option<Keyword>.some(Keyword.XxLarge)
  }
  if insensitive(name, b"xxx-large") {
    return Option<Keyword>.some(Keyword.XxxLarge)
  }
  if insensitive(name, b"smaller") {
    return Option<Keyword>.some(Keyword.Smaller)
  }
  if insensitive(name, b"larger") {
    return Option<Keyword>.some(Keyword.Larger)
  }
  if insensitive(name, b"math") {
    return Option<Keyword>.some(Keyword.Math)
  }
  if insensitive(name, b"ultra-condensed") {
    return Option<Keyword>.some(Keyword.UltraCondensed)
  }
  if insensitive(name, b"extra-condensed") {
    return Option<Keyword>.some(Keyword.ExtraCondensed)
  }
  if insensitive(name, b"condensed") {
    return Option<Keyword>.some(Keyword.Condensed)
  }
  if insensitive(name, b"semi-condensed") {
    return Option<Keyword>.some(Keyword.SemiCondensed)
  }
  if insensitive(name, b"semi-expanded") {
    return Option<Keyword>.some(Keyword.SemiExpanded)
  }
  if insensitive(name, b"expanded") {
    return Option<Keyword>.some(Keyword.Expanded)
  }
  if insensitive(name, b"extra-expanded") {
    return Option<Keyword>.some(Keyword.ExtraExpanded)
  }
  if insensitive(name, b"ultra-expanded") {
    return Option<Keyword>.some(Keyword.UltraExpanded)
  }
  if insensitive(name, b"small-caps") {
    return Option<Keyword>.some(Keyword.SmallCaps)
  }
  if insensitive(name, b"all-small-caps") {
    return Option<Keyword>.some(Keyword.AllSmallCaps)
  }
