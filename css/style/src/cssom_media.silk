//! CSSOM §4 media lists. Grammar and recovery share the matching implementation.
import cssom_error { CssomError }
import cssom_serialization
import condition_cursor { Structure }
import condition_cursor
import input { Input }
import lexer
import media_features { Environment, Truth }
import media_features
import media_queries
import tokens { TokenBuffer, TokenRange, Kind, Limits, CssError, CssErrorKind }
import tokens
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn opening(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.OpenParen => true
    Kind.OpenSquare => true
    Kind.OpenBrace => true
    Kind.Function { name } => true
    _ => false
  }
}

effect fn lowerIdentifier(out: &mut Bytes, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut escaped = run cssom_serialization.identifier(text)
  let mut data = escaped.asMutSlice()
  let mut i: usize = 0
  while i < data.length {
    if data[i] >= 65 && data[i] <= 90 {
      data[i] = data[i] + 32
    }
    i = i + 1
  }
  drop data
  run Bytes.append(&mut out.*, Bytes.asSlice(&escaped))
}

effect fn closeAtEnd(out: &mut Bytes, buffer: &TokenBuffer, start: usize, end: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = buffer.tokens.asSlice()
  let mut position = end
  while position > start {
    position = position - 1
    if items[position].matching >= end {
      match &items[position].kind {
        Kind.OpenParen => {
          run Bytes.append(&mut out.*, b")")
        }
        Kind.Function { name } => {
          run Bytes.append(&mut out.*, b")")
        }
        Kind.OpenSquare => {
          run Bytes.append(&mut out.*, b"]")
        }
        Kind.OpenBrace => {
          run Bytes.append(&mut out.*, b"}")
        }
        _ => {}
      }
    }
  }
}

// Recognized feature values use their case-insensitive CSS value grammar. Unknown
// syntax is serialized separately as general-enclosed, without changing its case.
effect fn feature(out: &mut Bytes, buffer: &TokenBuffer, start: usize, end: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = buffer.tokens.asSlice()
  let mut position = start
  let mut whitespace = false
  let mut separated = true
  while position < end {
    let token = &items[position]
    match &token.kind {
      Kind.Whitespace => {
        whitespace = true
        position = position + 1
        continue
      }
      Kind.Colon => {
        run Bytes.append(&mut out.*, b": ")
        separated = true
      }
      Kind.CloseParen => {
        run Bytes.append(&mut out.*, b")")
        separated = false
      }
      Kind.Delim { scalar } => {
        if scalar == 60 || scalar == 62 || scalar == 61 || scalar == 47 {
          if !separated {
            run Bytes.append(&mut out.*, b" ")
          }
          if scalar == 60 {
            run Bytes.append(&mut out.*, b"<")
          } else if scalar == 62 {
            run Bytes.append(&mut out.*, b">")
          } else if scalar == 61 {
            run Bytes.append(&mut out.*, b"=")
          } else {
            run Bytes.append(&mut out.*, b"/")
          }
          if (scalar == 60 || scalar == 62) && position + 1 < end {
            match &items[position + 1].kind {
              Kind.Delim { scalar: next } => {
                if next == 61 {
                  run Bytes.append(&mut out.*, b"=")
                  position = position + 1
                }
              }
              _ => {}
            }
          }
          run Bytes.append(&mut out.*, b" ")
          separated = true
        } else {
          if whitespace && !separated {
            run Bytes.append(&mut out.*, b" ")
          }
          let text = run cssom_serialization.components(
            buffer,
            TokenRange { start: position, end: position + 1 },
          )
          run Bytes.append(&mut out.*, Bytes.asSlice(&text))
          separated = false
        }
      }
      _ => {
        if whitespace && !separated {
          run Bytes.append(&mut out.*, b" ")
        }
        match &token.kind {
          Kind.Ident { text } => {
            run lowerIdentifier(&mut out.*, buffer.text(text))
          }
          Kind.Function { name } => {
            run lowerIdentifier(&mut out.*, buffer.text(name))
            run Bytes.append(&mut out.*, b"(")
          }
          Kind.OpenParen => {
            run Bytes.append(&mut out.*, b"(")
          }
          Kind.Number { value, integer } => {
            run cssom_serialization.appendNumber(&mut out.*, value)
          }
          Kind.Percentage { value, integer } => {
            run cssom_serialization.appendNumber(&mut out.*, value)
            run Bytes.append(&mut out.*, b"%")
          }
          Kind.Dimension { value, integer, unit } => {
            run cssom_serialization.appendNumber(&mut out.*, value)
            run lowerIdentifier(&mut out.*, buffer.text(unit))
          }
          _ => {
            let text = run cssom_serialization.components(
              buffer,
              TokenRange { start: position, end: position + 1 },
            )
            run Bytes.append(&mut out.*, Bytes.asSlice(&text))
          }
        }
        separated = opening(&token.kind)
      }
    }
    whitespace = false
    position = position + 1
  }
  run closeAtEnd(&mut out.*, buffer, start, end)
}

effect fn conditionText(
  out: &mut Bytes,
  buffer: &TokenBuffer,
  source: &Input,
  start: usize,
  end: usize,
  structure: &Structure,
  environment: &Environment,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let items = buffer.tokens.asSlice()
  let mut position = condition_cursor.skip(source, start, end)
  while position < end {
    if condition_cursor.ident(source, position, b"not") {
      run Bytes.append(&mut out.*, b"not ")
      position = condition_cursor.skip(source, position + 1, end)
      continue
    }
    if condition_cursor.ident(source, position, b"and")
      || condition_cursor.ident(source, position, b"or") {
      run Bytes.append(
        &mut out.*,
        if condition_cursor.ident(source, position, b"and") {
          b" and "
        } else {
          b" or "
        },
      )
      position = condition_cursor.skip(source, position + 1, end)
      continue
    }
    let close = structure.end(position)
    let next = if close < end {
      close + 1
    } else {
      end
    }
    let mut rendered = false
    match &items[position].kind {
      Kind.OpenParen => {
        let nested = run media_queries.parseCondition(
          source,
          position + 1,
          close,
          false,
          structure,
          environment,
        )
        if nested.valid && condition_cursor.skip(source, nested.next, close) == close {
          run Bytes.append(&mut out.*, b"(")
          run conditionText(&mut out.*, buffer, source, position + 1, close, structure, environment)
          run Bytes.append(&mut out.*, b")")
          rendered = true
        } else {
          let value = run media_features.evaluate(source, position + 1, close, environment)
          if value != Truth.Unknown {
            run Bytes.append(&mut out.*, b"(")
            run feature(&mut out.*, buffer, position + 1, close)
            run Bytes.append(&mut out.*, b")")
            rendered = true
          }
        }
      }
      _ => {}
    }
    if !rendered {
      let text = run cssom_serialization.components(
        buffer,
        TokenRange { start: position, end: next },
      )
      run Bytes.append(&mut out.*, Bytes.asSlice(&text))
      run closeAtEnd(&mut out.*, buffer, position, next)
    }
    position = condition_cursor.skip(source, next, end)
  }
}

effect fn queryText(
  buffer: &TokenBuffer,
  source: &Input,
  start: usize,
  end: usize,
  structure: &Structure,
  environment: &Environment,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run media_queries.parseQuery(source, start, end, structure, environment)
  if !parsed.valid {
    return run Bytes.copy(b"not all")
  }
  let expression = run media_queries.parseCondition(
    source,
    start,
    end,
    false,
    structure,
    environment,
  )
  let mut result = Bytes.make()
  if expression.valid && condition_cursor.skip(source, expression.next, end) == end {
    run conditionText(&mut result, buffer, source, start, end, structure, environment)
    return move result
  }
  let mut position = condition_cursor.skip(source, start, end)
  let negative = condition_cursor.ident(source, position, b"not")
  if negative || condition_cursor.ident(source, position, b"only") {
    position = condition_cursor.skip(source, position + 1, end)
  }
  let typePosition = position
  position = condition_cursor.skip(source, position + 1, end)
  if negative {
    run Bytes.append(&mut result, b"not ")
  }
  if negative || position == end || !condition_cursor.ident(source, typePosition, b"all") {
    match &buffer.tokens.asSlice()[typePosition].kind {
      Kind.Ident { text } => {
        run lowerIdentifier(&mut result, buffer.text(text))
      }
      _ => {}
    }
    if position < end {
      run Bytes.append(&mut result, b" and ")
    }
  }
  if position < end {
    run conditionText(&mut result, buffer, source, position + 1, end, structure, environment)
  }
  return move result
}

pub struct MediaList {
  queries: List<Bytes>,
  bytes: usize,
}

impl MediaList {
  pub fn make() -> MediaList {
    return MediaList { queries: List<Bytes>.make(), bytes: 0 }
  }

  pub effect fn parse(text: &[u8], limits: &Limits) -> MediaList
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let buffer = run lexer.tokenize(text, limits)
    let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    let structure = run condition_cursor.inspect(&source, limits)
    let end = source.length()
    let mut result = MediaList.make()
    if condition_cursor.skip(&source, 0, end) == end {
      return move result
    }
    let environment = Environment.headless(0.0, 0.0)
    let mut start: usize = 0
    let mut position: usize = 0
    while position <= end {
      let mut boundary = position == end
      if position < end {
        match &buffer.tokens.asSlice()[position].kind {
          Kind.Comma => {
            boundary = true
          }
          _ => {}
        }
      }
      if boundary {
        let value = run queryText(&buffer, &source, start, position, &structure, &environment)
        run result.admit(Bytes.asSlice(&value).length, limits)
        result.bytes = result.bytes + Bytes.asSlice(&value).length
        run result.queries.append(move value)
        start = position + 1
      }
      if position < end && opening(&buffer.tokens.asSlice()[position].kind) {
        let close = structure.end(position)
        position = if close < end {
          close + 1
        } else {
          end
        }
      } else {
        position = position + 1
      }
    }
    return move result
  }

  effect fn admit(self: &MediaList, additional: usize, limits: &Limits) -> ()
    ! CssError {
    let count = self.queries.length() + 1
    if count > limits.maxTokens {
      fail CssError { kind: CssErrorKind.TokenLimit, offset: 0 }
    }
    if self.bytes > limits.maxStorageBytes || additional > limits.maxStorageBytes - self.bytes {
      fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
    }
    if count > (limits.maxStorageBytes - self.bytes - additional) / 32 {
      fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
    }
  }

  pub fn length(self: &MediaList) -> usize {
    return self.queries.length()
  }

  pub fn item(self: &MediaList, index: usize) -> Option<&[u8]> {
    if index >= self.queries.length() {
      return Option<&[u8]>.None
    }
    return Option<&[u8]>.Some { value: Bytes.asSlice(&self.queries.asSlice()[index]) }
  }

  pub effect fn mediaText(self: &MediaList) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = Bytes.make()
    let mut i: usize = 0
    while i < self.queries.length() {
      if i != 0 {
        run Bytes.append(&mut result, b", ")
      }
      run Bytes.append(&mut result, Bytes.asSlice(&self.queries.asSlice()[i]))
      i = i + 1
    }
    return move result
  }

  pub effect fn setMediaText(self: &mut MediaList, text: &[u8], limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let replacement = run MediaList.parse(text, limits)
    self.* = move replacement
  }

  pub effect fn appendMedium(self: &mut MediaList, text: &[u8], limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut parsed = run MediaList.parse(text, limits)
    if parsed.length() != 1 {
      return
    }
    let value = Bytes.asSlice(&parsed.queries.asSlice()[0])
    let mut i: usize = 0
    while i < self.queries.length() {
      if tokens.equal(Bytes.asSlice(&self.queries.asSlice()[i]), value) {
        return
      }
      i = i + 1
    }
    run self.admit(value.length, limits)
    run self.queries.reserve(1)
    self.bytes = self.bytes + value.length
    run self.queries.append(parsed.queries.remove(0))
  }

  pub effect fn deleteMedium(self: &mut MediaList, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let parsed = run MediaList.parse(text, limits)
    if parsed.length() != 1 {
      return
    }
    let value = Bytes.asSlice(&parsed.queries.asSlice()[0])
    let mut kept: usize = 0
    let mut i: usize = 0
    let count = self.queries.length()
    let mut items = self.queries.asMutSlice()
    while i < count {
      if tokens.equal(Bytes.asSlice(&items[i]), value) {
        self.bytes = self.bytes - Bytes.asSlice(&items[i]).length
      } else {
        if kept != i {
          let survivor = Intrinsic.replace(items[i], Bytes.make())
          items[kept] = move survivor
        }
        kept = kept + 1
      }
      i = i + 1
    }
    drop items
    self.queries.truncate(kept)
    if kept == count {
      fail CssomError.NotFoundError
    }
  }

  pub effect fn matches(self: &MediaList, environment: &Environment, limits: &Limits) -> bool
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let text = run self.mediaText()
    let buffer = run lexer.tokenize(Bytes.asSlice(&text), limits)
    let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    return run media_queries.matches(&source, environment, limits)
  }
}
