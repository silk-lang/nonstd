//! One bounded UTF-8 output sink shared by all Encoding Standard decoders.
import tokens { CssError, CssErrorKind }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

pub struct Output {
  pub bytes: Bytes,
  pub maxOutput: usize,
}

effect fn append(output: &mut Output, data: &[u8], offset: usize) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let length = output.bytes.length()
  if length > output.maxOutput || data.length > output.maxOutput - length {
    fail CssError { kind: CssErrorKind.StorageLimit, offset: offset }
  }
  run output.bytes.append(data)
}

// Callers supply only Unicode scalar values (including U+FFFD on decoder errors).
pub effect fn scalar(output: &mut Output, cp: u32, offset: usize) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  if cp < 128 {
    run append(&mut output.*, &[u32.toU8(cp)], offset)
  } else if cp < 2048 {
    run append(&mut output.*, &[u32.toU8(192 + cp / 64), u32.toU8(128 + cp % 64)], offset)
  } else if cp < 65536 {
    run append(
      &mut output.*,
      &[u32.toU8(224 + cp / 4096), u32.toU8(128 + cp / 64 % 64), u32.toU8(128 + cp % 64)],
      offset,
    )
  } else {
    run append(
      &mut output.*,
      &[
        u32.toU8(240 + cp / 262144),
        u32.toU8(128 + cp / 4096 % 64),
        u32.toU8(128 + cp / 64 % 64),
        u32.toU8(128 + cp % 64),
      ],
      offset,
    )
  }
}
