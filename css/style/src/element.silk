//! Static selector matching borrows a host tree; it does not duplicate XML nodes.
import silk.num.usize
import tokens { CssError, CssErrorKind }

pub const NO_ELEMENT: usize = usize.MAX

/// Providers expose element-only links and an acyclic tree. NO_ELEMENT denotes an absent link.
/// Raw parents include shadow hosts. Child/sibling lists may mix tree scopes;
/// matching filters them with containingHost and never exposes a host's outer links.
/// Attribute names and namespaces are case-sensitive XML names; attribute values are decoded.
/// isEmpty follows pinned Selectors 4: comments/PIs and document whitespace do not prevent :empty.
/// language supplies the inherited document language, or empty when explicitly unknown.
/// isLink reports document-language link semantics, not whether a URL was fetched or visited.
pub interface ElementTree {
  fn parent(self: &Self, node: usize) -> usize

  /// Host of the node's own tree scope, or NO_ELEMENT in an ordinary tree.
  /// A host belongs to its enclosing scope, not the shadow tree that it hosts.
  /// This scope identity is stable across matching, including host-function arguments.
  fn containingHost(self: &Self, node: usize) -> usize

  fn firstChild(self: &Self, node: usize) -> usize

  fn nextSibling(self: &Self, node: usize) -> usize

  fn previousSibling(self: &Self, node: usize) -> usize

  fn localName(self: &Self, node: usize) -> &[u8]

  fn namespaceUri(self: &Self, node: usize) -> &[u8]

  fn attributeCount(self: &Self, node: usize) -> usize

  fn attributeName(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeNamespace(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeValue(self: &Self, node: usize, attribute: usize) -> &[u8]

  fn attributeIsId(self: &Self, node: usize, attribute: usize) -> bool

  fn language(self: &Self, node: usize) -> &[u8]

  fn isRoot(self: &Self, node: usize) -> bool

  fn isEmpty(self: &Self, node: usize) -> bool

  fn isLink(self: &Self, node: usize) -> bool
}

pub struct MatchContext {
  pub scope: usize,
  pub target: usize,
  /// Host exposed as featureless in the current selector scope; absent in light context.
  pub shadowHost: usize,
  /// Shared across a document's matching work; exhaustion is CssError.MatchLimit, never false.
  pub remainingSteps: usize,
}

impl MatchContext {
  pub fn make(scope: usize, target: usize) -> MatchContext {
    return MatchContext {
      scope: scope,
      target: target,
      shadowHost: NO_ELEMENT,
      remainingSteps: 64000000,
    }
  }

  /// Charge bounded matching or candidate-discovery work before performing it.
  pub effect fn spend(self: &mut Self, steps: usize) -> ()
    ! CssError {
    if steps > self.remainingSteps {
      fail CssError { kind: CssErrorKind.MatchLimit, offset: 0 }
    }
    self.remainingSteps = self.remainingSteps - steps
  }
}
