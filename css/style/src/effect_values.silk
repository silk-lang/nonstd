//! Typed Filter Effects 1 / Masking 1 / Shapes 1 / Images 3 values.
//! The numeric arena owns expressions; only semantic URLs own decoded text.
import input { Input, TokenView }
import value_cursor { Cursor }
import properties { Property }
import dimensions { Dimension, ExprId, Unit }
import dimensions
import colors { Color }
import colors
import transform_values { Position, PositionAxis, Edge }
import transform_values
import tokens { Kind }
import svg_geometry.geometry { Path }
import svg_geometry.svg
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub enum FilterKind {
  Blur,
  Brightness,
  Contrast,
  Grayscale,
  HueRotate,
  Invert,
  Opacity,
  Saturate,
  Sepia
}

pub union Filter {
  Url { pub url: Bytes },
  Function { pub kind: FilterKind, pub amount: ExprId },
  DropShadow { pub x: ExprId, pub y: ExprId, pub blur: ExprId, pub color: Color },
}

pub enum GeometryBox {
  Content,
  Padding,
  Border,
  Margin,
  Fill,
  Stroke,
  View,
  NoClip
}

pub enum MaskMode {
  MatchSource,
  Alpha,
  Luminance
}

pub enum Composite {
  Add,
  Subtract,
  Intersect,
  Exclude
}

pub enum Repeat {
  Repeat,
  Space,
  Round,
  NoRepeat,
  Stretch
}

pub struct RepeatPair {
  pub x: Repeat,
  pub y: Repeat
}

impl Copy for RepeatPair {}

pub union Size {
  Explicit { pub x: Option<ExprId>, pub y: Option<ExprId> },
  Cover,
  Contain
}

impl Copy for Size {}

pub enum Extent {
  ClosestSide,
  ClosestCorner,
  FarthestSide,
  FarthestCorner
}

pub union RadialSize {
  Extent { pub extent: Extent },
  Radii { pub x: ExprId, pub y: Option<ExprId> }
}

impl Copy for RadialSize {}

pub union Direction {
  Angle { pub angle: ExprId },
  Corner { pub x: Edge, pub y: Edge }
}

impl Copy for Direction {}

pub union GradientStop {
  ColorStop { pub color: Color, pub position: Option<ExprId> },
  Hint { pub position: ExprId }
}

impl Copy for GradientStop {}

pub union Image {
  None,
  Url { pub url: Bytes },
  Linear { pub repeating: bool, pub direction: Direction, pub stops: List<GradientStop> },
  Radial {
    pub repeating: bool,
    pub circle: bool,
    pub size: RadialSize,
    pub position: Position,
    pub stops: List<GradientStop>
  },
}

pub struct MaskLayer {
  pub image: Image,
  pub mode: MaskMode,
  pub position: Position,
  pub size: Size,
  pub repeat: RepeatPair,
  pub origin: GeometryBox,
  pub clip: GeometryBox,
  pub composite: Composite,
}

pub union BorderMeasure {
  Auto,
  Numeric { pub value: ExprId }
}

impl Copy for BorderMeasure {}

pub struct Border {
  pub image: Image,
  pub mode: MaskMode,
  pub slice: [ExprId; 4],
  pub fill: bool,
  pub width: [BorderMeasure; 4],
  pub outset: [ExprId; 4],
  pub repeat: RepeatPair,
}

pub struct Point {
  pub x: ExprId,
  pub y: ExprId
}

impl Copy for Point {}

pub struct Corners {
  pub x: [ExprId; 4],
  pub y: [ExprId; 4]
}

impl Copy for Corners {}

pub enum RectangleKind {
  Inset,
  Rect,
  Xywh
}

pub enum ControlOrigin {
  Origin,
  Start,
  End
}

pub struct ControlPoint {
  pub position: Position,
  pub origin: ControlOrigin
}

impl Copy for ControlPoint {}

pub enum CommandKind {
  Move,
  Line,
  HLine,
  VLine,
  Curve,
  Smooth,
  Arc,
  Close
}

pub struct ShapeCommand {
  pub kind: CommandKind,
  pub relative: bool,
  pub end: Position,
  pub control1: Option<ControlPoint>,
  pub control2: Option<ControlPoint>,
  pub radii: Option<Point>,
  /// One radius uses the reference box's direction-agnostic size for percentages.
  pub singleRadius: bool,
  pub clockwise: bool,
  pub large: bool,
  pub rotation: Option<ExprId>,
}

impl Copy for ShapeCommand {}

pub union Shape {
  Rectangle { pub kind: RectangleKind, pub edges: [Option<ExprId>; 4], pub corners: Corners },
  Ellipse { pub circle: bool, pub size: RadialSize, pub position: Position },
  Polygon { pub evenodd: bool, pub round: Option<ExprId>, pub points: List<Point> },
  Path { pub evenodd: bool, pub path: Path },
  Commands { pub evenodd: bool, pub start: Position, pub commands: List<ShapeCommand> },
}

pub union ClipSource {
  Url { pub url: Bytes },
  Shape { pub shape: Shape, pub reference: GeometryBox },
  Box { pub reference: GeometryBox },
}

pub union EffectValue {
  None,
  Filters { pub items: List<Filter> },
  Masks { pub layers: List<MaskLayer>, pub resetBorder: Border },
  MaskBorder { pub border: Border },
  ClipPath { pub source: ClipSource },
  Shapes { pub sources: List<ClipSource> },
  Clip { pub edges: [Option<ExprId>; 4] },
  Background { pub fresh: bool, pub region: Option<[ExprId; 4]> },
}

effect fn copyBytes(data: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = Bytes.make()
  run result.append(data)
  return move result
}

/// Whether `a` and `b` are the same mask, mask-border or empty value with no images, so one
/// can stand for the other (other values report false).
pub fn identical(a: &EffectValue, b: &EffectValue) -> bool {
  return match &a.* {
    EffectValue.None => match &b.* {
      EffectValue.None => true
      _ => false
    }
    EffectValue.Masks { layers, resetBorder } => match &b.* {
      EffectValue.Masks { layers: otherLayers, resetBorder: otherBorder } => {
        if layers.length() != otherLayers.length() || !sameBorder(&resetBorder, &otherBorder) {
          return false
        }
        let mut i: usize = 0
        while i < layers.length() {
          if !sameLayer(&layers.asSlice()[i], &otherLayers.asSlice()[i]) {
            return false
          }
          i = i + 1
        }
        true
      }
      _ => false
    }
    EffectValue.MaskBorder { border } => match &b.* {
      EffectValue.MaskBorder { border: other } => sameBorder(&border, &other)
      _ => false
    }
    _ => false
  }
}

fn noImage(image: &Image) -> bool {
  return match &image.* {
    Image.None => true
    _ => false
  }
}

fn sameLayer(a: &MaskLayer, b: &MaskLayer) -> bool {
  return noImage(&a.image) && noImage(&b.image) && a.mode == b.mode
    && samePosition(a.position, b.position)
    && sameSize(a.size, b.size)
    && a.repeat.x == b.repeat.x
    && a.repeat.y == b.repeat.y
    && a.origin == b.origin
    && a.clip == b.clip
    && a.composite == b.composite
}

fn samePosition(a: Position, b: Position) -> bool {
  return a.x.edge == b.x.edge && a.x.offset.index == b.x.offset.index && a.y.edge == b.y.edge
    && a.y.offset.index == b.y.offset.index
}

fn sameOptional(a: Option<ExprId>, b: Option<ExprId>) -> bool {
  return match &a {
    Option<ExprId>.Some { value } => match &b {
      Option<ExprId>.Some { value: other } => value.index == other.index
      _ => false
    }
    _ => b.isNone()
  }
}

fn sameSize(a: Size, b: Size) -> bool {
  return match &a {
    Size.Cover => match &b {
      Size.Cover => true
      _ => false
    }
    Size.Contain => match &b {
      Size.Contain => true
      _ => false
    }
    Size.Explicit { x, y } => match &b {
      Size.Explicit { x: otherX, y: otherY } => sameOptional(x, otherX) && sameOptional(y, otherY)
      _ => false
    }
  }
}

fn sameMeasure(a: BorderMeasure, b: BorderMeasure) -> bool {
  return match &a {
    BorderMeasure.Auto => match &b {
      BorderMeasure.Auto => true
      _ => false
    }
    BorderMeasure.Numeric { value } => match &b {
      BorderMeasure.Numeric { value: other } => value.index == other.index
      _ => false
    }
  }
}

fn sameBorder(a: &Border, b: &Border) -> bool {
  if !noImage(&a.image) || !noImage(&b.image) || a.mode != b.mode || a.fill != b.fill
    || a.repeat.x != b.repeat.x
    || a.repeat.y != b.repeat.y {
    return false
  }
  let mut i: usize = 0
  while i < 4 {
    if a.slice[i].index != b.slice[i].index || a.outset[i].index != b.outset[i].index
      || !sameMeasure(a.width[i], b.width[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether `copy` can duplicate the value: everything but path() shapes, which own a path.
pub fn copyable(value: &EffectValue) -> bool {
  return match &value.* {
    EffectValue.ClipPath { source } => copyableSource(&source)
    EffectValue.Shapes { sources } => {
      let mut i: usize = 0
      while i < sources.length() {
        if !copyableSource(&sources.asSlice()[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => true
  }
}

fn copyableSource(source: &ClipSource) -> bool {
  return match &source.* {
    ClipSource.Shape { shape, reference } => match &shape {
      Shape.Path { evenodd, path } => false
      _ => true
    }
    _ => true
  }
}

/// A deep copy of a [`copyable`] value.
pub effect fn copy(value: &EffectValue) -> EffectValue
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    EffectValue.Filters { items } => {
      let mut copied = run List<Filter>.makeWithCapacity(items.length())
      let mut i: usize = 0
      while i < items.length() {
        run copied.append(run copyFilter(&items.asSlice()[i]))
        i = i + 1
      }
      EffectValue.Filters { items: move copied }
    }
    EffectValue.Masks { layers, resetBorder } => {
      let mut copied = run List<MaskLayer>.makeWithCapacity(layers.length())
      let mut i: usize = 0
      while i < layers.length() {
        let layer = &layers.asSlice()[i]
        run copied.append(
          MaskLayer {
            image: run copyImage(&layer.image),
            mode: layer.mode,
            position: layer.position,
            size: layer.size,
            repeat: layer.repeat,
            origin: layer.origin,
            clip: layer.clip,
            composite: layer.composite,
          },
        )
        i = i + 1
      }
      EffectValue.Masks { layers: move copied, resetBorder: run copyBorder(&resetBorder) }
    }
    EffectValue.MaskBorder { border } => EffectValue.MaskBorder { border: run copyBorder(&border) }
    EffectValue.ClipPath { source } => EffectValue.ClipPath { source: run copySource(&source) }
    EffectValue.Shapes { sources } => {
      let mut copied = run List<ClipSource>.makeWithCapacity(sources.length())
      let mut i: usize = 0
      while i < sources.length() {
        run copied.append(run copySource(&sources.asSlice()[i]))
        i = i + 1
      }
      EffectValue.Shapes { sources: move copied }
    }
    EffectValue.Clip { edges } => EffectValue.Clip { edges: edges }
    EffectValue.Background { fresh, region } => EffectValue.Background {
      fresh: fresh,
      region: region,
    }
    _ => EffectValue.None
  }
}

effect fn copyFilter(filter: &Filter) -> Filter
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &filter.* {
    Filter.Url { url } => Filter.Url { url: run copyBytes(Bytes.asSlice(&url)) }
    Filter.Function { kind, amount } => Filter.Function { kind: kind, amount: amount }
    Filter.DropShadow { x, y, blur, color } => Filter.DropShadow {
      x: x,
      y: y,
      blur: blur,
      color: color,
    }
  }
}

effect fn copyStops(stops: &List<GradientStop>) -> List<GradientStop>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copied = run List<GradientStop>.makeWithCapacity(stops.length())
  run copied.appendSlice(stops.asSlice())
  return move copied
}

effect fn copyImage(image: &Image) -> Image
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &image.* {
    Image.None => Image.None
    Image.Url { url } => Image.Url { url: run copyBytes(Bytes.asSlice(&url)) }
    Image.Linear { repeating, direction, stops } => Image.Linear {
      repeating: repeating,
      direction: direction,
      stops: run copyStops(&stops),
    }
    Image.Radial { repeating, circle, size, position, stops } => Image.Radial {
      repeating: repeating,
      circle: circle,
      size: size,
      position: position,
      stops: run copyStops(&stops),
    }
  }
}

effect fn copyBorder(border: &Border) -> Border
  ! OutOfMemoryError
  ? &mut Allocator {
  return Border {
    image: run copyImage(&border.image),
    mode: border.mode,
    slice: border.slice,
    fill: border.fill,
    width: border.width,
    outset: border.outset,
    repeat: border.repeat,
  }
}

effect fn copySource(source: &ClipSource) -> ClipSource
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &source.* {
    ClipSource.Url { url } => ClipSource.Url { url: run copyBytes(Bytes.asSlice(&url)) }
    ClipSource.Box { reference } => ClipSource.Box { reference: reference }
    ClipSource.Shape { shape, reference } => match &shape {
      // Not copyable (see copyableSource): the path is left to the source.
      Shape.Path { evenodd, path } => ClipSource.Box { reference: reference }
      _ => ClipSource.Shape { shape: run copyShape(&shape), reference: reference }
    }
  }
}

effect fn copyShape(shape: &Shape) -> Shape
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &shape.* {
    Shape.Rectangle { kind, edges, corners } => Shape.Rectangle {
      kind: kind,
      edges: edges,
      corners: corners,
    }
    Shape.Ellipse { circle, size, position } => Shape.Ellipse {
      circle: circle,
      size: size,
      position: position,
    }
    Shape.Polygon { evenodd, round, points } => {
      let mut copied = run List<Point>.makeWithCapacity(points.length())
      run copied.appendSlice(points.asSlice())
      Shape.Polygon { evenodd: evenodd, round: round, points: move copied }
    }
    Shape.Commands { evenodd, start, commands } => {
      let mut copied = run List<ShapeCommand>.makeWithCapacity(commands.length())
      run copied.appendSlice(commands.asSlice())
      Shape.Commands { evenodd: evenodd, start: start, commands: move copied }
    }
    Shape.Path { evenodd, path } => Shape.Polygon {
      evenodd: evenodd,
      round: Option<ExprId>.None,
      points: List<Point>.make(),
    }
  }
}

/// A failed URL parse leaves the cursor unchanged, including malformed quoted url().
pub effect fn parseUrl(input: &Input, cursor: &mut Cursor) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut trial = Cursor { position: cursor.position, end: cursor.end }
  trial.skip(input)
  if trial.position >= trial.end {
    return Option<Bytes>.None
  }
  match &input.at(trial.position) {
    Option<TokenView>.Some { value: view } => match &view.token.kind {
      Kind.Url { text } => {
        let url = run copyBytes(view.text(text))
        cursor.position = trial.position + 1
        return Option<Bytes>.some(move url)
      }
      _ => {}
    }
    _ => {}
  }
  if !trial.function(input, b"url") && !trial.function(input, b"src") {
    return Option<Bytes>.None
  }
  trial.skip(input)
  if trial.position >= trial.end {
    return Option<Bytes>.None
  }
  match &input.at(trial.position) {
    Option<TokenView>.Some { value: view } => match &view.token.kind {
      Kind.String { text } => {
        let url = run copyBytes(view.text(text))
        trial.position = trial.position + 1
        if !trial.close(input) {
          return Option<Bytes>.None
        }
        cursor.position = trial.position
        return Option<Bytes>.some(move url)
      }
      _ => {}
    }
    _ => {}
  }
  return Option<Bytes>.None
}

effect fn numeric(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  kind: Dimension,
  nonnegative: bool,
  presentation: bool,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  let result = run dimensions.parse(&mut store.*, input, &mut cursor.*, kind, presentation)
  match &result {
    Option<ExprId>.Some { value } => {
      if nonnegative && dimensions.negativeLiteral(&store.*, value) {
        cursor.position = start
        return Option<ExprId>.None
      }
    }
    _ => {}
  }
  return result
}

effect fn zero(store: &mut dimensions.Store) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  return run dimensions.literal(&mut store.*, 0.0, Unit.Px)
}

effect fn defaultPosition(store: &mut dimensions.Store, center: bool) -> Position
  ! OutOfMemoryError
  ? &mut Allocator {
  let z = run zero(&mut store.*)
  let axis = PositionAxis {
    edge: if center {
      Edge.Center
    } else {
      Edge.Start
    },
    offset: z,
  }
  return Position { x: axis, y: axis }
}

fn atEnd(input: &Input, cursor: &mut Cursor) -> bool {
  cursor.skip(input)
  if cursor.position >= cursor.end {
    return true
  }
  return match &input.at(cursor.position) {
    Option<TokenView>.Some { value } => match &value.token.kind {
      Kind.CloseParen => true
      _ => false
    }
    _ => true
  }
}

fn filterKind(input: &Input, cursor: &mut Cursor) -> Option<FilterKind> {
  if cursor.function(input, b"blur") {
    return Option<FilterKind>.some(FilterKind.Blur)
  }
  if cursor.function(input, b"brightness") {
    return Option<FilterKind>.some(FilterKind.Brightness)
  }
  if cursor.function(input, b"contrast") {
    return Option<FilterKind>.some(FilterKind.Contrast)
  }
  if cursor.function(input, b"grayscale") {
    return Option<FilterKind>.some(FilterKind.Grayscale)
  }
  if cursor.function(input, b"hue-rotate") {
    return Option<FilterKind>.some(FilterKind.HueRotate)
  }
  if cursor.function(input, b"invert") {
    return Option<FilterKind>.some(FilterKind.Invert)
  }
  if cursor.function(input, b"opacity") {
    return Option<FilterKind>.some(FilterKind.Opacity)
  }
  if cursor.function(input, b"saturate") {
    return Option<FilterKind>.some(FilterKind.Saturate)
  }
  if cursor.function(input, b"sepia") {
    return Option<FilterKind>.some(FilterKind.Sepia)
  }
  return Option<FilterKind>.None
}

/// `presentation` admits unitless lengths and angles anywhere in the grammar, as the
/// SVG 2 presentation attribute grammar substitution (types.html#presentation-attribute-css-value) says.
effect fn filterItem(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<Filter>
  ! OutOfMemoryError
  ? &mut Allocator {
  let resource = run parseUrl(input, &mut cursor.*)
  match move resource {
    Option<Bytes>.Some { value } => {
      return Option<Filter>.some(Filter.Url { url: move value })
    }
    _ => {}
  }
  if cursor.function(input, b"drop-shadow") {
    let leading = run colors.parse(input, &mut cursor.*)
    let x = match run numeric(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      false,
      presentation,
    ) {
      Option<ExprId>.Some { value } => value
      _ => {
        return Option<Filter>.None
      }
    }
    let y = match run numeric(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      false,
      presentation,
    ) {
      Option<ExprId>.Some { value } => value
      _ => {
        return Option<Filter>.None
      }
    }
    let blur = match run numeric(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.Length,
      true,
      presentation,
    ) {
      Option<ExprId>.Some { value } => value
      _ => run zero(&mut store.*)
    }
    let color = match &leading {
      Option<Color>.Some { value } => value
      _ => match run colors.parse(input, &mut cursor.*) {
        Option<Color>.Some { value } => value
        _ => Color.current()
      }
    }
    if !cursor.close(input) {
      return Option<Filter>.None
    }
    return Option<Filter>.some(Filter.DropShadow { x: x, y: y, blur: blur, color: color })
  }
  let kind = match filterKind(input, &mut cursor.*) {
    Option<FilterKind>.Some { value } => value
    _ => {
      return Option<Filter>.None
    }
  }
  let dimension = if kind == FilterKind.Blur {
    Dimension.Length
  } else if kind == FilterKind.HueRotate {
    Dimension.Angle
  } else {
    Dimension.NumberPercentage
  }
  let amount = if atEnd(input, &mut cursor.*) {
    run dimensions.literal(
      &mut store.*,
      if kind == FilterKind.Blur || kind == FilterKind.HueRotate {
        0.0
      } else {
        1.0
      },
      if kind == FilterKind.Blur {
        Unit.Px
      } else if kind == FilterKind.HueRotate {
        Unit.Deg
      } else {
        Unit.Number
      },
    )
  } else {
    let parsed = if kind == FilterKind.HueRotate {
      run angleWithZero(&mut store.*, input, &mut cursor.*, presentation)
    } else {
      run numeric(&mut store.*, input, &mut cursor.*, dimension, true, presentation)
    }
    match &parsed {
      Option<ExprId>.Some { value } => value
      _ => {
        return Option<Filter>.None
      }
    }
  }
  if !cursor.close(input) {
    return Option<Filter>.None
  }
  return Option<Filter>.some(Filter.Function { kind: kind, amount: amount })
}

fn extent(input: &Input, cursor: &mut Cursor) -> Option<Extent> {
  if cursor.ident(input, b"closest-side") {
    return Option<Extent>.some(Extent.ClosestSide)
  }
  if cursor.ident(input, b"closest-corner") {
    return Option<Extent>.some(Extent.ClosestCorner)
  }
  if cursor.ident(input, b"farthest-side") {
    return Option<Extent>.some(Extent.FarthestSide)
  }
  if cursor.ident(input, b"farthest-corner") {
    return Option<Extent>.some(Extent.FarthestCorner)
  }
  return Option<Extent>.None
}

effect fn radialSize(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<RadialSize>
  ! OutOfMemoryError
  ? &mut Allocator {
  match extent(input, &mut cursor.*) {
    Option<Extent>.Some { value } => {
      return Option<RadialSize>.some(RadialSize.Extent { extent: value })
    }
    _ => {}
  }
  let x = match run numeric(
    &mut store.*,
    input,
    &mut cursor.*,
    Dimension.LengthPercentage,
    true,
    presentation,
  ) {
    Option<ExprId>.Some { value } => value
    _ => {
      return Option<RadialSize>.None
    }
  }
  let y = run numeric(
    &mut store.*,
    input,
    &mut cursor.*,
    Dimension.LengthPercentage,
    true,
    presentation,
  )
  return Option<RadialSize>.some(RadialSize.Radii { x: x, y: y })
}

/// Circle percentages are valid for basic shapes, but not for gradient circle radii.
fn validRadial(size: &RadialSize, circle: bool, gradient: bool, store: &dimensions.Store) -> bool {
  return match &size.* {
    RadialSize.Extent { extent } => true
    RadialSize.Radii { x, y } => match &y {
      Option<ExprId>.Some { value } => !circle
      _ => circle && (!gradient || !dimensions.containsPercentage(store, x))
    }
  }
}

effect fn stops(store: &mut dimensions.Store, input: &Input, cursor: &mut Cursor) -> Option<
  List<GradientStop>
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<GradientStop>.make()
  let mut count: usize = 0
  let mut previousHint = false
  while true {
    let color = run colors.parse(input, &mut cursor.*)
    match &color {
      Option<Color>.Some { value } => {
        let position = run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.LengthPercentage,
          false,
          false,
        )
        run result.append(GradientStop.ColorStop { color: value, position: position })
        count = count + 1
        previousHint = false
      }
      _ => {
        if count == 0 || previousHint {
          return Option<List<GradientStop>>.None
        }
        let position = match run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.LengthPercentage,
          false,
          false,
        ) {
          Option<ExprId>.Some { value } => value
          _ => {
            return Option<List<GradientStop>>.None
          }
        }
        run result.append(GradientStop.Hint { position: position })
        previousHint = true
      }
    }
    if !cursor.comma(input) {
      break
    }
  }
  if count < 2 || previousHint || !cursor.close(input) {
    return Option<List<GradientStop>>.None
  }
  return Option<List<GradientStop>>.some(move result)
}

effect fn imageInner(store: &mut dimensions.Store, input: &Input, cursor: &mut Cursor) -> Option<
  Image
>
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(input, b"none") {
    return Option<Image>.some(Image.None)
  }
  let resource = run parseUrl(input, &mut cursor.*)
  match move resource {
    Option<Bytes>.Some { value } => {
      return Option<Image>.some(Image.Url { url: move value })
    }
    _ => {}
  }
  let mut repeating = false
  let mut radial = false
  if cursor.function(input, b"linear-gradient") {} else if cursor.function(
    input,
    b"repeating-linear-gradient",
  ) {
    repeating = true
  } else if cursor.function(input, b"radial-gradient") {
    radial = true
  } else if cursor.function(input, b"repeating-radial-gradient") {
    radial = true
    repeating = true
  } else {
    return Option<Image>.None
  }
  if !radial {
    let mut direction = Direction.Corner { x: Edge.Center, y: Edge.End }
    let mut header = false
    if cursor.ident(input, b"to") {
      header = true
      let mut x = Edge.Center
      let mut y = Edge.Center
      let mut count: usize = 0
      while count < 2 {
        if x == Edge.Center && cursor.ident(input, b"left") {
          x = Edge.Start
        } else if x == Edge.Center && cursor.ident(input, b"right") {
          x = Edge.End
        } else if y == Edge.Center && cursor.ident(input, b"top") {
          y = Edge.Start
        } else if y == Edge.Center && cursor.ident(input, b"bottom") {
          y = Edge.End
        } else {
          break
        }
        count = count + 1
      }
      if count == 0 {
        return Option<Image>.None
      }
      direction = Direction.Corner { x: x, y: y }
    } else {
      match run angleWithZero(&mut store.*, input, &mut cursor.*, false) {
        Option<ExprId>.Some { value } => {
          direction = Direction.Angle { angle: value }
          header = true
        }
        _ => {}
      }
    }
    if header && !cursor.comma(input) {
      return Option<Image>.None
    }
    let list = match run stops(&mut store.*, input, &mut cursor.*) {
      Option<List<GradientStop>>.Some { value } => move value
      _ => {
        return Option<Image>.None
      }
    }
    return Option<Image>.some(
      Image.Linear { repeating: repeating, direction: direction, stops: move list },
    )
  }
  let mut circle = false
  let mut hasShape = false
  let mut hasSize = false
  let mut header = false
  let mut size = RadialSize.Extent { extent: Extent.FarthestCorner }
  while true {
    if !hasShape && cursor.ident(input, b"circle") {
      circle = true
      hasShape = true
      header = true
      continue
    }
    if !hasShape && cursor.ident(input, b"ellipse") {
      circle = false
      hasShape = true
      header = true
      continue
    }
    if !hasSize {
      match run radialSize(&mut store.*, input, &mut cursor.*, false) {
        Option<RadialSize>.Some { value } => {
          size = value
          hasSize = true
          header = true
          continue
        }
        _ => {}
      }
    }
    break
  }
  if !hasShape {
    circle = match &size {
      RadialSize.Radii { x, y } => match &y {
        Option<ExprId>.None => true
        _ => false
      }
      _ => false
    }
  }
  if !validRadial(&size, circle, true, &store.*) {
    return Option<Image>.None
  }
  let mut position = run defaultPosition(&mut store.*, true)
  if cursor.ident(input, b"at") {
    position = match run transform_values.parsePosition(&mut store.*, input, &mut cursor.*, false) {
      Option<Position>.Some { value } => value
      _ => {
        return Option<Image>.None
      }
    }
    header = true
  }
  if header && !cursor.comma(input) {
    return Option<Image>.None
  }
  let list = match run stops(&mut store.*, input, &mut cursor.*) {
    Option<List<GradientStop>>.Some { value } => move value
    _ => {
      return Option<Image>.None
    }
  }
  return Option<Image>.some(
    Image.Radial {
      repeating: repeating,
      circle: circle,
      size: size,
      position: position,
      stops: move list,
    },
  )
}

pub effect fn parseImage(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
) -> Option<Image>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut trial = cursor.*
  let result = run imageInner(&mut store.*, input, &mut trial)
  match &result {
    Option<Image>.Some { value } => {
      cursor.position = trial.position
    }
    _ => {}
  }
  return move result
}

fn geometryBox(input: &Input, cursor: &mut Cursor, noClip: bool) -> Option<GeometryBox> {
  if cursor.ident(input, b"content-box") {
    return Option<GeometryBox>.some(GeometryBox.Content)
  }
  if cursor.ident(input, b"padding-box") {
    return Option<GeometryBox>.some(GeometryBox.Padding)
  }
  if cursor.ident(input, b"border-box") {
    return Option<GeometryBox>.some(GeometryBox.Border)
  }
  if cursor.ident(input, b"margin-box") {
    return Option<GeometryBox>.some(GeometryBox.Margin)
  }
  if cursor.ident(input, b"fill-box") {
    return Option<GeometryBox>.some(GeometryBox.Fill)
  }
  if cursor.ident(input, b"stroke-box") {
    return Option<GeometryBox>.some(GeometryBox.Stroke)
  }
  if cursor.ident(input, b"view-box") {
    return Option<GeometryBox>.some(GeometryBox.View)
  }
  if noClip && cursor.ident(input, b"no-clip") {
    return Option<GeometryBox>.some(GeometryBox.NoClip)
  }
  return Option<GeometryBox>.None
}

fn mode(input: &Input, cursor: &mut Cursor, matchSource: bool) -> Option<MaskMode> {
  if cursor.ident(input, b"alpha") {
    return Option<MaskMode>.some(MaskMode.Alpha)
  }
  if cursor.ident(input, b"luminance") {
    return Option<MaskMode>.some(MaskMode.Luminance)
  }
  if matchSource && cursor.ident(input, b"match-source") {
    return Option<MaskMode>.some(MaskMode.MatchSource)
  }
  return Option<MaskMode>.None
}

fn composite(input: &Input, cursor: &mut Cursor) -> Option<Composite> {
  if cursor.ident(input, b"add") {
    return Option<Composite>.some(Composite.Add)
  }
  if cursor.ident(input, b"subtract") {
    return Option<Composite>.some(Composite.Subtract)
  }
  if cursor.ident(input, b"intersect") {
    return Option<Composite>.some(Composite.Intersect)
  }
  if cursor.ident(input, b"exclude") {
    return Option<Composite>.some(Composite.Exclude)
  }
  return Option<Composite>.None
}

fn repeat(input: &Input, cursor: &mut Cursor, border: bool) -> Option<Repeat> {
  if cursor.ident(input, b"repeat") {
    return Option<Repeat>.some(Repeat.Repeat)
  }
  if cursor.ident(input, b"space") {
    return Option<Repeat>.some(Repeat.Space)
  }
  if cursor.ident(input, b"round") {
    return Option<Repeat>.some(Repeat.Round)
  }
  if border && cursor.ident(input, b"stretch") {
    return Option<Repeat>.some(Repeat.Stretch)
  }
  if !border && cursor.ident(input, b"no-repeat") {
    return Option<Repeat>.some(Repeat.NoRepeat)
  }
  return Option<Repeat>.None
}

fn repeatPair(input: &Input, cursor: &mut Cursor, border: bool) -> Option<RepeatPair> {
  if !border && cursor.ident(input, b"repeat-x") {
    return Option<RepeatPair>.some(RepeatPair { x: Repeat.Repeat, y: Repeat.NoRepeat })
  }
  if !border && cursor.ident(input, b"repeat-y") {
    return Option<RepeatPair>.some(RepeatPair { x: Repeat.NoRepeat, y: Repeat.Repeat })
  }
  let x = match repeat(input, &mut cursor.*, border) {
    Option<Repeat>.Some { value } => value
    _ => {
      return Option<RepeatPair>.None
    }
  }
  let y = match repeat(input, &mut cursor.*, border) {
    Option<Repeat>.Some { value } => value
    _ => x
  }
  return Option<RepeatPair>.some(RepeatPair { x: x, y: y })
}

effect fn sizeValue(store: &mut dimensions.Store, input: &Input, cursor: &mut Cursor) -> Option<
  Size
>
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(input, b"cover") {
    return Option<Size>.some(Size.Cover)
  }
  if cursor.ident(input, b"contain") {
    return Option<Size>.some(Size.Contain)
  }
  let x = if cursor.ident(input, b"auto") {
    Option<ExprId>.None
  } else {
    match run numeric(&mut store.*, input, &mut cursor.*, Dimension.LengthPercentage, true, false) {
      Option<ExprId>.Some { value } => Option<ExprId>.some(value)
      _ => {
        return Option<Size>.None
      }
    }
  }
  let y = if cursor.ident(input, b"auto") {
    Option<ExprId>.None
  } else {
    run numeric(&mut store.*, input, &mut cursor.*, Dimension.LengthPercentage, true, false)
  }
  return Option<Size>.some(Size.Explicit { x: x, y: y })
}

effect fn defaultLayer(store: &mut dimensions.Store) -> MaskLayer
  ! OutOfMemoryError
  ? &mut Allocator {
  return MaskLayer {
    image: Image.None,
    mode: MaskMode.MatchSource,
    position: run defaultPosition(&mut store.*, false),
    size: Size.Explicit { x: Option<ExprId>.None, y: Option<ExprId>.None },
    repeat: RepeatPair { x: Repeat.Repeat, y: Repeat.Repeat },
    origin: GeometryBox.Border,
    clip: GeometryBox.Border,
    composite: Composite.Add,
  }
}

effect fn maskLayer(
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> Option<MaskLayer>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut layer = run defaultLayer(&mut store.*)
  let shorthand = property == Property.Mask
  let maxBoxes: usize = if shorthand {
    2
  } else {
    1
  }
  let mut imageSeen = false
  let mut modeSeen = false
  let mut positionSeen = false
  let mut repeatSeen = false
  let mut compositeSeen = false
  let mut boxes: usize = 0
  let mut noClip = false
  let mut any = false
  while true {
    if (shorthand || property == Property.MaskImage) && !imageSeen {
      let parsed = run parseImage(&mut store.*, input, &mut cursor.*)
      match move parsed {
        Option<Image>.Some { value } => {
          layer.image = move value
          imageSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskMode) && !modeSeen {
      match mode(input, &mut cursor.*, true) {
        Option<MaskMode>.Some { value } => {
          layer.mode = value
          modeSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskRepeat) && !repeatSeen {
      match repeatPair(input, &mut cursor.*, false) {
        Option<RepeatPair>.Some { value } => {
          layer.repeat = value
          repeatSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskComposite) && !compositeSeen {
      match composite(input, &mut cursor.*) {
        Option<Composite>.Some { value } => {
          layer.composite = value
          compositeSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskClip || property == Property.MaskOrigin)
      && boxes < maxBoxes {
      match geometryBox(input, &mut cursor.*, property != Property.MaskOrigin) {
        Option<GeometryBox>.Some { value } => {
          if value == GeometryBox.NoClip {
            if noClip || boxes > 1 {
              return Option<MaskLayer>.None
            }
            noClip = true
            layer.clip = GeometryBox.NoClip
          } else if !shorthand {
            if property == Property.MaskOrigin {
              layer.origin = value
            } else {
              layer.clip = value
            }
          } else if boxes == 0 || noClip {
            layer.origin = value
            if !noClip {
              layer.clip = value
            }
          } else {
            layer.clip = value
          }
          boxes = boxes + 1
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskPosition) && !positionSeen {
      match run transform_values.parsePosition(&mut store.*, input, &mut cursor.*, false) {
        Option<Position>.Some { value } => {
          layer.position = value
          if shorthand && cursor.delim(input, 47) {
            layer.size = match run sizeValue(&mut store.*, input, &mut cursor.*) {
              Option<Size>.Some { value: parsedSize } => parsedSize
              _ => {
                return Option<MaskLayer>.None
              }
            }
          }
          positionSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if property == Property.MaskSize && !any {
      match run sizeValue(&mut store.*, input, &mut cursor.*) {
        Option<Size>.Some { value } => {
          layer.size = value
          any = true
          continue
        }
        _ => {}
      }
    }
    break
  }
  if !any {
    return Option<MaskLayer>.None
  }
  return Option<MaskLayer>.some(move layer)
}

effect fn measure(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  property: Property,
) -> Option<BorderMeasure>
  ! OutOfMemoryError
  ? &mut Allocator {
  if property == Property.MaskBorderWidth && cursor.ident(input, b"auto") {
    return Option<BorderMeasure>.some(BorderMeasure.Auto)
  }
  let numberKind = if property == Property.MaskBorderSlice {
    Dimension.NumberPercentage
  } else {
    Dimension.Number
  }
  match run numeric(&mut store.*, input, &mut cursor.*, numberKind, true, false) {
    Option<ExprId>.Some { value } => {
      return Option<BorderMeasure>.some(BorderMeasure.Numeric { value: value })
    }
    _ => {}
  }
  if property == Property.MaskBorderSlice {
    return Option<BorderMeasure>.None
  }
  let lengthKind = if property == Property.MaskBorderWidth {
    Dimension.LengthPercentage
  } else {
    Dimension.Length
  }
  return match run numeric(&mut store.*, input, &mut cursor.*, lengthKind, true, false) {
    Option<ExprId>.Some { value } => Option<BorderMeasure>.some(
      BorderMeasure.Numeric { value: value },
    )
    _ => Option<BorderMeasure>.None
  }
}

effect fn measures(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  property: Property,
) -> Option<[BorderMeasure; 4]>
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = match run measure(&mut store.*, input, &mut cursor.*, property) {
    Option<BorderMeasure>.Some { value } => value
    _ => {
      return Option<[BorderMeasure; 4]>.None
    }
  }
  let mut result = [first; 4]
  let mut count: usize = 1
  while count < 4 {
    match run measure(&mut store.*, input, &mut cursor.*, property) {
      Option<BorderMeasure>.Some { value } => {
        result[count] = value
        count = count + 1
      }
      _ => {
        break
      }
    }
  }
  if count < 3 {
    result[2] = result[0]
  }
  if count < 4 {
    result[3] = result[1]
  }
  return Option<[BorderMeasure; 4]>.some(result)
}

fn numericMeasures(values: &[BorderMeasure; 4], defaultValue: ExprId) -> [ExprId; 4] {
  let mut result = [defaultValue; 4]
  let mut i: usize = 0
  while i < 4 {
    match &values[i] {
      BorderMeasure.Numeric { value } => {
        result[i] = value
      }
      _ => {}
    }
    i = i + 1
  }
  return result
}

/// The mask shorthand resets all six mask-border longhands, but not mask-type.
effect fn initialBorder(store: &mut dimensions.Store) -> Border
  ! OutOfMemoryError
  ? &mut Allocator {
  let z = run dimensions.literal(&mut store.*, 0.0, Unit.Number)
  return Border {
    image: Image.None,
    mode: MaskMode.Alpha,
    slice: [z; 4],
    fill: false,
    width: [BorderMeasure.Auto; 4],
    outset: [z; 4],
    repeat: RepeatPair { x: Repeat.Stretch, y: Repeat.Stretch },
  }
}

effect fn borderValue(
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
) -> Option<Border>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut border = run initialBorder(&mut store.*)
  let z = border.slice[0]
  let shorthand = property == Property.MaskBorder
  let mut sourceSeen = false
  let mut sliceSeen = false
  let mut modeSeen = false
  let mut repeatSeen = false
  let mut any = false
  while true {
    if (shorthand || property == Property.MaskBorderSource) && !sourceSeen {
      let parsed = run parseImage(&mut store.*, input, &mut cursor.*)
      match move parsed {
        Option<Image>.Some { value } => {
          border.image = move value
          sourceSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if shorthand && !modeSeen {
      match mode(input, &mut cursor.*, false) {
        Option<MaskMode>.Some { value } => {
          border.mode = value
          modeSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskBorderRepeat) && !repeatSeen {
      match repeatPair(input, &mut cursor.*, true) {
        Option<RepeatPair>.Some { value } => {
          border.repeat = value
          repeatSeen = true
          any = true
          continue
        }
        _ => {}
      }
    }
    if (shorthand || property == Property.MaskBorderSlice) && !sliceSeen {
      match run measures(&mut store.*, input, &mut cursor.*, Property.MaskBorderSlice) {
        Option<[BorderMeasure; 4]>.Some { value } => {
          border.slice = numericMeasures(&value, z)
          border.fill = cursor.ident(input, b"fill")
          sliceSeen = true
          any = true
          if shorthand && cursor.delim(input, 47) {
            let width = run measures(&mut store.*, input, &mut cursor.*, Property.MaskBorderWidth)
            let hasWidth = match &width {
              Option<[BorderMeasure; 4]>.Some { value: w } => {
                border.width = w
                true
              }
              _ => false
            }
            if cursor.delim(input, 47) {
              let outset = match run measures(
                &mut store.*,
                input,
                &mut cursor.*,
                Property.MaskBorderOutset,
              ) {
                Option<[BorderMeasure; 4]>.Some { value: parsedOutset } => parsedOutset
                _ => {
                  return Option<Border>.None
                }
              }
              border.outset = numericMeasures(&outset, z)
            } else if !hasWidth {
              return Option<Border>.None
            }
          }
          continue
        }
        _ => {}
      }
    }
    if !any && (property == Property.MaskBorderWidth || property == Property.MaskBorderOutset) {
      match run measures(&mut store.*, input, &mut cursor.*, property) {
        Option<[BorderMeasure; 4]>.Some { value } => {
          if property == Property.MaskBorderWidth {
            border.width = value
          } else {
            border.outset = numericMeasures(&value, z)
          }
          any = true
          continue
        }
        _ => {}
      }
    }
    break
  }
  if !any {
    return Option<Border>.None
  }
  return Option<Border>.some(move border)
}

effect fn lengthQuad(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  nonnegative: bool,
  presentation: bool,
) -> Option<[ExprId; 4]>
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = match run numeric(
    &mut store.*,
    input,
    &mut cursor.*,
    Dimension.LengthPercentage,
    nonnegative,
    presentation,
  ) {
    Option<ExprId>.Some { value } => value
    _ => {
      return Option<[ExprId; 4]>.None
    }
  }
  let mut result = [first; 4]
  let mut count: usize = 1
  while count < 4 {
    match run numeric(
      &mut store.*,
      input,
      &mut cursor.*,
      Dimension.LengthPercentage,
      nonnegative,
      presentation,
    ) {
      Option<ExprId>.Some { value } => {
        result[count] = value
        count = count + 1
      }
      _ => {
        break
      }
    }
  }
  if count < 3 {
    result[2] = result[0]
  }
  if count < 4 {
    result[3] = result[1]
  }
  return Option<[ExprId; 4]>.some(result)
}

effect fn corners(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<Corners>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !cursor.ident(input, b"round") {
    let z = run zero(&mut store.*)
    return Option<Corners>.some(Corners { x: [z; 4], y: [z; 4] })
  }
  let x = match run lengthQuad(&mut store.*, input, &mut cursor.*, true, presentation) {
    Option<[ExprId; 4]>.Some { value } => value
    _ => {
      return Option<Corners>.None
    }
  }
  let y = if cursor.delim(input, 47) {
    match run lengthQuad(&mut store.*, input, &mut cursor.*, true, presentation) {
      Option<[ExprId; 4]>.Some { value } => value
      _ => {
        return Option<Corners>.None
      }
    }
  } else {
    x
  }
  return Option<Corners>.some(Corners { x: x, y: y })
}

effect fn point(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<Point>
  ! OutOfMemoryError
  ? &mut Allocator {
  let x = match run numeric(
    &mut store.*,
    input,
    &mut cursor.*,
    Dimension.LengthPercentage,
    false,
    presentation,
  ) {
    Option<ExprId>.Some { value } => value
    _ => {
      return Option<Point>.None
    }
  }
  let y = match run numeric(
    &mut store.*,
    input,
    &mut cursor.*,
    Dimension.LengthPercentage,
    false,
    presentation,
  ) {
    Option<ExprId>.Some { value } => value
    _ => {
      return Option<Point>.None
    }
  }
  return Option<Point>.some(Point { x: x, y: y })
}

fn pointPosition(value: Point) -> Position {
  return Position {
    x: PositionAxis { edge: Edge.Start, offset: value.x },
    y: PositionAxis { edge: Edge.Start, offset: value.y },
  }
}

effect fn endpoint(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  relative: bool,
  presentation: bool,
) -> Option<Position>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !relative {
    return run transform_values.parsePosition(&mut store.*, input, &mut cursor.*, presentation)
  }
  return match run point(&mut store.*, input, &mut cursor.*, presentation) {
    Option<Point>.Some { value } => Option<Position>.some(pointPosition(value))
    _ => Option<Position>.None
  }
}

effect fn controlPoint(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  relative: bool,
  presentation: bool,
) -> Option<ControlPoint>
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = cursor.position
  let mut pair = false
  let position = if relative {
    pair = true
    match run endpoint(&mut store.*, input, &mut cursor.*, true, presentation) {
      Option<Position>.Some { value } => value
      _ => {
        return Option<ControlPoint>.None
      }
    }
  } else {
    let mut trial = cursor.*
    match run point(&mut store.*, input, &mut trial, presentation) {
      Option<Point>.Some { value } => {
        // Numeric pairs permit a following control-point origin qualifier.
        pair = true
        cursor.position = trial.position
        pointPosition(value)
      }
      _ => match run transform_values.parsePosition(
        &mut store.*,
        input,
        &mut cursor.*,
        presentation,
      ) {
        Option<Position>.Some { value } => value
        _ => {
          cursor.position = start
          return Option<ControlPoint>.None
        }
      }
    }
  }
  let mut origin = if relative {
    ControlOrigin.Start
  } else {
    ControlOrigin.Origin
  }
  if cursor.ident(input, b"from") {
    if !pair {
      return Option<ControlPoint>.None
    }
    if cursor.ident(input, b"start") {
      origin = ControlOrigin.Start
    } else if cursor.ident(input, b"end") {
      origin = ControlOrigin.End
    } else if cursor.ident(input, b"origin") {
      origin = ControlOrigin.Origin
    } else {
      return Option<ControlPoint>.None
    }
  }
  return Option<ControlPoint>.some(ControlPoint { position: position, origin: origin })
}

fn commandKind(input: &Input, cursor: &mut Cursor) -> Option<CommandKind> {
  if cursor.ident(input, b"move") {
    return Option<CommandKind>.some(CommandKind.Move)
  }
  if cursor.ident(input, b"line") {
    return Option<CommandKind>.some(CommandKind.Line)
  }
  if cursor.ident(input, b"hline") {
    return Option<CommandKind>.some(CommandKind.HLine)
  }
  if cursor.ident(input, b"vline") {
    return Option<CommandKind>.some(CommandKind.VLine)
  }
  if cursor.ident(input, b"curve") {
    return Option<CommandKind>.some(CommandKind.Curve)
  }
  if cursor.ident(input, b"smooth") {
    return Option<CommandKind>.some(CommandKind.Smooth)
  }
  if cursor.ident(input, b"arc") {
    return Option<CommandKind>.some(CommandKind.Arc)
  }
  if cursor.ident(input, b"close") {
    return Option<CommandKind>.some(CommandKind.Close)
  }
  return Option<CommandKind>.None
}

effect fn shapeCommand(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<ShapeCommand>
  ! OutOfMemoryError
  ? &mut Allocator {
  let kind = match commandKind(input, &mut cursor.*) {
    Option<CommandKind>.Some { value } => value
    _ => {
      return Option<ShapeCommand>.None
    }
  }
  let mut result = ShapeCommand {
    kind: kind,
    relative: false,
    end: run defaultPosition(&mut store.*, false),
    control1: Option<ControlPoint>.None,
    control2: Option<ControlPoint>.None,
    radii: Option<Point>.None,
    singleRadius: false,
    clockwise: false,
    large: false,
    rotation: Option<ExprId>.None,
  }
  if kind == CommandKind.Close {
    return Option<ShapeCommand>.some(result)
  }
  if cursor.ident(input, b"by") {
    result.relative = true
  } else if !cursor.ident(input, b"to") {
    return Option<ShapeCommand>.None
  }
  if kind == CommandKind.HLine || kind == CommandKind.VLine {
    let horizontal = kind == CommandKind.HLine
    let mut axis = result.end.x
    if !result.relative && cursor.ident(input, b"center") {
      axis.edge = Edge.Center
    } else if !result.relative
      && ((horizontal && (cursor.ident(input, b"left") || cursor.ident(input, b"x-start")))
        || (!horizontal && (cursor.ident(input, b"top") || cursor.ident(input, b"y-start")))) {
      axis.edge = Edge.Start
    } else if !result.relative
      && ((horizontal && (cursor.ident(input, b"right") || cursor.ident(input, b"x-end")))
        || (!horizontal && (cursor.ident(input, b"bottom") || cursor.ident(input, b"y-end")))) {
      axis.edge = Edge.End
    } else {
      axis.offset = match run numeric(
        &mut store.*,
        input,
        &mut cursor.*,
        Dimension.LengthPercentage,
        false,
        presentation,
      ) {
        Option<ExprId>.Some { value } => value
        _ => {
          return Option<ShapeCommand>.None
        }
      }
    }
    if horizontal {
      result.end.x = axis
    } else {
      result.end.y = axis
    }
  } else {
    result.end = match run endpoint(
      &mut store.*,
      input,
      &mut cursor.*,
      result.relative,
      presentation,
    ) {
      Option<Position>.Some { value } => value
      _ => {
        return Option<ShapeCommand>.None
      }
    }
  }
  if kind == CommandKind.Curve || kind == CommandKind.Smooth {
    if cursor.ident(input, b"with") {
      result.control1 = run controlPoint(
        &mut store.*,
        input,
        &mut cursor.*,
        result.relative,
        presentation,
      )
      match &result.control1 {
        Option<ControlPoint>.None => {
          return Option<ShapeCommand>.None
        }
        _ => {}
      }
      if kind == CommandKind.Curve && cursor.delim(input, 47) {
        result.control2 = run controlPoint(
          &mut store.*,
          input,
          &mut cursor.*,
          result.relative,
          presentation,
        )
        match &result.control2 {
          Option<ControlPoint>.None => {
            return Option<ShapeCommand>.None
          }
          _ => {}
        }
      }
    } else if kind == CommandKind.Curve {
      return Option<ShapeCommand>.None
    }
  }
  if kind == CommandKind.Arc {
    let mut radiusSeen = false
    let mut sweepSeen = false
    let mut sizeSeen = false
    let mut rotationSeen = false
    while true {
      if !radiusSeen && cursor.ident(input, b"of") {
        let x = match run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.LengthPercentage,
          false,
          presentation,
        ) {
          Option<ExprId>.Some { value } => value
          _ => {
            return Option<ShapeCommand>.None
          }
        }
        let y = match run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.LengthPercentage,
          false,
          presentation,
        ) {
          Option<ExprId>.Some { value } => value
          _ => {
            result.singleRadius = true
            x
          }
        }
        result.radii = Option<Point>.some(Point { x: x, y: y })
        radiusSeen = true
        continue
      }
      if !sweepSeen && cursor.ident(input, b"cw") {
        result.clockwise = true
        sweepSeen = true
        continue
      }
      if !sweepSeen && cursor.ident(input, b"ccw") {
        result.clockwise = false
        sweepSeen = true
        continue
      }
      if !sizeSeen && cursor.ident(input, b"large") {
        result.large = true
        sizeSeen = true
        continue
      }
      if !sizeSeen && cursor.ident(input, b"small") {
        result.large = false
        sizeSeen = true
        continue
      }
      if !rotationSeen && cursor.ident(input, b"rotate") {
        result.rotation = run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.Angle,
          false,
          false,
        )
        match &result.rotation {
          Option<ExprId>.None => {
            return Option<ShapeCommand>.None
          }
          _ => {}
        }
        rotationSeen = true
        continue
      }
      break
    }
    if !radiusSeen {
      return Option<ShapeCommand>.None
    }
  }
  return Option<ShapeCommand>.some(result)
}

effect fn shapeInner(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<Shape>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rectangle = Option<RectangleKind>.None
  if cursor.function(input, b"inset") {
    rectangle = Option<RectangleKind>.some(RectangleKind.Inset)
  } else if cursor.function(input, b"rect") {
    rectangle = Option<RectangleKind>.some(RectangleKind.Rect)
  } else if cursor.function(input, b"xywh") {
    rectangle = Option<RectangleKind>.some(RectangleKind.Xywh)
  }
  match &rectangle {
    Option<RectangleKind>.Some { value: kind } => {
      let mut edges = [Option<ExprId>.None; 4]
      if kind == RectangleKind.Inset {
        let quad = match run lengthQuad(&mut store.*, input, &mut cursor.*, false, presentation) {
          Option<[ExprId; 4]>.Some { value } => value
          _ => {
            return Option<Shape>.None
          }
        }
        let mut i: usize = 0
        while i < 4 {
          edges[i] = Option<ExprId>.some(quad[i])
          i = i + 1
        }
      } else {
        let mut i: usize = 0
        while i < 4 {
          if kind == RectangleKind.Rect && cursor.ident(input, b"auto") {} else {
            edges[i] = run numeric(
              &mut store.*,
              input,
              &mut cursor.*,
              Dimension.LengthPercentage,
              kind == RectangleKind.Xywh && i >= 2,
              presentation,
            )
            match &edges[i] {
              Option<ExprId>.None => {
                return Option<Shape>.None
              }
              _ => {}
            }
          }
          i = i + 1
        }
      }
      let rounding = match run corners(&mut store.*, input, &mut cursor.*, presentation) {
        Option<Corners>.Some { value } => value
        _ => {
          return Option<Shape>.None
        }
      }
      if !cursor.close(input) {
        return Option<Shape>.None
      }
      return Option<Shape>.some(Shape.Rectangle { kind: kind, edges: edges, corners: rounding })
    }
    _ => {}
  }
  let mut radial = false
  let mut circle = false
  if cursor.function(input, b"circle") {
    radial = true
    circle = true
  } else if cursor.function(input, b"ellipse") {
    radial = true
  }
  if radial {
    let size = match run radialSize(&mut store.*, input, &mut cursor.*, presentation) {
      Option<RadialSize>.Some { value } => value
      _ => RadialSize.Extent { extent: Extent.ClosestSide }
    }
    if !validRadial(&size, circle, false, &store.*) {
      return Option<Shape>.None
    }
    let position = if cursor.ident(input, b"at") {
      match run transform_values.parsePosition(&mut store.*, input, &mut cursor.*, presentation) {
        Option<Position>.Some { value } => value
        _ => {
          return Option<Shape>.None
        }
      }
    } else {
      run defaultPosition(&mut store.*, true)
    }
    if !cursor.close(input) {
      return Option<Shape>.None
    }
    return Option<Shape>.some(Shape.Ellipse { circle: circle, size: size, position: position })
  }
  if cursor.function(input, b"polygon") {
    let mut evenodd = false
    let mut header = false
    if cursor.ident(input, b"evenodd") {
      evenodd = true
      header = true
    } else if cursor.ident(input, b"nonzero") {
      header = true
    }
    let mut round = Option<ExprId>.None
    if cursor.ident(input, b"round") {
      header = true
      round = run numeric(&mut store.*, input, &mut cursor.*, Dimension.Length, true, presentation)
      match &round {
        Option<ExprId>.None => {
          return Option<Shape>.None
        }
        _ => {}
      }
    }
    if header && !cursor.comma(input) {
      return Option<Shape>.None
    }
    let mut points = List<Point>.make()
    while true {
      let next = match run point(&mut store.*, input, &mut cursor.*, presentation) {
        Option<Point>.Some { value } => value
        _ => {
          return Option<Shape>.None
        }
      }
      run points.append(next)
      if !cursor.comma(input) {
        break
      }
    }
    if !cursor.close(input) {
      return Option<Shape>.None
    }
    return Option<Shape>.some(Shape.Polygon { evenodd: evenodd, round: round, points: move points })
  }
  if cursor.function(input, b"path") {
    let mut evenodd = false
    let mut rule = false
    if cursor.ident(input, b"evenodd") {
      evenodd = true
      rule = true
    } else if cursor.ident(input, b"nonzero") {
      rule = true
    }
    if rule && !cursor.comma(input) {
      return Option<Shape>.None
    }
    cursor.skip(input)
    if cursor.position >= cursor.end {
      return Option<Shape>.None
    }
    match &input.at(cursor.position) {
      Option<TokenView>.Some { value: view } => match &view.token.kind {
        Kind.String { text } => {
          let parsed = run svg.parsePath(view.text(text))
          if !parsed.complete {
            return Option<Shape>.None
          }
          cursor.position = cursor.position + 1
          if !cursor.close(input) {
            return Option<Shape>.None
          }
          return Option<Shape>.some(Shape.Path { evenodd: evenodd, path: move parsed.path })
        }
        _ => {}
      }
      _ => {}
    }
    return Option<Shape>.None
  }
  if cursor.function(input, b"shape") {
    let mut evenodd = false
    if cursor.ident(input, b"evenodd") {
      evenodd = true
    } else {
      let nonzero = cursor.ident(input, b"nonzero")
    }
    if !cursor.ident(input, b"from") {
      return Option<Shape>.None
    }
    let start = match run transform_values.parsePosition(
      &mut store.*,
      input,
      &mut cursor.*,
      presentation,
    ) {
      Option<Position>.Some { value } => value
      _ => {
        return Option<Shape>.None
      }
    }
    if !cursor.comma(input) {
      return Option<Shape>.None
    }
    let mut commands = List<ShapeCommand>.make()
    while true {
      let command = match run shapeCommand(&mut store.*, input, &mut cursor.*, presentation) {
        Option<ShapeCommand>.Some { value } => value
        _ => {
          return Option<Shape>.None
        }
      }
      run commands.append(command)
      if !cursor.comma(input) {
        break
      }
    }
    if !cursor.close(input) {
      return Option<Shape>.None
    }
    return Option<Shape>.some(
      Shape.Commands { evenodd: evenodd, start: start, commands: move commands },
    )
  }
  return Option<Shape>.None
}

pub effect fn parseShape(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<Shape>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut trial = cursor.*
  let result = run shapeInner(&mut store.*, input, &mut trial, presentation)
  match &result {
    Option<Shape>.Some { value } => {
      cursor.position = trial.position
    }
    _ => {}
  }
  return move result
}

effect fn clipSource(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  boxes: bool,
  presentation: bool,
) -> Option<ClipSource>
  ! OutOfMemoryError
  ? &mut Allocator {
  let resource = run parseUrl(input, &mut cursor.*)
  match move resource {
    Option<Bytes>.Some { value } => {
      return Option<ClipSource>.some(ClipSource.Url { url: move value })
    }
    _ => {}
  }
  let mut reference = GeometryBox.Border
  let mut hasBox = false
  if boxes {
    match geometryBox(input, &mut cursor.*, false) {
      Option<GeometryBox>.Some { value } => {
        reference = value
        hasBox = true
      }
      _ => {}
    }
  }
  let shape = run parseShape(&mut store.*, input, &mut cursor.*, presentation)
  match move shape {
    Option<Shape>.Some { value } => {
      if boxes && !hasBox {
        match geometryBox(input, &mut cursor.*, false) {
          Option<GeometryBox>.Some { value: parsedBox } => {
            reference = parsedBox
          }
          _ => {}
        }
      }
      return Option<ClipSource>.some(ClipSource.Shape { shape: move value, reference: reference })
    }
    _ => {}
  }
  if hasBox {
    return Option<ClipSource>.some(ClipSource.Box { reference: reference })
  }
  return Option<ClipSource>.None
}

effect fn parseInner(
  store: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<EffectValue>
  ! OutOfMemoryError
  ? &mut Allocator {
  if property == Property.Filter {
    if cursor.ident(input, b"none") {
      return Option<EffectValue>.some(EffectValue.None)
    }
    let mut items = List<Filter>.make()
    while true {
      let start = cursor.position
      let parsed = run filterItem(&mut store.*, input, &mut cursor.*, presentation)
      match move parsed {
        Option<Filter>.Some { value } => {
          run items.append(move value)
        }
        _ => {
          if cursor.position != start {
            return Option<EffectValue>.None
          }
          break
        }
      }
    }
    if items.length() == 0 {
      return Option<EffectValue>.None
    }
    return Option<EffectValue>.some(EffectValue.Filters { items: move items })
  }
  if property == Property.ClipPath {
    if cursor.ident(input, b"none") {
      return Option<EffectValue>.some(EffectValue.None)
    }
    let source = match run clipSource(&mut store.*, input, &mut cursor.*, true, presentation) {
      Option<ClipSource>.Some { value } => move value
      _ => {
        return Option<EffectValue>.None
      }
    }
    return Option<EffectValue>.some(EffectValue.ClipPath { source: move source })
  }
  if property == Property.ShapeInside || property == Property.ShapeSubtract {
    if cursor.ident(
      input,
      if property == Property.ShapeInside {
        b"auto"
      } else {
        b"none"
      },
    ) {
      return Option<EffectValue>.some(EffectValue.None)
    }
    let mut sources = List<ClipSource>.make()
    while true {
      let parsed = run clipSource(&mut store.*, input, &mut cursor.*, false, presentation)
      match move parsed {
        Option<ClipSource>.Some { value } => {
          run sources.append(move value)
        }
        _ => {
          break
        }
      }
    }
    if sources.length() == 0 {
      return Option<EffectValue>.None
    }
    return Option<EffectValue>.some(EffectValue.Shapes { sources: move sources })
  }
  if property == Property.Clip {
    if cursor.ident(input, b"auto") {
      return Option<EffectValue>.some(EffectValue.None)
    }
    if !cursor.function(input, b"rect") {
      return Option<EffectValue>.None
    }
    let mut edges = [Option<ExprId>.None; 4]
    let mut commas = false
    let mut i: usize = 0
    while i < 4 {
      if i > 0 {
        let comma = cursor.comma(input)
        if i == 1 {
          commas = comma
        } else if comma != commas {
          return Option<EffectValue>.None
        }
      }
      if !cursor.ident(input, b"auto") {
        edges[i] = run numeric(
          &mut store.*,
          input,
          &mut cursor.*,
          Dimension.Length,
          false,
          presentation,
        )
        match &edges[i] {
          Option<ExprId>.None => {
            return Option<EffectValue>.None
          }
          _ => {}
        }
      }
      i = i + 1
    }
    if !cursor.close(input) {
      return Option<EffectValue>.None
    }
    return Option<EffectValue>.some(EffectValue.Clip { edges: edges })
  }
  if property == Property.EnableBackground {
    if cursor.ident(input, b"accumulate") {
      return Option<EffectValue>.some(
        EffectValue.Background { fresh: false, region: Option<[ExprId; 4]>.None },
      )
    }
    if !cursor.ident(input, b"new") {
      return Option<EffectValue>.None
    }
    let first = run numeric(&mut store.*, input, &mut cursor.*, Dimension.Number, false, false)
    let mut region = Option<[ExprId; 4]>.None
    match &first {
      Option<ExprId>.Some { value } => {
        let mut bounds = [value; 4]
        let mut i: usize = 1
        while i < 4 {
          bounds[i] = match run numeric(
            &mut store.*,
            input,
            &mut cursor.*,
            Dimension.Number,
            i >= 2,
            false,
          ) {
            Option<ExprId>.Some { value: next } => next
            _ => {
              return Option<EffectValue>.None
            }
          }
          i = i + 1
        }
        region = Option<[ExprId; 4]>.some(bounds)
      }
      _ => {}
    }
    return Option<EffectValue>.some(EffectValue.Background { fresh: true, region: region })
  }
  if property == Property.MaskBorder || property == Property.MaskBorderSource
    || property == Property.MaskBorderSlice
    || property == Property.MaskBorderWidth
    || property == Property.MaskBorderOutset
    || property == Property.MaskBorderRepeat {
    let border = match run borderValue(&mut store.*, property, input, &mut cursor.*) {
      Option<Border>.Some { value } => move value
      _ => {
        return Option<EffectValue>.None
      }
    }
    return Option<EffectValue>.some(EffectValue.MaskBorder { border: move border })
  }
  if property == Property.Mask || property == Property.MaskImage || property == Property.MaskMode
    || property == Property.MaskRepeat
    || property == Property.MaskPosition
    || property == Property.MaskClip
    || property == Property.MaskOrigin
    || property == Property.MaskSize
    || property == Property.MaskComposite {
    let mut layers = List<MaskLayer>.make()
    while true {
      let layer = match run maskLayer(&mut store.*, property, input, &mut cursor.*) {
        Option<MaskLayer>.Some { value } => move value
        _ => {
          return Option<EffectValue>.None
        }
      }
      run layers.append(move layer)
      if !cursor.comma(input) {
        break
      }
    }
    return Option<EffectValue>.some(
      EffectValue.Masks { layers: move layers, resetBorder: run initialBorder(&mut store.*) },
    )
  }
  return Option<EffectValue>.None
}

/// Parses only this property's grammar. The caller checks the remaining input.
/// Failure never commits a partially consumed cursor.
pub effect fn parse(
  numerics: &mut dimensions.Store,
  property: Property,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<EffectValue>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut trial = cursor.*
  let result = run parseInner(&mut numerics.*, property, input, &mut trial, presentation)
  match &result {
    Option<EffectValue>.Some { value } => {
      cursor.position = trial.position
    }
    _ => {}
  }
  return move result
}

effect fn computeOptional(
  value: Option<ExprId>,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value {
    Option<ExprId>.Some { value: id } => Option<ExprId>.some(
      run dimensions.compute(&mut store.*, id, context),
    )
    _ => Option<ExprId>.None
  }
}

effect fn computeQuad(
  value: &[ExprId; 4],
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> [ExprId; 4]
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = value.*
  let mut i: usize = 0
  while i < 4 {
    result[i] = run dimensions.compute(&mut store.*, value[i], context)
    i = i + 1
  }
  return result
}

effect fn computeEdges(
  value: &[Option<ExprId>; 4],
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> [Option<ExprId>; 4]
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = value.*
  let mut i: usize = 0
  while i < 4 {
    result[i] = run computeOptional(value[i], &mut store.*, context)
    i = i + 1
  }
  return result
}

effect fn computeRadial(
  value: &RadialSize,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> RadialSize
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    RadialSize.Extent { extent } => RadialSize.Extent { extent: extent }
    RadialSize.Radii { x, y } => RadialSize.Radii {
      x: run computeNonnegative(x, &mut store.*, context),
      y: run computeNonnegativeOptional(y, &mut store.*, context),
    }
  }
}

effect fn computeStops(
  values: &List<GradientStop>,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> List<GradientStop>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<GradientStop>.make()
  run result.reserve(values.length())
  let mut i: usize = 0
  while i < values.length() {
    let stop = match &values.asSlice()[i] {
      GradientStop.ColorStop { color, position } => GradientStop.ColorStop {
        color: colors.compute(color, colorContext),
        position: run computeOptional(position, &mut store.*, context),
      }
      GradientStop.Hint { position } => GradientStop.Hint {
        position: run dimensions.compute(&mut store.*, position, context),
      }
    }
    run result.append(stop)
    i = i + 1
  }
  return move result
}

pub effect fn computeImage(
  value: &Image,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> Image
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Image.None => Image.None
    Image.Url { url } => Image.Url { url: run copyBytes(url.asSlice()) }
    Image.Linear { repeating, direction, stops: list } => {
      let computedDirection = match &direction {
        Direction.Angle { angle } => Direction.Angle {
          angle: run dimensions.compute(&mut store.*, angle, context),
        }
        Direction.Corner { x, y } => Direction.Corner { x: x, y: y }
      }
      return Image.Linear {
        repeating: repeating,
        direction: computedDirection,
        stops: run computeStops(&list, &mut store.*, context, colorContext),
      }
    }
    Image.Radial { repeating, circle, size, position, stops: list } => Image.Radial {
      repeating: repeating,
      circle: circle,
      size: run computeRadial(&size, &mut store.*, context),
      position: run transform_values.computePosition(&position, &mut store.*, context),
      stops: run computeStops(&list, &mut store.*, context, colorContext),
    }
  }
}

effect fn computeControl(
  value: Option<ControlPoint>,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> Option<ControlPoint>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value {
    Option<ControlPoint>.Some { value: control } => Option<ControlPoint>.some(
      ControlPoint {
        position: run transform_values.computePosition(&control.position, &mut store.*, context),
        origin: control.origin,
      },
    )
    _ => Option<ControlPoint>.None
  }
}

pub effect fn computeShape(
  value: &Shape,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> Shape
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Shape.Rectangle { kind, edges, corners: rounding } => {
      let mut computedEdges = run computeEdges(&edges, &mut store.*, context)
      if kind == RectangleKind.Xywh {
        let mut i: usize = 2
        while i < 4 {
          match &computedEdges[i] {
            Option<ExprId>.Some { value: id } => {
              computedEdges[i] = Option<ExprId>.some(run dimensions.nonnegative(&mut store.*, id))
            }
            _ => {}
          }
          i = i + 1
        }
      }
      return Shape.Rectangle {
        kind: kind,
        edges: computedEdges,
        corners: Corners {
          x: run computeNonnegativeQuad(&rounding.x, &mut store.*, context),
          y: run computeNonnegativeQuad(&rounding.y, &mut store.*, context),
        },
      }
    }
    Shape.Ellipse { circle, size, position } => Shape.Ellipse {
      circle: circle,
      size: run computeRadial(&size, &mut store.*, context),
      position: run transform_values.computePosition(&position, &mut store.*, context),
    }
    Shape.Polygon { evenodd, round, points } => {
      let mut result = List<Point>.make()
      run result.reserve(points.length())
      let mut i: usize = 0
      while i < points.length() {
        let p = points.asSlice()[i]
        run result.append(
          Point {
            x: run dimensions.compute(&mut store.*, p.x, context),
            y: run dimensions.compute(&mut store.*, p.y, context),
          },
        )
        i = i + 1
      }
      return Shape.Polygon {
        evenodd: evenodd,
        round: run computeNonnegativeOptional(round, &mut store.*, context),
        points: move result,
      }
    }
    Shape.Path { evenodd, path } => {
      let mut result = Path.make()
      run result.reserve(path.length())
      let mut i: usize = 0
      while i < path.length() {
        let appended = run result.append(path.segments()[i])
        i = i + 1
      }
      return Shape.Path { evenodd: evenodd, path: move result }
    }
    Shape.Commands { evenodd, start, commands } => {
      let mut result = List<ShapeCommand>.make()
      run result.reserve(commands.length())
      let mut i: usize = 0
      while i < commands.length() {
        let original = commands.asSlice()[i]
        let mut command = original
        command.end = run transform_values.computePosition(&original.end, &mut store.*, context)
        command.control1 = run computeControl(original.control1, &mut store.*, context)
        command.control2 = run computeControl(original.control2, &mut store.*, context)
        command.rotation = run computeOptional(original.rotation, &mut store.*, context)
        command.radii = match &original.radii {
          Option<Point>.Some { value: p } => Option<Point>.some(
            Point {
              x: run dimensions.compute(&mut store.*, p.x, context),
              y: run dimensions.compute(&mut store.*, p.y, context),
            },
          )
          _ => Option<Point>.None
        }
        run result.append(command)
        i = i + 1
      }
      return Shape.Commands {
        evenodd: evenodd,
        start: run transform_values.computePosition(&start, &mut store.*, context),
        commands: move result,
      }
    }
  }
}

effect fn computeSource(
  value: &ClipSource,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> ClipSource
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    ClipSource.Url { url } => ClipSource.Url { url: run copyBytes(url.asSlice()) }
    ClipSource.Box { reference } => ClipSource.Box { reference: reference }
    ClipSource.Shape { shape, reference } => ClipSource.Shape {
      shape: run computeShape(&shape, &mut store.*, context),
      reference: reference,
    }
  }
}

effect fn computeSize(
  value: &Size,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> Size
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Size.Cover => Size.Cover
    Size.Contain => Size.Contain
    Size.Explicit { x, y } => Size.Explicit {
      x: run computeNonnegativeOptional(x, &mut store.*, context),
      y: run computeNonnegativeOptional(y, &mut store.*, context),
    }
  }
}

effect fn computeFilter(
  value: &Filter,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> Filter
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    Filter.Url { url } => Filter.Url { url: run copyBytes(url.asSlice()) }
    Filter.DropShadow { x, y, blur, color } => {
      let computedBlur = run dimensions.compute(&mut store.*, blur, context)
      let nonnegativeBlur = if dimensions.evaluate(&store.*, computedBlur, 0.0) < 0.0 {
        run zero(&mut store.*)
      } else {
        computedBlur
      }
      return Filter.DropShadow {
        x: run dimensions.compute(&mut store.*, x, context),
        y: run dimensions.compute(&mut store.*, y, context),
        blur: nonnegativeBlur,
        color: colors.compute(color, colorContext),
      }
    }
    Filter.Function { kind, amount } => {
      let computed = run dimensions.compute(&mut store.*, amount, context)
      if kind == FilterKind.HueRotate {
        return Filter.Function { kind: kind, amount: computed }
      }
      let raw = dimensions.evaluate(&store.*, computed, 1.0)
      let maximum = kind == FilterKind.Grayscale || kind == FilterKind.Invert
        || kind == FilterKind.Opacity
        || kind == FilterKind.Sepia
      let clamped = if raw < 0.0 {
        0.0
      } else if maximum && raw > 1.0 {
        1.0
      } else {
        raw
      }
      let result = if kind == FilterKind.Blur {
        if raw < 0.0 {
          run zero(&mut store.*)
        } else {
          computed
        }
      } else if clamped == raw && !dimensions.containsPercentage(&store.*, computed) {
        computed
      } else {
        run dimensions.literal(&mut store.*, clamped, Unit.Number)
      }
      return Filter.Function { kind: kind, amount: result }
    }
  }
}

/// Resolves font/viewport units and colors while preserving reference-box
/// percentages. Nonnegative ranges are represented by numeric max expressions,
/// so clamping observes the host's eventual percentage basis.
pub effect fn compute(
  value: &EffectValue,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> EffectValue
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value.* {
    EffectValue.None => EffectValue.None
    EffectValue.Filters { items } => {
      let mut result = List<Filter>.make()
      run result.reserve(items.length())
      let mut i: usize = 0
      while i < items.length() {
        run result.append(
          run computeFilter(&items.asSlice()[i], &mut numerics.*, context, colorContext),
        )
        i = i + 1
      }
      return EffectValue.Filters { items: move result }
    }
    EffectValue.Masks { layers, resetBorder } => {
      let mut result = List<MaskLayer>.make()
      run result.reserve(layers.length())
      let mut i: usize = 0
      while i < layers.length() {
        let layer = &layers.asSlice()[i]
        run result.append(
          MaskLayer {
            image: run computeImage(&layer.image, &mut numerics.*, context, colorContext),
            mode: layer.mode,
            position: run transform_values.computePosition(
              &layer.position,
              &mut numerics.*,
              context,
            ),
            size: run computeSize(&layer.size, &mut numerics.*, context),
            repeat: layer.repeat,
            origin: layer.origin,
            clip: layer.clip,
            composite: layer.composite,
          },
        )
        i = i + 1
      }
      return EffectValue.Masks {
        layers: move result,
        resetBorder: run computeBorder(&resetBorder, &mut numerics.*, context, colorContext),
      }
    }
    EffectValue.MaskBorder { border } => EffectValue.MaskBorder {
      border: run computeBorder(&border, &mut numerics.*, context, colorContext),
    }
    EffectValue.ClipPath { source } => EffectValue.ClipPath {
      source: run computeSource(&source, &mut numerics.*, context),
    }
    EffectValue.Shapes { sources } => {
      let mut result = List<ClipSource>.make()
      run result.reserve(sources.length())
      let mut i: usize = 0
      while i < sources.length() {
        run result.append(run computeSource(&sources.asSlice()[i], &mut numerics.*, context))
        i = i + 1
      }
      return EffectValue.Shapes { sources: move result }
    }
    EffectValue.Clip { edges } => EffectValue.Clip {
      edges: run computeEdges(&edges, &mut numerics.*, context),
    }
    EffectValue.Background { fresh, region } => EffectValue.Background {
      fresh: fresh,
      region: match &region {
        Option<[ExprId; 4]>.Some { value: bounds } => {
          let mut computedBounds = run computeQuad(&bounds, &mut numerics.*, context)
          computedBounds[2] = run dimensions.nonnegative(&mut numerics.*, computedBounds[2])
          computedBounds[3] = run dimensions.nonnegative(&mut numerics.*, computedBounds[3])
          Option<[ExprId; 4]>.some(computedBounds)
        }
        _ => Option<[ExprId; 4]>.None
      },
    }
  }
}

effect fn computeBorder(
  border: &Border,
  numerics: &mut dimensions.Store,
  context: &dimensions.Context,
  colorContext: &colors.Context,
) -> Border
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut width = border.width
  let mut i: usize = 0
  while i < 4 {
    width[i] = match &border.width[i] {
      BorderMeasure.Auto => BorderMeasure.Auto
      BorderMeasure.Numeric { value: id } => BorderMeasure.Numeric {
        value: run computeNonnegative(id, &mut numerics.*, context),
      }
    }
    i = i + 1
  }
  return Border {
    image: run computeImage(&border.image, &mut numerics.*, context, colorContext),
    mode: border.mode,
    slice: run computeNonnegativeQuad(&border.slice, &mut numerics.*, context),
    fill: border.fill,
    width: width,
    outset: run computeNonnegativeQuad(&border.outset, &mut numerics.*, context),
    repeat: border.repeat,
  }
}

/// Only grammars explicitly allowing unitless zero call this helper.
/// An angle, or a unitless zero; `presentation` admits any unitless number as degrees.
effect fn angleWithZero(
  store: &mut dimensions.Store,
  input: &Input,
  cursor: &mut Cursor,
  presentation: bool,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let angle = run numeric(&mut store.*, input, &mut cursor.*, Dimension.Angle, false, false)
  match &angle {
    Option<ExprId>.Some { value } => {
      return angle
    }
    _ => {}
  }
  let mut trial = cursor.*
  trial.skip(input)
  if trial.position >= trial.end {
    return Option<ExprId>.None
  }
  match &input.at(trial.position) {
    Option<TokenView>.Some { value: view } => match &view.token.kind {
      Kind.Number { value, integer } => {
        if value == 0.0 || presentation {
          cursor.position = trial.position + 1
          return Option<ExprId>.some(run dimensions.literal(&mut store.*, value, Unit.Deg))
        }
      }
      _ => {}
    }
    _ => {}
  }
  return Option<ExprId>.None
}

effect fn computeNonnegative(
  id: ExprId,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  let computed = run dimensions.compute(&mut store.*, id, context)
  return run dimensions.nonnegative(&mut store.*, computed)
}

effect fn computeNonnegativeOptional(
  value: Option<ExprId>,
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &value {
    Option<ExprId>.Some { value: id } => Option<ExprId>.some(
      run computeNonnegative(id, &mut store.*, context),
    )
    _ => Option<ExprId>.None
  }
}

effect fn computeNonnegativeQuad(
  value: &[ExprId; 4],
  store: &mut dimensions.Store,
  context: &dimensions.Context,
) -> [ExprId; 4]
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = value.*
  let mut i: usize = 0
  while i < 4 {
    result[i] = run computeNonnegative(value[i], &mut store.*, context)
    i = i + 1
  }
  return result
}
