//! CSSOM §6.2 live collections, stylesheet sets, and constructed-sheet adoption.
import cssom_document { Documents }
import cssom_stylesheet { StyleSheet, NO_HOST, NO_SHEET, NO_RULE }
import cssom_error { CssomError }
import tokens { equal }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn title(documents: &mut Documents, sheet: usize, name: &[u8], alternate: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run Bytes.copy(name)
  match move documents.sheetMut(sheet) {
    Option<&mut StyleSheet>.Some { value } => {
      value.title = move text
      value.alternate = alternate
    }
    _ => {}
  }
}

fn disabled(documents: &Documents, sheet: usize) -> bool {
  return match &documents.sheet(sheet) {
    Option<&StyleSheet>.Some { value } => value.disabled
    _ => false
  }
}

fn idAt(documents: &Documents, root: usize, index: usize) -> usize {
  return match &documents.finalStyleSheets(root).item(documents, index) {
    Option<usize>.Some { value } => value
    _ => NO_SHEET
  }
}

effect fn collections() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut documents = Documents.make()
  let document = run documents.createRoot(42)
  let shadow = run documents.createRoot(42)
  let foreign = run documents.createRoot(99)
  let associated = documents.styleSheets(document)
  let finalSheets = documents.finalStyleSheets(document)
  let authored = run documents.createSheet(false, 42)
  let constructed = run documents.createSheet(true, 42)
  run documents.addSheet(document, authored, 0)
  run documents.setAdoptedStyleSheets(document, &[constructed, constructed])
  run documents.setAdoptedSheet(shadow, 0, constructed)
  run Testing.expect(
    associated.length(&documents) == 1 && finalSheets.length(&documents) == 3,
    "previously obtained list identities observe later association and adoption",
  )
  run Testing.expect(
    idAt(&documents, document, 0) == authored && idAt(&documents, document, 1) == constructed
      && idAt(&documents, document, 2) == constructed,
    "final ordering is associated then adopted, preserving duplicates",
  )
  let wrongDocument = run Effect.result(documents.setAdoptedSheet(foreign, 0, constructed))
  run Testing.expect(
    match &wrongDocument {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NotAllowedError
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "constructed sheets cannot cross constructor documents",
  )
  let invalidReplacement = run Effect.result(
    documents.setAdoptedStyleSheets(document, &[constructed, authored]),
  )
  run Testing.expect(
    match &invalidReplacement {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NotAllowedError
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "nonconstructed sheet adoption is forbidden",
  )
  run Testing.expect(
    finalSheets.length(&documents) == 3,
    "failed array replacement leaves existing adoption unchanged",
  )
  run documents.removeAdoptedSheet(document, 0)
  run documents.removeSheet(document, authored)
  run Testing.expect(
    associated.length(&documents) == 0 && finalSheets.length(&documents) == 1
      && idAt(&documents, document, 0) == constructed,
    "live collections observe removals without destroying shared sheets",
  )
  run Testing.expect(
    documents.adoptedStyleSheets(shadow).length(&documents) == 1,
    "removing an adoption does not mutate another shadow root",
  )
  run Testing.expect(
    match &finalSheets.item(&documents, 1) {
      Option<usize>.None => true
      _ => false
    },
    "out-of-range stylesheet item is null",
  )
}

test effect fn liveCollectionsAndSameDocumentAdoption() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run collections() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sets() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut documents = Documents.make()
  let root = run documents.createRoot(1)
  let alternate = run documents.createSheet(false, 1)
  let regular = run documents.createSheet(false, 1)
  let persistent = run documents.createSheet(false, 1)
  run title(&mut documents, alternate, b"night", true)
  run title(&mut documents, regular, b"day", false)
  run documents.addSheet(root, alternate, 0)
  run Testing.expect(
    disabled(&documents, alternate) && equal(documents.preferredSet(root), b""),
    "alternate sheet does not establish preferred set",
  )
  run documents.addSheet(root, regular, 1)
  run documents.addSheet(root, persistent, 2)
  run Testing.expect(
    equal(documents.preferredSet(root), b"day") && !disabled(&documents, regular)
      && disabled(&documents, alternate)
      && !disabled(&documents, persistent),
    "first nonalternate titled sheet establishes preferred set",
  )
  run documents.selectSet(root, b"night")
  run documents.changePreferredSet(root, b"day")
  run Testing.expect(
    !disabled(&documents, alternate) && disabled(&documents, regular),
    "explicit selected set is not overridden by later preferred metadata",
  )
  run documents.selectSet(root, b"")
  run Testing.expect(
    disabled(&documents, alternate) && disabled(&documents, regular)
      && !disabled(&documents, persistent),
    "empty selection disables titled sheets only",
  )
  match move documents.sheetMut(regular) {
    Option<&mut StyleSheet>.Some { value } => {
      value.ownerNode = 7
      value.ownerRule = 8
      value.parentStyleSheet = alternate
    }
    _ => {}
  }
  run Testing.expect(
    match &documents.associatedSheet(root, 7) {
      Option<usize>.Some { value } => value == regular
      _ => false
    },
    "LinkStyle finds a disabled sheet by owner identity",
  )
  run documents.removeSheet(root, regular)
  run Testing.expect(
    match &documents.sheet(regular) {
      Option<&StyleSheet>.Some { value } => value.ownerNode == NO_HOST
        && value.parentStyleSheet == NO_SHEET
        && value.ownerRule == NO_RULE
      _ => false
    },
    "removal detaches owner state but retains the stylesheet identity",
  )
}

test effect fn stylesheetSetsAndAssociationRemoval() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sets() |> Effect.provideMut<Allocator>(&mut allocator)
}
