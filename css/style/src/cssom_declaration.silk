//! Native ordered CSS declaration blocks (CSSOM sections 6.5–6.7).
import cssom_error { CssomError }
import cssom_serialization
import cssom_value_serialization
import cssom_shorthand
import cssom_specified
import colors { Color }
import colors
import value_cursor { Cursor }
import cssom_descriptors { Context }
import cssom_descriptors
import properties { Property, longhandCount, longhandAt }
import properties
import values { Store, Mode, ValueId }
import values
import declaration_values
import condition_cursor
import input { Input }
import lexer
import syntax
import tokens { TokenBuffer, TokenRange, Kind, Limits, CssError, CssErrorKind }
import tokens
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

struct Entry {
  property: Property,
  custom: bool,
  name: Bytes,
  value: Bytes,
  important: bool,
  pending: bool,
  variables: bool,
  source: Property,
}

// Typed OM custom-property strings are broader than parsed <custom-property-name>s.
fn customString(name: &[u8]) -> bool {
  return name.length >= 2 && name[0] == 45 && name[1] == 45
}

fn entryName(entry: &Entry) -> &[u8] {
  return if entry.custom {
    Bytes.asSlice(&entry.name)
  } else {
    properties.name(entry.property)
  }
}

fn covers(source: Property, target: Property) -> bool {
  let mut at: usize = 0
  while at < longhandCount(source) {
    if longhandAt(source, at) == target {
      return true
    }
    at = at + 1
  }
  return false
}

fn wide(text: &[u8]) -> bool {
  return tokens.equal(text, b"initial") || tokens.equal(text, b"inherit")
    || tokens.equal(text, b"unset")
    || tokens.equal(text, b"revert")
    || tokens.equal(text, b"revert-layer")
}

fn wideRange(buffer: &TokenBuffer, range: TokenRange) -> &'static [u8] {
  let input = Input.Contiguous { buffer: buffer, range: range }
  let at = condition_cursor.skip(&input, 0, input.length())
  if at >= input.length()
    || condition_cursor.skip(&input, at + 1, input.length()) != input.length() {
    return b""
  }
  if condition_cursor.ident(&input, at, b"initial") {
    return b"initial"
  }
  if condition_cursor.ident(&input, at, b"inherit") {
    return b"inherit"
  }
  if condition_cursor.ident(&input, at, b"unset") {
    return b"unset"
  }
  if condition_cursor.ident(&input, at, b"revert") {
    return b"revert"
  }
  if condition_cursor.ident(&input, at, b"revert-layer") {
    return b"revert-layer"
  }
  return b""
}

fn space(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13
}

fn original(buffer: &TokenBuffer, range: TokenRange) -> &[u8] {
  let ts = buffer.tokens.asSlice()
  let mut before = range.start
  while before > 0
    && match &ts[before - 1].kind {
      Kind.Whitespace => true
      _ => false
    } {
    before = before - 1
  }
  let mut start = if before == 0 {
    0
  } else {
    ts[before - 1].source.end
  }
  let mut after = range.end
  while after < buffer.all().end
    && match &ts[after].kind {
      Kind.Whitespace => true
      _ => false
    } {
    after = after + 1
  }
  let mut end = if after == buffer.all().end {
    buffer.sourceLength
  } else {
    ts[after].source.start
  }
  let source = buffer.source()
  while start < end && space(source[start]) {
    start = start + 1
  }
  while end > start && space(source[end - 1]) {
    end = end - 1
  }
  return Slice.view<u8>(source, start, end - start)
}

fn pendingText(buffer: &TokenBuffer, range: TokenRange) -> &[u8] {
  let ts = buffer.tokens.asSlice()
  let mut first = range.start
  let mut last = range.end
  while first < last
    && match &ts[first].kind {
      Kind.Whitespace => true
      _ => false
    } {
    first = first + 1
  }
  while last > first
    && match &ts[last - 1].kind {
      Kind.Whitespace => true
      _ => false
    } {
    last = last - 1
  }
  if first == last {
    return b""
  }
  let start = ts[first].source.start
  let end = ts[last - 1].source.end
  return Slice.view<u8>(buffer.source(), start, end - start)
}

fn systemFont(buffer: &TokenBuffer, range: TokenRange) -> &'static [u8] {
  let input = Input.Contiguous { buffer: buffer, range: range }
  let at = condition_cursor.skip(&input, 0, input.length())
  if at >= input.length()
    || condition_cursor.skip(&input, at + 1, input.length()) != input.length() {
    return b""
  }
  if condition_cursor.ident(&input, at, b"caption") {
    return b"caption"
  }
  if condition_cursor.ident(&input, at, b"icon") {
    return b"icon"
  }
  if condition_cursor.ident(&input, at, b"menu") {
    return b"menu"
  }
  if condition_cursor.ident(&input, at, b"message-box") {
    return b"message-box"
  }
  if condition_cursor.ident(&input, at, b"small-caption") {
    return b"small-caption"
  }
  if condition_cursor.ident(&input, at, b"status-bar") {
    return b"status-bar"
  }
  return b""
}

fn colorProperty(property: Property) -> bool {
  return property == Property.Color || property == Property.Fill || property == Property.Stroke
    || property == Property.FloodColor
    || property == Property.LightingColor
    || property == Property.StopColor
    || property == Property.TextDecorationColor
    || property == Property.TextEmphasisColor
}

effect fn specified(
  store: &Store,
  id: ValueId,
  source: Property,
  target: Property,
  buffer: &TokenBuffer,
  range: TokenRange,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if colorProperty(target) {
    let mut at = range.start
    while at < range.end {
      let token = &buffer.tokens.asSlice()[at]
      if match &token.kind {
        Kind.Ident { text } => true
        _ => false
      } {
        let part = TokenRange { start: at, end: at + 1 }
        let input = Input.Contiguous { buffer: buffer, range: part }
        let mut cursor = Cursor.make(&input)
        match run colors.parse(&input, &mut cursor) {
          Option<Color>.Some { value } => {
            if source != target
              || (condition_cursor.skip(&input, cursor.position, input.length()) == input.length()
                && original(buffer, range).length == token.source.end - token.source.start) {
              return run cssom_specified.value(buffer, part)
            }
          }
          _ => {}
        }
      }
      at = if token.matching > at && token.matching < range.end {
        token.matching + 1
      } else {
        at + 1
      }
    }
  }
  if source == target
    && (target == Property.Transform || cssom_specified.hasFunction(buffer, range, b"clamp")
      || cssom_specified.hasFunction(buffer, range, b"color")
      || cssom_specified.hasFunction(buffer, range, b"path")) {
    return run cssom_specified.value(buffer, range)
  }
  return run cssom_value_serialization.value(store, id, source, target)
}

// Preparation owns all fallible parsing and allocation. Entries are reversed so the
// commit can pop them in canonical order without copying owned strings.
effect fn prepare(
  name: &[u8],
  buffer: &TokenBuffer,
  range: TokenRange,
  important: bool,
  limits: &Limits,
) -> List<Entry>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<Entry>.make()
  let custom = customString(name)
  let property = if custom {
    Property.Fill
  } else {
    match &properties.lookup(name) {
      Option<Property>.Some { value } => properties.canonical(value)
      _ => {
        return move out
      }
    }
  }
  let input = Input.Contiguous { buffer: buffer, range: range }
  let structure = run condition_cursor.inspect(&input, limits)
  let empty = condition_cursor.skip(&input, 0, input.length()) == input.length()
  let validation = declaration_values.validateRange(&input, &structure, 0, input.length())
  if !(custom && empty) && !validation.valid {
    return move out
  }
  if !custom && declaration_values.mixedTopLevelBlock(&input, &structure, 0, input.length()) {
    return move out
  }
  if custom {
    let source = original(buffer, range)
    let value = if source.length == 0 {
      run Bytes.copy(b" ")
    } else {
      run Bytes.copy(source)
    }
    run out.append(
      Entry {
        property: property,
        custom: true,
        name: run Bytes.copy(name),
        value: move value,
        important: important,
        pending: false,
        variables: false,
        source: property,
      },
    )
    return move out
  }
  let keyword = wideRange(buffer, range)
  let pending = validation.hasVariables
  let mut store = Store.make()
  let mut id = ValueId { index: 0 }
  if keyword.length == 0 && !pending {
    match &run values.parse(&mut store, property, &input, Mode.Css) {
      Option<ValueId>.Some { value } => {
        id = value
      }
      _ => {
        return move out
      }
    }
  }
  let count = longhandCount(property)
  let system = if property == Property.Font {
    systemFont(buffer, range)
  } else {
    b""
  }
  run out.reserve(count)
  let mut at = count
  let mut storage: usize = 0
  while at > 0 {
    at = at - 1
    let target = longhandAt(property, at)
    let value = if keyword.length != 0 {
      run Bytes.copy(keyword)
    } else if pending {
      run Bytes.copy(pendingText(buffer, range))
    } else if system.length != 0 {
      run Bytes.copy(system)
    } else {
      run specified(&store, id, property, target, buffer, range)
    }
    if value.length() > limits.maxStorageBytes
      || storage > limits.maxStorageBytes - value.length() {
      fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
    }
    storage = storage + value.length()
    run out.append(
      Entry {
        property: target,
        custom: false,
        name: Bytes.make(),
        value: move value,
        important: important,
        pending: (pending || system.length != 0) && count > 1,
        variables: pending,
        source: property,
      },
    )
  }
  return move out
}

pub struct StyleDeclaration {
  entries: List<Entry>,
  readonly: bool,
  context: Context,
  keyframe: bool,
  revision: usize,
  parentRuleId: usize,
}

impl StyleDeclaration {
  pub fn make() -> StyleDeclaration {
    return StyleDeclaration.makeFor(Context.Style)
  }

  pub fn makeFor(context: Context) -> StyleDeclaration {
    return StyleDeclaration {
      entries: List<Entry>.make(),
      readonly: false,
      context: context,
      keyframe: false,
      revision: 0,
      parentRuleId: usize.MAX,
    }
  }

  pub fn setReadOnly(self: &mut StyleDeclaration, readonly: bool) -> () {
    self.readonly = readonly
  }

  pub fn isReadOnly(self: &StyleDeclaration) -> bool {
    return self.readonly
  }

  pub fn mutationRevision(self: &StyleDeclaration) -> usize {
    return self.revision
  }

  pub fn parentRule(self: &StyleDeclaration) -> usize {
    return self.parentRuleId
  }

  pub fn setParentRule(self: &mut StyleDeclaration, id: usize) -> () {
    self.parentRuleId = id
  }

  pub fn computedFlag(self: &StyleDeclaration) -> bool {
    return false
  }

  fn changed(self: &mut StyleDeclaration) -> () {
    self.revision = if self.revision == usize.MAX {
      0
    } else {
      self.revision + 1
    }
  }

  fn unchanged(self: &StyleDeclaration, prior: usize, next: &Entry) -> bool {
    let old = &self.entries.asSlice()[prior]
    if old.important != next.important || old.pending != next.pending
      || old.variables != next.variables
      || (old.pending && old.source != next.source)
      || !tokens.equal(Bytes.asSlice(&old.value), Bytes.asSlice(&next.value)) {
      return false
    }
    let mut at = prior + 1
    while at < self.entries.length() {
      let other = &self.entries.asSlice()[at]
      if !old.custom && !other.custom {
        if (old.property == Property.InlineSize
          && (other.property == Property.Width || other.property == Property.Height))
          || (other.property == Property.InlineSize
            && (old.property == Property.Width || old.property == Property.Height)) {
          return false
        }
      }
      at = at + 1
    }
    return true
  }

  pub fn length(self: &StyleDeclaration) -> usize {
    return self.entries.length()
  }

  pub fn item(self: &StyleDeclaration, index: usize) -> &[u8] {
    return if index < self.entries.length() {
      entryName(&self.entries.asSlice()[index])
    } else {
      b""
    }
  }

  fn find(self: &StyleDeclaration, name: &[u8]) -> usize {
    let custom = customString(name)
    let mut at: usize = 0
    while at < self.entries.length() {
      let entry = &self.entries.asSlice()[at]
      if self.context != Context.Style {
        if tokens.insensitive(name, entryName(entry)) {
          return at
        }
      } else if custom && entry.custom && tokens.equal(name, entryName(entry)) {
        return at
      } else if !custom && !entry.custom {
        match &properties.lookup(name) {
          Option<Property>.Some { value } => {
            if properties.canonical(value) == entry.property {
              return at
            }
          }
          _ => {
            return self.entries.length()
          }
        }
      }
      at = at + 1
    }
    return self.entries.length()
  }

  fn propertyIndex(self: &StyleDeclaration, property: Property) -> usize {
    let mut at: usize = 0
    while at < self.entries.length() {
      let entry = &self.entries.asSlice()[at]
      if !entry.custom && entry.property == property {
        return at
      }
      at = at + 1
    }
    return at
  }

  fn text(self: &StyleDeclaration, property: Property) -> &[u8] {
    let at = self.propertyIndex(property)
    if at == self.entries.length() {
      return b""
    }
    return Bytes.asSlice(&self.entries.asSlice()[at].value)
  }

  pub effect fn parse(text: &[u8], limits: &Limits) -> StyleDeclaration
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    return run StyleDeclaration.parseFor(Context.Style, text, limits)
  }

  pub effect fn parseFor(context: Context, text: &[u8], limits: &Limits) -> StyleDeclaration
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    return run StyleDeclaration.parseMode(context, false, text, limits)
  }

  pub effect fn parseKeyframe(text: &[u8], limits: &Limits) -> StyleDeclaration
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    return run StyleDeclaration.parseMode(Context.Style, true, text, limits)
  }

  effect fn parseMode(
    context: Context,
    keyframe: bool,
    text: &[u8],
    limits: &Limits,
  ) -> StyleDeclaration
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let buffer = run lexer.tokenize(text, limits)
    let declarations = run syntax.parseDeclarations(&buffer, buffer.all(), limits)
    let mut out = StyleDeclaration.makeFor(context)
    out.keyframe = keyframe
    let mut at: usize = 0
    while at < declarations.length() {
      let declaration = declarations.asSlice()[at]
      let name = buffer.text(declaration.name)
      let prepared = run out.prepare(
        name,
        &buffer,
        declaration.value,
        declaration.important,
        limits,
      )
      run out.commit(move prepared, true, limits)
      at = at + 1
    }
    return move out
  }

  effect fn prepare(
    self: &StyleDeclaration,
    name: &[u8],
    buffer: &TokenBuffer,
    range: TokenRange,
    important: bool,
    limits: &Limits,
  ) -> List<Entry>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if important && (self.keyframe || self.context == Context.FontFace) {
      return List<Entry>.make()
    }
    if self.keyframe {
      match &properties.lookup(name) {
        Option<Property>.Some { value } => {
          if values.animationProperty(value) && value != Property.AnimationTimingFunction {
            return List<Entry>.make()
          }
        }
        _ => {}
      }
    }
    if self.context == Context.Style {
      return run prepare(name, buffer, range, important, limits)
    }
    let mut descriptors = run cssom_descriptors.parse(self.context, name, buffer, range, limits)
    let mut out = run List<Entry>.makeWithCapacity(descriptors.length())
    while descriptors.length() != 0 {
      let last = descriptors.length() - 1
      let descriptor = descriptors.remove(last)
      let known = properties.lookup(descriptor.name)
      let property = match &known {
        Option<Property>.Some { value } => properties.canonical(value)
        _ => Property.Fill
      }
      let named = match &known {
        Option<Property>.Some { value } => false
        _ => true
      }
      run out.append(
        Entry {
          property: property,
          custom: named,
          name: run Bytes.copy(descriptor.name),
          value: move descriptor.value,
          important: important,
          pending: false,
          variables: false,
          source: property,
        },
      )
    }
    return move out
  }

  effect fn commit(
    self: &mut StyleDeclaration,
    prepared: List<Entry>,
    cascading: bool,
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut prepared = move prepared
    if prepared.length() == 0 {
      return
    }
    let mut extra: usize = 0
    let mut at: usize = 0
    let mut storage: usize = 0
    while at < self.entries.length() {
      let entry = &self.entries.asSlice()[at]
      let size = entry.name.length() + entry.value.length()
      if size > limits.maxStorageBytes || storage > limits.maxStorageBytes - size {
        fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
      }
      storage = storage + size
      at = at + 1
    }
    at = 0
    while at < prepared.length() {
      let entry = &prepared.asSlice()[at]
      let prior = self.find(entryName(entry))
      if prior == self.entries.length() {
        extra = extra + 1
      } else {
        let old = &self.entries.asSlice()[prior]
        if cascading && old.important && !entry.important {
          at = at + 1
          continue
        }
        storage = storage - old.name.length() - old.value.length()
      }
      let size = entry.name.length() + entry.value.length()
      if size > limits.maxStorageBytes || storage > limits.maxStorageBytes - size {
        fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
      }
      storage = storage + size
      at = at + 1
    }
    if extra > limits.maxDeclarations || self.entries.length() > limits.maxDeclarations - extra {
      fail CssError { kind: CssErrorKind.DeclarationLimit, offset: 0 }
    }
    run self.entries.reserve(extra)
    let mut changed = false
    while prepared.length() != 0 {
      let last = prepared.length() - 1
      let next = prepared.remove(last)
      let prior = self.find(entryName(&next))
      if prior < self.entries.length() {
        if cascading && self.entries.asSlice()[prior].important && !next.important {
          continue
        }
        if !cascading && self.unchanged(prior, &next) {
          continue
        }

        // Moving to the end satisfies CSSOM's logical/physical ordering constraints.
        let removed = self.entries.remove(prior)
      }
      run self.entries.append(move next)
      changed = true
    }
    if changed {
      self.changed()
    }
  }

  pub effect fn getPropertyValue(self: &StyleDeclaration, name: &[u8]) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.context != Context.Style {
      return run self.descriptorValue(name)
    }
    if !customString(name) {
      match &properties.lookup(name) {
        Option<Property>.Some { value } => {
          let property = properties.canonical(value)
          if longhandCount(property) > 1 {
            return run self.shorthand(property)
          }
        }
        _ => {
          return Bytes.make()
        }
      }
    }
    let at = self.find(name)
    if at == self.entries.length() || self.entries.asSlice()[at].pending {
      return Bytes.make()
    }
    return run Bytes.copy(Bytes.asSlice(&self.entries.asSlice()[at].value))
  }

  pub fn getPropertyPriority(self: &StyleDeclaration, name: &[u8]) -> &[u8] {
    if self.context != Context.Style {
      let count = cssom_descriptors.longhandCount(self.context, name)
      if count == 0 {
        return b""
      }
      let mut at: usize = 0
      while at < count {
        let found = self.find(cssom_descriptors.longhandAt(self.context, name, at))
        if found == self.entries.length() || !self.entries.asSlice()[found].important {
          return b""
        }
        at = at + 1
      }
      return b"important"
    }
    if !customString(name) {
      match &properties.lookup(name) {
        Option<Property>.Some { value } => {
          let property = properties.canonical(value)
          if longhandCount(property) > 1 {
            let mut at: usize = 0
            while at < longhandCount(property) {
              let found = self.propertyIndex(longhandAt(property, at))
              if found == self.entries.length() || !self.entries.asSlice()[found].important {
                return b""
              }
              at = at + 1
            }
            return b"important"
          }
        }
        _ => {
          return b""
        }
      }
    }
    let at = self.find(name)
    return if at < self.entries.length() && self.entries.asSlice()[at].important {
      b"important"
    } else {
      b""
    }
  }

  pub effect fn setProperty(
    self: &mut StyleDeclaration,
    name: &[u8],
    value: &[u8],
    priority: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if self.readonly {
      fail CssomError.NoModificationAllowedError
    }
    if self.context != Context.Style {
      if cssom_descriptors.name(self.context, name).length == 0 {
        return
      }
    } else if !declaration_values.customName(name) {
      match &properties.lookup(name) {
        Option<Property>.Some { value: found } => {}
        _ => {
          return
        }
      }
    }
    if value.length == 0 {
      let removed = run self.removeProperty(name)
      return
    }
    if priority.length != 0 && !tokens.insensitive(priority, b"important") {
      return
    }
    if declaration_values.customName(name) {
      let names = run lexer.tokenize(name, limits)
      if names.all().end != 1
        || !match &names.tokens.asSlice()[0].kind {
          Kind.Ident { text } => tokens.equal(names.text(text), name)
          _ => false
        } {
        return
      }
    }
    let buffer = run lexer.tokenize(value, limits)
    let prepared = run self.prepare(name, &buffer, buffer.all(), priority.length != 0, limits)
    run self.commit(move prepared, false, limits)
  }

  /// Typed OM uses the same block but reports rejected values instead of silently ignoring them.
  /// Parsing and capacity checks complete before any existing declaration is replaced.
  pub effect fn setTypedProperty(
    self: &mut StyleDeclaration,
    name: &[u8],
    value: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if self.readonly {
      fail CssomError.NoModificationAllowedError
    }
    let buffer = run lexer.tokenize(value, limits)
    let prepared = run self.prepare(name, &buffer, buffer.all(), false, limits)
    if prepared.length() == 0 {
      fail CssomError.TypeError
    }
    run self.commit(move prepared, false, limits)
  }

  pub effect fn removeProperty(self: &mut StyleDeclaration, name: &[u8]) -> Bytes
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    if self.readonly {
      fail CssomError.NoModificationAllowedError
    }
    let result = run self.getPropertyValue(name)
    let previous = self.entries.length()
    if self.context != Context.Style {
      let mut at: usize = 0
      while at < cssom_descriptors.longhandCount(self.context, name) {
        let found = self.find(cssom_descriptors.longhandAt(self.context, name, at))
        if found < self.entries.length() {
          let removed = self.entries.remove(found)
        }
        at = at + 1
      }
      if self.entries.length() != previous {
        self.changed()
      }
      return move result
    }
    if !customString(name) {
      match &properties.lookup(name) {
        Option<Property>.Some { value } => {
          let property = properties.canonical(value)
          let mut at = self.entries.length()
          while at > 0 {
            at = at - 1
            let entry = &self.entries.asSlice()[at]
            if !entry.custom && covers(property, entry.property) {
              let removed = self.entries.remove(at)
            }
          }
          if self.entries.length() != previous {
            self.changed()
          }
          return move result
        }
        _ => {
          return move result
        }
      }
    }
    let at = self.find(name)
    if at < self.entries.length() {
      let removed = self.entries.remove(at)
    }
    if self.entries.length() != previous {
      self.changed()
    }
    return move result
  }

  pub effect fn setCssText(self: &mut StyleDeclaration, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if self.readonly {
      fail CssomError.NoModificationAllowedError
    }
    let parsed = run StyleDeclaration.parseMode(self.context, self.keyframe, text, limits)
    self.entries = move parsed.entries
    self.changed()
  }

  effect fn descriptorValue(self: &StyleDeclaration, name: &[u8]) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = cssom_descriptors.longhandCount(self.context, name)
    if count == 0 {
      return Bytes.make()
    }
    let mut values = run List<Bytes>.makeWithCapacity(count)
    let mut important = false
    let mut at: usize = 0
    while at < count {
      let found = self.find(cssom_descriptors.longhandAt(self.context, name, at))
      if found == self.entries.length() {
        return Bytes.make()
      }
      let entry = &self.entries.asSlice()[found]
      if at == 0 {
        important = entry.important
      } else if entry.important != important {
        return Bytes.make()
      }
      run values.append(run Bytes.copy(Bytes.asSlice(&entry.value)))
      at = at + 1
    }
    if count == 1 {
      return values.remove(0)
    }
    if count == 4 && (tokens.insensitive(name, b"margin") || tokens.insensitive(name, b"padding")) {
      return run cssom_shorthand.fourSides(values.asSlice())
    }
    match &properties.lookup(name) {
      Option<Property>.Some { value } => {
        return run cssom_shorthand.serialize(value, values.asSlice())
      }
      _ => {
        return Bytes.make()
      }
    }
  }

  effect fn shorthand(self: &StyleDeclaration, property: Property) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = longhandCount(property)
    let first = self.propertyIndex(longhandAt(property, 0))
    if first == self.entries.length() {
      return Bytes.make()
    }
    let entry = &self.entries.asSlice()[first]
    let firstValue = Bytes.asSlice(&entry.value)
    let mut same = true
    let mut at: usize = 0
    while at < count {
      let found = self.propertyIndex(longhandAt(property, at))
      if found == self.entries.length() {
        return Bytes.make()
      }
      let other = &self.entries.asSlice()[found]
      if other.important != entry.important {
        return Bytes.make()
      }
      if other.pending != entry.pending {
        return Bytes.make()
      }
      if other.pending && other.source != property {
        return Bytes.make()
      }
      if other.variables && !other.pending {
        return Bytes.make()
      }
      if !tokens.equal(Bytes.asSlice(&other.value), firstValue) {
        same = false
      }
      if wide(Bytes.asSlice(&other.value)) && !wide(firstValue) {
        return Bytes.make()
      }
      at = at + 1
    }
    if entry.pending {
      return if same {
        run Bytes.copy(firstValue)
      } else {
        Bytes.make()
      }
    }
    if wide(firstValue) {
      return if same {
        run Bytes.copy(firstValue)
      } else {
        Bytes.make()
      }
    }
    return run self.combine(property, same)
  }

  effect fn combine(self: &StyleDeclaration, property: Property, same: bool) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut texts = run List<Bytes>.makeWithCapacity(longhandCount(property))
    let mut at: usize = 0
    while at < longhandCount(property) {
      run texts.append(run Bytes.copy(self.text(longhandAt(property, at))))
      at = at + 1
    }
    return run cssom_shorthand.serialize(property, texts.asSlice())
  }

  pub effect fn cssText(self: &StyleDeclaration) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = Bytes.make()
    let mut used = run List<bool>.makeWithCapacity(self.entries.length())
    run used.appendRepeated(false, self.entries.length())

    // Greatest longhand coverage first; ties lexicographic, per CSSOM preferred order.
    let shorthands = [
      Property.All,
      Property.Font,
      Property.Mask,
      Property.Animation,
      Property.FontVariant,
      Property.MaskBorder,
      Property.FontSynthesis,
      Property.TextDecoration,
      Property.Marker,
      Property.VerticalAlign,
      Property.WhiteSpace,
      Property.Overflow,
      Property.TextAlign,
      Property.TextEmphasis,
    ]
    let mut at: usize = 0
    while at < self.entries.length() {
      if used.asSlice()[at] {
        at = at + 1
        continue
      }
      let entry = &self.entries.asSlice()[at]
      let mut emitted = false
      if self.context != Context.Style && entry.custom {
        let groups = [b"margin", b"padding"]
        let mut group: usize = 0
        while group < groups.length {
          let name = groups[group]
          group = group + 1
          let count = cssom_descriptors.longhandCount(self.context, name)
          let mut available = count == 4
          let mut contains = false
          let mut k: usize = 0
          while k < count {
            let found = self.find(cssom_descriptors.longhandAt(self.context, name, k))
            if found == at {
              contains = true
            }
            if found == self.entries.length() || used.asSlice()[found] {
              available = false
            }
            k = k + 1
          }
          if !available || !contains {
            continue
          }
          let value = run self.descriptorValue(name)
          if value.length() == 0 {
            continue
          }
          run appendDeclaration(&mut out, name, Bytes.asSlice(&value), entry.important)
          k = 0
          while k < count {
            used.set(self.find(cssom_descriptors.longhandAt(self.context, name, k)), true)
            k = k + 1
          }
          emitted = true
          break
        }
      }
      if !entry.custom {
        let mut choice: usize = 0
        while choice < shorthands.length {
          let shorthand = shorthands[choice]
          choice = choice + 1
          if !covers(shorthand, entry.property) {
            continue
          }
          let mut available = true
          let mut k: usize = 0
          while k < longhandCount(shorthand) {
            let found = self.propertyIndex(longhandAt(shorthand, k))
            if found == self.entries.length() || used.asSlice()[found] {
              available = false
              break
            }
            k = k + 1
          }
          if !available {
            continue
          }
          let value = run self.shorthand(shorthand)
          if Bytes.asSlice(&value).length == 0 {
            continue
          }
          run appendDeclaration(
            &mut out,
            properties.name(shorthand),
            Bytes.asSlice(&value),
            entry.important,
          )
          k = 0
          while k < longhandCount(shorthand) {
            let found = self.propertyIndex(longhandAt(shorthand, k))
            used.set(found, true)
            k = k + 1
          }
          emitted = true
          break
        }
      }
      if !emitted {
        if entry.pending {
          run appendDeclaration(&mut out, entryName(entry), b"", entry.important)
        } else {
          run appendDeclaration(
            &mut out,
            entryName(entry),
            Bytes.asSlice(&entry.value),
            entry.important,
          )
        }
        used.set(at, true)
      }
      at = at + 1
    }
    return move out
  }
}

effect fn appendDeclaration(out: &mut Bytes, name: &[u8], value: &[u8], important: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if Bytes.asSlice(&out.*).length != 0 {
    run Bytes.append(&mut out.*, b" ")
  }
  let escaped = run cssom_serialization.identifier(name)
  run Bytes.append(&mut out.*, Bytes.asSlice(&escaped))
  run Bytes.append(&mut out.*, b": ")
  let mut at: usize = 0
  while at < value.length && space(value[at]) {
    at = at + 1
  }
  if at < value.length {
    run Bytes.append(&mut out.*, value)
  }
  if important {
    run Bytes.append(&mut out.*, b" !important")
  }
  run Bytes.append(&mut out.*, b";")
}
