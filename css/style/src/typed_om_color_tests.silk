//! Typed OM 4.6 rectification/reification and native Color 4 conversion extension.
import typed_om_color {
  CSSColorValue,
  ParsedColor,
  CSSRGB,
  CSSHSL,
  CSSHWB,
  CSSLab,
  CSSLCH,
  CSSOKLab,
  CSSOKLCH,
  CSSColor,
  ColorInput,
  ColorComponent
}
import typed_om_numeric { NumericStore, UnitValue }
import colors { Color, Space, Identity }
import colors
import tokens { Limits, CssError }
import tokens
import cssom_error { CssomError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f64

fn number(value: f64) -> ColorInput<'static> {
  return ColorInput.Number { value: value }
}

fn none() -> ColorInput<'static> {
  return ColorInput.Keyword { text: b"NoNe" }
}

fn near(a: f64, b: f64) -> bool {
  return f64.abs(a - b) < 0.00001
}

fn unitIs(store: &NumericStore, component: ColorComponent, amount: f64, unit: &[u8]) -> bool {
  match &component {
    ColorComponent.Numeric { id } => {
      let found = store.unitValue(id)
      return match &found {
        Option<UnitValue>.Some { value } => near(value.value, amount)
          && tokens.equal(value.unit, unit)
        _ => false
      }
    }
    _ => {
      return false
    }
  }
}

fn isNone(component: ColorComponent) -> bool {
  return match &component {
    ColorComponent.None => true
    _ => false
  }
}

effect fn parsed(store: &mut NumericStore, text: &[u8]) -> CSSColorValue
  ! CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let value = run CSSColorValue.parse(&mut store.*, text, &limits)
  match move value {
    ParsedColor.Absolute { value: absolute } => {
      return move absolute
    }
    _ => {
      fail CssomError.TypeError
    }
  }
}

effect fn constructors() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut store = NumericStore.make()
  let raw = run store.unit(127.5, b"number")
  let angle = run store.unit(0.5, b"turn")
  let mut rgb = run CSSRGB.make(
    &mut store,
    number(0.25),
    ColorInput.Numeric { id: raw },
    none(),
    number(0.5),
  )
  run Testing.expect(
    unitIs(&store, rgb.r(), 25.0, b"percent"),
    "RGB doubles rectify as fraction-to-percent",
  )
  run Testing.expect(
    unitIs(&store, rgb.g(), 127.5, b"number"),
    "RGB numeric numbers keep their identity and 255 scale",
  )
  run Testing.expect(
    isNone(rgb.b()) && unitIs(&store, rgb.alpha(), 50.0, b"percent"),
    "none and alpha rectification",
  )
  run rgb.setB(&mut store, number(2.0))
  run rgb.setR(&mut store, none())
  run rgb.setG(&mut store, number(-0.5))
  run rgb.setAlpha(&mut store, none())
  run Testing.expect(
    isNone(rgb.r()) && isNone(rgb.alpha()) && unitIs(&store, rgb.g(), -50.0, b"percent")
      && unitIs(&store, rgb.b(), 200.0, b"percent"),
    "setters rectify without premature gamut or alpha clipping",
  )
  let mut hsl = run CSSHSL.opaque(
    &mut store,
    ColorInput.Numeric { id: angle },
    number(0.5),
    number(0.4),
  )
  run Testing.expect(
    unitIs(&store, hsl.h(), 0.5, b"turn") && unitIs(&store, hsl.alpha(), 100.0, b"percent"),
    "angles retain units and omitted alpha defaults opaque",
  )
  run hsl.setH(&mut store, number(720.0))
  run hsl.setS(&mut store, number(0.8))
  run hsl.setL(&mut store, number(0.2))
  run hsl.setAlpha(&mut store, number(0.6))
  run Testing.expect(
    unitIs(&store, hsl.h(), 720.0, b"deg") && unitIs(&store, hsl.s(), 80.0, b"percent")
      && unitIs(&store, hsl.l(), 20.0, b"percent")
      && unitIs(&store, hsl.alpha(), 60.0, b"percent"),
    "HSL accessors/setters",
  )
  let mut hwb = run CSSHWB.opaque(&mut store, number(30.0), number(0.1), number(0.2))
  run hwb.setH(&mut store, none())
  run hwb.setW(&mut store, number(0.3))
  run hwb.setB(&mut store, number(0.4))
  run hwb.setAlpha(&mut store, number(0.5))
  run Testing.expect(
    isNone(hwb.h()) && unitIs(&store, hwb.w(), 30.0, b"percent")
      && unitIs(&store, hwb.b(), 40.0, b"percent")
      && unitIs(&store, hwb.alpha(), 50.0, b"percent"),
    "HWB accessors/setters",
  )
  let mut lab = run CSSLab.opaque(&mut store, number(0.5), number(-40.0), number(20.0))
  run lab.setL(&mut store, number(0.6))
  run lab.setA(&mut store, none())
  run lab.setB(&mut store, number(-12.0))
  run lab.setAlpha(&mut store, number(0.4))
  run Testing.expect(
    unitIs(&store, lab.l(), 60.0, b"percent") && isNone(lab.a())
      && unitIs(&store, lab.b(), -12.0, b"number")
      && unitIs(&store, lab.alpha(), 40.0, b"percent"),
    "Lab number channels do not scale",
  )
  let mut lch = run CSSLCH.opaque(&mut store, number(0.5), number(0.2), number(40.0))
  run lch.setL(&mut store, number(0.7))
  run lch.setC(&mut store, number(0.3))
  run lch.setH(&mut store, ColorInput.Numeric { id: angle })
  run lch.setAlpha(&mut store, none())
  run Testing.expect(
    unitIs(&store, lch.l(), 70.0, b"percent") && unitIs(&store, lch.c(), 30.0, b"percent")
      && unitIs(&store, lch.h(), 0.5, b"turn")
      && isNone(lch.alpha()),
    "LCH chroma is percent-rectified",
  )
  let mut oklab = run CSSOKLab.opaque(&mut store, number(0.5), number(-0.1), number(0.2))
  run oklab.setL(&mut store, number(0.8))
  run oklab.setA(&mut store, number(0.1))
  run oklab.setB(&mut store, none())
  run oklab.setAlpha(&mut store, number(0.3))
  run Testing.expect(
    unitIs(&store, oklab.l(), 80.0, b"percent") && unitIs(&store, oklab.a(), 0.1, b"number")
      && isNone(oklab.b())
      && unitIs(&store, oklab.alpha(), 30.0, b"percent"),
    "OKLab accessors/setters",
  )
  let mut oklch = run CSSOKLCH.opaque(&mut store, number(0.5), number(0.4), number(20.0))
  run oklch.setL(&mut store, number(0.4))
  run oklch.setC(&mut store, number(0.2))
  run oklch.setH(&mut store, none())
  run oklch.setAlpha(&mut store, number(0.2))
  run Testing.expect(
    unitIs(&store, oklch.l(), 40.0, b"percent") && unitIs(&store, oklch.c(), 20.0, b"percent")
      && isNone(oklch.h())
      && unitIs(&store, oklch.alpha(), 20.0, b"percent"),
    "OKLCH accessors/setters",
  )
}

effect fn errors() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut store = NumericStore.make()
  let numberId = run store.unit(0.5, b"number")
  let lengthId = run store.unit(2.0, b"px")
  let mut hsl = run CSSHSL.opaque(&mut store, number(30.0), number(0.5), number(0.5))
  let percentError = run Effect.result(hsl.setS(&mut store, ColorInput.Numeric { id: numberId }))
  run Testing.expect(
    match &percentError {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.SyntaxError
        _ => false
      }
      _ => false
    },
    "CSSColorPercent rejects numeric number rather than treating it as a double",
  )
  let angleError = run Effect.result(hsl.setH(&mut store, ColorInput.Numeric { id: lengthId }))
  run Testing.expect(
    match &angleError {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.TypeError
        _ => false
      }
      _ => false
    },
    "angle mismatch throws TypeError, unlike other color component mismatches",
  )
  let keywordError = run Effect.result(hsl.setL(&mut store, ColorInput.Keyword { text: b"auto" }))
  run Testing.expect(
    match &keywordError {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.SyntaxError
        _ => false
      }
      _ => false
    },
    "only none is a color component keyword",
  )
  run Testing.expect(
    unitIs(&store, hsl.h(), 30.0, b"deg") && unitIs(&store, hsl.s(), 50.0, b"percent")
      && unitIs(&store, hsl.l(), 50.0, b"percent"),
    "failed setters leave the prior slot intact",
  )
}

effect fn reification() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut store = NumericStore.make()
  let rgb = run parsed(&mut store, b"rgb(10% 127.5 none / 25%)")
  run Testing.expect(
    match &rgb {
      CSSColorValue.RGB { value } => unitIs(&store, value.r(), 10.0, b"percent")
        && unitIs(&store, value.g(), 127.5, b"number")
        && isNone(value.b())
        && unitIs(&store, value.alpha(), 25.0, b"percent")
      _ => false
    },
    "parsing reifies specified component units and missing channels",
  )
  let serialized = run rgb.serialize(&store)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&serialized), b"rgb(10% 127.5 none / 25%)"),
    "native modern RGB serialization",
  )
  let math = run parsed(&mut store, b"hsl(calc(1turn / 2) 40% 60% / none)")
  let text = run math.serialize(&store)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&text), b"hsl(calc(1turn / 2) 40% 60% / none)"),
    "parsing does not collapse authored math to a float",
  )
  let absolute = run math.absolute(&store)
  run Testing.expect(
    near(absolute.channels[0], 180.0) && absolute.missing == 8,
    "numeric evaluation and missing alpha",
  )
  let limits = Limits.make()
  let keyword = run CSSColorValue.parse(&mut store, b"currentColor", &limits)
  run Testing.expect(
    match &keyword {
      ParsedColor.Keyword { text: name } => tokens.insensitive(
        Bytes.asSlice(&name),
        b"currentcolor",
      )
      _ => false
    },
    "context-dependent color remains a keyword, not an invented absolute color",
  )
  let system = run CSSColorValue.parse(&mut store, b"CanvasText", &limits)
  run Testing.expect(
    match &system {
      ParsedColor.Keyword { text: name } => true
      _ => false
    },
    "system colors stay context-dependent",
  )
  let hex = run parsed(&mut store, b"#ff000080")
  let resolved = run hex.absolute(&store)
  run Testing.expect(
    near(resolved.channels[0], 1.0) && near(resolved.alpha, 128.0 / 255.0),
    "hex reification",
  )
  let named = run parsed(&mut store, b"rebeccapurple")
  let purple = run named.absolute(&store)
  run Testing.expect(
    near(purple.channels[0], 0.4) && near(purple.channels[2], 0.6),
    "named color reification",
  )
  let invalid = run Effect.result(CSSColorValue.parse(&mut store, b"red blue", &limits))
  run Testing.expect(
    match &invalid {
      Result<ParsedColor, CssomError | CssError | OutOfMemoryError>.Failure {
        error
      } => match &error {
        CssomError problem => problem == CssomError.SyntaxError
        _ => false
      }
      _ => false
    },
    "parse consumes the entire color grammar",
  )
  let hwb = run parsed(&mut store, b"hwb(120deg 10% 20% / 0.5)")
  run Testing.expect(
    match &hwb {
      CSSColorValue.HWB { value } => unitIs(&store, value.h(), 120.0, b"deg")
        && unitIs(&store, value.alpha(), 0.5, b"number")
      _ => false
    },
    "HWB reification preserves explicitly numeric alpha",
  )
  let lab = run parsed(&mut store, b"lab(50% -20% 30%)")
  run Testing.expect(
    match &lab {
      CSSColorValue.Lab { value } => unitIs(&store, value.a(), -20.0, b"percent")
      _ => false
    },
    "reification does not incorrectly run constructor-only number rectification",
  )
  let labAbsolute = run lab.absolute(&store)
  run Testing.expect(
    near(labAbsolute.channels[1], -25.0) && near(labAbsolute.channels[2], 37.5),
    "Lab a/b percentages use their 125 reference range",
  )
  let lch = run parsed(&mut store, b"lch(50% 50% 0.25turn)")
  run Testing.expect(
    match &lch {
      CSSColorValue.LCH { value } => unitIs(&store, value.h(), 0.25, b"turn")
      _ => false
    },
    "LCH preserves authored angle units",
  )
  let lchAbsolute = run lch.absolute(&store)
  run Testing.expect(
    near(lchAbsolute.channels[1], 75.0) && near(lchAbsolute.channels[2], 90.0),
    "LCH chroma reference range is 150",
  )
  let oklab = run parsed(&mut store, b"oklab(50% 25% -25%)")
  run Testing.expect(
    match &oklab {
      CSSColorValue.OKLab { value } => true
      _ => false
    },
    "OKLab subclass reification",
  )
  let oklabAbsolute = run oklab.absolute(&store)
  run Testing.expect(
    near(oklabAbsolute.channels[0], 0.5) && near(oklabAbsolute.channels[1], 0.1)
      && near(oklabAbsolute.channels[2], -0.1),
    "OKLab reference ranges are one and 0.4",
  )
  let oklch = run parsed(&mut store, b"oklch(0.5 50% 180)")
  run Testing.expect(
    match &oklch {
      CSSColorValue.OKLCH { value } => true
      _ => false
    },
    "OKLCH subclass reification",
  )
  let oklchAbsolute = run oklch.absolute(&store)
  run Testing.expect(
    near(oklchAbsolute.channels[0], 0.5) && near(oklchAbsolute.channels[1], 0.2),
    "OKLCH chroma percentage reference is 0.4",
  )
  let xyz = run parsed(&mut store, b"color(xyz 0.1 20% 0.3)")
  run Testing.expect(
    match &xyz {
      CSSColorValue.Color { value } => tokens.equal(value.colorSpace(), b"xyz")
        && unitIs(&store, value.channels()[0], 0.1, b"number")
        && unitIs(&store, value.channels()[1], 20.0, b"percent")
      _ => false
    },
    "generic color reification retains the space keyword and number/percentage distinction",
  )
  let mut destination = NumericStore.make()
  let padding = run destination.unit(12.0, b"px")
  let copied = run math.cloneFrom(&mut destination, &store)
  let cloned = run copied.serialize(&destination)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&text), Bytes.asSlice(&cloned)),
    "cross-arena clone remaps every numeric subtree",
  )
}

effect fn genericChannels() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut store = NumericStore.make()
  let mut color = run CSSColor.opaque(
    &mut store,
    b"display-p3",
    &[number(1.0), none(), number(0.2)],
  )
  run Testing.expect(
    tokens.equal(color.colorSpace(), b"display-p3") && color.channels().length == 3
      && isNone(color.channels()[1])
      && unitIs(&store, color.alpha(), 100.0, b"percent"),
    "generic color constructor",
  )
  run color.setChannel(&mut store, 1, number(0.4))
  run color.setChannel(&mut store, 3, number(0.7))
  run Testing.expect(
    color.channels().length == 4 && color.deleteChannel(0),
    "observable channel append/delete",
  )
  run Testing.expect(
    unitIs(&store, color.channels()[0], 40.0, b"percent"),
    "delete shifts the backing list",
  )
  run color.setChannels(&mut store, &[number(0.1), number(0.2), number(0.3)])
  run color.setAlpha(&mut store, number(0.8))
  run color.setColorSpace(b"--custom-profile")
  let value = CSSColorValue.Color { value: move color }
  let text = run value.serialize(&store)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&text), b"color(--custom-profile 10% 20% 30% / 80%)"),
    "unknown spaces and arbitrary lists are representable per constructor algorithm",
  )
  let unsupported = run Effect.result(value.absolute(&store))
  run Testing.expect(
    match &unsupported {
      Result<Color, CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NotSupportedError
        _ => false
      }
      _ => false
    },
    "conversion cannot silently invent a custom color profile",
  )
}

effect fn conversions() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut store = NumericStore.make()
  let source = run parsed(&mut store, b"color(display-p3 0.9 0.3 0.2 / 0.7)")
  let original = run source.absolute(&store)
  let spaces = [
    Space.Srgb,
    Space.SrgbLinear,
    Space.DisplayP3,
    Space.DisplayP3Linear,
    Space.A98Rgb,
    Space.ProphotoRgb,
    Space.Rec2020,
    Space.XyzD50,
    Space.XyzD65,
    Space.Hsl,
    Space.Hwb,
    Space.Lab,
    Space.Lch,
    Space.Oklab,
    Space.Oklch,
  ]
  let mut i: usize = 0
  while i < spaces.length {
    let converted = run source.to(&mut store, spaces[i])
    let back = run converted.to(&mut store, Space.DisplayP3)
    let result = run back.absolute(&store)
    run Testing.expect(
      near(result.channels[0], original.channels[0])
        && near(result.channels[1], original.channels[1])
        && near(result.channels[2], original.channels[2])
        && near(result.alpha, original.alpha),
      "all supported color spaces round-trip without display gamut mapping",
    )
    i = i + 1
  }
  let wide = run parsed(&mut store, b"color(display-p3 1 0 0)")
  let srgb = run wide.to(&mut store, Space.Srgb)
  let extended = run srgb.absolute(&store)
  run Testing.expect(
    extended.channels[0] > 1.0 && extended.channels[1] < 0.0,
    "conversion preserves out-of-gamut coordinates",
  )
  let missing = run parsed(&mut store, b"lab(none 20 30 / none)")
  let other = run missing.to(&mut store, Space.Oklab)
  let retained = run other.absolute(&store)
  run Testing.expect(
    retained.missing == 9,
    "analogous missing lightness and alpha survive conversion",
  )
  let hwb = run parsed(&mut store, b"hwb(0 80% 80%)")
  let gray = run hwb.to(&mut store, Space.Srgb)
  let grayCoordinates = run gray.absolute(&store)
  run Testing.expect(
    near(grayCoordinates.channels[0], 0.5) && near(grayCoordinates.channels[1], 0.5),
    "HWB normalization delegates to the color engine",
  )
  let unresolved = colors.convert(Color.current(), Space.Lab)
  run Testing.expect(
    match &unresolved {
      Option<Color>.None => true
      _ => false
    },
    "engine conversion requires host resolution of currentcolor",
  )
}

test effect fn typedColorConstructorsAndSetters() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run constructors() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn typedColorRectificationErrorsAreAtomic() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run errors() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn typedColorParsingReificationAndArenaTransfer() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run reification() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn typedColorObservableChannelsAndUnknownProfiles() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run genericChannels() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn typedColorAllSpaceConversionsAndMissingComponents() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conversions() |> Effect.provideMut<Allocator>(&mut allocator)
}
