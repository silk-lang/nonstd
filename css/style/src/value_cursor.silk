//! Token-sequence cursor. Expanded inputs are never re-tokenized or index-matched.
import input { Input, TokenView }
import tokens { Kind }
import tokens
import silk.core.option { Option }
import silk.core.ownership { Copy }

pub struct Cursor {
  pub position: usize,
  pub end: usize
}

impl Copy for Cursor {}

impl Cursor {
  pub fn make(source: &Input) -> Cursor {
    return Cursor { position: 0, end: source.length() }
  }

  pub fn skip(self: &mut Cursor, source: &Input) -> () {
    while self.position < self.end {
      let next = source.at(self.position)
      match &next {
        Option<TokenView>.Some { value } => {
          match &value.token.kind {
            Kind.Whitespace => {
              self.position = self.position + 1
            }
            _ => {
              return
            }
          }
        }
        _ => {
          return
        }
      }
    }
  }

  pub fn done(self: &mut Cursor, source: &Input) -> bool {
    self.skip(source)
    return self.position >= self.end
  }

  pub fn ident(self: &mut Cursor, source: &Input, wanted: &[u8]) -> bool {
    let saved = self.position
    self.skip(source)
    if self.position < self.end {
      let next = source.at(self.position)
      match &next {
        Option<TokenView>.Some { value } => {
          match &value.token.kind {
            Kind.Ident { text } => {
              if tokens.insensitive(value.text(text), wanted) {
                self.position = self.position + 1
                return true
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
    }
    self.position = saved
    return false
  }

  pub fn function(self: &mut Cursor, source: &Input, wanted: &[u8]) -> bool {
    let saved = self.position
    self.skip(source)
    if self.position < self.end {
      let next = source.at(self.position)
      match &next {
        Option<TokenView>.Some { value } => {
          match &value.token.kind {
            Kind.Function { name } => {
              if tokens.insensitive(value.text(name), wanted) {
                self.position = self.position + 1
                return true
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
    }
    self.position = saved
    return false
  }

  pub fn delim(self: &mut Cursor, source: &Input, scalar: u32) -> bool {
    return self.punctuation(source, 0, scalar)
  }

  pub fn comma(self: &mut Cursor, source: &Input) -> bool {
    return self.punctuation(source, 1, 0)
  }

  pub fn close(self: &mut Cursor, source: &Input) -> bool {
    // Syntax3 closes any still-open component at the end of its input.
    let saved = self.position
    self.skip(source)
    if self.position >= self.end {
      return true
    }
    self.position = saved
    return self.punctuation(source, 2, 0)
  }

  fn punctuation(self: &mut Cursor, source: &Input, kind: u8, scalar: u32) -> bool {
    let saved = self.position
    self.skip(source)
    if self.position < self.end {
      let next = source.at(self.position)
      match &next {
        Option<TokenView>.Some { value } => {
          let matches = match &value.token.kind {
            Kind.Delim { scalar: actual } => kind == 0 && actual == scalar
            Kind.Comma => kind == 1
            Kind.CloseParen => kind == 2
            _ => false
          }
          if matches {
            self.position = self.position + 1
            return true
          }
        }
        _ => {}
      }
    }
    self.position = saved
    return false
  }
}
