// https://www.w3.org/TR/css-values-4/#calc-type-checking
// https://www.w3.org/TR/css-values-4/#calc-ieee
effect fn dimensionalPercentageAlgebraCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(b"calc(50%/25%)", Dimension.Number, false, &context, 0.0, 2.0)),
    "unhinted percentages cancel independently of zero number basis",
  )
  run Testing.expect(
    (run resolves(b"calc((50%/25%)*10%)", Dimension.Percentage, false, &context, 80.0, 16.0)),
    "percentage algebra scales only final percentage output",
  )
  run Testing.expect(
    (run resolves(b"calc(1px + 2px", Dimension.Length, false, &context, 0.0, 3.0)),
    "Syntax implicitly closes math at EOF",
  )
  run Testing.expect(
    (run resolves(b"calc(0/0)", Dimension.Number, false, &context, 0.0, 0.0)),
    "NaN censors at calculation boundary",
  )
  run Testing.expect(
    (run resolves(b"min(NaN, 1)", Dimension.Number, false, &context, 0.0, 0.0)),
    "comparison propagates NaN before censoring",
  )
  run Testing.expect(
    (run resolves(b"calc(pi*2)", Dimension.Number, false, &context, 0.0, 6.283185307179586)),
    "math constants participate in typed arithmetic",
  )
}

test effect fn dimensionalPercentageAlgebra() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalPercentageAlgebraCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-values-4/#numeric-data-types
// https://www.w3.org/TR/css-values-4/#angles
effect fn dimensionalConversionRangeCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(
      b"1e308in",
      Dimension.Length,
      false,
      &context,
      0.0,
      f64.fromBits(9218868437227405311),
    )),
    "finite dimensional conversion saturates instead of becoming mathematical infinity",
  )
  run Testing.expect(
    (run resolves(
      b"-1e308turn",
      Dimension.Angle,
      false,
      &context,
      0.0,
      -f64.fromBits(9218868437227405280),
    )),
    "overflow angle clamps to supported multiple of 360deg",
  )
}

test effect fn dimensionalConversionRange() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalConversionRangeCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-values-4/#resolution
// https://www.w3.org/TR/css-values-4/#calc-range
effect fn dimensionalResolutionRangeCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run invalid(b"-1dppx", Dimension.Resolution, false)),
    "resolution always excludes negative literal values",
  )
  run Testing.expect(
    (run resolves(b"calc(-1dppx)", Dimension.Resolution, false, &context, 0.0, 0.0)),
    "negative resolution math clamps instead of invalidating",
  )
  run Testing.expect(
    (run resolves(b"calc(-1dppx + 192dpi)", Dimension.Resolution, false, &context, 0.0, 1.0)),
    "resolution arithmetic permits negative intermediate terms",
  )
}

test effect fn dimensionalResolutionRange() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalResolutionRangeCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-values-4/#calc-type-checking
effect fn dimensionalResultKindCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run tokenize(
    b"calc(4px/2px) calc(4px/2) calc(50%/25%) calc(50% + 2px)",
    &Limits.make(),
  )
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let contexts = [Dimension.Number, Dimension.Length, Dimension.Number, Dimension.LengthPercentage]
  let wants = [true, false, true, false]
  let mut index: usize = 0
  while index < 4 {
    let parsed = run parse(&mut store, &source, &mut cursor, contexts[index], false)
    match &parsed {
      Option<ExprId>.Some { value } => {
        run Testing.expect(
          numberResult(&store, value) == wants[index],
          "result type follows dimensional algebra, not first literal",
        )
      }
      _ => {
        run Testing.expect(false, "typed example parses")
      }
    }
    index = index + 1
  }
}

test effect fn dimensionalResultKind() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalResultKindCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-values-4/#calc-range
// https://www.w3.org/TR/css-values-4/#comp-func
effect fn dimensionalDeferredRangeCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run tokenize(b"calc(50% - 40px)", &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let parsed = run parse(&mut store, &source, &mut cursor, Dimension.LengthPercentage, false)
  match &parsed {
    Option<ExprId>.Some { value } => {
      let clamped = run nonnegative(&mut store, value)
      run Testing.expect(
        evaluate(&store, clamped, 50.0) == 0.0,
        "deferred range clamps negative small-box result",
      )
      run Testing.expect(
        evaluate(&store, clamped, 200.0) == 60.0,
        "deferred range retains positive large-box result",
      )
      run Testing.expect(
        !numberResult(&store, clamped),
        "range wrapper preserves dimensional result type",
      )
    }
    _ => {
      run Testing.expect(false, "deferred range expression parses")
    }
  }
}

test effect fn dimensionalDeferredRange() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalDeferredRangeCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/mediaqueries-4/#false-in-the-negative-range
// https://www.w3.org/TR/mediaqueries-4/#resolution
effect fn dimensionalMediaNegativeResolutionCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run tokenize(b"-96dpi calc(1dppx - 3dppx)", &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let context = Context.make(800.0, 600.0, 16.0)
  let wants = [-1.0, -2.0]
  let mut index: usize = 0
  while index < 2 {
    let parsed = run parseMedia(&mut store, &source, &mut cursor, Dimension.Resolution)
    match &parsed {
      Option<ExprId>.Some { value } => {
        let computed = run compute(&mut store, value, &context)
        run Testing.expect(
          evaluate(&store, computed, 0.0) == wants[index],
          "media resolution negative thresholds remain valid and unclamped",
        )
      }
      _ => {
        run Testing.expect(false, "negative media resolution parses")
      }
    }
    index = index + 1
  }
  run Testing.expect(
    (run invalid(b"-96dpi", Dimension.Resolution, false)),
    "property resolution still rejects negative literal",
  )
  run Testing.expect(
    (run resolves(b"calc(1dppx - 3dppx)", Dimension.Resolution, false, &context, 0.0, 0.0)),
    "property resolution still clamps negative math",
  )
}

test effect fn dimensionalMediaNegativeResolution() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalMediaNegativeResolutionCase() |> Effect.provideMut<Allocator>(&mut allocator)
}
