//! CSS Values 3/4 dimensional contracts against the pinned specs.lock.json snapshots.
import dimensions {
  Store,
  ExprId,
  Dimension,
  Context,
  parse,
  parseMedia,
  compute,
  evaluate,
  negativeLiteral,
  numberResult,
  nonnegative
}
import input { Input, TokenRef }
import tokens { TokenBuffer, Limits, CssError }
import lexer { tokenize }
import value_cursor { Cursor }
import silk.core.option { Option }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }
import silk.num.f64

effect fn resolves(
  text: &[u8],
  expected: Dimension,
  presentation: bool,
  context: &Context,
  basis: f64,
  want: f64,
) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = (run tokenize(text, &Limits.make()))
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let parsed = (run parse(&mut store, &source, &mut cursor, expected, presentation))
  match &parsed {
    Option<ExprId>.Some { value } => {
      if !cursor.done(&source) {
        return false
      }
      let computed = (run compute(&mut store, value, context))
      return f64.abs(evaluate(&store, computed, basis) - want) < 0.00000001
    }
    Option<ExprId>.None => {
      return false
    }
  }
}

effect fn invalid(text: &[u8], expected: Dimension, presentation: bool) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = (run tokenize(text, &Limits.make()))
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let parsed = (run parse(&mut store, &source, &mut cursor, expected, presentation))
  return match &parsed {
    Option<ExprId>.None => cursor.position == 0
    Option<ExprId>.Some { value } => !cursor.done(&source)
  }
}

// https://www.w3.org/TR/css-values-4/#calc-syntax
// https://www.w3.org/TR/css-values-4/#calc-type-checking
effect fn dimensionalArithmeticPrecedenceAndTypesCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(b"calc(10px + 2px*3 - 8px/4)", Dimension.Length, false, &context, 0.0, 14.0)),
    "products bind before sums",
  )
  run Testing.expect(
    (run resolves(b"calc((10px + 2px)*3/4)", Dimension.Length, false, &context, 0.0, 9.0)),
    "parentheses override precedence",
  )
  run Testing.expect(
    (run resolves(b"calc(24/3/2)", Dimension.Number, false, &context, 0.0, 4.0)),
    "division associates left",
  )
  run Testing.expect(
    (run resolves(b"calc(2px*3px/1px)", Dimension.Length, false, &context, 0.0, 6.0)),
    "Values4 allows compound intermediate types",
  )
  run Testing.expect(
    (run resolves(b"calc(1in/24px)", Dimension.Number, false, &context, 0.0, 4.0)),
    "compatible dimensions cancel after conversion",
  )
  run Testing.expect(
    (run invalid(b"calc(1px + 1s)", Dimension.Length, false)),
    "unlike dimensions cannot add",
  )
  run Testing.expect(
    (run invalid(b"calc(0*1px + 1s)", Dimension.Time, false)),
    "zero does not erase type errors",
  )
  run Testing.expect(
    (run invalid(b"calc(2px*3px)", Dimension.Length, false)),
    "compound final type is invalid",
  )
  run Testing.expect(
    (run invalid(b"calc(0 + 1px)", Dimension.Length, false)),
    "unitless zero inside math remains number",
  )
  run Testing.expect(
    (run invalid(b"calc(1px+ 2px)", Dimension.Length, false)),
    "sum requires preceding whitespace",
  )
  run Testing.expect(
    (run invalid(b"calc(1px +2px)", Dimension.Length, false)),
    "sum requires following whitespace",
  )
  run Testing.expect(
    (run invalid(b"calc(1px/**/+/**/2px)", Dimension.Length, false)),
    "comments are not whitespace tokens",
  )
  run Testing.expect(
    (run invalid(b"calc(1px + )", Dimension.Length, false)),
    "missing operand rejected",
  )
  run Testing.expect((run invalid(b"min()", Dimension.Length, false)), "empty comparison rejected")
}

// https://www.w3.org/TR/css-values-4/#comp-func
// https://www.w3.org/TR/css-values-3/#calc-computed-value
effect fn dimensionalDeferredPercentagesCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(b"min(50%, 80px)", Dimension.LengthPercentage, false, &context, 100.0, 50.0)),
    "small reference box chooses percentage",
  )
  run Testing.expect(
    (run resolves(b"min(50%, 80px)", Dimension.LengthPercentage, false, &context, 200.0, 80.0)),
    "large reference box chooses absolute bound",
  )
  run Testing.expect(
    (run resolves(
      b"clamp(20px, calc(50% - 1em), 90px)",
      Dimension.LengthPercentage,
      false,
      &context,
      120.0,
      44.0,
    )),
    "nested arithmetic retains percentage basis",
  )
  run Testing.expect(
    (run resolves(b"clamp(100px, 20px, 10px)", Dimension.Length, false, &context, 0.0, 100.0)),
    "minimum wins crossed clamp bounds",
  )
  run Testing.expect(
    (run resolves(
      b"clamp(none, 50%, 80px)",
      Dimension.LengthPercentage,
      false,
      &context,
      200.0,
      80.0,
    )),
    "none omits lower bound",
  )
  run Testing.expect(
    (run resolves(b"clamp(20px, 10px, none)", Dimension.Length, false, &context, 0.0, 20.0)),
    "none omits upper bound",
  )
  run Testing.expect(
    (run resolves(b"calc(100%/4)", Dimension.NumberPercentage, false, &context, 1.0, 0.25)),
    "number percentage context retains homogeneous percentages",
  )
  run Testing.expect(
    (run invalid(b"calc(.25 + 25%)", Dimension.NumberPercentage, false)),
    "pinned Values4 forbids combining number and percentage",
  )
  run Testing.expect(
    (run invalid(b"min(.25, 25%)", Dimension.NumberPercentage, false)),
    "comparison requires consistent types",
  )
  run Testing.expect(
    (run invalid(b"calc(10px + 20%)", Dimension.Length, false)),
    "length-only contexts do not admit percentages",
  )
  run Testing.expect(
    (run invalid(b"clamp(1px, 2px)", Dimension.Length, false)),
    "clamp requires three arguments",
  )
}

// https://www.w3.org/TR/css-values-4/#absolute-lengths
// https://www.w3.org/TR/css-values-4/#angles
// https://www.w3.org/TR/css-values-4/#time
// https://www.w3.org/TR/css-values-4/#frequency
// https://www.w3.org/TR/css-values-4/#resolution
effect fn dimensionalCanonicalUnitsCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(
      b"calc(1in + 2.54cm + 25.4mm + 101.6Q + 72pt + 6pc + 96px)",
      Dimension.Length,
      false,
      &context,
      0.0,
      672.0,
    )),
    "all absolute lengths share CSS 96dpi",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1turn + 200grad + 3.141592653589793rad + 90deg)",
      Dimension.Angle,
      false,
      &context,
      0.0,
      810.0,
    )),
    "all angle units canonicalize to degrees",
  )
  run Testing.expect(
    (run resolves(b"calc(2s + 500ms)", Dimension.Time, false, &context, 0.0, 2.5)),
    "time canonicalizes to seconds",
  )
  run Testing.expect(
    (run resolves(b"calc(2kHz + 500HZ)", Dimension.Frequency, false, &context, 0.0, 2500.0)),
    "frequency units case insensitive",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1dppx + 1x + 96dpi + 37.79527559055118dpcm)",
      Dimension.Resolution,
      false,
      &context,
      0.0,
      4.0,
    )),
    "resolution aliases and physical conversions",
  )
  run Testing.expect((run invalid(b"1unknown", Dimension.Length, false)), "unknown units rejected")
  run Testing.expect(
    (run invalid(b"0", Dimension.Angle, false)),
    "angles do not generally admit unitless zero",
  )
  run Testing.expect((run invalid(b"0", Dimension.Time, false)), "times require a unit")
}

// https://www.w3.org/TR/css-values-4/#font-relative-lengths
// https://www.w3.org/TR/css-values-4/#viewport-relative-units
effect fn dimensionalHostMetricsCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut context = Context.make(1000.0, 600.0, 20.0)
  context.rootFontSize = 30.0
  context.xHeight = 7.0
  context.rootXHeight = 11.0
  context.capHeight = 13.0
  context.rootCapHeight = 17.0
  context.zeroAdvance = 9.0
  context.rootZeroAdvance = 14.0
  context.ideographAdvance = 21.0
  context.rootIdeographAdvance = 31.0
  context.lineHeight = 24.0
  context.rootLineHeight = 36.0
  context.smallViewportWidth = 800.0
  context.smallViewportHeight = 400.0
  context.dynamicViewportWidth = 900.0
  context.dynamicViewportHeight = 500.0
  run Testing.expect(
    (run resolves(
      b"calc(1em + 1rem + 1ex + 1rex + 1cap + 1rcap + 1ch + 1rch + 1ic + 1ric + 1lh + 1rlh)",
      Dimension.Length,
      false,
      &context,
      0.0,
      233.0,
    )),
    "all local and root metrics supplied independently",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1vw + 1vh + 1vi + 1vb + 1vmin + 1vmax)",
      Dimension.Length,
      false,
      &context,
      0.0,
      48.0,
    )),
    "default viewport physical logical and extrema units",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1lvw + 1lvh + 1lvi + 1lvb + 1lvmin + 1lvmax)",
      Dimension.Length,
      false,
      &context,
      0.0,
      48.0,
    )),
    "large viewport units",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1svw + 1svh + 1svi + 1svb + 1svmin + 1svmax)",
      Dimension.Length,
      false,
      &context,
      0.0,
      36.0,
    )),
    "small viewport units",
  )
  run Testing.expect(
    (run resolves(
      b"calc(1dvw + 1dvh + 1dvi + 1dvb + 1dvmin + 1dvmax)",
      Dimension.Length,
      false,
      &context,
      0.0,
      42.0,
    )),
    "dynamic viewport units",
  )
  context.vertical = true
  run Testing.expect(
    (run resolves(b"calc(2vi + 3vb)", Dimension.Length, false, &context, 0.0, 42.0)),
    "logical viewport axes follow vertical writing mode",
  )
}

// https://www.w3.org/TR/css-values-4/#lengths
// https://www.w3.org/TR/css-values-4/#calc-range
effect fn dimensionalUnitlessAndNegativityCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let context = Context.make(800.0, 600.0, 16.0)
  run Testing.expect(
    (run resolves(b"0", Dimension.Length, false, &context, 0.0, 0.0)),
    "CSS unitless zero length",
  )
  run Testing.expect(
    (run invalid(b"12", Dimension.Length, false)),
    "nonzero unitless CSS length invalid",
  )
  run Testing.expect(
    (run resolves(b"12", Dimension.Length, true, &context, 0.0, 12.0)),
    "presentation mode admits user units",
  )
  let buffer = (run tokenize(b"-2px calc(-2px)", &Limits.make()))
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let first = (run parse(&mut store, &source, &mut cursor, Dimension.Length, false))
  let second = (run parse(&mut store, &source, &mut cursor, Dimension.Length, false))
  match &first {
    Option<ExprId>.Some { value } => {
      run Testing.expect(
        negativeLiteral(&store, value),
        "negative literal rejected by nonnegative properties",
      )
    }
    _ => {
      run Testing.expect(false, "literal parses")
    }
  }
  match &second {
    Option<ExprId>.Some { value } => {
      run Testing.expect(
        !negativeLiteral(&store, value),
        "negative math results clamp at use, not parse time",
      )
    }
    _ => {
      run Testing.expect(false, "math parses")
    }
  }
}

// https://www.w3.org/TR/css-values-4/#calc-syntax
effect fn dimensionalExpandedInputCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  run buffers.append(run tokenize(b"calc(2px + ", &Limits.make()))
  run buffers.append(run tokenize(b"3px)", &Limits.make()))
  let mut references = List<TokenRef>.make()
  let mut b: usize = 0
  while b < buffers.length() {
    let mut t: usize = 0
    while t < buffers.asSlice()[b].all().end {
      run references.append(TokenRef { buffer: b, token: t })
      t = t + 1
    }
    b = b + 1
  }
  let source = Input.Expanded { buffers: buffers.asSlice(), references: references.asSlice() }
  let mut cursor = Cursor.make(&source)
  let mut store = Store.make()
  let parsed = (run parse(&mut store, &source, &mut cursor, Dimension.Length, false))
  match &parsed {
    Option<ExprId>.Some { value } => {
      run Testing.expect(
        cursor.done(&source) && evaluate(&store, value, 0.0) == 5.0,
        "expanded token indexes are independent of original matching indexes",
      )
    }
    _ => {
      run Testing.expect(false, "cross-buffer expression parses")
    }
  }
}

test effect fn dimensionalArithmeticPrecedenceAndTypes() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionalArithmeticPrecedenceAndTypesCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

