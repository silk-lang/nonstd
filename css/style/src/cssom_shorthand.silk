//! Serialization of canonical longhand tuples; no parsing or computed-style mutation.
import properties { Property }
import properties
import tokens
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn text(values: &[Bytes], index: usize) -> &[u8] {
  return Bytes.asSlice(&values[index])
}

fn is(values: &[Bytes], index: usize, expected: &[u8]) -> bool {
  return tokens.equal(text(values, index), expected)
}

fn wide(value: &[u8]) -> bool {
  return tokens.equal(value, b"initial") || tokens.equal(value, b"inherit")
    || tokens.equal(value, b"unset")
    || tokens.equal(value, b"revert")
    || tokens.equal(value, b"revert-layer")
}

fn fontWidth(value: &[u8]) -> &[u8] {
  if tokens.equal(value, b"50%") {
    return b"ultra-condensed"
  }
  if tokens.equal(value, b"62.5%") {
    return b"extra-condensed"
  }
  if tokens.equal(value, b"75%") {
    return b"condensed"
  }
  if tokens.equal(value, b"87.5%") {
    return b"semi-condensed"
  }
  if tokens.equal(value, b"100%") {
    return b"normal"
  }
  if tokens.equal(value, b"112.5%") {
    return b"semi-expanded"
  }
  if tokens.equal(value, b"125%") {
    return b"expanded"
  }
  if tokens.equal(value, b"150%") {
    return b"extra-expanded"
  }
  if tokens.equal(value, b"200%") {
    return b"ultra-expanded"
  }
  if tokens.equal(value, b"normal") || tokens.equal(value, b"ultra-condensed")
    || tokens.equal(value, b"extra-condensed")
    || tokens.equal(value, b"condensed")
    || tokens.equal(value, b"semi-condensed")
    || tokens.equal(value, b"semi-expanded")
    || tokens.equal(value, b"expanded")
    || tokens.equal(value, b"extra-expanded")
    || tokens.equal(value, b"ultra-expanded") {
    return value
  }
  return b""
}

effect fn word(out: &mut Bytes, value: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value.length == 0 {
    return
  }
  if out.length() != 0 {
    run out.append(b" ")
  }
  run out.append(value)
}

pub effect fn fourSides(values: &[Bytes]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if values.length != 4 {
    return Bytes.make()
  }
  let mut allSame = true
  let mut hasWide = false
  let mut at: usize = 0
  while at < 4 {
    if text(values, at).length == 0 {
      return Bytes.make()
    }
    if !tokens.equal(text(values, at), text(values, 0)) {
      allSame = false
    }
    if wide(text(values, at)) {
      hasWide = true
    }
    at = at + 1
  }
  if hasWide {
    return if allSame {
      run Bytes.copy(text(values, 0))
    } else {
      Bytes.make()
    }
  }
  let mut count: usize = 4
  if tokens.equal(text(values, 1), text(values, 3)) {
    count = 3
    if tokens.equal(text(values, 0), text(values, 2)) {
      count = 2
      if tokens.equal(text(values, 0), text(values, 1)) {
        count = 1
      }
    }
  }
  let mut out = Bytes.make()
  at = 0
  while at < count {
    run word(&mut out, text(values, at))
    at = at + 1
  }
  return move out
}

// Canonical component serializers quote strings and balance functions. Splitting their
// top-level lists can therefore use one bounded pass without lexing or allocating.
fn listEnd(value: &[u8], start: usize) -> usize {
  let mut at = start
  let mut depth: usize = 0
  let mut quoted = false
  while at < value.length {
    let byte = value[at]
    if byte == 92 {
      at = at + 1
      if at < value.length {
        at = at + 1
      }
      continue
    }
    if byte == 34 {
      quoted = !quoted
    }
    if !quoted {
      if byte == 40 || byte == 91 {
        depth = depth + 1
      }
      if (byte == 41 || byte == 93) && depth != 0 {
        depth = depth - 1
      }
      if byte == 44 && depth == 0 {
        return at
      }
    }
    at = at + 1
  }
  return at
}

fn listPart(value: &[u8], start: usize, end: usize) -> &[u8] {
  let mut first = start
  let mut last = end
  while first < last && value[first] == 32 {
    first = first + 1
  }
  while last > first && value[last - 1] == 32 {
    last = last - 1
  }
  return Slice.view<u8>(value, first, last - first)
}

pub effect fn serialize(property: Property, values: &[Bytes]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = properties.longhandCount(property)
  if values.length != count || count == 0 {
    return Bytes.make()
  }
  let mut same = true
  let mut hasWide = false
  let mut at: usize = 0
  while at < count {
    if text(values, at).length == 0 {
      return Bytes.make()
    }
    if !tokens.equal(text(values, 0), text(values, at)) {
      same = false
    }
    if wide(text(values, at)) {
      hasWide = true
    }
    at = at + 1
  }
  if hasWide {
    return if same {
      run Bytes.copy(text(values, 0))
    } else {
      Bytes.make()
    }
  }
  if count == 1 {
    return run Bytes.copy(text(values, 0))
  }
  let mut out = Bytes.make()
  if property == Property.All {
    return move out
  }
  if property == Property.Marker {
    return if same {
      run Bytes.copy(text(values, 0))
    } else {
      move out
    }
  }
  if property == Property.Overflow {
    run word(&mut out, text(values, 0))
    if !same {
      run word(&mut out, text(values, 1))
    }
    return move out
  }
  if property == Property.TextAlign {
    if is(values, 1, b"auto") {
      return run Bytes.copy(text(values, 0))
    }
    if is(values, 0, b"justify") && is(values, 1, b"justify") {
      return run Bytes.copy(b"justify-all")
    }
    return move out
  }
  if property == Property.WhiteSpace {
    if is(values, 2, b"none") {
      if is(values, 0, b"collapse") && is(values, 1, b"wrap") {
        return run Bytes.copy(b"normal")
      }
      if is(values, 0, b"collapse") && is(values, 1, b"nowrap") {
        return run Bytes.copy(b"nowrap")
      }
      if is(values, 0, b"preserve") && is(values, 1, b"nowrap") {
        return run Bytes.copy(b"pre")
      }
      if is(values, 0, b"preserve") && is(values, 1, b"wrap") {
        return run Bytes.copy(b"pre-wrap")
      }
      if is(values, 0, b"preserve-breaks") && is(values, 1, b"wrap") {
        return run Bytes.copy(b"pre-line")
      }
      if is(values, 0, b"break-spaces") && is(values, 1, b"wrap") {
        return run Bytes.copy(b"break-spaces")
      }
    }
    if !is(values, 0, b"collapse") {
      run word(&mut out, text(values, 0))
    }
    if !is(values, 1, b"wrap") {
      run word(&mut out, text(values, 1))
    }
    if !is(values, 2, b"none") {
      run word(&mut out, text(values, 2))
    }
    return move out
  }
  if property == Property.FontSynthesis {
    let names = [b"weight", b"style", b"small-caps", b"position"]
    at = 0
    while at < 4 {
      if is(values, at, b"auto") {
        run word(&mut out, names[at])
      } else if !is(values, at, b"none") {
        return Bytes.make()
      }
      at = at + 1
    }
    return if out.length() == 0 {
      run Bytes.copy(b"none")
    } else {
      move out
    }
  }
  if property == Property.FontVariant {
    if is(values, 0, b"none") {
      at = 1
      while at < count {
        if !is(values, at, b"normal") {
          return move out
        }
        at = at + 1
      }
      return run Bytes.copy(b"none")
    }
    at = 0
    while at < count {
      if !is(values, at, b"normal") {
        run word(&mut out, text(values, at))
      }
      at = at + 1
    }
    return if out.length() == 0 {
      run Bytes.copy(b"normal")
    } else {
      move out
    }
  }
  if property == Property.Font {
    // All reset-only longhands must be at their initial values. Only small-caps
    // from font-variant is representable by the font shorthand grammar.
    at = 1
    while at < 8 {
      if at == 2 {
        if !is(values, at, b"normal") && !is(values, at, b"small-caps") {
          return move out
        }
      } else if !is(values, at, b"normal") {
        return move out
      }
      at = at + 1
    }
    at = 13
    while at < count {
      if !is(values, at, properties.initial(properties.longhandAt(property, at))) {
        return move out
      }
      at = at + 1
    }
    if !is(values, 0, b"normal") {
      run word(&mut out, text(values, 0))
    }
    if !is(values, 2, b"normal") {
      run word(&mut out, text(values, 2))
    }
    if !is(values, 8, b"normal") && !is(values, 8, b"400") {
      run word(&mut out, text(values, 8))
    }
    let width = fontWidth(text(values, 9))
    if width.length == 0 {
      return Bytes.make()
    }
    if !tokens.equal(width, b"normal") {
      run word(&mut out, width)
    }
    run word(&mut out, text(values, 10))
    if !is(values, 11, b"normal") {
      run out.append(b" / ")
      run out.append(text(values, 11))
    }
    run word(&mut out, text(values, 12))
    return move out
  }
  if property == Property.TextDecoration || property == Property.TextEmphasis {
    at = 0
    while at < count {
      if !is(values, at, properties.initial(properties.longhandAt(property, at))) {
        run word(&mut out, text(values, at))
      }
      at = at + 1
    }
    return if out.length() == 0 {
      run Bytes.copy(b"none")
    } else {
      move out
    }
  }
  if property == Property.VerticalAlign {
    if !is(values, 0, b"auto") {
      run word(&mut out, text(values, 0))
    }
    if !is(values, 1, b"baseline") {
      run word(&mut out, text(values, 1))
    }
    if !is(values, 2, b"0") && !is(values, 2, b"0px") {
      run word(&mut out, text(values, 2))
    }
    return if out.length() == 0 {
      run Bytes.copy(b"baseline")
    } else {
      move out
    }
  }
  if property == Property.MaskBorder {
    run word(&mut out, text(values, 0))
    if !is(values, 2, b"0") || !is(values, 3, b"auto") || !is(values, 4, b"0") {
      run word(&mut out, text(values, 2))
      if !is(values, 3, b"auto") || !is(values, 4, b"0") {
        run out.append(b" / ")
        run out.append(text(values, 3))
      }
      if !is(values, 4, b"0") {
        run out.append(b" / ")
        run out.append(text(values, 4))
      }
    }
    if !is(values, 5, b"stretch") {
      run word(&mut out, text(values, 5))
    }
    if !is(values, 1, b"alpha") {
      run word(&mut out, text(values, 1))
    }
    return move out
  }
  if property == Property.Mask || property == Property.Animation {
    if property == Property.Mask {
      at = 8
      while at < count {
        if !is(values, at, properties.initial(properties.longhandAt(property, at))) {
          return move out
        }
        at = at + 1
      }
    }
    let mut starts: [usize; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    while true {
      let mut ends: [usize; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
      at = 0
      while at < 8 {
        ends[at] = listEnd(text(values, at), starts[at])
        if starts[at] >= ends[at] {
          return Bytes.make()
        }
        at = at + 1
      }
      if out.length() != 0 {
        run out.append(b", ")
      }
      let mut layer = Bytes.make()
      if property == Property.Animation {
        // The name is last: a name that is also a keyword must not steal an omitted component.
        let order: [usize; 8] = [1, 2, 3, 4, 5, 6, 7, 0]
        at = 0
        while at < 8 {
          let slot = order[at]
          run word(&mut layer, listPart(text(values, slot), starts[slot], ends[slot]))
          at = at + 1
        }
      } else {
        run word(&mut layer, listPart(text(values, 0), starts[0], ends[0]))
        let position = listPart(text(values, 3), starts[3], ends[3])
        let size = listPart(text(values, 6), starts[6], ends[6])
        if !tokens.equal(position, b"0% 0%") || !tokens.equal(size, b"auto") {
          run word(&mut layer, position)
          if !tokens.equal(size, b"auto") {
            run layer.append(b" / ")
            run layer.append(size)
          }
        }
        let repeat = listPart(text(values, 2), starts[2], ends[2])
        if !tokens.equal(repeat, b"repeat") {
          run word(&mut layer, repeat)
        }
        let origin = listPart(text(values, 5), starts[5], ends[5])
        let clip = listPart(text(values, 4), starts[4], ends[4])
        if !tokens.equal(origin, b"border-box") || !tokens.equal(clip, b"border-box") {
          run word(&mut layer, origin)
          if !tokens.equal(origin, clip) {
            run word(&mut layer, clip)
          }
        }
        let composite = listPart(text(values, 7), starts[7], ends[7])
        let mode = listPart(text(values, 1), starts[1], ends[1])
        if !tokens.equal(composite, b"add") {
          run word(&mut layer, composite)
        }
        if !tokens.equal(mode, b"match-source") {
          run word(&mut layer, mode)
        }
      }
      run out.append(Bytes.asSlice(&layer))
      let done = ends[0] == text(values, 0).length
      at = 0
      while at < 8 {
        if (ends[at] == text(values, at).length) != done {
          return Bytes.make()
        }
        starts[at] = ends[at] + 1
        at = at + 1
      }
      if done {
        return move out
      }
    }
  }
  return move out
}
