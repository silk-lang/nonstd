//! Live Typed OM maps borrow the same declaration block as CSSStyleDeclaration/InlineStyle.
import typed_om { StyleValues, StyleValue, Value, propertyName, listValued, containsVariables }
import typed_om_unparsed { customPropertyName }
import typed_om_numeric { BaseType, NumericType, UnitValue }
import cssom_declaration { StyleDeclaration }
import cssom_inline { InlineStyle }
import cssom_error { CssomError }
import properties { Property }
import properties
import lexer
import tokens { Kind, Limits, CssError }
import tokens
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub union StyleInput<'a> {
  Text { pub value: &'a [u8] },
  Typed { pub value: &'a StyleValue },
}

impl<'a> Copy for StyleInput<'a> {}

pub struct StylePropertyMapReadOnly<'a> {
  declaration: &'a StyleDeclaration
}

impl<'a> StylePropertyMapReadOnly<'a> {
  pub fn make(declaration: &'a StyleDeclaration) -> StylePropertyMapReadOnly<'a> {
    return StylePropertyMapReadOnly<'a> { declaration: declaration }
  }

  pub fn size(self: &Self) -> usize {
    return self.declaration.length()
  }

  pub fn key(self: &Self, index: usize) -> &[u8] {
    return self.declaration.item(index)
  }

  pub effect fn has(self: &Self, property: &[u8]) -> bool
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    let value = run self.declaration.getPropertyValue(Bytes.asSlice(&name))
    return value.length() != 0
  }

  pub effect fn getAll(
    self: &Self,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> List<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    let text = run self.declaration.getPropertyValue(Bytes.asSlice(&name))
    if text.length() == 0 {
      return List<StyleValue>.make()
    }
    return run store.reifyAll(Bytes.asSlice(&name), Bytes.asSlice(&text), false, limits)
  }

  pub effect fn get(
    self: &Self,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> Option<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut values = run self.getAll(&mut store.*, property, limits)
    if values.length() == 0 {
      return Option<StyleValue>.None
    }
    return Option<StyleValue>.some(values.remove(0))
  }
}

union Target<'a> {
  Declaration { style: &'a mut StyleDeclaration },
  Inline { style: &'a mut InlineStyle },
}

/// Borrowed object identity is the authoritative declaration, not a copied style map.
pub struct StylePropertyMap<'a> {
  target: Target<'a>
}

impl<'a> StylePropertyMap<'a> {
  pub fn forDeclaration(style: &'a mut StyleDeclaration) -> StylePropertyMap<'a> {
    return StylePropertyMap<'a> { target: Target.Declaration { style: move style } }
  }

  pub fn forInline(style: &'a mut InlineStyle) -> StylePropertyMap<'a> {
    return StylePropertyMap<'a> { target: Target.Inline { style: move style } }
  }

  pub fn readOnly(self: &Self) -> StylePropertyMapReadOnly<'_> {
    return StylePropertyMapReadOnly.make(
      match &self.target {
        Target.Declaration { style } => &style.*
        Target.Inline { style } => style.style()
      },
    )
  }

  pub fn size(self: &Self) -> usize {
    return self.readOnly().size()
  }

  pub fn key(self: &Self, index: usize) -> &[u8] {
    return match &self.target {
      Target.Declaration { style } => style.item(index)
      Target.Inline { style } => style.style().item(index)
    }
  }

  pub effect fn has(self: &Self, property: &[u8]) -> bool
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return run self.readOnly().has(property)
  }

  pub effect fn getAll(
    self: &Self,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> List<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    return run self.readOnly().getAll(&mut store.*, property, limits)
  }

  pub effect fn get(
    self: &Self,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> Option<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    return run self.readOnly().get(&mut store.*, property, limits)
  }

  effect fn assign(self: &mut Self, property: &[u8], text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    match &mut self.target {
      Target.Declaration { style } => {
        run style.setTypedProperty(property, text, limits)
      }
      Target.Inline { style } => {
        let changed = run style.setTypedProperty(property, text, limits)
      }
    }
  }

  pub effect fn set(
    self: &mut Self,
    store: &mut StyleValues,
    property: &[u8],
    inputs: &[StyleInput<'_>],
    limits: &Limits,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    let canonical = Bytes.asSlice(&name)
    if inputs.length == 0 || !listValued(canonical) && inputs.length > 1 {
      fail CssomError.TypeError
    }
    let text = run prepare(&mut store.*, canonical, inputs, false, limits)
    run self.assign(canonical, Bytes.asSlice(&text), limits)
  }

  pub effect fn append(
    self: &mut Self,
    store: &mut StyleValues,
    property: &[u8],
    inputs: &[StyleInput<'_>],
    limits: &Limits,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    let canonical = Bytes.asSlice(&name)
    if !listValued(canonical) {
      fail CssomError.TypeError
    }
    let mut text = run self.readOnly().declaration.getPropertyValue(canonical)
    let existing = run lexer.tokenize(Bytes.asSlice(&text), limits)
    if containsVariables(&existing, existing.all()) {
      fail CssomError.TypeError
    }
    let additional = run prepare(&mut store.*, canonical, inputs, true, limits)
    if additional.length() == 0 {
      return ()
    }
    if text.length() != 0 {
      run text.append(b", ")
    }
    run text.append(Bytes.asSlice(&additional))
    run self.assign(canonical, Bytes.asSlice(&text), limits)
  }

  pub effect fn delete(self: &mut Self, property: &[u8]) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    match &mut self.target {
      Target.Declaration { style } => {
        let removed = run style.removeProperty(Bytes.asSlice(&name))
      }
      Target.Inline { style } => {
        let removed = run style.removeProperty(Bytes.asSlice(&name))
      }
    }
  }

  pub effect fn clear(self: &mut Self, limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    match &mut self.target {
      Target.Declaration { style } => {
        run style.setCssText(b"", limits)
      }
      Target.Inline { style } => {
        run style.setCssText(b"", limits)
      }
    }
  }
}

effect fn prepare(
  store: &mut StyleValues,
  property: &[u8],
  inputs: &[StyleInput<'_>],
  appending: bool,
  limits: &Limits,
) -> Bytes
  ! CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at: usize = 0
  while at < inputs.length {
    let text = match &inputs[at] {
      StyleInput.Text { value } => {
        let parsed = run store.parse(property, value, limits)
        if parsed.unparsed() && (appending || inputs.length > 1) {
          fail CssomError.TypeError
        }
        run parsed.internalText(&store.*)
      }
      StyleInput.Typed { value } => {
        match &value.associatedProperty() {
          Option<&[u8]>.Some { value: associated } => {
            if !tokens.equal(associated, property) {
              fail CssomError.TypeError
            }
          }
          _ => {}
        }
        if value.unparsed() && (appending || inputs.length > 1) {
          fail CssomError.TypeError
        }
        if customPropertyName(property) && !value.unparsed() {
          fail CssomError.TypeError
        }
        match &value.value {
          Value.Keyword { value: keyword } => {
            let buffer = run lexer.tokenize(keyword.value(), limits)
            if buffer.all().end != 1
              || !match &buffer.tokens.asSlice()[0].kind {
                Kind.Ident { text } => tokens.equal(buffer.text(text), keyword.value())
                _ => false
              } {
              fail CssomError.TypeError
            }
          }
          Value.Numeric { id } => {
            if !numericMatches(property, store.numeric.typeOf(id)) {
              fail CssomError.TypeError
            }
          }
          _ => {}
        }
        let text = run value.internalText(&store.*)
        let wrap = match &value.value {
          Value.Numeric { id } => match &store.numeric.unitValue(id) {
            Option<UnitValue>.Some { value: unit } => outsideRange(property, unit.value)
            _ => false
          }
          _ => false
        }
        if wrap {
          let mut calculation = Bytes.make()
          run calculation.append(b"calc(")
          run calculation.append(Bytes.asSlice(&text))
          run calculation.append(b")")
          move calculation
        } else {
          move text
        }
      }
    }
    if at != 0 {
      run out.append(b", ")
    }
    run out.append(Bytes.asSlice(&text))
    at = at + 1
  }
  return move out
}

fn numericMatches(property: &[u8], numericType: NumericType) -> bool {
  let known = match &properties.lookup(property) {
    Option<Property>.Some { value } => properties.canonical(value)
    _ => {
      return false
    }
  }
  return match known {
    Property.Width => numericType.matches(BaseType.Length, true)
    Property.Height => numericType.matches(BaseType.Length, true)
    Property.InlineSize => numericType.matches(BaseType.Length, true)
    Property.X => numericType.matches(BaseType.Length, true)
    Property.Y => numericType.matches(BaseType.Length, true)
    Property.Cx => numericType.matches(BaseType.Length, true)
    Property.Cy => numericType.matches(BaseType.Length, true)
    Property.R => numericType.matches(BaseType.Length, true)
    Property.Rx => numericType.matches(BaseType.Length, true)
    Property.Ry => numericType.matches(BaseType.Length, true)
    Property.StrokeWidth => numericType.matches(BaseType.Length, true)
    Property.StrokeDashoffset => numericType.matches(BaseType.Length, true)
    Property.FontSize => numericType.matches(BaseType.Length, true)
    Property.LetterSpacing => numericType.matches(BaseType.Length, false)
    Property.WordSpacing => numericType.matches(BaseType.Length, true)
    Property.TextDecorationThickness => numericType.matches(BaseType.Length, true)
    Property.Perspective => numericType.matches(BaseType.Length, false)
    Property.ShapeMargin => numericType.matches(BaseType.Length, true)
    Property.BaselineShift => numericType.matches(BaseType.Length, true)
    Property.VerticalAlign => numericType.matches(BaseType.Length, true)
    Property.FontStretch => numericType.isPercent()
    Property.FontWidth => numericType.isPercent()
    Property.LineHeight => numericType.isNumber() || numericType.matches(BaseType.Length, true)
    Property.TabSize => numericType.isNumber() || numericType.matches(BaseType.Length, false)
    Property.AnimationDuration => numericType.matches(BaseType.Time, false)
    Property.AnimationDelay => numericType.matches(BaseType.Time, false)
    _ => true
  }
}

fn outsideRange(property: &[u8], number: f64) -> bool {
  let known = match &properties.lookup(property) {
    Option<Property>.Some { value } => properties.canonical(value)
    _ => {
      return false
    }
  }
  return match known {
    Property.StrokeMiterlimit => number < 1.0
    Property.FontWeight => number < 1.0 || number > 1000.0
    Property.Width => number < 0.0
    Property.Height => number < 0.0
    Property.InlineSize => number < 0.0
    Property.R => number < 0.0
    Property.Rx => number < 0.0
    Property.Ry => number < 0.0
    Property.StrokeWidth => number < 0.0
    Property.FontSize => number < 0.0
    Property.FontSizeAdjust => number < 0.0
    Property.FontStretch => number < 0.0
    Property.FontWidth => number < 0.0
    Property.LineHeight => number < 0.0
    Property.TabSize => number < 0.0
    Property.ShapeMargin => number < 0.0
    Property.Perspective => number < 0.0
    Property.TextDecorationThickness => number < 0.0
    Property.AnimationDuration => number < 0.0
    Property.AnimationIterationCount => number < 0.0
    _ => false
  }
}
