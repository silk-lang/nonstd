//! Pinned CSS Images 3 SHA256 74eb4b475aa0845a50ebedb4bbb3ba7bf3966f975817d1c5cf8e3d512f53447e.
import properties { Property }
import properties
import values { Store, Mode, ValueId }
import values
import input { Input }
import lexer
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

effect fn valid(text: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let property = match &properties.lookup(b"image-rendering") {
    Option<Property>.Some { value } => value
    _ => {
      return false
    }
  }
  let tokens = run lexer.tokenize(text, &Limits.make())
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let mut store = Store.make()
  return (run values.parse(&mut store, property, &input, Mode.Css)).isSome()
}

// https://www.w3.org/TR/css-images-3/#the-image-rendering
test effect fn renderingKeywordGrammar() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let yes: [string; 9] = [
    "auto",
    "smooth",
    "high-quality",
    "pixelated",
    "crisp-edges",
    "optimizeSpeed",
    "optimizeQuality",
    "inherit",
    "unset",
  ]
  let mut i: usize = 0
  while i < yes.length {
    let result = run valid(String.utf8Bytes(yes[i])) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(result, "CSS Images 3 rendering keyword or legacy alias is accepted")
    i = i + 1
  }
  let no: [string; 5] = [
    "crispEdges",
    "nearest-neighbor",
    "smooth pixelated",
    "pixelated 2",
    "none",
  ]
  i = 0
  while i < no.length {
    let result = run valid(String.utf8Bytes(no[i])) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(!result, "rendering rejects foreign keywords and extra components")
    i = i + 1
  }
}
