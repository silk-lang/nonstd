//! Grammar cases are anchored to the pinned Filter Effects 1, Masking 1, Shapes 1,
//! Images 3 and SVG 1.1 bytes in images/svg/specs.lock.json.
import effect_values { EffectValue, Filter, Image, GradientStop, GeometryBox, MaskMode, Size }
import effect_values
import properties { Property }
import dimensions
import dimensions { Store, Context }
import colors { Color, Context as ColorContext }
import colors
import value_cursor { Cursor }
import input { Input, TokenRef }
import lexer
import tokens { Limits, CssError, equal }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn parseValue(numerics: &mut dimensions.Store, property: Property, text: &[u8]) -> Option<
  EffectValue
>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  return run parseIn(&mut numerics.*, property, text, false)
}

effect fn parseIn(
  numerics: &mut dimensions.Store,
  property: Property,
  text: &[u8],
  presentation: bool,
) -> Option<EffectValue>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(text, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let result = run effect_values.parse(
    &mut numerics.*,
    property,
    &source,
    &mut cursor,
    presentation,
  )
  if !cursor.done(&source) {
    return Option<EffectValue>.None
  }
  return move result
}

effect fn accepts(property: Property, text: &[u8], expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run acceptsIn(property, text, false, expected)
}

effect fn acceptsIn(property: Property, text: &[u8], presentation: bool, expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let result = run parseIn(&mut numerics, property, text, presentation)
  let accepted = match &result {
    Option<EffectValue>.Some { value } => true
    _ => false
  }
  run Testing.expect(accepted == expected, "effect grammar acceptance")
}

// https://www.w3.org/TR/filter-effects-1/#typedef-filter-value-list
// https://www.w3.org/TR/filter-effects-1/#funcdef-filter-drop-shadow
// https://www.w3.org/TR/filter-effects-1/#funcdef-filter-hue-rotate
test effect fn filterGrammarAndOwnedStructure() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run filterCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn filterCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let result = run parseValue(
    &mut numerics,
    Property.Filter,
    b"url('fx.svg#A') blur(2em) drop-shadow(red -3px 4px 2px) hue-rotate(720deg)",
  )
  run Testing.expect(
    match &result {
      Option<EffectValue>.Some { value } => match &value {
        EffectValue.Filters { items } => items.length() == 4
          && match &items.asSlice()[0] {
            Filter.Url { url } => equal(url.asSlice(), b"fx.svg#A")
            _ => false
          }
        _ => false
      }
      _ => false
    },
    "filter chain retains order and decoded resource URL",
  )
  run accepts(
    Property.Filter,
    b"blur() brightness() contrast(200%) grayscale(2) hue-rotate(0) invert() opacity() saturate(3) sepia()",
    true,
  )
  run accepts(Property.Filter, b"drop-shadow(1px 2px currentColor)", true)
  run accepts(Property.Filter, b"drop-shadow(red 1px 2px)", true)
  run accepts(Property.Filter, b"drop-shadow(1px red 2px)", false)
  run accepts(Property.Filter, b"drop-shadow(1px 2px -1px)", false)
  run accepts(Property.Filter, b"drop-shadow(inset 1px 2px)", false)
  run accepts(Property.Filter, b"drop-shadow(1px 2px 3px 4px)", false)
  run accepts(Property.Filter, b"blur(2%)", false)
  run accepts(Property.Filter, b"blur(-1px)", false)
  run accepts(Property.Filter, b"brightness(-1)", false)
  run accepts(Property.Filter, b"hue-rotate(2)", false)
  run accepts(Property.Filter, b"none blur(0)", false)
  run accepts(Property.Filter, b"url(#a), blur(1px)", false)
  run accepts(Property.Filter, b"url('x' junk)", false)

  // https://www.w3.org/TR/2018/CR-SVG2-20181004/types.html#presentation-attribute-css-value:
  // presentation attributes admit unitless lengths and angles throughout the grammar.
  run acceptsIn(Property.Filter, b"blur(4)", true, true)
  run acceptsIn(Property.Filter, b"drop-shadow(10 15 2)", true, true)
  run acceptsIn(Property.Filter, b"hue-rotate(90)", true, true)
  run acceptsIn(Property.Filter, b"blur(4)", false, false)
  run acceptsIn(Property.Filter, b"drop-shadow(10 15)", false, false)
  run acceptsIn(Property.Filter, b"blur(-4)", true, false)
}

// https://www.w3.org/TR/css-masking-1/#typedef-mask-layer
// https://www.w3.org/TR/css-masking-1/#propdef-mask-border
// https://www.w3.org/TR/css-masking-1/#propdef-mask-border-slice
test effect fn maskLayerAndBorderGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run maskCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn maskCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(
    Property.Mask,
    b"url(#m) right 10px bottom 20% / 30px auto repeat-x padding-box no-clip subtract alpha, none",
    true,
  )
  run accepts(Property.Mask, b"no-clip padding-box", true)
  run accepts(Property.Mask, b"url(#a) url(#b)", false)
  run accepts(Property.Mask, b"alpha luminance", false)
  run accepts(Property.Mask, b"center / cover / contain", false)
  run accepts(Property.Mask, b"/ cover", false)
  run accepts(Property.Mask, b"none,", false)
  run accepts(Property.MaskOrigin, b"fill-box, view-box, margin-box", true)
  run accepts(Property.MaskOrigin, b"no-clip", false)
  run accepts(Property.MaskClip, b"no-clip, stroke-box", true)
  run accepts(Property.MaskRepeat, b"repeat-x, round space", true)
  run accepts(Property.MaskRepeat, b"repeat-x repeat", false)
  run accepts(Property.MaskSize, b"auto, contain, 10% 2em", true)
  run accepts(Property.MaskSize, b"10px -2px", false)
  run accepts(Property.MaskMode, b"alpha, luminance, match-source", true)
  run accepts(Property.MaskComposite, b"add, subtract, intersect, exclude", true)
  run accepts(
    Property.MaskBorder,
    b"url(#b) 10% 20 fill / 2 auto / 3px 4 round space luminance",
    true,
  )
  run accepts(Property.MaskBorder, b"10 / / 2", true)
  run accepts(Property.MaskBorder, b"10 /", false)
  run accepts(Property.MaskBorder, b"alpha luminance", false)
  run accepts(Property.MaskBorderSlice, b"10 20 30 40 fill", true)
  run accepts(Property.MaskBorderSlice, b"fill 10", false)
  run accepts(Property.MaskBorderSlice, b"10px", false)
  run accepts(Property.MaskBorderWidth, b"auto 20% 2 1em", true)
  run accepts(Property.MaskBorderOutset, b"1 2px 3 4em", true)
  run accepts(Property.MaskBorderOutset, b"10%", false)
  run accepts(Property.MaskBorderRepeat, b"round stretch", true)
  run accepts(Property.MaskBorderRepeat, b"no-repeat", false)
}

// https://www.w3.org/TR/css-images-3/#linear-gradient-syntax
// https://www.w3.org/TR/css-images-3/#radial-gradient-syntax
// https://www.w3.org/TR/css-images-3/#color-stop-syntax
test effect fn maskGradientGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run gradientCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn gradientCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(
    Property.MaskImage,
    b"linear-gradient(to top right, red 10%, blue 2em), repeating-radial-gradient(5em circle at top left, yellow, blue)",
    true,
  )
  run accepts(
    Property.MaskImage,
    b"radial-gradient(20% 40% at right bottom, transparent, black)",
    true,
  )
  run accepts(Property.MaskImage, b"linear-gradient(red, 20%, blue)", true)
  run accepts(Property.MaskImage, b"linear-gradient(red)", false)
  run accepts(Property.MaskImage, b"linear-gradient(red, 20%, 30%, blue)", false)
  run accepts(Property.MaskImage, b"linear-gradient(to left right, red, blue)", false)
  run accepts(Property.MaskImage, b"radial-gradient(circle 20%, red, blue)", false)
  run accepts(Property.MaskImage, b"radial-gradient(ellipse 10px, red, blue)", false)
  run accepts(Property.MaskImage, b"radial-gradient(-1px, red, blue)", false)
  run accepts(Property.MaskImage, b"linear-gradient(red 0% 20%, blue)", false)
}

// https://www.w3.org/TR/css-shapes-1/#supported-basic-shapes
// https://www.w3.org/TR/css-shapes-1/#funcdef-basic-shape-path
// https://www.w3.org/TR/css-shapes-1/#shape-function
// https://www.w3.org/TR/css-masking-1/#propdef-clip-path
test effect fn clipShapesRejectPartialGeometry() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shapeCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn shapeCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(Property.ClipPath, b"inset(1em 2% round 2px 3px / 4px) fill-box", true)
  run accepts(Property.ClipPath, b"stroke-box ellipse(20% 30% at right 10px bottom 20px)", true)
  run accepts(Property.ClipPath, b"circle(closest-corner)", true)
  run accepts(Property.ClipPath, b"xywh(0 0 10px 20%)", true)
  run accepts(Property.ClipPath, b"rect(auto 100% 40px 0 round 5%)", true)
  run accepts(Property.ClipPath, b"polygon(evenodd round 2px, 0 0, 100% 0, 50% 100%)", true)
  run accepts(Property.ClipPath, b"path(evenodd, 'M0 0L10 0 10 10z')", true)
  run accepts(Property.ClipPath, b"path('M0 0L10')", false)
  run accepts(Property.ClipPath, b"path('M0 0z garbage')", false)
  run accepts(Property.ClipPath, b"path('')", true)
  run accepts(Property.ClipPath, b"circle(-2px)", false)
  run accepts(Property.ClipPath, b"inset(1px round -2px)", false)
  run accepts(Property.ClipPath, b"xywh(0 0 -1px 2px)", false)
  run accepts(Property.ClipPath, b"polygon(0 0, 1px)", false)
  run accepts(Property.ClipPath, b"url(#a) fill-box", false)
  run accepts(
    Property.ClipPath,
    b"shape(from 0 0, line to 100% 0, curve by 0 20% with 10px 0 / 20px 20px, arc to 0 0 of 20% cw large rotate 30deg, close)",
    true,
  )
  run accepts(Property.ClipPath, b"shape(from 0 0, curve to 10px 20px)", false)
  run accepts(Property.ClipPath, b"shape(from 0 0, arc to 10px 20px cw)", false)
}

// https://www.w3.org/TR/css-masking-1/#clip-property
// https://www.w3.org/TR/2011/REC-SVG11-20110816/filters.html#EnableBackgroundProperty
test effect fn legacyRectangleAndBackgroundGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run legacyCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn legacyCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(Property.Clip, b"rect(auto, 1em, -2px, auto)", true)
  run accepts(Property.Clip, b"rect(auto 1em -2px auto)", true)
  run accepts(Property.Clip, b"rect(auto, 1em -2px, auto)", false)
  run accepts(Property.Clip, b"rect(0, 100%, 20px, 0)", false)
  run accepts(Property.EnableBackground, b"new -10 20 100 200", true)
  run accepts(Property.EnableBackground, b"new", true)
  run accepts(Property.EnableBackground, b"new 0 0 10", false)
  run accepts(Property.EnableBackground, b"new 0 0 -10 20", false)
  run accepts(Property.EnableBackground, b"new 0px 0 10 20", false)
  run accepts(Property.EnableBackground, b"accumulate 0 0 10 20", false)
}

// https://www.w3.org/TR/filter-effects-1/#funcdef-filter-drop-shadow
// https://www.w3.org/TR/filter-effects-1/#funcdef-filter-grayscale
// https://www.w3.org/TR/css-images-3/#computed-image
test effect fn computedEffectsResolveMetricsAndCurrentColor() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run computeCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn computeCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let context = Context.make(200.0, 100.0, 16.0)
  let palette = [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]
  let colorContext = ColorContext.make(Color.srgb(0.25, 0.5, 0.75, 1.0), palette)
  let specified = match run parseValue(
    &mut numerics,
    Property.Filter,
    b"blur(2em) drop-shadow(1em 2px) grayscale(200%)",
  ) {
    Option<EffectValue>.Some { value } => move value
    _ => {
      run Testing.expect(false, "specified filter parses")
      return
    }
  }
  let computed = run effect_values.compute(&specified, &mut numerics, &context, &colorContext)
  run Testing.expect(
    match &computed {
      EffectValue.Filters { items } => match &items.asSlice()[0] {
        Filter.Function { kind, amount } => dimensions.evaluate(&numerics, amount, 0.0) == 32.0
        _ => false
      }
      _ => false
    },
    "relative filter blur resolves using supplied font size",
  )
  run Testing.expect(
    match &computed {
      EffectValue.Filters { items } => match &items.asSlice()[1] {
        Filter.DropShadow { x, y, blur, color } => {
          let rgba = colors.toSrgb(color)
          dimensions.evaluate(&numerics, x, 0.0) == 16.0 && rgba.r == 0.25 && rgba.g == 0.5
            && rgba.b == 0.75
        }
        _ => false
      }
      _ => false
    },
    "omitted shadow color computes to host currentColor",
  )
  run Testing.expect(
    match &computed {
      EffectValue.Filters { items } => match &items.asSlice()[2] {
        Filter.Function { kind, amount } => dimensions.evaluate(&numerics, amount, 1.0) == 1.0
        _ => false
      }
      _ => false
    },
    "grayscale amount clamps above its maximum",
  )
  let image = match run parseValue(
    &mut numerics,
    Property.MaskImage,
    b"linear-gradient(currentColor 25%, blue 2em)",
  ) {
    Option<EffectValue>.Some { value } => move value
    _ => {
      run Testing.expect(false, "gradient parses")
      return
    }
  }
  let computedImage = run effect_values.compute(&image, &mut numerics, &context, &colorContext)
  run Testing.expect(
    match &computedImage {
      EffectValue.Masks { layers, resetBorder } => match &layers.asSlice()[0].image {
        Image.Linear { repeating, direction, stops } => match &stops.asSlice()[0] {
          GradientStop.ColorStop { color, position } => match &position {
            Option<dimensions.ExprId>.Some { value } => dimensions.evaluate(&numerics, value, 200.0)
              == 50.0
              && colors.toSrgb(color).g == 0.5
            _ => false
          }
          _ => false
        }
        _ => false
      }
      _ => false
    },
    "gradient computes colors but keeps reference-dependent stop percentages",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/text.html#TextShapeInside
// https://www.w3.org/TR/2018/CR-SVG2-20181004/text.html#TextShapeSubtract
test effect fn textWrappingShapeLists() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wrappingCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wrappingCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(Property.ShapeInside, b"circle(20px) url(#next)", true)
  run accepts(Property.ShapeSubtract, b"url(#hole) inset(10px)", true)
  run accepts(Property.ShapeInside, b"auto", true)
  run accepts(Property.ShapeSubtract, b"none", true)
  run accepts(Property.ShapeInside, b"circle(20px), url(#next)", false)
  run accepts(Property.ShapeSubtract, b"border-box", false)
}

// https://www.w3.org/TR/css-masking-1/#the-mask
// https://www.w3.org/TR/css-masking-1/#propdef-mask-border-mode
test effect fn maskShorthandCarriesBorderReset() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run resetCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn resetCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let parsed = run parseValue(&mut numerics, Property.Mask, b"padding-box no-clip url(#mask)")
  run Testing.expect(
    match &parsed {
      Option<EffectValue>.Some { value } => match &value {
        EffectValue.Masks { layers, resetBorder } => layers.length() == 1
          && layers.asSlice()[0].origin == GeometryBox.Padding
          && layers.asSlice()[0].clip == GeometryBox.NoClip
          && resetBorder.mode == MaskMode.Alpha
          && match &resetBorder.image {
            Image.None => true
            _ => false
          }
        _ => false
      }
      _ => false
    },
    "mask shorthand stores two-box semantics and all mask-border initial values",
  )
}

// https://www.w3.org/TR/css-values-4/#url-value
// https://www.w3.org/TR/css-images-3/#linear-gradient-syntax
test effect fn urlAliasesAndUnitlessZeroAngles() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run urlAndAngleCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn urlAndAngleCases() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run accepts(Property.Filter, b"src('#f') hue-rotate(0)", true)
  run accepts(Property.MaskImage, b"src('mask.svg')", true)
  run accepts(Property.ClipPath, b"src('#c')", true)
  run accepts(Property.MaskImage, b"linear-gradient(0, red, blue)", true)
  run accepts(Property.MaskImage, b"linear-gradient(1, red, blue)", false)
  run accepts(Property.Filter, b"src(#f)", false)
  run accepts(Property.ClipPath, b"url('#c' unknown)", false)
}

// https://www.w3.org/TR/css-values-4/#url-value
// https://www.w3.org/TR/css-variables-1/#substitute-a-var
test effect fn expandedInputKeepsUrlTokenBoundaries() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run expandedCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn expandedCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let first = run lexer.tokenize(b"src(", &Limits.make())
  let second = run lexer.tokenize(b"'mask.svg')", &Limits.make())
  let buffers = [move first, move second]
  let references = [
    TokenRef { buffer: 0, token: 0 },
    TokenRef { buffer: 1, token: 0 },
    TokenRef { buffer: 1, token: 1 },
  ]
  let source = Input.Expanded { buffers: &buffers, references: &references }
  let mut cursor = Cursor.make(&source)
  let parsed = run effect_values.parse(
    &mut numerics,
    Property.MaskImage,
    &source,
    &mut cursor,
    false,
  )
  run Testing.expect(
    cursor.done(&source)
      && match &parsed {
        Option<EffectValue>.Some { value } => match &value {
          EffectValue.Masks { layers, resetBorder } => match &layers.asSlice()[0].image {
            Image.Url { url } => equal(url.asSlice(), b"mask.svg")
            _ => false
          }
          _ => false
        }
        _ => false
      },
    "expanded input uses logical token positions, not source-buffer matching indices",
  )
}

// https://www.w3.org/TR/css-values-4/#calc-range
// https://www.w3.org/TR/css-masking-1/#propdef-mask-size
test effect fn maskSizeClampingWaitsForPercentageBasis() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rangeCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rangeCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut numerics = Store.make()
  let specified = match run parseValue(&mut numerics, Property.MaskSize, b"calc(10% - 20px) auto") {
    Option<EffectValue>.Some { value } => move value
    _ => {
      run Testing.expect(false, "calc range is not checked until computation")
      return
    }
  }
  let context = Context.make(200.0, 100.0, 16.0)
  let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
  let colorContext = ColorContext.make(black, [black; 19])
  let computed = run effect_values.compute(&specified, &mut numerics, &context, &colorContext)
  run Testing.expect(
    match &computed {
      EffectValue.Masks { layers, resetBorder } => match &layers.asSlice()[0].size {
        Size.Explicit { x, y } => match &x {
          Option<dimensions.ExprId>.Some { value } => dimensions.evaluate(&numerics, value, 100.0)
            == 0.0
            && dimensions.evaluate(&numerics, value, 300.0) == 10.0
          _ => false
        }
        _ => false
      }
      _ => false
    },
    "computed nonnegative range retains the unresolved reference box",
  )
}
