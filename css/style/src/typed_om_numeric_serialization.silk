//! CSS Typed OM §6.3–6.5 authored operation serialization, without algebraic folding.
import typed_om_numeric { NumericStore, NumericId, NumericOperator, UnitValue }
import cssom_serialization { appendNumber }
import tokens { equal }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

effect fn appendUnit(out: &mut Bytes, value: UnitValue) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let finite = f64.isFinite(value.value)
  if !finite {
    run out.append(b"calc(")
    if value.value != value.value {
      run out.append(b"NaN")
    } else if value.value < 0.0 {
      run out.append(b"-infinity")
    } else {
      run out.append(b"infinity")
    }
    if !equal(value.unit, b"number") {
      run out.append(b" * 1")
    }
  } else {
    run appendNumber(&mut out.*, value.value)
  }
  if equal(value.unit, b"percent") {
    run out.append(b"%")
  } else if !equal(value.unit, b"number") {
    run out.append(value.unit)
  }
  if !finite {
    run out.append(b")")
  }
}

pub effect fn append(
  out: &mut Bytes,
  store: &NumericStore,
  id: NumericId,
  nested: bool,
  parenless: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &store.unitValue(id) {
    Option<UnitValue>.Some { value } => {
      run appendUnit(&mut out.*, value)
      return
    }
    _ => {}
  }
  let operation = store.operator(id)
  let children = store.children(id)
  let function = operation == NumericOperator.Min || operation == NumericOperator.Max
    || operation == NumericOperator.Clamp
  if function {
    run out.append(
      if operation == NumericOperator.Min {
        b"min("
      } else if operation == NumericOperator.Max {
        b"max("
      } else {
        b"clamp("
      },
    )
  } else if !parenless {
    run out.append(
      if nested {
        b"("
      } else {
        b"calc("
      },
    )
  }
  if operation == NumericOperator.Negate {
    run out.append(b"-")
  }
  if operation == NumericOperator.Invert {
    run out.append(b"1 / ")
  }
  let mut i: usize = 0
  while i < children.length {
    let mut child = children[i]
    if i != 0 {
      if function {
        run out.append(b", ")
      } else if operation == NumericOperator.Sum {
        if store.operator(child) == NumericOperator.Negate {
          run out.append(b" - ")
          child = store.children(child)[0]
        } else {
          run out.append(b" + ")
        }
      } else {
        if store.operator(child) == NumericOperator.Invert {
          run out.append(b" / ")
          child = store.children(child)[0]
        } else {
          run out.append(b" * ")
        }
      }
    }
    run append(&mut out.*, store, child, true, function)
    i = i + 1
  }
  if function || !parenless {
    run out.append(b")")
  }
}

pub effect fn serialize(store: &NumericStore, id: NumericId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = Bytes.make()
  run append(&mut result, store, id, false, false)
  return move result
}
