//! CSSOM fetch-response processing. The host transport supplies Fetch's final response metadata.
import cssom_stylesheet { StyleSheet }
import cssom_error { CssomError }
import encoding { Encoding }
import encoding
import tokens { Limits, CssError, CssErrorKind, insensitive }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Response<'a> {
  pub bytes: &'a [u8],
  /// Parsed MIME essence, without parameters, from the transport's Content-Type metadata.
  pub mediaType: &'a [u8],
  pub protocolEncoding: Option<Encoding>,
  /// Fetch's CORS-same-origin classification, not a string comparison of URL hosts.
  pub corsSameOrigin: bool,
  pub networkError: bool,
}

/// Returns the selected encoding for descendant imports, or None when Fetch rejects the response.
/// Rejected responses leave the old stylesheet intact. The host resolves URLs and performs Fetch;
/// CSS decoding, quirks MIME handling, parsing and origin-clean state are handled here.
pub effect fn loadResponse(
  sheet: &mut StyleSheet,
  response: &Response<'_>,
  quirksMode: bool,
  environmentEncoding: Option<Encoding>,
  limits: &Limits,
) -> Option<Encoding>
  ! CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  if response.networkError {
    return Option<Encoding>.None
  }
  if !insensitive(response.mediaType, b"text/css") && !(quirksMode && response.corsSameOrigin) {
    return Option<Encoding>.None
  }
  if response.bytes.length > limits.maxInputBytes {
    fail CssError { kind: CssErrorKind.InputLimit, offset: limits.maxInputBytes }
  }
  let decoded = run encoding.decodeStylesheet(
    response.bytes,
    response.protocolEncoding,
    environmentEncoding,
    limits.maxInputBytes,
  )
  run sheet.load(Bytes.asSlice(&decoded.bytes), limits)
  sheet.originClean = response.corsSameOrigin
  return Option<Encoding>.some(decoded.encoding)
}
