//! CSSOM View rectangle, visibility, viewport boundary and scroll alignment regressions.
import cssom_view {
  boundingRect,
  alignAxis,
  normalizeScroll,
  pointInViewport,
  checkVisibility,
  ScrollLogicalPosition,
  CheckVisibilityOptions,
  VisibilityState,
  DocumentState,
  NO_VIEW_NODE,
  ScrollRoute,
  scrollRoute,
  elementClientExtent,
  elementScrollOffset
}
import cssom_geometry { DOMRect }
import silk.num.f64
import silk.testing.testing { Testing, AssertionError }

test effect fn viewBoundingRectIncludesThinFragmentsUnlessAllFragmentsAreDegenerate() -> ()
  ! AssertionError<'static> {
  let rects = [
    DOMRect.make(100.0, 200.0, 0.0, 4.0),
    DOMRect.make(20.0, 30.0, 10.0, 10.0),
    DOMRect.make(5.0, 8.0, 20.0, 15.0),
  ]
  let bounds = boundingRect(&rects)
  run Testing.expect(
    bounds.x == 5.0 && bounds.y == 8.0 && bounds.width == 95.0 && bounds.height == 196.0,
    "getBoundingClientRect includes every fragment with nonzero width or height when a nondegenerate fragment exists",
  )
  let empty = [DOMRect.make(8.0, 9.0, 0.0, 4.0), DOMRect.make(1.0, 2.0, 6.0, 0.0)]
  let first = boundingRect(&empty)
  run Testing.expect(
    first.x == 8.0 && first.y == 9.0 && first.height == 4.0,
    "all-empty rectangles preserve the first rectangle, not zero origin",
  )
}

test effect fn viewNearestAlignmentHandlesCoveringAndOversizedTargets() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    alignAxis(-10.0, 110.0, 0.0, 100.0, ScrollLogicalPosition.Nearest, false) == 0.0,
    "a target covering both edges must not scroll",
  )
  run Testing.expect(
    alignAxis(-40.0, 80.0, 0.0, 100.0, ScrollLogicalPosition.Nearest, false) == -20.0,
    "oversized start-overflow target aligns the opposite edge",
  )
  run Testing.expect(
    alignAxis(20.0, 140.0, 0.0, 100.0, ScrollLogicalPosition.Nearest, false) == 20.0,
    "oversized end-overflow target aligns the start edge",
  )
  run Testing.expect(
    alignAxis(120.0, 140.0, 0.0, 100.0, ScrollLogicalPosition.Start, true) == 40.0,
    "RTL logical start is the physical high edge",
  )
  run Testing.expect(
    alignAxis(120.0, 140.0, 0.0, 100.0, ScrollLogicalPosition.Center, false) == 80.0,
    "center aligns centers",
  )
}

test effect fn viewVisibilityOptionsRespectAliasesAndAncestors() -> ()
  ! AssertionError<'static> {
  let mut state = VisibilityState {
    hasBox: true,
    ancestorContentHidden: false,
    ancestorContentAutoSkipped: false,
    zeroOpacity: true,
    visible: false,
  }
  let mut options = CheckVisibilityOptions.make()
  run Testing.expect(
    checkVisibility(state, options),
    "default visibility does not inspect opacity or visibility",
  )
  options.opacityProperty = true
  run Testing.expect(!checkVisibility(state, options), "zero ancestor opacity is opt-in")
  options.opacityProperty = false
  options.checkVisibilityCSS = true
  run Testing.expect(!checkVisibility(state, options), "historical visibility alias is effective")
  options.checkVisibilityCSS = false
  state.ancestorContentHidden = true
  run Testing.expect(
    !checkVisibility(state, options),
    "hidden content ancestor always suppresses visibility",
  )
  state.ancestorContentHidden = false
  state.ancestorContentAutoSkipped = true
  run Testing.expect(checkVisibility(state, options), "auto skipping is opt-in")
  options.contentVisibilityAuto = true
  run Testing.expect(!checkVisibility(state, options), "auto skipping is checked when requested")
}

test effect fn viewNormalizesNonfiniteScrollButRejectsNonfiniteHitCoordinates() -> ()
  ! AssertionError<'static> {
  let infinity = f64.fromBits(9218868437227405312)
  run Testing.expect(
    normalizeScroll(infinity) == 0.0 && normalizeScroll(-infinity) == 0.0,
    "nonfinite scroll values normalize to zero",
  )
  run Testing.expect(
    !pointInViewport(infinity, 1.0, 100.0, 50.0),
    "nonfinite hit coordinates do not hit",
  )
  run Testing.expect(
    pointInViewport(100.0, 50.0, 100.0, 50.0),
    "CSSOM rejects greater-than, not equal viewport edge",
  )
  run Testing.expect(
    !pointInViewport(100.01, 50.0, 100.0, 50.0),
    "coordinates beyond viewport fail",
  )
}

test effect fn viewDocumentQuirksForwardingUsesExplicitHostState() -> ()
  ! AssertionError<'static> {
  let mut document = DocumentState {
    active: true,
    hasWindow: true,
    hasViewport: true,
    quirksMode: false,
    root: 1,
    body: 2,
    bodyPotentiallyScrollable: false,
    viewportWidth: 800.0,
    viewportHeight: 600.0,
    viewportScrollX: 10.0,
    viewportScrollY: 30.0,
    scrollingWidth: 1000.0,
    scrollingHeight: 1200.0,
  }
  run Testing.expect(document.scrollingElement() == 1, "standards document scrolls its root")
  run Testing.expect(
    elementScrollOffset(document, 1, true, 4.0, false) == 30.0,
    "root scroll offset forwards to actual window state",
  )
  document.quirksMode = true
  run Testing.expect(
    document.scrollingElement() == 2 && scrollRoute(document, 1, true, true) == ScrollRoute.None,
    "quirks mode forwards body instead of root",
  )
  document.bodyPotentiallyScrollable = true
  run Testing.expect(
    document.scrollingElement() == NO_VIEW_NODE,
    "potentially-scrollable quirks body is not the document scroller",
  )
  run Testing.expect(
    elementClientExtent(document, 2, false, false, 12.0, 0.0, true) == 0.0,
    "missing boxes return zero before viewport-special-case dimensions",
  )
}
