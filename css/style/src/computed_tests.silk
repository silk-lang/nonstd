//! CSS Cascade4/Variables1 computed values, distinct from used geometry.
import computed { Engine, HostContext, StyleId, ComputedError }
import computed
import cascade { Declaration, Target, Specified, Candidate, Priority, Origin }
import values { Value, ValueId, Mode, Paint, Fallback, IccId }
import values
import properties { Property }
import properties
import dimensions
import dimensions { Context }
import colors { Color, Identity, Context as ColorContext }
import colors
import text_values { TextValue, Atom, Keyword as TextKeyword }
import text_values
import value_cursor { Cursor }
import value_keywords { Keyword }
import effect_values { MaskMode }
import computed_queries { MaskItem, BorderItem }
import lexer
import input { Input }
import tokens { TokenBuffer, Limits, CssError }
import tokens
import variables
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn parsed(engine: &mut Engine, property: Property, source: &[u8]) -> ValueId
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let result = run values.parse(&mut engine.values, property, &input, Mode.Css)
  return match &result {
    Option<ValueId>.Some { value } => value
    _ => {
      fail ComputedError { property: property }
    }
  }
}

effect fn add(
  engine: &mut Engine,
  catalog: &mut List<Declaration>,
  candidates: &mut List<Candidate>,
  property: Property,
  source: &[u8],
) -> ()
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let value = run parsed(&mut engine.*, property, source)
  let index = catalog.length()
  run catalog.append(
    Declaration {
      target: Target.Property { property: property },
      specified: Specified.Parsed { value: value },
      buffer: 0,
      important: false,
    },
  )
  run candidates.append(
    Candidate { declaration: index, priority: Priority.make(Origin.Author, index) },
  )
}

fn whitespaceKeys(
  engine: &Engine,
  style: StyleId,
  property: Property,
  expected: &[TextKeyword],
) -> bool {
  let entry = match &engine.get(style, property) {
    Option<computed.ComputedValue>.Some { value } => value
    _ => {
      return false
    }
  }
  return match &engine.values.get(entry.value).* {
    Value.Text { value } => {
      if value.property != property || value.items.length() != expected.length {
        return false
      }
      let mut i: usize = 0
      while i < expected.length {
        if value.items.asSlice()[i].property != property {
          return false
        }
        match &value.items.asSlice()[i].atom {
          Atom.Keyword { value: key } => {
            if key != expected[i] {
              return false
            }
          }
          _ => {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

// Pinned Text4 106c5cd086ab23b0edea5aa3ff6876b61cc623154f728aa269b74f0527dba19d:
// https://www.w3.org/TR/css-text-4/#white-space-property
// https://www.w3.org/TR/css-text-4/#propdef-white-space-collapse
// https://www.w3.org/TR/css-text-4/#white-space-trim
// https://www.w3.org/TR/css-text-4/#text-wrap-mode
// Pinned SVG2ED dbbc1f8bcb1a3b05777d1ec03dac8040738b02941142018e44e2e02dad691195:
// https://svgwg.org/svg2-draft/styling.html#UAStyleSheet
// https://www.w3.org/TR/css-cascade-4/#all-shorthand
// https://www.w3.org/TR/css-variables-1/#variables-in-shorthands
effect fn whitespaceCascade() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run pending(
    &mut buffers,
    &mut declarations,
    &mut candidates,
    Property.WhiteSpaceCollapse,
    b"preserve-spaces",
    Origin.UserAgent,
  )
  let ua = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(&engine, ua, Property.WhiteSpaceCollapse, &[TextKeyword.PreserveSpaces]) {
    return false
  }
  run add(
    &mut engine,
    &mut declarations,
    &mut candidates,
    Property.WhiteSpaceTrim,
    b"discard-inner",
  )
  run add(&mut engine, &mut declarations, &mut candidates, Property.WhiteSpace, b"normal")
  let author = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(&engine, author, Property.WhiteSpaceCollapse, &[TextKeyword.Collapse])
    || !whitespaceKeys(&engine, author, Property.WhiteSpaceTrim, &[TextKeyword.None]) {
    return false
  }
  run pending(
    &mut buffers,
    &mut declarations,
    &mut candidates,
    Property.WhiteSpace,
    b"var(--missing, preserve nowrap discard-inner discard-after discard-before)",
    Origin.Author,
  )
  let parent = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(&engine, parent, Property.WhiteSpaceCollapse, &[TextKeyword.Preserve])
    || !whitespaceKeys(&engine, parent, Property.TextWrapMode, &[TextKeyword.Nowrap])
    || !whitespaceKeys(
      &engine,
      parent,
      Property.WhiteSpaceTrim,
      &[TextKeyword.DiscardBefore, TextKeyword.DiscardAfter, TextKeyword.DiscardInner],
    ) {
    return false
  }
  let mut childCandidates = List<Candidate>.make()
  let before = engine.values.values.length()
  let child = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  if before != engine.values.values.length()
    || !whitespaceKeys(&engine, child, Property.WhiteSpaceCollapse, &[TextKeyword.Preserve])
    || !whitespaceKeys(&engine, child, Property.TextWrapMode, &[TextKeyword.Nowrap])
    || !whitespaceKeys(&engine, child, Property.WhiteSpaceTrim, &[TextKeyword.None]) {
    return false
  }
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.WhiteSpace, b"inherit")
  let inherited = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(
    &engine,
    inherited,
    Property.WhiteSpaceTrim,
    &[TextKeyword.DiscardBefore, TextKeyword.DiscardAfter, TextKeyword.DiscardInner],
  ) {
    return false
  }
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.All, b"unset")
  let unset = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(&engine, unset, Property.WhiteSpaceCollapse, &[TextKeyword.Preserve])
    || !whitespaceKeys(&engine, unset, Property.TextWrapMode, &[TextKeyword.Nowrap])
    || !whitespaceKeys(&engine, unset, Property.WhiteSpaceTrim, &[TextKeyword.None]) {
    return false
  }
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.All, b"initial")
  let initial = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  if !whitespaceKeys(&engine, initial, Property.WhiteSpaceCollapse, &[TextKeyword.Collapse])
    || !whitespaceKeys(&engine, initial, Property.TextWrapMode, &[TextKeyword.Wrap])
    || !whitespaceKeys(&engine, initial, Property.WhiteSpaceTrim, &[TextKeyword.None]) {
    return false
  }
  run add(&mut engine, &mut declarations, &mut candidates, Property.WhiteSpace, b"revert")
  let reverted = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  return whitespaceKeys(
    &engine,
    reverted,
    Property.WhiteSpaceCollapse,
    &[TextKeyword.PreserveSpaces],
  )
}

test effect fn whitespaceUaAuthorVariablesAndDefaulting() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run whitespaceCascade() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "author whitespace shorthand overrides UA xml-space collapse, projects variables and resets or inherits each longhand independently",
  )
}

// https://www.w3.org/TR/css-cascade-4/#inheriting
// https://www.w3.org/TR/css-color-4/#resolving-other-colors
// https://www.w3.org/TR/css-values-4/#font-relative-lengths
// https://www.w3.org/TR/2018/CR-SVG2-20181004/text.html#TextDecorationFillStroke
effect fn dependencies() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut candidates, Property.Color, b"red")
  run add(&mut engine, &mut declarations, &mut candidates, Property.Fill, b"currentColor")
  run add(&mut engine, &mut declarations, &mut candidates, Property.FontSize, b"20px")
  run add(&mut engine, &mut declarations, &mut candidates, Property.StrokeWidth, b"2em")
  let parent = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let mut childCandidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.Color, b"blue")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.FontSize, b"150%")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.X, b"calc(25% + 1em)")
  let child = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  let fill = engine.get(child, Property.Fill)
  let inherited = match &fill {
    Option<computed.ComputedValue>.Some { value } => match &engine.values.get(value.value).* {
      Value.Paint { paint } => match &paint {
        Paint.Color { color } => match &color.identity {
          Identity.CurrentColor => true
          _ => false
        }
        _ => false
      }
      _ => false
    }
    _ => false
  }
  let stroke = engine.number(child, Property.StrokeWidth, 100.0)
  let x = engine.number(child, Property.X, 200.0)
  let size = engine.textNumber(child, Property.FontSize, 0.0)
  return inherited
    && match &stroke {
      Option<f64>.Some { value } => value == 40.0
      _ => false
    }
    && match &x {
      Option<f64>.Some { value } => value == 80.0
      _ => false
    }
    && match &size {
      Option<f64>.Some { value } => value == 30.0
      _ => false
    }
}

test effect fn computedInheritanceAndDependencyBoundaries() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run dependencies() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "inherit computed lengths, preserve currentColor and geometry percentages, compute font percentages first",
  )
}

// https://www.w3.org/TR/css-cascade-4/#initial-values
// https://www.w3.org/TR/css-cascade-4/#all-shorthand
effect fn allInitials() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let declarations = List<Declaration>.make()
  let candidates = List<Candidate>.make()
  let root = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let before = engine.values.values.length()
  let child = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.some(root),
    &host,
    &Limits.make(),
  )
  if before != engine.values.values.length() {
    return false
  }
  let all = properties.all()
  let mut i: usize = 0
  while i < all.length {
    let property = all[i]
    if properties.longhandCount(property) == 1 {
      match &engine.get(child, property) {
        Option<computed.ComputedValue>.Some { value } => {
          if !values.validComputed(&engine.values, value.value) {
            return false
          }
        }
        _ => {
          return false
        }
      }
    }
    i = i + 1
  }
  return true
}

test effect fn everyLonghandDefaultsAndSharesImmutableValues() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run allInitials() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "every longhand has a computed initial and an unstyled child allocates no values",
  )
}

effect fn pending(
  buffers: &mut List<TokenBuffer>,
  catalog: &mut List<Declaration>,
  candidates: &mut List<Candidate>,
  property: Property,
  source: &[u8],
  origin: Origin,
) -> ()
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let range = buffer.all()
  let sourceId = buffers.length()
  run buffers.append(move buffer)
  let index = catalog.length()
  run catalog.append(
    Declaration {
      target: Target.Property { property: property },
      specified: Specified.Pending { range: range, mode: Mode.Css },
      buffer: sourceId,
      important: false,
    },
  )
  run candidates.append(Candidate { declaration: index, priority: Priority.make(origin, index) })
}

// https://www.w3.org/TR/css-variables-1/#invalid-variables
// https://www.w3.org/TR/css-cascade-4/#default
// https://www.w3.org/TR/css-cascade-4/#valdef-all-revert
effect fn invalidAndRevert() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut candidates, Property.Fill, b"red")
  run add(&mut engine, &mut declarations, &mut candidates, Property.Opacity, b".25")
  run add(&mut engine, &mut declarations, &mut candidates, Property.FontPalette, b"dark")
  let parent = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let mut childCandidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.Fill, b"blue")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.Opacity, b".5")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.FontPalette, b"light")
  run add(
    &mut engine,
    &mut declarations,
    &mut childCandidates,
    Property.FontPalette,
    b"palette-mix(in srgb, normal calc(50% - 50%), light calc(50% - 50%))",
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut childCandidates,
    Property.Fill,
    b"var(--missing)",
    Origin.Author,
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut childCandidates,
    Property.Opacity,
    b"var(--missing)",
    Origin.Author,
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut childCandidates,
    Property.StrokeWidth,
    b"7px",
    Origin.User,
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut childCandidates,
    Property.StrokeWidth,
    b"var(--missing, revert)",
    Origin.Author,
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut childCandidates,
    Property.MarkerStart,
    b"var(--missing, url(marker.svg#p))",
    Origin.Author,
  )
  let sourceId = buffers.length() - 1
  let child = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  let inherited = match &engine.get(parent, Property.Fill) {
    Option<computed.ComputedValue>.Some { value: p } => match &engine.get(child, Property.Fill) {
      Option<computed.ComputedValue>.Some { value: c } => p.value.index == c.value.index
      _ => false
    }
    _ => false
  }
  let opacity = match &engine.number(child, Property.Opacity, 1.0) {
    Option<f64>.Some { value } => value == 1.0
    _ => false
  }
  let width = match &engine.number(child, Property.StrokeWidth, 0.0) {
    Option<f64>.Some { value } => value == 7.0
    _ => false
  }
  let source = match &engine.get(child, Property.MarkerStart) {
    Option<computed.ComputedValue>.Some { value } => match &value.sourceBuffer {
      Option<usize>.Some { value: buffer } => buffer == sourceId
      _ => false
    }
    _ => false
  }
  let palette = match &engine.get(parent, Property.FontPalette) {
    Option<computed.ComputedValue>.Some { value: p } => match &engine.get(
      child,
      Property.FontPalette,
    ) {
      Option<computed.ComputedValue>.Some { value: c } => p.value.index == c.value.index
      _ => false
    }
    _ => false
  }
  return inherited && opacity && width && source && palette
}

test effect fn invalidComputedValuesDefaultWithoutEarlierFallback() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run invalidAndRevert() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "invalid variables unset, substituted revert rolls back origin, substituted URL keeps declaration base",
  )
}

// https://www.w3.org/TR/css-fonts-4/#font-prop
// https://www.w3.org/TR/css-cascade-4/#shorthand
// https://www.w3.org/TR/css-values-4/#font-relative-lengths
effect fn fontShorthandDependencies() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut candidates, Property.Font, b"italic 20px/150% serif")
  run add(&mut engine, &mut declarations, &mut candidates, Property.FontSize, b"40px")
  run add(&mut engine, &mut declarations, &mut candidates, Property.X, b"1lh")
  run add(&mut engine, &mut declarations, &mut candidates, Property.Y, b"1rem")
  let root = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let line = match &engine.textNumber(root, Property.LineHeight, 0.0) {
    Option<f64>.Some { value } => value == 60.0
    _ => false
  }
  let x = match &engine.number(root, Property.X, 0.0) {
    Option<f64>.Some { value } => value == 60.0
    _ => false
  }
  let y = match &engine.number(root, Property.Y, 0.0) {
    Option<f64>.Some { value } => value == 40.0
    _ => false
  }
  return line && x && y
}

test effect fn overriddenShorthandSizeControlsLonghandDependencies() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run fontShorthandDependencies() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "font line-height uses the winning font-size, lh uses computed line-height, root rem uses computed root size",
  )
}

effect fn hostFont(engine: &mut Engine, bytes: &[u8]) -> TextValue
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(bytes, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&source)
  let result = run text_values.parse(
    &mut engine.values.numerics,
    Property.Font,
    &source,
    &mut cursor,
    false,
  )
  return match move result {
    Option<TextValue>.Some { value } => move value
    _ => {
      fail ComputedError { property: Property.Font }
    }
  }
}

// https://www.w3.org/TR/css-fonts-4/#font-prop
// https://www.w3.org/TR/css-masking-1/#the-mask
// https://www.w3.org/TR/css-cascade-4/#all-shorthand
effect fn systemFontsMasksAndWideKeywords() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    run hostFont(&mut engine, b"11px serif"),
    run hostFont(&mut engine, b"12px serif"),
    run hostFont(&mut engine, b"13px serif"),
    run hostFont(&mut engine, b"14px serif"),
    run hostFont(&mut engine, b"15px serif"),
    run hostFont(&mut engine, b"16px serif"),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(Color.srgb(0.0, 0.0, 0.0, 1.0), [Color.srgb(0.0, 0.0, 0.0, 1.0); 19]),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let keywords: [&[u8]; 6] = [
    b"caption",
    b"icon",
    b"menu",
    b"message-box",
    b"small-caption",
    b"status-bar",
  ]
  let mut i: usize = 0
  while i < keywords.length {
    let mut declarations = List<Declaration>.make()
    let mut candidates = List<Candidate>.make()
    run add(&mut engine, &mut declarations, &mut candidates, Property.Font, keywords[i])
    let style = run engine.build(
      buffers.asSlice(),
      declarations.asSlice(),
      candidates.asSlice(),
      Option<StyleId>.None,
      &host,
      &Limits.make(),
    )
    match &engine.textNumber(style, Property.FontSize, 0.0) {
      Option<f64>.Some { value } => {
        if value != 11.0 + usize.toF64(i) {
          return false
        }
      }
      _ => {
        return false
      }
    }
    i = i + 1
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut candidates, Property.Fill, b"blue")
  run add(&mut engine, &mut declarations, &mut candidates, Property.Direction, b"rtl")
  run add(&mut engine, &mut declarations, &mut candidates, Property.All, b"initial")
  run add(&mut engine, &mut declarations, &mut candidates, Property.Mask, b"url(#mask) luminance")
  run add(&mut engine, &mut declarations, &mut candidates, Property.MaskType, b"alpha")
  let style = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let direction = match &engine.get(style, Property.Direction) {
    Option<computed.ComputedValue>.Some { value } => match &engine.values.get(value.value).* {
      Value.Keyword { keyword } => keyword == Keyword.Rtl
      _ => false
    }
    _ => false
  }
  let reset = match &engine.get(style, Property.Fill) {
    Option<computed.ComputedValue>.Some { value } => match &engine.values.get(value.value).* {
      Value.Paint { paint } => match &paint {
        Paint.Color { color } => color.channels[0] == 0.0 && color.channels[2] == 0.0
        _ => false
      }
      _ => false
    }
    _ => false
  }
  let mode = match &engine.maskItem(style, Property.MaskMode, 0) {
    Option<MaskItem>.Some { value } => match &value {
      MaskItem.Mode { value: mode } => mode == MaskMode.Luminance
      _ => false
    }
    _ => false
  }
  let border = match &engine.borderItem(style, Property.MaskBorderMode) {
    Option<BorderItem>.Some { value } => match &value {
      BorderItem.Mode { value: borderMode } => borderMode == MaskMode.Alpha
      _ => false
    }
    _ => false
  }
  return direction && reset && mode && border
}

test effect fn hostSystemFontsAndShorthandResetProjection() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run systemFontsMasksAndWideKeywords() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "all six host fonts resolve, all excludes direction, mask projects modes and resets border",
  )
}

// Pinned SVG11 painting 8705784776f7ae94cf8a17b56fe0fdacc8a2b5ae2993d8f507176b5c729c247c:
// https://www.w3.org/TR/2011/REC-SVG11-20110816/painting.html#SpecifyingPaint
// https://www.w3.org/TR/2011/REC-SVG11-20110816/types.html#DataTypeICCColor
// https://www.w3.org/TR/css-cascade-4/#inheriting
fn iccEntry(engine: &Engine, style: StyleId, property: Property) -> Option<IccId> {
  let entry = match &engine.get(style, property) {
    Option<computed.ComputedValue>.Some { value } => value
    _ => {
      return Option<IccId>.None
    }
  }
  return match &engine.values.get(entry.value).* {
    Value.IccColor { color, icc } => Option<IccId>.some(icc)
    Value.Paint { paint } => match &paint {
      Paint.IccColor { color, icc } => Option<IccId>.some(icc)
      Paint.Server { url, fallback } => match &fallback {
        Fallback.IccColor { color, icc } => Option<IccId>.some(icc)
        _ => Option<IccId>.None
      }
      _ => Option<IccId>.None
    }
    _ => Option<IccId>.None
  }
}

effect fn iccComputedRetention() -> bool
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  let closing = run variables.appendClosingBuffer(&mut buffers)
  let mut engine = Engine.make(closing)
  let family = run parsed(&mut engine, Property.FontFamily, b"serif")
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let host = HostContext {
    dimensions: Context.make(200.0, 100.0, 16.0),
    colors: ColorContext.make(
      Color.srgb(0.0, 0.0, 0.0, 1.0),
      [Color.srgb(0.25, 0.5, 0.75, 1.0); 19],
    ),
    systemFonts: &fonts,
    fontFamily: family,
    revision: 0,
  }
  let mut declarations = List<Declaration>.make()
  let mut candidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut candidates, Property.Color, b"blue")
  run add(
    &mut engine,
    &mut declarations,
    &mut candidates,
    Property.Fill,
    b"red icc-color(\\50 rintProfile, .1 .2, -3, 4, 5)",
  )
  run add(
    &mut engine,
    &mut declarations,
    &mut candidates,
    Property.Stroke,
    b"url(#paint) red icc-color(PrintProfile, .1 .2, -3, 4, 5)",
  )
  run add(
    &mut engine,
    &mut declarations,
    &mut candidates,
    Property.StopColor,
    b"red icc-color(PrintProfile, .1 .2, -3, 4, 5)",
  )
  run pending(
    &mut buffers,
    &mut declarations,
    &mut candidates,
    Property.FloodColor,
    b"var(--absent, red icc-color(PrintProfile, .1 .2, -3, 4, 5))",
    Origin.Author,
  )
  run add(
    &mut engine,
    &mut declarations,
    &mut candidates,
    Property.LightingColor,
    b"Canvas icc-color(PrintProfile, .1 .2, -3, 4, 5)",
  )
  let parent = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    candidates.asSlice(),
    Option<StyleId>.None,
    &host,
    &Limits.make(),
  )
  let mut childCandidates = List<Candidate>.make()
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.Color, b"green")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.StopColor, b"inherit")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.FloodColor, b"inherit")
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.LightingColor, b"inherit")
  let before = engine.values.iccColors.length()
  let child = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  if before != engine.values.iccColors.length() {
    return false
  }
  let properties = [
    Property.Fill,
    Property.Stroke,
    Property.StopColor,
    Property.FloodColor,
    Property.LightingColor,
  ]
  let mut i: usize = 0
  while i < 5 {
    let inherited = iccEntry(&engine, child, properties[i])
    let original = iccEntry(&engine, parent, properties[i])
    let id = match &inherited {
      Option<IccId>.Some { value } => value
      _ => {
        return false
      }
    }
    match &original {
      Option<IccId>.Some { value } => {
        if id.index != value.index {
          return false
        }
      }
      _ => {
        return false
      }
    }
    let metadata = engine.values.icc(id)
    if !tokens.equal(engine.values.text(metadata.profile), b"PrintProfile")
      || metadata.channels.length() != 5 {
      return false
    }
    let channels = metadata.channels.asSlice()
    if channels[0] != 0.1 || channels[1] != 0.2 || channels[2] != -3.0 || channels[3] != 4.0
      || channels[4] != 5.0 {
      return false
    }
    i = i + 1
  }
  let fill = match &engine.get(child, Property.Fill) {
    Option<computed.ComputedValue>.Some { value } => value
    _ => {
      return false
    }
  }
  let red = match &engine.values.get(fill.value).* {
    Value.Paint { paint } => match &paint {
      Paint.IccColor { color, icc } => color.channels[0] == 1.0 && color.channels[1] == 0.0
        && color.channels[2] == 0.0
      _ => false
    }
    _ => false
  }
  let lighting = match &engine.get(child, Property.LightingColor) {
    Option<computed.ComputedValue>.Some { value } => value
    _ => {
      return false
    }
  }
  let system = match &engine.values.get(lighting.value).* {
    Value.IccColor { color, icc } => match &color.identity {
      Identity.Absolute => color.channels[0] == 0.25 && color.channels[2] == 0.75
      _ => false
    }
    _ => false
  }
  run add(&mut engine, &mut declarations, &mut childCandidates, Property.Fill, b"currentColor")
  let current = run engine.build(
    buffers.asSlice(),
    declarations.asSlice(),
    childCandidates.asSlice(),
    Option<StyleId>.some(parent),
    &host,
    &Limits.make(),
  )
  let entry = match &engine.get(current, Property.Fill) {
    Option<computed.ComputedValue>.Some { value } => value
    _ => {
      return false
    }
  }
  let noIcc = match &engine.values.get(entry.value).* {
    Value.Paint { paint } => match &paint {
      Paint.Color { color } => match &color.identity {
        Identity.CurrentColor => true
        _ => false
      }
      _ => false
    }
    _ => false
  }
  return red && system && noIcc
}

test effect fn iccMetadataSurvivesComputationVariablesAndInheritance() -> ()
  ! AssertionError<'static> | CssError | ComputedError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run iccComputedRetention() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result,
    "computed ICC keeps profile bytes, every channel, shared inherited handles, RGB/system fallback, and a distinct currentColor branch",
  )
}
