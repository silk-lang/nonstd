//! Project typed text shorthand atoms before resolving their longhand dependencies.
//! CSS Text4 white-space stores all three expanded longhands, including omitted-value
//! resets and canonical trim combinations. This same projection handles var() results;
//! neither projection nor whitespace computation reparses source text.
import values { Store, Value, ValueId }
import values
import properties { Property }
import text_values { TextValue, Atom, Keyword, Item }
import text_values
import tokens { Span }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import value_keywords
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn systemIndex(keyword: Keyword) -> Option<usize> {
  return match keyword {
    Keyword.Caption => Option<usize>.some(0)
    Keyword.Icon => Option<usize>.some(1)
    Keyword.Menu => Option<usize>.some(2)
    Keyword.MessageBox => Option<usize>.some(3)
    Keyword.SmallCaption => Option<usize>.some(4)
    Keyword.StatusBar => Option<usize>.some(5)
    _ => Option<usize>.None
  }
}

effect fn own(out: &mut TextValue, source: &TextValue, span: Span) -> Span
  ! OutOfMemoryError
  ? &mut Allocator {
  let start = out.strings.asSlice().length
  let bytes = source.text(span)
  run Bytes.append(&mut out.strings, bytes)
  return Span { start: start, end: start + bytes.length }
}

effect fn projectText(source: &TextValue, target: Property) -> TextValue
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = TextValue.make(target)
  let mut i: usize = 0
  while i < source.items.length() {
    let item = source.items.asSlice()[i]
    if item.property == target {
      let atom = match &item.atom {
        Atom.Family { generic, name } => Atom.Family {
          generic: generic,
          name: run own(&mut out, source, name),
        }
        Atom.String { text } => Atom.String { text: run own(&mut out, source, text) }
        Atom.Alternate { kind, name } => Atom.Alternate {
          kind: kind,
          name: run own(&mut out, source, name),
        }
        _ => item.atom
      }
      run out.items.append(Item { property: target, atom: atom })
    }
    i = i + 1
  }
  if target == Property.FontPalette {
    i = 0
    while i < source.palettes.length() {
      let mut node = source.palettes.asSlice()[i]
      node.name = run own(&mut out, source, node.name)
      run out.palettes.append(node)
      i = i + 1
    }
    i = 0
    while i < source.paletteStops.length() {
      run out.paletteStops.append(source.paletteStops.asSlice()[i])
      i = i + 1
    }
  }
  return move out
}

pub effect fn project(
  store: &mut Store,
  id: ValueId,
  sourceProperty: Property,
  target: Property,
  systemFonts: &[TextValue; 6],
) -> ValueId
  ! OutOfMemoryError
  ? &mut Allocator {
  let keyword = values.projectKeyword(&store.*, id, sourceProperty, target)
  match &keyword {
    Option<value_keywords.Keyword>.Some { value } => {
      if sourceProperty == Property.TextAlign {
        return run store.add(Value.Keyword { keyword: value })
      }
    }
    _ => {}
  }
  let projected = match &store.get(id).* {
    Value.Text { value } => {
      let mut source = &value
      if value.property == Property.Font && value.items.length() == 1 {
        match &value.items.asSlice()[0].atom {
          Atom.Keyword { value: name } => match &systemIndex(name) {
            Option<usize>.Some { value: index } => {
              source = &systemFonts[index]
            }
            _ => {}
          }
          _ => {}
        }
      }
      if source.property == target {
        return id
      }
      Value.Text { value: run projectText(source, target) }
    }
    _ => {
      return id
    }
  }
  return run store.add(move projected)
}
