//! Media Queries 4 condition grammar and three-valued matching.
import media_queries
import media_features { Environment }
import input { Input, TokenRef }
import lexer
import tokens { Limits, CssError, CssErrorKind, TokenBuffer, TokenRange }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn query(bytes: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(bytes, &limits)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  return run media_queries.matches(&source, &Environment.headless(800.0, 600.0), &limits)
}

// https://www.w3.org/TR/mediaqueries-4/#mq-list
// https://www.w3.org/TR/mediaqueries-4/#error-handling
test effect fn mediaListRecoversOnlyInvalidArms() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run query(b"  ") |> Effect.provideMut<Allocator>(&mut allocator),
    "empty media list matches",
  )
  run Testing.expect(
    run query(b"layer, nonsense, screen") |> Effect.provideMut<Allocator>(&mut allocator),
    "invalid arm does not discard matching screen arm",
  )
  run Testing.expect(
    !run query(b",") |> Effect.provideMut<Allocator>(&mut allocator),
    "empty arms are invalid queries, not an empty list",
  )
  run Testing.expect(
    run query(b"not unknown") |> Effect.provideMut<Allocator>(&mut allocator),
    "unknown media types are false, not unknown",
  )
  run Testing.expect(
    !run query(b"not layer") |> Effect.provideMut<Allocator>(&mut allocator),
    "reserved media type invalidates query before negation",
  )
  run Testing.expect(
    !run query(b"screen garbage") |> Effect.provideMut<Allocator>(&mut allocator),
    "complete arm must match grammar",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#evaluating
// https://www.w3.org/TR/mediaqueries-4/#typedef-general-enclosed
test effect fn mediaUnknownUsesKleeneLogic() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    !run query(b"not (future-feature: 1)") |> Effect.provideMut<Allocator>(&mut allocator),
    "negated unknown remains unknown",
  )
  run Testing.expect(
    run query(b"(future-feature: 1) or (color)") |> Effect.provideMut<Allocator>(&mut allocator),
    "true OR unknown is true",
  )
  run Testing.expect(
    run query(b"not ((monochrome) and future())") |> Effect.provideMut<Allocator>(&mut allocator),
    "false AND unknown is false, then negates true",
  )
  run Testing.expect(
    !run query(b"not future()") |> Effect.provideMut<Allocator>(&mut allocator),
    "empty future function is unknown",
  )
  run Testing.expect(
    !run query(b"not ()") |> Effect.provideMut<Allocator>(&mut allocator),
    "empty parentheses are unknown",
  )
  run Testing.expect(
    !run query(b"not screen and (future: yes)") |> Effect.provideMut<Allocator>(&mut allocator),
    "media type negation cannot turn unknown feature true",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#mq-syntax
test effect fn mediaConditionOperatorsRespectGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run query(b"only SCREEN and (width >= 800px)") |> Effect.provideMut<Allocator>(&mut allocator),
    "only modifier and case-insensitive type",
  )
  run Testing.expect(
    !run query(b"screen and (color) or (width)") |> Effect.provideMut<Allocator>(&mut allocator),
    "type suffix excludes top-level or",
  )
  run Testing.expect(
    !run query(b"(color) and (width) or (height)") |> Effect.provideMut<Allocator>(&mut allocator),
    "and and or cannot mix without parentheses",
  )
  run Testing.expect(
    run query(b"screen and ((color) or (monochrome))")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "nested or is allowed after type",
  )
  run Testing.expect(
    !run query(b"not (monochrome) and (color)") |> Effect.provideMut<Allocator>(&mut allocator),
    "not consumes one parenthesized term, not a chain",
  )
  run Testing.expect(
    !run query(b"only (color)") |> Effect.provideMut<Allocator>(&mut allocator),
    "only requires media type",
  )
}

// https://www.w3.org/TR/css-syntax-3/#consume-simple-block
// https://www.w3.org/TR/css-syntax-3/#typedef-any-value
// https://www.w3.org/TR/mediaqueries-4/#error-handling
test effect fn mediaComponentsPreserveRecoveryBoundaries() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run query(b"(color") |> Effect.provideMut<Allocator>(&mut allocator),
    "EOF implicitly closes component block",
  )
  run Testing.expect(
    !run query(b"future(screen, print)") |> Effect.provideMut<Allocator>(&mut allocator),
    "nested comma does not create media list arms",
  )
  run Testing.expect(
    !run query(b"(color] ) or (width)") |> Effect.provideMut<Allocator>(&mut allocator),
    "unmatched closer invalidates condition despite true other operand",
  )
  run Testing.expect(
    run query(b"(color]), screen") |> Effect.provideMut<Allocator>(&mut allocator),
    "malformed component invalidates only its top-level list arm",
  )
}

effect fn expandedQuery() -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let first = run lexer.tokenize(b"print, screen", &limits)
  let second = run lexer.tokenize(b" and (color)", &limits)
  let mut buffers = List<TokenBuffer>.make()
  run buffers.append(move first)
  run buffers.append(move second)
  let mut refs = List<TokenRef>.make()

  // Start in the middle of buffer zero; expanded indices differ from original matching indices.
  run refs.append(TokenRef { buffer: 0, token: 3 })
  let mut i: usize = 0
  while i < buffers.asSlice()[1].all().end {
    run refs.append(TokenRef { buffer: 1, token: i })
    i = i + 1
  }
  let source = Input.Expanded { buffers: buffers.asSlice(), references: refs.asSlice() }
  return run media_queries.matches(&source, &Environment.headless(800.0, 600.0), &limits)
}

// https://www.w3.org/TR/mediaqueries-4/#mq-syntax
test effect fn mediaExpandedTokenReferencesKeepComponentIndexes() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run expandedQuery() |> Effect.provideMut<Allocator>(&mut allocator),
    "expanded Input never uses original matching indexes",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#media-types
test effect fn deprecatedMediaTypesNeverMatch() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    !run query(b"speech, aural, tty, tv, handheld, projection, braille, embossed")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "deprecated media types match nothing",
  )
  run Testing.expect(
    run query(b"not speech") |> Effect.provideMut<Allocator>(&mut allocator),
    "deprecated type is false rather than unknown",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#mq-syntax
test effect fn mediaChecksLimitsBeforeMatchingBranches() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let buffer = run lexer.tokenize(b"all, (((color)))", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut limits = Limits.make()
  limits.maxDepth = 1
  let result = run Effect.result(
    media_queries.matches(&source, &Environment.headless(800.0, 600.0), &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &result {
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "a matching first arm cannot bypass nesting limits",
  )
  limits = Limits.make()
  limits.maxTokens = 1
  let tokenResult = run Effect.result(
    media_queries.matches(&source, &Environment.headless(800.0, 600.0), &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &tokenResult {
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.TokenLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "matcher independently enforces caller token limit",
  )
  let invalid = Input.Contiguous { buffer: &buffer, range: TokenRange { start: 4, end: 1 } }
  run Testing.expect(
    !run media_queries.matches(&invalid, &Environment.headless(800.0, 600.0), &Limits.make())
      |> Effect.provideMut<Allocator>(&mut allocator),
    "invalid input range is not the valid empty media list",
  )
}
