//! ElementCSSInlineStyle state with explicit host attribute-change notification.
import cssom_declaration { StyleDeclaration }
import cssom_error { CssomError }
import tokens { Limits, CssError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The host owns node identity and delivers returned attribute changes to its mutation observers.
/// External attribute writes use `setAttribute`; CSSOM writes use the declaration methods below.
pub struct InlineStyle {
  pub ownerNode: usize,
  declaration: StyleDeclaration,
  attributeValue: Option<Bytes>,
}

impl InlineStyle {
  pub fn make(ownerNode: usize) -> InlineStyle {
    return InlineStyle {
      ownerNode: ownerNode,
      declaration: StyleDeclaration.make(),
      attributeValue: Option<Bytes>.None,
    }
  }

  pub fn style(self: &Self) -> &StyleDeclaration {
    return &self.declaration
  }

  pub fn attribute(self: &Self) -> Option<&[u8]> {
    return match &self.attributeValue {
      Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
      _ => Option<&[u8]>.None
    }
  }

  /// Parses an external attribute change while retaining its exact attribute spelling.
  /// This direction does not serialize or recursively write the attribute back to the host.
  pub effect fn setAttribute(self: &mut Self, value: Option<&[u8]>, limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let text = match &value {
      Option<&[u8]>.Some { value: bytes } => bytes
      _ => b""
    }
    let declaration = run StyleDeclaration.parse(text, limits)
    let attribute = match &value {
      Option<&[u8]>.Some { value: bytes } => Option<Bytes>.some(run Bytes.copy(bytes))
      _ => Option<Bytes>.None
    }
    self.declaration = move declaration
    self.attributeValue = move attribute
  }

  pub effect fn cssText(self: &Self) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.declaration.cssText()
  }

  /// CSSOM cssText assignment always updates the style attribute, even for an empty block.
  pub effect fn setCssText(self: &mut Self, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let declaration = run StyleDeclaration.parse(text, limits)
    let attribute = run declaration.cssText()
    self.declaration = move declaration
    self.attributeValue = Option<Bytes>.some(move attribute)
  }

  /// True means the host must deliver a style-attribute mutation. Invalid or equal setters return false.
  pub effect fn setProperty(
    self: &mut Self,
    name: &[u8],
    value: &[u8],
    priority: &[u8],
    limits: &Limits,
  ) -> bool
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let previous = self.declaration.mutationRevision()
    run self.declaration.setProperty(name, value, priority, limits)
    if self.declaration.mutationRevision() == previous {
      return false
    }
    self.attributeValue = Option<Bytes>.some(run self.declaration.cssText())
    return true
  }

  pub effect fn setTypedProperty(
    self: &mut Self,
    name: &[u8],
    value: &[u8],
    limits: &Limits,
  ) -> bool
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let previous = self.declaration.mutationRevision()
    run self.declaration.setTypedProperty(name, value, limits)
    if self.declaration.mutationRevision() == previous {
      return false
    }
    self.attributeValue = Option<Bytes>.some(run self.declaration.cssText())
    return true
  }

  /// Returns the removed value; mutationRevision reports whether the host attribute changed.
  pub effect fn removeProperty(self: &mut Self, name: &[u8]) -> Bytes
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let previous = self.declaration.mutationRevision()
    let value = run self.declaration.removeProperty(name)
    if self.declaration.mutationRevision() != previous {
      self.attributeValue = Option<Bytes>.some(run self.declaration.cssText())
    }
    return move value
  }

  pub fn mutationRevision(self: &Self) -> usize {
    return self.declaration.mutationRevision()
  }
}
