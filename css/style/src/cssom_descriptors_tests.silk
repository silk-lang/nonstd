//! Descriptor grammar boundaries and native CSSOM mutation behavior.
import cssom_declaration { StyleDeclaration }
import cssom_descriptors { Context }
import cssom_error { CssomError }
import tokens { Limits, CssError, equal }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn value(block: &StyleDeclaration, name: &[u8], expected: &[u8]) -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let text = run block.getPropertyValue(name)
  run Testing.expect(equal(Bytes.asSlice(&text), expected), "descriptor canonical value")
}

effect fn fonts() -> ()
  ! CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut block = run StyleDeclaration.parseFor(
    Context.FontFace,
    b"font-family: Silk UI; src: local(Silk UI), nonsense, url(silk.woff2) format(woff2) tech(variations); font-weight: 100 900; unicode-range: u+4??, U+0041; font-display: swap; ascent-override: 90%; color: red; font-style: italic !important",
    &limits,
  )
  run value(&block, b"font-family", b"\"Silk UI\"")
  run value(
    &block,
    b"src",
    b"local(\"Silk UI\"), url(\"silk.woff2\") format(\"woff2\") tech(variations)",
  )
  run value(&block, b"font-weight", b"100 900")
  run value(&block, b"unicode-range", b"U+400-4FF, U+41")
  run value(&block, b"font-display", b"swap")
  run value(&block, b"ascent-override", b"90%")
  run value(&block, b"color", b"")
  run value(&block, b"font-style", b"")
  run block.setProperty(b"font-weight", b"bolder", b"", &limits)
  run value(&block, b"font-weight", b"100 900")
  run block.setProperty(b"unicode-range", b"U+??F", b"", &limits)
  run value(&block, b"unicode-range", b"U+400-4FF, U+41")
  run block.setProperty(b"unicode-range", b"U+110000", b"", &limits)
  run value(&block, b"unicode-range", b"U+400-4FF, U+41")
  run block.setProperty(b"src", b"local(inherit)", b"", &limits)
  run value(
    &block,
    b"src",
    b"local(\"Silk UI\"), url(\"silk.woff2\") format(\"woff2\") tech(variations)",
  )
  run block.setProperty(b"font-family", b"serif", b"", &limits)
  run value(&block, b"font-family", b"\"Silk UI\"")
  run block.setProperty(b"font-family", b"\"serif\"", b"", &limits)
  run value(&block, b"font-family", b"\"serif\"")
}

test effect fn fontDescriptorsRejectPropertiesAndInvalidRanges() -> ()
  ! CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fonts() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pages() -> ()
  ! CssError | CssomError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut block = run StyleDeclaration.parseFor(
    Context.Page,
    b"size: landscape A4; margin: 1px 2px 3px !important; padding: 4px; marks: cross crop; bleed: 3px; page-orientation: rotate-left",
    &limits,
  )
  run value(&block, b"size", b"a4 landscape")
  run value(&block, b"margin", b"1px 2px 3px")
  run value(&block, b"margin-left", b"2px")
  run value(&block, b"padding", b"4px")
  run value(&block, b"marks", b"crop cross")
  run Testing.expect(
    equal(block.getPropertyPriority(b"margin"), b"important"),
    "page declarations retain important priority",
  )
  run block.setProperty(b"margin-left", b"7px", b"", &limits)
  run value(&block, b"margin", b"")
  let removed = run block.removeProperty(b"padding")
  run Testing.expect(
    equal(Bytes.asSlice(&removed), b"4px"),
    "descriptor shorthand removal returns previous shorthand value",
  )
  run value(&block, b"padding-top", b"")
  run block.setProperty(b"size", b"-1px", b"", &limits)
  run value(&block, b"size", b"a4 landscape")
  let margin = run StyleDeclaration.parseFor(
    Context.Margin,
    b"content: 'Page ' counter(page); size: A4; margin-left: auto",
    &limits,
  )
  run value(&margin, b"content", b"\"Page \" counter(page)")
  run value(&margin, b"size", b"")
  run value(&margin, b"margin-left", b"auto")
}

test effect fn pageDescriptorShorthandsAndMarginContent() -> ()
  ! CssError | CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run pages() |> Effect.provideMut<Allocator>(&mut allocator)
}
