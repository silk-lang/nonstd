//! CSSOM exceptions, distinct from parsing resource limits and allocator failures.
pub enum CssomError {
  IndexSizeError,
  HierarchyRequestError,
  InvalidStateError,
  SyntaxError,
  NotFoundError,
  NotAllowedError,
  NoModificationAllowedError,
  SecurityError,
  TypeError,
  RangeError,
  NotSupportedError,
  InvalidAccessError,
}
