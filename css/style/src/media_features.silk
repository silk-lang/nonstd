//! Static MQ4 features evaluated against host state, never against styled elements.
import input { Input, TokenView }
import tokens { Kind, insensitive }
import value_cursor { Cursor }
import dimensions { Context, Store, ExprId, Dimension }
import dimensions
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.i64

pub enum Truth {
  True,
  False,
  Unknown
}

// Speech marks a nonvisual host. The deprecated MQ `speech` type never matches;
// media_queries owns type matching, including screen's non-print definition.
pub enum MediaType {
  Screen,
  Print,
  Speech
}

pub enum ColorGamut {
  None,
  Srgb,
  P3,
  Rec2020
}

pub enum Scan {
  None,
  Progressive,
  Interlace
}

pub enum Update {
  None,
  Slow,
  Fast
}

pub enum OverflowBlock {
  None,
  Scroll,
  Paged
}

pub enum Pointer {
  None,
  Coarse,
  Fine
}

pub enum ColorScheme {
  Light,
  Dark
}

pub struct Environment {
  pub mediaType: MediaType,
  // All font/root metrics and writing orientation are INITIAL host values,
  // independent of declarations; viewport dimensions include rendered scrollbars.
  pub initial: Context,
  pub deviceWidth: f64,
  pub deviceHeight: f64,
  // Vertical device-pixel density per CSS px, including host page zoom.
  pub resolutionDppx: f64,
  pub infiniteResolution: bool,
  // Minimum bits per color component; table entry count; monochrome pixel bits.
  pub colorBits: u32,
  pub colorIndex: u32,
  pub monochromeBits: u32,
  pub colorGamut: ColorGamut,
  pub grid: bool,
  pub scan: Scan,
  pub update: Update,
  pub overflowBlock: OverflowBlock,
  pub overflowInline: bool,
  pub pointer: Pointer,
  pub hover: bool,
  // Union capabilities, not a single secondary pointer classification.
  pub anyPointerCoarse: bool,
  pub anyPointerFine: bool,
  pub anyHover: bool,
  // Effective preference for this medium; Secure Animated embedded SVG uses
  // the embedding node's used color scheme (MQ5 #prefers-color-scheme).
  pub colorScheme: ColorScheme,
  pub reducedMotion: bool,
}

impl Copy for Environment {}

impl Environment {
  // Static sRGB pixel target: no input, scrolling, or post-render updates.
  // Override fields with the host's actual capabilities and initial font metrics.
  pub fn headless(width: f64, height: f64) -> Environment {
    return Environment {
      mediaType: MediaType.Screen,
      initial: Context.make(width, height, 16.0),
      deviceWidth: width,
      deviceHeight: height,
      resolutionDppx: 1.0,
      infiniteResolution: false,
      colorBits: 8,
      colorIndex: 0,
      monochromeBits: 0,
      colorGamut: ColorGamut.Srgb,
      grid: false,
      scan: Scan.Progressive,
      update: Update.None,
      overflowBlock: OverflowBlock.None,
      overflowInline: false,
      pointer: Pointer.None,
      hover: false,
      anyPointerCoarse: false,
      anyPointerFine: false,
      anyHover: false,
      colorScheme: ColorScheme.Light,
      reducedMotion: false,
    }
  }
}

enum Feature {
  Unknown,
  Width,
  Height,
  DeviceWidth,
  DeviceHeight,
  AspectRatio,
  DeviceAspectRatio,
  Orientation,
  Resolution,
  Color,
  ColorIndex,
  Monochrome,
  ColorGamut,
  Grid,
  Scan,
  Update,
  OverflowBlock,
  OverflowInline,
  Pointer,
  Hover,
  AnyPointer,
  AnyHover,
  PrefersColorScheme,
  PrefersReducedMotion,
}

enum Relation {
  Equal,
  Less,
  LessEqual,
  Greater,
  GreaterEqual
}

struct Name {
  feature: Feature,
  relation: Relation,
  prefixed: bool
}

impl Copy for Name {}

struct Comparison {
  start: usize,
  end: usize,
  relation: Relation
}

impl Copy for Comparison {}

fn truth(value: bool) -> Truth {
  return if value {
    Truth.True
  } else {
    Truth.False
  }
}

fn lookup(text: &[u8]) -> Feature {
  if insensitive(text, b"width") {
    return Feature.Width
  }
  if insensitive(text, b"height") {
    return Feature.Height
  }
  if insensitive(text, b"device-width") {
    return Feature.DeviceWidth
  }
  if insensitive(text, b"device-height") {
    return Feature.DeviceHeight
  }
  if insensitive(text, b"aspect-ratio") {
    return Feature.AspectRatio
  }
  if insensitive(text, b"device-aspect-ratio") {
    return Feature.DeviceAspectRatio
  }
  if insensitive(text, b"orientation") {
    return Feature.Orientation
  }
  if insensitive(text, b"resolution") {
    return Feature.Resolution
  }
  if insensitive(text, b"color") {
    return Feature.Color
  }
  if insensitive(text, b"color-index") {
    return Feature.ColorIndex
  }
  if insensitive(text, b"monochrome") {
    return Feature.Monochrome
  }
  if insensitive(text, b"color-gamut") {
    return Feature.ColorGamut
  }
  if insensitive(text, b"grid") {
    return Feature.Grid
  }
  if insensitive(text, b"scan") {
    return Feature.Scan
  }
  if insensitive(text, b"update") {
    return Feature.Update
  }
  if insensitive(text, b"overflow-block") {
    return Feature.OverflowBlock
  }
  if insensitive(text, b"overflow-inline") {
    return Feature.OverflowInline
  }
  if insensitive(text, b"pointer") {
    return Feature.Pointer
  }
  if insensitive(text, b"hover") {
    return Feature.Hover
  }
  if insensitive(text, b"any-pointer") {
    return Feature.AnyPointer
  }
  if insensitive(text, b"any-hover") {
    return Feature.AnyHover
  }
  if insensitive(text, b"prefers-color-scheme") {
    return Feature.PrefersColorScheme
  }
  if insensitive(text, b"prefers-reduced-motion") {
    return Feature.PrefersReducedMotion
  }
  return Feature.Unknown
}

fn ranged(feature: Feature) -> bool {
  return match feature {
    Feature.Width => true
    Feature.Height => true
    Feature.DeviceWidth => true
    Feature.DeviceHeight => true
    Feature.AspectRatio => true
    Feature.DeviceAspectRatio => true
    Feature.Resolution => true
    Feature.Color => true
    Feature.ColorIndex => true
    Feature.Monochrome => true
    _ => false
  }
}

fn name(source: &Input, start: usize, end: usize) -> Name {
  let unknown = Name { feature: Feature.Unknown, relation: Relation.Equal, prefixed: false }
  let mut cursor = Cursor { position: start, end: end }
  cursor.skip(source)
  if cursor.position >= end {
    return unknown
  }
  let next = source.at(cursor.position)
  cursor.position = cursor.position + 1
  if !cursor.done(source) {
    return unknown
  }
  match &next {
    Option<TokenView>.Some { value } => {
      match &value.token.kind {
        Kind.Ident { text } => {
          let bytes = value.text(text)
          if bytes.length > 4 {
            let prefix = Slice.view<u8>(bytes, 0, 4)
            let minimum = insensitive(prefix, b"min-")
            let maximum = insensitive(prefix, b"max-")
            if minimum || maximum {
              let feature = lookup(Slice.view<u8>(bytes, 4, bytes.length - 4))
              if !ranged(feature) {
                return unknown
              }
              return Name {
                feature: feature,
                relation: if minimum {
                  Relation.GreaterEqual
                } else {
                  Relation.LessEqual
                },
                prefixed: true,
              }
            }
          }
          return Name { feature: lookup(bytes), relation: Relation.Equal, prefixed: false }
        }
        _ => {
          return unknown
        }
      }
    }
    _ => {
      return unknown
    }
  }
}

fn applicable(feature: Feature, environment: &Environment) -> bool {
  return match feature {
    Feature.Pointer => true
    Feature.Hover => true
    Feature.AnyPointer => true
    Feature.AnyHover => true
    Feature.PrefersColorScheme => true
    Feature.PrefersReducedMotion => true
    Feature.Unknown => false
    _ => environment.mediaType != MediaType.Speech
  }
}

fn actual(feature: Feature, environment: &Environment) -> f64 {
  return match feature {
    Feature.Width => environment.initial.viewportWidth
    Feature.Height => environment.initial.viewportHeight
    Feature.DeviceWidth => environment.deviceWidth
    Feature.DeviceHeight => environment.deviceHeight
    Feature.AspectRatio => environment.initial.viewportWidth / environment.initial.viewportHeight
    Feature.DeviceAspectRatio => environment.deviceWidth / environment.deviceHeight
    Feature.Resolution => if environment.infiniteResolution {
      f64.INFINITY
    } else {
      environment.resolutionDppx
    }
    Feature.Color => u32.toF64(environment.colorBits)
    Feature.ColorIndex => u32.toF64(environment.colorIndex)
    Feature.Monochrome => u32.toF64(environment.monochromeBits)
    _ => 0.0
  }
}

fn boolean(feature: Feature, environment: &Environment) -> Truth {
  if feature == Feature.Unknown {
    return Truth.Unknown
  }
  if !applicable(feature, environment) {
    return Truth.False
  }
  if ranged(feature) {
    // A ratio is not the number/dimension 0; all matching ratio values count.
    if feature == Feature.AspectRatio || feature == Feature.DeviceAspectRatio {
      let ratio = actual(feature, environment)
      return truth(ratio == ratio)
    }
    return truth(actual(feature, environment) != 0.0)
  }
  return truth(
    match feature {
      Feature.Orientation => true
      Feature.ColorGamut => environment.colorGamut != ColorGamut.None
      Feature.Grid => environment.grid
      Feature.Scan => environment.scan != Scan.None
      Feature.Update => environment.update != Update.None
      Feature.OverflowBlock => environment.overflowBlock != OverflowBlock.None
      Feature.OverflowInline => environment.overflowInline
      Feature.Pointer => environment.pointer != Pointer.None
      Feature.Hover => environment.hover
      Feature.AnyPointer => environment.anyPointerCoarse || environment.anyPointerFine
      Feature.AnyHover => environment.anyHover
      Feature.PrefersColorScheme => true
      Feature.PrefersReducedMotion => environment.reducedMotion
      _ => false
    },
  )
}

fn compare(left: f64, relation: Relation, right: f64) -> bool {
  return match relation {
    Relation.Equal => left == right
    Relation.Less => left < right
    Relation.LessEqual => left <= right
    Relation.Greater => left > right
    Relation.GreaterEqual => left >= right
  }
}

fn reverse(relation: Relation) -> Relation {
  return match relation {
    Relation.Equal => Relation.Equal
    Relation.Less => Relation.Greater
    Relation.LessEqual => Relation.GreaterEqual
    Relation.Greater => Relation.Less
    Relation.GreaterEqual => Relation.LessEqual
  }
}

fn ascending(relation: Relation) -> bool {
  return relation == Relation.Less || relation == Relation.LessEqual
}

fn descending(relation: Relation) -> bool {
  return relation == Relation.Greater || relation == Relation.GreaterEqual
}

// CSS integer math rounds toward positive infinity on a tie. Larger finite
// f64 values already have no fractional part; avoid an overflowing integer cast.
fn integerResult(value: f64) -> f64 {
  if !f64.isFinite(value) || f64.abs(value) >= 4503599627370496.0 {
    return value
  }
  let shifted = value + 0.5
  let truncated = i64.toF64(f64.toI64(shifted))
  return if truncated > shifted {
    truncated - 1.0
  } else {
    truncated
  }
}

effect fn component(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  expected: Dimension,
  integer: bool,
  ratio: bool,
  environment: &Environment,
) -> Option<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  cursor.skip(source)
  if cursor.position >= cursor.end {
    return Option<f64>.None
  }
  let next = source.at(cursor.position)
  let mut math = false
  match &next {
    Option<TokenView>.Some { value } => {
      match &value.token.kind {
        Kind.Number { value: numeric, integer: integerToken } => {
          if integer && !integerToken {
            return Option<f64>.None
          }
          if ratio && numeric < 0.0 {
            return Option<f64>.None
          }
        }
        Kind.Function { name: functionName } => {
          math = true
        }
        Kind.Dimension { value: numeric, integer: integerToken, unit } => {}
        _ => {
          return Option<f64>.None
        }
      }
    }
    _ => {
      return Option<f64>.None
    }
  }
  let parsed = run dimensions.parseMedia(&mut store.*, source, &mut cursor.*, expected)
  match &parsed {
    Option<ExprId>.Some { value } => {
      let computed = run dimensions.compute(&mut store.*, value, &environment.initial)
      let numeric = dimensions.evaluate(&store.*, computed, 0.0)
      if ratio && numeric < 0.0 {
        return Option<f64>.some(0.0)
      }
      return Option<f64>.some(
        if integer && math {
          integerResult(numeric)
        } else {
          numeric
        },
      )
    }
    _ => {
      return Option<f64>.None
    }
  }
}

effect fn numeric(
  store: &mut Store,
  source: &Input,
  start: usize,
  end: usize,
  feature: Feature,
  environment: &Environment,
) -> Option<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut cursor = Cursor { position: start, end: end }
  if feature == Feature.Resolution && cursor.ident(source, b"infinite") {
    return if cursor.done(source) {
      Option<f64>.some(f64.INFINITY)
    } else {
      Option<f64>.None
    }
  }
  let ratio = feature == Feature.AspectRatio || feature == Feature.DeviceAspectRatio
  let integer = feature == Feature.Color || feature == Feature.ColorIndex
    || feature == Feature.Monochrome
    || feature == Feature.Grid
  let expected = if feature == Feature.Resolution {
    Dimension.Resolution
  } else if ratio || integer {
    Dimension.Number
  } else {
    Dimension.Length
  }
  let first = run component(
    &mut store.*,
    source,
    &mut cursor,
    expected,
    integer,
    ratio,
    environment,
  )
  match &first {
    Option<f64>.Some { value } => {
      let mut result = value
      if ratio && cursor.delim(source, 47) {
        let second = run component(
          &mut store.*,
          source,
          &mut cursor,
          Dimension.Number,
          false,
          true,
          environment,
        )
        match &second {
          Option<f64>.Some { value: denominator } => {
            result = value / denominator
          }
          _ => {
            return Option<f64>.None
          }
        }
      }
      if !cursor.done(source) {
        return Option<f64>.None
      }
      if feature == Feature.Grid && result != 0.0 && result != 1.0 {
        return Option<f64>.None
      }
      return Option<f64>.some(result)
    }
    _ => {
      return Option<f64>.None
    }
  }
}

fn discrete(feature: Feature, text: &[u8], environment: &Environment) -> Truth {
  let none = insensitive(text, b"none")
  match feature {
    Feature.Orientation => {
      if insensitive(text, b"portrait") {
        return truth(environment.initial.viewportHeight >= environment.initial.viewportWidth)
      }
      if insensitive(text, b"landscape") {
        return truth(environment.initial.viewportWidth > environment.initial.viewportHeight)
      }
    }
    Feature.ColorGamut => {
      if insensitive(text, b"srgb") {
        return truth(environment.colorGamut != ColorGamut.None)
      }
      if insensitive(text, b"p3") {
        return truth(
          environment.colorGamut == ColorGamut.P3 || environment.colorGamut == ColorGamut.Rec2020,
        )
      }
      if insensitive(text, b"rec2020") {
        return truth(environment.colorGamut == ColorGamut.Rec2020)
      }
    }
    Feature.Scan => {
      if insensitive(text, b"progressive") {
        return truth(environment.scan == Scan.Progressive)
      }
      if insensitive(text, b"interlace") {
        return truth(environment.scan == Scan.Interlace)
      }
    }
    Feature.PrefersColorScheme => {
      if insensitive(text, b"light") {
        return truth(environment.colorScheme == ColorScheme.Light)
      }
      if insensitive(text, b"dark") {
        return truth(environment.colorScheme == ColorScheme.Dark)
      }
    }
    Feature.PrefersReducedMotion => {
      if insensitive(text, b"no-preference") {
        return truth(!environment.reducedMotion)
      }
      if insensitive(text, b"reduce") {
        return truth(environment.reducedMotion)
      }
    }
    Feature.Update => {
      if none {
        return truth(environment.update == Update.None)
      }
      if insensitive(text, b"slow") {
        return truth(environment.update == Update.Slow)
      }
      if insensitive(text, b"fast") {
        return truth(environment.update == Update.Fast)
      }
    }
    Feature.OverflowBlock => {
      if none {
        return truth(environment.overflowBlock == OverflowBlock.None)
      }
      if insensitive(text, b"scroll") {
        return truth(environment.overflowBlock == OverflowBlock.Scroll)
      }
      if insensitive(text, b"paged") {
        return truth(environment.overflowBlock == OverflowBlock.Paged)
      }
    }
    Feature.OverflowInline => {
      if none {
        return truth(!environment.overflowInline)
      }
      if insensitive(text, b"scroll") {
        return truth(environment.overflowInline)
      }
    }
    Feature.Pointer => {
      if none {
        return truth(environment.pointer == Pointer.None)
      }
      if insensitive(text, b"coarse") {
        return truth(environment.pointer == Pointer.Coarse)
      }
      if insensitive(text, b"fine") {
        return truth(environment.pointer == Pointer.Fine)
      }
    }
    Feature.AnyPointer => {
      if none {
        return truth(!environment.anyPointerCoarse && !environment.anyPointerFine)
      }
      if insensitive(text, b"coarse") {
        return truth(environment.anyPointerCoarse)
      }
      if insensitive(text, b"fine") {
        return truth(environment.anyPointerFine)
      }
    }
    Feature.Hover => {
      if none {
        return truth(!environment.hover)
      }
      if insensitive(text, b"hover") {
        return truth(environment.hover)
      }
    }
    Feature.AnyHover => {
      if none {
        return truth(!environment.anyHover)
      }
      if insensitive(text, b"hover") {
        return truth(environment.anyHover)
      }
    }
    _ => {}
  }
  return Truth.Unknown
}

effect fn testValue(
  store: &mut Store,
  source: &Input,
  start: usize,
  end: usize,
  feature: Feature,
  relation: Relation,
  environment: &Environment,
) -> Truth
  ! OutOfMemoryError
  ? &mut Allocator {
  if feature == Feature.Unknown {
    return Truth.Unknown
  }
  let mut result = Truth.Unknown
  if ranged(feature) || feature == Feature.Grid {
    let value = run numeric(&mut store.*, source, start, end, feature, environment)
    match &value {
      Option<f64>.Some { value: number } => {
        let host = if feature == Feature.Grid {
          if environment.grid {
            1.0
          } else {
            0.0
          }
        } else {
          actual(feature, environment)
        }
        result = truth(compare(host, relation, number))
      }
      _ => {
        return Truth.Unknown
      }
    }
  } else {
    let mut cursor = Cursor { position: start, end: end }
    cursor.skip(source)
    if cursor.position >= end {
      return Truth.Unknown
    }
    let next = source.at(cursor.position)
    cursor.position = cursor.position + 1
    if !cursor.done(source) {
      return Truth.Unknown
    }
    match &next {
      Option<TokenView>.Some { value } => {
        match &value.token.kind {
          Kind.Ident { text } => {
            result = discrete(feature, value.text(text), environment)
          }
          _ => {
            return Truth.Unknown
          }
        }
      }
      _ => {
        return Truth.Unknown
      }
    }
  }

  // Invalid values remain unknown even when the valid feature does not apply.
  if result != Truth.Unknown && !applicable(feature, environment) {
    return Truth.False
  }
  return result
}

// Parses only token ranges; Expanded inputs never consult Token.matching or
// original source offsets. Parentheses inside typed math are skipped structurally.
pub effect fn evaluate(source: &Input, start: usize, end: usize, environment: &Environment) -> Truth
  ! OutOfMemoryError
  ? &mut Allocator {
  if start > end || end > source.length() {
    return Truth.Unknown
  }
  let empty = Comparison { start: end, end: end, relation: Relation.Equal }
  let mut comparisons = [empty, empty]
  let mut count: usize = 0
  let mut colon = end
  let mut depth: usize = 0
  let mut position = start
  while position < end {
    let next = source.at(position)
    match &next {
      Option<TokenView>.Some { value } => {
        match &value.token.kind {
          Kind.Function { name: functionName } => {
            depth = depth + 1
          }
          Kind.OpenParen => {
            depth = depth + 1
          }
          Kind.CloseParen => {
            if depth == 0 {
              return Truth.Unknown
            }
            depth = depth - 1
          }
          Kind.OpenSquare => {
            return Truth.Unknown
          }
          Kind.CloseSquare => {
            return Truth.Unknown
          }
          Kind.OpenBrace => {
            return Truth.Unknown
          }
          Kind.CloseBrace => {
            return Truth.Unknown
          }
          Kind.Colon => {
            if depth == 0 {
              if colon != end {
                return Truth.Unknown
              }
              colon = position
            }
          }
          Kind.Delim { scalar } => {
            if depth == 0 && (scalar == 60 || scalar == 62 || scalar == 61) {
              if count == 2 {
                return Truth.Unknown
              }
              let mut relation = if scalar == 60 {
                Relation.Less
              } else if scalar == 62 {
                Relation.Greater
              } else {
                Relation.Equal
              }
              let operatorStart = position
              if scalar != 61 && position + 1 < end {
                let following = source.at(position + 1)
                match &following {
                  Option<TokenView>.Some { value: token } => {
                    match &token.token.kind {
                      Kind.Delim { scalar: second } => {
                        if second == 61 {
                          relation = if scalar == 60 {
                            Relation.LessEqual
                          } else {
                            Relation.GreaterEqual
                          }
                          position = position + 1
                        }
                      }
                      _ => {}
                    }
                  }
                  _ => {}
                }
              }
              comparisons[count] = Comparison {
                start: operatorStart,
                end: position + 1,
                relation: relation,
              }
              count = count + 1
            }
          }
          _ => {}
        }
      }
      _ => {
        return Truth.Unknown
      }
    }
    position = position + 1
  }
  let mut store = Store.make()
  if colon != end {
    if count != 0 {
      return Truth.Unknown
    }
    let featureName = name(source, start, colon)
    return run testValue(
      &mut store,
      source,
      colon + 1,
      end,
      featureName.feature,
      featureName.relation,
      environment,
    )
  }
  if count == 0 {
    let featureName = name(source, start, end)
    if featureName.prefixed {
      return Truth.Unknown
    }
    return boolean(featureName.feature, environment)
  }
  let first = comparisons[0]
  if count == 1 {
    let left = name(source, start, first.start)
    if left.feature != Feature.Unknown {
      if left.prefixed || !ranged(left.feature) {
        return Truth.Unknown
      }
      return run testValue(
        &mut store,
        source,
        first.end,
        end,
        left.feature,
        first.relation,
        environment,
      )
    }
    let right = name(source, first.end, end)
    if right.prefixed || !ranged(right.feature) {
      return Truth.Unknown
    }
    return run testValue(
      &mut store,
      source,
      start,
      first.start,
      right.feature,
      reverse(first.relation),
      environment,
    )
  }
  let second = comparisons[1]
  if !((ascending(first.relation) && ascending(second.relation))
    || (descending(first.relation) && descending(second.relation))) {
    return Truth.Unknown
  }
  let middle = name(source, first.end, second.start)
  if middle.prefixed || !ranged(middle.feature) {
    return Truth.Unknown
  }
  let lower = run testValue(
    &mut store,
    source,
    start,
    first.start,
    middle.feature,
    reverse(first.relation),
    environment,
  )
  let upper = run testValue(
    &mut store,
    source,
    second.end,
    end,
    middle.feature,
    second.relation,
    environment,
  )

  // A malformed operand invalidates the entire feature, not just one comparison.
  if lower == Truth.Unknown || upper == Truth.Unknown {
    return Truth.Unknown
  }
  return truth(lower == Truth.True && upper == Truth.True)
}
