//! A contiguous declaration or a var()-expanded sequence of references, without token copies.
import tokens { Token, TokenBuffer, TokenRange, Span }
import silk.core.option { Option }
import silk.core.ownership { Copy }

pub struct TokenRef {
  pub buffer: usize,
  pub token: usize,
}

impl Copy for TokenRef {}

pub struct TokenView<'a> {
  pub buffer: &'a TokenBuffer,
  pub token: &'a Token,
}

impl<'a> Copy for TokenView<'a> {}

impl<'a> TokenView<'a> {
  pub fn text(self: &TokenView<'a>, span: Span) -> &'a [u8] {
    return self.buffer.text(span)
  }
}

pub union Input<'a> {
  Contiguous { pub buffer: &'a TokenBuffer, pub range: TokenRange },
  Expanded { pub buffers: &'a [TokenBuffer], pub references: &'a [TokenRef] },
}

impl<'a> Input<'a> {
  pub fn length(self: &Input<'a>) -> usize {
    return match &self.* {
      Input<'a>.Contiguous { buffer, range } => {
        if range.start > range.end || range.end > buffer.tokens.length() {
          return 0
        }
        return range.end - range.start
      }
      Input<'a>.Expanded { buffers, references } => references.length
    }
  }

  pub fn at<'s>(self: &'s Input<'a>, index: usize) -> Option<TokenView<'s>> {
    match &self.* {
      Input<'a>.Contiguous { buffer, range } => {
        if range.start > range.end || range.end > buffer.tokens.length()
          || index >= range.end - range.start {
          return Option<TokenView<'s>>.None
        }
        return Option<TokenView<'s>>.some(
          TokenView<'s> { buffer: buffer, token: &buffer.tokens.asSlice()[range.start + index] },
        )
      }
      Input<'a>.Expanded { buffers, references } => {
        if index >= references.length {
          return Option<TokenView<'s>>.None
        }
        let reference = references[index]
        if reference.buffer >= buffers.length {
          return Option<TokenView<'s>>.None
        }
        let buffer = &buffers[reference.buffer]
        if reference.token >= buffer.tokens.length() {
          return Option<TokenView<'s>>.None
        }
        return Option<TokenView<'s>>.some(
          TokenView<'s> { buffer: buffer, token: &buffer.tokens.asSlice()[reference.token] },
        )
      }
    }
  }
}
