//! Canonical token serialization for specified forms whose typed representation loses syntax.
import tokens { TokenBuffer, TokenRange, Kind }
import tokens
import cssom_serialization
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn lower(text: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at: usize = 0
  while at < text.length {
    let byte = text[at]
    run out.append(
      &[
        if byte >= 65 && byte <= 90 {
          byte + 32
        } else {
          byte
        },
      ],
    )
    at = at + 1
  }
  return move out
}

fn transformName(text: &[u8]) -> &'static [u8] {
  if tokens.insensitive(text, b"translatex") {
    return b"translateX"
  }
  if tokens.insensitive(text, b"translatey") {
    return b"translateY"
  }
  if tokens.insensitive(text, b"translatez") {
    return b"translateZ"
  }
  if tokens.insensitive(text, b"scalex") {
    return b"scaleX"
  }
  if tokens.insensitive(text, b"scaley") {
    return b"scaleY"
  }
  if tokens.insensitive(text, b"scalez") {
    return b"scaleZ"
  }
  if tokens.insensitive(text, b"rotatex") {
    return b"rotateX"
  }
  if tokens.insensitive(text, b"rotatey") {
    return b"rotateY"
  }
  if tokens.insensitive(text, b"rotatez") {
    return b"rotateZ"
  }
  if tokens.insensitive(text, b"skewx") {
    return b"skewX"
  }
  if tokens.insensitive(text, b"skewy") {
    return b"skewY"
  }
  return b""
}

effect fn append(out: &mut Bytes, buffer: &TokenBuffer, range: TokenRange) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = range.start
  let mut separated = true
  let mut whitespace = false
  while at < range.end {
    let token = &buffer.tokens.asSlice()[at]
    if match &token.kind {
      Kind.Whitespace => true
      _ => false
    } {
      whitespace = true
      at = at + 1
      continue
    }
    let comma = match &token.kind {
      Kind.Comma => true
      _ => false
    }
    if !comma && !separated && whitespace {
      run out.append(b" ")
    }
    whitespace = false
    separated = false
    match &token.kind {
      Kind.Function { name } => {
        let original = buffer.text(name)
        let canonical = transformName(original)
        if canonical.length != 0 {
          run out.append(canonical)
        } else {
          let name = run lower(original)
          run out.append(Bytes.asSlice(&name))
        }
        run out.append(b"(")
        let end = if token.matching < range.end {
          token.matching
        } else {
          range.end
        }
        run append(&mut out.*, buffer, TokenRange { start: at + 1, end: end })
        run out.append(b")")
        at = if end < range.end {
          end + 1
        } else {
          end
        }
        continue
      }
      Kind.Ident { text } => {
        let name = run lower(buffer.text(text))
        let escaped = run cssom_serialization.identifier(Bytes.asSlice(&name))
        run out.append(Bytes.asSlice(&escaped))
      }
      Kind.Number { value, integer } => {
        run cssom_serialization.appendNumber(&mut out.*, value)
      }
      Kind.Percentage { value, integer } => {
        run cssom_serialization.appendNumber(&mut out.*, value)
        run out.append(b"%")
      }
      Kind.Dimension { value, integer, unit } => {
        run cssom_serialization.appendNumber(&mut out.*, value)
        let unit = run lower(buffer.text(unit))
        run out.append(Bytes.asSlice(&unit))
      }
      Kind.String { text } => {
        let value = run cssom_serialization.string(buffer.text(text))
        run out.append(Bytes.asSlice(&value))
      }
      Kind.Comma => {
        run out.append(b", ")
        separated = true
      }
      _ => {
        let value = run cssom_serialization.components(
          buffer,
          TokenRange { start: at, end: at + 1 },
        )
        run out.append(Bytes.asSlice(&value))
      }
    }
    at = at + 1
  }
}

pub effect fn value(buffer: &TokenBuffer, range: TokenRange) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run append(&mut out, buffer, range)
  return move out
}

pub fn hasFunction(buffer: &TokenBuffer, range: TokenRange, wanted: &[u8]) -> bool {
  let mut at = range.start
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Function { name } => {
        if tokens.insensitive(buffer.text(name), wanted) {
          return true
        }
      }
      _ => {}
    }
    at = at + 1
  }
  return false
}
