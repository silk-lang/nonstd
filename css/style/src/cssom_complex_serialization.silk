//! CSS serialization of the typed effects and transform arenas.
import values
import properties { Property }
import dimensions { ExprId, Expr, Unit }
import dimensions
import effect_values
import effect_values {
  EffectValue,
  Filter,
  FilterKind,
  GeometryBox,
  MaskMode,
  Composite,
  Repeat,
  RepeatPair,
  Size,
  Extent,
  RadialSize,
  Direction,
  GradientStop,
  Image,
  MaskLayer,
  BorderMeasure,
  Border,
  Shape,
  RectangleKind,
  ClipSource,
  ShapeCommand,
  CommandKind,
  ControlPoint,
  ControlOrigin
}
import transform_values {
  TransformValue,
  Operation,
  Position,
  PositionAxis,
  Edge,
  ReferenceBox,
  TransformStyle,
  Backface
}
import cssom_numeric_serialization as numeric
import cssom_serialization as syntax
import svg_geometry.geometry { Path, Segment, Point }
import svg_geometry.geometry { Rect, Transform, isValidRect }
import svg_geometry.transforms { Matrix }
import svg_geometry.transforms
import svg_geometry.math
import silk.num.f64
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn literal(store: &values.Store, id: ExprId, expected: f64) -> bool {
  return match &store.numerics.get(id).* {
    Expr.Literal { value, unit } => value == expected && (expected == 0.0 || unit == Unit.Number)
    _ => false
  }
}

fn same(store: &values.Store, a: ExprId, b: ExprId) -> bool {
  if a.index == b.index {
    return true
  }
  return match &store.numerics.get(a).* {
    Expr.Literal { value, unit } => match &store.numerics.get(b).* {
      Expr.Literal { value: other, unit: otherUnit } => value == other && unit == otherUnit
      _ => false
    }
    Expr.Binary { operation, left, right } => match &store.numerics.get(b).* {
      Expr.Binary { operation: op, left: l, right: r } => operation == op && same(store, left, l)
        && same(store, right, r)
      _ => false
    }
    Expr.Calc { value } => match &store.numerics.get(b).* {
      Expr.Calc { value: other } => same(store, value, other)
      _ => false
    }
    Expr.PercentContext { value, percentage } => match &store.numerics.get(b).* {
      Expr.PercentContext { value: other, percentage: p } => percentage == p
        && same(store, value, other)
      _ => false
    }
  }
}

effect fn expr(computed: bool, out: &mut Bytes, store: &values.Store, id: ExprId) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if computed {
    run numeric.appendComputedExpression(&mut out.*, &store.numerics, id)
  } else {
    run numeric.appendExpression(&mut out.*, &store.numerics, id)
  }
}

effect fn optional(computed: bool, out: &mut Bytes, store: &values.Store, id: Option<ExprId>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &id {
    Option<ExprId>.Some { value } => run expr(computed, &mut out.*, store, value)
    Option<ExprId>.None => run out.append(b"auto")
  }
}

fn edgeName(edge: Edge, horizontal: bool) -> &'static [u8] {
  return match edge {
    Edge.Start => if horizontal {
      b"left"
    } else {
      b"top"
    }
    Edge.Center => b"center"
    Edge.End => if horizontal {
      b"right"
    } else {
      b"bottom"
    }
  }
}

// A two-value position uses percentages for keywords. End offsets use the
// four-value grammar, avoiding a subtraction or mutation of the numeric arena.
effect fn appendPositionImpl(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: Position,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let four = (value.x.edge == Edge.End && !literal(store, value.x.offset, 0.0))
    || (value.y.edge == Edge.End && !literal(store, value.y.offset, 0.0))
  if four {
    run out.append(
      edgeName(
        if value.x.edge == Edge.Center {
          Edge.Start
        } else {
          value.x.edge
        },
        true,
      ),
    )
    run out.append(b" ")
    if value.x.edge == Edge.Center {
      run out.append(b"50%")
    } else {
      run expr(computed, &mut out.*, store, value.x.offset)
    }
    run out.append(b" ")
    run out.append(
      edgeName(
        if value.y.edge == Edge.Center {
          Edge.Start
        } else {
          value.y.edge
        },
        false,
      ),
    )
    run out.append(b" ")
    if value.y.edge == Edge.Center {
      run out.append(b"50%")
    } else {
      run expr(computed, &mut out.*, store, value.y.offset)
    }
  } else {
    run positionAxis(computed, &mut out.*, store, value.x)
    run out.append(b" ")
    run positionAxis(computed, &mut out.*, store, value.y)
  }
}

effect fn positionAxis(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: PositionAxis,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value.edge == Edge.Center {
    run out.append(b"50%")
  } else if value.edge == Edge.End {
    run out.append(b"100%")
  } else {
    run expr(computed, &mut out.*, store, value.offset)
  }
}

effect fn positionImpl(computed: bool, store: &values.Store, value: Position) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run appendPositionImpl(computed, &mut out, store, value)
  return move out
}

fn boxName(value: GeometryBox) -> &'static [u8] {
  return match value {
    GeometryBox.Content => b"content-box"
    GeometryBox.Padding => b"padding-box"
    GeometryBox.Border => b"border-box"
    GeometryBox.Margin => b"margin-box"
    GeometryBox.Fill => b"fill-box"
    GeometryBox.Stroke => b"stroke-box"
    GeometryBox.View => b"view-box"
    GeometryBox.NoClip => b"no-clip"
  }
}

fn modeName(value: MaskMode) -> &'static [u8] {
  return match value {
    MaskMode.MatchSource => b"match-source"
    MaskMode.Alpha => b"alpha"
    MaskMode.Luminance => b"luminance"
  }
}

fn compositeName(value: Composite) -> &'static [u8] {
  return match value {
    Composite.Add => b"add"
    Composite.Subtract => b"subtract"
    Composite.Intersect => b"intersect"
    Composite.Exclude => b"exclude"
  }
}

fn repeatName(value: Repeat) -> &'static [u8] {
  return match value {
    Repeat.Repeat => b"repeat"
    Repeat.Space => b"space"
    Repeat.Round => b"round"
    Repeat.NoRepeat => b"no-repeat"
    Repeat.Stretch => b"stretch"
  }
}

effect fn repeats(out: &mut Bytes, value: RepeatPair, border: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !border && value.x == Repeat.Repeat && value.y == Repeat.NoRepeat {
    run out.append(b"repeat-x")
  } else if !border && value.x == Repeat.NoRepeat && value.y == Repeat.Repeat {
    run out.append(b"repeat-y")
  } else {
    run out.append(repeatName(value.x))
    if value.y != value.x {
      run out.append(b" ")
      run out.append(repeatName(value.y))
    }
  }
}

effect fn size(computed: bool, out: &mut Bytes, store: &values.Store, value: Size) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value {
    Size.Cover => run out.append(b"cover")
    Size.Contain => run out.append(b"contain")
    Size.Explicit { x, y } => {
      run optional(computed, &mut out.*, store, x)
      match &y {
        Option<ExprId>.Some { value: vertical } => {
          run out.append(b" ")
          run expr(computed, &mut out.*, store, vertical)
        }
        _ => {}
      }
    }
  }
}

effect fn radialSize(computed: bool, out: &mut Bytes, store: &values.Store, value: RadialSize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value {
    RadialSize.Extent { extent } => run out.append(
      match extent {
        Extent.ClosestSide => b"closest-side"
        Extent.ClosestCorner => b"closest-corner"
        Extent.FarthestSide => b"farthest-side"
        Extent.FarthestCorner => b"farthest-corner"
      },
    )
    RadialSize.Radii { x, y } => {
      run expr(computed, &mut out.*, store, x)
      match &y {
        Option<ExprId>.Some { value: vertical } => {
          run out.append(b" ")
          run expr(computed, &mut out.*, store, vertical)
        }
        _ => {}
      }
    }
  }
}

effect fn stops(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  items: &List<GradientStop>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < items.length() {
    if i > 0 {
      run out.append(b", ")
    }
    match &items.asSlice()[i] {
      GradientStop.ColorStop { color, position } => {
        run numeric.appendColor(&mut out.*, &color)
        match &position {
          Option<ExprId>.Some { value } => {
            run out.append(b" ")
            run expr(computed, &mut out.*, store, value)
          }
          _ => {}
        }
      }
      GradientStop.Hint { position } => run expr(computed, &mut out.*, store, position)
    }
    i = i + 1
  }
}

effect fn appendImageImpl(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: &Image,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value.* {
    Image.None => run out.append(b"none")
    Image.Url { url } => {
      let text = run syntax.url(url.asSlice())
      run out.append(text.asSlice())
    }
    Image.Linear { repeating, direction, stops: items } => {
      run out.append(
        if repeating {
          b"repeating-linear-gradient("
        } else {
          b"linear-gradient("
        },
      )
      let mut header = true
      match &direction {
        Direction.Angle { angle } => run expr(computed, &mut out.*, store, angle)
        Direction.Corner { x, y } => {
          if x == Edge.Center && y == Edge.End {
            header = false
          } else {
            run out.append(b"to ")
            if x != Edge.Center {
              run out.append(edgeName(x, true))
            }
            if y != Edge.Center {
              if x != Edge.Center {
                run out.append(b" ")
              }
              run out.append(edgeName(y, false))
            }
          }
        }
      }
      if header {
        run out.append(b", ")
      }
      run stops(computed, &mut out.*, store, &items)
      run out.append(b")")
    }
    Image.Radial { repeating, circle, size: extent, position: at, stops: items } => {
      run out.append(
        if repeating {
          b"repeating-radial-gradient("
        } else {
          b"radial-gradient("
        },
      )
      let mut header = false
      match &extent {
        RadialSize.Extent { extent: e } => {
          if circle {
            run out.append(b"circle")
            header = true
          }
          if e != Extent.FarthestCorner {
            if header {
              run out.append(b" ")
            }
            run radialSize(computed, &mut out.*, store, extent)
            header = true
          }
        }
        RadialSize.Radii { x, y } => {
          run radialSize(computed, &mut out.*, store, extent)
          header = true
        }
      }
      if !centered(store, at) {
        if header {
          run out.append(b" ")
        }
        run out.append(b"at ")
        run appendPositionImpl(computed, &mut out.*, store, at)
        header = true
      }
      if header {
        run out.append(b", ")
      }
      run stops(computed, &mut out.*, store, &items)
      run out.append(b")")
    }
  }
}

fn centered(store: &values.Store, at: Position) -> bool {
  return centerAxis(store, at.x) && centerAxis(store, at.y)
}

fn centerAxis(store: &values.Store, axis: PositionAxis) -> bool {
  if axis.edge == Edge.Center {
    return literal(store, axis.offset, 0.0)
  }
  return match &store.numerics.get(axis.offset).* {
    Expr.Literal { value, unit } => value == 50.0 && unit == Unit.Percent
    _ => false
  }
}

fn quadCount(store: &values.Store, items: &[ExprId; 4]) -> usize {
  if !same(store, items[1], items[3]) {
    return 4
  }
  if !same(store, items[0], items[2]) {
    return 3
  }
  if !same(store, items[0], items[1]) {
    return 2
  }
  return 1
}

effect fn quad(computed: bool, out: &mut Bytes, store: &values.Store, items: &[ExprId; 4]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count = quadCount(store, items)
  let mut i: usize = 0
  while i < count {
    if i > 0 {
      run out.append(b" ")
    }
    run expr(computed, &mut out.*, store, items[i])
    i = i + 1
  }
}

fn sameMeasure(store: &values.Store, a: BorderMeasure, b: BorderMeasure) -> bool {
  return match &a {
    BorderMeasure.Auto => match &b {
      BorderMeasure.Auto => true
      _ => false
    }
    BorderMeasure.Numeric { value } => match &b {
      BorderMeasure.Numeric { value: other } => same(store, value, other)
      _ => false
    }
  }
}

effect fn widths(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  items: &[BorderMeasure; 4],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let count: usize = if !sameMeasure(store, items[1], items[3]) {
    4
  } else if !sameMeasure(store, items[0], items[2]) {
    3
  } else if !sameMeasure(store, items[0], items[1]) {
    2
  } else {
    1
  }
  let mut i: usize = 0
  while i < count {
    if i > 0 {
      run out.append(b" ")
    }
    match &items[i] {
      BorderMeasure.Auto => run out.append(b"auto")
      BorderMeasure.Numeric { value } => run expr(computed, &mut out.*, store, value)
    }
    i = i + 1
  }
}

fn borderProperty(property: Property) -> bool {
  return property == Property.MaskBorder || property == Property.MaskBorderSource
    || property == Property.MaskBorderMode
    || property == Property.MaskBorderSlice
    || property == Property.MaskBorderWidth
    || property == Property.MaskBorderOutset
    || property == Property.MaskBorderRepeat
}

effect fn border(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: &Border,
  property: Property,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if property == Property.MaskBorderSource {
    run appendImageImpl(computed, &mut out.*, store, &value.image)
  } else if property == Property.MaskBorderMode {
    run out.append(modeName(value.mode))
  } else if property == Property.MaskBorderSlice {
    run quad(computed, &mut out.*, store, &value.slice)
    if value.fill {
      run out.append(b" fill")
    }
  } else if property == Property.MaskBorderWidth {
    run widths(computed, &mut out.*, store, &value.width)
  } else if property == Property.MaskBorderOutset {
    run quad(computed, &mut out.*, store, &value.outset)
  } else if property == Property.MaskBorderRepeat {
    run repeats(&mut out.*, value.repeat, true)
  } else {
    let mut slice = value.fill
    let mut width = false
    let mut outset = false
    let mut i: usize = 0
    while i < 4 {
      if !literal(store, value.slice[i], 0.0) {
        slice = true
      }
      if !literal(store, value.outset[i], 0.0) {
        outset = true
      }
      match &value.width[i] {
        BorderMeasure.Numeric { value: id } => {
          width = true
        }
        BorderMeasure.Auto => {}
      }
      i = i + 1
    }
    run appendImageImpl(computed, &mut out.*, store, &value.image)
    if slice || width || outset {
      run out.append(b" ")
      run quad(computed, &mut out.*, store, &value.slice)
      if value.fill {
        run out.append(b" fill")
      }
      if width || outset {
        run out.append(b" / ")
        if width {
          run widths(computed, &mut out.*, store, &value.width)
        }
        if outset {
          run out.append(b" / ")
          run quad(computed, &mut out.*, store, &value.outset)
        }
      }
    }
    if value.repeat.x != Repeat.Stretch || value.repeat.y != Repeat.Stretch {
      run out.append(b" ")
      run repeats(&mut out.*, value.repeat, true)
    }
    if value.mode != MaskMode.Alpha {
      run out.append(b" ")
      run out.append(modeName(value.mode))
    }
  }
}

effect fn layer(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: &MaskLayer,
  property: Property,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if property == Property.MaskImage {
    run appendImageImpl(computed, &mut out.*, store, &value.image)
  } else if property == Property.MaskMode {
    run out.append(modeName(value.mode))
  } else if property == Property.MaskPosition {
    run appendPositionImpl(computed, &mut out.*, store, value.position)
  } else if property == Property.MaskSize {
    run size(computed, &mut out.*, store, value.size)
  } else if property == Property.MaskRepeat {
    run repeats(&mut out.*, value.repeat, false)
  } else if property == Property.MaskOrigin {
    run out.append(boxName(value.origin))
  } else if property == Property.MaskClip {
    run out.append(boxName(value.clip))
  } else if property == Property.MaskComposite {
    run out.append(compositeName(value.composite))
  } else {
    run appendImageImpl(computed, &mut out.*, store, &value.image)
    let initialSize = match &value.size {
      Size.Explicit { x, y } => match &x {
        Option<ExprId>.None => match &y {
          Option<ExprId>.None => true
          _ => false
        }
        _ => false
      }
      _ => false
    }
    let initialPosition = value.position.x.edge == Edge.Start && value.position.y.edge == Edge.Start
      && literal(store, value.position.x.offset, 0.0)
      && literal(store, value.position.y.offset, 0.0)
    if !initialPosition || !initialSize {
      run out.append(b" ")
      run appendPositionImpl(computed, &mut out.*, store, value.position)
      if !initialSize {
        run out.append(b" / ")
        run size(computed, &mut out.*, store, value.size)
      }
    }
    if value.repeat.x != Repeat.Repeat || value.repeat.y != Repeat.Repeat {
      run out.append(b" ")
      run repeats(&mut out.*, value.repeat, false)
    }
    if value.origin != GeometryBox.Border || value.clip != GeometryBox.Border {
      run out.append(b" ")
      if value.origin != GeometryBox.Border || value.clip != GeometryBox.NoClip {
        run out.append(boxName(value.origin))
        if value.clip != value.origin {
          run out.append(b" ")
        }
      }
      if value.clip != value.origin {
        run out.append(boxName(value.clip))
      }
    }
    if value.composite != Composite.Add {
      run out.append(b" ")
      run out.append(compositeName(value.composite))
    }
    if value.mode != MaskMode.MatchSource {
      run out.append(b" ")
      run out.append(modeName(value.mode))
    }
  }
}

effect fn control(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: ControlPoint,
  relative: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run appendPositionImpl(computed, &mut out.*, store, value.position)
  let initial = if relative {
    ControlOrigin.Start
  } else {
    ControlOrigin.Origin
  }
  if value.origin != initial {
    run out.append(
      match value.origin {
        ControlOrigin.Origin => b" from origin"
        ControlOrigin.Start => b" from start"
        ControlOrigin.End => b" from end"
      },
    )
  }
}

effect fn command(computed: bool, out: &mut Bytes, store: &values.Store, value: ShapeCommand) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run out.append(
    match value.kind {
      CommandKind.Move => b"move"
      CommandKind.Line => b"line"
      CommandKind.HLine => b"hline"
      CommandKind.VLine => b"vline"
      CommandKind.Curve => b"curve"
      CommandKind.Smooth => b"smooth"
      CommandKind.Arc => b"arc"
      CommandKind.Close => b"close"
    },
  )
  if value.kind == CommandKind.Close {
    return
  }
  run out.append(
    if value.relative {
      b" by "
    } else {
      b" to "
    },
  )
  if value.kind == CommandKind.HLine {
    run positionAxis(computed, &mut out.*, store, value.end.x)
  } else if value.kind == CommandKind.VLine {
    run positionAxis(computed, &mut out.*, store, value.end.y)
  } else {
    run appendPositionImpl(computed, &mut out.*, store, value.end)
  }
  match &value.control1 {
    Option<ControlPoint>.Some { value: cp } => {
      run out.append(b" with ")
      run control(computed, &mut out.*, store, cp, value.relative)
    }
    _ => {}
  }
  match &value.control2 {
    Option<ControlPoint>.Some { value: cp } => {
      run out.append(b" / ")
      run control(computed, &mut out.*, store, cp, value.relative)
    }
    _ => {}
  }
  match &value.radii {
    Option<effect_values.Point>.Some { value: radii } => {
      run out.append(b" of ")
      run expr(computed, &mut out.*, store, radii.x)
      if !value.singleRadius {
        run out.append(b" ")
        run expr(computed, &mut out.*, store, radii.y)
      }
      if value.clockwise {
        run out.append(b" cw")
      }
      if value.large {
        run out.append(b" large")
      }
    }
    _ => {}
  }
  match &value.rotation {
    Option<ExprId>.Some { value: angle } => {
      if !literal(store, angle, 0.0) {
        run out.append(b" rotate ")
        run expr(computed, &mut out.*, store, angle)
      }
    }
    _ => {}
  }
}

effect fn appendShapeImpl(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: &Shape,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value.* {
    Shape.Rectangle { kind, edges, corners } => {
      run out.append(
        match kind {
          RectangleKind.Inset => b"inset("
          RectangleKind.Rect => b"rect("
          RectangleKind.Xywh => b"xywh("
        },
      )
      let mut count: usize = 4
      if kind == RectangleKind.Inset {
        let mut i: usize = 0
        let mut ids = [ExprId { index: 0 }; 4]
        while i < 4 {
          match &edges[i] {
            Option<ExprId>.Some { value: id } => {
              ids[i] = id
            }
            _ => {}
          }
          i = i + 1
        }
        count = quadCount(store, &ids)
      }
      let mut i: usize = 0
      while i < count {
        if i > 0 {
          run out.append(b" ")
        }
        run optional(computed, &mut out.*, store, edges[i])
        i = i + 1
      }
      let mut rounded = false
      let mut equal = true
      i = 0
      while i < 4 {
        if !literal(store, corners.x[i], 0.0) || !literal(store, corners.y[i], 0.0) {
          rounded = true
        }
        if !same(store, corners.x[i], corners.y[i]) {
          equal = false
        }
        i = i + 1
      }
      if rounded {
        run out.append(b" round ")
        run quad(computed, &mut out.*, store, &corners.x)
        if !equal {
          run out.append(b" / ")
          run quad(computed, &mut out.*, store, &corners.y)
        }
      }
    }
    Shape.Ellipse { circle, size, position } => {
      run out.append(
        if circle {
          b"circle("
        } else {
          b"ellipse("
        },
      )
      let initial = match &size {
        RadialSize.Extent { extent } => extent == Extent.ClosestSide
        _ => false
      }
      if !initial {
        run radialSize(computed, &mut out.*, store, size)
      }
      if !centered(store, position) {
        if !initial {
          run out.append(b" ")
        }
        run out.append(b"at ")
        run appendPositionImpl(computed, &mut out.*, store, position)
      }
    }
    Shape.Polygon { evenodd, round, points } => {
      run out.append(b"polygon(")
      let mut header = evenodd
      if evenodd {
        run out.append(b"evenodd")
      }
      match &round {
        Option<ExprId>.Some { value: radius } => {
          if header {
            run out.append(b" ")
          }
          run out.append(b"round ")
          run expr(computed, &mut out.*, store, radius)
          header = true
        }
        _ => {}
      }
      if header {
        run out.append(b", ")
      }
      let mut i: usize = 0
      while i < points.length() {
        if i > 0 {
          run out.append(b", ")
        }
        run expr(computed, &mut out.*, store, points.asSlice()[i].x)
        run out.append(b" ")
        run expr(computed, &mut out.*, store, points.asSlice()[i].y)
        i = i + 1
      }
    }
    Shape.Path { evenodd, path } => {
      run out.append(b"path(")
      if evenodd {
        run out.append(b"evenodd, ")
      }
      let data = run pathData(&path)
      let quoted = run syntax.string(data.asSlice())
      run out.append(quoted.asSlice())
    }
    Shape.Commands { evenodd, start, commands } => {
      run out.append(b"shape(")
      if evenodd {
        run out.append(b"evenodd ")
      }
      run out.append(b"from ")
      run appendPositionImpl(computed, &mut out.*, store, start)
      let mut i: usize = 0
      while i < commands.length() {
        run out.append(b", ")
        run command(computed, &mut out.*, store, commands.asSlice()[i])
        i = i + 1
      }
    }
  }
  run out.append(b")")
}

effect fn source(computed: bool, out: &mut Bytes, store: &values.Store, value: &ClipSource) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &value.* {
    ClipSource.Url { url } => {
      let text = run syntax.url(url.asSlice())
      run out.append(text.asSlice())
    }
    ClipSource.Box { reference } => run out.append(boxName(reference))
    ClipSource.Shape { shape, reference } => {
      run appendShapeImpl(computed, &mut out.*, store, &shape)
      if reference != GeometryBox.Border {
        run out.append(b" ")
        run out.append(boxName(reference))
      }
    }
  }
}

effect fn effectValueImpl(
  computed: bool,
  store: &values.Store,
  value: &EffectValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  match &value.* {
    EffectValue.None => run out.append(
      if property == Property.Clip || property == Property.ShapeInside {
        b"auto"
      } else {
        b"none"
      },
    )
    EffectValue.Filters { items } => {
      let mut i: usize = 0
      while i < items.length() {
        if i > 0 {
          run out.append(b" ")
        }
        match &items.asSlice()[i] {
          Filter.Url { url } => {
            let text = run syntax.url(url.asSlice())
            run out.append(text.asSlice())
          }
          Filter.Function { kind, amount } => {
            run out.append(
              match kind {
                FilterKind.Blur => b"blur("
                FilterKind.Brightness => b"brightness("
                FilterKind.Contrast => b"contrast("
                FilterKind.Grayscale => b"grayscale("
                FilterKind.HueRotate => b"hue-rotate("
                FilterKind.Invert => b"invert("
                FilterKind.Opacity => b"opacity("
                FilterKind.Saturate => b"saturate("
                FilterKind.Sepia => b"sepia("
              },
            )
            run expr(computed, &mut out, store, amount)
            run out.append(b")")
          }
          Filter.DropShadow { x, y, blur, color } => {
            run out.append(b"drop-shadow(")
            run numeric.appendColor(&mut out, &color)
            run out.append(b" ")
            run expr(computed, &mut out, store, x)
            run out.append(b" ")
            run expr(computed, &mut out, store, y)
            if !literal(store, blur, 0.0) {
              run out.append(b" ")
              run expr(computed, &mut out, store, blur)
            }
            run out.append(b")")
          }
        }
        i = i + 1
      }
    }
    EffectValue.Masks { layers, resetBorder } => {
      if borderProperty(property) {
        run border(computed, &mut out, store, &resetBorder, property)
      } else {
        let mut i: usize = 0
        while i < layers.length() {
          if i > 0 {
            run out.append(b", ")
          }
          run layer(computed, &mut out, store, &layers.asSlice()[i], property)
          i = i + 1
        }
      }
    }
    EffectValue.MaskBorder { border: maskBorder } => run border(
      computed,
      &mut out,
      store,
      &maskBorder,
      property,
    )
    EffectValue.ClipPath { source: clip } => run source(computed, &mut out, store, &clip)
    EffectValue.Shapes { sources } => {
      let mut i: usize = 0
      while i < sources.length() {
        if i > 0 {
          run out.append(b" ")
        }
        run source(computed, &mut out, store, &sources.asSlice()[i])
        i = i + 1
      }
    }
    EffectValue.Clip { edges } => {
      run out.append(b"rect(")
      let mut i: usize = 0
      while i < 4 {
        if i > 0 {
          run out.append(b", ")
        }
        run optional(computed, &mut out, store, edges[i])
        i = i + 1
      }
      run out.append(b")")
    }
    EffectValue.Background { fresh, region } => {
      run out.append(
        if fresh {
          b"new"
        } else {
          b"accumulate"
        },
      )
      match &region {
        Option<[ExprId; 4]>.Some { value: bounds } => {
          let mut i: usize = 0
          while i < 4 {
            run out.append(b" ")
            run expr(computed, &mut out, store, bounds[i])
            i = i + 1
          }
        }
        _ => {}
      }
    }
  }
  return move out
}

// The parser keeps the primitive's dimensional family, but not whether the
// author used translateX/translateY, skewX/skewY, or an explicit default argument.
effect fn operation(
  computed: bool,
  out: &mut Bytes,
  store: &values.Store,
  value: &Operation,
  individual: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let separator = if individual {
    b" "
  } else {
    b", "
  }
  match &value.* {
    Operation.Matrix2 { components } => {
      run out.append(b"matrix(")
      let mut i: usize = 0
      while i < 6 {
        if i > 0 {
          run out.append(b", ")
        }
        run expr(computed, &mut out.*, store, components[i])
        i = i + 1
      }
    }
    Operation.Matrix3 { components } => {
      run out.append(b"matrix3d(")
      let mut i: usize = 0
      while i < 16 {
        if i > 0 {
          run out.append(b", ")
        }
        run expr(computed, &mut out.*, store, components[i])
        i = i + 1
      }
    }
    Operation.Translate { x, y, z, threeD } => {
      let useZ = if individual {
        !literal(store, z, 0.0)
      } else {
        threeD
      }
      if !individual {
        run out.append(
          if useZ {
            b"translate3d("
          } else {
            b"translate("
          },
        )
      }
      run expr(computed, &mut out.*, store, x)
      if useZ || !literal(store, y, 0.0) {
        run out.append(separator)
        run expr(computed, &mut out.*, store, y)
      }
      if useZ {
        run out.append(separator)
        run expr(computed, &mut out.*, store, z)
      }
    }
    Operation.Scale { x, y, z, threeD } => {
      let useZ = if individual {
        !literal(store, z, 1.0)
      } else {
        threeD
      }
      if !individual {
        run out.append(
          if useZ {
            b"scale3d("
          } else {
            b"scale("
          },
        )
      }
      run expr(computed, &mut out.*, store, x)
      if useZ || !same(store, x, y) {
        run out.append(separator)
        run expr(computed, &mut out.*, store, y)
      }
      if useZ {
        run out.append(separator)
        run expr(computed, &mut out.*, store, z)
      }
    }
    Operation.Rotate { x, y, z, angle, threeD } => {
      if individual {
        let xAxis = literal(store, x, 1.0) && literal(store, y, 0.0) && literal(store, z, 0.0)
        let yAxis = literal(store, x, 0.0) && literal(store, y, 1.0) && literal(store, z, 0.0)
        let zAxis = literal(store, x, 0.0) && literal(store, y, 0.0) && literal(store, z, 1.0)
        if xAxis {
          run out.append(b"x ")
        } else if yAxis {
          run out.append(b"y ")
        } else if !zAxis {
          run expr(computed, &mut out.*, store, x)
          run out.append(b" ")
          run expr(computed, &mut out.*, store, y)
          run out.append(b" ")
          run expr(computed, &mut out.*, store, z)
          run out.append(b" ")
        }
      } else {
        run out.append(
          if threeD {
            b"rotate3d("
          } else {
            b"rotate("
          },
        )
        if threeD {
          run expr(computed, &mut out.*, store, x)
          run out.append(b", ")
          run expr(computed, &mut out.*, store, y)
          run out.append(b", ")
          run expr(computed, &mut out.*, store, z)
          run out.append(b", ")
        }
      }
      run expr(computed, &mut out.*, store, angle)
    }
    Operation.Skew { x, y } => {
      run out.append(b"skew(")
      run expr(computed, &mut out.*, store, x)
      if !literal(store, y, 0.0) {
        run out.append(b", ")
        run expr(computed, &mut out.*, store, y)
      }
    }
    Operation.Perspective { depth } => {
      run out.append(b"perspective(")
      match &depth {
        Option<ExprId>.Some { value: distance } => run expr(computed, &mut out.*, store, distance)
        Option<ExprId>.None => run out.append(b"none")
      }
    }
  }
  if !individual {
    run out.append(b")")
  }
}

effect fn transformValueImpl(
  computed: bool,
  store: &values.Store,
  value: &TransformValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  match &value.* {
    TransformValue.None => run out.append(b"none")
    TransformValue.List { operations } => {
      let mut i: usize = 0
      while i < operations.length() {
        if i > 0 {
          run out.append(b" ")
        }
        run operation(computed, &mut out, store, &operations.asSlice()[i], false)
        i = i + 1
      }
    }
    TransformValue.Individual { operation: op } => run operation(
      computed,
      &mut out,
      store,
      &op,
      true,
    )
    TransformValue.Origin { position, z } => {
      run appendPositionImpl(computed, &mut out, store, position)
      if !literal(store, z, 0.0) {
        run out.append(b" ")
        run expr(computed, &mut out, store, z)
      }
    }
    TransformValue.PerspectiveOrigin { position } => run appendPositionImpl(
      computed,
      &mut out,
      store,
      position,
    )
    TransformValue.Perspective { depth } => run expr(computed, &mut out, store, depth)
    TransformValue.Box { value: box } => run out.append(
      match box {
        ReferenceBox.Content => b"content-box"
        ReferenceBox.Border => b"border-box"
        ReferenceBox.Fill => b"fill-box"
        ReferenceBox.Stroke => b"stroke-box"
        ReferenceBox.View => b"view-box"
      },
    )
    TransformValue.Style { value: style } => run out.append(
      if style == TransformStyle.Flat {
        b"flat"
      } else {
        b"preserve-3d"
      },
    )
    TransformValue.BackfaceVisibility { value: visibility } => run out.append(
      if visibility == Backface.Visible {
        b"visible"
      } else {
        b"hidden"
      },
    )
  }
  return move out
}

effect fn pathPoint(out: &mut Bytes, point: Point) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let xy = point.coordinates()
  run syntax.appendNumber(&mut out.*, xy[0])
  run out.append(b" ")
  run syntax.appendNumber(&mut out.*, xy[1])
}

// Path parsing resolves relative/shorthand SVG commands. Serialize its retained
// geometry, rather than claiming the lost author command spelling is available.
pub effect fn pathData(path: &Path) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let segments = path.segments()
  let mut i: usize = 0
  while i < segments.length {
    if i > 0 {
      run out.append(b" ")
    }
    match &segments[i] {
      Segment.MoveTo { to } => {
        run out.append(b"M")
        run pathPoint(&mut out, to)
      }
      Segment.LineTo { to } => {
        run out.append(b"L")
        run pathPoint(&mut out, to)
      }
      Segment.QuadraticTo { control, to } => {
        run out.append(b"Q")
        run pathPoint(&mut out, control)
        run out.append(b" ")
        run pathPoint(&mut out, to)
      }
      Segment.CubicTo { control1, control2, to } => {
        run out.append(b"C")
        run pathPoint(&mut out, control1)
        run out.append(b" ")
        run pathPoint(&mut out, control2)
        run out.append(b" ")
        run pathPoint(&mut out, to)
      }
      Segment.ArcTo { arc } => {
        run out.append(b"A")
        run syntax.appendNumber(&mut out, arc.radii.width)
        run out.append(b" ")
        run syntax.appendNumber(&mut out, arc.radii.height)
        run out.append(b" ")
        run syntax.appendNumber(&mut out, arc.rotationDegrees)
        run out.append(
          if arc.largeArc {
            b" 1 "
          } else {
            b" 0 "
          },
        )
        run out.append(
          if arc.sweep {
            b"1 "
          } else {
            b"0 "
          },
        )
        run pathPoint(&mut out, arc.to)
      }
      Segment.Close => run out.append(b"Z")
    }
    i = i + 1
  }
  return move out
}

fn resolvedNumber(store: &values.Store, id: ExprId, basis: f64) -> f64 {
  let limit = f64.fromBits(9218868437227405311)
  return f64.max(-limit, f64.min(limit, dimensions.evaluate(&store.numerics, id, basis)))
}

fn resolvedOperation(store: &values.Store, value: &Operation, reference: Rect) -> Option<Matrix> {
  let matrix = match &value.* {
    Operation.Matrix2 { components } => transforms.fromAffine(
      Transform.new(
        resolvedNumber(store, components[0], 1.0),
        resolvedNumber(store, components[1], 1.0),
        resolvedNumber(store, components[2], 1.0),
        resolvedNumber(store, components[3], 1.0),
        resolvedNumber(store, components[4], 1.0),
        resolvedNumber(store, components[5], 1.0),
      ),
    )
    Operation.Matrix3 { components } => {
      let mut coefficients = [0.0; 16]
      let mut i: usize = 0
      while i < 16 {
        coefficients[i] = resolvedNumber(store, components[i], 1.0)
        i = i + 1
      }
      transforms.fromColumnMajor(&coefficients)
    }
    Operation.Translate { x, y, z, threeD } => transforms.translation(
      resolvedNumber(store, x, reference.width()),
      resolvedNumber(store, y, reference.height()),
      resolvedNumber(store, z, 1.0),
    )
    Operation.Scale { x, y, z, threeD } => transforms.scale(
      resolvedNumber(store, x, 1.0),
      resolvedNumber(store, y, 1.0),
      resolvedNumber(store, z, 1.0),
    )
    Operation.Rotate { x, y, z, angle, threeD } => transforms.rotation(
      resolvedNumber(store, x, 1.0),
      resolvedNumber(store, y, 1.0),
      resolvedNumber(store, z, 1.0),
      math.radians(resolvedNumber(store, angle, 1.0)),
    )
    Operation.Skew { x, y } => transforms.skew(
      math.radians(resolvedNumber(store, x, 1.0)),
      math.radians(resolvedNumber(store, y, 1.0)),
    )
    Operation.Perspective { depth } => match &depth {
      Option<ExprId>.Some { value: id } => {
        return transforms.perspective(f64.max(0.0, resolvedNumber(store, id, 1.0)))
      }
      Option<ExprId>.None => transforms.identity()
    }
  }
  return if transforms.finite(&matrix) {
    Option<Matrix>.some(matrix)
  } else {
    Option<Matrix>.None
  }
}

// CSSOM's resolved transform uses the transform list alone, not the element's
// transform-origin, ancestor transforms or individual transform properties.
// The caller supplies the actual box selected by transform-box after layout.
pub effect fn resolvedTransform(
  store: &values.Store,
  value: &TransformValue,
  reference: Rect,
) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isValidRect(reference) {
    return Option<Bytes>.None
  }
  let mut matrix = transforms.identity()
  match &value.* {
    TransformValue.None => {
      let mut out = Bytes.make()
      run out.append(b"none")
      return Option<Bytes>.some(move out)
    }
    TransformValue.List { operations } => {
      let mut i: usize = 0
      while i < operations.length() {
        match &resolvedOperation(store, &operations.asSlice()[i], reference) {
          Option<Matrix>.Some { value: next } => {
            matrix = transforms.multiply(&matrix, &next)
          }
          Option<Matrix>.None => {
            return Option<Bytes>.None
          }
        }
        if !transforms.finite(&matrix) {
          return Option<Bytes>.None
        }
        i = i + 1
      }
    }
    _ => {
      return Option<Bytes>.None
    }
  }
  let coefficients = transforms.coefficients(&matrix)
  let twoD = coefficients[2] == 0.0 && coefficients[6] == 0.0 && coefficients[8] == 0.0
    && coefficients[9] == 0.0
    && coefficients[10] == 1.0
    && coefficients[11] == 0.0
    && coefficients[12] == 0.0
    && coefficients[13] == 0.0
    && coefficients[14] == 0.0
    && coefficients[15] == 1.0
  let mut out = Bytes.make()
  run out.append(
    if twoD {
      b"matrix("
    } else {
      b"matrix3d("
    },
  )
  let affine: [usize; 6] = [0, 4, 1, 5, 3, 7]
  let count: usize = if twoD {
    6
  } else {
    16
  }
  let mut i: usize = 0
  while i < count {
    if i > 0 {
      run out.append(b", ")
    }
    let index = if twoD {
      affine[i]
    } else {
      (i % 4) * 4 + i / 4
    }
    run syntax.appendNumber(&mut out, coefficients[index])
    i = i + 1
  }
  run out.append(b")")
  return Option<Bytes>.some(move out)
}

fn resolvedAxis(store: &values.Store, axis: PositionAxis, basis: f64) -> f64 {
  let offset = resolvedNumber(store, axis.offset, basis)
  return match axis.edge {
    Edge.Start => offset
    Edge.Center => basis * 0.5 + offset
    Edge.End => basis - offset
  }
}

pub effect fn resolvedOrigin(
  store: &values.Store,
  value: &TransformValue,
  reference: Rect,
) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isValidRect(reference) {
    return Option<Bytes>.None
  }
  let at = match &value.* {
    TransformValue.Origin { position, z } => position
    TransformValue.PerspectiveOrigin { position } => position
    _ => {
      return Option<Bytes>.None
    }
  }
  let x = resolvedAxis(store, at.x, reference.width())
  let y = resolvedAxis(store, at.y, reference.height())
  if !f64.isFinite(x) || !f64.isFinite(y) {
    return Option<Bytes>.None
  }
  let mut out = Bytes.make()
  run syntax.appendNumber(&mut out, x)
  run out.append(b"px ")
  run syntax.appendNumber(&mut out, y)
  run out.append(b"px")
  match &value.* {
    TransformValue.Origin { position, z } => {
      let depth = resolvedNumber(store, z, 1.0)
      if depth != 0.0 {
        run out.append(b" ")
        run syntax.appendNumber(&mut out, depth)
        run out.append(b"px")
      }
    }
    _ => {}
  }
  return Option<Bytes>.some(move out)
}

pub effect fn appendPosition(out: &mut Bytes, store: &values.Store, value: Position) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run appendPositionImpl(false, &mut out.*, store, value)
}

pub effect fn position(store: &values.Store, value: Position) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run positionImpl(false, store, value)
}

pub effect fn appendImage(out: &mut Bytes, store: &values.Store, value: &Image) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run appendImageImpl(false, &mut out.*, store, value)
}

pub effect fn appendShape(out: &mut Bytes, store: &values.Store, value: &Shape) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run appendShapeImpl(false, &mut out.*, store, value)
}

pub effect fn effectValue(
  store: &values.Store,
  value: &EffectValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run effectValueImpl(false, store, value, sourceProperty, property)
}

pub effect fn computedEffectValue(
  store: &values.Store,
  value: &EffectValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run effectValueImpl(true, store, value, sourceProperty, property)
}

pub effect fn transformValue(
  store: &values.Store,
  value: &TransformValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run transformValueImpl(false, store, value, sourceProperty, property)
}

pub effect fn computedTransformValue(
  store: &values.Store,
  value: &TransformValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run transformValueImpl(true, store, value, sourceProperty, property)
}
