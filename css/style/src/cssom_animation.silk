//! CSS Animations 1 declaration grammar and canonical longhand expansion.
import properties { Property }
import tokens { TokenRange, Kind, Span }
import tokens
import dimensions { Dimension, ExprId, Store }
import dimensions
import input { Input, TokenView, TokenRef }
import value_cursor { Cursor }
import cssom_serialization
import cssom_numeric_serialization
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn slot(property: Property) -> usize {
  return match property {
    Property.AnimationName => 0
    Property.AnimationDuration => 1
    Property.AnimationTimingFunction => 2
    Property.AnimationDelay => 3
    Property.AnimationIterationCount => 4
    Property.AnimationDirection => 5
    Property.AnimationFillMode => 6
    Property.AnimationPlayState => 7
    _ => 8
  }
}

fn initial(index: usize) -> &'static [u8] {
  return match index {
    0 => b"none"
    1 => b"0s"
    2 => b"ease"
    3 => b"0s"
    4 => b"1"
    5 => b"normal"
    6 => b"none"
    _ => b"running"
  }
}

fn keyword(index: usize, value: &[u8]) -> &'static [u8] {
  if index == 2 {
    if tokens.insensitive(value, b"ease") {
      return b"ease"
    }
    if tokens.insensitive(value, b"linear") {
      return b"linear"
    }
    if tokens.insensitive(value, b"ease-in") {
      return b"ease-in"
    }
    if tokens.insensitive(value, b"ease-out") {
      return b"ease-out"
    }
    if tokens.insensitive(value, b"ease-in-out") {
      return b"ease-in-out"
    }
    if tokens.insensitive(value, b"step-start") {
      return b"step-start"
    }
    if tokens.insensitive(value, b"step-end") {
      return b"step-end"
    }
  }
  if index == 4 && tokens.insensitive(value, b"infinite") {
    return b"infinite"
  }
  if index == 5 {
    if tokens.insensitive(value, b"normal") {
      return b"normal"
    }
    if tokens.insensitive(value, b"reverse") {
      return b"reverse"
    }
    if tokens.insensitive(value, b"alternate") {
      return b"alternate"
    }
    if tokens.insensitive(value, b"alternate-reverse") {
      return b"alternate-reverse"
    }
  }
  if index == 6 {
    if tokens.insensitive(value, b"none") {
      return b"none"
    }
    if tokens.insensitive(value, b"forwards") {
      return b"forwards"
    }
    if tokens.insensitive(value, b"backwards") {
      return b"backwards"
    }
    if tokens.insensitive(value, b"both") {
      return b"both"
    }
  }
  if index == 7 {
    if tokens.insensitive(value, b"running") {
      return b"running"
    }
    if tokens.insensitive(value, b"paused") {
      return b"paused"
    }
  }
  return b""
}

fn kind(source: &Input, at: usize) -> Kind {
  return match &source.at(at) {
    Option<TokenView>.Some { value } => value.token.kind
    _ => Kind.Eof
  }
}

fn text(source: &Input, at: usize, span: Span) -> &[u8] {
  return match &source.at(at) {
    Option<TokenView>.Some { value } => value.text(span)
    _ => b""
  }
}

fn part<'a>(source: &'a Input, range: TokenRange) -> Input<'a> {
  return match &source.* {
    Input.Contiguous { buffer, range: outer } => Input.Contiguous {
      buffer: buffer,
      range: TokenRange { start: outer.start + range.start, end: outer.start + range.end },
    }
    Input.Expanded { buffers, references } => Input.Expanded {
      buffers: buffers,
      references: Slice.view<TokenRef>(references, range.start, range.end - range.start),
    }
  }
}

fn skip(source: &Input, at: usize, end: usize) -> usize {
  let mut position = at
  while position < end
    && match &kind(source, position) {
      Kind.Whitespace => true
      _ => false
    } {
    position = position + 1
  }
  return position
}

fn next(source: &Input, at: usize, end: usize) -> usize {
  if !match &kind(source, at) {
    Kind.Function { name } => true
    _ => false
  } {
    return at + 1
  }
  let mut position = at + 1
  let mut depth: usize = 1
  while position < end {
    match &kind(source, position) {
      Kind.Function { name } => {
        depth = depth + 1
      }
      Kind.OpenParen => {
        depth = depth + 1
      }
      Kind.CloseParen => {
        depth = depth - 1
      }
      _ => {}
    }
    position = position + 1
    if depth == 0 {
      return position
    }
  }
  return end
}

fn easing(source: &Input, start: usize, end: usize) -> bool {
  let name = match &kind(source, start) {
    Kind.Function { name } => text(source, start, name)
    _ => {
      return false
    }
  }
  if !match &kind(source, end - 1) {
    Kind.CloseParen => true
    _ => false
  } {
    return false
  }
  let close = end - 1
  let mut at = skip(source, start + 1, close)
  if tokens.insensitive(name, b"cubic-bezier") {
    let mut count: usize = 0
    while count < 4 {
      if at >= close {
        return false
      }
      match &kind(source, at) {
        Kind.Number { value, integer } => {
          if (count == 0 || count == 2) && (value < 0.0 || value > 1.0) {
            return false
          }
        }
        _ => {
          return false
        }
      }
      at = skip(source, at + 1, close)
      count = count + 1
      if count < 4 {
        if at >= close
          || !match &kind(source, at) {
            Kind.Comma => true
            _ => false
          } {
          return false
        }
        at = skip(source, at + 1, close)
      }
    }
    return at == close
  }
  if tokens.insensitive(name, b"steps") {
    if at >= close {
      return false
    }
    let count = match &kind(source, at) {
      Kind.Number { value, integer } => {
        if !integer || value < 1.0 {
          return false
        }
        value
      }
      _ => {
        return false
      }
    }
    at = skip(source, at + 1, close)
    if at == close {
      return true
    }
    if !match &kind(source, at) {
      Kind.Comma => true
      _ => false
    } {
      return false
    }
    at = skip(source, at + 1, close)
    if at >= close {
      return false
    }
    let position = match &kind(source, at) {
      Kind.Ident { text: span } => text(source, at, span)
      _ => {
        return false
      }
    }
    if tokens.insensitive(position, b"jump-none") {
      if count < 2.0 {
        return false
      }
    } else if !tokens.insensitive(position, b"start") && !tokens.insensitive(position, b"end")
      && !tokens.insensitive(position, b"jump-start")
      && !tokens.insensitive(position, b"jump-end")
      && !tokens.insensitive(position, b"jump-both") {
      return false
    }
    return skip(source, at + 1, close) == close
  }
  if tokens.insensitive(name, b"linear") {
    let mut stops: usize = 0
    while at < close {
      let mut number = false
      let mut percentages: usize = 0
      let mut afterNumber = false
      while at < close
        && !match &kind(source, at) {
          Kind.Comma => true
          _ => false
        } {
        match &kind(source, at) {
          Kind.Number { value, integer } => {
            if number {
              return false
            }
            number = true
            afterNumber = percentages != 0
          }
          Kind.Percentage { value, integer } => {
            if afterNumber {
              return false
            }
            percentages = percentages + 1
            if percentages > 2 {
              return false
            }
          }
          _ => {
            return false
          }
        }
        at = skip(source, at + 1, close)
      }
      if !number {
        return false
      }
      stops = stops + 1
      if at == close {
        return stops >= 2
      }
      at = skip(source, at + 1, close)
    }
  }
  return false
}

effect fn component(index: usize, source: &Input, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = kind(source, range.start)
  if index == 0 {
    match &first {
      Kind.Ident { text: span } => {
        let name = text(source, range.start, span)
        if tokens.insensitive(name, b"initial") || tokens.insensitive(name, b"inherit")
          || tokens.insensitive(name, b"unset")
          || tokens.insensitive(name, b"revert")
          || tokens.insensitive(name, b"revert-layer")
          || tokens.insensitive(name, b"default") {
          return Option<Bytes>.None
        }
        return Option<Bytes>.some(
          if tokens.insensitive(name, b"none") {
            run Bytes.copy(b"none")
          } else {
            run cssom_serialization.identifier(name)
          },
        )
      }
      Kind.String { text: span } => {
        return Option<Bytes>.some(run cssom_serialization.string(text(source, range.start, span)))
      }
      _ => {
        return Option<Bytes>.None
      }
    }
  }
  match &first {
    Kind.Ident { text: span } => {
      let canonical = keyword(index, text(source, range.start, span))
      if canonical.length != 0 {
        return Option<Bytes>.some(run Bytes.copy(canonical))
      }
    }
    _ => {}
  }
  let input = part(source, range)
  if index == 2 && easing(source, range.start, range.end) {
    return Option<Bytes>.some(run cssom_serialization.componentsInput(&input))
  }
  if index == 1 || index == 3 || index == 4 {
    let mut cursor = Cursor.make(&input)
    let mut store = Store.make()
    let expected = if index == 4 {
      Dimension.Number
    } else {
      Dimension.Time
    }
    match &run dimensions.parse(&mut store, &input, &mut cursor, expected, false) {
      Option<ExprId>.Some { value } => {
        if !cursor.done(&input) || (index != 3 && dimensions.negativeLiteral(&store, value)) {
          return Option<Bytes>.None
        }
        return Option<Bytes>.some(run cssom_numeric_serialization.expression(&store, value))
      }
      _ => {}
    }
  }
  return Option<Bytes>.None
}

pub effect fn parseInput(property: Property, source: &Input) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let shorthand = property == Property.Animation
  let count: usize = if shorthand {
    8
  } else {
    1
  }
  let target = slot(property)
  if !shorthand && target == 8 {
    return List<Bytes>.make()
  }
  let mut out = run List<Bytes>.makeWithCapacity(count)
  let mut at: usize = 0
  while at < count {
    run out.append(Bytes.make())
    at = at + 1
  }
  at = skip(source, 0, source.length())
  if at == source.length() {
    return List<Bytes>.make()
  }
  while at < source.length() {
    let mut layer = run List<Bytes>.makeWithCapacity(count)
    let mut k: usize = 0
    while k < count {
      run layer.append(Bytes.make())
      k = k + 1
    }
    let mut any = false
    while at < source.length()
      && !match &kind(source, at) {
        Kind.Comma => true
        _ => false
      } {
      let end = next(source, at, source.length())
      let range = TokenRange { start: at, end: end }
      let mut matched = false
      if shorthand {
        let order: [usize; 8] = [1, 2, 3, 4, 5, 6, 7, 0]
        k = 0
        while k < 8 {
          let candidate = order[k]

          // The first time always fills duration; a negative first time is invalid.
          if layer.asSlice()[candidate].length() == 0
            && (candidate != 3 || layer.asSlice()[1].length() != 0) {
            match run component(candidate, source, range) {
              Option<Bytes>.Some { value } => {
                layer.set(candidate, move value)
                matched = true
              }
              _ => {}
            }
            if matched {
              break
            }
          }
          k = k + 1
        }
      } else if !any {
        match run component(target, source, range) {
          Option<Bytes>.Some { value } => {
            layer.set(0, move value)
            matched = true
          }
          _ => {}
        }
      }
      if !matched {
        return List<Bytes>.make()
      }
      any = true
      at = skip(source, end, source.length())
    }
    if !any {
      return List<Bytes>.make()
    }
    k = 0
    while k < count {
      let mut destination = out.asMutSlice()
      if destination[k].length() != 0 {
        run destination[k].append(b", ")
      }
      if layer.asSlice()[k].length() == 0 {
        run destination[k].append(initial(k))
      } else {
        run destination[k].append(Bytes.asSlice(&layer.asSlice()[k]))
      }
      k = k + 1
    }
    if at == source.length() {
      return move out
    }
    at = skip(source, at + 1, source.length())
    if at == source.length() {
      return List<Bytes>.make()
    }
  }
  return move out
}
