//! Normative sources pinned in images/svg/specs.lock.json: css-syntax-3 and encoding.
import encoding { Encoding, DecodedStylesheet, decodeStylesheet, label }
import tokens { CssError, CssErrorKind, equal }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

effect fn decoded(data: &[u8], selected: Encoding, expected: &[u8]) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let result = run decodeStylesheet(
    data,
    Option<Encoding>.some(selected),
    Option<Encoding>.None,
    expected.length,
  )
  run Testing.expect(
    equal(result.bytes.asSlice(), expected),
    "decoder emits the normative scalar sequence",
  )
  run Testing.expect(result.encoding == selected, "effective source encoding survives decoding")
}

// https://www.w3.org/TR/css-syntax-3/#css-decode-bytes
// https://www.w3.org/TR/css-syntax-3/#determine-the-fallback-encoding
// https://encoding.spec.whatwg.org/#bom-sniff
test effect fn stylesheetEncodingPrecedence() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let bom = run decodeStylesheet(
    b"\xef\xbb\xbf\xc3\xa9",
    Option<Encoding>.some(Encoding.Windows1252),
    Option<Encoding>.some(Encoding.Ibm866),
    2,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    bom.encoding == Encoding.Utf8 && equal(bom.bytes.asSlice(), b"\xc3\xa9"),
    "BOM overrides protocol and environment",
  )
  let be = run decodeStylesheet(
    b"\xfe\xff\x00a",
    Option<Encoding>.some(Encoding.Utf16Le),
    Option<Encoding>.None,
    1,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    be.encoding == Encoding.Utf16Be && equal(be.bytes.asSlice(), b"a"),
    "UTF16 BOM overrides opposite endian label",
  )
  let le = run decodeStylesheet(b"\xff\xfea\x00", Option<Encoding>.None, Option<Encoding>.None, 1)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    le.encoding == Encoding.Utf16Le && equal(le.bytes.asSlice(), b"a"),
    "UTF16 little-endian BOM",
  )
  let protocol = run decodeStylesheet(
    b"@charset \"utf-8\";\xe9",
    Option<Encoding>.some(Encoding.Windows1252),
    Option<Encoding>.some(Encoding.Ibm866),
    64,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    protocol.encoding == Encoding.Windows1252
      && equal(protocol.bytes.asSlice(), b"@charset \"utf-8\";\xc3\xa9"),
    "protocol wins over charset; charset bytes remain in text",
  )
  let charset = run decodeStylesheet(
    b"@charset \"windows-1252\";\xe9",
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Ibm866),
    64,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(charset.encoding == Encoding.Windows1252, "charset wins over environment")
  let environment = run decodeStylesheet(
    b"\xe9",
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Windows1252),
    2,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    environment.encoding == Encoding.Windows1252 && equal(environment.bytes.asSlice(), b"\xc3\xa9"),
    "environment is fallback",
  )
  let inherited = run decodeStylesheet(
    b"\xe9",
    Option<Encoding>.None,
    Option<Encoding>.some(environment.encoding),
    2,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(inherited.bytes.asSlice(), b"\xc3\xa9"),
    "import inherits actual source encoding, not output UTF8",
  )
}

// https://www.w3.org/TR/css-syntax-3/#determine-the-fallback-encoding
test effect fn charsetRequiresExactAsciiPrefixAndBoundedProbe() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let ignored = [
    b" @charset \"utf-8\";",
    b"@CHARSET \"utf-8\";",
    b"@charset  \"utf-8\";",
    b"@charset 'utf-8';",
    b"@charset \"utf-8\"",
    b"@charset \"utf-8\" ;",
    b"@charset \"unknown\";",
    b"@charset \"ut\xfff-8\";",
  ]
  let mut i: usize = 0
  while i < ignored.length {
    let result = run decodeStylesheet(
      ignored[i],
      Option<Encoding>.None,
      Option<Encoding>.some(Encoding.Windows1252),
      128,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      result.encoding == Encoding.Windows1252,
      "nonconforming charset declaration does not select encoding",
    )
    i = i + 1
  }
  let utf16 = run decodeStylesheet(
    b"@charset \"utf-16le\";",
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Windows1252),
    64,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    utf16.encoding == Encoding.Utf8,
    "ASCII UTF16 charset selects UTF8 rather than environment",
  )
  let mut boundary = Bytes.make()
  run boundary.append(b"@charset \"") |> Effect.provideMut<Allocator>(&mut allocator)
  i = 0
  while i < 1007 {
    run boundary.append(b" ") |> Effect.provideMut<Allocator>(&mut allocator)
    i = i + 1
  }
  run boundary.append(b"utf-8\";") |> Effect.provideMut<Allocator>(&mut allocator)
  let exact = run decodeStylesheet(
    boundary.asSlice(),
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Windows1252),
    1024,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exact.encoding == Encoding.Utf8, "semicolon at byte 1024 is inside probe")
  let mut outside = Bytes.make()
  run outside.append(b"@charset \" ") |> Effect.provideMut<Allocator>(&mut allocator)
  i = 0
  while i < 1007 {
    run outside.append(b" ") |> Effect.provideMut<Allocator>(&mut allocator)
    i = i + 1
  }
  run outside.append(b"utf-8\";") |> Effect.provideMut<Allocator>(&mut allocator)
  let late = run decodeStylesheet(
    outside.asSlice(),
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Windows1252),
    1025,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    late.encoding == Encoding.Windows1252,
    "semicolon beyond byte 1024 does not select charset",
  )
}

// https://encoding.spec.whatwg.org/#utf-8-decoder
// https://www.w3.org/TR/css-syntax-3/#input-preprocessing
test effect fn utf8ReplacementPartitionsAndNoLexicalNormalization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decoded(b"\xe2\x82", Encoding.Utf8, b"\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xe2\x82\"", Encoding.Utf8, b"\xef\xbf\xbd\"")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xe0\x80\x80", Encoding.Utf8, b"\xef\xbf\xbd\xef\xbf\xbd\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xed\xa0\x80", Encoding.Utf8, b"\xef\xbf\xbd\xef\xbf\xbd\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(
    b"\xf4\x90\x80\x80",
    Encoding.Utf8,
    b"\xef\xbf\xbd\xef\xbf\xbd\xef\xbf\xbd\xef\xbf\xbd",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xf0\x9f\x98\x80", Encoding.Utf8, b"\xf0\x9f\x98\x80")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\r\n\x0c\x00", Encoding.Utf8, b"\r\n\x0c\x00")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"a\xef\xbb\xbf", Encoding.Utf8, b"a\xef\xbb\xbf")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://encoding.spec.whatwg.org/#shared-utf-16-decoder
test effect fn utf16SurrogatesAndOddEof() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decoded(b"\x3d\xd8\x00\xde", Encoding.Utf16Le, b"\xf0\x9f\x98\x80")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xd8\x3d\xde\x00", Encoding.Utf16Be, b"\xf0\x9f\x98\x80")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\x00\xd8a\x00", Encoding.Utf16Le, b"\xef\xbf\xbda")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\x00\xdc", Encoding.Utf16Le, b"\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\x00\xd8a", Encoding.Utf16Le, b"\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"a", Encoding.Utf16Be, b"\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://encoding.spec.whatwg.org/#single-byte-decoder
// https://encoding.spec.whatwg.org/#replacement-decoder
// https://encoding.spec.whatwg.org/#x-user-defined-decoder
test effect fn LegacyAndReplacementDecodeSemantics() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decoded(b"\x80\xe9", Encoding.Windows1252, b"\xe2\x82\xac\xc3\xa9")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\xa5A", Encoding.Iso8859_3, b"\xef\xbf\xbdA")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"any bytes", Encoding.Replacement, b"\xef\xbf\xbd")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"", Encoding.Replacement, b"") |> Effect.provideMut<Allocator>(&mut allocator)
  run decoded(b"\x80\xff", Encoding.XUserDefined, b"\xef\x9e\x80\xef\x9f\xbf")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://encoding.spec.whatwg.org/#decode
// https://encoding.spec.whatwg.org/#utf-8-decoder
test effect fn decodedOutputBoundIsExactAndReplacementAware() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let empty = run decodeStylesheet(b"\xef\xbb\xbf", Option<Encoding>.None, Option<Encoding>.None, 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(empty.bytes.length() == 0, "consumed BOM needs no output storage")
  let result = run Effect.result(
    decodeStylesheet(b"\xff", Option<Encoding>.None, Option<Encoding>.None, 2)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &result {
      Result<DecodedStylesheet, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.StorageLimit && problem.offset == 0
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "expanded replacement is bounded before writing, not after allocation",
  )
}

// https://www.w3.org/TR/css-syntax-3/#determine-the-fallback-encoding
// https://encoding.spec.whatwg.org/#decode
test effect fn utf16EnvironmentAndProtocolRemainUtf16() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let environment = run decodeStylesheet(
    b"a\x00",
    Option<Encoding>.None,
    Option<Encoding>.some(Encoding.Utf16Le),
    1,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    environment.encoding == Encoding.Utf16Le && equal(environment.bytes.asSlice(), b"a"),
    "only charset declarations coerce UTF16 to UTF8",
  )
  let protocol = run decodeStylesheet(
    b"\x00a",
    Option<Encoding>.some(Encoding.Utf16Be),
    Option<Encoding>.some(Encoding.Utf8),
    1,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    protocol.encoding == Encoding.Utf16Be && equal(protocol.bytes.asSlice(), b"a"),
    "UTF16 protocol label stays effective without BOM",
  )
  let noHint = run decodeStylesheet(b"\xe9", Option<Encoding>.None, Option<Encoding>.None, 3)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    noHint.encoding == Encoding.Utf8 && equal(noHint.bytes.asSlice(), b"\xef\xbf\xbd"),
    "no hints select UTF8 with replacement",
  )
  let unknownProtocol = run decodeStylesheet(
    b"@charset \"windows-1252\";\xe9",
    label(b"not-a-charset"),
    Option<Encoding>.None,
    64,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    unknownProtocol.encoding == Encoding.Windows1252,
    "unknown protocol labels fall through to the charset probe",
  )
  let doubleBom = run decodeStylesheet(
    b"\xef\xbb\xbf\xef\xbb\xbf",
    Option<Encoding>.some(Encoding.Replacement),
    Option<Encoding>.None,
    3,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    doubleBom.encoding == Encoding.Utf8 && equal(doubleBom.bytes.asSlice(), b"\xef\xbb\xbf"),
    "BOM overrides replacement label and exactly one BOM is consumed",
  )
}
