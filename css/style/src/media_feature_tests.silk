//! Pinned MQ4 feature semantics; lexer input is shared with declarations and conditions.
import media_features {
  Environment,
  MediaType,
  Truth,
  ColorGamut,
  Scan,
  Update,
  OverflowBlock,
  Pointer,
  ColorScheme,
  evaluate
}
import input { Input, TokenRef }
import tokens { TokenBuffer, Limits, CssError }
import lexer { tokenize }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }

effect fn expectFeature(text: &[u8], environment: &Environment, expected: Truth) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run tokenize(text, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  run Testing.expect(
    (run evaluate(&source, 0, source.length(), environment)) == expected,
    "media feature matches normative result",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#mq-range-context
// https://www.w3.org/TR/mediaqueries-4/#mq-min-max
// https://www.w3.org/TR/mediaqueries-4/#error-handling
// https://www.w3.org/TR/mediaqueries-4/#mq-syntax
effect fn rangesCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let environment = Environment.headless(800.5, 600.0)
  run expectFeature(b"width: 800.5px", &environment, Truth.True)
  run expectFeature(b"800px < width <= 801px", &environment, Truth.True)
  run expectFeature(b"801px > width >= 800.5px", &environment, Truth.True)
  run expectFeature(b"800.5px = width", &environment, Truth.True)
  run expectFeature(b"width > 800.5px", &environment, Truth.False)
  run expectFeature(b"min-width: 800.5px", &environment, Truth.True)
  run expectFeature(b"max-width: 800px", &environment, Truth.False)
  run expectFeature(b"width <= -1px", &environment, Truth.False)
  run expectFeature(b"-1px < width", &environment, Truth.True)
  run expectFeature(b"min-resolution: -300dpi", &environment, Truth.True)
  run expectFeature(b"resolution: -300dpi", &environment, Truth.False)
  run expectFeature(b"min-color: -2", &environment, Truth.True)
  run expectFeature(b"800px < width > 700px", &environment, Truth.Unknown)
  run expectFeature(b"800px = width = 800px", &environment, Truth.Unknown)
  run expectFeature(b"width < = 900px", &environment, Truth.Unknown)
  run expectFeature(b"width <= 900px junk", &environment, Truth.Unknown)
  run expectFeature(b"min-width", &environment, Truth.Unknown)
  run expectFeature(b"min-width >= 1px", &environment, Truth.Unknown)
  run expectFeature(b"min-grid: 1", &environment, Truth.Unknown)
  run expectFeature(b"orientation > portrait", &environment, Truth.Unknown)
  run expectFeature(b"future: yes", &environment, Truth.Unknown)
  run expectFeature(b"width: 2bananas", &environment, Truth.Unknown)
  run expectFeature(b"width: 50%", &environment, Truth.Unknown)
  run expectFeature(b"width: 800.5", &environment, Truth.Unknown)
}

// https://www.w3.org/TR/mediaqueries-4/#units
// https://www.w3.org/TR/mediaqueries-4/#width
// https://www.w3.org/TR/mediaqueries-4/#height
// https://www.w3.org/TR/mediaqueries-4/#aspect-ratio
// https://www.w3.org/TR/mediaqueries-4/#orientation
// https://www.w3.org/TR/css-values-4/#ratios
// https://www.w3.org/TR/mediaqueries-4/#mf-deprecated
effect fn dimensionsCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut environment = Environment.headless(960.0, 600.0)
  run expectFeature(b"width: 10in", &environment, Truth.True)
  run expectFeature(b"height: 37.5em", &environment, Truth.True)
  run expectFeature(b"width: 60rem", &environment, Truth.True)
  run expectFeature(b"width: 100vw", &environment, Truth.True)
  run expectFeature(b"width: calc(50vw + 30em)", &environment, Truth.True)
  run expectFeature(b"orientation: landscape", &environment, Truth.True)
  run expectFeature(b"aspect-ratio: 8/5", &environment, Truth.True)
  run expectFeature(b"aspect-ratio: 1.6", &environment, Truth.True)
  run expectFeature(b"1.5 < aspect-ratio < 2", &environment, Truth.True)
  run expectFeature(b"aspect-ratio: -8/-5", &environment, Truth.Unknown)
  run expectFeature(b"aspect-ratio < 1/0", &environment, Truth.True)
  run expectFeature(b"aspect-ratio: 0/0", &environment, Truth.False)
  environment.deviceWidth = 1920.0
  environment.deviceHeight = 1080.0
  run expectFeature(b"device-width: 1920px", &environment, Truth.True)
  run expectFeature(b"min-device-height: 1000px", &environment, Truth.True)
  run expectFeature(b"device-aspect-ratio: 16/9", &environment, Truth.True)
  environment.initial.fontSize = 20.0
  environment.initial.rootFontSize = 20.0
  run expectFeature(b"height: 30em", &environment, Truth.True)
  run expectFeature(b"height: 30rem", &environment, Truth.True)
  environment.initial.viewportWidth = 600.0
  run expectFeature(b"orientation: portrait", &environment, Truth.True)
  environment.mediaType = MediaType.Speech
  run expectFeature(b"width > -1px", &environment, Truth.False)
  run expectFeature(b"device-aspect-ratio", &environment, Truth.False)
  run expectFeature(b"width: nonsense", &environment, Truth.Unknown)
}

// https://www.w3.org/TR/mediaqueries-4/#resolution
// https://www.w3.org/TR/mediaqueries-4/#color
// https://www.w3.org/TR/mediaqueries-4/#color-index
// https://www.w3.org/TR/mediaqueries-4/#monochrome
// https://www.w3.org/TR/mediaqueries-4/#color-gamut
// https://www.w3.org/TR/mediaqueries-4/#grid
effect fn displayCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut environment = Environment.headless(800.0, 600.0)
  run expectFeature(b"resolution: 96dpi", &environment, Truth.True)
  run expectFeature(b"resolution: 1dppx", &environment, Truth.True)
  run expectFeature(b"resolution: 0", &environment, Truth.Unknown)
  environment.resolutionDppx = 2.0
  run expectFeature(b"192dpi <= resolution < 3dppx", &environment, Truth.True)
  environment.infiniteResolution = true
  run expectFeature(b"resolution: infinite", &environment, Truth.True)
  run expectFeature(b"resolution > 1000000dpi", &environment, Truth.True)
  run expectFeature(b"infinite <= resolution", &environment, Truth.True)
  run expectFeature(b"color: 8", &environment, Truth.True)
  run expectFeature(b"color: 8.0", &environment, Truth.Unknown)
  run expectFeature(b"color-index", &environment, Truth.False)
  environment.colorIndex = 256
  run expectFeature(b"color-index >= 256", &environment, Truth.True)
  environment.monochromeBits = 4
  run expectFeature(b"monochrome > 2", &environment, Truth.True)
  environment.colorGamut = ColorGamut.Rec2020
  run expectFeature(b"color-gamut: srgb", &environment, Truth.True)
  run expectFeature(b"color-gamut: p3", &environment, Truth.True)
  run expectFeature(b"color-gamut: rec2020", &environment, Truth.True)
  environment.colorGamut = ColorGamut.None
  run expectFeature(b"color-gamut", &environment, Truth.False)
  run expectFeature(b"color-gamut: none", &environment, Truth.Unknown)
  run expectFeature(b"grid: -0", &environment, Truth.True)
  run expectFeature(b"grid", &environment, Truth.False)
  environment.grid = true
  run expectFeature(b"grid: 1", &environment, Truth.True)
  run expectFeature(b"grid: 2", &environment, Truth.Unknown)
  run expectFeature(b"grid: 1.0", &environment, Truth.Unknown)
  run expectFeature(b"grid >= 0", &environment, Truth.Unknown)
}

// https://www.w3.org/TR/mediaqueries-4/#mq-boolean-context
// https://www.w3.org/TR/mediaqueries-4/#scan
// https://www.w3.org/TR/mediaqueries-4/#update
// https://www.w3.org/TR/mediaqueries-4/#mf-overflow-block
// https://www.w3.org/TR/mediaqueries-4/#mf-overflow-inline
// https://www.w3.org/TR/mediaqueries-4/#pointer
// https://www.w3.org/TR/mediaqueries-4/#hover
// https://www.w3.org/TR/mediaqueries-4/#@media/any-input
effect fn capabilitiesCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut environment = Environment.headless(800.0, 600.0)
  run expectFeature(b"scan: progressive", &environment, Truth.True)
  run expectFeature(b"update", &environment, Truth.False)
  run expectFeature(b"overflow-block: none", &environment, Truth.True)
  run expectFeature(b"overflow-inline", &environment, Truth.False)
  run expectFeature(b"pointer: none", &environment, Truth.True)
  run expectFeature(b"hover", &environment, Truth.False)
  run expectFeature(b"any-pointer: none", &environment, Truth.True)
  run expectFeature(b"any-hover: none", &environment, Truth.True)
  environment.scan = Scan.Interlace
  environment.update = Update.Slow
  environment.overflowBlock = OverflowBlock.Paged
  environment.overflowInline = true
  environment.pointer = Pointer.Coarse
  environment.anyPointerCoarse = true
  environment.anyPointerFine = true
  environment.anyHover = true
  run expectFeature(b"scan: interlace", &environment, Truth.True)
  run expectFeature(b"update: slow", &environment, Truth.True)
  run expectFeature(b"update", &environment, Truth.True)
  run expectFeature(b"overflow-block: paged", &environment, Truth.True)
  run expectFeature(b"overflow-inline: scroll", &environment, Truth.True)
  run expectFeature(b"overflow-inline: paged", &environment, Truth.Unknown)
  run expectFeature(b"pointer: coarse", &environment, Truth.True)
  run expectFeature(b"pointer: fine", &environment, Truth.False)
  run expectFeature(b"any-pointer: coarse", &environment, Truth.True)
  run expectFeature(b"any-pointer: fine", &environment, Truth.True)
  run expectFeature(b"any-pointer: none", &environment, Truth.False)
  run expectFeature(b"hover: none", &environment, Truth.True)
  run expectFeature(b"any-hover: hover", &environment, Truth.True)
  run expectFeature(b"any-hover: none", &environment, Truth.False)
  environment.scan = Scan.None
  run expectFeature(b"scan", &environment, Truth.False)
}

// https://www.w3.org/TR/mediaqueries-4/#mq-syntax
effect fn expandedCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut buffers = List<TokenBuffer>.make()
  run buffers.append((run tokenize(b"100px < ", &Limits.make())))
  run buffers.append((run tokenize(b"w\\69 dth <= 900px", &Limits.make())))
  let mut references = List<TokenRef>.make()
  let mut b: usize = 0
  while b < buffers.length() {
    let mut t: usize = 0
    while t < buffers.asSlice()[b].all().end {
      run references.append(TokenRef { buffer: b, token: t })
      t = t + 1
    }
    b = b + 1
  }
  let source = Input.Expanded { buffers: buffers.asSlice(), references: references.asSlice() }
  let environment = Environment.headless(800.0, 600.0)
  run Testing.expect(
    (run evaluate(&source, 0, source.length(), &environment)) == Truth.True,
    "expanded escaped feature name retains token boundaries",
  )
  run Testing.expect(
    (run evaluate(&source, source.length(), 0, &environment)) == Truth.Unknown,
    "reversed bounds do not trap",
  )
  run Testing.expect(
    (run evaluate(&source, 0, source.length() + 1, &environment)) == Truth.Unknown,
    "out of range bounds do not trap",
  )
}

test effect fn mediaFeatureRanges() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run rangesCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mediaFeatureDimensions() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dimensionsCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mediaFeatureDisplay() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run displayCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mediaFeatureCapabilities() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run capabilitiesCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mediaFeatureExpandedInput() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run expandedCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/mediaqueries-5/#prefers-color-scheme
// https://www.w3.org/TR/mediaqueries-5/#prefers-reduced-motion
// Pinned mediaqueries-5: 9e761f96f6a9935591264b470bdf5e4c1b5b15874c376b9de70e670171671c95.
effect fn preferencesCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut environment = Environment.headless(800.0, 600.0)
  run expectFeature(b"prefers-color-scheme: light", &environment, Truth.True)
  run expectFeature(b"prefers-color-scheme: dark", &environment, Truth.False)
  run expectFeature(b"prefers-color-scheme", &environment, Truth.True)
  run expectFeature(b"prefers-color-scheme: no-preference", &environment, Truth.Unknown)
  run expectFeature(b"prefers-reduced-motion: no-preference", &environment, Truth.True)
  run expectFeature(b"prefers-reduced-motion", &environment, Truth.False)
  run expectFeature(b"prefers-reduced-motion: reduce", &environment, Truth.False)
  environment.colorScheme = ColorScheme.Dark
  environment.reducedMotion = true
  run expectFeature(b"PREFERS-COLOR-SCHEME: DARK", &environment, Truth.True)
  run expectFeature(b"prefers-color-scheme: light", &environment, Truth.False)
  run expectFeature(b"prefers-reduced-motion: reduce", &environment, Truth.True)
  run expectFeature(b"prefers-reduced-motion", &environment, Truth.True)
  run expectFeature(b"prefers-reduced-motion: no-preference", &environment, Truth.False)
  run expectFeature(b"prefers-reduced-motion: none", &environment, Truth.Unknown)
  run expectFeature(b"min-prefers-color-scheme: dark", &environment, Truth.Unknown)
  run expectFeature(b"prefers-reduced-motion >= reduce", &environment, Truth.Unknown)
  environment.mediaType = MediaType.Print
  environment.colorScheme = ColorScheme.Light
  run expectFeature(b"prefers-color-scheme: light", &environment, Truth.True)
  run expectFeature(b"prefers-reduced-motion", &environment, Truth.True)
}

test effect fn mediaFeaturePreferences() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run preferencesCase() |> Effect.provideMut<Allocator>(&mut allocator)
}
