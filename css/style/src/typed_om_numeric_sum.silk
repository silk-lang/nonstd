//! CSS Typed OM sum values keep symbolic relative units distinct until they cancel.
import typed_om_numeric { NumericStore, NumericId, NumericOperator, UnitValue }
import typed_om_numeric_units { lookup, UnitInfo }
import cssom_error { CssomError }
import tokens { equal }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

pub fn minimum(a: f64, b: f64) -> f64 {
  if a != a || b != b {
    return f64.fromBits(9221120237041090560)
  }
  if a == 0.0 && b == 0.0 {
    return if f64.toBits(a) != 0 || f64.toBits(b) != 0 {
      -0.0
    } else {
      0.0
    }
  }
  return f64.min(a, b)
}

pub fn maximum(a: f64, b: f64) -> f64 {
  if a != a || b != b {
    return f64.fromBits(9221120237041090560)
  }
  if a == 0.0 && b == 0.0 {
    return if f64.toBits(a) != 0 && f64.toBits(b) != 0 {
      -0.0
    } else {
      0.0
    }
  }
  return f64.max(a, b)
}

struct Power {
  unit: &'static [u8],
  exponent: i32
}

impl Copy for Power {}

struct Term {
  value: f64,
  powers: List<Power>
}

fn same(a: &Term, b: &Term) -> bool {
  if a.powers.length() != b.powers.length() {
    return false
  }
  let mut i: usize = 0
  while i < a.powers.length() {
    let left = a.powers.asSlice()[i]
    let mut found = false
    let mut j: usize = 0
    while j < b.powers.length() {
      let right = b.powers.asSlice()[j]
      if equal(left.unit, right.unit) && left.exponent == right.exponent {
        found = true
      }
      j = j + 1
    }
    if !found {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn merge(out: &mut List<Term>, term: Term) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < out.length() {
    if same(&out.asSlice()[i], &term) {
      let entries = out.asMutSlice()
      entries[i].value = entries[i].value + term.value
      return
    }
    i = i + 1
  }
  run out.append(move term)
}

effect fn product(a: &Term, b: &Term) -> Term
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut powers = List<Power>.make()
  let mut i: usize = 0
  while i < a.powers.length() {
    let left = a.powers.asSlice()[i]
    let mut exponent = left.exponent
    let mut j: usize = 0
    while j < b.powers.length() {
      if equal(left.unit, b.powers.asSlice()[j].unit) {
        exponent = exponent + b.powers.asSlice()[j].exponent
      }
      j = j + 1
    }
    if exponent != 0 {
      run powers.append(Power { unit: left.unit, exponent: exponent })
    }
    i = i + 1
  }
  i = 0
  while i < b.powers.length() {
    let right = b.powers.asSlice()[i]
    let mut found = false
    let mut j: usize = 0
    while j < a.powers.length() {
      if equal(right.unit, a.powers.asSlice()[j].unit) {
        found = true
      }
      j = j + 1
    }
    if !found {
      run powers.append(right)
    }
    i = i + 1
  }
  return Term { value: a.value * b.value, powers: move powers }
}

effect fn create(store: &NumericStore, id: NumericId) -> List<Term>
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<Term>.make()
  match &store.unitValue(id) {
    Option<UnitValue>.Some { value } => {
      let info = match &lookup(value.unit) {
        Option<UnitInfo>.Some { value: found } => found
        _ => {
          fail CssomError.TypeError
        }
      }
      let mut powers = List<Power>.make()
      if !equal(info.canonical, b"number") {
        run powers.append(Power { unit: info.canonical, exponent: 1 })
      }
      run result.append(Term { value: value.value * info.factor, powers: move powers })
      return move result
    }
    _ => {}
  }
  let operation = store.operator(id)
  let children = store.children(id)
  if operation == NumericOperator.Negate || operation == NumericOperator.Invert {
    let mut values = run create(store, children[0])
    if operation == NumericOperator.Invert && values.length() != 1 {
      fail CssomError.TypeError
    }
    let mut i: usize = 0
    while i < values.length() {
      let mut term = &mut values.asMutSlice()[i]
      if operation == NumericOperator.Negate {
        term.value = -term.value
      } else {
        term.value = 1.0 / term.value
        let mut j: usize = 0
        while j < term.powers.length() {
          let powers = term.powers.asMutSlice()
          powers[j].exponent = -powers[j].exponent
          j = j + 1
        }
      }
      i = i + 1
    }
    return move values
  }
  if operation == NumericOperator.Product {
    run result.append(Term { value: 1.0, powers: List<Power>.make() })
    let mut i: usize = 0
    while i < children.length {
      let values = run create(store, children[i])
      let mut next = List<Term>.make()
      let mut a: usize = 0
      while a < result.length() {
        let mut b: usize = 0
        while b < values.length() {
          let term = run product(&result.asSlice()[a], &values.asSlice()[b])
          run next.append(move term)
          b = b + 1
        }
        a = a + 1
      }
      result = move next
      i = i + 1
    }
    return move result
  }
  if operation == NumericOperator.Sum {
    let mut i: usize = 0
    while i < children.length {
      let mut values = run create(store, children[i])

      // Moving out in reverse avoids copying owned unit maps; reverse again preserves summation order.
      let mut reversed = List<Term>.make()
      while values.length() > 0 {
        let last = values.length() - 1
        run reversed.append(values.remove(last))
      }
      while reversed.length() > 0 {
        let last = reversed.length() - 1
        run merge(&mut result, reversed.remove(last))
      }
      i = i + 1
    }
    return move result
  }
  let mut first = run create(store, children[0])
  if first.length() != 1 {
    fail CssomError.TypeError
  }
  let mut selected = first.asSlice()[0].value
  let mut lower: f64 = 0.0
  if operation == NumericOperator.Clamp {
    lower = selected
  }
  let mut i: usize = 1
  while i < children.length {
    let next = run create(store, children[i])
    if next.length() != 1 || !same(&first.asSlice()[0], &next.asSlice()[0]) {
      fail CssomError.TypeError
    }
    let value = next.asSlice()[0].value
    if operation == NumericOperator.Min {
      selected = minimum(selected, value)
    } else if operation == NumericOperator.Max {
      selected = maximum(selected, value)
    } else if i == 1 {
      selected = value
    } else {
      selected = maximum(lower, minimum(selected, value))
    }
    i = i + 1
  }
  let selectedTerms = first.asMutSlice()
  selectedTerms[0].value = selected
  return move first
}

effect fn unitValue(term: &Term) -> UnitValue
  ! CssomError {
  if term.powers.length() == 0 {
    return UnitValue { value: term.value, unit: b"number" }
  }
  if term.powers.length() != 1 || term.powers.asSlice()[0].exponent != 1 {
    fail CssomError.TypeError
  }
  return UnitValue { value: term.value, unit: term.powers.asSlice()[0].unit }
}

pub effect fn to(store: &NumericStore, id: NumericId, unit: &[u8]) -> UnitValue
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let target = match &lookup(unit) {
    Option<UnitInfo>.Some { value } => value
    _ => {
      fail CssomError.SyntaxError
    }
  }
  let terms = run create(store, id)
  if terms.length() != 1 {
    fail CssomError.TypeError
  }
  let value = run unitValue(&terms.asSlice()[0])
  if !equal(value.unit, target.canonical) {
    fail CssomError.TypeError
  }
  return UnitValue { value: value.value / target.factor, unit: target.name }
}

fn before(a: &[u8], b: &[u8]) -> bool {
  let mut i: usize = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] {
      return a[i] < b[i]
    }
    i = i + 1
  }
  return a.length < b.length
}

pub effect fn toSum(store: &mut NumericStore, id: NumericId, units: &[&[u8]]) -> NumericId
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let mut requested = List<UnitInfo>.make()
  let mut i: usize = 0
  while i < units.length {
    let info = match &lookup(units[i]) {
      Option<UnitInfo>.Some { value } => value
      _ => {
        fail CssomError.SyntaxError
      }
    }
    run requested.append(info)
    i = i + 1
  }
  let terms = run create(&store.*, id)
  let mut values = List<UnitValue>.make()
  i = 0
  while i < terms.length() {
    run values.append(run unitValue(&terms.asSlice()[i]))
    i = i + 1
  }
  let mut args = List<NumericId>.make()
  if units.length == 0 {
    i = 1
    while i < values.length() {
      let mut j = i
      while j > 0 && before(values.asSlice()[j].unit, values.asSlice()[j - 1].unit) {
        let saved = values.asSlice()[j]
        let items = values.asMutSlice()
        items[j] = items[j - 1]
        items[j - 1] = saved
        j = j - 1
      }
      i = i + 1
    }
    i = 0
    while i < values.length() {
      let value = values.asSlice()[i]
      let info = match &lookup(value.unit) {
        Option<UnitInfo>.Some { value: found } => found
        _ => {
          fail CssomError.TypeError
        }
      }
      run args.append(run store.literal(value.value, info))
      i = i + 1
    }
  } else {
    let mut consumed = List<bool>.make()
    i = 0
    while i < values.length() {
      run consumed.append(false)
      i = i + 1
    }
    i = 0
    while i < requested.length() {
      let target = requested.asSlice()[i]
      let mut amount = 0.0
      let mut j: usize = 0
      while j < values.length() {
        if !consumed.asSlice()[j] && equal(values.asSlice()[j].unit, target.canonical) {
          amount = amount + values.asSlice()[j].value / target.factor
          let marks = consumed.asMutSlice()
          marks[j] = true
        }
        j = j + 1
      }
      run args.append(run store.literal(amount, target))
      i = i + 1
    }
    i = 0
    while i < consumed.length() {
      if !consumed.asSlice()[i] {
        fail CssomError.TypeError
      }
      i = i + 1
    }
  }
  return run store.mathSum(args.asSlice())
}
