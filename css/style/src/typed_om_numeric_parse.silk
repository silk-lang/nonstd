//! Typed OM reification over the shared CSS Syntax tokenizer and input cursor.
import typed_om_numeric { NumericStore, NumericId, NumericOperator }
import typed_om_numeric_units { lookup, UnitInfo }
import cssom_error { CssomError }
import input { Input, TokenView }
import value_cursor { Cursor }
import lexer
import tokens { Kind, Limits, CssError, insensitive }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

pub effect fn parse(store: &mut NumericStore, text: &[u8], limits: &Limits) -> NumericId
  ! CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(text, limits)
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let parsed = run Effect.result(primary(&mut store.*, &input, &mut cursor, false))
  let result = match move parsed {
    Result<NumericId, CssomError | OutOfMemoryError>.Success { value } => value
    Result<NumericId, CssomError | OutOfMemoryError>.Failure { error } => match move error {
      CssomError failure => {
        fail CssomError.SyntaxError
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  if !cursor.done(&input) {
    fail CssomError.SyntaxError
  }
  return result
}

fn delimiter(input: &Input<'_>, index: usize) -> u32 {
  return match &input.at(index) {
    Option<TokenView>.Some { value } => match &value.token.kind {
      Kind.Delim { scalar } => scalar
      _ => 0
    }
    _ => 0
  }
}

fn whitespace(input: &Input<'_>, index: usize) -> bool {
  return match &input.at(index) {
    Option<TokenView>.Some { value } => match &value.token.kind {
      Kind.Whitespace => true
      _ => false
    }
    _ => false
  }
}

effect fn literal(store: &mut NumericStore, value: f64, unit: &[u8]) -> NumericId
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let info = match &lookup(unit) {
    Option<UnitInfo>.Some { value: found } => found
    _ => {
      fail CssomError.SyntaxError
    }
  }
  return run store.literal(value, info)
}

effect fn primary(
  store: &mut NumericStore,
  input: &Input<'_>,
  cursor: &mut Cursor,
  math: bool,
) -> NumericId
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  cursor.skip(input)
  if cursor.position >= cursor.end {
    fail CssomError.SyntaxError
  }
  let view = match &input.at(cursor.position) {
    Option<TokenView>.Some { value } => value
    _ => {
      fail CssomError.SyntaxError
    }
  }
  cursor.position = cursor.position + 1
  match &view.token.kind {
    Kind.Number { value, integer } => {
      return run literal(&mut store.*, value, b"number")
    }
    Kind.Percentage { value, integer } => {
      return run literal(&mut store.*, value, b"percent")
    }
    Kind.Dimension { value, integer, unit } => {
      let text = view.text(unit)
      match &lookup(text) {
        Option<UnitInfo>.Some { value: info } => {
          return run store.literal(value, info)
        }
        _ => {}
      }
      let mut lowercase = Bytes.make()
      let mut i: usize = 0
      while i < text.length {
        let byte = text[i]
        run lowercase.append(
          &[
            if byte >= 65 && byte <= 90 {
              byte + 32
            } else {
              byte
            },
          ],
        )
        i = i + 1
      }
      return run literal(&mut store.*, value, lowercase.asSlice())
    }
    Kind.Ident { text } => {
      if !math {
        fail CssomError.SyntaxError
      }
      let name = view.text(text)
      let value = if insensitive(name, b"pi") {
        3.141592653589793
      } else if insensitive(name, b"e") {
        2.718281828459045
      } else if insensitive(name, b"infinity") {
        f64.INFINITY
      } else if insensitive(name, b"-infinity") {
        -f64.INFINITY
      } else if insensitive(name, b"nan") {
        f64.fromBits(9221120237041090560)
      } else {
        fail CssomError.SyntaxError
      }
      return run literal(&mut store.*, value, b"number")
    }
    Kind.OpenParen => {
      if !math {
        fail CssomError.SyntaxError
      }
      let result = run sum(&mut store.*, input, &mut cursor.*, false)
      if !cursor.close(input) {
        fail CssomError.SyntaxError
      }
      return result
    }
    Kind.Function { name } => {
      let text = view.text(name)
      if insensitive(text, b"calc") {
        let result = run sum(&mut store.*, input, &mut cursor.*, true)
        if !cursor.close(input) {
          fail CssomError.SyntaxError
        }
        return result
      }
      let operation = if insensitive(text, b"min") {
        NumericOperator.Min
      } else if insensitive(text, b"max") {
        NumericOperator.Max
      } else if insensitive(text, b"clamp") {
        NumericOperator.Clamp
      } else {
        fail CssomError.SyntaxError
      }
      let mut args = List<NumericId>.make()
      run args.append(run sum(&mut store.*, input, &mut cursor.*, true))
      while cursor.comma(input) {
        run args.append(run sum(&mut store.*, input, &mut cursor.*, true))
      }
      if !cursor.close(input) {
        fail CssomError.SyntaxError
      }
      return run store.construct(operation, args.asSlice())
    }
    _ => {
      fail CssomError.SyntaxError
    }
  }
}

effect fn product(store: &mut NumericStore, input: &Input<'_>, cursor: &mut Cursor) -> NumericId
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let first = run primary(&mut store.*, input, &mut cursor.*, true)
  let mut args = List<NumericId>.make()
  run args.append(first)
  while true {
    let previous = cursor.position
    cursor.skip(input)
    let scalar = if cursor.position < cursor.end {
      delimiter(input, cursor.position)
    } else {
      0
    }
    if scalar != 42 && scalar != 47 {
      cursor.position = previous
      break
    }
    cursor.position = cursor.position + 1
    let value = run primary(&mut store.*, input, &mut cursor.*, true)
    let next = if scalar == 47 {
      run store.mathInvert(value)
    } else {
      value
    }
    run args.append(next)
  }
  if args.length() == 1 {
    return first
  }
  return run store.mathProduct(args.asSlice())
}

effect fn sum(
  store: &mut NumericStore,
  input: &Input<'_>,
  cursor: &mut Cursor,
  wrap: bool,
) -> NumericId
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let first = run product(&mut store.*, input, &mut cursor.*)
  let mut args = List<NumericId>.make()
  run args.append(first)
  while true {
    let previous = cursor.position
    cursor.skip(input)
    let scalar = if cursor.position < cursor.end {
      delimiter(input, cursor.position)
    } else {
      0
    }
    if scalar != 43 && scalar != 45 {
      cursor.position = previous
      break
    }
    if cursor.position == previous || !whitespace(input, cursor.position + 1) {
      fail CssomError.SyntaxError
    }
    cursor.position = cursor.position + 1
    let value = run product(&mut store.*, input, &mut cursor.*)
    let next = if scalar == 45 {
      run store.mathNegate(value)
    } else {
      value
    }
    run args.append(next)
  }
  if args.length() == 1 {
    if !wrap || store.operator(first) == NumericOperator.Product {
      return first
    }
  }
  return run store.mathSum(args.asSlice())
}
