//! CSS Values 4 calculation normalization and CSS Color 4 serialization.
import dimensions { Store, Expr, ExprId, Unit, Operation }
import colors { Color, Identity, Space, SystemColor }
import colors
import cssom_serialization as serialization
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

pub fn unitName(unit: Unit) -> &'static [u8] {
  return match unit {
    Unit.Number => b""
    Unit.Percent => b"%"
    Unit.Px => b"px"
    Unit.Cm => b"cm"
    Unit.Mm => b"mm"
    Unit.Q => b"q"
    Unit.In => b"in"
    Unit.Pt => b"pt"
    Unit.Pc => b"pc"
    Unit.Em => b"em"
    Unit.Rem => b"rem"
    Unit.Ex => b"ex"
    Unit.Rex => b"rex"
    Unit.Cap => b"cap"
    Unit.Rcap => b"rcap"
    Unit.Ch => b"ch"
    Unit.Rch => b"rch"
    Unit.Ic => b"ic"
    Unit.Ric => b"ric"
    Unit.Lh => b"lh"
    Unit.Rlh => b"rlh"
    Unit.Vw => b"vw"
    Unit.Vh => b"vh"
    Unit.Vi => b"vi"
    Unit.Vb => b"vb"
    Unit.Vmin => b"vmin"
    Unit.Vmax => b"vmax"
    Unit.Svw => b"svw"
    Unit.Svh => b"svh"
    Unit.Svi => b"svi"
    Unit.Svb => b"svb"
    Unit.Svmin => b"svmin"
    Unit.Svmax => b"svmax"
    Unit.Lvw => b"lvw"
    Unit.Lvh => b"lvh"
    Unit.Lvi => b"lvi"
    Unit.Lvb => b"lvb"
    Unit.Lvmin => b"lvmin"
    Unit.Lvmax => b"lvmax"
    Unit.Dvw => b"dvw"
    Unit.Dvh => b"dvh"
    Unit.Dvi => b"dvi"
    Unit.Dvb => b"dvb"
    Unit.Dvmin => b"dvmin"
    Unit.Dvmax => b"dvmax"
    Unit.Deg => b"deg"
    Unit.Grad => b"grad"
    Unit.Rad => b"rad"
    Unit.Turn => b"turn"
    Unit.S => b"s"
    Unit.Ms => b"ms"
    Unit.Hz => b"hz"
    Unit.Khz => b"khz"
    Unit.Dpi => b"dpi"
    Unit.Dpcm => b"dpcm"
    Unit.Dppx => b"dppx"
    Unit.X => b"x"
  }
}

enum Kind {
  Literal,
  Sum,
  Product,
  Invert,
  Min,
  Max
}

struct Node {
  kind: Kind,
  amount: f64,
  unit: Unit,
  left: usize,
  right: usize,
}

impl Copy for Node {}

fn literal(amount: f64, unit: Unit) -> Node {
  return Node { kind: Kind.Literal, amount: amount, unit: unit, left: 0, right: 0 }
}

fn operator(kind: Kind, left: usize, right: usize) -> Node {
  return Node { kind: kind, amount: 0.0, unit: Unit.Number, left: left, right: right }
}

effect fn push(nodes: &mut List<Node>, node: Node) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let index = nodes.length()
  run nodes.append(node)
  return index
}

fn canonical(amount: f64, unit: Unit) -> Node {
  let mut result = match unit {
    Unit.Cm => literal(amount * (96.0 / 2.54), Unit.Px)
    Unit.Mm => literal(amount * (96.0 / 25.4), Unit.Px)
    Unit.Q => literal(amount * (96.0 / 101.6), Unit.Px)
    Unit.In => literal(amount * 96.0, Unit.Px)
    Unit.Pt => literal(amount * (96.0 / 72.0), Unit.Px)
    Unit.Pc => literal(amount * 16.0, Unit.Px)
    Unit.Grad => literal(amount * 0.9, Unit.Deg)
    Unit.Rad => literal(amount * (180.0 / 3.141592653589793), Unit.Deg)
    Unit.Turn => literal(amount * 360.0, Unit.Deg)
    Unit.Ms => literal(amount * 0.001, Unit.S)
    Unit.Khz => literal(amount * 1000.0, Unit.Hz)
    Unit.Dpi => literal(amount / 96.0, Unit.Dppx)
    Unit.Dpcm => literal(amount * (2.54 / 96.0), Unit.Dppx)
    Unit.X => literal(amount, Unit.Dppx)
    _ => literal(amount, unit)
  }

  // A finite authored dimension overflowing during unit conversion is clamped,
  // not promoted to the distinct calc(infinity) keyword value.
  if f64.isFinite(amount) && !f64.isFinite(result.amount) {
    let limit = f64.fromBits(9218868437227405311)
    result.amount = if amount < 0.0 {
      -limit
    } else {
      limit
    }
  }
  return result
}

effect fn flatten(nodes: &List<Node>, id: usize, kind: Kind, out: &mut List<usize>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = nodes.asSlice()[id]
  if node.kind == kind {
    run flatten(nodes, node.left, kind, &mut out.*)
    run flatten(nodes, node.right, kind, &mut out.*)
  } else {
    run out.append(id)
  }
}

fn before(a: Node, b: Node) -> bool {
  if a.kind != Kind.Literal {
    return false
  }
  if b.kind != Kind.Literal {
    return true
  }
  if a.unit == b.unit {
    return false
  }
  if a.unit == Unit.Number {
    return true
  }
  if b.unit == Unit.Number {
    return false
  }
  if a.unit == Unit.Percent {
    return true
  }
  if b.unit == Unit.Percent {
    return false
  }
  let x = unitName(a.unit)
  let y = unitName(b.unit)
  let mut i: usize = 0
  while i < x.length && i < y.length {
    if x[i] != y[i] {
      return x[i] < y[i]
    }
    i = i + 1
  }
  return x.length < y.length
}

fn sort(nodes: &List<Node>, terms: &mut List<usize>) -> () {
  let mut i: usize = 1
  while i < terms.length() {
    let item = terms.asSlice()[i]
    let mut at = i
    while at > 0 && before(nodes.asSlice()[item], nodes.asSlice()[terms.asSlice()[at - 1]]) {
      let previous = terms.asSlice()[at - 1]
      let mut slice = terms.asMutSlice()
      slice[at] = previous
      at = at - 1
    }
    let mut slice = terms.asMutSlice()
    slice[at] = item
    i = i + 1
  }
}

effect fn join(nodes: &mut List<Node>, terms: &List<usize>, kind: Kind) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = terms.asSlice()[0]
  let mut i: usize = 1
  while i < terms.length() {
    result = run push(&mut nodes.*, operator(kind, result, terms.asSlice()[i]))
    i = i + 1
  }
  return result
}

// Keep zero coefficients: their units participate in percentage hints and type checking.
effect fn sum(nodes: &mut List<Node>, left: usize, right: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let a = nodes.asSlice()[left]
  let b = nodes.asSlice()[right]
  if a.kind == Kind.Literal && b.kind == Kind.Literal && a.unit == b.unit {
    return run push(&mut nodes.*, literal(a.amount + b.amount, a.unit))
  }
  if a.kind != Kind.Sum && b.kind != Kind.Sum {
    return run push(
      &mut nodes.*,
      if before(b, a) {
        operator(Kind.Sum, right, left)
      } else {
        operator(Kind.Sum, left, right)
      },
    )
  }
  let mut terms = List<usize>.make()
  run flatten(&nodes.*, left, Kind.Sum, &mut terms)
  run flatten(&nodes.*, right, Kind.Sum, &mut terms)
  sort(&nodes.*, &mut terms)
  let mut merged = List<usize>.make()
  let mut i: usize = 0
  while i < terms.length() {
    let mut node = nodes.asSlice()[terms.asSlice()[i]]
    let mut id = terms.asSlice()[i]
    i = i + 1
    if node.kind == Kind.Literal {
      let mut changed = false
      while i < terms.length() {
        let next = nodes.asSlice()[terms.asSlice()[i]]
        if next.kind != Kind.Literal || next.unit != node.unit {
          break
        }
        node.amount = node.amount + next.amount
        changed = true
        i = i + 1
      }
      if changed {
        id = run push(&mut nodes.*, node)
      }
    }
    run merged.append(id)
  }
  return run join(&mut nodes.*, &merged, Kind.Sum)
}

fn numericSum(nodes: &List<Node>, id: usize) -> bool {
  let node = nodes.asSlice()[id]
  if node.kind == Kind.Literal {
    return true
  }
  return node.kind == Kind.Sum && numericSum(nodes, node.left) && numericSum(nodes, node.right)
}

effect fn scale(nodes: &mut List<Node>, id: usize, amount: f64) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = nodes.asSlice()[id]
  if node.kind == Kind.Literal {
    return run push(&mut nodes.*, literal(node.amount * amount, node.unit))
  }
  if node.kind == Kind.Sum && (amount == -1.0 || numericSum(&nodes.*, id)) {
    let left = run scale(&mut nodes.*, node.left, amount)
    let right = run scale(&mut nodes.*, node.right, amount)
    return run sum(&mut nodes.*, left, right)
  }
  let factor = run push(&mut nodes.*, literal(amount, Unit.Number))
  if node.kind == Kind.Product {
    return run product(&mut nodes.*, factor, id)
  }
  return run push(&mut nodes.*, operator(Kind.Product, factor, id))
}

effect fn product(nodes: &mut List<Node>, left: usize, right: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let a = nodes.asSlice()[left]
  let b = nodes.asSlice()[right]
  if a.kind == Kind.Literal && a.unit == Unit.Number && b.kind != Kind.Product {
    return run scale(&mut nodes.*, right, a.amount)
  }
  if b.kind == Kind.Literal && b.unit == Unit.Number && a.kind != Kind.Product {
    return run scale(&mut nodes.*, left, b.amount)
  }
  let mut terms = List<usize>.make()
  run flatten(&nodes.*, left, Kind.Product, &mut terms)
  run flatten(&nodes.*, right, Kind.Product, &mut terms)
  let mut kept = List<usize>.make()
  let mut coefficient = 1.0
  let mut hasNumber = false
  let mut i: usize = 0
  while i < terms.length() {
    let id = terms.asSlice()[i]
    let node = nodes.asSlice()[id]
    if node.kind == Kind.Literal && node.unit == Unit.Number {
      coefficient = coefficient * node.amount
      hasNumber = true
    } else {
      run kept.append(id)
    }
    i = i + 1
  }

  // Cancel matching numeric units in products with inverses, without resolving relative units.
  let mut removed = List<usize>.make()
  i = 0
  while i < kept.length() {
    let inverse = nodes.asSlice()[kept.asSlice()[i]]
    if inverse.kind == Kind.Invert {
      let denominator = nodes.asSlice()[inverse.left]
      if denominator.kind == Kind.Literal {
        let mut j: usize = 0
        while j < kept.length() {
          let numerator = nodes.asSlice()[kept.asSlice()[j]]
          let mut used = false
          let mut k: usize = 0
          while k < removed.length() {
            if removed.asSlice()[k] == j {
              used = true
            }
            k = k + 1
          }
          if !used && numerator.kind == Kind.Literal && numerator.unit == denominator.unit {
            coefficient = coefficient * (numerator.amount / denominator.amount)
            hasNumber = true
            run removed.append(i)
            run removed.append(j)
            break
          }
          j = j + 1
        }
      }
    }
    i = i + 1
  }
  let mut result = List<usize>.make()
  i = 0
  while i < kept.length() {
    let mut used = false
    let mut j: usize = 0
    while j < removed.length() {
      if removed.asSlice()[j] == i {
        used = true
      }
      j = j + 1
    }
    if !used {
      run result.append(kept.asSlice()[i])
    }
    i = i + 1
  }
  if result.length() == 0 {
    return run push(&mut nodes.*, literal(coefficient, Unit.Number))
  }
  if result.length() == 1 && hasNumber {
    return run scale(&mut nodes.*, result.asSlice()[0], coefficient)
  }
  if hasNumber {
    let factor = run push(&mut nodes.*, literal(coefficient, Unit.Number))
    run result.append(factor)
  }
  sort(&nodes.*, &mut result)
  return run join(&mut nodes.*, &result, Kind.Product)
}

fn extremum(a: f64, b: f64, minimum: bool) -> f64 {
  if a != a {
    return a
  }
  if b != b {
    return b
  }
  if a == 0.0 && b == 0.0 {
    if minimum {
      return if 1.0 / a < 0.0 {
        a
      } else {
        b
      }
    }
    return if 1.0 / a > 0.0 {
      a
    } else {
      b
    }
  }
  return if (minimum && a < b) || (!minimum && a > b) {
    a
  } else {
    b
  }
}

effect fn comparison(
  nodes: &mut List<Node>,
  left: usize,
  right: usize,
  kind: Kind,
  percentage: bool,
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let a = nodes.asSlice()[left]
  let b = nodes.asSlice()[right]
  if a.kind == Kind.Literal && b.kind == Kind.Literal && a.unit == b.unit
    && (a.unit != Unit.Percent || !percentage) {
    return run push(&mut nodes.*, literal(extremum(a.amount, b.amount, kind == Kind.Min), a.unit))
  }
  if a.kind != kind && b.kind != kind {
    return run push(&mut nodes.*, operator(kind, left, right))
  }
  let mut terms = List<usize>.make()
  run flatten(&nodes.*, left, kind, &mut terms)
  run flatten(&nodes.*, right, kind, &mut terms)
  let mut merged = List<usize>.make()
  let mut i: usize = 0
  while i < terms.length() {
    let id = terms.asSlice()[i]
    let node = nodes.asSlice()[id]
    let mut found = false
    if node.kind == Kind.Literal && (node.unit != Unit.Percent || !percentage) {
      let mut j: usize = 0
      while j < merged.length() {
        let other = nodes.asSlice()[merged.asSlice()[j]]
        if other.kind == Kind.Literal && node.unit == other.unit {
          let value = extremum(other.amount, node.amount, kind == Kind.Min)
          let replacement = run push(&mut nodes.*, literal(value, node.unit))
          let mut slice = merged.asMutSlice()
          slice[j] = replacement
          found = true
          break
        }
        j = j + 1
      }
    }
    if !found {
      run merged.append(id)
    }
    i = i + 1
  }
  return run join(&mut nodes.*, &merged, kind)
}

effect fn normalize(nodes: &mut List<Node>, store: &Store, id: ExprId, percentage: bool) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &store.get(id).* {
    Expr.Literal { value, unit } => run push(&mut nodes.*, canonical(value, unit))
    Expr.Calc { value } => run normalize(&mut nodes.*, store, value, percentage)
    Expr.PercentContext { value, percentage: contextual } => run normalize(
      &mut nodes.*,
      store,
      value,
      false,
    )
    Expr.Binary { operation, left, right } => {
      let a = run normalize(&mut nodes.*, store, left, percentage)
      let b = run normalize(&mut nodes.*, store, right, percentage)
      match operation {
        Operation.Add => run sum(&mut nodes.*, a, b)
        Operation.Subtract => {
          let negative = run scale(&mut nodes.*, b, -1.0)
          run sum(&mut nodes.*, a, negative)
        }
        Operation.Multiply => run product(&mut nodes.*, a, b)
        Operation.Divide => {
          let denominator = nodes.asSlice()[b]
          let inverse = if denominator.kind == Kind.Literal && denominator.unit == Unit.Number {
            run push(&mut nodes.*, literal(1.0 / denominator.amount, Unit.Number))
          } else if denominator.kind == Kind.Invert {
            denominator.left
          } else {
            run push(&mut nodes.*, operator(Kind.Invert, b, 0))
          }
          run product(&mut nodes.*, a, inverse)
        }
        Operation.Min => run comparison(&mut nodes.*, a, b, Kind.Min, percentage)
        Operation.Max => run comparison(&mut nodes.*, a, b, Kind.Max, percentage)
      }
    }
  }
}

effect fn appendLiteral(out: &mut Bytes, amount: f64, unit: Unit) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !f64.isFinite(amount) {
    run Bytes.append(
      &mut out.*,
      if amount != amount {
        b"NaN"
      } else if amount < 0.0 {
        b"-infinity"
      } else {
        b"infinity"
      },
    )
    if unit != Unit.Number {
      run Bytes.append(&mut out.*, b" * 1")
      run Bytes.append(&mut out.*, unitName(unit))
    }
    return
  }
  run serialization.appendNumber(&mut out.*, amount)
  run Bytes.append(&mut out.*, unitName(unit))
}

effect fn appendTree(out: &mut Bytes, nodes: &List<Node>, id: usize, nested: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = nodes.asSlice()[id]
  if node.kind == Kind.Literal {
    if nested && !f64.isFinite(node.amount) && node.unit != Unit.Number {
      run Bytes.append(&mut out.*, b"(")
    }
    run appendLiteral(&mut out.*, node.amount, node.unit)
    if nested && !f64.isFinite(node.amount) && node.unit != Unit.Number {
      run Bytes.append(&mut out.*, b")")
    }
    return
  }
  if node.kind == Kind.Invert {
    run Bytes.append(&mut out.*, b"(1 / ")
    run appendTree(&mut out.*, nodes, node.left, true)
    run Bytes.append(&mut out.*, b")")
    return
  }
  let comparison = node.kind == Kind.Min || node.kind == Kind.Max
  if comparison {
    run Bytes.append(
      &mut out.*,
      if node.kind == Kind.Min {
        b"min("
      } else {
        b"max("
      },
    )
  } else if nested {
    run Bytes.append(&mut out.*, b"(")
  }
  let mut first = true
  run appendSequence(&mut out.*, nodes, id, node.kind, &mut first)
  if comparison || nested {
    run Bytes.append(&mut out.*, b")")
  }
}

effect fn appendSequence(
  out: &mut Bytes,
  nodes: &List<Node>,
  id: usize,
  kind: Kind,
  first: &mut bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let child = nodes.asSlice()[id]
  if child.kind == kind {
    run appendSequence(&mut out.*, nodes, child.left, kind, &mut first.*)
    run appendSequence(&mut out.*, nodes, child.right, kind, &mut first.*)
    return
  }
  let comparison = kind == Kind.Min || kind == Kind.Max
  if !first.* {
    if comparison {
      run Bytes.append(&mut out.*, b", ")
    } else if kind == Kind.Sum {
      if child.kind == Kind.Literal && child.amount < 0.0 {
        run Bytes.append(&mut out.*, b" - ")
        run appendLiteral(&mut out.*, -child.amount, child.unit)
        return
      }
      if child.kind == Kind.Product {
        let factor = nodes.asSlice()[child.left]
        if factor.kind == Kind.Literal && factor.unit == Unit.Number && factor.amount == -1.0 {
          run Bytes.append(&mut out.*, b" - ")
          run appendTree(&mut out.*, nodes, child.right, true)
          return
        }
      }
      run Bytes.append(&mut out.*, b" + ")
    } else if child.kind == Kind.Invert {
      run Bytes.append(&mut out.*, b" / ")
      run appendTree(&mut out.*, nodes, child.left, true)
      return
    } else {
      run Bytes.append(&mut out.*, b" * ")
    }
  }
  first.* = false
  run appendTree(&mut out.*, nodes, id, !comparison)
}

pub effect fn appendExpression(out: &mut Bytes, store: &Store, id: ExprId) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &store.get(id).* {
    Expr.Literal { value, unit } => {
      let node = if unit == Unit.Ms || unit == Unit.Dpi || unit == Unit.Dpcm || unit == Unit.X {
        canonical(value, unit)
      } else {
        literal(value, unit)
      }
      if !f64.isFinite(node.amount) {
        run Bytes.append(&mut out.*, b"calc(")
      }
      run appendLiteral(&mut out.*, node.amount, node.unit)
      if !f64.isFinite(node.amount) {
        run Bytes.append(&mut out.*, b")")
      }
      return
    }
    Expr.PercentContext { value, percentage } => {
      // A contextual wrapper alone does not turn a literal into a math function.
      match &store.get(value).* {
        Expr.Literal { value: amount, unit } => {
          run appendExpression(&mut out.*, store, value)
          return
        }
        _ => {}
      }
    }
    _ => {}
  }
  let mut nodes = List<Node>.make()
  let root = run normalize(&mut nodes, store, id, true)
  let kind = nodes.asSlice()[root].kind
  let wrapper = kind != Kind.Min && kind != Kind.Max
  if wrapper {
    run Bytes.append(&mut out.*, b"calc(")
  }
  run appendTree(&mut out.*, &nodes, root, false)
  if wrapper {
    run Bytes.append(&mut out.*, b")")
  }
}

pub effect fn expression(store: &Store, id: ExprId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run appendExpression(&mut out, store, id)
  return move out
}

effect fn appendComputedLiteral(out: &mut Bytes, node: Node, minimum: f64, maximum: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let factor = if node.unit == Unit.Percent {
    100.0
  } else {
    1.0
  }
  let limit = f64.fromBits(9218868437227405311)
  let amount = if node.amount != node.amount {
    0.0
  } else {
    node.amount
  }
  let bounded = f64.max(minimum * factor, f64.min(maximum * factor, amount))
  run appendLiteral(&mut out.*, f64.max(-limit, f64.min(limit, bounded)), node.unit)
}

// The caller supplies computed arena nodes; no font/viewport/percentage basis is
// invented here. A remaining mixed-unit tree is still serialized as a calculation.
pub effect fn appendComputedExpressionInRange(
  out: &mut Bytes,
  store: &Store,
  id: ExprId,
  minimum: f64,
  maximum: f64,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &store.get(id).* {
    Expr.Literal { value, unit } => {
      run appendComputedLiteral(&mut out.*, canonical(value, unit), minimum, maximum)
      return
    }
    _ => {}
  }
  let mut nodes = List<Node>.make()
  let root = run normalize(&mut nodes, store, id, true)
  let node = nodes.asSlice()[root]
  if node.kind == Kind.Literal {
    run appendComputedLiteral(&mut out.*, node, minimum, maximum)
    return
  }
  let wrapper = node.kind != Kind.Min && node.kind != Kind.Max
  if wrapper {
    run Bytes.append(&mut out.*, b"calc(")
  }
  run appendTree(&mut out.*, &nodes, root, false)
  if wrapper {
    run Bytes.append(&mut out.*, b")")
  }
}

pub effect fn appendComputedExpression(out: &mut Bytes, store: &Store, id: ExprId) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let infinity = f64.fromBits(9218868437227405312)
  run appendComputedExpressionInRange(&mut out.*, store, id, -infinity, infinity)
}

pub effect fn computedExpression(store: &Store, id: ExprId) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run appendComputedExpression(&mut out, store, id)
  return move out
}

fn systemName(color: SystemColor) -> &'static [u8] {
  return match color {
    SystemColor.AccentColor => b"accentcolor"
    SystemColor.AccentColorText => b"accentcolortext"
    SystemColor.ActiveText => b"activetext"
    SystemColor.ButtonBorder => b"buttonborder"
    SystemColor.ButtonFace => b"buttonface"
    SystemColor.ButtonText => b"buttontext"
    SystemColor.Canvas => b"canvas"
    SystemColor.CanvasText => b"canvastext"
    SystemColor.Field => b"field"
    SystemColor.FieldText => b"fieldtext"
    SystemColor.GrayText => b"graytext"
    SystemColor.Highlight => b"highlight"
    SystemColor.HighlightText => b"highlighttext"
    SystemColor.LinkText => b"linktext"
    SystemColor.Mark => b"mark"
    SystemColor.MarkText => b"marktext"
    SystemColor.SelectedItem => b"selecteditem"
    SystemColor.SelectedItemText => b"selecteditemtext"
    SystemColor.VisitedText => b"visitedtext"
  }
}

fn spaceName(space: Space) -> &'static [u8] {
  return match space {
    Space.Srgb => b"color(srgb "
    Space.SrgbLinear => b"color(srgb-linear "
    Space.DisplayP3 => b"color(display-p3 "
    Space.DisplayP3Linear => b"color(display-p3-linear "
    Space.A98Rgb => b"color(a98-rgb "
    Space.ProphotoRgb => b"color(prophoto-rgb "
    Space.Rec2020 => b"color(rec2020 "
    Space.XyzD50 => b"color(xyz-d50 "
    Space.XyzD65 => b"color(xyz-d65 "
    Space.Hsl => b"hsl("
    Space.Hwb => b"hwb("
    Space.Lab => b"lab("
    Space.Lch => b"lch("
    Space.Oklab => b"oklab("
    Space.Oklch => b"oklch("
  }
}

fn alpha(value: f64) -> f64 {
  if value != value || value < 0.0 {
    return 0.0
  }
  return if value > 1.0 {
    1.0
  } else {
    value
  }
}

pub effect fn appendColor(out: &mut Bytes, color: &Color) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &color.identity {
    Identity.CurrentColor => {
      run Bytes.append(&mut out.*, b"currentcolor")
      return
    }
    Identity.System { color: system } => {
      run Bytes.append(&mut out.*, systemName(system))
      return
    }
    Identity.Absolute => {}
  }
  let legacySpace = color.space == Space.Srgb || color.space == Space.Hsl
    || color.space == Space.Hwb

  // Out-of-gamut color(srgb) coordinates cannot be represented by legacy rgb().
  let inGamut = color.channels[0] >= 0.0 && color.channels[0] <= 1.0 && color.channels[1] >= 0.0
    && color.channels[1] <= 1.0
    && color.channels[2] >= 0.0
    && color.channels[2] <= 1.0
  if legacySpace && color.missing == 0 && (color.space != Space.Srgb || inGamut) {
    let rgb = colors.toSrgb(color.*)
    run Bytes.append(
      &mut out.*,
      if rgb.a == 1.0 {
        b"rgb("
      } else {
        b"rgba("
      },
    )
    run serialization.appendNumber(&mut out.*, rgb.r * 255.0)
    run Bytes.append(&mut out.*, b", ")
    run serialization.appendNumber(&mut out.*, rgb.g * 255.0)
    run Bytes.append(&mut out.*, b", ")
    run serialization.appendNumber(&mut out.*, rgb.b * 255.0)
    if rgb.a != 1.0 {
      run Bytes.append(&mut out.*, b", ")
      run serialization.appendNumber(&mut out.*, alpha(rgb.a))
    }
    run Bytes.append(&mut out.*, b")")
    return
  }
  run Bytes.append(&mut out.*, spaceName(color.space))
  let bits: [u8; 3] = [1, 2, 4]
  let mut i: usize = 0
  while i < 3 {
    if i > 0 {
      run Bytes.append(&mut out.*, b" ")
    }
    if (color.missing & bits[i]) != 0 {
      run Bytes.append(&mut out.*, b"none")
    } else {
      run serialization.appendNumber(&mut out.*, color.channels[i])
      if i > 0 && (color.space == Space.Hsl || color.space == Space.Hwb) {
        run Bytes.append(&mut out.*, b"%")
      }
    }
    i = i + 1
  }
  if (color.missing & 8) != 0 {
    run Bytes.append(&mut out.*, b" / none")
  } else if alpha(color.alpha) != 1.0 {
    run Bytes.append(&mut out.*, b" / ")
    run serialization.appendNumber(&mut out.*, alpha(color.alpha))
  }
  run Bytes.append(&mut out.*, b")")
}

pub effect fn color(color: &Color) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run appendColor(&mut out, color)
  return move out
}
