//! Encoding Standard snapshot e1421f1791b202717883c452a6267129ce5fb3ca13652e5022a2b6d2a11fc262,
//! pinned by images/svg/specs.lock.json. Expected bytes are UTF-8, before CSS preprocessing.
import encoding { decodeStylesheet }
import encoding_types { Encoding }
import tokens { CssError, equal }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }

effect fn decodes(data: &[u8], codec: Encoding, expected: &[u8]) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let decoded = run decodeStylesheet(
    data,
    Option<Encoding>.Some { value: codec },
    Option<Encoding>.None,
    expected.length,
  )
  run Testing.expect(
    decoded.encoding == codec && equal(decoded.bytes.asSlice(), expected),
    "normative decoding and exact output bound",
  )
}

// https://encoding.spec.whatwg.org/#gbk-decoder
// https://encoding.spec.whatwg.org/#gb18030-decoder
// https://encoding.spec.whatwg.org/#index-gb18030-ranges-code-point
effect fn gbCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(&[0x81, 0x40, 0x80], Encoding.Gbk, &[0xe4, 0xb8, 0x82, 0xe2, 0x82, 0xac])
  run decodes(&[0x81, 0x30, 0x81, 0x30], Encoding.Gbk, &[0xc2, 0x80])
  run decodes(&[0x90, 0x30, 0x81, 0x30], Encoding.Gb18030, &[0xf0, 0x90, 0x80, 0x80])
  run decodes(&[0xe3, 0x32, 0x9a, 0x35], Encoding.Gb18030, &[0xf4, 0x8f, 0xbf, 0xbf])
  run decodes(&[0xe3, 0x32, 0x9a, 0x36, 0x22], Encoding.Gb18030, &[0xef, 0xbf, 0xbd, 0x22])
  run decodes(&[0x81, 0x30, 0x22], Encoding.Gb18030, &[0xef, 0xbf, 0xbd, 0x30, 0x22])
  run decodes(
    &[0x81, 0x30, 0x81, 0x22],
    Encoding.Gb18030,
    &[0xef, 0xbf, 0xbd, 0x30, 0xef, 0xbf, 0xbd, 0x22],
  )
  run decodes(&[0x81, 0x22, 0xff], Encoding.Gb18030, &[0xef, 0xbf, 0xbd, 0x22, 0xef, 0xbf, 0xbd])
  run decodes(&[0x81], Encoding.Gb18030, &[0xef, 0xbf, 0xbd])
  run decodes(&[0x81, 0x30], Encoding.Gb18030, &[0xef, 0xbf, 0xbd])
  run decodes(&[0x81, 0x30, 0x81], Encoding.Gb18030, &[0xef, 0xbf, 0xbd])
}

// https://encoding.spec.whatwg.org/#big5-decoder
effect fn big5Case() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(&[0xa4, 0x40], Encoding.Big5, &[0xe4, 0xb8, 0x80])
  run decodes(
    &[0x88, 0x62, 0x88, 0x64, 0x88, 0xa3, 0x88, 0xa5],
    Encoding.Big5,
    &[
      0xc3,
      0x8a,
      0xcc,
      0x84,
      0xc3,
      0x8a,
      0xcc,
      0x8c,
      0xc3,
      0xaa,
      0xcc,
      0x84,
      0xc3,
      0xaa,
      0xcc,
      0x8c,
    ],
  )
  run decodes(
    &[0x81, 0x40, 0x81, 0x22, 0x80, 0xff, 0x81],
    Encoding.Big5,
    &[
      0xef,
      0xbf,
      0xbd,
      0x40,
      0xef,
      0xbf,
      0xbd,
      0x22,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
    ],
  )
  run decodes(&[0x81, 0x80, 0x22], Encoding.Big5, &[0xef, 0xbf, 0xbd, 0x22])
}

// https://encoding.spec.whatwg.org/#euc-jp-decoder
effect fn eucJpCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(
    &[0xa4, 0xa2, 0x8e, 0xa1, 0x8e, 0xdf, 0x8f, 0xa2, 0xaf],
    Encoding.EucJp,
    &[0xe3, 0x81, 0x82, 0xef, 0xbd, 0xa1, 0xef, 0xbe, 0x9f, 0xcb, 0x98],
  )
  run decodes(
    &[0x8f, 0xa2, 0x22, 0xa4, 0xa2],
    Encoding.EucJp,
    &[0xef, 0xbf, 0xbd, 0x22, 0xe3, 0x81, 0x82],
  )
  run decodes(
    &[0x8e, 0x22, 0x8f, 0x22, 0xa1, 0x22],
    Encoding.EucJp,
    &[0xef, 0xbf, 0xbd, 0x22, 0xef, 0xbf, 0xbd, 0x22, 0xef, 0xbf, 0xbd, 0x22],
  )
  run decodes(&[0x8e, 0xe0, 0x22], Encoding.EucJp, &[0xef, 0xbf, 0xbd, 0x22])
  run decodes(&[0x8f], Encoding.EucJp, &[0xef, 0xbf, 0xbd])
  run decodes(&[0x8f, 0xa2], Encoding.EucJp, &[0xef, 0xbf, 0xbd])
  run decodes(&[0xa4], Encoding.EucJp, &[0xef, 0xbf, 0xbd])
}

// https://encoding.spec.whatwg.org/#shift_jis-decoder
effect fn shiftJisCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(
    &[0x82, 0xa0, 0xa1, 0xdf, 0x80, 0x5c, 0x7e],
    Encoding.ShiftJis,
    &[0xe3, 0x81, 0x82, 0xef, 0xbd, 0xa1, 0xef, 0xbe, 0x9f, 0xc2, 0x80, 0x5c, 0x7e],
  )
  run decodes(&[0xf0, 0x40, 0xf9, 0xfc], Encoding.ShiftJis, &[0xee, 0x80, 0x80, 0xee, 0x9d, 0x97])
  run decodes(
    &[0x81, 0x22, 0x81, 0x7f, 0xa0, 0xfd, 0x81],
    Encoding.ShiftJis,
    &[
      0xef,
      0xbf,
      0xbd,
      0x22,
      0xef,
      0xbf,
      0xbd,
      0x7f,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
    ],
  )
  run decodes(&[0x81, 0xfd, 0x22], Encoding.ShiftJis, &[0xef, 0xbf, 0xbd, 0x22])
}

// https://encoding.spec.whatwg.org/#euc-kr-decoder
effect fn eucKrCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(&[0xb0, 0xa1], Encoding.EucKr, &[0xea, 0xb0, 0x80])
  run decodes(&[0x81, 0x41], Encoding.EucKr, &[0xea, 0xb0, 0x82])
  run decodes(
    &[0x81, 0x5b, 0x81, 0x22, 0x80, 0xff, 0x81],
    Encoding.EucKr,
    &[
      0xef,
      0xbf,
      0xbd,
      0x5b,
      0xef,
      0xbf,
      0xbd,
      0x22,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
      0xef,
      0xbf,
      0xbd,
    ],
  )
  run decodes(&[0x81, 0xff, 0x22], Encoding.EucKr, &[0xef, 0xbf, 0xbd, 0x22])
}

// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder
// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder-escape
effect fn iso2022Case() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(
    &[
      0x1b,
      0x28,
      0x4a,
      0x5c,
      0x7e,
      0x1b,
      0x28,
      0x49,
      0x21,
      0x5f,
      0x1b,
      0x24,
      0x42,
      0x24,
      0x22,
      0x1b,
      0x28,
      0x42,
      0x5c,
      0x7e,
    ],
    Encoding.Iso2022Jp,
    &[
      0xc2,
      0xa5,
      0xe2,
      0x80,
      0xbe,
      0xef,
      0xbd,
      0xa1,
      0xef,
      0xbe,
      0x9f,
      0xe3,
      0x81,
      0x82,
      0x5c,
      0x7e,
    ],
  )
  run decodes(&[0x1b, 0x24, 0x40, 0x24, 0x22], Encoding.Iso2022Jp, &[0xe3, 0x81, 0x82])
  run decodes(
    &[0x1b, 0x28, 0x42, 0x1b, 0x28, 0x4a, 0x1b, 0x28, 0x49, 0x21],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd, 0xef, 0xbd, 0xa1],
  )
  run decodes(
    &[0x1b, 0x28, 0x4a, 0x5c, 0x1b, 0x28, 0x42, 0x1b, 0x28, 0x4a, 0x5c, 0x1b, 0x28, 0x42],
    Encoding.Iso2022Jp,
    &[0xc2, 0xa5, 0xef, 0xbf, 0xbd, 0xc2, 0xa5],
  )
  run decodes(&[0x1b, 0x28, 0x42], Encoding.Iso2022Jp, b"")
}

// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder-escape-start
// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder-escape
// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder-trail-byte
effect fn iso2022RecoveryCase() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  run decodes(
    &[0x1b, 0x22, 0x1b, 0x28, 0x58],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0x22, 0xef, 0xbf, 0xbd, 0x28, 0x58],
  )
  run decodes(&[0x1b], Encoding.Iso2022Jp, &[0xef, 0xbf, 0xbd])
  run decodes(&[0x1b, 0x28], Encoding.Iso2022Jp, &[0xef, 0xbf, 0xbd, 0x28])
  run decodes(&[0x1b, 0x24, 0x42, 0x24], Encoding.Iso2022Jp, &[0xef, 0xbf, 0xbd])
  run decodes(
    &[0x1b, 0x24, 0x42, 0x24, 0x1b, 0x28, 0x42, 0x22],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0x22],
  )
  run decodes(
    &[0x1b, 0x24, 0x42, 0x1b, 0x28],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd],
  )
  run decodes(
    &[0x0e, 0x0f, 0x80],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd],
  )
  run decodes(
    &[0x1b, 0x28, 0x49, 0x20, 0x60],
    Encoding.Iso2022Jp,
    &[0xef, 0xbf, 0xbd, 0xef, 0xbf, 0xbd],
  )
}

// https://encoding.spec.whatwg.org/#gb18030-decoder
// https://encoding.spec.whatwg.org/#big5-decoder
// https://encoding.spec.whatwg.org/#euc-jp-decoder
// https://encoding.spec.whatwg.org/#shift_jis-decoder
// https://encoding.spec.whatwg.org/#euc-kr-decoder
// https://encoding.spec.whatwg.org/#iso-2022-jp-decoder
test effect fn multibyteEncodingStandard() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run gbCase() |> Effect.provideMut<Allocator>(&mut allocator)
  run big5Case() |> Effect.provideMut<Allocator>(&mut allocator)
  run eucJpCase() |> Effect.provideMut<Allocator>(&mut allocator)
  run shiftJisCase() |> Effect.provideMut<Allocator>(&mut allocator)
  run eucKrCase() |> Effect.provideMut<Allocator>(&mut allocator)
  run iso2022Case() |> Effect.provideMut<Allocator>(&mut allocator)
  run iso2022RecoveryCase() |> Effect.provideMut<Allocator>(&mut allocator)
}
