//! Conditional Rules 3 support is parse-time declaration acceptance, not computed validity.
import supports
import supports { Evaluation }
import declaration_values
import values { Store }
import input { Input, TokenRef }
import tokens { Limits, TokenBuffer, CssError, CssErrorKind }
import lexer
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn query(bytes: &[u8], expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(bytes, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let result = run supports.matches(&source, &mut store, &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(result == expected, "supports evaluates the entire pinned condition grammar")
}

effect fn evaluated(bytes: &[u8], importCondition: bool, valid: bool, value: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(bytes, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let result = if importCondition {
    run supports.evaluateImport(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator)
  } else {
    run supports.evaluate(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  run Testing.expect(
    result.valid == valid && result.value == value,
    "condition grammar validity is independent of feature support",
  )
}

// https://www.w3.org/TR/css-conditional-3/#typedef-supports-condition
// https://www.w3.org/TR/css-conditional-3/#support-definition
test effect fn evaluationDistinguishesInvalidFromValidFalse() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run evaluated(b"(fill: red)", false, true, true)
  run evaluated(b"(unknown-property: initial)", false, true, false)
  run evaluated(b"(fill: nonsense)", false, true, false)
  run evaluated(b"future(foo)", false, true, false)
  run evaluated(b"(fill: red;)", false, true, false)
  run evaluated(b"", false, false, false)
  run evaluated(b"fill: red", false, false, false)
  run evaluated(b"(fill: red) or garbage", false, false, false)
  run evaluated(b"(fill: red) and (stroke: blue) or (x: 1px)", false, false, false)
  run evaluated(b"(fill: red) or (broken ] syntax)", false, false, false)
}

// https://www.w3.org/TR/css-cascade-4/#at-import
// https://www.w3.org/TR/css-cascade-4/#conditional-import
test effect fn importSupportsAllowsBareDeclarationOrCondition() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run evaluated(b"fill: red", true, true, true)
  run evaluated(b" F\\49LL /**/: red ! ImPoRtAnT ", true, true, true)
  run evaluated(b"unknown-property: initial", true, true, false)
  run evaluated(b"fill: nonsense", true, true, false)
  run evaluated(b"fill:", true, true, false)
  run evaluated(b"--paint:", true, true, true)
  run evaluated(b"--paint: {a;b!c} [x]", true, true, true)
  run evaluated(b"fill: var(--missing)", true, true, true)
  run evaluated(b"fill: var(bad)", true, true, false)
  run evaluated(b"(fill: red)", true, true, true)
  run evaluated(b"not ((fill: nope) or (stroke: nope))", true, true, true)
  run evaluated(b"(fill: red) and (stroke: nope)", true, true, false)
  run evaluated(b"future(foo)", true, true, false)
}

// https://www.w3.org/TR/css-cascade-4/#at-import
// https://www.w3.org/TR/css-syntax-3/#consume-a-declaration
// https://www.w3.org/TR/css-syntax-3/#typedef-declaration-value
test effect fn importSupportsRejectsMalformedWholeContents() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run evaluated(b"", true, false, false)
  run evaluated(b"   ", true, false, false)
  run evaluated(b"fill red", true, false, false)
  run evaluated(b": red", true, false, false)
  run evaluated(b"fill: red;", true, false, false)
  run evaluated(b"fill: red; stroke: blue", true, false, false)
  run evaluated(b"fill: red !urgent", true, false, false)
  run evaluated(b"fill: {} var(--paint)", true, false, false)
  run evaluated(b"fill: red]", true, false, false)
  run evaluated(b"fill: 'bad\n'", true, false, false)
  run evaluated(b"not fill: red", true, false, false)
  run evaluated(b"(fill: red) or", true, false, false)
  run evaluated(b"(fill: red) or (broken ] syntax)", true, false, false)
}

// https://www.w3.org/TR/css-conditional-3/#support-definition
// https://www.w3.org/TR/css-conditional-3/#typedef-supports-decl
test effect fn typedSupportAndWholeDeclaration() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run query(b"(fill: red)", true)
  run query(b"(FILL: rEd)", true)
  run query(b"(f\\69ll: red)", true)
  run query(b"(fill: red blue)", false)
  run query(b"(x: 12px)", true)
  run query(b"(x: 12)", false)
  run query(b"(stroke-width: -1px)", false)
  run query(b"(unknown-property: initial)", false)
  run query(b"(fill:)", false)
  run query(b"fill: red", false)
  run query(b"(fill: red;)", false)
  run query(b"(fill: red) trailing", false)
  run query(b"(fill: red) or garbage", false)
  run query(b"(fill: blue) or (fill: red);", false)
}

// https://www.w3.org/TR/css-conditional-3/#typedef-supports-condition
test effect fn booleanGrammarDoesNotShortCircuitValidation() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run query(b"not (fill: nonsense)", true)
  run query(b"NOT (fill: red)", false)
  run query(b"(fill: red) and (stroke: blue)", true)
  run query(b"(fill: nope) or (stroke: blue)", true)
  run query(b"((fill: red) and (stroke: blue)) or (x: nope)", true)
  run query(b"not ((fill: nope) or (stroke: nope))", true)
  run query(b"(fill: red) and (stroke: blue) or (x: 1px)", false)
  run query(b"not (fill: nope) and (stroke: blue)", false)
  run query(b"not not (fill: red)", false)
  run query(b"(fill:red)or(stroke:blue)", false)
  run query(b"(fill:red)or (stroke:blue)", true)
  run query(b"(fill: red) or", false)
  run query(b"(fill: red) or (broken ] syntax)", false)
  run query(b"(fill: red) or unknown('bad\n')", false)
}

// https://www.w3.org/TR/css-conditional-3/#at-supports
// https://www.w3.org/TR/css-syntax-3/#typedef-any-value
// https://www.w3.org/TR/mediaqueries-5/#typedef-general-enclosed
// https://www.w3.org/TR/2022/CR-css-conditional-3-20220113/#typedef-supports-in-parens
test effect fn generalEnclosedIsFalseNotSelectorSupport() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run query(b"selector(svg)", false)
  run query(b"not selector(svg)", true)
  run query(b"not future()", true)
  run query(b"not ()", true)
  run query(b"not (42 !;)", true)
  run query(b"not ((fill:red) and (fill:red) or (fill:red))", true)
  run query(b"not (future-feature: [a; !b])", true)
  run query(b"future(foo [bar]) or (fill:red)", true)
  run query(b"not future(])", false)
  run query(b"(fill:red))", false)
  run query(b"(fill:red", true)
}

// https://www.w3.org/TR/css-conditional-3/#support-definition
// https://www.w3.org/TR/css-syntax-3/#consume-a-declaration
test effect fn cssWideAndImportantAreDeclarationSyntax() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run query(b"(fill: initial)", true)
  run query(b"(fill: inherit)", true)
  run query(b"(fill: unset)", true)
  run query(b"(fill: revert)", true)
  run query(b"(fill: initial red)", false)
  run query(b"(fill: red ! ImPoRtAnT)", true)
  run query(b"(fill: red !/**/important)", true)
  run query(b"(fill: red !important !important)", false)
  run query(b"(fill: red !urgent)", false)
  run query(b"(fill: !important)", false)
}

// https://www.w3.org/TR/css-variables-1/#defining-variables
// https://www.w3.org/TR/css-variables-1/#using-variables
test effect fn customPropertiesAndDeferredVarValidity() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run query(b"(--paint:)", true)
  run query(b"(--paint: !important)", true)
  run query(b"(--paint: initial)", true)
  run query(b"(--paint: {a;b!c} [x])", true)
  run query(b"(--: red)", false)
  run query(b"(--paint: red; blue)", false)
  run query(b"(--paint: red !urgent)", false)
  run query(b"(fill: var(--missing))", true)
  run query(b"(fill: initial var(--missing))", true)
  run query(b"(fill: var(--missing,))", true)
  run query(b"(fill: var(--missing, red, blue))", true)
  run query(b"(fill: var(--missing, var(--fallback)))", true)
  run query(b"(fill: VaR(--missing) !important)", true)
  run query(b"(fill: var(--missing ", true)
  run query(b"(fill: var(--missing, red !important", false)
  run query(b"(--paint: unknown(!important", true)
  run query(b"(unknown: var(--missing))", false)
  run query(b"(fill: var())", false)
  run query(b"(fill: var(--))", false)
  run query(b"(fill: var(paint))", false)
  run query(b"(fill: var(--paint extra))", false)
  run query(b"(fill: var(--paint, red !important))", false)
  run query(b"(fill: var(--paint, red; blue))", false)
  run query(b"(fill: var(--paint, var(bad)))", false)
  run query(b"(--paint: unknown(var(bad)))", false)
  run query(b"(fill: var(--paint) !bad)", false)
  run query(b"(fill: {} var(--paint))", false)
  run query(b"(fill: {var(--paint)})", true)
  run query(b"(--paint: {} var(--paint))", true)
}

effect fn joined(first: &[u8], second: &[u8], importCondition: bool, expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let a = run lexer.tokenize(first, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run lexer.tokenize(second, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut references = List<TokenRef>.make()
  let mut i: usize = 0
  while i < a.all().end {
    run references.append(TokenRef { buffer: 0, token: i })
      |> Effect.provideMut<Allocator>(&mut allocator)
    i = i + 1
  }
  i = 0
  while i < b.all().end {
    run references.append(TokenRef { buffer: 1, token: i })
      |> Effect.provideMut<Allocator>(&mut allocator)
    i = i + 1
  }
  let mut buffers = List<TokenBuffer>.make()
  run buffers.append(move a) |> Effect.provideMut<Allocator>(&mut allocator)
  run buffers.append(move b) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Expanded { buffers: buffers.asSlice(), references: references.asSlice() }
  let mut store = Store.make()
  let result = if importCondition {
    let imported = run supports.evaluateImport(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator)
    imported.valid && imported.value
  } else {
    run supports.matches(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  run Testing.expect(
    result == expected,
    "expanded input uses its own indexes and preserves token boundaries",
  )
}

// https://www.w3.org/TR/css-variables-1/#using-variables
// https://www.w3.org/TR/css-syntax-3/#consume-a-simple-block
test effect fn expandedInputNeverUsesOriginalMatchingIndexes() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run joined(b"(fill:", b"red)", false, true)
  run joined(b"(x:1", b"px)", false, false)
  run joined(b"not ((fill: nope) or", b"(stroke: nope))", false, true)
  run joined(b"(fill: rgb(", b"255 0 0))", false, true)
}

// https://www.w3.org/TR/css-cascade-4/#conditional-import
// https://www.w3.org/TR/css-syntax-3/#consume-a-simple-block
test effect fn importSupportsPreservesExpandedTokenBoundaries() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run joined(b"fill:", b"red", true, true)
  run joined(b"x:1", b"px", true, false)
  run joined(b"fill: rgb(", b"255 0 0)", true, true)
  run joined(b"not ((fill: nope) or", b"(stroke: nope))", true, true)
}

// https://www.w3.org/TR/css-syntax-3/#tokenization
// https://www.w3.org/TR/css-syntax-3/#consume-a-simple-block
test effect fn conditionLimitsApplyAfterTokenization() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let buffer = run lexer.tokenize(b"((fill:red))", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let mut limits = Limits.make()
  limits.maxTokens = 1
  let tokenResult = run Effect.result(
    supports.matches(&source, &mut store, &limits) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &tokenResult {
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.TokenLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "supports has a token limit independent of lexer limits",
  )
  limits = Limits.make()
  limits.maxDepth = 1
  let depthResult = run Effect.result(
    supports.matches(&source, &mut store, &limits) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &depthResult {
      Result<bool, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "supports has a nesting limit independent of lexer limits",
  )
}

// https://www.w3.org/TR/css-cascade-4/#conditional-import
// https://www.w3.org/TR/css-syntax-3/#tokenization
test effect fn importSupportsPreservesBoundedFailures() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let buffer = run lexer.tokenize(b"fill: rgb(255 0 0)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let mut limits = Limits.make()
  limits.maxTokens = 1
  let tokenResult = run Effect.result(
    supports.evaluateImport(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &tokenResult {
      Result<Evaluation, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.TokenLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "bare import declarations cannot bypass the token limit",
  )
  limits = Limits.make()
  limits.maxDepth = 0
  let depthResult = run Effect.result(
    supports.evaluateImport(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &depthResult {
      Result<Evaluation, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.NestingLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "bare import declarations cannot bypass the nesting limit",
  )
  limits = Limits.make()
  limits.maxStorageBytes = 0
  let storageResult = run Effect.result(
    supports.evaluateImport(&source, &mut store, &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &storageResult {
      Result<Evaluation, CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.StorageLimit
        OutOfMemoryError problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    "bare import declarations cannot bypass the storage limit",
  )
}

effect fn declaration(bytes: &[u8], valid: bool, variables: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(bytes, &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let result = run declaration_values.validate(&source, &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    result.valid == valid && (!valid || result.hasVariables == variables),
    "shared pre-substitution declaration validator follows Variables 1",
  )
}

// https://www.w3.org/TR/css-variables-1/#defining-variables
// https://www.w3.org/TR/css-variables-1/#using-variables
test effect fn sharedDeclarationValidatorIsIndependentOfPropertyGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  run declaration(b"", true, false)
  run declaration(b"nonsense red blue", true, false)
  run declaration(b"{a;!b} [c]", true, false)
  run declaration(b"var(--a, [!;] var(--b,))", true, true)
  run declaration(b"VAR(--a", true, true)
  run declaration(b"VAR(--a ", true, true)
  run declaration(b"unknown(var(--a, var(no)))", false, false)
  run declaration(b"var(--a, !important)", false, false)
  run declaration(b"red !important", false, false)
  run declaration(b"red;blue", false, false)
  run declaration(b"var(--a))", false, false)
}

// https://www.w3.org/TR/css-syntax-3/#typedef-any-value
test effect fn malformedExpandedReferencesNeverBecomeSupported() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"(fill:red)", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let eof = buffer.all().end
  let buffers = [move buffer]
  let missingBuffer = [TokenRef { buffer: 1, token: 0 }]
  let missingToken = [TokenRef { buffer: 0, token: eof + 1 }]
  let embeddedEof = [TokenRef { buffer: 0, token: eof }]
  let a = Input.Expanded { buffers: &buffers, references: &missingBuffer }
  let b = Input.Expanded { buffers: &buffers, references: &missingToken }
  let c = Input.Expanded { buffers: &buffers, references: &embeddedEof }
  let mut store = Store.make()
  let acceptedA = run supports.matches(&a, &mut store, &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptedB = run supports.matches(&b, &mut store, &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptedC = run supports.matches(&c, &mut store, &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    !acceptedA && !acceptedB && !acceptedC,
    "invalid expanded references and explicit EOF are not conditions",
  )
}
