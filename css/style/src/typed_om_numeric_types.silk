//! CSS Typed OM §4.3.2 dimensional algebra; percentages carry explicit hints.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import cssom_error { CssomError }

pub enum BaseType {
  Length,
  Angle,
  Time,
  Frequency,
  Resolution,
  Flex,
  Percent
}

pub struct NumericType {
  pub exponents: [i32; 7],
  pub percentHint: Option<BaseType>,
}

impl Copy for NumericType {}

pub fn baseIndex(base: BaseType) -> usize {
  return match base {
    BaseType.Length => 0
    BaseType.Angle => 1
    BaseType.Time => 2
    BaseType.Frequency => 3
    BaseType.Resolution => 4
    BaseType.Flex => 5
    BaseType.Percent => 6
  }
}

impl NumericType {
  pub fn number() -> Self {
    return Self { exponents: [0; 7], percentHint: Option<BaseType>.None }
  }

  pub fn base(base: BaseType) -> Self {
    let mut result = NumericType.number()
    result.exponents[baseIndex(base)] = 1
    return result
  }

  pub fn hinted(self: &Self, hint: BaseType) -> Self {
    let mut result = self.*
    result.percentHint = Option<BaseType>.some(hint)
    if hint != BaseType.Percent {
      let index = baseIndex(hint)
      result.exponents[index] = result.exponents[index] + result.exponents[6]
      result.exponents[6] = 0
    }
    return result
  }

  pub fn samePowers(self: &Self, other: &Self) -> bool {
    let mut i: usize = 0
    while i < 7 {
      if self.exponents[i] != other.exponents[i] {
        return false
      }
      i = i + 1
    }
    return true
  }

  pub fn isNumber(self: &Self) -> bool {
    return self.percentHint.isNone() && self.samePowers(&NumericType.number())
  }

  pub fn isPercent(self: &Self) -> bool {
    return self.matches(BaseType.Percent, true)
  }

  pub fn matches(self: &Self, base: BaseType, allowPercent: bool) -> bool {
    let validHint = match &self.percentHint {
      Option<BaseType>.Some { value } => allowPercent && value == base
      _ => true
    }
    if !validHint {
      return false
    }
    if self.samePowers(&NumericType.base(base)) {
      return true
    }
    return allowPercent && self.samePowers(&NumericType.base(BaseType.Percent))
  }

  pub fn inverted(self: &Self) -> Self {
    let mut result = self.*
    let mut i: usize = 0
    while i < 7 {
      result.exponents[i] = -result.exponents[i]
      i = i + 1
    }
    return result
  }
}

pub effect fn combine(left: NumericType, right: NumericType, multiply: bool) -> NumericType
  ! CssomError {
  let mut a = left
  let mut b = right
  match &a.percentHint {
    Option<BaseType>.Some { value: hint } => {
      match &b.percentHint {
        Option<BaseType>.Some { value: other } => {
          if hint != other {
            fail CssomError.TypeError
          }
        }
        _ => {
          b = b.hinted(hint)
        }
      }
    }
    _ => {
      match &b.percentHint {
        Option<BaseType>.Some { value: hint } => {
          a = a.hinted(hint)
        }
        _ => {}
      }
    }
  }
  if multiply {
    let mut i: usize = 0
    while i < 7 {
      a.exponents[i] = a.exponents[i] + b.exponents[i]
      i = i + 1
    }
    return a
  }
  if a.samePowers(&b) {
    return a
  }
  if a.exponents[6] != 0 || b.exponents[6] != 0 {
    let hints = [
      BaseType.Length,
      BaseType.Angle,
      BaseType.Time,
      BaseType.Frequency,
      BaseType.Resolution,
      BaseType.Flex,
    ]
    let mut i: usize = 0
    while i < 6 {
      let hintedA = a.hinted(hints[i])
      let hintedB = b.hinted(hints[i])
      if hintedA.samePowers(&hintedB) {
        return hintedA
      }
      i = i + 1
    }
  }
  fail CssomError.TypeError
}
