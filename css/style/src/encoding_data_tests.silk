//! Encoding Standard snapshot e1421f1791b202717883c452a6267129ce5fb3ca13652e5022a2b6d2a11fc262.
import encoding_data
import encoding_types { Encoding }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

fn isLabel(input: &[u8], expected: Encoding) -> bool {
  let found = encoding_data.label(input)
  return match &found {
    Option<Encoding>.Some { value } => value == expected
    Option<Encoding>.None => false
  }
}

fn missingLabel(input: &[u8]) -> bool {
  let found = encoding_data.label(input)
  return match &found {
    Option<Encoding>.None => true
    _ => false
  }
}

// https://encoding.spec.whatwg.org/#names-and-labels
// https://encoding.spec.whatwg.org/#concept-encoding-get
// Every one of the 228 pinned labels, grouped by its normative encoding.
effect fn labelGroup(labels: &[u8], expected: Encoding) -> ()
  ! AssertionError<'static> {
  let mut start: usize = 0
  let mut end: usize = 0
  while end <= labels.length {
    if end == labels.length || labels[end] == 32 {
      run Testing.expect(
        isLabel(Slice.view<u8>(labels, start, end - start), expected),
        "normative encoding alias",
      )
      start = end + 1
    }
    end = end + 1
  }
}

test effect fn allEncodingLabels() -> ()
  ! AssertionError<'static> {
  run labelGroup(
    b"unicode-1-1-utf-8 unicode11utf8 unicode20utf8 utf-8 utf8 x-unicode20utf8",
    Encoding.Utf8,
  )
  run labelGroup(b"866 cp866 csibm866 ibm866", Encoding.Ibm866)
  run labelGroup(
    b"csisolatin2 iso-8859-2 iso-ir-101 iso8859-2 iso88592 iso_8859-2 iso_8859-2:1987 l2 latin2",
    Encoding.Iso8859_2,
  )
  run labelGroup(
    b"csisolatin3 iso-8859-3 iso-ir-109 iso8859-3 iso88593 iso_8859-3 iso_8859-3:1988 l3 latin3",
