  run labelGroup(b"csmacintosh mac macintosh x-mac-roman", Encoding.Macintosh)
  run labelGroup(
    b"dos-874 iso-8859-11 iso8859-11 iso885911 tis-620 windows-874",
    Encoding.Windows874,
  )
  run labelGroup(b"cp1250 windows-1250 x-cp1250", Encoding.Windows1250)
  run labelGroup(b"cp1251 windows-1251 x-cp1251", Encoding.Windows1251)
  run labelGroup(
    b"ansi_x3.4-1968 ascii cp1252 cp819 csisolatin1 ibm819 iso-8859-1 iso-ir-100 iso8859-1 iso88591 iso_8859-1 iso_8859-1:1987 l1 latin1 us-ascii windows-1252 x-cp1252",
    Encoding.Windows1252,
