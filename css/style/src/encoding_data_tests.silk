  run labelGroup(b"x-user-defined", Encoding.XUserDefined)
}

// https://encoding.spec.whatwg.org/#concept-encoding-get
test effect fn encodingLabelNormalization() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    isLabel(b"\t\n\x0c\r UtF-8 \t", Encoding.Utf8),
    "ASCII whitespace and ASCII case",
  )
  run Testing.expect(isLabel(b"ASCII", Encoding.Windows1252), "ASCII is Windows-1252")
  run Testing.expect(isLabel(b"UTF-16", Encoding.Utf16Le), "UTF-16 label is little endian")
  run Testing.expect(missingLabel(b""), "empty label fails")
  run Testing.expect(missingLabel(b" \t\r\n\x0c"), "whitespace alone fails")
  run Testing.expect(missingLabel(b"\x0butf-8"), "vertical tab is not ASCII whitespace")
  run Testing.expect(missingLabel(b"utf-8\x00"), "NUL is not trimmed")
  run Testing.expect(missingLabel(b"\xc2\xa0utf-8"), "non-ASCII whitespace is not trimmed")
  run Testing.expect(missingLabel(b"utf -8"), "internal whitespace is not removed")
  run Testing.expect(missingLabel(b"utf_8"), "unlisted punctuation aliases fail")
  run Testing.expect(missingLabel(b"utf-32"), "unlisted encodings fail")
}

// https://encoding.spec.whatwg.org/#index-code-point
// https://encoding.spec.whatwg.org/#single-byte-decoder
test effect fn singleByteIndexes() -> ()
  ! AssertionError<'static> {
  run Testing.expect(encoding_data.single(Encoding.Ibm866, 0) == 0x410, "ibm866 index value")
  run Testing.expect(encoding_data.single(Encoding.Iso8859_2, 0) == 0x80, "iso-8859-2 index value")
  run Testing.expect(encoding_data.single(Encoding.Iso8859_3, 0) == 0x80, "iso-8859-3 index value")
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_3, 37) == 0xFFFFFFFF,
    "iso-8859-3 unmapped pointer",
  )
  run Testing.expect(encoding_data.single(Encoding.Iso8859_4, 0) == 0x80, "iso-8859-4 index value")
  run Testing.expect(encoding_data.single(Encoding.Iso8859_5, 0) == 0x80, "iso-8859-5 index value")
  run Testing.expect(encoding_data.single(Encoding.Iso8859_6, 0) == 0x80, "iso-8859-6 index value")
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_6, 33) == 0xFFFFFFFF,
    "iso-8859-6 unmapped pointer",
  )
  run Testing.expect(encoding_data.single(Encoding.Iso8859_7, 0) == 0x80, "iso-8859-7 index value")
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_7, 46) == 0xFFFFFFFF,
    "iso-8859-7 unmapped pointer",
  )
  run Testing.expect(encoding_data.single(Encoding.Iso8859_8, 0) == 0x80, "iso-8859-8 index value")
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_8, 33) == 0xFFFFFFFF,
    "iso-8859-8 unmapped pointer",
  )
  run Testing.expect(encoding_data.single(Encoding.Iso8859_8I, 0) == 0x80, "iso-8859-8 index value")
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_8I, 33) == 0xFFFFFFFF,
    "iso-8859-8 unmapped pointer",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_10, 0) == 0x80,
    "iso-8859-10 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_13, 0) == 0x80,
    "iso-8859-13 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_14, 0) == 0x80,
    "iso-8859-14 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_15, 0) == 0x80,
    "iso-8859-15 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Iso8859_16, 0) == 0x80,
    "iso-8859-16 index value",
  )
  run Testing.expect(encoding_data.single(Encoding.Koi8R, 0) == 0x2500, "koi8-r index value")
  run Testing.expect(encoding_data.single(Encoding.Koi8U, 0) == 0x2500, "koi8-u index value")
  run Testing.expect(encoding_data.single(Encoding.Macintosh, 0) == 0xC4, "macintosh index value")
  run Testing.expect(
    encoding_data.single(Encoding.Windows874, 0) == 0x20AC,
    "windows-874 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows874, 91) == 0xFFFFFFFF,
    "windows-874 unmapped pointer",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1250, 0) == 0x20AC,
    "windows-1250 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1251, 0) == 0x402,
    "windows-1251 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1252, 0) == 0x20AC,
    "windows-1252 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1253, 0) == 0x20AC,
    "windows-1253 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1253, 42) == 0xFFFFFFFF,
    "windows-1253 unmapped pointer",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1254, 0) == 0x20AC,
    "windows-1254 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1255, 0) == 0x20AC,
    "windows-1255 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1255, 89) == 0xFFFFFFFF,
    "windows-1255 unmapped pointer",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1256, 0) == 0x20AC,
    "windows-1256 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1257, 0) == 0x20AC,
    "windows-1257 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1257, 33) == 0xFFFFFFFF,
    "windows-1257 unmapped pointer",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1258, 0) == 0x20AC,
    "windows-1258 index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.XMacCyrillic, 0) == 0x410,
    "x-mac-cyrillic index value",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1252, 128) == 0xFFFFFFFF,
    "single-byte upper bound",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Windows1252, 0xFFFFFFFF) == 0xFFFFFFFF,
    "large pointer does not overflow",
  )
  run Testing.expect(
    encoding_data.single(Encoding.Utf8, 0) == 0xFFFFFFFF,
    "not a single-byte index",
  )
}

// https://encoding.spec.whatwg.org/#index-code-point
// https://encoding.spec.whatwg.org/#index-gb18030
// https://encoding.spec.whatwg.org/#index-big5
// https://encoding.spec.whatwg.org/#index-jis0208
// https://encoding.spec.whatwg.org/#index-jis0212
// https://encoding.spec.whatwg.org/#index-euc-kr
test effect fn multibyteIndexes() -> ()
  ! AssertionError<'static> {
  run Testing.expect(encoding_data.gb18030(0) == 0x4E02, "GB18030 8140")
  run Testing.expect(encoding_data.big5(5495) == 0x4E00, "Big5 A440")
  run Testing.expect(encoding_data.jis0208(283) == 0x3042, "JIS0208 hiragana A")
  run Testing.expect(encoding_data.jis0212(108) == 0x02D8, "JIS0212 breve")
  run Testing.expect(encoding_data.eucKr(9026) == 0xAC00, "EUC-KR B0A1")
  run Testing.expect(
    encoding_data.big5(947) == 0x27267,
    "Big5 supplementary scalar retains all 21 bits",
  )
  run Testing.expect(encoding_data.big5(0) == 0xFFFFFFFF, "Big5 hole")
  run Testing.expect(encoding_data.jis0212(0) == 0xFFFFFFFF, "JIS0212 hole")
  run Testing.expect(encoding_data.gb18030(23939) == 0xE4C5, "gb18030 last pointer")
  run Testing.expect(encoding_data.gb18030(23940) == 0xFFFFFFFF, "gb18030 past table")
  run Testing.expect(encoding_data.gb18030(0xFFFFFFFF) == 0xFFFFFFFF, "gb18030 large pointer")
  run Testing.expect(encoding_data.big5(19781) == 0x79D4, "big5 last pointer")
  run Testing.expect(encoding_data.big5(19782) == 0xFFFFFFFF, "big5 past table")
  run Testing.expect(encoding_data.big5(0xFFFFFFFF) == 0xFFFFFFFF, "big5 large pointer")
  run Testing.expect(encoding_data.jis0208(11103) == 0x9ED1, "jis0208 last pointer")
  run Testing.expect(encoding_data.jis0208(11104) == 0xFFFFFFFF, "jis0208 past table")
  run Testing.expect(encoding_data.jis0208(0xFFFFFFFF) == 0xFFFFFFFF, "jis0208 large pointer")
  run Testing.expect(encoding_data.jis0212(7210) == 0x9FA5, "jis0212 last pointer")
  run Testing.expect(encoding_data.jis0212(7211) == 0xFFFFFFFF, "jis0212 past table")
  run Testing.expect(encoding_data.jis0212(0xFFFFFFFF) == 0xFFFFFFFF, "jis0212 large pointer")
  run Testing.expect(encoding_data.eucKr(23749) == 0x8A70, "euc-kr last pointer")
  run Testing.expect(encoding_data.eucKr(23750) == 0xFFFFFFFF, "euc-kr past table")
  run Testing.expect(encoding_data.eucKr(0xFFFFFFFF) == 0xFFFFFFFF, "euc-kr large pointer")
}

// https://encoding.spec.whatwg.org/#index-gb18030-ranges-code-point
test effect fn gb18030RangeBoundaries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(encoding_data.gb18030Range(0) == 0x80, "first range")
  run Testing.expect(
    encoding_data.gb18030Range(7456) == 0x1E3E,
    "pointer before the isolated override",
  )
  run Testing.expect(encoding_data.gb18030Range(7457) == 0xE7C7, "2005 special case")
  run Testing.expect(
    encoding_data.gb18030Range(7458) == 0x1E40,
    "pointer after the isolated override",
  )
  run Testing.expect(encoding_data.gb18030Range(39419) == 0xFFFF, "last BMP pointer")
  run Testing.expect(encoding_data.gb18030Range(39420) == 0xFFFFFFFF, "gap begins")
  run Testing.expect(encoding_data.gb18030Range(188999) == 0xFFFFFFFF, "gap ends")
  run Testing.expect(encoding_data.gb18030Range(189000) == 0x10000, "supplementary begins")
  run Testing.expect(encoding_data.gb18030Range(1237575) == 0x10FFFF, "last Unicode scalar")
  run Testing.expect(encoding_data.gb18030Range(1237576) == 0xFFFFFFFF, "past Unicode")
  run Testing.expect(encoding_data.gb18030Range(0xFFFFFFFF) == 0xFFFFFFFF, "large pointer")
}
