//! A table from already-hashed keys to indices.
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize

/// Already-hashed u64 keys to indices, by open addressing: a lookup costs a multiply and a
/// few compares, where a HashMap hashes the key again. Key 0 marks an empty slot, so keys 0
/// and 1 are the same key; callers use a key to find a candidate they then confirm.
pub struct KeyIndex {
  keys: List<u64>,
  values: List<usize>,
  count: usize,
  shift: u64,
}

impl KeyIndex {
  pub fn make() -> KeyIndex {
    return KeyIndex { keys: List<u64>.make(), values: List<usize>.make(), count: 0, shift: 64 }
  }

  @inlineAlways
  fn slot(self: &Self, key: u64) -> usize {
    return u64.toUsize(u64.shiftRight(u64.wrappingMultiply(key, 11400714819323198485), self.shift))
  }

  pub fn get(self: &Self, key: u64) -> Option<usize> {
    let keys = self.keys.asSlice()
    if keys.length == 0 {
      return Option<usize>.None
    }
    let k = if key == 0 {
      1
    } else {
      key
    }
    let mask = keys.length - 1
    let mut i = self.slot(k)
    while keys[i] != 0 {
      if keys[i] == k {
        return Option<usize>.Some { value: self.values.asSlice()[i] }
      }
      i = (i + 1) & mask
    }
    return Option<usize>.None
  }

  /// Room for `additional` more keys without rebuilding, at most half full.
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let wanted = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some { value } => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if wanted * 2 <= self.keys.length() {
      return
    }
    let mut size: usize = 16
    let mut shift: u64 = 60
    while size < wanted * 2 {
      if size > usize.MAX / 4 {
        return run Allocator.outOfMemory()
      }
      size = size * 2
      shift = shift - 1
    }
    let mut keys = run List<u64>.makeWithCapacity(size)
    run keys.appendRepeated(0, size)
    let mut values = run List<usize>.makeWithCapacity(size)
    run values.appendRepeated(0, size)
    let old = self.keys.asSlice()
    let oldValues = self.values.asSlice()
    let mask = size - 1
    let mut j: usize = 0
    while j < old.length {
      let k = old[j]
      if k != 0 {
        let mut i = u64.toUsize(
          u64.shiftRight(u64.wrappingMultiply(k, 11400714819323198485), shift),
        )
        while keys.asSlice()[i] != 0 {
          i = (i + 1) & mask
        }
        let mut ks = keys.asMutSlice()
        ks[i] = k
        let mut vs = values.asMutSlice()
        vs[i] = oldValues[j]
      }
      j = j + 1
    }
    self.keys = move keys
    self.values = move values
    self.shift = shift
  }

  /// Forgets every key, keeping the slots.
  pub fn clear(self: &mut Self) -> () {
    if self.count == 0 {
      return
    }
    let mut keys = self.keys.asMutSlice()
    let mut i: usize = 0
    while i < keys.length {
      keys[i] = 0
      i = i + 1
    }
    self.count = 0
  }

  /// Maps `key` to `value`, replacing an earlier value for the same key.
  pub effect fn insert(self: &mut Self, key: u64, value: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.reserve(1)
    let k = if key == 0 {
      1
    } else {
      key
    }
    let mask = self.keys.length() - 1
    let mut i = self.slot(k)
    let mut keys = self.keys.asMutSlice()
    while keys[i] != 0 {
      if keys[i] == k {
        let mut values = self.values.asMutSlice()
        values[i] = value
        return
      }
      i = (i + 1) & mask
    }
    keys[i] = k
    let mut values = self.values.asMutSlice()
    values[i] = value
    self.count = self.count + 1
  }
}
