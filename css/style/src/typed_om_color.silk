//! Typed OM 4.6/5.7 color objects backed by the shared numeric arena.
//! Color conversion delegates to colors; stringification is the native Color 4
//! syntax extension (the pinned Typed OM draft leaves color stringifiers open).
import typed_om_numeric { NumericStore, NumericId, BaseType }
import colors { Color, Space, Identity }
import colors
import lexer
import input { Input }
import value_cursor { Cursor }
import tokens { Limits, CssError, Kind, TokenBuffer, Span, insensitive }
import cssom_error { CssomError }
import cssom_serialization as serialization
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub union ColorInput<'a> {
  Number { pub value: f64 },
  Numeric { pub id: NumericId },
  Keyword { pub text: &'a [u8] },
}

impl<'a> Copy for ColorInput<'a> {}

pub union ColorComponent {
  Numeric { pub id: NumericId },
  None,
}

impl Copy for ColorComponent {}

pub enum ComponentType {
  RGB,
  Percent,
  Number,
  Angle,
}

pub effect fn rectify(
  store: &mut NumericStore,
  input: ColorInput,
  kind: ComponentType,
) -> ColorComponent
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  match &input {
    ColorInput.Number { value } => {
      let unit = if kind == ComponentType.Angle {
        b"deg"
      } else if kind == ComponentType.Number {
        b"number"
      } else {
        b"percent"
      }
      let amount = if kind == ComponentType.Percent || kind == ComponentType.RGB {
        value * 100.0
      } else {
        value
      }
      return ColorComponent.Numeric { id: run store.unit(amount, unit) }
    }
    ColorInput.Numeric { id } => {
      let numericType = store.typeOf(id)
      let valid = match kind {
        ComponentType.RGB => numericType.isNumber() || numericType.isPercent()
        ComponentType.Percent => numericType.isPercent()
        ComponentType.Number => numericType.isNumber()
        ComponentType.Angle => numericType.matches(BaseType.Angle, false)
      }
      if valid {
        return ColorComponent.Numeric { id: id }
      }
    }
    ColorInput.Keyword { text } => {
      if insensitive(text, b"none") {
        return ColorComponent.None
      }
    }
  }
  if kind == ComponentType.Angle {
    fail CssomError.TypeError
  }
  fail CssomError.SyntaxError
}

struct Components {
  channels: [ColorComponent; 3],
  alpha: ColorComponent,
}

impl Copy for Components {}

impl Components {
  effect fn make(
    store: &mut NumericStore,
    inputs: [ColorInput; 3],
    kinds: [ComponentType; 3],
    alpha: ColorInput,
  ) -> Components
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let first = run rectify(&mut store.*, inputs[0], kinds[0])
    let second = run rectify(&mut store.*, inputs[1], kinds[1])
    let third = run rectify(&mut store.*, inputs[2], kinds[2])
    let opacity = run rectify(&mut store.*, alpha, ComponentType.Percent)
    return Components { channels: [first, second, third], alpha: opacity }
  }
}

pub struct CSSColor {
  spaceName: Bytes,
  values: List<ColorComponent>,
  opacity: ColorComponent,
}

impl CSSColor {
  pub effect fn make(
    store: &mut NumericStore,
    colorSpace: &[u8],
    channels: &[ColorInput],
    alpha: ColorInput,
  ) -> CSSColor
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    if colorSpace.length == 0 {
      fail CssomError.TypeError
    }
    let mut values = List<ColorComponent>.make()
    let mut i: usize = 0
    while i < channels.length {
      run values.append(run rectify(&mut store.*, channels[i], ComponentType.Percent))
      i = i + 1
    }
    return CSSColor {
      spaceName: run Bytes.copy(colorSpace),
      values: move values,
      opacity: run rectify(&mut store.*, alpha, ComponentType.Percent),
    }
  }

  pub effect fn opaque(
    store: &mut NumericStore,
    colorSpace: &[u8],
    channels: &[ColorInput],
  ) -> CSSColor
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return run CSSColor.make(&mut store.*, colorSpace, channels, ColorInput.Number { value: 1.0 })
  }

  pub fn colorSpace<'a>(self: &'a CSSColor) -> &'a [u8] {
    return Bytes.asSlice(&self.spaceName)
  }

  pub fn channels<'a>(self: &'a CSSColor) -> &'a [ColorComponent] {
    return self.values.asSlice()
  }

  pub fn alpha(self: &CSSColor) -> ColorComponent {
    return self.opacity
  }

  pub effect fn setColorSpace(self: &mut CSSColor, colorSpace: &[u8]) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    if colorSpace.length == 0 {
      fail CssomError.TypeError
    }
    self.spaceName = run Bytes.copy(colorSpace)
  }

  pub effect fn setAlpha(self: &mut CSSColor, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.opacity = run rectify(&mut store.*, value, ComponentType.Percent)
  }

  pub effect fn setChannel(
    self: &mut CSSColor,
    store: &mut NumericStore,
    index: usize,
    value: ColorInput,
  ) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    if index > self.values.length() {
      fail CssomError.IndexSizeError
    }
    let rectified = run rectify(&mut store.*, value, ComponentType.Percent)
    if index == self.values.length() {
      run self.values.append(rectified)
    } else {
      let channels = self.values.asMutSlice()
      channels[index] = rectified
    }
  }

  pub effect fn setChannels(
    self: &mut CSSColor,
    store: &mut NumericStore,
    channels: &[ColorInput],
  ) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let mut values = List<ColorComponent>.make()
    let mut i: usize = 0
    while i < channels.length {
      run values.append(run rectify(&mut store.*, channels[i], ComponentType.Percent))
      i = i + 1
    }
    self.values = move values
  }

  pub fn deleteChannel(self: &mut CSSColor, index: usize) -> bool {
    if index >= self.values.length() {
      return false
    }
    let removed = self.values.remove(index)
    return true
  }
}

pub union CSSColorValue {
  RGB { pub value: CSSRGB },
  HSL { pub value: CSSHSL },
  HWB { pub value: CSSHWB },
  Lab { pub value: CSSLab },
  LCH { pub value: CSSLCH },
  OKLab { pub value: CSSOKLab },
  OKLCH { pub value: CSSOKLCH },
  Color { pub value: CSSColor },
}

pub union ParsedColor {
  Absolute { pub value: CSSColorValue },
  Keyword { pub text: Bytes },
}

pub fn spaceName(space: Space) -> &'static [u8] {
  return match space {
    Space.Srgb => b"srgb"
    Space.SrgbLinear => b"srgb-linear"
    Space.DisplayP3 => b"display-p3"
    Space.DisplayP3Linear => b"display-p3-linear"
    Space.A98Rgb => b"a98-rgb"
    Space.ProphotoRgb => b"prophoto-rgb"
    Space.Rec2020 => b"rec2020"
    Space.XyzD50 => b"xyz-d50"
    Space.XyzD65 => b"xyz-d65"
    Space.Hsl => b"hsl"
    Space.Hwb => b"hwb"
    Space.Lab => b"lab"
    Space.Lch => b"lch"
    Space.Oklab => b"oklab"
    Space.Oklch => b"oklch"
  }
}

pub fn colorSpace(name: &[u8]) -> Option<Space> {
  let spaces = [
    Space.Srgb,
    Space.SrgbLinear,
    Space.DisplayP3,
    Space.DisplayP3Linear,
    Space.A98Rgb,
    Space.ProphotoRgb,
    Space.Rec2020,
    Space.XyzD50,
    Space.XyzD65,
    Space.Hsl,
    Space.Hwb,
    Space.Lab,
    Space.Lch,
    Space.Oklab,
    Space.Oklch,
  ]
  let mut i: usize = 0
  while i < spaces.length {
    if insensitive(name, spaceName(spaces[i])) {
      return Option<Space>.some(spaces[i])
    }
    i = i + 1
  }
  if insensitive(name, b"xyz") {
    return Option<Space>.some(Space.XyzD65)
  }
  return Option<Space>.None
}

fn genericSpace(space: Space) -> bool {
  return space != Space.Hsl && space != Space.Hwb && space != Space.Lab && space != Space.Lch
    && space != Space.Oklab
    && space != Space.Oklch
}

fn angular(space: Space, index: usize) -> bool {
  return ((space == Space.Hsl || space == Space.Hwb) && index == 0)
    || ((space == Space.Lch || space == Space.Oklch) && index == 2)
}

fn percentScale(space: Space, index: usize, generic: bool) -> f64 {
  if generic {
    return 1.0
  }
  if space == Space.Srgb {
    return 1.0
  }
  if space == Space.Hsl || space == Space.Hwb || space == Space.Lab {
    return if space == Space.Lab && index != 0 {
      125.0
    } else {
      100.0
    }
  }
  if space == Space.Lch {
    return if index == 0 {
      100.0
    } else {
      150.0
    }
  }
  return if index == 0 {
    1.0
  } else {
    0.4
  }
}

effect fn appendComponent(out: &mut Bytes, store: &NumericStore, component: ColorComponent) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &component {
    ColorComponent.None => {
      run Bytes.append(&mut out.*, b"none")
    }
    ColorComponent.Numeric { id } => {
      let text = run store.serialize(id)
      run Bytes.append(&mut out.*, Bytes.asSlice(&text))
    }
  }
}

effect fn appendFunction(
  out: &mut Bytes,
  store: &NumericStore,
  name: &[u8],
  parts: Components,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut out.*, name)
  run Bytes.append(&mut out.*, b"(")
  let mut i: usize = 0
  while i < 3 {
    if i != 0 {
      run Bytes.append(&mut out.*, b" ")
    }
    run appendComponent(&mut out.*, store, parts.channels[i])
    i = i + 1
  }
  run Bytes.append(&mut out.*, b" / ")
  run appendComponent(&mut out.*, store, parts.alpha)
  run Bytes.append(&mut out.*, b")")
}

effect fn resolveComponent(
  store: &NumericStore,
  component: ColorComponent,
  space: Space,
  index: usize,
  generic: bool,
) -> f64
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  match &component {
    ColorComponent.None => {
      return 0.0
    }
    ColorComponent.Numeric { id } => {
      let numericType = store.typeOf(id)
      if index < 3 && !generic && angular(space, index) {
        if numericType.isNumber() {
          return (run store.to(id, b"number")).value
        }
        return (run store.to(id, b"deg")).value
      }
      if numericType.isPercent() {
        let value = run store.to(id, b"percent")
        return value.value
          * (if index == 3 {
            1.0
          } else {
            percentScale(space, index, generic)
          })
          / 100.0
      }
      let value = run store.to(id, b"number")
      return if space == Space.Srgb && !generic && index < 3 {
        value.value / 255.0
      } else {
        value.value
      }
    }
  }
}

fn missing(component: ColorComponent) -> bool {
  return match &component {
    ColorComponent.None => true
    _ => false
  }
}

effect fn resolve(store: &NumericStore, parts: Components, space: Space, generic: bool) -> Color
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  let mut result = Color {
    space: space,
    channels: [0.0; 3],
    alpha: 0.0,
    missing: 0,
    identity: Identity.Absolute,
  }
  let bits: [u8; 3] = [1, 2, 4]
  let mut i: usize = 0
  while i < 3 {
    result.channels[i] = run resolveComponent(store, parts.channels[i], space, i, generic)
    if missing(parts.channels[i]) {
      result.missing = result.missing | bits[i]
    }
    i = i + 1
  }
  result.alpha = run resolveComponent(store, parts.alpha, space, 3, generic)
  if missing(parts.alpha) {
    result.missing = result.missing | 8
  }
  return result
}

pub struct CSSRGB {
  parts: Components
}

impl Copy for CSSRGB {}

impl CSSRGB {
  pub effect fn make(
    store: &mut NumericStore,
    r: ColorInput,
    g: ColorInput,
    b: ColorInput,
    alpha: ColorInput,
  ) -> CSSRGB
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return CSSRGB {
      parts: run Components.make(&mut store.*, [r, g, b], [ComponentType.RGB; 3], alpha),
    }
  }

  pub effect fn opaque(
    store: &mut NumericStore,
    r: ColorInput,
    g: ColorInput,
    b: ColorInput,
  ) -> CSSRGB
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return run CSSRGB.make(&mut store.*, r, g, b, ColorInput.Number { value: 1.0 })
  }

  pub fn r(self: &CSSRGB) -> ColorComponent {
    return self.parts.channels[0]
  }

  pub fn g(self: &CSSRGB) -> ColorComponent {
    return self.parts.channels[1]
  }

  pub fn b(self: &CSSRGB) -> ColorComponent {
    return self.parts.channels[2]
  }

  pub fn alpha(self: &CSSRGB) -> ColorComponent {
    return self.parts.alpha
  }

  pub effect fn setR(self: &mut CSSRGB, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[0] = run rectify(&mut store.*, value, ComponentType.RGB)
  }

  pub effect fn setG(self: &mut CSSRGB, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[1] = run rectify(&mut store.*, value, ComponentType.RGB)
  }

  pub effect fn setB(self: &mut CSSRGB, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[2] = run rectify(&mut store.*, value, ComponentType.RGB)
  }

  pub effect fn setAlpha(self: &mut CSSRGB, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.alpha = run rectify(&mut store.*, value, ComponentType.Percent)
  }
}

