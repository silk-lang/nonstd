  pub effect fn opaque(
    store: &mut NumericStore,
    l: ColorInput,
    a: ColorInput,
    b: ColorInput,
  ) -> CSSOKLab
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return run CSSOKLab.make(&mut store.*, l, a, b, ColorInput.Number { value: 1.0 })
  }

  pub fn l(self: &CSSOKLab) -> ColorComponent {
    return self.parts.channels[0]
  }

  pub fn a(self: &CSSOKLab) -> ColorComponent {
    return self.parts.channels[1]
  }

  pub fn b(self: &CSSOKLab) -> ColorComponent {
    return self.parts.channels[2]
  }

  pub fn alpha(self: &CSSOKLab) -> ColorComponent {
    return self.parts.alpha
  }

  pub effect fn setL(self: &mut CSSOKLab, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[0] = run rectify(&mut store.*, value, ComponentType.Percent)
  }

  pub effect fn setA(self: &mut CSSOKLab, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[1] = run rectify(&mut store.*, value, ComponentType.Number)
  }

  pub effect fn setB(self: &mut CSSOKLab, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[2] = run rectify(&mut store.*, value, ComponentType.Number)
  }

  pub effect fn setAlpha(self: &mut CSSOKLab, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.alpha = run rectify(&mut store.*, value, ComponentType.Percent)
  }
}

pub struct CSSOKLCH {
  parts: Components
}

impl Copy for CSSOKLCH {}

impl CSSOKLCH {
  pub effect fn make(
    store: &mut NumericStore,
    l: ColorInput,
    c: ColorInput,
    h: ColorInput,
    alpha: ColorInput,
  ) -> CSSOKLCH
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return CSSOKLCH {
      parts: run Components.make(
        &mut store.*,
        [l, c, h],
        [ComponentType.Percent, ComponentType.Percent, ComponentType.Angle],
        alpha,
      ),
    }
  }

  pub effect fn opaque(
    store: &mut NumericStore,
    l: ColorInput,
    c: ColorInput,
    h: ColorInput,
  ) -> CSSOKLCH
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return run CSSOKLCH.make(&mut store.*, l, c, h, ColorInput.Number { value: 1.0 })
  }

  pub fn l(self: &CSSOKLCH) -> ColorComponent {
    return self.parts.channels[0]
  }

  pub fn c(self: &CSSOKLCH) -> ColorComponent {
    return self.parts.channels[1]
  }

  pub fn h(self: &CSSOKLCH) -> ColorComponent {
    return self.parts.channels[2]
  }

  pub fn alpha(self: &CSSOKLCH) -> ColorComponent {
    return self.parts.alpha
  }

  pub effect fn setL(self: &mut CSSOKLCH, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[0] = run rectify(&mut store.*, value, ComponentType.Percent)
  }

  pub effect fn setC(self: &mut CSSOKLCH, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[1] = run rectify(&mut store.*, value, ComponentType.Percent)
  }

  pub effect fn setH(self: &mut CSSOKLCH, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.channels[2] = run rectify(&mut store.*, value, ComponentType.Angle)
  }

  pub effect fn setAlpha(self: &mut CSSOKLCH, store: &mut NumericStore, value: ColorInput) -> ()
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    self.parts.alpha = run rectify(&mut store.*, value, ComponentType.Percent)
  }
}

effect fn genericParts(name: &[u8], parts: Components) -> CSSColorValue
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut values = List<ColorComponent>.make()
  let mut i: usize = 0
  while i < 3 {
    run values.append(parts.channels[i])
    i = i + 1
  }
  return CSSColorValue.Color {
    value: CSSColor { spaceName: run Bytes.copy(name), values: move values, opacity: parts.alpha },
  }
}

effect fn fromParts(space: Space, generic: bool, parts: Components) -> CSSColorValue
  ! OutOfMemoryError
  ? &mut Allocator {
  if generic {
    return run genericParts(spaceName(space), parts)
  }
  return match space {
    Space.Hsl => CSSColorValue.HSL { value: CSSHSL { parts: parts } }
    Space.Hwb => CSSColorValue.HWB { value: CSSHWB { parts: parts } }
    Space.Lab => CSSColorValue.Lab { value: CSSLab { parts: parts } }
    Space.Lch => CSSColorValue.LCH { value: CSSLCH { parts: parts } }
    Space.Oklab => CSSColorValue.OKLab { value: CSSOKLab { parts: parts } }
    Space.Oklch => CSSColorValue.OKLCH { value: CSSOKLCH { parts: parts } }
    _ => CSSColorValue.RGB { value: CSSRGB { parts: parts } }
  }
}

/// Reification from the package's resolved coordinates. Parsing below instead
/// reifies the token components, preserving their units and math identities.
pub effect fn reify(store: &mut NumericStore, color: Color, generic: bool) -> CSSColorValue
  ! CssomError | OutOfMemoryError
  ? &mut Allocator {
  match &color.identity {
    Identity.Absolute => {}
    _ => {
      fail CssomError.InvalidStateError
    }
  }
  let useGeneric = generic || (color.space != Space.Srgb && genericSpace(color.space))
  let mut parts = Components { channels: [ColorComponent.None; 3], alpha: ColorComponent.None }
  let bits: [u8; 3] = [1, 2, 4]
  let mut i: usize = 0
  while i < 3 {
    if (color.missing & bits[i]) == 0 {
      let mut amount = color.channels[i]
      let mut unit: &'static [u8] = b"percent"
      if !useGeneric && angular(color.space, i) {
        unit = b"deg"
      } else if !useGeneric && color.space == Space.Srgb {
        amount = amount * 255.0
        unit = b"number"
      } else if !useGeneric && (color.space == Space.Lab || color.space == Space.Oklab) && i != 0 {
        unit = b"number"
      } else {
        amount = amount * 100.0 / percentScale(color.space, i, useGeneric)
      }
      parts.channels[i] = ColorComponent.Numeric { id: run store.unit(amount, unit) }
    }
    i = i + 1
  }
  if (color.missing & 8) == 0 {
    parts.alpha = ColorComponent.Numeric { id: run store.unit(color.alpha * 100.0, b"percent") }
  }
  return run fromParts(color.space, useGeneric, parts)
}

effect fn parseComponent(
  store: &mut NumericStore,
  buffer: &TokenBuffer,
  cursor: &mut Cursor,
  limits: &Limits,
) -> ColorComponent
  ! CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let source = Input.Contiguous { buffer: buffer, range: buffer.all() }
  cursor.skip(&source)
  if cursor.position >= cursor.end {
    fail CssomError.SyntaxError
  }
  let token = buffer.tokens.asSlice()[cursor.position]
  cursor.position = cursor.position + 1
  match &token.kind {
    Kind.Ident { text } => {
      if insensitive(buffer.text(text), b"none") {
        return ColorComponent.None
      }
    }
    Kind.Number { value, integer } => {
      return ColorComponent.Numeric { id: run store.unit(value, b"number") }
    }
    Kind.Percentage { value, integer } => {
      return ColorComponent.Numeric { id: run store.unit(value, b"percent") }
    }
    Kind.Dimension { value, integer, unit } => {
      return ColorComponent.Numeric { id: run store.unit(value, buffer.text(unit)) }
    }
    Kind.Function { name } => {
      let end = if token.matching < cursor.end {
        buffer.tokens.asSlice()[token.matching].source.end
      } else {
        buffer.sourceLength
      }
      cursor.position = if token.matching < cursor.end {
        token.matching + 1
      } else {
        cursor.end
      }
      return ColorComponent.Numeric {
        id: run store.parse(buffer.text(Span { start: token.source.start, end: end }), limits),
      }
    }
    _ => {}
  }
  fail CssomError.SyntaxError
}

impl CSSColorValue {
  pub effect fn parse(store: &mut NumericStore, text: &[u8], limits: &Limits) -> ParsedColor
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let buffer = run lexer.tokenize(text, limits)
    let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    let mut cursor = Cursor.make(&source)
    let parsed = run colors.parse(&source, &mut cursor)
    if !cursor.done(&source) {
      fail CssomError.SyntaxError
    }
    let color = match &parsed {
      Option<Color>.Some { value } => value
      _ => {
        fail CssomError.SyntaxError
      }
    }
    cursor.position = 0
    cursor.skip(&source)
    let first = buffer.tokens.asSlice()[cursor.position]
    match &color.identity {
      Identity.Absolute => {}
      _ => {
        match &first.kind {
          Kind.Ident { text: name } => {
            return ParsedColor.Keyword { text: run Bytes.copy(buffer.text(name)) }
          }
          _ => {
            fail CssomError.SyntaxError
          }
        }
      }
    }
    let generic = match &first.kind {
      Kind.Function { name } => insensitive(buffer.text(name), b"color")
      _ => {
        return ParsedColor.Absolute { value: run reify(&mut store.*, color, false) }
      }
    }
    cursor.position = cursor.position + 1
    let mut genericName = Span { start: 0, end: 0 }
    if generic {
      cursor.skip(&source)
      match &buffer.tokens.asSlice()[cursor.position].kind {
        Kind.Ident { text: name } => {
          genericName = name
        }
        _ => {
          fail CssomError.SyntaxError
        }
      }
      cursor.position = cursor.position + 1
    }
    let mut parts = Components { channels: [ColorComponent.None; 3], alpha: ColorComponent.None }
    let mut i: usize = 0
    while i < 3 {
      parts.channels[i] = run parseComponent(&mut store.*, &buffer, &mut cursor, limits)
      if i < 2 {
        let comma = cursor.comma(&source)
      }
      i = i + 1
    }
    let alpha = cursor.comma(&source) || cursor.delim(&source, 47)
    parts.alpha = if alpha {
      run parseComponent(&mut store.*, &buffer, &mut cursor, limits)
    } else {
      ColorComponent.Numeric { id: run store.unit(100.0, b"percent") }
    }
    if generic {
      return ParsedColor.Absolute { value: run genericParts(buffer.text(genericName), parts) }
    }
    return ParsedColor.Absolute { value: run fromParts(color.space, generic, parts) }
  }

  pub effect fn serialize(self: &CSSColorValue, store: &NumericStore) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = Bytes.make()
    match &self.* {
      CSSColorValue.RGB { value } => {
        run appendFunction(&mut out, store, b"rgb", value.parts)
      }
      CSSColorValue.HSL { value } => {
        run appendFunction(&mut out, store, b"hsl", value.parts)
      }
      CSSColorValue.HWB { value } => {
        run appendFunction(&mut out, store, b"hwb", value.parts)
      }
      CSSColorValue.Lab { value } => {
        run appendFunction(&mut out, store, b"lab", value.parts)
      }
      CSSColorValue.LCH { value } => {
        run appendFunction(&mut out, store, b"lch", value.parts)
      }
      CSSColorValue.OKLab { value } => {
        run appendFunction(&mut out, store, b"oklab", value.parts)
      }
      CSSColorValue.OKLCH { value } => {
        run appendFunction(&mut out, store, b"oklch", value.parts)
      }
      CSSColorValue.Color { value } => {
        run Bytes.append(&mut out, b"color(")
        let name = run serialization.identifier(value.colorSpace())
        run Bytes.append(&mut out, Bytes.asSlice(&name))
        let mut i: usize = 0
        while i < value.channels().length {
          run Bytes.append(&mut out, b" ")
          run appendComponent(&mut out, store, value.channels()[i])
          i = i + 1
        }
        run Bytes.append(&mut out, b" / ")
        run appendComponent(&mut out, store, value.alpha())
        run Bytes.append(&mut out, b")")
      }
    }
    return move out
  }

  pub effect fn absolute(self: &CSSColorValue, store: &NumericStore) -> Color
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    return match &self.* {
      CSSColorValue.RGB { value } => run resolve(store, value.parts, Space.Srgb, false)
      CSSColorValue.HSL { value } => run resolve(store, value.parts, Space.Hsl, false)
      CSSColorValue.HWB { value } => run resolve(store, value.parts, Space.Hwb, false)
      CSSColorValue.Lab { value } => run resolve(store, value.parts, Space.Lab, false)
      CSSColorValue.LCH { value } => run resolve(store, value.parts, Space.Lch, false)
      CSSColorValue.OKLab { value } => run resolve(store, value.parts, Space.Oklab, false)
      CSSColorValue.OKLCH { value } => run resolve(store, value.parts, Space.Oklch, false)
      CSSColorValue.Color { value } => {
        let found = colorSpace(value.colorSpace())
        let space = match &found {
          Option<Space>.Some { value: known } => known
          _ => {
            fail CssomError.NotSupportedError
          }
        }
        if !genericSpace(space) {
          fail CssomError.NotSupportedError
        }
        if value.channels().length != 3 {
          fail CssomError.InvalidStateError
        }
        let parts = Components {
          channels: [value.channels()[0], value.channels()[1], value.channels()[2]],
          alpha: value.alpha(),
        }
        return run resolve(store, parts, space, true)
      }
    }
  }

  /// Native extension: all built-in Color 4 spaces, without display gamut mapping.
  pub effect fn to(self: &CSSColorValue, store: &mut NumericStore, space: Space) -> CSSColorValue
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let original = run self.absolute(&store.*)
    let converted = colors.convert(original, space)
    match &converted {
      Option<Color>.Some { value } => {
        return run reify(&mut store.*, value, false)
      }
      _ => {
        fail CssomError.InvalidStateError
      }
    }
  }
}

effect fn cloneComponent(
  target: &mut NumericStore,
  source: &NumericStore,
  component: ColorComponent,
) -> ColorComponent
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &component {
    ColorComponent.None => ColorComponent.None
    ColorComponent.Numeric { id } => ColorComponent.Numeric { id: run target.cloneFrom(source, id) }
  }
}

effect fn cloneParts(
  target: &mut NumericStore,
  source: &NumericStore,
  parts: Components,
) -> Components
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = parts
  let mut i: usize = 0
  while i < 3 {
    result.channels[i] = run cloneComponent(&mut target.*, source, parts.channels[i])
    i = i + 1
  }
  result.alpha = run cloneComponent(&mut target.*, source, parts.alpha)
  return result
}

impl CSSColorValue {
  pub effect fn cloneFrom(
    self: &CSSColorValue,
    target: &mut NumericStore,
    source: &NumericStore,
  ) -> CSSColorValue
    ! OutOfMemoryError
    ? &mut Allocator {
    return match &self.* {
      CSSColorValue.RGB { value } => CSSColorValue.RGB {
        value: CSSRGB { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.HSL { value } => CSSColorValue.HSL {
        value: CSSHSL { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.HWB { value } => CSSColorValue.HWB {
        value: CSSHWB { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.Lab { value } => CSSColorValue.Lab {
        value: CSSLab { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.LCH { value } => CSSColorValue.LCH {
        value: CSSLCH { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.OKLab { value } => CSSColorValue.OKLab {
        value: CSSOKLab { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.OKLCH { value } => CSSColorValue.OKLCH {
        value: CSSOKLCH { parts: run cloneParts(&mut target.*, source, value.parts) },
      }
      CSSColorValue.Color { value } => {
        let mut channels = List<ColorComponent>.make()
        let mut i: usize = 0
        while i < value.channels().length {
          run channels.append(run cloneComponent(&mut target.*, source, value.channels()[i]))
          i = i + 1
        }
        return CSSColorValue.Color {
          value: CSSColor {
            spaceName: run Bytes.copy(value.colorSpace()),
            values: move channels,
            opacity: run cloneComponent(&mut target.*, source, value.alpha()),
          },
        }
      }
    }
  }
}
