//! Pinned CSS Images 3 SHA256 74eb4b475aa0845a50ebedb4bbb3ba7bf3966f975817d1c5cf8e3d512f53447e.
import properties { Property }
import properties
import values { Store, Mode, ValueId }
import values
import input { Input }
import lexer
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String }

effect fn valid(text: &[u8]) -> bool ! CssError | OutOfMemoryError ? &mut Allocator {
  let property = match &properties.lookup(b"image-orientation") {
    Option<Property>.Some { value } => value
    _ => { return false }
  }
  let tokens = run lexer.tokenize(text, &Limits.make())
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let mut store = Store.make()
  return (run values.parse(&mut store, property, &input, Mode.Css)).isSome()
}

// https://www.w3.org/TR/css-images-3/#the-image-orientation
// https://www.w3.org/TR/css-cascade-4/#all-shorthand
test effect fn orientationCatalogAndGrammar() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let yes: [string; 10] = ["none", "from-image", "90deg", "-0.25turn", "flip", "flip 180deg", "450deg flip", "calc(1turn - 90deg)", "inherit", "unset"]
  let mut i: usize = 0
  while i < yes.length {
    let result = run valid(String.utf8Bytes(yes[i])) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(result, "valid image orientation value")
    i = i + 1
  }
  let no: [string; 9] = ["auto", "90", "90px", "25%", "none flip", "from-image 90deg", "90deg 180deg", "flip flip", "flip 90deg flip"]
  i = 0
  while i < no.length {
    let result = run valid(String.utf8Bytes(no[i])) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(!result, "orientation rejects invalid units and extra components")
    i = i + 1
  }
  let property = properties.lookup(b"image-orientation")
  let included = match &property {
    Option<Property>.Some { value } => {
      let mut found = false
      i = 0
      while i < properties.longhandCount(Property.All) {
        if properties.longhandAt(Property.All, i) == value { found = true }
        i = i + 1
      }
      found && properties.inherited(value)
    }
    _ => false
  }
  run Testing.expect(included, "inherited image orientation participates in all")
}
