//! KeyIndex: lookups, replacement, the 0/1 key merge, growth and clear.
import key_index { KeyIndex }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u64

fn found(index: &KeyIndex, key: u64) -> usize {
  return match &index.get(key) {
    Option<usize>.Some { value } => value
    _ => 999999
  }
}

test effect fn keyIndexMapsReplacesAndGrows() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut index = KeyIndex.make()
  run Testing.expect(index.get(7).isNone(), "an empty index finds nothing")
  let mut i: u64 = 0
  while i < 1000 {
    run index.insert(u64.wrappingMultiply(i, 1099511628211) + 2, u64.toUsize(i))
      |> Effect.provideMut<Allocator>(&mut allocator)
    i = i + 1
  }
  i = 0
  let mut all = true
  while i < 1000 {
    all = all && found(&index, u64.wrappingMultiply(i, 1099511628211) + 2) == u64.toUsize(i)
    i = i + 1
  }
  run Testing.expect(all, "every key survives growth")
  run Testing.expect(index.get(1).isNone(), "an absent key is not found")
  run index.insert(2, 5) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(found(&index, 2) == 5, "a repeated key takes the later value")
  run index.insert(0, 8) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(found(&index, 1) == 8, "keys 0 and 1 are one key")
  index.clear()
  run Testing.expect(index.get(2).isNone(), "clear forgets every key")
}
