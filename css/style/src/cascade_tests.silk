//! Cascade4 priority and origin rollback conformance.
import cascade { Origin, Priority, Target, Specified, Declaration, Candidate }
import cascade
import properties { Property }
import selectors { Specificity }
import values { Wide, Store }
import silk.core.option { Option }
import tokens { Limits, TokenBuffer, CssError }
import lexer
import syntax
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

// https://www.w3.org/TR/css-cascade-4/#cascade-sort
test effect fn originImportanceContextAndInline() -> ()
  ! AssertionError<'static> {
  let mut ua = Priority.make(Origin.UserAgent, 0)
  let mut user = Priority.make(Origin.User, 1)
  let mut author = Priority.make(Origin.Author, 2)
  let animation = Priority.make(Origin.Animation, 3)
  let transition = Priority.make(Origin.Transition, 4)
  run Testing.expect(
    cascade.compare(author, user) > 0 && cascade.compare(user, ua) > 0,
    "normal origin order",
  )
  run Testing.expect(cascade.compare(animation, author) > 0, "animation beats normal author")
  ua.important = true
  user.important = true
  author.important = true
  run Testing.expect(
    cascade.compare(ua, user) > 0 && cascade.compare(user, author) > 0,
    "important reverses origins",
  )
  run Testing.expect(
    cascade.compare(author, animation) > 0 && cascade.compare(transition, ua) > 0,
    "transition outranks important",
  )
  let mut inner = author
  inner.encapsulationDepth = 1
  run Testing.expect(cascade.compare(inner, author) > 0, "inner important wins")
  inner.important = false
  author.important = false
  run Testing.expect(cascade.compare(inner, author) < 0, "outer normal wins")
  inner.encapsulationDepth = 0
  inner.inline = true
  author.specificity = Specificity { ids: 100, classes: 100, types: 100 }
  run Testing.expect(cascade.compare(inner, author) > 0, "style attributes outrank every selector")
}

// https://www.w3.org/TR/css-cascade-4/#default
// https://www.w3.org/TR/css-cascade-4/#shorthand
test effect fn revertDiscardsOriginAndAnimationNotJustDeclaration() -> ()
  ! AssertionError<'static> {
  let catalog = [
    Declaration {
      target: Target.Property { property: Property.Fill },
      specified: Specified.Wide { keyword: Wide.Initial },
      buffer: 0,
      important: false,
    },
    Declaration {
      target: Target.Property { property: Property.Fill },
      specified: Specified.Wide { keyword: Wide.Inherit },
      buffer: 0,
      important: false,
    },
    Declaration {
      target: Target.Property { property: Property.All },
      specified: Specified.Wide { keyword: Wide.Revert },
      buffer: 0,
      important: true,
    },
    Declaration {
      target: Target.Property { property: Property.Fill },
      specified: Specified.Wide { keyword: Wide.Initial },
      buffer: 0,
      important: false,
    },
  ]
  let candidates = [
    Candidate { declaration: 0, priority: Priority.make(Origin.User, 0) },
    Candidate { declaration: 1, priority: Priority.make(Origin.Author, 1) },
    Candidate { declaration: 2, priority: Priority.make(Origin.Author, 2) },
    Candidate { declaration: 3, priority: Priority.make(Origin.Animation, 3) },
  ]
  let selected = cascade.select(&catalog, &candidates, Property.Fill, 0)
  let correct = match &selected {
    Option<Candidate>.Some { value } => value.declaration == 0
    _ => false
  }
  run Testing.expect(correct, "author revert removes author normal and animation")
  run Testing.expect(
    !cascade.covers(&catalog[2], Property.Direction)
      && !cascade.covers(&catalog[2], Property.UnicodeBidi),
    "all excludes direction and unicode-bidi",
  )
  let none = cascade.select(
    &catalog,
    &candidates,
    Property.Fill,
    cascade.revertMask(Origin.UserAgent),
  )
  run Testing.expect(
    match &none {
      Option<Candidate>.None => true
      _ => false
    },
    "UA revert defaults, never reveals higher origins",
  )
}

// https://www.w3.org/TR/css-cascade-4/#filtering
// https://www.w3.org/TR/css-variables-1/#using-variables
test effect fn compileRejectsInvalidDeclarationsBeforeTheyCanWin() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let buffer = run lexer.tokenize(
    b"fill:red;fill:var(--missing);fill:var(bad);unknown:initial;fill:red blue;--empty:;--:red;all:inherit",
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parsed = run syntax.parseDeclarations(&buffer, buffer.all(), &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let buffers = [move buffer]
  let mut store = Store.make()
  let mut accepted: usize = 0
  let mut pending: usize = 0
  let mut i: usize = 0
  while i < parsed.length() {
    let declaration = run cascade.compile(&mut store, &buffers, 0, &parsed.asSlice()[i], &limits)
      |> Effect.provideMut<Allocator>(&mut allocator)
    match &declaration {
      Option<Declaration>.Some { value } => {
        accepted = accepted + 1
        match &value.specified {
          Specified.Pending { range, mode } => {
            pending = pending + 1
          }
          _ => {}
        }
      }
      _ => {}
    }
    i = i + 1
  }
  run Testing.expect(
    accepted == 4 && pending == 2,
    "typed validity and shared var validation filter before cascade",
  )
}

// https://www.w3.org/TR/css-cascade-4/#cascade-specificity
// https://www.w3.org/TR/css-cascade-4/#cascade-order
// https://www.w3.org/TR/css-cascade-4/#shorthand
test effect fn shorthandAndLonghandCompeteByPriorityNotExpansionOrder() -> ()
  ! AssertionError<'static> {
  let declarations = [
    Declaration {
      target: Target.Property { property: Property.Marker },
      specified: Specified.Wide { keyword: Wide.Initial },
      buffer: 0,
      important: false,
    },
    Declaration {
      target: Target.Property { property: Property.MarkerStart },
      specified: Specified.Wide { keyword: Wide.Inherit },
      buffer: 0,
      important: false,
    },
  ]
  let mut shorthand = Priority.make(Origin.Author, 1)
  shorthand.specificity = Specificity { ids: 1, classes: 0, types: 0 }
  let longhand = Priority.make(Origin.Author, 2)
  let mut candidates = [
    Candidate { declaration: 0, priority: shorthand },
    Candidate { declaration: 1, priority: longhand },
  ]
  let specific = cascade.select(&declarations, &candidates, Property.MarkerStart, 0)
  run Testing.expect(
    match &specific {
      Option<Candidate>.Some { value } => value.declaration == 0
      _ => false
    },
    "more-specific shorthand wins its longhand",
  )
  candidates[0].priority.specificity = longhand.specificity
  let later = cascade.select(&declarations, &candidates, Property.MarkerStart, 0)
  run Testing.expect(
    match &later {
      Option<Candidate>.Some { value } => value.declaration == 1
      _ => false
    },
    "equal-specificity later longhand wins",
  )
  let untouched = cascade.select(&declarations, &candidates, Property.MarkerEnd, 0)
  run Testing.expect(
    match &untouched {
      Option<Candidate>.Some { value } => value.declaration == 0
      _ => false
    },
    "other shorthand longhands remain selected",
  )
}
