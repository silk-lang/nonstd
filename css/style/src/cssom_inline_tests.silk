import cssom_inline { InlineStyle }
import cssom_error { CssomError }
import tokens { Limits, CssError, equal }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn attribute(style: &InlineStyle, expected: &[u8]) -> bool {
  return match &style.attribute() {
    Option<&[u8]>.Some { value } => equal(value, expected)
    _ => false
  }
}

effect fn mutations() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = InlineStyle.make(19)
  run style.setAttribute(Option<&[u8]>.some(b" Opacity: .5 ; unknown: nonsense "), &limits)
  let serialized = run style.cssText()
  run Testing.expect(
    equal(Bytes.asSlice(&serialized), b"opacity: 0.5;")
      && attribute(&style, b" Opacity: .5 ; unknown: nonsense "),
    "reading parsed declarations does not rewrite the original style attribute",
  )
  run Testing.expect(
    !(run style.setProperty(b"opacity", b"invalid", b"", &limits))
      && attribute(&style, b" Opacity: .5 ; unknown: nonsense "),
    "invalid CSSOM writes do not fire attribute changes or discard original spelling",
  )
  run Testing.expect(
    !(run style.setProperty(b"opacity", b".5", b"", &limits)),
    "an equal value is not an attribute mutation",
  )
  run Testing.expect(
    (run style.setProperty(b"opacity", b".75", b"important", &limits))
      && attribute(&style, b"opacity: 0.75 !important;"),
    "effective CSSOM writes serialize the attribute and notify the host",
  )
  let removed = run style.removeProperty(b"opacity")
  run Testing.expect(
    equal(Bytes.asSlice(&removed), b"0.75") && attribute(&style, b""),
    "removing the last declaration leaves a present empty style attribute",
  )
  run style.setAttribute(Option<&'static [u8]>.None, &limits)
  run Testing.expect(
    match &style.attribute() {
      Option<&[u8]>.None => true
      _ => false
    }
      && style.style().length() == 0,
    "external removal clears the block and removes the attribute",
  )
  run style.setCssText(b"invalid", &limits)
  run Testing.expect(
    attribute(&style, b""),
    "cssText assignment creates an empty style attribute after invalid input",
  )
}

test effect fn inlineStyleSynchronizesOnlyEffectiveCssomMutations() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mutations() |> Effect.provideMut<Allocator>(&mut allocator)
}
