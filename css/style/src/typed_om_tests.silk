import typed_om { StyleValues, StyleValue, Value }
import typed_om_map { StylePropertyMap, StyleInput }
import typed_om_unparsed { UnparsedStore, UnparsedId, Segment, KeywordValue }
import cssom_inline { InlineStyle }
import cssom_error { CssomError }
import tokens { Limits, CssError, equal }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn unparsedIdentity() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut store = UnparsedStore.make()
  let fallback = run store.text(b"1px")
  let reference = run store.variable(b"--gap", Option<UnparsedId>.some(fallback))
  let mut segments = List<Segment>.make()
  run segments.append(Segment.Variable { id: reference })
  let value = run store.create(move segments)
  run store.set(fallback, 0, Segment.Text { text: run Bytes.copy(b"2px") })
  let text = run store.serialize(value)
  run Testing.expect(
    equal(Bytes.asSlice(&text), b"var(--gap, 2px)"),
    "shared fallback mutations remain visible through variable references",
  )
  let invalid = run store.setVariable(reference, b"gap") |> Effect.result
  run Testing.expect(
    match &invalid {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => true
      _ => false
    },
    "invalid variable setters fail",
  )
  run Testing.expect(
    equal(store.variableName(reference), b"--gap"),
    "failed variable setters preserve identity and name",
  )
  let parsed = run store.parse(
    b"calc(42px + var(--a, 15em) + var(--b, var(--c) + 15px))",
    &Limits.make(),
  )
  run Testing.expect(
    store.length(parsed) == 5,
    "nested var references split maximal text runs without flattening fallback objects",
  )
  run store.set(fallback, 0, Segment.Variable { id: reference })
  let cycle = run store.serialize(value) |> Effect.result
  run Testing.expect(
    match &cycle {
      Result<Bytes, CssomError | OutOfMemoryError>.Failure { error } => true
      _ => false
    },
    "cyclic indexed values fail without overflowing the native call stack",
  )
  let mut keyword = run KeywordValue.make(b"auto")
  let empty = run keyword.setValue(b"") |> Effect.result
  run Testing.expect(
    match &empty {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => equal(keyword.value(), b"auto")
      _ => false
    },
    "empty keyword mutation fails atomically",
  )
}

effect fn liveMaps() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let mut store = StyleValues.make()
  let mut inline = InlineStyle.make(4)
  run inline.setCssText(b"width:10px!important;animation-duration:1s,2s", &limits)
  let mut map = StylePropertyMap.forInline(&mut inline)
  let percent = run store.numeric.unit(25.0, b"percent")
  let value = StyleValue.constructed(Value.Numeric { id: percent })
  run map.set(&mut store, b"WIDTH", &[StyleInput.Typed { value: &value }], &limits)
  run map.append(&mut store, b"animation-duration", &[StyleInput.Text { value: b"3s" }], &limits)
  let all = run map.getAll(&mut store, b"animation-duration", &limits)
  run Testing.expect(all.length() == 3, "append extends parallel animation iterations")
  let last = run all.asSlice()[2].serialize(&store)
  run Testing.expect(
    equal(Bytes.asSlice(&last), b"3s"),
    "list reification preserves the appended duration",
  )
  let zero = run store.numeric.unit(0.0, b"number")
  let invalid = StyleValue.constructed(Value.Numeric { id: zero })
  let rejected = run map.set(&mut store, b"width", &[StyleInput.Typed { value: &invalid }], &limits)
    |> Effect.result
  run Testing.expect(
    match &rejected {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => true
      _ => false
    },
    "typed unitless zero is not a length even though CSS text accepts zero",
  )
  let font = run store.parse(b"font-family", b"serif", &limits)
  let wrongProperty = run map.set(
    &mut store,
    b"fill",
    &[StyleInput.Typed { value: &font }],
    &limits,
  )
    |> Effect.result
  run Testing.expect(
    match &wrongProperty {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => true
      _ => false
    },
    "direct values remain bound to their associated property",
  )
  let variable = run store.parse(b"animation-duration", b"var(--times)", &limits)
  run map.set(&mut store, b"animation-duration", &[StyleInput.Typed { value: &variable }], &limits)
  let appendVariable = run map.append(
    &mut store,
    b"animation-duration",
    &[StyleInput.Text { value: b"4s" }],
    &limits,
  )
    |> Effect.result
  run Testing.expect(
    match &appendVariable {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => true
      _ => false
    },
    "unresolved list boundaries prohibit appending to variable-backed values",
  )
  drop map
  let width = run inline.style().getPropertyValue(b"width")
  run Testing.expect(
    equal(Bytes.asSlice(&width), b"25%")
      && inline.style().getPropertyPriority(b"width").length == 0,
    "typed mutation updates the original declaration and clears important priority",
  )
  let expected = run inline.cssText()
  run Testing.expect(
    match &inline.attribute() {
      Option<&[u8]>.Some { value: attribute } => equal(attribute, Bytes.asSlice(&expected))
      _ => false
    },
    "typed mutation synchronizes the actual style attribute",
  )
  let parsed = run store.parse(b"width", b"42.0px", &limits)
  let serialized = run parsed.serialize(&store)
  run Testing.expect(
    equal(Bytes.asSlice(&serialized), b"42.0px"),
    "parse-origin values retain their specified stringification",
  )
}

test effect fn typedUnparsedValuesPreserveSharedMutationAndRejectCycles() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unparsedIdentity() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn typedMapsShareDeclarationsAndEnforceValueGrammar() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run liveMaps() |> Effect.provideMut<Allocator>(&mut allocator)
}
