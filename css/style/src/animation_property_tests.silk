//! The animation properties keep their source text for the SVG sampler to interpret.
import properties { Property }
import properties
import values { Store, Mode, Value }
import values
import input { Input }
import lexer
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut k: usize = 0
  while k < left.length {
    if left[k] != right[k] {
      return false
    }
    k = k + 1
  }
  return true
}

effect fn raw(name: &[u8], text: &[u8], expected: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let property = match &properties.lookup(name) {
    Option<Property>.Some { value } => value
    _ => {
      return false
    }
  }
  let tokens = run lexer.tokenize(text, &Limits.make())
  let input = Input.Contiguous { buffer: &tokens, range: tokens.all() }
  let mut store = Store.make()
  let parsed = run values.parse(&mut store, property, &input, Mode.Css)
  return match &parsed {
    Option<values.ValueId>.Some { value } => match &store.get(value).* {
      Value.Raw { text: span } => same(
        Slice.view<u8>(Bytes.asSlice(&store.strings), span.start, span.end - span.start),
        expected,
      )
      Value.Wide { keyword } => expected.length == 0
      _ => false
    }
    _ => false
  }
}

// https://www.w3.org/TR/css-animations-1/#animation
// https://www.w3.org/TR/css-cascade-4/#all-shorthand
test effect fn animationPropertiesKeepText() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run raw(b"animation", b"  spin 2s  linear infinite ", b"spin 2s  linear infinite")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "the animation shorthand keeps its trimmed text",
  )
  run Testing.expect(
    run raw(b"Animation-Name", b"a, b", b"a, b") |> Effect.provideMut<Allocator>(&mut allocator),
    "names are case-insensitive and lists are kept",
  )
  run Testing.expect(
    run raw(
      b"animation-timing-function",
      b"cubic-bezier(0.1, 0, 0.2, 1)",
      b"cubic-bezier(0.1, 0, 0.2, 1)",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "functions are kept verbatim",
  )
  run Testing.expect(
    run raw(b"animation-delay", b"inherit", b"") |> Effect.provideMut<Allocator>(&mut allocator),
    "CSS-wide keywords stay wide",
  )
  let mut covered: usize = 0
  let mut k: usize = 0
  while k < properties.longhandCount(Property.All) {
    if values.animationProperty(properties.longhandAt(Property.All, k)) {
      covered = covered + 1
    }
    k = k + 1
  }
  run Testing.expect(covered == 9, "all resets every animation property")
  run Testing.expect(
    !properties.inherited(Property.AnimationName),
    "animation properties are not inherited",
  )
}
