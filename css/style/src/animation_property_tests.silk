//! CSS Animations grammar and shorthand expansion used by cascade and CSSOM.
import properties { Property }
import values { Store, Mode, Value, ValueId }
import values
import input { Input }
import lexer
import tokens { Limits, CssError, equal }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn grammar() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let buffer = run lexer.tokenize(b"spin 2s linear infinite, fade 1s -0.5s both", &limits)
  let mut store = Store.make()
  let parsed = run values.parse(
    &mut store,
    Property.Animation,
    &Input.Contiguous { buffer: &buffer, range: buffer.all() },
    Mode.Css,
  )
  let expanded = match &parsed {
    Option<ValueId>.Some { value } => match &store.get(value).* {
      Value.Animation { longhands } => equal(store.text(longhands[0]), b"spin, fade")
        && equal(store.text(longhands[1]), b"2s, 1s")
        && equal(store.text(longhands[3]), b"0s, -0.5s")
        && equal(store.text(longhands[4]), b"infinite, 1")
        && equal(store.text(longhands[6]), b"none, both")
      _ => false
    }
    _ => false
  }
  run Testing.expect(expanded, "each comma arm expands and resets omitted longhands independently")
  let invalid = [b"spin -1s", b"spin 1s 2s 3s", b"spin 1s,", b"spin wobble", b"spin 1s steps(0)"]
  let mut i: usize = 0
  while i < invalid.length {
    let input = run lexer.tokenize(invalid[i], &limits)
    let parsedInvalid = run values.parse(
      &mut store,
      Property.Animation,
      &Input.Contiguous { buffer: &input, range: input.all() },
      Mode.Css,
    )
    run Testing.expect(
      match &parsedInvalid {
        Option<ValueId>.None => true
        _ => false
      },
      "invalid animation grammar cannot enter the cascade",
    )
    i = i + 1
  }
}

test effect fn animationGrammarAndIndependentListExpansion() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run grammar() |> Effect.provideMut<Allocator>(&mut allocator)
}
