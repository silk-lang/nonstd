//! CSS Fonts unicode-range descriptor parsing and canonical interval serialization.
import tokens { TokenBuffer, TokenRange, Kind }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32

fn hex(byte: u8) -> u32 {
  if byte >= 48 && byte <= 57 {
    return u8.toU32(byte) - 48
  }
  if byte >= 65 && byte <= 70 {
    return u8.toU32(byte) - 55
  }
  if byte >= 97 && byte <= 102 {
    return u8.toU32(byte) - 87
  }
  return 16
}

effect fn appendHex(out: &mut Bytes, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digits = b"0123456789ABCDEF"
  let mut number = value
  let mut buffer: [u8; 6] = [0; 6]
  let mut at: usize = 6
  while true {
    at = at - 1
    buffer[at] = digits[u32.toUsize(number % 16)]
    number = number / 16
    if number == 0 {
      break
    }
  }
  run Bytes.append(&mut out.*, Slice.view<u8>(&buffer, at, 6 - at))
}

effect fn interval(out: &mut Bytes, text: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if text.length < 3 || (text[0] != 85 && text[0] != 117) || text[1] != 43 {
    return false
  }
  let mut low: u32 = 0
  let mut high: u32 = 0
  let mut at: usize = 2
  let mut digits: usize = 0
  let mut wildcard = false
  while at < text.length && text[at] != 45 && digits < 6 {
    if text[at] == 63 {
      wildcard = true
      low = low * 16
      high = high * 16 + 15
    } else {
      let digit = hex(text[at])
      if wildcard || digit == 16 {
        return false
      }
      low = low * 16 + digit
      high = high * 16 + digit
    }
    at = at + 1
    digits = digits + 1
  }
  if digits == 0 {
    return false
  }
  if at < text.length && text[at] == 45 {
    if wildcard {
      return false
    }
    at = at + 1
    high = 0
    digits = 0
    while at < text.length && digits < 6 {
      let digit = hex(text[at])
      if digit == 16 {
        return false
      }
      high = high * 16 + digit
      at = at + 1
      digits = digits + 1
    }
    if digits == 0 {
      return false
    }
  }
  if at != text.length || high > 0x10ffff || low > high {
    return false
  }
  if Bytes.length(&out.*) != 0 {
    run Bytes.append(&mut out.*, b", ")
  }
  run Bytes.append(&mut out.*, b"U+")
  run appendHex(&mut out.*, low)
  if high != low {
    run Bytes.append(&mut out.*, b"-")
    run appendHex(&mut out.*, high)
  }
  return true
}

pub effect fn parse(buffer: &TokenBuffer, range: TokenRange) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at = range.start
  while at < range.end {
    while at < range.end
      && match &buffer.tokens.asSlice()[at].kind {
        Kind.Whitespace => true
        _ => false
      } {
      at = at + 1
    }
    let start = at
    while at < range.end
      && !match &buffer.tokens.asSlice()[at].kind {
        Kind.Comma => true
        _ => false
      } {
      at = at + 1
    }
    let mut end = at
    while end > start
      && match &buffer.tokens.asSlice()[end - 1].kind {
        Kind.Whitespace => true
        _ => false
      } {
      end = end - 1
    }
    if end == start {
      return Option<Bytes>.None
    }
    let first = buffer.tokens.asSlice()[start].source.start
    let last = buffer.tokens.asSlice()[end - 1].source.end
    if !(run interval(&mut out, Slice.view<u8>(buffer.source(), first, last - first))) {
      return Option<Bytes>.None
    }
    if at < range.end {
      at = at + 1
      if at == range.end {
        return Option<Bytes>.None
      }
    }
  }
  if Bytes.length(&out) == 0 {
    return Option<Bytes>.None
  }
  return Option<Bytes>.some(move out)
}
