//! Native Geometry Interfaces values. Read-only objects are shared borrows of these
//! value types; copying preserves every coordinate and the matrix dimensional flag.
//! https://drafts.fxtf.org/geometry/ §§2–7. Optional WebIDL arguments are represented
//! by explicit native defaults or the scaleOptional/rotateOptional adapters.
import svg_geometry.transforms { Matrix }
import svg_geometry.transforms as transforms
import svg_geometry.math
import cssom_error { CssomError }
import cssom_geometry_serialization as syntax
import cssom_geometry_parse
import tokens { Limits, CssError }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.f32

pub struct DOMPoint {
  pub x: f64,
  pub y: f64,
  pub z: f64,
  pub w: f64,
}

impl Copy for DOMPoint {}

impl DOMPoint {
  pub fn make(x: f64, y: f64, z: f64, w: f64) -> Self {
    return Self { x: x, y: y, z: z, w: w }
  }

  pub fn origin() -> Self {
    return DOMPoint.make(0.0, 0.0, 0.0, 1.0)
  }

  pub fn fromPoint(other: Self) -> Self {
    return other
  }

  pub fn toJSON(self: &Self) -> Self {
    return self.*
  }

  pub fn matrixTransform(self: &Self, matrix: DOMMatrix) -> Self {
    return matrix.transformPoint(self.*)
  }
}

// Geometry's NaN-safe extrema propagate NaN rather than silently dropping it.
fn minimum(a: f64, b: f64) -> f64 {
  if a != a || b != b {
    return f64.NAN
  }
  return f64.min(a, b)
}

fn maximum(a: f64, b: f64) -> f64 {
  if a != a || b != b {
    return f64.NAN
  }
  return f64.max(a, b)
}

pub struct DOMRect {
  pub x: f64,
  pub y: f64,
  pub width: f64,
  pub height: f64,
}

impl Copy for DOMRect {}

impl DOMRect {
  pub fn make(x: f64, y: f64, width: f64, height: f64) -> Self {
    return Self { x: x, y: y, width: width, height: height }
  }

  pub fn zero() -> Self {
    return DOMRect.make(0.0, 0.0, 0.0, 0.0)
  }

  pub fn fromRect(other: Self) -> Self {
    return other
  }

  pub fn left(self: &Self) -> f64 {
    return minimum(self.x, self.x + self.width)
  }

  pub fn right(self: &Self) -> f64 {
    return maximum(self.x, self.x + self.width)
  }

  pub fn top(self: &Self) -> f64 {
    return minimum(self.y, self.y + self.height)
  }

  pub fn bottom(self: &Self) -> f64 {
    return maximum(self.y, self.y + self.height)
  }

  pub fn toJSON(self: &Self) -> DOMRectJSON {
    return DOMRectJSON {
      x: self.x,
      y: self.y,
      width: self.width,
      height: self.height,
      top: self.top(),
      right: self.right(),
      bottom: self.bottom(),
      left: self.left(),
    }
  }
}

pub struct DOMRectList {
  values: List<DOMRect>
}

impl DOMRectList {
  pub effect fn make(values: &[DOMRect]) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = List<DOMRect>.make()
    run result.appendSlice(values)
    return Self { values: move result }
  }

  pub fn length(self: &Self) -> usize {
    return self.values.length()
  }

  pub fn item(self: &Self, index: usize) -> Option<DOMRect> {
    if index >= self.values.length() {
      return Option<DOMRect>.None
    }
    return Option<DOMRect>.some(self.values.asSlice()[index])
  }

  pub fn asSlice(self: &Self) -> &[DOMRect] {
    return self.values.asSlice()
  }
}

pub struct DOMQuad {
  pub p1: DOMPoint,
  pub p2: DOMPoint,
  pub p3: DOMPoint,
  pub p4: DOMPoint,
}

impl Copy for DOMQuad {}

impl DOMQuad {
  pub fn make(p1: DOMPoint, p2: DOMPoint, p3: DOMPoint, p4: DOMPoint) -> Self {
    return Self { p1: p1, p2: p2, p3: p3, p4: p4 }
  }

  pub fn fromQuad(other: Self) -> Self {
    return other
  }

  pub fn toJSON(self: &Self) -> Self {
    return self.*
  }

  pub fn fromRect(rect: DOMRect) -> Self {
    return DOMQuad.make(
      DOMPoint.make(rect.x, rect.y, 0.0, 1.0),
      DOMPoint.make(rect.x + rect.width, rect.y, 0.0, 1.0),
      DOMPoint.make(rect.x + rect.width, rect.y + rect.height, 0.0, 1.0),
      DOMPoint.make(rect.x, rect.y + rect.height, 0.0, 1.0),
    )
  }

  pub fn bounds(self: &Self) -> DOMRect {
    let left = minimum(minimum(self.p1.x, self.p2.x), minimum(self.p3.x, self.p4.x))
    let top = minimum(minimum(self.p1.y, self.p2.y), minimum(self.p3.y, self.p4.y))
    let right = maximum(maximum(self.p1.x, self.p2.x), maximum(self.p3.x, self.p4.x))
    let bottom = maximum(maximum(self.p1.y, self.p2.y), maximum(self.p3.y, self.p4.y))
    return DOMRect.make(left, top, right - left, bottom - top)
  }

  pub fn getBounds(self: &Self) -> DOMRect {
    return self.bounds()
  }

  pub fn matrixTransform(self: &Self, matrix: DOMMatrix) -> Self {
    return DOMQuad.make(
      matrix.transformPoint(self.p1),
      matrix.transformPoint(self.p2),
      matrix.transformPoint(self.p3),
      matrix.transformPoint(self.p4),
    )
  }
}

pub struct DOMMatrix {
  pub matrix: Matrix,
  pub is2D: bool,
}

impl Copy for DOMMatrix {}

fn twoDimensional(values: &[f64; 16]) -> bool {
  return values[2] == 0.0 && values[3] == 0.0 && values[6] == 0.0 && values[7] == 0.0
    && values[8] == 0.0
    && values[9] == 0.0
    && values[10] == 1.0
    && values[11] == 0.0
    && values[14] == 0.0
    && values[15] == 1.0
}

// Optional alias fields implement DOMMatrixInit's SameValueZero validation.
pub struct DOMMatrixInit {
  pub elements: [Option<f64>; 16],
  pub aliases: [Option<f64>; 6],
  pub is2D: Option<bool>,
}

impl DOMMatrixInit {
  pub fn make() -> Self {
    return Self {
      elements: [Option<f64>.None; 16],
      aliases: [Option<f64>.None; 6],
      is2D: Option<bool>.None,
    }
  }
}

impl DOMMatrix {
  fn setElement(self: &mut Self, index: usize, value: f64) -> () {
    let mut elements = self.toFloat64Array()
    elements[index] = value
    self.matrix = transforms.fromColumnMajor(&elements)
    self.is2D = self.is2D && twoDimensional(&elements)
  }

  pub fn m11(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[0]
  }

  pub fn setM11(self: &mut Self, value: f64) -> () {
    self.setElement(0, value)
  }

  pub fn m12(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[4]
  }

  pub fn setM12(self: &mut Self, value: f64) -> () {
    self.setElement(1, value)
  }

  pub fn m13(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[8]
  }

  pub fn setM13(self: &mut Self, value: f64) -> () {
    self.setElement(2, value)
  }

  pub fn m14(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[12]
  }

  pub fn setM14(self: &mut Self, value: f64) -> () {
    self.setElement(3, value)
  }

  pub fn m21(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[1]
  }

  pub fn setM21(self: &mut Self, value: f64) -> () {
    self.setElement(4, value)
  }

  pub fn m22(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[5]
  }

  pub fn setM22(self: &mut Self, value: f64) -> () {
    self.setElement(5, value)
  }

  pub fn m23(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[9]
  }

  pub fn setM23(self: &mut Self, value: f64) -> () {
    self.setElement(6, value)
  }

  pub fn m24(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[13]
  }

  pub fn setM24(self: &mut Self, value: f64) -> () {
    self.setElement(7, value)
  }

  pub fn m31(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[2]
  }

  pub fn setM31(self: &mut Self, value: f64) -> () {
    self.setElement(8, value)
  }

  pub fn m32(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[6]
  }

  pub fn setM32(self: &mut Self, value: f64) -> () {
    self.setElement(9, value)
  }

  pub fn m33(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[10]
  }

  pub fn setM33(self: &mut Self, value: f64) -> () {
    self.setElement(10, value)
  }

  pub fn m34(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[14]
  }

  pub fn setM34(self: &mut Self, value: f64) -> () {
    self.setElement(11, value)
  }

  pub fn m41(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[3]
  }

  pub fn setM41(self: &mut Self, value: f64) -> () {
    self.setElement(12, value)
  }

  pub fn m42(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[7]
  }

  pub fn setM42(self: &mut Self, value: f64) -> () {
    self.setElement(13, value)
  }

  pub fn m43(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[11]
  }

  pub fn setM43(self: &mut Self, value: f64) -> () {
    self.setElement(14, value)
  }

  pub fn m44(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[15]
  }

  pub fn setM44(self: &mut Self, value: f64) -> () {
    self.setElement(15, value)
  }

  pub fn a(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[0]
  }

  pub fn setA(self: &mut Self, value: f64) -> () {
    self.setElement(0, value)
  }

  pub fn b(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[4]
  }

  pub fn setB(self: &mut Self, value: f64) -> () {
    self.setElement(1, value)
  }

  pub fn c(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[1]
  }

  pub fn setC(self: &mut Self, value: f64) -> () {
    self.setElement(4, value)
  }

  pub fn d(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[5]
  }

  pub fn setD(self: &mut Self, value: f64) -> () {
    self.setElement(5, value)
  }

  pub fn e(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[3]
  }

  pub fn setE(self: &mut Self, value: f64) -> () {
    self.setElement(12, value)
  }

  pub fn f(self: &Self) -> f64 {
    return transforms.coefficients(&self.matrix)[7]
  }

  pub fn setF(self: &mut Self, value: f64) -> () {
    self.setElement(13, value)
  }

  pub fn toJSON(self: &Self) -> DOMMatrixJSON {
    return DOMMatrixJSON {
      m11: self.m11(),
      m12: self.m12(),
      m13: self.m13(),
      m14: self.m14(),
      m21: self.m21(),
      m22: self.m22(),
      m23: self.m23(),
      m24: self.m24(),
      m31: self.m31(),
      m32: self.m32(),
      m33: self.m33(),
      m34: self.m34(),
      m41: self.m41(),
      m42: self.m42(),
      m43: self.m43(),
      m44: self.m44(),
      a: self.a(),
      b: self.b(),
      c: self.c(),
      d: self.d(),
      e: self.e(),
      f: self.f(),
      is2D: self.is2D,
      isIdentity: self.isIdentity(),
    }
  }

  pub fn structuredSerialize(self: &Self) -> DOMMatrixState {
    return DOMMatrixState { elements: self.toFloat64Array(), is2D: self.is2D }
  }

  pub fn structuredDeserialize(state: DOMMatrixState) -> Self {
    return DOMMatrix.fromMatrix(transforms.fromColumnMajor(&state.elements), state.is2D)
  }

  pub fn scaleOptional(
    self: &Self,
    x: f64,
    y: Option<f64>,
    z: f64,
    ox: f64,
    oy: f64,
    oz: f64,
  ) -> Self {
    let sy = match &y {
      Option<f64>.Some { value } => value
      _ => x
    }
    return self.scale(x, sy, z, ox, oy, oz)
  }

  pub fn scaleOptionalSelf(
    self: &mut Self,
    x: f64,
    y: Option<f64>,
    z: f64,
    ox: f64,
    oy: f64,
    oz: f64,
  ) -> () {
    self.* = self.scaleOptional(x, y, z, ox, oy, oz)
  }

  pub fn rotateOptional(self: &Self, x: f64, y: Option<f64>, z: Option<f64>) -> Self {
    if y.isNone() && z.isNone() {
      return self.rotate(0.0, 0.0, x)
    }
    let ry = match &y {
      Option<f64>.Some { value } => value
      _ => 0.0
    }
    let rz = match &z {
      Option<f64>.Some { value } => value
      _ => 0.0
    }
    return self.rotate(x, ry, rz)
  }

  pub fn rotateOptionalSelf(self: &mut Self, x: f64, y: Option<f64>, z: Option<f64>) -> () {
    self.* = self.rotateOptional(x, y, z)
  }

  pub fn identity() -> Self {
    return Self { matrix: transforms.identity(), is2D: true }
  }

  pub fn fromMatrix(matrix: Matrix, is2D: bool) -> Self {
    return Self { matrix: matrix, is2D: is2D }
  }

  pub effect fn fromSequence(values: &[f64]) -> Self
    ! CssomError {
    if values.length != 6 && values.length != 16 {
      fail CssomError.TypeError
    }
    let mut result = [0.0; 16]
    result[0] = 1.0
    result[5] = 1.0
    result[10] = 1.0
    result[15] = 1.0
    let indices: [usize; 6] = [0, 1, 4, 5, 12, 13]
    let mut i: usize = 0
    while i < values.length {
      let index = if values.length == 6 {
        indices[i]
      } else {
        i
      }
      result[index] = values[i]
      i = i + 1
    }
    return DOMMatrix.fromMatrix(transforms.fromColumnMajor(&result), values.length == 6)
  }

  pub effect fn fromInit(init: &DOMMatrixInit) -> Self
    ! CssomError {
    let mut values = DOMMatrix.identity().toFloat64Array()
    let mut i: usize = 0
    while i < 16 {
      match &init.elements[i] {
        Option<f64>.Some { value } => {
          values[i] = value
        }
        _ => {}
      }
      i = i + 1
    }
    let indices: [usize; 6] = [0, 1, 4, 5, 12, 13]
    i = 0
    while i < 6 {
      match &init.aliases[i] {
        Option<f64>.Some { value } => {
          let index = indices[i]
          match &init.elements[index] {
            Option<f64>.Some { value: element } => {
              if value != element && !(value != value && element != element) {
                fail CssomError.TypeError
              }
            }
            _ => {
              values[index] = value
            }
          }
        }
        _ => {}
      }
      i = i + 1
    }
    let compatible = twoDimensional(&values)
    let twoD = match &init.is2D {
      Option<bool>.Some { value } => value
      _ => compatible
    }
    if twoD && !compatible {
      fail CssomError.TypeError
    }
    return DOMMatrix.fromMatrix(transforms.fromColumnMajor(&values), twoD)
  }

  pub effect fn fromFloat64Array(values: &[f64]) -> Self
    ! CssomError {
    return run DOMMatrix.fromSequence(values)
  }

  pub effect fn fromFloat32Array(values: &[f32]) -> Self
    ! CssomError {
    if values.length != 6 && values.length != 16 {
      fail CssomError.TypeError
    }
    let mut converted = [0.0; 16]
    let mut i: usize = 0
    while i < values.length {
      converted[i] = f32.toF64(values[i])
      i = i + 1
    }
    if values.length == 6 {
      return run DOMMatrix.fromSequence(
        &[converted[0], converted[1], converted[2], converted[3], converted[4], converted[5]],
      )
    }
    return run DOMMatrix.fromSequence(&converted)
  }

  pub fn toFloat64Array(self: &Self) -> [f64; 16] {
    let source = transforms.coefficients(&self.matrix)
    let mut result = [0.0; 16]
    let mut i: usize = 0
    while i < 16 {
      result[i] = source[(i % 4) * 4 + i / 4]
      i = i + 1
    }
    return result
  }

  pub fn toFloat32Array(self: &Self) -> [f32; 16] {
    let source = self.toFloat64Array()
    let mut result: [f32; 16] = [0.0; 16]
    let mut i: usize = 0
    while i < 16 {
      result[i] = f64.toF32(source[i])
      i = i + 1
    }
    return result
  }

  // Column-major element index, 0..15, exposes m11 through m44 without a second matrix representation.
  pub effect fn get(self: &Self, index: usize) -> f64
    ! CssomError {
    if index >= 16 {
      fail CssomError.IndexSizeError
    }
    return transforms.coefficients(&self.matrix)[(index % 4) * 4 + index / 4]
  }

  pub effect fn set(self: &mut Self, index: usize, value: f64) -> ()
    ! CssomError {
    if index >= 16 {
      fail CssomError.IndexSizeError
    }
    self.setElement(index, value)
  }

  pub fn isIdentity(self: &Self) -> bool {
    let values = self.toFloat64Array()
    let mut i: usize = 0
    while i < 16 {
      if values[i]
        != (if i % 5 == 0 {
          1.0
        } else {
          0.0
        }) {
        return false
      }
      i = i + 1
    }
    return true
  }

  pub fn transformPoint(self: &Self, point: DOMPoint) -> DOMPoint {
    let m = transforms.coefficients(&self.matrix)
    if self.is2D && point.z == 0.0 && point.w == 1.0 {
      return DOMPoint.make(
        m[0] * point.x + m[1] * point.y + m[3],
        m[4] * point.x + m[5] * point.y + m[7],
        0.0,
        1.0,
      )
    }
    return DOMPoint.make(
      m[0] * point.x + m[1] * point.y + m[2] * point.z + m[3] * point.w,
      m[4] * point.x + m[5] * point.y + m[6] * point.z + m[7] * point.w,
      m[8] * point.x + m[9] * point.y + m[10] * point.z + m[11] * point.w,
      m[12] * point.x + m[13] * point.y + m[14] * point.z + m[15] * point.w,
    )
  }

  pub fn multiply(self: &Self, other: Self) -> Self {
    return DOMMatrix.fromMatrix(
      transforms.multiply(&self.matrix, &other.matrix),
      self.is2D && other.is2D,
    )
  }

  pub fn multiplySelf(self: &mut Self, other: Self) -> () {
    self.* = self.multiply(other)
  }

  pub fn preMultiplySelf(self: &mut Self, other: Self) -> () {
    self.* = other.multiply(self.*)
  }

  pub fn translate(self: &Self, x: f64, y: f64, z: f64) -> Self {
    return self.multiply(DOMMatrix.fromMatrix(transforms.translation(x, y, z), z == 0.0))
  }

  pub fn translateSelf(self: &mut Self, x: f64, y: f64, z: f64) -> () {
    self.* = self.translate(x, y, z)
  }

  pub fn scale(self: &Self, x: f64, y: f64, z: f64, ox: f64, oy: f64, oz: f64) -> Self {
    let translated = self.translate(ox, oy, oz)
    let scaled = translated.multiply(DOMMatrix.fromMatrix(transforms.scale(x, y, z), z == 1.0))
    return scaled.translate(-ox, -oy, -oz)
  }

  pub fn scaleSelf(self: &mut Self, x: f64, y: f64, z: f64, ox: f64, oy: f64, oz: f64) -> () {
    self.* = self.scale(x, y, z, ox, oy, oz)
  }

  pub fn scaleNonUniform(self: &Self, x: f64, y: f64) -> Self {
    return self.scale(x, y, 1.0, 0.0, 0.0, 0.0)
  }

  pub fn scale3d(self: &Self, value: f64, ox: f64, oy: f64, oz: f64) -> Self {
    return self.scale(value, value, value, ox, oy, oz)
  }

  pub fn scale3dSelf(self: &mut Self, value: f64, ox: f64, oy: f64, oz: f64) -> () {
    self.* = self.scale3d(value, ox, oy, oz)
  }

  pub fn rotateAxisAngle(self: &Self, x: f64, y: f64, z: f64, angle: f64) -> Self {
    return self.multiply(
      DOMMatrix.fromMatrix(transforms.rotation(x, y, z, math.radians(angle)), x == 0.0 && y == 0.0),
    )
  }

  pub fn rotateAxisAngleSelf(self: &mut Self, x: f64, y: f64, z: f64, angle: f64) -> () {
    self.* = self.rotateAxisAngle(x, y, z, angle)
  }

  pub fn rotate(self: &Self, x: f64, y: f64, z: f64) -> Self {
    let rz = self.rotateAxisAngle(0.0, 0.0, 1.0, z)
    let ry = rz.rotateAxisAngle(0.0, 1.0, 0.0, y)
    let rx = ry.rotateAxisAngle(1.0, 0.0, 0.0, x)
    return DOMMatrix.fromMatrix(rx.matrix, self.is2D && x == 0.0 && y == 0.0)
  }

  pub fn rotateSelf(self: &mut Self, x: f64, y: f64, z: f64) -> () {
    self.* = self.rotate(x, y, z)
  }

  pub fn rotateFromVector(self: &Self, x: f64, y: f64) -> Self {
    let angle = if x == 0.0 && y == 0.0 {
      0.0
    } else {
      math.atan2(y, x)
    }
    return self.multiply(DOMMatrix.fromMatrix(transforms.rotation(0.0, 0.0, 1.0, angle), true))
  }

  pub fn rotateFromVectorSelf(self: &mut Self, x: f64, y: f64) -> () {
    self.* = self.rotateFromVector(x, y)
  }

  pub fn skewX(self: &Self, angle: f64) -> Self {
    return self.multiply(DOMMatrix.fromMatrix(transforms.skew(math.radians(angle), 0.0), true))
  }

  pub fn skewY(self: &Self, angle: f64) -> Self {
    return self.multiply(DOMMatrix.fromMatrix(transforms.skew(0.0, math.radians(angle)), true))
  }

  pub fn skewXSelf(self: &mut Self, angle: f64) -> () {
    self.* = self.skewX(angle)
  }

  pub fn skewYSelf(self: &mut Self, angle: f64) -> () {
    self.* = self.skewY(angle)
  }

  pub fn flipX(self: &Self) -> Self {
    return self.scaleNonUniform(-1.0, 1.0)
  }

  pub fn flipY(self: &Self) -> Self {
    return self.scaleNonUniform(1.0, -1.0)
  }

  pub fn inverse(self: &Self) -> Self {
    let mut result = self.*
    result.invertSelf()
    return result
  }

  pub fn invertSelf(self: &mut Self) -> () {
    // Pivoted elimination is needed here because the shared graphics API exposes
    // composition but no inverse. Work on stack storage, preserving 3D identity.
    let source = transforms.coefficients(&self.matrix)
    let mut work = [0.0; 32]
    let mut row: usize = 0
    while row < 4 {
      let mut col: usize = 0
      while col < 4 {
        work[row * 8 + col] = source[row * 4 + col]
        work[row * 8 + col + 4] = if row == col {
          1.0
        } else {
          0.0
        }
        col = col + 1
      }
      row = row + 1
    }
    let mut pivot: usize = 0
    while pivot < 4 {
      let mut best = pivot
      row = pivot + 1
      while row < 4 {
        if f64.abs(work[row * 8 + pivot]) > f64.abs(work[best * 8 + pivot]) {
          best = row
        }
        row = row + 1
      }
      let divisor = work[best * 8 + pivot]
      if divisor == 0.0 || !f64.isFinite(divisor) {
        self.matrix = transforms.fromColumnMajor(&[f64.NAN; 16])
        self.is2D = false
        return
      }
      let mut col: usize = 0
      while col < 8 {
        let saved = work[pivot * 8 + col]
        work[pivot * 8 + col] = work[best * 8 + col]
        work[best * 8 + col] = saved
        col = col + 1
      }
      col = 0
      while col < 8 {
        work[pivot * 8 + col] = work[pivot * 8 + col] / divisor
        col = col + 1
      }
      row = 0
      while row < 4 {
        if row != pivot {
          let factor = work[row * 8 + pivot]
          col = 0
          while col < 8 {
            work[row * 8 + col] = work[row * 8 + col] - factor * work[pivot * 8 + col]
            col = col + 1
          }
        }
        row = row + 1
      }
      pivot = pivot + 1
    }
    let mut result = [0.0; 16]
    let mut i: usize = 0
    while i < 16 {
      result[i] = work[(i % 4) * 8 + i / 4 + 4]
      i = i + 1
    }
    self.matrix = transforms.fromColumnMajor(&result)
  }

  pub effect fn serialize(self: &Self) -> Bytes
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    if !transforms.finite(&self.matrix) {
      fail CssomError.InvalidStateError
    }
    let values = self.toFloat64Array()
    let indices: [usize; 6] = [0, 1, 4, 5, 12, 13]
    let mut out = Bytes.make()
    run out.append(
      if self.is2D {
        b"matrix("
      } else {
        b"matrix3d("
      },
    )
    let count: usize = if self.is2D {
      6
    } else {
      16
    }
    let mut i: usize = 0
    while i < count {
      if i != 0 {
        run out.append(b", ")
      }
      run syntax.appendNumber(
        &mut out,
        values[if self.is2D {
          indices[i]
        } else {
          i
        }],
      )
      i = i + 1
    }
    run out.append(b")")
    return move out
  }

  pub effect fn parse(text: &[u8], limits: &Limits) -> Self
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let parsed = run cssom_geometry_parse.parse(text, limits)
    return DOMMatrix.fromMatrix(parsed.matrix, parsed.is2D)
  }

  pub effect fn setMatrixValue(self: &mut Self, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    self.* = run DOMMatrix.parse(text, limits)
  }
}

pub struct DOMRectJSON {
  pub x: f64,
  pub y: f64,
  pub width: f64,
  pub height: f64,
  pub top: f64,
  pub right: f64,
  pub bottom: f64,
  pub left: f64,
}

impl Copy for DOMRectJSON {}

pub struct DOMMatrixJSON {
  pub m11: f64,
  pub m12: f64,
  pub m13: f64,
  pub m14: f64,
  pub m21: f64,
  pub m22: f64,
  pub m23: f64,
  pub m24: f64,
  pub m31: f64,
  pub m32: f64,
  pub m33: f64,
  pub m34: f64,
  pub m41: f64,
  pub m42: f64,
  pub m43: f64,
  pub m44: f64,
  pub a: f64,
  pub b: f64,
  pub c: f64,
  pub d: f64,
  pub e: f64,
  pub f: f64,
  pub is2D: bool,
  pub isIdentity: bool,
}

impl Copy for DOMMatrixJSON {}

pub struct DOMMatrixState {
  pub elements: [f64; 16],
  pub is2D: bool
}

impl Copy for DOMMatrixState {}
