//! Parse-time declaration-value and var() validation shared by cascade and @supports.
import input { Input, TokenView }
import tokens { Kind, Limits, CssError }
import tokens
import condition_cursor { Structure }
import condition_cursor
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Validation {
  pub valid: bool,
  pub hasVariables: bool,
}

pub fn customName(name: &[u8]) -> bool {
  return name.length > 2 && name[0] == 45 && name[1] == 45
}

// https://www.w3.org/TR/css-variables-1/#using-variables
fn scan(
  input: &Input,
  structure: &Structure,
  start: usize,
  end: usize,
  declaration: bool,
) -> Validation {
  let mut variables = false
  let mut position = start
  while position < end {
    let view = input.at(position)
    match &view {
      Option<TokenView>.Some { value } => {
        let mut opening = false
        let mut variable = false
        match &value.token.kind {
          Kind.Function { name } => {
            opening = true
            variable = tokens.insensitive(value.text(name), b"var")
          }
          Kind.OpenParen => {
            opening = true
          }
          Kind.OpenSquare => {
            opening = true
          }
          Kind.OpenBrace => {
            opening = true
          }
          Kind.Semicolon => {
            if declaration {
              return Validation { valid: false, hasVariables: variables }
            }
          }
          Kind.Delim { scalar } => {
            if declaration && scalar == 33 {
              return Validation { valid: false, hasVariables: variables }
            }
          }
          _ => {}
        }
        if opening {
          let close = structure.end(position)
          if close > end {
            return Validation { valid: false, hasVariables: variables }
          }
          let mut inner = position + 1
          if variable {
            variables = true
            inner = condition_cursor.skip(input, inner, close)
            if inner >= close {
              return Validation { valid: false, hasVariables: variables }
            }
            let argument = input.at(inner)
            let named = match &argument {
              Option<TokenView>.Some { value: nameView } => match &nameView.token.kind {
                Kind.Ident { text } => customName(nameView.text(text))
                _ => false
              }
              _ => false
            }
            if !named {
              return Validation { valid: false, hasVariables: variables }
            }
            inner = condition_cursor.skip(input, inner + 1, close)
            if inner < close {
              let separator = input.at(inner)
              let comma = match &separator {
                Option<TokenView>.Some { value: commaView } => match &commaView.token.kind {
                  Kind.Comma => true
                  _ => false
                }
                _ => false
              }
              if !comma {
                return Validation { valid: false, hasVariables: variables }
              }
              inner = inner + 1
            }
          }
          let nested = scan(input, structure, inner, close, variable)
          if !nested.valid {
            return Validation { valid: false, hasVariables: variables || nested.hasVariables }
          }
          variables = variables || nested.hasVariables
          position = if close < end {
            close + 1
          } else {
            end
          }
        } else {
          position = position + 1
        }
      }
      _ => {
        return Validation { valid: false, hasVariables: variables }
      }
    }
  }
  return Validation { valid: true, hasVariables: variables }
}

// The Structure must have been produced by inspect for this exact Input. The
// range is a complete component list (not the middle of a block). Its original
// token/depth limits remain in force; each component is visited once.
pub fn validateRange(input: &Input, structure: &Structure, start: usize, end: usize) -> Validation {
  if start > end || end > input.length() || !structure.any(start, end) {
    return Validation { valid: false, hasVariables: false }
  }
  return scan(input, structure, start, end, true)
}

// https://www.w3.org/TR/css-syntax-3/#consume-a-declaration
// Non-custom declarations cannot mix a top-level {} block with other values.
pub fn mixedTopLevelBlock(input: &Input, structure: &Structure, start: usize, end: usize) -> bool {
  if start > end || end > input.length() {
    return true
  }
  let mut position = start
  let mut components: usize = 0
  let mut brace = false
  while position < end {
    position = condition_cursor.skip(input, position, end)
    if position >= end {
      break
    }
    let view = input.at(position)
    match &view {
      Option<TokenView>.Some { value } => {
        components = components + 1
        match &value.token.kind {
          Kind.OpenBrace => {
            brace = true
          }
          _ => {}
        }
        let opening = match &value.token.kind {
          Kind.OpenBrace => true
          Kind.OpenParen => true
          Kind.OpenSquare => true
          Kind.Function { name } => true
          _ => false
        }
        if opening {
          let close = structure.end(position)
          if close > end {
            return true
          }
          position = if close < end {
            close + 1
          } else {
            end
          }
        } else {
          position = position + 1
        }
      }
      _ => {
        return true
      }
    }
  }
  return brace && components > 1
}

// Declaration-level !important has already been removed. Empty values are
// valid for custom properties; ordinary property grammar is checked separately.
// https://www.w3.org/TR/css-variables-1/#defining-variables
// https://www.w3.org/TR/css-syntax-3/#typedef-declaration-value
pub effect fn validate(input: &Input, limits: &Limits) -> Validation
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let structure = run condition_cursor.inspect(input, limits)
  return validateRange(input, &structure, 0, input.length())
}
