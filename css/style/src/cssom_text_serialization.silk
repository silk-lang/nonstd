//! CSSOM serialization of the validated font and text arenas.
import values
import text_values {
  TextValue,
  Atom,
  Keyword,
  GenericFamily,
  AlternateKind,
  PaletteKind,
  InterpolationSpace,
  HueMethod
}
import properties { Property }
import dimensions { Expr, ExprId, Unit }
import colors { Color, Identity }
import cssom_serialization as serialization
import cssom_numeric_serialization as numeric
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32

fn keyword(value: Keyword) -> &'static [u8] {
  return match value {
    Keyword.Normal => b"normal"
    Keyword.None => b"none"
    Keyword.Auto => b"auto"
    Keyword.Italic => b"italic"
    Keyword.Oblique => b"oblique"
    Keyword.Left => b"left"
    Keyword.Right => b"right"
    Keyword.Bold => b"bold"
    Keyword.Bolder => b"bolder"
    Keyword.Lighter => b"lighter"
    Keyword.XxSmall => b"xx-small"
    Keyword.XSmall => b"x-small"
    Keyword.Small => b"small"
    Keyword.Medium => b"medium"
    Keyword.Large => b"large"
    Keyword.XLarge => b"x-large"
    Keyword.XxLarge => b"xx-large"
    Keyword.XxxLarge => b"xxx-large"
    Keyword.Smaller => b"smaller"
    Keyword.Larger => b"larger"
    Keyword.Math => b"math"
    Keyword.UltraCondensed => b"ultra-condensed"
    Keyword.ExtraCondensed => b"extra-condensed"
    Keyword.Condensed => b"condensed"
    Keyword.SemiCondensed => b"semi-condensed"
    Keyword.SemiExpanded => b"semi-expanded"
    Keyword.Expanded => b"expanded"
    Keyword.ExtraExpanded => b"extra-expanded"
    Keyword.UltraExpanded => b"ultra-expanded"
    Keyword.SmallCaps => b"small-caps"
    Keyword.AllSmallCaps => b"all-small-caps"
    Keyword.PetiteCaps => b"petite-caps"
    Keyword.AllPetiteCaps => b"all-petite-caps"
    Keyword.Unicase => b"unicase"
    Keyword.TitlingCaps => b"titling-caps"
    Keyword.CommonLigatures => b"common-ligatures"
    Keyword.NoCommonLigatures => b"no-common-ligatures"
    Keyword.DiscretionaryLigatures => b"discretionary-ligatures"
    Keyword.NoDiscretionaryLigatures => b"no-discretionary-ligatures"
    Keyword.HistoricalLigatures => b"historical-ligatures"
    Keyword.NoHistoricalLigatures => b"no-historical-ligatures"
    Keyword.Contextual => b"contextual"
    Keyword.NoContextual => b"no-contextual"
    Keyword.LiningNums => b"lining-nums"
    Keyword.OldstyleNums => b"oldstyle-nums"
    Keyword.ProportionalNums => b"proportional-nums"
    Keyword.TabularNums => b"tabular-nums"
    Keyword.DiagonalFractions => b"diagonal-fractions"
    Keyword.StackedFractions => b"stacked-fractions"
    Keyword.Ordinal => b"ordinal"
    Keyword.SlashedZero => b"slashed-zero"
    Keyword.Jis78 => b"jis78"
    Keyword.Jis83 => b"jis83"
    Keyword.Jis90 => b"jis90"
    Keyword.Jis04 => b"jis04"
    Keyword.Simplified => b"simplified"
    Keyword.Traditional => b"traditional"
    Keyword.FullWidth => b"full-width"
    Keyword.ProportionalWidth => b"proportional-width"
    Keyword.Ruby => b"ruby"
    Keyword.HistoricalForms => b"historical-forms"
    Keyword.Sub => b"sub"
    Keyword.Super => b"super"
    Keyword.Text => b"text"
    Keyword.Emoji => b"emoji"
    Keyword.Unicode => b"unicode"
    Keyword.Weight => b"weight"
    Keyword.Style => b"style"
    Keyword.Position => b"position"
    Keyword.ObliqueOnly => b"oblique-only"
    Keyword.Baseline => b"baseline"
    Keyword.TextBottom => b"text-bottom"
    Keyword.Alphabetic => b"alphabetic"
    Keyword.Ideographic => b"ideographic"
    Keyword.Middle => b"middle"
    Keyword.Central => b"central"
    Keyword.Mathematical => b"mathematical"
    Keyword.Hanging => b"hanging"
    Keyword.TextTop => b"text-top"
    Keyword.BeforeEdge => b"before-edge"
    Keyword.TextBeforeEdge => b"text-before-edge"
    Keyword.AfterEdge => b"after-edge"
    Keyword.TextAfterEdge => b"text-after-edge"
    Keyword.UseScript => b"use-script"
    Keyword.NoChange => b"no-change"
    Keyword.ResetSize => b"reset-size"
    Keyword.Top => b"top"
    Keyword.Center => b"center"
    Keyword.Bottom => b"bottom"
    Keyword.First => b"first"
    Keyword.Last => b"last"
    Keyword.EachLine => b"each-line"
    Keyword.Underline => b"underline"
    Keyword.Overline => b"overline"
    Keyword.LineThrough => b"line-through"
    Keyword.Blink => b"blink"
    Keyword.Solid => b"solid"
    Keyword.Double => b"double"
    Keyword.Dotted => b"dotted"
    Keyword.Dashed => b"dashed"
    Keyword.Wavy => b"wavy"
    Keyword.Under => b"under"
    Keyword.Clip => b"clip"
    Keyword.Ellipsis => b"ellipsis"
    Keyword.Capitalize => b"capitalize"
    Keyword.Uppercase => b"uppercase"
    Keyword.Lowercase => b"lowercase"
    Keyword.FullSizeKana => b"full-size-kana"
    Keyword.ForceEnd => b"force-end"
    Keyword.AllowEnd => b"allow-end"
    Keyword.Filled => b"filled"
    Keyword.Open => b"open"
    Keyword.Dot => b"dot"
    Keyword.Circle => b"circle"
    Keyword.DoubleCircle => b"double-circle"
    Keyword.Triangle => b"triangle"
    Keyword.Sesame => b"sesame"
    Keyword.Over => b"over"
    Keyword.Caption => b"caption"
    Keyword.Icon => b"icon"
    Keyword.Menu => b"menu"
    Keyword.MessageBox => b"message-box"
    Keyword.SmallCaption => b"small-caption"
    Keyword.StatusBar => b"status-bar"
    Keyword.FromFont => b"from-font"
    Keyword.Collapse => b"collapse"
    Keyword.Discard => b"discard"
    Keyword.Preserve => b"preserve"
    Keyword.PreserveBreaks => b"preserve-breaks"
    Keyword.PreserveSpaces => b"preserve-spaces"
    Keyword.BreakSpaces => b"break-spaces"
    Keyword.Wrap => b"wrap"
    Keyword.Nowrap => b"nowrap"
    Keyword.DiscardBefore => b"discard-before"
    Keyword.DiscardAfter => b"discard-after"
    Keyword.DiscardInner => b"discard-inner"
  }
}

fn family(value: GenericFamily) -> &'static [u8] {
  return match value {
    GenericFamily.Named => b""
    GenericFamily.Serif => b"serif"
    GenericFamily.SansSerif => b"sans-serif"
    GenericFamily.Cursive => b"cursive"
    GenericFamily.Fantasy => b"fantasy"
    GenericFamily.Monospace => b"monospace"
    GenericFamily.SystemUi => b"system-ui"
    GenericFamily.UiSerif => b"ui-serif"
    GenericFamily.UiSansSerif => b"ui-sans-serif"
    GenericFamily.UiMonospace => b"ui-monospace"
    GenericFamily.UiRounded => b"ui-rounded"
    GenericFamily.Math => b"math"
    GenericFamily.Fangsong => b"generic(fangsong)"
    GenericFamily.Kai => b"generic(kai)"
    GenericFamily.KhmerMul => b"generic(khmer-mul)"
    GenericFamily.Nastaliq => b"generic(nastaliq)"
  }
}

fn alternate(value: AlternateKind) -> &'static [u8] {
  return match value {
    AlternateKind.Stylistic => b"stylistic"
    AlternateKind.Styleset => b"styleset"
    AlternateKind.CharacterVariant => b"character-variant"
    AlternateKind.Swash => b"swash"
    AlternateKind.Ornaments => b"ornaments"
    AlternateKind.Annotation => b"annotation"
  }
}

fn space(value: InterpolationSpace) -> &'static [u8] {
  return match value {
    InterpolationSpace.Srgb => b"srgb"
    InterpolationSpace.SrgbLinear => b"srgb-linear"
    InterpolationSpace.DisplayP3 => b"display-p3"
    InterpolationSpace.DisplayP3Linear => b"display-p3-linear"
    InterpolationSpace.A98Rgb => b"a98-rgb"
    InterpolationSpace.ProphotoRgb => b"prophoto-rgb"
    InterpolationSpace.Rec2020 => b"rec2020"
    InterpolationSpace.Lab => b"lab"
    InterpolationSpace.Oklab => b"oklab"
    InterpolationSpace.XyzD50 => b"xyz-d50"
    InterpolationSpace.XyzD65 => b"xyz-d65"
    InterpolationSpace.Hsl => b"hsl"
    InterpolationSpace.Hwb => b"hwb"
    InterpolationSpace.Lch => b"lch"
    InterpolationSpace.Oklch => b"oklch"
  }
}

fn literal(store: &values.Store, id: ExprId, expected: f64) -> bool {
  return match &store.numerics.get(id).* {
    Expr.Literal { value, unit } => value == expected
    _ => false
  }
}

fn current(color: &Color) -> bool {
  return match &color.identity {
    Identity.CurrentColor => true
    _ => false
  }
}

fn hasKeyword(text: &TextValue, property: Property, expected: Keyword) -> bool {
  let mut i: usize = 0
  while i < text.items.length() {
    let item = &text.items.asSlice()[i]
    if item.property == property {
      match &item.atom {
        Atom.Keyword { value } => {
          if value == expected {
            return true
          }
        }
        _ => {}
      }
    }
    i = i + 1
  }
  return false
}

fn initial(store: &values.Store, text: &TextValue, property: Property) -> bool {
  let mut i: usize = 0
  let mut found = false
  while i < text.items.length() {
    let item = &text.items.asSlice()[i]
    if item.property == property {
      found = true
      let valid = match &item.atom {
        Atom.Keyword { value } => {
          if property == Property.TextDecorationLine || property == Property.TextEmphasisStyle
            || property == Property.WhiteSpaceTrim {
            value == Keyword.None
          } else if property == Property.TextDecorationStyle {
            value == Keyword.Solid
          } else if property == Property.BaselineSource
            || property == Property.TextDecorationThickness {
            value == Keyword.Auto
          } else if property == Property.AlignmentBaseline {
            value == Keyword.Baseline
          } else {
            value == Keyword.Normal
          }
        }
        Atom.Color { value } => current(&value)
        Atom.Numeric { value } => property == Property.BaselineShift && literal(store, value, 0.0)
        _ => false
      }
      if !valid {
        return false
      }
    }
    i = i + 1
  }
  return found
}

effect fn gap(out: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if Bytes.asSlice(&out.*).length != 0 {
    run Bytes.append(&mut out.*, b" ")
  }
}

effect fn appendString(out: &mut Bytes, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let escaped = run serialization.string(text)
  run Bytes.append(&mut out.*, Bytes.asSlice(&escaped))
}

effect fn appendIdentifier(out: &mut Bytes, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let escaped = run serialization.identifier(text)
  run Bytes.append(&mut out.*, Bytes.asSlice(&escaped))
}

fn defaultWeight(store: &values.Store, weight: &Option<ExprId>, amount: f64) -> bool {
  return match &weight.* {
    Option<ExprId>.Some { value } => literal(store, value, amount)
    _ => true
  }
}

fn omitPaletteWeight(
  store: &values.Store,
  text: &TextValue,
  firstLink: usize,
  link: usize,
) -> bool {
  let first = &text.paletteStops.asSlice()[firstLink - 1]
  if first.next == 0 {
    return defaultWeight(store, &first.weight, 100.0)
  }
  let second = &text.paletteStops.asSlice()[first.next - 1]
  if second.next != 0 {
    return false
  }
  if defaultWeight(store, &first.weight, 50.0) && defaultWeight(store, &second.weight, 50.0) {
    return true
  }
  if link == first.next {
    return match &first.weight {
      Option<ExprId>.Some { value: firstId } => match &second.weight {
        Option<ExprId>.Some { value: secondId } => match &store.numerics.get(firstId).* {
          Expr.Literal { value: firstAmount, unit } => match &store.numerics.get(secondId).* {
            Expr.Literal { value: secondAmount, unit: secondUnit } => firstAmount + secondAmount
              == 100.0
            _ => false
          }
          _ => false
        }
        _ => false
      }
      _ => false
    }
  }
  return false
}

effect fn expression(out: &mut Bytes, store: &values.Store, id: ExprId, computed: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if computed {
    run numeric.appendComputedExpression(&mut out.*, &store.numerics, id)
  } else {
    run numeric.appendExpression(&mut out.*, &store.numerics, id)
  }
}

effect fn palette(
  out: &mut Bytes,
  store: &values.Store,
  text: &TextValue,
  root: usize,
  computed: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = &text.palettes.asSlice()[root]
  match node.kind {
    PaletteKind.Normal => {
      run Bytes.append(&mut out.*, b"normal")
    }
    PaletteKind.Light => {
      run Bytes.append(&mut out.*, b"light")
    }
    PaletteKind.Dark => {
      run Bytes.append(&mut out.*, b"dark")
    }
    PaletteKind.Named => {
      run appendIdentifier(&mut out.*, text.text(node.name))
    }
    PaletteKind.Mix => {
      run Bytes.append(&mut out.*, b"palette-mix(")
      if node.space != InterpolationSpace.Oklab || node.hue != HueMethod.Shorter {
        run Bytes.append(&mut out.*, b"in ")
        run Bytes.append(&mut out.*, space(node.space))
        if node.hue != HueMethod.Shorter {
          run Bytes.append(
            &mut out.*,
            match node.hue {
              HueMethod.Shorter => b" shorter hue"
              HueMethod.Longer => b" longer hue"
              HueMethod.Increasing => b" increasing hue"
              HueMethod.Decreasing => b" decreasing hue"
            },
          )
        }
        run Bytes.append(&mut out.*, b", ")
      }
      let mut link = node.firstStop
      let mut first = true
      while link != 0 {
        let stop = &text.paletteStops.asSlice()[link - 1]
        if !first {
          run Bytes.append(&mut out.*, b", ")
        }
        run palette(&mut out.*, store, text, stop.palette, computed)
        match &stop.weight {
          Option<ExprId>.Some { value } => {
            if node.alphaMultiplier != 1.0 {
              run Bytes.append(&mut out.*, b" ")

              // Computation normalizes stop weights and retains their missing
              // alpha separately; restore the total rather than lose that alpha.
              match &store.numerics.get(value).* {
                Expr.Literal { value: amount, unit } => {
                  run serialization.appendNumber(&mut out.*, amount * node.alphaMultiplier)
                  run Bytes.append(&mut out.*, b"%")
                }
                _ => {
                  run expression(&mut out.*, store, value, computed)
                }
              }
            } else if !omitPaletteWeight(store, text, node.firstStop, link) {
              run Bytes.append(&mut out.*, b" ")
              run expression(&mut out.*, store, value, computed)
            }
          }
          _ => {}
        }
        first = false
        link = stop.next
      }
      run Bytes.append(&mut out.*, b")")
    }
  }
}

effect fn atom(
  out: &mut Bytes,
  store: &values.Store,
  text: &TextValue,
  property: Property,
  item: &Atom,
  computed: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &item.* {
    Atom.Keyword { value } => {
      run Bytes.append(&mut out.*, keyword(value))
    }
    Atom.Numeric { value } => {
      run expression(&mut out.*, store, value, computed)
    }
    Atom.String { text: span } => {
      run appendString(&mut out.*, text.text(span))
    }
    Atom.Family { generic, name } => {
      if generic == GenericFamily.Named {
        run appendString(&mut out.*, text.text(name))
      } else {
        run Bytes.append(&mut out.*, family(generic))
      }
    }
    Atom.Setting { tag, value } => {
      let bytes = [
        u32.toU8(tag / 16777216),
        u32.toU8(tag / 65536 % 256),
        u32.toU8(tag / 256 % 256),
        u32.toU8(tag % 256),
      ]
      run appendString(&mut out.*, &bytes)
      if property != Property.FontFeatureSettings || !literal(store, value, 1.0) {
        run Bytes.append(&mut out.*, b" ")
        run expression(&mut out.*, store, value, computed)
      }
    }
    Atom.Alternate { kind, name } => {
      run Bytes.append(&mut out.*, alternate(kind))
      run Bytes.append(&mut out.*, b"(")
      run appendIdentifier(&mut out.*, text.text(name))
      run Bytes.append(&mut out.*, b")")
    }
    Atom.Color { value } => {
      run numeric.appendColor(&mut out.*, &value)
    }
    Atom.Shadow { x, y, blur, color } => {
      if !current(&color) {
        run numeric.appendColor(&mut out.*, &color)
        run Bytes.append(&mut out.*, b" ")
      }
      run expression(&mut out.*, store, x, computed)
      run Bytes.append(&mut out.*, b" ")
      run expression(&mut out.*, store, y, computed)
      if !literal(store, blur, 0.0) {
        run Bytes.append(&mut out.*, b" ")
        run expression(&mut out.*, store, blur, computed)
      }
    }
    Atom.Palette { root } => {
      run palette(&mut out.*, store, text, root, computed)
    }
  }
}

// Only unordered grammar groups are ranked. List members retain their source order.
fn rank(property: Property, item: &Atom) -> usize {
  return match &item.* {
    Atom.Numeric { value } => if property == Property.FontStyle {
      2
    } else {
      0
    }
    Atom.Alternate { kind, name } => match kind {
      AlternateKind.Stylistic => 0
      AlternateKind.Styleset => 3
      AlternateKind.CharacterVariant => 4
      AlternateKind.Swash => 5
      AlternateKind.Ornaments => 6
      AlternateKind.Annotation => 7
    }
    Atom.Keyword { value } => match value {
      Keyword.NoCommonLigatures => 1
      Keyword.CommonLigatures => 1
      Keyword.DiscretionaryLigatures => 2
      Keyword.NoDiscretionaryLigatures => 2
      Keyword.HistoricalLigatures => 3
      Keyword.NoHistoricalLigatures => 3
      Keyword.Contextual => 4
      Keyword.NoContextual => 4
      Keyword.LiningNums => 1
      Keyword.OldstyleNums => 1
      Keyword.ProportionalNums => 2
      Keyword.TabularNums => 2
      Keyword.DiagonalFractions => 3
      Keyword.StackedFractions => 3
      Keyword.Ordinal => 4
      Keyword.SlashedZero => 5
      Keyword.FullWidth => 2
      Keyword.ProportionalWidth => 2
      Keyword.Ruby => 3
      Keyword.Hanging => 1
      Keyword.EachLine => 2
      Keyword.Underline => 1
      Keyword.Overline => 2
      Keyword.LineThrough => 3
      Keyword.Blink => 4
      Keyword.First => 1
      Keyword.Last => 2
      Keyword.ForceEnd => 3
      Keyword.AllowEnd => 3
      Keyword.FullSizeKana => 3
      Keyword.Left => 2
      Keyword.Right => 2
      Keyword.Dot => 2
      Keyword.Circle => 2
      Keyword.DoubleCircle => 2
      Keyword.Triangle => 2
      Keyword.Sesame => 2
      Keyword.DiscardBefore => 1
      Keyword.DiscardAfter => 2
      Keyword.DiscardInner => 3
      _ => 1
    }
    _ => 0
  }
}

fn omitted(store: &values.Store, text: &TextValue, property: Property, item: &Atom) -> bool {
  if property == Property.FontStyle {
    return match &item.* {
      Atom.Numeric { value } => match &store.numerics.get(value).* {
        Expr.Literal { value: angle, unit } => angle == 14.0 && unit == Unit.Deg
        _ => false
      }
      _ => false
    }
  }
  if property == Property.TextEmphasisStyle {
    return match &item.* {
      Atom.Keyword { value } => value == Keyword.Filled
        && (hasKeyword(text, property, Keyword.Dot) || hasKeyword(text, property, Keyword.Circle)
          || hasKeyword(text, property, Keyword.DoubleCircle)
          || hasKeyword(text, property, Keyword.Triangle)
          || hasKeyword(text, property, Keyword.Sesame))
      _ => false
    }
  }
  return false
}

effect fn appendProperty(
  out: &mut Bytes,
  store: &values.Store,
  text: &TextValue,
  property: Property,
  computed: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let comma = property == Property.FontFamily || property == Property.FontFeatureSettings
    || property == Property.FontVariationSettings
    || property == Property.TextShadow
  let mut first = true
  let mut order: usize = 0

  // There are at most eight independent grammar groups, regardless of list size.
  let groups: usize = if comma {
    1
  } else {
    8
  }
  while order < groups {
    let mut open = false
    let mut i: usize = 0
    while i < text.items.length() {
      let item = &text.items.asSlice()[i]
      if item.property == property && (comma || rank(property, &item.atom) == order)
        && !omitted(store, text, property, &item.atom) {
        if open {
          run Bytes.append(&mut out.*, b", ")
        } else if !first {
          run Bytes.append(
            &mut out.*,
            if comma {
              b", "
            } else {
              b" "
            },
          )
        }
        match &item.atom {
          Atom.Alternate { kind, name } => {
            if !open {
              run Bytes.append(&mut out.*, alternate(kind))
              run Bytes.append(&mut out.*, b"(")
              open = true
            }
            run appendIdentifier(&mut out.*, text.text(name))
          }
          _ => {
            run atom(&mut out.*, store, text, property, &item.atom, computed)
          }
        }
        first = false
      }
      i = i + 1
    }
    if open {
      run Bytes.append(&mut out.*, b")")
    }
    order = order + 1
  }
}

effect fn component(
  out: &mut Bytes,
  store: &values.Store,
  text: &TextValue,
  property: Property,
  computed: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run gap(&mut out.*)
  run appendProperty(&mut out.*, store, text, property, computed)
}

effect fn serialize(
  store: &values.Store,
  text: &TextValue,
  sourceProperty: Property,
  property: Property,
  computed: bool,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  if property == Property.Font {
    if sourceProperty == Property.Font && text.items.length() == 1
      && text.items.asSlice()[0].property == Property.Font {
      run appendProperty(&mut out, store, text, Property.Font, computed)
      return move out
    }
    let optional = [
      Property.FontStyle,
      Property.FontVariantCaps,
      Property.FontWeight,
      Property.FontWidth,
    ]
    let mut i: usize = 0
    while i < optional.length {
      if !initial(store, text, optional[i]) {
        run component(&mut out, store, text, optional[i], computed)
      }
      i = i + 1
    }
    run component(&mut out, store, text, Property.FontSize, computed)
    if !initial(store, text, Property.LineHeight) {
      run Bytes.append(&mut out, b" / ")
      run appendProperty(&mut out, store, text, Property.LineHeight, computed)
    }
    run component(&mut out, store, text, Property.FontFamily, computed)
  } else if property == Property.FontVariant {
    let order = [
      Property.FontVariantLigatures,
      Property.FontVariantCaps,
      Property.FontVariantAlternates,
      Property.FontVariantNumeric,
      Property.FontVariantEastAsian,
      Property.FontVariantPosition,
      Property.FontVariantEmoji,
    ]
    let mut i: usize = 0
    while i < order.length {
      if !initial(store, text, order[i]) {
        run component(&mut out, store, text, order[i], computed)
      }
      i = i + 1
    }
    if Bytes.asSlice(&out).length == 0 {
      run Bytes.append(&mut out, b"normal")
    }
  } else if property == Property.FontSynthesis {
    let targets = [
      Property.FontSynthesisWeight,
      Property.FontSynthesisStyle,
      Property.FontSynthesisSmallCaps,
      Property.FontSynthesisPosition,
    ]
    let names = [Keyword.Weight, Keyword.Style, Keyword.SmallCaps, Keyword.Position]
    let mut i: usize = 0
    while i < targets.length {
      if hasKeyword(text, targets[i], Keyword.Auto) {
        run gap(&mut out)
        run Bytes.append(&mut out, keyword(names[i]))
      }
      i = i + 1
    }
    if Bytes.asSlice(&out).length == 0 {
      run Bytes.append(&mut out, b"none")
    }
  } else if property == Property.WhiteSpace {
    let collapse = hasKeyword(text, Property.WhiteSpaceCollapse, Keyword.Collapse)
    let preserve = hasKeyword(text, Property.WhiteSpaceCollapse, Keyword.Preserve)
    let breaks = hasKeyword(text, Property.WhiteSpaceCollapse, Keyword.PreserveBreaks)
    let wrap = hasKeyword(text, Property.TextWrapMode, Keyword.Wrap)
    let trim = initial(store, text, Property.WhiteSpaceTrim)
    if trim && (collapse || preserve || (breaks && wrap)) {
      run Bytes.append(
        &mut out,
        if collapse {
          if wrap {
            b"normal"
          } else {
            b"nowrap"
          }
        } else if preserve {
          if wrap {
            b"pre-wrap"
          } else {
            b"pre"
          }
        } else {
          b"pre-line"
        },
      )
    } else {
      if !collapse {
        run component(&mut out, store, text, Property.WhiteSpaceCollapse, computed)
      }
      if !wrap {
        run component(&mut out, store, text, Property.TextWrapMode, computed)
      }
      if !trim {
        run component(&mut out, store, text, Property.WhiteSpaceTrim, computed)
      }
    }
  } else if property == Property.TextDecoration {
    let order = [
      Property.TextDecorationLine,
      Property.TextDecorationThickness,
      Property.TextDecorationStyle,
      Property.TextDecorationColor,
    ]
    let mut i: usize = 0
    while i < order.length {
      if !initial(store, text, order[i]) {
        run component(&mut out, store, text, order[i], computed)
      }
      i = i + 1
    }
    if Bytes.asSlice(&out).length == 0 {
      run Bytes.append(&mut out, b"none")
    }
  } else if property == Property.TextEmphasis {
    if !initial(store, text, Property.TextEmphasisStyle) {
      run component(&mut out, store, text, Property.TextEmphasisStyle, computed)
    }
    if !initial(store, text, Property.TextEmphasisColor) {
      run component(&mut out, store, text, Property.TextEmphasisColor, computed)
    }
    if Bytes.asSlice(&out).length == 0 {
      run Bytes.append(&mut out, b"none")
    }
  } else if property == Property.VerticalAlign {
    let order = [Property.BaselineSource, Property.AlignmentBaseline, Property.BaselineShift]
    let mut i: usize = 0
    while i < order.length {
      if !initial(store, text, order[i]) {
        run component(&mut out, store, text, order[i], computed)
      }
      i = i + 1
    }
    if Bytes.asSlice(&out).length == 0 {
      run Bytes.append(&mut out, b"baseline")
    }
  } else {
    // A system font stores the system keyword, not invented longhand values.
    // CSS Fonts requires the corresponding specified longhands to be empty.
    let target = if property == Property.FontStretch && sourceProperty == Property.Font {
      Property.FontWidth
    } else {
      property
    }
    run appendProperty(&mut out, store, text, target, computed)
  }
  return move out
}

pub effect fn value(
  store: &values.Store,
  text: &TextValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run serialize(store, text, sourceProperty, property, false)
}

pub effect fn computedValue(
  store: &values.Store,
  text: &TextValue,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run serialize(store, text, sourceProperty, property, true)
}
