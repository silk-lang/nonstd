//! CSSOM declaration algorithms, CSS Variables serialization, and Animations grammar.
import cssom_declaration { StyleDeclaration }
import cssom_error { CssomError }
import cssom_descriptors { Context }
import tokens { Limits, CssError, CssErrorKind }
import tokens
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn valueIs(style: &StyleDeclaration, name: &[u8], expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let value = run style.getPropertyValue(name)
  return tokens.equal(Bytes.asSlice(&value), expected)
}

effect fn textIs(style: &StyleDeclaration, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run style.cssText()
  return tokens.equal(Bytes.asSlice(&text), expected)
}

effect fn mutation() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = run StyleDeclaration.parse(
    b"WIDTH: 1px; color: RED; width: 2px !important; width: 3px; opacity: .5",
    &limits,
  )
  run Testing.expect(style.length() == 3, "duplicates collapse to one canonical longhand")
  run Testing.expect(
    tokens.equal(style.item(0), b"color") && tokens.equal(style.item(1), b"width")
      && tokens.equal(style.item(2), b"opacity")
      && style.item(3).length == 0,
    "winning declarations retain specified order",
  )
  run Testing.expect(
    run valueIs(&style, b"WiDtH", b"2px"),
    "parse ignores later non-important duplicate",
  )
  run Testing.expect(
    tokens.equal(style.getPropertyPriority(b"width"), b"important"),
    "priority is canonical",
  )
  run Testing.expect(
    run valueIs(&style, b"color", b"red"),
    "specified named colors remain canonical keywords",
  )
  run style.setProperty(b"width", b"4px", b"IMPORTANT", &limits)
  run style.setProperty(b"width", b"bogus", b"", &limits)
  run style.setProperty(b"width", b"5px !important", b"", &limits)
  run style.setProperty(b"width", b"6px", b" important", &limits)
  run style.setProperty(b"unknown", b"hello", b"", &limits)
  run Testing.expect(
    run valueIs(&style, b"width", b"4px"),
    "invalid values/priorities and embedded important are no-ops",
  )
  run style.setProperty(b"width", b"7px", b"", &limits)
  run Testing.expect(
    (run valueIs(&style, b"width", b"7px")) && style.getPropertyPriority(b"width").length == 0,
    "setter replaces important declarations regardless of former priority",
  )
  let revision = style.mutationRevision()
  run style.setProperty(b"width", b"7px", b"", &limits)
  run style.setProperty(b"width", b"invalid", b"", &limits)
  run Testing.expect(
    style.mutationRevision() == revision,
    "identical and invalid setters do not notify an inline owner",
  )
  let removed = run style.removeProperty(b"WIDTH")
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&removed), b"7px") && style.length() == 2,
    "removal returns the previous canonical value",
  )
  run style.setProperty(b"opacity", b"", b"invalid", &limits)
  run Testing.expect(style.length() == 1, "empty value removes before validating priority")
  run style.setCssText(b"height: 10px; unknown: value; width: broken", &limits)
  run Testing.expect(
    style.length() == 1 && (run textIs(&style, b"height: 10px;")),
    "cssText replaces the block and ignores invalid declarations",
  )
}

effect fn shorthands() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = run StyleDeclaration.parse(
    b"overflow-y: scroll; overflow: hidden; color: blue",
    &limits,
  )
  run Testing.expect(
    style.length() == 3 && tokens.equal(style.item(0), b"overflow-x")
      && tokens.equal(style.item(1), b"overflow-y"),
    "shorthands expand in canonical longhand order",
  )
  run Testing.expect(
    (run valueIs(&style, b"overflow-y", b"hidden"))
      && (run valueIs(&style, b"overflow", b"hidden")),
    "omitted shorthand components reset and equal longhands compress",
  )
  run Testing.expect(
    run textIs(&style, b"overflow: hidden; color: blue;"),
    "cssText chooses a representable shorthand",
  )
  run style.setProperty(b"overflow-y", b"scroll", b"important", &limits)
  run Testing.expect(
    (run valueIs(&style, b"overflow", b"")) && style.getPropertyPriority(b"overflow").length == 0,
    "mixed-priority longhands cannot reconstruct a shorthand",
  )
  run style.setProperty(b"overflow-x", b"hidden", b"important", &limits)
  run Testing.expect(
    (run valueIs(&style, b"overflow", b"hidden scroll"))
      && tokens.equal(style.getPropertyPriority(b"overflow"), b"important"),
    "matching priorities permit reconstruction",
  )
  let removed = run style.removeProperty(b"overflow")
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&removed), b"hidden scroll") && style.length() == 1,
    "shorthand removal removes every mapped longhand and returns shorthand value",
  )
  run style.setCssText(b"white-space: pre-wrap; font-synthesis: none; marker: none", &limits)
  run Testing.expect(
    (run valueIs(&style, b"white-space-collapse", b"preserve"))
      && (run valueIs(&style, b"text-wrap-mode", b"wrap"))
      && (run valueIs(&style, b"white-space-trim", b"none")),
    "white-space expands all three modern longhands",
  )
  run Testing.expect(
    (run valueIs(&style, b"white-space", b"pre-wrap"))
      && (run valueIs(&style, b"font-synthesis", b"none"))
      && (run valueIs(&style, b"marker", b"none")),
    "supported compound shorthands reconstruct",
  )
  run style.setCssText(b"font: italic small-caps bold 12px / 2 serif", &limits)
  run Testing.expect(
    (run valueIs(&style, b"font-size", b"12px")) && (run valueIs(&style, b"font-kerning", b"auto"))
      && (run valueIs(&style, b"font-feature-settings", b"normal")),
    "font expands both explicit and reset-only fields",
  )
  run style.setProperty(b"font-kerning", b"none", b"", &limits)
  run Testing.expect(
    run valueIs(&style, b"font", b""),
    "noninitial reset-only font field prevents shorthand serialization",
  )
  run style.setCssText(b"font: menu", &limits)
  run Testing.expect(
    (run valueIs(&style, b"font", b"menu")) && (run valueIs(&style, b"font-size", b"")),
    "system font retains shorthand provenance without exposing fake longhand keywords",
  )
  run style.setCssText(b"font: 12px serif", &limits)
  run style.setProperty(b"font-width", b"75%", b"", &limits)
  run Testing.expect(
    run valueIs(&style, b"font", b"condensed 12px serif"),
    "font shorthand maps a representable width percentage to its CSS3 keyword",
  )
  run style.setProperty(b"font-width", b"80%", b"", &limits)
  run Testing.expect(
    run valueIs(&style, b"font", b""),
    "font shorthand cannot represent an arbitrary width percentage",
  )
  run style.setCssText(b"text-decoration-thickness: 5px; text-decoration: underline red", &limits)
  run Testing.expect(
    style.length() == 4 && (run valueIs(&style, b"text-decoration-thickness", b"auto")),
    "text-decoration resets its supported thickness longhand to auto",
  )
  run style.setProperty(b"text-decoration", b"red 10% underline wavy", b"", &limits)
  run Testing.expect(
    (run valueIs(&style, b"text-decoration-thickness", b"10%"))
      && (run valueIs(&style, b"text-decoration", b"underline 10% wavy red")),
    "thickness is expanded and serialized in defining-grammar order",
  )
  run style.setProperty(b"text-decoration", b"underline calc(1px + 2%)", b"", &limits)
  let beforeInvalid = run style.getPropertyValue(b"text-decoration-thickness")
  run style.setProperty(b"text-decoration", b"underline -2px", b"", &limits)
  let afterInvalid = run style.getPropertyValue(b"text-decoration-thickness")
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&beforeInvalid), Bytes.asSlice(&afterInvalid)),
    "negative literal thickness leaves the previously parsed calculation intact",
  )
  run style.setCssText(b"direction: rtl; --Keep: Blue; all: revert-layer", &limits)
  run Testing.expect(
    (run valueIs(&style, b"all", b"revert-layer")) && (run valueIs(&style, b"direction", b"rtl"))
      && (run valueIs(&style, b"--Keep", b"Blue")),
    "all covers canonical longhands but excludes direction and custom properties",
  )
}

effect fn customAndPending() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = run StyleDeclaration.parse(
    b"--X: /*keep*/ MiXeD  1.00 /*tail*/; --x: lower; --empty:; --bad: !;",
    &limits,
  )
  run Testing.expect(
    style.length() == 3 && (run valueIs(&style, b"--X", b"/*keep*/ MiXeD  1.00 /*tail*/"))
      && (run valueIs(&style, b"--x", b"lower"))
      && (run valueIs(&style, b"--empty", b" ")),
    "custom properties preserve case, whitespace, comments and number spelling; empty serializes as a space",
  )
  run Testing.expect(
    run textIs(&style, b"--X: /*keep*/ MiXeD  1.00 /*tail*/; --x: lower; --empty: ;"),
    "whitespace-only serialized values do not add a second separator space",
  )
  run style.setProperty(b"--x", b"bad ! important", b"", &limits)
  run style.setProperty(b"--x;", b"invalid name", b"", &limits)
  run Testing.expect(
    style.length() == 3 && (run valueIs(&style, b"--x", b"lower")),
    "custom invalid token/name setters are no-ops",
  )
  run style.setCssText(b"overflow: var(--pair) !important", &limits)
  run Testing.expect(
    (run valueIs(&style, b"overflow", b"var(--pair)")) && (run valueIs(&style, b"overflow-x", b"")),
    "pending shorthand preserves original text and hides longhand substitution values",
  )
  run style.setProperty(b"overflow-y", b"scroll", b"", &limits)
  run Testing.expect(
    (run valueIs(&style, b"overflow", b""))
      && (run textIs(&style, b"overflow-x:  !important; overflow-y: scroll;")),
    "partly overwritten pending shorthand serializes empty pending longhands, not the lost original shorthand",
  )
  run style.setCssText(b"overflow-x: var(--x); overflow-y: var(--x)", &limits)
  run Testing.expect(
    run valueIs(&style, b"overflow", b""),
    "independent variable-bearing longhands cannot become a shorthand",
  )
  run style.setCssText(b"width: /*strip*/ var(--w) /*strip*/", &limits)
  run Testing.expect(
    run valueIs(&style, b"width", b"var(--w)"),
    "noncustom pending values strip surrounding comments",
  )
}

effect fn animationsAndModes() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = run StyleDeclaration.parse(
    b"animation: Spin 2s ease-in 1s 3 alternate both paused",
    &limits,
  )
  run Testing.expect(
    style.length() == 8 && (run valueIs(&style, b"animation-name", b"Spin"))
      && (run valueIs(&style, b"animation-duration", b"2s"))
      && (run valueIs(&style, b"animation-delay", b"1s"))
      && (run valueIs(&style, b"animation-play-state", b"paused")),
    "animation is parsed and expanded, never opaque raw text",
  )
  run style.setProperty(b"animation", b"spin -1s", b"", &limits)
  run style.setProperty(b"animation-duration", b"red", b"", &limits)
  run style.setProperty(b"animation-timing-function", b"steps(1, jump-none)", b"", &limits)
  run Testing.expect(
    (run valueIs(&style, b"animation-duration", b"2s"))
      && (run valueIs(&style, b"animation-timing-function", b"ease-in")),
    "invalid animation values are no-ops",
  )
  run style.setProperty(b"animation", b"fade 1s, move 2s", b"", &limits)
  run Testing.expect(
    (run valueIs(&style, b"animation-name", b"fade, move"))
      && (run valueIs(&style, b"animation-delay", b"0s, 0s")),
    "animation lists reset omitted components per item",
  )
  let mut keyframe = run StyleDeclaration.parseKeyframe(
    b"opacity: .3!important; opacity: .5; animation: spin 2s; animation-timing-function: linear",
    &limits,
  )
  run Testing.expect(
    keyframe.length() == 2 && (run valueIs(&keyframe, b"opacity", b"0.5")),
    "keyframe declarations ignore important and disallowed animation properties",
  )
  run keyframe.setProperty(b"opacity", b".8", b"important", &limits)
  run keyframe.setProperty(b"animation-name", b"spin", b"", &limits)
  run Testing.expect(
    keyframe.length() == 2 && (run valueIs(&keyframe, b"opacity", b"0.5")),
    "keyframe mutation preserves parsing mode",
  )
  let mut page = run StyleDeclaration.parseFor(
    Context.Page,
    b"margin: 1px 2px; size: A4 landscape",
    &limits,
  )
  run Testing.expect(
    (run valueIs(&page, b"margin-left", b"2px")) && (run valueIs(&page, b"margin", b"1px 2px")),
    "descriptor mode expands and reconstructs four-side descriptors",
  )
  run page.setCssText(b"margin: 3px", &limits)
  run Testing.expect(
    run textIs(&page, b"margin: 3px;"),
    "cssText replacement retains descriptor context",
  )
  let face = run StyleDeclaration.parseFor(
    Context.FontFace,
    b"font-family: Demo; src: url(font.woff2); font-weight: bold!important",
    &limits,
  )
  run Testing.expect(
    face.length() == 2 && (run valueIs(&face, b"font-weight", b"")),
    "font-face descriptor blocks reject important",
  )
}

effect fn protections() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let limits = Limits.make()
  let mut style = run StyleDeclaration.parse(b"width: 3px", &limits)
  style.setReadOnly(true)
  let setter = run Effect.result(style.setProperty(b"unknown", b"", b"invalid", &limits))
  run Testing.expect(
    match &setter {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NoModificationAllowedError
        _ => false
      }
      _ => false
    },
    "read-only check precedes all setter early exits",
  )
  let removal = run Effect.result(style.removeProperty(b"unknown"))
  run Testing.expect(
    match &removal {
      Result<Bytes, CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NoModificationAllowedError
        _ => false
      }
      _ => false
    },
    "read-only missing-property removal throws",
  )
  let replacement = run Effect.result(style.setCssText(b"", &limits))
  run Testing.expect(
    match &replacement {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NoModificationAllowedError
        _ => false
      }
      _ => false
    },
    "read-only cssText replacement throws",
  )
  style.setReadOnly(false)
  let mut bounded = Limits.make()
  bounded.maxDeclarations = 1
  let failure = run Effect.result(style.setProperty(b"overflow", b"hidden", b"", &bounded))
  run Testing.expect(
    match &failure {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.DeclarationLimit
        _ => false
      }
      _ => false
    },
    "expanded declaration count obeys checked limits",
  )
  run Testing.expect(
    run textIs(&style, b"width: 3px;"),
    "resource failure leaves the previous block intact",
  )
}

test effect fn cssomDeclarationMutation() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mutation() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarationShorthands() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shorthands() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarationCustomAndPending() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run customAndPending() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarationAnimationAndDescriptors() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run animationsAndModes() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomDeclarationProtectionAndAtomicity() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run protections() |> Effect.provideMut<Allocator>(&mut allocator)
}
