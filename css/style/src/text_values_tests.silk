effect fn computedNumeric(
  property: Property,
  target: Property,
  source: &[u8],
  context: &Context,
  basis: f64,
  expected: f64,
) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut numerics = Store.make()
  let parsed = run text_values.parse(&mut numerics, property, &input, &mut cursor, false)
  match &parsed {
    Option<TextValue>.Some { value } => {
      run Testing.expect(cursor.done(&input), "numeric computation fixture consumes its grammar")
      let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
      let colorContext = ColorContext.make(black, [black; 19])

      // These tests do not request a system font. No host font is consulted.
      let systems: [TextValue; 6] = [
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
      ]
      let computed = run text_values.compute(
        &value,
        &mut numerics,
        context,
        &colorContext,
        &systems,
      )
      let mut found = false
      let mut i: usize = 0
      while i < computed.items.length() {
        let item = &computed.items.asSlice()[i]
        if item.property == target {
          match &item.atom {
            Atom.Numeric { value: id } => {
              found = true
              let actual = dimensions.evaluate(&numerics, id, basis)
              run Testing.expect(
                actual > expected - 0.000001 && actual < expected + 0.000001,
                "computed numeric value matches normative context",
              )
            }
            _ => {}
          }
        }
        i = i + 1
      }
      run Testing.expect(found, "computed longhand contains its typed numeric result")
    }
    _ => {
      run Testing.expect(false, "numeric computation fixture parses")
    }
  }
}

// https://www.w3.org/TR/css-fonts-4/#font-size-prop
// https://www.w3.org/TR/css-fonts-4/#font-prop
// https://www.w3.org/TR/css-fonts-4/#font-width-prop
// https://www.w3.org/TR/css-inline-3/#propdef-baseline-shift
// https://www.w3.org/TR/css-text-3/#propdef-letter-spacing
test effect fn fontAndInlineMetricDependencies() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut context = Context.make(640.0, 480.0, 10.0)
  context.parentFontSize = 20.0
  context.parentFontWeight = 700.0
  run computedNumeric(Property.FontSize, Property.FontSize, b"150%", &context, 0.0, 30.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.FontSize, Property.FontSize, b"calc(2em + 3px)", &context, 0.0, 43.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.Font, Property.LineHeight, b"150%/120% serif", &context, 0.0, 36.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.FontWeight, Property.FontWeight, b"lighter", &context, 0.0, 400.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(
    Property.FontWidth,
    Property.FontWidth,
    b"semi-condensed",
    &context,
    100.0,
    87.5,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.LetterSpacing, Property.LetterSpacing, b"normal", &context, 0.0, 0.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.BaselineShift, Property.BaselineShift, b"20%", &context, 50.0, 10.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run computedNumeric(Property.LineHeight, Property.LineHeight, b"calc(-2)", &context, 0.0, 0.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// https://www.w3.org/TR/css-fonts-4/#font-feature-settings-prop
test effect fn featureMapLastWinsAndSorts() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let buffer = run lexer.tokenize(b"'zzzz' 1, 'aaaa' calc(1.5), 'zzzz' off", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut numerics = Store.make()
  let parsed = run text_values.parse(
    &mut numerics,
    Property.FontFeatureSettings,
    &input,
    &mut cursor,
    false,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  match &parsed {
    Option<TextValue>.Some { value } => {
      run Testing.expect(cursor.done(&input), "feature calc() is a valid integer value")
      let black = Color.srgb(0.0, 0.0, 0.0, 1.0)
      let colorContext = ColorContext.make(black, [black; 19])
      let context = Context.make(640.0, 480.0, 16.0)
      let systems: [TextValue; 6] = [
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
        TextValue.make(Property.Font),
      ]
      let computed = run text_values.compute(
        &value,
        &mut numerics,
        &context,
        &colorContext,
        &systems,
      )
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(computed.items.length() == 2, "computed features deduplicate")
      run Testing.expect(
        match &computed.items.asSlice()[0].atom {
          Atom.Setting { tag, value: id } => tag == 1633771873
            && dimensions.evaluate(&numerics, id, 0.0) == 2.0
          _ => false
        },
        "aaaa sorts first and CSS integer calc rounds ties upward",
      )
      run Testing.expect(
        match &computed.items.asSlice()[1].atom {
          Atom.Setting { tag, value: id } => tag == 2054847098
            && dimensions.evaluate(&numerics, id, 0.0) == 0.0
          _ => false
        },
        "last zzzz setting supersedes the earlier enabled value",
      )
    }
    _ => {
      run Testing.expect(false, "feature map fixture parses")
    }
  }
}

