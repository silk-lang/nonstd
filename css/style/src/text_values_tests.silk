//! Normative grammar boundaries; all anchors occur in the pinned specification bytes.
import lexer
import text_values { TextValue, Atom, Keyword }
import dimensions { Store, Context }
import text_values
import dimensions
import colors { Color, Context as ColorContext }
import properties { Property }
import input { Input }
import value_cursor { Cursor }
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn accepts(property: Property, source: &[u8], expected: bool) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut numerics = Store.make()
  let parsed = run text_values.parse(&mut numerics, property, &input, &mut cursor, false)
  let valid = match &parsed {
    Option<TextValue>.Some { value } => cursor.done(&input)
    _ => false
  }
  run Testing.expect(valid == expected, "font/text grammar acceptance")
}

// Pinned CSS Text4 106c5cd086ab23b0edea5aa3ff6876b61cc623154f728aa269b74f0527dba19d:
// https://www.w3.org/TR/css-text-4/#white-space-property
// https://www.w3.org/TR/css-text-4/#propdef-white-space-collapse
// https://www.w3.org/TR/css-text-4/#white-space-trim
// https://www.w3.org/TR/css-text-4/#text-wrap-mode
test effect fn whitespaceText4Grammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run accepts(Property.WhiteSpaceCollapse, b"preserve-spaces", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceCollapse, b"discard", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceCollapse, b"normal", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.TextWrapMode, b"wrap", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.TextWrapMode, b"balance", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceTrim, b"discard-inner discard-before discard-after", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceTrim, b"discard-after discard-before", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceTrim, b"none discard-before", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpaceTrim, b"discard-after discard-after", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"nowrap preserve-spaces discard-after discard-before", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"discard-inner discard-before wrap break-spaces", true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"none", true) |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"normal nowrap", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"pre discard-before", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"collapse preserve", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"wrap nowrap", false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run accepts(Property.WhiteSpace, b"", false) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn whitespaceExpansion(source: &[u8], collapse: Keyword, wrapping: Keyword) -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(source, &Limits.make())
  let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut cursor = Cursor.make(&input)
  let mut numerics = Store.make()
  let parsed = run text_values.parse(&mut numerics, Property.WhiteSpace, &input, &mut cursor, false)
  match &parsed {
    Option<TextValue>.Some { value } => {
      run Testing.expect(
        cursor.done(&input) && value.items.length() == 3,
        "white-space expands into exactly three longhands",
      )
      let targets = [Property.WhiteSpaceCollapse, Property.TextWrapMode, Property.WhiteSpaceTrim]
      let expected = [collapse, wrapping, Keyword.None]
      let mut i: usize = 0
      while i < targets.length {
        let item = value.items.asSlice()[i]
        run Testing.expect(
          item.property == targets[i]
            && match &item.atom {
              Atom.Keyword { value: k } => k == expected[i]
              _ => false
            },
          "canonical expansion resets omitted longhands",
        )
        i = i + 1
      }
    }
    _ => {
      run Testing.expect(false, "legacy whitespace spelling parses as shorthand")
    }
  }
}

// https://www.w3.org/TR/css-text-4/#white-space-property (normative keyword mapping).
test effect fn whitespaceLegacyExpansion() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run whitespaceExpansion(b"normal", Keyword.Collapse, Keyword.Wrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run whitespaceExpansion(b"pre", Keyword.Preserve, Keyword.Nowrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run whitespaceExpansion(b"pre-wrap", Keyword.Preserve, Keyword.Wrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run whitespaceExpansion(b"pre-line", Keyword.PreserveBreaks, Keyword.Wrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run whitespaceExpansion(b"nowrap", Keyword.Collapse, Keyword.Nowrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run whitespaceExpansion(b"break-spaces", Keyword.BreakSpaces, Keyword.Wrap)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

