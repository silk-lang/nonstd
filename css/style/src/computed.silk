//! Immutable computed styles. Source buffers and declarations remain caller-owned.
import cascade { Declaration, Candidate, Target, Specified, Priority }
import cascade
import variables { VariableStore, ScopeId }
import variables
import properties { Property, InitialKind }
import properties
import values { Store, Value, ValueId, Wide, Mode, ComputeContext, Range, Basis, Paint, Fallback }
import values
import computed_projection
import computed_queries
import dimensions { Context, Unit }
import dimensions
import colors { Color, Identity, SystemColor, Context as ColorContext }
import colors
import text_values { TextValue, Atom }
import value_keywords { Keyword }
import tokens { TokenBuffer, PreparedSheet, Limits, CssError }
import input { Input, TokenRef }
import lexer
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.num.u32
import silk.num.usize
import silk.num.u16
import silk.num.u8
import silk.num.u64
import silk.num.f64
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct StyleId {
  pub index: usize
}

impl Copy for StyleId {}

/// The value handle is immutable. Text values contain only the requested longhand.
/// Mask values share immutable compound storage; use maskItem/borderItem to project.
pub struct ComputedValue {
  pub value: ValueId,
  pub property: Property,
  pub sourceProperty: Property,
  pub sourceBuffer: Option<usize>,
}

impl Copy for ComputedValue {}

/// Font metrics in dimensions describe the selected face at dimensions.fontSize.
/// They are scaled to the cascaded size, never replaced by invented OS metrics.
/// For rem/rex/etc, the engine supplies the actual computed root metrics.
/// Rebuild with a new host snapshot after font matching; old StyleIds remain valid.
/// Change revision when host palette, initial font configuration, or system fonts change.
pub struct HostContext<'a> {
  pub dimensions: Context,
  pub colors: colors.Context,
  pub systemFonts: &'a [TextValue; 6],
  pub fontFamily: ValueId,
  pub revision: usize,
}

// A ComputedValue packed into 12 bytes (value u32.MAX = absent), so a style's
// 172 entries stay small to build, copy and scan.
struct Entry {
  value: u32,
  buffer: u32,
  property: Property,
  sourceProperty: Property,
}

impl Copy for Entry {}

fn absent() -> Entry {
  return Entry {
    value: u32.MAX,
    buffer: u32.MAX,
    property: Property.Color,
    sourceProperty: Property.Color,
  }
}

fn pack(value: ComputedValue) -> Entry {
  let buffer = match &value.sourceBuffer {
    Option<usize>.Some { value: index } => usize.toU32(index)
    _ => u32.MAX
  }
  return Entry {
    value: usize.toU32(value.value.index),
    buffer: buffer,
    property: value.property,
    sourceProperty: value.sourceProperty,
  }
}

fn unpack(entry: Entry) -> Option<ComputedValue> {
  if entry.value == u32.MAX {
    return Option<ComputedValue>.None
  }
  let buffer = if entry.buffer == u32.MAX {
    Option<usize>.None
  } else {
    Option<usize>.some(u32.toUsize(entry.buffer))
  }
  return Option<ComputedValue>.some(
    ComputedValue {
      value: ValueId { index: u32.toUsize(entry.value) },
      property: entry.property,
      sourceProperty: entry.sourceProperty,
      sourceBuffer: buffer,
    },
  )
}

struct Style {
  entries: [Entry; 172],
  scope: ScopeId,
  dimensions: Context,
  root: StyleId,
  // Hash of everything a child's build reads from this style (see inheritKey).
  inheritKey: u64,
}

// A built style that a later build with the same inputs can return instead (see sharedStyle).
struct Shared {
  style: usize,
  parent: usize,
  candidates: usize,
  count: usize,
}

impl Copy for Shared {}

struct Resolved {
  declaration: usize,
  value: Option<ValueId>,
  wide: Wide,
  compound: Option<ValueId>,
}

impl Copy for Resolved {}

pub struct Engine {
  pub values: Store,
  pub variables: VariableStore,
  styles: List<Style>,
  // Cached initial ValueId indices, u32.MAX until computed.
  initialSpecified: [u32; 172],
  initialComputed: [u32; 172],
  // Initials computed once for every host (see Initials); they survive a revision change.
  contextFree: [bool; 172],
  revision: Option<usize>,
  // Canonical longhands some candidate of the style being built declares;
  // resolve skips the cascade scan for the rest.
  covered: [bool; 172],
  // The canonical single longhands in properties.all() order, with their
  // entry index and whether they inherit.
  slots: [Slot; 172],
  slotCount: usize,
  // Entry indices of the inherited slots, and the cached initial value of
  // every plain-initial slot (absent until defaultValue computes it). A new
  // style starts from these, so only declared or uncached slots run resolve.
  inheritedIndices: [u16; 172],
  inheritedCount: usize,
  initialEntries: [Entry; 172],
  // Slot positions whose initial entry was absent when last listed, ascending: with the
  // declared slots, the only ones a new style can leave unset. Relisted when stale.
  pendingSlots: [u8; 172],
  pendingCount: usize,
  pendingStale: bool,
  // The slot position of each entry index, u8.MAX for entries without a slot.
  slotPositions: [u8; 172],
  // Styles by the hash of their build inputs, with the candidates they were built from.
  shareKeys: HashMap<u64, usize>,
  shared: List<Shared>,
  sharedCandidates: List<Candidate>,
}

struct Slot {
  property: Property,
  index: u16,
  inherited: bool,
}

impl Copy for Slot {}

fn inheritedTable(slots: &[Slot; 172], slotCount: usize, count: &mut usize) -> [u16; 172] {
  let mut indices: [u16; 172] = [0; 172]
  let mut i: usize = 0
  while i < slotCount {
    if slots[i].inherited {
      indices[count.*] = slots[i].index
      count.* = count.* + 1
    }
    i = i + 1
  }
  return indices
}

fn slotTable(count: &mut usize) -> [Slot; 172] {
  let mut slots = [Slot { property: Property.Color, index: 0, inherited: false }; 172]
  let all = properties.all()
  let mut i: usize = 0
  while i < all.length {
    let property = all[i]
    if properties.canonical(property) == property && properties.longhandCount(property) == 1 {
      slots[count.*] = Slot {
        property: property,
        index: usize.toU16(properties.index(property)),
        inherited: properties.inherited(property),
      }
      count.* = count.* + 1
    }
    i = i + 1
  }
  return slots
}

/// The catalog's initial values parsed once, for engines of many documents to start from
/// (see [`Engine.makeWith`]). Initials whose values point at a path or ICC colour stay out and
/// are parsed per document, as without this.
pub struct Initials {
  values: Store,
  specified: [u32; 172],
  // Initials whose computed value is the specified one in any context.
  contextFree: [bool; 172],
  // Stylesheets every document adds (see prepareSheet), already tokenized.
  sheets: List<PreparedSheet>,
}

impl Initials {
  pub effect fn make(limits: &Limits) -> Initials
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut store = Store.make()
    let mut specified: [u32; 172] = [u32.MAX; 172]
    let mut contextFree: [bool; 172] = [false; 172]
    let all = properties.all()
    let mut i: usize = 0
    while i < all.length {
      let property = all[i]
      let kind = properties.initialKind(property)
      if kind != InitialKind.HostFontFamily && kind != InitialKind.Shorthand {
        let mark = store.mark()
        let parsed = run Effect.catch<CssError>(
          parseInitial(&mut store, property, limits),
          unparsed,
        )
        let mut kept = false
        if let Option<ValueId>.Some { value } = parsed {
          if store.simpleSince(mark) {
            let index = properties.index(property)
            specified[index] = usize.toU32(value.index)
            contextFree[index] = run unchangedWhenComputed(&mut store, value, property)
            kept = true
          }
        }
        if !kept {
          store.truncate(mark)
        }
      }
      i = i + 1
    }
    return Initials {
      values: move store,
      specified: specified,
      contextFree: contextFree,
      sheets: List<PreparedSheet>.make(),
    }
  }

  /// Tokenizes a stylesheet that every document adds, so each catalog starts from a copy of
  /// its tokens instead of tokenizing it again (see [`Initials.copySheets`]).
  pub effect fn prepareSheet(self: &mut Initials, bytes: &[u8], limits: &Limits) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    run self.sheets.append(PreparedSheet.make(run lexer.tokenize(bytes, limits)))
  }

  pub effect fn copySheets(self: &Initials) -> List<PreparedSheet>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut sheets = run List<PreparedSheet>.makeWithCapacity(self.sheets.length())
    let mut i: usize = 0
    while i < self.sheets.length() {
      run sheets.append(run self.sheets.asSlice()[i].copy())
      i = i + 1
    }
    return move sheets
  }
}

// Whether computing `id` returns it unchanged under two unrelated contexts (sizes, viewport,
// writing mode and palette all differ), so its computed value needs no context. Whatever the
// probes add to the store is dropped.
effect fn unchangedWhenComputed(store: &mut Store, id: ValueId, property: Property) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mark = store.mark()
  let fonts = [
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
    TextValue.make(Property.Font),
  ]
  let mut same = true
  let mut probe: usize = 0
  while probe < 2 && same {
    let mut dimensions = if probe == 0 {
      Context.make(300.0, 150.0, 16.0)
    } else {
      Context.make(1234.5, 77.25, 37.5)
    }
    dimensions.vertical = probe == 1
    let shade: f64 = if probe == 0 {
      0.0
    } else {
      0.75
    }
    let host = Color.srgb(shade, 1.0 - shade, 0.5, 1.0)
    let palette = ColorContext.make(
      if property == Property.Color {
        host
      } else {
        Color.current()
      },
      [host; 19],
    )
    let computeContext = ComputeContext {
      dimensions: dimensions,
      colors: palette,
      systemFonts: &fonts,
    }
    let computed = run computeValue(&mut store.*, id, property, &computeContext)
    same = computed.index == id.index
    probe = probe + 1
  }
  store.truncate(mark)
  return same
}

effect fn parseInitial(store: &mut Store, property: Property, limits: &Limits) -> Option<ValueId>
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(properties.initial(property), limits)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  return run values.parse(&mut store.*, property, &source, Mode.Css)
}

// An initial over the limits is left to each document, which reports it as before.
effect fn unparsed(error: CssError) -> Option<ValueId> {
  drop error
  return Option<ValueId>.None
}

impl Engine {
  /// An engine whose value store starts with the parsed initial values of `initials`.
  pub effect fn makeWith(closingBuffer: usize, initials: &Initials) -> Engine
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut engine = Engine.make(closingBuffer)
    engine.values = run initials.values.copy()
    engine.initialSpecified = initials.specified
    engine.contextFree = initials.contextFree
    return move engine
  }

  pub fn make(closingBuffer: usize) -> Engine {
    let mut slotCount: usize = 0
    let slots = slotTable(&mut slotCount)
    let mut inheritedCount: usize = 0
    let inheritedIndices = inheritedTable(&slots, slotCount, &mut inheritedCount)
    let mut slotPositions: [u8; 172] = [u8.MAX; 172]
    let mut k: usize = 0
    while k < slotCount {
      slotPositions[u16.toUsize(slots[k].index)] = usize.wrappingToU8(k)
      k = k + 1
    }
    return Engine {
      slots: slots,
      slotCount: slotCount,
      inheritedIndices: inheritedIndices,
      inheritedCount: inheritedCount,
      initialEntries: [absent(); 172],
      pendingSlots: [0; 172],
      pendingCount: 0,
      pendingStale: true,
      slotPositions: slotPositions,
      shareKeys: HashMap<u64, usize>.make(Hash.seed(0)),
      shared: List<Shared>.make(),
      sharedCandidates: List<Candidate>.make(),
      values: Store.make(),
      variables: VariableStore.make(closingBuffer),
      styles: List<Style>.make(),
      initialSpecified: [u32.MAX; 172],
      initialComputed: [u32.MAX; 172],
      contextFree: [false; 172],
      covered: [false; 172],
      revision: Option<usize>.None,
    }
  }

  // Whitespace layout queries use the three Text4 longhands, never WhiteSpace.
  // Resolve the returned ValueId through values.get: Value.Text contains only
  // Atom.Keyword entries tagged with that longhand. Collapse and wrap have one
  // keyword; trim has None or DiscardBefore/DiscardAfter/DiscardInner in that order.
  // These immutable computed values share handles with their specified/inherited values.
  pub fn get(self: &Engine, style: StyleId, property: Property) -> Option<ComputedValue> {
    if style.index >= self.styles.length() {
      return Option<ComputedValue>.None
    }
    return unpack(
      self.styles.asSlice()[style.index].entries[properties.index(properties.canonical(property))],
    )
  }

  /// Reserves room for `count` more styles, so building them copies no style list.
  pub effect fn reserve(self: &mut Engine, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.styles.reserve(count)
  }

  pub fn scope(self: &Engine, style: StyleId) -> Option<ScopeId> {
    if style.index >= self.styles.length() {
      return Option<ScopeId>.None
    }
    return Option<ScopeId>.some(self.styles.asSlice()[style.index].scope)
  }

  pub fn metrics(self: &Engine, style: StyleId) -> Option<Context> {
    if style.index >= self.styles.length() {
      return Option<Context>.None
    }
    return Option<Context>.some(self.styles.asSlice()[style.index].dimensions)
  }

  pub fn number(self: &Engine, style: StyleId, property: Property, basis: f64) -> Option<f64> {
    return match &self.get(style, property) {
      Option<ComputedValue>.Some { value } => values.usedNumber(&self.values, value.value, basis)
      _ => Option<f64>.None
    }
  }

  pub fn textNumber(self: &Engine, style: StyleId, property: Property, basis: f64) -> Option<f64> {
    return match &self.get(style, property) {
      Option<ComputedValue>.Some { value } => textNumber(&self.values, value.value, basis)
      _ => Option<f64>.None
    }
  }

  pub fn maskCount(self: &Engine, style: StyleId, property: Property) -> usize {
    return match &self.get(style, property) {
      Option<ComputedValue>.Some { value } => computed_queries.maskCount(&self.values, value.value)
      _ => 0
    }
  }

  pub fn maskItem<'a>(self: &'a Engine, style: StyleId, property: Property, index: usize) -> Option<
    computed_queries.MaskItem<'a>
  > {
    return match &self.get(style, property) {
      Option<ComputedValue>.Some { value } => computed_queries.maskItem(
        &self.values,
        value.value,
        property,
        index,
      )
      _ => Option<computed_queries.MaskItem<'a>>.None
    }
  }

  pub fn borderItem<'a>(self: &'a Engine, style: StyleId, property: Property) -> Option<
    computed_queries.BorderItem<'a>
  > {
    return match &self.get(style, property) {
      Option<ComputedValue>.Some { value } => computed_queries.borderItem(
        &self.values,
        value.value,
        property,
      )
      _ => Option<computed_queries.BorderItem<'a>>.None
    }
  }

  // Lists the slots whose initial entry is absent (see pendingSlots).
  fn listPending(self: &mut Engine) -> () {
    let mut count: usize = 0
    let mut k: usize = 0
    while k < self.slotCount {
      if self.initialEntries[u16.toUsize(self.slots[k].index)].value == u32.MAX {
        self.pendingSlots[count] = usize.wrappingToU8(k)
        count = count + 1
      }
      k = k + 1
    }
    self.pendingCount = count
    self.pendingStale = false
  }

  // Caches the computed value of every context-free initial, as defaultValue would.
  fn restoreContextFree(self: &mut Engine) -> () {
    let all = properties.all()
    let mut i: usize = 0
    while i < all.length {
      let property = all[i]
      let index = properties.index(property)
      if self.contextFree[index] {
        let value = self.initialSpecified[index]
        self.initialComputed[index] = value
        let kind = properties.initialKind(property)
        if kind != InitialKind.DecorationFill && kind != InitialKind.DecorationStroke
          && properties.canonical(property) == property
          && properties.longhandCount(property) == 1 {
          self.initialEntries[index] = Entry {
            value: value,
            buffer: u32.MAX,
            property: property,
            sourceProperty: property,
          }
          self.pendingStale = true
        }
      }
      i = i + 1
    }
  }

  pub effect fn build(
    self: &mut Engine,
    buffers: &[TokenBuffer],
    declarations: &[Declaration],
    candidates: &[Candidate],
    parent: Option<StyleId>,
    host: &HostContext,
    limits: &Limits,
  ) -> StyleId
    ! CssError | ComputedError | OutOfMemoryError
    ? &mut Allocator {
    let sameRevision = match &self.revision {
      Option<usize>.Some { value } => value == host.revision
      _ => false
    }
    if !sameRevision {
      self.initialComputed = [u32.MAX; 172]
      self.initialEntries = [absent(); 172]
      self.pendingStale = true
      self.restoreContextFree()
      self.revision = Option<usize>.some(host.revision)
      self.shareKeys.clear()
      self.shared.clear()
      self.sharedCandidates.clear()
    }
    if self.pendingStale {
      self.listPending()
    }
    let shareKey = self.shareKey(declarations, candidates, parent)
    if let Option<u64>.Some { value: key } = shareKey {
      if let Option<StyleId>.Some { value: earlier } = self.sharedStyle(
        key,
        declarations,
        candidates,
        parent,
      ) {
        return earlier
      }
    }
    let parentScope = match &parent {
      Option<StyleId>.Some { value } => self.scope(value)
      _ => Option<ScopeId>.None
    }
    let scope = run self.variables.build(buffers, declarations, candidates, parentScope, limits)
    self.covered = [false; 172]
    let mut coveredIndices: [u16; 172] = [0; 172]
    let mut coveredCount: usize = 0
    let mut c: usize = 0
    while c < candidates.length {
      if candidates[c].declaration < declarations.length {
        match &declarations[candidates[c].declaration].target {
          Target.Property { property: source } => {
            let count = properties.longhandCount(source)
            let mut l: usize = 0
            while l < count {
              let index = properties.index(properties.longhandAt(source, l))
              if !self.covered[index] {
                self.covered[index] = true
                coveredIndices[coveredCount] = usize.toU16(index)
                coveredCount = coveredCount + 1
              }
              l = l + 1
            }
          }
          _ => {}
        }
      }
      c = c + 1
    }
    let id = StyleId { index: self.styles.length() }
    let mut metrics = host.dimensions
    let mut root = id
    match &parent {
      Option<StyleId>.Some { value } => {
        if value.index < self.styles.length() {
          let ancestor = &self.styles.asSlice()[value.index]
          root = ancestor.root
          let p = ancestor.dimensions
          metrics.parentFontSize = p.fontSize
          metrics.parentXHeight = p.xHeight
          metrics.parentCapHeight = p.capHeight
          metrics.parentZeroAdvance = p.zeroAdvance
          metrics.parentIdeographAdvance = p.ideographAdvance
          metrics.parentLineHeight = p.lineHeight
          metrics.parentFontWeight = numberOr(
            self.textNumber(value, Property.FontWeight, 0.0),
            400.0,
          )
          metrics.parentFontStretch = numberOr(
            self.textNumber(value, Property.FontWidth, 100.0),
            100.0,
          )
          let r = self.styles.asSlice()[root.index].dimensions
          metrics.rootFontSize = r.fontSize
          metrics.rootXHeight = r.xHeight
          metrics.rootCapHeight = r.capHeight
          metrics.rootZeroAdvance = r.zeroAdvance
          metrics.rootIdeographAdvance = r.ideographAdvance
          metrics.rootLineHeight = r.lineHeight
          metrics.vertical = r.vertical
        }
      }
      _ => {
        // Root font-relative units use initial font metrics while computing font-size.
        let scale = if host.dimensions.fontSize > 0.0 {
          metrics.initialFontSize / host.dimensions.fontSize
        } else {
          0.0
        }
        metrics.parentFontSize = metrics.initialFontSize
        metrics.parentXHeight = host.dimensions.xHeight * scale
        metrics.parentCapHeight = host.dimensions.capHeight * scale
        metrics.parentZeroAdvance = host.dimensions.zeroAdvance * scale
        metrics.parentIdeographAdvance = host.dimensions.ideographAdvance * scale
        metrics.parentLineHeight = host.dimensions.lineHeight * scale
        metrics.parentFontWeight = 400.0
        metrics.parentFontStretch = 100.0
        metrics.rootFontSize = metrics.parentFontSize
        metrics.rootXHeight = metrics.parentXHeight
        metrics.rootCapHeight = metrics.parentCapHeight
        metrics.rootZeroAdvance = metrics.parentZeroAdvance
        metrics.rootIdeographAdvance = metrics.parentIdeographAdvance
        metrics.rootLineHeight = metrics.parentLineHeight
      }
    }
    let mut style = Style {
      entries: self.initialEntries,
      scope: scope,
      dimensions: metrics,
      root: root,
      inheritKey: 0,
    }

    // Undeclared inherited longhands take the parent's entry, as
    // defaultValue(Wide.Unset) would; declared ones are resolved below.
    match &parent {
      Option<StyleId>.Some { value } => {
        if value.index < self.styles.length() {
          let inherited = &self.styles.asSlice()[value.index].entries
          let mut n: usize = 0
          while n < self.inheritedCount {
            let index = u16.toUsize(self.inheritedIndices[n])
            n = n + 1
            if inherited[index].value != u32.MAX {
              style.entries[index] = inherited[index]
            }
          }
        }
      }
      _ => {}
    }
    let mut d: usize = 0
    while d < coveredCount {
      style.entries[u16.toUsize(coveredIndices[d])] = absent()
      d = d + 1
    }
    let mut resolved = run List<Resolved>.makeWithCapacity(candidates.length)

    // Dependency boundaries: font-size uses parent metrics; other lengths use the
    // winning current font-size, even when it overrides a font shorthand's size.
    let early = [
      Property.Color,
      Property.WritingMode,
      Property.FontSize,
      Property.FontWeight,
      Property.FontWidth,
    ]
    let mut i: usize = 0
    while i < early.length {
      run resolve(
        &mut self.*,
        &mut style,
        early[i],
        buffers,
        declarations,
        candidates,
        &mut resolved,
        parent,
        host,
        limits,
      )
      if early[i] == Property.WritingMode && root.index == id.index {
        let writing = entryKeyword(&self.values, &style, Property.WritingMode)
        style.dimensions.vertical = match &writing {
          Option<Keyword>.Some { value } => value == Keyword.VerticalRl
            || value == Keyword.VerticalLr
          _ => false
        }
      }
      i = i + 1
    }
    let size = entryNumber(&self.values, &style, Property.FontSize, metrics.initialFontSize)
    let ratio = if host.dimensions.fontSize > 0.0 {
      size / host.dimensions.fontSize
    } else {
      0.0
    }
    style.dimensions.fontSize = size
    style.dimensions.xHeight = host.dimensions.xHeight * ratio
    style.dimensions.capHeight = host.dimensions.capHeight * ratio
    style.dimensions.zeroAdvance = host.dimensions.zeroAdvance * ratio
    style.dimensions.ideographAdvance = host.dimensions.ideographAdvance * ratio
    style.dimensions.lineHeight = host.dimensions.lineHeight * ratio
    if root.index == id.index {
      style.dimensions.rootFontSize = size
      style.dimensions.rootXHeight = style.dimensions.xHeight
      style.dimensions.rootCapHeight = style.dimensions.capHeight
      style.dimensions.rootZeroAdvance = style.dimensions.zeroAdvance
      style.dimensions.rootIdeographAdvance = style.dimensions.ideographAdvance
    }
    run resolve(
      &mut self.*,
      &mut style,
      Property.LineHeight,
      buffers,
      declarations,
      candidates,
      &mut resolved,
      parent,
      host,
      limits,
    )
    match &unpack(style.entries[properties.index(Property.LineHeight)]) {
      Option<ComputedValue>.Some { value } => match &self.values.get(value.value).* {
        Value.Text { value: text } => {
          if text.items.length() > 0 {
            match &text.items.asSlice()[0].atom {
              Atom.Numeric { value: expression } => {
                let number = dimensions.evaluate(&self.values.numerics, expression, size)
                style.dimensions.lineHeight = if dimensions.numberResult(
                  &self.values.numerics,
                  expression,
                ) {
                  number * size
                } else {
                  number
                }
              }
              _ => {}
            }
          }
        }
        _ => {}
      }
      _ => {}
    }
    if root.index == id.index {
      style.dimensions.rootLineHeight = style.dimensions.lineHeight
    }

    // Only pending and declared slots can still be unset; visit them in slot order.
    let mut declaredSlots: [u8; 172] = [0; 172]
    let mut declaredCount: usize = 0
    d = 0
    while d < coveredCount {
      let position = self.slotPositions[u16.toUsize(coveredIndices[d])]
      d = d + 1
      if position == u8.MAX {
        continue
      }
      let mut at = declaredCount
      while at > 0 && declaredSlots[at - 1] > position {
        declaredSlots[at] = declaredSlots[at - 1]
        at = at - 1
      }
      declaredSlots[at] = position
      declaredCount = declaredCount + 1
    }
    let mut p: usize = 0
    let mut q: usize = 0
    while p < self.pendingCount || q < declaredCount {
      let k = if q >= declaredCount
        || (p < self.pendingCount && self.pendingSlots[p] <= declaredSlots[q]) {
        let next = self.pendingSlots[p]
        p = p + 1
        if q < declaredCount && declaredSlots[q] == next {
          q = q + 1
        }
        next
      } else {
        let next = declaredSlots[q]
        q = q + 1
        next
      }
      let slot = self.slots[u8.toUsize(k)]
      let index = u16.toUsize(slot.index)
      if style.entries[index].value != u32.MAX {
        continue
      }

      run resolve(
        &mut self.*,
        &mut style,
        slot.property,
        buffers,
        declarations,
        candidates,
        &mut resolved,
        parent,
        host,
        limits,
      )
    }
    run computeOverflow(&mut self.*, &mut style)
    style.inheritKey = match &parent {
      Option<StyleId>.Some { value } => self.childInheritKey(
        &style,
        value,
        &coveredIndices,
        coveredCount,
      )
      _ => self.inheritKey(&style)
    }
    run self.styles.append(move style)
    if let Option<u64>.Some { value: key } = shareKey {
      if let Option<StyleId>.Some { value: from } = parent {
        let record = Shared {
          style: id.index,
          parent: from.index,
          candidates: self.sharedCandidates.length(),
          count: candidates.length,
        }
        run self.sharedCandidates.appendSlice(candidates)
        drop run self.shareKeys.insert(key, self.shared.length())
        run self.shared.append(record)
      }
    }
    return id
  }

  // A child's build reads its parent's inherited entries, scope, root and the font metrics
  // copied into its own; nothing else of the parent unless a declaration says inherit, and
  // such builds are not shared.
  fn inheritKey(self: &Engine, style: &Style) -> u64 {
    let mut hash: u64 = 14695981039346656037
    let mut n: usize = 0
    while n < self.inheritedCount {
      let entry = style.entries[u16.toUsize(self.inheritedIndices[n])]
      hash = mix(hash, u32.toU64(entry.value) | u64.shiftLeft(u32.toU64(entry.buffer), 32))
      n = n + 1
    }
    hash = mix(hash, usize.toU64(style.scope.index))
    hash = mix(hash, usize.toU64(style.root.index))
    hash = mix(hash, f64.toBits(style.dimensions.fontSize))
    hash = mix(hash, f64.toBits(style.dimensions.lineHeight))
    return mix(hash, f64.toBits(style.dimensions.xHeight))
  }

  // inheritKey for a child of `parent`: its undeclared inherited entries are the parent's,
  // so only the declared ones are mixed into the parent's key. Equal inputs reached through
  // different declarations may hash differently, which only forgoes sharing.
  fn childInheritKey(
    self: &Engine,
    style: &Style,
    parent: StyleId,
    covered: &[u16; 172],
    coveredCount: usize,
  ) -> u64 {
    if parent.index >= self.styles.length() {
      return self.inheritKey(style)
    }
    let mut hash = self.styles.asSlice()[parent.index].inheritKey
    let mut d: usize = 0
    while d < coveredCount {
      let index = u16.toUsize(covered[d])
      let position = self.slotPositions[index]
      if position != u8.MAX && self.slots[u8.toUsize(position)].inherited {
        let entry = style.entries[index]
        hash = mix(
          mix(hash, usize.toU64(index)),
          u32.toU64(entry.value) | u64.shiftLeft(u32.toU64(entry.buffer), 32),
        )
      }
      d = d + 1
    }
    hash = mix(hash, usize.toU64(style.scope.index))
    hash = mix(hash, f64.toBits(style.dimensions.fontSize))
    hash = mix(hash, f64.toBits(style.dimensions.lineHeight))
    return mix(hash, f64.toBits(style.dimensions.xHeight))
  }

  // The hash of a build's inputs when another build with equal inputs would give the same
  // style: a parent, and only parsed property declarations (no var(), wide keywords or
  // custom properties, which read more of the parent or make a scope).
  fn shareKey(
    self: &Engine,
    declarations: &[Declaration],
    candidates: &[Candidate],
    parent: Option<StyleId>,
  ) -> Option<u64> {
    let from = match &parent {
      Option<StyleId>.Some { value } => value
      _ => {
        return Option<u64>.None
      }
    }
    if from.index >= self.styles.length() {
      return Option<u64>.None
    }
    let mut hash = mix(14695981039346656037, self.styles.asSlice()[from.index].inheritKey)
    let mut c: usize = 0
    while c < candidates.length {
      let candidate = candidates[c]
      if candidate.declaration >= declarations.length {
        return Option<u64>.None
      }
      let declaration = declarations[candidate.declaration]
      let property = match &declaration.target {
        Target.Property { property } => property
        _ => {
          return Option<u64>.None
        }
      }
      let value = match &declaration.specified {
        Specified.Parsed { value } => value
        _ => {
          return Option<u64>.None
        }
      }
      hash = mix(hash, usize.toU64(properties.index(property)))
      hash = mix(
        hash,
        usize.toU64(value.index) | u64.shiftLeft(usize.toU64(declaration.buffer), 32),
      )
      hash = mix(
        hash,
        usize.toU64(
          candidate.priority.specificity.ids * 4096 + candidate.priority.specificity.classes * 64
            + candidate.priority.specificity.types,
        ),
      )
      c = c + 1
    }
    return Option<u64>.some(hash)
  }

  // The earlier style for `key` when its build inputs equal these (see shareKey).
  fn sharedStyle(
    self: &Engine,
    key: u64,
    declarations: &[Declaration],
    candidates: &[Candidate],
    parent: Option<StyleId>,
  ) -> Option<StyleId> {
    let record = match &self.shareKeys.get(key) {
      Option<usize>.Some { value } => self.shared.asSlice()[value]
      _ => {
        return Option<StyleId>.None
      }
    }
    let from = match &parent {
      Option<StyleId>.Some { value } => value.index
      _ => {
        return Option<StyleId>.None
      }
    }
    if record.count != candidates.length || !self.sameInheritance(record.parent, from) {
      return Option<StyleId>.None
    }
    let earlier = Slice.view<Candidate>(
      self.sharedCandidates.asSlice(),
      record.candidates,
      record.count,
    )
    let mut c: usize = 0
    while c < candidates.length {
      let a = earlier[c]
      let b = candidates[c]
      if !sameDeclaration(declarations[a.declaration], declarations[b.declaration])
        || !samePriority(a.priority, b.priority) {
        return Option<StyleId>.None
      }

      // Document order only breaks ties, so it must compare the same way for every pair.
      let mut d: usize = 0
      while d < c {
        let earlierA = earlier[d].priority.order
        let earlierB = candidates[d].priority.order
        if (a.priority.order < earlierA) != (b.priority.order < earlierB)
          || (a.priority.order == earlierA) != (b.priority.order == earlierB) {
          return Option<StyleId>.None
        }
        d = d + 1
      }
      c = c + 1
    }
    return Option<StyleId>.some(StyleId { index: record.style })
  }

  // Whether children of styles `a` and `b` read the same inputs from them (see inheritKey).
  fn sameInheritance(self: &Engine, a: usize, b: usize) -> bool {
    if a == b {
      return true
    }
    let first = &self.styles.asSlice()[a]
    let second = &self.styles.asSlice()[b]
    if first.scope.index != second.scope.index || first.root.index != second.root.index {
      return false
    }
    let x = first.dimensions
    let y = second.dimensions
    if x.fontSize != y.fontSize || x.xHeight != y.xHeight || x.capHeight != y.capHeight
      || x.zeroAdvance != y.zeroAdvance
      || x.ideographAdvance != y.ideographAdvance
      || x.lineHeight != y.lineHeight {
      return false
    }
    let mut n: usize = 0
    while n < self.inheritedCount {
      let index = u16.toUsize(self.inheritedIndices[n])
      let p = first.entries[index]
      let q = second.entries[index]
      if p.value != q.value || p.buffer != q.buffer || p.property != q.property
        || p.sourceProperty != q.sourceProperty {
        return false
      }
      n = n + 1
    }
    return true
  }
}

fn mix(hash: u64, value: u64) -> u64 {
  return u64.wrappingMultiply(hash ^ value, 1099511628211)
}

fn sameDeclaration(a: Declaration, b: Declaration) -> bool {
  let same = match &a.target {
    Target.Property { property: first } => match &b.target {
      Target.Property { property: second } => first == second
      _ => false
    }
    _ => false
  }
  let value = match &a.specified {
    Specified.Parsed { value: first } => match &b.specified {
      Specified.Parsed { value: second } => first.index == second.index
      _ => false
    }
    _ => false
  }
  return same && value && a.buffer == b.buffer && a.important == b.important
}

// Equal in everything the cascade compares but document order, which sharedStyle compares
// pairwise.
fn samePriority(a: Priority, b: Priority) -> bool {
  return a.origin == b.origin && a.important == b.important
    && a.encapsulationDepth == b.encapsulationDepth
    && a.specificity.ids == b.specificity.ids
    && a.specificity.classes == b.specificity.classes
    && a.specificity.types == b.specificity.types
    && a.inline == b.inline
}

fn numberOr(value: Option<f64>, fallback: f64) -> f64 {
  return match &value {
    Option<f64>.Some { value: number } => number
    _ => fallback
  }
}

fn textNumber(store: &Store, id: ValueId, basis: f64) -> Option<f64> {
  return match &store.get(id).* {
    Value.Text { value } => {
      let mut i: usize = 0
      while i < value.items.length() {
        match &value.items.asSlice()[i].atom {
          Atom.Numeric { value: expression } => {
            return Option<f64>.some(dimensions.evaluate(&store.numerics, expression, basis))
          }
          _ => {}
        }
        i = i + 1
      }
      Option<f64>.None
    }
    _ => Option<f64>.None
  }
}

fn entryNumber(store: &Store, style: &Style, property: Property, fallback: f64) -> f64 {
  return match &unpack(style.entries[properties.index(property)]) {
    Option<ComputedValue>.Some { value } => numberOr(textNumber(store, value.value, 0.0), fallback)
    _ => fallback
  }
}

fn entryKeyword(store: &Store, style: &Style, property: Property) -> Option<Keyword> {
  return match &unpack(style.entries[properties.index(property)]) {
    Option<ComputedValue>.Some { value } => match &store.get(value.value).* {
      Value.Keyword { keyword } => Option<Keyword>.some(keyword)
      _ => Option<Keyword>.None
    }
    _ => Option<Keyword>.None
  }
}

fn context<'a>(
  style: &Style,
  property: Property,
  host: &HostContext<'a>,
  inheritedColor: Color,
) -> ComputeContext<'a> {
  let mut palette = host.colors

  // Preserve currentColor in all properties other than color itself.
  palette.currentColor = if property == Property.Color {
    inheritedColor
  } else {
    Color.current()
  }
  return ComputeContext {
    dimensions: style.dimensions,
    colors: palette,
    systemFonts: host.systemFonts,
  }
}

fn parentColor(engine: &Engine, parent: Option<StyleId>, host: &HostContext) -> Color {
  match &parent {
    Option<StyleId>.Some { value: style } => match &engine.get(style, Property.Color) {
      Option<ComputedValue>.Some { value } => match &engine.values.get(value.value).* {
        Value.Color { color } => {
          return color
        }
        _ => {}
      }
      _ => {}
    }
    _ => {}
  }
  return host.colors.system[colors.systemIndex(SystemColor.CanvasText)]
}

effect fn resolve(
  engine: &mut Engine,
  style: &mut Style,
  property: Property,
  buffers: &[TokenBuffer],
  declarations: &[Declaration],
  candidates: &[Candidate],
  resolved: &mut List<Resolved>,
  parent: Option<StyleId>,
  host: &HostContext,
  limits: &Limits,
) -> ()
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  let index = properties.index(property)
  if style.entries[index].value != u32.MAX {
    return
  }
  let mut excluded: u8 = 0
  while true {
    let winner = if engine.covered[properties.index(properties.canonical(property))] {
      cascade.select(declarations, candidates, property, excluded)
    } else {
      Option<Candidate>.None
    }
    let candidate = match &winner {
      Option<Candidate>.Some { value } => value
      _ => {
        let value = run defaultValue(
          &mut engine.*,
          &mut style.*,
          property,
          Wide.Unset,
          buffers,
          declarations,
          candidates,
          &mut resolved.*,
          parent,
          host,
          limits,
        )
        style.entries[index] = pack(value)
        return
      }
    }
    let declaration = &declarations[candidate.declaration]
    let sourceProperty = match &declaration.target {
      Target.Property { property: source } => source
      _ => property
    }
    let selected = run resolveDeclaration(
      &mut engine.*,
      buffers,
      declaration,
      candidate.declaration,
      style.scope,
      &mut resolved.*,
      limits,
    )
    let specified = match &selected.value {
      Option<ValueId>.Some { value } => value
      _ => {
        if selected.wide == Wide.Revert {
          excluded = excluded | cascade.revertMask(candidate.priority.origin)
          continue
        }
        let value = run defaultValue(
          &mut engine.*,
          &mut style.*,
          property,
          selected.wide,
          buffers,
          declarations,
          candidates,
          &mut resolved.*,
          parent,
          host,
          limits,
        )
        style.entries[index] = pack(value)
        return
      }
    }
    let projected = run computed_projection.project(
      &mut engine.values,
      specified,
      sourceProperty,
      property,
      host.systemFonts,
    )
    let inheritedColor = parentColor(&engine.*, parent, host)
    let computeContext = context(&style.*, property, host, inheritedColor)
    let computed = match &selected.compound {
      Option<ValueId>.Some { value } => value
      _ => run computeValue(&mut engine.values, projected, property, &computeContext)
    }
    let compound = match &engine.values.get(specified).* {
      Value.Effect { value } => true
      _ => false
    }
    if compound {
      let mut cached: usize = 0
      while cached < resolved.length() {
        if resolved.asSlice()[cached].declaration == candidate.declaration {
          let mut entries = resolved.asMutSlice()
          entries[cached].compound = Option<ValueId>.some(computed)
          break
        }
        cached = cached + 1
      }
    }
    if !values.validComputed(&engine.values, computed) {
      let value = run defaultValue(
        &mut engine.*,
        &mut style.*,
        property,
        Wide.Unset,
        buffers,
        declarations,
        candidates,
        &mut resolved.*,
        parent,
        host,
        limits,
      )
      style.entries[index] = pack(value)
      return
    }
    style.entries[index] = pack(
      ComputedValue {
        value: computed,
        property: property,
        sourceProperty: sourceProperty,
        sourceBuffer: Option<usize>.some(declaration.buffer),
      },
    )
    return
  }
}

effect fn resolveDeclaration(
  engine: &mut Engine,
  buffers: &[TokenBuffer],
  declaration: &Declaration,
  index: usize,
  scope: ScopeId,
  cache: &mut List<Resolved>,
  limits: &Limits,
) -> Resolved
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < cache.length() {
    if cache.asSlice()[i].declaration == index {
      return cache.asSlice()[i]
    }
    i = i + 1
  }
  let mut out = Resolved {
    declaration: index,
    value: Option<ValueId>.None,
    wide: Wide.Unset,
    compound: Option<ValueId>.None,
  }
  match &declaration.specified {
    Specified.Wide { keyword } => {
      out.wide = keyword
    }
    Specified.Parsed { value } => {
      out.value = Option<ValueId>.some(value)
    }
    Specified.Pending { range, mode } => {
      let substituted = run engine.variables.substitute(
        buffers,
        scope,
        declaration.buffer,
        range,
        limits,
      )
      match &substituted {
        Option<List<TokenRef>>.Some { value: references } => {
          let source = Input.Expanded { buffers: buffers, references: references.asSlice() }
          let property = match &declaration.target {
            Target.Property { property } => property
            _ => Property.All
          }
          out.value = run values.parse(&mut engine.values, property, &source, mode)
        }
        _ => {}
      }
    }
  }
  match &out.value {
    Option<ValueId>.Some { value } => match &engine.values.get(value).* {
      Value.Wide { keyword } => {
        out.wide = keyword
        out.value = Option<ValueId>.None
      }
      _ => {}
    }
    _ => {}
  }
  run cache.append(out)
  return out
}

effect fn defaultValue(
  engine: &mut Engine,
  style: &mut Style,
  property: Property,
  wide: Wide,
  buffers: &[TokenBuffer],
  declarations: &[Declaration],
  candidates: &[Candidate],
  resolved: &mut List<Resolved>,
  parent: Option<StyleId>,
  host: &HostContext,
  limits: &Limits,
) -> ComputedValue
  ! CssError | ComputedError | OutOfMemoryError
  ? &mut Allocator {
  if wide == Wide.Inherit || (wide == Wide.Unset && properties.inherited(property)) {
    match &parent {
      Option<StyleId>.Some { value } => match &engine.get(value, property) {
        Option<ComputedValue>.Some { value: inherited } => {
          return inherited
        }
        _ => {}
      }
      _ => {}
    }
  }
  let kind = properties.initialKind(property)
  if kind == InitialKind.DecorationFill || kind == InitialKind.DecorationStroke {
    let dependency = if kind == InitialKind.DecorationFill {
      Property.Fill
    } else {
      Property.Stroke
    }
    run resolve(
      &mut engine.*,
      &mut style.*,
      dependency,
      buffers,
      declarations,
      candidates,
      &mut resolved.*,
      parent,
      host,
      limits,
    )
    match &unpack(style.entries[properties.index(dependency)]) {
      Option<ComputedValue>.Some { value } => {
        let mut out = value
        out.property = property
        return out
      }
      _ => {}
    }
  }
  let index = properties.index(property)
  if kind == InitialKind.HostFontFamily {
    return ComputedValue {
      value: host.fontFamily,
      property: property,
      sourceProperty: property,
      sourceBuffer: Option<usize>.None,
    }
  }
  if engine.initialComputed[index] != u32.MAX {
    return ComputedValue {
      value: ValueId { index: u32.toUsize(engine.initialComputed[index]) },
      property: property,
      sourceProperty: property,
      sourceBuffer: Option<usize>.None,
    }
  }
  let specified = if engine.initialSpecified[index] != u32.MAX {
    ValueId { index: u32.toUsize(engine.initialSpecified[index]) }
  } else {
    let buffer = run lexer.tokenize(properties.initial(property), limits)
    let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
    let parsed = run values.parse(&mut engine.values, property, &source, Mode.Css)
    let value = match &parsed {
      Option<ValueId>.Some { value } => value
      _ => {
        // A catalog/grammar disagreement is an integration error, not a default keyword.
        fail ComputedError { property: property }
      }
    }
    engine.initialSpecified[index] = usize.toU32(value.index)
    value
  }
  let inheritedColor = parentColor(&engine.*, parent, host)
  let computeContext = context(&style.*, property, host, inheritedColor)
  let value = run computeValue(&mut engine.values, specified, property, &computeContext)
  engine.initialComputed[index] = usize.toU32(value.index)
  if kind != InitialKind.DecorationFill && kind != InitialKind.DecorationStroke
    && properties.canonical(property) == property
    && properties.longhandCount(property) == 1 {
    engine.initialEntries[index] = Entry {
      value: usize.toU32(value.index),
      buffer: u32.MAX,
      property: property,
      sourceProperty: property,
    }
    engine.pendingStale = true
  }
  return ComputedValue {
    value: value,
    property: property,
    sourceProperty: property,
    sourceBuffer: Option<usize>.None,
  }
}

/// Signals a property-catalog initial that the shared value grammar cannot parse.
pub struct ComputedError {
  pub property: Property
}

effect fn computeValue(
  store: &mut Store,
  id: ValueId,
  property: Property,
  computeContext: &ComputeContext,
) -> ValueId
  ! OutOfMemoryError
  ? &mut Allocator {
  match &store.get(id).* {
    Value.Color { color } => {
      if stableColor(color, property) {
        return id
      }
    }
    Value.IccColor { color, icc } => {
      if stableColor(color, property) {
        return id
      }
    }
    Value.Paint { paint } => {
      let stable = match &paint {
        Paint.Color { color } => stableColor(color, property)
        Paint.IccColor { color, icc } => stableColor(color, property)
        Paint.Server { url, fallback } => match &fallback {
          Fallback.Color { color } => stableColor(color, property)
          Fallback.IccColor { color, icc } => stableColor(color, property)
          _ => true
        }
        _ => true
      }
      if stable {
        return id
      }
    }
    Value.Numeric { expression, range, basis } => {
      if range == Range.UnitInterval && basis == Basis.None {
        // A number already inside (0, 1] is its own computed opacity (see below).
        if let Option<f64>.Some { value: number } = dimensions.numberLiteral(
          &store.numerics,
          expression,
        ) {
          if number > 0.0 && number <= 1.0 {
            return id
          }
        }
      }
      if range != Range.UnitInterval {
        let original = expression
        let computedRange = range
        let percentageBasis = basis
        let result = run dimensions.compute(
          &mut store.numerics,
          original,
          &computeContext.dimensions,
        )
        if result.index == original.index {
          return id
        }
        return run store.add(
          Value.Numeric { expression: result, range: computedRange, basis: percentageBasis },
        )
      }
    }
    _ => {}
  }
  if property == Property.WritingMode {
    match &store.get(id).* {
      Value.Keyword { keyword } => {
        let normalized = match keyword {
          Keyword.Lr => Keyword.HorizontalTb
          Keyword.LrTb => Keyword.HorizontalTb
          Keyword.Rl => Keyword.HorizontalTb
          Keyword.RlTb => Keyword.HorizontalTb
          Keyword.Tb => Keyword.VerticalRl
          Keyword.TbRl => Keyword.VerticalRl
          _ => keyword
        }
        if normalized != keyword {
          return run store.add(Value.Keyword { keyword: normalized })
        }
      }
      _ => {}
    }
  }
  let computed = run values.compute(&mut store.*, id, computeContext)

  // Opacity percentages are numbers, not reference-box-dependent percentages.
  match &store.get(computed).* {
    Value.Numeric { expression, range, basis } => {
      if range == Range.UnitInterval {
        let number = numberOr(values.usedNumber(&store.*, computed, 1.0), 1.0)
        let scalar = run dimensions.literal(&mut store.numerics, number, Unit.Number)
        return run store.add(
          Value.Numeric { expression: scalar, range: Range.UnitInterval, basis: Basis.None },
        )
      }
    }
    _ => {}
  }
  return computed
}

fn stableColor(color: Color, property: Property) -> bool {
  return match &color.identity {
    Identity.Absolute => true
    Identity.CurrentColor => property != Property.Color
    Identity.System { color: systemRole } => false
  }
}

effect fn computeOverflow(engine: &mut Engine, style: &mut Style) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let x = entryKeyword(&engine.values, &style.*, Property.OverflowX)
  let y = entryKeyword(&engine.values, &style.*, Property.OverflowY)
  let horizontal = match &x {
    Option<Keyword>.Some { value } => value
    _ => Keyword.Visible
  }
  let vertical = match &y {
    Option<Keyword>.Some { value } => value
    _ => Keyword.Visible
  }
  let target = if horizontal == Keyword.Visible && vertical != Keyword.Visible {
    Option<Property>.some(Property.OverflowX)
  } else if vertical == Keyword.Visible && horizontal != Keyword.Visible {
    Option<Property>.some(Property.OverflowY)
  } else {
    Option<Property>.None
  }
  match &target {
    Option<Property>.Some { value: property } => {
      let index = properties.index(property)
      match &unpack(style.entries[index]) {
        Option<ComputedValue>.Some { value } => {
          let mut changed = value
          changed.value = run engine.values.add(Value.Keyword { keyword: Keyword.Auto })
          style.entries[index] = pack(changed)
        }
        _ => {}
      }
    }
    _ => {}
  }
}
