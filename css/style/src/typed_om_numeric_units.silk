//! Unit identity and context-free conversion, reusing the CSS Values unit catalog.
import dimensions { Unit, Dimension }
import dimensions
import cssom_numeric_serialization { unitName }
import typed_om_numeric_types { NumericType, BaseType }
import tokens { equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }

pub struct UnitInfo {
  pub name: &'static [u8],
  pub canonical: &'static [u8],
  pub factor: f64,
  pub numericType: NumericType,
}

impl Copy for UnitInfo {}

pub fn lookup(text: &[u8]) -> Option<UnitInfo> {
  if equal(text, b"number") {
    return Option<UnitInfo>.some(
      UnitInfo {
        name: b"number",
        canonical: b"number",
        factor: 1.0,
        numericType: NumericType.number(),
      },
    )
  }
  if equal(text, b"percent") {
    return Option<UnitInfo>.some(
      UnitInfo {
        name: b"percent",
        canonical: b"percent",
        factor: 1.0,
        numericType: NumericType.base(BaseType.Percent),
      },
    )
  }
  if equal(text, b"fr") {
    return Option<UnitInfo>.some(
      UnitInfo {
        name: b"fr",
        canonical: b"fr",
        factor: 1.0,
        numericType: NumericType.base(BaseType.Flex),
      },
    )
  }
  let extra: [&'static [u8]; 6] = [b"cqw", b"cqh", b"cqi", b"cqb", b"cqmin", b"cqmax"]
  let mut i: usize = 0
  while i < 6 {
    if equal(text, extra[i]) {
      return Option<UnitInfo>.some(
        UnitInfo {
          name: extra[i],
          canonical: extra[i],
          factor: 1.0,
          numericType: NumericType.base(BaseType.Length),
        },
      )
    }
    i = i + 1
  }
  let parsed = dimensions.unit(text)
  match &parsed {
    Option<Unit>.Some { value } => {
      let name: &'static [u8] = if equal(text, b"Q") {
        b"Q"
      } else if equal(text, b"Hz") {
        b"Hz"
      } else if equal(text, b"kHz") {
        b"kHz"
      } else {
        unitName(value)
      }

      // Preserve the factory spellings Q/Hz/kHz as well as lowercase CSS tokens.
      if !equal(name, text) {
        return Option<UnitInfo>.None
      }
      let base = match dimensions.dimension(value) {
        Dimension.Length => BaseType.Length
        Dimension.Angle => BaseType.Angle
        Dimension.Time => BaseType.Time
        Dimension.Frequency => BaseType.Frequency
        Dimension.Resolution => BaseType.Resolution
        _ => {
          return Option<UnitInfo>.None
        }
      }
      let canonical: &'static [u8] = match value {
        Unit.Cm => b"px"
        Unit.Mm => b"px"
        Unit.Q => b"px"
        Unit.In => b"px"
        Unit.Pt => b"px"
        Unit.Pc => b"px"
        Unit.Grad => b"deg"
        Unit.Rad => b"deg"
        Unit.Turn => b"deg"
        Unit.Ms => b"s"
        Unit.Hz => b"hz"
        Unit.Khz => b"hz"
        Unit.Dpi => b"dppx"
        Unit.Dpcm => b"dppx"
        Unit.X => b"dppx"
        _ => name
      }
      let factor = match value {
        Unit.Cm => 96.0 / 2.54
        Unit.Mm => 96.0 / 25.4
        Unit.Q => 96.0 / 101.6
        Unit.In => 96.0
        Unit.Pt => 96.0 / 72.0
        Unit.Pc => 16.0
        Unit.Grad => 0.9
        Unit.Rad => 180.0 / 3.141592653589793
        Unit.Turn => 360.0
        Unit.Ms => 0.001
        Unit.Khz => 1000.0
        Unit.Dpi => 1.0 / 96.0
        Unit.Dpcm => 2.54 / 96.0
        _ => 1.0
      }
      return Option<UnitInfo>.some(
        UnitInfo {
          name: name,
          canonical: canonical,
          factor: factor,
          numericType: NumericType.base(base),
        },
      )
    }
    _ => {
      return Option<UnitInfo>.None
    }
  }
}
