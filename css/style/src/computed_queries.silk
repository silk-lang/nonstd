//! Allocation-free longhand views over immutable computed mask storage.
import properties { Property }
import values { Store, Value, ValueId }
import effect_values {
  EffectValue,
  Image,
  MaskMode,
  Size,
  RepeatPair,
  GeometryBox,
  Composite,
  Border,
  BorderMeasure
}
import transform_values { Position }
import dimensions { ExprId }
import silk.core.option { Option }

pub union MaskItem<'a> {
  Image { pub value: &'a Image },
  Mode { pub value: MaskMode },
  Position { pub value: Position },
  Size { pub value: Size },
  Repeat { pub value: RepeatPair },
  Box { pub value: GeometryBox },
  Composite { pub value: Composite },
}

pub union BorderItem<'a> {
  Image { pub value: &'a Image },
  Mode { pub value: MaskMode },
  Slice { pub values: [ExprId; 4], pub fill: bool },
  Width { pub values: [BorderMeasure; 4] },
  Outset { pub values: [ExprId; 4] },
  Repeat { pub value: RepeatPair },
}

pub fn maskCount(store: &Store, id: ValueId) -> usize {
  return match &store.get(id).* {
    Value.Effect { value } => match &value {
      EffectValue.Masks { layers, resetBorder } => layers.length()
      _ => 0
    }
    _ => 0
  }
}

pub fn maskItem<'a>(store: &'a Store, id: ValueId, property: Property, index: usize) -> Option<
  MaskItem<'a>
> {
  match &store.get(id).* {
    Value.Effect { value } => match &value {
      EffectValue.Masks { layers, resetBorder } => {
        if index >= layers.length() {
          return Option<MaskItem<'a>>.None
        }
        let layer = &layers.asSlice()[index]
        return match property {
          Property.MaskImage => Option<MaskItem<'a>>.some(
            MaskItem<'a>.Image { value: &layer.image },
          )
          Property.MaskMode => Option<MaskItem<'a>>.some(MaskItem<'a>.Mode { value: layer.mode })
          Property.MaskPosition => Option<MaskItem<'a>>.some(
            MaskItem<'a>.Position { value: layer.position },
          )
          Property.MaskSize => Option<MaskItem<'a>>.some(MaskItem<'a>.Size { value: layer.size })
          Property.MaskRepeat => Option<MaskItem<'a>>.some(
            MaskItem<'a>.Repeat { value: layer.repeat },
          )
          Property.MaskOrigin => Option<MaskItem<'a>>.some(MaskItem<'a>.Box { value: layer.origin })
          Property.MaskClip => Option<MaskItem<'a>>.some(MaskItem<'a>.Box { value: layer.clip })
          Property.MaskComposite => Option<MaskItem<'a>>.some(
            MaskItem<'a>.Composite { value: layer.composite },
          )
          _ => Option<MaskItem<'a>>.None
        }
      }
      _ => {}
    }
    _ => {}
  }
  return Option<MaskItem<'a>>.None
}

fn projectBorder<'a>(border: &'a Border, property: Property) -> Option<BorderItem<'a>> {
  return match property {
    Property.MaskBorderSource => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Image { value: &border.image },
    )
    Property.MaskBorderMode => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Mode { value: border.mode },
    )
    Property.MaskBorderSlice => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Slice { values: border.slice, fill: border.fill },
    )
    Property.MaskBorderWidth => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Width { values: border.width },
    )
    Property.MaskBorderOutset => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Outset { values: border.outset },
    )
    Property.MaskBorderRepeat => Option<BorderItem<'a>>.some(
      BorderItem<'a>.Repeat { value: border.repeat },
    )
    _ => Option<BorderItem<'a>>.None
  }
}

pub fn borderItem<'a>(store: &'a Store, id: ValueId, property: Property) -> Option<BorderItem<'a>> {
  return match &store.get(id).* {
    Value.Effect { value } => match &value {
      EffectValue.Masks { layers, resetBorder } => projectBorder(&resetBorder, property)
      EffectValue.MaskBorder { border } => projectBorder(&border, property)
      _ => Option<BorderItem<'a>>.None
    }
    _ => Option<BorderItem<'a>>.None
  }
}
