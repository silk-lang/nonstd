//! Typed CSS Values 3/4 expression arena. Percentages remain unresolved until evaluate.
//! Host metrics are CSS px; font-* callers supply parent font metrics as required by Values4.
import input { Input, TokenView }
import tokens { Kind, insensitive }
import value_cursor { Cursor }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.num.f64

pub enum Dimension {
  Number,
  NumberPercentage,
  Length,
  LengthPercentage,
  Percentage,
  Angle,
  Time,
  Frequency,
  Resolution
}

pub enum Unit {
  Number,
  Percent,
  Px,
  Cm,
  Mm,
  Q,
  In,
  Pt,
  Pc,
  Em,
  Rem,
  Ex,
  Rex,
  Cap,
  Rcap,
  Ch,
  Rch,
  Ic,
  Ric,
  Lh,
  Rlh,
  Vw,
  Vh,
  Vi,
  Vb,
  Vmin,
  Vmax,
  Svw,
  Svh,
  Svi,
  Svb,
  Svmin,
  Svmax,
  Lvw,
  Lvh,
  Lvi,
  Lvb,
  Lvmin,
  Lvmax,
  Dvw,
  Dvh,
  Dvi,
  Dvb,
  Dvmin,
  Dvmax,
  Deg,
  Grad,
  Rad,
  Turn,
  S,
  Ms,
  Hz,
  Khz,
  Dpi,
  Dpcm,
  Dppx,
  X,
}

pub struct ExprId {
  pub index: usize
}

impl Copy for ExprId {}

pub enum Operation {
  Add,
  Subtract,
  Multiply,
  Divide,
  Min,
  Max
}

pub union Expr {
  Literal { pub value: f64, pub unit: Unit },
  Binary { pub operation: Operation, pub left: ExprId, pub right: ExprId },
  Calc { pub value: ExprId },
  PercentContext { pub value: ExprId, pub percentage: bool },
}

impl Copy for Expr {}

pub struct Store {
  nodes: List<Expr>
}

impl Store {
  pub fn make() -> Store {
    return Store { nodes: List<Expr>.make() }
  }

  pub fn get(self: &Store, id: ExprId) -> &Expr {
    return &self.nodes.asSlice()[id.index]
  }
}

pub struct Context {
  pub fontSize: f64,
  pub rootFontSize: f64,
  pub xHeight: f64,
  pub rootXHeight: f64,
  pub capHeight: f64,
  pub rootCapHeight: f64,
  pub zeroAdvance: f64,
  pub rootZeroAdvance: f64,
  pub ideographAdvance: f64,
  pub rootIdeographAdvance: f64,
  pub lineHeight: f64,
  pub rootLineHeight: f64,
  pub viewportWidth: f64,
  pub viewportHeight: f64,
  pub smallViewportWidth: f64,
  pub smallViewportHeight: f64,
  pub dynamicViewportWidth: f64,
  pub dynamicViewportHeight: f64,
  pub vertical: bool,
  pub parentFontSize: f64,
  pub parentXHeight: f64,
  pub parentCapHeight: f64,
  pub parentZeroAdvance: f64,
  pub parentIdeographAdvance: f64,
  pub parentLineHeight: f64,
  pub parentFontWeight: f64,
  pub parentFontStretch: f64,
  pub initialFontSize: f64,
  pub mathFontSize: f64,
  pub fontSizeKeywords: [f64; 8],
}

impl Copy for Context {}

impl Context {
  /// Convenience for a static viewport. Override actual font metrics, ascent/cap height,
  /// line heights, root metrics, and viewport variants before computing host styles.
  pub fn make(viewportWidth: f64, viewportHeight: f64, fontSize: f64) -> Context {
    return Context {
      fontSize: fontSize,
      rootFontSize: fontSize,
      xHeight: fontSize * 0.5,
      rootXHeight: fontSize * 0.5,
      capHeight: fontSize,
      rootCapHeight: fontSize,
      zeroAdvance: fontSize * 0.5,
      rootZeroAdvance: fontSize * 0.5,
      ideographAdvance: fontSize,
      rootIdeographAdvance: fontSize,
      lineHeight: fontSize,
      rootLineHeight: fontSize,
      viewportWidth: viewportWidth,
      viewportHeight: viewportHeight,
      smallViewportWidth: viewportWidth,
      smallViewportHeight: viewportHeight,
      dynamicViewportWidth: viewportWidth,
      dynamicViewportHeight: viewportHeight,
      vertical: false,
      parentFontSize: fontSize,
      parentFontWeight: 400.0,
      parentXHeight: fontSize * 0.5,
      parentCapHeight: fontSize,
      parentZeroAdvance: fontSize * 0.5,
      parentIdeographAdvance: fontSize,
      parentLineHeight: fontSize,
      parentFontStretch: 100.0,
      initialFontSize: fontSize,
      mathFontSize: fontSize,
      fontSizeKeywords: [
        fontSize * 0.6,
        fontSize * 0.75,
        fontSize * 0.89,
        fontSize,
        fontSize * 1.2,
        fontSize * 1.5,
        fontSize * 2.0,
        fontSize * 3.0,
      ],
    }
  }
}

effect fn append(store: &mut Store, expression: Expr) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  let id = ExprId { index: store.nodes.length() }
  run store.nodes.append(expression)
  return id
}

pub effect fn literal(store: &mut Store, value: f64, unit: Unit) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  return (run append(&mut store.*, Expr.Literal { value: value, unit: unit }))
}

effect fn binary(store: &mut Store, operation: Operation, left: ExprId, right: ExprId) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  return (run append(&mut store.*, Expr.Binary { operation: operation, left: left, right: right }))
}

pub fn negativeLiteral(store: &Store, id: ExprId) -> bool {
  return match &store.get(id).* {
    Expr.Literal { value, unit } => value < 0.0
    _ => false
  }
}

pub fn containsPercentage(store: &Store, id: ExprId) -> bool {
  return match &store.get(id).* {
    Expr.Literal { value, unit } => unit == Unit.Percent
    Expr.Binary { operation, left, right } => containsPercentage(store, left)
      || containsPercentage(store, right)
    Expr.Calc { value } => containsPercentage(store, value)
    Expr.PercentContext { value, percentage } => containsPercentage(store, value)
  }
}

fn unit(text: &[u8]) -> Option<Unit> {
  if insensitive(text, b"px") {
    return Option<Unit>.some(Unit.Px)
  }
  if insensitive(text, b"cm") {
    return Option<Unit>.some(Unit.Cm)
  }
  if insensitive(text, b"mm") {
    return Option<Unit>.some(Unit.Mm)
  }
  if insensitive(text, b"q") {
    return Option<Unit>.some(Unit.Q)
  }
  if insensitive(text, b"in") {
    return Option<Unit>.some(Unit.In)
  }
  if insensitive(text, b"pt") {
    return Option<Unit>.some(Unit.Pt)
  }
  if insensitive(text, b"pc") {
    return Option<Unit>.some(Unit.Pc)
  }
  if insensitive(text, b"em") {
    return Option<Unit>.some(Unit.Em)
  }
  if insensitive(text, b"rem") {
    return Option<Unit>.some(Unit.Rem)
  }
  if insensitive(text, b"ex") {
    return Option<Unit>.some(Unit.Ex)
  }
  if insensitive(text, b"rex") {
    return Option<Unit>.some(Unit.Rex)
  }
  if insensitive(text, b"cap") {
    return Option<Unit>.some(Unit.Cap)
  }
  if insensitive(text, b"rcap") {
    return Option<Unit>.some(Unit.Rcap)
  }
  if insensitive(text, b"ch") {
    return Option<Unit>.some(Unit.Ch)
  }
  if insensitive(text, b"rch") {
    return Option<Unit>.some(Unit.Rch)
  }
  if insensitive(text, b"ic") {
    return Option<Unit>.some(Unit.Ic)
  }
  if insensitive(text, b"ric") {
    return Option<Unit>.some(Unit.Ric)
  }
  if insensitive(text, b"lh") {
    return Option<Unit>.some(Unit.Lh)
  }
  if insensitive(text, b"rlh") {
    return Option<Unit>.some(Unit.Rlh)
  }
  if insensitive(text, b"vw") {
    return Option<Unit>.some(Unit.Vw)
  }
  if insensitive(text, b"vh") {
    return Option<Unit>.some(Unit.Vh)
  }
  if insensitive(text, b"vi") {
    return Option<Unit>.some(Unit.Vi)
  }
  if insensitive(text, b"vb") {
    return Option<Unit>.some(Unit.Vb)
  }
  if insensitive(text, b"vmin") {
    return Option<Unit>.some(Unit.Vmin)
  }
  if insensitive(text, b"vmax") {
    return Option<Unit>.some(Unit.Vmax)
  }
  if insensitive(text, b"svw") {
    return Option<Unit>.some(Unit.Svw)
  }
  if insensitive(text, b"svh") {
    return Option<Unit>.some(Unit.Svh)
  }
  if insensitive(text, b"svi") {
    return Option<Unit>.some(Unit.Svi)
  }
  if insensitive(text, b"svb") {
    return Option<Unit>.some(Unit.Svb)
  }
  if insensitive(text, b"svmin") {
    return Option<Unit>.some(Unit.Svmin)
  }
  if insensitive(text, b"svmax") {
    return Option<Unit>.some(Unit.Svmax)
  }
  if insensitive(text, b"lvw") {
    return Option<Unit>.some(Unit.Lvw)
  }
  if insensitive(text, b"lvh") {
    return Option<Unit>.some(Unit.Lvh)
  }
  if insensitive(text, b"lvi") {
    return Option<Unit>.some(Unit.Lvi)
  }
  if insensitive(text, b"lvb") {
    return Option<Unit>.some(Unit.Lvb)
  }
  if insensitive(text, b"lvmin") {
    return Option<Unit>.some(Unit.Lvmin)
  }
  if insensitive(text, b"lvmax") {
    return Option<Unit>.some(Unit.Lvmax)
  }
  if insensitive(text, b"dvw") {
    return Option<Unit>.some(Unit.Dvw)
  }
  if insensitive(text, b"dvh") {
    return Option<Unit>.some(Unit.Dvh)
  }
  if insensitive(text, b"dvi") {
    return Option<Unit>.some(Unit.Dvi)
  }
  if insensitive(text, b"dvb") {
    return Option<Unit>.some(Unit.Dvb)
  }
  if insensitive(text, b"dvmin") {
    return Option<Unit>.some(Unit.Dvmin)
  }
  if insensitive(text, b"dvmax") {
    return Option<Unit>.some(Unit.Dvmax)
  }
  if insensitive(text, b"deg") {
    return Option<Unit>.some(Unit.Deg)
  }
  if insensitive(text, b"grad") {
    return Option<Unit>.some(Unit.Grad)
  }
  if insensitive(text, b"rad") {
    return Option<Unit>.some(Unit.Rad)
  }
  if insensitive(text, b"turn") {
    return Option<Unit>.some(Unit.Turn)
  }
  if insensitive(text, b"s") {
    return Option<Unit>.some(Unit.S)
  }
  if insensitive(text, b"ms") {
    return Option<Unit>.some(Unit.Ms)
  }
  if insensitive(text, b"hz") {
    return Option<Unit>.some(Unit.Hz)
  }
  if insensitive(text, b"khz") {
    return Option<Unit>.some(Unit.Khz)
  }
  if insensitive(text, b"dpi") {
    return Option<Unit>.some(Unit.Dpi)
  }
  if insensitive(text, b"dpcm") {
    return Option<Unit>.some(Unit.Dpcm)
  }
  if insensitive(text, b"dppx") {
    return Option<Unit>.some(Unit.Dppx)
  }
  if insensitive(text, b"x") {
    return Option<Unit>.some(Unit.X)
  }
  return Option<Unit>.None
}

// Six independent base dimensions: length, angle, time, frequency, resolution, percent.
// Values4 permits arbitrary intermediate powers, but only a simple final dimension.
struct Typed {
  id: ExprId,
  powers: [i32; 6],
  hinted: bool
}

impl Copy for Typed {}

fn powers(dimension: Dimension) -> [i32; 6] {
  return match dimension {
    Dimension.Length => [1, 0, 0, 0, 0, 0]
    Dimension.LengthPercentage => [1, 0, 0, 0, 0, 0]
    Dimension.Angle => [0, 1, 0, 0, 0, 0]
    Dimension.Time => [0, 0, 1, 0, 0, 0]
    Dimension.Frequency => [0, 0, 0, 1, 0, 0]
    Dimension.Resolution => [0, 0, 0, 0, 1, 0]
    Dimension.Percentage => [0, 0, 0, 0, 0, 1]
    _ => [0, 0, 0, 0, 0, 0]
  }
}

fn dimension(unitValue: Unit) -> Dimension {
  return match unitValue {
    Unit.Number => Dimension.Number
    Unit.Percent => Dimension.Percentage
    Unit.Deg => Dimension.Angle
    Unit.Grad => Dimension.Angle
    Unit.Rad => Dimension.Angle
    Unit.Turn => Dimension.Angle
    Unit.S => Dimension.Time
    Unit.Ms => Dimension.Time
    Unit.Hz => Dimension.Frequency
    Unit.Khz => Dimension.Frequency
    Unit.Dpi => Dimension.Resolution
    Unit.Dpcm => Dimension.Resolution
    Unit.Dppx => Dimension.Resolution
    Unit.X => Dimension.Resolution
    _ => Dimension.Length
  }
}

fn same(a: [i32; 6], b: [i32; 6]) -> bool {
  let mut index: usize = 0
  while index < 6 {
    if a[index] != b[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn resultPowers(store: &Store, id: ExprId) -> [i32; 6] {
  return match &store.get(id).* {
    Expr.Literal { value, unit } => powers(dimension(unit))
    Expr.Calc { value } => resultPowers(store, value)
    Expr.PercentContext { value, percentage } => resultPowers(store, value)
    Expr.Binary { operation, left, right } => {
      let mut a = resultPowers(store, left)
      let b = resultPowers(store, right)
      if operation == Operation.Multiply || operation == Operation.Divide {
        let mut index: usize = 0
        while index < 6 {
          a[index] = a[index]
            + (if operation == Operation.Divide {
              -b[index]
            } else {
              b[index]
            })
          index = index + 1
        }
      } else if !same(a, b) {
        // The only mixed additive type admitted by parse is length-percentage.
        a[0] = a[0] + a[5]
        a[5] = 0
      }
      return a
    }
  }
}

/// Distinguishes unitless inherited multipliers from lengths, including ratios.
pub fn numberResult(store: &Store, id: ExprId) -> bool {
  return same(resultPowers(store, id), powers(Dimension.Number))
}

/// Applies a property's nonnegative range without resolving its percentage basis.
/// This is distinct from specified negative-literal rejection at parse time.
pub effect fn nonnegative(store: &mut Store, id: ExprId) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = store.get(id).*
  match &node {
    Expr.Literal { value, unit } => {
      if value >= 0.0 {
        return id
      }
      return run literal(&mut store.*, 0.0, unit)
    }
    _ => {}
  }
  let result = resultPowers(&store.*, id)
  let zeroUnit = if result[0] == 1 {
    Unit.Px
  } else if result[1] == 1 {
    Unit.Deg
  } else if result[2] == 1 {
    Unit.S
  } else if result[3] == 1 {
    Unit.Hz
  } else if result[4] == 1 {
    Unit.Dppx
  } else if result[5] == 1 {
    Unit.Percent
  } else {
    Unit.Number
  }
  let zero = run literal(&mut store.*, 0.0, zeroUnit)
  return run binary(&mut store.*, Operation.Max, id, zero)
}

fn simple(value: &Typed) -> bool {
  let mut sum: i32 = 0
  let mut index: usize = 0
  while index < 6 {
    if value.powers[index] < 0 || value.powers[index] > 1 {
      return false
    }
    sum = sum + value.powers[index]
    index = index + 1
  }
  return sum <= 1
}

fn compatible(value: &Typed, expected: Dimension) -> bool {
  if value.hinted && expected != Dimension.LengthPercentage {
    return false
  }
  if expected == Dimension.NumberPercentage {
    return same(value.powers, powers(Dimension.Number))
      || same(value.powers, powers(Dimension.Percentage))
  }
  return same(value.powers, powers(expected))
}

effect fn typedLiteral(store: &mut Store, value: f64, unitValue: Unit, hint: bool) -> Typed
  ! OutOfMemoryError
  ? &mut Allocator {
  let hinted = unitValue == Unit.Percent && hint
  return Typed {
    id: (run literal(&mut store.*, value, unitValue)),
    powers: powers(
      if hinted {
        Dimension.Length
      } else {
        dimension(unitValue)
      },
    ),
    hinted: hinted,
  }
}

effect fn combine(store: &mut Store, left: Typed, right: Typed, operation: Operation) -> Option<
  Typed
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut resultPowers = left.powers
  if operation == Operation.Multiply || operation == Operation.Divide {
    let mut index: usize = 0
    while index < 6 {
      resultPowers[index] = resultPowers[index]
        + (if operation == Operation.Divide {
          -right.powers[index]
        } else {
          right.powers[index]
        })
      index = index + 1
    }
  } else {
    if !same(left.powers, right.powers) {
      return Option<Typed>.None
    }
  }
  return Option<Typed>.some(
    Typed {
      id: (run binary(&mut store.*, operation, left.id, right.id)),
      powers: resultPowers,
      hinted: left.hinted || right.hinted,
    },
  )
}

fn whitespace(source: &Input, index: usize) -> bool {
  let view = source.at(index)
  return match &view {
    Option<TokenView>.Some { value } => match &value.token.kind {
      Kind.Whitespace => true
      _ => false
    }
    _ => false
  }
}

fn delimiter(source: &Input, index: usize) -> u32 {
  let view = source.at(index)
  return match &view {
    Option<TokenView>.Some { value } => match &value.token.kind {
      Kind.Delim { scalar } => scalar
      _ => 0
    }
    _ => 0
  }
}

// CSS Syntax implicitly closes component blocks at EOF. An unmatched explicit closer
// is not EOF; never use Token.matching here because Input can span many buffers.
fn close(source: &Input, cursor: &mut Cursor) -> bool {
  cursor.skip(source)
  if cursor.position == cursor.end {
    return true
  }
  return cursor.close(source)
}

effect fn primary(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  hint: bool,
  depth: usize,
  remaining: &mut usize,
  math: bool,
) -> Option<Typed>
  ! OutOfMemoryError
  ? &mut Allocator {
  if depth > 64 || remaining.* == 0 {
    return Option<Typed>.None
  }
  cursor.skip(source)
  if cursor.position >= cursor.end {
    return Option<Typed>.None
  }
  remaining.* = remaining.* - 1
  let view = source.at(cursor.position)
  match &view {
    Option<TokenView>.Some { value: tokenView } => {
      match &tokenView.token.kind {
        Kind.Number { value, integer } => {
          cursor.position = cursor.position + 1
          return Option<Typed>.some((run typedLiteral(&mut store.*, value, Unit.Number, hint)))
        }
        Kind.Percentage { value, integer } => {
          cursor.position = cursor.position + 1
          return Option<Typed>.some((run typedLiteral(&mut store.*, value, Unit.Percent, hint)))
        }
        Kind.Dimension { value, integer, unit: unitText } => {
          let parsedUnit = unit(tokenView.text(unitText))
          match &parsedUnit {
            Option<Unit>.Some { value: unitValue } => {
              cursor.position = cursor.position + 1
              return Option<Typed>.some((run typedLiteral(&mut store.*, value, unitValue, hint)))
            }
            _ => {
              return Option<Typed>.None
            }
          }
        }
        Kind.Ident { text } => {
          if !math {
            return Option<Typed>.None
          }
          let name = tokenView.text(text)
          let numeric = if insensitive(name, b"pi") {
            3.141592653589793
          } else if insensitive(name, b"e") {
            2.718281828459045
          } else if insensitive(name, b"infinity") {
            f64.INFINITY
          } else if insensitive(name, b"-infinity") {
            -f64.INFINITY
          } else if insensitive(name, b"nan") {
            f64.fromBits(9221120237041090560)
          } else {
            return Option<Typed>.None
          }
          cursor.position = cursor.position + 1
          return Option<Typed>.some((run typedLiteral(&mut store.*, numeric, Unit.Number, hint)))
        }
        Kind.OpenParen => {
          if !math {
            return Option<Typed>.None
          }
          cursor.position = cursor.position + 1
          let inside = (run sum(
            &mut store.*,
            source,
            &mut cursor.*,
            hint,
            depth + 1,
            &mut remaining.*,
          ))
          if !close(source, &mut cursor.*) {
            return Option<Typed>.None
          }
          return inside
        }
        Kind.Function { name } => {
          let functionName = tokenView.text(name)
          let functionKind = if insensitive(functionName, b"calc") {
            0
          } else if insensitive(functionName, b"min") {
            1
          } else if insensitive(functionName, b"max") {
            2
          } else if insensitive(functionName, b"clamp") {
            3
          } else {
            return Option<Typed>.None
          }
          cursor.position = cursor.position + 1
          return (run function(
            &mut store.*,
            source,
            &mut cursor.*,
            hint,
            depth + 1,
            &mut remaining.*,
            functionKind,
          ))
        }
        _ => {
          return Option<Typed>.None
        }
      }
    }
    _ => {
      return Option<Typed>.None
    }
  }
}

effect fn product(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  hint: bool,
  depth: usize,
  remaining: &mut usize,
) -> Option<Typed>
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = (run primary(
    &mut store.*,
    source,
    &mut cursor.*,
    hint,
    depth,
    &mut remaining.*,
    true,
  ))
  let mut result = match &first {
    Option<Typed>.Some { value } => value
    _ => {
      return Option<Typed>.None
    }
  }
  while true {
    let previous = cursor.position
    cursor.skip(source)
    let scalar = if cursor.position < cursor.end {
      delimiter(source, cursor.position)
    } else {
      0
    }
    if scalar != 42 && scalar != 47 {
      cursor.position = previous
      break
    }
    cursor.position = cursor.position + 1
    let next = (run primary(
      &mut store.*,
      source,
      &mut cursor.*,
      hint,
      depth,
      &mut remaining.*,
      true,
    ))
    let operand = match &next {
      Option<Typed>.Some { value } => value
      _ => {
        return Option<Typed>.None
      }
    }
    let combined = (run combine(
      &mut store.*,
      result,
      operand,
      if scalar == 42 {
        Operation.Multiply
      } else {
        Operation.Divide
      },
    ))
    result = match &combined {
      Option<Typed>.Some { value } => value
      _ => {
        return Option<Typed>.None
      }
    }
  }
  return Option<Typed>.some(result)
}

effect fn sum(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  hint: bool,
  depth: usize,
  remaining: &mut usize,
) -> Option<Typed>
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = (run product(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
  let mut result = match &first {
    Option<Typed>.Some { value } => value
    _ => {
      return Option<Typed>.None
    }
  }
  while true {
    let previous = cursor.position
    cursor.skip(source)
    let scalar = if cursor.position < cursor.end {
      delimiter(source, cursor.position)
    } else {
      0
    }
    if scalar != 43 && scalar != 45 {
      cursor.position = previous
      break
    }
    if cursor.position == 0 || !whitespace(source, cursor.position - 1)
      || cursor.position + 1 >= cursor.end
      || !whitespace(source, cursor.position + 1) {
      return Option<Typed>.None
    }
    cursor.position = cursor.position + 1
    let next = (run product(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
    let operand = match &next {
      Option<Typed>.Some { value } => value
      _ => {
        return Option<Typed>.None
      }
    }
    let combined = (run combine(
      &mut store.*,
      result,
      operand,
      if scalar == 43 {
        Operation.Add
      } else {
        Operation.Subtract
      },
    ))
    result = match &combined {
      Option<Typed>.Some { value } => value
      _ => {
        return Option<Typed>.None
      }
    }
  }
  return Option<Typed>.some(result)
}

effect fn function(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  hint: bool,
  depth: usize,
  remaining: &mut usize,
  kind: i32,
) -> Option<Typed>
  ! OutOfMemoryError
  ? &mut Allocator {
  if depth > 64 {
    return Option<Typed>.None
  }
  let noLower = kind == 3 && cursor.ident(source, b"none")
  let first = if noLower {
    Option<Typed>.None
  } else {
    (run sum(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
  }
  if kind == 3 {
    if !noLower {
      match &first {
        Option<Typed>.None => {
          return Option<Typed>.None
        }
        _ => {}
      }
    }
    if !cursor.comma(source) {
      return Option<Typed>.None
    }
    let middle = (run sum(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
    let mut result = match &middle {
      Option<Typed>.Some { value } => value
      _ => {
        return Option<Typed>.None
      }
    }
    if !cursor.comma(source) {
      return Option<Typed>.None
    }
    if !cursor.ident(source, b"none") {
      let last = (run sum(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
      let upper = match &last {
        Option<Typed>.Some { value } => value
        _ => {
          return Option<Typed>.None
        }
      }
      let bounded = (run combine(&mut store.*, result, upper, Operation.Min))
      result = match &bounded {
        Option<Typed>.Some { value } => value
        _ => {
          return Option<Typed>.None
        }
      }
    }
    match &first {
      Option<Typed>.Some { value: lower } => {
        let bounded = (run combine(&mut store.*, lower, result, Operation.Max))
        result = match &bounded {
          Option<Typed>.Some { value } => value
          _ => {
            return Option<Typed>.None
          }
        }
      }
      _ => {}
    }
    if !close(source, &mut cursor.*) || !simple(&result) {
      return Option<Typed>.None
    }
    result.id = (run append(&mut store.*, Expr.Calc { value: result.id }))
    return Option<Typed>.some(result)
  }
  let mut result = match &first {
    Option<Typed>.Some { value } => value
    _ => {
      return Option<Typed>.None
    }
  }
  if kind != 0 {
    while cursor.comma(source) {
      let next = (run sum(&mut store.*, source, &mut cursor.*, hint, depth, &mut remaining.*))
      let operand = match &next {
        Option<Typed>.Some { value } => value
        _ => {
          return Option<Typed>.None
        }
      }
      let combined = (run combine(
        &mut store.*,
        result,
        operand,
        if kind == 1 {
          Operation.Min
        } else {
          Operation.Max
        },
      ))
      result = match &combined {
        Option<Typed>.Some { value } => value
        _ => {
          return Option<Typed>.None
        }
      }
    }
  }
  if !close(source, &mut cursor.*) || !simple(&result) {
    return Option<Typed>.None
  }
  result.id = (run append(&mut store.*, Expr.Calc { value: result.id }))
  return Option<Typed>.some(result)
}

/// Parses one value; failed parses leave the caller's cursor unchanged. Unitless
/// nonzero lengths are accepted only as bare presentation-attribute literals.
/// Limits: 256 terms/function openers and 64 nested functions/parentheses.
pub effect fn parse(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  expected: Dimension,
  presentation: bool,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run parseContext(&mut store.*, source, &mut cursor.*, expected, presentation, false)
}

/// MQ4 #false-in-the-negative-range admits negative resolution thresholds.
/// The media evaluator, not the property-value range rules, compares those values.
pub effect fn parseMedia(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  expected: Dimension,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run parseContext(&mut store.*, source, &mut cursor.*, expected, false, true)
}

effect fn parseContext(
  store: &mut Store,
  source: &Input,
  cursor: &mut Cursor,
  expected: Dimension,
  presentation: bool,
  media: bool,
) -> Option<ExprId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let checkpoint = store.nodes.length()
  let mut local = Cursor { position: cursor.position, end: cursor.end }
  let mut remaining: usize = 256
  let parsed = (run primary(
    &mut store.*,
    source,
    &mut local,
    expected == Dimension.LengthPercentage,
    0,
    &mut remaining,
    false,
  ))
  match &parsed {
    Option<Typed>.Some { value } => {
      if compatible(&value, expected) {
        let isMath = match &store.get(value.id).* {
          Expr.Literal { value: numeric, unit: literalUnit } => false
          _ => true
        }
        let mut result = value.id
        if isMath && !value.hinted && containsPercentage(&store.*, result) {
          result = run append(
            &mut store.*,
            Expr.PercentContext {
              value: result,
              percentage: same(value.powers, powers(Dimension.Percentage)),
            },
          )
        }
        if expected == Dimension.Resolution && !media {
          if negativeLiteral(&store.*, result) {
            store.nodes.truncate(checkpoint)
            return Option<ExprId>.None
          }
          if isMath {
            let zero = run literal(&mut store.*, 0.0, Unit.Dppx)
            result = run binary(&mut store.*, Operation.Max, zero, result)
          }
        }
        cursor.position = local.position
        return Option<ExprId>.some(result)
      }
      if expected == Dimension.Length || expected == Dimension.LengthPercentage {
        match &store.get(value.id).* {
          Expr.Literal { value: numeric, unit: literalUnit } => {
            if literalUnit == Unit.Number && (numeric == 0.0 || presentation) {
              let amount: f64 = numeric
              let converted = run literal(&mut store.*, amount, Unit.Px)
              cursor.position = local.position
              return Option<ExprId>.some(converted)
            }
          }
          _ => {}
        }
      }
      store.nodes.truncate(checkpoint)
      return Option<ExprId>.None
    }
    _ => {
      store.nodes.truncate(checkpoint)
      return Option<ExprId>.None
    }
  }
}

fn canonical(unitValue: Unit) -> Unit {
  return match dimension(unitValue) {
    Dimension.Length => Unit.Px
    Dimension.Angle => Unit.Deg
    Dimension.Time => Unit.S
    Dimension.Frequency => Unit.Hz
    Dimension.Resolution => Unit.Dppx
    Dimension.Percentage => Unit.Percent
    _ => Unit.Number
  }
}

fn absoluteFactor(unitValue: Unit) -> f64 {
  return match unitValue {
    Unit.Cm => 96.0 / 2.54
    Unit.Mm => 96.0 / 25.4
    Unit.Q => 96.0 / 101.6
    Unit.In => 96.0
    Unit.Pt => 96.0 / 72.0
    Unit.Pc => 16.0
    Unit.Grad => 0.9
    Unit.Rad => 180.0 / 3.141592653589793
    Unit.Turn => 360.0
    Unit.Ms => 0.001
    Unit.Khz => 1000.0
    Unit.Dpi => 1.0 / 96.0
    Unit.Dpcm => 2.54 / 96.0
    _ => 1.0
  }
}

fn factor(unitValue: Unit, context: &Context) -> f64 {
  let inlineSize = if context.vertical {
    context.viewportHeight
  } else {
    context.viewportWidth
  }
  let blockSize = if context.vertical {
    context.viewportWidth
  } else {
    context.viewportHeight
  }
  let smallInline = if context.vertical {
    context.smallViewportHeight
  } else {
    context.smallViewportWidth
  }
  let smallBlock = if context.vertical {
    context.smallViewportWidth
  } else {
    context.smallViewportHeight
  }
  let dynamicInline = if context.vertical {
    context.dynamicViewportHeight
  } else {
    context.dynamicViewportWidth
  }
  let dynamicBlock = if context.vertical {
    context.dynamicViewportWidth
  } else {
    context.dynamicViewportHeight
  }
  return match unitValue {
    Unit.Em => context.fontSize
    Unit.Rem => context.rootFontSize
    Unit.Ex => context.xHeight
    Unit.Rex => context.rootXHeight
    Unit.Cap => context.capHeight
    Unit.Rcap => context.rootCapHeight
    Unit.Ch => context.zeroAdvance
    Unit.Rch => context.rootZeroAdvance
    Unit.Ic => context.ideographAdvance
    Unit.Ric => context.rootIdeographAdvance
    Unit.Lh => context.lineHeight
    Unit.Rlh => context.rootLineHeight
    Unit.Vw => context.viewportWidth * 0.01
    Unit.Lvw => context.viewportWidth * 0.01
    Unit.Vh => context.viewportHeight * 0.01
    Unit.Lvh => context.viewportHeight * 0.01
    Unit.Vi => inlineSize * 0.01
    Unit.Lvi => inlineSize * 0.01
    Unit.Vb => blockSize * 0.01
    Unit.Lvb => blockSize * 0.01
    Unit.Vmin => f64.min(context.viewportWidth, context.viewportHeight) * 0.01
    Unit.Lvmin => f64.min(context.viewportWidth, context.viewportHeight) * 0.01
    Unit.Vmax => f64.max(context.viewportWidth, context.viewportHeight) * 0.01
    Unit.Lvmax => f64.max(context.viewportWidth, context.viewportHeight) * 0.01
    Unit.Svw => context.smallViewportWidth * 0.01
    Unit.Svh => context.smallViewportHeight * 0.01
    Unit.Svi => smallInline * 0.01
    Unit.Svb => smallBlock * 0.01
    Unit.Svmin => f64.min(context.smallViewportWidth, context.smallViewportHeight) * 0.01
    Unit.Svmax => f64.max(context.smallViewportWidth, context.smallViewportHeight) * 0.01
    Unit.Dvw => context.dynamicViewportWidth * 0.01
    Unit.Dvh => context.dynamicViewportHeight * 0.01
    Unit.Dvi => dynamicInline * 0.01
    Unit.Dvb => dynamicBlock * 0.01
    Unit.Dvmin => f64.min(context.dynamicViewportWidth, context.dynamicViewportHeight) * 0.01
    Unit.Dvmax => f64.max(context.dynamicViewportWidth, context.dynamicViewportHeight) * 0.01
    _ => absoluteFactor(unitValue)
  }
}

// CSS Values4 #numeric-data-types: overflow of a finite literal's unit
// conversion is range-limited, not the math-function infinity constant.
fn converted(value: f64, unitValue: Unit, scale: f64) -> f64 {
  let result = value * scale
  if !f64.isFinite(value) || unitValue == Unit.Number || unitValue == Unit.Percent {
    return result
  }
  let bound = if dimension(unitValue) == Dimension.Angle {
    // Largest finite binary64 whose integer significand is divisible by 45;
    // its power-of-two factor also supplies 8, so it is a multiple of 360.
    f64.fromBits(9218868437227405280)
  } else {
    f64.fromBits(9218868437227405311)
  }
  if result > bound {
    return bound
  }
  if result < -bound {
    return -bound
  }
  return if result == 0.0 {
    0.0
  } else {
    result
  }
}

/// Canonicalizes all relative/absolute units without choosing a percentage basis.
/// Unchanged subtrees reuse their arena handles; specified nodes remain immutable.
pub effect fn compute(store: &mut Store, id: ExprId, context: &Context) -> ExprId
  ! OutOfMemoryError
  ? &mut Allocator {
  let node = store.get(id).*
  match &node {
    Expr.Literal { value, unit: unitValue } => {
      let resultUnit = canonical(unitValue)
      let result = converted(value, unitValue, factor(unitValue, context))
      if resultUnit == unitValue && result == value {
        return id
      }
      return run literal(&mut store.*, result, resultUnit)
    }
    Expr.Binary { operation, left, right } => {
      let computedLeft = (run compute(&mut store.*, left, context))
      let computedRight = (run compute(&mut store.*, right, context))
      if computedLeft.index == left.index && computedRight.index == right.index {
        return id
      }
      return (run binary(&mut store.*, operation, computedLeft, computedRight))
    }
    Expr.Calc { value } => {
      let computed = (run compute(&mut store.*, value, context))
      if computed.index == value.index {
        return id
      }
      return (run append(&mut store.*, Expr.Calc { value: computed }))
    }
    Expr.PercentContext { value, percentage } => {
      let computed = run compute(&mut store.*, value, context)
      if computed.index == value.index {
        return id
      }
      return run append(
        &mut store.*,
        Expr.PercentContext { value: computed, percentage: percentage },
      )
    }
  }
}

// Explicit IEEE propagation is needed: hardware min/max may suppress NaN.
fn minimum(a: f64, b: f64) -> f64 {
  if a != a {
    return a
  }
  if b != b {
    return b
  }
  if a == 0.0 && b == 0.0 {
    return if 1.0 / a < 0.0 {
      a
    } else {
      b
    }
  }
  return if a < b {
    a
  } else {
    b
  }
}

fn maximum(a: f64, b: f64) -> f64 {
  if a != a {
    return a
  }
  if b != b {
    return b
  }
  if a == 0.0 && b == 0.0 {
    return if 1.0 / a > 0.0 {
      a
    } else {
      b
    }
  }
  return if a > b {
    a
  } else {
    b
  }
}

/// Evaluates canonical units without censoring NaN or signed zero. Consumers
/// composing further numeric operations must defer censorship to their boundary.
pub fn evaluateUncensored(store: &Store, id: ExprId, percentageBasis: f64) -> f64 {
  return match &store.get(id).* {
    Expr.Literal { value, unit: unitValue } => {
      if unitValue == Unit.Percent {
        return value * 0.01 * percentageBasis
      }
      return converted(value, unitValue, absoluteFactor(unitValue))
    }
    Expr.Calc { value } => evaluateUncensored(store, value, percentageBasis)
    Expr.PercentContext { value, percentage } => {
      let result = evaluateUncensored(store, value, 100.0)
      return if percentage {
        result * 0.01 * percentageBasis
      } else {
        result
      }
    }
    Expr.Binary { operation, left, right } => {
      let a = evaluateUncensored(store, left, percentageBasis)
      let b = evaluateUncensored(store, right, percentageBasis)
      return match operation {
        Operation.Add => a + b
        Operation.Subtract => a - b
        Operation.Multiply => a * b
        Operation.Divide => a / b
        Operation.Min => minimum(a, b)
        Operation.Max => maximum(a, b)
      }
    }
  }
}

/// Resolve the used reference-box/number percentage basis. Call compute first for
/// font/viewport units. Absolute-only trees (including color angles) need no context.
/// NaN and negative zero censor to positive zero only at the outermost boundary.
pub fn evaluate(store: &Store, id: ExprId, percentageBasis: f64) -> f64 {
  let value = evaluateUncensored(store, id, percentageBasis)
  if value != value || value == 0.0 {
    return 0.0
  }
  return value
}
