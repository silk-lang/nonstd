//! Normative value validation, distinct from CSS syntax recovery.
import values { Store, Mode, Value, ValueId, Wide }
import values
import properties { Property }
import properties
import input { Input }
import lexer
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn accepts(property: Property, bytes: &[u8], mode: Mode) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(bytes, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let result = run values.parse(&mut store, property, &source, mode)
  return match &result {
    Option<ValueId>.Some { value } => true
    _ => false
  }
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#DataTypePaint
// https://www.w3.org/TR/css-cascade-4/#defaulting-keywords
test effect fn paintFallbackAndWholeValueValidation() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run accepts(Property.Fill, b"url('#p') currentColor", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "paint URL has typed currentColor fallback",
  )
  run Testing.expect(
    !run accepts(Property.Fill, b"url(#p) context-fill", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "context paint is not a URL fallback",
  )
  run Testing.expect(
    !run accepts(Property.Fill, b"red blue", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "a valid prefix does not validate a declaration",
  )
  run Testing.expect(
    run accepts(Property.Fill, b"revert", Mode.Css) |> Effect.provideMut<Allocator>(&mut allocator),
    "CSS-wide keyword is a complete value",
  )
  run Testing.expect(
    !run accepts(Property.Fill, b"initial red", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "CSS-wide keyword cannot combine",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeDasharrayProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#PaintOrderProperty
test effect fn dashAndPaintOrderGrammar() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run accepts(Property.StrokeDasharray, b"5, 3 2%", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "dash grammar explicitly permits numbers in CSS",
  )
  let calculatedNumber = run accepts(
    Property.StrokeDasharray,
    b"calc(2 * 3), min(4, 5) 2px",
    Mode.Css,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    calculatedNumber,
    "the explicit dash number alternative accepts dimensionless math",
  )
  run Testing.expect(
    !run accepts(Property.StrokeDasharray, b"5,,3", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "empty dash item invalid",
  )
  run Testing.expect(
    !run accepts(Property.StrokeDasharray, b"5,-3", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "negative dash invalidates list",
  )
  run Testing.expect(
    !run accepts(Property.StrokeDasharray, b"5,", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "trailing comma invalid",
  )
  run Testing.expect(
    run accepts(Property.PaintOrder, b"stroke markers", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "unique partial paint order accepted",
  )
  run Testing.expect(
    !run accepts(Property.PaintOrder, b"stroke stroke", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "duplicate paint operation invalid",
  )
}

// https://www.w3.org/TR/css-values-3/#lengths
// https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#StrokeMiterlimitProperty
test effect fn strictCssVersusPresentationLengths() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    !run accepts(Property.X, b"12", Mode.Css) |> Effect.provideMut<Allocator>(&mut allocator),
    "nonzero CSS length requires a unit",
  )
  run Testing.expect(
    run accepts(Property.X, b"12", Mode.Presentation)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "SVG presentation length accepts user units",
  )
  run Testing.expect(
    run accepts(Property.X, b"0", Mode.Css) |> Effect.provideMut<Allocator>(&mut allocator),
    "unitless CSS zero is a length",
  )
  run Testing.expect(
    !run accepts(Property.StrokeMiterlimit, b"0.5", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "miter limit minimum is one",
  )
  run Testing.expect(
    !run accepts(Property.R, b"-1px", Mode.Css) |> Effect.provideMut<Allocator>(&mut allocator),
    "negative radius invalid",
  )
}

effect fn used(property: Property, bytes: &[u8], basis: f64, expected: f64) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(bytes, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let parsed = run values.parse(&mut store, property, &source, Mode.Css)
  match &parsed {
    Option<ValueId>.Some { value } => {
      let result = values.usedNumber(&store, value, basis)
      return match &result {
        Option<f64>.Some { value: n } => n == expected
        _ => false
      }
    }
    _ => {
      return false
    }
  }
}

// https://www.w3.org/TR/css-values-4/#calc-range
// https://www.w3.org/TR/css-color-4/#transparency
test effect fn numericRangesApplyAfterMath() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let opacity = run used(Property.Opacity, b"250%", 1.0, 1.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let negative = run used(Property.StrokeWidth, b"calc(2px - 5px)", 100.0, 0.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reference = run used(Property.Cx, b"calc(25% + 4px)", 200.0, 54.0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    opacity && negative && reference,
    "opacity clamps, calculated stroke clamps, reference-box percentage remains live",
  )
}

// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#DProperty
// https://www.w3.org/TR/2018/CR-SVG2-20181004/paths.html#PathDataErrorHandling
test effect fn cssPathRejectsInvalidPrefixes() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let valid = run accepts(Property.D, b"path('M0 0 L10 5')", Mode.Css)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run accepts(Property.D, b"path('M0 0 L10')", Mode.Css)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let prefix = run accepts(Property.D, b"M0 0 L10", Mode.Presentation)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    valid && !invalid && prefix,
    "CSS whole-path validity differs from SVG presentation valid-prefix recovery",
  )
}

// https://www.w3.org/TR/css-cascade-4/#all-shorthand
test effect fn allShorthandExcludesDirectionAndCustomProperties() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let valid = run accepts(Property.All, b"unset", Mode.Css)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run accepts(Property.All, b"none", Mode.Css)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut excludesDirection = true
  let mut index: usize = 0
  while index < properties.longhandCount(Property.All) {
    let property = properties.longhandAt(Property.All, index)
    if property == Property.Direction || property == Property.UnicodeBidi {
      excludesDirection = false
    }
    index = index + 1
  }
  run Testing.expect(
    valid && !invalid && excludesDirection,
    "all accepts only CSS-wide keywords and leaves directional markup alone",
  )
}

// Pinned SVG11 types 92e6a601c7ee9946e6eec116fbbc31d226272d8853c1a73a2735f7e247fa1551:
// https://www.w3.org/TR/2011/REC-SVG11-20110816/types.html#DataTypeICCColor
// https://www.w3.org/TR/2011/REC-SVG11-20110816/painting.html#SpecifyingPaint
// https://www.w3.org/TR/2011/REC-SVG11-20110816/pservers.html#StopColorProperty
// https://www.w3.org/TR/2011/REC-SVG11-20110816/filters.html#FloodColorProperty
// https://www.w3.org/TR/2011/REC-SVG11-20110816/filters.html#LightingColorProperty
test effect fn svgIccColorGrammarAndPropertyBoundary() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let properties = [
    Property.Fill,
    Property.Stroke,
    Property.StopColor,
    Property.FloodColor,
    Property.LightingColor,
  ]
  let mut index: usize = 0
  while index < 5 {
    let property = properties[index]
    run Testing.expect(
      run accepts(property, b"rgb(20, 40, 60) icc-color(PrintProfile, .1 .2, -3, 4, 5)", Mode.Css)
        |> Effect.provideMut<Allocator>(&mut allocator),
      "ICC supports arbitrary channel count and mixed comma-wsp",
    )
    run Testing.expect(
      run accepts(property, b"#123 icc-color(PrintProfile, 1e-2)", Mode.Presentation)
        |> Effect.provideMut<Allocator>(&mut allocator),
      "SVG ICC requires at least one unrestricted number",
    )
    run Testing.expect(
      !run accepts(property, b"currentColor icc-color(p, 1)", Mode.Css)
        |> Effect.provideMut<Allocator>(&mut allocator),
      "currentColor is a separate grammar branch",
    )
    run Testing.expect(
      !run accepts(property, b"icc-color(p, 1)", Mode.Css)
        |> Effect.provideMut<Allocator>(&mut allocator),
      "ICC cannot omit the fallback color",
    )
    index = index + 1
  }
  run Testing.expect(
    run accepts(Property.Fill, b"url(#paint) red icc-color(p, 1, 2)", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "paint server fallback retains its ICC alternative",
  )
  run Testing.expect(
    !run accepts(Property.Color, b"red icc-color(p, 1)", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "the color property has no SVG ICC extension",
  )
  run Testing.expect(
    !run accepts(Property.TextDecorationColor, b"red icc-color(p, 1)", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "CSS colors do not acquire SVG ICC suffixes",
  )
  let invalid: [&[u8]; 12] = [
    b"red icc-color(p)",
    b"red icc-color(p,)",
    b"red icc-color(,1)",
    b"red icc-color(p,,1)",
    b"red icc-color(p,1,)",
    b"red icc-color(p,1%)",
    b"red icc-color(p,1px)",
    b"red icc-color(p,calc(1))",
    b"red icc-color(p,1+2)",
    b"red icc-color(p,1) junk",
    b"url(#p) none icc-color(p,1)",
    b"url(#p) currentColor icc-color(p,1)",
  ]
  index = 0
  while index < 12 {
    run Testing.expect(
      !run accepts(Property.Fill, invalid[index], Mode.Css)
        |> Effect.provideMut<Allocator>(&mut allocator),
      "malformed ICC input is not discarded or accepted as a color prefix",
    )
    index = index + 1
  }
  run Testing.expect(
    run accepts(Property.Fill, b"red icc-color(p,1", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "CSS Syntax closes functions at EOF",
  )
  run Testing.expect(
    !run accepts(Property.Fill, b"red icc-color(p,1e-2)", Mode.Css)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "SVG11 ICC stylesheet numbers exclude the SVG attribute exponent production",
  )
  run Testing.expect(
    run accepts(Property.Fill, b"red icc-color(123:Print,1)", Mode.Presentation)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "SVG profile names are not restricted to CSS identifiers",
  )
  run Testing.expect(
    !run accepts(Property.Fill, b"red icc-color(p,1", Mode.Presentation)
      |> Effect.provideMut<Allocator>(&mut allocator),
    "SVG ICC grammar requires its closing parenthesis",
  )
}
