//! Linear component indexing for conditional grammars, including expanded Input.
import input { Input, TokenView }
import tokens { Kind, Limits, CssError, CssErrorKind }
import tokens
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Structure {
  ends: List<usize>,
  invalid: List<usize>,
  pub valid: bool,
}

impl Structure {
  pub fn end(self: &Structure, index: usize) -> usize {
    if index >= self.ends.length() {
      return self.ends.length()
    }
    return self.ends.asSlice()[index]
  }

  pub fn any(self: &Structure, start: usize, end: usize) -> bool {
    if !self.valid || start > end || end >= self.invalid.length() {
      return false
    }
    return self.invalid.asSlice()[start] == self.invalid.asSlice()[end]
  }
}

fn opener(kind: &Kind) -> u8 {
  return match &kind.* {
    Kind.OpenParen => 1
    Kind.Function { name } => 1
    Kind.OpenSquare => 2
    Kind.OpenBrace => 3
    _ => 0
  }
}

fn closer(kind: &Kind) -> u8 {
  return match &kind.* {
    Kind.CloseParen => 1
    Kind.CloseSquare => 2
    Kind.CloseBrace => 3
    _ => 0
  }
}

// https://www.w3.org/TR/css-syntax-3/#consume-simple-block
// https://www.w3.org/TR/css-syntax-3/#typedef-any-value
pub effect fn inspect(input: &Input, limits: &Limits) -> Structure
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let count = input.length()
  if count > limits.maxTokens {
    fail CssError { kind: CssErrorKind.TokenLimit, offset: 0 }
  }

  // At most two count-sized indexes, one depth stack, and the prefix sentinel.
  // 8 bytes is a conservative slot bound on all supported 32/64-bit targets.
  if limits.maxStorageBytes < 8 || count > (limits.maxStorageBytes - 8) / 24 {
    fail CssError { kind: CssErrorKind.StorageLimit, offset: 0 }
  }
  let mut valid = true
  match &input.* {
    Input.Contiguous { buffer, range } => {
      if range.start > range.end || range.end > buffer.tokens.length() {
        valid = false
      }
    }
    _ => {}
  }
  let mut result = Structure {
    ends: run List<usize>.makeWithCapacity(count),
    invalid: run List<usize>.makeWithCapacity(count + 1),
    valid: valid,
  }
  let mut stack = List<usize>.make()
  run result.invalid.append(0)
  let mut invalid: usize = 0
  let mut i: usize = 0
  while i < count {
    run result.ends.append(count)
    let view = input.at(i)
    match &view {
      Option<TokenView>.Some { value } => {
        let opening = opener(&value.token.kind)
        let closing = closer(&value.token.kind)
        if opening != 0 {
          if stack.length() >= limits.maxDepth {
            fail CssError { kind: CssErrorKind.NestingLimit, offset: i }
          }
          run stack.append(i)
        } else if closing != 0 {
          let mut matched = false
          if stack.length() > 0 {
            let previous = stack.asSlice()[stack.length() - 1]
            let previousView = input.at(previous)
            match &previousView {
              Option<TokenView>.Some { value: old } => {
                if opener(&old.token.kind) == closing {
                  let mut ends = result.ends.asMutSlice()
                  ends[previous] = i
                  let depth = stack.length() - 1
                  stack.truncate(depth)
                  matched = true
                }
              }
              _ => {}
            }
          }
          if !matched {
            invalid = invalid + 1
          }
        } else {
          match &value.token.kind {
            Kind.BadString => {
              invalid = invalid + 1
            }
            Kind.BadUrl => {
              invalid = invalid + 1
            }
            Kind.Eof => {
              invalid = invalid + 1
            }
            _ => {}
          }
        }
      }
      _ => {
        invalid = invalid + 1
      }
    }
    run result.invalid.append(invalid)
    i = i + 1
  }
  return move result
}

pub fn skip(input: &Input, start: usize, end: usize) -> usize {
  let mut position = start
  while position < end {
    let view = input.at(position)
    match &view {
      Option<TokenView>.Some { value } => {
        match &value.token.kind {
          Kind.Whitespace => {
            position = position + 1
          }
          _ => {
            return position
          }
        }
      }
      _ => {
        return position
      }
    }
  }
  return position
}

pub fn ident(input: &Input, index: usize, want: &[u8]) -> bool {
  let view = input.at(index)
  return match &view {
    Option<TokenView>.Some { value } => {
      return match &value.token.kind {
        Kind.Ident { text } => tokens.insensitive(value.text(text), want)
        _ => false
      }
    }
    _ => false
  }
}
