//! CSSOM View algorithms independent of layout ownership. Coordinates are CSS pixels.
//! Hosts provide current rendered boxes, flat-tree visibility state and writing directions;
//! this module does not synthesize layout, screen metrics, or an animation clock.
import cssom_geometry { DOMRect }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.num.usize
import silk.num.f64

pub enum ScrollBehavior {
  Auto,
  Instant,
  Smooth
}

pub enum ScrollLogicalPosition {
  Start,
  Center,
  End,
  Nearest
}

pub struct ScrollToOptions {
  pub left: Option<f64>,
  pub top: Option<f64>,
  pub behavior: ScrollBehavior,
}

impl Copy for ScrollToOptions {}

impl ScrollToOptions {
  pub fn make() -> Self {
    return Self { left: Option<f64>.None, top: Option<f64>.None, behavior: ScrollBehavior.Auto }
  }
}

pub struct ScrollIntoViewOptions {
  pub behavior: ScrollBehavior,
  pub block: ScrollLogicalPosition,
  pub inline: ScrollLogicalPosition,
  pub nearestContainer: bool,
}

impl Copy for ScrollIntoViewOptions {}

impl ScrollIntoViewOptions {
  pub fn make() -> Self {
    return Self {
      behavior: ScrollBehavior.Auto,
      block: ScrollLogicalPosition.Start,
      inline: ScrollLogicalPosition.Nearest,
      nearestContainer: false,
    }
  }

  pub fn alignToTop(top: bool) -> Self {
    let mut result = ScrollIntoViewOptions.make()
    if !top {
      result.block = ScrollLogicalPosition.End
    }
    return result
  }
}

pub struct CheckVisibilityOptions {
  pub checkOpacity: bool,
  pub checkVisibilityCSS: bool,
  pub contentVisibilityAuto: bool,
  pub opacityProperty: bool,
  pub visibilityProperty: bool,
}

impl Copy for CheckVisibilityOptions {}

impl CheckVisibilityOptions {
  pub fn make() -> Self {
    return Self {
      checkOpacity: false,
      checkVisibilityCSS: false,
      contentVisibilityAuto: false,
      opacityProperty: false,
      visibilityProperty: false,
    }
  }
}

/// Flat-tree facts, including ancestors; visibility itself is the element's used value.
pub struct VisibilityState {
  pub hasBox: bool,
  pub ancestorContentHidden: bool,
  pub ancestorContentAutoSkipped: bool,
  pub zeroOpacity: bool,
  pub visible: bool,
}

impl Copy for VisibilityState {}

pub fn checkVisibility(state: VisibilityState, options: CheckVisibilityOptions) -> bool {
  return state.hasBox && !state.ancestorContentHidden
    && (!(options.checkOpacity || options.opacityProperty) || !state.zeroOpacity)
    && (!(options.checkVisibilityCSS || options.visibilityProperty) || state.visible)
    && (!options.contentVisibilityAuto || !state.ancestorContentAutoSkipped)
}

/// Streaming form of the View bounding-rectangle algorithm. Retains thin fragments for
/// a nondegenerate union, but returns the first rectangle when every fragment is degenerate.
pub struct BoundingRects {
  first: DOMRect,
  combined: DOMRect,
  seen: bool,
  hasExtent: bool,
  hasArea: bool,
}

impl BoundingRects {
  pub fn make() -> BoundingRects {
    return BoundingRects {
      first: DOMRect.zero(),
      combined: DOMRect.zero(),
      seen: false,
      hasExtent: false,
      hasArea: false,
    }
  }

  pub fn append(self: &mut Self, rect: DOMRect) -> () {
    if !self.seen {
      self.first = rect
      self.seen = true
    }
    if rect.width != 0.0 && rect.height != 0.0 {
      self.hasArea = true
    }
    if rect.width != 0.0 || rect.height != 0.0 {
      if !self.hasExtent {
        self.combined = rect
        self.hasExtent = true
      } else {
        let left = f64.min(self.combined.left(), rect.left())
        let top = f64.min(self.combined.top(), rect.top())
        self.combined = DOMRect.make(
          left,
          top,
          f64.max(self.combined.right(), rect.right()) - left,
          f64.max(self.combined.bottom(), rect.bottom()) - top,
        )
      }
    }
  }

  pub fn bounds(self: &Self) -> DOMRect {
    return if self.hasArea {
      self.combined
    } else {
      self.first
    }
  }
}

pub fn boundingRect(rects: &[DOMRect]) -> DOMRect {
  let mut result = BoundingRects.make()
  let mut index: usize = 0
  while index < rects.length {
    result.append(rects[index])
    index = index + 1
  }
  return result.bounds()
}

pub fn normalizeScroll(value: f64) -> f64 {
  return if f64.isFinite(value) {
    value
  } else {
    0.0
  }
}

/// Delta for one physical axis. `reverse` maps logical start to the high physical edge.
/// Nearest leaves a target covering the entire scrollport unmoved, unlike a simple clamp.
pub fn alignAxis(
  start: f64,
  end: f64,
  portStart: f64,
  portEnd: f64,
  alignment: ScrollLogicalPosition,
  reverse: bool,
) -> f64 {
  if alignment == ScrollLogicalPosition.Center {
    return (start + end - portStart - portEnd) / 2.0
  }
  if alignment == ScrollLogicalPosition.Start {
    return if reverse {
      end - portEnd
    } else {
      start - portStart
    }
  }
  if alignment == ScrollLogicalPosition.End {
    return if reverse {
      start - portStart
    } else {
      end - portEnd
    }
  }
  if start < portStart && end > portEnd {
    return 0.0
  }
  let smaller = end - start < portEnd - portStart
  if (start < portStart && smaller) || (end > portEnd && !smaller) {
    return start - portStart
  }
  if (start < portStart && !smaller) || (end > portEnd && smaller) {
    return end - portEnd
  }
  return 0.0
}

/// Point validation rejects nonfinite values and coordinates beyond the scrollbar-excluded viewport.
pub fn pointInViewport(x: f64, y: f64, width: f64, height: f64) -> bool {
  return f64.isFinite(x) && f64.isFinite(y) && x >= 0.0 && y >= 0.0 && x <= width && y <= height
}

/// DOM/browsing-context facts belong to the embedding host, not a layout tree. Missing root
/// or body is NO_VIEW_NODE. The body's potentially-scrollable flag includes its parent's
/// overflow and associated-box checks from CSSOM View's definition.
pub const NO_VIEW_NODE: usize = usize.MAX

pub struct DocumentState {
  pub active: bool,
  pub hasWindow: bool,
  pub hasViewport: bool,
  pub quirksMode: bool,
  pub root: usize,
  pub body: usize,
  pub bodyPotentiallyScrollable: bool,
  pub viewportWidth: f64,
  pub viewportHeight: f64,
  pub viewportScrollX: f64,
  pub viewportScrollY: f64,
  pub scrollingWidth: f64,
  pub scrollingHeight: f64,
}

impl Copy for DocumentState {}

impl DocumentState {
  pub fn scrollingElement(self: &Self) -> usize {
    if self.quirksMode {
      return if self.body != NO_VIEW_NODE && !self.bodyPotentiallyScrollable {
        self.body
      } else {
        NO_VIEW_NODE
      }
    }
    return self.root
  }

  pub fn acceptsPoint(self: &Self, x: f64, y: f64) -> bool {
    return self.hasViewport && pointInViewport(x, y, self.viewportWidth, self.viewportHeight)
  }
}

pub enum ScrollRoute {
  None,
  Element,
  Viewport
}

/// Root/body forwarding is a DOM rule, not a guess based on which native node scrolls.
pub fn scrollRoute(
  document: DocumentState,
  element: usize,
  hasBox: bool,
  hasScrollingBox: bool,
) -> ScrollRoute {
  if !document.active || !document.hasWindow {
    return ScrollRoute.None
  }
  if element == document.root {
    return if document.quirksMode {
      ScrollRoute.None
    } else {
      ScrollRoute.Viewport
    }
  }
  if element == document.body && document.quirksMode && !document.bodyPotentiallyScrollable {
    return ScrollRoute.Viewport
  }
  return if hasBox && hasScrollingBox {
    ScrollRoute.Element
  } else {
    ScrollRoute.None
  }
}

pub fn elementScrollOffset(
  document: DocumentState,
  element: usize,
  hasBox: bool,
  offset: f64,
  horizontal: bool,
) -> f64 {
  return match scrollRoute(document, element, hasBox, true) {
    ScrollRoute.None => 0.0
    ScrollRoute.Element => offset
    ScrollRoute.Viewport => if horizontal {
      document.viewportScrollX
    } else {
      document.viewportScrollY
    }
  }
}

/// HTML viewport special cases apply after excluding absent or inline boxes.
pub fn elementClientExtent(
  document: DocumentState,
  element: usize,
  hasBox: bool,
  inline: bool,
  paddingExtent: f64,
  scrollbarExtent: f64,
  horizontal: bool,
) -> f64 {
  if !hasBox || inline {
    return 0.0
  }
  if (element == document.root && !document.quirksMode)
    || (element == document.body && document.quirksMode) {
    return if horizontal {
      document.viewportWidth
    } else {
      document.viewportHeight
    }
  }
  return f64.max(0.0, paddingExtent - scrollbarExtent)
}

pub fn elementScrollExtent(
  document: DocumentState,
  element: usize,
  hasBox: bool,
  scrollingExtent: f64,
  horizontal: bool,
) -> f64 {
  if !document.active {
    return 0.0
  }
  if (element == document.root && !document.quirksMode)
    || (element == document.body && document.quirksMode && !document.bodyPotentiallyScrollable) {
    return if horizontal {
      f64.max(document.scrollingWidth, document.viewportWidth)
    } else {
      f64.max(document.scrollingHeight, document.viewportHeight)
    }
  }
  return if hasBox {
    scrollingExtent
  } else {
    0.0
  }
}

pub fn currentCSSZoom(rendered: bool, effectiveZoom: f64) -> f64 {
  return if rendered {
    effectiveZoom
  } else {
    1.0
  }
}
