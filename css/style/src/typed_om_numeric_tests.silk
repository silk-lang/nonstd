//! CSS Typed OM §4.3 and §6 numeric algebra and reification regressions.
import typed_om_numeric {
  NumericStore,
  NumericId,
  NumericOperator,
  UnitValue,
  BaseType,
  NumericType
}
import typed_om_numeric_types { combine }
import cssom_error { CssomError }
import tokens { Limits, CssError, equal }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn conversionError(result: &Result<UnitValue, CssomError | OutOfMemoryError>) -> bool {
  return match &result.* {
    Result<UnitValue, CssomError | OutOfMemoryError>.Failure { error } => match &error {
      CssomError value => value == CssomError.TypeError
      _ => false
    }
    _ => false
  }
}

fn constructionError(
  result: &Result<NumericId, CssomError | OutOfMemoryError>,
  expected: CssomError,
) -> bool {
  return match &result.* {
    Result<NumericId, CssomError | OutOfMemoryError>.Failure { error } => match &error {
      CssomError value => value == expected
      _ => false
    }
    _ => false
  }
}

test effect fn typedNumericPercentageHintAlgebra() -> ()
  ! CssomError | AssertionError<'static> {
  let length = NumericType.base(BaseType.Length)
  let percentage = NumericType.base(BaseType.Percent)
  let hinted = run combine(length, percentage, false)
  run Testing.expect(
    hinted.exponents[0] == 1 && hinted.exponents[6] == 0,
    "addition applies the length percent hint",
  )
  run Testing.expect(
    match &hinted.percentHint {
      Option<BaseType>.Some { value } => value == BaseType.Length
      _ => false
    },
    "percent hint remains observable",
  )
  let canceled = run combine(hinted, hinted.inverted(), true)
  run Testing.expect(
    canceled.samePowers(&NumericType.number()) && !canceled.isNumber(),
    "dimensional cancellation preserves percent hint",
  )
  run Testing.expect(
    hinted.matches(BaseType.Length, true) && !hinted.matches(BaseType.Length, false),
    "percentage-bearing length cannot satisfy pure length",
  )
}

test effect fn typedNumericConstructorsPreserveIdentityAndOrder() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let one = run store.unit(1.0, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  let two = run store.unit(2.0, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  let sum = run store.mathSum(&[one, two]) |> Effect.provideMut<Allocator>(&mut allocator)
  let reversed = run store.mathSum(&[two, one]) |> Effect.provideMut<Allocator>(&mut allocator)
  let added = run store.add(one, &[two]) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    store.operator(sum) == NumericOperator.Sum && store.operator(added) == NumericOperator.Unit,
    "constructor preserves operation while add folds identical units",
  )
  run Testing.expect(
    !store.equals(sum, &[reversed]) && store.equals(one, &[]),
    "equality is ordered structural equality and empty variadic equality is true",
  )
  let text = run store.serialize(sum) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(text.asSlice(), b"calc(1px + 2px)"),
    "constructor sum is not computed away",
  )
  let empty = run Effect.result(store.mathSum(&[]) |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(
    constructionError(&empty, CssomError.SyntaxError),
    "empty math constructors throw SyntaxError",
  )
}

test effect fn typedNumericCanonicalUnitsAndCompoundCancellation() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let id = run store.parse(b"calc(1in / 96px)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let number = run store.to(id, b"number") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    number.value == 1.0 && store.typeOf(id).isNumber(),
    "absolute units canonicalize before symbolic cancellation",
  )
  let compound = run store.parse(b"calc(2px * 3deg)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let numericType = store.typeOf(compound)
  run Testing.expect(
    numericType.exponents[0] == 1 && numericType.exponents[1] == 1,
    "products retain compound dimensions",
  )
  let rejected = run Effect.result(
    store.to(compound, b"px") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    conversionError(&rejected),
    "compound units cannot masquerade as a single dimension",
  )
  let resolution = run store.unit(192.0, b"dpi") |> Effect.provideMut<Allocator>(&mut allocator)
  let dppx = run store.to(resolution, b"dppx") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(dppx.value == 2.0, "resolution uses dppx as canonical unit")
}

test effect fn typedNumericRelativeUnitsRemainSymbolic() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let em = run store.unit(2.0, b"em") |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = run Effect.result(
    store.to(em, b"px") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(conversionError(&rejected), "font metrics are never invented")
  let same = run store.to(em, b"em") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(same.value == 2.0, "identity conversion does not require font metrics")
  let quotient = run store.parse(b"calc(4em / 2em)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let canceled = run store.to(quotient, b"number") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(canceled.value == 2.0, "identical relative units cancel symbolically")
  let different = run store.parse(b"calc(4em / 2rem)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unresolved = run Effect.result(
    store.to(different, b"number") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    conversionError(&unresolved),
    "different relative units do not cancel from dimensional type alone",
  )
}

test effect fn typedNumericPercentFlexAndIncompatibleSums() -> ()
  ! CssomError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let percent = run store.unit(50.0, b"percent") |> Effect.provideMut<Allocator>(&mut allocator)
  let px = run store.unit(10.0, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  let mixed = run store.mathSum(&[percent, px]) |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = run Effect.result(
    store.to(mixed, b"px") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(conversionError(&rejected), "percent hint is not a percentage reference value")
  let noUnits: [&'static [u8]; 0] = []
  let parts = run store.toSum(mixed, &noUnits) |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run store.serialize(parts) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(text.asSlice(), b"calc(50% + 10px)"),
    "toSum preserves unresolved percentage and code-point unit order",
  )
  let fr = run store.unit(2.0, b"fr") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(store.typeOf(fr).exponents[5] == 1, "fr has its own flex base type")
  let incompatible = run Effect.result(
    store.add(px, &[fr]) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    constructionError(&incompatible, CssomError.TypeError),
    "length and flex cannot be added",
  )
}

test effect fn typedNumericInvertAndMinMaxRules() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let zero = run store.unit(0.0, b"number") |> Effect.provideMut<Allocator>(&mut allocator)
  let inverseZero = run Effect.result(
    store.invert(zero) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    constructionError(&inverseZero, CssomError.RangeError),
    "arithmetic inversion of unitless zero throws RangeError",
  )
  let wrappedZero = run store.mathInvert(zero) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    store.operator(wrappedZero) == NumericOperator.Invert,
    "CSSMathInvert constructor does not perform arithmetic inversion",
  )
  let absolute = run store.parse(b"min(1in, 100px)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let minimum = run store.to(absolute, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(minimum.value == 96.0, "min compares compatible canonical units")
  let relative = run store.parse(b"max(1em, 10px)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unresolved = run Effect.result(
    store.to(relative, b"px") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    conversionError(&unresolved),
    "min and max require identical symbolic unit maps",
  )
  let denominator = run store.parse(b"calc(1 / (1px + 1em))", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonsum = run Effect.result(
    store.to(denominator, b"number") |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    conversionError(&nonsum),
    "inverse of a multi-term sum cannot be represented as a sum value",
  )
}

test effect fn typedNumericParseIdentityMutationAndClone() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let original = run store.parse(b"42.0px", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let preserved = run store.serialize(original) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(preserved.asSlice(), b"42.0px"),
    "USVString construction retains original serialization",
  )
  let canonical = run store.parseCanonical(b"42.0px", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let normalized = run store.serialize(canonical) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(normalized.asSlice(), b"42px"),
    "CSSOM reification uses canonical numeric serialization",
  )
  let mut copy = NumericStore.make()
  let cloned = run copy.cloneFrom(&store, original) |> Effect.provideMut<Allocator>(&mut allocator)
  run store.setUnitValue(original, 43.0)
  let changed = run store.serialize(original) |> Effect.provideMut<Allocator>(&mut allocator)
  let unchanged = run copy.serialize(cloned) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(changed.asSlice(), b"43px") && equal(unchanged.asSlice(), b"42.0px"),
    "mutation invalidates origin without mutating a cloned arena",
  )
  let expression = run store.parseCanonical(b"calc(1px - 2 * 3em)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run store.serialize(expression) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(text.asSlice(), b"calc(1px - (2 * 3em))"),
    "subtraction reifies as negate over an authored product",
  )
}

test effect fn typedNumericToSumRequestedUnitConsumption() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let value = run store.parse(b"calc(1in + 2em)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parts = run store.toSum(value, &[b"cm", b"px", b"em"])
    |> Effect.provideMut<Allocator>(&mut allocator)
  let children = store.children(parts)
  let first = run store.to(children[0], b"cm") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run store.to(children[1], b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    first.value > 2.539999 && first.value < 2.540001 && second.value == 0.0,
    "first compatible requested unit consumes values; later duplicates get zero",
  )
  let missing = run Effect.result(
    store.toSum(value, &[b"px"]) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    constructionError(&missing, CssomError.TypeError),
    "toSum rejects units omitted by the caller",
  )
}

test effect fn typedNumericParsingRejectsInvalidGrammarAndTypes() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let invalid: [&'static [u8]; 6] = [
    b"1px 2px",
    b"calc(1px+ 2px)",
    b"calc(1px +2px)",
    b"calc(1px + 1s)",
    b"12unknown",
    b"min()",
  ]
  let mut i: usize = 0
  while i < 6 {
    let result = run Effect.result(
      store.parse(invalid[i], &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator),
    )
    run Testing.expect(
      match &result {
        Result<NumericId, CssomError | CssError | OutOfMemoryError>.Failure {
          error
        } => match &error {
          CssomError value => value == CssomError.SyntaxError
          _ => false
        }
        _ => false
      },
      "numeric parse rejects invalid component grammar and incompatible dimensions",
    )
    i = i + 1
  }
  let eofClosed = run store.parse(b"calc(1px + 2px", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let converted = run store.to(eofClosed, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(converted.value == 3.0, "CSS Syntax implicitly closes function blocks at EOF")
}

test effect fn typedNumericClampAndNonfiniteComparisons() -> ()
  ! CssomError | CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let clamp = run store.parseCanonical(b"clamp(10px, 5px, 1px)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run store.to(clamp, b"px") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(value.value == 10.0, "clamp lower bound wins when lower exceeds upper")
  let text = run store.serialize(clamp) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    equal(text.asSlice(), b"clamp(10px, 5px, 1px)"),
    "clamp retains its three authored operands",
  )
  let nan = run store.parseCanonical(b"min(1, NaN)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run store.to(nan, b"number") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(result.value != result.value, "comparison functions propagate NaN")
  let frequency = run store.unit(2.0, b"kHz") |> Effect.provideMut<Allocator>(&mut allocator)
  let hz = run store.to(frequency, b"Hz") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    hz.value == 2000.0 && equal(hz.unit, b"Hz"),
    "frequency factory unit spellings remain valid",
  )
}
