//! Serializes immutable typed values, projecting shorthand fields through their owning arenas.
import values {
  Store,
  Value,
  ValueId,
  Wide,
  Paint,
  Fallback,
  IccId,
  PaintLayer,
  VectorReference,
  Range
}
import values
import properties { Property }
import properties
import cssom_shorthand
import silk.collections.list { List }
import value_keywords
import cssom_serialization as serialization
import cssom_numeric_serialization as numeric
import cssom_text_serialization
import cssom_complex_serialization
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64

effect fn appendKeyword(out: &mut Bytes, name: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < name.length {
    let byte = name[i]
    let lower = if byte >= 65 && byte <= 90 {
      byte + 32
    } else {
      byte
    }
    run Bytes.append(&mut out.*, &[lower])
    i = i + 1
  }
}

effect fn appendIcc(out: &mut Bytes, store: &Store<'_>, id: IccId) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let icc = store.icc(id)
  run Bytes.append(&mut out.*, b" icc-color(")
  let profile = run serialization.identifier(store.text(icc.profile))
  run Bytes.append(&mut out.*, Bytes.asSlice(&profile))
  let mut i: usize = 0
  while i < icc.channels.length() {
    run Bytes.append(&mut out.*, b", ")
    run serialization.appendNumber(&mut out.*, icc.channels.asSlice()[i])
    i = i + 1
  }
  run Bytes.append(&mut out.*, b")")
}

effect fn appendPaint(out: &mut Bytes, store: &Store<'_>, paint: &Paint) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match &paint.* {
    Paint.None => run Bytes.append(&mut out.*, b"none")
    Paint.ContextFill => run Bytes.append(&mut out.*, b"context-fill")
    Paint.ContextStroke => run Bytes.append(&mut out.*, b"context-stroke")
    Paint.Color { color } => run numeric.appendColor(&mut out.*, &color)
    Paint.IccColor { color, icc } => {
      run numeric.appendColor(&mut out.*, &color)
      run appendIcc(&mut out.*, store, icc)
    }
    Paint.Server { url, fallback } => {
      let text = run serialization.url(store.text(url))
      run Bytes.append(&mut out.*, Bytes.asSlice(&text))
      match &fallback {
        Fallback.Missing => {}
        Fallback.None => run Bytes.append(&mut out.*, b" none")
        Fallback.Color { color } => {
          run Bytes.append(&mut out.*, b" ")
          run numeric.appendColor(&mut out.*, &color)
        }
        Fallback.IccColor { color, icc } => {
          run Bytes.append(&mut out.*, b" ")
          run numeric.appendColor(&mut out.*, &color)
          run appendIcc(&mut out.*, store, icc)
        }
      }
    }
  }
}

fn layerName(layer: PaintLayer) -> &'static [u8] {
  return match layer {
    PaintLayer.Fill => b"fill"
    PaintLayer.Stroke => b"stroke"
    PaintLayer.Markers => b"markers"
  }
}

fn layerRank(layer: PaintLayer) -> usize {
  return match layer {
    PaintLayer.Fill => 0
    PaintLayer.Stroke => 1
    PaintLayer.Markers => 2
  }
}

pub effect fn value(
  store: &Store<'_>,
  id: ValueId,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  match &store.get(id).* {
    Value.Wide { keyword } => {
      run Bytes.append(
        &mut out,
        match keyword {
          Wide.Initial => b"initial"
          Wide.Inherit => b"inherit"
          Wide.Unset => b"unset"
          Wide.Revert => b"revert"
        },
      )
    }
    Value.Keyword { keyword } => {
      let projected = if sourceProperty == property {
        keyword
      } else {
        match &values.projectKeyword(store, id, sourceProperty, property) {
          Option<value_keywords.Keyword>.Some { value } => value
          _ => keyword
        }
      }
      run appendKeyword(&mut out, value_keywords.name(projected))
    }
    Value.Numeric { expression, range, basis } => {
      run numeric.appendExpression(&mut out, &store.numerics, expression)
    }
    Value.Color { color } => run numeric.appendColor(&mut out, &color)
    Value.IccColor { color, icc } => {
      run numeric.appendColor(&mut out, &color)
      run appendIcc(&mut out, store, icc)
    }
    Value.Paint { paint } => run appendPaint(&mut out, store, &paint)
    Value.Resource { url } => {
      return run serialization.url(store.text(url))
    }
    Value.Profile { name } => {
      return run serialization.identifier(store.text(name))
    }
    Value.Dashes { expressions } => {
      let mut i: usize = 0
      while i < expressions.length() {
        if i > 0 {
          run Bytes.append(&mut out, b", ")
        }
        run numeric.appendExpression(&mut out, &store.numerics, expressions.asSlice()[i])
        i = i + 1
      }
    }
    Value.PaintOrder { order } => {
      if order[0] == PaintLayer.Fill && order[1] == PaintLayer.Stroke {
        run Bytes.append(&mut out, b"normal")
      } else {
        run Bytes.append(&mut out, layerName(order[0]))

        // The omitted suffix is implicitly filled in the normal painting order.
        if layerRank(order[1]) > layerRank(order[2]) {
          run Bytes.append(&mut out, b" ")
          run Bytes.append(&mut out, layerName(order[1]))
        }
      }
    }
    Value.VectorEffect { flags, reference } => {
      if flags == 0 {
        run Bytes.append(&mut out, b"none")
      } else {
        let bits: [u8; 4] = [1, 2, 4, 8]
        let mut i: usize = 0
        let mut first = true
        while i < 4 {
          if (flags & bits[i]) != 0 {
            if !first {
              run Bytes.append(&mut out, b" ")
            }
            run Bytes.append(
              &mut out,
              if i == 0 {
                b"non-scaling-stroke"
              } else if i == 1 {
                b"non-scaling-size"
              } else if i == 2 {
                b"non-rotation"
              } else {
                b"fixed-position"
              },
            )
            first = false
          }
          i = i + 1
        }
        if reference == VectorReference.Screen {
          run Bytes.append(&mut out, b" screen")
        }
      }
    }
    Value.Cursor { images, fallback } => {
      let mut i: usize = 0
      while i < images.length() {
        let image = images.asSlice()[i]
        let url = run serialization.url(store.text(image.url))
        run Bytes.append(&mut out, Bytes.asSlice(&url))
        if image.hotspot {
          run Bytes.append(&mut out, b" ")
          run serialization.appendNumber(&mut out, image.x)
          run Bytes.append(&mut out, b" ")
          run serialization.appendNumber(&mut out, image.y)
        }
        run Bytes.append(&mut out, b", ")
        i = i + 1
      }
      run Bytes.append(&mut out, value_keywords.name(fallback))
    }
    Value.BlendModes { modes } => {
      let mut i: usize = 0
      while i < modes.length() {
        if i > 0 {
          run Bytes.append(&mut out, b", ")
        }
        run Bytes.append(&mut out, value_keywords.name(modes.asSlice()[i]))
        i = i + 1
      }
    }
    Value.Path { index } => {
      let data = run cssom_complex_serialization.pathData(&store.paths.asSlice()[index])
      let quoted = run serialization.string(Bytes.asSlice(&data))
      run Bytes.append(&mut out, b"path(")
      run Bytes.append(&mut out, Bytes.asSlice(&quoted))
      run Bytes.append(&mut out, b")")
    }
    Value.Text { value: text } => {
      return run cssom_text_serialization.value(store, &text, sourceProperty, property)
    }
    Value.Effect { value: effects } => {
      return run cssom_complex_serialization.effectValue(store, &effects, sourceProperty, property)
    }
    Value.Transform { value: transform } => {
      return run cssom_complex_serialization.transformValue(
        store,
        &transform,
        sourceProperty,
        property,
      )
    }
    Value.ImageOrientation { angle, flip } => {
      run numeric.appendExpression(&mut out, &store.numerics, angle)
      if flip {
        run Bytes.append(&mut out, b" flip")
      }
    }
    Value.Animation { longhands } => {
      let mut i: usize = 0
      if property == Property.Animation {
        let mut parts = run List<Bytes>.makeWithCapacity(8)
        while i < 8 {
          run parts.append(run Bytes.copy(store.text(longhands[i])))
          i = i + 1
        }
        return run cssom_shorthand.serialize(property, parts.asSlice())
      }
      while i < 8 {
        if properties.longhandAt(Property.Animation, i) == property {
          return run Bytes.copy(store.text(longhands[i]))
        }
        i = i + 1
      }
    }
    Value.Raw { text } => {
      return run Bytes.copy(store.text(text))
    }
  }
  return move out
}

// This entry point is for values already processed by values.compute. Specified
// declarations continue to use value(), which deliberately retains math syntax.
pub effect fn computedValue(
  store: &Store<'_>,
  id: ValueId,
  sourceProperty: Property,
  property: Property,
) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let infinity = f64.fromBits(9218868437227405312)
  match &store.get(id).* {
    Value.Numeric { expression, range, basis } => {
      let minimum = match range {
        Range.Unrestricted => -infinity
        Range.AtLeastOne => 1.0
        _ => 0.0
      }
      let maximum = if range == Range.UnitInterval {
        1.0
      } else {
        infinity
      }
      run numeric.appendComputedExpressionInRange(
        &mut out,
        &store.numerics,
        expression,
        minimum,
        maximum,
      )
    }
    Value.Dashes { expressions } => {
      let mut i: usize = 0
      while i < expressions.length() {
        if i > 0 {
          run Bytes.append(&mut out, b", ")
        }
        run numeric.appendComputedExpressionInRange(
          &mut out,
          &store.numerics,
          expressions.asSlice()[i],
          0.0,
          infinity,
        )
        i = i + 1
      }
    }
    Value.ImageOrientation { angle, flip } => {
      run numeric.appendComputedExpression(&mut out, &store.numerics, angle)
      if flip {
        run Bytes.append(&mut out, b" flip")
      }
    }
    Value.Text { value: text } => {
      return run cssom_text_serialization.computedValue(store, &text, sourceProperty, property)
    }
    Value.Effect { value: effects } => {
      return run cssom_complex_serialization.computedEffectValue(
        store,
        &effects,
        sourceProperty,
        property,
      )
    }
    Value.Transform { value: transform } => {
      return run cssom_complex_serialization.computedTransformValue(
        store,
        &transform,
        sourceProperty,
        property,
      )
    }
    _ => {
      return run value(store, id, sourceProperty, property)
    }
  }
  return move out
}
