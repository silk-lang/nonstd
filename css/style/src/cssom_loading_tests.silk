import cssom_loading { Response }
import cssom_loading
import cssom_stylesheet { StyleSheet, RuleList }
import cssom_error { CssomError }
import encoding { Encoding }
import tokens { Limits, CssError }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn responses() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError
  ? &mut Allocator {
  let limits = Limits.make()
  let mut sheet = StyleSheet.make(0, false)
  let mut response = Response {
    bytes: b"a { opacity: .5 }",
    mediaType: b"text/plain",
    protocolEncoding: Option<Encoding>.None,
    corsSameOrigin: true,
    networkError: false,
  }
  let rejected = run cssom_loading.loadResponse(
    &mut sheet,
    &response,
    false,
    Option<Encoding>.None,
    &limits,
  )
  run Testing.expect(
    match &rejected {
      Option<Encoding>.None => true
      _ => false
    }
      && (run sheet.cssRules()).length(&sheet) == 0,
    "standards-mode non-CSS responses do not become stylesheets",
  )
  let accepted = run cssom_loading.loadResponse(
    &mut sheet,
    &response,
    true,
    Option<Encoding>.None,
    &limits,
  )
  run Testing.expect(
    match &accepted {
      Option<Encoding>.Some { value } => value == Encoding.Utf8
      _ => false
    }
      && (run sheet.cssRules()).length(&sheet) == 1,
    "quirks MIME exception accepts CORS-same-origin responses",
  )
  response.corsSameOrigin = false
  let crossOrigin = run cssom_loading.loadResponse(
    &mut sheet,
    &response,
    true,
    Option<Encoding>.None,
    &limits,
  )
  run Testing.expect(
    match &crossOrigin {
      Option<Encoding>.None => true
      _ => false
    }
      && sheet.originClean,
    "quirks mode cannot bypass MIME checking across origins",
  )
  response.mediaType = b"TEXT/CSS"
  let loaded = run cssom_loading.loadResponse(
    &mut sheet,
    &response,
    false,
    Option<Encoding>.None,
    &limits,
  )
  drop loaded
  let access = run Effect.result(sheet.cssRules())
  run Testing.expect(
    match &access {
      Result<RuleList, CssomError>.Failure { error } => error == CssomError.SecurityError
      _ => false
    },
    "cross-origin CSS can render but cannot expose cssRules",
  )
}

test effect fn stylesheetResponsesApplyMimeQuirksAndOriginCleanRules() -> ()
  ! AssertionError<'static> | CssomError | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run responses() |> Effect.provideMut<Allocator>(&mut allocator)
}
