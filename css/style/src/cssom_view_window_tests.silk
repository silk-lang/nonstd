//! CSSOM View ED scrolling, host requests, media reporting and coordinate contracts.
import cssom_view_window {
  ScrollState,
  ScrollResult,
  ViewTarget,
  ViewTargetKind,
  ViewEventKind,
  Window,
  Screen,
  WindowViewport,
  WindowDisplay,
  VisualViewport,
  ScrollToOptions,
  MouseEvent,
  MouseDispatchCoordinates,
  WindowRequests,
  WindowRequestResult,
  WindowFeature,
  BrowsingContextPolicy,
  MediaQueryLists,
  MediaQueryList
}
import cssom_view_window
import cssom_view { ScrollBehavior }
import cssom_error { CssomError }
import media_features { Environment }
import tokens { Limits, CssError }
import tokens
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

fn visual() -> VisualViewport {
  return VisualViewport {
    fullyActive: true,
    hasOutputDevice: true,
    layoutOffsetX: 0.0,
    layoutOffsetY: 0.0,
    documentOffsetX: 0.0,
    documentOffsetY: 0.0,
    viewportWidth: 80.0,
    viewportHeight: 80.0,
    scaleFactor: 1.25,
  }
}

fn window() -> Window {
  return Window {
    document: 7,
    screen: Screen {
      availWidth: 1000,
      availHeight: 700,
      width: 1000,
      height: 800,
      outputColorBits: Option<u32>.None,
      mediaColorBits: 10,
    },
    display: Option<WindowDisplay>.None,
    viewport: Option<WindowViewport>.some(
      WindowViewport {
        width: 115.0,
        height: 115.0,
        scrollportWidth: 100.0,
        scrollportHeight: 100.0,
        scrollingAreaWidth: 600.0,
        scrollingAreaHeight: 1000.0,
        scrollX: 0.0,
        scrollY: 0.0,
        overflowLeftward: false,
        overflowUpward: false,
        ongoingSmoothScroll: false,
      },
    ),
    visualViewportState: Option<VisualViewport>.some(visual()),
  }
}

effect fn completionBehavior() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError
  ? &mut Allocator {
  let mut state = ScrollState.make()
  let target = ViewTarget { kind: ViewTargetKind.Document, id: 4 }
  let first = run state.begin(target, 0.0, 0.0, 0.0, 100.0, ScrollBehavior.Auto, true, true)
  run Testing.expect(
    first.behavior == ScrollBehavior.Smooth && state.pending(first.id),
    "request creation is not completion",
  )
  run state.update(first.id, 0.0, 30.0)
  run state.update(first.id, 0.0, 40.0)
  run Testing.expect(
    state.events().length == 1 && state.events()[0].bubbles,
    "scroll events deduplicate and document events bubble",
  )
  run Testing.expect(
    !(run state.complete(first.id, true, false)),
    "pending translation prevents completion",
  )
  run Testing.expect(
    !(run state.complete(first.id, false, true)),
    "held gesture prevents completion",
  )
  let second = run state.begin(target, 0.0, 40.0, 0.0, 60.0, ScrollBehavior.Instant, true, true)
  run Testing.expect(
    (run cssom_view_window.combinedScrollResult(&state, &[first.id])) == ScrollResult.Interrupted,
    "replacement resolves prior promise as interrupted",
  )
  run Testing.expect(second.behavior == ScrollBehavior.Instant, "instant overrides smooth style")
  run Testing.expect(
    (run cssom_view_window.combinedScrollResult(&state, &[first.id, second.id]))
      == ScrollResult.Pending,
    "aggregate waits for every request even after interruption",
  )
  run state.update(second.id, 0.0, 60.0)
  run Testing.expect(
    run state.complete(second.id, false, false),
    "host completion settles updated scroll",
  )
  run Testing.expect(
    state.events().length == 2 && state.events()[0].kind == ViewEventKind.Scroll
      && state.events()[1].kind == ViewEventKind.ScrollEnd,
    "scroll precedes one scrollend",
  )
  run Testing.expect(
    (run cssom_view_window.combinedScrollResult(&state, &[first.id, second.id]))
      == ScrollResult.Interrupted,
    "aggregate reports interrupted only after all settle",
  )
  state.clearEvents()
  let noop = run state.begin(target, 0.0, 60.0, 0.0, 60.0, ScrollBehavior.Instant, false, true)
  drop run state.complete(noop.id, false, false)
  run Testing.expect(
    state.events().length == 0,
    "unchanged scroll emits neither scroll nor scrollend",
  )
  let roundtrip = run state.begin(target, 0.0, 60.0, 0.0, 60.0, ScrollBehavior.Smooth, false, true)
  run state.update(roundtrip.id, 0.0, 70.0)
  run state.update(roundtrip.id, 0.0, 60.0)
  drop run state.complete(roundtrip.id, false, false)
  run Testing.expect(
    state.events().length == 2,
    "actual movement counts even when final offset equals start",
  )
  run state.release(first.id)
  run state.release(second.id)
  run Testing.expect(
    (run cssom_view_window.combinedScrollResult(&state, &[roundtrip.id])) == ScrollResult.Completed,
    "releasing old results preserves newer request identities",
  )
}

test effect fn cssomViewScrollCompletionTracksActualHostProgress() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run completionBehavior() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn coordinatedBehavior() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError
  ? &mut Allocator {
  let view = window()
  let options = ScrollToOptions {
    left: Option<f64>.None,
    top: Option<f64>.some(50.0),
    behavior: ScrollBehavior.Smooth,
  }
  let plan = cssom_view_window.planViewportScroll(&view, options, false)
  run Testing.expect(
    plan.layoutY == 30.0 && plan.visualY == 20.0,
    "visual viewport consumes 20 then pushes layout 30",
  )
  let mut state = ScrollState.make()
  let request = run view.scroll(&mut state, options, false, true)
  let layout = match request.layout {
    Option<cssom_view_window.ScrollRequest>.Some { value } => value.id
    _ => 999
  }
  let visualId = match request.visual {
    Option<cssom_view_window.ScrollRequest>.Some { value } => value.id
    _ => 999
  }
  run Testing.expect(
    layout < visualId && (run request.result(&state)) == ScrollResult.Pending,
    "coordinated scroll submits layout first and remains pending",
  )
  run state.update(layout, 0.0, 30.0)
  drop run state.complete(layout, false, false)
  run Testing.expect(
    (run request.result(&state)) == ScrollResult.Pending,
    "layout completion does not settle visual scrolling",
  )
  run state.update(visualId, 0.0, 20.0)
  drop run state.complete(visualId, false, false)
  run Testing.expect(
    (run request.result(&state)) == ScrollResult.Completed,
    "both host acknowledgments complete viewport request",
  )
  let mut absent = view
  absent.viewport = Option<WindowViewport>.None
  let noViewport = run absent.scroll(&mut state, options, false, true)
  run Testing.expect(
    (run noViewport.result(&state)) == ScrollResult.Completed,
    "no viewport uses normative resolved no-op result",
  )
  let mut reverse = view
  reverse.visualViewportState = Option<VisualViewport>.None
  let mut port = match reverse.viewport {
    Option<WindowViewport>.Some { value } => value
    _ => {
      return
    }
  }
  port.overflowLeftward = true
  port.overflowUpward = true
  reverse.viewport = Option<WindowViewport>.some(port)
  let negative = cssom_view_window.planViewportScroll(
    &reverse,
    ScrollToOptions {
      left: Option<f64>.some(-900.0),
      top: Option<f64>.some(-1000.0),
      behavior: ScrollBehavior.Auto,
    },
    false,
  )
  run Testing.expect(
    negative.layoutX == -500.0 && negative.layoutY == -900.0,
    "reverse overflow clamps to negative scroll range",
  )
}

test effect fn cssomViewCoordinatesLayoutAndVisualScrollCompletion() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run coordinatedBehavior() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomViewScreenInactiveViewportAndMouseCoordinates() -> ()
  ! AssertionError<'static> {
  let view = window()
  run Testing.expect(
    view.screen.colorDepth() == 30 && view.screen.pixelDepth() == 30,
    "unknown screen depth respects media color lower bound",
  )
  run Testing.expect(
    view.innerWidth() == 115.0 && view.outerWidth() == 0.0 && view.devicePixelRatio() == 1.0,
    "inner dimensions include scrollbars and absent output has specified fallbacks",
  )
  let mut vv = visual()
  vv.fullyActive = false
  run Testing.expect(
    vv.width() == 0.0 && vv.height() == 0.0 && vv.scale() == 0.0 && vv.pageLeft() == 0.0,
    "inactive visual viewport exposes zero",
  )
  let mut inactive = view
  inactive.visualViewportState = Option<VisualViewport>.some(vv)
  run Testing.expect(
    match inactive.visualViewport() {
      Option<VisualViewport>.None => true
      _ => false
    },
    "window exposes null visualViewport when its associated document is inactive",
  )
  vv.fullyActive = true
  vv.hasOutputDevice = false
  run Testing.expect(vv.scale() == 1.0, "active visual viewport without output has unit scale")
  let mut mouse = MouseEvent {
    screenX: 120.0,
    screenY: 140.0,
    clientX: 12.0,
    clientY: 14.0,
    dispatch: Option<MouseDispatchCoordinates>.None,
  }
  run Testing.expect(
    mouse.pageX(100.0) == 112.0 && mouse.offsetY(200.0) == 214.0 && mouse.x() == 12.0,
    "outside dispatch page/offset use current window scroll plus client coordinates",
  )
  mouse.dispatch = Option<MouseDispatchCoordinates>.some(
    MouseDispatchCoordinates { pageX: 90.0, pageY: 80.0, offsetX: 3.0, offsetY: 4.0 },
  )
  run Testing.expect(
    mouse.pageX(1000.0) == 90.0 && mouse.offsetX(1000.0) == 3.0,
    "dispatch uses host event position and untransformed target padding coordinates",
  )
}

effect fn requestBehavior() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError
  ? &mut Allocator {
  let features = cssom_view_window.parseWindowFeatures(
    &[
      WindowFeature { name: b"left", value: b" \t-12junk" },
      WindowFeature { name: b"top", value: b"invalid" },
      WindowFeature { name: b"width", value: b"0" },
      WindowFeature { name: b"height", value: b"+240px" },
    ],
  )
  run Testing.expect(
    match features.left {
      Option<f64>.Some { value } => value == -12.0
      _ => false
    },
    "feature integer permits whitespace sign and trailing text",
  )
  run Testing.expect(
    match features.top {
      Option<f64>.Some { value } => value == 0.0
      _ => false
    },
    "invalid position becomes zero",
  )
  run Testing.expect(
    match features.width {
      Option<f64>.None => true
      _ => false
    },
    "zero width does not request a resize",
  )
  let mut requests = WindowRequests.make()
  let mut policy = BrowsingContextPolicy {
    scriptCreatedAuxiliary: false,
    pictureInPicture: false,
    transientActivation: false,
    allowMove: true,
    allowResize: true,
  }
  let denied = run requests.moveTo(7, &policy, 100, 200)
  run Testing.expect(
    denied.result == WindowRequestResult.Ignored,
    "non-script-created window cannot be moved",
  )
  policy.scriptCreatedAuxiliary = true
  let accepted = run requests.moveBy(7, &policy, -10, 20)
  run Testing.expect(
    accepted.result == WindowRequestResult.Pending,
    "platform move remains pending before host completion",
  )
  let actual = WindowDisplay {
    screenX: 90.0,
    screenY: 220.0,
    outerWidth: 640.0,
    outerHeight: 480.0,
    devicePixelRatio: 2.0,
  }
  run requests.complete(
    accepted.id,
    WindowRequestResult.Applied,
    Option<WindowDisplay>.some(actual),
  )
  run Testing.expect(
    match requests.get(accepted.id) {
      Option<cssom_view_window.WindowRequest>.Some { value } => value.result
        == WindowRequestResult.Applied
      _ => false
    },
    "host acknowledgement makes completion observable",
  )
  policy.pictureInPicture = true
  policy.transientActivation = true
  let resize = run requests.resizeTo(7, &mut policy, 300, 200)
  run Testing.expect(
    !policy.transientActivation && resize.result == WindowRequestResult.Pending,
    "picture-in-picture resize consumes activation without claiming completion",
  )
  let moved = run requests.moveBy(7, &policy, 1, 1)
  run Testing.expect(
    moved.result == WindowRequestResult.Ignored,
    "picture-in-picture is never moved",
  )
  let open = run requests.setUpBrowsingContextFeatures(
    8,
    &[WindowFeature { name: b"height", value: b"200" }],
  )
  run Testing.expect(open.result == WindowRequestResult.Pending, "open sizing awaits host work")
}

test effect fn cssomViewWindowRequestsHonorPermissionsAndAwaitHost() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run requestBehavior() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn mediaBehavior() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError
  ? &mut Allocator {
  let mut lists = MediaQueryLists.make()
  let limits = Limits.make()
  let small = Environment.headless(400.0, 300.0)
  let large = Environment.headless(800.0, 600.0)
  let first = run lists.matchMedia(7, b"(MIN-width: 600PX)", &small, &limits)
  let second = run lists.matchMedia(7, b"(width < 600px)", &small, &limits)
  drop run lists.matchMedia(8, b"(width >= 600px)", &small, &limits)
  match move lists.getMut(first) {
    Option<&mut MediaQueryList>.Some { value } => {
      run value.addListener(Option<usize>.some(10))
      run value.addListener(Option<usize>.some(10))
      run value.addListener(Option<usize>.None)
      run Testing.expect(
        value.listeners().length == 1,
        "legacy listener registration deduplicates callback identity and ignores null",
      )
      value.removeListener(Option<usize>.some(10))
      run Testing.expect(
        value.listeners().length == 0,
        "legacy listener removal uses same callback identity",
      )
      run value.addEventListener(b"change", Option<usize>.some(10), false)
      run value.addListener(Option<usize>.some(10))
      run value.setOnchange(Option<usize>.some(20))
      run value.addEventListener(b"change", Option<usize>.some(30), false)
      run value.setOnchange(Option<usize>.some(21))
      run Testing.expect(
        value.listeners().length == 3 && value.listeners()[1].callback == 21,
        "legacy and standard listeners share identity; onchange replacement preserves registration order",
      )
      value.removeListener(Option<usize>.some(10))
      run value.setOnchange(Option<usize>.None)
      run Testing.expect(
        value.listeners().length == 1 && value.listeners()[0].callback == 30,
        "legacy removal also removes standard registration and null onchange unregisters its handler",
      )
      run Testing.expect(
        run value.matches(&large, &limits),
        "matches reads current environment without consuming report baseline",
      )
    }
    _ => {}
  }
  let events = run lists.reportChanges(7, &large, &limits)
  run Testing.expect(
    events.length() == 2 && events.asSlice()[0].target == first
      && events.asSlice()[1].target == second,
    "media changes use creation order and filter associated document",
  )
  run Testing.expect(
    events.asSlice()[0].matches && !events.asSlice()[1].matches && events.asSlice()[0].isTrusted
      && tokens.equal(Bytes.asSlice(&events.asSlice()[0].media), b"(min-width: 600px)"),
    "media events snapshot canonical text and match state",
  )
  let unchanged = run lists.reportChanges(7, &large, &limits)
  run Testing.expect(unchanged.length() == 0, "unchanged media state emits no repeated event")
}

test effect fn cssomViewMediaChangesUseCanonicalQueriesAndCreationOrder() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mediaBehavior() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn resizeBehavior() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let old = window()
  let mut current = old
  let mut vv = visual()
  vv.scaleFactor = 2.0
  current.visualViewportState = Option<VisualViewport>.some(vv)
  let mut state = ScrollState.make()
  run cssom_view_window.runResizeSteps(&old, &current, &mut state)
  run cssom_view_window.runResizeSteps(&old, &current, &mut state)
  run Testing.expect(
    state.events().length == 1 && state.events()[0].target.kind == ViewTargetKind.VisualViewport
      && !state.events()[0].bubbles,
    "pinch scaling emits one visual resize, not window resize",
  )
  state.clearEvents()
  let mut port = match current.viewport {
    Option<WindowViewport>.Some { value } => value
    _ => {
      return
    }
  }
  port.width = 120.0
  current.viewport = Option<WindowViewport>.some(port)
  run cssom_view_window.runResizeSteps(&old, &current, &mut state)
  run Testing.expect(
    state.events().length == 2 && state.events()[0].target.kind == ViewTargetKind.Window
      && state.events()[1].target.kind == ViewTargetKind.VisualViewport,
    "window resize precedes visual viewport resize",
  )
}

test effect fn cssomViewResizeEventsCompareScaleAndDimensionsInOrder() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run resizeBehavior() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssomViewRejectsUnauthorizedPipResizeAndInventedCompletion() -> ()
  ! AssertionError<'static> | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut requests = WindowRequests.make()
  let mut policy = BrowsingContextPolicy {
    scriptCreatedAuxiliary: true,
    pictureInPicture: true,
    transientActivation: false,
    allowMove: true,
    allowResize: true,
  }
  let denied = run Effect.result(
    requests.resizeTo(7, &mut policy, 100, 100) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &denied {
      Result<cssom_view_window.WindowRequest, CssomError | OutOfMemoryError>.Failure {
        error
      } => match &error {
        CssomError value => value == CssomError.NotAllowedError
        _ => false
      }
      _ => false
    },
    "picture-in-picture resize requires transient activation",
  )
  policy.pictureInPicture = false
  let request = run requests.moveTo(7, &policy, 100, 100)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invented = run Effect.result(
    requests.complete(request.id, WindowRequestResult.Applied, Option<WindowDisplay>.None),
  )
  run Testing.expect(
    match &invented {
      Result<(), CssomError>.Failure { error } => error == CssomError.InvalidStateError
      _ => false
    },
    "applied platform request requires actual host geometry",
  )
  let mut state = ScrollState.make()
  let target = ViewTarget { kind: ViewTargetKind.Element, id: 9 }
  let scroll = run state.begin(target, 0.0, 0.0, 10.0, 20.0, ScrollBehavior.Smooth, true, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(scroll.behavior == ScrollBehavior.Instant, "host may decline smooth behavior")
  state.interruptTarget(target)
  let stale = run Effect.result(
    state.update(scroll.id, 10.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &stale {
      Result<(), CssomError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError value => value == CssomError.InvalidStateError
        _ => false
      }
      _ => false
    },
    "late animator updates cannot revive interrupted promises",
  )
}
