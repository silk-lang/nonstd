    Keyword.ColResize => b"col-resize"
    Keyword.RowResize => b"row-resize"
    Keyword.EwResize => b"ew-resize"
    Keyword.NsResize => b"ns-resize"
    Keyword.NeswResize => b"nesw-resize"
    Keyword.NwseResize => b"nwse-resize"
    Keyword.ZoomIn => b"zoom-in"
    Keyword.ZoomOut => b"zoom-out"
  }
}

pub fn parse(property: Property, source: &Input, cursor: &mut Cursor) -> Option<Keyword> {
  match property {
    Property.FillRule => {
      if cursor.ident(source, b"nonzero") {
        return Option<Keyword>.some(Keyword.Nonzero)
      }
      if cursor.ident(source, b"evenodd") {
        return Option<Keyword>.some(Keyword.Evenodd)
      }
    }
    Property.ClipRule => {
      if cursor.ident(source, b"nonzero") {
        return Option<Keyword>.some(Keyword.Nonzero)
      }
      if cursor.ident(source, b"evenodd") {
        return Option<Keyword>.some(Keyword.Evenodd)
      }
    }
    Property.StrokeLinecap => {
      if cursor.ident(source, b"butt") {
        return Option<Keyword>.some(Keyword.Butt)
      }
      if cursor.ident(source, b"round") {
        return Option<Keyword>.some(Keyword.Round)
      }
      if cursor.ident(source, b"square") {
        return Option<Keyword>.some(Keyword.Square)
      }
    }
    Property.StrokeLinejoin => {
      if cursor.ident(source, b"miter") {
        return Option<Keyword>.some(Keyword.Miter)
      }
      if cursor.ident(source, b"miter-clip") {
        return Option<Keyword>.some(Keyword.MiterClip)
      }
      if cursor.ident(source, b"round") {
        return Option<Keyword>.some(Keyword.Round)
      }
      if cursor.ident(source, b"bevel") {
        return Option<Keyword>.some(Keyword.Bevel)
      }
      if cursor.ident(source, b"arcs") {
        return Option<Keyword>.some(Keyword.Arcs)
      }
    }
    Property.ColorInterpolation => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"sRGB") {
        return Option<Keyword>.some(Keyword.SRGB)
      }
      if cursor.ident(source, b"linearRGB") {
        return Option<Keyword>.some(Keyword.LinearRGB)
      }
    }
    Property.ColorInterpolationFilters => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"sRGB") {
        return Option<Keyword>.some(Keyword.SRGB)
      }
      if cursor.ident(source, b"linearRGB") {
        return Option<Keyword>.some(Keyword.LinearRGB)
      }
    }
    Property.ColorRendering => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"optimizeSpeed") {
        return Option<Keyword>.some(Keyword.OptimizeSpeed)
      }
      if cursor.ident(source, b"optimizeQuality") {
        return Option<Keyword>.some(Keyword.OptimizeQuality)
      }
    }
    Property.ShapeRendering => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"optimizeSpeed") {
        return Option<Keyword>.some(Keyword.OptimizeSpeed)
      }
      if cursor.ident(source, b"crispEdges") {
        return Option<Keyword>.some(Keyword.CrispEdges)
      }
      if cursor.ident(source, b"geometricPrecision") {
        return Option<Keyword>.some(Keyword.GeometricPrecision)
      }
    }
    Property.ImageOrientation => {
      if cursor.ident(source, b"none") {
        return Option<Keyword>.some(Keyword.None)
      }
      if cursor.ident(source, b"from-image") {
        return Option<Keyword>.some(Keyword.FromImage)
      }
    }
    Property.ImageRendering => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"optimizeQuality") {
        return Option<Keyword>.some(Keyword.OptimizeQuality)
      }
      if cursor.ident(source, b"optimizeSpeed") {
        return Option<Keyword>.some(Keyword.OptimizeSpeed)
      }
    }
    Property.TextRendering => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"optimizeSpeed") {
        return Option<Keyword>.some(Keyword.OptimizeSpeed)
      }
      if cursor.ident(source, b"optimizeLegibility") {
        return Option<Keyword>.some(Keyword.OptimizeLegibility)
      }
      if cursor.ident(source, b"geometricPrecision") {
        return Option<Keyword>.some(Keyword.GeometricPrecision)
      }
    }
    Property.TextAnchor => {
      if cursor.ident(source, b"start") {
        return Option<Keyword>.some(Keyword.Start)
      }
      if cursor.ident(source, b"middle") {
        return Option<Keyword>.some(Keyword.Middle)
      }
      if cursor.ident(source, b"end") {
        return Option<Keyword>.some(Keyword.End)
      }
    }
    Property.Direction => {
      if cursor.ident(source, b"ltr") {
        return Option<Keyword>.some(Keyword.Ltr)
      }
      if cursor.ident(source, b"rtl") {
        return Option<Keyword>.some(Keyword.Rtl)
      }
    }
    Property.UnicodeBidi => {
      if cursor.ident(source, b"normal") {
        return Option<Keyword>.some(Keyword.Normal)
      }
      if cursor.ident(source, b"embed") {
        return Option<Keyword>.some(Keyword.Embed)
      }
      if cursor.ident(source, b"isolate") {
        return Option<Keyword>.some(Keyword.Isolate)
      }
      if cursor.ident(source, b"bidi-override") {
        return Option<Keyword>.some(Keyword.BidiOverride)
      }
      if cursor.ident(source, b"isolate-override") {
        return Option<Keyword>.some(Keyword.IsolateOverride)
      }
      if cursor.ident(source, b"plaintext") {
        return Option<Keyword>.some(Keyword.Plaintext)
      }
    }
    Property.WritingMode => {
      if cursor.ident(source, b"horizontal-tb") {
        return Option<Keyword>.some(Keyword.HorizontalTb)
      }
      if cursor.ident(source, b"vertical-rl") {
        return Option<Keyword>.some(Keyword.VerticalRl)
      }
      if cursor.ident(source, b"vertical-lr") {
        return Option<Keyword>.some(Keyword.VerticalLr)
      }
      if cursor.ident(source, b"lr") {
        return Option<Keyword>.some(Keyword.Lr)
      }
      if cursor.ident(source, b"lr-tb") {
        return Option<Keyword>.some(Keyword.LrTb)
      }
      if cursor.ident(source, b"rl") {
        return Option<Keyword>.some(Keyword.Rl)
      }
      if cursor.ident(source, b"rl-tb") {
        return Option<Keyword>.some(Keyword.RlTb)
      }
      if cursor.ident(source, b"tb") {
        return Option<Keyword>.some(Keyword.Tb)
      }
      if cursor.ident(source, b"tb-rl") {
        return Option<Keyword>.some(Keyword.TbRl)
      }
    }
    Property.TextOrientation => {
      if cursor.ident(source, b"mixed") {
        return Option<Keyword>.some(Keyword.Mixed)
      }
      if cursor.ident(source, b"upright") {
        return Option<Keyword>.some(Keyword.Upright)
      }
      if cursor.ident(source, b"sideways") {
        return Option<Keyword>.some(Keyword.Sideways)
      }
    }
    Property.OverflowWrap => {
      if cursor.ident(source, b"normal") {
        return Option<Keyword>.some(Keyword.Normal)
      }
      if cursor.ident(source, b"break-word") {
        return Option<Keyword>.some(Keyword.BreakWord)
      }
      if cursor.ident(source, b"anywhere") {
        return Option<Keyword>.some(Keyword.Anywhere)
      }
    }
    Property.WordBreak => {
      if cursor.ident(source, b"normal") {
        return Option<Keyword>.some(Keyword.Normal)
      }
      if cursor.ident(source, b"keep-all") {
        return Option<Keyword>.some(Keyword.KeepAll)
      }
      if cursor.ident(source, b"break-all") {
        return Option<Keyword>.some(Keyword.BreakAll)
      }
      if cursor.ident(source, b"break-word") {
        return Option<Keyword>.some(Keyword.BreakWord)
      }
    }
    Property.LineBreak => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"loose") {
        return Option<Keyword>.some(Keyword.Loose)
      }
      if cursor.ident(source, b"normal") {
        return Option<Keyword>.some(Keyword.Normal)
      }
      if cursor.ident(source, b"strict") {
        return Option<Keyword>.some(Keyword.Strict)
      }
      if cursor.ident(source, b"anywhere") {
        return Option<Keyword>.some(Keyword.Anywhere)
      }
    }
    Property.TextAlign => {
      if cursor.ident(source, b"start") {
        return Option<Keyword>.some(Keyword.Start)
      }
      if cursor.ident(source, b"end") {
        return Option<Keyword>.some(Keyword.End)
      }
      if cursor.ident(source, b"left") {
        return Option<Keyword>.some(Keyword.Left)
      }
      if cursor.ident(source, b"right") {
        return Option<Keyword>.some(Keyword.Right)
      }
      if cursor.ident(source, b"center") {
        return Option<Keyword>.some(Keyword.Center)
      }
      if cursor.ident(source, b"justify") {
        return Option<Keyword>.some(Keyword.Justify)
      }
      if cursor.ident(source, b"match-parent") {
        return Option<Keyword>.some(Keyword.MatchParent)
      }
      if cursor.ident(source, b"justify-all") {
        return Option<Keyword>.some(Keyword.JustifyAll)
      }
    }
    Property.TextAlignAll => {
      if cursor.ident(source, b"start") {
        return Option<Keyword>.some(Keyword.Start)
      }
      if cursor.ident(source, b"end") {
        return Option<Keyword>.some(Keyword.End)
      }
      if cursor.ident(source, b"left") {
        return Option<Keyword>.some(Keyword.Left)
      }
      if cursor.ident(source, b"right") {
        return Option<Keyword>.some(Keyword.Right)
      }
      if cursor.ident(source, b"center") {
        return Option<Keyword>.some(Keyword.Center)
      }
      if cursor.ident(source, b"justify") {
        return Option<Keyword>.some(Keyword.Justify)
      }
      if cursor.ident(source, b"match-parent") {
        return Option<Keyword>.some(Keyword.MatchParent)
      }
    }
    Property.TextAlignLast => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"start") {
        return Option<Keyword>.some(Keyword.Start)
      }
      if cursor.ident(source, b"end") {
        return Option<Keyword>.some(Keyword.End)
      }
      if cursor.ident(source, b"left") {
        return Option<Keyword>.some(Keyword.Left)
      }
      if cursor.ident(source, b"right") {
        return Option<Keyword>.some(Keyword.Right)
      }
      if cursor.ident(source, b"center") {
        return Option<Keyword>.some(Keyword.Center)
      }
      if cursor.ident(source, b"justify") {
        return Option<Keyword>.some(Keyword.Justify)
      }
      if cursor.ident(source, b"match-parent") {
        return Option<Keyword>.some(Keyword.MatchParent)
      }
    }
    Property.TextJustify => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"none") {
        return Option<Keyword>.some(Keyword.None)
      }
      if cursor.ident(source, b"inter-word") {
        return Option<Keyword>.some(Keyword.InterWord)
      }
      if cursor.ident(source, b"inter-character") {
        return Option<Keyword>.some(Keyword.InterCharacter)
      }
    }
    Property.TextCombineUpright => {
      if cursor.ident(source, b"none") {
        return Option<Keyword>.some(Keyword.None)
      }
      if cursor.ident(source, b"all") {
        return Option<Keyword>.some(Keyword.All)
      }
    }
    Property.Hyphens => {
      if cursor.ident(source, b"none") {
        return Option<Keyword>.some(Keyword.None)
      }
      if cursor.ident(source, b"manual") {
        return Option<Keyword>.some(Keyword.Manual)
      }
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
    }
    Property.BaselineSource => {
      if cursor.ident(source, b"auto") {
        return Option<Keyword>.some(Keyword.Auto)
      }
      if cursor.ident(source, b"first") {
        return Option<Keyword>.some(Keyword.First)
      }
      if cursor.ident(source, b"last") {
        return Option<Keyword>.some(Keyword.Last)
      }
    }
    Property.FontVariantEmoji => {
      if cursor.ident(source, b"normal") {
        return Option<Keyword>.some(Keyword.Normal)
      }
      if cursor.ident(source, b"text") {
        return Option<Keyword>.some(Keyword.Text)
      }
      if cursor.ident(source, b"emoji") {
        return Option<Keyword>.some(Keyword.Emoji)
      }
      if cursor.ident(source, b"unicode") {
        return Option<Keyword>.some(Keyword.Unicode)
      }
    }
    Property.MaskType => {
      if cursor.ident(source, b"luminance") {
        return Option<Keyword>.some(Keyword.Luminance)
      }
      if cursor.ident(source, b"alpha") {
        return Option<Keyword>.some(Keyword.Alpha)
      }
    }
    Property.MaskBorderMode => {
      if cursor.ident(source, b"luminance") {
        return Option<Keyword>.some(Keyword.Luminance)
      }
      if cursor.ident(source, b"alpha") {
        return Option<Keyword>.some(Keyword.Alpha)
      }
    }
    Property.Display => {
      if cursor.ident(source, b"inline") {
        return Option<Keyword>.some(Keyword.Inline)
      }
      if cursor.ident(source, b"block") {
        return Option<Keyword>.some(Keyword.Block)
      }
      if cursor.ident(source, b"list-item") {
        return Option<Keyword>.some(Keyword.ListItem)
      }
      if cursor.ident(source, b"run-in") {
        return Option<Keyword>.some(Keyword.RunIn)
      }
      if cursor.ident(source, b"compact") {
        return Option<Keyword>.some(Keyword.Compact)
      }
      if cursor.ident(source, b"marker") {
        return Option<Keyword>.some(Keyword.Marker)
      }
      if cursor.ident(source, b"table") {
        return Option<Keyword>.some(Keyword.Table)
      }
      if cursor.ident(source, b"inline-table") {
        return Option<Keyword>.some(Keyword.InlineTable)
      }
      if cursor.ident(source, b"table-row-group") {
        return Option<Keyword>.some(Keyword.TableRowGroup)
      }
      if cursor.ident(source, b"table-header-group") {
        return Option<Keyword>.some(Keyword.TableHeaderGroup)
      }
      if cursor.ident(source, b"table-footer-group") {
        return Option<Keyword>.some(Keyword.TableFooterGroup)
      }
      if cursor.ident(source, b"table-row") {
        return Option<Keyword>.some(Keyword.TableRow)
      }
      if cursor.ident(source, b"table-column-group") {
        return Option<Keyword>.some(Keyword.TableColumnGroup)
      }
      if cursor.ident(source, b"table-column") {
        return Option<Keyword>.some(Keyword.TableColumn)
      }
      if cursor.ident(source, b"table-cell") {
        return Option<Keyword>.some(Keyword.TableCell)
      }
      if cursor.ident(source, b"table-caption") {
