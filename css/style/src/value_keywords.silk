//! Closed keyword vocabulary; identifiers are accepted only by their property grammar.
import properties { Property }
import input { Input }
import value_cursor { Cursor }
import silk.core.option { Option }

pub enum Keyword {
  None,
  FromImage,
  Auto,
  Normal,
  SRGB,
  Nonzero,
  Evenodd,
  Butt,
  Round,
  Square,
  Miter,
  MiterClip,
  Bevel,
  Arcs,
  LinearRGB,
  OptimizeSpeed,
  OptimizeQuality,
  CrispEdges,
  GeometricPrecision,
  OptimizeLegibility,
  Start,
  Middle,
  End,
  Ltr,
  Rtl,
  Embed,
  Isolate,
  BidiOverride,
  IsolateOverride,
  Plaintext,
  HorizontalTb,
  VerticalRl,
  VerticalLr,
  Lr,
  LrTb,
  Rl,
  RlTb,
  Tb,
  TbRl,
  Mixed,
  Upright,
  Sideways,
  BreakWord,
  Anywhere,
  KeepAll,
  BreakAll,
  Loose,
  Strict,
  Left,
  Right,
  Center,
  Justify,
  MatchParent,
  JustifyAll,
  InterWord,
  InterCharacter,
  All,
  Manual,
  First,
  Last,
  Text,
  Emoji,
  Unicode,
  Luminance,
  Alpha,
  Inline,
  Block,
  ListItem,
  RunIn,
  Compact,
  Marker,
  Table,
  InlineTable,
  TableRowGroup,
  TableHeaderGroup,
  TableFooterGroup,
  TableRow,
  TableColumnGroup,
  TableColumn,
  TableCell,
  TableCaption,
  Visible,
  Hidden,
  Collapse,
  Scroll,
  BoundingBox,
  VisiblePainted,
  VisibleFill,
  VisibleStroke,
  Painted,
  Fill,
  Stroke,
  Multiply,
  Screen,
  Overlay,
  Darken,
  Lighten,
  ColorDodge,
  ColorBurn,
  HardLight,
  SoftLight,
  Difference,
  Exclusion,
  Hue,
  Saturation,
  Color,
  Luminosity,
  ContextFill,
  ContextStroke,
  Crosshair,
  Default,
  Pointer,
  Move,
  EResize,
  NeResize,
  NwResize,
  NResize,
  SeResize,
  SwResize,
  SResize,
  WResize,
  Wait,
  Help,
  Progress,
  NotAllowed,
  NoDrop,
  VerticalText,
  Cell,
  ContextMenu,
  Alias,
  Copy,
  Grab,
  Grabbing,
  AllScroll,
  ColResize,
  RowResize,
  EwResize,
  NsResize,
  NeswResize,
  NwseResize,
  ZoomIn,
  ZoomOut,
}

pub fn name(value: Keyword) -> &'static [u8] {
  return match value {
    Keyword.FromImage => b"from-image"
    Keyword.None => b"none"
    Keyword.Auto => b"auto"
    Keyword.Normal => b"normal"
    Keyword.SRGB => b"sRGB"
    Keyword.Nonzero => b"nonzero"
    Keyword.Evenodd => b"evenodd"
    Keyword.Butt => b"butt"
    Keyword.Round => b"round"
    Keyword.Square => b"square"
    Keyword.Miter => b"miter"
    Keyword.MiterClip => b"miter-clip"
    Keyword.Bevel => b"bevel"
    Keyword.Arcs => b"arcs"
    Keyword.LinearRGB => b"linearRGB"
    Keyword.OptimizeSpeed => b"optimizeSpeed"
    Keyword.OptimizeQuality => b"optimizeQuality"
    Keyword.CrispEdges => b"crispEdges"
    Keyword.GeometricPrecision => b"geometricPrecision"
    Keyword.OptimizeLegibility => b"optimizeLegibility"
    Keyword.Start => b"start"
    Keyword.Middle => b"middle"
    Keyword.End => b"end"
    Keyword.Ltr => b"ltr"
    Keyword.Rtl => b"rtl"
    Keyword.Embed => b"embed"
    Keyword.Isolate => b"isolate"
    Keyword.BidiOverride => b"bidi-override"
    Keyword.IsolateOverride => b"isolate-override"
    Keyword.Plaintext => b"plaintext"
    Keyword.HorizontalTb => b"horizontal-tb"
    Keyword.VerticalRl => b"vertical-rl"
    Keyword.VerticalLr => b"vertical-lr"
    Keyword.Lr => b"lr"
    Keyword.LrTb => b"lr-tb"
    Keyword.Rl => b"rl"
    Keyword.RlTb => b"rl-tb"
    Keyword.Tb => b"tb"
    Keyword.TbRl => b"tb-rl"
    Keyword.Mixed => b"mixed"
    Keyword.Upright => b"upright"
    Keyword.Sideways => b"sideways"
    Keyword.BreakWord => b"break-word"
    Keyword.Anywhere => b"anywhere"
    Keyword.KeepAll => b"keep-all"
    Keyword.BreakAll => b"break-all"
    Keyword.Loose => b"loose"
    Keyword.Strict => b"strict"
    Keyword.Left => b"left"
    Keyword.Right => b"right"
    Keyword.Center => b"center"
    Keyword.Justify => b"justify"
    Keyword.MatchParent => b"match-parent"
    Keyword.JustifyAll => b"justify-all"
    Keyword.InterWord => b"inter-word"
    Keyword.InterCharacter => b"inter-character"
    Keyword.All => b"all"
    Keyword.Manual => b"manual"
    Keyword.First => b"first"
    Keyword.Last => b"last"
    Keyword.Text => b"text"
    Keyword.Emoji => b"emoji"
    Keyword.Unicode => b"unicode"
    Keyword.Luminance => b"luminance"
    Keyword.Alpha => b"alpha"
    Keyword.Inline => b"inline"
    Keyword.Block => b"block"
    Keyword.ListItem => b"list-item"
    Keyword.RunIn => b"run-in"
    Keyword.Compact => b"compact"
    Keyword.Marker => b"marker"
    Keyword.Table => b"table"
    Keyword.InlineTable => b"inline-table"
    Keyword.TableRowGroup => b"table-row-group"
    Keyword.TableHeaderGroup => b"table-header-group"
    Keyword.TableFooterGroup => b"table-footer-group"
    Keyword.TableRow => b"table-row"
    Keyword.TableColumnGroup => b"table-column-group"
    Keyword.TableColumn => b"table-column"
    Keyword.TableCell => b"table-cell"
    Keyword.TableCaption => b"table-caption"
    Keyword.Visible => b"visible"
    Keyword.Hidden => b"hidden"
    Keyword.Collapse => b"collapse"
    Keyword.Scroll => b"scroll"
    Keyword.BoundingBox => b"bounding-box"
    Keyword.VisiblePainted => b"visiblePainted"
    Keyword.VisibleFill => b"visibleFill"
    Keyword.VisibleStroke => b"visibleStroke"
    Keyword.Painted => b"painted"
    Keyword.Fill => b"fill"
    Keyword.Stroke => b"stroke"
    Keyword.Multiply => b"multiply"
    Keyword.Screen => b"screen"
    Keyword.Overlay => b"overlay"
    Keyword.Darken => b"darken"
    Keyword.Lighten => b"lighten"
    Keyword.ColorDodge => b"color-dodge"
    Keyword.ColorBurn => b"color-burn"
    Keyword.HardLight => b"hard-light"
    Keyword.SoftLight => b"soft-light"
