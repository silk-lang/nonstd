//! Geometry uses ECMAScript Number::toString, not CSSOM's six-decimal formatting.
//! Reuse the standard library's shortest round-trip digits and apply JS notation thresholds.
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Format }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.usize

struct NumberWriter {
  bytes: [u8; 384],
  length: usize
}

impl Writer for NumberWriter {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut i: usize = 0
    while i < bytes.length {
      self.bytes[self.length] = bytes[i]
      self.length = self.length + 1
      i = i + 1
    }
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {}
}

pub effect fn appendNumber(out: &mut Bytes, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value == 0.0 {
    run out.append(b"0")
    return
  }
  let mut writer = NumberWriter { bytes: [0; 384], length: 0 }
  let formatted = run Format.display(&value)
    |> Effect.provideMut<Writer>(&mut writer)
    |> Effect.result
  drop formatted
  let mut at: usize = 0
  if writer.bytes[0] == 45 {
    run out.append(b"-")
    at = 1
  }
  let mut digits: [u8; 384] = [0; 384]
  let mut count: usize = 0
  let mut decimal: i32 = 0
  let mut fraction = false
  while at < writer.length && writer.bytes[at] != 101 && writer.bytes[at] != 69 {
    let byte = writer.bytes[at]
    if byte == 46 {
      fraction = true
    } else {
      digits[count] = byte
      count = count + 1
      if !fraction {
        decimal = decimal + 1
      }
    }
    at = at + 1
  }
  if at < writer.length {
    at = at + 1
    let negative = writer.bytes[at] == 45
    if negative || writer.bytes[at] == 43 {
      at = at + 1
    }
    let mut exponent: i32 = 0
    while at < writer.length {
      exponent = exponent * 10 + u8.toI32(writer.bytes[at] - 48)
      at = at + 1
    }
    decimal = decimal
      + (if negative {
        -exponent
      } else {
        exponent
      })
  }
  let mut first: usize = 0
  while first + 1 < count && digits[first] == 48 {
    first = first + 1
    decimal = decimal - 1
  }
  while count > first + 1 && digits[count - 1] == 48 {
    count = count - 1
  }
  let significant = count - first
  if decimal > 0 && decimal <= 21 {
    let whole = i32.toUsize(decimal)
    let mut i: usize = 0
    while i < whole || i < significant {
      if i == whole {
        run out.append(b".")
      }
      run out.append(
        &[
          if i < significant {
            digits[first + i]
          } else {
            48
          },
        ],
      )
      i = i + 1
    }
  } else if decimal <= 0 && decimal > -6 {
    run out.append(b"0.")
    let mut zeros = -decimal
    while zeros > 0 {
      run out.append(b"0")
      zeros = zeros - 1
    }
    run out.append(Slice.view<u8>(&digits, first, significant))
  } else {
    run out.append(&[digits[first]])
    if significant > 1 {
      run out.append(b".")
      run out.append(Slice.view<u8>(&digits, first + 1, significant - 1))
    }
    let exponent = decimal - 1
    run out.append(
      if exponent < 0 {
        b"e-"
      } else {
        b"e+"
      },
    )
    let magnitude = if exponent < 0 {
      -exponent
    } else {
      exponent
    }
    let mut exponentWriter = NumberWriter { bytes: [0; 384], length: 0 }
    let rendered = run Format.display(&magnitude)
      |> Effect.provideMut<Writer>(&mut exponentWriter)
      |> Effect.result
    drop rendered
    run out.append(Slice.view<u8>(&exponentWriter.bytes, 0, exponentWriter.length))
  }
}
