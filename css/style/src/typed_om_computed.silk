//! Computed Typed OM values: never CSSOM View's layout-dependent resolved values.
import computed { Engine, StyleId, ComputedValue }
import cssom_computed { Binding }
import typed_om { StyleValues, StyleValue, propertyName }
import typed_om_unparsed { customPropertyName }
import cssom_error { CssomError }
import cssom_value_serialization
import cssom_serialization
import cssom_shorthand
import properties { Property }
import properties
import variables { ScopeId }
import input { Input, TokenRef }
import tokens { BufferView, TokenRange, Limits, CssError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// Store this handle on the element; supply its latest engine binding at each query.
/// Detached nodes can expose computed data when the host has computed their styles.
pub struct ComputedStyleMap {
  elementId: usize,
  longhands: [Property; 172],
  count: usize,
}

impl ComputedStyleMap {
  pub fn make(element: usize) -> ComputedStyleMap {
    let mut map = ComputedStyleMap {
      elementId: element,
      longhands: [Property.Color; 172],
      count: 0,
    }
    let catalog = properties.all()
    let mut at: usize = 0
    while at < catalog.length {
      let property = catalog[at]
      if properties.canonical(property) == property && properties.longhandCount(property) == 1 {
        let mut position = map.count
        while position > 0
          && before(properties.name(property), properties.name(map.longhands[position - 1])) {
          map.longhands[position] = map.longhands[position - 1]
          position = position - 1
        }
        map.longhands[position] = property
        map.count = map.count + 1
      }
      at = at + 1
    }
    return move map
  }

  pub fn element(self: &Self) -> usize {
    return self.elementId
  }

  fn current(self: &Self, binding: &Binding<'_>, engine: &Engine<'_>) -> Option<StyleId> {
    if binding.element != self.elementId || binding.pseudo.length != 0 {
      return Option<StyleId>.None
    }
    match &binding.style {
      Option<StyleId>.Some { value } => {
        match &engine.scope(value) {
          Option<ScopeId>.Some { value: scope } => {
            return Option<StyleId>.some(value)
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Option<StyleId>.None
  }

  pub effect fn size(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    limits: &Limits,
  ) -> usize
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let style = match &self.current(binding, engine) {
      Option<StyleId>.Some { value } => value
      _ => {
        return 0
      }
    }
    let scope = match &engine.scope(style) {
      Option<ScopeId>.Some { value } => value
      _ => {
        return 0
      }
    }
    let custom = run engine.variables.computedEntries(buffers, scope, limits)
    return self.count + custom.length()
  }

  pub effect fn keys(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    limits: &Limits,
  ) -> List<Bytes>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut names = List<Bytes>.make()
    let style = match &self.current(binding, engine) {
      Option<StyleId>.Some { value } => value
      _ => {
        return move names
      }
    }
    let scope = match &engine.scope(style) {
      Option<ScopeId>.Some { value } => value
      _ => {
        return move names
      }
    }
    let custom = run engine.variables.computedEntries(buffers, scope, limits)
    run names.reserve(self.count + custom.length())
    let mut at: usize = 0
    while at < self.count {
      run names.append(run Bytes.copy(properties.name(self.longhands[at])))
      at = at + 1
    }
    at = 0
    while at < custom.length() {
      let name = custom.asSlice()[at].name
      let text = buffers.one(name.buffer)[0].text(name.span)
      let copy = run Bytes.copy(text)
      let mut position = names.length()
      run names.append(move copy)
      while position > self.count
        && before(
          Bytes.asSlice(&names.asSlice()[position]),
          Bytes.asSlice(&names.asSlice()[position - 1]),
        ) {
        let moving = names.remove(position)
        run names.insert(position - 1, move moving)
        position = position - 1
      }
      at = at + 1
    }
    return move names
  }

  pub effect fn has(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    property: &[u8],
  ) -> bool
    ! CssomError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    return match &run self.text(binding, engine, buffers, Bytes.asSlice(&name)) {
      Option<Bytes>.Some { value } => true
      _ => false
    }
  }

  pub effect fn getAll(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> List<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let name = run propertyName(property)
    match move run self.text(binding, engine, buffers, Bytes.asSlice(&name)) {
      Option<Bytes>.Some { value } => {
        return run store.reifyAll(Bytes.asSlice(&name), Bytes.asSlice(&value), false, limits)
      }
      _ => {
        return List<StyleValue>.make()
      }
    }
  }

  pub effect fn get(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    store: &mut StyleValues,
    property: &[u8],
    limits: &Limits,
  ) -> Option<StyleValue>
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut values = run self.getAll(binding, engine, buffers, &mut store.*, property, limits)
    if values.length() == 0 {
      return Option<StyleValue>.None
    }
    return Option<StyleValue>.some(values.remove(0))
  }

  effect fn text(
    self: &Self,
    binding: &Binding<'_>,
    engine: &Engine<'_>,
    buffers: BufferView<'_>,
    property: &[u8],
  ) -> Option<Bytes>
    ! OutOfMemoryError
    ? &mut Allocator {
    let style = match &self.current(binding, engine) {
      Option<StyleId>.Some { value } => value
      _ => {
        return Option<Bytes>.None
      }
    }
    if customPropertyName(property) {
      let scope = match &engine.scope(style) {
        Option<ScopeId>.Some { value } => value
        _ => {
          return Option<Bytes>.None
        }
      }
      let range = match &engine.variables.lookupText(buffers, scope, property) {
        Option<TokenRange>.Some { value } => value
        _ => {
          return Option<Bytes>.None
        }
      }
      let input = Input.Expanded {
        buffers: buffers,
        references: Slice.view<TokenRef>(
          engine.variables.references(),
          range.start,
          range.end - range.start,
        ),
      }
      return Option<Bytes>.some(run cssom_serialization.componentsInput(&input))
    }
    let known = match &properties.lookup(property) {
      Option<Property>.Some { value } => properties.canonical(value)
      _ => {
        return Option<Bytes>.None
      }
    }
    let count = properties.longhandCount(known)
    if count == 1 {
      return run computedText(engine, style, known)
    }
    let mut values = run List<Bytes>.makeWithCapacity(count)
    let mut at: usize = 0
    while at < count {
      match move run computedText(engine, style, properties.longhandAt(known, at)) {
        Option<Bytes>.Some { value } => {
          run values.append(move value)
        }
        _ => {
          return Option<Bytes>.None
        }
      }
      at = at + 1
    }
    return Option<Bytes>.some(run cssom_shorthand.serialize(known, values.asSlice()))
  }
}

effect fn computedText(engine: &Engine<'_>, style: StyleId, property: Property) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &engine.get(style, property) {
    Option<ComputedValue>.Some { value } => Option<Bytes>.some(
      run cssom_value_serialization.computedValue(
        &engine.values,
        value.value,
        value.sourceProperty,
        property,
      ),
    )
    _ => Option<Bytes>.None
  }
}

fn before(a: &[u8], b: &[u8]) -> bool {
  let mut at: usize = 0
  while at < a.length && at < b.length {
    if a[at] != b[at] {
      return a[at] < b[at]
    }
    at = at + 1
  }
  return a.length < b.length
}
