//! CSSOM §4 and Media Queries 4 parsing, identity, and mutation contracts.
import cssom_media { MediaList }
import cssom_error { CssomError }
import media_features { Environment }
import tokens { Limits, CssError, CssErrorKind }
import tokens
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn serialized(input: &[u8], expected: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let list = run MediaList.parse(input, &Limits.make())
  let text = run list.mediaText()
  return tokens.equal(Bytes.asSlice(&text), expected)
}

// https://drafts.csswg.org/cssom/#serializing-media-queries
// https://wpt.live/css/cssom/mediaquery-sort-dedup.html
test effect fn cssomMediaCanonicalFeaturesPreserveOrderAndDuplicates() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run serialized(
      b"not SCREEN and (min-WIDTH:05.00PX) AND (max-width:40px)",
      b"not screen and (min-width: 5px) and (max-width: 40px)",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "feature names, dimensions, type, and numbers canonicalize without sorting",
  )
  run Testing.expect(
    run serialized(b"all and (COLOR) and (color)", b"(color) and (color)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "all is omitted with features and repeated features are preserved",
  )
  run Testing.expect(
    run serialized(
      b"(ORIENTATION:LANDSCAPE), (ASPECT-RATIO:16/9)",
      b"(orientation: landscape), (aspect-ratio: 16 / 9)",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "discrete values and ratio delimiters use CSS serialization",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#error-handling
test effect fn cssomMediaRecoversIndividualInvalidArms() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run serialized(
      b"screen garbage, SCREEN, , layer, print",
      b"not all, screen, not all, not all, print",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "invalid and empty arms recover as not all without dropping siblings",
  )
  run Testing.expect(
    run serialized(b"(color]), screen", b"not all, screen")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "malformed enclosed component invalidates only its arm",
  )
  run Testing.expect(
    run serialized(b"(color) and (width) or (height)", b"not all")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "mixed condition operators use existing MQ grammar",
  )
}

// https://www.w3.org/TR/mediaqueries-4/#typedef-general-enclosed
test effect fn cssomMediaRangesAndGeneralEnclosed() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run serialized(b"(400PX<=WIDTH<1000px)", b"(400px <= width < 1000px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "range operands and units retain range semantics",
  )
  run Testing.expect(
    run serialized(b"NOT ((COLOR) OR (MONOCHROME))", b"not ((color) or (monochrome))")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "nested conditions canonicalize their operators",
  )
  run Testing.expect(
    run serialized(b"future(A,B), (FUTURE: AbC)", b"future(A,B), (FUTURE: AbC)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "general-enclosed preserves unknown content and nested commas",
  )
  run Testing.expect(
    run serialized(b"future([A", b"future([A])") |> Effect.provideMut<Allocator>(&mut allocator),
    "EOF closes every nested general-enclosed component",
  )
  run Testing.expect(
    run serialized(b"(COLOR", b"(color)") |> Effect.provideMut<Allocator>(&mut allocator),
    "EOF closes recognized feature components",
  )
}

test effect fn cssomMediaEmptyListAndNullItems() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut list = run MediaList.parse(b"screen", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    match list.item(0) {
      Option<&[u8]>.Some { value } => tokens.equal(value, b"screen")
      _ => false
    },
    "in-bounds item returns its serialized query",
  )
  run Testing.expect(
    match list.item(1) {
      Option<&[u8]>.None => true
      _ => false
    },
    "out-of-bounds item is null, not empty text",
  )
  run list.setMediaText(b"  /**/ ", &Limits.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(list.length() == 0, "whitespace-only list has no queries")
  let text = run list.mediaText() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Bytes.asSlice(&text).length == 0, "empty list serializes to empty text")
}

// https://drafts.csswg.org/cssom/#dom-medialist-appendmedium
test effect fn cssomMediaAppendUsesCanonicalIdentityWithoutReordering() -> ()
  ! AssertionError<'static> | CssError | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let mut list = run MediaList.parse(b"screen and (min-width: 5px), print", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run list.appendMedium(b"SCREEN and (MIN-WIDTH:05.00PX)", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run list.appendMedium(b"screen, speech", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  run list.appendMedium(b"", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let unchanged = run list.mediaText() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&unchanged), b"screen and (min-width: 5px), print"),
    "canonical duplicate append and multi-query append leave order unchanged",
  )
  run list.deleteMedium(b"SCREEN and (MIN-WIDTH:5PX)", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run list.appendMedium(b"screen and (min-width:5px)", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reordered = run list.mediaText() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&reordered), b"print, screen and (min-width: 5px)"),
    "deleting and explicitly reappending puts the query at the end",
  )
}

// https://drafts.csswg.org/cssom/#dom-medialist-deletemedium
test effect fn cssomMediaDeleteRemovesAllMatchesOrThrows() -> ()
  ! AssertionError<'static> | CssError | CssomError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = Limits.make()
  let mut list = run MediaList.parse(b"screen, print, SCREEN, speech, screen", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run list.deleteMedium(b"ScReEn", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  run list.deleteMedium(b"print, speech", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run list.mediaText() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&text), b"print, speech"),
    "all canonical matches are removed stably; multi-query delete is a no-op",
  )
  let absent = run Effect.result(
    list.deleteMedium(b"screen", &limits) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &absent {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssomError problem => problem == CssomError.NotFoundError
        _ => false
      }
      _ => false
    },
    "deleting an absent query reports NotFoundError",
  )
  run list.appendMedium(b"broken query", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  run list.deleteMedium(b"also broken", &limits) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(list.length() == 2, "invalid single queries compare as not all")
}

test effect fn cssomMediaMutationFailureIsTransactionalAndMatchingUsesEnvironment() -> ()
  ! AssertionError<'static> | CssError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut list = run MediaList.parse(b"(width >= 600px)", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut limits = Limits.make()
  limits.maxInputBytes = 2
  let rejected = run Effect.result(
    list.setMediaText(b"print", &limits) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run Testing.expect(
    match &rejected {
      Result<(), CssError | OutOfMemoryError>.Failure { error } => match &error {
        CssError problem => problem.kind == CssErrorKind.InputLimit
        _ => false
      }
      _ => false
    },
    "setMediaText enforces tokenizer resource limits",
  )
  let text = run list.mediaText() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&text), b"(width >= 600px)"),
    "resource failure preserves prior list",
  )
  run Testing.expect(
    run list.matches(&Environment.headless(800.0, 600.0), &Limits.make())
      |> Effect.provideMut<Allocator>(&mut allocator),
    "stored canonical query matches using existing feature evaluator",
  )
  run Testing.expect(
    !run list.matches(&Environment.headless(400.0, 600.0), &Limits.make())
      |> Effect.provideMut<Allocator>(&mut allocator),
    "matching uses supplied environment rather than parse-time environment",
  )
}
