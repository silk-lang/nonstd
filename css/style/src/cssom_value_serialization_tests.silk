//! CSS Values 4 §10.13 and Color 4 §16 canonicalization and typed projection.
import cssom_value_serialization as serialization
import cssom_numeric_serialization as numeric
import values { Store, Mode, ValueId }
import values
import properties { Property }
import dimensions { Unit, Store as NumericStore }
import dimensions
import input { Input }
import lexer
import tokens { Limits, CssError }
import tokens
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

effect fn roundtrip(property: Property, input: &[u8], expected: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(input, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let id = match &(run values.parse(&mut store, property, &source, Mode.Css)) {
    Option<ValueId>.Some { value } => value
    _ => {
      return false
    }
  }
  let serialized = run serialization.value(&store, id, property, property)
  if !tokens.equal(Bytes.asSlice(&serialized), expected) {
    return false
  }
  let second = run lexer.tokenize(Bytes.asSlice(&serialized), &Limits.make())
  let secondSource = Input.Contiguous { buffer: &second, range: second.all() }
  let secondId = match &(run values.parse(&mut store, property, &secondSource, Mode.Css)) {
    Option<ValueId>.Some { value } => value
    _ => {
      return false
    }
  }
  let again = run serialization.value(&store, secondId, property, property)
  return tokens.equal(Bytes.asSlice(&serialized), Bytes.asSlice(&again))
}

test effect fn cssomNumericCanonicalSumAndUnits() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run roundtrip(Property.Width, b"calc(1in + 2px + 3em + 10% - 1em)", b"calc(10% + 2em + 98px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "sums combine convertible absolute units and order percentage before alphabetical dimensions",
  )
  run Testing.expect(
    run roundtrip(Property.Width, b"calc(2 * (1em + 3px))", b"calc(2em + 6px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "scalar multiplication distributes over a numeric sum",
  )
  run Testing.expect(
    run roundtrip(Property.Width, b"calc(10% - 2px + 0em)", b"calc(10% + 0em - 2px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "zero dimensions remain and negative terms use subtraction",
  )
  run Testing.expect(
    run roundtrip(Property.Width, b"min(1in, 100px, 2em)", b"min(96px, 2em)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "min combines comparable absolute lengths but preserves unresolved font-relative lengths",
  )
  run Testing.expect(
    run roundtrip(Property.Opacity, b"min(30%, 20%)", b"calc(20%)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "raw percentage comparison has no unknown potentially negative length basis",
  )
  run Testing.expect(
    run roundtrip(Property.Width, b"min(30%, 20%)", b"min(30%, 20%)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "length percentages are not compared before their reference basis is known",
  )
  run Testing.expect(
    run roundtrip(Property.Opacity, b"calc(1in / 96px)", b"calc(1)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "typed division cancels canonical dimension units",
  )
  run Testing.expect(
    run roundtrip(Property.Width, b"calc(infinity * 1px)", b"calc(infinity * 1px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "nonfinite dimensional math uses a keyword times a unit quantity",
  )
}

test effect fn cssomColorCanonicalFunctionsAndMissingCoordinates() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run roundtrip(Property.Color, b"#ff000080", b"rgba(255, 0, 0, 0.501961)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "float alpha retains six decimal places rather than pretending the store is eight-bit",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"rgb(10.5 20 30 / 50%)", b"rgba(10.5, 20, 30, 0.5)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "fractional RGB components remain fractional in legacy serialization",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"rgb(none 0 0 / none)", b"color(srgb none 0 0 / none)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "missing sRGB coordinates use color() so none survives reparsing",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"hwb(20 none 30% / none)", b"hwb(20 none 30% / none)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "missing polar sRGB coordinates preserve their original color space",
  )
  run Testing.expect(
    run roundtrip(
      Property.Color,
      b"color(display-p3 1.2 none -0.1 / 40%)",
      b"color(display-p3 1.2 none -0.1 / 0.4)",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "wide gamut and out-of-range channels are not clipped by serialization",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"oklch(50% 0.2 450 / none)", b"oklch(0.5 0.2 90 / none)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "OK lightness uses a number and hue is canonicalized in degrees",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"CanvasText", b"canvastext")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "system color identity is not replaced with an invented display palette",
  )
  run Testing.expect(
    run roundtrip(Property.Color, b"CURRENTCOLOR", b"currentcolor")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "currentcolor retains its unresolved identity",
  )
}

test effect fn cssomSvgTypedValueCanonicalization() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run roundtrip(Property.Fill, b"url('#paint') #f00", b"url(\"#paint\") rgb(255, 0, 0)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "paint server and fallback serialize independently",
  )
  run Testing.expect(
    run roundtrip(Property.StrokeDasharray, b"1 2px 3%", b"1, 2px, 3%")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "dash lists preserve numbers lengths and percentages without duplicating odd lists",
  )
  run Testing.expect(
    run roundtrip(Property.PaintOrder, b"markers fill stroke", b"markers")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "paint order omits the implied suffix",
  )
  run Testing.expect(
    run roundtrip(
      Property.VectorEffect,
      b"fixed-position non-scaling-stroke screen",
      b"non-scaling-stroke fixed-position screen",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "vector flags have grammar order and preserve the reference frame",
  )
  run Testing.expect(
    run roundtrip(
      Property.Cursor,
      b"url(hand.cur) 2.5 3, pointer",
      b"url(\"hand.cur\") 2.5 3, pointer",
    )
      |> Effect.provideMut<Allocator>(&mut allocator),
    "cursor hotspots and mandatory fallback survive",
  )
}

test effect fn cssomNumericLiteralNegativeZero() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut store = NumericStore.make()
  let id = run dimensions.literal(&mut store, -0.0, Unit.Px)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run numeric.expression(&store, id) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&result), b"0px"),
    "negative zero serializes without a sign",
  )
  let time = run dimensions.literal(&mut store, 1500.0, Unit.Ms)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let timeText = run numeric.expression(&store, time)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&timeText), b"1.5s"),
    "time serializes in seconds even outside calc",
  )
  let resolution = run dimensions.literal(&mut store, 192.0, Unit.Dpi)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resolutionText = run numeric.expression(&store, resolution)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&resolutionText), b"2dppx"),
    "resolution serializes in dots per CSS pixel",
  )
}

test effect fn cssomKeywordShorthandProjectionIsImmutable() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let buffer = run lexer.tokenize(b"justify-all", &Limits.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let parsed = run values.parse(&mut store, Property.TextAlign, &source, Mode.Css)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let id = match &parsed {
    Option<ValueId>.Some { value } => value
    _ => {
      run Testing.expect(false, "text-align shorthand parses")
      return
    }
  }
  let before = store.length()
  let last = run serialization.value(&store, id, Property.TextAlign, Property.TextAlignLast)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&last), b"justify"),
    "justify-all projects the final line to justify",
  )
  let original = run serialization.value(&store, id, Property.TextAlign, Property.TextAlign)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    tokens.equal(Bytes.asSlice(&original), b"justify-all"),
    "projection does not replace the original shorthand",
  )
  run Testing.expect(store.length() == before, "serialization does not mutate the typed store")
}

effect fn computedMath(property: Property, input: &[u8], expected: &[u8]) -> bool
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let buffer = run lexer.tokenize(input, &Limits.make())
  let source = Input.Contiguous { buffer: &buffer, range: buffer.all() }
  let mut store = Store.make()
  let id = match &(run values.parse(&mut store, property, &source, Mode.Css)) {
    Option<ValueId>.Some { value } => value
    _ => {
      return false
    }
  }

  // These cases use only already-canonical units, so no host metrics are needed.
  let result = run serialization.computedValue(&store, id, property, property)
  return tokens.equal(Bytes.asSlice(&result), expected)
}

test effect fn cssomComputedNumericMathRemovesOnlyResolvedWrappers() -> ()
  ! CssError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Testing.expect(
    run computedMath(Property.Width, b"calc(1px + 2px)", b"3px")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "computed pure-length calculations serialize as a literal",
  )
  run Testing.expect(
    run computedMath(Property.Width, b"calc(50% + 2px)", b"calc(50% + 2px)")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "mixed length percentages retain a calculation without inventing layout metrics",
  )
  run Testing.expect(
    run computedMath(Property.Width, b"calc(1px - 2px)", b"0px")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "computed nonnegative range applies after simplifying the calculation",
  )
  run Testing.expect(
    run computedMath(Property.Opacity, b"calc(2)", b"1")
      |> Effect.provideMut<Allocator>(&mut allocator),
    "computed unit-interval values clamp after math",
  )
}
