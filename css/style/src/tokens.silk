//! Owned CSS token storage. Text spans address one immutable arena after tokenization.
import silk.collections.bytes { Bytes }
import silk.simd.u8x16
import silk.simd.mask16
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct Span {
  pub start: usize,
  pub end: usize,
}

impl Copy for Span {}

pub struct TokenRange {
  pub start: usize,
  pub end: usize,
}

impl Copy for TokenRange {}

pub enum CssErrorKind {
  InputLimit,
  StorageLimit,
  TokenLimit,
  NestingLimit,
  RuleLimit,
  DeclarationLimit,
  MatchLimit,
}

pub struct CssError {
  pub kind: CssErrorKind,
  pub offset: usize,
}

pub struct Limits {
  pub maxInputBytes: usize,
  pub maxStorageBytes: usize,
  pub maxTokens: usize,
  pub maxDepth: usize,
  pub maxRules: usize,
  pub maxDeclarations: usize,
}

impl Copy for Limits {}

impl Limits {
  pub fn make() -> Limits {
    return Limits {
      maxInputBytes: 16777216,
      maxStorageBytes: 67108864,
      maxTokens: 1000000,
      maxDepth: 128,
      maxRules: 100000,
      maxDeclarations: 100000,
    }
  }
}

pub union Kind {
  Whitespace,
  Ident { pub text: Span },
  Function { pub name: Span },
  AtKeyword { pub name: Span },
  Hash { pub text: Span, pub identifier: bool },
  String { pub text: Span },
  BadString,
  Url { pub text: Span },
  BadUrl,
  Number { pub value: f64, pub integer: bool },
  Percentage { pub value: f64, pub integer: bool },
  Dimension { pub value: f64, pub integer: bool, pub unit: Span },
  Delim { pub scalar: u32 },
  Colon,
  Semicolon,
  Comma,
  OpenParen,
  CloseParen,
  OpenSquare,
  CloseSquare,
  OpenBrace,
  CloseBrace,
  Cdo,
  Cdc,
  Eof,
}

impl Copy for Kind {}

pub struct Token {
  pub kind: Kind,
  /// Location in the normalized source prefix, not the decoded-text suffix.
  pub source: Span,
  /// Closing token index for an opener; EOF for an unclosed block. Others use their own index.
  pub matching: usize,
}

impl Copy for Token {}

/// A tokenized stylesheet with the nesting depth tokenizing it needs (an opener fails once
/// `maxDepth` blocks are open), for reuse by documents with other limits.
pub struct PreparedSheet {
  pub buffer: TokenBuffer,
  pub depth: usize,
}

impl PreparedSheet {
  pub fn make(buffer: TokenBuffer) -> PreparedSheet {
    let tokens = buffer.tokens.asSlice()
    let mut depth: usize = 0
    let mut i: usize = 0
    while i < tokens.length {
      if opener(&tokens[i].kind) {
        // Blocks still open here: earlier openers whose closing token comes later.
        let mut open: usize = 0
        let mut j: usize = 0
        while j < i {
          if opener(&tokens[j].kind) && tokens[j].matching > i {
            open = open + 1
          }
          j = j + 1
        }
        if open + 1 > depth {
          depth = open + 1
        }
      }
      i = i + 1
    }
    return PreparedSheet { buffer: move buffer, depth: depth }
  }

  pub effect fn copy(self: &PreparedSheet) -> PreparedSheet
    ! OutOfMemoryError
    ? &mut Allocator {
    return PreparedSheet { buffer: run self.buffer.copy(), depth: self.depth }
  }
}

fn opener(kind: &Kind) -> bool {
  return match &kind.* {
    Kind.Function { name } => true
    Kind.OpenParen => true
    Kind.OpenSquare => true
    Kind.OpenBrace => true
    _ => false
  }
}

pub struct TokenBuffer {
  /// Normalized source followed by decoded escaped token text. Unescaped text reuses source spans.
  pub data: Bytes,
  pub sourceLength: usize,
  pub tokens: List<Token>,
}

impl TokenBuffer {
  pub fn make() -> TokenBuffer {
    return TokenBuffer { data: Bytes.make(), sourceLength: 0, tokens: List<Token>.make() }
  }

  pub effect fn copy(self: &TokenBuffer) -> TokenBuffer
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut tokens = run List<Token>.makeWithCapacity(self.tokens.length())
    run tokens.appendSlice(self.tokens.asSlice())
    return TokenBuffer {
      data: run Bytes.copy(Bytes.asSlice(&self.data)),
      sourceLength: self.sourceLength,
      tokens: move tokens,
    }
  }

  pub fn text(self: &TokenBuffer, span: Span) -> &[u8] {
    let data = Bytes.asSlice(&self.data)
    if span.start > span.end || span.end > data.length {
      return b""
    }
    return Slice.view<u8>(data, span.start, span.end - span.start)
  }

  pub fn source(self: &TokenBuffer) -> &[u8] {
    let data = Bytes.asSlice(&self.data)
    if self.sourceLength > data.length {
      return b""
    }
    return Slice.view<u8>(data, 0, self.sourceLength)
  }

  /// Excludes the terminal EOF token emitted by tokenize.
  pub fn all(self: &TokenBuffer) -> TokenRange {
    let count = self.tokens.length()
    return TokenRange {
      start: 0,
      end: if count == 0 {
        0
      } else {
        count - 1
      },
    }
  }
}

pub fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0

  // Namespace URIs and other long names compare sixteen bytes at a time; 16 to 32 bytes
  // take two overlapping blocks.
  if a.length >= 16 {
    if a.length <= 32 {
      return mask16.all(u8x16.lanesEqual(u8x16.load(a, 0), u8x16.load(b, 0)))
        && mask16.all(u8x16.lanesEqual(u8x16.load(a, a.length - 16), u8x16.load(b, a.length - 16)))
    }
    while i + 16 <= a.length {
      if !mask16.all(u8x16.lanesEqual(u8x16.load(a, i), u8x16.load(b, i))) {
        return false
      }
      i = i + 16
    }
  }
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

pub fn insensitive(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    let x = if a[i] >= 65 && a[i] <= 90 {
      a[i] + 32
    } else {
      a[i]
    }
    let y = if b[i] >= 65 && b[i] <= 90 {
      b[i] + 32
    } else {
      b[i]
    }
    if x != y {
      return false
    }
    i = i + 1
  }
  return true
}

const NO_BUFFERS: [TokenBuffer; 0] = []

/// Token buffers whose first indices may name another owner's buffers, read in place.
pub struct Buffers<'a> {
  base: &'a [TokenBuffer],
  own: List<TokenBuffer>,
}

impl<'a> Buffers<'a> {
  pub fn make() -> Buffers<'a> {
    return Buffers<'a> {
      base: Slice.view<TokenBuffer>(&NO_BUFFERS, 0, 0),
      own: List<TokenBuffer>.make(),
    }
  }

  /// Buffers whose first `base.length` indices read `base` in place.
  pub fn over(base: &'a [TokenBuffer]) -> Buffers<'a> {
    return Buffers<'a> { base: base, own: List<TokenBuffer>.make() }
  }

  pub fn length(self: &Self) -> usize {
    return self.base.length + self.own.length()
  }

  /// The buffer at `index` as a one-element slice.
  @inlineAlways
  pub fn one(self: &Self, index: usize) -> &[TokenBuffer] {
    if index < self.base.length {
      return Slice.view<TokenBuffer>(self.base, index, 1)
    }
    return Slice.view<TokenBuffer>(self.own.asSlice(), index - self.base.length, 1)
  }

  /// The buffers this owner holds, after the borrowed ones.
  pub fn owned(self: &Self) -> &[TokenBuffer] {
    return self.own.asSlice()
  }

  pub fn view<'s>(self: &'s Self) -> BufferView<'s> {
    return BufferView<'s> { base: self.base, own: self.own.asSlice() }
  }

  pub effect fn append(self: &mut Self, buffer: TokenBuffer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.own.append(move buffer)
  }

  pub effect fn reserve(self: &mut Self, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.own.reserve(count)
  }
}

/// A borrowed view of token buffers: a shared run followed by a document's own.
pub struct BufferView<'a> {
  base: &'a [TokenBuffer],
  own: &'a [TokenBuffer],
}

impl<'a> Copy for BufferView<'a> {}

impl<'a> BufferView<'a> {
  /// A view of one plain slice of buffers.
  pub fn of(buffers: &'a [TokenBuffer]) -> BufferView<'a> {
    return BufferView<'a> { base: buffers, own: Slice.view<TokenBuffer>(&NO_BUFFERS, 0, 0) }
  }

  pub fn length(self: &Self) -> usize {
    return self.base.length + self.own.length
  }

  /// The buffer at `index` as a one-element slice.
  @inlineAlways
  pub fn one(self: &Self, index: usize) -> &'a [TokenBuffer] {
    if index < self.base.length {
      return Slice.view<TokenBuffer>(self.base, index, 1)
    }
    return Slice.view<TokenBuffer>(self.own, index - self.base.length, 1)
  }
}
