//! CSS Color 4, pinned 43bfdad1d01d4ce47cbb350b5fdf058be5b63edc2f0416b6967de1d731ff7145.
//! Specified coordinates and missing components survive until display conversion.
import input { Input, TokenView }
import tokens { Kind, insensitive }
import value_cursor { Cursor }
import dimensions { Store, Dimension, ExprId }
import dimensions
import svg_geometry.math
import silk.num.f64
import silk.num.u32
import silk.num.u8
import silk.text.string { String }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub enum Space {
  Srgb,
  SrgbLinear,
  DisplayP3,
  DisplayP3Linear,
  A98Rgb,
  ProphotoRgb,
  Rec2020,
  XyzD50,
  XyzD65,
  Hsl,
  Hwb,
  Lab,
  Lch,
  Oklab,
  Oklch
}

pub enum SystemColor {
  AccentColor,
  AccentColorText,
  ActiveText,
  ButtonBorder,
  ButtonFace,
  ButtonText,
  Canvas,
  CanvasText,
  Field,
  FieldText,
  GrayText,
  Highlight,
  HighlightText,
  LinkText,
  Mark,
  MarkText,
  SelectedItem,
  SelectedItemText,
  VisitedText
}

pub union Identity {
  Absolute,
  CurrentColor,
  System { pub color: SystemColor }
}

impl Copy for Identity {}

pub struct Color {
  pub space: Space,
  pub channels: [f64; 3],
  pub alpha: f64,
  /// Bits 0,1,2 are missing coordinates; bit 3 is missing alpha.
  pub missing: u8,
  pub identity: Identity,
}

impl Copy for Color {}

pub struct Rgba {
  pub r: f64,
  pub g: f64,
  pub b: f64,
  pub a: f64
}

impl Copy for Rgba {}

impl Color {
  pub fn srgb(r: f64, g: f64, b: f64, a: f64) -> Color {
    return Color {
      space: Space.Srgb,
      channels: [r, g, b],
      alpha: a,
      missing: 0,
      identity: Identity.Absolute,
    }
  }

  pub fn current() -> Color {
    let mut result = Color.srgb(0.0, 0.0, 0.0, 1.0)
    result.identity = Identity.CurrentColor
    return result
  }
}

pub struct Context {
  /// Host-resolved absolute color, including when computing color:currentColor.
  pub currentColor: Color,
  /// Absolute host colors, indexed by systemIndex; no invented OS palette.
  pub system: [Color; 19],
}

impl Copy for Context {}

impl Context {
  pub fn make(currentColor: Color, system: [Color; 19]) -> Context {
    return Context { currentColor: currentColor, system: system }
  }
}

pub fn systemIndex(color: SystemColor) -> usize {
  return match color {
    SystemColor.AccentColor => 0
    SystemColor.AccentColorText => 1
    SystemColor.ActiveText => 2
    SystemColor.ButtonBorder => 3
    SystemColor.ButtonFace => 4
    SystemColor.ButtonText => 5
    SystemColor.Canvas => 6
    SystemColor.CanvasText => 7
    SystemColor.Field => 8
    SystemColor.FieldText => 9
    SystemColor.GrayText => 10
    SystemColor.Highlight => 11
    SystemColor.HighlightText => 12
    SystemColor.LinkText => 13
    SystemColor.Mark => 14
    SystemColor.MarkText => 15
    SystemColor.SelectedItem => 16
    SystemColor.SelectedItemText => 17
    SystemColor.VisitedText => 18
  }
}

pub fn compute(color: Color, context: &Context) -> Color {
  return match &color.identity {
    Identity.Absolute => color
    Identity.CurrentColor => context.currentColor
    Identity.System { color: systemColor } => context.system[systemIndex(systemColor)]
  }
}

fn clamp(value: f64, low: f64, high: f64) -> f64 {
  if value != value {
    return low
  }
  return f64.max(low, f64.min(high, value))
}

fn hue(value: f64) -> f64 {
  if !f64.isFinite(value) {
    return 0.0
  }
  let degrees = math.radians(value) * (180.0 / math.PI)
  return if degrees < 0.0 {
    degrees + 360.0
  } else {
    degrees
  }
}

fn nibble(byte: u8) -> f64 {
  if byte >= 48 && byte <= 57 {
    return u8.toF64(byte - 48)
  }
  if byte >= 65 && byte <= 70 {
    return u8.toF64(byte - 55)
  }
  if byte >= 97 && byte <= 102 {
    return u8.toF64(byte - 87)
  }
  return -1.0
}

/// The color of a hex color's digits (the text after `#`), as the parser reads a hash token.
pub fn hexDigits(text: &[u8]) -> Option<Color> {
  return hex(text)
}

fn hex(text: &[u8]) -> Option<Color> {
  let n = text.length
  if n != 3 && n != 4 && n != 6 && n != 8 {
    return Option<Color>.None
  }
  let short = n <= 4
  let count: usize = if n == 4 || n == 8 {
    4
  } else {
    3
  }
  let mut channels = [0.0, 0.0, 0.0, 1.0]
  let mut index: usize = 0
  while index < count {
    let position = if short {
      index
    } else {
      index * 2
    }
    let high = nibble(text[position])
    let low = if short {
      high
    } else {
      nibble(text[position + 1])
    }
    if high < 0.0 || low < 0.0 {
      return Option<Color>.None
    }
    channels[index] = (high * 16.0 + low) / 255.0
    index = index + 1
  }
  return Option<Color>.some(Color.srgb(channels[0], channels[1], channels[2], channels[3]))
}

// #css-system-colors and #deprecated-system-colors.
fn system(text: &[u8]) -> Option<SystemColor> {
  let names: [string; 19] = [
    "accentcolor",
    "accentcolortext",
    "activetext",
    "buttonborder",
    "buttonface",
    "buttontext",
    "canvas",
    "canvastext",
    "field",
    "fieldtext",
    "graytext",
    "highlight",
    "highlighttext",
    "linktext",
    "mark",
    "marktext",
    "selecteditem",
    "selecteditemtext",
    "visitedtext",
  ]
  let roles = [
    SystemColor.AccentColor,
    SystemColor.AccentColorText,
    SystemColor.ActiveText,
    SystemColor.ButtonBorder,
    SystemColor.ButtonFace,
    SystemColor.ButtonText,
    SystemColor.Canvas,
    SystemColor.CanvasText,
    SystemColor.Field,
    SystemColor.FieldText,
    SystemColor.GrayText,
    SystemColor.Highlight,
    SystemColor.HighlightText,
    SystemColor.LinkText,
    SystemColor.Mark,
    SystemColor.MarkText,
    SystemColor.SelectedItem,
    SystemColor.SelectedItemText,
    SystemColor.VisitedText,
  ]
  let mut index: usize = 0
  while index < names.length {
    if insensitive(text, String.utf8Bytes(names[index])) {
      return Option<SystemColor>.some(roles[index])
    }
    index = index + 1
  }
  if insensitive(text, b"activeborder") || insensitive(text, b"inactiveborder")
    || insensitive(text, b"threeddarkshadow")
    || insensitive(text, b"threedhighlight")
    || insensitive(text, b"threedlightshadow")
    || insensitive(text, b"threedshadow")
    || insensitive(text, b"windowframe") {
    return Option<SystemColor>.some(SystemColor.ButtonBorder)
  }
  if insensitive(text, b"buttonhighlight") || insensitive(text, b"buttonshadow")
    || insensitive(text, b"threedface") {
    return Option<SystemColor>.some(SystemColor.ButtonFace)
  }
  if insensitive(text, b"captiontext") || insensitive(text, b"infotext")
    || insensitive(text, b"menutext")
    || insensitive(text, b"windowtext") {
    return Option<SystemColor>.some(SystemColor.CanvasText)
  }
  if insensitive(text, b"inactivecaptiontext") {
    return Option<SystemColor>.some(SystemColor.GrayText)
  }
  if insensitive(text, b"activecaption") || insensitive(text, b"appworkspace")
    || insensitive(text, b"background")
    || insensitive(text, b"inactivecaption")
    || insensitive(text, b"infobackground")
    || insensitive(text, b"menu")
    || insensitive(text, b"scrollbar")
    || insensitive(text, b"window") {
    return Option<SystemColor>.some(SystemColor.Canvas)
  }
  return Option<SystemColor>.None
}

struct Component {
  value: f64,
  percentage: bool,
  missing: bool
}

impl Copy for Component {}

// Number/percentage math expressions retain their type until the color's own
// percentage reference range is applied. Angle math resolves in degrees.
effect fn component(source: &Input, cursor: &mut Cursor, angle: bool, percentScale: f64) -> Option<
  Component
>
  ! OutOfMemoryError
  ? &mut Allocator {
  if cursor.ident(source, b"none") {
    return Option<Component>.some(Component { value: 0.0, percentage: false, missing: true })
  }
  cursor.skip(source)
  if cursor.position >= cursor.end {
    return Option<Component>.None
  }
  let viewed = source.at(cursor.position)
  match &viewed {
    Option<TokenView>.Some { value: view } => {
      match &view.token.kind {
        Kind.Number { value, integer } => {
          cursor.position = cursor.position + 1
          return Option<Component>.some(
            Component { value: value, percentage: false, missing: false },
          )
        }
        Kind.Percentage { value, integer } => {
          if angle {
            return Option<Component>.None
          }
          cursor.position = cursor.position + 1
          return Option<Component>.some(
            Component { value: value * (percentScale / 100.0), percentage: true, missing: false },
          )
        }
        Kind.Dimension { value, integer, unit } => {
          if !angle {
            return Option<Component>.None
          }
          let text = view.text(unit)
          let factor = if insensitive(text, b"deg") {
            1.0
          } else if insensitive(text, b"grad") {
            0.9
          } else if insensitive(text, b"rad") {
            180.0 / math.PI
          } else if insensitive(text, b"turn") {
            360.0
          } else {
            return Option<Component>.None
          }
          cursor.position = cursor.position + 1
          return Option<Component>.some(
            Component { value: value * factor, percentage: false, missing: false },
          )
        }
        _ => {}
      }
    }
    _ => {
      return Option<Component>.None
    }
  }
  let start = cursor.position
  let mut store = Store.make()
  let number = run dimensions.parse(&mut store, source, &mut cursor.*, Dimension.Number, false)
  match &number {
    Option<ExprId>.Some { value } => {
      return Option<Component>.some(
        Component {
          value: dimensions.evaluate(&store, value, 0.0),
          percentage: false,
          missing: false,
        },
      )
    }
    _ => {}
  }
  cursor.position = start
  let typed = run dimensions.parse(
    &mut store,
    source,
    &mut cursor.*,
    if angle {
      Dimension.Angle
    } else {
      Dimension.Percentage
    },
    false,
  )
  match &typed {
    Option<ExprId>.Some { value } => {
      return Option<Component>.some(
        Component {
          value: dimensions.evaluate(&store, value, percentScale),
          percentage: !angle,
          missing: false,
        },
      )
    }
    _ => {
      cursor.position = start
      return Option<Component>.None
    }
  }
}

fn functionSpace(name: &[u8]) -> Option<Space> {
  if insensitive(name, b"rgb") || insensitive(name, b"rgba") {
    return Option<Space>.some(Space.Srgb)
  }
  if insensitive(name, b"hsl") || insensitive(name, b"hsla") {
    return Option<Space>.some(Space.Hsl)
  }
  if insensitive(name, b"hwb") {
    return Option<Space>.some(Space.Hwb)
  }
  if insensitive(name, b"lab") {
    return Option<Space>.some(Space.Lab)
  }
  if insensitive(name, b"lch") {
    return Option<Space>.some(Space.Lch)
  }
  if insensitive(name, b"oklab") {
    return Option<Space>.some(Space.Oklab)
  }
  if insensitive(name, b"oklch") {
    return Option<Space>.some(Space.Oklch)
  }
  return Option<Space>.None
}

fn predefined(source: &Input, cursor: &mut Cursor) -> Option<Space> {
  if cursor.ident(source, b"srgb") {
    return Option<Space>.some(Space.Srgb)
  }
  if cursor.ident(source, b"srgb-linear") {
    return Option<Space>.some(Space.SrgbLinear)
  }
  if cursor.ident(source, b"display-p3") {
    return Option<Space>.some(Space.DisplayP3)
  }
  if cursor.ident(source, b"display-p3-linear") {
    return Option<Space>.some(Space.DisplayP3Linear)
  }
  if cursor.ident(source, b"a98-rgb") {
    return Option<Space>.some(Space.A98Rgb)
  }
  if cursor.ident(source, b"prophoto-rgb") {
    return Option<Space>.some(Space.ProphotoRgb)
  }
  if cursor.ident(source, b"rec2020") {
    return Option<Space>.some(Space.Rec2020)
  }
  if cursor.ident(source, b"xyz") || cursor.ident(source, b"xyz-d65") {
    return Option<Space>.some(Space.XyzD65)
  }
  if cursor.ident(source, b"xyz-d50") {
    return Option<Space>.some(Space.XyzD50)
  }
  return Option<Space>.None
}

pub effect fn parse(source: &Input, cursor: &mut Cursor) -> Option<Color>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut trial = Cursor { position: cursor.position, end: cursor.end }
  let result = run parseInner(source, &mut trial)
  match &result {
    Option<Color>.Some { value } => {
      cursor.position = trial.position
    }
    _ => {}
  }
  return result
}

effect fn parseInner(source: &Input, cursor: &mut Cursor) -> Option<Color>
  ! OutOfMemoryError
  ? &mut Allocator {
  cursor.skip(source)
  if cursor.position >= cursor.end {
    return Option<Color>.None
  }
  let viewed = source.at(cursor.position)
  let mut space = Space.Srgb
  let mut generic = false
  match &viewed {
    Option<TokenView>.Some { value: view } => {
      match &view.token.kind {
        Kind.Hash { text, identifier } => {
          cursor.position = cursor.position + 1
          return hex(view.text(text))
        }
        Kind.Ident { text } => {
          let name = view.text(text)
          cursor.position = cursor.position + 1
          if insensitive(name, b"currentcolor") {
            return Option<Color>.some(Color.current())
          }
          if insensitive(name, b"transparent") {
            return Option<Color>.some(Color.srgb(0.0, 0.0, 0.0, 0.0))
          }
          let systemColor = system(name)
          match &systemColor {
            Option<SystemColor>.Some { value } => {
              let mut result = Color.srgb(0.0, 0.0, 0.0, 1.0)
              result.identity = Identity.System { color: value }
              return Option<Color>.some(result)
            }
            _ => {
              return namedColor(name)
            }
          }
        }
        Kind.Function { name } => {
          generic = insensitive(view.text(name), b"color")
          let parsedSpace = functionSpace(view.text(name))
          if !generic {
            match &parsedSpace {
              Option<Space>.Some { value } => {
                space = value
              }
              _ => {
                return Option<Color>.None
              }
            }
          }
          cursor.position = cursor.position + 1
        }
        _ => {
          return Option<Color>.None
        }
      }
    }
    _ => {
      return Option<Color>.None
    }
  }
  if generic {
    let parsedSpace = predefined(source, &mut cursor.*)
    match &parsedSpace {
      Option<Space>.Some { value } => {
        space = value
      }
      _ => {
        return Option<Color>.None
      }
    }
    let boundary = cursor.position
    cursor.skip(source)
    if cursor.position == boundary {
      return Option<Color>.None
    }
  }
  let mut result = Color {
    space: space,
    channels: [0.0; 3],
    alpha: 1.0,
    missing: 0,
    identity: Identity.Absolute,
  }
  let mut parts = [Component { value: 0.0, percentage: false, missing: false }; 3]
  let mut legacy = false
  let mut index: usize = 0
  let bits: [u8; 3] = [1, 2, 4]
  while index < 3 {
    let angular = !generic
      && ((index == 0 && (space == Space.Hsl || space == Space.Hwb))
        || (index == 2 && (space == Space.Lch || space == Space.Oklch)))
    let mut scale = 1.0
    if !generic {
      if space == Space.Srgb {
        scale = 255.0
      } else if space == Space.Hsl || space == Space.Hwb {
        scale = 100.0
      } else if space == Space.Lab {
        scale = if index == 0 {
          100.0
        } else {
          125.0
        }
      } else if space == Space.Lch {
        scale = if index == 0 {
          100.0
        } else {
          150.0
        }
      } else if space == Space.Oklab || space == Space.Oklch {
        scale = if index == 0 {
          1.0
        } else {
          0.4
        }
      }
    }
    let parsed = run component(source, &mut cursor.*, angular, scale)
    match &parsed {
      Option<Component>.Some { value } => {
        parts[index] = value
      }
      _ => {
        return Option<Color>.None
      }
    }

    // #resolving-color-function-values permits an implementation-defined
    // near-infinity limit. One million preserves HDR/out-of-gamut coordinates
    // while keeping all cubic/matrix/transfer-curve intermediates finite.
    result.channels[index] = if angular {
      hue(parts[index].value)
    } else if parts[index].value != parts[index].value {
      0.0
    } else {
      clamp(parts[index].value, -1000000.0, 1000000.0)
    }
    if parts[index].missing {
      result.missing = result.missing | bits[index]
    }
    if index == 0 {
      legacy = cursor.comma(source)
      if legacy && (generic || (space != Space.Srgb && space != Space.Hsl)) {
        return Option<Color>.None
      }
    } else if index == 1 && legacy && !cursor.comma(source) {
      return Option<Color>.None
    }
    if index < 2 && !legacy {
      let boundary = cursor.position
      cursor.skip(source)
      if cursor.position == boundary {
        return Option<Color>.None
      }
    }
    index = index + 1
  }
  if legacy {
    if result.missing != 0 {
      return Option<Color>.None
    }
    if space == Space.Srgb
      && (parts[0].percentage != parts[1].percentage
        || parts[1].percentage != parts[2].percentage) {
      return Option<Color>.None
    }
    if space == Space.Hsl && (!parts[1].percentage || !parts[2].percentage) {
      return Option<Color>.None
    }
  }
  let alpha = if legacy {
    cursor.comma(source)
  } else {
    cursor.delim(source, 47)
  }
  if alpha {
    let parsed = run component(source, &mut cursor.*, false, 1.0)
    match &parsed {
      Option<Component>.Some { value } => {
        if value.missing && legacy {
          return Option<Color>.None
        }
        if value.missing {
          result.missing = result.missing | 8
        }
        result.alpha = clamp(value.value, 0.0, 1.0)
      }
      _ => {
        return Option<Color>.None
      }
    }
  }

  // CSS Syntax implicitly closes functions at the end of the component stream.
  if !cursor.close(source) && !cursor.done(source) {
    return Option<Color>.None
  }
  if !generic {
    if space == Space.Srgb {
      index = 0
      while index < 3 {
        result.channels[index] = clamp(result.channels[index], 0.0, 255.0) / 255.0
        index = index + 1
      }
    } else if space == Space.Hsl {
      result.channels[1] = f64.max(0.0, result.channels[1])
    } else if space == Space.Lab || space == Space.Lch {
      result.channels[0] = clamp(result.channels[0], 0.0, 100.0)
    } else if space == Space.Oklab || space == Space.Oklch {
      result.channels[0] = clamp(result.channels[0], 0.0, 1.0)
    }
    if space == Space.Lch || space == Space.Oklch {
      result.channels[1] = f64.max(0.0, result.channels[1])
    }
  }
  return Option<Color>.some(result)
}

// #color-conversion-code. Row-major multiplication, with the coefficients
// transcribed from the pinned specification (not from another implementation).
fn matrix(m: &[f64; 9], v: [f64; 3]) -> [f64; 3] {
  return [
    m[0] * v[0] + m[1] * v[1] + m[2] * v[2],
    m[3] * v[0] + m[4] * v[1] + m[5] * v[2],
    m[6] * v[0] + m[7] * v[1] + m[8] * v[2],
  ]
}

