  -0.0638541728258133,
  1.0,
  -0.0894841775298119,
  -1.2914855480194092,
]

const LMS_XYZ: [f64; 9] = [
  1.2268798758459243,
  -0.5578149944602171,
  0.2813910456659647,
  -0.0405757452148008,
  1.1122868032803170,
  -0.0717110580655164,
  -0.0763729366746601,
  -0.4214933324022432,
  1.5869240198367816,
]

fn reflectedPow(value: f64, exponent: f64) -> f64 {
  let magnitude = math.pow(f64.abs(value), exponent)
  return if value < 0.0 {
    -magnitude
  } else {
    magnitude
  }
}

fn decode(value: f64) -> f64 {
  let magnitude = f64.abs(value)
  if magnitude <= 0.04045 {
    return value / 12.92
  }
  let linear = math.pow((magnitude + 0.055) / 1.055, 2.4)
  return if value < 0.0 {
    -linear
  } else {
    linear
  }
}

fn encode(value: f64) -> f64 {
  let magnitude = f64.abs(value)
  if magnitude <= 0.0031308 {
    return 12.92 * value
  }
  let encoded = 1.055 * math.pow(magnitude, 1.0 / 2.4) - 0.055
  return if value < 0.0 {
    -encoded
  } else {
    encoded
  }
}

fn encoded(rgb: [f64; 3]) -> [f64; 3] {
  return [encode(rgb[0]), encode(rgb[1]), encode(rgb[2])]
}

fn decoded(rgb: [f64; 3]) -> [f64; 3] {
  return [decode(rgb[0]), decode(rgb[1]), decode(rgb[2])]
}

fn polar(channels: [f64; 3]) -> [f64; 3] {
  let radians = math.radians(channels[2])
  return [channels[0], channels[1] * f64.cos(radians), channels[1] * f64.sin(radians)]
}

fn labXyz(lab: [f64; 3]) -> [f64; 3] {
  let kappa = 24389.0 / 27.0
  let epsilon = 216.0 / 24389.0
  let l = lab[0] / 116.0
  let a = lab[1] / 500.0
  let b = lab[2] / 200.0
  let fx = l + 16.0 / 116.0 + a
  let fy = (lab[0] + 16.0) / 116.0
  let fz = l + 16.0 / 116.0 - b
  let x = if fx * fx * fx > epsilon {
    fx * fx * fx
  } else {
    (l + a) * (116.0 / kappa)
  }
  let y = if lab[0] > 8.0 {
    fy * fy * fy
  } else {
    lab[0] / kappa
  }
  let z = if fz * fz * fz > epsilon {
    fz * fz * fz
  } else {
    (l - b) * (116.0 / kappa)
  }
  return [x * (0.3457 / 0.3585), y, z * ((1.0 - 0.3457 - 0.3585) / 0.3585)]
}

fn oklabXyz(lab: [f64; 3]) -> [f64; 3] {
  let lms = matrix(&OKLAB_LMS, lab)
  return matrix(
    &LMS_XYZ,
    [lms[0] * lms[0] * lms[0], lms[1] * lms[1] * lms[1], lms[2] * lms[2] * lms[2]],
  )
}

fn xyzOklab(xyz: [f64; 3]) -> [f64; 3] {
  let lms = matrix(&XYZ_LMS, xyz)
  return matrix(&LMS_OKLAB, [math.cbrt(lms[0]), math.cbrt(lms[1]), math.cbrt(lms[2])])
}

fn hslChannel(n: f64, h: f64, s: f64, l: f64) -> f64 {
  let mut k = n + h / 30.0
  if k >= 12.0 {
    k = k - 12.0
  }
  let amplitude = s * f64.min(l, 1.0 - l)
  return l - amplitude * f64.max(-1.0, f64.min(f64.min(k - 3.0, 9.0 - k), 1.0))
}

fn hslRgb(channels: [f64; 3]) -> [f64; 3] {
  let h = hue(channels[0])
  let s = channels[1] / 100.0
  let l = channels[2] / 100.0
  return [hslChannel(0.0, h, s, l), hslChannel(8.0, h, s, l), hslChannel(4.0, h, s, l)]
}

fn hwbRgb(channels: [f64; 3]) -> [f64; 3] {
  let white = channels[1] / 100.0
  let black = channels[2] / 100.0
  if white + black >= 1.0 {
    return [white / (white + black); 3]
  }
  let rgb = hslRgb([channels[0], 100.0, 50.0])
  let factor = 1.0 - white - black
  return [rgb[0] * factor + white, rgb[1] * factor + white, rgb[2] * factor + white]
}

fn coordinates(color: Color) -> [f64; 3] {
  let mut result = color.channels
  let bits: [u8; 3] = [1, 2, 4]
  let mut i: usize = 0
  while i < 3 {
    if (color.missing & bits[i]) != 0 {
      result[i] = 0.0
    }
    i = i + 1
  }
  return result
}

fn xyz(color: Color) -> [f64; 3] {
  let c = coordinates(color)
  return match color.space {
    Space.Srgb => matrix(&SRGB_XYZ, decoded(c))
    Space.SrgbLinear => matrix(&SRGB_XYZ, c)
    Space.DisplayP3 => matrix(&P3_XYZ, decoded(c))
    Space.DisplayP3Linear => matrix(&P3_XYZ, c)
    Space.A98Rgb => matrix(
      &A98_XYZ,
      [
        reflectedPow(c[0], 563.0 / 256.0),
        reflectedPow(c[1], 563.0 / 256.0),
        reflectedPow(c[2], 563.0 / 256.0),
      ],
    )
    Space.ProphotoRgb => {
      let mut linear = c
      let mut i: usize = 0
      while i < 3 {
        linear[i] = if f64.abs(c[i]) <= 16.0 / 512.0 {
          c[i] / 16.0
        } else {
          reflectedPow(c[i], 1.8)
        }
        i = i + 1
      }
      return matrix(&D50_D65, matrix(&PROPHOTO_XYZ, linear))
    }

    // Pinned Color4 uses BT.1886 gamma 2.4, not the camera OETF inverse.
    Space.Rec2020 => matrix(
      &REC2020_XYZ,
      [reflectedPow(c[0], 2.4), reflectedPow(c[1], 2.4), reflectedPow(c[2], 2.4)],
    )
    Space.XyzD65 => c
    Space.XyzD50 => matrix(&D50_D65, c)
    Space.Hsl => matrix(&SRGB_XYZ, decoded(hslRgb(c)))
    Space.Hwb => matrix(&SRGB_XYZ, decoded(hwbRgb(c)))
    Space.Lab => matrix(&D50_D65, labXyz(c))
    Space.Lch => matrix(&D50_D65, labXyz(polar(c)))
    Space.Oklab => oklabXyz(c)
    Space.Oklch => oklabXyz(polar(c))
  }
}

fn clipped(rgb: [f64; 3]) -> [f64; 3] {
  return [clamp(rgb[0], 0.0, 1.0), clamp(rgb[1], 0.0, 1.0), clamp(rgb[2], 0.0, 1.0)]
}

fn inGamut(rgb: [f64; 3]) -> bool {
  return rgb[0] >= 0.0 && rgb[0] <= 1.0 && rgb[1] >= 0.0 && rgb[1] <= 1.0 && rgb[2] >= 0.0
    && rgb[2] <= 1.0
}

fn delta(clippedRgb: [f64; 3], original: [f64; 3]) -> f64 {
  let lab = xyzOklab(matrix(&SRGB_XYZ, decoded(clippedRgb)))
  return math.hypot(math.hypot(lab[0] - original[0], lab[1] - original[1]), lab[2] - original[2])
}

// #pseudo-binsearch: local MINDE, JND deltaEOK=.02, epsilon=.0001.
fn gamutMap(original: [f64; 3], rgb: [f64; 3]) -> [f64; 3] {
  if original[0] >= 1.0 {
    return [1.0; 3]
  }
  if original[0] <= 0.0 {
    return [0.0; 3]
  }
  if inGamut(rgb) {
    return rgb
  }
  let mut result = clipped(rgb)
  if delta(result, original) < 0.02 {
    return result
  }
  let chroma = math.hypot(original[1], original[2])
  if chroma == 0.0 {
    return result
  }
  let directionA = original[1] / chroma
  let directionB = original[2] / chroma
  let mut low = 0.0
  let mut high = chroma
  let mut lowInGamut = true
  while high - low > 0.0001 {
    let middle = (low + high) * 0.5
    let current = [original[0], middle * directionA, middle * directionB]
    let converted = encoded(matrix(&XYZ_SRGB, oklabXyz(current)))
    if lowInGamut && inGamut(converted) {
      low = middle
    } else {
      result = clipped(converted)
      let error = delta(result, current)
      if error < 0.02 {
        if 0.02 - error < 0.0001 {
          return result
        }
        lowInGamut = false
        low = middle
      } else {
        high = middle
      }
    }
  }
  return result
}

/// Display conversion of a context-resolved absolute color, using sRGB local-MINDE.
/// Missing components become zero for this conversion only; the Color is unchanged.
pub fn toSrgb(color: Color) -> Rgba {
  let alpha = if (color.missing & 8) != 0 {
    0.0
  } else {
    clamp(color.alpha, 0.0, 1.0)
  }
  let channels = coordinates(color)

  // Preserve exact authored sRGB endpoints and avoid needless matrix roundtrips.
  let direct = color.space == Space.Srgb || color.space == Space.Hsl || color.space == Space.Hwb
  let mut sourceXyz = [0.0; 3]
  let mut rgb = channels
  if color.space == Space.Hsl {
    rgb = hslRgb(channels)
  } else if color.space == Space.Hwb {
    rgb = hwbRgb(channels)
  } else if !direct {
    sourceXyz = xyz(color)
    rgb = encoded(matrix(&XYZ_SRGB, sourceXyz))
  }
  if inGamut(rgb) {
    return Rgba { r: rgb[0], g: rgb[1], b: rgb[2], a: alpha }
  }

  // Per #specifying-lab-lch and #specifying-oklab-oklch, endpoint
  // lightness maps to white/black even for nonzero chromatic coordinates.
  if color.space == Space.Lab || color.space == Space.Lch || color.space == Space.Oklab
    || color.space == Space.Oklch {
    let maxLightness = if color.space == Space.Lab || color.space == Space.Lch {
      100.0
    } else {
      1.0
    }
    if channels[0] <= 0.0 {
      return Rgba { r: 0.0, g: 0.0, b: 0.0, a: alpha }
    }
    if channels[0] >= maxLightness {
      return Rgba { r: 1.0, g: 1.0, b: 1.0, a: alpha }
    }
  }
  if direct {
    sourceXyz = matrix(&SRGB_XYZ, decoded(rgb))
  }
  let mapped = gamutMap(xyzOklab(sourceXyz), rgb)
  return Rgba { r: mapped[0], g: mapped[1], b: mapped[2], a: alpha }
}

