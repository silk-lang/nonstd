pub enum InitialKind {
  Css,
  HostFontFamily,
  DecorationFill,
  DecorationStroke,
  Shorthand
}

pub fn initialKind(property: Property) -> InitialKind {
  if longhandCount(property) > 1 {
    return InitialKind.Shorthand
  }
  return match property {
    Property.FontFamily => InitialKind.HostFontFamily
    Property.TextDecorationFill => InitialKind.DecorationFill
    Property.TextDecorationStroke => InitialKind.DecorationStroke
    _ => InitialKind.Css
  }
}

pub fn canonical(property: Property) -> Property {
  return if property == Property.FontStretch {
    Property.FontWidth
  } else {
    property
  }
}

// Iteration is allocation-free; a shorthand value retains typed data for every target.
pub fn longhandCount(property: Property) -> usize {
  return match property {
    Property.All => 156
    Property.WhiteSpace => 3
    Property.Marker => 3
    Property.Font => 19
    Property.FontVariant => 7
    Property.FontSynthesis => 4
    Property.Mask => 14
    Property.MaskBorder => 6
    Property.TextDecoration => 3
    Property.TextEmphasis => 2
    Property.TextAlign => 2
    Property.Overflow => 2
    Property.VerticalAlign => 3
    _ => 1
  }
}

