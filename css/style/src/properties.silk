pub fn lookup(name: &[u8]) -> Option<Property> {
  if tokens.insensitive(name, b"animation") {
    return Option<Property>.some(Property.Animation)
  }
  if tokens.insensitive(name, b"animation-name") {
    return Option<Property>.some(Property.AnimationName)
  }
  if tokens.insensitive(name, b"animation-duration") {
    return Option<Property>.some(Property.AnimationDuration)
  }
  if tokens.insensitive(name, b"animation-timing-function") {
    return Option<Property>.some(Property.AnimationTimingFunction)
  }
  if tokens.insensitive(name, b"animation-delay") {
    return Option<Property>.some(Property.AnimationDelay)
  }
  if tokens.insensitive(name, b"animation-iteration-count") {
    return Option<Property>.some(Property.AnimationIterationCount)
  }
  if tokens.insensitive(name, b"animation-direction") {
    return Option<Property>.some(Property.AnimationDirection)
  }
  if tokens.insensitive(name, b"animation-fill-mode") {
    return Option<Property>.some(Property.AnimationFillMode)
  }
  if tokens.insensitive(name, b"animation-play-state") {
    return Option<Property>.some(Property.AnimationPlayState)
  }
  if tokens.insensitive(name, b"image-orientation") {
    return Option<Property>.some(Property.ImageOrientation)
  }
  if tokens.insensitive(name, b"fill") {
    return Option<Property>.some(Property.Fill)
  }
  if tokens.insensitive(name, b"fill-rule") {
    return Option<Property>.some(Property.FillRule)
  }
  if tokens.insensitive(name, b"fill-opacity") {
    return Option<Property>.some(Property.FillOpacity)
  }
  if tokens.insensitive(name, b"stroke") {
    return Option<Property>.some(Property.Stroke)
  }
  if tokens.insensitive(name, b"stroke-opacity") {
    return Option<Property>.some(Property.StrokeOpacity)
  }
  if tokens.insensitive(name, b"stroke-width") {
    return Option<Property>.some(Property.StrokeWidth)
  }
  if tokens.insensitive(name, b"stroke-linecap") {
    return Option<Property>.some(Property.StrokeLinecap)
  }
  if tokens.insensitive(name, b"stroke-linejoin") {
    return Option<Property>.some(Property.StrokeLinejoin)
  }
  if tokens.insensitive(name, b"stroke-miterlimit") {
    return Option<Property>.some(Property.StrokeMiterlimit)
  }
  if tokens.insensitive(name, b"stroke-dasharray") {
    return Option<Property>.some(Property.StrokeDasharray)
  }
  if tokens.insensitive(name, b"stroke-dashoffset") {
    return Option<Property>.some(Property.StrokeDashoffset)
  }
  if tokens.insensitive(name, b"marker-start") {
    return Option<Property>.some(Property.MarkerStart)
  }
  if tokens.insensitive(name, b"marker-mid") {
    return Option<Property>.some(Property.MarkerMid)
  }
  if tokens.insensitive(name, b"marker-end") {
    return Option<Property>.some(Property.MarkerEnd)
  }
  if tokens.insensitive(name, b"marker") {
    return Option<Property>.some(Property.Marker)
  }
  if tokens.insensitive(name, b"paint-order") {
    return Option<Property>.some(Property.PaintOrder)
  }
  if tokens.insensitive(name, b"color") {
    return Option<Property>.some(Property.Color)
  }
  if tokens.insensitive(name, b"color-interpolation") {
    return Option<Property>.some(Property.ColorInterpolation)
  }
  if tokens.insensitive(name, b"color-interpolation-filters") {
