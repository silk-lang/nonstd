//! Native CSSOM sheets and stable, sheet-local rule handles. Host identities are explicit.
import tokens {
  TokenBuffer,
  TokenRange,
  Span,
  Kind,
  Limits,
  CssError,
  CssErrorKind,
  equal,
  insensitive
}
import lexer
import syntax { Rule, RuleKind }
import syntax
import selectors { NamespaceBinding }
import selectors
import input { Input }
import supports
import values { Store }
import cssom_error { CssomError }
import cssom_declaration { StyleDeclaration }
import cssom_descriptors { Context }
import cssom_media { MediaList }
import cssom_serialization as serialization
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

pub const NO_RULE: usize = usize.MAX

pub const NO_SHEET: usize = usize.MAX

pub const NO_HOST: usize = usize.MAX

pub enum CssRuleKind {
  Style,
  Import,
  Namespace,
  Media,
  Supports,
  FontFace,
  Page,
  Margin,
  Keyframes,
  Keyframe,
  LayerBlock,
  LayerStatement,
  NestedDeclarations
}

pub struct CssRule {
  pub kind: CssRuleKind,
  pub parentRule: usize,
  pub parentStyleSheet: usize,
  pub prelude: Bytes,
  pub name: Bytes,
  pub href: Bytes,
  pub hasLayer: bool,
  pub layerName: Bytes,
  pub supportsText: Bytes,
  pub namespacePrefix: Bytes,
  pub namespaceUri: Bytes,
  /// Imported sheet identity, assigned by the loading host, or NO_SHEET.
  pub styleSheet: usize,
  pub style: StyleDeclaration,
  pub media: MediaList,
  first: usize,
  next: usize,
}

impl CssRule {
  pub fn ruleType(self: &CssRule) -> u16 {
    return match self.kind {
      CssRuleKind.Style => 1
      CssRuleKind.Import => 3
      CssRuleKind.Media => 4
      CssRuleKind.FontFace => 5
      CssRuleKind.Page => 6
      CssRuleKind.Keyframes => 7
      CssRuleKind.Keyframe => 8
      CssRuleKind.Margin => 9
      CssRuleKind.Namespace => 10
      CssRuleKind.Supports => 12
      _ => 0
    }
  }

  /// CSSOM deliberately specifies a no-op, including invalid input.
  pub fn setCssText(self: &mut CssRule, text: &[u8]) -> () {}

  pub fn selectorText(self: &CssRule) -> &[u8] {
    return self.prelude.asSlice()
  }

  pub effect fn conditionText(self: &CssRule) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.kind == CssRuleKind.Media {
      return run self.media.mediaText()
    }
    return run Bytes.copy(self.prelude.asSlice())
  }
}

/// A live list identity, not a snapshot. Retain this value across mutations.
pub struct RuleList {
  pub sheet: usize,
  pub parent: usize,
}

impl Copy for RuleList {}

impl RuleList {
  pub fn length(self: &RuleList, sheet: &StyleSheet) -> usize {
    if self.sheet != sheet.id {
      return 0
    }
    let mut id = sheet.firstFor(self.parent)
    let mut count: usize = 0
    while id != NO_RULE {
      count = count + 1
      id = sheet.arena.asSlice()[id].next
    }
    return count
  }

  pub fn item(self: &RuleList, sheet: &StyleSheet, index: usize) -> Option<usize> {
    if self.sheet != sheet.id {
      return Option<usize>.None
    }
    let mut id = sheet.firstFor(self.parent)
    let mut at: usize = 0
    while id != NO_RULE {
      if at == index {
        return Option<usize>.some(id)
      }
      id = sheet.arena.asSlice()[id].next
      at = at + 1
    }
    return Option<usize>.None
  }
}

pub struct StyleSheet {
  pub id: usize,
  pub constructed: bool,
  pub originClean: bool,
  pub disabled: bool,
  pub alternate: bool,
  pub ownerNode: usize,
  pub ownerRule: usize,
  pub parentStyleSheet: usize,
  pub constructorDocument: usize,
  pub title: Bytes,
  pub location: Bytes,
  pub baseUrl: Bytes,
  pub media: MediaList,
  arena: List<CssRule>,
  first: usize,
  replacing: bool,
}

impl StyleSheet {
  pub fn make(id: usize, constructed: bool) -> StyleSheet {
    return StyleSheet {
      id: id,
      constructed: constructed,
      originClean: true,
      disabled: false,
      alternate: false,
      ownerNode: NO_HOST,
      ownerRule: NO_RULE,
      parentStyleSheet: NO_SHEET,
      constructorDocument: NO_HOST,
      title: Bytes.make(),
      location: Bytes.make(),
      baseUrl: Bytes.make(),
      media: MediaList.make(),
      arena: List<CssRule>.make(),
      first: NO_RULE,
      replacing: false,
    }
  }

  pub fn mimeType(self: &StyleSheet) -> &[u8] {
    return b"text/css"
  }

  pub fn modificationPending(self: &StyleSheet) -> bool {
    return self.replacing
  }

  pub effect fn cssRules(self: &StyleSheet) -> RuleList
    ! CssomError {
    if !self.originClean {
      fail CssomError.SecurityError
    }
    return RuleList { sheet: self.id, parent: NO_RULE }
  }

  pub effect fn rules(self: &StyleSheet) -> RuleList
    ! CssomError {
    return run self.cssRules()
  }

  /// Privileged native list lookup, including retained detached grouping rules.
  /// Script-facing root access must go through cssRules(), which checks originClean.
  pub fn rulesFor(self: &StyleSheet, parent: usize) -> RuleList {
    return RuleList { sheet: self.id, parent: parent }
  }

  pub fn rule<'a>(self: &'a StyleSheet, id: usize) -> Option<&'a CssRule> {
    if id >= self.arena.length() {
      return Option<&'a CssRule>.None
    }
    return Option<&'a CssRule>.some(&self.arena.asSlice()[id])
  }

  pub fn ruleMut<'a>(self: &'a mut StyleSheet, id: usize) -> Option<&'a mut CssRule> {
    if id >= self.arena.length() {
      return Option<&'a mut CssRule>.None
    }
    return Option<&'a mut CssRule>.some(&mut self.arena.asMutSlice()[id])
  }

  fn firstFor(self: &StyleSheet, parent: usize) -> usize {
    if parent == NO_RULE {
      return self.first
    }
    if parent >= self.arena.length() {
      return NO_RULE
    }
    return self.arena.asSlice()[parent].first
  }

  fn setFirst(self: &mut StyleSheet, parent: usize, first: usize) -> () {
    if parent == NO_RULE {
      self.first = first
    } else {
      let mut arena = self.arena.asMutSlice()
      arena[parent].first = first
    }
  }

  effect fn writable(self: &StyleSheet) -> ()
    ! CssomError {
    if !self.originClean {
      fail CssomError.SecurityError
    }
    if self.replacing {
      fail CssomError.NotAllowedError
    }
  }

  fn namespaceOnly(self: &StyleSheet, parent: usize) -> bool {
    let mut id = self.firstFor(parent)
    while id != NO_RULE {
      let kind = self.arena.asSlice()[id].kind
      if kind != CssRuleKind.Import && kind != CssRuleKind.Namespace {
        return false
      }
      id = self.arena.asSlice()[id].next
    }
    return true
  }

  effect fn placement(self: &StyleSheet, kind: CssRuleKind, parent: usize, index: usize) -> ()
    ! CssomError {
    let list = self.rulesFor(parent)
    if index > list.length(self) {
      fail CssomError.IndexSizeError
    }
    if parent != NO_RULE {
      let container = self.arena.asSlice()[parent].kind
      if kind == CssRuleKind.Import || kind == CssRuleKind.Namespace {
        fail CssomError.HierarchyRequestError
      }
      if container == CssRuleKind.Keyframes && kind != CssRuleKind.Keyframe {
        fail CssomError.HierarchyRequestError
      }
      if container == CssRuleKind.Page && kind != CssRuleKind.Margin {
        fail CssomError.HierarchyRequestError
      }
      if self.nested(parent)
        && (kind == CssRuleKind.FontFace || kind == CssRuleKind.Page
          || kind == CssRuleKind.Keyframes
          || kind == CssRuleKind.Margin
          || kind == CssRuleKind.LayerStatement) {
        fail CssomError.HierarchyRequestError
      }
      return
    }
    let mut id = self.first
    let mut at: usize = 0
    while id != NO_RULE {
      let old = self.arena.asSlice()[id].kind
      if at < index {
        if kind == CssRuleKind.Import && old != CssRuleKind.Import
          && old != CssRuleKind.LayerStatement {
          fail CssomError.HierarchyRequestError
        }
        if kind == CssRuleKind.Namespace && old != CssRuleKind.Import
          && old != CssRuleKind.Namespace
          && old != CssRuleKind.LayerStatement {
          fail CssomError.HierarchyRequestError
        }
      } else {
        if old == CssRuleKind.Import && kind != CssRuleKind.Import
          && kind != CssRuleKind.LayerStatement {
          fail CssomError.HierarchyRequestError
        }
        if old == CssRuleKind.Namespace && kind != CssRuleKind.Import
          && kind != CssRuleKind.Namespace
          && kind != CssRuleKind.LayerStatement {
          fail CssomError.HierarchyRequestError
        }
      }
      id = self.arena.asSlice()[id].next
      at = at + 1
    }
    if kind == CssRuleKind.Namespace && !self.namespaceOnly(parent) {
      fail CssomError.InvalidStateError
    }
  }

  fn link(self: &mut StyleSheet, parent: usize, index: usize, id: usize) -> () {
    if index == 0 {
      let first = self.firstFor(parent)
      let mut arena = self.arena.asMutSlice()
      arena[id].next = first
      drop arena
      self.setFirst(parent, id)
      return
    }
    let mut previous = self.firstFor(parent)
    let mut at: usize = 1
    while at < index {
      previous = self.arena.asSlice()[previous].next
      at = at + 1
    }
    let next = self.arena.asSlice()[previous].next
    let mut arena = self.arena.asMutSlice()
    arena[id].next = next
    arena[previous].next = id
  }

  /// Syntax's parse-a-rule rejects trailing junk even when parseRules would recover it.
  pub effect fn insertRule(
    self: &mut StyleSheet,
    text: &[u8],
    index: usize,
    limits: &Limits,
  ) -> usize
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    run self.writable()
    let buffer = run lexer.tokenize(text, limits)
    if !oneRule(&buffer) {
      fail CssomError.SyntaxError
    }
    let rules = run syntax.parseRules(&buffer, buffer.all(), false, limits)
    if rules.length() != 1 {
      fail CssomError.SyntaxError
    }
    let parsed = rules.asSlice()[0]
    if self.constructed && insensitive(buffer.text(parsed.name), b"import") {
      fail CssomError.SyntaxError
    }

    // CSSStyleSheet parses CSS Syntax before the generic insertion index check.
    let list = self.rulesFor(NO_RULE)
    if index > list.length(&self.*) {
      fail CssomError.IndexSizeError
    }
    return run self.insertParsed(move buffer, parsed, NO_RULE, index, limits)
  }

  effect fn insertParsed(
    self: &mut StyleSheet,
    buffer: TokenBuffer,
    parsed: Rule,
    parent: usize,
    index: usize,
    limits: &Limits,
  ) -> usize
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let start = self.arena.length()
    let mut owned = move buffer
    let mut depth: usize = 0
    let mut ancestor = parent
    while ancestor != NO_RULE {
      depth = depth + 1
      ancestor = self.arena.asSlice()[ancestor].parentRule
    }
    let result = run Effect.result(self.parseRule(&mut owned, parsed, parent, limits, depth))
    let id = match move result {
      Result<usize, CssomError | CssError | OutOfMemoryError>.Success { value } => value
      Result<usize, CssomError | CssError | OutOfMemoryError>.Failure { error } => {
        self.arena.truncate(start)
        fail move error
      }
    }
    let placement = run Effect.result(self.placement(self.arena.asSlice()[id].kind, parent, index))
    match move placement {
      Result<(), CssomError>.Failure { error } => {
        self.arena.truncate(start)
        fail error
      }
      _ => {}
    }
    self.link(parent, index, id)
    return index
  }

  pub effect fn insertGroupingRule(
    self: &mut StyleSheet,
    parent: usize,
    text: &[u8],
    index: usize,
    limits: &Limits,
  ) -> usize
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if parent >= self.arena.length() || !grouping(self.arena.asSlice()[parent].kind) {
      fail CssomError.HierarchyRequestError
    }
    let list = self.rulesFor(parent)
    if index > list.length(&self.*) {
      fail CssomError.IndexSizeError
    }
    let buffer = run lexer.tokenize(text, limits)
    if oneRule(&buffer) {
      let rules = run syntax.parseRules(&buffer, buffer.all(), false, limits)
      if rules.length() == 1 {
        return run self.insertParsed(move buffer, rules.asSlice()[0], parent, index, limits)
      }
    }
    let style = run StyleDeclaration.parse(text, limits)
    if style.length() == 0 {
      fail CssomError.SyntaxError
    }
    let id = self.arena.length()
    let sheet = self.arena.asSlice()[parent].parentStyleSheet
    let mut rule = emptyRule(CssRuleKind.NestedDeclarations, parent, sheet)
    rule.style = move style
    rule.style.setParentRule(id)
    run self.placement(CssRuleKind.NestedDeclarations, parent, index)
    run self.arena.append(move rule)
    self.link(parent, index, id)
    return index
  }

  pub effect fn deleteRule(self: &mut StyleSheet, index: usize) -> ()
    ! CssomError {
    run self.writable()
    run self.deleteGroupingRule(NO_RULE, index)
  }

  pub effect fn deleteGroupingRule(self: &mut StyleSheet, parent: usize, index: usize) -> ()
    ! CssomError {
    let list = self.rulesFor(parent)
    let id = match list.item(&self.*, index) {
      Option<usize>.Some { value } => value
      _ => {
        fail CssomError.IndexSizeError
      }
    }
    if self.arena.asSlice()[id].kind == CssRuleKind.Namespace && !self.namespaceOnly(parent) {
      fail CssomError.InvalidStateError
    }
    let next = self.arena.asSlice()[id].next
    if index == 0 {
      self.setFirst(parent, next)
    } else {
      let previous = match list.item(&self.*, index - 1) {
        Option<usize>.Some { value } => value
        _ => {
          fail CssomError.IndexSizeError
        }
      }
      let mut arena = self.arena.asMutSlice()
      arena[previous].next = next
    }
    self.detach(id)
  }

  fn detach(self: &mut StyleSheet, id: usize) -> () {
    let mut arena = self.arena.asMutSlice()
    arena[id].parentRule = NO_RULE
    arena[id].next = NO_RULE
    drop arena
    self.detachSheet(id)
  }

  fn detachSheet(self: &mut StyleSheet, id: usize) -> () {
    let mut child = self.arena.asSlice()[id].first
    let mut arena = self.arena.asMutSlice()
    arena[id].parentStyleSheet = NO_SHEET
    drop arena
    while child != NO_RULE {
      let next = self.arena.asSlice()[child].next
      self.detachSheet(child)
      child = next
    }
  }

  pub effect fn removeRule(self: &mut StyleSheet, index: usize) -> ()
    ! CssomError {
    run self.deleteRule(index)
  }

  /// The native omitted-index sentinel is usize.MAX. Bindings supply the WebIDL
  /// default selector/style strings ("undefined") before calling this method.
  pub effect fn addRule(
    self: &mut StyleSheet,
    selector: &[u8],
    style: &[u8],
    index: usize,
    limits: &Limits,
  ) -> i32
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut text = run Bytes.copy(selector)
    run text.append(b" { ")
    if style.length != 0 {
      run text.append(style)
      run text.append(b" ")
    }
    run text.append(b"}")
    let at = if index == usize.MAX {
      self.rulesFor(NO_RULE).length(&self.*)
    } else {
      index
    }
    let inserted = run self.insertRule(text.asSlice(), at, limits)
    return -1
  }

  pub effect fn beginReplace(self: &mut StyleSheet) -> ()
    ! CssomError {
    if !self.constructed || self.replacing {
      fail CssomError.NotAllowedError
    }
    self.replacing = true
  }

  pub fn cancelReplace(self: &mut StyleSheet) -> () {
    self.replacing = false
  }

  pub effect fn finishReplace(self: &mut StyleSheet, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if !self.replacing {
      fail CssomError.NotAllowedError
    }
    let result = run Effect.result(self.replaceContents(text, true, limits))
    self.replacing = false
    match move result {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => {
        fail move error
      }
      _ => {}
    }
  }

  pub effect fn replaceSync(self: &mut StyleSheet, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if !self.constructed || self.replacing {
      fail CssomError.NotAllowedError
    }
    run self.replaceContents(text, true, limits)
  }

  /// Host loading entrypoint; unlike replaceSync this accepts nonconstructed sheets.
  pub effect fn load(self: &mut StyleSheet, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if self.replacing {
      fail CssomError.NotAllowedError
    }
    let constructed = self.constructed
    run self.replaceContents(text, constructed, limits)
  }

  effect fn replaceContents(
    self: &mut StyleSheet,
    text: &[u8],
    removeImports: bool,
    limits: &Limits,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut buffer = run lexer.tokenize(text, limits)
    let start = self.arena.length()
    let old = self.first

    // Parsing uses a private root. Existing live lists are not exposed during this synchronous call.
    self.first = NO_RULE
    let range = buffer.all()
    let result = run Effect.result(
      self.parseList(&mut buffer, range, NO_RULE, removeImports, limits, 0),
    )
    match move result {
      Result<(), CssomError | CssError | OutOfMemoryError>.Failure { error } => {
        self.first = old
        self.arena.truncate(start)
        fail move error
      }
      _ => {}
    }
    let mut id = old
    while id != NO_RULE {
      let next = self.arena.asSlice()[id].next
      self.detach(id)
      id = next
    }
  }

  pub effect fn setSelectorText(
    self: &mut StyleSheet,
    id: usize,
    text: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if id >= self.arena.length() {
      return
    }
    let kind = self.arena.asSlice()[id].kind
    if kind != CssRuleKind.Style && kind != CssRuleKind.Page {
      return
    }
    let mut buffer = run lexer.tokenize(text, limits)
    let range = buffer.all()
    let serialized = if kind == CssRuleKind.Style {
      let bindings = run self.bindings(
        &mut buffer,
        self.arena.asSlice()[id].parentStyleSheet != NO_SHEET,
        limits,
      )
      let parsed = run selectors.validateCssom(
        &buffer,
        range,
        bindings.asSlice(),
        limits,
        self.nested(self.arena.asSlice()[id].parentRule),
      )
      if !parsed {
        return
      }
      run serialization.selectorTextWithNamespaces(&buffer, range, bindings.asSlice())
    } else {
      if !pageSelectors(&buffer, range) {
        return
      }
      run serialization.selectorText(&buffer, range)
    }
    let mut arena = self.arena.asMutSlice()
    arena[id].prelude = move serialized
  }

  effect fn bindings(
    self: &StyleSheet,
    buffer: &mut TokenBuffer,
    attached: bool,
    limits: &Limits,
  ) -> List<NamespaceBinding>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut result = List<NamespaceBinding>.make()
    if !attached {
      return move result
    }
    let mut id = self.first
    while id != NO_RULE {
      let rule = &self.arena.asSlice()[id]
      if rule.kind == CssRuleKind.Namespace {
        let prefix = run appendText(&mut buffer.*, rule.namespacePrefix.asSlice(), limits)
        let uri = run appendText(&mut buffer.*, rule.namespaceUri.asSlice(), limits)

        // Later declarations replace earlier bindings for the same prefix.
        let mut found = false
        let mut i: usize = 0
        while i < result.length() {
          if equal(buffer.text(result.asSlice()[i].prefix), rule.namespacePrefix.asSlice()) {
            let mut entries = result.asMutSlice()
            entries[i] = NamespaceBinding { prefix: prefix, uri: uri }
            found = true
            break
          }
          i = i + 1
        }
        if !found {
          run result.append(NamespaceBinding { prefix: prefix, uri: uri })
        }
      }
      id = rule.next
    }
    return move result
  }

  effect fn parseList(
    self: &mut StyleSheet,
    buffer: &mut TokenBuffer,
    range: TokenRange,
    parent: usize,
    removeImports: bool,
    limits: &Limits,
    depth: usize,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let parsed = run syntax.parseRules(&buffer.*, range, parent == NO_RULE, limits)
    let mut i: usize = 0
    while i < parsed.length() {
      let rule = parsed.asSlice()[i]
      if !(removeImports && insensitive(buffer.text(rule.name), b"import")) {
        let start = self.arena.length()
        let result = run Effect.result(self.parseRule(&mut buffer.*, rule, parent, limits, depth))
        match move result {
          Result<usize, CssomError | CssError | OutOfMemoryError>.Success { value } => {
            let index = self.rulesFor(parent).length(&self.*)
            let placement = run Effect.result(
              self.placement(self.arena.asSlice()[value].kind, parent, index),
            )
            match move placement {
              Result<(), CssomError>.Success { value: ignored } => self.link(parent, index, value)
              _ => self.arena.truncate(start)
            }
          }
          Result<usize, CssomError | CssError | OutOfMemoryError>.Failure { error } => {
            self.arena.truncate(start)
            match move error {
              CssomError ignored => {}
              CssError problem => {
                fail move problem
              }
              OutOfMemoryError problem => {
                fail move problem
              }
            }
          }
        }
      }
      i = i + 1
    }
  }

  effect fn parseRule(
    self: &mut StyleSheet,
    owned: &mut TokenBuffer,
    parsed: Rule,
    parent: usize,
    limits: &Limits,
    depth: usize,
  ) -> usize
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if depth >= limits.maxDepth {
      fail CssError { kind: CssErrorKind.NestingLimit, offset: parsed.prelude.start }
    }

    // Retained detached rules count towards the arena resource limit as well.
    if self.arena.length() >= limits.maxRules {
      fail CssError { kind: CssErrorKind.RuleLimit, offset: parsed.prelude.start }
    }
    let prelude = trim(&owned.*, parsed.prelude)
    let name = owned.text(parsed.name)
    let parentKind = if parent == NO_RULE {
      CssRuleKind.Media
    } else {
      self.arena.asSlice()[parent].kind
    }
    let kind = if parsed.kind == RuleKind.Qualified {
      if parentKind == CssRuleKind.Keyframes {
        CssRuleKind.Keyframe
      } else {
        CssRuleKind.Style
      }
    } else if insensitive(name, b"import") && parsed.kind == RuleKind.AtStatement {
      CssRuleKind.Import
    } else if insensitive(name, b"namespace") && parsed.kind == RuleKind.AtStatement {
      CssRuleKind.Namespace
    } else if insensitive(name, b"layer") {
      if parsed.kind == RuleKind.AtStatement {
        CssRuleKind.LayerStatement
      } else {
        CssRuleKind.LayerBlock
      }
    } else if parsed.kind != RuleKind.AtBlock {
      fail CssomError.SyntaxError
    } else if insensitive(name, b"media") {
      CssRuleKind.Media
    } else if insensitive(name, b"supports") {
      CssRuleKind.Supports
    } else if insensitive(name, b"font-face") {
      CssRuleKind.FontFace
    } else if insensitive(name, b"page") {
      CssRuleKind.Page
    } else if insensitive(name, b"keyframes") {
      CssRuleKind.Keyframes
    } else if marginName(name) && parent != NO_RULE && parentKind == CssRuleKind.Page {
      CssRuleKind.Margin
    } else {
      fail CssomError.SyntaxError
    }
    let sheet = if parent == NO_RULE {
      self.id
    } else {
      self.arena.asSlice()[parent].parentStyleSheet
    }
    let mut rule = emptyRule(kind, parent, sheet)
    rule.name = run lowercase(name)
    if kind == CssRuleKind.Style {
      let bindings = run self.bindings(&mut owned.*, sheet != NO_SHEET, limits)
      let selector = run selectors.validateCssom(
        &owned.*,
        prelude,
        bindings.asSlice(),
        limits,
        self.nested(parent),
      )
      if !selector {
        fail CssomError.SyntaxError
      }
      rule.prelude = run serialization.selectorTextWithNamespaces(
        &owned.*,
        prelude,
        bindings.asSlice(),
      )
    } else {
      rule.prelude = run serialization.components(&owned.*, prelude)
    }
    if kind == CssRuleKind.Page && !pageSelectors(&owned.*, prelude) {
      fail CssomError.SyntaxError
    }
    if (kind == CssRuleKind.FontFace || kind == CssRuleKind.Margin)
      && prelude.start != prelude.end {
      fail CssomError.SyntaxError
    }
    if kind == CssRuleKind.LayerStatement || kind == CssRuleKind.LayerBlock {
      if !layerNames(&owned.*, prelude, kind == CssRuleKind.LayerStatement) {
        fail CssomError.SyntaxError
      }
    }
    if kind == CssRuleKind.Keyframes {
      if prelude.end != prelude.start + 1 {
        fail CssomError.SyntaxError
      }
      match &owned.tokens.asSlice()[prelude.start].kind {
        Kind.String { text } => {
          if owned.text(text).length == 0 {
            fail CssomError.SyntaxError
          }
          rule.name = run Bytes.copy(owned.text(text))
        }
        Kind.Ident { text } => {
          if reserved(owned.text(text)) || insensitive(owned.text(text), b"none") {
            fail CssomError.SyntaxError
          }
          rule.name = run Bytes.copy(owned.text(text))
        }
        _ => {
          fail CssomError.SyntaxError
        }
      }
    }
    if kind == CssRuleKind.Keyframe {
      if !keyframeSelectors(&owned.*, prelude) {
        fail CssomError.SyntaxError
      }
      rule.prelude = run keyframeText(&owned.*, prelude)
    }
    if kind == CssRuleKind.Supports {
      let input = Input.Contiguous { buffer: &owned.*, range: prelude }
      let mut store = Store.make()
      let condition = run supports.evaluate(&input, &mut store, limits)
      if !condition.valid {
        fail CssomError.SyntaxError
      }
    }
    if kind == CssRuleKind.Media {
      rule.media = run MediaList.parse(rule.prelude.asSlice(), limits)
    }
    if kind == CssRuleKind.Import || kind == CssRuleKind.Namespace {
      let mut at = prelude.start
      if kind == CssRuleKind.Namespace && at < prelude.end {
        match &owned.tokens.asSlice()[at].kind {
          Kind.Ident { text } => {
            rule.namespacePrefix = run Bytes.copy(owned.text(text))
            at = skipWhitespace(&owned.*, at + 1, prelude.end)
          }
          _ => {}
        }
      }
      let uri = urlValue(&owned.*, at, prelude.end)
      let span = match uri {
        Option<Span>.Some { value } => value
        _ => {
          fail CssomError.SyntaxError
        }
      }
      let mut after = skipWhitespace(&owned.*, componentEnd(&owned.*, at, prelude.end), prelude.end)
      if kind == CssRuleKind.Namespace {
        if after != prelude.end {
          fail CssomError.SyntaxError
        }
        rule.namespaceUri = run Bytes.copy(owned.text(span))
      } else {
        rule.href = run Bytes.copy(owned.text(span))
        if after < prelude.end {
          match &owned.tokens.asSlice()[after].kind {
            Kind.Ident { text } => {
              if insensitive(owned.text(text), b"layer") {
                rule.hasLayer = true
                after = skipWhitespace(&owned.*, after + 1, prelude.end)
              }
            }
            Kind.Function { name: functionName } => {
              if insensitive(owned.text(functionName), b"layer") {
                let close = owned.tokens.asSlice()[after].matching
                let inner = trim(
                  &owned.*,
                  TokenRange {
                    start: after + 1,
                    end: if close < prelude.end {
                      close
                    } else {
                      prelude.end
                    },
                  },
                )
                if inner.start == inner.end || !layerNames(&owned.*, inner, false) {
                  fail CssomError.SyntaxError
                }
                rule.hasLayer = true
                rule.layerName = run serialization.components(&owned.*, inner)
                after = skipWhitespace(
                  &owned.*,
                  componentEnd(&owned.*, after, prelude.end),
                  prelude.end,
                )
              }
            }
            _ => {}
          }
        }
        if after < prelude.end {
          match &owned.tokens.asSlice()[after].kind {
            Kind.Function { name: functionName } => {
              if insensitive(owned.text(functionName), b"supports") {
                let close = owned.tokens.asSlice()[after].matching
                let inner = trim(
                  &owned.*,
                  TokenRange {
                    start: after + 1,
                    end: if close < prelude.end {
                      close
                    } else {
                      prelude.end
                    },
                  },
                )
                let input = Input.Contiguous { buffer: &owned.*, range: inner }
                let mut store = Store.make()
                let condition = run supports.evaluateImport(&input, &mut store, limits)
                if !condition.valid {
                  fail CssomError.SyntaxError
                }
                rule.supportsText = run serialization.components(&owned.*, inner)
                after = skipWhitespace(
                  &owned.*,
                  componentEnd(&owned.*, after, prelude.end),
                  prelude.end,
                )
              }
            }
            _ => {}
          }
        }
        let media = run serialization.components(
          &owned.*,
          TokenRange { start: after, end: prelude.end },
        )
        rule.media = run MediaList.parse(media.asSlice(), limits)
      }
    }
    if kind == CssRuleKind.FontFace || kind == CssRuleKind.Margin || kind == CssRuleKind.Keyframe {
      let body = run serialization.components(&owned.*, parsed.body)
      rule.style = if kind == CssRuleKind.Keyframe {
        run StyleDeclaration.parseKeyframe(body.asSlice(), limits)
      } else {
        run StyleDeclaration.parseFor(declarationContext(kind), body.asSlice(), limits)
      }
    }
    let id = self.arena.length()
    rule.style.setParentRule(id)
    run self.arena.append(move rule)
    if kind == CssRuleKind.Style || kind == CssRuleKind.Page
      || ((kind == CssRuleKind.Media || kind == CssRuleKind.Supports
        || kind == CssRuleKind.LayerBlock)
        && self.nested(parent)) {
      run self.parseStyleBlock(
        &mut owned.*,
        parsed.body,
        id,
        kind == CssRuleKind.Style || kind == CssRuleKind.Page,
        limits,
        depth + 1,
      )
    } else if kind == CssRuleKind.Media || kind == CssRuleKind.Supports
      || kind == CssRuleKind.LayerBlock
      || kind == CssRuleKind.Keyframes {
      run self.parseList(&mut owned.*, parsed.body, id, false, limits, depth + 1)
    }
    return id
  }

  fn nested(self: &StyleSheet, parent: usize) -> bool {
    let mut id = parent
    while id != NO_RULE {
      if self.arena.asSlice()[id].kind == CssRuleKind.Style {
        return true
      }
      id = self.arena.asSlice()[id].parentRule
    }
    return false
  }

  effect fn blockDeclarations(
    self: &mut StyleSheet,
    buffer: &TokenBuffer,
    range: TokenRange,
    parent: usize,
    primary: bool,
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let body = run serialization.components(buffer, range)
    let mut text = if primary {
      run self.arena.asSlice()[parent].style.cssText()
    } else {
      Bytes.make()
    }
    run text.append(body.asSlice())
    let declarations = run StyleDeclaration.parseFor(
      declarationContext(self.arena.asSlice()[parent].kind),
      text.asSlice(),
      limits,
    )
    if declarations.length() == 0 {
      return
    }
    if primary {
      let mut arena = self.arena.asMutSlice()
      arena[parent].style = move declarations
      arena[parent].style.setParentRule(parent)
    } else {
      if self.arena.length() >= limits.maxRules {
        fail CssError { kind: CssErrorKind.RuleLimit, offset: range.start }
      }
      let id = self.arena.length()
      let mut rule = emptyRule(
        CssRuleKind.NestedDeclarations,
        parent,
        self.arena.asSlice()[parent].parentStyleSheet,
      )
      rule.style = move declarations
      rule.style.setParentRule(id)
      let index = self.rulesFor(parent).length(&self.*)
      run self.arena.append(move rule)
      self.link(parent, index, id)
    }
  }

  // Consume declaration runs separately from nested rules: declarations after a
  // nested rule belong to CSSNestedDeclarations, not the parent's declaration block.
  effect fn parseStyleBlock(
    self: &mut StyleSheet,
    buffer: &mut TokenBuffer,
    range: TokenRange,
    parent: usize,
    primary: bool,
    limits: &Limits,
    depth: usize,
  ) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    let mut at = range.start
    let mut declarations = at
    let mut initial = primary
    while at < range.end {
      at = skipWhitespace(&buffer.*, at, range.end)
      if at == range.end {
        break
      }
      let start = at
      let isAt = match &buffer.tokens.asSlice()[at].kind {
        Kind.AtKeyword { name } => true
        _ => false
      }
      let custom = match &buffer.tokens.asSlice()[at].kind {
        Kind.Ident { text } => {
          let name = buffer.text(text)
          name.length >= 2 && name[0] == 45 && name[1] == 45
        }
        _ => false
      }
      let mut isRule = isAt
      while at < range.end {
        match &buffer.tokens.asSlice()[at].kind {
          Kind.Semicolon => {
            at = at + 1
            break
          }
          Kind.OpenBrace => {
            if !custom || isAt {
              isRule = true
              at = componentEnd(&buffer.*, at, range.end)
              break
            }
          }
          _ => {}
        }
        at = componentEnd(&buffer.*, at, range.end)
      }
      if isRule {
        run self.blockDeclarations(
          &buffer.*,
          TokenRange { start: declarations, end: start },
          parent,
          initial,
          limits,
        )
        let parsed = run syntax.parseRules(
          &buffer.*,
          TokenRange { start: start, end: at },
          false,
          limits,
        )
        if parsed.length() == 1 {
          let saved = self.arena.length()
          let result = run Effect.result(
            self.parseRule(&mut buffer.*, parsed.asSlice()[0], parent, limits, depth),
          )
          match move result {
            Result<usize, CssomError | CssError | OutOfMemoryError>.Success { value } => {
              let index = self.rulesFor(parent).length(&self.*)
              let placement = run Effect.result(
                self.placement(self.arena.asSlice()[value].kind, parent, index),
              )
              match move placement {
                Result<(), CssomError>.Success { value: ignored } => {
                  self.link(parent, index, value)
                  if self.arena.asSlice()[parent].kind != CssRuleKind.Page {
                    initial = false
                  }
                }
                _ => self.arena.truncate(saved)
              }
            }
            Result<usize, CssomError | CssError | OutOfMemoryError>.Failure { error } => {
              self.arena.truncate(saved)
              match move error {
                CssomError ignored => {}
                CssError problem => {
                  fail move problem
                }
                OutOfMemoryError problem => {
                  fail move problem
                }
              }
            }
          }
        }
        declarations = at
      }
    }
    run self.blockDeclarations(
      &buffer.*,
      TokenRange { start: declarations, end: range.end },
      parent,
      initial,
      limits,
    )
  }

  pub effect fn setKeyText(self: &mut StyleSheet, id: usize, text: &[u8], limits: &Limits) -> ()
    ! CssomError | CssError | OutOfMemoryError
    ? &mut Allocator {
    if id >= self.arena.length() || self.arena.asSlice()[id].kind != CssRuleKind.Keyframe {
      fail CssomError.InvalidStateError
    }
    let buffer = run lexer.tokenize(text, limits)
    if !keyframeSelectors(&buffer, buffer.all()) {
      fail CssomError.SyntaxError
    }
    let key = run keyframeText(&buffer, buffer.all())
    let mut arena = self.arena.asMutSlice()
    arena[id].prelude = move key
  }

  pub effect fn setKeyframesName(self: &mut StyleSheet, id: usize, name: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if id >= self.arena.length() || self.arena.asSlice()[id].kind != CssRuleKind.Keyframes {
      return
    }
    let copied = run Bytes.copy(name)
    let mut arena = self.arena.asMutSlice()
    arena[id].name = move copied
  }

  pub effect fn appendKeyframeRule(
    self: &mut StyleSheet,
    parent: usize,
    text: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if parent >= self.arena.length() || self.arena.asSlice()[parent].kind != CssRuleKind.Keyframes {
      return
    }
    let index = self.rulesFor(parent).length(&self.*)
    let result = run Effect.result(self.insertGroupingRule(parent, text, index, limits))
    match move result {
      Result<usize, CssomError | CssError | OutOfMemoryError>.Failure {
        error
      } => match move error {
        CssomError ignored => {}
        CssError problem => {
          fail move problem
        }
        OutOfMemoryError problem => {
          fail move problem
        }
      }
      _ => {}
    }
  }

  pub effect fn findKeyframeRule(
    self: &StyleSheet,
    parent: usize,
    selector: &[u8],
    limits: &Limits,
  ) -> Option<usize>
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if parent >= self.arena.length() || self.arena.asSlice()[parent].kind != CssRuleKind.Keyframes {
      return Option<usize>.None
    }
    let buffer = run lexer.tokenize(selector, limits)
    if !keyframeSelectors(&buffer, buffer.all()) {
      return Option<usize>.None
    }
    let key = run keyframeText(&buffer, buffer.all())
    let mut id = self.firstFor(parent)
    let mut found = Option<usize>.None
    while id != NO_RULE {
      if equal(self.arena.asSlice()[id].prelude.asSlice(), key.asSlice()) {
        found = Option<usize>.some(id)
      }
      id = self.arena.asSlice()[id].next
    }
    return found
  }

  pub effect fn deleteKeyframeRule(
    self: &mut StyleSheet,
    parent: usize,
    selector: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    let found = run self.findKeyframeRule(parent, selector, limits)
    let id = match found {
      Option<usize>.Some { value } => value
      _ => {
        return
      }
    }
    let mut previous = NO_RULE
    let mut current = self.firstFor(parent)
    while current != id {
      previous = current
      current = self.arena.asSlice()[current].next
    }
    let next = self.arena.asSlice()[id].next
    if previous == NO_RULE {
      self.setFirst(parent, next)
    } else {
      let mut arena = self.arena.asMutSlice()
      arena[previous].next = next
    }
    self.detach(id)
  }

  /// CSSConditionRule setters retain the old condition on parse failure.
  pub effect fn setConditionText(
    self: &mut StyleSheet,
    id: usize,
    text: &[u8],
    limits: &Limits,
  ) -> ()
    ! CssError | OutOfMemoryError
    ? &mut Allocator {
    if id >= self.arena.length() {
      return
    }
    let kind = self.arena.asSlice()[id].kind
    if kind == CssRuleKind.Media {
      let media = run MediaList.parse(text, limits)
      let prelude = run media.mediaText()
      let mut arena = self.arena.asMutSlice()
      arena[id].media = move media
      arena[id].prelude = move prelude
    } else if kind == CssRuleKind.Supports {
      let buffer = run lexer.tokenize(text, limits)
      let input = Input.Contiguous { buffer: &buffer, range: buffer.all() }
      let mut store = Store.make()
      let parsed = run supports.evaluate(&input, &mut store, limits)
      if !parsed.valid {
        return
      }
      let condition = run serialization.components(&buffer, trim(&buffer, buffer.all()))
      let mut arena = self.arena.asMutSlice()
      arena[id].prelude = move condition
    }
  }

  pub effect fn cssText(self: &StyleSheet, id: usize) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = Bytes.make()
    if id >= self.arena.length() {
      return move out
    }
    let rule = &self.arena.asSlice()[id]
    if rule.kind == CssRuleKind.NestedDeclarations {
      return run rule.style.cssText()
    }
    if rule.kind == CssRuleKind.Import {
      run out.append(b"@import ")
      let href = run serialization.url(rule.href.asSlice())
      run out.append(href.asSlice())
      if rule.hasLayer {
        run out.append(b" layer")
        if rule.layerName.length() != 0 {
          run out.append(b"(")
          run out.append(rule.layerName.asSlice())
          run out.append(b")")
        }
      }
      if rule.supportsText.length() != 0 {
        run out.append(b" supports(")
        run out.append(rule.supportsText.asSlice())
        run out.append(b")")
      }
      let media = run rule.media.mediaText()
      if media.length() != 0 {
        run out.append(b" ")
        run out.append(media.asSlice())
      }
      run out.append(b";")
      return move out
    }
    if rule.kind == CssRuleKind.Namespace {
      run out.append(b"@namespace ")
      if rule.namespacePrefix.length() != 0 {
        let prefix = run serialization.identifier(rule.namespacePrefix.asSlice())
        run out.append(prefix.asSlice())
        run out.append(b" ")
      }
      let uri = run serialization.url(rule.namespaceUri.asSlice())
      run out.append(uri.asSlice())
      run out.append(b";")
      return move out
    }
    if rule.kind != CssRuleKind.Style && rule.kind != CssRuleKind.Keyframe {
      run out.append(b"@")
      if rule.kind == CssRuleKind.Keyframes {
        run out.append(b"keyframes")
      } else {
        run out.append(rule.name.asSlice())
      }
      if rule.prelude.length() != 0 || rule.kind == CssRuleKind.Media {
        run out.append(b" ")
      }
    }
    if rule.kind == CssRuleKind.Media {
      let media = run rule.media.mediaText()
      run out.append(media.asSlice())
    } else if rule.kind == CssRuleKind.Keyframes {
      let name = if reserved(rule.name.asSlice()) || insensitive(rule.name.asSlice(), b"none") {
        run serialization.string(rule.name.asSlice())
      } else {
        run serialization.identifier(rule.name.asSlice())
      }
      run out.append(name.asSlice())
    } else {
      run out.append(rule.prelude.asSlice())
    }
    if rule.kind == CssRuleKind.LayerStatement {
      run out.append(b";")
      return move out
    }
    run out.append(
      if rule.kind == CssRuleKind.Keyframes {
        b" { "
      } else {
        b" {"
      },
    )
    let declaration = run rule.style.cssText()
    let multiline = rule.first != NO_RULE || rule.kind == CssRuleKind.Media
      || rule.kind == CssRuleKind.Supports
      || rule.kind == CssRuleKind.LayerBlock
      || rule.kind == CssRuleKind.Keyframes
    if declaration.length() != 0 {
      run out.append(
        if multiline {
          b"\n  "
        } else {
          b" "
        },
      )
      run out.append(declaration.asSlice())
    }
    let mut child = rule.first
    while child != NO_RULE {
      let text = run self.cssText(child)
      if text.length() != 0 {
        run out.append(
          if rule.kind == CssRuleKind.Keyframes && child == rule.first {
            b"  "
          } else {
            b"\n  "
          },
        )
        run out.append(text.asSlice())
      }
      child = self.arena.asSlice()[child].next
    }
    if multiline && rule.kind != CssRuleKind.Keyframes && rule.first == NO_RULE
      && declaration.length() == 0 {
      run out.append(b"\n")
    }
    run out.append(
      if multiline {
        b"\n}"
      } else {
        b" }"
      },
    )
    return move out
  }
}

fn emptyRule(kind: CssRuleKind, parent: usize, sheet: usize) -> CssRule {
  return CssRule {
    kind: kind,
    parentRule: parent,
    parentStyleSheet: sheet,
    prelude: Bytes.make(),
    name: Bytes.make(),
    href: Bytes.make(),
    hasLayer: false,
    layerName: Bytes.make(),
    supportsText: Bytes.make(),
    namespacePrefix: Bytes.make(),
    namespaceUri: Bytes.make(),
    styleSheet: NO_SHEET,
    style: StyleDeclaration.makeFor(declarationContext(kind)),
    media: MediaList.make(),
    first: NO_RULE,
    next: NO_RULE,
  }
}

fn declarationContext(kind: CssRuleKind) -> Context {
  return match kind {
    CssRuleKind.FontFace => Context.FontFace
    CssRuleKind.Page => Context.Page
    CssRuleKind.Margin => Context.Margin
    _ => Context.Style
  }
}

effect fn lowercase(text: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  run out.reserve(text.length)
  let mut i: usize = 0
  while i < text.length {
    let byte = text[i]
    run out.append(
      &[
        if byte >= 65 && byte <= 90 {
          byte + 32
        } else {
          byte
        },
      ],
    )
    i = i + 1
  }
  return move out
}

effect fn keyframeText(buffer: &TokenBuffer, range: TokenRange) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = Bytes.make()
  let mut at = range.start
  let mut first = true
  while at < range.end {
    let value = match &buffer.tokens.asSlice()[at].kind {
      Kind.Percentage { value, integer } => value
      Kind.Ident { text } => if insensitive(buffer.text(text), b"from") {
        0.0
      } else {
        100.0
      }
      _ => {
        at = at + 1
        continue
      }
    }
    if !first {
      run out.append(b", ")
    }
    run serialization.appendNumber(&mut out, value)
    run out.append(b"%")
    first = false
    at = at + 1
  }
  return move out
}

fn grouping(kind: CssRuleKind) -> bool {
  return kind == CssRuleKind.Style || kind == CssRuleKind.Media || kind == CssRuleKind.Supports
    || kind == CssRuleKind.Page
    || kind == CssRuleKind.LayerBlock
    || kind == CssRuleKind.Keyframes
}

fn skipWhitespace(buffer: &TokenBuffer, start: usize, end: usize) -> usize {
  let mut at = start
  while at < end {
    if !match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => true
      _ => false
    } {
      break
    }
    at = at + 1
  }
  return at
}

fn trim(buffer: &TokenBuffer, range: TokenRange) -> TokenRange {
  let start = skipWhitespace(buffer, range.start, range.end)
  let mut end = range.end
  while end > start {
    if !match &buffer.tokens.asSlice()[end - 1].kind {
      Kind.Whitespace => true
      _ => false
    } {
      break
    }
    end = end - 1
  }
  return TokenRange { start: start, end: end }
}

fn componentEnd(buffer: &TokenBuffer, at: usize, end: usize) -> usize {
  let token = &buffer.tokens.asSlice()[at]
  if token.matching > at {
    return if token.matching < end {
      token.matching + 1
    } else {
      end
    }
  }
  return at + 1
}

fn oneRule(buffer: &TokenBuffer) -> bool {
  let range = trim(buffer, buffer.all())
  if range.start == range.end {
    return false
  }
  let isAt = match &buffer.tokens.asSlice()[range.start].kind {
    Kind.AtKeyword { name } => true
    _ => false
  }
  let mut at = range.start
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.OpenBrace => {
        return componentEnd(buffer, at, range.end) == range.end
      }
      Kind.Semicolon => {
        if isAt {
          return at + 1 == range.end
        }
      }
      _ => {}
    }
    at = componentEnd(buffer, at, range.end)
  }
  return isAt
}

effect fn appendText(buffer: &mut TokenBuffer, text: &[u8], limits: &Limits) -> Span
  ! CssError | OutOfMemoryError
  ? &mut Allocator {
  let start = buffer.data.length()
  if start > limits.maxStorageBytes || text.length > limits.maxStorageBytes - start {
    fail CssError { kind: CssErrorKind.StorageLimit, offset: start }
  }
  run buffer.data.append(text)
  return Span { start: start, end: buffer.data.length() }
}

fn urlValue(buffer: &TokenBuffer, at: usize, end: usize) -> Option<Span> {
  if at >= end {
    return Option<Span>.None
  }
  match &buffer.tokens.asSlice()[at].kind {
    Kind.String { text } => {
      return Option<Span>.some(text)
    }
    Kind.Url { text } => {
      return Option<Span>.some(text)
    }
    Kind.Function { name } => {
      if !insensitive(buffer.text(name), b"url") {
        return Option<Span>.None
      }
      let close = buffer.tokens.asSlice()[at].matching
      let stop = if close < end {
        close
      } else {
        end
      }
      let inner = trim(buffer, TokenRange { start: at + 1, end: stop })
      if inner.end != inner.start + 1 {
        return Option<Span>.None
      }
      match &buffer.tokens.asSlice()[inner.start].kind {
        Kind.String { text } => {
          return Option<Span>.some(text)
        }
        _ => {}
      }
    }
    _ => {}
  }
  return Option<Span>.None
}

fn reserved(text: &[u8]) -> bool {
  return insensitive(text, b"initial") || insensitive(text, b"inherit")
    || insensitive(text, b"unset")
    || insensitive(text, b"revert")
    || insensitive(text, b"revert-layer")
    || insensitive(text, b"default")
}

fn layerNames(buffer: &TokenBuffer, range: TokenRange, statement: bool) -> bool {
  if range.start == range.end {
    return !statement
  }
  let mut at = range.start
  let mut needName = true
  let mut separated = false
  let mut afterDot = false
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => {
        if afterDot {
          return false
        }
        separated = true
      }
      Kind.Ident { text } => {
        if !needName || reserved(buffer.text(text)) {
          return false
        }
        needName = false
        separated = false
        afterDot = false
      }
      Kind.Delim { scalar } => {
        if scalar != 46 || needName || separated {
          return false
        }
        needName = true
        afterDot = true
      }
      Kind.Comma => {
        if !statement || needName {
          return false
        }
        needName = true
        separated = false
      }
      _ => {
        return false
      }
    }
    at = at + 1
  }
  return !needName
}

fn pageSelectors(buffer: &TokenBuffer, range: TokenRange) -> bool {
  if range.start == range.end {
    return true
  }
  let mut at = range.start
  let mut arm = false
  let mut canName = true
  let mut separated = false
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => {
        if arm {
          separated = true
        }
      }
      Kind.Ident { text } => {
        if !canName || reserved(buffer.text(text)) || insensitive(buffer.text(text), b"auto") {
          return false
        }
        canName = false
        arm = true
      }
      Kind.Colon => {
        if separated {
          return false
        }
        at = at + 1
        if at >= range.end {
          return false
        }
        match &buffer.tokens.asSlice()[at].kind {
          Kind.Ident { text } => {
            if !insensitive(buffer.text(text), b"left") && !insensitive(buffer.text(text), b"right")
              && !insensitive(buffer.text(text), b"first")
              && !insensitive(buffer.text(text), b"blank") {
              return false
            }
          }
          _ => {
            return false
          }
        }
        canName = false
        arm = true
      }
      Kind.Comma => {
        if !arm {
          return false
        }
        arm = false
        canName = true
        separated = false
      }
      _ => {
        return false
      }
    }
    at = at + 1
  }
  return arm
}

fn keyframeSelectors(buffer: &TokenBuffer, range: TokenRange) -> bool {
  let mut at = range.start
  let mut need = true
  while at < range.end {
    match &buffer.tokens.asSlice()[at].kind {
      Kind.Whitespace => {}
      Kind.Ident { text } => {
        if !need
          || (!insensitive(buffer.text(text), b"from") && !insensitive(buffer.text(text), b"to")) {
          return false
        }
        need = false
      }
      Kind.Percentage { value, integer } => {
        if !need || value < 0.0 || value > 100.0 {
          return false
        }
        need = false
      }
      Kind.Comma => {
        if need {
          return false
        }
        need = true
      }
      _ => {
        return false
      }
    }
    at = at + 1
  }
  return !need
}

fn marginName(name: &[u8]) -> bool {
  return insensitive(name, b"top-left-corner") || insensitive(name, b"top-left")
    || insensitive(name, b"top-center")
    || insensitive(name, b"top-right")
    || insensitive(name, b"top-right-corner")
    || insensitive(name, b"bottom-left-corner")
    || insensitive(name, b"bottom-left")
    || insensitive(name, b"bottom-center")
    || insensitive(name, b"bottom-right")
    || insensitive(name, b"bottom-right-corner")
    || insensitive(name, b"left-top")
    || insensitive(name, b"left-middle")
    || insensitive(name, b"left-bottom")
    || insensitive(name, b"right-top")
    || insensitive(name, b"right-middle")
    || insensitive(name, b"right-bottom")
}
