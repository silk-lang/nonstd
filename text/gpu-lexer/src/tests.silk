//! CPU-side unit tests. tests/ compares both passes and both models with the original.
import source { scalar, lengthBucket, pairCode, KIND_WORD, KIND_NEWLINE }
import spans { Span, SyntaxClass, extend }
import tree_parts { TreeParts }
import lite_parts { LiteParts }
import tree { expandWeights }
import generated_models as models
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

test effect fn scalarsCountUtf16Units() -> () ! AssertionError<'static> {
  run Testing.expect(scalar(b"\xc3\xa9", 0).next == 2 && scalar(b"\xc3\xa9", 0).units == 1, "two-byte scalar")
  run Testing.expect(scalar(b"\xe6\x97\xa5", 0).next == 3, "three-byte scalar")
  run Testing.expect(scalar(b"\xf0\x9f\x98\x80", 0).units == 2, "astral scalar is a surrogate pair")
  run Testing.expect(scalar(b"\xed\xa0\x80", 0).next == 1, "an encoded surrogate is invalid")
  run Testing.expect(scalar(b"\xf0\x9f", 0).next == 1, "a truncated sequence consumes one byte")
  run Testing.expect(scalar(b"\xc0\xaf", 0).next == 1, "overlong encodings are invalid")
}

test effect fn lengthBuckets() -> () ! AssertionError<'static> {
  run Testing.expect(lengthBucket(1) == 0 && lengthBucket(2) == 1 && lengthBucket(3) == 1, "small lengths")
  run Testing.expect(lengthBucket(127) == 6 && lengthBucket(128) == 7, "bucket cap")
  run Testing.expect(pairCode(47, 47) == 1 && pairCode(60, 62) == 14 && pairCode(47, 48) == 0, "pair codes")
}

test effect fn spansMerge() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut result = List<Span>.make()
  run extend(&mut result, SyntaxClass.Keyword, 0, 5) |> Effect.provideMut<Allocator>(&mut allocator)
  run extend(&mut result, SyntaxClass.Keyword, 5, 6) |> Effect.provideMut<Allocator>(&mut allocator)
  run extend(&mut result, SyntaxClass.Plain, 6, 7) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(result.length() == 2 && result.get(0).end == 6 && result.get(1).start == 6, "adjacent equal spans merge")
  run Testing.expect(SyntaxClass.fromLabel(8) == SyntaxClass.Operator && SyntaxClass.fromLabel(9) == SyntaxClass.Plain, "labels")
}

test effect fn partsSplitSources() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut parts = TreeParts.make()
  run parts.append(b"let x\r\n") |> Effect.provideMut<Allocator>(&mut allocator)
  run parts.append(b"//") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parts.count() == 6, "word, space, word, CRLF, two symbols")
  let streams = parts.streams()
  run Testing.expect(streams[0] == 0 && streams[1] == 4 && streams[2] == 4 && streams[3] == 2, "streams")
  let features = parts.features()
  run Testing.expect((features[0] & 3) == KIND_WORD && (features[6] & 3) == KIND_NEWLINE, "kinds")
  // The second source starts a new stream: no pair code with the CRLF before it.
  run Testing.expect(((features[9] / 128) & 15) == 0 && ((features[11] / 128) & 15) == 1, "pairs stay within a source")
  let mut lite = LiteParts.make()
  run lite.append(b"a\n\n") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(lite.count() == 3 && lite.kinds()[2] == 2, "lite newlines are single parts")
}

test effect fn weightsExpand() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut weights = List<u8>.make()
  run expandWeights(&mut weights) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(weights.length() == models.treeWeights().length * 4, "one f32 per weight")
}
