//! Source text as the models see it. Both models were trained on UTF-16 code units: a non-ASCII
//! scalar is one or two word units, and every length and hash counts units. Input here is UTF-8,
//! so the scanners step over whole scalars and count the units each one stands for. Invalid
//! UTF-8 consumes one byte as U+FFFD (one unit); span offsets always refer to input bytes.
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32

/// Word characters are normalized to this code (`_`) when they are not ASCII.
pub const NON_ASCII: u32 = 95

pub const KIND_WORD: u32 = 0
pub const KIND_SPACE: u32 = 1
pub const KIND_NEWLINE: u32 = 2
pub const KIND_SYMBOL: u32 = 3

/// One non-ASCII scalar: where the next one starts and how many UTF-16 units it is.
pub struct Scalar {
  pub next: usize,
  pub units: u32,
}

impl Copy for Scalar {}

@inlineAlways
fn continuation(bytes: &[u8], at: usize) -> bool {
  return at < bytes.length && (bytes[at] & 0xc0) == 0x80
}

/// Steps over the scalar at `at`, whose lead byte is at least 0x80.
pub fn scalar(bytes: &[u8], at: usize) -> Scalar {
  let lead = bytes[at]
  if lead >= 0xc2 && lead <= 0xdf && continuation(bytes, at + 1) {
    return Scalar { next: at + 2, units: 1 }
  }
  if lead >= 0xe0 && lead <= 0xef && continuation(bytes, at + 1) && continuation(bytes, at + 2) {
    let second = bytes[at + 1]
    // No overlongs (E0 needs A0..BF) and no surrogates (ED needs 80..9F).
    if (lead != 0xe0 || second >= 0xa0) && (lead != 0xed || second < 0xa0) {
      return Scalar { next: at + 3, units: 1 }
    }
  }
  if lead >= 0xf0 && lead <= 0xf4 && continuation(bytes, at + 1) && continuation(bytes, at + 2) && continuation(bytes, at + 3) {
    let second = bytes[at + 1]
    // F0 needs 90..BF (no overlongs), F4 needs 80..8F (nothing past U+10FFFF).
    if (lead != 0xf0 || second >= 0x90) && (lead != 0xf4 || second < 0x90) {
      return Scalar { next: at + 4, units: 2 }
    }
  }
  return Scalar { next: at + 1, units: 1 }
}

/// The part kind an ASCII byte starts.
@inlineAlways
pub fn asciiKind(byte: u8) -> u32 {
  if byte == 10 || byte == 13 { return KIND_NEWLINE }
  if byte == 9 || byte == 11 || byte == 12 || byte == 32 { return KIND_SPACE }
  if wordFlags(u8.toU32(byte)) != 0 { return KIND_WORD }
  return KIND_SYMBOL
}

/// Lowercase 1, uppercase 2, digit 4, underscore 8 (non-ASCII is normalized to underscore).
@inlineAlways
pub fn wordFlags(code: u32) -> u32 {
  if code >= 97 && code <= 122 { return 1 }
  if code >= 65 && code <= 90 { return 2 }
  if code >= 48 && code <= 57 { return 4 }
  if code == 95 { return 8 }
  return 0
}

/// Codes 1 to 14 for boundaries between two parts that read as one token in common languages.
pub fn pairCode(left: u32, right: u32) -> u32 {
  match left {
    47 => { if right == 47 { return 1 } if right == 42 { return 2 } }   // // /*
    42 => { if right == 47 { return 3 } }                               // */
    45 => { if right == 45 { return 4 } if right == 62 { return 11 } }  // -- ->
    61 => { if right == 62 { return 5 } }                               // =>
    58 => { if right == 58 { return 6 } }                               // ::
    60 => { if right == 47 { return 7 } if right == 62 { return 14 } }  // </ <>
    123 => { if right == 123 { return 8 } }                             // {{
    36 => { if right == 123 { return 9 } }                             // ${
    125 => { if right == 125 { return 10 } }                            // }}
    63 => { if right == 63 { return 12 } if right == 46 { return 13 } } // ?? ?.
    _ => {}
  }
  return 0
}

/// A 1-31 bucket for any boundary next to a symbol; 0 means no neighbor.
@inlineAlways
pub fn symbolPairHash(left: u32, right: u32) -> u32 {
  return 1 + (u32.wrappingMultiply(left + 1, 131) ^ right) % 31
}

/// floor(log2(length)) for 1 to 127 units, 7 beyond.
@inlineAlways
pub fn lengthBucket(length: u32) -> u32 {
  if length > 127 { return 7 }
  return 31 - u32.leadingZeros(length)
}
