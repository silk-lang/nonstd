//! Display classes and the spans a parse returns.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// The nine visual classes both models predict, in their label order.
pub enum SyntaxClass {
  Plain,
  Comment,
  String,
  Number,
  Keyword,
  Type,
  Function,
  Constant,
  Operator,
}

impl SyntaxClass {
  /// The class for a model label; anything out of range is plain.
  pub fn fromLabel(label: u32) -> SyntaxClass {
    return match label {
      1 => SyntaxClass.Comment
      2 => SyntaxClass.String
      3 => SyntaxClass.Number
      4 => SyntaxClass.Keyword
      5 => SyntaxClass.Type
      6 => SyntaxClass.Function
      7 => SyntaxClass.Constant
      8 => SyntaxClass.Operator
      _ => SyntaxClass.Plain
    }
  }

  /// The class's model label, 0 to 8.
  pub fn label(self: Self) -> u32 {
    return match self {
      SyntaxClass.Plain => 0
      SyntaxClass.Comment => 1
      SyntaxClass.String => 2
      SyntaxClass.Number => 3
      SyntaxClass.Keyword => 4
      SyntaxClass.Type => 5
      SyntaxClass.Function => 6
      SyntaxClass.Constant => 7
      SyntaxClass.Operator => 8
    }
  }

  /// The lowercase name gpu-lexer uses for the class (`plain`, `comment`, ...).
  pub fn name(self: Self) -> string<'static> {
    return match self {
      SyntaxClass.Plain => "plain"
      SyntaxClass.Comment => "comment"
      SyntaxClass.String => "string"
      SyntaxClass.Number => "number"
      SyntaxClass.Keyword => "keyword"
      SyntaxClass.Type => "type"
      SyntaxClass.Function => "function"
      SyntaxClass.Constant => "constant"
      SyntaxClass.Operator => "operator"
    }
  }
}

/// A run of source bytes `start .. end` (half-open, UTF-8 byte offsets) with one class.
/// The spans of a parse are non-overlapping, in order, and cover the whole source.
pub struct Span {
  pub kind: SyntaxClass,
  pub start: usize,
  pub end: usize,
}

impl Copy for Span {}

/// Appends a span, or extends the previous one when it has the same class and ends at `start`.
@inlineAlways
pub effect fn extend(spans: &mut List<Span>, kind: SyntaxClass, start: usize, end: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let count = spans.length()
  if count > 0 {
    let last = spans.get(count - 1)
    if last.kind == kind && last.end == start {
      spans.set(count - 1, Span { kind: kind, start: last.start, end: end })
      return
    }
  }
  run spans.append(Span { kind: kind, start: start, end: end })
}
