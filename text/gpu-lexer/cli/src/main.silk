//! Prints the spans of a file, one `class start end` line each (UTF-8 byte offsets).
//! Usage: text-gpu-lexer-cli FILE [lite]
import gpu_lexer.lexer { Lexer, LiteLexer, Options }
import gpu_lexer.spans { Span }
import webgpu.runtime { GpuError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.host_input { NativeHostInput }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format }

effect fn program() -> i32 ! GpuError | OutOfMemoryError | FileError | HostInputError | WriterError ? &mut Allocator | &mut Writer | &mut HostInput {
  let count = run HostInput.argumentCount()
  if count < 2 || count > 3 {
    run Writer.writeString("Usage: text-gpu-lexer-cli FILE [lite]\n")
    return 2
  }
  let name = match move run HostInput.argument(1) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => Bytes.make()
  }
  let cwd = run NativeHostInput.workingDirectory()
  let root = run Path.fromBytes(Bytes.asSlice(&cwd))
  let path = run root.joinBytes(Bytes.asSlice(&name))
  let mut files = run OsFileSystem.make("/")
  let contents = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let source = Bytes.asSlice(&contents)
  let mut spans = List<Span>.make()
  if count == 3 {
    let mut lexer = run LiteLexer.open()
    spans = run lexer.parse(source)
  } else {
    let mut lexer = run Lexer.open(Options.default())
    spans = run lexer.parse(source)
  }
  let mut index: usize = 0
  while index < spans.length() {
    let span = spans.get(index)
    run Format.format("{kind} {start} {end}\n", &.{ kind: span.kind.name(), start: span.start, end: span.end })
    index = index + 1
  }
  return 0
}

effect fn gpuFailed(error: GpuError) -> i32 ! never {
  StderrWriter.print("WebGPU error {}: {:?}\n", &(error.code, error.message.asSlice()))
  return 1
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("text-gpu-lexer-cli: unable to read the file or write the spans\n", &())
  return 1
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut writer = StdoutWriter.make()
  return run Effect.catchAll(Effect.catch<GpuError>(program(), gpuFailed), failed)
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut writer)
}
