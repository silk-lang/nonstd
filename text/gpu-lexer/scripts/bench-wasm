#!/usr/bin/env python3
"""Builds wasm/ for wasm32 and times it next to the original in Chromium (wasm/bench.mjs).
Usage: scripts/bench-wasm <gpu-lexer checkout at 4f36e39>. Needs Playwright's Chromium."""
import subprocess
import sys
from _gpu import LEXER, build

if len(sys.argv) != 2:
    raise SystemExit(__doc__)
binary = build(LEXER / "wasm", target="wasm32-unknown-unknown", release=True)
subprocess.run(["node", str(LEXER / "wasm/bench.mjs"), str(binary), sys.argv[1]], cwd=LEXER, check=True, timeout=1800)
