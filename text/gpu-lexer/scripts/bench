#!/usr/bin/env python3
"""Builds bench/ in release mode and runs it on the native device. Prints one JSON object per
workload and step (stderr); scripts/bench-original.mjs prints the same for gpu-lexer itself."""
import subprocess
from _gpu import LEXER, build

binary = build(LEXER / "bench", release=True)
subprocess.run([str(binary)], cwd=LEXER, check=True, timeout=900)
