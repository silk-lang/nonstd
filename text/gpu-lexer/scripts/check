#!/usr/bin/env python3
"""PR gate for text/gpu-lexer: generated modules are fresh, packages check, and (unless
--skip-native) both CPU passes and both models' spans match the original's on pinned Dawn."""
import argparse
import os
import shlex
import shutil
import subprocess
import sys
from _gpu import LEXER, build, command_path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-native", action="store_true", help="omit the Dawn build and fixture comparison")
args = parser.parse_args()


def run(command, **options):
    print("+ " + shlex.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=LEXER, check=True, **options)


if shutil.which("node"):
    run(["node", LEXER / "generator/generate.mjs", "--check"])
else:
    print("node not found: skipping the generated-module freshness check", flush=True)
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
stdlib = compiler_bin.parent / "lib/silk/stdlib"
for package in (".", "tests", "bench", "cli"):
    run([compiler_bin / "silkc", "check", "--manifest-path", LEXER / package / "silk.toml", "--stdlib", stdlib])
# The browser build: the package must also check for wasm32 (navigator.gpu).
for package in (".", "wasm"):
    run([compiler_bin / "silkc", "check", "--manifest-path", LEXER / package / "silk.toml", "--stdlib", stdlib, "--target", "wasm32-unknown-unknown"])
run([compiler_bin / "silkc", "test", "--manifest-path", LEXER / "silk.toml", "--root", LEXER / "src/tests.silk", "--stdlib", stdlib])
if not args.skip_native:
    binary = build(LEXER / "tests")
    run([binary], timeout=600)
