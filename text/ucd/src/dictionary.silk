//! Optional dictionary providers for complex-context line breaking.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub interface DictionarySegmenter {
  /// Append sorted UTF-8 byte boundaries, including 0 and text.length once.
  /// The caller clears output. Providers need not allocate except to grow output.
  effect fn breaks(self: &Self, text: &[u8], output: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator
}
