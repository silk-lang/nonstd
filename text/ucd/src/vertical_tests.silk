import vertical { Orientation, OrientationRun }
import vertical
import lib as Ucd
import lib { VerticalOrientation }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }

effect fn expectRuns(text: string, ends: &[usize], values: &[Orientation]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut runs = List<OrientationRun>.make()
  run vertical.orientations(bytes, &mut runs)
  let actual = List<OrientationRun>.asSlice(&runs)
  run Testing.expect(
    actual.length == ends.length && ends.length == values.length,
    "orientation run count",
  )
  let mut start: usize = 0
  let mut i: usize = 0
  while i < actual.length {
    run Testing.expect(
      actual[i].start == start && actual[i].end == ends[i],
      "orientation byte range",
    )
    run Testing.expect(actual[i].orientation == values[i], "cluster fallback orientation")
    run Testing.expect(actual[i].start < actual[i].end, "no empty orientation run")
    if i > 0 {
      run Testing.expect(
        actual[i - 1].orientation != actual[i].orientation,
        "maximal orientation runs",
      )
    }
    start = actual[i].end
    i = i + 1
  }
  run Testing.expect(start == bytes.length, "orientation covers input")
}

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // These are four distinct source values, not two values renamed in a table.
  run Testing.expect(Ucd.verticalOrientation(0x41) == VerticalOrientation.R, "Latin R")
  run Testing.expect(Ucd.verticalOrientation(0x6f22) == VerticalOrientation.U, "Han U")
  run Testing.expect(
    Ucd.verticalOrientation(0x3001) == VerticalOrientation.Tu,
    "ideographic comma Tu",
  )
  run Testing.expect(
    Ucd.verticalOrientation(0x30fc) == VerticalOrientation.Tr,
    "prolonged sound mark Tr",
  )
  run expectRuns("", &[], &[])
  run expectRuns("abc", &[3], &[Orientation.Rotated])
  run expectRuns("漢字、。", &[12], &[Orientation.Upright])
  run expectRuns(
    "A漢、ーB",
    &[1, 7, 11],
    &[Orientation.Rotated, Orientation.Upright, Orientation.Rotated],
  )
  run expectRuns(
    "〈漢〉",
    &[3, 6, 9],
    &[Orientation.Rotated, Orientation.Upright, Orientation.Rotated],
  )

  // Inverse property values on marks must not split their grapheme cluster.
  run expectRuns("漢́A゙", &[5, 9], &[Orientation.Upright, Orientation.Rotated])
  run expectRuns("ÁB", &[4], &[Orientation.Rotated])
  run expectRuns(
    "a👩‍💻b",
    &[1, 12, 13],
    &[Orientation.Rotated, Orientation.Upright, Orientation.Rotated],
  )
  run expectRuns("🇯🇵漢", &[11], &[Orientation.Upright])

  // Enclosing marks override the orientation of the entire cluster, including
  // preceding non-enclosing marks and variation selectors (UAX #50 §3.2.1).
  run expectRuns("A⃝B", &[4, 5], &[Orientation.Upright, Orientation.Rotated])
  run expectRuns("Á⃝B", &[6, 7], &[Orientation.Upright, Orientation.Rotated])
  run expectRuns("1️⃣2", &[7, 8], &[Orientation.Upright, Orientation.Rotated])
  run expectRuns("́a", &[3], &[Orientation.Rotated])
  let mut runs = List<OrientationRun>.make()
  run List<OrientationRun>.append(
    &mut runs,
    OrientationRun { start: 99, end: 100, orientation: Orientation.Upright },
  )
  run vertical.orientations(b"a", &mut runs)
  run Testing.expect(
    List<OrientationRun>.length(&runs) == 2,
    "orientation appends without clearing caller output",
  )
  run vertical.orientations(b"", &mut runs)
  run Testing.expect(List<OrientationRun>.length(&runs) == 2, "empty input appends no positions")
  List<OrientationRun>.clear(&mut runs)
  run vertical.orientations(b"\xffa\xc0", &mut runs)
  let bad = List<OrientationRun>.asSlice(&runs)
  run Testing.expect(
    bad.length == 3 && bad[0].end == 1 && bad[1].end == 2 && bad[2].end == 3,
    "invalid UTF-8 replacement byte ranges",
  )
  run Testing.expect(
    bad[0].orientation == Orientation.Upright && bad[1].orientation == Orientation.Rotated
      && bad[2].orientation == Orientation.Upright,
    "replacement glyph orientation",
  )
}

test effect fn mixedVerticalOrientation() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
