  MidLetter,
  MidNum,
  Newline,
  Numeric,
  Regional_Indicator,
  Single_Quote,
  WSegSpace,
  Other,
  ZWJ,
}

pub fn wordBreak(cp: u32) -> WordBreak with Intrinsic.inlineAlways() {
  return wordBreakValue(Data.wordBreak(cp))
}

// Package-internal: converts a packed table value.
pub fn wordBreakValue(value: u32) -> WordBreak with Intrinsic.inlineAlways() {
  return match value {
    0 => WordBreak.CR
    1 => WordBreak.Double_Quote
    2 => WordBreak.E_Base
    3 => WordBreak.E_Base_GAZ
    4 => WordBreak.E_Modifier
    5 => WordBreak.ExtendNumLet
    6 => WordBreak.Extend
    7 => WordBreak.Format
    8 => WordBreak.Glue_After_Zwj
    9 => WordBreak.Hebrew_Letter
    10 => WordBreak.Katakana
    11 => WordBreak.ALetter
    12 => WordBreak.LF
    13 => WordBreak.MidNumLet
    14 => WordBreak.MidLetter
    15 => WordBreak.MidNum
    16 => WordBreak.Newline
    17 => WordBreak.Numeric
    18 => WordBreak.Regional_Indicator
    19 => WordBreak.Single_Quote
    20 => WordBreak.WSegSpace
    22 => WordBreak.ZWJ
    _ => WordBreak.Other
  }
}

