//! Allocation-free scalar decoding for byte-oriented text algorithms.
//! Invalid UTF-8 consumes one byte and yields U+FFFD; offsets always refer to input bytes.
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32

pub struct Decoded {
  pub cp: u32,
  pub next: usize,
}

impl Copy for Decoded {}

/// Decodes the scalar at `at`. ASCII stays inline; longer sequences take one call.
@inlineAlways
pub fn decode(bytes: &[u8], at: usize) -> Decoded {
  if at < bytes.length && bytes[at] < 128 {
    return Decoded { cp: u8.toU32(bytes[at]), next: at + 1 }
  }
  return decodeMultibyte(bytes, at)
}

@inlineAlways
fn isContinuation(byte: u8) -> bool {
  return (byte & 0xc0) == 0x80
}

@inlineAlways
fn payload(byte: u8, mask: u8, shift: u32) -> u32 {
  return u32.shiftLeft(u8.toU32(byte & mask), shift)
}

// RFC 3629 well-formed sequences only: no overlongs, surrogates or values past U+10FFFF.
// Checking the decoded value is equivalent to RFC 3629's second-byte ranges.
@inlineAlways
fn decodeMultibyte(bytes: &[u8], at: usize) -> Decoded {
  if at >= bytes.length {
    return Decoded { cp: 0xfffd, next: bytes.length }
  }

  // Indexing a view by constants lets the length checks below cover every access.
  let rest = Slice.view<u8>(bytes, at, bytes.length - at)
  let lead = rest[0]
  if lead >= 0xe0 {
    if lead < 0xf0 {
      if rest.length >= 3 && isContinuation(rest[1]) && isContinuation(rest[2]) {
        let cp = payload(lead, 0x0f, 12) | payload(rest[1], 0x3f, 6) | payload(rest[2], 0x3f, 0)
        if cp >= 0x800 && (cp < 0xd800 || cp > 0xdfff) {
          return Decoded { cp: cp, next: at + 3 }
        }
      }
    } else if lead <= 0xf4 {
      if rest.length >= 4 && isContinuation(rest[1]) && isContinuation(rest[2])
        && isContinuation(rest[3]) {
        let cp = payload(lead, 0x07, 18) | payload(rest[1], 0x3f, 12) | payload(rest[2], 0x3f, 6)
          | payload(rest[3], 0x3f, 0)
        if cp >= 0x10000 && cp <= 0x10ffff {
          return Decoded { cp: cp, next: at + 4 }
        }
      }
    }
  } else if lead >= 0xc2 {
    if rest.length >= 2 && isContinuation(rest[1]) {
      return Decoded { cp: payload(lead, 0x1f, 6) | payload(rest[1], 0x3f, 0), next: at + 2 }
    }
  }
  return Decoded { cp: 0xfffd, next: at + 1 }
}
