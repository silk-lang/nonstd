import utf8
import test_support as Scan
import silk.testing.testing { Testing, AssertionError }
import silk.core.option { Option }
import silk.text.utf8_decoder { Utf8Decoder, Utf8Step }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

test effect fn scalarByteOffsets() -> ()
  ! AssertionError<'static> {
  let bytes = b"A\xc3\xa9\xe0\xa4\x95\xf0\x9f\x98\x80"
  let ascii = utf8.decode(bytes, 0)
  let latin = utf8.decode(bytes, ascii.next)
  let indic = utf8.decode(bytes, latin.next)
  let emoji = utf8.decode(bytes, indic.next)
  run Testing.expect(ascii.cp == 0x41 && ascii.next == 1, "ASCII byte range")
  run Testing.expect(latin.cp == 0xe9 && latin.next == 3, "two-byte scalar range")
  run Testing.expect(indic.cp == 0x915 && indic.next == 6, "three-byte scalar range")
  run Testing.expect(emoji.cp == 0x1f600 && emoji.next == 10, "four-byte scalar range")
}

test effect fn invalidUtf8PreservesByteProgress() -> ()
  ! AssertionError<'static> {
  let bad = b"\xc0\xaf\xed\xa0\x80\xf4\x90\x80\x80\xe2\x82"
  let mut at: usize = 0
  while at < bad.length {
    let decoded = utf8.decode(bad, at)
    run Testing.expect(
      decoded.cp == 0xfffd && decoded.next == at + 1,
      "one replacement per invalid byte",
    )
    at = decoded.next
  }
  let eof = utf8.decode(bad, bad.length)
  run Testing.expect(eof.next == bad.length, "EOF does not advance")
  let mixed = utf8.decode(b"\xe2A", 0)
  let following = utf8.decode(b"\xe2A", mixed.next)
  run Testing.expect(
    following.cp == 0x41 && following.next == 2,
    "invalid prefix preserves following ASCII",
  )
}

test effect fn conformanceIntegerBoundaries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    (Scan.number(b"FFFFFFFF", 16) |> Option<u32>.unwrapOr(0)) == 4294967295,
    "maximum hexadecimal value",
  )
  run Testing.expect(Scan.number(b"4294967296", 10).isNone(), "decimal overflow rejected")
  run Testing.expect(Scan.number(b"D800x", 16).isNone(), "trailing nonhex digit rejected")
}

// The previous stdlib-decoder implementation, kept as a differential oracle.
fn referenceDecode(bytes: &[u8], at: usize) -> utf8.Decoded {
  if at >= bytes.length {
    return utf8.Decoded { cp: 0xfffd, next: bytes.length }
  }
  if bytes[at] < 128 {
    return utf8.Decoded { cp: u8.toU32(bytes[at]), next: at + 1 }
  }
  let mut decoder = Utf8Decoder.make()
  let mut cursor = at
  while cursor < bytes.length && cursor - at < 4 {
    let step = Utf8Decoder.step(&mut decoder, bytes[cursor], cursor)
    cursor = cursor + 1
    match &step {
      Utf8Step.Scalar { value } => {
        return utf8.Decoded { cp: value, next: cursor }
      }
      Utf8Step.Invalid { offset: _ } => {
        return utf8.Decoded { cp: 0xfffd, next: at + 1 }
      }
      Utf8Step.NeedMore => {}
    }
  }
  return utf8.Decoded { cp: 0xfffd, next: at + 1 }
}

test effect fn decoderMatchesStdlibDecoder() -> ()
  ! AssertionError<'static> {
  let tails: [u8; 4] = [0x80, 0xbf, 0x41, 0xc3]
  let mut buffer: [u8; 4] = [0; 4]
  let mut mismatches: usize = 0
  let mut lead: usize = 0
  while lead < 256 {
    let mut second: usize = 0
    while second < 256 {
      let mut third: usize = 0
      while third < 4 {
        let mut fourth: usize = 0
        while fourth < 4 {
          buffer[0] = usize.wrappingToU8(lead)
          buffer[1] = usize.wrappingToU8(second)
          buffer[2] = tails[third]
          buffer[3] = tails[fourth]
          let mut length: usize = 1
          while length <= 4 {
            let slice = Slice.view<u8>(&buffer, 0, length)
            let actual = utf8.decode(slice, 0)
            let expected = referenceDecode(slice, 0)
            if actual.cp != expected.cp || actual.next != expected.next {
              mismatches = mismatches + 1
            }
            length = length + 1
          }
          fourth = fourth + 1
        }
        third = third + 1
      }
      second = second + 1
    }
    lead = lead + 1
  }
  run Testing.expect(mismatches == 0, "decoder agrees with the stdlib UTF-8 decoder")
}
