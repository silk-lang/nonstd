import utf8_tests
import bidi_tests
import segmentation_tests
import line_break_tests
import itemization_tests
import vertical_tests
import lib as unicode
import lib { Decomposed, Script, GeneralCategory, JoiningType, JoiningGroup }
import lib {
  BidiClass,
  BidiPairedBracketType,
  LineBreak,
  EastAsianWidth,
  GraphemeBreak,
  WordBreak,
  SentenceBreak,
  IndicConjunctBreak,
  VerticalOrientation,
}
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

test effect fn categoriesAndScripts() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.generalCategory(0x41) == GeneralCategory.Lu, "uppercase category")
  run Testing.expect(
    unicode.generalCategory(0x301) == GeneralCategory.Mn,
    "nonspacing mark category",
  )
  run Testing.expect(unicode.script(0x41).value == 0x4c61746e, "Latin script")
  run Testing.expect(unicode.script(0x18e00).value == 0x4a757263, "Unicode 18 Jurchen")
  run Testing.expect(unicode.script(0x125a8).value == 0x5063756e, "Unicode 18 Proto-Cuneiform")
  run Testing.expect(unicode.script(0x3d000).value == 0x5365616c, "Unicode 18 Seal")
  run Testing.expect(unicode.isMark(0x301) && !unicode.isMark(0x41), "mark predicate")
}

test effect fn canonicalCombiningClasses() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.combiningClass(0x41).number() == 0, "starter class")
  run Testing.expect(unicode.combiningClass(0x301).number() == 230, "above class")
  run Testing.expect(unicode.combiningClass(0xc55).number() == 84, "unmodified Telugu class")
  run Testing.expect(unicode.combiningClass(0xc56).number() == 91, "unmodified Telugu length class")
}

test effect fn mirroringAndVerticalForms() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.mirror(40) == 41 && unicode.mirror(41) == 40, "signed mirror deltas")
  run Testing.expect(unicode.mirror(65) == 65, "unmirrored identity")
  run Testing.expect(unicode.vertical(0x2013) == 0xfe32, "vertical en dash")
  run Testing.expect(unicode.vertical(0x3001) == 0xfe11, "vertical ideographic comma")
  run Testing.expect(unicode.vertical(65) == 65, "vertical identity")
}

test effect fn selectorsIgnorablesAndEmoji() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    !unicode.isVariationSelector(0xfdff) && unicode.isVariationSelector(0xfe00)
      && unicode.isVariationSelector(0xfe0f)
      && !unicode.isVariationSelector(0xfe10)
      && !unicode.isVariationSelector(0xe00ff)
      && unicode.isVariationSelector(0xe0100)
      && unicode.isVariationSelector(0xe01ef)
      && !unicode.isVariationSelector(0xe01f0),
    "variation selector boundaries",
  )
  run Testing.expect(unicode.isDefaultIgnorable(0xad), "soft hyphen ignorable")
  run Testing.expect(unicode.isDefaultIgnorable(0x200d), "joiner ignorable")
  run Testing.expect(!unicode.isDefaultIgnorable(0x41), "letter is visible")
  run Testing.expect(unicode.isExtendedPictographic(0x1f600), "pictographic emoji")
  run Testing.expect(!unicode.isExtendedPictographic(0x41), "letter is not pictographic")
}

test effect fn arabicAndSyriacJoining() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.joiningType(0x41) == JoiningType.U, "nonjoining Latin")
  run Testing.expect(unicode.joiningType(0x627) == JoiningType.R, "right joining alef")
  run Testing.expect(unicode.joiningType(0x628) == JoiningType.D, "dual joining beh")
  run Testing.expect(unicode.joiningType(0x301) == JoiningType.T, "transparent mark")
  run Testing.expect(unicode.joiningType(0x200c) == JoiningType.U, "nonjoining ZWNJ override")
  run Testing.expect(unicode.joiningType(0x200d) == JoiningType.C, "join-causing ZWJ")
  run Testing.expect(unicode.joiningGroup(0x710) == JoiningGroup.Alaph, "Syriac ALAPH group")
  run Testing.expect(unicode.joiningGroup(0x715) == JoiningGroup.Dalath_Rish, "Syriac DALATH group")
  run Testing.expect(unicode.joiningGroup(0x72a) == JoiningGroup.Dalath_Rish, "Syriac RISH group")
}

test effect fn rawCanonicalComposition() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.composeRaw(0x41, 0x301) == 0xc1, "canonical pair")
  run Testing.expect(unicode.composeRaw(0x41, 0x41) == 0, "absent pair sentinel")
  run Testing.expect(unicode.composeRaw(0x41, 0x315) == 0, "noncomposing mark")
  run Testing.expect(unicode.composesAsSecond(0x301), "composition second membership")
  run Testing.expect(!unicode.composesAsSecond(0x41), "nonmember second")
  let pair = unicode.decomposeRaw(0xc1)
  run Testing.expect(pair.first == 0x41 && pair.second == 0x301, "pair decomposition")
  let singleton = unicode.decomposeRaw(0x212b)
  run Testing.expect(
    singleton.first == 0xc5 && singleton.second == 0,
    "raw singleton, not recursive",
  )
  let planeTwo = unicode.decomposeRaw(0x2f803)
  run Testing.expect(
    planeTwo.first == 0x20122 && planeTwo.second == 0,
    "plane-two singleton palette",
  )
  let absent = unicode.decomposeRaw(0x41)
  run Testing.expect(absent.first == 0 && absent.second == 0, "absent decomposition sentinel")
}

test effect fn hangulCompositionBoundaries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.composeRaw(0x1100, 0x1161) == 0xac00, "first Hangul LV")
  run Testing.expect(unicode.composeRaw(0x1112, 0x1175) == 0xd788, "last Hangul LV")
  run Testing.expect(unicode.composeRaw(0xac00, 0x11a8) == 0xac01, "first Hangul LVT")
  run Testing.expect(unicode.composeRaw(0xd788, 0x11c2) == 0xd7a3, "last Hangul LVT")
  run Testing.expect(unicode.composeRaw(0xac00, 0x11a7) == 0, "trailing-Jamo base excluded")
  run Testing.expect(unicode.composeRaw(0xac00, 0x11c3) == 0, "trailing-Jamo upper bound")
  run Testing.expect(unicode.composeRaw(0xac01, 0x11a8) == 0, "LVT does not accept trailing Jamo")
  run Testing.expect(unicode.composeRaw(0x1113, 0x1161) == 0, "leading-Jamo upper bound")
  run Testing.expect(unicode.composeRaw(0x1100, 0x1176) == 0, "vowel-Jamo upper bound")
  let lv = unicode.decomposeRaw(0xac00)
  let lvt = unicode.decomposeRaw(0xd7a3)
  let after = unicode.decomposeRaw(0xd7a4)
  run Testing.expect(lv.first == 0x1100 && lv.second == 0x1161, "LV decomposition")
  run Testing.expect(lvt.first == 0xd788 && lvt.second == 0x11c2, "LVT raw decomposition")
  run Testing.expect(after.first == 0 && after.second == 0, "Hangul upper bound")
}

test effect fn optionalCompositionQueries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    (unicode.compose(0x41, 0x30a) |> Option<u32>.unwrapOr(0)) == 0xc5,
    "optional pair",
  )
  run Testing.expect(
    match move unicode.decompose(0xc5) {
      Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => first == 0x41
        && second == 0x30a
      _ => false
    },
    "optional decomposition pair",
  )
  run Testing.expect(
    match move unicode.decompose(0x212b) {
      Option<Decomposed>.Some { value: Decomposed.Singleton { codepoint } } => codepoint == 0xc5
      _ => false
    },
    "optional singleton",
  )
  run Testing.expect(
    match move unicode.decompose(0x41) {
      Option<Decomposed>.None => true
      _ => false
    },
    "optional absent decomposition",
  )
}

test effect fn isoScriptNormalization() -> ()
  ! AssertionError<'static> {
  let unknown = Script { value: 0x5a7a7a7a }
  run Testing.expect(
    (Script.parse("lAtN") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "case normalization",
  )
  run Testing.expect(
    (Script.parse("Hans") |> Option<Script>.unwrapOr(unknown)).value == 0x48616e69,
    "Han alias",
  )
  run Testing.expect(
    (Script.parse("Latf") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "Latin alias",
  )
  run Testing.expect(
    (Script.parse("Syre") |> Option<Script>.unwrapOr(unknown)).value == 0x53797263,
    "Syriac alias",
  )
  run Testing.expect(
    (Script.parse("Latn-extra") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "four-byte parsing",
  )
  run Testing.expect(
    (Script.parse("") |> Option<Script>.unwrapOr(unknown)).value == unknown.value,
    "short input retains unknown behavior",
  )
  run Testing.expect(
    match move Script.fromIso15924Tag(0) {
      Option<Script>.None => true
      _ => false
    },
    "zero tag is absent",
  )
  run Testing.expect(
    (Script.fromIso15924Tag(0xffffffff) |> Option<Script>.unwrapOr(unknown)).value == unknown.value,
    "malformed tag is unknown",
  )
}

test effect fn invalidCodepointsAndLookupBoundaries() -> ()
  ! AssertionError<'static> {
  let invalid: [u32; 4] = [0x110000, 0x110001, 0x80000000, 0xffffffff]
  let mut i: usize = 0
  while i < invalid.length {
    let cp = invalid[i]
    run Testing.expect(
      unicode.generalCategory(cp) == GeneralCategory.Cn,
      "invalid category is unassigned",
    )
    run Testing.expect(unicode.combiningClass(cp).number() == 0, "invalid combining class")
    run Testing.expect(unicode.script(cp).value == 0x5a7a7a7a, "invalid script is unknown")
    run Testing.expect(
      unicode.mirror(cp) == cp && unicode.vertical(cp) == cp,
      "invalid mapping identity",
    )
    run Testing.expect(unicode.joiningType(cp) == JoiningType.U, "invalid joining is nonjoining")
    run Testing.expect(
      !unicode.isMark(cp) && !unicode.isVariationSelector(cp),
      "invalid mark and selector",
    )
    run Testing.expect(
      !unicode.isDefaultIgnorable(cp) && !unicode.isExtendedPictographic(cp),
      "invalid boolean properties",
    )
    run Testing.expect(!unicode.composesAsSecond(cp), "invalid composition membership")
    run Testing.expect(
      unicode.composeRaw(cp, 0x301) == 0 && unicode.composeRaw(0x41, cp) == 0,
      "invalid composition inputs",
    )
    let parts = unicode.decomposeRaw(cp)
    run Testing.expect(parts.first == 0 && parts.second == 0, "invalid decomposition")
    run Testing.expect(
      (unicode.compose(cp, cp) |> Option<u32>.unwrapOr(0)) == 0,
      "invalid optional composition",
    )
    run Testing.expect(
      match move unicode.decompose(cp) {
        Option<Decomposed>.None => true
        _ => false
      },
      "invalid optional decomposition",
    )
    i = i + 1
  }
  let edges: [u32; 23] = [
    0,
    0xd7ff,
    0xd800,
    0xdfff,
    0xe000,
    121616,
    121617,
    121618,
    125258,
    125259,
    125260,
    131069,
    131070,
    131071,
    195101,
    195102,
    195103,
    917999,
    918000,
    918001,
    1114109,
    1114110,
    1114111,
  ]
  i = 0
  while i < edges.length {
    let cp = edges[i]
    run Testing.expect(
      unicode.mirror(cp) <= 0x10ffff && unicode.vertical(cp) <= 0x10ffff,
      "mapping boundary",
    )
    run Testing.expect(unicode.script(cp).value != 0, "script boundary")
    run Testing.expect(unicode.combiningClass(cp).number() <= 254, "class boundary")
    let parts = unicode.decomposeRaw(cp)
    run Testing.expect(
      parts.first <= 0x10ffff && parts.second <= 0x10ffff,
      "decomposition boundary",
    )
    let pictographic = unicode.isExtendedPictographic(cp)
    run Testing.expect(cp < 131070 || !pictographic, "emoji upper bound")
    i = i + 1
  }
}

test effect fn typedUnicodeProperties() -> ()
  ! AssertionError<'static> {
  run Testing.expect(unicode.bidiClass(0x05d0) == BidiClass.R, "Hebrew bidi class")
  run Testing.expect(unicode.bidiClass(0x0608) == BidiClass.AL, "Arabic bidi class")
  run Testing.expect(unicode.bidiClass(0x0590) == BidiClass.R, "unassigned Hebrew missing default")
  run Testing.expect(
    unicode.bidiPairedBracketType(0x28) == BidiPairedBracketType.Open,
    "open bracket",
  )
  run Testing.expect(
    unicode.bidiPairedBracketType(0x29) == BidiPairedBracketType.Close,
    "close bracket",
  )
  run Testing.expect(unicode.bidiPairedBracket(0x28) == 0x29, "bracket mate")
  run Testing.expect(unicode.bidiPairedBracket(0x41) == 0x41, "nonbracket identity")
  run Testing.expect(unicode.lineBreak(0x0a) == LineBreak.LF, "line feed class")
  run Testing.expect(unicode.eastAsianWidth(0x3000) == EastAsianWidth.F, "fullwidth space")
  run Testing.expect(unicode.graphemeBreak(0x301) == GraphemeBreak.Extend, "grapheme extend")
  run Testing.expect(unicode.wordBreak(0x05d0) == WordBreak.Hebrew_Letter, "Hebrew word class")
  run Testing.expect(
    unicode.sentenceBreak(0x2e) == SentenceBreak.ATerm,
    "sentence abbreviation terminator",
  )
  run Testing.expect(
    unicode.indicConjunctBreak(0x094d) == IndicConjunctBreak.Linker,
    "Indic linker",
  )
  run Testing.expect(unicode.verticalOrientation(0x41) == VerticalOrientation.R, "rotated Latin")
  run Testing.expect(unicode.verticalOrientation(0x4e00) == VerticalOrientation.U, "upright Han")
  run Testing.expect(
    unicode.isEmoji(0x1f600) && unicode.isEmojiPresentation(0x1f600),
    "emoji presentation",
  )
  run Testing.expect(
    unicode.isEmojiModifier(0x1f3fb) && unicode.isEmojiComponent(0x1f3fb),
    "emoji modifier",
  )
  run Testing.expect(unicode.isEmojiModifierBase(0x1f44d), "emoji modifier base")
  run Testing.expect(unicode.isRegionalIndicator(0x1f1e6), "regional indicator")
  run Testing.expect(
    !unicode.isRegionalIndicator(0x1f1e5) && !unicode.isRegionalIndicator(0x1f200),
    "regional indicator boundaries",
  )
  run Testing.expect(
    unicode.isDefaultIgnorable(0x115f) && unicode.isDefaultIgnorable(0x1bca0),
    "normative ignorables, not shaping exclusions",
  )
  run Testing.expect(
    unicode.isVariationSelector(0x180b) && unicode.isVariationSelector(0x180f),
    "Mongolian selectors",
  )
  run Testing.expect(
    !unicode.isVariationSelector(0x180e),
    "Mongolian vowel separator is not selector",
  )
}

test effect fn scriptExtensionSets() -> ()
  ! AssertionError<'static> {
  let latin = unicode.scriptExtensions(0x41)
  run Testing.expect(
    latin.length() == 1 && latin.contains(Script { value: 0x4c61746e }),
    "default singleton",
  )
  run Testing.expect(
    (latin.get(0) |> Option<Script>.unwrapOr(Script { value: 0 })).value == 0x4c61746e,
    "indexed singleton",
  )
  run Testing.expect(
    match move latin.get(1) {
      Option<Script>.None => true
      _ => false
    },
    "set upper bound",
  )
  let prolonged = unicode.scriptExtensions(0x30fc)
  run Testing.expect(
    prolonged.contains(Script { value: 0x48697261 })
      && prolonged.contains(Script { value: 0x4b616e61 }),
    "Hiragana and Katakana extensions",
  )
  run Testing.expect(!prolonged.contains(Script { value: 0x4c61746e }), "unrelated script absent")
  let invalid = unicode.scriptExtensions(0xffffffff)
  run Testing.expect(
    invalid.length() == 1 && invalid.contains(Script { value: 0x5a7a7a7a }),
    "invalid default singleton",
  )
}
