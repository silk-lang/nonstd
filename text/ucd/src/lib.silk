//! Unicode 18.0.0 properties and raw canonical composition from pinned UCD files.
import generated_unicode as Data
pub import generated_properties {
  GeneralCategory,
  CanonicalCombiningClass,
  BidiClass,
  BidiPairedBracketType,
  JoiningType,
  JoiningGroup,
  LineBreak,
  EastAsianWidth,
  GraphemeBreak,
  WordBreak,
  SentenceBreak,
  IndicConjunctBreak,
  VerticalOrientation,
  generalCategory,
  combiningClass,
  bidiClass,
  bidiPairedBracketType,
  bidiPairedBracket,
  joiningType,
  joiningGroup,
  lineBreak,
  eastAsianWidth,
  graphemeBreak,
  wordBreak,
  sentenceBreak,
  indicConjunctBreak,
  verticalOrientation,
  isEmoji,
  isEmojiPresentation,
  isEmojiModifier,
  isEmojiModifierBase,
  isEmojiComponent,
  isRegionalIndicator,
  isExtendedPictographic,
  isVariationSelector,
  isDefaultIgnorable,
  mirror,
  vertical,
  composesAsSecond,
}
pub import script { Script }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.num.u32

pub fn script(cp: u32) -> Script with Intrinsic.inlineAlways() {
  return Script { value: Data.script(cp) }
}

/// A borrowed, immutable set of ISO 15924 scripts backed by packed static bytes.
pub struct ScriptSet {
  start: usize,
  end: usize,
}

impl Copy for ScriptSet {}

impl ScriptSet {
  pub fn length(self: &Self) -> usize with Intrinsic.inlineAlways() {
    return self.end - self.start
  }

  pub fn get(self: &Self, index: usize) -> Option<Script> {
    if index >= self.length() {
      return Option<Script>.None
    }
    return Option<Script>.some(
      Script { value: Data.be32(Data.scriptSetMembers(), (self.start + index) * 4) },
    )
  }

  pub fn contains(self: &Self, script: Script) -> bool {
    let mut index = self.start
    while index < self.end {
      if Data.be32(Data.scriptSetMembers(), index * 4) == script.value {
        return true
      }
      index = index + 1
    }
    return false
  }
}

pub fn scriptExtensions(cp: u32) -> ScriptSet with Intrinsic.inlineAlways() {
  let index = u32.toUsize(Data.scriptExtensions(cp)) * 4
  return ScriptSet {
    start: u32.toUsize(Data.be32(Data.scriptSetOffsets(), index)),
    end: u32.toUsize(Data.be32(Data.scriptSetOffsets(), index + 4)),
  }
}

pub fn isMark(cp: u32) -> bool with Intrinsic.inlineAlways() {
  let category = generalCategory(cp)
  return category == GeneralCategory.Mn || category == GeneralCategory.Mc
    || category == GeneralCategory.Me
}

pub struct Decomposition {
  pub first: u32,
  pub second: u32,
}

impl Copy for Decomposition {}

pub fn decomposeRaw(cp: u32) -> Decomposition {
  if cp >= 0xac00 && cp < 0xac00 + 11172 {
    let n = cp - 0xac00
    if n % 28 != 0 {
      return Decomposition { first: cp - n % 28, second: 0x11a7 + n % 28 }
    }
    return Decomposition { first: 0x1100 + n / 588, second: 0x1161 + (n % 588) / 28 }
  }
  let index = u32.toUsize(Data.decomposition(cp)) * 8
  return Decomposition {
    first: Data.be32(Data.decompositions(), index),
    second: Data.be32(Data.decompositions(), index + 4),
  }
}

pub fn composeRaw(a: u32, b: u32) -> u32 {
  if a >= 0x1100 && a < 0x1113 && b >= 0x1161 && b < 0x1176 {
    return 0xac00 + (a - 0x1100) * 588 + (b - 0x1161) * 28
  }
  if a >= 0xac00 && a <= 0xd788 && (a - 0xac00) % 28 == 0 && b > 0x11a7 && b < 0x11c3 {
    return a + b - 0x11a7
  }
  if !composesAsSecond(b) {
    return 0
  }
  let data = Data.compositions()
  let mut lo: usize = 0
  let mut hi = data.length / 12
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let first = Data.be32(data, mid * 12)
    let second = Data.be32(data, mid * 12 + 4)
    if first < a || (first == a && second < b) {
      lo = mid + 1
    } else if first == a && second == b {
      return Data.be32(data, mid * 12 + 8)
    } else {
      hi = mid
    }
  }
  return 0
}

pub union Decomposed {
  Singleton { pub codepoint: u32 },
  Pair { pub first: u32, pub second: u32 },
}

impl Copy for Decomposed {}

pub fn compose(first: u32, second: u32) -> Option<u32> {
  let result = composeRaw(first, second)
  if result == 0 {
    return Option<u32>.None
  }
  return Option<u32>.some(result)
}

pub fn decompose(cp: u32) -> Option<Decomposed> {
  let result = decomposeRaw(cp)
  if result.first == 0 {
    return Option<Decomposed>.None
  }
  if result.second == 0 {
    return Option<Decomposed>.some(Decomposed.Singleton { codepoint: result.first })
  }
  return Option<Decomposed>.some(Decomposed.Pair { first: result.first, second: result.second })
}
