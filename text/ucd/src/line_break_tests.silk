import line_break
import line_break {
  LineOptions,
  LineBreakMode,
  WordBreakMode,
  Hyphens,
  LineLanguage,
  BreakOpportunity,
  BreakKind
}
import dictionary { DictionarySegmenter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }

effect fn positions(text: string, options: LineOptions, expected: &[usize]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut output = List<BreakOpportunity>.make()
  run line_break.breaks(bytes, options, &mut output)
  run expectPositions(&output, bytes.length, expected)
}

effect fn expectPositions(output: &List<BreakOpportunity>, length: usize, expected: &[usize]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(output.length() == expected.length, "line opportunity count")
  let mut i: usize = 0
  while i < expected.length {
    let result = output.get(i)
    if expected[i] == length {
      run Testing.expect(result.offset == length, "EOF offset")
      run Testing.expect(result.kind == BreakKind.Mandatory, "EOF is mandatory")
    } else {
      run Testing.expect(result.offset == expected[i], "original UTF8 opportunity")
    }
    i = i + 1
  }
}

effect fn standardCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let options = LineOptions.make()
  run positions("", options, &[0])
  run positions("hello world", options, &[6, 11])
  run positions("a\r\nb\n c", options, &[3, 5, 6, 7])
  run positions("(12.34)%x", options, &[9])
  run positions("a\u{200b}  b", options, &[6, 7])
  run positions("a\u{2060}b", options, &[5])
  run positions("a\u{00a0}b", options, &[4])
  run positions("a\u{0308}b", options, &[4])
  run positions("\u{1f1e6}\u{0308}\u{1f1e7}\u{1f1e8}\u{1f1e9}", options, &[10, 18])
  run positions("\u{1f469}\u{200d}\u{1f4bb}x", options, &[11, 12])
  run positions("\u{1fffd}\u{1f3fb}", options, &[8])

  // Unicode 18 LB12a: BA no longer permits a break before GL.
  run positions("–\u{00a0}x", options, &[6])
  run positions("x‐\u{00a0}y", options, &[4, 7])

  // Numeric lookahead includes the optional initial decimal separator.
  run positions("$(.5)", options, &[5])
  run positions("x .5", options, &[2, 4])

  // The quotation context must survive intervening spaces and combining marks.
  run positions("“  a”, b", options, &[11, 12])
  let mut output = List<BreakOpportunity>.make()
  run line_break.breaks(b"a\r\nb", options, &mut output)
  run Testing.expect(output.get(0).kind == BreakKind.Mandatory, "CRLF forced break")
  output.clear()
  run line_break.breaks(b"a\xff b", options, &mut output)
  run expectPositions(&output, 4, &[3, 4])
}

effect fn cssCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut options = LineOptions.make()
  options.lineBreak = LineBreakMode.Strict
  options.language = LineLanguage.Japanese
  run positions("小ぁ", options, &[6])
  run positions("あ〜い", options, &[6, 9])
  options.lineBreak = LineBreakMode.Normal
  run positions("小ぁ", options, &[6])
  run positions("あ〜い", options, &[3, 6, 9])
  run positions("中‐文", options, &[6, 9])
  run positions("時々", options, &[6])
  run positions("……", options, &[6])
  run positions("中・文", options, &[6, 9])
  run positions("中％", options, &[6])
  run positions("＄中", options, &[6])
  options.lineBreak = LineBreakMode.Loose
  run positions("小ぁ", options, &[3, 6])
  run positions("時々", options, &[3, 6])
  run positions("中‐文", options, &[3, 6, 9])
  run positions("中–文", options, &[3, 6, 9])
  run positions("……", options, &[3, 6])
  run positions("中・文", options, &[3, 6, 9])
  run positions("中％", options, &[3, 6])
  run positions("＄中", options, &[3, 6])
  options.language = LineLanguage.Chinese
  run positions("中！文", options, &[3, 6, 9])
  options.language = LineLanguage.Default
  run positions("中！文", options, &[6, 9])
  run positions("中％", options, &[6])
  options.lineBreak = LineBreakMode.Auto
  options.language = LineLanguage.Japanese
  run positions("あ〜い", options, &[3, 6, 9])
  options = LineOptions.make()
  options.wordBreak = WordBreakMode.BreakAll
  run positions("ab12", options, &[1, 2, 3, 4])
  run positions("a\u{0301}b", options, &[3, 4])
  run positions("a,b", options, &[2, 3])
  run positions("小ぁ", options, &[6])
  run positions("時々", options, &[6])
  options.wordBreak = WordBreakMode.KeepAll
  run positions("中a文", options, &[7])
  run positions("한국", options, &[6])
  options.lineBreak = LineBreakMode.Loose
  run positions("時々", options, &[6])
  run positions("中\u{200b}文", options, &[6, 9])
  options.lineBreak = LineBreakMode.Anywhere
  run positions("a\u{2060}b", options, &[1, 4, 5])
  run positions("a\u{00a0}b", options, &[1, 3, 4])
  run positions("a\u{0301}b", options, &[3, 4])
  run positions("\u{1f469}\u{200d}\u{1f4bb}x", options, &[11, 12])
  run positions("a\r\nb", options, &[1, 3, 4])
  run positions("(a)", options, &[1, 2, 3])
}

effect fn hyphenCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut options = LineOptions.make()
  let mut output = List<BreakOpportunity>.make()
  let bytes = String.utf8Bytes("ab\u{00ad}cd")
  run line_break.breaks(bytes, options, &mut output)
  run expectPositions(&output, bytes.length, &[4, 6])
  run Testing.expect(output.get(0).kind == BreakKind.Hyphenated, "manual soft hyphen")
  options.hyphens = Hyphens.None
  run positions("ab\u{00ad}cd", options, &[6])

  // Explicit visible hyphens are not automatic hyphenation.
  run positions("ab-cd", options, &[3, 5])
  options.hyphens = Hyphens.Manual
  options.wordBreak = WordBreakMode.BreakAll
  output.clear()
  run line_break.breaks(bytes, options, &mut output)
  let mut i: usize = 0
  while i < output.length() {
    run Testing.expect(output.get(i).kind != BreakKind.Hyphenated, "break-all does not hyphenate")
    i = i + 1
  }
  options.lineBreak = LineBreakMode.Anywhere
  output.clear()
  run line_break.breaks(bytes, options, &mut output)
  i = 0
  while i < output.length() {
    run Testing.expect(output.get(i).kind != BreakKind.Hyphenated, "anywhere does not hyphenate")
    i = i + 1
  }
}

// Deliberately over-eager provider verifies that the UAX14 consumer, not the
// dictionary, enforces scalar/combining/joiner/punctuation safety and uniqueness.
struct EveryByte {}

impl DictionarySegmenter for EveryByte {
  effect fn breaks(self: &Self, text: &[u8], output: &mut List<usize>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while true {
      run output.append(i)
      run output.append(i)
      if i == text.length {
        break
      }
      i = i + 1
    }
  }
}

effect fn dictionaryCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let dictionary = EveryByte {}
  let mut options = LineOptions.make()
  let mut output = List<BreakOpportunity>.make()
  let plain = String.utf8Bytes("กขค")
  run line_break.breaks(plain, options, &mut output)
  run expectPositions(&output, plain.length, &[9])
  output.clear()
  run line_break.withDictionary(plain, options, &dictionary, &mut output)
  run expectPositions(&output, plain.length, &[3, 6, 9])
  output.clear()
  let marks = String.utf8Bytes("กัข")
  run line_break.withDictionary(marks, options, &dictionary, &mut output)
  run expectPositions(&output, marks.length, &[6, 9])
  output.clear()
  let joiner = String.utf8Bytes("ก\u{200d}ข")
  run line_break.withDictionary(joiner, options, &dictionary, &mut output)
  run expectPositions(&output, joiner.length, &[9])
  output.clear()
  let punctuation = String.utf8Bytes("กข)ab")
  run line_break.withDictionary(punctuation, options, &dictionary, &mut output)
  run expectPositions(&output, punctuation.length, &[3, 9])
  output.clear()
  options.wordBreak = WordBreakMode.KeepAll
  run line_break.withDictionary(plain, options, &dictionary, &mut output)
  run expectPositions(&output, plain.length, &[3, 6, 9])
}

test effect fn standardLineBreaking() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run standardCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn cssLineBreakingPrecedence() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cssCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn manualAndDisabledHyphens() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hyphenCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn dictionaryBoundaryConstraints() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run dictionaryCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
