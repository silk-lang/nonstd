//! Font-independent ISO 15924 script values and Harfrust tag normalization.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.text.string { String }
import silk.num.u8

pub struct Script {
  pub value: u32,
}

impl Copy for Script {}

impl Script {
  pub fn fromIso15924Tag(value: u32) -> Option<Self> {
    if value == 0 {
      return Option<Self>.None
    }
    let mut result = (value & 0xdfdfdfdf) | 0x00202020
    if (result & 0xe0e0e0e0) != 0x40606060 {
      result = 0x5a7a7a7a
    }
    result = match result {
      0x4172616e => 0x41726162
      0x43797273 => 0x4379726c
      0x47656f6b => 0x47656f72
      0x48616e73 => 0x48616e69
      0x48616e74 => 0x48616e69
      0x4a616d6f => 0x48616e67
      0x4c617466 => 0x4c61746e
      0x4c617467 => 0x4c61746e
      0x53797265 => 0x53797263
      0x5379726a => 0x53797263
      0x5379726e => 0x53797263
      _ => result
    }
    return Option<Self>.some(Self { value: result })
  }

  pub fn parse(text: string) -> Option<Self> {
    let bytes = String.utf8Bytes(text)
    let mut value: u32 = 0
    let mut i: usize = 0
    while i < 4 {
      value = value * 256
      if i < bytes.length {
        value = value + u8.toU32(bytes[i])
      } else {
        value = value + 32
      }
      i = i + 1
    }
    return Script.fromIso15924Tag(value)
  }
}
