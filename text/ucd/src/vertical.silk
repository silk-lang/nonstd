//! UAX #50 mixed vertical text, expressed as maximal UTF-8 byte runs.
//!
//! U and Tu fall back to an upright code-chart glyph; R and Tr fall back to a
//! glyph rotated 90 degrees clockwise. Tu/Tr both request a transformed vertical
//! glyph when one is available: their fallback classification is NOT permission
//! to skip vertical shaping, nor to rotate an already substituted vertical glyph.
//! A font/shaping consumer still queries verticalOrientation(cp) to distinguish
//! U from Tu and R from Tr, and applies its vertical alternates before fallback.
//! This font-independent API cannot decide whether a font has those alternates.
//!
//! Per UAX #50 §3.2.1, orientation belongs to an extended grapheme cluster:
//! use its first scalar, except any enclosing mark (General_Category=Me) makes
//! the entire cluster upright. Combining marks and emoji sequences never split.
//! Reference: https://www.unicode.org/reports/tr50/#grapheme_clusters
import lib as Ucd
import lib { GeneralCategory, VerticalOrientation }
import segmentation { GraphemeCursor }
import utf8
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }

pub enum Orientation {
  Upright,
  Rotated,
}

pub struct OrientationRun {
  pub start: usize,
  pub end: usize,
  pub orientation: Orientation,
}

impl Copy for OrientationRun {}

fn fallback(cp: u32) -> Orientation {
  let property = Ucd.verticalOrientation(cp)
  return match &property {
    VerticalOrientation.U => Orientation.Upright
    VerticalOrientation.Tu => Orientation.Upright
    VerticalOrientation.R => Orientation.Rotated
    VerticalOrientation.Tr => Orientation.Rotated
  }
}

/// Appends nonempty, contiguous runs of code-chart fallback orientation.
/// The caller clears output before a new input; empty input appends nothing.
/// Positions always refer to the original UTF-8 bytes, including malformed input.
pub effect fn orientations(text: &[u8], output: &mut List<OrientationRun>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  let mut start: usize = 0
  let mut previous = Orientation.Upright
  let mut graphemes = GraphemeCursor.make()
  while at < text.length {
    let end = GraphemeCursor.next(&mut graphemes, text)
    let first = utf8.decode(text, at)
    let mut orientation = fallback(first.cp)
    let mut cp = first.cp
    let mut next = first.next
    while true {
      if Ucd.generalCategory(cp) == GeneralCategory.Me {
        orientation = Orientation.Upright
        break
      }
      if next >= end {
        break
      }
      let decoded = utf8.decode(text, next)
      cp = decoded.cp
      next = decoded.next
    }
    if at > 0 && previous != orientation {
      run List<OrientationRun>.append(
        &mut output,
        OrientationRun { start: start, end: at, orientation: previous },
      )
      start = at
    }
    previous = orientation
    at = end
  }
  if start < text.length {
    run List<OrientationRun>.append(
      &mut output,
      OrientationRun { start: start, end: text.length, orientation: previous },
    )
  }
}
