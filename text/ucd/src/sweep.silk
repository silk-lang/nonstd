//! Full code-point-domain no-trap checks, separate from the focused test root.
import lib as unicode
import lib { Decomposed, GeneralCategory, BidiPairedBracketType }
import lib {
  BidiClass,
  JoiningType,
  JoiningGroup,
  LineBreak,
  EastAsianWidth,
  GraphemeBreak,
  WordBreak,
  SentenceBreak,
  IndicConjunctBreak,
  VerticalOrientation,
}
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u8

test effect fn fullUnicodeRangeNoTrap() -> ()
  ! AssertionError<'static> {
  let mut cp: u32 = 0
  let mut classes: u32 = 0
  let mut scripts: u32 = 0
  let mut selectors: u32 = 0
  let mut ignorables: u32 = 0
  let mut pictographs: u32 = 0
  let mut seconds: u32 = 0
  let mut properties: [u32; 10] = [0; 10]
  while cp <= 0x10ffff {
    let category = unicode.generalCategory(cp)
    run Testing.expect(
      unicode.isMark(cp)
        == (category == GeneralCategory.Mc || category == GeneralCategory.Me
          || category == GeneralCategory.Mn),
      "mark classification",
    )
    classes = classes + u8.toU32(unicode.combiningClass(cp).number())
    scripts = scripts | unicode.script(cp).value
    run Testing.expect(unicode.mirror(cp) <= 0x10ffff, "mirror result range")
    run Testing.expect(unicode.vertical(cp) <= 0x10ffff, "vertical result range")
    let extensions = unicode.scriptExtensions(cp)
    run Testing.expect(extensions.length() > 0, "script extensions are nonempty")
    run Testing.expect(unicode.bidiPairedBracket(cp) <= 0x10ffff, "bracket result range")
    if unicode.bidiPairedBracketType(cp) != BidiPairedBracketType.None {
      run Testing.expect(
        unicode.bidiPairedBracket(unicode.bidiPairedBracket(cp)) == cp,
        "paired brackets are symmetric",
      )
    }
    if unicode.bidiClass(cp) == BidiClass.AL {
      properties[0] = properties[0] + 1
    }
    if unicode.joiningType(cp) == JoiningType.D {
      properties[1] = properties[1] + 1
    }
    if unicode.joiningGroup(cp) == JoiningGroup.Alaph {
      properties[2] = properties[2] + 1
    }
    if unicode.lineBreak(cp) == LineBreak.BK {
      properties[3] = properties[3] + 1
    }
    if unicode.eastAsianWidth(cp) == EastAsianWidth.W {
      properties[4] = properties[4] + 1
    }
    if unicode.graphemeBreak(cp) == GraphemeBreak.Extend {
      properties[5] = properties[5] + 1
    }
    if unicode.wordBreak(cp) == WordBreak.Hebrew_Letter {
      properties[6] = properties[6] + 1
    }
    if unicode.sentenceBreak(cp) == SentenceBreak.ATerm {
      properties[7] = properties[7] + 1
    }
    if unicode.indicConjunctBreak(cp) == IndicConjunctBreak.Linker {
      properties[8] = properties[8] + 1
    }
    if unicode.verticalOrientation(cp) == VerticalOrientation.Tu {
      properties[9] = properties[9] + 1
    }
    run Testing.expect(
      !unicode.isEmojiPresentation(cp) || unicode.isEmoji(cp),
      "emoji presentation is emoji",
    )
    run Testing.expect(
      !unicode.isEmojiModifier(cp) || unicode.isEmojiComponent(cp),
      "emoji modifier is component",
    )
    run Testing.expect(
      !unicode.isEmojiModifierBase(cp) || unicode.isEmoji(cp),
      "emoji base is emoji",
    )
    run Testing.expect(
      !unicode.isRegionalIndicator(cp) || unicode.isEmojiComponent(cp),
      "regional indicator is emoji component",
    )
    if unicode.isVariationSelector(cp) {
      selectors = selectors + 1
    }
    if unicode.isDefaultIgnorable(cp) {
      ignorables = ignorables + 1
    }
    if unicode.isExtendedPictographic(cp) {
      pictographs = pictographs + 1
    }
    if unicode.composesAsSecond(cp) {
      seconds = seconds + 1
    }
    let parts = unicode.decomposeRaw(cp)
    run Testing.expect(
      parts.first <= 0x10ffff && parts.second <= 0x10ffff,
      "raw decomposition range",
    )
    let same = match move unicode.decompose(cp) {
      Option<Decomposed>.None => parts.first == 0 && parts.second == 0
      Option<Decomposed>.Some { value: Decomposed.Singleton { codepoint } } => parts.first
        == codepoint
        && parts.second == 0
      Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => parts.first == first
        && parts.second == second
    }
    run Testing.expect(same, "optional and raw decompositions agree")
    let asFirst = unicode.composeRaw(cp, 0x301)
    let asSecond = unicode.composeRaw(0x41, cp)
    run Testing.expect(asFirst <= 0x10ffff && asSecond <= 0x10ffff, "composition input domains")
    run Testing.expect(
      (unicode.compose(cp, 0x301) |> Option<u32>.unwrapOr(0)) == asFirst,
      "optional and raw compositions agree",
    )
    cp = cp + 1
  }
  let mut property: usize = 0
  while property < properties.length {
    run Testing.expect(properties[property] > 0, "typed property table was traversed")
    property = property + 1
  }
  run Testing.expect(classes > 0 && scripts != 0, "class and script tables were traversed")
  run Testing.expect(selectors == 260, "standard and Mongolian selector ranges were traversed")
  run Testing.expect(
    ignorables > 0 && pictographs > 0 && seconds > 0,
    "boolean tables were traversed",
  )
}
