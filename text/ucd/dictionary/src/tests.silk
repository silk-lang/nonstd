import lib { IcuDictionary }
import generated_reference as Reference
import ucd.dictionary { DictionarySegmenter }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u8
import silk.num.u32
import silk.text.format { Format }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer, WriterError }

fn offset(data: &[u8], at: usize) -> usize {
  return u32.toUsize(
    u32.shiftLeft(u8.toU32(data[at]), 24) | u32.shiftLeft(u8.toU32(data[at + 1]), 16)
      | u32.shiftLeft(u8.toU32(data[at + 2]), 8)
      | u8.toU32(data[at + 3]),
  )
}

effect fn expectBoundaries(text: &[u8], expected: &[usize]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let dictionary = IcuDictionary.make()
  let mut actual = List<usize>.make()
  run DictionarySegmenter.breaks(&dictionary, text, &mut actual)
  run Testing.expect(List<usize>.length(&actual) == expected.length, "dictionary boundary count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(List<usize>.get(&actual, i) == expected[i], "dictionary UTF-8 boundary")
    i = i + 1
  }
}

// All 51 curated cases run, including ICU's ambiguity, spelling-error,
// combining-mark, suffix and multiword regressions for all four languages.
// Expectations are extracted from checksum-pinned upstream rbbitst.txt,
// not generated by this implementation or by a longest-match approximation.
effect fn referenceCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError | WriterError
  ? &mut Allocator {
  let dictionary = IcuDictionary.make()
  let mut actual = List<usize>.make()
  let mut caseIndex: usize = 0
  let mut failures: usize = 0
  while caseIndex < Reference.count() {
    List<usize>.clear(&mut actual)
    let text = Reference.text(caseIndex)
    let expected = Reference.offsets(caseIndex)
    run DictionarySegmenter.breaks(&dictionary, text, &mut actual)
    let mut same = List<usize>.length(&actual) == expected.length / 4
    let mut i: usize = 0
    while same && i < expected.length / 4 {
      same = List<usize>.get(&actual, i) == offset(expected, i * 4)
      i = i + 1
    }
    if !same {
      failures = failures + 1
      let mut writer = StderrWriter.make()
      run Format.format(
        "ICU fixture {index} ({source}): expected",
        &.{ index: caseIndex, source: Reference.source(caseIndex) },
      )
        |> Effect.provideMut<Writer>(&mut writer)
      i = 0
      while i < expected.length / 4 {
        run Format.format(" {offset}", &.{ offset: offset(expected, i * 4) })
          |> Effect.provideMut<Writer>(&mut writer)
        i = i + 1
      }
      run Format.format("; actual", &.{}) |> Effect.provideMut<Writer>(&mut writer)
      i = 0
      while i < List<usize>.length(&actual) {
        run Format.format(" {offset}", &.{ offset: List<usize>.get(&actual, i) })
          |> Effect.provideMut<Writer>(&mut writer)
        i = i + 1
      }
      run Format.format("\n", &.{}) |> Effect.provideMut<Writer>(&mut writer)
    }
    caseIndex = caseIndex + 1
  }
  run Testing.expect(failures == 0, "ICU reference failures (all fixtures executed; see stderr)")
}

effect fn opaqueCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run expectBoundaries(b"", &[0])
  run expectBoundaries(b"Latin punctuation, 123", &[0, 22])

  // CJK dictionaries are intentionally not part of this optional package.
  run expectBoundaries(b"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e", &[0, 9])
  run expectBoundaries(b"A\xff\xc0\xaf\xed\xa0\x80", &[0, 7])
}

effect fn mixedCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // A + ใชมั้ย + !. The two Thai words are upstream ICU-10296's case.
  run expectBoundaries(
    b"A\xe0\xb9\x83\xe0\xb8\x8a\xe0\xb8\xa1\xe0\xb8\xb1\xe0\xb9\x89\xe0\xb8\xa2!",
    &[0, 1, 7, 19, 20],
  )

  // Three-scalar Thai runs retain ICU's minimum-span behavior.
  run expectBoundaries(b"A\xe0\xb9\x84\xe0\xb8\x97\xe0\xb8\xa2!", &[0, 1, 10, 11])

  // The dictionary set ends before Myanmar's AL symbols, but the enclosing
  // alphabetic word does not. Exercise all four symbols and both directions,
  // rather than special-casing U+104D from upstream reference fixture 49.
  run expectBoundaries(b"\xe1\x80\x91\xe1\x80\xac\xe1\x80\xb8\xe1\x81\x8c", &[0, 12])
  run expectBoundaries(b"\xe1\x80\x91\xe1\x80\xac\xe1\x80\xb8\xe1\x81\x8d", &[0, 12])
  run expectBoundaries(b"\xe1\x80\x91\xe1\x80\xac\xe1\x80\xb8\xe1\x81\x8e", &[0, 12])
  run expectBoundaries(b"\xe1\x80\x91\xe1\x80\xac\xe1\x80\xb8\xe1\x81\x8f", &[0, 12])
  run expectBoundaries(b"\xe1\x81\x8d\xe1\x80\x91\xe1\x80\xac\xe1\x80\xb8", &[0, 12])
}

effect fn fallbackCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  // Repeated obsolete Thai letters do not occur in the ICU word list. The
  // fallback scanner keeps the unknown run rather than inventing syllables.
  run expectBoundaries(
    b"\xe0\xb8\x83\xe0\xb8\x85\xe0\xb8\x83\xe0\xb8\x85\xe0\xb8\x83\xe0\xb8\x85",
    &[0, 18],
  )

  // Leading combining marks cannot cause zero-length fallback iterations.
  run expectBoundaries(b"\xe0\xb8\xb1\xe0\xb8\xb1\xe0\xb8\xb1\xe0\xb8\xb1\xe0\xb8\xb1", &[0, 15])
}

test effect fn pinnedIcuReferenceCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run referenceCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn emptyAndNonDictionarySpans() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run opaqueCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn mixedInputPreservesOriginalByteOffsets() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run mixedCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unknownRunsAndLeadingMarksMakeProgress() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallbackCases() |> Effect.provideMut<Allocator>(&mut allocator)
}
