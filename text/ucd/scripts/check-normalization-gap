#!/usr/bin/env python3
"""Characterize the pinned Silk stdlib/Unicode 18 normalization gap.

This is a report, not a version-parity gate. It runs actual stdlib NFC/NFD,
checks all ten canonical invariants per NormalizationTest row, and compares
raw non-Hangul decomposition/composition plus CCC over the full code-point
range. Algorithmic Hangul is exercised by the normalization file.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
from unicode_probe import build_probe
import subprocess
import urllib.request

ROOT = Path(__file__).resolve().parents[3]
UNICODE17_SHA256 = "2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c"


def unicode17_classes():
    path = ROOT / "build/ucd/17.0.0/UnicodeData.txt"
    data = path.read_bytes() if path.exists() else urllib.request.urlopen(
        "https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt", timeout=60
    ).read()
    if hashlib.sha256(data).hexdigest() != UNICODE17_SHA256:
        raise ValueError("Unicode 17 comparison source SHA256 mismatch")
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    return {int(fields[0], 16): int(fields[3])
            for row in data.decode("utf-8").splitlines() if (fields := row.split(";"))}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--silk", default=os.environ.get("SILK", "silk"))
    parser.add_argument("--report", type=Path, default=ROOT / "build/normalization-gap.json")
    args = parser.parse_args()
    subprocess.run([str(ROOT / "text/ucd/scripts/fetch-unicode")], cwd=ROOT, check=True)
    executable = build_probe("normalization_gap", args.silk)
    result = subprocess.check_output([str(executable)], cwd=ROOT, text=True)
    report = {"ucd_unicode": "18.0.0", "ccc": [], "decomposition": [],
              "composition": [], "normalization": []}
    for row in result.splitlines():
        fields = row.split("\t")
        kind, values = fields[0], fields[1:]
        if kind == "version":
            report["stdlib_unicode"] = values[0]
        elif kind == "ccc":
            cp, before, after = map(int, values)
            report["ccc"].append({"code_point": f"U+{cp:04X}", "stdlib": before, "ucd": after})
        elif kind == "decomp":
            cp, a, b, c, d = map(int, values)
            report["decomposition"].append({"code_point": f"U+{cp:04X}", "stdlib": [a, b], "ucd": [c, d]})
        elif kind == "compose":
            first, second, before, after = map(int, values)
            report["composition"].append({"pair": [first, second], "stdlib": before, "ucd": after})
        elif kind == "normalization":
            line, column, flags = map(int, values)
            report["normalization"].append({"line": line, "column": column,
                                            "nfc_differs": bool(flags & 1), "nfd_differs": bool(flags & 2)})
        elif kind == "summary":
            report["counts"] = dict(zip(("rows", "ccc", "decomposition", "composition", "nfc", "nfd"),
                                         map(int, values), strict=True))
        else:
            raise ValueError(f"unexpected normalization probe output: {row}")
    if "stdlib_unicode" not in report or "counts" not in report:
        raise ValueError("incomplete normalization probe output")
    previous = unicode17_classes()
    for difference in report["ccc"]:
        expected = previous.get(int(difference["code_point"][2:], 16), 0)
        difference["unicode17"] = expected
        difference["stdlib_data_error"] = (
            report["stdlib_unicode"] == "17.0.0" and expected != difference["stdlib"]
        )
    report["counts"]["stdlib_data_errors"] = sum(row["stdlib_data_error"] for row in report["ccc"])
    report["counts"]["unicode17_to18_ccc_changes"] = sum(
        row["unicode17"] != row["ucd"] for row in report["ccc"]
    )
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(json.dumps(report, indent=2) + "\n")
    print(f"stdlib Unicode {report['stdlib_unicode']} versus UCD {report['ucd_unicode']}")
    print(json.dumps(report["counts"], sort_keys=True))
    for difference in report["ccc"]:
        print(f"CCC {difference['code_point']}: {difference['stdlib']} -> {difference['ucd']}")
    print(f"Full report: {args.report}")


if __name__ == "__main__":
    main()
