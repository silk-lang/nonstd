#!/usr/bin/env python3
"""Write the Wayland protocol glue the Linux bridge compiles (silk generate runs this).

Each protocol in PROTOCOLS becomes native/linux/protocols/<name>-client-protocol.h and
<name>-protocol.c, from wayland-scanner and the system's wayland-protocols. The files are
committed, so building needs neither; rerun `silk generate` after changing the list.
Needs wayland-scanner and wayland-protocols (Debian and Ubuntu: libwayland-dev wayland-protocols).
"""
from pathlib import Path
import shutil
import subprocess
import sys

PACKAGE = Path(__file__).resolve().parent.parent
OUTPUT = PACKAGE / "native/linux/protocols"
PROTOCOLS = [
    "stable/xdg-shell/xdg-shell.xml",
    "unstable/xdg-decoration/xdg-decoration-unstable-v1.xml",
    "unstable/text-input/text-input-unstable-v3.xml",
    "staging/fractional-scale/fractional-scale-v1.xml",
    "stable/viewporter/viewporter.xml",
    "staging/cursor-shape/cursor-shape-v1.xml",
    # cursor-shape refers to the tablet tool; newer wayland-protocols moved it to stable.
    ("stable/tablet/tablet-v2.xml", "unstable/tablet/tablet-unstable-v2.xml"),
]


def protocols_dir():
    try:
        return Path(subprocess.check_output(["pkg-config", "--variable=pkgdatadir", "wayland-protocols"],
                                            text=True).strip())
    except (OSError, subprocess.CalledProcessError):
        return Path("/usr/share/wayland-protocols")


def scan(scanner, mode, xml, path):
    subprocess.run([scanner, mode, str(xml), str(path)], check=True)
    # Drop the scanner's version line so the output depends only on the protocol.
    lines = path.read_text().splitlines(keepends=True)
    path.write_text("".join(line for line in lines if not line.startswith("/* Generated by wayland-scanner")))


def main():
    scanner = shutil.which("wayland-scanner")
    if not scanner:
        raise SystemExit("wayland-scanner not found (install libwayland-dev)")
    share = protocols_dir()
    OUTPUT.mkdir(parents=True, exist_ok=True)
    for protocol in PROTOCOLS:
        candidates = protocol if isinstance(protocol, tuple) else (protocol,)
        xml = next((share / c for c in candidates if (share / c).exists()), None)
        if xml is None:
            raise SystemExit(f"{candidates[0]} not found under {share} (install wayland-protocols)")
        scan(scanner, "client-header", xml, OUTPUT / f"{xml.stem}-client-protocol.h")
        scan(scanner, "private-code", xml, OUTPUT / f"{xml.stem}-protocol.c")
    return 0


if __name__ == "__main__":
    sys.exit(main())
