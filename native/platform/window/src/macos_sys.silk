  pub unsafe fn silk_macos_close_window(window: u32) -> () {
    return ()
  }

  pub unsafe fn silk_macos_next_event(timeout: f64, event: *mut RawEvent) -> u8 {
    return 0
  }

  pub unsafe fn silk_macos_wake() -> () {
    return ()
