    keyKind: u32,
    keyValue: u32,
    modifiers: u32,
    enabled: u8,
    checked: u8,
  ) -> ()
  pub unsafe extern "C" fn silk_macos_menu_separator() -> ()
  pub unsafe extern "C" fn silk_macos_menu_system(item: u32) -> ()
  pub unsafe extern "C" fn silk_macos_menu_commit() -> ()
  pub unsafe extern "C" fn silk_macos_open_dialog(
    title: ?[*]const u8,
    titleLength: usize,
    directory: ?[*]const u8,
    directoryLength: usize,
    extensions: ?[*]const u8,
    extensionsLength: usize,
    flags: u32,
    parent: u32,
  ) -> u32
  pub unsafe extern "C" fn silk_macos_save_dialog(
    title: ?[*]const u8,
    titleLength: usize,
    directory: ?[*]const u8,
    directoryLength: usize,
    name: ?[*]const u8,
    nameLength: usize,
    extensions: ?[*]const u8,
    extensionsLength: usize,
    flags: u32,
    parent: u32,
  ) -> u32
  pub unsafe extern "C" fn silk_macos_clipboard_read(length: *mut usize) -> ?[*]const u8
  pub unsafe extern "C" fn silk_macos_clipboard_write(text: ?[*]const u8, length: usize) -> ()
  pub unsafe extern "C" fn silk_macos_appearance() -> u32
  pub unsafe extern "C" fn silk_macos_test_post_key(
    window: u32,
    keyCode: u16,
    characters: ?[*]const u8,
    length: usize,
    modifiers: u32,
  ) -> ()
  pub unsafe extern "C" fn silk_macos_test_set_marked_text(
    window: u32,
    text: ?[*]const u8,
    length: usize,
    selectionStart: u64,
    selectionLength: u64,
  ) -> ()
  pub unsafe extern "C" fn silk_macos_test_insert_text(
    window: u32,
    text: ?[*]const u8,
