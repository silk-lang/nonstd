  pub unsafe fn silk_macos_content_size(window: u32, width: *mut f64, height: *mut f64) -> () {
    return ()
  }

  pub unsafe fn silk_macos_scale_factor(window: u32) -> f64 {
    return 1.0
  }

  pub unsafe fn silk_macos_metal_layer(window: u32) -> ?*mut u8 {
