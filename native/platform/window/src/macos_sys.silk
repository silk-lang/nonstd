  pub unsafe fn silk_macos_event_text(index: usize, length: *mut usize) -> ?[*]const u8 {
    return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())
  }

  pub unsafe fn silk_macos_request_frame(window: u32) -> () {
    return ()
