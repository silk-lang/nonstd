  pub unsafe extern "C" fn silk_macos_test_ime_rect(
    window: u32,
    x: *mut f64,
    y: *mut f64,
    width: *mut f64,
    height: *mut f64,
  ) -> ()
  pub unsafe extern "C" fn silk_macos_test_uses_fiber() -> u8
} else {
  pub unsafe fn silk_macos_start() -> i32 {
    return 2
  }

  pub unsafe fn silk_macos_open_window(
    title: ?[*]const u8,
    titleLength: usize,
    width: f64,
    height: f64,
    minWidth: f64,
    minHeight: f64,
    flags: u32,
