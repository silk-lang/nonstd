#!/usr/bin/env python3
"""Prepare pinned libghostty-vt 1.0.0 for this checkout (macOS prebuilt; Linux needs Zig 0.17)."""
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import tempfile
import tomllib
import zipfile

PACKAGE = Path(__file__).resolve().parents[1]
VERSION = "1.0.0"
APPLE_URL = f"https://release.files.ghostty.org/libghostty-vt/{VERSION}/ghostty-vt-{VERSION}.xcframework.zip"
APPLE_SHA256 = "2c32b7409b2b6c2ef6cfd606526de357762ad458bdc27134ad074e86506a8bc2"


def download(url, digest, destination):
    subprocess.run(["curl", "--fail", "--location", "--silent", "--show-error",
                    "--output", str(destination), url], check=True)
    with destination.open("rb") as downloaded:
        actual = hashlib.file_digest(downloaded, "sha256").hexdigest()
    if actual != digest:
        raise SystemExit(f"SHA-256 mismatch for {url}: {actual}")


def main():
    system = platform.system()
    if system not in ("Darwin", "Linux"):
        raise SystemExit("terminal-ghostty currently supports macOS and Linux only")
    destination = PACKAGE / "native/build"
    library = destination / "lib/libghostty-vt.a"
    stamp = destination / "prepared.json"
    source = tomllib.loads((PACKAGE / "silk.toml").read_text())["native"]["archive"]["ghostty-source"]
    identity = {"version": VERSION, "os": system, "arch": platform.machine(),
                "sha256": APPLE_SHA256 if system == "Darwin" else source["sha256"]}
    if library.is_file() and stamp.is_file() and json.loads(stamp.read_text()) == identity:
        print(f"Already prepared: {library}")
        return
    destination.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="nonstd-ghostty-") as temporary:
        work = Path(temporary)
        if system == "Darwin":
            archive = work / "ghostty.zip"
            download(APPLE_URL, APPLE_SHA256, archive)
            library.parent.mkdir(parents=True, exist_ok=True)
            with zipfile.ZipFile(archive) as zipped:
                member = "ghostty-vt.xcframework/macos-arm64_x86_64/libghostty-vt.a"
                with zipped.open(member) as data, library.open("wb") as output:
                    shutil.copyfileobj(data, output)
        else:
            zig = os.environ.get("ZIG", "zig")
            version = subprocess.check_output([zig, "version"], text=True).strip()
            if not version.startswith("0.17."):
                raise SystemExit(f"libghostty-vt {VERSION} requires Zig 0.17; found {version}")
            archive = work / "ghostty.tar.gz"
            download(source["url"], source["sha256"], archive)
            with tarfile.open(archive) as tar:
                tar.extractall(work, filter="data")
            subprocess.run([zig, "build", "-Doptimize=ReleaseFast", "--prefix", str(destination)],
                           cwd=work / f"libghostty-vt-{VERSION}", check=True)
        if not library.is_file():
            raise SystemExit(f"Build did not produce {library}")
    stamp.write_text(json.dumps(identity, indent=2) + "\n")
    print(f"Prepared: {library}")


if __name__ == "__main__":
    main()
