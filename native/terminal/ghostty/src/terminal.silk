//! Terminal emulation through libghostty-vt 1.0. Feed output bytes to [`Terminal.write`],
//! then read an owned [`Snapshot`] or export text. This module owns no PTY, window or process.
//! Native allocations use Ghostty's default allocator; dropping a handle releases them.
import sys
import silk.core.option { Option }
import silk.core.ownership { Copy, Drop }
import silk.mem.pointer { Pointer }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.text.string { String }

/// A libghostty result code. `-1` means native allocation failure; `-2` invalid dimensions.
pub struct GhosttyError {
  pub code: i32
}

effect fn checked(code: i32) -> ()
  ! GhosttyError {
  if code != 0 {
    fail GhosttyError { code: code }
  }
}

/// An owned terminal. Mutating operations require an exclusive borrow; do not share across threads.
pub struct Terminal {
  handle: ?*mut u8,
  input: ?*mut u8
}

impl Drop for Terminal {
  fn drop(self: &mut Self) -> () {
    unsafe sys.ghostty_terminal_free(self.handle)
    unsafe sys.silk_ghostty_input_free(self.input)
  }
}

impl Terminal {
  /// Creates a terminal with nonzero dimensions. Fails with `GhosttyError` on invalid size or OOM.
  pub effect fn make(columns: u16, rows: u16) -> Terminal
    ! GhosttyError {
    if columns == 0 || rows == 0 {
      fail GhosttyError { code: -2 }
    }
    let mut handle = Pointer.null<u8>()
    run checked(
      unsafe sys.ghostty_terminal_new(
        Pointer.null<u8>(),
        Pointer.fromMutRef<?*mut u8>(&mut handle),
        columns,
        rows,
      ),
    )
    let mut terminal = Terminal { handle: handle, input: Pointer.null<u8>() }
    run checked(
      unsafe sys.silk_ghostty_input_new(handle, Pointer.fromMutRef<?*mut u8>(&mut terminal.input)),
    )
    return move terminal
  }

  /// Encodes a pressed key using the terminal's current keyboard modes. `key` is a UI Events
  /// name (Enter, ArrowUp, F1, etc.) or UTF-8 text. Modifier bits: Shift=1, Ctrl=2, Alt=4,
  /// Super=8, CapsLock=16. Returns bytes written; fails with `GhosttyError` (-3 if too small).
  pub effect fn encodeKey(self: &mut Self, key: string, modifiers: u32, output: &mut [u8]) -> usize
    ! GhosttyError {
    let name = String.utf8Bytes(key)
    let mut written: usize = 0
    run checked(
      unsafe sys.silk_ghostty_key(
        self.handle,
        self.input,
        Pointer.fromSlice(name),
        name.length,
        modifiers,
        Pointer.fromMutSlice(&mut output),
        output.length,
        Pointer.fromMutRef(&mut written),
      ),
    )
    return written
  }

  /// Encodes paste with Ghostty's current bracketed-paste mode and sanitization. Allocate at
  /// least UTF-8 byte length + 12 bytes. Fails with `GhosttyError`, including -3 for insufficient space.
  pub effect fn encodePaste(self: &mut Self, text: string, output: &mut [u8]) -> usize
    ! GhosttyError {
    let bytes = String.utf8Bytes(text)
    let mut written: usize = 0
    run checked(
      unsafe sys.silk_ghostty_paste(
        self.handle,
        Pointer.fromSlice(bytes),
        bytes.length,
        Pointer.fromMutSlice(&mut output),
        output.length,
        Pointer.fromMutRef(&mut written),
      ),
    )
    return written
  }

  /// Drains replies generated by writes or resize (for example cursor-position reports).
  /// Send these bytes back to the PTY. Repeat until zero. Replies are queued up to 1 MiB;
  /// allocation failure or overflow is a sticky `GhosttyError` until the terminal is recreated.
  pub effect fn readReplies(self: &mut Self, output: &mut [u8]) -> usize
    ! GhosttyError {
    let mut written: usize = 0
    run checked(
      unsafe sys.silk_ghostty_replies(
        self.input,
        Pointer.fromMutSlice(&mut output),
        output.length,
        Pointer.fromMutRef(&mut written),
      ),
    )
    return written
  }

  /// Feeds arbitrary output bytes, including split UTF-8 and escape sequences.
  /// Ghostty processes best-effort; [`Terminal.hasProcessingError`] reports its sticky parser failure.
  pub fn write(self: &mut Self, bytes: &[u8]) -> () {
    unsafe sys.ghostty_terminal_vt_write(self.handle, Pointer.fromSlice<u8>(bytes), bytes.length)
  }

  /// Feeds UTF-8 text, including embedded ANSI sequences, as output bytes.
  pub fn writeText(self: &mut Self, text: string) -> () {
    self.write(String.utf8Bytes(text))
  }

  /// Reflows the primary screen to nonzero cell dimensions; fails with `GhosttyError`.
  /// Pixel sizes are per cell and may be zero when the host has no pixel geometry.
  pub effect fn resize(
    self: &mut Self,
    columns: u16,
    rows: u16,
    cellWidth: u32,
    cellHeight: u32,
  ) -> ()
    ! GhosttyError {
    if columns == 0 || rows == 0 {
      fail GhosttyError { code: -2 }
    }
    run checked(
      unsafe sys.ghostty_terminal_resize(self.handle, columns, rows, cellWidth, cellHeight),
    )
  }

  /// Resets contents, scrollback and terminal modes, preserving dimensions.
  pub fn reset(self: &mut Self) -> () {
    unsafe sys.ghostty_terminal_reset(self.handle)
  }

  /// Moves the viewport by rows (negative is up), clamped by Ghostty. Fails with `GhosttyError`.
  pub effect fn scroll(self: &mut Self, rows: i64) -> ()
    ! GhosttyError {
    run checked(unsafe sys.silk_ghostty_scroll(self.handle, rows, 0))
  }

  /// Returns the viewport to live output. Fails with `GhosttyError`.
  pub effect fn scrollToBottom(self: &mut Self) -> ()
    ! GhosttyError {
    run checked(unsafe sys.silk_ghostty_scroll(self.handle, 0, 1))
  }

  /// Copies the visible cells and cursor. The result survives mutation or destruction of this
  /// terminal. Consumes Ghostty's dirty state; fails with `GhosttyError` on native OOM.
  pub effect fn snapshot(self: &mut Self) -> Snapshot
    ! GhosttyError {
    let mut handle = Pointer.null<u8>()
    run checked(
      unsafe sys.silk_ghostty_snapshot_new(self.handle, Pointer.fromMutRef<?*mut u8>(&mut handle)),
    )
    return Snapshot { handle: handle }
  }

  /// Formats the active screen and its scrollback as plain UTF-8, trimming trailing whitespace.
  /// Fails with `GhosttyError` for native allocation failure or `OutOfMemoryError` for the copy.
  pub effect fn plainText(self: &Self) -> String
    ! GhosttyError | OutOfMemoryError
    ? &mut Allocator {
    let mut buffer = TextBuffer { bytes: Pointer.fromSlice<u8>(b""), length: 0 }
    run checked(
      unsafe sys.silk_ghostty_format(
        self.handle,
        Pointer.fromMutRef<?[*]const u8>(&mut buffer.bytes),
        Pointer.fromMutRef<usize>(&mut buffer.length),
      ),
    )
    let bytes = unsafe borrowedBytes(&buffer, buffer.bytes, buffer.length)
    return run String.copy(unsafe String.fromUtf8Unchecked(bytes))
  }

  /// Whether Ghostty encountered a sticky best-effort VT processing error. Reset does
  /// not clear this diagnostic; recreate the terminal after an unrecoverable allocation error.
  pub fn hasProcessingError(self: &Self) -> bool {
    return unsafe sys.silk_ghostty_processing_error(self.handle) != 0
  }
}

struct TextBuffer {
  bytes: ?[*]const u8,
  length: usize
}

impl Drop for TextBuffer {
  fn drop(self: &mut Self) -> () {
    unsafe sys.ghostty_free(Pointer.null<u8>(), self.bytes, self.length)
  }
}

unsafe fn borrowedBytes<'a, A>(anchor: &'a A, bytes: ?[*]const u8, length: usize) -> &'a [u8] {
  return match Pointer.nonNullMany<u8>(bytes) {
    Option<[*]const u8>.Some { value } => unsafe Pointer.borrowMany<'a, A, u8>(
      anchor,
      value,
      length,
    )
    Option<[*]const u8>.None => b""
  }
}

/// An immutable, owned viewport. Cell text borrows this snapshot, never the terminal.
pub struct Snapshot {
  handle: ?*mut u8
}

impl Drop for Snapshot {
  fn drop(self: &mut Self) -> () {
    unsafe sys.silk_ghostty_snapshot_free(self.handle)
  }
}

/// Cursor coordinates are zero-based. `visible` is false when hidden or outside the viewport.
pub struct Cursor {
  pub column: u32,
  pub row: u32,
  pub visible: bool
}

impl Copy for Cursor {}

/// A complete grapheme and its rendering attributes. Colors are `0xRRGGBB`, resolved through
/// the current palette, before inverse/faint/invisible styling. Width is 0 for a wide-cell
/// spacer, 1 for an ordinary cell (including an empty cell), and 2 for a wide glyph.
pub struct Cell<'a> {
  pub text: string<'a>,
  pub foreground: u32,
  pub background: u32,
  pub flags: u32,
  pub width: u32,
}

impl<'a> Copy for Cell<'a> {}

/// SGR style bits. Underline style occupies bits 8–10 of [`Cell.flags`].
pub const BOLD: u32 = 1

pub const ITALIC: u32 = 2

pub const FAINT: u32 = 4

pub const BLINK: u32 = 8

pub const INVERSE: u32 = 16

pub const INVISIBLE: u32 = 32

pub const STRIKETHROUGH: u32 = 64

pub const OVERLINE: u32 = 128

pub const UNDERLINE_MASK: u32 = 1792

impl Snapshot {
  /// Number of columns in this captured frame.
  pub fn columns(self: &Self) -> u32 {
    return unsafe sys.silk_ghostty_snapshot_get(self.handle, 0)
  }

  /// Number of rows in this captured frame.
  pub fn rows(self: &Self) -> u32 {
    return unsafe sys.silk_ghostty_snapshot_get(self.handle, 1)
  }

  /// Cursor state at capture time.
  pub fn cursor(self: &Self) -> Cursor {
    return Cursor {
      column: unsafe sys.silk_ghostty_snapshot_get(self.handle, 2),
      row: unsafe sys.silk_ghostty_snapshot_get(self.handle, 3),
      visible: unsafe sys.silk_ghostty_snapshot_get(self.handle, 4) != 0,
    }
  }

  /// Default foreground color, `0xRRGGBB`.
  pub fn foreground(self: &Self) -> u32 {
    return unsafe sys.silk_ghostty_snapshot_get(self.handle, 5)
  }

  /// Default background color, `0xRRGGBB`.
  pub fn background(self: &Self) -> u32 {
    return unsafe sys.silk_ghostty_snapshot_get(self.handle, 6)
  }

  /// Reads a zero-based viewport cell; returns `None` outside the captured dimensions.
  pub fn cell<'a>(self: &'a Self, column: u32, row: u32) -> Option<Cell<'a>> {
    let columns = self.columns()
    if column >= columns || row >= self.rows() {
      return Option<Cell<'a>>.None
    }
    let index = u32.toUsize(row) * u32.toUsize(columns) + u32.toUsize(column)
    let mut length: usize = 0
    let pointer = unsafe sys.silk_ghostty_cell_text(
      self.handle,
      index,
      Pointer.fromMutRef<usize>(&mut length),
    )
    let bytes = unsafe borrowedBytes(self, pointer, length)
    return Option<Cell<'a>>.Some {
      value: Cell<'a> {
        text: unsafe String.fromUtf8Unchecked(bytes),
        foreground: unsafe sys.silk_ghostty_cell_get(self.handle, index, 0),
        background: unsafe sys.silk_ghostty_cell_get(self.handle, index, 1),
        flags: unsafe sys.silk_ghostty_cell_get(self.handle, index, 2),
        width: unsafe sys.silk_ghostty_cell_get(self.handle, index, 3),
      }
    }
  }
}
