//! Private C ABI. Handles and snapshot indices must be valid for every call.
pub unsafe extern "C" fn ghostty_terminal_new(
  allocator: ?*mut u8,
  out: *mut ?*mut u8,
  cols: u16,
  rows: u16,
) -> i32

pub unsafe extern "C" fn ghostty_terminal_free(terminal: ?*mut u8) -> ()

pub unsafe extern "C" fn ghostty_terminal_reset(terminal: ?*mut u8) -> ()

pub unsafe extern "C" fn ghostty_terminal_vt_write(
  terminal: ?*mut u8,
  bytes: ?[*]const u8,
  length: usize,
) -> ()

pub unsafe extern "C" fn ghostty_terminal_resize(
  terminal: ?*mut u8,
  cols: u16,
  rows: u16,
  cellWidth: u32,
  cellHeight: u32,
) -> i32

pub unsafe extern "C" fn ghostty_free(allocator: ?*mut u8, bytes: ?[*]const u8, length: usize) -> ()

pub unsafe extern "C" fn silk_ghostty_processing_error(terminal: ?*mut u8) -> u8

pub unsafe extern "C" fn silk_ghostty_scroll(terminal: ?*mut u8, delta: i64, bottom: u8) -> i32

pub unsafe extern "C" fn silk_ghostty_format(
  terminal: ?*mut u8,
  out: *mut ?[*]const u8,
  length: *mut usize,
) -> i32

pub unsafe extern "C" fn silk_ghostty_snapshot_new(terminal: ?*mut u8, out: *mut ?*mut u8) -> i32

pub unsafe extern "C" fn silk_ghostty_snapshot_free(snapshot: ?*mut u8) -> ()

pub unsafe extern "C" fn silk_ghostty_snapshot_get(snapshot: ?*mut u8, field: u32) -> u32

pub unsafe extern "C" fn silk_ghostty_cell_get(snapshot: ?*mut u8, index: usize, field: u32) -> u32

pub unsafe extern "C" fn silk_ghostty_cell_text(
  snapshot: ?*mut u8,
  index: usize,
  length: *mut usize,
) -> ?[*]const u8

pub unsafe extern "C" fn silk_ghostty_input_new(terminal: ?*mut u8, out: *mut ?*mut u8) -> i32

pub unsafe extern "C" fn silk_ghostty_input_free(input: ?*mut u8) -> ()

pub unsafe extern "C" fn silk_ghostty_replies(
  input: ?*mut u8,
  output: ?[*]mut u8,
  capacity: usize,
  written: *mut usize,
) -> i32

pub unsafe extern "C" fn silk_ghostty_key(
  terminal: ?*mut u8,
  input: ?*mut u8,
  name: ?[*]const u8,
  length: usize,
  mods: u32,
  output: ?[*]mut u8,
  capacity: usize,
  written: *mut usize,
) -> i32

pub unsafe extern "C" fn silk_ghostty_paste(
  terminal: ?*mut u8,
  text: ?[*]const u8,
  length: usize,
  output: ?[*]mut u8,
  capacity: usize,
  written: *mut usize,
) -> i32
