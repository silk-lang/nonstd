#!/usr/bin/env python3
"""Embed canonical WGSL in Silk byte literals; --check detects stale embedding."""
import argparse
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
repo = root.parents[3]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
# (shader directory, Silk module, shader names); `a+b` concatenates a.wgsl and b.wgsl as shader b.
# A part may be a path relative to the shader directory.
sets = (
    ('native/gpu/webgpu/examples/shaders', 'native/gpu/webgpu/examples/src/generated_shaders.silk', ('clear', 'triangle', 'textured-quad', 'instanced-rects', 'compute', 'msaa')),
    ('graphics/gpu_scene/core/shaders', 'graphics/gpu_scene/core/src/generated_shaders.silk', ('scene', 'blend+compose', 'blend+filter')),
    ('graphics/ui_renderer/core/shaders', 'graphics/ui_renderer/core/src/generated_shaders.silk', ('common+quad', 'common+shadow', 'common+underline', 'common+sprite+mono', 'common+sprite+poly', 'common+path', '../../../gpu_scene/core/shaders/blend+layer')),
)
stale = []
for directory, module, names in sets:
    text = f'// Generated by scripts/embed-shaders from {directory}; do not edit.\n'
    for name in names:
        parts = name.split('+')
        source = ''.join((repo / directory / (part + '.wgsl')).read_text() for part in parts)
        text += f"pub fn {parts[-1].split('/')[-1].replace('-', '_')}() -> &'static [u8] {{ return b{json.dumps(source)} }}\n"
    path = repo / module
    if args.check:
        if not path.exists() or path.read_text() != text:
            stale.append(module)
    else:
        path.write_text(text)
if stale:
    raise SystemExit('stale embedded WGSL in ' + ', '.join(stale) + ': run scripts/embed-shaders')
