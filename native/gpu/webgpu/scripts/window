#!/usr/bin/env python3
"""Build/run the dev-only GLFW host. GLFW >= 3.4 must be installed separately.

Linux uses the distribution's libglfw (libglfw3-dev), macOS a GLFW the linker finds by default,
Windows the pinned release after scripts/prepare-windows. native/gpu/webgpu/examples-window/silk.toml
declares the links.
"""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

from _build import build, command_path

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build-only", action="store_true")
    parser.add_argument("--release", action="store_true")
    args = parser.parse_args()
    executable = build(ROOT / "examples-window", release=args.release)
    if sys.platform == "win32":
        root = command_path("install-glfw")
        dll = next((p for p in (root / "bin/glfw3.dll", root / "lib/glfw3.dll",
                                root / "lib-vc2022/glfw3.dll") if p.is_file()), None)
        if dll is None:
            raise SystemExit(f"GLFW runtime glfw3.dll not found under {root}")
        shutil.copy2(dll, executable.parent / "glfw3.dll")
    if args.build_only:
        print(executable)
        return 0
    return subprocess.run([str(executable)], cwd=ROOT).returncode


if __name__ == "__main__":
    raise SystemExit(main())
