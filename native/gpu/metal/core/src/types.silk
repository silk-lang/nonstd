// CoreGraphics CGSize used by MetalLayer drawable_size.
pub extern "C" struct CGSize {
    pub width: f64,
    pub height: f64,
}
impl Copy for CGSize {}

impl MTLSize {
    pub fn new(width: u64, height: u64, depth: u64) -> MTLSize {
        return MTLSize { width: width, height: height, depth: depth }
    }
    pub fn default() -> MTLSize {
        return MTLSize { width: 0, height: 0, depth: 0 }
    }
}

impl MTLRegion {
    pub fn new_1d(x: u64, width: u64) -> MTLRegion {
        return MTLRegion.new_2d(x, 0, width, 1)
    }
    pub fn new_2d(x: u64, y: u64, width: u64, height: u64) -> MTLRegion {
        return MTLRegion.new_3d(x, y, 0, width, height, 1)
    }
    pub fn new_3d(x: u64, y: u64, z: u64, width: u64, height: u64, depth: u64) -> MTLRegion {
        return MTLRegion { origin: MTLOrigin { x: x, y: y, z: z }, size: MTLSize { width: width, height: height, depth: depth } }
    }
    pub fn default() -> MTLRegion {
        return MTLRegion { origin: MTLOrigin { x: 0, y: 0, z: 0 }, size: MTLSize { width: 0, height: 0, depth: 0 } }
    }
}

impl NSRange {
    pub fn new(location: u64, length: u64) -> NSRange {
        return NSRange { location: location, length: length }
    }
}

impl MTLClearColor {
    pub fn new(red: f64, green: f64, blue: f64, alpha: f64) -> MTLClearColor {
        return MTLClearColor { red: red, green: green, blue: blue, alpha: alpha }
    }
}

impl CGSize {
    pub fn new(width: f64, height: f64) -> CGSize {
        return CGSize { width: width, height: height }
    }
}

pub struct MTLAccelerationStructureInstanceOptions {}
impl MTLAccelerationStructureInstanceOptions {
    pub fn default() -> u32 {
        return 0
    }
}

impl MTLAccelerationStructureInstanceDescriptor {
    pub fn default() -> MTLAccelerationStructureInstanceDescriptor {
        return MTLAccelerationStructureInstanceDescriptor { transformation_matrix: [[0.0; 3]; 4], options: 0, mask: 0, intersection_function_table_offset: 0, acceleration_structure_index: 0 }
    }
}

impl MTLAccelerationStructureUserIDInstanceDescriptor {
    pub fn default() -> MTLAccelerationStructureUserIDInstanceDescriptor {
        return MTLAccelerationStructureUserIDInstanceDescriptor { transformation_matrix: [[0.0; 3]; 4], options: 0, mask: 0, intersection_function_table_offset: 0, acceleration_structure_index: 0, user_id: 0 }
    }
}

impl MTLIndirectAccelerationStructureInstanceDescriptor {
    pub fn default() -> MTLIndirectAccelerationStructureInstanceDescriptor {
        return MTLIndirectAccelerationStructureInstanceDescriptor { transformation_matrix: [[0.0; 3]; 4], options: 0, mask: 0, intersection_function_table_offset: 0, user_id: 0, acceleration_structure_id: 0 }
    }
}

impl MTLOrigin {
    pub fn default() -> MTLOrigin {
        return MTLOrigin { x: 0, y: 0, z: 0 }
    }
}

impl MTLSamplePosition {
    pub fn default() -> MTLSamplePosition {
        return MTLSamplePosition { x: 0.0, y: 0.0 }
    }
}

impl MTLResourceID {
    pub fn default() -> MTLResourceID {
        return MTLResourceID { _impl: 0 }
    }
}

pub struct MTLMutability {}
impl MTLMutability {
    pub fn default() -> u64 {
        return MTLMutability_Default
    }
}

