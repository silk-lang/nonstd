pub struct CommandEncoder {}

impl CommandEncoder {
    // Returned UTF-8 storage is borrowed from the encoder label NSString.
    pub unsafe fn label(object: ?*mut u8) -> ?[*]const u8 {
        return unsafe metal_CommandEncoder_label(object)
    }

    // label is a non-null NUL-terminated UTF-8 string.
    pub unsafe fn set_label(object: ?*mut u8, label: ?[*]const u8) -> () {
        unsafe metal_CommandEncoder_set_label(object, label)
    }

    pub unsafe fn end_encoding(object: ?*mut u8) -> () {
        unsafe metal_CommandEncoder_end_encoding(object)
    }

    // name is a non-null NUL-terminated UTF-8 string.
    pub unsafe fn insert_debug_signpost(object: ?*mut u8, name: ?[*]const u8) -> () {
        unsafe metal_CommandEncoder_insert_debug_signpost(object, name)
    }

    // name is a non-null NUL-terminated UTF-8 string.
    pub unsafe fn push_debug_group(object: ?*mut u8, name: ?[*]const u8) -> () {
        unsafe metal_CommandEncoder_push_debug_group(object, name)
    }

    pub unsafe fn pop_debug_group(object: ?*mut u8) -> () {
        unsafe metal_CommandEncoder_pop_debug_group(object)
    }
}

