  pub unsafe fn set_install_name(object: ?*mut u8, name: ?[*]const u8) -> () {
    unsafe metal_CompileOptions_set_install_name(object, name)
  }
  // Borrowed +0 NSArray of MTLDynamicLibrary objects; replaces the Rust Vec with its source NSArray.
  pub unsafe fn libraries(object: ?*mut u8) -> ?*mut u8 {
    return unsafe metal_CompileOptions_libraries(object)
  }
  // Borrowed +0 NSArray of MTLDynamicLibrary objects; replaces the Rust Vec with its source NSArray.
  pub unsafe fn libraries_as_nsarray(object: ?*mut u8) -> ?*mut u8 {
    return unsafe metal_CompileOptions_libraries_as_nsarray(object)
  }
  // Pointer addresses count nonnull library objects; null pointer permitted only for count zero.
  pub unsafe fn set_libraries(object: ?*mut u8, libraries: ?[*]const ?*mut u8, count: u64) -> () {
    unsafe metal_CompileOptions_set_libraries(object, libraries, count)
  }
  pub unsafe fn set_libraries_nsarray(object: ?*mut u8, libraries: ?*mut u8) -> () {
    unsafe metal_CompileOptions_set_libraries_nsarray(object, libraries)
  }
  pub unsafe fn preserve_invariance(object: ?*mut u8) -> bool {
    return unsafe metal_CompileOptions_preserve_invariance(object) != 0
  }
  pub unsafe fn set_preserve_invariance(object: ?*mut u8, preserve: bool) -> () {
    let mut preserve_abi: u8 = 0
