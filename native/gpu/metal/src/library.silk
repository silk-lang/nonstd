  }
  pub unsafe fn set_label(object: ?*mut u8, label: ?[*]const u8) -> () {
    unsafe metal_Library_set_label(object, label)
  }
  // Returns owned +1 function or null. Null constants selects the unspecialized Metal overload; nonnull selects specialization. NSError is borrowed +0; missing-function convenience errors retain the upstream message.
  pub unsafe fn get_function(object: ?*mut u8, name: ?[*]const u8, constants: ?*mut u8, error: ?*mut ?*mut u8) -> ?*mut u8 {
    return unsafe metal_Library_get_function(object, name, constants, error)
  }
  // Borrowed +0 NSArray of NSString names; replaces the Rust Vec<String>.
  pub unsafe fn function_names(object: ?*mut u8) -> ?*mut u8 {
    return unsafe metal_Library_function_names(object)
  }
  pub unsafe fn library_type(object: ?*mut u8) -> u64 {
    return unsafe metal_Library_library_type(object)
  }
  // Borrowed UTF-8 install name; null represents upstream None.
  pub unsafe fn install_name(object: ?*mut u8) -> ?[*]const u8 {
    return unsafe metal_Library_install_name(object)
  }
  // Result is owned +1 or null. NSError output is borrowed +0; fallback error preserves the upstream convenience failure message.
  pub unsafe fn new_function_with_descriptor(object: ?*mut u8, descriptor: ?*mut u8, error: ?*mut ?*mut u8) -> ?*mut u8 {
    return unsafe metal_Library_new_function_with_descriptor(object, descriptor, error)
  }
  // Result is owned +1 or null. NSError output is borrowed +0; fallback error preserves the upstream convenience failure message.
  pub unsafe fn new_intersection_function_with_descriptor(object: ?*mut u8, descriptor: ?*mut u8, error: ?*mut ?*mut u8) -> ?*mut u8 {
    return unsafe metal_Library_new_intersection_function_with_descriptor(object, descriptor, error)
  }
}

