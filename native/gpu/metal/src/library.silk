pub struct Library {}
impl Library {
  // Borrowed +0 Objective-C object; retain explicitly if needed.
  pub unsafe fn device(object: ?*mut u8) -> ?*mut u8 {
    return unsafe metal_Library_device(object)
  }
  // Borrowed NUL-terminated UTF-8; valid while the owning NSString remains alive.
