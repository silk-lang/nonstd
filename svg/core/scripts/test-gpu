#!/usr/bin/env python3
"""Render the SVG reftest inputs on the CPU and through gpu_scene on pinned Dawn, and compare."""
import subprocess
import sys
from _gpu import SVG, build

# Inputs render with the deterministic test environment (no installed fonts) at time 0.
SUITES = ("painting", "compositing", "masking", "clipping", "clip-shapes", "structure", "color",
          "filters", "images", "own", "text", "animation", "css", "malformed")

binary = build(SVG.parent / "gpu" / "tests")
suites = sys.argv[1:] or SUITES
subprocess.run([str(binary), str(SVG.parent / "tests" / "fixtures"), *suites], check=True, timeout=900)
