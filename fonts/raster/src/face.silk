//! One font instance, read once and passed to every cache lookup.
import read_fonts.lib { FontRef, ReadError }
import read_fonts.model.metrics { Metrics }
import font_outline.outline { Outlines }
import color { ColorTables }
import font_types.lib { F2Dot14 }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silk.num.f64

/// A font at fixed variation coordinates, with the tables the rasterizer reads.
///
/// `id` is the caller's name for this instance and becomes [`key.GlyphKey.font`]: two faces with
/// the same `id` must have the same bytes, face index and coordinates, or the cache will hand one
/// the other's glyphs.
pub struct FontFace<'a> {
  pub id: u32,
  pub font: FontRef<'a>,
  outlines: Outlines<'a>,
  colors: ColorTables<'a>,
  coords: List<F2Dot14>,
  unitsPerEm: u16,
  glyphCount: u32,
}

impl<'a> FontFace<'a> {
  /// Reads `font` at normalized variation `coords` (empty for the default instance).
  pub effect fn make(id: u32, font: FontRef<'a>, coords: &[F2Dot14]) -> FontFace<'a>
    ! OutOfMemoryError
    ? &mut Allocator {
    let metrics = Metrics.fromSfnt(&font, coords)
    let mut owned = List<F2Dot14>.make()
    run owned.appendSlice(coords)
    let upem = if metrics.unitsPerEm == 0 {
      1000
    } else {
      metrics.unitsPerEm
    }
    return FontFace<'a> {
      id: id,
      font: font,
      outlines: Outlines.new(&font, metrics.numGlyphs, upem),
      colors: ColorTables.read(&font),
      coords: move owned,
      unitsPerEm: upem,
      glyphCount: metrics.numGlyphs,
    }
  }

  /// Reads face `index` of the font file or collection `data`.
  pub effect fn fromBytes(id: u32, data: &'a [u8], index: u32, coords: &[F2Dot14]) -> Result<
    FontFace<'a>,
    ReadError
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    return match move FontRef.fromIndex(data, index) {
      Result<FontRef<'a>, ReadError>.Success { value } => Result<FontFace<'a>, ReadError>.succeed(
        run FontFace.make(id, value, coords),
      )
      Result<FontRef<'a>, ReadError>.Failure { error } => Result<
        FontFace<'a>,
        ReadError
      >.failResult(error)
    }
  }

  pub fn outlineReader(self: &Self) -> &Outlines<'a> {
    return &self.outlines
  }

  /// The COLR, CPAL, sbix and CBDT tables, where present.
  pub fn colorTables(self: &Self) -> ColorTables<'a> {
    return self.colors
  }

  pub fn variationCoords(self: &Self) -> &[F2Dot14] {
    return self.coords.asSlice()
  }

  pub fn upem(self: &Self) -> u16 {
    return self.unitsPerEm
  }

  pub fn numGlyphs(self: &Self) -> u32 {
    return self.glyphCount
  }

  /// Device pixels per font unit at `pixelsPerEm`.
  pub fn scaleFor(self: &Self, pixelsPerEm: f64) -> f64 {
    return pixelsPerEm / u16.toF64(self.unitsPerEm)
  }
}
