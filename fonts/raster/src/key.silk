//! What identifies a rasterized glyph, and how a pen position picks its subpixel variant.
//!
//! Text is unhinted, so a glyph's pixels depend on where its pen falls inside a device pixel.
//! Horizontal positions are quantized to [`SUBPIXEL_VARIANTS`] steps of a quarter pixel; vertical
//! positions snap to whole pixels (baselines are horizontal in UI text).
import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.core.equal { Equal }
import silk.core.ownership { Copy }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u32

/// Horizontal positions per pixel that get their own rasterization.
pub const SUBPIXEL_VARIANTS: u8 = 4

/// Everything that changes a glyph's pixels.
///
/// `font` names one font instance (face and variation coordinates) chosen by the caller, as in
/// [`face.FontFace`]. `size` is the font size in logical pixels per em and `scale` the window's
/// scale factor, so the glyph is drawn at `size * scale` device pixels per em. `color` asks for
/// the color rendering (COLR, CBDT, sbix) instead of the outline when the font has one.
pub struct GlyphKey {
  pub font: u32,
  pub glyph: u32,
  pub size: f32,
  pub scale: f32,
  pub subpixel: u8,
  pub color: bool,
}

impl Copy for GlyphKey {}

fn bits(value: f32) -> u32 {
  // -0.0 and 0.0 are the same size.
  if value == 0.0 {
    return 0
  }
  return f32.toBits(value)
}

impl GlyphKey {
  /// Device pixels per em.
  pub fn pixelsPerEm(self: &Self) -> f64 {
    return f32.toF64(self.size) * f32.toF64(self.scale)
  }

  /// The horizontal offset of the pen inside its pixel, in device pixels: `0`, `0.25`, `0.5` or
  /// `0.75`.
  pub fn subpixelOffset(self: &Self) -> f64 {
    return u8.toF64(self.subpixel) / u8.toF64(SUBPIXEL_VARIANTS)
  }
}

impl Equal for GlyphKey {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.font == right.font && left.glyph == right.glyph
      && bits(left.size) == bits(right.size)
      && bits(left.scale) == bits(right.scale)
      && left.subpixel == right.subpixel
      && left.color == right.color
  }
}

impl HashKey for GlyphKey {
  fn equals(left: &Self, right: &Self) -> bool {
    return Equal.equals(left, right)
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    let mut hashed = Hash.mix(seed, u32.toU64(value.font))
    hashed = Hash.combine(hashed, u32.toU64(value.glyph))
    hashed = Hash.combine(
      hashed,
      u32.toU64(bits(value.size)) * 4294967296 + u32.toU64(bits(value.scale)),
    )
    let mut flags = u8.toU64(value.subpixel) * 2
    if value.color {
      flags = flags + 1
    }
    return Hash.combine(hashed, flags)
  }
}

/// A pen position in device pixels split into the whole pixel a glyph tile is placed from and the
/// subpixel variant it is rasterized at.
pub struct PenPosition {
  /// The whole device pixel of the pen, after rounding to the nearest variant.
  pub x: i32,
  /// The baseline row, rounded to the nearest whole pixel.
  pub y: i32,
  /// `0 .. SUBPIXEL_VARIANTS`: the pen sits `subpixel / SUBPIXEL_VARIANTS` pixels right of `x`.
  pub subpixel: u8,
}

impl Copy for PenPosition {}

impl PenPosition {
  /// Quantizes a device-space pen position. The horizontal error is at most an eighth of a pixel.
  /// Positions must be finite and inside the `i32` range.
  pub fn of(x: f64, y: f64) -> PenPosition {
    let variants = u8.toF64(SUBPIXEL_VARIANTS)
    let steps = f64.floor(x * variants + 0.5)
    let pixel = f64.floor(steps / variants)
    let variant = steps - pixel * variants
    return PenPosition {
      x: f64.toI32(pixel),
      y: f64.toI32(f64.floor(y + 0.5)),
      subpixel: u32.toU8(f64.toU32(variant)),
    }
  }

  /// The quantized pen position as a device-space x coordinate.
  pub fn quantizedX(self: &Self) -> f64 {
    return i32.toF64(self.x) + u8.toF64(self.subpixel) / u8.toF64(SUBPIXEL_VARIANTS)
  }
}
