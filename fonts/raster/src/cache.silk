//! The glyph cache: rasterize a glyph once per key, keep its pixels in an atlas tile.
//!
//! A frame calls [`atlas.Atlas.beginFrame`], then [`GlyphCache.glyph`] for every glyph it draws.
//! A hit touches the tile so the atlas keeps it; a miss rasterizes the glyph, allocates a tile and
//! queues its pixels in [`GlyphCache.uploads`]. The renderer copies each upload into its texture
//! (`queue.writeTexture` on WebGPU, a memcpy for the CPU reference) and calls
//! [`GlyphCache.clearUploads`].
//!
//! The atlas is borrowed per call so icons and images can share it. When the atlas evicts a
//! glyph's tile, the next lookup sees the stale tile and rasterizes the glyph again;
//! [`GlyphCache.prune`] drops such entries early to bound the map.
import key { GlyphKey }
import face { FontFace }
import rasterize { GlyphRasterizer, GlyphImage, Outcome }
import color
import vector.pixmap { Rgba8 }
import atlas.atlas { Atlas, AtlasTile, AtlasError, Kind, TileId, TextureId }
import silk.geometry.rect { Rect }
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// A glyph in the atlas, placed relative to the pen.
///
/// Draw `tile.bounds` (its width and height) with the top-left corner `left` device pixels right
/// of the pen's whole pixel ([`key.PenPosition.x`]) and `top` rows below the baseline
/// ([`key.PenPosition.y`]; negative is above).
pub struct RasterGlyph {
  pub tile: AtlasTile,
  pub left: i32,
  pub top: i32,
  pub kind: Kind,
}

impl Copy for RasterGlyph {}

impl RasterGlyph {
  pub fn width(self: &Self) -> u32 {
    return self.tile.bounds.xMax - self.tile.bounds.xMin
  }

  pub fn height(self: &Self) -> u32 {
    return self.tile.bounds.yMax - self.tile.bounds.yMin
  }
}

/// Pixels to copy into a texture: `tile.bounds` of texture `tile.texture`, from
/// [`GlyphCache.uploadBytes`] starting at `offset`, `bytesPerRow` bytes per row, tightly packed.
pub struct Upload {
  pub tile: AtlasTile,
  pub offset: usize,
  pub bytesPerRow: u32,
}

impl Copy for Upload {}

struct Cached {
  present: bool,
  glyph: RasterGlyph,
}

impl Copy for Cached {}

/// How many lookups hit, missed, or found their tile evicted, since the cache was made.
pub struct CacheStats {
  pub hits: u64,
  pub misses: u64,
  pub rerasterized: u64,
}

impl Copy for CacheStats {}

pub struct GlyphCache {
  entries: HashMap<GlyphKey, Cached>,
  rasterizer: GlyphRasterizer,
  image: GlyphImage,
  uploadList: List<Upload>,
  bytes: List<u8>,
  counters: CacheStats,
  scratchKeys: List<GlyphKey>,
  foreground: Rgba8,
}

fn emptyGlyph() -> RasterGlyph {
  return RasterGlyph {
    tile: AtlasTile {
      id: TileId { index: 0, generation: 0 },
      texture: TextureId { kind: Kind.Monochrome, index: 0 },
      bounds: Rect<u32> { xMin: 0, yMin: 0, xMax: 0, yMax: 0 },
    },
    left: 0,
    top: 0,
    kind: Kind.Monochrome,
  }
}

impl GlyphCache {
  /// An empty cache that draws foreground-colored COLR layers in opaque black.
  pub fn make() -> GlyphCache {
    return GlyphCache.withForeground(Rgba8.make(0, 0, 0, 255))
  }

  /// An empty cache that draws foreground-colored COLR layers (palette index 0xFFFF) in
  /// `foreground`. Keys do not hold a color, so one cache serves one foreground color.
  pub fn withForeground(foreground: Rgba8) -> GlyphCache {
    return GlyphCache {
      entries: HashMap<GlyphKey, Cached>.make(Hash.seed(0x676c797068)),
      rasterizer: GlyphRasterizer.make(),
      image: GlyphImage.make(),
      uploadList: List<Upload>.make(),
      bytes: List<u8>.make(),
      counters: CacheStats { hits: 0, misses: 0, rerasterized: 0 },
      scratchKeys: List<GlyphKey>.make(),
      foreground: foreground,
    }
  }

  /// The number of cached keys, empty glyphs included.
  pub fn length(self: &Self) -> usize {
    return self.entries.length()
  }

  pub fn stats(self: &Self) -> CacheStats {
    return self.counters
  }

  /// Returns the tile of `key` in `face`, rasterizing it on a miss, or `None` when the glyph draws
  /// nothing (a space, or a glyph the font has no outline for). `face.id` must be `key.font`.
  ///
  /// With `key.color`, a glyph that has a COLR (version 0), sbix or CBDT rendering gets a
  /// polychrome tile of premultiplied RGBA; any other glyph gets its outline as usual.
  ///
  /// Fails with [`atlas.AtlasError.Full`] when the atlas has no room even after evicting what
  /// earlier frames used; nothing is cached then, so a later frame can try again.
  pub effect fn glyph(
    self: &mut Self,
    atlas: &mut Atlas,
    face: &FontFace<'_>,
    key: GlyphKey,
  ) -> Option<RasterGlyph>
    ! OutOfMemoryError | AtlasError
    ? &mut Allocator {
    if let Option<Cached>.Some { value } = self.entries.get(key) {
      if !value.present {
        self.counters.hits = self.counters.hits + 1
        return Option<RasterGlyph>.None
      }
      if atlas.touch(value.glyph.tile.id) {
        self.counters.hits = self.counters.hits + 1
        return Option<RasterGlyph>.some(value.glyph)
      }
      self.counters.rerasterized = self.counters.rerasterized + 1
    } else {
      self.counters.misses = self.counters.misses + 1
    }
    let mut drawn = false
    let mut kind = Kind.Monochrome
    if key.color {
      let colored = run color.colorGlyph(
        &mut self.rasterizer,
        face,
        key.glyph,
        key.pixelsPerEm(),
        key.subpixelOffset(),
        self.foreground,
        &mut self.image,
      )
      drawn = match &colored {
        Outcome.Drawn => true
        Outcome.Missing => false
      }
      kind = Kind.Polychrome
    }
    if !drawn {
      kind = Kind.Monochrome
      let outcome = run self.rasterizer.outline(
        face,
        key.glyph,
        key.pixelsPerEm(),
        key.subpixelOffset(),
        &mut self.image,
      )
      drawn = match &outcome {
        Outcome.Drawn => true
        Outcome.Missing => false
      }
    }
    if !drawn || self.image.isEmpty() {
      drop run self.entries.insert(key, Cached { present: false, glyph: emptyGlyph() })
      return Option<RasterGlyph>.None
    }
    let tile = run atlas.allocate(kind, self.image.width, self.image.height)
    let glyph = RasterGlyph { tile: tile, left: self.image.left, top: self.image.top, kind: kind }
    let offset = self.bytes.length()
    run self.bytes.appendSlice(self.image.pixels.asSlice())
    run self.uploadList.append(
      Upload {
        tile: tile,
        offset: offset,
        bytesPerRow: self.image.width * self.image.bytesPerPixel,
      },
    )
    drop run self.entries.insert(key, Cached { present: true, glyph: glyph })
    return Option<RasterGlyph>.some(glyph)
  }

  /// Tiles allocated since the last [`GlyphCache.clearUploads`], in allocation order.
  pub fn uploads(self: &Self) -> &[Upload] {
    return self.uploadList.asSlice()
  }

  /// The pixel bytes [`Upload.offset`] points into.
  pub fn uploadBytes(self: &Self) -> &[u8] {
    return self.bytes.asSlice()
  }

  /// Forgets the queued uploads once the renderer has copied them.
  pub fn clearUploads(self: &mut Self) -> () {
    self.uploadList.clear()
    self.bytes.clear()
  }

  /// Drops every entry whose tile `atlas` no longer holds, and returns how many were dropped.
  /// Empty glyphs stay cached.
  pub effect fn prune(self: &mut Self, atlas: &Atlas) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    self.scratchKeys.clear()
    let mut i: usize = 0
    while i < self.entries.bucketCount() {
      if self.entries.occupiedAt(i) {
        let value = self.entries.valueAt(i)
        if value.present {
          if let Option<AtlasTile>.None = atlas.get(value.glyph.tile.id) {
            run self.scratchKeys.append(self.entries.keyAt(i))
          }
        }
      }
      i = i + 1
    }
    let stale = self.scratchKeys.asSlice()
    let mut j: usize = 0
    while j < stale.length {
      drop self.entries.remove(stale[j])
      j = j + 1
    }
    return stale.length
  }

  /// Drops every entry, for example when the scale factor changes. Tiles stay allocated until the
  /// atlas evicts them.
  pub fn clear(self: &mut Self) -> () {
    self.entries.clear()
  }
}
