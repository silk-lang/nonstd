pub const CBDT: string = "fonts/raster/tests/fonts/Cbdt.ttf"

/// A CPU copy of the atlas textures, filled from the cache's uploads like a GPU would be.
pub struct Textures {
  pages: List<List<u8>>,
  widths: List<u32>,
  bytesPerPixel: List<u32>,
}

impl Textures {
  pub fn make() -> Textures {
    return Textures {
      pages: List<List<u8>>.make(),
      widths: List<u32>.make(),
      bytesPerPixel: List<u32>.make(),
    }
  }

  /// Creates the textures the atlas added and copies every queued upload, then clears the queue.
  pub effect fn sync(self: &mut Self, atlas: &Atlas, cache: &mut GlyphCache) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    while self.pages.length() < atlas.textureCount() {
      let info = atlas.texture(self.pages.length())
      let bpp = info.id.kind.bytesPerPixel()
      let mut page = List<u8>.make()
      run page.appendRepeated(0, u32.toUsize(info.width * info.height * bpp))
      run self.pages.append(move page)
      run self.widths.append(info.width)
      run self.bytesPerPixel.append(bpp)
    }
    let uploads = cache.uploads()
    let bytes = cache.uploadBytes()
    let mut i: usize = 0
    while i < uploads.length {
      let upload = uploads[i]
      let t = u32.toUsize(upload.tile.texture.index)
      let width = self.widths.get(t)
      let bpp = self.bytesPerPixel.get(t)
      let bounds = upload.tile.bounds
      let page = self.pages.asMutSlice()[t].asMutSlice()
      let mut y = bounds.yMin
      while y < bounds.yMax {
        let source = upload.offset + u32.toUsize((y - bounds.yMin) * upload.bytesPerRow)
        let target = u32.toUsize((y * width + bounds.xMin) * bpp)
        let mut x: usize = 0
        while x < u32.toUsize(upload.bytesPerRow) {
          page[target + x] = bytes[source + x]
          x = x + 1
        }
        y = y + 1
      }
      i = i + 1
    }
    cache.clearUploads()
  }

  /// Byte `(x, y)` (in tile pixels) of a monochrome glyph's tile.
  pub fn alpha(self: &Self, glyph: &RasterGlyph, x: u32, y: u32) -> u8 {
    let t = u32.toUsize(glyph.tile.texture.index)
    let width = self.widths.get(t)
    let index = (glyph.tile.bounds.yMin + y) * width + glyph.tile.bounds.xMin + x
    return self.pages.asSlice()[t].asSlice()[u32.toUsize(index)]
  }
}

impl Textures {
  /// Pixel `(x, y)` (in tile pixels) of a polychrome glyph's tile, premultiplied.
  pub fn rgba(self: &Self, glyph: &RasterGlyph, x: u32, y: u32) -> Rgba8 {
    let t = u32.toUsize(glyph.tile.texture.index)
    let width = self.widths.get(t)
    let index = u32.toUsize(((glyph.tile.bounds.yMin + y) * width + glyph.tile.bounds.xMin + x) * 4)
    let page = self.pages.asSlice()[t].asSlice()
    return Rgba8.make(page[index], page[index + 1], page[index + 2], page[index + 3])
  }
}

/// An A8 canvas that glyph tiles are composited onto with `over`.
pub struct Canvas {
  pub width: u32,
  pub height: u32,
  pub pixels: List<u8>,
}

impl Canvas {
  pub effect fn make(width: u32, height: u32) -> Canvas
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut pixels = List<u8>.make()
    run pixels.appendRepeated(0, u32.toUsize(width * height))
    return Canvas { width: width, height: height, pixels: move pixels }
  }

  pub fn draw(self: &mut Self, textures: &Textures, glyph: &RasterGlyph, pen: PenPosition) -> () {
    let x0 = pen.x + glyph.left
    let y0 = pen.y + glyph.top
    let mut y: u32 = 0
    while y < glyph.height() {
      let mut x: u32 = 0
      while x < glyph.width() {
        let cx = x0 + u32.toI32(x)
        let cy = y0 + u32.toI32(y)
        if cx >= 0 && cy >= 0 && cx < u32.toI32(self.width) && cy < u32.toI32(self.height) {
          let a = u8.toU32(textures.alpha(glyph, x, y))
          let i = i32.toUsize(cy) * u32.toUsize(self.width) + i32.toUsize(cx)
          let d = u8.toU32(self.pixels.get(i))
          self.pixels.set(i, u32.toU8(d + (a * (255 - d) + 127) / 255))
        }
        x = x + 1
      }
      y = y + 1
    }
  }

  /// The canvas as a binary PGM (P5) file.
  pub effect fn pgm(self: &Self) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut out = run Bytes.copy(b"P5\n")
    run appendDecimal(&mut out, self.width)
    run out.append(b" ")
    run appendDecimal(&mut out, self.height)
    run out.append(b"\n255\n")
    run out.append(self.pixels.asSlice())
    return move out
  }
}

effect fn appendDecimal(out: &mut Bytes, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run appendDecimal(&mut out, value / 10)
  }
  run out.append(&[u32.toU8(48 + value % 10)])
}

/// Shapes `text` once through `lines`, then draws it with its pen starting at `(x, y)` device
/// pixels on `canvas`, `size * scale` device pixels per em.
pub effect fn drawText(
  canvas: &mut Canvas,
  textures: &mut Textures,
  atlas: &mut Atlas,
  cache: &mut GlyphCache,
  lines: &mut LineCache,
  face: &FontFace<'_>,
  text: string,
  size: f32,
  scale: f32,
  x: f64,
  y: f64,
) -> ()
  ! OutOfMemoryError | AtlasError
  ? &mut Allocator {
  let data = ShaperData.new(&face.font)
  let shaper = data.shaper()
  let id = run lines.shape(&shaper, face.id, text)
  let pixelsPerFontUnit = face.scaleFor(f32.toF64(size) * f32.toF64(scale))
  let glyphs = lines.glyphs(id)
  let mut penX = x
  let mut i: usize = 0
  let mut placed = List<RasterGlyph>.make()
  let mut pens = List<PenPosition>.make()
  while i < glyphs.length {
    let glyph = glyphs[i]
    let pen = PenPosition.of(
      penX + i32.toF64(glyph.xOffset) * pixelsPerFontUnit,
      y - i32.toF64(glyph.yOffset) * pixelsPerFontUnit,
    )
    let key = GlyphKey {
      font: face.id,
      glyph: glyph.glyph,
      size: size,
      scale: scale,
      subpixel: pen.subpixel,
      color: false,
    }
    if let Option<RasterGlyph>.Some { value } = run cache.glyph(&mut atlas, face, key) {
      run placed.append(value)
      run pens.append(pen)
    }
    penX = penX + i32.toF64(glyph.xAdvance) * pixelsPerFontUnit
    i = i + 1
  }
  run textures.sync(&atlas, &mut cache)
  let mut j: usize = 0
  while j < placed.length() {
    canvas.draw(&textures, &placed.asSlice()[j], pens.get(j))
    j = j + 1
  }
}
