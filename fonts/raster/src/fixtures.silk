effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}

effect fn resolve(relative: string) -> Path
  ! HostInputError | OutOfMemoryError | FileError
  ? &mut Allocator {
  let root = run Path.root()
  return run Path.resolve(&root, relative)
}

/// Reads a file relative to the repository root (tests run from there).
pub effect fn readFile(relative: string) -> Bytes
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let path = run resolve(relative)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  return run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
}

/// Writes a file relative to the repository root, creating its directories.
pub effect fn writeFile(relative: string, bytes: &[u8]) -> ()
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let path = run resolve(relative)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  run FileSystem.writeFileWithParents(&path, bytes) |> Effect.provideMut<FileSystem>(&mut files)
}

