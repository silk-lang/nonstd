//! Glyph cache tests over the Noto subsets in svg/tests/fonts: pen quantization, tiles that
//! match `vector` fills of the same outline, cache hits, eviction and re-rasterization.
import key { GlyphKey, PenPosition, SUBPIXEL_VARIANTS }
import face { FontFace }
import rasterize { GlyphRasterizer, GlyphImage, Outcome, densify }
import cache { GlyphCache, RasterGlyph, CacheStats }
import lines { LineCache, LineId, ShapedGlyph }
import fixtures { Textures, readFile, SANS, SERIF }
import atlas.atlas { Atlas, AtlasError, AtlasOptions, AtlasTile, Kind }
import harfrust.lib { ShaperData }
import read_fonts.lib { ReadError }
import font_types.lib { F2Dot14 }
import vector.strips { Rasterizer, Coverage, NONZERO }
import vector.geometry_error { GeometryError }
import silk.geometry.affine { Affine2 }
import silk.collections.bytes { Bytes }
import silk.collections.hash { Hash, HashKey }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInputError }
import silk.system.filesystem { FileError }
import silk.testing.testing { Testing, AssertionError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.usize

pub effect fn must<'a>(result: Result<FontFace<'a>, ReadError>) -> FontFace<'a>
  ! AssertionError<'static> {
  return match move result {
    Result<FontFace<'a>, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "the font parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

pub effect fn present(glyph: Option<RasterGlyph>) -> RasterGlyph
  ! AssertionError<'static> {
  return match glyph {
    Option<RasterGlyph>.Some { value } => value
    _ => {
      run Testing.expect(false, "the glyph has a tile")
      return Intrinsic.trap("test assertion")
    }
  }
}

/// The glyph ids `text` shapes to in `face`.
pub effect fn glyphsOf(face: &FontFace<'_>, text: string, out: &mut List<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut lines = LineCache.make()
  let data = ShaperData.new(&face.font)
  let shaper = data.shaper()
  let id = run lines.shape(&shaper, face.id, text)
  let glyphs = lines.glyphs(id)
  let mut i: usize = 0
  while i < glyphs.length {
    run out.append(glyphs[i].glyph)
    i = i + 1
  }
}

fn keyOf(face: &FontFace<'_>, glyph: u32, size: f32, scale: f32, subpixel: u8) -> GlyphKey {
  return GlyphKey {
    font: face.id,
    glyph: glyph,
    size: size,
    scale: scale,
    subpixel: subpixel,
    color: false,
  }
}

test effect fn penPositionsRoundToTheNearestQuarterPixel() -> ()
  ! AssertionError<'static> {
  let a = PenPosition.of(10.1, 20.4)
  run Testing.expect(a.x == 10 && a.subpixel == 0 && a.y == 20, "10.1 rounds down to variant 0")
  let b = PenPosition.of(10.13, 20.6)
  run Testing.expect(b.x == 10 && b.subpixel == 1 && b.y == 21, "10.13 rounds to 10.25")
  let c = PenPosition.of(10.9, 0.0)
  run Testing.expect(c.x == 11 && c.subpixel == 0, "10.9 rounds up to the next whole pixel")
  let d = PenPosition.of(-0.3, -2.5)
  run Testing.expect(d.x == -1 && d.subpixel == 3 && d.y == -2, "negative positions floor")
  run Testing.expect(d.quantizedX() == -0.25, "-0.3 quantizes to -0.25")
  let mut i: i32 = 0
  while i < 400 {
    let x = i32.toF64(i) * 0.0137 - 2.0
    let pen = PenPosition.of(x, 0.0)
    run Testing.expect(f64.abs(pen.quantizedX() - x) <= 0.125, "error at most an eighth of a pixel")
    run Testing.expect(pen.subpixel < SUBPIXEL_VARIANTS, "variant in range")
    i = i + 1
  }
}

test effect fn glyphKeysDifferInEveryField() -> ()
  ! AssertionError<'static> {
  let seed = Hash.seed(3)
  let base = GlyphKey { font: 1, glyph: 2, size: 13.0, scale: 1.0, subpixel: 0, color: false }
  let mut variants = List<GlyphKey>.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let keys = [
    GlyphKey { font: 2, glyph: 2, size: 13.0, scale: 1.0, subpixel: 0, color: false },
    GlyphKey { font: 1, glyph: 3, size: 13.0, scale: 1.0, subpixel: 0, color: false },
    GlyphKey { font: 1, glyph: 2, size: 13.5, scale: 1.0, subpixel: 0, color: false },
    GlyphKey { font: 1, glyph: 2, size: 13.0, scale: 2.0, subpixel: 0, color: false },
    GlyphKey { font: 1, glyph: 2, size: 13.0, scale: 1.0, subpixel: 1, color: false },
    GlyphKey { font: 1, glyph: 2, size: 13.0, scale: 1.0, subpixel: 0, color: true },
  ]
  let mut i: usize = 0
  while i < 6 {
    run Testing.expect(!HashKey.equals(&base, &keys[i]), "keys differ")
    run Testing.expect(HashKey.hash(&base, &seed) != HashKey.hash(&keys[i], &seed), "hashes differ")
    i = i + 1
  }
  let same = GlyphKey { font: 1, glyph: 2, size: 13.0, scale: 1.0, subpixel: 0, color: false }
  run Testing.expect(
    HashKey.equals(&base, &same) && HashKey.hash(&base, &seed) == HashKey.hash(&same, &seed),
    "equal keys hash alike",
  )
  run Testing.expect(base.pixelsPerEm() == 13.0, "pixels per em")
  let doubled = keys[3]
  run Testing.expect(doubled.pixelsPerEm() == 26.0, "scale multiplies the size")
  run Testing.expect(keys[4].subpixelOffset() == 0.25, "variant 1 is a quarter pixel")
}

/// Compares the cached tile of each glyph with a direct `vector` fill of the same outline drawn
/// with its pen at `(penX + offset, baseline)` on a larger canvas: same coverage, same place.
effect fn tilesMatchVectorFills() -> ()
  ! AssertionError<'static>
    | AtlasError
    | OutOfMemoryError
    | FileError
    | HostInputError
    | GeometryError
  ? &mut Allocator {
  let bytes = run readFile(SANS)
  let face = run must(run FontFace.fromBytes(1, bytes.asSlice(), 0, &[]))
  let mut glyphs = List<u32>.make()
  run glyphsOf(&face, "Rag&@jQ", &mut glyphs)
  run Testing.expect(glyphs.length() == 7, "seven glyphs")
  let mut atlas = Atlas.make(AtlasOptions.default())
  let mut cache = GlyphCache.make()
  let mut textures = Textures.make()
  let mut reference = GlyphRasterizer.make()
  let mut rasterizer = Rasterizer.make()
  let mut dense = List<u8>.make()
  let canvas: u32 = 128
  let penX = 30.0
  let baseline = 80.0
  let scales: [f32; 2] = [1.0, 2.0]
  let mut checked: u32 = 0
  let mut s: usize = 0
  while s < 2 {
    let mut v: u8 = 0
    while v < SUBPIXEL_VARIANTS {
      let mut g: usize = 0
      while g < glyphs.length() {
        let key = keyOf(&face, glyphs.get(g), 13.0, scales[s], v)
        let tile = run present(run cache.glyph(&mut atlas, &face, key))
        run textures.sync(&atlas, &mut cache)
        drop run reference.outlinePath(
          &face,
          key.glyph,
          key.pixelsPerEm(),
          penX + key.subpixelOffset(),
          baseline,
        )
        let mut coverage = Coverage.make(canvas, canvas)
        let identity = Affine2<f64>.identity()
        run rasterizer.fill(reference.lastPath(), &identity, NONZERO, &mut coverage)
        run densify(&coverage, &mut dense)
        let x0 = f64.toI32(penX) + tile.left
        let y0 = f64.toI32(baseline) + tile.top
        let mut worst: u32 = 0
        let mut differing: u32 = 0
        let mut total: u32 = 0
        let mut y: i32 = 0
        while y < u32.toI32(canvas) {
          let mut x: i32 = 0
          while x < u32.toI32(canvas) {
            let expected = u8.toI32(
              dense.get(i32.toUsize(y) * u32.toUsize(canvas) + i32.toUsize(x)),
            )
            let tx = x - x0
            let ty = y - y0
            let mut got: i32 = 0
            if tx >= 0 && ty >= 0 && tx < u32.toI32(tile.width()) && ty < u32.toI32(tile.height()) {
              got = u8.toI32(textures.alpha(&tile, i32.toU32(tx), i32.toU32(ty)))
            }
            let diff = i32.toU32(
              if expected > got {
                expected - got
              } else {
                got - expected
              },
            )
            if diff > worst {
              worst = diff
            }
            if diff != 0 {
              differing = differing + 1
            }
            if expected != 0 {
              total = total + 1
            }
            x = x + 1
          }
          y = y + 1
        }

        // The tile is filled at small coordinates and the reference far from the origin, so f32
        // rounding may move a coverage byte by one.
        run Testing.expect(
          worst <= 1,
          "the tile is the vector fill of the same outline, within 1/255",
        )
        run Testing.expect(differing * 50 <= total, "at most 2% of the covered pixels differ")
        checked = checked + 1
        g = g + 1
      }
      v = v + 1
    }
    s = s + 1
  }
  run Testing.expect(checked == 56, "seven glyphs, four variants, two scales")
  run Testing.expect(cache.stats().misses == 56, "every key rasterized once")
}

test effect fn tilesMatchVectorFillsOfTheSameOutline() -> ()
  ! AssertionError<'static>
    | AtlasError
    | OutOfMemoryError
    | FileError
    | HostInputError
    | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tilesMatchVectorFills() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn variantsShiftCoverage() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let bytes = run readFile(SANS)
  let face = run must(run FontFace.fromBytes(1, bytes.asSlice(), 0, &[]))
  let mut glyphs = List<u32>.make()
  run glyphsOf(&face, "l", &mut glyphs)
  let mut rasterizer = GlyphRasterizer.make()
  let mut images = List<GlyphImage>.make()
  let mut v: u8 = 0
  while v < SUBPIXEL_VARIANTS {
    let mut image = GlyphImage.make()
    let outcome = run rasterizer.outline(&face, glyphs.get(0), 16.0, u8.toF64(v) * 0.25, &mut image)
    run Testing.expect(
      match &outcome {
        Outcome.Drawn => true
        Outcome.Missing => false
      },
      "drawn",
    )
    run images.append(move image)
    v = v + 1
  }

  // The left edge of the stem, read from the coverage of its first pixel in the middle row, moves
  // right by a quarter pixel per variant.
  let mut previous = 0.0
  let mut i: usize = 0
  while i < images.length() {
    let image = &images.asSlice()[i]
    let row = u32.toI32(image.height / 2)
    let mut x: i32 = 0
    while image.alphaAt(x, row) == 0 {
      x = x + 1
    }
    let edge = i32.toF64(image.left + x + 1) - u8.toF64(image.alphaAt(x, row)) / 255.0
    if i > 0 {
      run Testing.expect(f64.abs(edge - previous - 0.25) < 0.01, "a quarter pixel per variant")
    }
    previous = edge
    i = i + 1
  }
}

test effect fn subpixelVariantsShiftTheGlyphByAQuarterPixel() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run variantsShiftCoverage() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn hitsAndEmptyGlyphs() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let bytes = run readFile(SANS)
  let face = run must(run FontFace.fromBytes(7, bytes.asSlice(), 0, &[]))
  let mut glyphs = List<u32>.make()
  run glyphsOf(&face, "a b", &mut glyphs)
  run Testing.expect(glyphs.length() == 3, "a, space, b")
  let mut atlas = Atlas.make(AtlasOptions.default())
  let mut cache = GlyphCache.make()
  drop atlas.beginFrame()
  let a = run present(run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 14.0, 1.0, 0)))
  let space = run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(1), 14.0, 1.0, 0))
  run Testing.expect(
    match space {
      Option<RasterGlyph>.None => true
      _ => false
    },
    "a space has no tile",
  )
  run Testing.expect(cache.uploads().length == 1, "one upload, for the a")
  run Testing.expect(
    cache.uploadBytes().length == u32.toUsize(a.width() * a.height()),
    "one coverage byte per pixel",
  )
  run Testing.expect(a.top < 0 && a.left >= 0, "the a sits above the baseline, right of the pen")
  run Testing.expect(&a.tile.texture.kind == &Kind.Monochrome, "outlines go to A8 textures")
  cache.clearUploads()
  drop atlas.beginFrame()
  let again = run present(
    run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 14.0, 1.0, 0)),
  )
  drop run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(1), 14.0, 1.0, 0))
  run Testing.expect(&again.tile.id == &a.tile.id, "a hit returns the same tile")
  run Testing.expect(cache.uploads().length == 0, "hits upload nothing")
  let stats = cache.stats()
  run Testing.expect(stats.hits == 2 && stats.misses == 2, "two hits, two misses")
  run Testing.expect(cache.length() == 2, "the empty glyph is cached too")
  drop run present(run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 14.0, 1.0, 1)))
  drop run present(run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 14.0, 2.0, 0)))
  run Testing.expect(cache.stats().misses == 4, "another variant or scale is another key")
  run Testing.expect(atlas.tileCount() == 3, "three tiles")
}

test effect fn hitsReuseTilesAndEmptyGlyphsAreCached() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run hitsAndEmptyGlyphs() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn evictionAndRerasterization() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let bytes = run readFile(SANS)
  let face = run must(run FontFace.fromBytes(1, bytes.asSlice(), 0, &[]))
  let mut glyphs = List<u32>.make()
  run glyphsOf(&face, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", &mut glyphs)

  // One 64 x 64 texture holds one frame of 26 capitals at 14 px but not two, so the next frame's
  // capitals at another size must evict the previous frame's.
  let mut atlas = Atlas.make(
    AtlasOptions { textureSize: 64, maxTextureSize: 64, maxTextures: 1, padding: 0 },
  )
  let mut cache = GlyphCache.make()
  let mut textures = Textures.make()
  let sizes: [f32; 3] = [14.0, 15.0, 14.0]
  let mut frame: usize = 0
  while frame < 3 {
    drop atlas.beginFrame()
    let mut g: usize = 0
    while g < glyphs.length() {
      drop run present(
        run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(g), sizes[frame], 1.0, 0)),
      )
      g = g + 1
    }
    run textures.sync(&atlas, &mut cache)
    frame = frame + 1
  }
  let stats = cache.stats()
  run Testing.expect(atlas.evicted().length > 0, "the atlas evicted tiles")
  run Testing.expect(stats.misses == 52, "two sizes of 26 glyphs were new keys")
  run Testing.expect(stats.rerasterized > 0, "evicted glyphs of the first size were drawn again")
  run Testing.expect(stats.hits + stats.rerasterized == 26, "the rest of the third frame hit")
  let pruned = run cache.prune(&atlas)
  run Testing.expect(pruned > 0, "prune drops keys whose tiles were evicted")
  run Testing.expect(cache.length() == 52 - pruned, "the rest stay")
  drop atlas.beginFrame()
  drop run present(run cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 14.0, 1.0, 0)))
  run Testing.expect(
    cache.stats().hits == stats.hits + 1,
    "the latest frame's glyphs are still hits",
  )
}

test effect fn evictedGlyphsAreRasterizedAgain() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run evictionAndRerasterization() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn atlasFullWithinOneFrame() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let bytes = run readFile(SANS)
  let face = run must(run FontFace.fromBytes(1, bytes.asSlice(), 0, &[]))
  let mut glyphs = List<u32>.make()
  run glyphsOf(&face, "W", &mut glyphs)
  let mut atlas = Atlas.make(
    AtlasOptions { textureSize: 64, maxTextureSize: 64, maxTextures: 1, padding: 0 },
  )
  let mut cache = GlyphCache.make()
  drop atlas.beginFrame()
  let first = run Effect.result(
    cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 50.0, 1.0, 0)),
  )
  run Testing.expect(
    match &first {
      Result<Option<RasterGlyph>, OutOfMemoryError | AtlasError>.Success { value } => true
      _ => false
    },
    "the first W fits",
  )
  drop move first
  let second = run Effect.result(
    cache.glyph(&mut atlas, &face, keyOf(&face, glyphs.get(0), 51.0, 1.0, 0)),
  )
  let full = match move second {
    Result<Option<RasterGlyph>, OutOfMemoryError | AtlasError>.Failure {
      error
    } => match move error {
      AtlasError problem => true
      OutOfMemoryError problem => false
    }
    _ => false
  }
  run Testing.expect(full, "a second W in the same frame finds the atlas full")
  run Testing.expect(cache.length() == 1, "the refused glyph is not cached")
}

test effect fn aFullAtlasIsReportedAndNothingIsCached() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run atlasFullWithinOneFrame() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fontsAreSeparateKeys() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let sansBytes = run readFile(SANS)
  let serifBytes = run readFile(SERIF)
  let sans = run must(run FontFace.fromBytes(1, sansBytes.asSlice(), 0, &[]))
  let serif = run must(run FontFace.fromBytes(2, serifBytes.asSlice(), 0, &[]))
  let mut sansGlyphs = List<u32>.make()
  run glyphsOf(&sans, "g", &mut sansGlyphs)
  let mut serifGlyphs = List<u32>.make()
  run glyphsOf(&serif, "g", &mut serifGlyphs)
  let mut atlas = Atlas.make(AtlasOptions.default())
  let mut cache = GlyphCache.make()
  let a = run present(
    run cache.glyph(&mut atlas, &sans, keyOf(&sans, sansGlyphs.get(0), 30.0, 1.0, 0)),
  )
  let b = run present(
    run cache.glyph(&mut atlas, &serif, keyOf(&serif, serifGlyphs.get(0), 30.0, 1.0, 0)),
  )
  run Testing.expect(&a.tile.id != &b.tile.id, "two fonts, two tiles")
  run Testing.expect(cache.stats().misses == 2, "both rasterized")
}

test effect fn eachFontInstanceHasItsOwnGlyphs() -> ()
  ! AssertionError<'static> | AtlasError | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fontsAreSeparateKeys() |> Effect.provideMut<Allocator>(&mut allocator)
}
