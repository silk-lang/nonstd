import font_data { FontData }
import read { ReadError, FontRead, readWithArgs }
import font_types.lib { Scalar, OffsetValue, Nullable, offsetValue }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.u32
import silk.num.usize

pub fn nonNull<O: OffsetValue>(offset: O) -> Option<usize> {
  let raw = offsetValue<O>(move offset)
  if raw == 0 {
    return Option<usize>.None
  }
  return Option<usize>.some(u32.toUsize(raw))
}

pub fn resolveWithArgs<'a, Args, T: FontRead<'a, Args>, O: OffsetValue>(
  offset: O,
  data: FontData<'a>,
  args: Args,
) -> Result<T, ReadError> {
  let raw = offsetValue<O>(move offset)
  if raw == 0 {
    return Result<T, ReadError>.failResult(ReadError.NullOffset)
  }
  return match move FontData.splitOff(&data, u32.toUsize(raw)) {
    Option<FontData<'a>>.Some { value } => readWithArgs<Args, T>(value, move args)
    Option<FontData<'a>>.None => Result<T, ReadError>.failResult(ReadError.OutOfBounds)
  }
}

pub fn resolve<'a, T: FontRead<'a, ()>, O: OffsetValue>(offset: O, data: FontData<'a>) -> Result<
  T,
  ReadError
> {
  return resolveWithArgs<(), T, O>(move offset, data, ())
}

pub fn resolveNullableWithArgs<'a, Args, T: FontRead<'a, Args>, O: Scalar + OffsetValue + Copy>(
  offset: &Nullable<O>,
  data: FontData<'a>,
  args: Args,
) -> Option<Result<T, ReadError>> {
  if Nullable<O>.isNull(offset) {
    return Option<Result<T, ReadError>>.None
  }
  let inner = Nullable<O>.offset(offset)
  return Option<Result<T, ReadError>>.some(resolveWithArgs<Args, T, O>(inner.*, data, move args))
}

pub struct CheckedOffset {
  value: usize,
  valid: bool,
}

impl Copy for CheckedOffset {}

impl CheckedOffset {
  pub fn new(value: usize) -> CheckedOffset {
    return CheckedOffset { value: value, valid: true }
  }

  pub fn add(self: CheckedOffset, value: usize) -> CheckedOffset {
    return match move usize.checkedAdd(self.value, value) {
      Option<usize>.Some { value: sum } => CheckedOffset { value: sum, valid: self.valid }
      Option<usize>.None => CheckedOffset { value: 0, valid: false }
    }
  }

  pub fn mul(self: CheckedOffset, value: usize) -> CheckedOffset {
    return match move usize.checkedMultiply(self.value, value) {
      Option<usize>.Some { value: product } => CheckedOffset { value: product, valid: self.valid }
      Option<usize>.None => CheckedOffset { value: 0, valid: false }
    }
  }

  pub fn okOrOob(self: CheckedOffset) -> Result<usize, ReadError> {
    if !self.valid {
      return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return Result<usize, ReadError>.succeed(self.value)
  }
}

impl CheckedOffset {
  pub fn get(self: &CheckedOffset) -> Option<usize> {
    if self.valid {
      return Option<usize>.some(self.value)
    }
    return Option<usize>.None
  }

  pub fn okOr<E>(self: &CheckedOffset, error: E) -> Result<usize, E> {
    if self.valid {
      return Result<usize, E>.succeed(self.value)
    }
    return Result<usize, E>.failResult(move error)
  }
}
