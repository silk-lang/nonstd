// Ports of upstream head tests plus regression coverage for generated view semantics.
import lib { FontData, ReadError, ScalarArray }
import tables.head { Head, Flags }
import tables.maxp { Maxp }
import tables.cmap { Cmap0, Cmap4, CmapSubtable }
import font_types.lib { Fixed, LongDateTime }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      run Testing.expect(false, "table read succeeds")
      return Intrinsic.trap("unreachable after failed assertion")
    }
  }
}

test effect fn headSmokeText() -> ()
  ! AssertionError<'static> {
  let head = run must(
    Head.read(
      FontData.new(
        b"\x00\x01\x00\x00\x00\x02\xcc\xcd\x00\x00\x00\x2a\x5f\x0f\x3c\xf5\x00\x10\x10\x00\xff\xff\xff\xff\xff\xff\xfe\x0c\x00\x00\x00\x00\x00\x00\x00\x65\xff\x9c\xff\xce\x01\x90\x02\xc7\x00\x00\x00\x0c\x00\x02\x00\x01\x00\x00",
      ),
    ),
  )
  let version = Head.version(&head)
  run Testing.expect(version.major == 1 && version.minor == 0, "version")
  run Testing.expect(&Head.fontRevision(&head) == &Fixed.fromF64(2.8), "revision")
  run Testing.expect(Head.unitsPerEm(&head) == 4096, "upm")
  run Testing.expect(LongDateTime.asSecs(Head.created(&head)) == -500, "created")
  run Testing.expect(Head.yMin(&head) == -50, "bounds")
  run Testing.expect(&Head.flags(&head) == &Flags.instructionsMayAlterAdvanceWidth(), "flags")
}

test effect fn headFlags() -> ()
  ! AssertionError<'static> {
  // Exact head payload extracted from upstream font-test-data TINOS_SUBSET.
  let head = run must(
    Head.read(
      FontData.new(
        b"\x00\x01\x00\x00\x00\x01\x3b\x23\x5f\x78\xbc\xf5\x5f\x0f\x3c\xf5\x00\x19\x08\x00\x00\x00\x00\x00\xc8\x44\xd0\xce\x00\x00\x00\x00\xda\xff\x48\xed\xfb\xa6\xfd\x93\x0a\x3a\x07\xda\x00\x00\x00\x09\x00\x01\x00\x00\x00\x00",
      ),
    ),
  )
  let expected = Flags.baselineAtY0() | Flags.forceIntegerPpem()
    | Flags.instructionsMayAlterAdvanceWidth()
  run Testing.expect(&Head.flags(&head) == &expected, "original Tinos flags")
}

test effect fn generatedMinimumAndLazyOptionalFields() -> ()
  ! AssertionError<'static> {
  let bytes: [u8; 54] = [0; 54]
  let mut length: usize = 0
  while length < 54 {
    let failed = match move Head.read(FontData.new(Slice.view<u8>(&bytes, 0, length))) {
      Result<Head, ReadError>.Failure { error } => match error {
        ReadError.OutOfBounds => true
        _ => false
      }
      _ => false
    }
    run Testing.expect(failed, "every short head fails")
    length = length + 1
  }
  let maxp = run must(Maxp.read(FontData.new(b"\x00\x01\x00\x00\x00\x05")))
  run Testing.expect(Maxp.numGlyphs(&maxp) == 5, "minimum maxp accepted")
  let absent = match move Maxp.maxPoints(&maxp) {
    Option<u16>.None => true
    _ => false
  }
  run Testing.expect(absent, "truncated optional maxp field stays absent")
  let failed = match move Cmap0.read(FontData.new(b"\x00\x00\x01\x06\x00\x00")) {
    Result<Cmap0, ReadError>.Failure { error } => true
    _ => false
  }
  run Testing.expect(failed, "fixed-size array contributes to minimum")
}

test effect fn remainingArrayIgnoresIncompleteTail() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Cmap4.read(
      FontData.new(b"\x00\x04\x00\x13\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x12\x34\xff"),
    ),
  )
  let values = Cmap4.glyphIdArray(&table)
  run Testing.expect(ScalarArray<u16>.len(&values) == 1, "discard incomplete trailing scalar")
  run Testing.expect(
    (ScalarArray<u16>.get(&values, 0) |> Option<u16>.unwrapOr(0)) == 4660,
    "retain complete tail scalar",
  )
  run Testing.expect(Cmap4.glyphIdArrayByteRange(&table).end == 18, "range excludes partial item")
}

test effect fn unknownFormatPreservesDiscriminant() -> ()
  ! AssertionError<'static> {
  let result = CmapSubtable.read(FontData.new(b"\xff\xfe"))
  let correct = match move result {
    Result<CmapSubtable, ReadError>.Failure { error } => match error {
      ReadError.InvalidFormat { value } => value == 65534
      _ => false
    }
    _ => false
  }
  run Testing.expect(correct, "unknown cmap format payload")
}

import tables.hmtx { Hmtx }
import lib { formatValue }

test effect fn generatedDefaultsRetainUpstreamBackingPool() -> ()
  ! AssertionError<'static> {
  let head = Head.default()
  run Testing.expect(FontData.len(&Head.offsetData(&head)) == 262, "default pool length")
  run Testing.expect(Head.minSize() == 54 && Head.unitsPerEm(&head) == 0, "default fixed header")
  let cmap = Cmap0.default()
  run Testing.expect(
    ScalarArray<u8>.len(&Cmap0.glyphIdArray(&cmap)) == 256,
    "default fixed array retains zero elements",
  )
  let metrics = Hmtx.default()
  run Testing.expect(
    ScalarArray<i16>.len(&Hmtx.leftSideBearings(&metrics)) == 131,
    "default remainder array sees the pool",
  )
  run Testing.expect(formatValue<u16, Cmap4>() == 4, "static table format")
  run Testing.expect(&Flags.default() == &Flags.empty(), "default flags")
}
