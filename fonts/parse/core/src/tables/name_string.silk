import font_data { FontData }
import read { ReadError }
import generated_data { macRomanCode }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.text.char
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.text.format { Display, Debug, Formatter, Format }
import silk.io.writer { Writer, WriterError }

pub enum Encoding {
  Utf16Be,
  MacRoman,
  Unknown,
}

impl Encoding {
  pub fn new(platformId: u16, encodingId: u16) -> Encoding {
    if platformId == 0
      || (platformId == 3 && (encodingId == 0 || encodingId == 1 || encodingId == 10)) {
      return Encoding.Utf16Be
    }
    if platformId == 1 && encodingId == 0 {
      return Encoding.MacRoman
    }
    return Encoding.Unknown
  }
}

pub struct NameString<'a> {
  data: FontData<'a>,
  encoding: Encoding,
}

impl<'a> Copy for NameString<'a> {}

impl<'a> NameString<'a> {
  pub fn read(data: FontData<'a>, start: usize, length: usize, encoding: Encoding) -> Result<
    Self,
    ReadError
  > {
    let end = match move usize.checkedAdd(start, length) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move FontData.slice(&data, start, end) {
      Option<FontData<'a>>.Some { value } => Result<Self, ReadError>.succeed(
        Self { data: value, encoding: encoding },
      )
      Option<FontData<'a>>.None => Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }

  pub fn chars(self: &Self) -> CharIter<'a> {
    return CharIter<'a> { data: self.data, encoding: self.encoding, pos: 0 }
  }
}

pub struct CharIter<'a> {
  data: FontData<'a>,
  encoding: Encoding,
  pos: usize,
}

impl<'a> CharIter<'a> {
  pub fn new(data: FontData<'a>, encoding: Encoding) -> Self {
    return Self { data: data, encoding: encoding, pos: 0 }
  }

  fn bumpU16(self: &mut Self) -> Option<u16> {
    return match move FontData<'a>.readAt<u16>(&self.data, self.pos) {
      Result<u16, ReadError>.Success { value } => {
        self.pos = self.pos + 2
        return Option<u16>.some(value)
      }
      Result<u16, ReadError>.Failure { error } => Option<u16>.None
    }
  }

  fn bumpU8(self: &mut Self) -> Option<u8> {
    return match move FontData<'a>.readAt<u8>(&self.data, self.pos) {
      Result<u8, ReadError>.Success { value } => {
        self.pos = self.pos + 1
        return Option<u8>.some(value)
      }
      Result<u8, ReadError>.Failure { error } => Option<u8>.None
    }
  }

  pub fn next(self: &mut Self) -> Option<char> {
    if self.pos >= FontData.len(&self.data) {
      return Option<char>.None
    }
    let mut raw: u32 = 0
    match self.encoding {
      Encoding.Utf16Be => {
        let first = match move CharIter<'a>.bumpU16(&mut self) {
          Option<u16>.Some { value } => u16.toU32(value)
          Option<u16>.None => {
            return Option<char>.None
          }
        }
        if first >= 55296 && first < 56320 {
          let second = match move CharIter<'a>.bumpU16(&mut self) {
            Option<u16>.Some { value } => u16.toU32(value)
            Option<u16>.None => {
              return char.fromU32(65533)
            }
          }
          if second < 56320 || second > 57343 {
            self.pos = self.pos - 2
            return char.fromU32(65533)
          }
          raw = (first & 1023) * 1024 + (second & 1023) + 65536
        } else {
          raw = first
        }
      }
      Encoding.MacRoman => {
        let byte = match move CharIter<'a>.bumpU8(&mut self) {
          Option<u8>.Some { value } => value
          Option<u8>.None => {
            return Option<char>.None
          }
        }
        return Option<char>.some(MacRomanMapping.decode(byte))
      }
      Encoding.Unknown => {
        return Option<char>.None
      }
    }
    return match move char.fromU32(raw) {
      Option<char>.Some { value } => Option<char>.some(value)
      Option<char>.None => char.fromU32(65533)
    }
  }
}

pub struct MacRomanMapping {}

impl MacRomanMapping {
  pub fn decode(raw: u8) -> char {
    let mut code = u8.toU32(raw)
    if raw >= 128 {
      code = u16.toU32(macRomanCode(u8.toUsize(raw) - 128) |> Option<u16>.unwrapOr(65533))
    }
    return char.fromU32(code) |> Option<char>.unwrapOr('\u{fffd}')
  }

  pub fn encode(value: char) -> Option<u8> {
    let code = char.toU32(value)
    if code < 128 {
      return Option<u8>.some(u32.toU8(code))
    }
    let mut i: usize = 0
    while i < 128 {
      let mapped = macRomanCode(i) |> Option<u16>.unwrapOr(0)
      if u16.toU32(mapped) == code {
        return Option<u8>.some(usize.toU8(i + 128))
      }
      i = i + 1
    }
    return Option<u8>.None
  }
}

impl<'a> Display for NameString<'a> {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut iter = NameString<'a>.chars(self)
    while true {
      if let Option<char>.Some { value } = move CharIter<'a>.next(&mut iter) {
        run Format.format("{value}", &.{ value: value })
      } else {
        break
      }
    }
  }
}

impl<'a> Debug for NameString<'a> {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("\"")
    run Display.display(self, &mut formatter)
    run Writer.writeString("\"")
  }
}
