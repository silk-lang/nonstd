fn mapFrom<'a>(maps: &ComputedArray<'a, (), AxisValueMap<'a>>, index: usize) -> Fixed {
  return match move ComputedArray<'a, (), AxisValueMap<'a>>.get(maps, index) {
    Result<AxisValueMap<'a>, ReadError>.Success { value } => F2Dot14.toFixed(
      AxisValueMap.fromCoordinate(&value),
    )
    _ => Fixed.zero()
  }
}

fn mapTo<'a>(maps: &ComputedArray<'a, (), AxisValueMap<'a>>, index: usize) -> Fixed {
  return match move ComputedArray<'a, (), AxisValueMap<'a>>.get(maps, index) {
    Result<AxisValueMap<'a>, ReadError>.Success { value } => F2Dot14.toFixed(
      AxisValueMap.toCoordinate(&value),
    )
    _ => Fixed.zero()
  }
}

impl<'a> SegmentMaps<'a> {
  pub fn apply(self: &Self, coord: Fixed) -> Fixed {
    let maps = SegmentMaps.axisValueMaps(self)
    let len = ComputedArray<'a, (), AxisValueMap<'a>>.len(&maps)
    if len == 0 {
      return coord
    }
    if len == 1 {
      return coord - mapFrom(&maps, 0) + mapTo(&maps, 0)
    }
    let mut start: usize = 0
    let mut end = len
    if Fixed.toBits(mapFrom(&maps, 0)) == -65536 && Fixed.toBits(mapTo(&maps, 0)) == -65536
      && Fixed.toBits(mapFrom(&maps, 1)) == -65536 {
      start = 1
    }
    if Fixed.toBits(mapFrom(&maps, end - 1)) == 65536
      && Fixed.toBits(mapTo(&maps, end - 1)) == 65536
      && Fixed.toBits(mapFrom(&maps, end - 2)) == 65536 {
      end = end - 1
    }
    let mut i = start
    while i < end {
      if Fixed.toBits(coord) == Fixed.toBits(mapFrom(&maps, i)) {
        break
      }
      i = i + 1
    }
    if i < end {
      let mut j = i
      while j + 1 < end && Fixed.toBits(coord) == Fixed.toBits(mapFrom(&maps, j + 1)) {
        j = j + 1
      }
      if i == j {
        return mapTo(&maps, i)
      }
      if i + 2 == j {
        return mapTo(&maps, i + 1)
      }
      if Fixed.toBits(coord) < 0 {
        return mapTo(&maps, j)
      }
      if Fixed.toBits(coord) > 0 {
        return mapTo(&maps, i)
      }
      let first = mapTo(&maps, i)
      let last = mapTo(&maps, j)
      if Fixed.toBits(Fixed.abs(first)) < Fixed.toBits(Fixed.abs(last)) {
        return first
      }
      return last
    }
    let mut k = start
    while k < end {
      if Fixed.toBits(coord) < Fixed.toBits(mapFrom(&maps, k)) {
        break
      }
      k = k + 1
    }
    if k == start {
      return coord - mapFrom(&maps, start) + mapTo(&maps, start)
    }
    if k == end {
      return coord - mapFrom(&maps, end - 1) + mapTo(&maps, end - 1)
    }
    let beforeFrom = mapFrom(&maps, k - 1)
    let beforeTo = mapTo(&maps, k - 1)
    let numerator = mapTo(&maps, k) - beforeTo
    return beforeTo + Fixed.mulDiv(&numerator, coord - beforeFrom, mapFrom(&maps, k) - beforeFrom)
  }
}
