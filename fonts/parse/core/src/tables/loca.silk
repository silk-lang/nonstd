import font_data { FontData }
import read { ReadError, FontRead }
import array { ScalarArray }
import table_provider { TopLevelTable }
import tables.glyf { Glyf, Glyph }
import font_types.lib { Tag, GlyphId }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.num.u16
import silk.num.u32

pub union Loca<'a> {
  Short { pub data: ScalarArray<'a, u16> },
  Long { pub data: ScalarArray<'a, u32> },
}

impl<'a> Copy for Loca<'a> {}

impl<'a> TopLevelTable for Loca<'a> {
  fn tag() -> Tag {
    return Loca.tag()
  }
}

impl<'a> FontRead<'a, bool> for Loca<'a> {
  fn readWithArgs(data: FontData<'a>, args: bool) -> Result<Self, ReadError> {
    return Loca.read(data, args)
  }
}

impl<'a> Loca<'a> {
  pub fn tag() -> Tag {
    return Tag.fromU32(1819239265)
  }

  pub fn read(data: FontData<'a>, isLong: bool) -> Result<Self, ReadError> {
    if isLong {
      return match move FontData<'a>.readArray<u32>(&data, 0, FontData.len(&data)) {
        Result<ScalarArray<'a, u32>, ReadError>.Success { value } => Result<
          Self,
          ReadError
        >.succeed(Loca<'a>.Long { data: value })
        Result<ScalarArray<'a, u32>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    return match move FontData<'a>.readArray<u16>(&data, 0, FontData.len(&data)) {
      Result<ScalarArray<'a, u16>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
        Loca<'a>.Short { data: value },
      )
      Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => Result<
        Self,
        ReadError
      >.failResult(error)
    }
  }

  pub fn len(self: &Self) -> usize {
    return usize.saturatingSubtract(
      match &self.* {
        Loca<'a>.Short { data } => ScalarArray<u16>.len(&data)
        Loca<'a>.Long { data } => ScalarArray<u32>.len(&data)
      },
      1,
    )
  }

  pub fn isEmpty(self: &Self) -> bool {
    return Loca.len(self) == 0
  }

  pub fn getRaw(self: &Self, index: usize) -> Option<u32> {
    return match &self.* {
      Loca<'a>.Short { data } => match move ScalarArray<u16>.get(&data, index) {
        Option<u16>.Some { value } => Option<u32>.some(u16.toU32(value) * 2)
        _ => Option<u32>.None
      }
      Loca<'a>.Long { data } => ScalarArray<u32>.get(&data, index)
    }
  }

  pub fn allOffsetsAreAscending(self: &Self) -> bool {
    let mut i: usize = 0
    let count = Loca.len(self)
    while i < count {
      let start = Loca.getRaw(self, i) |> Option<u32>.unwrapOr(0)
      let end = Loca.getRaw(self, i + 1) |> Option<u32>.unwrapOr(0)
      if start > end {
        return false
      }
      i = i + 1
    }
    return true
  }

  pub fn get(self: &Self, gid: GlyphId, glyf: &Glyf<'a>) -> Option<LocaGlyph<'a>> {
    let index = u32.toUsize(GlyphId.toU32(gid))
    let next = match move usize.checkedAdd(index, 1) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<LocaGlyph<'a>>.None
      }
    }
    let start = match move Loca.getRaw(self, index) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<LocaGlyph<'a>>.None
      }
    }
    let end = match move Loca.getRaw(self, next) {
      Option<u32>.Some { value } => value
      _ => {
        return Option<LocaGlyph<'a>>.None
      }
    }
    if start == end {
      return Option<LocaGlyph<'a>>.some(LocaGlyph<'a>.Empty)
    }
    let data = match move FontData.slice(
      &Glyf.offsetData(glyf),
      u32.toUsize(start),
      u32.toUsize(end),
    ) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<LocaGlyph<'a>>.None
      }
    }
    return match move Glyph.read(data) {
      Result<Glyph<'a>, ReadError>.Success { value } => Option<LocaGlyph<'a>>.some(
        LocaGlyph<'a>.Glyph { value: value },
      )
      _ => Option<LocaGlyph<'a>>.None
    }
  }

  pub fn getGlyf(self: &Self, gid: GlyphId, glyf: &Glyf<'a>) -> Result<
    Option<Glyph<'a>>,
    ReadError
  > {
    return match move Loca.get(self, gid, glyf) {
      Option<LocaGlyph<'a>>.Some { value } => Result<Option<Glyph<'a>>, ReadError>.succeed(
        LocaGlyph.intoGlyph(value),
      )
      _ => Result<Option<Glyph<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
    }
  }
}

pub union LocaGlyph<'a> {
  Empty,
  Glyph { pub value: Glyph<'a> },
}

impl<'a> Copy for LocaGlyph<'a> {}

impl<'a> LocaGlyph<'a> {
  pub fn intoGlyph(self: Self) -> Option<Glyph<'a>> {
    return match self {
      LocaGlyph<'a>.Glyph { value } => Option<Glyph<'a>>.some(value)
      _ => Option<Glyph<'a>>.None
    }
  }

  pub fn glyph<'b>(self: &'b Self) -> Option<&'b Glyph<'a>> {
    return match &self.* {
      LocaGlyph<'a>.Glyph { value } => Option<&'b Glyph<'a>>.some(&value)
      _ => Option<&'b Glyph<'a>>.None
    }
  }
}
