impl<'a> Svg<'a> {
  pub fn glyphData(self: &Self, gid: GlyphId) -> Option<&'a [u8]> {
    let documents = match move Svg.svgDocumentList(self) {
      Result<SVGDocumentList<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<&'a [u8]>.None
      }
    }
    let records = SVGDocumentList.documentRecords(&documents)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), SVGDocumentRecord<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), SVGDocumentRecord<'a>>.get(&records, mid) {
        Result<SVGDocumentRecord<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<&'a [u8]>.None
        }
      }
      if u16.toU32(GlyphId16.toU16(SVGDocumentRecord.startGlyphId(&record))) > GlyphId.toU32(gid) {
        hi = mid
      } else if u16.toU32(GlyphId16.toU16(SVGDocumentRecord.endGlyphId(&record)))
        < GlyphId.toU32(gid) {
        lo = mid + 1
      } else {
        let start = SVGDocumentRecord.svgDocOffset(&record)
        let end = match move u32.checkedAdd(start, SVGDocumentRecord.svgDocLength(&record)) {
          Option<u32>.Some { value } => value
          _ => {
            return Option<&'a [u8]>.None
          }
        }
        return match move FontData.slice(
          &SVGDocumentList.offsetData(&documents),
          u32.toUsize(start),
          u32.toUsize(end),
        ) {
          Option<FontData<'a>>.Some { value } => Option<&'a [u8]>.some(FontData.asBytes(&value))
          _ => Option<&'a [u8]>.None
        }
      }
    }
    return Option<&'a [u8]>.None
  }
}
