impl<'a> SignatureRecord<'a> {
  pub fn signatureBlock(self: &Self, data: FontData<'a>) -> Option<SignatureBlockFormat1<'a>> {
    if SignatureRecord.format(self) != 1 {
      return Option<SignatureBlockFormat1<'a>>.None
    }
    let block = match move resolve<SignatureBlockFormat1<'a>, Offset32>(
      SignatureRecord.signatureBlockOffset(self),
      data,
    ) {
      Result<SignatureBlockFormat1<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<SignatureBlockFormat1<'a>>.None
      }
    }
    let length = MinByteRange.minByteRange(&block).end
    if u32.toUsize(SignatureRecord.length(self)) != length {
      return Option<SignatureBlockFormat1<'a>>.None
    }
    return Option<SignatureBlockFormat1<'a>>.some(block)
  }
}
