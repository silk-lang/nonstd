effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn present<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn none<T>(option: Option<T>) -> bool {
  return match move option {
    Option<T>.None => true
    _ => false
  }
}

fn tag(bytes: &[u8]) -> Tag {
  return Tag.fromBeBytes([bytes[0], bytes[1], bytes[2], bytes[3]])
}

effect fn baseInstance() -> BaseInstance<'static, 'static>
  ! AssertionError<'static> {
  return BaseInstance<'static, 'static>.new(run must(Base.read(FontData.new(Fixtures.baseTable()))))
}

effect fn baseline<'a, 'c>(
  instance: &BaseInstance<'a, 'c>,
  name: &[u8],
  script: &[u8],
  expected: i32,
) -> ()
  ! AssertionError<'static> {
  let value = run present(
    BaseInstance.baseline(instance, tag(name), BaseAxis.Horizontal, tag(script)),
  )
  run Testing.expect(
    F48Dot16.toBits(value) == F48Dot16.toBits(F48Dot16.fromI32(expected)),
    "baseline coordinate",
  )
}

test effect fn baseExample1() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x00\x00\x08\x01\x0c\x00\x04\x00\x12\x00\x03hangideoromn\x00\x04cyrl\x00\x1adevn\x00\x60hani\x00\x8alatn\x00\xb4"
  let base = run must(Base.read(FontData.new(bytes)))
  let version = Base.version(&base)
  run Testing.expect(version.major == 1 && version.minor == 0, "BASE version")
  let axis = run must(run present(Base.horizAxis(&base)))
  let list = run must(run present(Axis.baseTagList(&axis)))
  let tags = BaseTagList.baselineTags(&list)
  let expected = [tag(b"hang"), tag(b"ideo"), tag(b"romn")]
  let mut i: usize = 0
  while i < 3 {
    run Testing.expect(
      Tag.toU32(run present(ScalarArray<Tag>.get(&tags, i))) == Tag.toU32(expected[i]),
      "baseline tag",
    )
    i = i + 1
  }
  run Testing.expect(MinByteRange.minByteRange(&list).end == 14, "tag list extent")
  let scripts = run must(Axis.baseScriptList(&axis))
  let record = run must(
    ComputedArray<'static, (), BaseScriptRecord<'static>>.get(
      &BaseScriptList.baseScriptRecords(&scripts),
      3,
    ),
  )
  run Testing.expect(
    Tag.toU32(BaseScriptRecord.baseScriptTag(&record)) == Tag.toU32(tag(b"latn")),
    "script record",
  )
}

test effect fn scriptsMapToTheirBaseline() -> ()
  ! AssertionError<'static> {
  let scripts = [
    tag(b"Deva"),
    tag(b"Nand"),
    tag(b"Hani"),
    tag(b"Kits"),
    tag(b"Latn"),
    tag(b"Arab"),
    tag(b"Zzzz"),
    tag(b"Hang"),
  ]
  let expected = [
    Baselines.hanging(),
    Baselines.hanging(),
    Baselines.ideoFaceBottomOrLeft(),
    Baselines.ideoFaceBottomOrLeft(),
    Baselines.roman(),
    Baselines.roman(),
    Baselines.roman(),
    Baselines.ideoFaceBottomOrLeft(),
  ]
  let mut i: usize = 0
  while i < scripts.length {
    run Testing.expect(
      Tag.toU32(horizontalBaselineTagForScript(scripts[i])) == Tag.toU32(expected[i]),
      "Unicode script baseline",
    )
    i = i + 1
  }
  run Testing.expect(
    Tag.toU32(tag(b"Hang")) != Tag.toU32(Baselines.hanging()),
    "Hangul is not hanging",
  )
  let hanging = run must(ScalarArray<Tag>.new(FontData.new(Fixtures.hangingScripts())))
  let ideographic = run must(ScalarArray<Tag>.new(FontData.new(Fixtures.ideographicScripts())))
  run Testing.expect(
    ScalarArray<Tag>.len(&hanging) == 21 && ScalarArray<Tag>.len(&ideographic) == 8,
    "complete script lists",
  )
  i = 0
  while i < 21 {
    let script = run present(ScalarArray<Tag>.get(&hanging, i))
    run Testing.expect(
      Tag.toU32(horizontalBaselineTagForScript(script)) == Tag.toU32(Baselines.hanging()),
      "hanging script",
    )
    let mut j: usize = 0
    while j < 8 {
      let other = run present(ScalarArray<Tag>.get(&ideographic, j))
      run Testing.expect(Tag.toU32(script) != Tag.toU32(other), "script lists are disjoint")
      run Testing.expect(
        Tag.toU32(horizontalBaselineTagForScript(other))
          == Tag.toU32(Baselines.ideoFaceBottomOrLeft()),
        "ideographic script",
      )
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn baselinesAreFoundByTag() -> ()
  ! AssertionError<'static> {
  let instance = run baseInstance()
  run baseline(&instance, b"hang", b"latn", 700)
  run baseline(&instance, b"ideo", b"latn", -120)
  run baseline(&instance, b"romn", b"latn", 0)
  run Testing.expect(
    none(BaseInstance.baseline(&instance, tag(b"math"), BaseAxis.Horizontal, tag(b"latn"))),
    "unknown baseline",
  )
  run Testing.expect(
    none(BaseInstance.baseline(&instance, tag(b"romn"), BaseAxis.Vertical, tag(b"latn"))),
    "absent vertical axis",
  )
}

test effect fn anUnlistedScriptFallsBackToTheDefault() -> ()
  ! AssertionError<'static> {
  let instance = run baseInstance()
  run baseline(&instance, b"hang", b"arab", 600)
  run baseline(&instance, b"ideo", b"arab", -100)
  run Testing.expect(
    none(BaseInstance.baseline(&instance, tag(b"hang"), BaseAxis.Horizontal, tag(b"hani"))),
    "existing empty script does not fall back",
  )
}

test effect fn variationDeltasComeFromTheTablesOwnStore() -> ()
  ! AssertionError<'static> {
  let coords = [F2Dot14.one()]
  let base = run must(Base.read(FontData.new(Fixtures.baseTable())))
  let instance = BaseInstance.withCoords(base, &coords)
  run baseline(&instance, b"romn", b"latn", -40)
  run baseline(&instance, b"ideo", b"latn", -120)
  let plain = run baseInstance()
  run baseline(&plain, b"romn", b"latn", 0)
}

test effect fn deviceTablesAdjustByPpem() -> ()
  ! AssertionError<'static> {
  let instance = run baseInstance()
  let sizes: [u16; 3] = [10, 11, 12]
  let expected: [i32; 3] = [2, -2, 0]
  let mut i: usize = 0
  while i < 3 {
    let value = run present(
      BaseInstance.baselineForPpem(
        &instance,
        tag(b"hang"),
        BaseAxis.Horizontal,
        tag(b"latn"),
        sizes[i],
      ),
    )
    run Testing.expect(
      F48Dot16.toI32(value.value) == 700 && value.deltaPx == expected[i],
      "device pixel adjustment",
    )
    i = i + 1
  }
  let coords = [F2Dot14.one()]
  let base = run must(Base.read(FontData.new(Fixtures.baseTable())))
  let varying = BaseInstance.withCoords(base, &coords)
  let value = run present(
    BaseInstance.baselineForPpem(&varying, tag(b"romn"), BaseAxis.Horizontal, tag(b"latn"), 10),
  )
  run Testing.expect(
    F48Dot16.toI32(value.value) == -40 && value.deltaPx == 0,
    "variation is a design-unit adjustment",
  )
}

test effect fn gaspSmokeTest() -> ()
  ! AssertionError<'static> {
  let table = run must(Gasp.read(FontData.new(b"\x00\x01\x00\x02\x01\x94\x00\x03\xff\xff\x00\x0c")))
  run Testing.expect(Gasp.version(&table) == 1, "gasp version")
  let ranges = Gasp.gaspRanges(&table)
  let first = run must(ComputedArray<'static, (), GaspRange<'static>>.get(&ranges, 0))
  let last = run must(ComputedArray<'static, (), GaspRange<'static>>.get(&ranges, 1))
  run Testing.expect(
    GaspRange.rangeMaxPpem(&first) == 404
      && GaspRangeBehavior.bits(&GaspRange.rangeGaspBehavior(&first)) == 3,
    "first gasp range",
  )
  run Testing.expect(
    GaspRange.rangeMaxPpem(&last) == 65535
      && GaspRangeBehavior.bits(&GaspRange.rangeGaspBehavior(&last)) == 12,
    "second gasp range",
  )
}

fn hdmxBytes() -> &'static [u8] {
  return b"\x00\x00\x00\x03\x00\x00\x00\x08\x08\x0d\x0a\x0c\x0d\x00\x00\x00\x10\x15\x12\x14\x15\x00\x00\x00\x20\x34\x26\x28\x34\x00\x00\x00"
}

test effect fn readHdmx() -> ()
  ! AssertionError<'static> {
  let table = run must(Hdmx.read(FontData.new(hdmxBytes()), 3))
  run Testing.expect(
    Hdmx.version(&table) == 0 && Hdmx.numRecords(&table) == 3 && Hdmx.sizeDeviceRecord(&table) == 8,
    "hdmx header and aligned stride",
  )
  let expected: [[u8; 5]; 3] = [[8, 13, 10, 12, 13], [16, 21, 18, 20, 21], [32, 52, 38, 40, 52]]
  let records = Hdmx.records(&table)
  let mut i: usize = 0
  while i < 3 {
    let record = run must(
      ComputedArray<'static, ReadArgs2<u32, u32>, DeviceRecord<'static>>.get(&records, i),
    )
    let row = expected[i]
    run Testing.expect(
      DeviceRecord.pixelSize(&record) == row[0] && DeviceRecord.maxWidth(&record) == row[1],
      "device record",
    )
    let widths = DeviceRecord.widths(&record)
    run Testing.expect(widths.length == 3, "glyph count excludes padding")
    let mut j: usize = 0
    while j < 3 {
      run Testing.expect(widths[j] == row[j + 2], "device width")
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn findHdmxBySize() -> ()
  ! AssertionError<'static> {
  let table = run must(Hdmx.read(FontData.new(hdmxBytes()), 3))
  let sizes: [u8; 3] = [8, 16, 32]
  let mut i: usize = 0
  while i < 3 {
    let record = run present(Hdmx.recordForSize(&table, sizes[i]))
    run Testing.expect(DeviceRecord.pixelSize(&record) == sizes[i], "exact ppem")
    i = i + 1
  }
  run Testing.expect(
    none(Hdmx.recordForSize(&table, 7)) && none(Hdmx.recordForSize(&table, 20))
      && none(Hdmx.recordForSize(&table, 72)),
    "missing ppem",
  )
}

test effect fn statSmokeTest() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Models.vazirmatn()))
  let table = run must(FontRef.stat(&font))
  run Testing.expect(Stat.designAxisCount(&table) == 1, "one design axis")
  let axes = run must(Stat.designAxes(&table))
  let axis = run must(ComputedArray<'static, (), AxisRecord<'static>>.get(&axes, 0))
  run Testing.expect(
    Tag.toU32(AxisRecord.axisTag(&axis)) == Tag.toU32(tag(b"wght"))
      && NameId.toU16(AxisRecord.axisNameId(&axis)) == 257
      && AxisRecord.axisOrdering(&axis) == 0,
    "design axis record",
  )
  let values = run must(run present(Stat.offsetToAxisValues(&table)))
  let offsets = AxisValueArray.axisValues(&values)
  run Testing.expect(
    ArrayOfOffsets<'static, (), AxisValue<'static>, Offset16>.len(&offsets) == 3,
    "three axis values",
  )
  let last = run must(ArrayOfOffsets<'static, (), AxisValue<'static>, Offset16>.get(&offsets, 2))
  match last {
    AxisValue<'static>.Format1 { value } => {
      run Testing.expect(
        AxisValueFormat1.axisIndex(&value) == 0
          && NameId.toU16(AxisValueFormat1.valueNameId(&value)) == 264
          && Fixed.toBits(AxisValueFormat1.value(&value)) == Fixed.toBits(Fixed.fromI32(700)),
        "bold axis value",
      )
    }
    _ => {
      run Testing.expect(false, "format 1")
    }
  }
}

test effect fn parseSimpleMeta() -> ()
  ! AssertionError<'static> {
  let table = run must(Meta.read(FontData.new(Fixtures.simpleMeta())))
  let records = Meta.dataMaps(&table)
  let mut index: usize = 0
  while index < 2 {
    let record = run must(ComputedArray<'static, (), DataMapRecord<'static>>.get(&records, index))
    let mut expectedTag = dlng()
    if index == 1 {
      expectedTag = slng()
    }
    run Testing.expect(
      Tag.toU32(DataMapRecord.tag(&record)) == Tag.toU32(expectedTag),
      "metadata language tag",
    )
    let metadata = run must(DataMapRecord.data(&record, Meta.offsetData(&table)))
    match metadata {
      Metadata<'static>.ScriptLangTags { value } => {
        let mut iter = VarLenArray<'static, ScriptLangTag<'static>>.iter(&value)
        let first = run must(
          run present(VarLenIter<'static, ScriptLangTag<'static>>.next(&mut iter)),
        )
        let mut expected = "en-latn"
        if index == 1 {
          expected = "latn"
        }
        run Testing.expect(ScriptLangTag.asStr(&first) == expected, "first script-language")
        if index == 0 {
          let second = run must(
            run present(VarLenIter<'static, ScriptLangTag<'static>>.next(&mut iter)),
          )
          run Testing.expect(ScriptLangTag.asStr(&second) == "latn", "second script-language")
        }
        run Testing.expect(
          none(VarLenIter<'static, ScriptLangTag<'static>>.next(&mut iter)),
          "language list exhausted",
        )
      }
      _ => {
        run Testing.expect(false, "script-language metadata")
      }
    }
    index = index + 1
  }
}

test effect fn cvarScaledDeltas() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.cvarFont()))
  let table = run must(FontRef.cvar(&font))
  let fvar = run must(FontRef.fvar(&font))
  let mut expected = FontData.cursor(&FontData.new(Fixtures.cvarScaledExpected()))
  let cases = u16.toUsize(run must(Cursor<'static>.read<u16>(&mut expected)))
  let count = u16.toUsize(run must(Cursor<'static>.read<u16>(&mut expected)))
  run Testing.expect(count <= 256, "expectation buffer")
  let mut i: usize = 0
  while i < cases {
    let coords = [
      F2Dot14.fromBits(run must(Cursor<'static>.read<i16>(&mut expected))),
      F2Dot14.fromBits(run must(Cursor<'static>.read<i16>(&mut expected))),
    ]
    let mut storage: [i32; 256] = [0; 256]
    drop run present(Cvar.deltas(&table, Fvar.axisCount(&fvar), &coords, &mut storage))
    let mut j: usize = 0
    while j < count {
      run Testing.expect(
        storage[j] == run must(Cursor<'static>.read<i32>(&mut expected)),
        "scaled CVT delta",
      )
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn cvarRawTupleDeltas() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.cvarFont()))
  let table = run must(FontRef.cvar(&font))
  let fvar = run must(FontRef.fvar(&font))
  let data = run present(Cvar.variationData(&table, Fvar.axisCount(&fvar)))
  let mut variations = TupleVariationData<'static, CvtDelta>.tuples(&data)
  let mut expected = FontData.cursor(&FontData.new(Fixtures.cvarRawExpected()))
  let count = u16.toUsize(run must(Cursor<'static>.read<u16>(&mut expected)))
  let mut i: usize = 0
  while i < count {
    let variation = run present(TupleVariationIter<'static, CvtDelta>.next(&mut variations))
    let mut deltas = TupleVariation<'static, CvtDelta>.deltas(&variation)
    let length = u16.toUsize(run must(Cursor<'static>.read<u16>(&mut expected)))
    let mut j: usize = 0
    while j < length {
      let delta = run present(TupleDeltaIter<'static, CvtDelta>.next(&mut deltas))
      let position = run must(Cursor<'static>.read<u16>(&mut expected))
      let value = run must(Cursor<'static>.read<i32>(&mut expected))
      run Testing.expect(delta.position == position && delta.value == value, "raw CVT delta")
      j = j + 1
    }
    run Testing.expect(
      none(TupleDeltaIter<'static, CvtDelta>.next(&mut deltas)),
      "delta stream exhausted",
    )
    i = i + 1
  }
  run Testing.expect(
    none(TupleVariationIter<'static, CvtDelta>.next(&mut variations)),
    "tuple stream exhausted",
  )
}

test effect fn cpalReadSample() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.gradientFont()))
  let table = run must(FontRef.cpal(&font))
  run Testing.expect(
    Cpal.version(&table) == 0 && Cpal.numPaletteEntries(&table) == 2
      && Cpal.numPalettes(&table) == 2
      && Cpal.numColorRecords(&table) == 4,
    "palette header",
  )
  let records = run must(run present(Cpal.colorRecordsArray(&table)))
  run Testing.expect(
    ComputedArray<'static, (), ColorRecord<'static>>.len(&records) == 4,
    "four colors",
  )
  let expected: [[u8; 4]; 4] = [
    [0, 0, 255, 255],
    [0, 255, 255, 255],
    [170, 0, 255, 255],
    [170, 255, 255, 255],
  ]
  let mut i: usize = 0
  while i < 4 {
    let record = run must(ComputedArray<'static, (), ColorRecord<'static>>.get(&records, i))
    let row = expected[i]
    run Testing.expect(
      ColorRecord.red(&record) == row[0] && ColorRecord.green(&record) == row[1]
        && ColorRecord.blue(&record) == row[2]
        && ColorRecord.alpha(&record) == row[3],
      "BGRA palette color",
    )
    i = i + 1
  }
}

test effect fn cpalVersion1ArrayOffsets() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x01\x00\x01\x00\x01\x00\x00\x00\x1a\x00\x00\x00\x00\x00\x1e\x00\x00\x00\x22\x00\x00\x00\x24\x01\x02\x03\x04\x00\x00\x00\x03\x01\x01\x01\x02"
  let table = run must(Cpal.read(FontData.new(bytes)))
  let kinds = run must(run present(Cpal.paletteTypesArray(&table)))
  run Testing.expect(
    ScalarArray<PaletteType>.len(&kinds) == 1
      && PaletteType.bits(&run present(ScalarArray<PaletteType>.get(&kinds, 0))) == 3,
    "flag array count uses records, not bytes",
  )
  let labels = run must(run present(Cpal.paletteLabelsArray(&table)))
  let entries = run must(run present(Cpal.paletteEntryLabelsArray(&table)))
  run Testing.expect(
    NameId.toU16(run present(ScalarArray<NameId>.get(&labels, 0))) == 257
      && NameId.toU16(run present(ScalarArray<NameId>.get(&entries, 0))) == 258,
    "name-id arrays",
  )
}

test effect fn readDummySvgFile() -> ()
  ! AssertionError<'static> {
  let words: [u16; 32] = [
    0,
    0,
    10,
    0,
    0,
    3,
    1,
    3,
    0,
    38,
    0,
    10,
    6,
    7,
    0,
    48,
    0,
    6,
    9,
    9,
    0,
    38,
    0,
    10,
    1,
    0,
    0,
    0,
    1,
    2,
    0,
    0,
  ]
  let mut bytes: [u8; 64] = [0; 64]
  let mut i: usize = 0
  while i < 32 {
    Builder.put16(&mut bytes, i * 2, words[i])
    i = i + 1
  }
  let table = run must(Svg.read(FontData.new(&bytes)))
  i = 0
  while i < 11 {
    let data = Svg.glyphData(&table, GlyphId.new(usize.toU32(i)))
    if (i >= 1 && i <= 3) || i == 9 {
      let value = run present(move data)
      run sameBytes(value, b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01")
    } else if i == 6 || i == 7 {
      let value = run present(move data)
      run sameBytes(value, b"\x00\x02\x00\x00\x00\x00")
    } else {
      run Testing.expect(none(move data), "missing SVG glyph")
    }
    i = i + 1
  }
}

