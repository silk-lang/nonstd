test effect fn dsigEmpty() -> ()
  ! AssertionError<'static> {
  let table = run must(Dsig.read(FontData.new(b"\x00\x00\x00\x01\x00\x00\x00\x00")))
  run Testing.expect(
    Dsig.version(&table) == 1
      && ComputedArray<'static, (), SignatureRecord<'static>>.len(&Dsig.signatureRecords(&table))
        == 0
      && PermissionFlags.bits(&Dsig.flags(&table)) == 0,
    "empty signature table",
  )
}

test effect fn dsigBeef() -> ()
  ! AssertionError<'static> {
  let bytes = signatureBytes()
  let table = run must(Dsig.read(FontData.new(&bytes)))
  let records = Dsig.signatureRecords(&table)
  run Testing.expect(
    Dsig.version(&table) == 1 && signatureCount(&table) == 1
      && PermissionFlags.bits(&Dsig.flags(&table)) == 1,
    "signature header",
  )
  let record = run firstSignature(&table)
  run Testing.expect(SignatureRecord.format(&record) == 1, "signature format")
  let block = run present(SignatureRecord.signatureBlock(&record, Dsig.offsetData(&table)))
  let data = SignatureBlockFormat1.signature(&block)
  run Testing.expect(ScalarArray<u8>.len(&data) == 4, "signature length")
  let expected: [u8; 4] = [222, 173, 190, 239]
  let mut i: usize = 0
  while i < 4 {
    let actual = run present(ScalarArray<u8>.get(&data, i))
    run Testing.expect(actual == expected[i], "PKCS bytes")
    i = i + 1
  }
}

test effect fn dsigUnknownFormat() -> ()
  ! AssertionError<'static> {
  let mut bytes = signatureBytes()
  Builder.put32(&mut bytes, 8, 2)
  let table = run must(Dsig.read(FontData.new(&bytes)))
  let records = Dsig.signatureRecords(&table)
  run Testing.expect(signatureCount(&table) == 1, "one signature")
  let record = run firstSignature(&table)
  run Testing.expect(
    SignatureRecord.format(&record) == 2
      && none(SignatureRecord.signatureBlock(&record, Dsig.offsetData(&table))),
    "unknown format rejected",
  )
}

test effect fn dsigLyingLength() -> ()
  ! AssertionError<'static> {
  let mut bytes = signatureBytes()
  Builder.put32(&mut bytes, 12, 11)
  let table = run must(Dsig.read(FontData.new(&bytes)))
  let record = run firstSignature(&table)
  run Testing.expect(
    none(SignatureRecord.signatureBlock(&record, Dsig.offsetData(&table))),
    "record and block lengths disagree",
  )
}

fn signatureCount<'a>(table: &Dsig<'a>) -> usize {
  return ComputedArray<'a, (), SignatureRecord<'a>>.len(&Dsig.signatureRecords(table))
}

effect fn firstSignature<'a>(table: &Dsig<'a>) -> SignatureRecord<'a>
  ! AssertionError<'static> {
  return run must(ComputedArray<'a, (), SignatureRecord<'a>>.get(&Dsig.signatureRecords(table), 0))
}

effect fn sameBytes(actual: &[u8], expected: &[u8]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "byte length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "exact bytes")
    i = i + 1
  }
}
