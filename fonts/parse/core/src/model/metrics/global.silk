//! Font-wide measurements needed by glyph advances, origins and scaling.
import table_provider { TableProvider }
import tables.head { Head }
import tables.maxp { SelectedMaxp }
import tables.hhea { SelectedHhea }
import tables.vhea { SelectedVhea }
import tables.os2 { Os2, SelectionFlags }
import tables.mvar { Mvar, MvarInstance }
import tables.mvar.tags as Tags
import ps.cff.font { CffFontRef, Metadata }
import model.optional { Maybe }
import font_types.lib { F48Dot16, F2Dot14, Fixed, FWord, UfWord, Tag }
import silk.geometry.rect { Rect }
import read { ReadError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.i16
import silk.num.i32
import silk.num.u16

pub struct LineExtents<T> {
  pub ascender: T,
  pub descender: T,
}

impl<T: Copy> Copy for LineExtents<T> {}

pub struct LineBox<T> {
  pub ascender: T,
  pub descender: T,
  pub lineGap: T,
}

impl<T: Copy> Copy for LineBox<T> {}

impl<T> LineBox<T> {
  pub fn extents<T: Copy>(self: &Self) -> LineExtents<T> {
    return LineExtents<T> { ascender: self.ascender, descender: self.descender }
  }
}

pub struct Metrics {
  pub unitsPerEm: u16,
  pub rawUnitsPerEm: u16,
  pub numGlyphs: u32,
  pub bounds: Rect<F48Dot16>,
  pub hheaLine: Option<LineBox<F48Dot16>>,
  pub maxHAdvance: Option<F48Dot16>,
  pub vheaLine: Option<LineBox<F48Dot16>>,
  pub maxVAdvance: Option<F48Dot16>,
  pub typoLine: Option<LineBox<F48Dot16>>,
  pub useTypoMetrics: bool,
  pub winLine: Option<LineExtents<F48Dot16>>,
  pub xHeight: Option<F48Dot16>,
  pub capHeight: Option<F48Dot16>,
  pub averageCharWidth: Option<F48Dot16>,
}

pub fn unitsPerEm(stated: u16) -> u16 {
  if stated >= 16 && stated <= 16384 {
    return stated
  }
  return 1000
}

fn metric<'a, 'c>(value: i32, deltas: &Maybe<MvarInstance<'a, 'c>>, tag: Tag) -> F48Dot16 {
  let mut delta = F48Dot16.zero()
  if let Maybe<MvarInstance<'a, 'c>>.Some { value: instance } = deltas.* {
    delta = MvarInstance.get(&instance, tag) |> Option<F48Dot16>.unwrapOr(F48Dot16.zero())
  }
  return F48Dot16.fromI32(value) + delta
}

fn lineBox(ascender: F48Dot16, descender: F48Dot16, gap: F48Dot16) -> LineBox<F48Dot16> {
  return LineBox<F48Dot16> {
    ascender: F48Dot16.abs(ascender),
    descender: -F48Dot16.abs(descender),
    lineGap: gap,
  }
}

fn nonzero(line: &LineBox<F48Dot16>) -> bool {
  return F48Dot16.toBits(line.ascender) != 0 || F48Dot16.toBits(line.descender) != 0
}

impl Metrics {
  pub fn default() -> Self {
    return Self {
      unitsPerEm: 0,
      rawUnitsPerEm: 0,
      numGlyphs: 0,
      bounds: Rect<F48Dot16> {
        xMin: F48Dot16.zero(),
        yMin: F48Dot16.zero(),
        xMax: F48Dot16.zero(),
        yMax: F48Dot16.zero(),
      },
      hheaLine: Option<LineBox<F48Dot16>>.None,
      maxHAdvance: Option<F48Dot16>.None,
      vheaLine: Option<LineBox<F48Dot16>>.None,
      maxVAdvance: Option<F48Dot16>.None,
      typoLine: Option<LineBox<F48Dot16>>.None,
      useTypoMetrics: false,
      winLine: Option<LineExtents<F48Dot16>>.None,
      xHeight: Option<F48Dot16>.None,
      capHeight: Option<F48Dot16>.None,
      averageCharWidth: Option<F48Dot16>.None,
    }
  }

  pub fn fromSfnt<'a, 'c, P: TableProvider<'a>>(provider: &P, coords: &'c [F2Dot14]) -> Self {
    return Metrics.fromSfntWithVariations(provider, coords, true)
  }

  pub fn fromSfntWithVariations<'a, 'c, P: TableProvider<'a>>(
    provider: &P,
    coords: &'c [F2Dot14],
    applyVariations: bool,
  ) -> Self {
    let mut result = Metrics.default()
    let mut deltas = Maybe<MvarInstance<'a, 'c>>.None
    if applyVariations && coords.length != 0 {
      if let Result<Mvar<'a>, ReadError>.Success { value } = TableProvider.mvar(provider) {
        deltas = Maybe<MvarInstance<'a, 'c>>.fromOption(Mvar.at(&value, coords))
      }
    }
    if let Result<Head<'a>, ReadError>.Success { value } = TableProvider.head(provider) {
      result.rawUnitsPerEm = Head.unitsPerEm(&value)
      result.bounds = Rect<F48Dot16> {
        xMin: F48Dot16.fromI32(i16.toI32(Head.xMin(&value))),
        yMin: F48Dot16.fromI32(i16.toI32(Head.yMin(&value))),
        xMax: F48Dot16.fromI32(i16.toI32(Head.xMax(&value))),
        yMax: F48Dot16.fromI32(i16.toI32(Head.yMax(&value))),
      }
    }
    result.unitsPerEm = unitsPerEm(result.rawUnitsPerEm)
    if let Result<SelectedMaxp<'a>, ReadError>.Success { value } = TableProvider.selectedMaxp(
      provider,
    ) {
      result.numGlyphs = SelectedMaxp.numGlyphs(&value)
    }
    if let Result<SelectedHhea<'a>, ReadError>.Success { value } = TableProvider.selectedHhea(
      provider,
    ) {
      result.hheaLine = Option<LineBox<F48Dot16>>.some(
        lineBox(
          metric(i16.toI32(FWord.toI16(SelectedHhea.ascender(&value))), &deltas, Tags.hasc()),
          metric(i16.toI32(FWord.toI16(SelectedHhea.descender(&value))), &deltas, Tags.hdsc()),
          metric(i16.toI32(FWord.toI16(SelectedHhea.lineGap(&value))), &deltas, Tags.hlgp()),
        ),
      )
      result.maxHAdvance = Option<F48Dot16>.some(
        F48Dot16.fromI32(u16.toI32(UfWord.toU16(SelectedHhea.advanceWidthMax(&value)))),
      )
    }
    if let Result<SelectedVhea<'a>, ReadError>.Success { value } = TableProvider.selectedVhea(
      provider,
    ) {
      result.vheaLine = Option<LineBox<F48Dot16>>.some(
        lineBox(
          metric(i16.toI32(FWord.toI16(SelectedVhea.ascender(&value))), &deltas, Tags.vasc()),
          metric(i16.toI32(FWord.toI16(SelectedVhea.descender(&value))), &deltas, Tags.vdsc()),
          metric(i16.toI32(FWord.toI16(SelectedVhea.lineGap(&value))), &deltas, Tags.vlgp()),
        ),
      )
      result.maxVAdvance = Option<F48Dot16>.some(
        F48Dot16.fromI32(u16.toI32(UfWord.toU16(SelectedVhea.advanceHeightMax(&value)))),
      )
    }
    if let Result<Os2<'a>, ReadError>.Success { value } = TableProvider.os2(provider) {
      result.typoLine = Option<LineBox<F48Dot16>>.some(
        lineBox(
          metric(i16.toI32(Os2.sTypoAscender(&value)), &deltas, Tags.hasc()),
          metric(i16.toI32(Os2.sTypoDescender(&value)), &deltas, Tags.hdsc()),
          metric(i16.toI32(Os2.sTypoLineGap(&value)), &deltas, Tags.hlgp()),
        ),
      )
      result.winLine = Option<LineExtents<F48Dot16>>.some(
        LineExtents<F48Dot16> {
          ascender: metric(u16.toI32(Os2.usWinAscent(&value)), &deltas, Tags.hcla()),
          descender: -metric(u16.toI32(Os2.usWinDescent(&value)), &deltas, Tags.hcld()),
        },
      )
      result.useTypoMetrics = SelectionFlags.contains(
        &Os2.fsSelection(&value),
        SelectionFlags.useTypoMetrics(),
      )
      if let Option<i16>.Some { value: height } = Os2.sxHeight(&value) {
        result.xHeight = Option<F48Dot16>.some(metric(i16.toI32(height), &deltas, Tags.xhgt()))
      }
      if let Option<i16>.Some { value: height } = Os2.sCapHeight(&value) {
        result.capHeight = Option<F48Dot16>.some(metric(i16.toI32(height), &deltas, Tags.cpht()))
      }
      result.averageCharWidth = Option<F48Dot16>.some(
        F48Dot16.fromI32(i16.toI32(Os2.xAvgCharWidth(&value))),
      )
    }
    return move result
  }

  pub fn hLine(self: &Self) -> Option<LineBox<F48Dot16>> {
    if self.useTypoMetrics {
      if let Option<LineBox<F48Dot16>>.Some { value } = &self.typoLine {
        return Option<LineBox<F48Dot16>>.some(value)
      }
    }
    if let Option<LineBox<F48Dot16>>.Some { value } = &self.hheaLine {
      if nonzero(&value) {
        return Option<LineBox<F48Dot16>>.some(value)
      }
    }
    if let Option<LineBox<F48Dot16>>.Some { value } = &self.typoLine {
      if nonzero(&value) {
        return Option<LineBox<F48Dot16>>.some(value)
      }
    }
    if let Option<LineExtents<F48Dot16>>.Some { value } = &self.winLine {
      return Option<LineBox<F48Dot16>>.some(
        LineBox<F48Dot16> {
          ascender: value.ascender,
          descender: value.descender,
          lineGap: F48Dot16.zero(),
        },
      )
    }
    if let Option<LineBox<F48Dot16>>.Some { value } = &self.hheaLine {
      return Option<LineBox<F48Dot16>>.some(value)
    }
    return Option<LineBox<F48Dot16>>.None
  }

  pub fn fromCff(font: &CffFontRef) -> Self {
    let mut result = Metrics.default()
    let mut upem = CffFontRef.upem(font)
    if upem < 0 {
      upem = 0
    }
    if upem > 65535 {
      upem = 65535
    }
    result.rawUnitsPerEm = i32.toU16(upem)
    result.unitsPerEm = unitsPerEm(result.rawUnitsPerEm)
    result.numGlyphs = CffFontRef.numGlyphs(font)
    if let Option<Metadata>.Some { value } = CffFontRef.metadata(font) {
      let bounds = Metadata.bbox(&value)
      result.bounds = Rect<F48Dot16> {
        xMin: Fixed.toF48dot16(bounds.xMin),
        yMin: Fixed.toF48dot16(bounds.yMin),
        xMax: Fixed.toF48dot16(bounds.xMax),
        yMax: Fixed.toF48dot16(bounds.yMax),
      }
      result.hheaLine = Option<LineBox<F48Dot16>>.some(
        LineBox<F48Dot16> {
          ascender: result.bounds.yMax,
          descender: result.bounds.yMin,
          lineGap: F48Dot16.zero(),
        },
      )
    }
    return move result
  }
}
