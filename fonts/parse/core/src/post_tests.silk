import lib { FontData, ReadError }
import tables.post { Post, GlyphNames, GlyphNameEntry }
import font_types.lib { GlyphId, GlyphId16, FWord }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.usize
import silk.num.u16
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "post read succeeds")
      return Intrinsic.trap("unreachable")
    }
  }
}

fn put16(data: &mut [u8], at: usize, value: u16) -> () {
  data[at] = u16.toU8(value / 256)
  data[at + 1] = u16.toU8(value % 256)
}

fn basic(version: u8) -> [u8; 34] {
  let mut data: [u8; 34] = [0; 34]
  data[1] = version
  return data
}

test effect fn testPost() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Post.read(
      FontData.new(
        b"\x00\x02\x00\x00\x00\x00\x00\x00\xff\xb5\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x00\x03\x00\x04\x00\x06\x00\x07\x00\x08\x01\x02\x01\x03\x01\x04\x05\x68\x65\x6c\x6c\x6f\x02\x68\x69\x04\x68\x6f\x6c\x61",
      ),
    ),
  )
  run Testing.expect(FWord.toI16(Post.underlinePosition(&table)) == -75, "underline position")
  run Testing.expect(
    (Post.glyphName(&table, GlyphId16.new(1)) |> Option<string>.unwrapOr("")) == ".notdef",
    "glyph name",
  )
  run Testing.expect(
    (Post.glyphName(&table, GlyphId16.new(2)) |> Option<string>.unwrapOr("")) == "space",
    "glyph name",
  )
  run Testing.expect(
    (Post.glyphName(&table, GlyphId16.new(7)) |> Option<string>.unwrapOr("")) == "hello",
    "glyph name",
  )
  run Testing.expect(
    (Post.glyphName(&table, GlyphId16.new(8)) |> Option<string>.unwrapOr("")) == "hi",
    "glyph name",
  )
  run Testing.expect(
    (Post.glyphName(&table, GlyphId16.new(9)) |> Option<string>.unwrapOr("")) == "hola",
    "glyph name",
  )
}

test effect fn parseVersionedFieldsV1() -> ()
  ! AssertionError<'static> {
  let data = basic(1)
  let table = run must(Post.read(FontData.new(&data)))
  run Testing.expect(
    match move Post.numGlyphs(&table) {
      Option<u16>.None => true
      _ => false
    },
    "incompatible field absent",
  )
}

test effect fn parseVersionedFieldsV2() -> ()
  ! AssertionError<'static> {
  let data = basic(2)
  let table = run must(Post.read(FontData.new(&data)))
  run Testing.expect(
    (Post.numGlyphs(&table) |> Option<u16>.unwrapOr(65535)) == 0,
    "version two field present",
  )
  let short = run must(Post.read(FontData.new(Slice.view<u8>(&data, 0, 32))))
  run Testing.expect(
    match move Post.numGlyphs(&short) {
      Option<u16>.None => true
      _ => false
    },
    "short version two field absent",
  )
}

test effect fn parseVersionedFieldsV3() -> ()
  ! AssertionError<'static> {
  let data = basic(3)
  let table = run must(Post.read(FontData.new(&data)))
  run Testing.expect(
    match move Post.numGlyphs(&table) {
      Option<u16>.None => true
      _ => false
    },
    "incompatible field absent",
  )
}

test effect fn numNamesDefaultsToZeroWithoutNumGlyphs() -> ()
  ! AssertionError<'static> {
  let data = basic(2)
  let table = run must(Post.read(FontData.new(Slice.view<u8>(&data, 0, 32))))
  run Testing.expect(Post.numNames(&table) == 0, "missing count defaults to zero")
}

test effect fn glyphNameMissingStringDataReturnsNone() -> ()
  ! AssertionError<'static> {
  let mut data: [u8; 36] = [0; 36]
  data[1] = 2
  put16(&mut data, 32, 1)
  put16(&mut data, 34, 258)
  let table = run must(Post.read(FontData.new(&data)))
  run Testing.expect(
    match move Post.glyphName(&table, GlyphId16.new(0)) {
      Option<string>.None => true
      _ => false
    },
    "missing string is absent",
  )
}

test effect fn glyphNamesSkipANameThatCannotBeRead() -> ()
  ! AssertionError<'static> {
  let mut data: [u8; 43] = [0; 43]
  data[1] = 2
  put16(&mut data, 32, 3)
  put16(&mut data, 34, 258)
  put16(&mut data, 36, 267)
  put16(&mut data, 38, 3)
  data[40] = 2
  data[41] = 111
  data[42] = 107
  let table = run must(Post.read(FontData.new(&data)))
  let mut names = Post.glyphNames(&table)
  let first = move GlyphNames.next(&mut names)
    |> Option<GlyphNameEntry>.unwrapOr(GlyphNameEntry { glyph: GlyphId.new(99), name: "" })
  let last = move GlyphNames.next(&mut names)
    |> Option<GlyphNameEntry>.unwrapOr(GlyphNameEntry { glyph: GlyphId.new(99), name: "" })
  run Testing.expect(GlyphId.toU32(first.glyph) == 0 && first.name == "ok", "first name")
  run Testing.expect(GlyphId.toU32(last.glyph) == 2 && last.name == "space", "skip bad string")
  run Testing.expect(
    match move GlyphNames.next(&mut names) {
      Option<GlyphNameEntry>.None => true
      _ => false
    },
    "iterator exhausted",
  )
}

test effect fn glyphNamesPastTheStringDataStayLinear() -> ()
  ! AssertionError<'static> {
  let mut data: [u8; 142666] = [0; 142666]
  data[1] = 2
  put16(&mut data, 32, 65535)
  let mut i: usize = 0
  while i < 65535 {
    let mut index: u16 = 60258
    if i < 2 {
      index = usize.toU16(258 + i)
    }
    put16(&mut data, 34 + i * 2, index)
    i = i + 1
  }
  i = 131104
  while i < data.length {
    data[i] = 2
    data[i + 1] = 97
    data[i + 2] = 98
    i = i + 3
  }
  let table = run must(Post.read(FontData.new(&data)))
  let mut names = Post.glyphNames(&table)
  let mut count: u32 = 0
  while true {
    match move GlyphNames.next(&mut names) {
      Option<GlyphNameEntry>.Some { value } => {
        run Testing.expect(
          GlyphId.toU32(value.glyph) == count && value.name == "ab",
          "only first two readable",
        )
        count = count + 1
      }
      _ => {
        break
      }
    }
  }
  run Testing.expect(count == 2, "linear missing-string iterator")
}

test effect fn glyphNamesMatchesNaivePastTheLastCheckpoint() -> ()
  ! AssertionError<'static> {
  let mut data: [u8; 248] = [0; 248]
  data[1] = 2
  put16(&mut data, 32, 2)
  put16(&mut data, 34, 308)
  put16(&mut data, 36, 288)
  let mut i: usize = 0
  while i < 70 {
    data[38 + i * 3] = 2
    data[39 + i * 3] = usize.toU8(97 + i / 26)
    data[40 + i * 3] = usize.toU8(97 + i % 26)
    i = i + 1
  }
  let table = run must(Post.read(FontData.new(&data)))
  let mut names = Post.glyphNames(&table)
  let expected: [string; 2] = ["by", "be"]
  i = 0
  while i < 2 {
    let name = move GlyphNames.next(&mut names)
      |> Option<GlyphNameEntry>.unwrapOr(GlyphNameEntry { glyph: GlyphId.new(99), name: "" })
    run Testing.expect(name.name == expected[i], "checkpoint beyond last slot")
    run Testing.expect(
      (Post.glyphName(&table, GlyphId16.new(usize.toU16(i))) |> Option<string>.unwrapOr(""))
        == name.name,
      "iterator equals naive",
    )
    i = i + 1
  }
}

fn mappedIndex(gid: usize, order: usize) -> usize {
  if order == 2 {
    return 1999
  }
  if order == 1 {
    if gid > 0 && gid % 97 == 0 {
      return gid - 1
    }
    if gid > 3 && gid % 251 == 0 {
      return gid - 3
    }
    if gid > 7 && gid % 509 == 0 {
      return gid - 7
    }
  }
  return gid
}

test effect fn glyphNamesMatchesNaiveOnVariedSyntheticV2Data() -> ()
  ! AssertionError<'static> {
  let patterns: [string; 4] = [
    "abcdefghijklmnopqrstuvwxyz0123456789",
    "zyxwvutsrqponmlkjihgfedcba9876543210",
    "aabccddeeffgghhiijjkkllmmnnooppqqrrss",
    "n0nlinear_name_pattern_block_",
  ]
  let mut order: usize = 0
  while order < 3 {
    let mut data: [u8; 200000] = [0; 200000]
    data[1] = 2
    put16(&mut data, 32, 2000)
    let mut starts: [usize; 2000] = [0; 2000]
    let mut i: usize = 0
    let mut position: usize = 4034
    while i < 2000 {
      put16(&mut data, 34 + i * 2, usize.toU16(258 + mappedIndex(i, order)))
      starts[i] = position + 1
      let length = 63 + i % 27
      data[position] = usize.toU8(length)
      let prefix = b"glyph_00000_"
      let mut j: usize = 0
      while j < prefix.length {
        data[position + 1 + j] = prefix[j]
        j = j + 1
      }
      let mut number = i
      j = 11
      while j > 6 {
        data[position + j] = usize.toU8(48 + number % 10)
        number = number / 10
        j = j - 1
      }
      let pattern = String.utf8Bytes(patterns[i % 4])
      j = 12
      while j < length {
        data[position + 1 + j] = pattern[(j - 12) % pattern.length]
        j = j + 1
      }
      position = position + 1 + length
      i = i + 1
    }
    let table = run must(Post.read(FontData.new(Slice.view<u8>(&data, 0, position))))
    let mut names = Post.glyphNames(&table)
    i = 0
    while i < 2000 {
      let entry = move GlyphNames.next(&mut names)
        |> Option<GlyphNameEntry>.unwrapOr(GlyphNameEntry { glyph: GlyphId.new(9999), name: "" })
      let naive = Post.glyphName(&table, GlyphId16.new(usize.toU16(i)))
        |> Option<string>.unwrapOr("")
      run Testing.expect(
        entry.name == naive && GlyphId.toU32(entry.glyph) == usize.toU32(i),
        "cached iterator equals naive",
      )
      let actual = String.utf8Bytes(entry.name)
      let target = mappedIndex(i, order)
      run Testing.expect(actual.length == 63 + target % 27, "varied name length")
      let mut j: usize = 0
      while j < actual.length {
        run Testing.expect(actual[j] == data[starts[target] + j], "expected custom name")
        j = j + 1
      }
      i = i + 1
    }
    order = order + 1
  }
}
