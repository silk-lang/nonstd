impl Tables {
  pub fn varc<'a>(self: &'a Self) -> Result<Varc<'a>, ReadError> {
    let view = Tables.view(self)
    return TableProvider.varc(&view)
  }

  pub fn math<'a>(self: &'a Self) -> Result<Math<'a>, ReadError> {
    let view = Tables.view(self)
