//! Stable byte ownership and table access without self-referential views.
import model.font.blob { Blob }
import font { FontRef, TableDirectory, TableRecords, TableRecord }
import font_data { FontData }
import read { ReadError }
import table_provider { TableProvider, GlyfLoca }
import font_types.lib { Tag }
