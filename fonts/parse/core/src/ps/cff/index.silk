import font_data { FontData }
import read { ReadError }
import model.error { Error }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.u16
pub import generated_cff { Index as Index1 }
pub import generated_cff2 { Index as Index2 }

pub union Index<'a> {
  Empty,
  Format1 { pub value: Index1<'a> },
  Format2 { pub value: Index2<'a> },
}

impl<'a> Copy for Index<'a> {}

impl<'a> Index<'a> {
  pub fn default() -> Self {
    return Index<'a>.Empty
  }

  pub fn new(bytes: &'a [u8], isCff2: bool) -> Result<Self, Error> {
    let data = FontData.new(bytes)
    if isCff2 {
      if bytes.length == 4 {
        if (FontData<'a>.readAt<u32>(&data, 0) |> Result<u32, ReadError>.unwrapOr(1)) == 0 {
          return Result<Self, Error>.succeed(Index<'a>.Empty)
        }
      }
      return match move Index2.read(data) {
        Result<Index2<'a>, ReadError>.Success { value } => Result<Self, Error>.succeed(
          Index<'a>.Format2 { value: value },
        )
        _ => Result<Self, Error>.failResult(Error.Malformed)
      }
    }
    if bytes.length == 2 {
      if (FontData<'a>.readAt<u16>(&data, 0) |> Result<u16, ReadError>.unwrapOr(1)) == 0 {
        return Result<Self, Error>.succeed(Index<'a>.Empty)
      }
    }
    return match move Index1.read(data) {
      Result<Index1<'a>, ReadError>.Success { value } => Result<Self, Error>.succeed(
        Index<'a>.Format1 { value: value },
      )
      _ => Result<Self, Error>.failResult(Error.Malformed)
    }
  }

  pub fn count(self: &Self) -> u32 {
    return match &self.* {
      Index<'a>.Empty => 0
      Index<'a>.Format1 { value } => u16.toU32(Index1.count(&value))
      Index<'a>.Format2 { value } => Index2.count(&value)
    }
  }

  pub fn subrBias(self: &Self) -> i32 {
    let count = Index.count(self)
    if count < 1240 {
      return 107
    }
    if count < 33900 {
      return 1131
    }
    return 32768
  }

  pub fn sizeInBytes(self: &Self) -> Option<usize> {
    return match &self.* {
      Index<'a>.Empty => Option<usize>.some(0)
      Index<'a>.Format1 { value } => Index1.sizeInBytes(&value)
      Index<'a>.Format2 { value } => Index2.sizeInBytes(&value)
    }
  }

  pub fn getOffset(self: &Self, index: usize) -> Option<usize> {
    return match &self.* {
      Index<'a>.Empty => Option<usize>.None
      Index<'a>.Format1 { value } => Index1.getOffset(&value, index)
      Index<'a>.Format2 { value } => Index2.getOffset(&value, index)
    }
  }

  pub fn get(self: &Self, index: usize) -> Option<&'a [u8]> {
    return match &self.* {
      Index<'a>.Empty => Option<&'a [u8]>.None
      Index<'a>.Format1 { value } => Index1.get(&value, index)
      Index<'a>.Format2 { value } => Index2.get(&value, index)
    }
  }

  pub fn offSize(self: &Self) -> u8 {
    return match &self.* {
      Index<'a>.Empty => 0
      Index<'a>.Format1 { value } => Index1.offSize(&value)
      Index<'a>.Format2 { value } => Index2.offSize(&value)
    }
  }
}
