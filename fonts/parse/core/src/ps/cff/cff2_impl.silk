pub struct Cff2<'a> {
  _header: Cff2Header<'a>,
  _globalSubrs: Index<'a>,
}

impl<'a> Copy for Cff2<'a> {}

impl<'a> Cff2<'a> {
  pub fn tag() -> Tag {
    return Tag.fromU32(1128678962)
  }

  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let header = match move Cff2Header.read(data) {
      Result<Cff2Header<'a>, ReadError>.Success { value } => value
      Result<Cff2Header<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let subrs = match move Index.read(
      ScalarArray<u8>.offsetData(&Cff2Header.trailingData(&header)),
    ) {
      Result<Index<'a>, ReadError>.Success { value } => value
      Result<Index<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { _header: header, _globalSubrs: subrs })
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return Cff2Header.offsetData(&self._header)
  }

  pub fn header(self: &Self) -> Cff2Header<'a> {
    return self._header
  }

  pub fn topDictData(self: &Self) -> &'a [u8] {
    return FontData.asBytes(&ScalarArray<u8>.offsetData(&Cff2Header.topDictData(&self._header)))
  }

  pub fn globalSubrs(self: &Self) -> Index<'a> {
    return self._globalSubrs
  }
}

impl<'a> TopLevelTable for Cff2<'a> {
  fn tag() -> Tag {
    return Cff2.tag()
  }
}

impl<'a> FontRead<'a, ()> for Cff2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Cff2.read(data)
  }
}
