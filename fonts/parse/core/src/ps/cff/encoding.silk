import ps.cff.charset { Charset }
import ps.encoding { PredefinedEncoding }
import ps.string { Sid }
import font_data { FontData, Cursor }
import read { ReadError }
import array { ScalarArray, ComputedArray }
import font_types.lib { GlyphId }
pub import generated_cff { EncodingRange1 as Range1, EncodingSupplement as Supplement }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.usize

pub union Encoding<'a> {
  Predefined { pub value: PredefinedEncoding },
  Custom { pub value: CustomEncoding<'a> },
}

impl<'a> Copy for Encoding<'a> {}

impl<'a> Encoding<'a> {
  pub fn new(data: &'a [u8], offset: usize) -> Option<Self> {
    if offset == 0 {
      return Option<Self>.some(Encoding<'a>.Predefined { value: PredefinedEncoding.Standard })
    }
    if offset == 1 {
      return Option<Self>.some(Encoding<'a>.Predefined { value: PredefinedEncoding.Expert })
    }
    let tail = match move FontData.splitOff(&FontData.new(data), offset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    return match move CustomEncoding.new(FontData.asBytes(&tail)) {
      Option<CustomEncoding<'a>>.Some { value } => Option<Self>.some(
        Encoding<'a>.Custom { value: value },
      )
      _ => Option<Self>.None
    }
  }

  pub fn map(self: &Self, charset: &Charset<'a>, code: u8) -> Option<GlyphId> {
    return match &self.* {
      Encoding<'a>.Predefined { value } => match move PredefinedEncoding.sid(&value, code) {
        Option<Sid>.Some { value: sid } => Charset.glyphId(charset, sid)
        _ => Option<GlyphId>.None
      }
      Encoding<'a>.Custom { value } => CustomEncoding.map(&value, charset, code)
    }
  }
}

pub union CustomEncoding<'a> {
  Format0 {
    pub codes: ScalarArray<'a, u8>,
    pub supplements: ComputedArray<'a, (), Supplement<'a>>
  },
  Format1 {
    pub ranges: ComputedArray<'a, (), Range1<'a>>,
    pub supplements: ComputedArray<'a, (), Supplement<'a>>
  },
}

impl<'a> Copy for CustomEncoding<'a> {}

fn readSupplements<'a>(cursor: &mut Cursor<'a>, hasSupplement: bool) -> Option<
  ComputedArray<'a, (), Supplement<'a>>
> {
  let mut count: u8 = 0
  if hasSupplement {
    count = match move Cursor<'a>.read<u8>(&mut cursor) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return Option<ComputedArray<'a, (), Supplement<'a>>>.None
      }
    }
  }
  return match move Cursor<'a>.readComputedArray<(), Supplement<'a>>(
    &mut cursor,
    u8.toUsize(count),
    (),
  ) {
    Result<ComputedArray<'a, (), Supplement<'a>>, ReadError>.Success { value } => Option<
      ComputedArray<'a, (), Supplement<'a>>
    >.some(value)
    _ => Option<ComputedArray<'a, (), Supplement<'a>>>.None
  }
}

fn readSupplement<'a>(
  sup: ComputedArray<'a, (), Supplement<'a>>,
  charset: &Charset<'a>,
  code: u8,
) -> Option<GlyphId> {
  let mut i: usize = 0
  while i < ComputedArray<'a, (), Supplement<'a>>.len(&sup) {
    let item = match move ComputedArray<'a, (), Supplement<'a>>.get(&sup, i) {
      Result<Supplement<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<GlyphId>.None
      }
    }
    if Supplement.code(&item) == code {
      return Charset.glyphId(charset, Sid.new(Supplement.glyph(&item)))
    }
    i = i + 1
  }
  return Option<GlyphId>.None
}

impl<'a> CustomEncoding<'a> {
  pub fn new(data: &'a [u8]) -> Option<Self> {
    let mut cursor = FontData.cursor(&FontData.new(data))
    let header = match move Cursor<'a>.read<u8>(&mut cursor) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    let format = header & 127
    if format > 1 {
      return Option<Self>.None
    }
    let count = match move Cursor<'a>.read<u8>(&mut cursor) {
      Result<u8, ReadError>.Success { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    if format == 0 {
      let codes = match move Cursor<'a>.readArray<u8>(&mut cursor, u8.toUsize(count)) {
        Result<ScalarArray<'a, u8>, ReadError>.Success { value } => value
        _ => {
          return Option<Self>.None
        }
      }
      let sup = match move readSupplements(&mut cursor, header & 128 != 0) {
        Option<ComputedArray<'a, (), Supplement<'a>>>.Some { value } => value
        _ => {
          return Option<Self>.None
        }
      }
      return Option<Self>.some(CustomEncoding<'a>.Format0 { codes: codes, supplements: sup })
    }
    let ranges = match move Cursor<'a>.readComputedArray<(), Range1<'a>>(
      &mut cursor,
      u8.toUsize(count),
      (),
    ) {
      Result<ComputedArray<'a, (), Range1<'a>>, ReadError>.Success { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    let sup = match move readSupplements(&mut cursor, header & 128 != 0) {
      Option<ComputedArray<'a, (), Supplement<'a>>>.Some { value } => value
      _ => {
        return Option<Self>.None
      }
    }
    return Option<Self>.some(CustomEncoding<'a>.Format1 { ranges: ranges, supplements: sup })
  }

  pub fn map(self: &Self, charset: &Charset<'a>, code: u8) -> Option<GlyphId> {
    return match &self.* {
      CustomEncoding<'a>.Format0 { codes, supplements } => {
        match move readSupplement(supplements, charset, code) {
          Option<GlyphId>.Some { value } => {
            return Option<GlyphId>.some(value)
          }
          _ => {}
        }
        let mut i: usize = 0
        while i < ScalarArray<u8>.len(&codes) {
          if (ScalarArray<u8>.get(&codes, i) |> Option<u8>.unwrapOr(0)) == code {
            return Option<GlyphId>.some(GlyphId.new(usize.toU32(i) + 1))
          }
          i = i + 1
        }
        return Option<GlyphId>.None
      }
      CustomEncoding<'a>.Format1 { ranges, supplements } => {
        match move readSupplement(supplements, charset, code) {
          Option<GlyphId>.Some { value } => {
            return Option<GlyphId>.some(value)
          }
          _ => {}
        }
        let mut i: usize = 0
        let mut gid: u32 = 1
        while i < ComputedArray<'a, (), Range1<'a>>.len(&ranges) {
          let range = match move ComputedArray<'a, (), Range1<'a>>.get(&ranges, i) {
            Result<Range1<'a>, ReadError>.Success { value } => value
            _ => {
              return Option<GlyphId>.None
            }
          }
          let first = Range1.first(&range)
          let left = Range1.nLeft(&range)
          let end = u8.saturatingAdd(first, left)
          if code >= first && code <= end {
            return Option<GlyphId>.some(GlyphId.new(gid + u8.toU32(code - first)))
          }
          gid = gid + u8.toU32(left) + 1
          i = i + 1
        }
        return Option<GlyphId>.None
      }
    }
  }
}
