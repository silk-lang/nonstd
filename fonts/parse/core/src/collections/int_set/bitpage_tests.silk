// Ports of all 27 upstream collections/int_set/bitpage.rs tests.
import collections.int_set.bitpage { BitPage, BitIter, PageIter, RangeIter, U32Range }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.hash { Hash }
import silk.collections.hash_set { HashSet }
import silk.num.u32
import silk.num.u64

fn page(values: &[u32]) -> BitPage {
  let mut result = BitPage.newZeroes()
  let mut i: usize = 0
  while i < values.length {
    drop BitPage.insert(&mut result, values[i])
    i = i + 1
  }
  return result
}

fn optional(input: Option<u32>, expected: i64) -> bool {
  return match move input {
    Option<u32>.Some { value } => u32.toI64(value) == expected
    _ => expected == -1
  }
}

effect fn pageItems(value: &BitPage, from: u32, reverse: bool, expected: &[u32]) -> ()
  ! AssertionError<'static> {
  let mut iter = BitPage.iterFrom(value, from)
  let mut i: usize = 0
  while i < expected.length {
    let mut found = Option<u32>.None
    if reverse {
      found = PageIter.nextBack(&mut iter)
    } else {
      found = PageIter.next(&mut iter)
    }
    run Testing.expect(optional(move found, u32.toI64(expected[i])), "page iteration")
    i = i + 1
  }
  run Testing.expect(
    optional(PageIter.next(&mut iter), -1) && optional(PageIter.nextBack(&mut iter), -1),
    "iterator exhausted",
  )
}

effect fn bitItems(bits: u64, expected: &[u32]) -> ()
  ! AssertionError<'static> {
  let mut iter = BitIter.new(bits)
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(optional(BitIter.next(&mut iter), u32.toI64(expected[i])), "bit indices")
    i = i + 1
  }
  run Testing.expect(optional(BitIter.next(&mut iter), -1), "bit iterator exhausted")
}

effect fn ranges(expected: &[U32Range]) -> ()
  ! AssertionError<'static> {
  let mut value = BitPage.newZeroes()
  let mut i: usize = 0
  while i < expected.length {
    BitPage.insertRange(&mut value, expected[i].first, expected[i].last)
    i = i + 1
  }
  let mut iter = BitPage.iterRanges(&value)
  i = 0
  while i < expected.length {
    let got = match move RangeIter.next(&mut iter) {
      Option<U32Range>.Some { value: found } => found
      _ => {
        run Testing.expect(false, "range exists")
        return
      }
    }
    run Testing.expect(
      got.first == expected[i].first && got.last == expected[i].last,
      "range bounds",
    )
    i = i + 1
  }
  run Testing.expect(
    match move RangeIter.next(&mut iter) {
      Option<U32Range>.None => true
      _ => false
    },
    "range iterator exhausted",
  )
}

test effect fn testIterBitIndices() -> ()
  ! AssertionError<'static> {
  run bitItems(0, &[])
  run bitItems(1, &[0])
  run bitItems(12, &[2, 3])
  run bitItems(u64.shiftLeft(1, 63), &[63])
  run bitItems(u64.shiftLeft(1, 47) | u64.shiftLeft(1, 63), &[47, 63])
  let mut iter = BitIter.new(u64.MAX)
  run Testing.expect(
    optional(BitIter.next(&mut iter), 0) && optional(BitIter.nextBack(&mut iter), 63),
    "minimum and maximum bit",
  )
}

test effect fn firstFrom() -> ()
  ! AssertionError<'static> {
  let empty = BitPage.newZeroes()
  run Testing.expect(
    optional(BitPage.firstFrom(&empty, 0), -1) && optional(BitPage.firstFrom(&empty, 511), -1),
    "no candidate",
  )
  let mut value = BitPage.newZeroes()
  let items: [u32; 5] = [3, 63, 64, 200, 511]
  let mut i: usize = 0
  while i < 5 {
    drop BitPage.insert(&mut value, items[i])
    i = i + 1
  }
  run Testing.expect(optional(BitPage.firstFrom(&value, 0), 3), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 3), 3), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 4), 63), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 63), 63), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 64), 64), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 65), 200), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 201), 511), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 511), 511), "first candidate")
  run Testing.expect(optional(BitPage.firstFrom(&value, 516), 63), "first candidate")
  let full = BitPage.newOnes()
  let mut n: u32 = 0
  while n < 512 {
    run Testing.expect(optional(BitPage.firstFrom(&full, n), u32.toI64(n)), "all candidates")
    n = n + 1
  }
}

test effect fn firstAbsentFrom() -> ()
  ! AssertionError<'static> {
  let empty = BitPage.newOnes()
  run Testing.expect(
    optional(BitPage.firstAbsentFrom(&empty, 0), -1)
      && optional(BitPage.firstAbsentFrom(&empty, 511), -1),
    "no candidate",
  )
  let mut value = BitPage.newOnes()
  let items: [u32; 5] = [3, 63, 64, 200, 511]
  let mut i: usize = 0
  while i < 5 {
    drop BitPage.remove(&mut value, items[i])
    i = i + 1
  }
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 0), 3), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 3), 3), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 4), 63), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 63), 63), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 64), 64), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 65), 200), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 201), 511), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 511), 511), "first candidate")
  run Testing.expect(optional(BitPage.firstAbsentFrom(&value, 516), 63), "first candidate")
  let full = BitPage.newZeroes()
  let mut n: u32 = 0
  while n < 512 {
    run Testing.expect(optional(BitPage.firstAbsentFrom(&full, n), u32.toI64(n)), "all candidates")
    n = n + 1
  }
}

test effect fn testIterBitIndicesBackwards() -> ()
  ! AssertionError<'static> {
  let mut empty = BitIter.new(0)
  run Testing.expect(
    optional(BitIter.next(&mut empty), -1) && optional(BitIter.nextBack(&mut empty), -1),
    "empty both ends",
  )
  let mut iter = BitIter.new(126)
  run Testing.expect(optional(BitIter.next(&mut iter), 1), "mixed directions")
  run Testing.expect(optional(BitIter.nextBack(&mut iter), 6), "mixed directions")
  run Testing.expect(optional(BitIter.nextBack(&mut iter), 5), "mixed directions")
  run Testing.expect(optional(BitIter.next(&mut iter), 2), "mixed directions")
  run Testing.expect(optional(BitIter.next(&mut iter), 3), "mixed directions")
  run Testing.expect(optional(BitIter.next(&mut iter), 4), "mixed directions")
  run Testing.expect(optional(BitIter.next(&mut iter), -1), "mixed directions")
  run Testing.expect(optional(BitIter.nextBack(&mut iter), -1), "mixed directions")
  let mut it1 = BitIter.new(1)
  run Testing.expect(optional(BitIter.nextBack(&mut it1), 0), "reverse bit indices")
  run Testing.expect(optional(BitIter.nextBack(&mut it1), -1), "reverse bit indices")
  let mut it9223372036854775808 = BitIter.new(9223372036854775808)
  run Testing.expect(
    optional(BitIter.nextBack(&mut it9223372036854775808), 63),
    "reverse bit indices",
  )
  run Testing.expect(
    optional(BitIter.nextBack(&mut it9223372036854775808), -1),
    "reverse bit indices",
  )
  let mut it13835058055282163712 = BitIter.new(13835058055282163712)
  run Testing.expect(
    optional(BitIter.nextBack(&mut it13835058055282163712), 63),
    "reverse bit indices",
  )
  run Testing.expect(
    optional(BitIter.nextBack(&mut it13835058055282163712), 62),
    "reverse bit indices",
  )
  run Testing.expect(
    optional(BitIter.nextBack(&mut it13835058055282163712), -1),
    "reverse bit indices",
  )
  let mut it9223372041149743104 = BitIter.new(9223372041149743104)
  run Testing.expect(
    optional(BitIter.nextBack(&mut it9223372041149743104), 63),
    "reverse bit indices",
  )
  run Testing.expect(
    optional(BitIter.nextBack(&mut it9223372041149743104), 32),
    "reverse bit indices",
  )
  run Testing.expect(
    optional(BitIter.nextBack(&mut it9223372041149743104), -1),
    "reverse bit indices",
  )
}

test effect fn pageInit() -> ()
  ! AssertionError<'static> {
  let value = BitPage.newZeroes()
  run Testing.expect(BitPage.len(&value) == 0 && BitPage.isEmpty(&value), "initial page")
}

test effect fn pageInitOnes() -> ()
  ! AssertionError<'static> {
  let value = BitPage.newOnes()
  run Testing.expect(BitPage.len(&value) == 512 && !BitPage.isEmpty(&value), "initial page")
}

test effect fn pageContainsEmpty() -> ()
  ! AssertionError<'static> {
  let value = BitPage.newZeroes()
  run Testing.expect(
    !BitPage.contains(&value, 0) && !BitPage.contains(&value, 1)
      && !BitPage.contains(&value, 75475),
    "modulo membership",
  )
}

test effect fn pageContainsAll() -> ()
  ! AssertionError<'static> {
  let value = BitPage.newOnes()
  run Testing.expect(
    BitPage.contains(&value, 0) && BitPage.contains(&value, 1) && BitPage.contains(&value, 75475),
    "modulo membership",
  )
}

test effect fn pageInsert() -> ()
  ! AssertionError<'static> {
  let mut n: u32 = 0
  while n <= 1025 {
    let mut value = BitPage.newZeroes()
    run Testing.expect(!BitPage.contains(&value, n), "absent before insertion")
    drop BitPage.insert(&mut value, n)
    run Testing.expect(
      BitPage.contains(&value, n) && !BitPage.contains(&value, u32.wrappingSubtract(n, 1)),
      "only inserted value",
    )
    n = n + 1
  }
}

test effect fn pageInsertRange() -> ()
  ! AssertionError<'static> {
  let cases: [U32Range; 10] = [
    U32Range { first: 0, last: 0 },
    U32Range { first: 0, last: 1 },
    U32Range { first: 1, last: 15 },
    U32Range { first: 5, last: 63 },
    U32Range { first: 64, last: 67 },
    U32Range { first: 69, last: 72 },
    U32Range { first: 69, last: 127 },
    U32Range { first: 32, last: 345 },
    U32Range { first: 544, last: 857 },
    U32Range { first: 0, last: 511 },
  ]
  let mut i: usize = 0
  while i < 10 {
    let mut value = BitPage.newZeroes()
    let mut expected = BitPage.newZeroes()
    let r = cases[i]
    BitPage.insertRange(&mut value, r.first, r.last)
    let mut n = r.first
    while n <= r.last {
      drop BitPage.insert(&mut expected, n)
      n = n + 1
    }
    run Testing.expect(
      BitPage.equals(&value, &expected) && BitPage.len(&value) == BitPage.len(&expected),
      "range matches individual changes",
    )
    i = i + 1
  }
}

test effect fn pageRemoveRange() -> ()
  ! AssertionError<'static> {
  let cases: [U32Range; 10] = [
    U32Range { first: 0, last: 0 },
    U32Range { first: 0, last: 1 },
    U32Range { first: 1, last: 15 },
    U32Range { first: 5, last: 63 },
    U32Range { first: 64, last: 67 },
    U32Range { first: 69, last: 72 },
    U32Range { first: 69, last: 127 },
    U32Range { first: 32, last: 345 },
    U32Range { first: 544, last: 857 },
    U32Range { first: 0, last: 511 },
  ]
  let mut i: usize = 0
  while i < 10 {
    let mut value = BitPage.newOnes()
    let mut expected = BitPage.newOnes()
    let r = cases[i]
    BitPage.removeRange(&mut value, r.first, r.last)
    let mut n = r.first
    while n <= r.last {
      drop BitPage.remove(&mut expected, n)
      n = n + 1
    }
    run Testing.expect(
      BitPage.equals(&value, &expected) && BitPage.len(&value) == BitPage.len(&expected),
      "range matches individual changes",
    )
    i = i + 1
  }
}

test effect fn pageInsertReturn() -> ()
  ! AssertionError<'static> {
  let mut value = BitPage.newZeroes()
  run Testing.expect(
    BitPage.insert(&mut value, 123) && !BitPage.insert(&mut value, 123),
    "insert reports change",
  )
}

test effect fn pageRemove() -> ()
  ! AssertionError<'static> {
  let mut n: u32 = 0
  while n <= 1025 {
    let mut value = BitPage.newOnes()
    run Testing.expect(
      BitPage.contains(&value, n) && BitPage.remove(&mut value, n)
        && !BitPage.remove(&mut value, n),
      "remove reports change",
    )
    run Testing.expect(
      !BitPage.contains(&value, n) && BitPage.contains(&value, u32.wrappingSubtract(n, 1)),
      "adjacent value remains",
    )
    n = n + 1
  }
}

test effect fn clear() -> ()
  ! AssertionError<'static> {
  let mut empty = BitPage.newZeroes()
  let mut full = BitPage.newOnes()
  BitPage.clear(&mut empty)
  run Testing.expect(BitPage.len(&empty) == 0, "clear empty")
  run pageItems(&empty, 0, false, &[])
  BitPage.insertRange(&mut empty, 10, 300)
  BitPage.clear(&mut empty)
  run Testing.expect(BitPage.len(&empty) == 0, "clear range")
  run pageItems(&empty, 0, false, &[])
  BitPage.clear(&mut full)
  run Testing.expect(BitPage.len(&full) == 0, "clear full")
  run pageItems(&full, 0, false, &[])
}

test effect fn removeToEmptyPage() -> ()
  ! AssertionError<'static> {
  let mut value = BitPage.newZeroes()
  drop BitPage.insert(&mut value, 13)
  run Testing.expect(!BitPage.isEmpty(&value), "inserted")
  drop BitPage.remove(&mut value, 13)
  run Testing.expect(BitPage.isEmpty(&value), "removed")
}

test effect fn pageIter() -> ()
  ! AssertionError<'static> {
  let value = page(&[0, 12, 13, 63, 64, 511, 23, 400, 78])
  run pageItems(&value, 0, false, &[0, 12, 13, 23, 63, 64, 78, 400, 511])
}

test effect fn pageIterOverflow() -> ()
  ! AssertionError<'static> {
  let value = page(&[0])
  let mut iter = BitPage.iter(&value)
  run Testing.expect(
    optional(PageIter.nextBack(&mut iter), 0) && optional(PageIter.next(&mut iter), -1),
    "crossing cursors",
  )
}

test effect fn pageIterFrom() -> ()
  ! AssertionError<'static> {
  let empty = BitPage.newZeroes()
  run pageItems(&empty, 0, false, &[])
  run pageItems(&empty, 256, false, &[])
  let mut value = page(&[1, 12, 13, 63, 64, 511, 23, 400, 78])
  run pageItems(&value, 0, false, &[1, 12, 13, 23, 63, 64, 78, 400, 511])
  drop BitPage.insert(&mut value, 0)
  run pageItems(&value, 0, false, &[0, 1, 12, 13, 23, 63, 64, 78, 400, 511])
  run pageItems(&value, 1, false, &[1, 12, 13, 23, 63, 64, 78, 400, 511])
  run pageItems(&value, 2, false, &[12, 13, 23, 63, 64, 78, 400, 511])
  run pageItems(&value, 63, false, &[63, 64, 78, 400, 511])
  run pageItems(&value, 256, false, &[400, 511])
  run pageItems(&value, 511, false, &[511])
  run pageItems(&value, 512, false, &[0, 1, 12, 13, 23, 63, 64, 78, 400, 511])
  run pageItems(&value, 515, false, &[12, 13, 23, 63, 64, 78, 400, 511])
  run pageItems(&value, 390, false, &[400, 511])
  run pageItems(&value, 400, false, &[400, 511])
  run pageItems(&value, 401, false, &[511])
}

test effect fn pageIterAfterRev() -> ()
  ! AssertionError<'static> {
  let empty = BitPage.newZeroes()
  run pageItems(&empty, 0, false, &[])
  run pageItems(&empty, 256, false, &[])
  let mut value = page(&[1, 12, 13, 63, 64, 511, 23, 400, 78])
  run pageItems(&value, 0, true, &[511, 400, 78, 64, 63, 23, 13, 12, 1])
  drop BitPage.insert(&mut value, 0)
  run pageItems(&value, 0, true, &[511, 400, 78, 64, 63, 23, 13, 12, 1, 0])
  run pageItems(&value, 1, true, &[511, 400, 78, 64, 63, 23, 13, 12, 1])
  run pageItems(&value, 2, true, &[511, 400, 78, 64, 63, 23, 13, 12])
  run pageItems(&value, 63, true, &[511, 400, 78, 64, 63])
  run pageItems(&value, 256, true, &[511, 400])
  run pageItems(&value, 511, true, &[511])
  run pageItems(&value, 512, true, &[511, 400, 78, 64, 63, 23, 13, 12, 1, 0])
  run pageItems(&value, 515, true, &[511, 400, 78, 64, 63, 23, 13, 12])
  run pageItems(&value, 390, true, &[511, 400])
  run pageItems(&value, 400, true, &[511, 400])
  run pageItems(&value, 401, true, &[511])
}

test effect fn iterRanges() -> ()
  ! AssertionError<'static> {
  run ranges(&[])
  run ranges(&[U32Range { first: 0, last: 5 }])
  run ranges(
    &[
      U32Range { first: 0, last: 0 },
      U32Range { first: 5, last: 5 },
      U32Range { first: 10, last: 10 },
    ],
  )
  run ranges(&[U32Range { first: 0, last: 5 }, U32Range { first: 12, last: 31 }])
  run ranges(&[U32Range { first: 12, last: 31 }])
  run ranges(&[U32Range { first: 71, last: 84 }])
  run ranges(&[U32Range { first: 273, last: 284 }])
  run ranges(&[U32Range { first: 0, last: 511 }])
  run ranges(&[U32Range { first: 511, last: 511 }])
  run ranges(&[U32Range { first: 500, last: 511 }])
  run ranges(&[U32Range { first: 400, last: 511 }])
  run ranges(&[U32Range { first: 0, last: 511 }])
  run ranges(&[U32Range { first: 64, last: 127 }])
  run ranges(&[U32Range { first: 64, last: 127 }, U32Range { first: 129, last: 135 }])
  run ranges(&[U32Range { first: 64, last: 135 }])
  run ranges(&[U32Range { first: 71, last: 135 }])
  run ranges(&[U32Range { first: 71, last: 435 }])
}

test effect fn unionValue() -> ()
  ! AssertionError<'static> {
  let pages: [BitPage; 3] = [page(&[]), page(&[32, 400]), page(&[32, 200])]
  run Testing.expect(
    BitPage.equals(&BitPage.unionValue(&pages[0], &pages[1]), &page(&[32, 400])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.unionValue(&pages[1], &pages[0]), &page(&[32, 400])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.unionValue(&pages[1], &pages[2]), &page(&[32, 200, 400])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.unionValue(&pages[2], &pages[1]), &page(&[32, 200, 400])),
    "set operation",
  )
}

test effect fn intersect() -> ()
  ! AssertionError<'static> {
  let pages: [BitPage; 3] = [page(&[]), page(&[32, 400]), page(&[32, 200])]
  run Testing.expect(
    BitPage.equals(&BitPage.intersect(&pages[0], &pages[1]), &page(&[])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.intersect(&pages[1], &pages[0]), &page(&[])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.intersect(&pages[1], &pages[2]), &page(&[32])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.intersect(&pages[2], &pages[1]), &page(&[32])),
    "set operation",
  )
}

test effect fn subtract() -> ()
  ! AssertionError<'static> {
  let pages: [BitPage; 3] = [page(&[]), page(&[32, 400]), page(&[32, 200])]
  run Testing.expect(
    BitPage.equals(&BitPage.subtract(&pages[0], &pages[1]), &page(&[])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.subtract(&pages[1], &pages[0]), &page(&[32, 400])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.subtract(&pages[1], &pages[2]), &page(&[400])),
    "set operation",
  )
  run Testing.expect(
    BitPage.equals(&BitPage.subtract(&pages[2], &pages[1]), &page(&[200])),
    "set operation",
  )
}

test effect fn hashAndEq() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let a = page(&[12, 300])
  let b = page(&[300, 12])
  let c = page(&[300, 12, 23])
  run Testing.expect(
    BitPage.equals(&a, &b) && !BitPage.equals(&a, &c) && !BitPage.equals(&b, &c),
    "storage equality",
  )
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut set = HashSet<BitPage>.make(Hash.seed(17))
  drop run HashSet<BitPage>.insert(&mut set, a) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    HashSet<BitPage>.contains(&set, b) && !HashSet<BitPage>.contains(&set, c),
    "hash identity ignores insertion order",
  )
}

test effect fn intersects() -> ()
  ! AssertionError<'static> {
  let a = page(&[])
  let b = page(&[32, 400])
  let c = page(&[400])
  let d = page(&[401])
  run Testing.expect(
    BitPage.intersectsSet(&a, &b) == false && BitPage.intersectsSet(&b, &a) == false,
    "symmetric intersection",
  )
  run Testing.expect(
    BitPage.intersectsSet(&a, &c) == false && BitPage.intersectsSet(&c, &a) == false,
    "symmetric intersection",
  )
  run Testing.expect(
    BitPage.intersectsSet(&a, &d) == false && BitPage.intersectsSet(&d, &a) == false,
    "symmetric intersection",
  )
  run Testing.expect(
    BitPage.intersectsSet(&b, &c) == true && BitPage.intersectsSet(&c, &b) == true,
    "symmetric intersection",
  )
  run Testing.expect(
    BitPage.intersectsSet(&b, &d) == false && BitPage.intersectsSet(&d, &b) == false,
    "symmetric intersection",
  )
  run Testing.expect(
    BitPage.intersectsSet(&c, &d) == false && BitPage.intersectsSet(&d, &c) == false,
    "symmetric intersection",
  )
}

test effect fn isSubset() -> ()
  ! AssertionError<'static> {
  let a = page(&[])
  let b = page(&[32, 400])
  let c = page(&[32])
  let d = page(&[32, 200, 400])
  let e = page(&[32, 300])
  let f = page(&[32, 200, 300])
  run Testing.expect(BitPage.isSubset(&a, &a), "subset")
  run Testing.expect(BitPage.isSubset(&a, &b), "subset")
  run Testing.expect(BitPage.isSubset(&a, &c), "subset")
  run Testing.expect(BitPage.isSubset(&a, &d), "subset")
  run Testing.expect(BitPage.isSubset(&b, &b), "subset")
  run Testing.expect(BitPage.isSubset(&c, &c), "subset")
  run Testing.expect(BitPage.isSubset(&d, &d), "subset")
  run Testing.expect(BitPage.isSubset(&e, &e), "subset")
  run Testing.expect(BitPage.isSubset(&f, &f), "subset")
  run Testing.expect(BitPage.isSubset(&c, &b), "subset")
  run Testing.expect(BitPage.isSubset(&c, &d), "subset")
  run Testing.expect(BitPage.isSubset(&b, &d), "subset")
  run Testing.expect(!BitPage.isSubset(&b, &c), "not subset")
  run Testing.expect(!BitPage.isSubset(&d, &b), "not subset")
  run Testing.expect(!BitPage.isSubset(&d, &c), "not subset")
  run Testing.expect(!BitPage.isSubset(&b, &a), "not subset")
  run Testing.expect(!BitPage.isSubset(&b, &e), "not subset")
  run Testing.expect(!BitPage.isSubset(&e, &b), "not subset")
  run Testing.expect(!BitPage.isSubset(&b, &f), "not subset")
}

test effect fn intersectionLen() -> ()
  ! AssertionError<'static> {
  let a = page(&[])
  let b = page(&[32, 400])
  let c = page(&[32, 200])
  let d = page(&[32])
  run Testing.expect(BitPage.intersectionLen(&a, &b) == 0, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&b, &a) == 0, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&b, &c) == 1, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&c, &b) == 1, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&b, &d) == 1, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&d, &b) == 1, "intersection count")
  run Testing.expect(BitPage.intersectionLen(&b, &b) == 2, "intersection count")
}
