test effect fn ligaturesubstformat1() -> ()
  ! AssertionError<'static> {
  let table = run must(
    LigatureSubstFormat1.read(
      FontData.new(generated_layout_fixtures.gsubLigaturesubstformat1Table()),
    ),
  )
  let entries = LigatureSubstFormat1.ligatureSets(&table)
  run Testing.expect(
    ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.len(&entries) == 2,
    "ligature set count",
  )
  let first = run must(ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.get(&entries, 0))
  let second = run must(
    ArrayOfOffsets<'static, (), LigatureSet<'static>, Offset16>.get(&entries, 1),
  )
  let ligs = LigatureSet.ligatures(&first)
  run Testing.expect(
    ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.len(&ligs) == 1,
    "first ligature count",
  )
  let a = run must(ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.get(&ligs, 0))
  let b = run must(
    ArrayOfOffsets<'static, (), Ligature<'static>, Offset16>.get(
      &LigatureSet.ligatures(&second),
      0,
    ),
  )
  run Testing.expect(
    GlyphId16.toU16(Ligature.ligatureGlyph(&a)) == 347
      && GlyphId16.toU16(Ligature.ligatureGlyph(&b)) == 241,
    "ligature glyphs",
  )
  run glyphs(Ligature.componentGlyphIds(&a), &[40, 23])
  run glyphs(Ligature.componentGlyphIds(&b), &[26, 29])
}

test effect fn sanityCheckFormatConst() -> ()
  ! AssertionError<'static> {
  let format = ValueFormat.xAdvanceDevice() | ValueFormat.yAdvanceDevice()
    | ValueFormat.yPlacementDevice()
    | ValueFormat.xPlacementDevice()
  run Testing.expect(
    &format == &ValueFormat.anyDeviceOrVaridx() && ValueFormat.recordByteLen(format) == 8,
    "device mask",
  )
}

fn placement(record: &ValueRecord, index: usize) -> Option<i16> {
  return match index {
    0 => ValueRecord.xPlacement(record)
    1 => ValueRecord.yPlacement(record)
    2 => ValueRecord.xAdvance(record)
    _ => ValueRecord.yAdvance(record)
  }
}

test effect fn fieldOffsetsMatchSequentialLayout() -> ()
  ! AssertionError<'static> {
  let data = FontData.new(
    b"\x00\x00\x00\x00\x00\x00\x11\x00\x11\x01\x11\x02\x11\x03\x11\x04\x11\x05\x11\x06\x11\x07",
  )
  let mut bits: u16 = 0
  while bits < 256 {
    let format = ValueFormat.fromBitsTruncate(bits)
    let record = ValueRecord.new(data, 6, format)
    run Testing.expect(
      &ValueRecord.format(&record) == &format
        && ValueRecord.byteLen(&record) == ValueFormat.recordByteLen(format),
      "format and size",
    )
    let mut field: usize = 0
    let mut flag: u16 = 1
    let mut position: u16 = 0
    while field < 8 {
      let mut got: Option<u16> = Option<u16>.None
      if field < 4 {
        if let Option<i16>.Some { value } = move placement(&record, field) {
          got = Option<u16>.some(i16.toU16(value))
        }
      } else {
        if let Option<Nullable<Offset16>>.Some { value } = move ValueRecord.deviceOffset(
          &record,
          ValueFormat.fromBitsTruncate(flag),
        ) {
          got = Option<u16>.some(u32.toU16(Offset16.toU32(Nullable<Offset16>.offset(&value).*)))
        }
      }
      if (bits & flag) != 0 {
        run Testing.expect(
          (move got |> Option<u16>.unwrapOr(0)) == 4352 + position,
          "present field has sequential position",
        )
        position = position + 1
      } else {
        run Testing.expect(
          match move got {
            Option<u16>.None => true
            _ => false
          },
          "absent field stays absent",
        )
      }
      field = field + 1
      flag = flag * 2
    }
    run Testing.expect(
      u16.toUsize(position) * 2 == ValueRecord.byteLen(&record),
      "sequential byte length",
    )
    bits = bits + 1
  }
}

test effect fn lazyFieldsOutOfBounds() -> ()
  ! AssertionError<'static> {
  let format = ValueFormat.xPlacement() | ValueFormat.yAdvance()
  let lazy = ValueRecord.new(FontData.new(b"\x00\x01\x00\x02"), 2, format)
  run Testing.expect(
    (ValueRecord.xPlacement(&lazy) |> Option<i16>.unwrapOr(0)) == 2,
    "present first field",
  )
  run Testing.expect(
    match move ValueRecord.yAdvance(&lazy) {
      Option<i16>.None => true
      _ => false
    },
    "missing second field",
  )
  let huge = ValueRecord.new(FontData.new(b"\x00\x01\x00\x02"), usize.MAX, format)
  run Testing.expect(
    match move ValueRecord.xPlacement(&huge) {
      Option<i16>.None => true
      _ => false
    },
    "unrepresentable position",
  )
}

