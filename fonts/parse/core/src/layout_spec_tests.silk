test effect fn singleposformat1() -> ()
  ! AssertionError<'static> {
  let table = run must(
    SinglePosFormat1.read(FontData.new(generated_layout_fixtures.gposSingleposformat1())),
  )
  run Testing.expect(
    &SinglePosFormat1.valueFormat(&table) == &ValueFormat.yPlacement(),
    "single adjustment format",
  )
  run Testing.expect(
    (ValueRecord.yPlacement(&SinglePosFormat1.valueRecord(&table)) |> Option<i16>.unwrapOr(0))
      == -80,
    "placement",
  )
  let coverage = run must(SinglePosFormat1.coverage(&table))
  run Testing.expect(coverageCount(&coverage) == 10, "coverage population")
}

test effect fn singleposformat2() -> ()
  ! AssertionError<'static> {
  let table = run must(
    SinglePosFormat2.read(FontData.new(generated_layout_fixtures.gposSingleposformat2())),
  )
  run Testing.expect(
    &SinglePosFormat2.valueFormat(&table) == &(ValueFormat.xPlacement() | ValueFormat.xAdvance())
      && SinglePosFormat2.valueCount(&table) == 3,
    "per-glyph format",
  )
  let records = SinglePosFormat2.valueRecords(&table)
  let a = run must(ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, 0))
  let b = run must(ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, 1))
  let c = run must(ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, 2))
  run Testing.expect(
    (ValueRecord.xPlacement(&a) |> Option<i16>.unwrapOr(0)) == 50
      && (ValueRecord.xAdvance(&b) |> Option<i16>.unwrapOr(0)) == 25
      && (ValueRecord.xPlacement(&c) |> Option<i16>.unwrapOr(0)) == 10,
    "per-glyph records",
  )
  run Testing.expect(
    match move ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, 3) {
      Result<ValueRecord<'static>, ReadError>.Failure { error } => true
      _ => false
    },
    "out-of-range record",
  )
}

test effect fn pairposformat1() -> ()
  ! AssertionError<'static> {
  let table = run must(
    PairPosFormat1.read(FontData.new(generated_layout_fixtures.gposPairposformat1())),
  )
  run Testing.expect(
    &PairPosFormat1.valueFormat1(&table) == &ValueFormat.xAdvance()
      && &PairPosFormat1.valueFormat2(&table) == &ValueFormat.xPlacement()
      && PairPosFormat1.pairSetCount(&table) == 2,
    "pair formats",
  )
  let sets = PairPosFormat1.pairSets(&table)
  let first = run must(
    ArrayOfOffsets<'static, ReadArgs2<ValueFormat, ValueFormat>, PairSet<'static>, Offset16>.get(
      &sets,
      0,
    ),
  )
  let second = run must(
    ArrayOfOffsets<'static, ReadArgs2<ValueFormat, ValueFormat>, PairSet<'static>, Offset16>.get(
      &sets,
      1,
    ),
  )
  let firstRecords = PairSet.pairValueRecords(&first)
  let secondRecords = PairSet.pairValueRecords(&second)
  run Testing.expect(
    ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.len(
      &firstRecords,
    )
      == 1
      && ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.len(
        &secondRecords,
      )
        == 1,
    "pair record counts",
  )
  let a = run must(
    ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.get(
      &firstRecords,
      0,
    ),
  )
  let b = run must(
    ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.get(
      &secondRecords,
      0,
    ),
  )
  run Testing.expect(
    GlyphId16.toU16(PairValueRecord.secondGlyph(&a)) == 89
      && GlyphId16.toU16(PairValueRecord.secondGlyph(&b)) == 89,
    "second glyphs",
  )
  run Testing.expect(
    (ValueRecord.xAdvance(&PairValueRecord.valueRecord1(&a)) |> Option<i16>.unwrapOr(0)) == -30
      && (ValueRecord.xPlacement(&PairValueRecord.valueRecord2(&a)) |> Option<i16>.unwrapOr(0))
        == -20,
    "first pair",
  )
  run Testing.expect(
    match move ValueRecord.xPlacement(&PairValueRecord.valueRecord1(&a)) {
      Option<i16>.None => true
      _ => false
    },
    "absent placement",
  )
  run Testing.expect(
    (ValueRecord.xAdvance(&PairValueRecord.valueRecord1(&b)) |> Option<i16>.unwrapOr(0)) == -40
      && (ValueRecord.xPlacement(&PairValueRecord.valueRecord2(&b)) |> Option<i16>.unwrapOr(0))
        == -25,
    "second pair",
  )
}

test effect fn pairposformat2() -> ()
  ! AssertionError<'static> {
  let table = run must(
    PairPosFormat2.read(FontData.new(generated_layout_fixtures.gposPairposformat2())),
  )
  run Testing.expect(
    ValueFormat.recordByteLen(PairPosFormat2.valueFormat1(&table)) == 2
      && ValueFormat.recordByteLen(PairPosFormat2.valueFormat2(&table)) == 0
      && PairPosFormat2.class1Count(&table) == 2,
    "class pair formats",
  )
  run Testing.expect(
    ComputedArray<'static, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'static>>.len(
      &PairPosFormat2.class1Records(&table),
    )
      == 2,
    "class record count",
  )
  let class = run must(PairPosFormat2.classDef2(&table))
  match class {
    ClassDef.Format2 { value } => {
      let record = run must(
        ComputedArray<'static, (), ClassRangeRecord<'static>>.get(
          &ClassDefFormat2.classRangeRecords(&value),
          0,
        ),
      )
      run Testing.expect(
        GlyphId16.toU16(ClassRangeRecord.startGlyphId(&record)) == 106,
        "class range start",
      )
    }
    _ => run Testing.expect(false, "class format 2")
  }
}

