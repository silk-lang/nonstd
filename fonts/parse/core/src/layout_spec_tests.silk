test effect fn valueformattable() -> ()
  ! AssertionError<'static> {
  let table = run must(
    SinglePosFormat1.read(FontData.new(generated_layout_fixtures.gposValueformattable())),
  )
  run Testing.expect(
    &SinglePosFormat1.valueFormat(&table)
      == &(ValueFormat.xPlacement() | ValueFormat.yAdvance() | ValueFormat.xPlacementDevice()
        | ValueFormat.yAdvanceDevice()),
    "device formats",
  )
  let record = SinglePosFormat1.valueRecord(&table)
  run Testing.expect((ValueRecord.yAdvance(&record) |> Option<i16>.unwrapOr(0)) == 210, "y advance")
  let result = run some(ValueRecord.yAdvanceDevice(&record))
  let target = run must(move result)
  match target {
    DeviceOrVariationIndex.Device { value } => {
      run Testing.expect(
        Device.startSize(&value) == 11 && Device.endSize(&value) == 15
          && Device.deltaFormat(&value) == DeltaFormat.Local2BitDeltas,
        "y device header",
      )
      let values = Device.deltaValue(&value)
      run Testing.expect(
        ScalarArray<u16>.len(&values) == 1
          && (ScalarArray<u16>.get(&values, 0) |> Option<u16>.unwrapOr(0)) == 21824,
        "device packed value",
      )
    }
    _ => run Testing.expect(false, "device variant")
  }
}

