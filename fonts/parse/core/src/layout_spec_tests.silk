test effect fn coverage24bitGlyphsAndIndices() -> ()
  ! AssertionError<'static> {
  let table = run must(
    CoverageTable.read(FontData.new(b"\x00\x03\x00\x00\x03\x00\xff\xff\x01\x00\x00\xff\xff\xff")),
  )
  let mut iter = CoverageTable.iter(&table)
  let expected: [u32; 3] = [65535, 65536, 16777215]
  let mut i: usize = 0
  while i < 3 {
    let glyph = run some(CoverageIter.next(&mut iter))
    run Testing.expect(GlyphId.toU32(glyph) == expected[i], "wide glyph")
    i = i + 1
  }
  run Testing.expect(
    (CoverageTable.get(&table, GlyphId.new(65536)) |> Option<u32>.unwrapOr(0)) == 1
      && match move CoverageTable.get(&table, GlyphId.new(16777216)) {
        Option<u32>.None => true
        _ => false
      },
    "wide lookup",
  )
  let range = run must(
    CoverageTable.read(FontData.new(b"\x00\x04\x00\x00\x01\x01\x00\x00\x01\x00\x02\x01\x00\x00")),
  )
  run Testing.expect(
    (CoverageTable.get(&range, GlyphId.new(65538)) |> Option<u32>.unwrapOr(0)) == 65538
      && CoverageTable.population(&range) == 3
      && match move CoverageTable.get(&range, GlyphId.new(65539)) {
        Option<u32>.None => true
        _ => false
      },
    "wide coverage index",
  )
}

test effect fn classWidthsFollowTheFormat() -> ()
  ! AssertionError<'static> {
  let a = run must(
    ClassDef.read(FontData.new(b"\x00\x03\x01\x00\x00\x00\x00\x02\x01\x00\x00\xff\xff\xff")),
  )
  run Testing.expect(
    ClassDef.get(&a, GlyphId.new(65536)) == 65536
      && ClassDef.get(&a, GlyphId.new(65537)) == 16777215
      && ClassDef.get(&a, GlyphId.new(65538)) == 0,
    "24 bit class values",
  )
  let b = run must(
    ClassDef.read(FontData.new(b"\x00\x04\x00\x00\x01\x01\x00\x00\x01\x00\x02\xff\xff")),
  )
  run Testing.expect(
    ClassDef.get(&b, GlyphId.new(65538)) == 65535 && ClassDef.get(&b, GlyphId.new(65539)) == 0
      && classCount(&b) == 3,
    "16 bit ranged class values",
  )
}

test effect fn truncatedWideArraysDoNotMatch() -> ()
  ! AssertionError<'static> {
  let a = run must(CoverageTable.read(FontData.new(b"\x00\x03\x00\x00\x01")))
  let b = run must(CoverageTable.read(FontData.new(b"\x00\x04\x00\x00\x01")))
  run Testing.expect(
    match move CoverageTable.get(&a, GlyphId.new(0)) {
      Option<u32>.None => true
      _ => false
    },
    "truncated array",
  )
  run Testing.expect(
    match move CoverageTable.get(&b, GlyphId.new(0)) {
      Option<u32>.None => true
      _ => false
    },
    "truncated ranges",
  )
  let c = run must(ClassDef.read(FontData.new(b"\x00\x03\x01\x00\x00\x00\x00\x01")))
  let d = run must(ClassDef.read(FontData.new(b"\x00\x04\x00\x00\x01")))
  run Testing.expect(
    ClassDef.get(&c, GlyphId.new(65536)) == 0 && ClassDef.get(&d, GlyphId.new(65536)) == 0,
    "truncated classes",
  )
}

test effect fn coverageGetFormat1() -> ()
  ! AssertionError<'static> {
  let c = run must(
    CoverageFormat1.read(FontData.new(b"\x00\x01\x00\x05\x00\x01\x00\x07\x00\x0d\x00\x1b\x00\x2c")),
  )
  let gids: [u32; 5] = [1, 2, 7, 27, 45]
  let expected: [u16; 5] = [0, 65535, 1, 3, 65535]
  let mut i: usize = 0
  while i < 5 {
    run Testing.expect(
      (CoverageFormat1.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(65535)) == expected[i],
      "coverage index",
    )
    i = i + 1
  }
}

test effect fn coverageGetFormat2() -> ()
  ! AssertionError<'static> {
  let c = run must(
    CoverageFormat2.read(
      FontData.new(b"\x00\x02\x00\x02\x00\x05\x00\x09\x00\x00\x00\x1e\x00\x27\x00\x05"),
    ),
  )
  let gids: [u32; 7] = [2, 7, 9, 10, 32, 39, 40]
  let expected: [u16; 7] = [65535, 2, 4, 65535, 7, 14, 65535]
  let mut i: usize = 0
  while i < 7 {
    run Testing.expect(
      (CoverageFormat2.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(65535)) == expected[i],
      "ranged coverage index",
    )
    i = i + 1
  }
}

test effect fn coverageGetFormat2NoU16Overflow() -> ()
  ! AssertionError<'static> {
  let c = run must(CoverageFormat2.read(FontData.new(b"\x00\x02\x00\x01\x9c\x40\x9c\x4a\x9c\x40")))
  let gids: [u32; 3] = [40000, 40005, 40010]
  let mut i: usize = 0
  while i < 3 {
    run Testing.expect(
      u16.toU32(CoverageFormat2.get(&c, GlyphId.new(gids[i])) |> Option<u16>.unwrapOr(0))
        == gids[i],
      "large CJK range",
    )
    i = i + 1
  }
  run Testing.expect(
    match move CoverageFormat2.get(&c, GlyphId.new(40011)) {
      Option<u16>.None => true
      _ => false
    },
    "outside range",
  )
}

test effect fn coverageGetFormat2RejectsOverflowingCoverageIndex() -> ()
  ! AssertionError<'static> {
  let c = run must(CoverageFormat2.read(FontData.new(b"\x00\x02\x00\x01\x00\x01\x00\x02\xff\xff")))
  run Testing.expect(
    (CoverageFormat2.get(&c, GlyphId.new(1)) |> Option<u16>.unwrapOr(0)) == 65535
      && match move CoverageFormat2.get(&c, GlyphId.new(2)) {
        Option<u16>.None => true
        _ => false
      },
    "overflowing coverage index",
  )
}

test effect fn classdefGetFormat2() -> ()
  ! AssertionError<'static> {
  let table = run must(
    ClassDef.read(FontData.new(generated_layout_fixtures.gdefMarkattachclassdefTable())),
  )
  let gids: [u32; 11] = [616, 617, 618, 624, 625, 626, 652, 653, 654, 655, 661]
  let mut i: usize = 0
  while i < 11 {
    let mut expected: u32 = 1
    if i >= 6 {
      expected = 2
    }
    run Testing.expect(ClassDef.get(&table, GlyphId.new(gids[i])) == expected, "class assignment")
    i = i + 1
  }
  let mut iter = ClassDef.iter(&table)
  while let Option<ClassEntry>.Some { value } = move ClassIter.next(&mut iter) {
    run Testing.expect(
      ClassDef.get(&table, value.glyph) == value.class,
      "class iterator agrees with lookup",
    )
  }
}

effect fn deviceDeltas(data: &'static [u8], expected: &[i8]) -> ()
  ! AssertionError<'static> {
  let device = run must(Device.read(FontData.new(data)))
  let mut iter = Device.iter(&device)
  let mut i: usize = 0
  while i < expected.length {
    let value = run some(DeviceIter.next(&mut iter))
    run Testing.expect(value == expected[i], "decoded device delta")
    i = i + 1
  }
  run Testing.expect(
    match move DeviceIter.next(&mut iter) {
      Option<i8>.None => true
      _ => false
    },
    "device iterator length",
  )
}

test effect fn deltaDecode() -> ()
  ! AssertionError<'static> {
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x02\x12\x3f", &[1, 2, 3, -1])
  run deviceDeltas(b"\x00\x01\x00\x05\x00\x01\x55\x40", &[1, 1, 1, 1, 1])
}

test effect fn deltaDecodeNegativeNotInLastSlot() -> ()
  ! AssertionError<'static> {
  run deviceDeltas(b"\x00\x01\x00\x02\x00\x03\xf4\x01", &[-12, 1])
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x02\x81\x23", &[-8, 1, 2, 3])
  run deviceDeltas(b"\x00\x01\x00\x04\x00\x01\x95\x40", &[-2, 1, 1, 1])
  run deviceDeltas(b"\x00\x01\x00\x02\x00\x03\x80\x00", &[-128, 0])
}

test effect fn deltaDecodeAll() -> ()
  ! AssertionError<'static> {
