test effect fn anchorformat3() -> ()
  ! AssertionError<'static> {
  let table = run must(
    AnchorFormat3.read(FontData.new(generated_layout_fixtures.gposAnchorformat3())),
  )
  run Testing.expect(
    AnchorFormat3.xCoordinate(&table) == 279 && AnchorFormat3.yCoordinate(&table) == 1301,
    "format 3 anchor",
  )
  let xr = run some(AnchorFormat3.xDevice(&table))
  let yr = run some(AnchorFormat3.yDevice(&table))
  let x = run must(move xr)
  let y = run must(move yr)
  let devices = [x, y]
  let mut i: usize = 0
  while i < 2 {
    match devices[i] {
      DeviceOrVariationIndex.Device { value } => {
        let values = Device.deltaValue(&value)
        run Testing.expect(
          Device.deltaFormat(&value) == DeltaFormat.Local4BitDeltas
            && ScalarArray<u16>.len(&values) == 2
            && (ScalarArray<u16>.get(&values, 0) |> Option<u16>.unwrapOr(0)) == 4369
            && (ScalarArray<u16>.get(&values, 1) |> Option<u16>.unwrapOr(0)) == 8704,
          "anchor device",
        )
      }
      _ => run Testing.expect(false, "device variant")
    }
    i = i + 1
  }
}

import font_types.lib { readScalar }
import silk.collections.slice { Slice }
import generated_layout { ScriptTags, SelectedScript, TaggedElement }

fn tag(bytes: &[u8]) -> Tag {
  return readScalar<Tag>(bytes) |> Option<Tag>.unwrapOr(Tag.default())
}

effect fn sameTags(unicode: &[u8], expected: &[u8]) -> ()
  ! AssertionError<'static> {
  let mapped = ScriptTags.fromUnicode(tag(unicode))
  let tags = ScriptTags.asSlice(&mapped)
  run Testing.expect(tags.length * 4 == expected.length, "mapped tag count")
  let mut i: usize = 0
  while i < tags.length {
    run Testing.expect(&tags[i] == &tag(Slice.view(expected, i * 4, 4)), "mapped tag")
    i = i + 1
  }
}

test effect fn simpleScriptTagFromUnicode() -> ()
  ! AssertionError<'static> {
  run sameTags(b"Cyrl", b"cyrl")
  run sameTags(b"Grek", b"grek")
  run sameTags(b"Hebr", b"hebr")
  run sameTags(b"Latn", b"latn")
}

test effect fn exceptionScriptTagFromUnicode() -> ()
  ! AssertionError<'static> {
  run sameTags(b"Kana", b"kana")
  run sameTags(b"Hira", b"kana")
  run sameTags(b"Nkoo", b"nko ")
  run sameTags(b"Yiii", b"yi  ")
  run sameTags(b"Vaii", b"vai ")
}

test effect fn multiScriptTagsFromUnicode() -> ()
  ! AssertionError<'static> {
  run sameTags(b"Beng", b"bng3bng2beng")
  run sameTags(b"Orya", b"ory3ory2orya")
  run sameTags(b"Mlym", b"mlm3mlm2mlym")
  run sameTags(b"Mymr", b"mym2mymr")
}

test effect fn scriptIndexForTag() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontNotoserifhebrewAutohintMetricsGsub())),
  )
  let scripts = run must(Gsub.scriptList(&gsub))
  let expected = b"DFLTcyrlgrekhebrlatn"
  let mut i: usize = 0
  while i < 5 {
    run Testing.expect(
      (ScriptList.indexForTag(&scripts, tag(Slice.view(expected, i * 4, 4)))
        |> Option<u16>.unwrapOr(65535))
        == usize.toU16(i),
      "script index",
    )
    i = i + 1
  }
}

test effect fn selectScriptsFromUnicode() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontNotoserifhebrewAutohintMetricsGsub())),
  )
  let scripts = run must(Gsub.scriptList(&gsub))
  let hebrew = ScriptTags.fromUnicode(tag(b"Hebr"))
  let hebr = run some(ScriptList.select(&scripts, ScriptTags.asSlice(&hebrew)))
  run Testing.expect(
    &hebr.tag == &tag(b"hebr") && hebr.index == 3 && !hebr.isFallback,
    "requested script",
  )
  let bengali = ScriptTags.fromUnicode(tag(b"Beng"))
  let beng = run some(ScriptList.select(&scripts, ScriptTags.asSlice(&bengali)))
  run Testing.expect(
    &beng.tag == &tag(b"DFLT") && beng.index == 0 && beng.isFallback,
    "fallback script",
  )
}

test effect fn scriptListGet() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontCantarellVfTrimmedGsub())),
  )
  let scripts = run must(Gsub.scriptList(&gsub))
  let index = run some(ScriptList.indexForTag(&scripts, tag(b"latn")))
  run Testing.expect(index == 1, "Latin index")
  let script = run must(ScriptList.get(&scripts, index))
  run Testing.expect(&script.tag == &tag(b"latn"), "Latin tag")
}

test effect fn scriptLangSysHelpers() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontCantarellVfTrimmedGsub())),
  )
  let scripts = run must(Gsub.scriptList(&gsub))
  let script = run must(ScriptList.get(&scripts, 1))
  let index = run some(Script.langSysIndexForTag(&script.element, tag(b"TRK ")))
  run Testing.expect(index == 0, "Turkish language index")
  let language = run must(Script.langSys(&script.element, index))
  run Testing.expect(&language.tag == &tag(b"TRK "), "Turkish language tag")
}

test effect fn featureIndexForTag() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontMaterialSymbolsSubsetGsub())),
  )
  let scripts = run must(Gsub.scriptList(&gsub))
  let features = run must(Gsub.featureList(&gsub))
  let script = run must(ScriptList.get(&scripts, 1))
  let language = run must(run some(Script.defaultLangSys(&script.element)))
  run Testing.expect(
    (LangSys.featureIndexForTag(&language, &features, tag(b"rclt")) |> Option<u16>.unwrapOr(65535))
      == 0,
    "rclt feature",
  )
  run Testing.expect(
    (LangSys.featureIndexForTag(&language, &features, tag(b"rlig")) |> Option<u16>.unwrapOr(65535))
      == 1,
    "rlig feature",
  )
  let absent = b"loclabvsliga"
  let mut i: usize = 0
  while i < 3 {
    run Testing.expect(
      (LangSys.featureIndexForTag(&language, &features, tag(Slice.view(absent, i * 4, 4)))
        |> Option<u16>.unwrapOr(65535))
        == 65535,
      "absent feature",
    )
    i = i + 1
  }
}

test effect fn featureListGet() -> ()
  ! AssertionError<'static> {
  let gsub = run must(
    Gsub.read(FontData.new(generated_layout_fixtures.fontNotoserifAutohintShapingGsub())),
  )
  let features = run must(Gsub.featureList(&gsub))
  let first = run must(FeatureList.get(&features, 0))
  let second = run must(FeatureList.get(&features, 1))
  run Testing.expect(&first.tag == &tag(b"c2sc") && &second.tag == &tag(b"liga"), "feature tags")
  run Testing.expect(
    match move FeatureList.get(&features, 2) {
      Result<TaggedElement<Feature<'static>>, ReadError>.Failure { error } => true
      _ => false
    },
    "feature bounds",
  )
}

import generated_gpos {
  Class2Record,
  ClassValueRecords,
  ExtensionSubtable,
  ExtensionPosFormat1,
  SinglePos
}

effect fn sameValueRecord<'a>(a: ValueRecord<'a>, b: ValueRecord<'a>) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    ValueFormat.bits(&ValueRecord.format(&a)) == ValueFormat.bits(&ValueRecord.format(&b)),
    "value record format",
  )
  run Testing.expect(Equal.equals(&a, &b), "value record bytes")
}

test effect fn pairPos2HoistedMatchesNested() -> ()
  ! AssertionError<'static> {
  let table = run must(
    PairPosFormat2.read(FontData.new(generated_layout_fixtures.gposPairposformat2())),
  )
  let c1 = PairPosFormat2.class1Count(&table)
  let c2 = PairPosFormat2.class2Count(&table)
  run Testing.expect(c1 > 0 && c2 > 0, "class counts")
  let hoisted = PairPosFormat2.classValueRecords(&table)
  let rows = PairPosFormat2.class1Records(&table)
  let mut i: u16 = 0
  while i < c1 {
    let row = run must(
      ComputedArray<'static, ReadArgs3<u16, ValueFormat, ValueFormat>, Class1Record<'static>>.get(
        &rows,
        u16.toUsize(i),
      ),
    )
    let cells = Class1Record.class2Records(&row)
    let mut j: u16 = 0
    while j < c2 {
      let cell = run must(
        ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, Class2Record<'static>>.get(
          &cells,
          u16.toUsize(j),
        ),
      )
      let found = run some(ClassValueRecords.get(&hoisted, i, j))
      run sameValueRecord(found[0], Class2Record.valueRecord1(&cell))
      run sameValueRecord(found[1], Class2Record.valueRecord2(&cell))
      j = j + 1
    }
    i = i + 1
  }
  run Testing.expect(
    match move ClassValueRecords.get(&hoisted, c1, 0) {
      Option<[ValueRecord<'static>; 2]>.None => true
      _ => false
    },
    "class1 bounds",
  )
  run Testing.expect(
    match move ClassValueRecords.get(&hoisted, 0, c2) {
      Option<[ValueRecord<'static>; 2]>.None => true
      _ => false
    },
    "class2 bounds",
  )
}

test effect fn pairSetFindMatchesScan() -> ()
  ! AssertionError<'static> {
  let table = run must(
    PairPosFormat1.read(FontData.new(generated_layout_fixtures.gposPairposformat1())),
  )
  let sets = PairPosFormat1.pairSets(&table)
  let mut i: usize = 0
  let mut seen: usize = 0
  while i
    < ArrayOfOffsets<'static, ReadArgs2<ValueFormat, ValueFormat>, PairSet<'static>, Offset16>.len(
      &sets,
    ) {
    let set = run must(
      ArrayOfOffsets<'static, ReadArgs2<ValueFormat, ValueFormat>, PairSet<'static>, Offset16>.get(
        &sets,
        i,
      ),
    )
    let records = PairSet.pairValueRecords(&set)
    run Testing.expect(
      !ComputedArray<
        'static,
        ReadArgs2<ValueFormat, ValueFormat>,
        PairValueRecord<'static>
      >.isEmpty(&records),
      "nonempty pair records",
    )
    let mut j: usize = 0
    while j
      < ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.len(
        &records,
      ) {
      let want = run must(
        ComputedArray<'static, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'static>>.get(
          &records,
          j,
        ),
      )
      let found = run some(PairSet.findPairValueRecord(&set, PairValueRecord.secondGlyph(&want)))
      run Testing.expect(
        GlyphId16.toU16(PairValueRecord.secondGlyph(&want))
          == GlyphId16.toU16(PairValueRecord.secondGlyph(&found)),
        "found glyph",
      )
      run sameValueRecord(PairValueRecord.valueRecord1(&want), PairValueRecord.valueRecord1(&found))
      run sameValueRecord(PairValueRecord.valueRecord2(&want), PairValueRecord.valueRecord2(&found))
      seen = seen + 1
      j = j + 1
    }
    run Testing.expect(
      match move PairSet.findPairValueRecord(&set, GlyphId16.new(65535)) {
        Option<PairValueRecord<'static>>.None => true
        _ => false
      },
      "absent pair",
    )
    i = i + 1
  }
  run Testing.expect(seen > 0, "visited pairs")
}

test effect fn valueRecordResolvesDevicesAgainstItsTable() -> ()
  ! AssertionError<'static> {
  let table = run must(
    SinglePosFormat1.read(FontData.new(generated_layout_fixtures.gposValueformattable())),
  )
  let record = SinglePosFormat1.valueRecord(&table)
  run Testing.expect(
    ValueFormat.intersects(&ValueRecord.format(&record), ValueFormat.anyDeviceOrVaridx()),
    "device format",
  )
  run Testing.expect(ValueRecord.offset(&record) > 0, "located record")
  drop run must(run some(ValueRecord.xPlacementDevice(&record)))
  drop run must(run some(ValueRecord.yAdvanceDevice(&record)))
}

test effect fn singlePos2RecordsAreEvenlySpaced() -> ()
  ! AssertionError<'static> {
  let table = run must(
    SinglePosFormat2.read(FontData.new(generated_layout_fixtures.gposSingleposformat2())),
  )
  let records = SinglePosFormat2.valueRecords(&table)
  let stride = ValueFormat.recordByteLen(SinglePosFormat2.valueFormat(&table))
  let count = ComputedArray<'static, ValueFormat, ValueRecord<'static>>.len(&records)
  run Testing.expect(count > 1, "multiple value records")
  let first = run must(ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, 0))
  let mut i: usize = 0
  while i < count {
    let record = run must(
      ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, i),
    )
    run Testing.expect(
      ValueRecord.offset(&record) == ValueRecord.offset(&first) + i * stride,
      "record stride",
    )
    run Testing.expect(
      ValueFormat.bits(&ValueRecord.format(&record))
        == ValueFormat.bits(&SinglePosFormat2.valueFormat(&table)),
      "record format",
    )
    i = i + 1
  }
  run Testing.expect(
    match move ComputedArray<'static, ValueFormat, ValueRecord<'static>>.get(&records, count) {
      Result<ValueRecord<'static>, ReadError>.Failure { error } => true
      _ => false
    },
    "record bounds",
  )
}

test effect fn defaultForGenerics() -> ()
  ! AssertionError<'static> {
  let table = ExtensionSubtable<'static>.default()
  match table {
    ExtensionSubtable<'static>.Single { value } => {
      run Testing.expect(
        ExtensionPosFormat1<'static, SinglePos<'static>>.extensionLookupType(&value) == 0,
        "default extension type",
      )
      let inner = ExtensionPosFormat1<'static, SinglePos<'static>>.extension(&value)
        |> Result<SinglePos<'static>, ReadError>.unwrapOr(SinglePos<'static>.default())
      run Testing.expect(
        match inner {
          SinglePos<'static>.Format1 { value: first } => true
          _ => false
        },
        "default first variant",
      )
    }
    _ => run Testing.expect(false, "default extension variant")
  }
}

import silk.core.equal { Equal }
