effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      run Testing.expect(false, "upstream fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn glyphs(array: ScalarArray<GlyphId16>, expected: &[u16]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(ScalarArray<GlyphId16>.len(&array) == expected.length, "glyph array length")
  let mut i: usize = 0
  while i < expected.length {
    let value = ScalarArray<GlyphId16>.get(&array, i)
      |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0))
    run Testing.expect(GlyphId16.toU16(value) == expected[i], "glyph array entry")
    i = i + 1
  }
}

test effect fn gdefHeader() -> ()
  ! AssertionError<'static> {
  let table = run must(Gdef.read(FontData.new(generated_layout_fixtures.gdefGdefHeader())))
  let version = Gdef.version(&table)
  run Testing.expect(version.major == 1 && version.minor == 0, "GDEF version")
  run Testing.expect(
    Offset16.toU32(Nullable<Offset16>.offset(&Gdef.markAttachClassDefOffset(&table)).*) == 90,
    "mark attachment offset",
  )
}

test effect fn glyphClassDefTable() -> ()
  ! AssertionError<'static> {
  let table = run must(
    ClassDefFormat2.read(FontData.new(generated_layout_fixtures.gdefGlyphclassdefTable())),
  )
  run Testing.expect(ClassDefFormat2.classRangeCount(&table) == 4, "range count")
  let record = run must(
    ComputedArray<'static, (), ClassRangeRecord<'static>>.get(
      &ClassDefFormat2.classRangeRecords(&table),
      3,
    ),
  )
  run Testing.expect(
    GlyphId16.toU16(ClassRangeRecord.startGlyphId(&record)) == 399
      && GlyphId16.toU16(ClassRangeRecord.endGlyphId(&record)) == 399,
    "last class range",
  )
}

test effect fn attachListTable() -> ()
  ! AssertionError<'static> {
  let table = run must(
    AttachList.read(FontData.new(generated_layout_fixtures.gdefAttachlistTable())),
  )
  run Testing.expect(
    AttachList.glyphCount(&table) == 2
      && ScalarArray<Offset16>.len(&AttachList.attachPointOffsets(&table)) == 2,
    "attachment count",
  )
  let point = run must(
    ArrayOfOffsets<'static, (), AttachPoint<'static>, Offset16>.get(
      &AttachList.attachPoints(&table),
      1,
    ),
  )
  let indices = AttachPoint.pointIndices(&point)
  run Testing.expect(
    (ScalarArray<u16>.get(&indices, 0) |> Option<u16>.unwrapOr(0)) == 14
      && (ScalarArray<u16>.get(&indices, 1) |> Option<u16>.unwrapOr(0)) == 23,
    "point indices",
  )
}

test effect fn ligCaretList() -> ()
  ! AssertionError<'static> {
  let table = run must(
    LigCaretList.read(FontData.new(generated_layout_fixtures.gdefLigcaretlistTable())),
  )
  let entries = LigCaretList.ligGlyphs(&table)
  let first = run must(ArrayOfOffsets<'static, (), LigGlyph<'static>, Offset16>.get(&entries, 0))
  let second = run must(ArrayOfOffsets<'static, (), LigGlyph<'static>, Offset16>.get(&entries, 1))
  run Testing.expect(
    ScalarArray<Offset16>.len(&LigGlyph.caretValueOffsets(&first)) == 1
      && ScalarArray<Offset16>.len(&LigGlyph.caretValueOffsets(&second)) == 2,
    "caret counts",
  )
  let a = ScalarArray<Offset16>.get(&LigGlyph.caretValueOffsets(&first), 0)
    |> Option<Offset16>.unwrapOr(Offset16.new(0))
  let b = ScalarArray<Offset16>.get(&LigGlyph.caretValueOffsets(&second), 1)
    |> Option<Offset16>.unwrapOr(Offset16.new(0))
  let ca = run must(resolve<CaretValueFormat1<'static>, Offset16>(a, LigGlyph.offsetData(&first)))
  let cb = run must(resolve<CaretValueFormat1<'static>, Offset16>(b, LigGlyph.offsetData(&second)))
  run Testing.expect(
    CaretValueFormat1.coordinate(&ca) == 603 && CaretValueFormat1.coordinate(&cb) == 1206,
    "caret coordinates",
  )
}

test effect fn caretvalueformat3() -> ()
  ! AssertionError<'static> {
  let table = run must(
    CaretValueFormat3.read(FontData.new(generated_layout_fixtures.gdefCaretvalueformat3Table())),
  )
  run Testing.expect(CaretValueFormat3.coordinate(&table) == 1206, "coordinate")
  let target = run must(CaretValueFormat3.device(&table))
  match target {
    DeviceOrVariationIndex.Device { value } => {
      run Testing.expect(
        Device.startSize(&value) == 12 && Device.endSize(&value) == 17
          && Device.deltaFormat(&value) == DeltaFormat.Local4BitDeltas,
        "device header",
      )
      let deltas = Device.deltaValue(&value)
      run Testing.expect(
        ScalarArray<u16>.len(&deltas) == 2
          && (ScalarArray<u16>.get(&deltas, 0) |> Option<u16>.unwrapOr(0)) == 4369
          && (ScalarArray<u16>.get(&deltas, 1) |> Option<u16>.unwrapOr(0)) == 8704,
        "packed device deltas",
      )
    }
    _ => run Testing.expect(false, "device variant")
  }
}

