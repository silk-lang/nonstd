  DeviceIter,
  SequenceContextFormat1,
  SequenceContextFormat2,
  SequenceContextFormat3,
  SequenceLookupRecord
}
import generated_gsub { Gsub, SubstitutionLookup }
import font_types.lib { GlyphId, Offset32, Tag }

effect fn some<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    Option<T>.None => {
      run Testing.expect(false, "expected present value")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn coverageCount(table: &CoverageTable) -> usize {
  let mut iter = CoverageTable.iter(table)
  let mut count: usize = 0
  while let Option<GlyphId>.Some { value } = move CoverageIter.next(&mut iter) {
    count = count + 1
  }
  return count
}

fn classCount(table: &ClassDef) -> usize {
  let mut iter = ClassDef.iter(table)
  let mut count: usize = 0
  while let Option<ClassEntry>.Some { value } = move ClassIter.next(&mut iter) {
    count = count + 1
  }
  return count
}

fn n16(value: u16) -> Nullable<Offset16> {
  return Nullable<Offset16>.new(Offset16.new(value))
}

fn n32(value: u32) -> Option<Nullable<Offset32>> {
  return Option<Nullable<Offset32>>.some(Nullable<Offset32>.new(Offset32.new(value)))
}

test effect fn headerOffsetPrefersNonzeroExtendedOffset() -> ()
  ! AssertionError<'static> {
  let selected = run must(HeaderOffset.select(n16(10), n32(70000), true))
  run Testing.expect(
    selected.extended && Offset32.toU32(selected.offset) == 70000,
    "extended offset selected",
  )
}

test effect fn headerOffsetFallsBackToOriginalOffset() -> ()
  ! AssertionError<'static> {
  let zero = run must(HeaderOffset.select(n16(10), n32(0), true))
  let version = run must(HeaderOffset.select(n16(10), n32(70000), false))
  let null = run must(HeaderOffset.select(n16(0), n32(0), true))
  run Testing.expect(
    !zero.extended && !version.extended && Offset32.toU32(zero.offset) == 10
      && Offset32.toU32(version.offset) == 10
      && HeaderOffset.isNull(&null),
    "original and null offsets",
  )
}

test effect fn headerOffsetRequiresExtendedFieldInExtendedHeader() -> ()
  ! AssertionError<'static> {
  let error = HeaderOffset.select(n16(10), Option<Nullable<Offset32>>.None, true)
  run Testing.expect(
    match move error {
      Result<HeaderOffset, ReadError>.Failure { error: ReadError.OutOfBounds } => true
      _ => false
    },
    "extended field required",
  )
  let original = run must(HeaderOffset.select(n16(10), Option<Nullable<Offset32>>.None, false))
  run Testing.expect(
    !original.extended && Offset32.toU32(original.offset) == 10,
    "older version ignores absent extension",
  )
}

test effect fn majorVersion2ReadsOriginalLists() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Gsub.read(FontData.new(b"\x00\x02\x00\x00\x00\x0a\x00\x0c\x00\x0e\x00\x00\x00\x00\x00\x00")),
  )
  let scripts = run must(Gsub.scriptList(&table))
  let features = run must(Gsub.featureList(&table))
  let lookups = run must(Gsub.lookupList(&table))
  run Testing.expect(
    ScriptList.scriptCount(&scripts) == 0 && FeatureList.featureCount(&features) == 0
      && SelectedLookupList<'static, SubstitutionLookup<'static>>.lookupCount(&lookups) == 0,
    "major version 2 keeps original offsets",
  )
}

test effect fn example1Scripts() -> ()
  ! AssertionError<'static> {
  let table = run must(ScriptList.read(FontData.new(generated_layout_fixtures.layoutScripts())))
  run Testing.expect(ScriptList.scriptCount(&table) == 3, "script count")
  let records = ScriptList.scriptRecords(&table)
  let expected: [u32; 3] = [1751215721, 1801547361, 1818326126]
  let mut i: usize = 0
  while i < 3 {
    let record = run must(ComputedArray<'static, (), ScriptRecord<'static>>.get(&records, i))
    run Testing.expect(Tag.toU32(ScriptRecord.scriptTag(&record)) == expected[i], "script tag")
    i = i + 1
  }
}

test effect fn example2ScriptsAndLangs() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Script.read(FontData.new(generated_layout_fixtures.layoutScriptsAndLanguages())),
  )
  let defaultResult = run some(Script.defaultLangSys(&table))
  let defaultSys = run must(move defaultResult)
  run Testing.expect(
    LangSys.requiredFeatureIndex(&defaultSys) == 65535
      && LangSys.featureIndexCount(&defaultSys) == 3
      && Script.langSysCount(&table) == 1,
    "default language system",
  )
  let record = run must(
    ComputedArray<'static, (), LangSysRecord<'static>>.get(&Script.langSysRecords(&table), 0),
  )
  run Testing.expect(Tag.toU32(LangSysRecord.langSysTag(&record)) == 1431454752, "Urdu tag")
  let urdu = run must(LangSysRecord.langSys(&record, Script.offsetData(&table)))
  run Testing.expect(
    LangSys.requiredFeatureIndex(&urdu) == 3 && LangSys.featureIndexCount(&urdu) == 3,
    "Urdu system",
  )
}

