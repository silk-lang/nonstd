import lib { FontRef, FontData, ReadError, TableProvider, ComputedArray, ScalarArray }
import tables.maxp { Maxp, SelectedMaxp }
import tables.hhea { Hhea, SelectedHhea }
import tables.hmtx { Hmtx, LongMetric, GlyphMetricRecords }
import font_types.lib { Tag, GlyphId }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "provider read succeeds")
      return Intrinsic.trap("unreachable")
    }
  }
}

test effect fn extendedGlyphCountDoesNotRequireExtendedMetrics() -> ()
  ! AssertionError<'static> {
  let font = run must(
    FontRef.new(
      b"\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x4d\x41\x58\x50\x00\x00\x00\x00\x00\x00\x00\x3c\x00\x00\x00\x07\x68\x68\x65\x61\x00\x00\x00\x00\x00\x00\x00\x44\x00\x00\x00\x24\x68\x6d\x74\x78\x00\x00\x00\x00\x00\x00\x00\x68\x00\x00\x00\x0a\x00\x00\x50\x00\x01\x11\x72\x00\x00\x01\x00\x00\x03\x20\xff\x38\x00\x32\x07\xd0\xff\x9c\xff\x9c\x07\xd0\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x01\xf4\x00\x00\x01\xf5\xff\xff\xff\xf6\x00\x00",
    ),
  )
  let profile = run must(FontRef.selectedMaxp(&font))
  run Testing.expect(SelectedMaxp.numGlyphs(&profile) == 70002, "wide glyph count")
  let metrics = run must(FontRef.hGlyphMetricRecords(&font))
  run Testing.expect(
    ComputedArray<'static, (), LongMetric<'static>>.len(&GlyphMetricRecords.longMetrics(&metrics))
      == 2,
    "legacy long metrics",
  )
  run Testing.expect(
    (GlyphMetricRecords.advance(&metrics, GlyphId.new(2)) |> Option<u16>.unwrapOr(0)) == 501,
    "last advance repeats",
  )
  run Testing.expect(
    (GlyphMetricRecords.sideBearing(&metrics, GlyphId.new(2)) |> Option<i16>.unwrapOr(0)) == -10,
    "trailing bearing",
  )
}

test effect fn malformedExtendedTablesDoNotFallBackToLegacy() -> ()
  ! AssertionError<'static> {
  let font = run must(
    FontRef.new(
      b"\x00\x01\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x48\x48\x45\x41\x00\x00\x00\x00\x00\x00\x00\x5c\x00\x00\x00\x02\x4d\x41\x58\x50\x00\x00\x00\x00\x00\x00\x00\x60\x00\x00\x00\x02\x68\x68\x65\x61\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x24\x68\x6d\x74\x78\x00\x00\x00\x00\x00\x00\x00\x88\x00\x00\x00\x0a\x6d\x61\x78\x70\x00\x00\x00\x00\x00\x00\x00\x94\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x03\x20\xff\x38\x00\x32\x07\xd0\xff\x9c\xff\x9c\x07\xd0\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x01\xf4\x00\x00\x01\xf5\xff\xff\xff\xf6\x00\x00\x00\x00\x50\x00\x00\x03\x00\x00",
    ),
  )
  run Testing.expect(
    match move FontRef.selectedMaxp(&font) {
      Result<SelectedMaxp, ReadError>.Failure { error } => true
      _ => false
    },
    "malformed wide maxp stays an error",
  )
  run Testing.expect(
    match move FontRef.selectedHhea(&font) {
      Result<SelectedHhea, ReadError>.Failure { error } => true
      _ => false
    },
    "malformed wide hhea stays an error",
  )
  let metrics = run must(FontRef.hGlyphMetricRecords(&font))
  run Testing.expect(
    (GlyphMetricRecords.advance(&metrics, GlyphId.new(0)) |> Option<u16>.unwrapOr(0)) == 500,
    "absent HMTX chooses legacy",
  )
  let missing = run must(
    FontRef.new(
      b"\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x48\x4d\x54\x58\x00\x00\x00\x00\x00\x00\x00\x3c\x00\x00\x00\x0a\x68\x68\x65\x61\x00\x00\x00\x00\x00\x00\x00\x48\x00\x00\x00\x24\x68\x6d\x74\x78\x00\x00\x00\x00\x00\x00\x00\x6c\x00\x00\x00\x0a\x01\xf4\x00\x00\x01\xf5\xff\xff\xff\xf6\x00\x00\x00\x01\x00\x00\x03\x20\xff\x38\x00\x32\x07\xd0\xff\x9c\xff\x9c\x07\xd0\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x01\xf4\x00\x00\x01\xf5\xff\xff\xff\xf6\x00\x00",
    ),
  )
  run Testing.expect(
    match move FontRef.hGlyphMetricRecords(&missing) {
      Result<GlyphMetricRecords, ReadError>.Failure { error } => true
      _ => false
    },
    "present HMTX requires HHEA",
  )
}

struct DummyProvider {}

impl TableProvider<'static> for DummyProvider {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'static>> {
    if &tag == &Tag.fromU32(1835104368) {
      return Option<FontData<'static>>.some(FontData.new(b"\x00\x00\x50\x00\x00\x03"))
    }
    if &tag == &Tag.fromU32(1751672161) {
      return Option<FontData<'static>>.some(
        FontData.new(
          b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01",
        ),
      )
    }
    if &tag == &Tag.fromU32(1752003704) {
      return Option<FontData<'static>>.some(FontData.new(b"\x00\x04\x00\x06\x00\x1e\x00\x6f"))
    }
    return Option<FontData<'static>>.None
  }
}

test effect fn bug105() -> ()
  ! AssertionError<'static> {
  let provider = DummyProvider {}
  let header = run must(TableProvider.expectTable<Hhea<'static>>(&provider))
  let profile = run must(TableProvider.maxp(&provider))
  let metrics = run must(TableProvider.hmtx(&provider))
  run Testing.expect(
    Hhea.numberOfHMetrics(&header) == 1 && Maxp.numGlyphs(&profile) == 3,
    "custom provider counts",
  )
  run Testing.expect(
    ComputedArray<'static, (), LongMetric<'static>>.len(&Hmtx.hMetrics(&metrics)) == 1,
    "one long metric",
  )
  run Testing.expect(
    ScalarArray<i16>.len(&Hmtx.leftSideBearings(&metrics)) == 2,
    "two trailing bearings",
  )
}
