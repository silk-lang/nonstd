import model.glyph { GlyphSource, GlyphSourceOrder, GlyphSources }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.io.writer { Writer, WriterError }

effect fn expectSources(order: GlyphSourceOrder, expected: &[GlyphSource]) -> ()
  ! AssertionError<'static> {
  let mut cursor = GlyphSourceOrder.iter(order)
  let mut i: usize = 0
  while let Option<GlyphSource>.Some { value } = GlyphSources.next(&mut cursor) {
    run Testing.expect(i < expected.length, "no extra sources")
    run Testing.expect(value == expected[i], "source order")
    i = i + 1
  }
  run Testing.expect(i == expected.length, "all sources visited")
}

fn all() -> [GlyphSource; 9] {
  return [
    GlyphSource.Sbix,
    GlyphSource.Cbdt,
    GlyphSource.Ebdt,
    GlyphSource.Colr,
    GlyphSource.Varc,
    GlyphSource.Glyf,
    GlyphSource.Cff2,
    GlyphSource.Cff,
    GlyphSource.Type1,
  ]
}

struct Capture {
  bytes: [u8; 32],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut i: usize = 0
    while i < bytes.length {
      self.bytes[self.length] = bytes[i]
      self.length = self.length + 1
      i = i + 1
    }
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {}
}

test effect fn namedOrdersHoldTheirSources() -> ()
  ! AssertionError<'static> | WriterError {
  run expectSources(GlyphSourceOrder.all(), &all())
  run expectSources(
    GlyphSourceOrder.default(),
    &[
      GlyphSource.Sbix,
      GlyphSource.Cbdt,
      GlyphSource.Colr,
      GlyphSource.Varc,
      GlyphSource.Glyf,
      GlyphSource.Cff2,
      GlyphSource.Cff,
      GlyphSource.Type1,
    ],
  )
  run expectSources(
    GlyphSourceOrder.bitmaps(),
    &[GlyphSource.Sbix, GlyphSource.Cbdt, GlyphSource.Ebdt],
  )
  run expectSources(GlyphSourceOrder.colorBitmaps(), &[GlyphSource.Sbix, GlyphSource.Cbdt])
  run expectSources(GlyphSourceOrder.monoBitmaps(), &[GlyphSource.Ebdt])
  run expectSources(GlyphSourceOrder.color(), &[GlyphSource.Colr])
  run expectSources(
    GlyphSourceOrder.outlines(),
    &[GlyphSource.Varc, GlyphSource.Glyf, GlyphSource.Cff2, GlyphSource.Cff, GlyphSource.Type1],
  )
  run expectSources(
    GlyphSourceOrder.baseOutlines(),
    &[GlyphSource.Glyf, GlyphSource.Cff2, GlyphSource.Cff, GlyphSource.Type1],
  )
  run Testing.expect(GlyphSourceOrder.isEmpty(GlyphSourceOrder.empty()), "named empty order")
  let mut output = Capture { bytes: [0; 32], length: 0 }
  run Format.debug(&GlyphSourceOrder.colorBitmaps()) |> Effect.provideMut<Writer>(&mut output)
  let expected = b"[Sbix, Cbdt]"
  run Testing.expect(output.length == expected.length, "debug text length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(output.bytes[i] == expected[i], "debug text")
    i = i + 1
  }
}

test effect fn orderKeepsFirstPositionOfEachSource() -> ()
  ! AssertionError<'static> {
  let order = GlyphSourceOrder.new(
    &[GlyphSource.Glyf, GlyphSource.Varc, GlyphSource.Glyf, GlyphSource.Cff],
  )
  run expectSources(order, &[GlyphSource.Glyf, GlyphSource.Varc, GlyphSource.Cff])
  run Testing.expect(
    GlyphSourceOrder.contains(order, GlyphSource.Cff)
      && !GlyphSourceOrder.contains(order, GlyphSource.Cff2),
    "source membership",
  )
}

test effect fn defaultOrderIsTheHarfbuzzExtentsChain() -> ()
  ! AssertionError<'static> {
  run expectSources(
    GlyphSourceOrder.default(),
    &[
      GlyphSource.Sbix,
      GlyphSource.Cbdt,
      GlyphSource.Colr,
      GlyphSource.Varc,
      GlyphSource.Glyf,
      GlyphSource.Cff2,
      GlyphSource.Cff,
      GlyphSource.Type1,
    ],
  )
  run Testing.expect(
    !GlyphSourceOrder.contains(GlyphSourceOrder.default(), GlyphSource.Ebdt),
    "monochrome bitmap omitted by default",
  )
}

test effect fn emptyOrderHasNoSources() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    GlyphSourceOrder.isEmpty(GlyphSourceOrder.empty())
      && !GlyphSourceOrder.contains(GlyphSourceOrder.new(&[]), GlyphSource.Glyf),
    "empty order",
  )
  run expectSources(GlyphSourceOrder.empty(), &[])
}

test effect fn everySourceRoundTripsThroughAnOrder() -> ()
  ! AssertionError<'static> {
  run expectSources(GlyphSourceOrder.new(&all()), &all())
}

import model.glyph.bitmap { BitmapSource }
import model.glyph.outline { OutlineSource }
import silk.core.result { Result }

test effect fn narrowSourcesRoundTrip() -> ()
  ! AssertionError<'static> {
  let sources = all()
  let mut i: usize = 0
  while i < sources.length {
    let source = sources[i]
    let mut kinds: usize = 0
    match move OutlineSource.tryFrom(source) {
      Result<OutlineSource, GlyphSource>.Success { value } => {
        run Testing.expect(
          OutlineSource.toGlyphSource(value) == source,
          "outline source round trip",
        )
        kinds = kinds + 1
      }
      Result<OutlineSource, GlyphSource>.Failure { error } => run Testing.expect(
        error == source,
        "outline conversion preserves rejected source",
      )
    }
    match move BitmapSource.tryFrom(source) {
      Result<BitmapSource, GlyphSource>.Success { value } => {
        run Testing.expect(BitmapSource.toGlyphSource(value) == source, "bitmap source round trip")
        kinds = kinds + 1
      }
      Result<BitmapSource, GlyphSource>.Failure { error } => run Testing.expect(
        error == source,
        "bitmap conversion preserves rejected source",
      )
    }
    let mut expected: usize = 1
    if source == GlyphSource.Colr {
      expected = 0
    }
    run Testing.expect(kinds == expected, "only COLR is neither bitmap nor outline")
    i = i + 1
  }
}
