effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "read succeeds")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn present<T>(option: Option<T>) -> T
  ! AssertionError<'static> {
  return match move option {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn failed<T>(result: Result<T, ReadError>) -> bool {
  return match move result {
    Result<T, ReadError>.Failure { error } => true
    _ => false
  }
}

effect fn sameBytes(actual: &[u8], expected: &[u8]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "byte length")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "bitmap byte")
    i = i + 1
  }
}

effect fn small<'a>(data: &BitmapData<'a>, height: u8, width: u8, x: i8, y: i8, advance: u8) -> ()
  ! AssertionError<'static> {
  match data.metrics {
    BitmapMetrics<'a>.Small { value } => {
      run Testing.expect(
        SmallGlyphMetrics.height(&value) == height && SmallGlyphMetrics.width(&value) == width
          && SmallGlyphMetrics.bearingX(&value) == x
          && SmallGlyphMetrics.bearingY(&value) == y
          && SmallGlyphMetrics.advance(&value) == advance,
        "small bitmap metrics",
      )
    }
    _ => {
      run Testing.expect(false, "small metrics variant")
    }
  }
}

effect fn bytes<'a>(data: &BitmapData<'a>, format: BitmapDataFormat, expected: &[u8]) -> ()
  ! AssertionError<'static> {
  match data.content {
    BitmapContent<'a>.Data { format: actual, bytes: value } => {
      run Testing.expect(actual == format, "bitmap encoding")
      run sameBytes(value, expected)
    }
    _ => {
      run Testing.expect(false, "bitmap bytes variant")
    }
  }
}

fn makeCase(out: &mut [u8], subtable: &[u8], last: u16, declared: u32) -> usize {
  let mut i: usize = 0
  while i < out.length {
    out[i] = 0
    i = i + 1
  }
  Builder.put32(&mut out, 0, 48)
  Builder.put32(&mut out, 4, declared)
  Builder.put32(&mut out, 8, 1)
  Builder.put16(&mut out, 42, last)
  out[46] = 1
  Builder.put16(&mut out, 50, last)
  Builder.put32(&mut out, 52, 8)
  i = 0
  while i < subtable.length {
    out[56 + i] = subtable[i]
    i = i + 1
  }
  return 56 + subtable.length
}

fn location<'a>(bytes: &'a [u8], glyph: u32) -> Result<BitmapLocation<'a>, ReadError> {
  let data = FontData.new(bytes)
  let size = match move FontData<'a>.readRefAt<BitmapSize<'a>>(&data, 0) {
    Result<BitmapSize<'a>, ReadError>.Success { value } => value
    Result<BitmapSize<'a>, ReadError>.Failure { error } => {
      return Result<BitmapLocation<'a>, ReadError>.failResult(error)
    }
  }
  return BitmapSize.location(&size, data, GlyphId.new(glyph))
}

test effect fn shortIndexTablesSizeIsIgnored() -> ()
  ! AssertionError<'static> {
  let subtable = b"\x00\x02\x00\x05\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00"
  let mut buffer: [u8; 128] = [0; 128]
  let size = makeCase(&mut buffer, subtable, 1, 8)
  let value = run must(location(Slice.view<u8>(&buffer, 0, size), 1))
  run Testing.expect(
    value.dataOffset == 4 && value.dataSize == 4,
    "ignore declared index list length",
  )
}

test effect fn format2TruncatedMetricsReturnsError() -> ()
  ! AssertionError<'static> {
  let subtable = b"\x00\x02\x00\x05\x00\x00\x00\x00\x00\x00\x00\x01"
  let mut buffer: [u8; 128] = [0; 128]
  let size = makeCase(&mut buffer, subtable, 0, 20)
  run Testing.expect(
    failed(location(Slice.view<u8>(&buffer, 0, size), 0)),
    "truncated metrics do not panic",
  )
}

test effect fn format4OffsetsIncludeTheImageBase() -> ()
  ! AssertionError<'static> {
  let subtable = b"\x00\x04\x00\x11\x00\x00\x03\xe8\x00\x00\x00\x01\x00\x00\x00\x14\x00\x01\x00\x1e"
  let mut buffer: [u8; 128] = [0; 128]
  let size = makeCase(&mut buffer, subtable, 0, 28)
  let value = run must(location(Slice.view<u8>(&buffer, 0, size), 0))
  run Testing.expect(
    value.dataOffset == 1020 && value.dataSize == 10,
    "sparse offsets are relative to image data",
  )
}

test effect fn format5TruncatedMetricsReturnsError() -> ()
  ! AssertionError<'static> {
  let subtable = b"\x00\x05\x00\x05\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00"
  let mut buffer: [u8; 128] = [0; 128]
  let size = makeCase(&mut buffer, subtable, 0, 24)
  run Testing.expect(
    failed(location(Slice.view<u8>(&buffer, 0, size), 0)),
    "truncated metrics do not panic",
  )
}

test effect fn sbixStrikesCountOverflowTable() -> ()
  ! AssertionError<'static> {
  let table = run must(Sbix.read(FontData.new(b"\x00\x01\x00\x00\xff\xff\xff\xff"), 5))
  run Testing.expect(
    Sbix.numStrikes(&table) == u32.MAX
      && ScalarArray<Offset32>.len(&Sbix.strikeOffsets(&table)) == 0,
    "oversized strike array is empty",
  )
}

test effect fn readCblc1Cbdt17() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.embeddedBitmaps()))
  let cblc = run must(FontRef.cblc(&font))
  let cbdt = run must(FontRef.cbdt(&font))
  let size = run must(
    ComputedArray<'static, (), BitmapSize<'static>>.get(&Cblc.bitmapSizes(&cblc), 0),
  )
  let hori = BitmapSize.hori(&size)
  let vert = BitmapSize.vert(&size)
  run Testing.expect(
    SbitLineMetrics.ascender(&hori) == 101 && SbitLineMetrics.descender(&hori) == -27
      && SbitLineMetrics.widthMax(&hori) == 136
      && SbitLineMetrics.ascender(&vert) == 101
      && SbitLineMetrics.descender(&vert) == -27
      && SbitLineMetrics.widthMax(&vert) == 136,
    "color strike line metrics",
  )
  run Testing.expect(
    GlyphId16.toU32(BitmapSize.startGlyphIndex(&size)) == 4
      && GlyphId16.toU32(BitmapSize.endGlyphIndex(&size)) == 4
      && BitmapSize.ppemX(&size) == 109
      && BitmapSize.ppemY(&size) == 109
      && BitmapSize.bitDepth(&size) == 32,
    "color strike descriptor",
  )
  let location = run must(BitmapSize.location(&size, Cblc.offsetData(&cblc), GlyphId.new(4)))
  run Testing.expect(location.format == 17, "PNG small metrics format")
  let data = run must(Cbdt.data(&cbdt, &location))
  run small(&data, 128, 136, 0, 101, 136)
  run bytes(&data, BitmapDataFormat.Png, b"\x89PNG\x0d\x0a\x1a\x0a")
}

test effect fn sparseBitmapGlyphIds() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.cbdtFont()))
  let cblc = run must(FontRef.cblc(&font))
  let cbdt = run must(FontRef.cbdt(&font))
  let size = run must(
    ComputedArray<'static, (), BitmapSize<'static>>.get(&Cblc.bitmapSizes(&cblc), 0),
  )
  let mut gid: u32 = 0
  while gid <= 3 {
    let location = run must(BitmapSize.location(&size, Cblc.offsetData(&cblc), GlyphId.new(gid)))
    run Testing.expect(
      failed(Cbdt.data(&cbdt, &location)) == (gid == 1),
      "missing sparse image data",
    )
    gid = gid + 1
  }
}

test effect fn readEblc3Ebdt2() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.embeddedBitmaps()))
  let eblc = run must(FontRef.eblc(&font))
  let ebdt = run must(FontRef.ebdt(&font))
  let size = run must(
    ComputedArray<'static, (), BitmapSize<'static>>.get(&Eblc.bitmapSizes(&eblc), 0),
  )
  let hori = BitmapSize.hori(&size)
  let vert = BitmapSize.vert(&size)
  run Testing.expect(
    SbitLineMetrics.ascender(&hori) == 6 && SbitLineMetrics.descender(&hori) == 2
      && SbitLineMetrics.widthMax(&hori) == 4
      && SbitLineMetrics.maxBeforeBl(&hori) == 6
      && SbitLineMetrics.minAfterBl(&hori) == -2
      && SbitLineMetrics.ascender(&vert) == 6
      && SbitLineMetrics.descender(&vert) == 2,
    "monochrome strike line metrics",
  )
  run Testing.expect(
    GlyphId16.toU32(BitmapSize.startGlyphIndex(&size)) == 1
      && GlyphId16.toU32(BitmapSize.endGlyphIndex(&size)) == 2
      && BitmapSize.ppemX(&size) == 7
      && BitmapSize.ppemY(&size) == 7
      && BitmapSize.bitDepth(&size) == 1,
    "monochrome strike descriptor",
  )
  let first = run must(BitmapSize.location(&size, Eblc.offsetData(&eblc), GlyphId.new(1)))
  let second = run must(BitmapSize.location(&size, Eblc.offsetData(&eblc), GlyphId.new(2)))
  run Testing.expect(first.format == 2 && second.format == 2, "bit-aligned small metrics")
  let data1 = run must(Ebdt.data(&ebdt, &first))
  run small(&data1, 8, 3, 1, 6, 4)
  run bytes(&data1, BitmapDataFormat.BitAligned, b"\xee\xae\xea")
  let data2 = run must(Ebdt.data(&ebdt, &second))
  run small(&data2, 8, 4, 0, 6, 4)
  run bytes(&data2, BitmapDataFormat.BitAligned, b"\xf0\xf0\xf0\xf0")
}

test effect fn readEblc2Ebdt5() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(Fixtures.embeddedBitmaps()))
  let eblc = run must(FontRef.eblc(&font))
  let ebdt = run must(FontRef.ebdt(&font))
  let size = run must(
    ComputedArray<'static, (), BitmapSize<'static>>.get(&Eblc.bitmapSizes(&eblc), 1),
  )
  let hori = BitmapSize.hori(&size)
  let vert = BitmapSize.vert(&size)
  run Testing.expect(
    SbitLineMetrics.ascender(&hori) == 12 && SbitLineMetrics.descender(&hori) == 5
      && SbitLineMetrics.widthMax(&hori) == 9
      && SbitLineMetrics.maxBeforeBl(&hori) == 12
      && SbitLineMetrics.minAfterBl(&hori) == -5
      && SbitLineMetrics.ascender(&vert) == 12
      && SbitLineMetrics.descender(&vert) == 5,
    "larger strike line metrics",
  )
  run Testing.expect(
    GlyphId16.toU32(BitmapSize.startGlyphIndex(&size)) == 3
      && GlyphId16.toU32(BitmapSize.endGlyphIndex(&size)) == 3
      && BitmapSize.ppemX(&size) == 15
      && BitmapSize.ppemY(&size) == 15
      && BitmapSize.bitDepth(&size) == 1,
    "larger strike descriptor",
  )
  let location = run must(BitmapSize.location(&size, Eblc.offsetData(&eblc), GlyphId.new(3)))
  let metrics = match &location.metrics {
    Option<BigGlyphMetrics<'static>>.Some { value } => value
    _ => {
      run Testing.expect(false, "external metrics present")
      return
    }
  }
  run Testing.expect(
    BigGlyphMetrics.height(&metrics) == 17 && BigGlyphMetrics.width(&metrics) == 9
      && BigGlyphMetrics.horiBearingX(&metrics) == 0
      && BigGlyphMetrics.horiBearingY(&metrics) == 12
      && BigGlyphMetrics.horiAdvance(&metrics) == 9
      && BigGlyphMetrics.vertBearingX(&metrics) == -4
      && BigGlyphMetrics.vertBearingY(&metrics) == -9
      && BigGlyphMetrics.vertAdvance(&metrics) == 0,
    "location-supplied full metrics",
  )
  run Testing.expect(location.format == 5, "external metrics format")
  let data = run must(Ebdt.data(&ebdt, &location))
  run bytes(
    &data,
    BitmapDataFormat.BitAligned,
    b"\xaa\xbb\xcc\xdd\x00\x11\x22\x33\xff\xee\x12\x34\x42\x42\x42\xaa\x88\x99\x00\x11",
  )
}
