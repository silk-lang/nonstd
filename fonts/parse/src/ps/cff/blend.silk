import tables.variations {
  ItemVariationStore,
  ItemVariationData,
  VariationRegionList,
  VariationRegion
}
import array { ScalarArray, ComputedArray }
import offset_array { ArrayOfNullableOffsets }
import font_types.lib { Fixed, F2Dot14, Offset32 }
import model.error { Error }
import ps.read { take, takeRead, require }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.num.u16

pub struct BlendState<'a, 'c> {
  store: ItemVariationStore<'a>,
  coords: &'c [F2Dot14],
  storeIndex: u16,
  regionIndices: ScalarArray<'a, u16>,
  cachedScalars: [Fixed; 16],
}

impl<'a, 'c> Copy for BlendState<'a, 'c> {}

impl<'a, 'c> BlendState<'a, 'c> {
  pub fn new(store: ItemVariationStore<'a>, coords: &'c [F2Dot14], storeIndex: u16) -> Result<
    Self,
    Error
  > {
    return run Effect.result(BlendState<'a, 'c>.newImpl(store, coords, storeIndex))
  }

  effect fn newImpl(store: ItemVariationStore<'a>, coords: &'c [F2Dot14], storeIndex: u16) -> Self
    ! Error {
    let mut result = Self {
      store: store,
      coords: coords,
      storeIndex: storeIndex,
      regionIndices: ScalarArray<u16>.empty(),
      cachedScalars: [Fixed.zero(); 16],
    }
    run BlendState.update(&mut result)
    return result
  }

  pub fn setStoreIndex(self: &mut Self, storeIndex: u16) -> Result<(), Error> {
    if self.storeIndex != storeIndex {
      self.storeIndex = storeIndex
      return run Effect.result(BlendState.update(&mut self))
    }
    return Result<(), Error>.succeed(())
  }

  pub fn regionCount(self: &Self) -> Result<usize, Error> {
    return Result<usize, Error>.succeed(ScalarArray<u16>.len(&self.regionIndices))
  }

  pub fn scalars<'s>(self: &'s Self) -> Result<Scalars<'s, 'a, 'c>, Error> {
    return Result<Scalars<'s, 'a, 'c>, Error>.succeed(Scalars<'s, 'a, 'c> { state: self, index: 0 })
  }

  effect fn update(self: &mut Self) -> ()
    ! Error {
    self.regionIndices = ScalarArray<u16>.empty()
    let data = run takeRead(
      run require(
        ArrayOfNullableOffsets<'a, (), ItemVariationData<'a>, Offset32>.get(
          &ItemVariationStore.itemVariationData(&self.store),
          u16.toUsize(self.storeIndex),
        ),
        Error.Malformed,
      ),
    )
    let indices = ItemVariationData.regionIndexes(&data)
    let list = run takeRead(ItemVariationStore.variationRegionList(&self.store))
    let regions = VariationRegionList.variationRegions(&list)
    let mut i: usize = 0
    while i < 16 && i < ScalarArray<u16>.len(&indices) {
      let index = run require(ScalarArray<u16>.get(&indices, i), Error.Malformed)
      let region = run takeRead(
        ComputedArray<'a, u16, VariationRegion<'a>>.get(&regions, u16.toUsize(index)),
      )
      self.cachedScalars[i] = VariationRegion.computeScalar(&region, self.coords)
      i = i + 1
    }
    self.regionIndices = indices
  }

  fn regionScalar(self: &Self, index: u16) -> Result<Fixed, Error> {
    return run Effect.result(BlendState.regionScalarImpl(self, index))
  }

  effect fn regionScalarImpl(self: &Self, index: u16) -> Fixed
    ! Error {
    let list = run takeRead(ItemVariationStore.variationRegionList(&self.store))
    let region = run takeRead(
      ComputedArray<'a, u16, VariationRegion<'a>>.get(
        &VariationRegionList.variationRegions(&list),
        u16.toUsize(index),
      ),
    )
    return VariationRegion.computeScalar(&region, self.coords)
  }
}

pub struct Scalars<'s, 'a, 'c> {
  state: &'s BlendState<'a, 'c>,
  index: usize,
}

impl<'s, 'a, 'c> Scalars<'s, 'a, 'c> {
  pub fn next(self: &mut Self) -> Option<Result<Fixed, Error>> {
    if self.index >= ScalarArray<u16>.len(&self.state.regionIndices) {
      return Option<Result<Fixed, Error>>.None
    }
    let index = self.index
    self.index = self.index + 1
    if index < 16 {
      return Option<Result<Fixed, Error>>.some(
        Result<Fixed, Error>.succeed(self.state.cachedScalars[index]),
      )
    }
    let region = ScalarArray<u16>.get(&self.state.regionIndices, index) |> Option<u16>.unwrapOr(0)
    return Option<Result<Fixed, Error>>.some(BlendState.regionScalar(self.state, region))
  }
}
