import ps.cff.index_offset { readOffset, indexItem }

impl<'a> Index<'a> {
  pub fn sizeInBytes(self: &Self) -> Option<usize> {
    let count = u32.toUsize(Index.count(self))
    if count == 0 {
      return Option<usize>.some(4)
    }
    let last = match move Index.getOffset(self, count) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<usize>.None
      }
    }
    return usize.checkedAdd(5 + ScalarArray<u8>.len(&Index.offsets(self)), last)
  }

  pub fn getOffset(self: &Self, index: usize) -> Option<usize> {
    return readOffset(
      index,
      u32.toUsize(Index.count(self)),
      Index.offSize(self),
      ScalarArray<u8>.offsetData(&Index.offsets(self)),
    )
  }

  @inlineAlways
  pub fn get(self: &Self, index: usize) -> Option<&'a [u8]> {
    return indexItem(
      FontData.asBytes(&self._fontData),
      u32.toUsize(Index.count(self)),
      Index.offSize(self),
      self._fieldRanges[2],
      index,
    )
  }
}
