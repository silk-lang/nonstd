import lib { FontData, ReadError, ScalarArray }
import tables.hmtx { Hmtx }
import tables.os2 { Os2 }
import font_types.lib { GlyphId }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.usize
import silk.testing.testing { Testing, AssertionError }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "table read succeeds")
      return Intrinsic.trap("unreachable")
    }
  }
}

test effect fn trimmedAdvances() -> ()
  ! AssertionError<'static> {
  let table = run must(Hmtx.read(FontData.new(b"\x03\x20\x00\x64\x00\x00\x00\x64\x00\x00"), 1))
  run Testing.expect(
    ScalarArray<i16>.len(&Hmtx.leftSideBearings(&table)) > 0,
    "trimmed fixture has bare bearings",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(0)) |> Option<u16>.unwrapOr(0)) == 800,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(0)) |> Option<i16>.unwrapOr(-32768)) == 100,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(1)) |> Option<u16>.unwrapOr(0)) == 800,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(1)) |> Option<i16>.unwrapOr(-32768)) == 0,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(2)) |> Option<u16>.unwrapOr(0)) == 800,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(2)) |> Option<i16>.unwrapOr(-32768)) == 100,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(3)) |> Option<u16>.unwrapOr(0)) == 800,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(3)) |> Option<i16>.unwrapOr(-32768)) == 0,
    "bearing",
  )
}

test effect fn metrics() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Hmtx.read(FontData.new(b"\x03\x8c\x00\x64\x05\x38\x00\x1d\x05\x38\x00\x1d\x02\x79\x00\x39"), 4),
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(0)) |> Option<u16>.unwrapOr(0)) == 908,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(0)) |> Option<i16>.unwrapOr(-32768)) == 100,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(1)) |> Option<u16>.unwrapOr(0)) == 1336,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(1)) |> Option<i16>.unwrapOr(-32768)) == 29,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(2)) |> Option<u16>.unwrapOr(0)) == 1336,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(2)) |> Option<i16>.unwrapOr(-32768)) == 29,
    "bearing",
  )
  run Testing.expect(
    (Hmtx.advance(&table, GlyphId.new(3)) |> Option<u16>.unwrapOr(0)) == 633,
    "advance",
  )
  run Testing.expect(
    (Hmtx.sideBearing(&table, GlyphId.new(3)) |> Option<i16>.unwrapOr(-32768)) == 57,
    "bearing",
  )
}

test effect fn missingLeftSideBearings() -> ()
  ! AssertionError<'static> {
  let table = run must(Hmtx.read(FontData.new(b"\x01\xf4\x00\x32\x02\x58\x00\x3c"), 2))
  let advances: [u16; 4] = [500, 600, 600, 600]
  let mut i: usize = 0
  while i < 4 {
    run Testing.expect(
      (Hmtx.advance(&table, GlyphId.new(usize.toU32(i))) |> Option<u16>.unwrapOr(0)) == advances[i],
      "last advance repeats",
    )
    if i < 2 {
      run Testing.expect(
        (Hmtx.sideBearing(&table, GlyphId.new(usize.toU32(i))) |> Option<i16>.unwrapOr(0))
          == usize.toI16(50 + i * 10),
        "long bearing",
      )
    } else {
      run Testing.expect(
        match move Hmtx.sideBearing(&table, GlyphId.new(usize.toU32(i))) {
          Option<i16>.None => true
          _ => false
        },
        "missing bearing",
      )
    }
    i = i + 1
  }
}

test effect fn os2ReadSample() -> ()
  ! AssertionError<'static> {
  let table = run must(
    Os2.read(
      FontData.new(
        b"\x00\x04\x04\xfb\x01\x90\x00\x05\x00\x04\x02\x9a\x02\x66\x00\x00\x00\x4d\x02\x9a\x02\x66\x00\x00\x01\x66\x00\x33\x01\x33\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x4e\x4f\x4e\x45\x00\xc0\x00\x0e\x00\x20\x03\xb6\xff\x06\x00\x00\x03\xb6\x00\xfa\x00\x00\x00\x01\x00\x00\x00\x00\x02\x00\x02\xcd\x00\x00\x00\x20\x00\x00",
      ),
    ),
  )
  run Testing.expect(Os2.version(&table) == 4, "sample version")
}
