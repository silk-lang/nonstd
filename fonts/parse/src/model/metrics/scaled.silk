import model.metrics.glyph { GlyphMetrics }
import model.metrics.extents { GlyphExtents, zeroExtents }
import model.metrics.global { LineExtents }
import model.metrics.convert { MetricConverter }
import model.glyph { GlyphSourceOrder }
import model.optional { Maybe }
import font_types.lib { F48Dot16, F26Dot6, Fixed, GlyphId }
import silk.geometry.rect { Rect }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.f32

pub interface Scale<V> {
  fn add(a: V, b: V) -> V

  fn sub(a: V, b: V) -> V

  fn half(value: V) -> V

  fn scaleX(self: &Self, value: F48Dot16) -> V

  fn scaleY(self: &Self, value: F48Dot16) -> V

  fn scaleGlyphExtents(self: &Self, value: GlyphExtents<F48Dot16>) -> GlyphExtents<V>

  fn scaleRect(self: &Self, value: Rect<F48Dot16>) -> Rect<V>

  fn ppem(self: &Self) -> Option<f32> {
    return Option<f32>.None
  }
}

pub struct Scale26Dot6 {
  x: Fixed,
  y: Fixed,
  size: f32,
}

impl Copy for Scale26Dot6 {}

impl Scale26Dot6 {
  pub fn new(xPpem: f32, yPpem: f32, unitsPerEm: u16) -> Self {
    let mut size = xPpem
    if yPpem > size || f32.isNaN(size) {
      size = yPpem
    }
    return Self { x: scaleFactor(xPpem, unitsPerEm), y: scaleFactor(yPpem, unitsPerEm), size: size }
  }

  pub fn fromPpem(ppem: f32, unitsPerEm: u16) -> Self {
    return Scale26Dot6.new(ppem, ppem, unitsPerEm)
  }
}

fn scaleFactor(ppem: f32, unitsPerEm: u16) -> Fixed {
  let mut units = unitsPerEm
  if units == 0 {
    units = 1
  }
  return Fixed.fromBits(f32ToI32(ppem * 64.0)) / Fixed.fromBits(u16.toI32(units))
}

fn scaleFixed(value: F48Dot16, factor: Fixed) -> F26Dot6 {
  return F26Dot6.fromBits(Fixed.toBits(Fixed.fromBits(F48Dot16.toI32(value)) * factor))
}

fn roundAway(value: F48Dot16) -> F48Dot16 {
  let bits = F48Dot16.toBits(value)
  let mut bias: i64 = 32768
  if bits < 0 {
    bias = bias - 1
  }
  return F48Dot16.fromBits(i64.wrappingAdd(bits, bias) & -65536)
}

impl Scale<F26Dot6> for Scale26Dot6 {
  fn add(a: F26Dot6, b: F26Dot6) -> F26Dot6 {
    return F26Dot6.saturatingAdd(a, b)
  }

  fn sub(a: F26Dot6, b: F26Dot6) -> F26Dot6 {
    return F26Dot6.saturatingSub(a, b)
  }

  fn half(value: F26Dot6) -> F26Dot6 {
    return F26Dot6.fromBits(i32.shiftRight(F26Dot6.toBits(value), 1))
  }

  fn scaleX(self: &Self, value: F48Dot16) -> F26Dot6 {
    return scaleFixed(value, self.x)
  }

  fn scaleY(self: &Self, value: F48Dot16) -> F26Dot6 {
    return scaleFixed(value, self.y)
  }

  fn scaleGlyphExtents(self: &Self, value: GlyphExtents<F48Dot16>) -> GlyphExtents<F26Dot6> {
    if F48Dot16.toBits(value.width) <= 0 || F48Dot16.toBits(value.height) <= 0 {
      return GlyphExtents<F26Dot6> {
        xBearing: F26Dot6.zero(),
        yBearing: F26Dot6.zero(),
        width: F26Dot6.zero(),
        height: F26Dot6.zero(),
      }
    }
    let left = roundAway(value.xBearing)
    let top = roundAway(value.yBearing)
    let right = roundAway(value.xBearing + value.width)
    let bottom = roundAway(value.yBearing - value.height)
    return GlyphExtents<F26Dot6> {
      xBearing: scaleFixed(left, self.x),
      yBearing: scaleFixed(top, self.y),
      width: scaleFixed(right - left, self.x),
      height: scaleFixed(top - bottom, self.y),
    }
  }

  fn scaleRect(self: &Self, value: Rect<F48Dot16>) -> Rect<F26Dot6> {
    return Rect<F26Dot6> {
      xMin: scaleFixed(value.xMin, self.x),
      yMin: scaleFixed(value.yMin, self.y),
      xMax: scaleFixed(value.xMax, self.x),
      yMax: scaleFixed(value.yMax, self.y),
    }
  }

  fn ppem(self: &Self) -> Option<f32> {
    return Option<f32>.some(self.size)
  }
}

pub struct ScaleF32 {
  x: f32,
  y: f32,
  size: f32,
}

impl Copy for ScaleF32 {}

impl ScaleF32 {
  pub fn new(xPpem: f32, yPpem: f32, unitsPerEm: u16) -> Self {
    let mut units = unitsPerEm
    if units == 0 {
      units = 1
    }
    let mut size = xPpem
    if yPpem > size || f32.isNaN(size) {
      size = yPpem
    }
    return Self { x: xPpem / u16.toF32(units), y: yPpem / u16.toF32(units), size: size }
  }

  pub fn fromPpem(ppem: f32, unitsPerEm: u16) -> Self {
    return ScaleF32.new(ppem, ppem, unitsPerEm)
  }
}

impl Scale<f32> for ScaleF32 {
  fn add(a: f32, b: f32) -> f32 {
    return a + b
  }

  fn sub(a: f32, b: f32) -> f32 {
    return a - b
  }

  fn half(value: f32) -> f32 {
    return value * 0.5
  }

  fn scaleX(self: &Self, value: F48Dot16) -> f32 {
    return F48Dot16.toF32(value) * self.x
  }

  fn scaleY(self: &Self, value: F48Dot16) -> f32 {
    return F48Dot16.toF32(value) * self.y
  }

  fn scaleGlyphExtents(self: &Self, value: GlyphExtents<F48Dot16>) -> GlyphExtents<f32> {
    return GlyphExtents<f32> {
      xBearing: F48Dot16.toF32(value.xBearing) * self.x,
      yBearing: F48Dot16.toF32(value.yBearing) * self.y,
      width: F48Dot16.toF32(value.width) * self.x,
      height: F48Dot16.toF32(value.height) * self.y,
    }
  }

  fn scaleRect(self: &Self, value: Rect<F48Dot16>) -> Rect<f32> {
    return Rect<f32> {
      xMin: F48Dot16.toF32(value.xMin) * self.x,
      yMin: F48Dot16.toF32(value.yMin) * self.y,
      xMax: F48Dot16.toF32(value.xMax) * self.x,
      yMax: F48Dot16.toF32(value.yMax) * self.y,
    }
  }

  fn ppem(self: &Self) -> Option<f32> {
    return Option<f32>.some(self.size)
  }
}

// The numeric result is an explicit interface parameter in place of Rust's
// associated Value type. Extents providers are static, and may borrow per query.
pub interface GlyphExtentsProvider<V> {
  fn extents(self: &Self, glyph: GlyphId) -> Option<GlyphExtents<V>>
}

pub struct NoExtents {}

impl<V> GlyphExtentsProvider<V> for NoExtents {
  fn extents(self: &Self, glyph: GlyphId) -> Option<GlyphExtents<V>> {
    return Option<GlyphExtents<V>>.None
  }
}

pub struct ScaledGlyphMetrics<'a, 'c, 'e, S: Scale<V>, V: Copy, E: GlyphExtentsProvider<V>> {
  metrics: GlyphMetrics<'a, 'c>,
  scale: S,
  line: Maybe<LineExtents<V>>,
  provider: Maybe<&'e E>,
}

impl<
  'a,
  'c,
  'e,
  S: Scale<V> + Copy,
  V: Copy,
  E: GlyphExtentsProvider<V>
> Copy for ScaledGlyphMetrics<'a, 'c, 'e, S, V, E> {}

impl<'a, 'c, 'e, S, V, E> ScaledGlyphMetrics<'a, 'c, 'e, S, V, E> {
  pub fn new(metrics: GlyphMetrics<'a, 'c>, scale: S) -> Self {
    return Self {
      metrics: GlyphMetrics.withBitmapPpem(metrics, Scale.ppem(&scale)),
      scale: move scale,
      line: Maybe<LineExtents<V>>.None,
      provider: Maybe<&'e E>.None,
    }
  }

  /// The unscaled metrics these scale.
  pub fn exact(self: &Self) -> &GlyphMetrics<'a, 'c> {
    return &self.metrics
  }

  pub fn scaling(self: &Self) -> &S {
    return &self.scale
  }

  pub fn withLineExtents(self: Self, line: Option<LineExtents<V>>) -> Self {
    return Self {
      metrics: self.metrics,
      scale: move self.scale,
      line: Maybe<LineExtents<V>>.fromOption(move line),
      provider: self.provider,
    }
  }

  pub fn withExtentsSourceOrder(self: Self, order: GlyphSourceOrder) -> Self {
    return Self {
      metrics: GlyphMetrics.withExtentsSourceOrder(self.metrics, order),
      scale: move self.scale,
      line: self.line,
      provider: self.provider,
    }
  }

  pub fn withGlyphExtents<'b, F: GlyphExtentsProvider<V>>(
    self: Self,
    provider: Option<&'b F>,
  ) -> ScaledGlyphMetrics<'a, 'c, 'b, S, V, F> {
    return ScaledGlyphMetrics<'a, 'c, 'b, S, V, F> {
      metrics: self.metrics,
      scale: move self.scale,
      line: self.line,
      provider: Maybe<&'b F>.fromOption(move provider),
    }
  }

  @inlineAlways
  pub fn hAdvance(self: &Self, glyph: GlyphId) -> V {
    return Scale.scaleX(&self.scale, GlyphMetrics.hAdvanceExact(&self.metrics, glyph))
  }

  pub fn vAdvance(self: &Self, glyph: GlyphId) -> V {
    if !GlyphMetrics.statesVerticalAdvances(&self.metrics) {
      let line = ScaledGlyphMetrics.originLine(self)
      return scaleSub<S, V>(line.ascender, line.descender)
    }
    return Scale.scaleY(&self.scale, GlyphMetrics.vAdvanceExact(&self.metrics, glyph))
  }

  pub fn originLine(self: &Self) -> LineExtents<V> {
    if let Maybe<LineExtents<V>>.Some { value } = self.line {
      return value
    }
    let line = GlyphMetrics.originLine(&self.metrics)
    return LineExtents<V> {
      ascender: Scale.scaleY(&self.scale, line.ascender),
      descender: Scale.scaleY(&self.scale, line.descender),
    }
  }

  pub effect fn extents(self: &Self, glyph: GlyphId) -> Option<GlyphExtents<V>>
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Maybe<&'e E>.Some { value } = self.provider {
      return GlyphExtentsProvider.extents(value, glyph)
    }
    if let Option<GlyphExtents<F48Dot16>>.Some { value } = run GlyphMetrics.extentsExact(
      &self.metrics,
      glyph,
    ) {
      return Option<GlyphExtents<V>>.some(Scale.scaleGlyphExtents(&self.scale, value))
    }
    return Option<GlyphExtents<V>>.None
  }

  pub effect fn vOriginY(self: &Self, glyph: GlyphId) -> V
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Option<F48Dot16>.Some { value } = GlyphMetrics.statedVOrigin(&self.metrics, glyph) {
      return Scale.scaleY(&self.scale, value)
    }
    if let Option<F48Dot16>.Some { value } = run GlyphMetrics.glyfVOrigin(&self.metrics, glyph) {
      return Scale.scaleY(&self.scale, value)
    }
    let line = ScaledGlyphMetrics.originLine(self)
    if let Option<GlyphExtents<V>>.Some { value } = run ScaledGlyphMetrics.extents(self, glyph) {
      return scaleAdd<S, V>(
        value.yBearing,
        scaleHalf<S, V>(
          scaleSub<S, V>(scaleSub<S, V>(line.ascender, line.descender), value.height),
        ),
      )
    }
    return line.ascender
  }

  pub fn hAdvanceBatched<O, C: MetricConverter<V, O>>(
    self: &Self,
    convert: &C,
    glyphs: &[GlyphId],
    outputs: &mut [O],
  ) -> () {
    let mut count = glyphs.length
    if outputs.length < count {
      count = outputs.length
    }
    let mut i: usize = 0
    while i < count {
      outputs[i] = MetricConverter.convert(convert, ScaledGlyphMetrics.hAdvance(self, glyphs[i]))
      i = i + 1
    }
  }

  pub fn vAdvanceBatched<O, C: MetricConverter<V, O>>(
    self: &Self,
    convert: &C,
    glyphs: &[GlyphId],
    outputs: &mut [O],
  ) -> () {
    let mut count = glyphs.length
    if outputs.length < count {
      count = outputs.length
    }
    let mut i: usize = 0
    while i < count {
      outputs[i] = MetricConverter.convert(convert, ScaledGlyphMetrics.vAdvance(self, glyphs[i]))
      i = i + 1
    }
  }

  pub effect fn vOriginYBatched<O, C: MetricConverter<V, O>>(
    self: &Self,
    convert: &C,
    glyphs: &[GlyphId],
    outputs: &mut [O],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut count = glyphs.length
    if outputs.length < count {
      count = outputs.length
    }
    let mut i: usize = 0
    while i < count {
      outputs[i] = MetricConverter.convert(
        convert,
        run ScaledGlyphMetrics.vOriginY(self, glyphs[i]),
      )
      i = i + 1
    }
  }

  pub effect fn extentsBatched<O, C: MetricConverter<Option<GlyphExtents<V>>, O>>(
    self: &Self,
    convert: &C,
    glyphs: &[GlyphId],
    outputs: &mut [O],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut count = glyphs.length
    if outputs.length < count {
      count = outputs.length
    }
    let mut i: usize = 0
    while i < count {
      outputs[i] = MetricConverter.convert(convert, run ScaledGlyphMetrics.extents(self, glyphs[i]))
      i = i + 1
    }
  }
}

fn scaleAdd<S: Scale<V>, V>(a: V, b: V) -> V {
  return Scale<V>.add(move a, move b)
}

fn scaleSub<S: Scale<V>, V>(a: V, b: V) -> V {
  return Scale<V>.sub(move a, move b)
}

fn scaleHalf<S: Scale<V>, V>(a: V) -> V {
  return Scale<V>.half(move a)
}

fn f32ToI32(value: f32) -> i32 {
  if f32.isNaN(value) {
    return 0
  }
  if value >= 2147483648.0 {
    return 2147483647
  }
  if value <= -2147483648.0 {
    return -2147483648
  }
  return f32.toI32(value)
}
