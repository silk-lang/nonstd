import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.core.equal { Equal }
import silk.text.format { Debug, Formatter }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.u64

pub enum GlyphSource {
  Sbix = 1,
  Cbdt,
  Ebdt,
  Colr,
  Varc,
  Glyf,
  Cff2,
  Cff,
  Type1,
}

pub struct GlyphSourceOrder {
  packed: u64,
}

impl Copy for GlyphSourceOrder {}

impl Equal for GlyphSourceOrder {
  fn equals(a: &Self, b: &Self) -> bool {
    return a.packed == b.packed
  }
}

impl GlyphSourceOrder {
  pub fn new(sources: &[GlyphSource]) -> Self {
    let mut result = Self { packed: 0 }
    let mut count: u64 = 0
    let mut i: usize = 0
    while i < sources.length && count < 9 {
      let source = sources[i]
      i = i + 1
      if GlyphSourceOrder.contains(result, source) {
        continue
      }
      result.packed = result.packed | u64.shiftLeft(u8.toU64(GlyphSource.value(source)), count * 4)
      count = count + 1
    }
    return result
  }

  pub fn contains(self: Self, source: GlyphSource) -> bool {
    let mut packed = self.packed
    while packed != 0 {
      if (packed & 15) == u8.toU64(GlyphSource.value(source)) {
        return true
      }
      packed = u64.shiftRight(packed, 4)
    }
    return false
  }

  pub fn isEmpty(self: Self) -> bool {
    return self.packed == 0
  }

  pub fn iter(self: Self) -> GlyphSources {
    return GlyphSources { packed: self.packed }
  }

  pub fn default() -> Self {
    return Self { packed: 0x98765421 }
  }

  pub fn all() -> Self {
    return Self { packed: 0x987654321 }
  }

  pub fn outlines() -> Self {
    return Self { packed: 0x98765 }
  }

  pub fn baseOutlines() -> Self {
    return Self { packed: 0x9876 }
  }

  pub fn bitmaps() -> Self {
    return Self { packed: 0x321 }
  }

  pub fn colorBitmaps() -> Self {
    return Self { packed: 0x21 }
  }

  pub fn monoBitmaps() -> Self {
    return Self { packed: 3 }
  }

  pub fn color() -> Self {
    return Self { packed: 4 }
  }

  pub fn empty() -> Self {
    return Self { packed: 0 }
  }
}

pub struct GlyphSources {
  packed: u64,
}

impl Copy for GlyphSources {}

impl GlyphSources {
  pub fn next(self: &mut Self) -> Option<GlyphSource> {
    let nibble = self.packed & 15
    self.packed = u64.shiftRight(self.packed, 4)
    return match nibble {
      1 => Option<GlyphSource>.some(GlyphSource.Sbix)
      2 => Option<GlyphSource>.some(GlyphSource.Cbdt)
      3 => Option<GlyphSource>.some(GlyphSource.Ebdt)
      4 => Option<GlyphSource>.some(GlyphSource.Colr)
      5 => Option<GlyphSource>.some(GlyphSource.Varc)
      6 => Option<GlyphSource>.some(GlyphSource.Glyf)
      7 => Option<GlyphSource>.some(GlyphSource.Cff2)
      8 => Option<GlyphSource>.some(GlyphSource.Cff)
      9 => Option<GlyphSource>.some(GlyphSource.Type1)
      _ => Option<GlyphSource>.None
    }
  }
}

impl Debug for GlyphSourceOrder {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("[")
    let mut iter = GlyphSourceOrder.iter(self.*)
    let mut first = true
    while let Option<GlyphSource>.Some { value } = GlyphSources.next(&mut iter) {
      if !first {
        run Writer.writeString(", ")
      }
      first = false
      let name = match value {
        GlyphSource.Sbix => "Sbix"
        GlyphSource.Cbdt => "Cbdt"
        GlyphSource.Ebdt => "Ebdt"
        GlyphSource.Colr => "Colr"
        GlyphSource.Varc => "Varc"
        GlyphSource.Glyf => "Glyf"
        GlyphSource.Cff2 => "Cff2"
        GlyphSource.Cff => "Cff"
        GlyphSource.Type1 => "Type1"
      }
      run Writer.writeString(name)
    }
    run Writer.writeString("]")
  }
}
