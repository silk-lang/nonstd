//! Fontations parser errors and static read contracts.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import font_types.lib { Tag }
import font_data { FontData }
import silk.core.result { Result }
import silk.core.ownership { Copy }

pub union ReadError {
  OutOfBounds,
  InvalidFormat { pub value: i64 },
  InvalidSfnt { pub value: u32 },
  InvalidTtc { pub tag: Tag },
  InvalidCollectionIndex { pub index: u32 },
  InvalidArrayLen,
  ValidationError,
  NullOffset,
  TableIsMissing { pub tag: Tag },
  MalformedData { pub message: string<'static> },
}

impl Copy for ReadError {}

/// Args is explicit because Silk interfaces do not have Rust associated types.
pub interface FontRead<'a, Args> {
  fn readWithArgs(data: FontData<'a>, args: Args) -> Result<Self, ReadError>
}

pub interface FontReadAt<'a, Args> {
  fn readAt(data: FontData<'a>, offset: usize, args: Args) -> Result<Self, ReadError>
}

pub interface ComputeSize<Args> {
  fn computeSize(args: Args) -> Result<usize, ReadError>
}

pub fn readWithArgs<'a, Args, T: FontRead<'a, Args>>(data: FontData<'a>, args: Args) -> Result<
  T,
  ReadError
> {
  return FontRead.readWithArgs(data, move args)
}

pub fn readAtWithArgs<'a, Args, T: FontReadAt<'a, Args>>(
  data: FontData<'a>,
  offset: usize,
  args: Args,
) -> Result<T, ReadError> {
  return FontReadAt.readAt(data, offset, move args)
}

pub fn computeSize<Args, T: ComputeSize<Args>>(args: Args) -> Result<usize, ReadError> {
  return ComputeSize.computeSize(move args)
}

import silk.core.option { Option }
import silk.num.usize

pub interface VarSize {
  fn readLenAt(data: FontData, position: usize) -> Option<usize>
}

pub fn readLenAt<T: VarSize>(data: FontData, position: usize) -> Option<usize> {
  return VarSize.readLenAt(data, position)
}

pub fn totalLenForCount<T: VarSize>(data: FontData, count: usize) -> Result<usize, ReadError> {
  let mut position: usize = 0
  let mut i: usize = 0
  while i < count {
    let size = match move readLenAt<T>(data, position) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    if size == 0 {
      return Result<usize, ReadError>.succeed(position)
    }
    position = match move usize.checkedAdd(position, size) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<usize, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    i = i + 1
  }
  return Result<usize, ReadError>.succeed(position)
}

/// A format discriminator known from the table grammar.
pub interface Format<T> {
  fn formatValue() -> T
}

pub fn formatValue<T, F: Format<T>>() -> T {
  return Format.formatValue()
}

impl<'a> FontRead<'a, ()> for () {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Result<Self, ReadError>.succeed(())
  }
}

// State-table payloads retain the same BigEndian value wrapper as upstream.
import font_types.lib { Scalar, BigEndian }

impl<'a, T: Scalar> FontRead<'a, ()> for BigEndian<T> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return FontData<'a>.readBeAt<T>(&data, 0)
  }
}
