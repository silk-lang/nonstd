import font_data { FontData }
import array { ComputedArray }
import read { ReadError }
import generated_layout {
  FeatureVariations,
  LookupVariations,
  LookupVariationRecord,
  FeatureLookups
}
import model.error { Error }
import font_types.lib { F2Dot14 }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.slice { Slice }

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      run Testing.expect(false, "fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    Option<T>.None => {
      run Testing.expect(false, "fixture value present")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn isNone<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.None => true
    _ => false
  }
}

fn noDelta(index: u32) -> Result<f64, Error> {
  return Result<f64, Error>.succeed(0.0)
}

fn variationBytes() -> &'static [u8] {
  return b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x12\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x1a\x00\x00\x00\x22\x00\x00\x00\x00\x00\x00\x00\x28\x00\x01\x00\x00\x20\x00\x40\x00\x00\x02\x00\x07\x00\x08\x00\x01\x00\x09"
}

fn addBytes() -> &'static [u8] {
  return b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x12\x00\x01\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x1a\x00\x00\x00\x22\x00\x00\x00\x00\x00\x00\x00\x28\x00\x01\x00\x00\x20\x00\x40\x00\x00\x02\x00\x07\x00\x08\x00\x01\x00\x09"
}

fn sharedBytes() -> &'static [u8] {
  return b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x00\x00\x00\x12\x00\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x22\x00\x00\x00\x00\x00\x00\x00\x22\x00\x00\x00\x00\x00\x00\x00\x22\x00\x02\x00\x07\x00\x08"
}

effect fn listOf(values: &[u16]) -> List<u16>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = List<u16>.make()
  let mut i: usize = 0
  while i < values.length {
    run List<u16>.append(&mut result, values[i])
    i = i + 1
  }
  return move result
}

effect fn same(list: &List<u16>, expected: &[u16]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(List<u16>.length(list) == expected.length, "lookup count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(List<u16>.get(list, i) == expected[i], "lookup index")
    i = i + 1
  }
}

effect fn replaceByLocation() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(FeatureVariations.read(FontData.new(variationBytes())))
  let variations = run some(FeatureVariations.lookupVariations(&table))
  let mut lookups = run listOf(&[1, 2])
  run Testing.expect(
    run LookupVariations<'static>.apply<Error>(
      &variations,
      2,
      &[F2Dot14.fromBits(12288)],
      noDelta,
      &mut lookups,
    ),
    "matching feature",
  )
  run same(&lookups, &[7, 8, 9])
  lookups = run listOf(&[1, 2])
  run Testing.expect(
    run LookupVariations<'static>.apply<Error>(
      &variations,
      2,
      &[F2Dot14.fromBits(4096)],
      noDelta,
      &mut lookups,
    ),
    "unconditional list",
  )
  run same(&lookups, &[9])
  lookups = run listOf(&[1, 2])
  run Testing.expect(
    !run LookupVariations<'static>.apply<Error>(
      &variations,
      3,
      &[F2Dot14.fromBits(12288)],
      noDelta,
      &mut lookups,
    ),
    "absent feature",
  )
  run same(&lookups, &[1, 2])
  lookups = run listOf(&[1])
  run Testing.expect(run LookupVariations.addAll(&variations, 2, &mut lookups), "all lists")
  run same(&lookups, &[1, 7, 8, 9])
}

test effect fn lookupVariationsReplaceFeatureLookupsByLocation() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run replaceByLocation() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn addDefaults() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(FeatureVariations.read(FontData.new(addBytes())))
  let variations = run some(FeatureVariations.lookupVariations(&table))
  let mut lookups = run listOf(&[1, 2])
  run Testing.expect(
    run LookupVariations<'static>.apply<Error>(
      &variations,
      2,
      &[F2Dot14.fromBits(12288)],
      noDelta,
      &mut lookups,
    ),
    "adding feature",
  )
  run same(&lookups, &[1, 2, 7, 8, 9])
}

test effect fn lookupVariationsCanAddToDefaultLookups() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run addDefaults() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sharedOnce() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let table = run must(FeatureVariations.read(FontData.new(sharedBytes())))
  let variations = run some(FeatureVariations.lookupVariations(&table))
  let mut lookups = List<u16>.make()
  run Testing.expect(run LookupVariations.addAll(&variations, 2, &mut lookups), "shared all")
  run same(&lookups, &[7, 8])
  lookups = List<u16>.make()
  run Testing.expect(
    run LookupVariations<'static>.apply<Error>(&variations, 2, &[], noDelta, &mut lookups),
    "shared apply",
  )
  run same(&lookups, &[7, 8])
}

test effect fn lookupVariationsAddASharedListOnce() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharedOnce() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn lookupVariationsAbsentOrUnsorted() -> ()
  ! AssertionError<'static> {
  let v10 = run must(FeatureVariations.read(FontData.new(b"\x00\x01\x00\x00\x00\x00\x00\x00")))
  run Testing.expect(isNone(FeatureVariations.lookupVariations(&v10)), "version 1.0")
  let v11 = run must(
    FeatureVariations.read(FontData.new(b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00")),
  )
  run Testing.expect(isNone(FeatureVariations.lookupVariations(&v11)), "version 1.1 empty")
  let unsorted = run must(
    FeatureVariations.read(
      FontData.new(
        b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x03\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00",
      ),
    ),
  )
  run Testing.expect(isNone(FeatureVariations.lookupVariations(&unsorted)), "unsorted ignored")
}

fn featureLookups<'a>(table: &FeatureVariations<'a>, index: u16) -> Option<
  Result<FeatureLookups<'a>, ReadError>
> {
  let records = match move FeatureVariations<'a>.lookupVariationRecords(table) {
    Option<ComputedArray<'a, (), LookupVariationRecord<'a>>>.Some { value } => value
    Option<ComputedArray<'a, (), LookupVariationRecord<'a>>>.None => {
      return Option<Result<FeatureLookups<'a>, ReadError>>.None
    }
  }
  let mut i: usize = 0
  while i < ComputedArray<'a, (), LookupVariationRecord<'a>>.len(&records) {
    if let Result<LookupVariationRecord<'a>, ReadError>.Success { value } = ComputedArray<
      'a,
      (),
      LookupVariationRecord<'a>
    >.get(&records, i) {
      if LookupVariationRecord<'a>.featureIndex(&value) == index {
        return Option<Result<FeatureLookups<'a>, ReadError>>.some(
          LookupVariationRecord<'a>.featureLookups(&value, FeatureVariations<'a>.offsetData(table)),
        )
      }
    }
    i = i + 1
  }
  return Option<Result<FeatureLookups<'a>, ReadError>>.None
}

test effect fn lookupVariationsVersionedEmptyArrays() -> ()
  ! AssertionError<'static> {
  let v10 = run must(FeatureVariations.read(FontData.new(b"\x00\x01\x00\x00\x00\x00\x00\x00")))
  run Testing.expect(
    FeatureVariations.version(&v10).major == 1 && FeatureVariations.version(&v10).minor == 0,
    "1.0 version",
  )
  run Testing.expect(
    isNone(FeatureVariations.lookupVariationRecordCount(&v10))
      && isNone(FeatureVariations.lookupVariationRecords(&v10))
      && isNone(featureLookups(&v10, 0)),
    "1.0 absent array",
  )
  let v11 = run must(
    FeatureVariations.read(FontData.new(b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00")),
  )
  run Testing.expect(
    FeatureVariations.version(&v11).major == 1 && FeatureVariations.version(&v11).minor == 1,
    "1.1 version",
  )
  run Testing.expect(
    (FeatureVariations.lookupVariationRecordCount(&v11) |> Option<u32>.unwrapOr(99)) == 0,
    "1.1 count",
  )
  let array = run some(FeatureVariations.lookupVariationRecords(&v11))
  run Testing.expect(
    ComputedArray<'static, (), LookupVariationRecord<'static>>.len(&array) == 0
      && isNone(featureLookups(&v11, 0)),
    "1.1 present empty",
  )
}

test effect fn lookupVariationsTruncatedArraysAndInvalidOffsets() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x03\xff\xff\xff\xff"
  let mut length: usize = 8
  while length < bytes.length {
    let table = run must(FeatureVariations.read(FontData.new(Slice.view(bytes, 0, length))))
    run Testing.expect(
      isNone(FeatureVariations.lookupVariationRecords(&table)) && isNone(featureLookups(&table, 3)),
      "truncated record",
    )
    length = length + 1
  }
  let table = run must(FeatureVariations.read(FontData.new(bytes)))
  let array = run some(FeatureVariations.lookupVariationRecords(&table))
  run Testing.expect(
    ComputedArray<'static, (), LookupVariationRecord<'static>>.len(&array) == 1,
    "full record",
  )
  let result = run some(featureLookups(&table, 3))
  run Testing.expect(
    match move result {
      Result<FeatureLookups<'static>, ReadError>.Failure { error: ReadError.OutOfBounds } => true
      _ => false
    },
    "invalid target offset",
  )
  run Testing.expect(
    isNone(featureLookups(&table, 2)) && isNone(featureLookups(&table, 4)),
    "neighboring features absent",
  )
}
