effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "cmap read succeeds")
      return Intrinsic.trap("unreachable")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "present value")
      return Intrinsic.trap("unreachable")
    }
  }
}

fn m(cp: u32, glyph: u32) -> CmapMapping {
  return CmapMapping { codepoint: cp, glyph: GlyphId.new(glyph) }
}

fn uv(cp: u32, selector: u32, glyph: i64) -> UvsMappingEntry {
  let mut mapping = MapVariant.UseDefault
  if glyph >= 0 {
    mapping = MapVariant.Variant { glyph: GlyphId.new(i64.toU32(glyph)) }
  }
  return UvsMappingEntry { codepoint: cp, selector: selector, mapping: mapping }
}

import silk.num.i64

fn mapped(value: Option<GlyphId>) -> i64 {
  return match move value {
    Option<GlyphId>.Some { value: glyph } => u32.toI64(GlyphId.toU32(glyph))
    _ => -1
  }
}

fn variant(value: Option<MapVariant>) -> i64 {
  return match move value {
    Option<MapVariant>.Some { value: mapping } => match mapping {
      MapVariant.UseDefault => -2
      MapVariant.Variant { glyph } => u32.toI64(GlyphId.toU32(glyph))
    }
    _ => -1
  }
}

interface MappingIter {
  fn next(self: &mut Self) -> Option<CmapMapping>
}

impl<'a> MappingIter for Cmap0Iter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap0Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for Cmap4Iter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap4Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for Cmap6Iter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap6Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for Cmap10Iter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap10Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for Cmap12Iter<'a> {
