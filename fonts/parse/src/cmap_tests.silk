  ! AssertionError<'static> {
  let table = run must(Cmap12.read(FontData.new(timeout12())))
  run Testing.expect(
    countMappings(Cmap12.iterWithLimits(&table, CmapIterLimits.default())) <= 1114112,
    "bounded malicious group",
  )
}

test effect fn cmap12IterAvoidTimeout2() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap12.read(FontData.new(timeout12b())))
  run Testing.expect(
    countMappings(Cmap12.iterWithLimits(&table, CmapIterLimits { maxChar: 1114111, glyphCount: 8 }))
      == 8,
    "glyph limited ranges",
  )
}

test effect fn cmap12IterGlyphLimit() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(limitsFont()))
  let table = run find12(font12())
  let mut limits = CmapIterLimits.defaultForFont(&font)
  run Testing.expect(limits.glyphCount == 11, "font glyph limit")
  let mut count: u32 = 0
  while count <= 11 {
    limits.glyphCount = count
    run Testing.expect(
      countMappings(Cmap12.iterWithLimits(&table, limits))
        == u32.toUsize(u32.saturatingSubtract(count, 1)),
      "glyph limit",
    )
    count = count + 1
  }
}

test effect fn cmap12And13IterIncludeTheMaximumCharacter() -> ()
  ! AssertionError<'static> {
  let values: [u32; 4] = [0, 1, 1114111, 4294967295]
  let mut i: usize = 0
  while i < 4 {
    let cp = values[i]
    let mut bytes: [u8; 28] = [0; 28]
    bytes[1] = 12
    bytes[15] = 1
    bytes[27] = 1
    let encoded: [u8; 4] = [
      u32.toU8(cp / 16777216),
      u32.toU8(cp / 65536 % 256),
      u32.toU8(cp / 256 % 256),
      u32.toU8(cp % 256),
    ]
    let mut j: usize = 0
    while j < 4 {
      bytes[16 + j] = encoded[j]
      bytes[20 + j] = encoded[j]
      j = j + 1
    }
    let limits = CmapIterLimits { maxChar: cp, glyphCount: 2 }
    let expected: [CmapMapping; 1] = [m(cp, 1)]
    bytes[1] = 12
    let table12 = run must(Cmap12.read(FontData.new(&bytes)))
    run Testing.expect(mapped(Cmap12.mapCodepoint(&table12, cp)) == 1, "maximum maps")
    run assertMappings(Cmap12.iterWithLimits(&table12, limits), &expected)
    bytes[1] = 13
    let table13 = run must(Cmap13.read(FontData.new(&bytes)))
    run Testing.expect(mapped(Cmap13.mapCodepoint(&table13, cp)) == 1, "maximum maps")
    run assertMappings(Cmap13.iterWithLimits(&table13, limits), &expected)
    i = i + 1
  }
}

test effect fn cmap12IterRangeClamping() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap12.read(FontData.new(rangeClamp12())))
  run Testing.expect(
    countMappings(
      Cmap12.iterWithLimits(&table, CmapIterLimits { maxChar: 1114111, glyphCount: 4294967295 }),
    )
      <= 1114112,
    "overlap clamped",
  )
}

test effect fn cmap12IterSaturatedGroupDoesNotResetRange() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap12.read(FontData.new(saturated12())))
  let mut iter = Cmap12.iterWithLimits(&table, CmapIterLimits { maxChar: 1114111, glyphCount: 50 })
  let mut cp: u32 = 10
  while cp <= 22 {
    let item = run some(Cmap12Iter.next(&mut iter))
    run Testing.expect(item.codepoint == cp, "monotonic clamped ranges")
    cp = cp + 1
  }
  run Testing.expect(
    match move Cmap12Iter.next(&mut iter) {
      Option<CmapMapping>.None => true
      _ => false
    },
    "range exhausted",
  )
}

test effect fn cmap12IterExplicitNotdef() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap12.read(FontData.new(notdef12())))
  let expected: [CmapMapping; 2] = [m(0, 0), m(1, 1)]
  run assertMappings(Cmap12.iter(&table), &expected)
}

test effect fn cmap13Map() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap13.read(FontData.new(constant13())))
  let mut cp: u32 = 0
  while cp < 1024 {
    let mut expected: i64 = -1
    if cp <= 8 {
      expected = 20
    }
    if cp >= 42 && cp <= 46 {
      expected = 30
    }
    run Testing.expect(mapped(Cmap13.mapCodepoint(&table, cp)) == expected, "constant mapping")
    cp = cp + 1
  }
}

test effect fn cmap13Iter() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap13.read(FontData.new(constant13())))
  let mut iter = Cmap13.iter(&table)
  while true {
    match move Cmap13Iter.next(&mut iter) {
      Option<CmapMapping>.Some { value } => {
        run Testing.expect(
          mapped(Cmap13.mapCodepoint(&table, value.codepoint))
            == u32.toI64(GlyphId.toU32(value.glyph)),
          "constant iterator equals lookup",
        )
      }
      _ => {
        break
      }
    }
  }
}

test effect fn cmap14Iter() -> ()
  ! AssertionError<'static> {
  let table = run find14(font14())
  let mut iter = Cmap14.iter(&table)
  let mut count: usize = 0
  while true {
    match move UvsSubtableIter.next(&mut iter) {
      Option<UvsMappingEntry>.Some { value } => {
        let actual = run some(Cmap14.mapVariant(&table, value.codepoint, value.selector))
        run Testing.expect(&actual == &value.mapping, "variation iterator equals lookup")
        count = count + 1
      }
      _ => {
        break
      }
    }
  }
  run Testing.expect(count == 7, "seven variation sequences")
}

test effect fn cmap14IterOnlyHandlesMonotoneSelectors() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap14.read(FontData.new(monotone14())))
  let expected: [UvsMappingEntry; 3] = [
    uv(19968, 57600, -1),
    uv(19969, 57600, 7),
    uv(19971, 57856, 9),
  ]
  run assertUvs(Cmap14.iter(&table), &expected)
}

test effect fn cmap14IterLimitsDefaultUvsToMaxChar() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap14.read(FontData.new(defaultLimit14())))
  let expected: [UvsMappingEntry; 2] = [uv(65, 57600, -1), uv(66, 57600, -1)]
  run assertUvs(
    Cmap14.iterWithLimits(&table, CmapIterLimits { maxChar: 1, glyphCount: 4294967295 }),
    &expected,
  )
}

test effect fn cmap14IterLimitsNonDefaultUvsToGlyphCount() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap14.read(FontData.new(nonDefaultLimit14())))
  let expected: [UvsMappingEntry; 2] = [uv(19968, 57600, 10), uv(19969, 57600, 11)]
  run assertUvs(
    Cmap14.iterWithLimits(&table, CmapIterLimits { maxChar: 4294967295, glyphCount: 2 }),
    &expected,
  )
}

test effect fn bestSubtableFull() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap.read(FontData.new(vorg())))
  let best = run some(Cmap.bestSubtable(&table))
  run Testing.expect(
    best.index == 3 && EncodingRecord.platformId(&best.record) == PlatformId.Windows
      && EncodingRecord.encodingId(&best.record) == 10,
    "best encoding record",
  )
}

test effect fn bestSubtableBmp() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap.read(FontData.new(font12())))
  let best = run some(Cmap.bestSubtable(&table))
  run Testing.expect(
    best.index == 0 && EncodingRecord.platformId(&best.record) == PlatformId.Windows
      && EncodingRecord.encodingId(&best.record) == 1,
    "best encoding record",
  )
}

test effect fn bestSubtableSymbol() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap.read(FontData.new(symbol())))
  let best = run some(Cmap.bestSubtable(&table))
  run Testing.expect(
    best.index == 0 && EncodingRecord.platformId(&best.record) == PlatformId.Windows
      && EncodingRecord.encodingId(&best.record) == 0,
    "best encoding record",
  )
  run Testing.expect(EncodingRecord.isSymbol(&best.record), "symbol encoding")
}

test effect fn uvsSubtable() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap.read(FontData.new(font14())))
  let selected = run some(Cmap.uvsSubtable(&table))
  run Testing.expect(selected.index == 0, "variation subtable index")
}
