  return b"\x00\x0f\x00\x00\x00\x27\x00\x00\x00\x01\x0e\x01\x00\x00\x00\x00\x15\x00\x00\x00\x1d\x00\x00\x00\x01\x00\x00\x41\x00\x00\x00\x00\x01\x00\x00\x42\x01\x11\x70"
}

fn prefer15a() -> &'static [u8] {
  return b"\x00\x00\x00\x02\x00\x00\x00\x05\x00\x00\x00\x14\x00\x00\x00\x05\x00\x00\x00\x32\x00\x0e\x00\x00\x00\x1e\x00\x00\x00\x01\x0e\x01\x00\x00\x00\x00\x00\x00\x00\x00\x15\x00\x00\x00\x01\x00\x00\x41\x00\x01\x00\x0f\x00\x00\x00\x1f\x00\x00\x00\x01\x0e\x01\x00\x00\x00\x00\x00\x00\x00\x00\x15\x00\x00\x00\x01\x00\x00\x41\x01\x11\x70"
}

fn prefer15b() -> &'static [u8] {
  return b"\x00\x00\x00\x02\x00\x00\x00\x05\x00\x00\x00\x14\x00\x00\x00\x05\x00\x00\x00\x33\x00\x0f\x00\x00\x00\x1f\x00\x00\x00\x01\x0e\x01\x00\x00\x00\x00\x00\x00\x00\x00\x15\x00\x00\x00\x01\x00\x00\x41\x01\x11\x70\x00\x0e\x00\x00\x00\x1e\x00\x00\x00\x01\x0e\x01\x00\x00\x00\x00\x00\x00\x00\x00\x15\x00\x00\x00\x01\x00\x00\x41\x00\x01"
}

fn monotone14() -> &'static [u8] {
  return b"\x00\x0e\x00\x00\x00\x62\x00\x00\x00\x04\x00\xe1\x00\x00\x00\x00\x36\x00\x00\x00\x3e\x00\xe1\x00\x00\x00\x00\x00\x00\x00\x00\x47\x00\xe2\x00\x00\x00\x00\x00\x00\x00\x00\x50\x00\xe1\x00\x00\x00\x00\x00\x00\x00\x00\x59\x00\x00\x00\x01\x00\x4e\x00\x00\x00\x00\x00\x01\x00\x4e\x01\x00\x07\x00\x00\x00\x01\x00\x4e\x02\x00\x08\x00\x00\x00\x01\x00\x4e\x03\x00\x09\x00\x00\x00\x01\x00\x4e\x03\x00\x0a"
}

fn defaultLimit14() -> &'static [u8] {
  return b"\x00\x0e\x00\x00\x00\x21\x00\x00\x00\x01\x00\xe1\x00\x00\x00\x00\x15\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x41\x02\x00\x00\x50\x00"
}

fn nonDefaultLimit14() -> &'static [u8] {
  return b"\x00\x0e\x00\x00\x00\x28\x00\x00\x00\x01\x00\xe1\x00\x00\x00\x00\x00\x00\x00\x00\x15\x00\x00\x00\x03\x00\x4e\x00\x00\x0a\x00\x4e\x01\x00\x0b\x00\x4e\x02\x00\x0c"
}

test effect fn cachedFormat4AgreesWithLookupOnOverlappingSegments() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap4.read(FontData.new(overlap4())))
  run Testing.expect(
    mapped(Cmap4.mapCodepoint(&table, 65)) == 1 && mapped(Cmap4.mapCodepoint(&table, 70)) == 100,
    "binary search overlap",
  )
  let orders: [u32; 19] = [
    65,
    70,
    70,
    65,
    71,
    74,
    65,
    69,
    70,
    75,
    76,
    80,
    81,
    80,
    75,
    70,
    65,
    66,
    74,
  ]
  let boundaries: [usize; 5] = [0, 2, 6, 13, 19]
  let mut group: usize = 0
  while group < 4 {
    let mut cached: Option<Cmap4Segment> = Option<Cmap4Segment>.None
    let mut i = boundaries[group]
    while i < boundaries[group + 1] {
      run Testing.expect(
        mapped(Cmap4.mapCodepointCached(&table, orders[i], &mut cached))
          == mapped(Cmap4.mapCodepoint(&table, orders[i])),
        "cached lookup matches ordinary",
      )
      i = i + 1
    }
    group = group + 1
  }
}

