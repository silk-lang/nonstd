test effect fn cmap15VariantsAndIteration() -> ()
  ! AssertionError<'static> {
  let table = run must(Cmap15.read(FontData.new(format15())))
  run Testing.expect(Cmap15.length(&table) == usize.toU32(format15().length), "format 15 length")
  let uvs = UvsSubtable.fromCmap15(table)
  run Testing.expect(UvsSubtable.format(&uvs) == 15, "wide format")
  let expected: [UvsMappingEntry; 4] = [
    uv(65, 917760, -1),
    uv(66, 917760, 65536),
    uv(67, 917760, 70000),
    uv(68, 917760, 16777215),
  ]
  run assertUvs(UvsSubtable.iter(&uvs), &expected)
  let mut i: usize = 0
  while i < 4 {
    let actual = run some(UvsSubtable.mapVariant(&uvs, expected[i].codepoint, expected[i].selector))
    run Testing.expect(&actual == &expected[i].mapping, "format 15 mapping")
    i = i + 1
  }
  run Testing.expect(
    variant(UvsSubtable.mapVariant(&uvs, 69, 917760)) == -1
      && variant(UvsSubtable.mapVariant(&uvs, 66, 917761)) == -1,
    "missing variant",
  )
  run assertUvs(
    UvsSubtable.iterWithLimits(&uvs, CmapIterLimits { maxChar: 0, glyphCount: 1 }),
    Slice.view<UvsMappingEntry>(&expected, 0, 2),
  )
  let empty = UvsSubtable.fromCmap15(run must(Cmap15.read(FontData.new(format15Empty()))))
  run assertUvs(UvsSubtable.iter(&empty), &[])
  run Testing.expect(variant(UvsSubtable.mapVariant(&empty, 65, 917760)) == -1, "empty variant")
}

test effect fn cmap15MalformedArraysAndOffsets() -> ()
  ! AssertionError<'static> {
  let source = malformed15()
  let mut bytes: [u8; 38] = [0; 38]
  let mut i: usize = 0
  while i < bytes.length {
    bytes[i] = source[i]
    i = i + 1
  }
  run Testing.expect(
    match move Cmap15.read(FontData.new(Slice.view<u8>(&bytes, 0, 9))) {
      Result<Cmap15, ReadError>.Failure { error } => true
      _ => false
    },
    "short header",
  )
  let expected: [UvsMappingEntry; 1] = [uv(65, 917760, -1)]
  let mut stage: usize = 0
  while stage < 3 {
    if stage == 1 {
      i = 17
      while i < 21 {
        bytes[i] = 255
        i = i + 1
      }
    }
    if stage == 2 {
      i = 6
      while i < 10 {
        bytes[i] = 255
        i = i + 1
      }
    }
    let table = UvsSubtable.fromCmap15(run must(Cmap15.read(FontData.new(&bytes))))
    run Testing.expect(
      variant(UvsSubtable.mapVariant(&table, 66, 917760)) == -1,
      "malformed non-default",
    )
    if stage < 2 {
      run Testing.expect(
        variant(UvsSubtable.mapVariant(&table, 65, 917760)) == -2,
        "valid default survives",
      )
      run assertUvs(UvsSubtable.iter(&table), &expected)
    } else {
      run Testing.expect(
        variant(UvsSubtable.mapVariant(&table, 65, 917760)) == -1,
        "invalid selectors",
      )
      run assertUvs(UvsSubtable.iter(&table), &[])
    }
    stage = stage + 1
  }
}

test effect fn preferCmap15OverCmap14() -> ()
  ! AssertionError<'static> {
  let fixtures: [&[u8]; 2] = [prefer15a(), prefer15b()]
  let mut i: usize = 0
  while i < 2 {
    let cmap = run must(Cmap.read(FontData.new(fixtures[i])))
    let selected = run some(Cmap.uvsSubtable(&cmap))
    run Testing.expect(
      UvsSubtable.format(&selected.subtable) == 15
        && variant(UvsSubtable.mapVariant(&selected.subtable, 65, 917760)) == 70000,
      "prefer format 15 in either order",
    )
    i = i + 1
  }
}

test effect fn mapCodepoints() -> ()
  ! AssertionError<'static> {
  let vazirmatnTable = run must(Cmap.read(FontData.new(vazirmatn())))
  run Testing.expect(mapped(Cmap.mapCodepoint(&vazirmatnTable, 65)) == 1, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&vazirmatnTable, 192)) == 2, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&vazirmatnTable, 96)) == 3, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&vazirmatnTable, 66)) == -1, "codepoint mapping")
  let simpleTable = run must(Cmap.read(FontData.new(simple())))
  run Testing.expect(mapped(Cmap.mapCodepoint(&simpleTable, 32)) == 1, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&simpleTable, 14)) == 2, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&simpleTable, 66)) == -1, "codepoint mapping")
  let format0Table = run must(Cmap.read(FontData.new(format0())))
  run Testing.expect(mapped(Cmap.mapCodepoint(&format0Table, 0)) == 0, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format0Table, 32)) == 178, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format0Table, 114)) == 193, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format0Table, 88)) == 13, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format0Table, 255)) == 3, "codepoint mapping")
  let format6SmallTable = run must(Cmap.read(FontData.new(format6Small())))
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 0)) == -1, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 31)) == -1, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 33)) == 15, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 35)) == 20, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 36)) == 4, "codepoint mapping")
  run Testing.expect(mapped(Cmap.mapCodepoint(&format6SmallTable, 50)) == -1, "codepoint mapping")
}

test effect fn mapVariants() -> ()
  ! AssertionError<'static> {
  let table = run find14(font14())
  run Testing.expect(variant(Cmap14.mapVariant(&table, 97, 917760)) == -1, "unmapped character")
  run Testing.expect(
    variant(Cmap14.mapVariant(&table, 19968, 917760)) == -2
      && variant(Cmap14.mapVariant(&table, 19974, 917760)) == -2,
    "default variants",
  )
  run Testing.expect(
    variant(Cmap14.mapVariant(&table, 19976, 917760)) == 25
      && variant(Cmap14.mapVariant(&table, 19977, 917760)) == 26,
    "non-default variants",
  )
}

test effect fn cmap0Iter() -> ()
  ! AssertionError<'static> {
  let cmap = run must(Cmap.read(FontData.new(format0())))
  let subtable = run must(Cmap.subtable(&cmap, 0))
  let mut iter = CmapSubtable.iter(&subtable)
  let mut limited = CmapSubtable.iterWithLimits(&subtable, CmapIterLimits.default())
  let mut i: u32 = 0
  while i < 256 {
    let item = run some(CmapSubtableIter.next(&mut iter))
    let other = run some(CmapSubtableIter.next(&mut limited))
    run Testing.expect(
      item.codepoint == i
        && mapped(CmapSubtable.mapCodepoint(&subtable, i)) == u32.toI64(GlyphId.toU32(item.glyph))
        && &item.glyph == &other.glyph,
      "all format zero mappings",
    )
    if i == 0 {
      run Testing.expect(GlyphId.toU32(item.glyph) == 0, "notdef")
    }
    if i == 32 {
      run Testing.expect(GlyphId.toU32(item.glyph) == 178, "space")
    }
    if i == 255 {
      run Testing.expect(GlyphId.toU32(item.glyph) == 3, "last")
    }
    i = i + 1
  }
  run Testing.expect(
    match move CmapSubtableIter.next(&mut iter) {
      Option<CmapMapping>.None => true
      _ => false
    },
    "exhausted",
  )
  run Testing.expect(
    match move CmapSubtableIter.next(&mut iter) {
      Option<CmapMapping>.None => true
      _ => false
    },
    "still exhausted",
  )
}

test effect fn cmap4Iter() -> ()
  ! AssertionError<'static> {
  let fixtures: [&[u8]; 2] = [vazirmatn(), simple()]
  let counts: [usize; 2] = [4, 3]
  let mut i: usize = 0
  while i < 2 {
    let table = run find4(fixtures[i])
    let mut iter = Cmap4.iter(&table)
    let mut count: usize = 0
    while true {
      match move Cmap4Iter.next(&mut iter) {
        Option<CmapMapping>.Some { value } => {
          run Testing.expect(
            mapped(Cmap4.mapCodepoint(&table, value.codepoint))
              == u32.toI64(GlyphId.toU32(value.glyph)),
            "iterator equals lookup",
          )
          count = count + 1
        }
        _ => {
          break
        }
      }
    }
    run Testing.expect(count == counts[i], "mapping count")
    i = i + 1
  }
}

test effect fn cmap4IterExplicitNotdef() -> ()
  ! AssertionError<'static> {
  let table = run find4(vazirmatn())
  let mut iter = Cmap4.iter(&table)
  let mut count: usize = 0
  while true {
    match move Cmap4Iter.next(&mut iter) {
      Option<CmapMapping>.Some { value } => {
        if GlyphId.toU32(value.glyph) == 0 {
          count = count + 1
        }
      }
      _ => {
        break
      }
    }
  }
  run Testing.expect(count > 0 && mapped(Cmap4.mapCodepoint(&table, 65535)) == 0, "explicit notdef")
}

