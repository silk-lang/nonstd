    return Cmap12Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for Cmap13Iter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return Cmap13Iter<'a>.next(&mut self)
  }
}

impl<'a> MappingIter for CmapSubtableIter<'a> {
  fn next(self: &mut Self) -> Option<CmapMapping> {
    return CmapSubtableIter<'a>.next(&mut self)
  }
}

effect fn assertMappings<I: MappingIter>(iter: I, expected: &[CmapMapping]) -> ()
  ! AssertionError<'static> {
  let mut cursor = move iter
  let mut i: usize = 0
  while i < expected.length {
    let item = run some(MappingIter.next(&mut cursor))
    run Testing.expect(
      item.codepoint == expected[i].codepoint && &item.glyph == &expected[i].glyph,
      "expected codepoint and glyph",
    )
    i = i + 1
  }
  run Testing.expect(
    match move MappingIter.next(&mut cursor) {
      Option<CmapMapping>.None => true
      _ => false
    },
    "iterator exhausted",
  )
}

fn countMappings<I: MappingIter>(iter: I) -> usize {
  let mut cursor = move iter
  let mut count: usize = 0
  while true {
    if let Option<CmapMapping>.None = move MappingIter.next(&mut cursor) {
      break
    }
    count = count + 1
  }
  return count
}

effect fn assertUvs(iter: UvsSubtableIter, expected: &[UvsMappingEntry]) -> ()
  ! AssertionError<'static> {
  let mut cursor = move iter
  let mut i: usize = 0
  while i < expected.length {
    let item = run some(UvsSubtableIter.next(&mut cursor))
    run Testing.expect(
      item.codepoint == expected[i].codepoint && item.selector == expected[i].selector
        && &item.mapping == &expected[i].mapping,
      "expected variation mapping",
    )
    i = i + 1
  }
  run Testing.expect(
    match move UvsSubtableIter.next(&mut cursor) {
      Option<UvsMappingEntry>.None => true
      _ => false
    },
    "variation iterator exhausted",
  )
}

effect fn find4(data: &[u8]) -> Cmap4
  ! AssertionError<'static> {
  let table = run must(Cmap.read(FontData.new(data)))
  let mut i: u16 = 0
  while i < Cmap.numTables(&table) {
    if let Result<CmapSubtable, ReadError>.Success { value } = move Cmap.subtable(&table, i) {
      if let CmapSubtable.Format4 { value: found } = value {
        return found
      }
    }
    i = i + 1
  }
  run Testing.expect(false, "expected cmap format")
  return Intrinsic.trap("unreachable")
}

