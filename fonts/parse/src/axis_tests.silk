effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "axis fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(result: Option<T>) -> T
  ! AssertionError<'static> {
  return match move result {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "axis fixture exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn normalized<'a, 'b>(
  fvar: &Fvar<'a>,
  avar: Option<Avar<'b>>,
  user: &[UserCoordinate],
  out: &mut [F2Dot14],
) -> ()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Fvar.userToNormalized(fvar, move avar, user, &mut out)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn user(tag: u32, value: f64) -> UserCoordinate {
  return UserCoordinate { tag: Tag.fromU32(tag), value: Fixed.fromF64(value) }
}

effect fn axis() -> VariationAxisRecord<'static>
  ! AssertionError<'static> {
  let fvar = run must(Fvar.read(FontData.new(Fixtures.vazirmatnFvar())))
  let axes = run must(Fvar.axes(&fvar))
  return run must(ComputedArray<'static, (), VariationAxisRecord<'static>>.get(&axes, 0))
}

effect fn map() -> SegmentMaps<'static>
  ! AssertionError<'static> {
  let avar = run must(Avar.read(FontData.new(Fixtures.vazirmatnAvar())))
  let maps = Avar.axisSegmentMaps(&avar)
  return run must(run some(VarLenArray<'static, SegmentMaps<'static>>.get(&maps, 0)))
}

test effect fn fvarAxes() -> ()
  ! AssertionError<'static> {
  let fvar = run must(Fvar.read(FontData.new(Fixtures.vazirmatnFvar())))
  let wght = run axis()
  run Testing.expect(
    Fvar.axisCount(&fvar) == 1 && Tag.toU32(VariationAxisRecord.axisTag(&wght)) == 2003265652,
    "weight axis",
  )
  run Testing.expect(
    Fixed.toF64(VariationAxisRecord.minValue(&wght)) == 100.0
      && Fixed.toF64(VariationAxisRecord.defaultValue(&wght)) == 400.0
      && Fixed.toF64(VariationAxisRecord.maxValue(&wght)) == 900.0,
    "weight range",
  )
  run Testing.expect(
    VariationAxisRecord.flags(&wght) == 0
      && NameId.toU16(VariationAxisRecord.axisNameId(&wght)) == 257,
    "axis metadata",
  )
}

test effect fn fvarInstances() -> ()
  ! AssertionError<'static> {
  let fvar = run must(Fvar.read(FontData.new(Fixtures.vazirmatnFvar())))
  run Testing.expect(Fvar.instanceCount(&fvar) == 9, "nine instances")
  let instances = run must(Fvar.instances(&fvar))
  let mut i: usize = 0
  while i < 9 {
    let instance = run must(
      ComputedArray<'static, ReadArgs2<u16, u16>, InstanceRecord<'static>>.get(&instances, i),
    )
    let value = run some(ScalarArray<Fixed>.get(&instance.coordinates, 0))
    run Testing.expect(
      ScalarArray<Fixed>.len(&instance.coordinates) == 1
        && Fixed.toF64(value) == 100.0 * usize.toF64(i + 1),
      "instance coordinate",
    )
    run Testing.expect(
      NameId.toU16(instance.subfamilyNameId) == 258 + usize.toU16(i),
      "instance name",
    )
    run Testing.expect(
      match move instance.postScriptNameId {
        Option<NameId>.None => true
        _ => false
      },
      "no postscript name",
    )
    i = i + 1
  }
}

test effect fn fvarNormalize() -> ()
  ! AssertionError<'static> {
  let wght = run axis()
  let values: [f64; 6] = [100.0, 220.0, 250.0, 400.0, 650.0, 900.0]
  let expected: [f64; 6] = [-1.0, -0.60001, -0.5, 0.0, 0.5, 1.0]
  let mut i: usize = 0
  while i < 6 {
    run Testing.expect(
      Fixed.toBits(VariationAxisRecord.normalize(&wght, Fixed.fromF64(values[i])))
        == Fixed.toBits(Fixed.fromF64(expected[i])),
      "axis normalization",
    )
    i = i + 1
  }
}

