import font_data { FontData }
import read { ReadError, FontReadAt }
import generated_layout { Condition, ConditionSet, LookupConditionRecord, FeatureVariations }
import model.error { Error }
import font_types.lib { F2Dot14 }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.collections.slice { Slice }
import silk.num.usize
import generated_layout { storeDeltas }
import generated_variations { ItemVariationStore }

test effect fn variableValuesKeepFractionalDeltasAndUseStrictPositiveTest() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x00\x00\x0c\x00\x01\x00\x00\x00\x16\x00\x01\x00\x01\x00\x00\x40\x00\x40\x00\x00\x01\x00\x01\x00\x01\x00\x00\x00\x01"
  let store = run must(ItemVariationStore.read(FontData.new(bytes)))
  let condition = run must(Condition.read(FontData.new(b"\x00\x02\x00\x00\x00\x00\x00\x00")))
  let inputs: [i16; 4] = [-16384, 0, 8192, 16384]
  let matches: [bool; 4] = [false, false, true, true]
  let mut i: usize = 0
  while i < 4 {
    let coords = [F2Dot14.fromBits(inputs[i])]
    run expected(
      Condition.evaluate(
        &condition,
        &coords,
        storeDeltas(Option<ItemVariationStore<'static>>.some(store), &coords),
      ),
      matches[i],
    )
    i = i + 1
  }
  run expected(evaluate(b"\x00\x02\xff\xff\xff\xff\xff\xff", &[]), false)
  run expected(evaluate(b"\x00\x02\x00\x00\xff\xff\xff\xff", &[]), false)
  run expected(evaluate(b"\x00\x02\x00\x01\xff\xff\xff\xff", &[]), true)
}

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    Result<T, ReadError>.Failure { error } => {
      run Testing.expect(false, "fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn noDelta(index: u32) -> Result<f64, Error> {
  return Result<f64, Error>.succeed(0.0)
}

fn badDelta(index: u32) -> Result<f64, Error> {
  return Result<f64, Error>.failResult(Error.InvalidOperation)
}

fn evaluate(bytes: &[u8], coords: &[F2Dot14]) -> Result<bool, Error> {
  return match move Condition.read(FontData.new(bytes)) {
    Result<Condition, ReadError>.Success { value } => Condition.evaluate(&value, coords, noDelta)
    Result<Condition, ReadError>.Failure { error } => Result<bool, Error>.failResult(
      Error.Malformed,
    )
  }
}

effect fn expected(result: Result<bool, Error>, value: bool) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    match move result {
      Result<bool, Error>.Success { value: actual } => actual == value
      _ => false
    },
    "condition result",
  )
}

effect fn errorIs(result: Result<bool, Error>, error: Error) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    match move result {
      Result<bool, Error>.Failure { error: actual } => actual == error
      _ => false
    },
    "condition error",
  )
}

test effect fn deltaCallbackErrorsSurviveNegationAndNoVariationSkipsCallback() -> ()
  ! AssertionError<'static> {
  let condition = run must(
    Condition.read(FontData.new(b"\x00\x05\x00\x00\x05\x00\x02\x00\x01\x00\x00\x00\x00")),
  )
  run errorIs(Condition.evaluate(&condition, &[], badDelta), Error.InvalidOperation)
  let none = run must(Condition.read(FontData.new(b"\x00\x02\x00\x01\xff\xff\xff\xff")))
  run expected(Condition.evaluate(&none, &[], badDelta), true)
}

test effect fn conditionSetsAndLookupRecordsRejectBadOffsets() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x00\x00\x06\x00\x05\x00\x00\x00"
  let set = run must(ConditionSet.read(FontData.new(bytes)))
  run expected(ConditionSet.evaluate(&set, &[], noDelta), false)
  let truncated = run must(ConditionSet.read(FontData.new(Slice.view(bytes, 0, 2))))
  run errorIs(ConditionSet.evaluate(&truncated, &[], noDelta), Error.Malformed)
  let record = run must(
    LookupConditionRecord.readAt(FontData.new(b"\x00\x00\x00\x06\x00\x00\x00\x00"), 0, ()),
  )
  run expected(LookupConditionRecord.evaluate(&record, FontData.new(bytes), &[], noDelta), false)
  run errorIs(
    LookupConditionRecord.evaluate(&record, FontData.new(Slice.view(bytes, 0, 2)), &[], noDelta),
    Error.Malformed,
  )
  let null = run must(
    LookupConditionRecord.readAt(FontData.new(b"\x00\x00\x00\x00\x00\x00\x00\x00"), 0, ()),
  )
  run expected(LookupConditionRecord.evaluate(&null, FontData.new(b""), &[], noDelta), true)
}

test effect fn axisRangesIncludeEndpointsAndMissingAxesAreZero() -> ()
  ! AssertionError<'static> {
  let condition = b"\x00\x01\x00\x00\x10\x00\x30\x00"
  let coords: [i16; 5] = [0, 4096, 8192, 12288, 16384]
  let matches: [bool; 5] = [false, true, true, true, false]
  let mut i: usize = 0
  while i < 5 {
    run expected(evaluate(condition, &[F2Dot14.fromBits(coords[i])]), matches[i])
    i = i + 1
  }
  run expected(evaluate(condition, &[]), false)
  run expected(evaluate(b"\x00\x01\x00\x05\x00\x00\x00\x00", &[]), true)
}

test effect fn compoundConditionsAndNullChildren() -> ()
  ! AssertionError<'static> {
  let andBytes = b"\x00\x03\x02\x00\x00\x09\x00\x00\x11\x00\x01\x00\x00\x10\x00\x30\x00\x00\x01\x00\x01\xc0\x00\xf0\x00"
  let orBytes = b"\x00\x04\x02\x00\x00\x09\x00\x00\x11\x00\x01\x00\x00\x10\x00\x30\x00\x00\x01\x00\x01\xc0\x00\xf0\x00"
  let notBytes = b"\x00\x05\x00\x00\x05\x00\x04\x02\x00\x00\x09\x00\x00\x11\x00\x01\x00\x00\x10\x00\x30\x00\x00\x01\x00\x01\xc0\x00\xf0\x00"
  run expected(evaluate(andBytes, &[F2Dot14.fromBits(8192), F2Dot14.fromBits(-8192)]), true)
  run expected(evaluate(andBytes, &[F2Dot14.fromBits(8192)]), false)
  run expected(evaluate(orBytes, &[F2Dot14.fromBits(8192)]), true)
  run expected(evaluate(orBytes, &[]), false)
  run expected(evaluate(notBytes, &[]), true)
  run expected(evaluate(notBytes, &[F2Dot14.fromBits(8192)]), false)
  run expected(evaluate(b"\x00\x03\x01\x00\x00\x00", &[]), true)
  run expected(evaluate(b"\x00\x04\x01\x00\x00\x00", &[]), true)
  run expected(evaluate(b"\x00\x05\x00\x00\x00", &[]), false)
  run expected(evaluate(b"\x00\x03\x00", &[]), true)
  run expected(evaluate(b"\x00\x04\x00", &[]), false)
}

test effect fn malformedAndExpensiveConditionsFailClosed() -> ()
  ! AssertionError<'static> {
  run errorIs(evaluate(b"\x00\x03\x01", &[]), Error.Malformed)
  run errorIs(evaluate(b"\x00\x05\xff\xff\xff", &[]), Error.Malformed)
  let mut deep: [u8; 328] = [0; 328]
  let mut i: usize = 0
  while i < 64 {
    deep[i * 5 + 1] = 5
    deep[i * 5 + 4] = 5
    i = i + 1
  }
  deep[321] = 1
  run errorIs(evaluate(&deep, &[]), Error.LimitExceeded)
  let mut repeated: [u8; 161] = [0; 161]
  i = 0
  while i < 17 {
    repeated[i * 9 + 1] = 3
    repeated[i * 9 + 2] = 2
    repeated[i * 9 + 5] = 9
    repeated[i * 9 + 8] = 9
    i = i + 1
  }
  repeated[154] = 1
  run errorIs(evaluate(&repeated, &[]), Error.LimitExceeded)
}

test effect fn featureVariationsSelectFirstMatchingRecordAtDefaultToo() -> ()
  ! AssertionError<'static> {
  let bytes = b"\x00\x01\x00\x00\x00\x00\x00\x02\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x06\x00\x05\x00\x00\x05\x00\x01\x00\x00\x10\x00\x30\x00"
  let variations = run must(FeatureVariations.read(FontData.new(bytes)))
  run Testing.expect(
    (FeatureVariations.indexForCoords(&variations, &[]) |> Option<u32>.unwrapOr(4294967295)) == 0,
    "default condition",
  )
  run Testing.expect(
    (FeatureVariations.indexForCoords(&variations, &[F2Dot14.fromBits(8192)])
      |> Option<u32>.unwrapOr(4294967295))
      == 1,
    "fallback record",
  )
}

test effect fn unknownConditionFormatsAreFalse() -> ()
  ! AssertionError<'static> {
  run expected(
    evaluate(b"\x00\x04\x02\x00\x00\x09\x00\x00\x0b\x00\x63\x00\x01\x00\x00\xc0\x00\x40\x00", &[]),
    true,
  )
  run expected(evaluate(b"\x00\x05\x00\x00\x05\x00\x63", &[]), true)
}
