effect fn must<T, E>(result: Result<T, E>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, E>.Success { value } => move value
    _ => {
      run Testing.expect(false, "name fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(input: Option<T>) -> T
  ! AssertionError<'static> {
  return match move input {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "glyph name exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn absent<T>(input: Option<T>) -> bool {
  return match move input {
    Option<T>.None => true
    _ => false
  }
}

effect fn map<'a>(data: &'a [u8]) -> GlyphNameMap<'a>
  ! AssertionError<'static> {
  let font = run must(FontRef.new(data))
  return GlyphNameMap.new(&font)
}

struct Override<'a> {
  font: FontRef<'a>,
  post: &'a [u8],
  hide: bool,
}

impl<'a> TableProvider<'a> for Override<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    if &tag == &Tag.new(&[112, 111, 115, 116]) {
      if self.hide {
        return Option<FontData<'a>>.None
      }
      return Option<FontData<'a>>.some(FontData.new(self.post))
    }
    if self.hide && &tag == &Tag.new(&[67, 70, 70, 32]) {
      return Option<FontData<'a>>.None
    }
    return FontRef.tableData(&self.font, tag)
  }
}

effect fn modified<'a>(font: &'a [u8], post: &'a [u8], hide: bool) -> GlyphNameMap<'a>
  ! AssertionError<'static> {
  let provider = Override<'a> { font: run must(FontRef.new(font)), post: post, hide: hide }
  return GlyphNameMap.new(&provider)
}

effect fn agree(map: &GlyphNameMap) -> ()
  ! AssertionError<'static> {
  let mut iter = GlyphNameMap.glyphNames(map)
  let mut count: u32 = 0
  while let Option<GlyphNameEntry>.Some { value } = GlyphNames.next(&mut iter) {
    let lookup = run some(GlyphNameMap.glyphName(map, value.glyph))
    run Testing.expect(
      GlyphName.asStr(&lookup) == GlyphName.asStr(&value.name)
        && GlyphName.source(&lookup) == GlyphName.source(&value.name),
      "lookup and iteration agree",
    )
    count = count + 1
  }
  run Testing.expect(count == GlyphNameMap.numGlyphs(map), "exact glyph count")
  run Testing.expect(absent(GlyphNameMap.glyphName(map, GlyphId.new(count))), "out of range name")
}

effect fn synthesized(map: &GlyphNameMap) -> ()
  ! AssertionError<'static> {
  let mut iter = GlyphNameMap.glyphNames(map)
  let mut count: u32 = 0
  while let Option<GlyphNameEntry>.Some { value } = GlyphNames.next(&mut iter) {
    let expected = GlyphName.synthesized(value.glyph)
    let lookup = run some(GlyphNameMap.glyphName(map, value.glyph))
    run Testing.expect(
      GlyphName.asStr(&value.name) == GlyphName.asStr(&expected)
        && GlyphName.isSynthesized(&value.name),
      "synthesized gid name",
    )
    run Testing.expect(
      GlyphName.asStr(&lookup) == GlyphName.asStr(&expected)
        && GlyphName.source(&lookup) == GlyphName.source(&value.name),
      "synthesized lookup",
    )
    count = count + 1
  }
  run Testing.expect(count == GlyphNameMap.numGlyphs(map), "all glyphs named")
}

effect fn nameAt(map: &GlyphNameMap, glyph: u32, text: string, source: GlyphNameSource) -> ()
  ! AssertionError<'static> {
  let actual = run some(GlyphNameMap.glyphName(map, GlyphId.new(glyph)))
  run Testing.expect(
    GlyphName.asStr(&actual) == text && GlyphName.source(&actual) == source,
    "name and source",
  )
  let mut iter = GlyphNameMap.glyphNames(map)
  let mut at: u32 = 0
  while let Option<GlyphNameEntry>.Some { value } = GlyphNames.next(&mut iter) {
    if at == glyph {
      run Testing.expect(
        GlyphName.asStr(&value.name) == text && GlyphName.source(&value.name) == source,
        "iterated name and source",
      )
      return
    }
    at = at + 1
  }
  run Testing.expect(false, "iterated glyph exists")
}

effect fn put16(out: &mut List<u8>, value: u16) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<u8>.append(&mut out, u16.toU8(value / 256))
  run List<u8>.append(&mut out, u16.toU8(value % 256))
}

effect fn post(indices: &[u16], names: &[string]) -> List<u8>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut out = List<u8>.make()
  run List<u8>.appendBytes(&mut out, &[0, 2, 0, 0])
  run List<u8>.appendRepeated(&mut out, 0, 28)
  run put16(&mut out, usize.toU16(indices.length))
  let mut i: usize = 0
  while i < indices.length {
    run put16(&mut out, indices[i])
    i = i + 1
  }
  i = 0
  while i < names.length {
    run List<u8>.append(&mut out, usize.toU8(String.byteLength(names[i])))
    run List<u8>.appendBytes(&mut out, String.utf8Bytes(names[i]))
    i = i + 1
  }
  return move out
}

effect fn indexMatches(map: &GlyphNameMap) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let index = run GlyphNameIndex.new(map)
  let mut iter = GlyphNameMap.glyphNames(map)
  while let Option<GlyphNameEntry>.Some { value } = GlyphNames.next(&mut iter) {
    let text = GlyphName.asStr(&value.name)
    let mut expected: i64 = -1
    let mut all = GlyphNameMap.glyphNames(map)
    while let Option<GlyphNameEntry>.Some { value: other } = GlyphNames.next(&mut all) {
      if !GlyphName.isSynthesized(&other.name) && GlyphName.asStr(&other.name) == text {
        expected = u32.toI64(GlyphId.toU32(other.glyph))
        break
      }
    }
    let got = match move GlyphNameIndex.get(&index, text) {
      Option<GlyphId>.Some { value: glyph } => u32.toI64(GlyphId.toU32(glyph))
      _ => -1
    }
    run Testing.expect(got == expected, "reverse lookup selects first stored name")
  }
  run Testing.expect(
    absent(GlyphNameIndex.get(&index, "no.such.glyph")) && absent(GlyphNameIndex.get(&index, "")),
    "absent names",
  )
}

test effect fn postNamesAgreeBetweenLookupAndIteration() -> ()
  ! AssertionError<'static> {
  let map = run map(hvarNames())
  let mut iter = GlyphNameMap.glyphNames(&map)
  let count = GlyphNameMap.numGlyphs(&map)
  run Testing.expect(GlyphNames.len(&iter) == u32.toUsize(count), "initial exact size")
  drop run some(GlyphNames.next(&mut iter))
  let mut remaining: u32 = 0
  while let Option<GlyphNameEntry>.Some { value } = GlyphNames.next(&mut iter) {
    remaining = remaining + 1
  }
  run Testing.expect(remaining == count - 1, "remaining exact size")
  run nameAt(&map, 0, ".notdef", GlyphNameSource.Post)
  run nameAt(&map, 1, "space", GlyphNameSource.Post)
  run nameAt(&map, 2, "A", GlyphNameSource.Post)
  run agree(&map)
}

test effect fn aPartialPostTableSynthesizesOnlyMissingNames() -> ()
  ! AssertionError<'static> {
  let map = run modified(hvarNames(), postSimple(), false)
  run Testing.expect(GlyphNameMap.numGlyphs(&map) > 10, "partial post fixture")
  run nameAt(&map, 9, "hola", GlyphNameSource.Post)
  run nameAt(&map, 10, "gid10", GlyphNameSource.Synthesized)
}

test effect fn postNamesSurviveABadEntry() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run badEntryBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn badEntryBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let data = run post(
    &[0, 258, 263, 259],
    &["ok", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"],
  )
  let map = run modified(hvarNames(), List<u8>.asSlice(&data), false)
  run nameAt(&map, 1, "ok", GlyphNameSource.Post)
  run nameAt(&map, 2, "gid2", GlyphNameSource.Synthesized)
  run nameAt(
    &map,
    3,
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    GlyphNameSource.Post,
  )
  run agree(&map)
}

test effect fn aLongNameIsCutBetweenCharacters() -> ()
  ! AssertionError<'static> {
  let text = "ééééééééééééééééééééééééééééééééééé"
  let name = run some(GlyphName.fromBytes(String.utf8Bytes(text), GlyphNameSource.Cff))
  run Testing.expect(
    GlyphName.asStr(&name) == "ééééééééééééééééééééééééééééééé",
    "truncate on UTF-8 boundary",
  )
}

test effect fn glyphByNameFindsTheFirstGlyphWithEachName() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run byNameBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn byNameBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let hvar = run map(hvarNames())
  let serif = run map(notoSerifFont())
  let jp = run must(FontRef.new(notoSansJp()))
  let table = run must(FontRef.cff(&jp))
  let parsed = run must(
    CffFontRef.newCff(FontData.asBytes(&Cff.offsetData(&table)), 0, Option<i32>.None),
  )
  let cid = GlyphNameMap.fromCff(move parsed)
  run indexMatches(&hvar)
  run indexMatches(&serif)
  run indexMatches(&cid)
  let hvarIndex = run GlyphNameIndex.new(&hvar)
  let glyph = run some(GlyphNameIndex.get(&hvarIndex, "A"))
  run Testing.expect(GlyphId.toU32(glyph) == 2, "A maps to glyph 2")
  let cidIndex = run GlyphNameIndex.new(&cid)
  run Testing.expect(
    absent(GlyphNameIndex.get(&cidIndex, "gid1")),
    "synthesized names are not indexed",
  )
}

test effect fn cffNamesAgreeBetweenLookupAndIteration() -> ()
  ! AssertionError<'static> {
  let map = run map(notoSerifFont())
  let expected = [".notdef", "i", "j", "k", "l"]
  let mut i: usize = 0
  while i < expected.length {
    run nameAt(&map, usize.toU32(i), expected[i], GlyphNameSource.Cff)
    i = i + 1
  }
  run agree(&map)
}

test effect fn standaloneCidCffSynthesizesGidNames() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(notoSansJp()))
  let table = run must(FontRef.cff(&font))
  let cff = run must(
    CffFontRef.newCff(FontData.asBytes(&Cff.offsetData(&table)), 0, Option<i32>.None),
  )
  run Testing.expect(CffFontRef.isCid(&cff), "standalone CID fixture")
  let map = GlyphNameMap.fromCff(move cff)
  run synthesized(&map)
  run Testing.expect(
    absent(GlyphNameMap.glyphName(&map, GlyphId.new(GlyphNameMap.numGlyphs(&map)))),
    "out of range standalone name",
  )
}

test effect fn sfntCidCffWithoutPostNamesSynthesizesGidNames() -> ()
  ! AssertionError<'static> {
  let map = run map(notoSansJp())
  let mut i: u32 = 0
  while i < 3 {
    let expected = GlyphName.synthesized(GlyphId.new(i))
    run nameAt(&map, i, GlyphName.asStr(&expected), GlyphNameSource.Synthesized)
    i = i + 1
  }
}

test effect fn longNamesAreFoundInFull() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run longNamesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn longNamesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let prefix = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let x = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaxxxxxxx"
  let y = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaayyyyyyy"
  let data = run post(&[0, 258, 259], &[x, y])
  let map = run modified(hvarNames(), List<u8>.asSlice(&data), false)
  let index = run GlyphNameIndex.new(&map)
  run Testing.expect(
    GlyphId.toU32(run some(GlyphNameIndex.get(&index, x))) == 1
      && GlyphId.toU32(run some(GlyphNameIndex.get(&index, y))) == 2,
    "full stored names are indexed",
  )
  run Testing.expect(absent(GlyphNameIndex.get(&index, prefix)), "truncated name is not indexed")
  run nameAt(&map, 1, prefix, GlyphNameSource.Post)
}

test effect fn missingNameTablesSynthesizeEachName() -> ()
  ! AssertionError<'static> {
  let map = run modified(tinos(), b"", true)
  run synthesized(&map)
}
