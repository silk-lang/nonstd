effect fn checkBatch(charmap: &Charmap, codepoints: &[u32]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut actual = List<GlyphId>.make()
  let mut i: usize = 0
  while i < codepoints.length {
    run List<GlyphId>.append(&mut actual, GlyphId.new(123))
    i = i + 1
  }
  let mapped = Charmap.mapUnicodeBatched(charmap, codepoints, List<GlyphId>.asMutSlice(&mut actual))
  let mut expected: usize = 0
  let mut initial = true
  i = 0
  while i < codepoints.length {
    let glyph = gid(Charmap.mapUnicode(charmap, codepoints[i]))
    run Testing.expect(
      GlyphId.toU32(List<GlyphId>.asSlice(&actual)[i]) == glyph,
      "batch writes every scalar result",
    )
    initial = initial && glyph != 0
    if initial {
      expected = expected + 1
    }
    i = i + 1
  }
  run Testing.expect(mapped == expected, "initial successful batch prefix")
}

test effect fn batchedUnicodeMatchesScalarAcrossCmapFormats() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run batchFormatsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn batchFormatsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let codepoints: [u32; 14] = [
    0,
    0x20,
    0x41,
    0x42,
    0xe9,
    0x400,
    0xf000,
    0xffff,
    0x10000,
    0x10ffff,
    0x110000,
    0x41,
    0x20,
    0,
  ]
  let fonts = [tinos(), cmap12Font(), cmapSymbolFont(), cmap6Font(), notoSerifFont(), notoEmoji()]
  let mut i: usize = 0
  while i < fonts.length {
    let charmap = run map(fonts[i])
    run checkBatch(&charmap, &codepoints)
    i = i + 1
  }
  let charmap = run map(tinos())
  run checkBatch(&charmap, &[65, 66, 67])
}

test effect fn batchedUnicodeHandlesLargeOrderedAndReversedInputs() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run largeBatchBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn largeBatchBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut forward = List<u32>.make()
  let mut reverse = List<u32>.make()
  let mut cp: u32 = 0
  while cp <= 0x11000 {
    run List<u32>.append(&mut forward, cp)
    cp = cp + 7
  }
  let mut at = List<u32>.length(&forward)
  while at > 0 {
    at = at - 1
    run List<u32>.append(&mut reverse, List<u32>.asSlice(&forward)[at])
  }
  let fonts = [tinos(), cmap12Font()]
  let mut i: usize = 0
  while i < fonts.length {
    let charmap = run map(fonts[i])
    run checkBatch(&charmap, List<u32>.asSlice(&forward))
    run checkBatch(&charmap, List<u32>.asSlice(&reverse))
    i = i + 1
  }
}

test effect fn batchedUnicodeHonorsDmap() -> ()
  ! AssertionError<'static> {
  let charmap = run map(dmapBatch())
  let codepoints: [u32; 6] = [65, 66, 67, 68, 69, 66]
  let expected: [u32; 6] = [1, 9, 3, 10, 0, 9]
  let mut actual: [GlyphId; 6] = [GlyphId.new(123); 6]
  run Testing.expect(
    Charmap.mapUnicodeBatched(&charmap, &codepoints, &mut actual) == 4,
    "DMAP batch prefix",
  )
  let mut i: usize = 0
  while i < 6 {
    run Testing.expect(
      GlyphId.toU32(actual[i]) == expected[i]
        && gid(Charmap.mapUnicode(&charmap, codepoints[i])) == expected[i],
      "DMAP scalar and batch",
    )
    i = i + 1
  }
}

test effect fn iteratorsOutliveTheCharmap() -> ()
  ! AssertionError<'static> {
  let mut unicodes = Charmap.unicodes(&(run map(cmap14Font())))
  let mut variants = Charmap.unicodeVariants(&(run map(cmap14Font())))
  let mut encodings = Charmap.encodings(&(run map(cmap14Font())))
  let encoding = run some(Encodings.next(&mut encodings))
  let mut codes = Charmap.codes(&(run map(cmap14Font())), encoding)
  drop run some(Unicodes.next(&mut unicodes))
  drop run some(UnicodeVariants.next(&mut variants))
  drop run some(Codes.next(&mut codes))
}

// Compare unordered results while requiring each expected code exactly once.
effect fn checkUnicodes(charmap: &Charmap, cps: &[u32], glyphs: &[u32]) -> ()
  ! AssertionError<'static> {
  let mut iter = Charmap.unicodes(charmap)
  let mut count: usize = 0
  let mut seen: u64 = 0
  while let Option<CmapMapping>.Some { value } = Unicodes.next(&mut iter) {
    let mut i: usize = 0
    while i < cps.length && cps[i] != value.codepoint {
      i = i + 1
    }
    run Testing.expect(i < cps.length, "expected Unicode code")
    run Testing.expect(
      GlyphId.toU32(value.glyph) == glyphs[i]
        && gid(Charmap.mapUnicode(charmap, value.codepoint)) == glyphs[i],
      "Unicode glyph",
    )
    let bit: u64 = u64.shiftLeft(1, usize.toU64(i))
    run Testing.expect((seen & bit) == 0, "unique Unicode code")
    seen = seen | bit
    count = count + 1
  }
  run Testing.expect(count == cps.length, "Unicode count")
}

effect fn checkVariants(charmap: &Charmap, cps: &[u32], glyphs: &[u32]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(Charmap.hasUnicodeVariants(charmap), "has variants")
  let mut iter = Charmap.unicodeVariants(charmap)
  let mut count: usize = 0
  let mut seen: u64 = 0
  while let Option<UnicodeVariant>.Some { value } = UnicodeVariants.next(&mut iter) {
    let mut i: usize = 0
    while i < cps.length && cps[i] != value.codepoint {
      i = i + 1
    }
    run Testing.expect(i < cps.length, "expected variant code")
    run Testing.expect(
      value.selector == 0xfe0f && GlyphId.toU32(value.glyph) == glyphs[i]
        && gid(Charmap.mapUnicodeVariant(charmap, value.codepoint, value.selector)) == glyphs[i],
      "variant glyph",
    )
    let bit: u64 = u64.shiftLeft(1, usize.toU64(i))
    run Testing.expect((seen & bit) == 0, "unique variant code")
    seen = seen | bit
    count = count + 1
  }
  run Testing.expect(count == cps.length, "variant count")
}

test effect fn cmap15SelectionAndDmapVariants() -> ()
  ! AssertionError<'static> {
  let bases = [cmap15Order0(), cmap15Order1()]
  let deltas = [cmap15Delta0(), cmap15Delta1()]
  let mut i: usize = 0
  while i < 2 {
    let base = run map(bases[i])
    run checkVariants(&base, &[65, 66, 68], &[1, 70000, 0xffffff])
    let delta = run map(deltas[i])
    run checkVariants(&delta, &[65, 66, 67, 68], &[2, 70000, 3, 0xffffff])
    i = i + 1
  }
  let only = run map(dmap15Only())
  run Testing.expect(
    gid(Charmap.mapUnicodeVariant(&only, 66, 0xfe0f)) == 70000,
    "DMAP15 without base",
  )
}

test effect fn dmapUnicodeLookupsAndIterators() -> ()
  ! AssertionError<'static> {
  let charmap = run map(dmapMappings())
  run Testing.expect(Charmap.hasUnicode(&charmap), "DMAP Unicode")
  run checkUnicodes(&charmap, &[65, 66, 67, 68], &[3, 2, 4, 5])
  run checkVariants(&charmap, &[65, 66, 67, 68], &[3, 4, 6, 7])
  let mut encodings = Charmap.encodings(&charmap)
  let mut encCount: usize = 0
  while let Option<Encoding>.Some { value: encoding } = Encodings.next(&mut encodings) {
    encCount = encCount + 1
    let index = run some(Encoding.sfntIndex(encoding))
    run Testing.expect(&index.tag == &Tag.new(&[99, 109, 97, 112]), "base record retained")
    run Testing.expect(
      gid(Charmap.mapCode(&charmap, encoding, 65)) == 3,
      "selected encoding override",
    )
    let mut codes = Charmap.codes(&charmap, encoding)
    let expected: [u32; 4] = [3, 2, 4, 5]
    let mut seen: u32 = 0
    let mut count: usize = 0
    while let Option<CmapMapping>.Some { value } = Codes.next(&mut codes) {
      run Testing.expect(value.codepoint >= 65 && value.codepoint <= 68, "expected encoded code")
      let at = value.codepoint - 65
      run Testing.expect(GlyphId.toU32(value.glyph) == expected[u32.toUsize(at)], "encoding glyph")
      let bit: u32 = u32.shiftLeft(1, at)
      run Testing.expect((seen & bit) == 0, "encoding unique code")
      seen = seen | bit
      count = count + 1
    }
    run Testing.expect(count == 4, "encoding count")
  }
  run Testing.expect(encCount == 1, "matching DMAP encoding omitted")
  let only = run map(dmapOnly())
  run Testing.expect(
    Charmap.hasUnicode(&only) && gid(Charmap.mapUnicode(&only, 65)) == 3
      && gid(Charmap.mapUnicodeVariant(&only, 65, 0xfe0f)) == 3,
    "DMAP-only mappings",
  )
  let mut onlyEnc = Charmap.encodings(&only)
  let encoding = run some(Encodings.next(&mut onlyEnc))
  let index = run some(Encoding.sfntIndex(encoding))
  run Testing.expect(
    &index.tag == &Tag.new(&[68, 77, 65, 80]) && index.index == 0
      && gid(Charmap.mapCode(&only, encoding, 65)) == 3,
    "DMAP-only encoding",
  )
}

effect fn standalone(data: &[u8]) -> CffFontRef
  ! AssertionError<'static> {
  return match move CffFontRef.newCff(data, 0, Option<i32>.None) {
    Result<CffFontRef, Error>.Success { value } => move value
    _ => {
      run Testing.expect(false, "CFF fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

test effect fn standaloneCffBatchMatchesScalarAndWritesAfterAMiss() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run standaloneBatchBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn standaloneBatchBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run standalone(notoSerifTable())
  let charmap = Charmap.fromCff(&font)
  run checkBatch(&charmap, &[105, 0x10ffff, 105])
  let mut glyphs: [GlyphId; 3] = [GlyphId.new(123); 3]
  run Testing.expect(
    Charmap.mapUnicodeBatched(&charmap, &[105, 0x10ffff, 105], &mut glyphs) == 0,
    "AGL excluded",
  )
  let mut i: usize = 0
  while i < 3 {
    run Testing.expect(GlyphId.toU32(glyphs[i]) == 0, "all outputs cleared without AGL")
    i = i + 1
  }
}

test effect fn cidCffHasNoGlyphNameUnicodeMapping() -> ()
  ! AssertionError<'static> {
  let sfnt = run must(FontRef.new(notoSansJp()))
  let cff = run some(FontRef.tableData(&sfnt, Tag.new(&[67, 70, 70, 32])))
  let font = run standalone(FontData.asBytes(&cff))
  let charmap = Charmap.fromCff(&font)
  run Testing.expect(
    !Charmap.hasUnicode(&charmap) && gid(Charmap.mapUnicode(&charmap, 65)) == 0,
    "CID no Unicode map",
  )
  let mut encodings = Charmap.encodings(&charmap)
  run Testing.expect(
    match move Encodings.next(&mut encodings) {
      Option<Encoding>.None => true
      _ => false
    },
    "CID no native encoding",
  )
  run Testing.expect(
    gid(
      Charmap.mapCode(&charmap, Encoding.standaloneCffNative(Option<PredefinedEncoding>.None), 65),
    )
      == 0,
    "CID native mapping absent",
  )
  let mut glyphs: [GlyphId; 2] = [GlyphId.new(123); 2]
  run Testing.expect(
    Charmap.mapUnicodeBatched(&charmap, &[65, 66], &mut glyphs) == 0
      && GlyphId.toU32(glyphs[0]) == 0
      && GlyphId.toU32(glyphs[1]) == 0,
    "CID batch cleared",
  )
}

test effect fn selectableMappingsAreFixedSizeAndKeepRecordIdentity() -> ()
  ! AssertionError<'static> {
  let layout = Layout.of<Encoding>()
  run Testing.expect(layout.bytes == 12, "fixed-size encoding key")
  run Testing.expect(
    EncodingKind.value(EncodingKind.Unicode) == 0x756e6963
      && EncodingKind.value(EncodingKind.AppleRoman) == 0x61726d6e,
    "FreeType encoding tags",
  )
  let font = run must(FontRef.new(vorgFont()))
  let charmap = Charmap.new(&font)
  let cmap = run must(FontRef.cmap(&font))
  let mut encodings = Charmap.encodings(&charmap)
  let mut previous = Option<Encoding>.None
  let mut unicodeCount: usize = 0
  while let Option<Encoding>.Some { value: encoding } = Encodings.next(&mut encodings) {
    let index = run some(Encoding.sfntIndex(encoding))
    run Testing.expect(&index.tag == &Tag.new(&[99, 109, 97, 112]), "cmap record source")
    let records = Cmap.encodingRecords(&cmap)
    let record = run must(
      ComputedArray<'static, (), EncodingRecord<'static>>.get(&records, u32.toUsize(index.index)),
    )
    let ids = run some(Encoding.sfntIds(encoding))
    run Testing.expect(
      ids.platformId == PlatformId.value(EncodingRecord.platformId(&record))
        && ids.encodingId == EncodingRecord.encodingId(&record),
      "record IDs retained",
    )
    let subtable = run must(EncodingRecord.subtable(&record, Cmap.offsetData(&cmap)))
    run Testing.expect(
      gid(Charmap.mapCode(&charmap, encoding, 65)) == gid(CmapSubtable.mapCodepoint(&subtable, 65)),
      "selected subtable mapping",
    )
    let mut codes = Charmap.codes(&charmap, encoding)
    let mapper = Charmap.encodingMapper(&charmap, encoding)
    let mut count: usize = 0
    while count < 3 {
      if let Option<CmapMapping>.Some { value } = Codes.next(&mut codes) {
        run Testing.expect(
          gid(Charmap.mapCode(&charmap, encoding, value.codepoint)) == GlyphId.toU32(value.glyph),
          "selected codes",
        )
        run Testing.expect(
          gid(EncodingMapper.map(&mapper, value.codepoint)) == GlyphId.toU32(value.glyph),
          "encoding mapper codes",
        )
      }
      count = count + 1
    }
    if Encoding.kind(encoding) == EncodingKind.Unicode {
      unicodeCount = unicodeCount + 1
    }
    if let Option<Encoding>.Some { value } = &previous {
      run Testing.expect(&value != &encoding, "record identity distinct")
    }
    previous = Option<Encoding>.some(encoding)
  }
  run Testing.expect(unicodeCount > 1, "multiple Unicode records remain distinct")
}

test effect fn resolvesDefaultAndNonDefaultVariants() -> ()
  ! AssertionError<'static> {
  let charmap = run map(cmap14Font())
  run Testing.expect(Charmap.hasUnicodeVariants(&charmap), "variation table")
  let selector: u32 = 0xe0100
  let default = gid(Charmap.mapUnicode(&charmap, 0x4e00))
  run Testing.expect(
    default != 0 && gid(Charmap.mapUnicodeVariant(&charmap, 0x4e00, selector)) == default,
    "default variant",
  )
  run Testing.expect(
    gid(Charmap.mapUnicodeVariant(&charmap, 0x4e08, selector)) == 25
      && gid(Charmap.mapUnicodeVariant(&charmap, 97, selector)) == 0,
    "nondefault and absent variants",
  )
  let mut variants = Charmap.unicodeVariants(&charmap)
  let mut foundDefault = false
  let mut foundNondefault = false
  while let Option<UnicodeVariant>.Some { value } = UnicodeVariants.next(&mut variants) {
    if value.selector == selector {
      if value.codepoint == 0x4e00 && GlyphId.toU32(value.glyph) == default {
        foundDefault = true
      }
      if value.codepoint == 0x4e08 && GlyphId.toU32(value.glyph) == 25 {
        foundNondefault = true
      }
    }
  }
  run Testing.expect(foundDefault && foundNondefault, "variant iterator resolves both kinds")
}

test effect fn symbolEncodingFallsBackToThePrivateUsePage() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(cmapSymbolFont()))
  let cmap = run must(FontRef.cmap(&font))
  let selected = run some(Cmap.bestSubtable(&cmap))
  let mut cp: u32 = 0xf000
  let mut glyph: u32 = 0
  while cp <= 0xf0ff {
    glyph = gid(CmapSubtable.mapCodepoint(&selected.subtable, cp))
    if glyph != 0 {
      break
    }
    cp = cp + 1
  }
  run Testing.expect(
    glyph != 0 && gid(CmapSubtable.mapCodepoint(&selected.subtable, cp - 0xf000)) == 0,
    "direct private-use mapping",
  )
  let charmap = Charmap.new(&font)
  run Testing.expect(
    Charmap.hasUnicode(&charmap) && Charmap.unicodeIsSymbol(&charmap)
      && !Charmap.unicodeIsMacRoman(&charmap),
    "symbol selection",
  )
  run Testing.expect(gid(Charmap.mapUnicode(&charmap, cp - 0xf000)) == glyph, "symbol fallback")
  let mut iter = Charmap.unicodes(&charmap)
  let mut found = false
  while let Option<CmapMapping>.Some { value } = Unicodes.next(&mut iter) {
    if value.codepoint == cp && GlyphId.toU32(value.glyph) == glyph {
      found = true
    }
    run Testing.expect(
      !(value.codepoint == cp - 0xf000 && GlyphId.toU32(value.glyph) == glyph),
      "iterator excludes implicit fallback",
    )
  }
  run Testing.expect(found, "private-use iterator entry")
  let mut encodings = Charmap.encodings(&charmap)
  let encoding = run some(Encodings.next(&mut encodings))
  run Testing.expect(gid(Charmap.mapCode(&charmap, encoding, cp)) == glyph, "native code mapping")
  let mut codes = Charmap.codes(&charmap, encoding)
  found = false
  while let Option<CmapMapping>.Some { value } = Codes.next(&mut codes) {
    if value.codepoint == cp && GlyphId.toU32(value.glyph) == glyph {
      found = true
    }
  }
  run Testing.expect(found, "native code iterator")
}

test effect fn symbolEncodingRetriesWhenDirectMappingIsNotdef() -> ()
  ! AssertionError<'static> {
  let charmap = run map(symbolNotdef())
  run Testing.expect(gid(Charmap.mapUnicode(&charmap, 65)) == 3, "notdef retries private-use page")
  let mut batched: [GlyphId; 3] = [GlyphId.new(0); 3]
  run Testing.expect(
    Charmap.mapUnicodeBatched(&charmap, &[65, 66, 65], &mut batched) == 1
      && GlyphId.toU32(batched[0]) == 3
      && GlyphId.toU32(batched[1]) == 0
      && GlyphId.toU32(batched[2]) == 3,
    "batch retry after miss",
  )
  run checkUnicodes(&charmap, &[0xf041], &[3])
  let mut encodings = Charmap.encodings(&charmap)
  let encoding = run some(Encodings.next(&mut encodings))
  run Testing.expect(
    gid(Charmap.mapCode(&charmap, encoding, 65)) == 0,
    "native code has no symbol fallback",
  )
  let mut codes = Charmap.codes(&charmap, encoding)
  while let Option<CmapMapping>.Some { value } = Codes.next(&mut codes) {
    run Testing.expect(value.codepoint != 65, "native iterator filters notdef")
  }
}

test effect fn macRomanEncodingTranslatesUnicode() -> ()
  ! AssertionError<'static> {
  let charmap = run map(macRoman())
  run Testing.expect(
    Charmap.hasUnicode(&charmap) && !Charmap.unicodeIsSymbol(&charmap)
      && Charmap.unicodeIsMacRoman(&charmap),
    "Mac Roman selection",
  )
  run Testing.expect(
    gid(Charmap.mapUnicode(&charmap, 0xe9)) == 3 && gid(Charmap.mapUnicode(&charmap, 65)) == 0
      && gid(Charmap.mapUnicode(&charmap, 0x100)) == 0,
    "Mac Roman conversion and rejected character",
  )
  let mut batch: [GlyphId; 1] = [GlyphId.new(9)]
  drop Charmap.mapUnicodeBatched(&charmap, &[0x100], &mut batch)
  run Testing.expect(GlyphId.toU32(batch[0]) == 0, "unencodable batch is not code zero")
  run checkUnicodes(&charmap, &[0, 0xe9], &[5, 3])
  let mut encodings = Charmap.encodings(&charmap)
  let encoding = run some(Encodings.next(&mut encodings))
  run Testing.expect(gid(Charmap.mapCode(&charmap, encoding, 0x8e)) == 3, "native Roman code")
  let mut codes = Charmap.codes(&charmap, encoding)
  let mut found = false
  while let Option<CmapMapping>.Some { value } = Codes.next(&mut codes) {
    if value.codepoint == 0x8e && GlyphId.toU32(value.glyph) == 3 {
      found = true
    }
  }
  run Testing.expect(found, "native Roman iteration")
}

test effect fn format0MappingsAreListedOnce() -> ()
  ! AssertionError<'static> {
  let charmap = run map(unicodeFormat0())
  run Testing.expect(!Charmap.unicodeIsMacRoman(&charmap), "format0 Unicode")
  run checkUnicodes(&charmap, &[65, 66], &[3, 4])
}

import model { Blob, Tables, TableFunction, TableCallback }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }

struct CountedFont {
  reads: *mut u32,
}

impl TableCallback for CountedFont {
  effect fn table(self: &Self, tag: Tag) -> Option<Blob>
    ! OutOfMemoryError
    ? &mut Allocator {
    // The counter lives in snapshotBody until the callback snapshot is complete.
    if &tag == &Tag.new(&[99, 109, 97, 112]) {
      drop unsafe Atomic.fetchAdd<u32>(self.reads, 1, MemoryOrder.Relaxed)
    }
    if let Result<FontRef, ReadError>.Success { value: font } = FontRef.new(vazirmatn()) {
      if let Option<FontData>.Some { value } = FontRef.tableData(&font, tag) {
        return Option<Blob>.some(run Blob.fromBytes(FontData.asBytes(&value)))
      }
    }
    return Option<Blob>.None
  }
}

// Eager TableFunction snapshots replace the upstream lazy Font instance cache.
test effect fn selectedSubtablesReuseTheCallbackSnapshot() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run snapshotBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn snapshotBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut reads: u32 = 0
  let counter = Pointer.fromMutRef(&mut reads)
  let callback = CountedFont { reads: counter }
  let tables = Tables.fromTableFunction(run TableFunction.new(&callback))
  run Testing.expect(
    unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed) == 1,
    "eager snapshot calls cmap once",
  )
  let view = Tables.view(&tables)
  let charmap = Charmap.new(&view)
  run Testing.expect(gid(Charmap.mapUnicode(&charmap, 65)) == 1, "snapshot mapping")
  let copied = charmap
  let reconstructed = Charmap.new(&view)
  run Testing.expect(
    gid(Charmap.mapUnicode(&copied, 65)) == 1 && gid(Charmap.mapUnicode(&reconstructed, 65)) == 1,
    "copied and reconstructed facades agree",
  )
  run Testing.expect(
    unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed) == 1,
    "repeated lookup never recalls source",
  )
}

test effect fn filledUnicodeTableMatchesScalarLookups() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fillBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fillBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [
    tinos(),
    cmap12Font(),
    cmap14Font(),
    cmapSymbolFont(),
    cmap6Font(),
    vazirmatn(),
    notoEmoji(),
    notoSansJp(),
  ]
  let mut filled: usize = 0
  let mut i: usize = 0
  while i < fonts.length {
    let charmap = run map(fonts[i])
    let mut table: [u16; 12288] = [0xffff; 12288]
    if Charmap.fillUnicode(&charmap, &mut table) {
      filled = filled + 1
      let mut cp: usize = 0
      while cp < table.length {
        let mut expected = gid(Charmap.mapUnicode(&charmap, usize.toU32(cp)))
        if expected > 0xffff {
          expected = 0xffff
        }
        run Testing.expect(u16.toU32(table[cp]) == expected, "filled glyph")
        cp = cp + 1
      }
    } else {
      run Testing.expect(table[0x41] == 0xffff, "an unfilled table is unchanged")
    }
    i = i + 1
  }
  run Testing.expect(filled >= 2, "format 4 and 12 subtables fill")
}
