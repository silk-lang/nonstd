effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "charmap fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(input: Option<T>) -> T
  ! AssertionError<'static> {
  return match move input {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "expected mapping")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn gid(value: Option<GlyphId>) -> u32 {
  return GlyphId.toU32(move value |> Option<GlyphId>.unwrapOr(GlyphId.new(0)))
}

effect fn map(data: &[u8]) -> Charmap
  ! AssertionError<'static> {
  let font = run must(FontRef.new(data))
  return Charmap.new(&font)
}

test effect fn mapsASelectedUnicodeSubtable() -> ()
  ! AssertionError<'static> {
  let charmap = run map(vazirmatn())
  run Testing.expect(
    Charmap.hasUnicode(&charmap) && !Charmap.unicodeIsSymbol(&charmap)
      && !Charmap.unicodeIsMacRoman(&charmap),
    "Unicode selection",
  )
  run Testing.expect(
    gid(Charmap.mapUnicode(&charmap, 65)) == 1 && gid(Charmap.mapUnicode(&charmap, 66)) == 0
      && gid(Charmap.mapUnicode(&charmap, 65535)) == 0,
    "nominal mappings",
  )
  let mut iter = Charmap.unicodes(&charmap)
  let mut found = false
  while let Option<CmapMapping>.Some { value } = Unicodes.next(&mut iter) {
    if value.codepoint == 65 && GlyphId.toU32(value.glyph) == 1 {
      found = true
    }
  }
  run Testing.expect(found, "Unicode iteration")
}

