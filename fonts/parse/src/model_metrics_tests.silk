struct MixedVorg<'a> {
  font: FontRef<'a>,
  origin: FontRef<'a>,
  vvarReads: *mut u32,
}

impl<'a> TableProvider<'a> for MixedVorg<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    if Tag.toU32(tag) == 0x564f5247 {
      return FontRef.tableData(&self.origin, tag)
    }
    if Tag.toU32(tag) == 0x56564152 {
      let old = unsafe Atomic.fetchAdd<u32>(self.vvarReads, 1, MemoryOrder.Relaxed)
      drop old
    }
    return FontRef.tableData(&self.font, tag)
  }
}

fn mixedMetrics<'a, 'c>(provider: &MixedVorg<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(provider, coords)
}

test effect fn vorgReadsTheVvarOriginDeltaAtALocation() -> ()
  ! AssertionError<'static> {
  let mut reads: u32 = 0
  let counter = Pointer.fromMutRef(&mut reads)
  let provider = MixedVorg {
    font: run must(FontRef.new(verticalCff2())),
    origin: run must(FontRef.new(vorgFont())),
    vvarReads: counter,
  }
  let coords = [F2Dot14.fromBits(-16384)]
  let metrics = mixedMetrics(&provider, &coords)
  let vorg = run must(FontRef.vorg(&provider.origin))
  let actual = run some(GlyphMetrics.statedVOrigin(&metrics, GlyphId.new(1)))
  run Testing.expect(
    &actual == &F48Dot16.fromI32(i16.toI32(Vorg.verticalOriginY(&vorg, GlyphId.new(1))))
      && unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed) > 0,
    "VORG plus VVAR origin delta",
  )
}

import model { Blob, Tables, TableFunction, TableCallback }
import model.font.tables { TablesView }

struct WideCallback<'a> {
  data: &'a [u8],
  counts: *mut u64,
}

impl<'a> TableCallback for WideCallback<'a> {
  effect fn table(self: &Self, tag: Tag) -> Option<Blob>
    ! OutOfMemoryError
    ? &mut Allocator {
    let amount: u64 = match Tag.toU32(tag) {
      0x4d415850 => 1
      0x48484541 => 256
      0x484d5458 => 65536
      0x56484541 => 16777216
      0x564d5458 => 4294967296
      _ => 0
    }
    let old = unsafe Atomic.fetchAdd<u64>(self.counts, amount, MemoryOrder.Relaxed)
    drop old
    if let Result<FontRef, ReadError>.Success { value: font } = FontRef.new(self.data) {
      if let Option<FontData>.Some { value } = FontRef.tableData(&font, tag) {
        return Option<Blob>.some(run Blob.fromBytes(FontData.asBytes(&value)))
      }
    }
    return Option<Blob>.None
  }
}

fn tablesMetrics<'a, 'c>(provider: &TablesView<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(provider, coords)
}

test effect fn extendedMetricsFromCallbackTablesAreCached() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wideCallbackBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wideCallbackBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut bytes: [u8; 562000] = [0; 562000]
  let size = Builder.metricsFont(&mut bytes, true, true, 0)
  let mut counts: u64 = 0
  let counter = Pointer.fromMutRef(&mut counts)
  let callback = WideCallback { data: Slice.view<u8>(&bytes, 0, size), counts: counter }
  let tables = Tables.fromTableFunction(run TableFunction.new(&callback))
  let view = Tables.view(&tables)
  let mut i: usize = 0
  while i < 2 {
    let metrics = tablesMetrics(&view, &[])
    run Testing.expect(
      GlyphMetrics.numGlyphs(&metrics) == 70002
        && &GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(65536)) == &F48Dot16.fromI32(1036)
        && &GlyphMetrics.vAdvanceExact(&metrics, GlyphId.new(65536)) == &F48Dot16.fromI32(1236),
      "extended callback metrics selected",
    )
    i = i + 1
  }
  run Testing.expect(
    unsafe Atomic.load<u64>(counter, MemoryOrder.Relaxed) == 0x0101010101,
    "each extended raw table requested exactly once by snapshot",
  )
}

test effect fn everySourceMeasuresARunAsItMeasuresOne() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run everySourceBatchBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn equalOptionalBox(
  a: &Option<GlyphExtents<F48Dot16>>,
  b: &Option<GlyphExtents<F48Dot16>>,
) -> bool {
  return match &a.* {
    Option<GlyphExtents<F48Dot16>>.None => absent(b)
    Option<GlyphExtents<F48Dot16>>.Some { value: x } => match &b.* {
      Option<GlyphExtents<F48Dot16>>.Some { value: y } => equalBox(x, y)
      _ => false
    }
  }
}

effect fn everySourceBatchBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [tinos(), vazirmatn(), notoSansJp(), verticalCff2()]
  let mut f: usize = 0
  while f < 4 {
    let font = run must(FontRef.new(fonts[f]))
    let mut coord = F2Dot14.zero()
    if f == 1 {
      coord = F2Dot14.fromBits(-16384)
    }
    let location = [coord]
    let metrics = metricView(&font, &location)
    let mut glyphs = List<GlyphId>.make()
    let mut results = List<Option<GlyphExtents<F48Dot16>>>.make()
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&metrics) {
      run List<GlyphId>.append(&mut glyphs, GlyphId.new(i))
      run List<Option<GlyphExtents<F48Dot16>>>.append(
        &mut results,
        Option<GlyphExtents<F48Dot16>>.None,
      )
      i = i + 1
    }
    run GlyphMetrics.extentsBatched(
      &metrics,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&glyphs),
      List<Option<GlyphExtents<F48Dot16>>>.asMutSlice(&mut results),
    )
    let outputs = List<Option<GlyphExtents<F48Dot16>>>.asSlice(&results)
    i = 0
    while i < GlyphMetrics.numGlyphs(&metrics) {
      let expected = run GlyphMetrics.extentsExact(&metrics, GlyphId.new(i))
      run Testing.expect(
        equalOptionalBox(&outputs[u32.toUsize(i)], &expected),
        "each outline source batch matches single measurements",
      )
      i = i + 1
    }
    f = f + 1
  }
}
