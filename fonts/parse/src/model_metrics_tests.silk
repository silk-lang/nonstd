test effect fn phantomPointsMeasureAGlyphTheSameAsVvar() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(mplusVertical()))
  let filtered = Filtered { font: font, hideH: false, hideV: true }
  let coords = [F2Dot14.fromBits(-16384)]
  let a = metricView(&font, &coords)
  let b = filteredMetrics(&filtered, &coords)
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&a) {
    if i != 2 {
      run Testing.expect(
        &GlyphMetrics.vAdvanceExact(&a, GlyphId.new(i))
          == &GlyphMetrics.vAdvanceExact(&b, GlyphId.new(i)),
        "VVAR and gvar agree",
      )
    }
    i = i + 1
  }
  run Testing.expect(
    &(GlyphMetrics.vAdvanceExact(&b, GlyphId.new(2))
      - GlyphMetrics.vAdvanceExact(&a, GlyphId.new(2)))
      == &F48Dot16.fromI32(235),
    "composite USE_MY_METRICS discrepancy preserved",
  )
}

effect fn checkBatch(data: &[u8], coords: &[F2Dot14], vertical: bool) -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(data))
  let metrics = metricView(&font, coords)
  let glyphs = firstGlyphs()
  let mut output = [F48Dot16.zero(); 16]
  if vertical {
    GlyphMetrics.vAdvanceBatched(&metrics, &IdentityConverter {}, &glyphs, &mut output)
  } else {
    GlyphMetrics.hAdvanceBatched(&metrics, &IdentityConverter {}, &glyphs, &mut output)
  }
  let mut i: usize = 0
  while i < 16 {
    let mut expected = GlyphMetrics.hAdvanceExact(&metrics, glyphs[i])
    if vertical {
      expected = GlyphMetrics.vAdvanceExact(&metrics, glyphs[i])
    }
    run Testing.expect(&output[i] == &expected, "batch matches individual query")
    i = i + 1
  }
}

test effect fn aVerticalBatchAgreesWithOneAtATime() -> ()
  ! AssertionError<'static> {
  run checkBatch(verticalCff2(), &[], true)
  run checkBatch(verticalCff2(), &[F2Dot14.fromBits(-16384)], true)
  run checkBatch(tinos(), &[], true)
}

test effect fn aBatchAgreesWithOneAtATime() -> ()
  ! AssertionError<'static> {
  run checkBatch(tinos(), &[], false)
}

test effect fn aBatchAgreesWithOneAtATimeAtALocation() -> ()
  ! AssertionError<'static> {
  run checkBatch(vazirmatn(), &[F2Dot14.fromF32(-0.6)], false)
}

test effect fn theNarrowedAdvanceAgreesWithTheExactOne() -> ()
  ! AssertionError<'static> {
  let data = [tinos(), materialSymbols(), vazirmatn()]
  let mut n: usize = 0
  while n < data.length {
    let font = run must(FontRef.new(data[n]))
    let metrics = metricView(&font, &[])
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&metrics) {
      let glyph = GlyphId.new(i)
      run Testing.expect(
        GlyphMetrics.hAdvance(&metrics, glyph)
          == F48Dot16.toF32(GlyphMetrics.hAdvanceExact(&metrics, glyph)),
        "narrowed advance",
      )
      i = i + 1
    }
    n = n + 1
  }
}

test effect fn theConversionDecidesWhatACallerGetsBack() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let metrics = metricView(&font, &[])
  let glyphs = [GlyphId.new(1), GlyphId.new(2)]
  let mut exact = [F48Dot16.zero(); 2]
  let mut floats: [f32; 2] = [0.0; 2]
  GlyphMetrics.hAdvanceBatched(&metrics, &IdentityConverter {}, &glyphs, &mut exact)
  GlyphMetrics.hAdvanceBatched(&metrics, &FloatConverter {}, &glyphs, &mut floats)
  let mut i: usize = 0
  while i < 2 {
    run Testing.expect(floats[i] == F48Dot16.toF32(exact[i]), "caller-selected conversion")
    i = i + 1
  }
}

