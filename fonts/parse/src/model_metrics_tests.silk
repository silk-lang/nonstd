    i = i + 1
  }
  run Testing.expect(fractional, "fractional variation advance retained")
}

test effect fn gvarAnswersTheSameAsHvar() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(vazirmatn()))
  let filtered = Filtered { font: font, hideH: true, hideV: false }
  let locations: [f32; 5] = [-1.0, -0.8, -0.25, 0.75, 1.0]
  let mut n: usize = 0
  while n < locations.length {
    let coords = [F2Dot14.fromF32(locations[n])]
    let a = metricView(&font, &coords)
    let b = filteredMetrics(&filtered, &coords)
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&a) {
      run Testing.expect(
        &GlyphMetrics.hAdvanceExact(&a, GlyphId.new(i))
          == &GlyphMetrics.hAdvanceExact(&b, GlyphId.new(i)),
        "HVAR and gvar phantom advances agree",
      )
      i = i + 1
    }
    n = n + 1
  }
}

test effect fn negativeVariedAdvancesAreClampedBeforeScaling() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(negativeVarAdvances()))
  let locations: [f32; 3] = [0.0, 0.5, 1.0]
  let widths: [[f32; 3]; 3] = [[500.0, 500.0, 0.0], [199.5, 550.5, 0.0], [0.0, 601.0, 0.0]]
  let heights: [[f32; 3]; 3] = [[1000.0, 1000.0, 0.0], [399.5, 1100.5, 0.0], [0.0, 1201.0, 0.0]]
  let glyphs = [GlyphId.new(1), GlyphId.new(2), GlyphId.new(3)]
  let factors: [f32; 5] = [-2.0, -1.0, 0.0, 1.0, 2.0]
  let mut path: usize = 0
  while path < 2 {
    let filtered = Filtered { font: font, hideH: path == 1, hideV: path == 1 }
    let mut n: usize = 0
    while n < 3 {
      let coords = [F2Dot14.fromF32(locations[n])]
      let metrics = filteredMetrics(&filtered, &coords)
      let mut h = [F48Dot16.zero(); 3]
      let mut v = [F48Dot16.zero(); 3]
      GlyphMetrics.hAdvanceBatched(&metrics, &IdentityConverter {}, &glyphs, &mut h)
      GlyphMetrics.vAdvanceBatched(&metrics, &IdentityConverter {}, &glyphs, &mut v)
      let mut i: usize = 0
      while i < 3 {
        let exactH = GlyphMetrics.hAdvanceExact(&metrics, glyphs[i])
        let exactV = GlyphMetrics.vAdvanceExact(&metrics, glyphs[i])
        run Testing.expect(
          &exactH == &F48Dot16.fromF64(f32.toF64(widths[n][i]))
            && &exactV == &F48Dot16.fromF64(f32.toF64(heights[n][i]))
            && &h[i] == &exactH
            && &v[i] == &exactV
            && GlyphMetrics.hAdvance(&metrics, glyphs[i]) == widths[n][i]
            && GlyphMetrics.vAdvance(&metrics, glyphs[i]) == heights[n][i],
          "clamped exact and batched advances",
        )
        i = i + 1
      }
      let mut f: usize = 0
      while f < 5 {
        let scale = ScaleF32.new(factors[f] * 1000.0, -factors[f] * 1000.0, 1000)
        let scaled = scaledMetrics(metrics, scale)
        let mut hs: [f32; 3] = [0.0; 3]
        let mut vs: [f32; 3] = [0.0; 3]
        ScaledGlyphMetrics.hAdvanceBatched(&scaled, &IdentityConverter {}, &glyphs, &mut hs)
        ScaledGlyphMetrics.vAdvanceBatched(&scaled, &IdentityConverter {}, &glyphs, &mut vs)
        i = 0
        while i < 3 {
          run Testing.expect(
            ScaledGlyphMetrics.hAdvance(&scaled, glyphs[i]) == widths[n][i] * factors[f]
              && ScaledGlyphMetrics.vAdvance(&scaled, glyphs[i]) == heights[n][i] * -factors[f]
              && hs[i] == ScaledGlyphMetrics.hAdvance(&scaled, glyphs[i])
              && vs[i] == ScaledGlyphMetrics.vAdvance(&scaled, glyphs[i]),
            "clamp precedes signed scaling",
          )
          i = i + 1
        }
        f = f + 1
      }
      n = n + 1
    }
    path = path + 1
  }
}

fn scaledMetrics<'a, 'c>(metrics: GlyphMetrics<'a, 'c>, scale: ScaleF32) -> ScaledGlyphMetrics<
  'a,
  'c,
  'static,
  ScaleF32,
  f32,
  NoExtents
> {
  return GlyphMetrics<'a, 'c>.scaled<ScaleF32, f32>(metrics, scale)
}

test effect fn aReversedBoxStillMeasuresASize() -> ()
  ! AssertionError<'static> {
  let actual = GlyphExtents<F48Dot16>.fromBounds(
    Rect<F48Dot16> {
      xMin: F48Dot16.fromI32(70),
      yMin: F48Dot16.fromI32(50),
      xMax: F48Dot16.fromI32(10),
      yMax: F48Dot16.fromI32(-30),
    },
  )
  let expected = GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.fromI32(10),
    yBearing: F48Dot16.fromI32(50),
    width: F48Dot16.fromI32(60),
    height: F48Dot16.fromI32(80),
  }
  run Testing.expect(equalBox(actual, expected), "reversed corners ordered")
}

import test_font_builder as Builder
import silk.collections.slice { Slice }
import silk.collections.list { List }
import silk.num.usize

struct Overlay<'a> {
  font: FontRef<'a>,
  tables: &'a [Builder.TestTable<'a>],
}

impl<'a> TableProvider<'a> for Overlay<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    let mut i: usize = 0
    while i < self.tables.length {
      if Tag.toU32(tag) == self.tables[i].tag {
        return Option<FontData<'a>>.some(FontData.new(self.tables[i].data))
      }
      i = i + 1
    }
    return FontRef.tableData(&self.font, tag)
  }
}

fn overlayMetrics<'a, 'c>(provider: &Overlay<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(provider, coords)
}

test effect fn verticalOriginsInDesignUnitsMatchTheirSourcesAndBatch() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run verticalOriginsInDesignUnitsMatchTheirSourcesAndBatchBody()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn verticalOriginsInDesignUnitsMatchTheirSourcesAndBatchBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [vorgFont(), mplusVertical(), tinos()]
  let mut f: usize = 0
  while f < 3 {
    let font = run must(FontRef.new(fonts[f]))
    let metrics = metricView(&font, &[])
    let mut glyphs = List<GlyphId>.make()
    let mut outputs = List<F48Dot16>.make()
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&metrics) {
      run List<GlyphId>.append(&mut glyphs, GlyphId.new(i))
      run List<F48Dot16>.append(&mut outputs, F48Dot16.zero())
      i = i + 1
    }
    run GlyphMetrics.vOriginYBatched(
      &metrics,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&glyphs),
      List<F48Dot16>.asMutSlice(&mut outputs),
    )
    i = 0
    while i < GlyphMetrics.numGlyphs(&metrics) {
      let glyph = GlyphId.new(i)
      let origin = run GlyphMetrics.vOriginYExact(&metrics, glyph)
      run Testing.expect(
        &origin == &List<F48Dot16>.get(&outputs, u32.toUsize(i))
          && F48Dot16.toF32(origin) == (run GlyphMetrics.vOriginY(&metrics, glyph)),
        "origin batch and narrowed form",
      )
      if let Option<F48Dot16>.Some { value } = GlyphMetrics.statedVOrigin(&metrics, glyph) {
        run Testing.expect(&origin == &value, "VORG origin wins")
      } else if let Option<F48Dot16>.Some { value } = run GlyphMetrics.glyfVOrigin(
        &metrics,
        glyph,
      ) {
        run Testing.expect(&origin == &value, "glyf phantom origin")
      }
      i = i + 1
    }
    f = f + 1
  }
}

test effect fn aBoxIsTheOneTheGlyphStates() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aBoxIsTheOneTheGlyphStatesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aBoxIsTheOneTheGlyphStatesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let metrics = metricView(&font, &[])
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let hmtx = run must(FontRef.hmtx(&font))
  let mut drawn: u32 = 0
  let mut empty: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&metrics) {
    let gid = GlyphId.new(i)
    let outline = run some(Loca.get(&loca, gid, &glyf))
    let actual = run some(run GlyphMetrics.extentsExact(&metrics, gid))
    let mut expected = zeroExtents()
    if let LocaGlyph.Glyph { value } = outline {
      if Glyph.numberOfContours(&value) != 0 {
        expected = GlyphExtents<F48Dot16> {
          xBearing: F48Dot16.fromI32(
            i16.toI32(Hmtx.sideBearing(&hmtx, gid) |> Option<i16>.unwrapOr(0)),
          ),
          yBearing: F48Dot16.fromI32(i16.toI32(Glyph.yMax(&value))),
          width: F48Dot16.fromI32(i16.toI32(Glyph.xMax(&value)) - i16.toI32(Glyph.xMin(&value))),
          height: F48Dot16.fromI32(i16.toI32(Glyph.yMax(&value)) - i16.toI32(Glyph.yMin(&value))),
        }
        drawn = drawn + 1
      } else {
        empty = empty + 1
      }
    } else {
      empty = empty + 1
    }
    run Testing.expect(equalBox(actual, expected), "header bounds and hmtx bearing")
    i = i + 1
  }
  run Testing.expect(drawn > 0 && empty > 0, "drawn and empty glyphs checked")
}

