test effect fn anAdvanceKeepsTheFractionALocationAdds() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(vazirmatn()))
  let coords = [F2Dot14.fromF32(-0.4)]
  let metrics = metricView(&font, &coords)
  let mut fractional = false
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&metrics) {
    if (F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(i))) & 65535) != 0 {
      fractional = true
