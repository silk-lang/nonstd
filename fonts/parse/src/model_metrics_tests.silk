test effect fn extendedMetricsInTheCachedFontModel() -> ()
  ! AssertionError<'static> {
  let mut bytes: [u8; 562000] = [0; 562000]
  let outlines: [u32; 3] = [0, 0x676c7966, 0x474c5946]
  let ids: [u32; 4] = [0, 65535, 65536, 69999]
  let mut n: usize = 0
  while n < 6 {
    let size = Builder.metricsFont(&mut bytes, true, (n & 1) != 0, outlines[n / 2])
    let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
    let metrics = metricView(&font, &[])
    run Testing.expect(GlyphMetrics.numGlyphs(&metrics) == 70002, "extended glyph count")
    let mut i: usize = 0
    while i < 4 {
      let gid = GlyphId.new(ids[i])
      run Testing.expect(
        F48Dot16.toI32(GlyphMetrics.hAdvanceExact(&metrics, gid)) == 1000 + u32.toI32(ids[i] % 100)
          && F48Dot16.toI32(GlyphMetrics.vAdvanceExact(&metrics, gid))
            == 1200 + u32.toI32(ids[i] % 100),
        "extended metrics selected",
      )
      i = i + 1
    }
    run Testing.expect(
      F48Dot16.toI32(GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(70001))) == 1099
        && F48Dot16.toI32(GlyphMetrics.vAdvanceExact(&metrics, GlyphId.new(70001))) == 1299
        && F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(70002))) == 0,
      "extended tail and boundary",
    )
    n = n + 1
  }
}

