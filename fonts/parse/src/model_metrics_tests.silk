fn absent<T>(value: &Option<T>) -> bool {
  return match &value.* {
    Option<T>.None => true
    _ => false
  }
}

fn equalBox(a: GlyphExtents<F48Dot16>, b: GlyphExtents<F48Dot16>) -> bool {
  return &a.xBearing == &b.xBearing && &a.yBearing == &b.yBearing && &a.width == &b.width
    && &a.height == &b.height
}

struct Filtered<'a> {
  font: FontRef<'a>,
  hideH: bool,
  hideV: bool,
}

impl<'a> TableProvider<'a> for Filtered<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    if (self.hideH && &tag == &Tag.fromU32(0x48564152))
      || (self.hideV && &tag == &Tag.fromU32(0x56564152)) {
      return Option<FontData<'a>>.None
    }
    return FontRef.tableData(&self.font, tag)
  }
}

fn filteredMetrics<'a, 'c>(font: &Filtered<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(font, coords)
}

struct FloatConverter {}

impl MetricConverter<F48Dot16, f32> for FloatConverter {
  fn convert(self: &Self, value: F48Dot16) -> f32 {
    return F48Dot16.toF32(value)
  }
}

fn firstGlyphs() -> [GlyphId; 16] {
  let mut result = [GlyphId.new(0); 16]
  let mut i: u32 = 0
  while i < 16 {
    result[u32.toUsize(i)] = GlyphId.new(i)
    i = i + 1
  }
  return result
}

test effect fn aWidthIsWhatHmtxStores() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(materialSymbols()))
  let metrics = metricView(&font, &[])
  let hmtx = run must(FontRef.hmtx(&font))
  let mut i: u32 = 0
  run Testing.expect(GlyphMetrics.numGlyphs(&metrics) > 1, "fixture has multiple glyphs")
  while i < GlyphMetrics.numGlyphs(&metrics) {
    let glyph = GlyphId.new(i)
    let expected = run some(Hmtx.advance(&hmtx, glyph))
    run Testing.expect(
      &GlyphMetrics.hAdvanceExact(&metrics, glyph) == &F48Dot16.fromI32(u16.toI32(expected)),
      "advance matches stored metric",
    )
    i = i + 1
  }
}

test effect fn aFontWithNoWidthsGivesEveryGlyphHalfAnEm() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(namesOnly()))
  let metrics = metricView(&font, &[])
  run Testing.expect(
    &GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(1)) == &F48Dot16.fromI32(500),
    "missing widths use half the fallback em",
  )
}

test effect fn glyphsPastTheLongMetricsShareTheLastAdvance() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(materialSymbols()))
  let metrics = metricView(&font, &[])
  let header = run must(FontRef.hhea(&font))
  let first = u16.toU32(Hhea.numberOfHMetrics(&header))
  let count = GlyphMetrics.numGlyphs(&metrics)
  run Testing.expect(first > 0 && first < count, "fixture has a metric tail")
  let last = GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(first - 1))
  run Testing.expect(F48Dot16.toBits(last) > 0, "tail advance positive")
  let mut i = first
  while i < count {
    run Testing.expect(
      &GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(i)) == &last,
      "tail shares last advance",
    )
    i = i + 1
  }
  run Testing.expect(
    F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&metrics, GlyphId.new(count))) == 0,
    "tail ends at glyph count",
  )
}

test effect fn glyphsBeyondTheFontMeasureZeroAtAnyLocation() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(vazirmatn()))
  let coords = [F2Dot14.fromBits(-16384)]
  let base = metricView(&font, &[])
  let varied = metricView(&font, &coords)
  let count = GlyphMetrics.numGlyphs(&base)
  run Testing.expect(
    &GlyphMetrics.hAdvanceExact(&base, GlyphId.new(count - 1))
      != &GlyphMetrics.hAdvanceExact(&varied, GlyphId.new(count - 1)),
    "last real glyph moves",
  )
  let ids = [count, count + 1, 4294967295]
  let mut i: usize = 0
  while i < 3 {
    run Testing.expect(
      F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&base, GlyphId.new(ids[i]))) == 0
        && F48Dot16.toBits(GlyphMetrics.hAdvanceExact(&varied, GlyphId.new(ids[i]))) == 0,
      "out of range remains zero",
    )
    i = i + 1
  }
}

test effect fn verticalAdvancesComeFromVmtx() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(verticalCff2()))
  let metrics = metricView(&font, &[])
  let vmtx = run must(FontRef.vmtx(&font))
  let mut checked: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&metrics) {
    let glyph = GlyphId.new(i)
    if let Option<u16>.Some { value } = Vmtx.advance(&vmtx, glyph) {
      run Testing.expect(
        &GlyphMetrics.vAdvanceExact(&metrics, glyph) == &F48Dot16.fromI32(u16.toI32(value)),
        "stated vertical advance",
      )
      checked = checked + 1
    }
    i = i + 1
  }
  run Testing.expect(checked > 1, "multiple vertical advances")
}

test effect fn withoutVmtxGlyphsAdvanceByTheLine() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let global = Metrics.fromSfnt(&font, &[])
  let line = run some(Metrics.hLine(&global))
  let expected = line.ascender - line.descender
  let metrics = metricView(&font, &[])
  run Testing.expect(F48Dot16.toBits(expected) > 0, "positive line height")
  let mut i: u32 = 0
  while i < 16 && i < GlyphMetrics.numGlyphs(&metrics) {
    run Testing.expect(
      &GlyphMetrics.vAdvanceExact(&metrics, GlyphId.new(i)) == &expected,
      "vertical fallback uses line",
    )
    i = i + 1
  }
}

