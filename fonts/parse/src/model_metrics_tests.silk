  ! AssertionError<'static> {
  let font = run must(FontRef.new(mplusVertical()))
  let coords = [F2Dot14.fromBits(-16384)]
  let base = metricView(&font, &[])
  let varied = metricView(&font, &coords)
  let mut moved = false
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&base) {
    if &GlyphMetrics.vAdvanceExact(&base, GlyphId.new(i))
      != &GlyphMetrics.vAdvanceExact(&varied, GlyphId.new(i)) {
      moved = true
    }
    i = i + 1
