effect fn drawnBounds<'a, 'b, 'c>(data: &'a [u8], expected: &'b [u8], coords: &'c [F2Dot14]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(data))
  let metrics = metricView(&font, coords)
  let bytes = FontData.new(expected)
  let mut at: usize = 0
  let mut checked: u32 = 0
  while at < expected.length {
    let gid = run must(FontData<'b>.readAt<u32>(&bytes, at))
    let e = GlyphExtents<F48Dot16> {
      xBearing: F48Dot16.fromBits(run must(FontData<'b>.readAt<i64>(&bytes, at + 4))),
      yBearing: F48Dot16.fromBits(run must(FontData<'b>.readAt<i64>(&bytes, at + 12))),
      width: F48Dot16.fromBits(run must(FontData<'b>.readAt<i64>(&bytes, at + 20))),
      height: F48Dot16.fromBits(run must(FontData<'b>.readAt<i64>(&bytes, at + 28))),
    }
    let actual = run some(run GlyphMetrics.extentsExact(&metrics, GlyphId.new(gid)))
    run Testing.expect(equalBox(actual, e), "model box matches independent Rust drawing")
    at = at + 36
    checked = checked + 1
  }
  run Testing.expect(
    checked > 0 && checked == GlyphMetrics.numGlyphs(&metrics),
    "every fixture glyph compared against drawn path",
  )
}

import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.pointer { Pointer }
import silk.num.u64

// Test counters live until all immutable provider snapshots have been dropped.
struct Counted<'a> {
  font: FontRef<'a>,
  reads: *mut u32,
  tags: *mut u64,
}

fn tagMask(tag: Tag) -> u64 {
  return match Tag.toU32(tag) {
    0x686d7478 => 1
    0x48564152 => 2
    0x56564152 => 4
    0x67766172 => 8
    0x676c7966 => 16
    0x6c6f6361 => 32
    0x4d564152 => 64
    _ => 0
  }
}

impl<'a> TableProvider<'a> for Counted<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    drop unsafe Atomic.fetchAdd<u32>(self.reads, 1, MemoryOrder.Relaxed)
    let previousTags = unsafe Atomic.load<u64>(self.tags, MemoryOrder.Relaxed)
    unsafe Atomic.store<u64>(self.tags, previousTags | tagMask(tag), MemoryOrder.Relaxed)
    return FontRef.tableData(&self.font, tag)
  }
}

fn countedMetrics<'a, 'c>(font: &Counted<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(font, coords)
}

// The upstream cache tests become eager-snapshot tests: constructing a view
// resolves tables, and querying or copying that view never recalls the source.
effect fn checkSnapshot(
  data: &[u8],
  coords: &[F2Dot14],
  vertical: bool,
  defaultLocation: bool,
) -> ()
  ! AssertionError<'static> {
  let mut reads: u32 = 0
  let mut tags: u64 = 0
  let counter = Pointer.fromMutRef(&mut reads)
  let seen = Pointer.fromMutRef(&mut tags)
  let provider = Counted { font: run must(FontRef.new(data)), reads: counter, tags: seen }
  let metrics = countedMetrics(&provider, coords)
  let copied = metrics
  let before = unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed)
  let requested = unsafe Atomic.load<u64>(seen, MemoryOrder.Relaxed)
  run Testing.expect((requested & 1) != 0, "horizontal metrics captured during construction")
  if defaultLocation {
    run Testing.expect((requested & 78) == 0, "default location reads no variation tables")
  } else {
    let mut required: u64 = 2
    if vertical {
      required = 4
    }
    run Testing.expect(
      (requested & required) != 0,
      "requested advance variation table captured eagerly",
    )
  }
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&metrics) {
    let gid = GlyphId.new(i)
    if vertical {
      run Testing.expect(
        &GlyphMetrics.vAdvanceExact(&metrics, gid) == &GlyphMetrics.vAdvanceExact(&copied, gid),
        "copied vertical metrics",
      )
    } else {
      run Testing.expect(
        &GlyphMetrics.hAdvanceExact(&metrics, gid) == &GlyphMetrics.hAdvanceExact(&copied, gid),
        "copied horizontal metrics",
      )
    }
    i = i + 1
  }
  run Testing.expect(
    unsafe Atomic.load<u32>(counter, MemoryOrder.Relaxed) == before,
    "queries and copies never recall provider",
  )
}

