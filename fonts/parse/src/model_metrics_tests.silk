test effect fn extendedGvarMetricsAndExtentsInTheCachedFontModel() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run extendedGvarMetricsAndExtentsInTheCachedFontModelBody()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn extendedGvarMetricsAndExtentsInTheCachedFontModelBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut bytes: [u8; 450000] = [0; 450000]
  let mut variations: [u8; 263000] = [0; 263000]
  let mut vhea: [u8; 38] = [0; 38]
  let mut vmtx: [u8; 131076] = [0; 131076]
  drop Builder.metricHeader(&mut vhea, 1, true, true)
  Builder.put16(&mut vmtx, 0, 1200)
  let mut variant: usize = 0
  while variant < 4 {
    let size = Builder.outlinesFont(&mut bytes, (variant & 1) != 0, true, true, 0)
    let font = run must(FontRef.new(Slice.view<u8>(&bytes, 0, size)))
    let varSize = Builder.gvar(&mut variations, 65537, true, (variant & 2) != 0, false)
    let replacements = [
      Builder.TestTable { tag: 0x47564152, data: Slice.view<u8>(&variations, 0, varSize) },
      Builder.TestTable { tag: 0x56484541, data: &vhea },
      Builder.TestTable { tag: 0x564d5458, data: &vmtx },
    ]
    let provider = run makeOverlay(Slice.view<u8>(&bytes, 0, size), &replacements)
    let locations: [f32; 3] = [0.0, 0.5, 1.0]
    let mut n: usize = 0
    while n < 3 {
      let coords = [F2Dot14.fromF32(locations[n])]
      let zero: [F2Dot14; 0] = []
      let mut active: &[F2Dot14] = &coords
      if n == 0 {
        active = &zero
      }
      let metrics = overlayMetrics(&provider, active)
      let gids: [u32; 2] = [65536, 1]
      let deltas: [f32; 2] = [100.0, 60.0]
      let shifts: [f32; 2] = [40.0, 60.0]
      let mut i: usize = 0
      while i < 2 {
        let gid = GlyphId.new(gids[i])
        let mut vertical: f32 = 0.0
        if i == 0 {
          vertical = 60.0
        }
        run Testing.expect(
          GlyphMetrics.hAdvance(&metrics, gid) == 1000.0 + deltas[i] * locations[n]
            && GlyphMetrics.vAdvance(&metrics, gid) == 1200.0 + vertical * locations[n],
          "extended gvar phantom advances",
        )
        let e = run some(run GlyphMetrics.extentsExact(&metrics, gid))
        run Testing.expect(
          F48Dot16.toF32(e.xBearing) == shifts[i] * locations[n]
            && &e.width == &F48Dot16.fromI32(80)
            && &e.height == &F48Dot16.fromI32(80),
          "extended gvar outline shift",
        )
        i = i + 1
      }
      n = n + 1
    }
    variant = variant + 1
  }
}

test effect fn glyfInkStartsAtTheStatedLeftSideBearing() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run glyfInkStartsAtTheStatedLeftSideBearingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn glyfInkStartsAtTheStatedLeftSideBearingBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let hmtx = run must(FontRef.hmtx(&font))
  let raw = run some(FontRef.tableData(&font, Tag.fromU32(0x686d7478)))
  let mut changed = List<u8>.make()
  run List<u8>.appendBytes(&mut changed, FontData.asBytes(&raw))
  let mut i: u32 = 0
  let mut checked = false
  while i < u16.toU32(Hhea.numberOfHMetrics(&run must(FontRef.hhea(&font)))) {
    if let Option<LocaGlyph>.Some { value: entry } = Loca.get(&loca, GlyphId.new(i), &glyf) {
      if let LocaGlyph.Glyph { value: outline } = entry {
        if Glyph.numberOfContours(&outline) > 0 {
          let bearing = i16.toI32(Glyph.xMin(&outline)) + 17
          let mut rawBearing = bearing
          if rawBearing < 0 {
            rawBearing = rawBearing + 65536
          }
          Builder.put16(
            List<u8>.asMutSlice(&mut changed),
            u32.toUsize(i) * 4 + 2,
            i32.toU16(rawBearing),
          )
          let replacements = [
            Builder.TestTable { tag: 0x686d7478, data: List<u8>.asSlice(&changed) },
          ]
          let mut fontBytes = List<u8>.make()
          run List<u8>.appendBytes(&mut fontBytes, tinos())
          let provider = run makeOverlay(List<u8>.asSlice(&fontBytes), &replacements)
          let metrics = overlayMetrics(&provider, &[])
          let loadedMetrics = overlayMetrics(&provider, &[F2Dot14.fromBits(1)])
          let header = run some(run GlyphMetrics.extentsExact(&metrics, GlyphId.new(i)))
          let loaded = run some(run GlyphMetrics.extentsExact(&loadedMetrics, GlyphId.new(i)))
          run Testing.expect(
            F48Dot16.toI32(header.xBearing) == bearing && equalBox(header, loaded),
            "header and loaded outline use changed side bearing",
          )
          checked = true
          break
        }
      }
    }
    i = i + 1
  }
  run Testing.expect(checked, "drawn glyph bearing checked")
  drop hmtx
}

test effect fn glyfBearingUsesHmtxTailThenFallsBackToZero() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run glyfBearingUsesHmtxTailThenFallsBackToZeroBody()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn glyfBearingUsesHmtxTailThenFallsBackToZeroBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(materialSymbols()))
  let glyf = run must(FontRef.glyf(&font))
  let loca = run must(FontRef.loca(&font, Option<bool>.None))
  let hmtx = run must(FontRef.hmtx(&font))
  let metrics = metricView(&font, &[])
  let longCount = u16.toU32(Hhea.numberOfHMetrics(&run must(FontRef.hhea(&font))))
  let mut i = longCount
  let mut checked = false
  while i < GlyphMetrics.numGlyphs(&metrics) {
    if let Option<LocaGlyph>.Some { value: entry } = Loca.get(&loca, GlyphId.new(i), &glyf) {
      if let LocaGlyph.Glyph { value: outline } = entry {
        let glyph = GlyphId.new(i)
        let original = run some(run GlyphMetrics.extentsExact(&metrics, glyph))
        run Testing.expect(
          &original.xBearing
            == &F48Dot16.fromI32(i16.toI32(run some(Hmtx.sideBearing(&hmtx, glyph)))),
          "tail bearing read",
        )
        let raw = run some(FontRef.tableData(&font, Tag.fromU32(0x686d7478)))
        let replacements = [
          Builder.TestTable {
            tag: 0x686d7478,
            data: Slice.view<u8>(FontData.asBytes(&raw), 0, u32.toUsize(longCount) * 4),
          },
        ]
        let provider = run makeOverlay(materialSymbols(), &replacements)
        let shortened = overlayMetrics(&provider, &[])
        let loaded = overlayMetrics(&provider, &[F2Dot14.fromBits(1)])
        run Testing.expect(
          F48Dot16.toBits((run some(run GlyphMetrics.extentsExact(&shortened, glyph))).xBearing)
            == 0
            && F48Dot16.toBits((run some(run GlyphMetrics.extentsExact(&loaded, glyph))).xBearing)
              == 0,
          "missing tail bearing defaults zero in both paths",
        )
        checked = true
        break
      }
    }
    i = i + 1
  }
  run Testing.expect(checked, "tail outline checked")
}

