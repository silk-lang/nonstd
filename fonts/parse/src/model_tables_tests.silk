import tables.cmap { Cmap }
import tables.hmtx { Hmtx }
import tables.name { Name }
import tables.glyf { Glyf }
import tables.loca { Loca }
import tables.cff { Cff }
import tables.cbdt { Cbdt }
import tables.dsig { Dsig }
