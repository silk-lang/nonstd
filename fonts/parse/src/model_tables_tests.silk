import silk.num.usize

effect fn must<T>(result: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move result {
    Result<T, ReadError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "model table parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(input: Option<T>) -> T
  ! AssertionError<'static> {
  return match move input {
    Option<T>.Some { value } => move value
    _ => {
      run Testing.expect(false, "model font exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn bytes(a: &[u8], b: &[u8]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(a.length == b.length, "table byte count")
  let mut i: usize = 0
  while i < a.length {
    run Testing.expect(a[i] == b[i], "table byte")
    i = i + 1
  }
}

effect fn optionalBytes<'a, 'b>(a: Option<&'a [u8]>, b: Option<FontData<'b>>) -> ()
  ! AssertionError<'static> {
  match move a {
    Option<&'a [u8]>.Some { value } => {
      let other = run some(move b)
      run bytes(value, FontData.asBytes(&other))
    }
    _ => {
      run Testing.expect(
        match move b {
          Option<FontData<'b>>.None => true
          _ => false
        },
        "missing table agrees",
      )
    }
  }
}

struct FontCallback<'a> {
  font: FontRef<'a>,
}

impl<'a> TableCallback for FontCallback<'a> {
  effect fn table(self: &Self, tag: Tag) -> Option<Blob>
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Option<FontData<'a>>.Some { value } = FontRef.tableData(&self.font, tag) {
      return Option<Blob>.some(run Blob.fromBytes(FontData.asBytes(&value)))
    }
    return Option<Blob>.None
  }
}

test effect fn unsortedDirectoryFindsTables() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unsortedDirectoryBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unsortedDirectoryBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let original = tinos()
  let count = u8.toUsize(original[4]) * 256 + u8.toUsize(original[5])
  let mut changed = List<u8>.make()
  run List<u8>.appendBytes(&mut changed, Slice.view(original, 0, 12))
  let mut at = count
  while at > 0 {
    at = at - 1
    run List<u8>.appendBytes(&mut changed, Slice.view(original, 12 + at * 16, 16))
  }
  let end = 12 + count * 16
  run List<u8>.appendBytes(&mut changed, Slice.view(original, end, original.length - end))
  let font = run must(FontRef.new(List<u8>.asSlice(&changed)))
  let tables = run some(run Tables.new(run Blob.fromBytes(List<u8>.asSlice(&changed)), 0))
  let actual = run must(Tables.head(&tables))
  let expected = run must(FontRef.head(&font))
  run bytes(
    FontData.asBytes(&Head.offsetData(&actual)),
    FontData.asBytes(&Head.offsetData(&expected)),
  )
  drop run must(Tables.cmap(&tables))
  drop run must(Tables.hmtx(&tables))
  drop run must(Tables.name(&tables))
  drop run must(Tables.glyf(&tables))
  drop run must(Tables.loca(&tables, Option<bool>.None))
}

test effect fn missingKnownTablesAreMissing() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run missingTablesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn missingTablesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let tables = run some(run Tables.new(Blob.fromStatic(ahem()), 0))
  run Testing.expect(
    match move Tables.cff(&tables) {
      Result<Cff, ReadError>.Failure { error: ReadError.TableIsMissing { tag } } => true
      _ => false
    },
    "missing CFF",
  )
  run Testing.expect(
    match move Tables.cbdt(&tables) {
      Result<Cbdt, ReadError>.Failure { error: ReadError.TableIsMissing { tag } } => true
      _ => false
    },
    "missing CBDT",
  )
  run Testing.expect(
    match move Tables.dsig(&tables) {
      Result<Dsig, ReadError>.Failure { error: ReadError.TableIsMissing { tag } } => true
      _ => false
    },
    "missing DSIG",
  )
  run Testing.expect(
    match move Tables.expectRawData(&tables, Tag.new(&[67, 66, 68, 84])) {
      Result<FontData, ReadError>.Failure { error: ReadError.TableIsMissing { tag } } => true
      _ => false
    },
    "missing CBDT bytes",
  )
  run Testing.expect(
    match move Tables.expectRawData(&tables, Tag.new(&[68, 83, 73, 71])) {
      Result<FontData, ReadError>.Failure { error: ReadError.TableIsMissing { tag } } => true
      _ => false
    },
    "missing DSIG bytes",
  )
}

test effect fn tableFunctionMatchesFontRef() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run tableFunctionBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn tableFunctionBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(ahem()))
  let callback = FontCallback { font: font }
  let tables = Tables.fromTableFunction(run TableFunction.new(&callback))
  run optionalBytes(
    Tables.gaspData(&tables),
    FontRef.tableData(&font, Tag.new(&[103, 97, 115, 112])),
  )
  run optionalBytes(
    Tables.glyfData(&tables),
    FontRef.tableData(&font, Tag.new(&[103, 108, 121, 102])),
  )
  run optionalBytes(
    Tables.hmtxData(&tables),
    FontRef.tableData(&font, Tag.new(&[104, 109, 116, 120])),
  )
}

struct BadHeader {}

impl TableCallback for BadHeader {
  effect fn table(self: &Self, tag: Tag) -> Option<Blob>
    ! OutOfMemoryError
    ? &mut Allocator {
    if &tag == &Tag.new(&[104, 101, 97, 100]) {
      return Option<Blob>.some(Blob.fromStatic(b"\x00"))
    }
    return Option<Blob>.None
  }
}

test effect fn modelValidationAndRawAccessStayDistinct() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run validationBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn validationBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let callback = BadHeader {}
  let tables = Tables.fromTableFunction(run TableFunction.new(&callback))
  run Testing.expect(
    match move Tables.head(&tables) {
      Result<Head, ReadError>.Failure { error: ReadError.ValidationError } => true
      _ => false
    },
    "malformed table maps to validation error",
  )
  run Testing.expect(
    match move Tables.head(&tables) {
      Result<Head, ReadError>.Failure { error: ReadError.ValidationError } => true
      _ => false
    },
    "repeated validation is stable",
  )
  let data = run some(Tables.headData(&tables))
  run bytes(data, b"\x00")
  let view = Tables.view(&tables)
  run Testing.expect(
    match move TableProvider.dataForTag(&view, Tag.new(&[104, 101, 97, 100])) {
      Option<FontData>.None => true
      _ => false
    },
    "model provider intentionally has no generic raw lookup",
  )
  run Testing.expect(
    match move TableProvider.head(&view) {
      Result<Head, ReadError>.Failure { error: ReadError.ValidationError } => true
      _ => false
    },
    "typed provider retains validation",
  )
}
