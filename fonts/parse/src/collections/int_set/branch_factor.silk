import silk.num.u32
import silk.num.u8

pub enum BranchFactor {
  Two,
  Four,
  Eight,
  ThirtyTwo,
}

impl BranchFactor {
  pub fn arity(self: &Self) -> u32 {
    return match &self.* {
      BranchFactor.Two => 2
      BranchFactor.Four => 4
      BranchFactor.Eight => 8
      BranchFactor.ThirtyTwo => 32
    }
  }

  pub fn maxHeight(self: &Self) -> u8 {
    return match &self.* {
      BranchFactor.Two => 31
      BranchFactor.Four => 16
      BranchFactor.Eight => 11
      BranchFactor.ThirtyTwo => 7
    }
  }

  pub fn nodeSizeLog2(self: &Self) -> u32 {
    return match &self.* {
      BranchFactor.Two => 1
      BranchFactor.Four => 2
      BranchFactor.Eight => 3
      BranchFactor.ThirtyTwo => 5
    }
  }

  pub fn byteMask(self: &Self) -> u32 {
    return match &self.* {
      BranchFactor.Two => 3
      BranchFactor.Four => 15
      _ => 255
    }
  }

  pub fn u32Mask(self: &Self) -> u32 {
    if self.* == BranchFactor.ThirtyTwo {
      return u32.MAX
    }
    return u32.shiftLeft(1, BranchFactor.arity(self)) - 1
  }

  pub fn nodesPerByte(self: &Self) -> u32 {
    return match &self.* {
      BranchFactor.Two => 4
      BranchFactor.Four => 2
      _ => 1
    }
  }

  pub fn bytesPerNode(self: &Self) -> u32 {
    if self.* == BranchFactor.ThirtyTwo {
      return 4
    }
    return 1
  }

  pub fn bitId(self: &Self) -> u8 {
    return match &self.* {
      BranchFactor.Two => 0
      BranchFactor.Four => 1
      BranchFactor.Eight => 2
      BranchFactor.ThirtyTwo => 3
    }
  }

  pub fn treeHeightFor(self: &Self, maximum: u32) -> u8 {
    let mut value = maximum
    let mut height: u8 = 0
    while true {
      height = height + 1
      value = u32.shiftRight(value, BranchFactor.nodeSizeLog2(self))
      if value == 0 {
        return height
      }
    }
    return height
  }
}
