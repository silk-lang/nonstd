effect fn collect<'a, T: Domain + Copy>(input: IntSetIter<'a, T>) -> IntSet<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = IntSet<T>.empty()
  let mut it = move input
  while let Option<T>.Some { value } = IntSetIter<T>.next(&mut it) {
    drop run IntSet<T>.insert(&mut result, value)
  }
  return move result
}

