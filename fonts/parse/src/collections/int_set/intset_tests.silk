test effect fn iterBackwards() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run iterBackwardsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn iterBackwardsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run IntSet<u32>.insertRange(&mut set, 1, 6)
  run mixed0(&set)
  let mut small = IntSet<u8>.all()
  run IntSet<u8>.removeRange(&mut small, 10, 255)
  drop run IntSet<u8>.remove(&mut small, 4)
  drop run IntSet<u8>.remove(&mut small, 8)
  run mixed1(&small)
  run mixed2(&small)
}

