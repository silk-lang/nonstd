struct SetOpInput {
  hasX: bool,
  inverted: bool,
  hasPage: bool,
}

effect fn operationInput(input: &SetOpInput) -> IntSet<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  if input.inverted {
    IntSet<u32>.invert(&mut set)
  }
  if input.hasPage {
    if input.inverted {
      drop run IntSet<u32>.remove(&mut set, 13)
    } else {
      drop run IntSet<u32>.insert(&mut set, 13)
    }
  }
  if input.hasX {
    drop run IntSet<u32>.insert(&mut set, 13)
  } else {
    drop run IntSet<u32>.remove(&mut set, 13)
  }
  return move set
}

test effect fn setOperations() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run setOperationsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn setOperationsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let inputs = [
    SetOpInput { hasX: true, inverted: true, hasPage: false },
    SetOpInput { hasX: true, inverted: true, hasPage: true },
    SetOpInput { hasX: true, inverted: false, hasPage: false },
    SetOpInput { hasX: false, inverted: true, hasPage: false },
    SetOpInput { hasX: false, inverted: false, hasPage: false },
    SetOpInput { hasX: false, inverted: false, hasPage: true },
  ]
  let mut i: usize = 0
  while i < inputs.length {
    let mut j: usize = 0
    while j < inputs.length {
      if true {
        let mut a = run operationInput(&inputs[i])
        let b = run operationInput(&inputs[j])
        run IntSet<u32>.unionValue(&mut a, &b)
        run Testing.expect(
          IntSet<u32>.contains(&a, 13) == (inputs[i].hasX || inputs[j].hasX),
          "upstream IntSet expectation",
        )
      }
      if true {
        let mut a = run operationInput(&inputs[i])
        let b = run operationInput(&inputs[j])
        run IntSet<u32>.intersect(&mut a, &b)
        run Testing.expect(
          IntSet<u32>.contains(&a, 13) == (inputs[i].hasX && inputs[j].hasX),
          "upstream IntSet expectation",
        )
      }
      if true {
        let mut a = run operationInput(&inputs[i])
        let b = run operationInput(&inputs[j])
        run IntSet<u32>.subtract(&mut a, &b)
        run Testing.expect(
          IntSet<u32>.contains(&a, 13) == (inputs[i].hasX && !inputs[j].hasX),
          "upstream IntSet expectation",
        )
      }
      j = j + 1
    }
    i = i + 1
  }
}

test effect fn inverted() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run invertedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn invertedBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run make<u32>(&[13, 800])
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(13)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(800)), "upstream IntSet expectation")
  run Testing.expect(
    IntSet<u32>.len(&set) == 2 && !IntSet<u32>.isInverted(&set),
    "upstream IntSet expectation",
  )
  IntSet<u32>.invert(&mut set)
  run Testing.expect(
    IntSet<u32>.len(&set) == 4294967294 && IntSet<u32>.isInverted(&set),
    "upstream IntSet expectation",
  )
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(13)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(80)), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(800)), "upstream IntSet expectation")
  drop run IntSet<u32>.remove(&mut set, 80)
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(80)), "upstream IntSet expectation")
  drop run IntSet<u32>.insert(&mut set, 13)
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(13)), "upstream IntSet expectation")
  IntSet<u32>.invert(&mut set)
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(80)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(800)), "upstream IntSet expectation")
}

test effect fn limitedDomainType() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run limitedDomainTypeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn limitedDomainTypeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run make<EvenInts>(&[2, 8, 12])
  run IntSet<EvenInts>.insertRange(&mut set, value<EvenInts>(20), value<EvenInts>(34))
  run IntSet<EvenInts>.removeRange(&mut set, value<EvenInts>(30), value<EvenInts>(34))
  run Testing.expect(
    IntSet<EvenInts>.contains(&set, value<EvenInts>(2)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(4)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(18)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(19)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<EvenInts>.contains(&set, value<EvenInts>(20)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(21)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<EvenInts>.contains(&set, value<EvenInts>(28)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(29)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(30)),
    "upstream IntSet expectation",
  )
  let copy = run collect<EvenInts>(IntSet<EvenInts>.iter(&set))
  run Testing.expect(IntSet<EvenInts>.equals(&set, &copy), "upstream IntSet expectation")
  IntSet<EvenInts>.invert(&mut set)
  run Testing.expect(
    !IntSet<EvenInts>.contains(&set, value<EvenInts>(2)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<EvenInts>.contains(&set, value<EvenInts>(4)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<EvenInts>(IntSet<EvenInts>.last(&set), 65534),
    "upstream IntSet expectation",
  )
  run sequence<EvenInts>(IntSet<EvenInts>.iter(&set), &[0, 4, 6, 10, 14], false, false)
  run IntSet<EvenInts>.insertRange(&mut set, value<EvenInts>(6), value<EvenInts>(10))
  run sequence<EvenInts>(IntSet<EvenInts>.iter(&set), &[0, 4, 6, 8, 10, 14], false, false)
  run IntSet<EvenInts>.removeRange(&mut set, value<EvenInts>(6), value<EvenInts>(10))
  run sequence<EvenInts>(IntSet<EvenInts>.iter(&set), &[0, 4, 14], false, false)
}

