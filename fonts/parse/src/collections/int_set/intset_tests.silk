    ),
    &[2, 4, 8, 12, 14],
    false,
    false,
  )
  run sequence<EvenInts>(
    IntSet<EvenInts>.iterAfter(&set, value<EvenInts>(4)),
    &[8, 12, 14, 16, 18],
    false,
