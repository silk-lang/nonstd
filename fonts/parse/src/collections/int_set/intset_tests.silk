test effect fn extendOnInverted() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run extendOnInvertedBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn extendOnInvertedBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.all()
  run IntSet<u32>.removeRange(&mut set, 10, 20)
  run IntSet<u32>.extend(&mut set, &[12, 17, 18])
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(11)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(12)), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(13)), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(16)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(17)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(18)), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&set, value<u32>(19)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&set, value<u32>(100)), "upstream IntSet expectation")
}

