effect fn nextAfterExclusiveRespectsDomainMaxBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut wide = IntSet<u16>.all()
  run IntSet<u16>.removeRange(&mut wide, 64935, 65535)
  run Testing.expect(
    optional<u16>(IntSet<u16>.nextAfter(&wide, 64933), 64934)
      && optional<u16>(IntSet<u16>.nextAfter(&wide, 64934), -1),
    "upstream IntSet expectation",
  )
  let mut set = IntSet<u8>.all()
  run Testing.expect(
    optional<u8>(IntSet<u8>.nextAfter(&set, value<u8>(254)), 255),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u8>(IntSet<u8>.nextAfter(&set, value<u8>(255)), -1),
    "upstream IntSet expectation",
  )
  drop run IntSet<u8>.remove(&mut set, 255)
  run Testing.expect(
    optional<u8>(IntSet<u8>.nextAfter(&set, value<u8>(254)), -1),
    "upstream IntSet expectation",
  )
  run nextMatches<u8>(&set, 255)
}

