effect fn iterRangeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(0)), &[], false, true)
  run IntSet<u32>.extend(&mut set, &[5, 7, 10, 1250, 1300, 3001])
  run sequence<u32>(
    IntSet<u32>.iterAfter(&set, value<u32>(0)),
    &[5, 7, 10, 1250, 1300, 3001],
    false,
    true,
  )
  run sequence<u32>(
    IntSet<u32>.range(&set, Bound<u32>.Included { value: value<u32>(0) }, Bound<u32>.Unbounded),
    &[5, 7, 10, 1250, 1300, 3001],
    false,
    true,
  )
  run sequence<u32>(
    IntSet<u32>.iterAfter(&set, value<u32>(5)),
    &[7, 10, 1250, 1300, 3001],
    false,
    true,
  )
  run sequence<u32>(
    IntSet<u32>.range(&set, Bound<u32>.Included { value: value<u32>(5) }, Bound<u32>.Unbounded),
    &[5, 7, 10, 1250, 1300, 3001],
    false,
    true,
  )
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(700)), &[1250, 1300, 3001], false, true)
  run sequence<u32>(
    IntSet<u32>.range(&set, Bound<u32>.Included { value: value<u32>(700) }, Bound<u32>.Unbounded),
    &[1250, 1300, 3001],
    false,
    true,
  )
}

