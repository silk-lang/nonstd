  ? &mut Allocator {
  let mut set = run make<EvenInts>(&[6, 10])
  run Testing.expect(
    optional<EvenInts>(IntSet<EvenInts>.nextAfter(&set, value<EvenInts>(2)), 6),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<EvenInts>(IntSet<EvenInts>.nextAfter(&set, value<EvenInts>(6)), 10),
