effect fn intersectsRangeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(0)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(100)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(4294967295)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(4294967295), value<u32>(4294967295)),
    "upstream IntSet expectation",
  )
  drop run IntSet<u32>.insert(&mut set, value<u32>(1234))
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(1233)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(1235), value<u32>(1240)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1234), value<u32>(1234)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1230), value<u32>(1240)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(1234)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1234), value<u32>(4294967295)),
    "upstream IntSet expectation",
  )
  drop run IntSet<u32>.insert(&mut set, value<u32>(0))
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(0)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(1), value<u32>(1)),
    "upstream IntSet expectation",
  )
}

