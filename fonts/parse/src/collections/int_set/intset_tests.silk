effect fn exclusiveIterBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.all()
  run IntSet<u32>.removeAll(&mut set, &[3, 7, 8])
  run sequence<u32>(IntSet<u32>.iter(&set), &[0, 1, 2, 4, 5, 6, 9, 10], false, false)
  run Testing.expect(
    match move IntSet<u32>.inclusiveIter(&set) {
      Option<IntSetIter<u32>>.None => true
      _ => false
    },
    "upstream IntSet expectation",
  )
  run IntSet<u32>.removeRange(&mut set, 0, 200)
  run sequence<u32>(IntSet<u32>.iter(&set), &[201], false, false)
  let mut small = IntSet<u8>.all()
  run IntSet<u8>.removeRange(&mut small, 200, 255)
  run sequence<u8>(IntSet<u8>.iter(&small), &[199], true, false)
}

test effect fn iterRangesInclusive() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run iterRangesInclusiveBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn iterRangesInclusiveBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run ranges<u32>(&set, false, &[])
  run IntSet<u32>.insertRange(&mut set, 200, 700)
  drop run IntSet<u32>.insert(&mut set, 5)
  run ranges<u32>(
    &set,
    false,
    &[U32Range { first: 5, last: 5 }, U32Range { first: 200, last: 700 }],
  )
  IntSet<u32>.clear(&mut set)
  run IntSet<u32>.insertRange(&mut set, 0, 0)
  run IntSet<u32>.insertRange(&mut set, u32.MAX, u32.MAX)
  run ranges<u32>(
    &set,
    false,
    &[U32Range { first: 0, last: 0 }, U32Range { first: 4294967295, last: 4294967295 }],
  )
  IntSet<u32>.clear(&mut set)
  run IntSet<u32>.insertRange(&mut set, 0, 5)
  run IntSet<u32>.insertRange(&mut set, u32.MAX - 5, u32.MAX)
  run ranges<u32>(
    &set,
    false,
    &[U32Range { first: 0, last: 5 }, U32Range { first: 4294967290, last: 4294967295 }],
  )
  let mut inverted = run IntSet<u32>.clone(&set)
  IntSet<u32>.invert(&mut inverted)
  run ranges<u32>(
    &inverted,
    true,
    &[U32Range { first: 0, last: 5 }, U32Range { first: 4294967290, last: 4294967295 }],
  )
}

