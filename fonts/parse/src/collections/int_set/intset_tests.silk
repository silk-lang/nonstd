    false,
    true,
  )
  drop run IntSet<EvenInts>.remove(&mut set, value<EvenInts>(65534))
  run sequence<EvenInts>(
    IntSet<EvenInts>.iterAfter(&set, value<EvenInts>(65530)),
    &[65532],
    false,
    true,
