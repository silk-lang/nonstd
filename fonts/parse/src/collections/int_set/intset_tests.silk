effect fn iterRangesExclusiveBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.all()
  run IntSet<u32>.removeRange(&mut set, 200, 700)
  drop run IntSet<u32>.remove(&mut set, 5)
  run ranges<u32>(
    &set,
    false,
    &[
      U32Range { first: 0, last: 4 },
      U32Range { first: 6, last: 199 },
      U32Range { first: 701, last: 4294967295 },
    ],
  )
  run IntSet<u32>.removeRange(&mut set, 0, 700)
  run ranges<u32>(&set, false, &[U32Range { first: 701, last: 4294967295 }])
  let mut inverted = run IntSet<u32>.clone(&set)
  IntSet<u32>.invert(&mut inverted)
  run ranges<u32>(&inverted, true, &[U32Range { first: 701, last: 4294967295 }])
  let mut top = IntSet<u32>.all()
  run IntSet<u32>.removeRange(&mut top, u32.MAX - 10, u32.MAX)
  run ranges<u32>(&top, false, &[U32Range { first: 0, last: 4294967284 }])
  let mut s0 = IntSet<u16>.all()
  run IntSet<u16>.removeRange(&mut s0, 0, 65535)
  run ranges<u16>(&s0, false, &[])
  let mut s1 = IntSet<u16>.all()
  run IntSet<u16>.removeRange(&mut s1, 0, 65534)
  run ranges<u16>(&s1, false, &[U32Range { first: 65535, last: 65535 }])
  let mut s2 = IntSet<u16>.all()
  run IntSet<u16>.removeRange(&mut s2, 1, 65535)
  run ranges<u16>(&s2, false, &[U32Range { first: 0, last: 0 }])
  let all = IntSet<u32>.all()
  run ranges<u32>(&all, false, &[U32Range { first: 0, last: 4294967295 }])
}

