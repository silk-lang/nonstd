effect fn intersectionPair(a: &IntSet<u32>, b: &IntSet<u32>, expected: bool) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    IntSet<u32>.intersectsSet(a, b) == expected && IntSet<u32>.intersectsSet(b, a) == expected,
    "symmetric intersection",
  )
}

test effect fn intersectsSet() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run intersectsSetBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn intersectsSetBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = IntSet<u32>.empty()
  let a = run make<u32>(&[1, 5, 6, 7, 8, 12])
  let b = run make<u32>(&[2, 13])
  let c = run make<u32>(&[8, 14])
  let mut d = IntSet<u32>.all()
  run IntSet<u32>.removeRange(&mut d, 0, 13)
  let mut e = IntSet<u32>.all()
  run IntSet<u32>.removeRange(&mut e, 0, 100)
  run intersectionPair(&empty, &empty, false)
  run intersectionPair(&a, &b, false)
  run intersectionPair(&a, &c, true)
  run intersectionPair(&a, &d, false)
  run intersectionPair(&b, &c, false)
  run intersectionPair(&b, &d, false)
  run intersectionPair(&b, &e, false)
  run intersectionPair(&c, &d, true)
  run intersectionPair(&c, &e, false)
  run intersectionPair(&d, &e, true)
  run intersectionPair(&a, &empty, false)
  run intersectionPair(&b, &empty, false)
  run intersectionPair(&c, &empty, false)
  run intersectionPair(&d, &empty, false)
  run intersectionPair(&e, &empty, false)
}

test effect fn isSubset() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isSubsetBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn isSubsetBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = IntSet<u32>.empty()
  let a = run make<u32>(&[1, 5, 6, 7, 8, 12])
  let b = run make<u32>(&[1, 5, 6, 7, 8, 12, 15])
  let c = run make<u32>(&[1, 5, 6, 7, 8, 13])
  run Testing.expect(IntSet<u32>.isSubset(&empty, &empty), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.isSubset(&empty, &a), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.isSubset(&a, &empty), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.isSubset(&a, &a), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.isSubset(&a, &b), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.isSubset(&b, &a), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.isSubset(&a, &c), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.isSubset(&c, &a), "upstream IntSet expectation")
  let mut allBut13 = IntSet<u32>.all()
  drop run IntSet<u32>.remove(&mut allBut13, 13)
  let mut allBut5 = IntSet<u32>.all()
  drop run IntSet<u32>.remove(&mut allBut5, 5)
  run Testing.expect(IntSet<u32>.isSubset(&a, &allBut13), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.isSubset(&a, &allBut5), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.isSubset(&empty, &allBut13), "upstream IntSet expectation")
  let mut allBut1 = IntSet<u8>.all()
  drop run IntSet<u8>.remove(&mut allBut1, 1)
  let mut allBut12 = IntSet<u8>.all()
  run IntSet<u8>.removeAll(&mut allBut12, &[1, 2])
  let mut inclAll = IntSet<u8>.empty()
  run IntSet<u8>.insertRange(&mut inclAll, 0, 255)
  let mut inclAllBut1 = run IntSet<u8>.clone(&inclAll)
  drop run IntSet<u8>.remove(&mut inclAllBut1, 1)
  let mut inclAllBut3 = run IntSet<u8>.clone(&inclAll)
  drop run IntSet<u8>.remove(&mut inclAllBut3, 3)
  let small = run make<u8>(&[0, 2, 3])
  let mut allBut23 = IntSet<u8>.all()
  run IntSet<u8>.removeAll(&mut allBut23, &[2, 3])
  run Testing.expect(IntSet<u8>.isSubset(&allBut1, &inclAll), "upstream IntSet expectation")
  run Testing.expect(IntSet<u8>.isSubset(&allBut1, &inclAllBut1), "upstream IntSet expectation")
  run Testing.expect(IntSet<u8>.isSubset(&allBut12, &inclAllBut1), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u8>.isSubset(&allBut1, &small), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u8>.isSubset(&allBut12, &inclAllBut3), "upstream IntSet expectation")
  run Testing.expect(IntSet<u8>.isSubset(&allBut12, &allBut1), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u8>.isSubset(&allBut1, &allBut12), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u8>.isSubset(&allBut12, &allBut23), "upstream IntSet expectation")
  let all = IntSet<u32>.all()
  run Testing.expect(IntSet<u32>.isSubset(&all, &all), "upstream IntSet expectation")
  let evenEmpty = IntSet<EvenInts>.empty()
  let evenA = run make<EvenInts>(&[2, 4])
  let evenB = run make<EvenInts>(&[2, 4, 6])
  let evenC = run make<EvenInts>(&[2, 6])
  run Testing.expect(IntSet<EvenInts>.isSubset(&evenEmpty, &evenA), "upstream IntSet expectation")
  run Testing.expect(IntSet<EvenInts>.isSubset(&evenA, &evenB), "upstream IntSet expectation")
  run Testing.expect(!IntSet<EvenInts>.isSubset(&evenB, &evenA), "upstream IntSet expectation")
  run Testing.expect(!IntSet<EvenInts>.isSubset(&evenC, &evenA), "upstream IntSet expectation")
}

test effect fn length() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lengthBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lengthBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run Testing.expect(IntSet<u32>.len(&set) == 0, "upstream IntSet expectation")
  run IntSet<u32>.extend(&mut set, &[5, 5, 100])
  run Testing.expect(IntSet<u32>.len(&set) == 2, "upstream IntSet expectation")
  IntSet<u32>.invert(&mut set)
  run Testing.expect(IntSet<u32>.len(&set) == 4294967294, "upstream IntSet expectation")
  let all = IntSet<u32>.all()
  run Testing.expect(IntSet<u32>.len(&all) == 4294967296, "upstream IntSet expectation")
  let mut parts = IntSet<TwoParts>.all()
  run Testing.expect(IntSet<TwoParts>.len(&parts) == 13, "upstream IntSet expectation")
  drop run IntSet<TwoParts>.remove(&mut parts, value<TwoParts>(5))
  run Testing.expect(IntSet<TwoParts>.len(&parts) == 12, "upstream IntSet expectation")
  let mut values = orderedValues<TwoParts>()
  while let Option<u32>.Some { value: raw } = DomainValues<TwoParts>.next(&mut values) {
    drop run IntSet<TwoParts>.remove(&mut parts, value<TwoParts>(raw))
  }
  run Testing.expect(IntSet<TwoParts>.len(&parts) == 0, "upstream IntSet expectation")
}

test effect fn ordering() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run orderingBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn orderingBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  if true {
    let a = run make<u16>(&[])
    let b = run make<u16>(&[])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Equal, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[])
    let b = run make<u16>(&[0])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[0])
    let b = run make<u16>(&[0])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Equal, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[0, 1, 2])
    let b = run make<u16>(&[1, 2, 3])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[0, 1, 4])
    let b = run make<u16>(&[1, 2, 3])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[1, 2, 3])
    let b = run make<u16>(&[0, 2, 4])
    run Testing.expect(
      IntSet<u16>.compare(&a, &b) == Ordering.Greater,
      "upstream IntSet expectation",
    )
  }
  if true {
    let a = run make<u16>(&[5, 4, 0])
    let b = run make<u16>(&[1, 2, 3])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[1, 2, 3])
    let b = run make<u16>(&[1, 2, 3, 4])
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  if true {
    let a = run make<u16>(&[2, 3, 4])
    let b = run make<u16>(&[1, 2, 3, 4, 5])
    run Testing.expect(
      IntSet<u16>.compare(&a, &b) == Ordering.Greater,
      "upstream IntSet expectation",
    )
  }
  let all = IntSet<u16>.all()
  let mut allBut0 = run IntSet<u16>.clone(&all)
  drop run IntSet<u16>.remove(&mut allBut0, 0)
  let mut allBut5 = run IntSet<u16>.clone(&all)
  drop run IntSet<u16>.remove(&mut allBut5, 5)
  run Testing.expect(
    IntSet<u16>.compare(&all, &all) == Ordering.Equal,
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u16>.compare(&all, &allBut0) == Ordering.Less,
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u16>.compare(&allBut0, &all) == Ordering.Greater,
    "upstream IntSet expectation",
  )
  if true {
    let mut a = IntSet<u16>.all()
    run IntSet<u16>.removeRange(&mut a, 0, 5)
    run IntSet<u16>.removeRange(&mut a, 221, 1693)
    let mut b = IntSet<u16>.all()
    run IntSet<u16>.removeRange(&mut b, 0, 1693)
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
  let mut incAllBut0 = IntSet<u16>.empty()
  run IntSet<u16>.insertRange(&mut incAllBut0, 1, 65535)
  let mut incAllBut5 = IntSet<u16>.empty()
  run IntSet<u16>.insertRange(&mut incAllBut5, 0, 4)
  run IntSet<u16>.insertRange(&mut incAllBut5, 6, 65535)
  run Testing.expect(
    IntSet<u16>.compare(&all, &all) == Ordering.Equal,
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u16>.compare(&all, &incAllBut0) == Ordering.Less,
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u16>.compare(&incAllBut0, &all) == Ordering.Greater,
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u16>.compare(&incAllBut5, &allBut0) == Ordering.Less,
    "upstream IntSet expectation",
  )
  if true {
    let mut a = IntSet<u16>.all()
    run IntSet<u16>.removeRange(&mut a, 8, 1160)
    let mut b = IntSet<u16>.empty()
    run IntSet<u16>.insertRange(&mut b, 0, 259)
    run Testing.expect(
      IntSet<u16>.compare(&a, &b) == Ordering.Greater,
      "upstream IntSet expectation",
    )
  }
  if true {
    let mut a = IntSet<u16>.all()
    run IntSet<u16>.removeRange(&mut a, 8, 65535)
    let mut b = IntSet<u16>.empty()
    run IntSet<u16>.insertRange(&mut b, 0, 259)
    run Testing.expect(IntSet<u16>.compare(&a, &b) == Ordering.Less, "upstream IntSet expectation")
  }
}

import collections.int_set { DecodingError }
import silk.core.result { Result }

test effect fn fromSparseSet() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fromSparseSetBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fromSparseSetBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let set = match move run IntSet<u32>.fromSparseBitSet(&[13, 3, 49]) {
    Result<IntSet<u32>, DecodingError>.Success { value } => move value
    _ => {
      run Testing.expect(false, "upstream sparse set decodes")
      return
    }
  }
  let mut expected = IntSet<u32>.empty()
  run IntSet<u32>.insertRange(&mut expected, 0, 17)
  run Testing.expect(IntSet<u32>.equals(&set, &expected), "sparse set membership")
}
