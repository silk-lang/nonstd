}

effect fn nextMatches<T: Domain + Copy + TestValue>(set: &IntSet<T>, maximum: u32) -> ()
  ! AssertionError<'static> {
  let mut n: u32 = 0
  while n <= maximum {
    let mut it = IntSet<T>.iterAfter(set, value<T>(n))
    let expected = match move IntSetIter<T>.next(&mut it) {
      Option<T>.Some { value } => u32.toI64(Domain.toU32(&value))
      _ => -1
    }
    run Testing.expect(
      optional<T>(IntSet<T>.nextAfter(set, value<T>(n)), expected),
      "next after matches cursor",
    )
    n = n + 1
  }
}

test effect fn nextAfter() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run nextAfterBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nextAfterBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(0)), -1),
    "upstream IntSet expectation",
  )
  run IntSet<u32>.extend(&mut set, &[5, 7, 10, 1250, 1300, 3001])
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(0)), 5),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(5)), 7),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(700)), 1250),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(3001)), -1),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967295)), -1),
    "upstream IntSet expectation",
  )
  run nextMatches<u32>(&set, 3100)
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967294)), -1),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967295)), -1),
    "upstream IntSet expectation",
  )
}

test effect fn nextAfterExclusive() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
