effect fn iterRangesExclusiveDiscontinuousBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut even = IntSet<EvenInts>.all()
  run IntSet<EvenInts>.removeRange(&mut even, value<EvenInts>(0), value<EvenInts>(8))
  run IntSet<EvenInts>.removeRange(&mut even, value<EvenInts>(16), value<EvenInts>(65534))
  run ranges<EvenInts>(&even, false, &[U32Range { first: 10, last: 14 }])
  let mut set = IntSet<TwoParts>.all()
  run IntSet<TwoParts>.removeRange(&mut set, value<TwoParts>(11), value<TwoParts>(13))
  run ranges<TwoParts>(
    &set,
    false,
    &[U32Range { first: 2, last: 10 }, U32Range { first: 14, last: 16 }],
  )
  let mut inverted = run IntSet<TwoParts>.clone(&set)
  IntSet<TwoParts>.invert(&mut inverted)
  run ranges<TwoParts>(
    &inverted,
    true,
    &[U32Range { first: 2, last: 10 }, U32Range { first: 14, last: 16 }],
  )
  let mut s0 = IntSet<TwoParts>.all()
  run IntSet<TwoParts>.removeRange(&mut s0, value<TwoParts>(2), value<TwoParts>(16))
  run ranges<TwoParts>(&s0, false, &[])
  let mut s1 = IntSet<TwoParts>.all()
  run IntSet<TwoParts>.removeRange(&mut s1, value<TwoParts>(2), value<TwoParts>(5))
  run ranges<TwoParts>(&s1, false, &[U32Range { first: 8, last: 16 }])
  let mut s2 = IntSet<TwoParts>.all()
  run IntSet<TwoParts>.removeRange(&mut s2, value<TwoParts>(6), value<TwoParts>(16))
  run ranges<TwoParts>(&s2, false, &[U32Range { first: 2, last: 5 }])
  let bounds = IntSet<TwoPartsBounds>.all()
  run ranges<TwoPartsBounds>(&bounds, false, &[U32Range { first: 0, last: 4294967295 }])
}

