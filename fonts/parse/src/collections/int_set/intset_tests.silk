interface TestValue {
  fn value(raw: u32) -> Self
}

impl TestValue for u32 {
  fn value(raw: u32) -> Self {
    return raw
  }
}

impl TestValue for u16 {
  fn value(raw: u32) -> Self {
    return u32.toU16(raw)
  }
}

impl TestValue for u8 {
  fn value(raw: u32) -> Self {
    return u32.toU8(raw)
  }
}

impl TestValue for GlyphId {
  fn value(raw: u32) -> Self {
    return GlyphId.new(raw)
  }
}

impl TestValue for GlyphId16 {
  fn value(raw: u32) -> Self {
    return GlyphId16.new(u32.toU16(raw))
  }
}

impl TestValue for NameId {
  fn value(raw: u32) -> Self {
    return NameId.new(u32.toU16(raw))
  }
}

impl TestValue for Tag {
  fn value(raw: u32) -> Self {
    return Tag.fromU32(raw)
  }
}

struct EvenInts {
  raw: u16,
}

impl Copy for EvenInts {}

impl TestValue for EvenInts {
  fn value(raw: u32) -> Self {
    return Self { raw: u32.toU16(raw) }
  }
}

impl Order for EvenInts {
  fn compare(a: &Self, b: &Self) -> Ordering {
    if a.raw < b.raw {
      return Ordering.Less
    }
    if a.raw > b.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Domain for EvenInts {
  fn toU32(self: &Self) -> u32 {
    return u16.toU32(self.raw)
  }

  fn fromU32(member: InDomain) -> Self {
    return Self { raw: u32.toU16(InDomain.value(&member)) }
  }

  fn contains(raw: u32) -> bool {
    return raw % 2 == 0
  }

  fn isContinuous() -> bool {
    return false
  }

  fn count() -> u64 {
    return 2147483648
  }

  fn nextFrom(raw: u32) -> Option<u32> {
    if raw > 65534 {
      return Option<u32>.None
    }
    return Option<u32>.some(raw + raw % 2)
  }

  fn previousFrom(raw: u32) -> Option<u32> {
    let mut n = raw
    if n > 65534 {
      n = 65534
    }
    return Option<u32>.some(n - n % 2)
  }
}

struct TwoParts {
  raw: u16,
}

impl Copy for TwoParts {}

impl TestValue for TwoParts {
  fn value(raw: u32) -> Self {
    return Self { raw: u32.toU16(raw) }
  }
}

impl Order for TwoParts {
  fn compare(a: &Self, b: &Self) -> Ordering {
    if a.raw < b.raw {
      return Ordering.Less
    }
    if a.raw > b.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Domain for TwoParts {
  fn toU32(self: &Self) -> u32 {
    return u16.toU32(self.raw)
  }

  fn fromU32(member: InDomain) -> Self {
    return Self { raw: u32.toU16(InDomain.value(&member)) }
  }

  fn contains(raw: u32) -> bool {
    return (raw >= 2 && raw <= 5) || (raw >= 8 && raw <= 16)
  }

  fn isContinuous() -> bool {
    return false
  }

  fn count() -> u64 {
    return 13
  }

  fn nextFrom(raw: u32) -> Option<u32> {
    if raw <= 2 {
      return Option<u32>.some(2)
    }
    if raw <= 5 {
      return Option<u32>.some(raw)
    }
    if raw <= 8 {
      return Option<u32>.some(8)
    }
    if raw <= 16 {
      return Option<u32>.some(raw)
    }
    return Option<u32>.None
  }

  fn previousFrom(raw: u32) -> Option<u32> {
    if raw >= 16 {
      return Option<u32>.some(16)
    }
    if raw >= 8 {
      return Option<u32>.some(raw)
    }
    if raw >= 5 {
      return Option<u32>.some(5)
    }
    if raw >= 2 {
      return Option<u32>.some(raw)
    }
    return Option<u32>.None
  }
}

struct TwoPartsBounds {
  raw: u32,
}

impl Copy for TwoPartsBounds {}

impl TestValue for TwoPartsBounds {
  fn value(raw: u32) -> Self {
    return Self { raw: raw }
  }
}

impl Order for TwoPartsBounds {
  fn compare(a: &Self, b: &Self) -> Ordering {
    if a.raw < b.raw {
      return Ordering.Less
    }
    if a.raw > b.raw {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Domain for TwoPartsBounds {
  fn toU32(self: &Self) -> u32 {
    return self.raw
  }

  fn fromU32(member: InDomain) -> Self {
    return Self { raw: InDomain.value(&member) }
  }

  fn contains(raw: u32) -> bool {
    return raw <= 1 || raw >= u32.MAX - 1
  }

  fn isContinuous() -> bool {
    return false
  }

  fn count() -> u64 {
    return 4
  }

  fn nextFrom(raw: u32) -> Option<u32> {
    if raw <= 1 || raw >= u32.MAX - 1 {
      return Option<u32>.some(raw)
    }
    return Option<u32>.some(u32.MAX - 1)
  }

  fn previousFrom(raw: u32) -> Option<u32> {
    if raw <= 1 || raw >= u32.MAX - 1 {
      return Option<u32>.some(raw)
    }
    return Option<u32>.some(1)
  }
}

fn value<T: TestValue>(raw: u32) -> T {
  return TestValue.value(raw)
}

fn optional<T: Domain>(input: Option<T>, expected: i64) -> bool {
  return match move input {
    Option<T>.Some { value } => u32.toI64(Domain.toU32(&value)) == expected
    _ => expected == -1
  }
}

effect fn make<T: Domain + Copy + TestValue>(values: &[u32]) -> IntSet<T>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<T>.empty()
  let mut i: usize = 0
  while i < values.length {
    drop run IntSet<T>.insert(&mut set, value<T>(values[i]))
    i = i + 1
  }
  return move set
}

effect fn sequence<'a, T: Domain + Copy>(
  input: IntSetIter<'a, T>,
  expected: &[u32],
  reverse: bool,
  exhaust: bool,
) -> ()
  ! AssertionError<'static> {
  let mut iter = move input
  let mut i: usize = 0
  while i < expected.length {
    let mut got = Option<T>.None
    if reverse {
      got = IntSetIter<T>.nextBack(&mut iter)
    } else {
      got = IntSetIter<T>.next(&mut iter)
    }
    run Testing.expect(optional<T>(move got, u32.toI64(expected[i])), "integer set iteration")
    i = i + 1
  }
  if exhaust {
    run Testing.expect(
      optional<T>(IntSetIter<T>.next(&mut iter), -1)
        && optional<T>(IntSetIter<T>.nextBack(&mut iter), -1),
      "both ends exhausted",
    )
  }
}

effect fn ranges<T: Domain + Copy>(set: &IntSet<T>, excluded: bool, expected: &[U32Range]) -> ()
  ! AssertionError<'static> {
  let mut iter = IntSet<T>.iterRanges(set)
  if excluded {
    iter = IntSet<T>.iterExcludedRanges(set)
  }
  let mut i: usize = 0
  while i < expected.length {
    let got = match move IntSetRangeIter<T>.next(&mut iter) {
      Option<IntRange<T>>.Some { value } => value
      _ => {
        run Testing.expect(false, "range exists")
        return
      }
    }
    run Testing.expect(
      Domain.toU32(&got.first) == expected[i].first && Domain.toU32(&got.last) == expected[i].last,
      "domain range bounds",
    )
    i = i + 1
  }
  run Testing.expect(
    match move IntSetRangeIter<T>.next(&mut iter) {
      Option<IntRange<T>>.None => true
      _ => false
    },
    "ranges exhausted",
  )
}

test effect fn insert() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run insertBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn insertBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut empty = IntSet<u32>.empty()
  let mut all = IntSet<u32>.all()
  run Testing.expect(!IntSet<u32>.contains(&empty, 10), "upstream IntSet expectation")
  run Testing.expect(run IntSet<u32>.insert(&mut empty, 10), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&empty, 10), "upstream IntSet expectation")
  run Testing.expect(!(run IntSet<u32>.insert(&mut empty, 10)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&all, 10), "upstream IntSet expectation")
  run Testing.expect(!(run IntSet<u32>.insert(&mut all, 10)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&all, 10), "upstream IntSet expectation")
  run Testing.expect(!(run IntSet<u32>.insert(&mut all, 10)), "upstream IntSet expectation")
}

test effect fn remove() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run removeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn removeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut empty = run make<u32>(&[10])
  let mut all = IntSet<u32>.all()
  run Testing.expect(IntSet<u32>.contains(&empty, 10), "upstream IntSet expectation")
  run Testing.expect(run IntSet<u32>.remove(&mut empty, 10), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&empty, 10), "upstream IntSet expectation")
  run Testing.expect(!(run IntSet<u32>.remove(&mut empty, 10)), "upstream IntSet expectation")
  run Testing.expect(IntSet<u32>.contains(&all, 10), "upstream IntSet expectation")
  run Testing.expect(run IntSet<u32>.remove(&mut all, 10), "upstream IntSet expectation")
  run Testing.expect(!IntSet<u32>.contains(&all, 10), "upstream IntSet expectation")
  run Testing.expect(!(run IntSet<u32>.remove(&mut all, 10)), "upstream IntSet expectation")
}

test effect fn isEmpty() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isEmptyBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn isEmptyBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = IntSet<u32>.empty()
  run Testing.expect(IntSet<u32>.isEmpty(&set), "upstream IntSet expectation")
  run IntSet<u32>.extend(&mut set, &[13, 800])
  run Testing.expect(!IntSet<u32>.isEmpty(&set), "upstream IntSet expectation")
  IntSet<u32>.invert(&mut set)
  run Testing.expect(!IntSet<u32>.isEmpty(&set), "upstream IntSet expectation")
  let mut empty = IntSet<u32>.empty()
  run Testing.expect(IntSet<u32>.isEmpty(&empty), "upstream IntSet expectation")
  IntSet<u32>.invert(&mut empty)
  run Testing.expect(!IntSet<u32>.isEmpty(&empty), "upstream IntSet expectation")
}

test effect fn first() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run firstBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn firstBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = IntSet<u16>.empty()
  let all = IntSet<u16>.all()
  run Testing.expect(
    optional<u16>(IntSet<u16>.first(&empty), -1) && optional<u16>(IntSet<u16>.first(&all), 0),
    "upstream IntSet expectation",
  )
  let s0 = run make<u16>(&[0])
  run Testing.expect(optional<u16>(IntSet<u16>.first(&s0), 0), "upstream IntSet expectation")
  let s1 = run make<u16>(&[65535])
  run Testing.expect(optional<u16>(IntSet<u16>.first(&s1), 65535), "upstream IntSet expectation")
  let s2 = run make<u16>(&[100, 1000, 10000])
  run Testing.expect(optional<u16>(IntSet<u16>.first(&s2), 100), "upstream IntSet expectation")
  let mut set = run make<u16>(&[100, 1000, 10000])
  IntSet<u16>.invert(&mut set)
  run Testing.expect(optional<u16>(IntSet<u16>.first(&set), 0), "upstream IntSet expectation")
  run IntSet<u16>.removeRange(&mut set, 0, 100)
  run Testing.expect(optional<u16>(IntSet<u16>.first(&set), 101), "upstream IntSet expectation")
}

test effect fn last() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lastBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lastBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let empty = IntSet<u16>.empty()
  let all = IntSet<u16>.all()
  run Testing.expect(
    optional<u16>(IntSet<u16>.last(&empty), -1) && optional<u16>(IntSet<u16>.last(&all), 65535),
    "upstream IntSet expectation",
  )
  let s0 = run make<u16>(&[0])
  run Testing.expect(optional<u16>(IntSet<u16>.last(&s0), 0), "upstream IntSet expectation")
  let s1 = run make<u16>(&[65535])
  run Testing.expect(optional<u16>(IntSet<u16>.last(&s1), 65535), "upstream IntSet expectation")
  let s2 = run make<u16>(&[5, 7, 8])
  run Testing.expect(optional<u16>(IntSet<u16>.last(&s2), 8), "upstream IntSet expectation")
  let s3 = run make<u16>(&[100, 1000, 10000])
  run Testing.expect(optional<u16>(IntSet<u16>.last(&s3), 10000), "upstream IntSet expectation")
  let mut set = run make<u16>(&[100, 1000, 10000])
  IntSet<u16>.invert(&mut set)
  run Testing.expect(optional<u16>(IntSet<u16>.last(&set), 65535), "upstream IntSet expectation")
  run IntSet<u16>.removeRange(&mut set, 65525, 65535)
  run Testing.expect(optional<u16>(IntSet<u16>.last(&set), 65524), "upstream IntSet expectation")
}

test effect fn clear() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run clearBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn clearBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run make<u32>(&[13, 800])
  let mut inverted = run make<u32>(&[13, 800])
  IntSet<u32>.invert(&mut inverted)
  IntSet<u32>.clear(&mut set)
  IntSet<u32>.clear(&mut inverted)
  run Testing.expect(
    IntSet<u32>.isEmpty(&set) && IntSet<u32>.isEmpty(&inverted),
    "upstream IntSet expectation",
  )
}

test effect fn equalAndHash() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run equalAndHashBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn equalAndHashBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let inc1 = run make<u32>(&[14, 670])
  let inc2 = run make<u32>(&[670, 14])
  let mut inc3 = run IntSet<u32>.clone(&inc1)
  drop run IntSet<u32>.insert(&mut inc3, 5)
  let mut exc = run IntSet<u32>.clone(&inc1)
  IntSet<u32>.invert(&mut exc)
  run Testing.expect(
    IntSet<u32>.equals(&inc1, &inc2) && !IntSet<u32>.equals(&inc1, &inc3)
      && !IntSet<u32>.equals(&inc1, &exc),
    "set equality",
  )
  let seed = Hash.seed(17)
  run Testing.expect(
    IntSet<u32>.hash(&inc1, &seed) != IntSet<u32>.hash(&exc, &seed)
      && IntSet<u32>.hash(&inc1, &seed) == IntSet<u32>.hash(&inc2, &seed),
    "effective membership hash",
  )
  let mut hashed = HashSet<IntSet<u32>>.make(seed)
  drop run HashSet<IntSet<u32>>.insert(&mut hashed, run IntSet<u32>.clone(&inc1))
  drop run HashSet<IntSet<u32>>.insert(&mut hashed, run IntSet<u32>.clone(&inc3))
  drop run HashSet<IntSet<u32>>.insert(&mut hashed, run IntSet<u32>.clone(&exc))
  run Testing.expect(
    HashSet<IntSet<u32>>.contains(&hashed, move inc1)
      && HashSet<IntSet<u32>>.contains(&hashed, move inc3)
      && HashSet<IntSet<u32>>.contains(&hashed, move exc),
    "set hashed membership",
  )
}

test effect fn equalAndHashMixedMembershipTypes() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run equalAndHashMixedMembershipTypesBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn equalAndHashMixedMembershipTypesBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut inverted = IntSet<TwoParts>.all()
  let mut all = IntSet<TwoParts>.empty()
  let mut values = orderedValues<TwoParts>()
  while true {
    let n = match move DomainValues<TwoParts>.next(&mut values) {
      Option<u32>.Some { value } => value
      _ => {
        break
      }
    }
    drop run IntSet<TwoParts>.insert(&mut all, value<TwoParts>(n))
  }
  let seed = Hash.seed(17)
  run Testing.expect(
    IntSet<TwoParts>.equals(&inverted, &all)
      && IntSet<TwoParts>.hash(&all, &seed) == IntSet<TwoParts>.hash(&inverted, &seed),
    "mixed membership identity",
  )
  drop run IntSet<TwoParts>.remove(&mut inverted, value<TwoParts>(5))
  run Testing.expect(!IntSet<TwoParts>.equals(&inverted, &all), "different effective members")
  drop run IntSet<TwoParts>.remove(&mut all, value<TwoParts>(5))
  run Testing.expect(
    IntSet<TwoParts>.equals(&inverted, &all)
      && IntSet<TwoParts>.hash(&all, &seed) == IntSet<TwoParts>.hash(&inverted, &seed),
    "equal after both remove",
  )
}

test effect fn iter() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run iterBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn iterBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let set = run make<u32>(&[3, 8, 534, 700, 10000, 10001, 10002])
  run sequence<u32>(IntSet<u32>.iter(&set), &[3, 8, 534, 700, 10000, 10001, 10002], false, true)
  let it = match move IntSet<u32>.inclusiveIter(&set) {
    Option<IntSetIter<u32>>.Some { value } => move value
    _ => {
      run Testing.expect(false, "inclusive iterator exists")
      return
    }
  }
  run sequence<u32>(move it, &[3, 8, 534, 700, 10000, 10001, 10002], false, true)
}

effect fn mixed0(set: &IntSet<u32>) -> ()
  ! AssertionError<'static> {
  let mut it = IntSet<u32>.iter(set)
  run Testing.expect(optional<u32>(IntSetIter<u32>.next(&mut it), 1), "upstream IntSet expectation")
  run Testing.expect(
    optional<u32>(IntSetIter<u32>.nextBack(&mut it), 6),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSetIter<u32>.nextBack(&mut it), 5),
    "upstream IntSet expectation",
  )
  run Testing.expect(optional<u32>(IntSetIter<u32>.next(&mut it), 2), "upstream IntSet expectation")
  run Testing.expect(optional<u32>(IntSetIter<u32>.next(&mut it), 3), "upstream IntSet expectation")
  run Testing.expect(optional<u32>(IntSetIter<u32>.next(&mut it), 4), "upstream IntSet expectation")
  run Testing.expect(
    optional<u32>(IntSetIter<u32>.next(&mut it), -1),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSetIter<u32>.nextBack(&mut it), -1),
    "upstream IntSet expectation",
  )
}

effect fn mixed1(set: &IntSet<u8>) -> ()
  ! AssertionError<'static> {
  let mut it = IntSet<u8>.iter(set)
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), 0), "upstream IntSet expectation")
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), 1), "upstream IntSet expectation")
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), 2), "upstream IntSet expectation")
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), 3), "upstream IntSet expectation")
  run Testing.expect(
    optional<u8>(IntSetIter<u8>.nextBack(&mut it), 9),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u8>(IntSetIter<u8>.nextBack(&mut it), 7),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u8>(IntSetIter<u8>.nextBack(&mut it), 6),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u8>(IntSetIter<u8>.nextBack(&mut it), 5),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u8>(IntSetIter<u8>.nextBack(&mut it), -1),
    "upstream IntSet expectation",
  )
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), -1), "upstream IntSet expectation")
}

effect fn mixed2(set: &IntSet<u8>) -> ()
  ! AssertionError<'static> {
  let mut it = IntSet<u8>.iter(set)
  run Testing.expect(optional<u8>(IntSetIter<u8>.next(&mut it), 0), "upstream IntSet expectation")
