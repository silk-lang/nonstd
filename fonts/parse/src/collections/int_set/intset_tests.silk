effect fn nextAfterExclusiveBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run make<u32>(&[5, 7, 10, 1250, 1300, 3001])
  IntSet<u32>.invert(&mut set)
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(3)), 4),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4)), 6),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(9)), 11),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967294)), 4294967295),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967295)), -1),
    "upstream IntSet expectation",
  )
  run IntSet<u32>.removeRange(&mut set, 4000, 5000)
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(3999)), 5001),
    "upstream IntSet expectation",
  )
  run nextMatches<u32>(&set, 5100)
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967294)), 4294967295),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294967295)), -1),
    "upstream IntSet expectation",
  )
  run IntSet<u32>.removeRange(&mut set, u32.MAX - 600, u32.MAX)
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294966693)), 4294966694),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    optional<u32>(IntSet<u32>.nextAfter(&set, value<u32>(4294966694)), -1),
    "upstream IntSet expectation",
  )
}

test effect fn nextAfterExclusiveRespectsDomainMax() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
