effect fn iterAfterFromExclusiveBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut set = run make<u32>(&[5, 7, 10, 1250, 1300, 3001])
  IntSet<u32>.invert(&mut set)
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(3)), &[4, 6, 8, 9, 11], false, false)
  run sequence<u32>(
    IntSet<u32>.range(&set, Bound<u32>.Included { value: value<u32>(3) }, Bound<u32>.Unbounded),
    &[3, 4, 6, 8, 9],
    false,
    false,
  )
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(0)), &[1, 2, 3, 4, 6], false, false)
  run sequence<u32>(
    IntSet<u32>.range(&set, Bound<u32>.Included { value: value<u32>(0) }, Bound<u32>.Unbounded),
    &[0, 1, 2, 3, 4],
    false,
    false,
  )
  run sequence<u32>(
    IntSet<u32>.iterAfter(&set, value<u32>(4294967294)),
    &[4294967295],
    false,
    false,
  )
  run sequence<u32>(
    IntSet<u32>.range(
      &set,
      Bound<u32>.Included { value: value<u32>(4294967294) },
      Bound<u32>.Unbounded,
    ),
    &[4294967294, 4294967295],
    false,
    false,
  )
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(4294967295)), &[], false, true)
  drop run IntSet<u32>.remove(&mut set, u32.MAX)
  run sequence<u32>(
    IntSet<u32>.range(
      &set,
      Bound<u32>.Included { value: value<u32>(4294967295) },
      Bound<u32>.Unbounded,
    ),
    &[],
    false,
    true,
  )
  run sequence<u32>(IntSet<u32>.iterAfter(&set, value<u32>(4294967294)), &[], false, true)
}

