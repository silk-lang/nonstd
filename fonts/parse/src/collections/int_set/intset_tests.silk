  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(1234), value<u32>(1234)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1230), value<u32>(1240)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(1234)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1234), value<u32>(4294967295)),
    "upstream IntSet expectation",
  )
  drop run IntSet<u32>.remove(&mut set, value<u32>(0))
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(0), value<u32>(0)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(1), value<u32>(1)),
    "upstream IntSet expectation",
  )
  run IntSet<u32>.removeRange(&mut set, value<u32>(5000), value<u32>(5200))
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(5000), value<u32>(5200)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    !IntSet<u32>.intersectsRange(&set, value<u32>(5100), value<u32>(5150)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(4999), value<u32>(5200)),
    "upstream IntSet expectation",
  )
  run Testing.expect(
    IntSet<u32>.intersectsRange(&set, value<u32>(5000), value<u32>(5201)),
    "upstream IntSet expectation",
  )
}

