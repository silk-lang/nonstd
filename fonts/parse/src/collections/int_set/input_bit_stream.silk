import collections.int_set.branch_factor { BranchFactor }
import silk.core.option { Option }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.core.ownership { Copy }

impl Copy for StreamHeader {}

pub struct StreamHeader {
  pub branchFactor: BranchFactor,
  pub height: u8,
}

pub struct InputBitStream<'a> {
  data: &'a [u8],
  byteIndex: usize,
  subIndex: u32,
  branchFactor: BranchFactor,
}

impl<'a> InputBitStream<'a> {
  pub fn from(data: &'a [u8], branchFactor: BranchFactor) -> Self {
    return Self { data: data, byteIndex: 1, subIndex: 0, branchFactor: branchFactor }
  }

  pub fn decodeHeader(data: &[u8]) -> Option<StreamHeader> {
    if data.length == 0 {
      return Option<StreamHeader>.None
    }
    let bf = match data[0] & 3 {
      0 => BranchFactor.Two
      1 => BranchFactor.Four
      2 => BranchFactor.Eight
      _ => BranchFactor.ThirtyTwo
    }
    return Option<StreamHeader>.some(
      StreamHeader { branchFactor: bf, height: u8.shiftRight(data[0] & 124, 2) },
    )
  }

  pub fn next(self: &mut Self) -> Option<u32> {
    if self.byteIndex >= self.data.length {
      return Option<u32>.None
    }
    let bf = BranchFactor.arity(&self.branchFactor)
    if bf < 8 {
      let value = u32.shiftRight(u8.toU32(self.data[self.byteIndex]), self.subIndex)
        & BranchFactor.byteMask(&self.branchFactor)
      self.subIndex = (self.subIndex + bf) % 8
      if self.subIndex == 0 {
        self.byteIndex = self.byteIndex + 1
      }
      return Option<u32>.some(value)
    }
    if bf == 8 {
      let value = u8.toU32(self.data[self.byteIndex])
      self.byteIndex = self.byteIndex + 1
      return Option<u32>.some(value)
    }
    if self.data.length - self.byteIndex < 4 {
      return Option<u32>.None
    }
    let at = self.byteIndex
    let value = u8.toU32(self.data[at]) | u32.shiftLeft(u8.toU32(self.data[at + 1]), 8)
      | u32.shiftLeft(u8.toU32(self.data[at + 2]), 16)
      | u32.shiftLeft(u8.toU32(self.data[at + 3]), 24)
    self.byteIndex = self.byteIndex + 4
    return Option<u32>.some(value)
  }

  pub fn skipNodes(self: &mut Self, count: u32) -> bool {
    let bits = u32.toU64(self.subIndex)
      + u32.toU64(count) * u32.toU64(BranchFactor.arity(&self.branchFactor))
    let delta = match move u64.checkedToUsize(bits / 8) {
      Option<usize>.Some { value } => value
      _ => {
        return false
      }
    }
    self.byteIndex = match move usize.checkedAdd(self.byteIndex, delta) {
      Option<usize>.Some { value } => value
      _ => {
        return false
      }
    }
    self.subIndex = u64.toU32(bits % 8)
    return InputBitStream.bytesConsumed(&self) <= self.data.length
  }

  pub fn bytesConsumed(self: &Self) -> usize {
    if self.subIndex > 0 {
      return usize.saturatingAdd(self.byteIndex, 1)
    }
    return self.byteIndex
  }
}
