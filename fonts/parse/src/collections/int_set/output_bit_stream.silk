import collections.int_set.branch_factor { BranchFactor }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32

pub struct OutputBitStream {
  data: List<u8>,
  subIndex: u32,
  branchFactor: BranchFactor,
}

impl OutputBitStream {
  pub effect fn new(branchFactor: BranchFactor, height: u8) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut data = List<u8>.make()
    run List<u8>.append(&mut data, u8.shiftLeft(height & 31, 2) | BranchFactor.bitId(&branchFactor))
    return Self { data: move data, subIndex: 0, branchFactor: branchFactor }
  }

  pub fn intoBytes(self: Self) -> List<u8> {
    return move self.data
  }

  pub effect fn writeNode(self: &mut Self, bits: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut byteIndex: u32 = 0
    while byteIndex < BranchFactor.bytesPerNode(&self.branchFactor) {
      if BranchFactor.nodesPerByte(&self.branchFactor) == 1 || self.subIndex == 0 {
        run List<u8>.append(&mut self.data, 0)
      }
      let part = u32.shiftRight(bits, byteIndex * 8) & BranchFactor.byteMask(&self.branchFactor)
      let shifted = u32.toU8(
        u32.shiftLeft(part, self.subIndex * BranchFactor.arity(&self.branchFactor)),
      )
      let at = List<u8>.length(&self.data) - 1
      let old = List<u8>.get(&self.data, at)
      List<u8>.set(&mut self.data, at, old | shifted)
      if BranchFactor.nodesPerByte(&self.branchFactor) > 1 {
        self.subIndex = (self.subIndex + 1) % BranchFactor.nodesPerByte(&self.branchFactor)
      }
      byteIndex = byteIndex + 1
    }
  }
}
