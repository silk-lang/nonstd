effect fn bf32Body() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut stream1 = run OutputBitStream.new(BranchFactor.ThirtyTwo, 31)
  run OutputBitStream.writeNode(&mut stream1, 0b10000000_00000000_00001101_01110010)
  run bytes(
    OutputBitStream.intoBytes(move stream1),
    &[0b0_11111_11, 0b01110010, 0b00001101, 0b00000000, 0b10000000],
  )
}

test effect fn truncating() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
