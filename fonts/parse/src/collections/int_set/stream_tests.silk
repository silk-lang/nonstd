import collections.int_set.branch_factor { BranchFactor }
import collections.int_set.input_bit_stream { InputBitStream, StreamHeader }
import collections.int_set.output_bit_stream { OutputBitStream }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u32

fn optional(input: Option<u32>, expected: i64) -> bool {
  return match move input {
    Option<u32>.Some { value } => u32.toI64(value) == expected
    Option<u32>.None => expected == -1
  }
}

effect fn bytes(input: List<u8>, expected: &[u8]) -> ()
  ! AssertionError<'static> {
  let actual = List<u8>.asSlice(&input)
  run Testing.expect(actual.length == expected.length, "encoded byte count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "encoded byte")
    i = i + 1
  }
}

test effect fn readHeader() -> ()
  ! AssertionError<'static> {
  if true {
    let header = match move InputBitStream.decodeHeader(&[228]) {
      Option<StreamHeader>.Some { value } => value
      _ => {
        run Testing.expect(false, "header exists")
        return
      }
    }
    run Testing.expect(
      header.branchFactor == BranchFactor.Two && header.height == 25,
      "upstream stream expectation",
    )
  }
  if true {
    let header = match move InputBitStream.decodeHeader(&[129]) {
      Option<StreamHeader>.Some { value } => value
      _ => {
        run Testing.expect(false, "header exists")
        return
      }
    }
    run Testing.expect(
      header.branchFactor == BranchFactor.Four && header.height == 0,
      "upstream stream expectation",
    )
  }
  if true {
    let header = match move InputBitStream.decodeHeader(&[254]) {
      Option<StreamHeader>.Some { value } => value
      _ => {
        run Testing.expect(false, "header exists")
        return
      }
    }
    run Testing.expect(
      header.branchFactor == BranchFactor.Eight && header.height == 31,
      "upstream stream expectation",
    )
  }
  if true {
    let header = match move InputBitStream.decodeHeader(&[167]) {
      Option<StreamHeader>.Some { value } => value
      _ => {
        run Testing.expect(false, "header exists")
        return
      }
    }
    run Testing.expect(
      header.branchFactor == BranchFactor.ThirtyTwo && header.height == 9,
      "upstream stream expectation",
    )
  }
}

test effect fn read2() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(
    &[0b00000000, 0b11_10_01_00, 0b00_01_10_11],
    BranchFactor.Two,
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b00),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b01),
    "upstream stream expectation",
  )
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b10),
    "upstream stream expectation",
  )
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b11),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b11),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b10),
    "upstream stream expectation",
  )
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b01),
    "upstream stream expectation",
  )
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b00),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(optional(InputBitStream.next(&mut stream1), -1), "upstream stream expectation")
  let mut stream2 = InputBitStream.from(&[], BranchFactor.Two)
  run Testing.expect(optional(InputBitStream.next(&mut stream2), -1), "upstream stream expectation")
}

test effect fn skip2() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(
    &[0b00000000, 0b11_10_01_00, 0b00_01_10_11],
    BranchFactor.Two,
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 2), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 3), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(!InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
}

test effect fn skip2Unaligned() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(
    &[0b00000000, 0b11_10_01_00, 0b00_01_10_11],
    BranchFactor.Two,
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 3), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 3), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(!InputBitStream.skipNodes(&mut stream1, 3), "upstream stream expectation")
}

test effect fn read4() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(&[0b00000000, 0b1110_0100, 0b0001_1011], BranchFactor.Four)
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b0100),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b1110),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b1011),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b0001),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(optional(InputBitStream.next(&mut stream1), -1), "upstream stream expectation")
  let mut stream2 = InputBitStream.from(&[], BranchFactor.Four)
  run Testing.expect(optional(InputBitStream.next(&mut stream2), -1), "upstream stream expectation")
}

test effect fn skip4() -> ()
