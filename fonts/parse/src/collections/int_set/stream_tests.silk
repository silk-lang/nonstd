test effect fn skip8() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(&[0b00000000, 0b11100100, 0b00011011], BranchFactor.Eight)
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 2, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 3, "upstream stream expectation")
  run Testing.expect(!InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  let mut stream2 = InputBitStream.from(&[0b00000000, 0b11100100, 0b00011011], BranchFactor.Eight)
  run Testing.expect(InputBitStream.bytesConsumed(&stream2) == 1, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream2, 2), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream2) == 3, "upstream stream expectation")
  run Testing.expect(!InputBitStream.skipNodes(&mut stream2, 1), "upstream stream expectation")
}

test effect fn read32() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(
    &[0b00000000, 0b00000000, 0b11111111, 0b11100100, 0b00011011],
    BranchFactor.ThirtyTwo,
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(
    optional(InputBitStream.next(&mut stream1), 0b00011011_11100100_11111111_00000000),
    "upstream stream expectation",
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 5, "upstream stream expectation")
  run Testing.expect(optional(InputBitStream.next(&mut stream1), -1), "upstream stream expectation")
  let mut stream2 = InputBitStream.from(
    &[0b00000000, 0b00000000, 0b11111111, 0b11100100, 0b00011011, 0b00000001],
    BranchFactor.ThirtyTwo,
  )
  run Testing.expect(
    optional(InputBitStream.next(&mut stream2), 0b00011011_11100100_11111111_00000000),
    "upstream stream expectation",
  )
  run Testing.expect(optional(InputBitStream.next(&mut stream2), -1), "upstream stream expectation")
  let mut stream3 = InputBitStream.from(&[], BranchFactor.ThirtyTwo)
  run Testing.expect(optional(InputBitStream.next(&mut stream3), -1), "upstream stream expectation")
}

test effect fn skip32() -> ()
  ! AssertionError<'static> {
  let mut stream1 = InputBitStream.from(
    &[0b00000000, 0b00000000, 0b11111111, 0b11100100, 0b00011011],
    BranchFactor.ThirtyTwo,
  )
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 1, "upstream stream expectation")
  run Testing.expect(InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
  run Testing.expect(InputBitStream.bytesConsumed(&stream1) == 5, "upstream stream expectation")
  run Testing.expect(!InputBitStream.skipNodes(&mut stream1, 1), "upstream stream expectation")
}

test effect fn init() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run initBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn initBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut stream1 = run OutputBitStream.new(BranchFactor.Two, 13)
  run bytes(OutputBitStream.intoBytes(move stream1), &[0b0_01101_00])
  let mut stream2 = run OutputBitStream.new(BranchFactor.Four, 23)
  run bytes(OutputBitStream.intoBytes(move stream2), &[0b0_10111_01])
  let mut stream3 = run OutputBitStream.new(BranchFactor.Eight, 1)
  run bytes(OutputBitStream.intoBytes(move stream3), &[0b0_00001_10])
  let mut stream4 = run OutputBitStream.new(BranchFactor.ThirtyTwo, 31)
  run bytes(OutputBitStream.intoBytes(move stream4), &[0b0_11111_11])
}

test effect fn bf2() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run bf2Body() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bf2Body() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut stream1 = run OutputBitStream.new(BranchFactor.Two, 13)
  run OutputBitStream.writeNode(&mut stream1, 0b10)
  run OutputBitStream.writeNode(&mut stream1, 0b00)
  run OutputBitStream.writeNode(&mut stream1, 0b11)
  run OutputBitStream.writeNode(&mut stream1, 0b01)
  run OutputBitStream.writeNode(&mut stream1, 0b01)
  run OutputBitStream.writeNode(&mut stream1, 0b11)
  run bytes(OutputBitStream.intoBytes(move stream1), &[0b0_01101_00, 0b01_11_00_10, 0b00_00_11_01])
}

