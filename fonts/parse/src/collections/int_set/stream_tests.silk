  run OutputBitStream.writeNode(&mut stream1, 0b0010)
  run OutputBitStream.writeNode(&mut stream1, 0b0111)
  run OutputBitStream.writeNode(&mut stream1, 0b1101)
  run bytes(OutputBitStream.intoBytes(move stream1), &[0b0_10111_01, 0b0111_0010, 0b0000_1101])
}

