effect fn truncatingBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut stream1 = run OutputBitStream.new(BranchFactor.Four, 23)
  run OutputBitStream.writeNode(&mut stream1, 0b11110010)
  run bytes(OutputBitStream.intoBytes(move stream1), &[0b0_10111_01, 0b0000_0010])
}
