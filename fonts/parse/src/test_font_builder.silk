import silk.num.usize
import silk.num.u16
import silk.num.u32

pub fn put16(out: &mut [u8], at: usize, value: u16) -> () {
  out[at] = u16.toU8(value / 256)
  out[at + 1] = u16.toU8(value & 255)
}

pub fn put32(out: &mut [u8], at: usize, value: u32) -> () {
  out[at] = u32.toU8(u32.shiftRight(value, 24))
  out[at + 1] = u32.toU8(u32.shiftRight(value, 16) & 255)
  out[at + 2] = u32.toU8(u32.shiftRight(value, 8) & 255)
  out[at + 3] = u32.toU8(value & 255)
}

import silk.core.ownership { Copy }

pub struct TestTable<'a> {
  pub tag: u32,
  pub data: &'a [u8],
}

impl<'a> Copy for TestTable<'a> {}

pub fn font(out: &mut [u8], tables: &[TestTable]) -> usize {
  let mut i: usize = 0
  while i < out.length {
    out[i] = 0
    i = i + 1
  }
  put32(&mut out, 0, 65536)
  put16(&mut out, 4, usize.toU16(tables.length))
  let mut position = 12 + tables.length * 16
  i = 0
  while i < tables.length {
    let record = 12 + i * 16
    put32(&mut out, record, tables[i].tag)
    put32(&mut out, record + 8, usize.toU32(position))
    put32(&mut out, record + 12, usize.toU32(tables[i].data.length))
    let mut j: usize = 0
    while j < tables[i].data.length {
      out[position + j] = tables[i].data[j]
      j = j + 1
    }
    position = (position + tables[i].data.length + 3) & (usize.MAX - 3)
    i = i + 1
  }
  return position
}

pub fn gvar(
  out: &mut [u8],
  count: u32,
  extended: bool,
  longOffsets: bool,
  wideDataOffset: bool,
) -> usize {
  let mut i: usize = 0
  while i < out.length {
    out[i] = 0
    i = i + 1
  }
  let mut header: usize = 20
  if extended {
    header = 21
  }
  let mut width: usize = 2
  if longOffsets {
    width = 4
  }
  let shared = header + (u32.toUsize(count) + 1) * width
  let body = shared + 2
  put32(&mut out, 0, 65536)
  put16(&mut out, 4, 1)
  put16(&mut out, 6, 1)
  put32(&mut out, 8, usize.toU32(shared))
  let mut flags: usize = 14
  if extended {
    out[12] = u32.toU8(u32.shiftRight(count, 16) & 255)
    out[13] = u32.toU8(u32.shiftRight(count, 8) & 255)
    out[14] = u32.toU8(count & 255)
    flags = 15
  } else {
    put16(&mut out, 12, u32.toU16(count))
  }
  if longOffsets {
    put16(&mut out, flags, 1)
  }
  put32(&mut out, flags + 2, usize.toU32(body))
  put16(&mut out, shared, 16384)
  let mut end = body
  let mut firstEnd: usize = 0
  let mut item: usize = 0
  while item < 2 {
    let start = end
    let mut dataOffset: usize = 8
    if extended {
      dataOffset = 9
    }
    if wideDataOffset && item == 1 {
      dataOffset = 65537
    }
    put16(&mut out, start, 1)
    let mut tupleHeader = start + 4
    if extended {
      put32(&mut out, start + 1, usize.toU32(dataOffset))
      out[start + 1] = 1
      tupleHeader = start + 5
    } else {
      put16(&mut out, start + 2, usize.toU16(dataOffset))
    }
    let mut points: usize = 5
    if item == 1 {
      points = 8
    }
    put16(&mut out, tupleHeader, usize.toU16(points * 2 + 3))
    put16(&mut out, tupleHeader + 2, 8192)
    let serialized = start + dataOffset
    out[serialized + 1] = usize.toU8(points - 1)
    out[serialized + 2 + points] = usize.toU8(points - 1)
    if item == 0 {
      out[serialized + 2] = 20
      out[serialized + 4] = 60
    } else {
      out[serialized + 2] = 40
      out[serialized + 3] = 40
      out[serialized + 4] = 40
      out[serialized + 5] = 40
      out[serialized + 7] = 100
      out[serialized + 17] = 40
      out[serialized + 18] = 236
    }
    end = serialized + points * 2 + 3
    if !longOffsets {
      end = body + ((end - body + 1) & (usize.MAX - 1))
    }
    if item == 0 {
      firstEnd = end - body
    }
    item = item + 1
  }
  i = 0
  while i <= u32.toUsize(count) {
    let mut offset: usize = 0
    if i >= 2 {
      offset = firstEnd
    }
    if i == u32.toUsize(count) {
      offset = end - body
    }
    if longOffsets {
      put32(&mut out, header + i * width, usize.toU32(offset))
    } else {
      put16(&mut out, header + i * width, usize.toU16(offset / 2))
    }
    i = i + 1
  }
  return end
}

pub fn metricHeader(out: &mut [u8], count: u32, extended: bool, vertical: bool) -> usize {
  let mut i: usize = 0
  while i < out.length {
    out[i] = 0
    i = i + 1
  }
  let mut version: u32 = 65536
  if vertical {
    version = 69632
  }
  put32(&mut out, 0, version)
  let values: [u16; 15] = [800, 65336, 50, 2000, 65436, 65436, 2000, 1, 0, 0, 0, 0, 0, 0, 0]
  i = 0
  while i < 15 {
    put16(&mut out, 4 + i * 2, values[i])
    i = i + 1
  }
  if extended {
    put32(&mut out, 34, count)
    return 38
  }
  put16(&mut out, 34, u32.toU16(count))
  return 36
}

pub fn metricData(out: &mut [u8], count: usize, trailing: usize, advance: u16) -> usize {
  let mut i: usize = 0
  while i < count {
    put16(&mut out, i * 4, advance + usize.toU16(i % 100))
    let mut bearing: u16 = 0
    if i % 300 != 0 {
      bearing = usize.toU16(65536 - i % 300)
    }
    put16(&mut out, i * 4 + 2, bearing)
    i = i + 1
  }
  i = 0
  while i < trailing {
    put16(&mut out, count * 4 + i * 2, usize.toU16(65536 - 10 - i))
    i = i + 1
  }
  return count * 4 + trailing * 2
}

import silk.collections.slice { Slice }

pub fn metricsFont(out: &mut [u8], extended: bool, legacy: bool, outline: u32) -> usize {
  let mut head: [u8; 54] = [0; 54]
  put32(&mut head, 0, 65536)
  put16(&mut head, 18, 1000)
  let profile = b"\x00\x00\x50\x00\x01\x11\x72"
  let oldProfile = b"\x00\x00\x50\x00\x00\x03"
  let mut horizontal: [u8; 38] = [0; 38]
  drop metricHeader(&mut horizontal, 70000, true, false)
  let mut vertical: [u8; 38] = [0; 38]
  drop metricHeader(&mut vertical, 70000, true, true)
  let mut oldHorizontal: [u8; 36] = [0; 36]
  drop metricHeader(&mut oldHorizontal, 2, false, false)
  let mut oldVertical: [u8; 36] = [0; 36]
  drop metricHeader(&mut oldVertical, 2, false, true)
  let mut hRecords: [u8; 280004] = [0; 280004]
  drop metricData(&mut hRecords, 70000, 2, 1000)
  let mut vRecords: [u8; 280004] = [0; 280004]
  drop metricData(&mut vRecords, 70000, 2, 1200)
  let mut oldHRecords: [u8; 10] = [0; 10]
  drop metricData(&mut oldHRecords, 2, 1, 500)
  let mut oldVRecords: [u8; 10] = [0; 10]
  drop metricData(&mut oldVRecords, 2, 1, 600)
  let mut tables = [TestTable { tag: 0, data: &head }; 12]
  tables[0] = TestTable { tag: 1751474532, data: &head }
  let mut n: usize = 1
  if extended {
    tables[n] = TestTable { tag: 1296128080, data: profile }
    tables[n + 1] = TestTable { tag: 1212695873, data: &horizontal }
    tables[n + 2] = TestTable { tag: 1213027416, data: &hRecords }
    tables[n + 3] = TestTable { tag: 1447576897, data: &vertical }
    tables[n + 4] = TestTable { tag: 1447908440, data: &vRecords }
    n = n + 5
  }
  if legacy {
    tables[n] = TestTable { tag: 1835104368, data: oldProfile }
    tables[n + 1] = TestTable { tag: 1751672161, data: &oldHorizontal }
    tables[n + 2] = TestTable { tag: 1752003704, data: &oldHRecords }
    tables[n + 3] = TestTable { tag: 1986553185, data: &oldVertical }
    tables[n + 4] = TestTable { tag: 1986884728, data: &oldVRecords }
    n = n + 5
  }
  if outline != 0 {
    tables[n] = TestTable { tag: outline, data: b"" }
    n = n + 1
  }
  return font(move out, Slice.view<TestTable>(&tables, 0, n))
}

pub fn outlinesFont(
  out: &mut [u8],
  legacy: bool,
  extendedMetrics: bool,
  longLoca: bool,
  locationMode: usize,
) -> usize {
  let mut head: [u8; 54] = [0; 54]
  put32(&mut head, 0, 65536)
  put16(&mut head, 18, 1000)
  if longLoca {
    put16(&mut head, 50, 1)
  }
  let mut profile: [u8; 33] = [0; 33]
  put32(&mut profile, 0, 65536)
  profile[4] = 1
  profile[6] = 1
  let mut oldProfile: [u8; 32] = [0; 32]
  put32(&mut oldProfile, 0, 65536)
  put16(&mut oldProfile, 4, 3)
  let outline = b"\xff\xff\x00\x00\x00\x00\x00\x50\x00\x50\x20\x02\x01\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x50\x00\x50\x00\x03\x00\x00\x80\x80\x80\x80\x00\x00\x00\x50\x00\x00\xff\xb0\x00\x00\x00\x00\x00\x50\x00\x00"
  let oldOutline = b"\x00\x01\x00\x00\x00\x00\x00\x0a\x00\x0a\x00\x02\x00\x00\x01\x01\x01\x00\x00\x00\x0a\x00\x00\x00\x00\x00\x00\x00\x0a\x00"
  let mut locations: [u8; 262152] = [0; 262152]
  let mut oldLocations: [u8; 16] = [0; 16]
  let mut width: usize = 2
  if longLoca {
    width = 4
  }
  let mut i: usize = 2
  while i < 65538 {
    let mut offset: u32 = 18
    if i == 65537 {
      offset = 52
    }
    if longLoca {
      put32(&mut locations, i * width, offset)
    } else {
      put16(&mut locations, i * width, u32.toU16(offset / 2))
    }
    i = i + 1
  }
  if longLoca {
    put32(&mut oldLocations, 8, 30)
    put32(&mut oldLocations, 12, 30)
  } else {
    put16(&mut oldLocations, 4, 15)
    put16(&mut oldLocations, 6, 15)
  }
  let mut metrics: [u8; 131076] = [0; 131076]
  put16(&mut metrics, 0, 1000)
  let mut header: [u8; 38] = [0; 38]
  let headerSize = metricHeader(&mut header, 1, extendedMetrics, false)
  let mut headerTag: u32 = 1751672161
  let mut metricTag: u32 = 1752003704
  if extendedMetrics {
    headerTag = 1212695873
    metricTag = 1213027416
  }
  let mut tables = [TestTable { tag: 0, data: &head }; 9]
  tables[0] = TestTable { tag: 1751474532, data: &head }
  tables[1] = TestTable { tag: 1296128080, data: &profile }
  tables[2] = TestTable { tag: 1196185926, data: outline }
  let mut n: usize = 3
  if locationMode != 1 {
    let mut data = Slice.view<u8>(&locations, 0, 65538 * width)
    if locationMode == 2 {
      data = Slice.view<u8>(&locations, 0, 1)
    }
    tables[n] = TestTable { tag: 1280262977, data: data }
    n = n + 1
  }
  if legacy {
    tables[n] = TestTable { tag: 1835104368, data: &oldProfile }
    tables[n + 1] = TestTable { tag: 1735162214, data: oldOutline }
    tables[n + 2] = TestTable { tag: 1819239265, data: Slice.view<u8>(&oldLocations, 0, 4 * width) }
    n = n + 3
  }
  tables[n] = TestTable { tag: headerTag, data: Slice.view<u8>(&header, 0, headerSize) }
  tables[n + 1] = TestTable { tag: metricTag, data: &metrics }
  n = n + 2
  return font(move out, Slice.view<TestTable>(&tables, 0, n))
}
