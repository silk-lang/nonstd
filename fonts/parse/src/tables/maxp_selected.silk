import generated_maxp { Maxp, MaxpExtended }
import font_types.lib { Version16Dot16, MajorMinor, FWord, UfWord, Uint24 }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.u16

pub union SelectedMaxp<'a> {
  Original { pub table: Maxp<'a> },
  Extended { pub table: MaxpExtended<'a> },
}

impl<'a> Copy for SelectedMaxp<'a> {}

impl<'a> SelectedMaxp<'a> {
  pub fn numGlyphs(self: &Self) -> u32 {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => u16.toU32(Maxp<'a>.numGlyphs(&table))
      SelectedMaxp<'a>.Extended { table } => Uint24.toU32(MaxpExtended<'a>.numGlyphs(&table))
    }
  }

  pub fn version(self: &Self) -> Version16Dot16 {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.version(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.version(&table)
    }
  }

  pub fn maxPoints(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxPoints(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxPoints(&table)
    }
  }

  pub fn maxContours(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxContours(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxContours(&table)
    }
  }

  pub fn maxCompositePoints(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxCompositePoints(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxCompositePoints(&table)
    }
  }

  pub fn maxCompositeContours(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxCompositeContours(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxCompositeContours(&table)
    }
  }

  pub fn maxZones(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxZones(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxZones(&table)
    }
  }

  pub fn maxTwilightPoints(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxTwilightPoints(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxTwilightPoints(&table)
    }
  }

  pub fn maxStorage(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxStorage(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxStorage(&table)
    }
  }

  pub fn maxFunctionDefs(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxFunctionDefs(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxFunctionDefs(&table)
    }
  }

  pub fn maxInstructionDefs(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxInstructionDefs(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxInstructionDefs(&table)
    }
  }

  pub fn maxStackElements(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxStackElements(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxStackElements(&table)
    }
  }

  pub fn maxSizeOfInstructions(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxSizeOfInstructions(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxSizeOfInstructions(&table)
    }
  }

  pub fn maxComponentElements(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxComponentElements(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxComponentElements(&table)
    }
  }

  pub fn maxComponentDepth(self: &Self) -> Option<u16> {
    return match &self.* {
      SelectedMaxp<'a>.Original { table } => Maxp<'a>.maxComponentDepth(&table)
      SelectedMaxp<'a>.Extended { table } => MaxpExtended<'a>.maxComponentDepth(&table)
    }
  }
}
