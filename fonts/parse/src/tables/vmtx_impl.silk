  }

  pub fn sideBearing(self: &Self, glyph: GlyphId) -> Option<i16> {
    return GlyphMetricRecords.sideBearing(
      &GlyphMetricRecords.new(VmtxExtended.vMetrics(self), VmtxExtended.topSideBearings(self)),
      glyph,
    )
  }
}
