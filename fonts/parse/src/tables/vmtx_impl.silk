import tables.hmtx { GlyphMetricRecords }

impl<'a> Vmtx<'a> {
  pub fn advance(self: &Self, glyph: GlyphId) -> Option<u16> {
    return GlyphMetricRecords.advance(
      &GlyphMetricRecords.new(Vmtx.vMetrics(self), Vmtx.topSideBearings(self)),
      glyph,
    )
  }

  pub fn sideBearing(self: &Self, glyph: GlyphId) -> Option<i16> {
    return GlyphMetricRecords.sideBearing(
      &GlyphMetricRecords.new(Vmtx.vMetrics(self), Vmtx.topSideBearings(self)),
      glyph,
    )
  }
}

impl<'a> VmtxExtended<'a> {
  pub fn advance(self: &Self, glyph: GlyphId) -> Option<u16> {
    return GlyphMetricRecords.advance(
      &GlyphMetricRecords.new(VmtxExtended.vMetrics(self), VmtxExtended.topSideBearings(self)),
      glyph,
