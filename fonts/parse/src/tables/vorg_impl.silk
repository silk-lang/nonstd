impl<'a> Vorg<'a> {
  pub fn verticalOriginY(self: &Self, glyph: GlyphId) -> i16 {
    let records = Vorg.vertOriginYMetrics(self)
    let count = ComputedArray<'a, (), VertOriginYMetrics<'a>>.len(&records)
    let mut low: usize = 0
    let mut high = count
    let wanted = GlyphId.toU32(glyph)

    // Rust slice binary_search returns the rightmost equal record.
    while low < high {
      let mid = low + (high - low) / 2
      let record = match move ComputedArray<'a, (), VertOriginYMetrics<'a>>.get(&records, mid) {
        Result<VertOriginYMetrics<'a>, ReadError>.Success { value } => value
        _ => {
          return Vorg.defaultVertOriginY(self)
        }
      }
      if u16.toU32(GlyphId16.toU16(VertOriginYMetrics.glyphIndex(&record))) <= wanted {
        low = mid + 1
      } else {
        high = mid
      }
    }
    if low > 0 {
      if let Result<VertOriginYMetrics<'a>, ReadError>.Success { value } = move ComputedArray<
        'a,
        (),
        VertOriginYMetrics<'a>
      >.get(&records, low - 1) {
        if u16.toU32(GlyphId16.toU16(VertOriginYMetrics.glyphIndex(&value))) == wanted {
          return VertOriginYMetrics.vertOriginY(&value)
        }
      }
    }
    return Vorg.defaultVertOriginY(self)
  }
}
