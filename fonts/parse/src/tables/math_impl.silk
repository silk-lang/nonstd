pub enum(u8) MathKernCorner {
  TopRight = 0,
  TopLeft = 1,
  BottomRight = 2,
  BottomLeft = 3,
}

pub enum(u8) StretchAxis {
  Horizontal = 0,
  Vertical = 1,
}

pub struct MathValue {
  pub value: i32,
  pub deltaPx: i32,
}

impl Copy for MathValue {}

impl MathValue {
  pub fn default() -> Self {
    return Self { value: 0, deltaPx: 0 }
  }
}

impl Equal for MathValue {
  fn equals(a: &Self, b: &Self) -> bool {
    return a.value == b.value && a.deltaPx == b.deltaPx
  }
}

pub struct MathKernEntry {
  pub maxHeight: Option<MathValue>,
  pub kern: MathValue,
}

fn mathOk<T>(result: Result<T, ReadError>) -> Option<T> {
  return match move result {
    Result<T, ReadError>.Success { value } => Option<T>.some(move value)
    _ => Option<T>.None
  }
}

fn mathOptional<T>(result: Option<Result<T, ReadError>>) -> Option<T> {
  return match move result {
    Option<Result<T, ReadError>>.Some { value } => mathOk(move value)
    _ => Option<T>.None
  }
}

impl<'a> Math<'a> {
  pub fn hasSwappedMinHeights(self: &Self) -> bool {
    if FontData.len(&Math.offsetData(self)) != 25722 {
      return false
    }
    let constants = match move Math.mathConstants(self) {
      Result<MathConstants<'a>, ReadError>.Success { value } => value
      _ => {
        return false
      }
    }
    return UfWord.toU16(MathConstants.delimitedSubFormulaMinHeight(&constants)) == 3000
      && UfWord.toU16(MathConstants.displayOperatorMinHeight(&constants)) == 2500
  }
}

impl<'a> MathValueRecord<'a> {
  pub fn valueForPpem(self: &Self, data: FontData<'a>, ppem: u16) -> MathValue {
    let mut delta: i32 = 0
    if let Option<DeviceOrVariationIndex<'a>>.Some { value } = move mathOptional(
      MathValueRecord.device(self, data),
    ) {
      if let DeviceOrVariationIndex<'a>.Device { value: device } = value {
        delta = Device.deltaForPpem(&device, ppem)
      }
    }
    return MathValue { value: i16.toI32(FWord.toI16(MathValueRecord.value(self))), deltaPx: delta }
  }
}

impl<'a> MathGlyphInfo<'a> {
  pub fn isExtendedShape(self: &Self, glyph: GlyphId) -> bool {
    if let Option<CoverageTable<'a>>.Some { value } = move mathOptional(
      MathGlyphInfo.extendedShapeCoverage(self),
    ) {
      if let Option<u32>.Some { value: index } = move CoverageTable.get(&value, glyph) {
        return true
      }
    }
    return false
  }
}

impl<'a> MathItalicsCorrectionInfo<'a> {
  pub fn correction(self: &Self, glyph: GlyphId) -> Option<i32> {
    let record = match move MathItalicsCorrectionInfo.record(self, glyph) {
      Option<MathValueRecord<'a>>.Some { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    return Option<i32>.some(i16.toI32(FWord.toI16(MathValueRecord.value(&record))))
  }

  pub fn correctionForPpem(self: &Self, glyph: GlyphId, ppem: u16) -> Option<MathValue> {
    let record = match move MathItalicsCorrectionInfo.record(self, glyph) {
      Option<MathValueRecord<'a>>.Some { value } => value
      _ => {
        return Option<MathValue>.None
      }
    }
    return Option<MathValue>.some(
      MathValueRecord.valueForPpem(&record, MathItalicsCorrectionInfo.offsetData(self), ppem),
    )
  }

  fn record(self: &Self, glyph: GlyphId) -> Option<MathValueRecord<'a>> {
    let coverage = match move MathItalicsCorrectionInfo.coverage(self) {
      Result<CoverageTable<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MathValueRecord<'a>>.None
      }
    }
    let index = match move CoverageTable.get(&coverage, glyph) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Option<MathValueRecord<'a>>.None
      }
    }
    return mathOk(
      ComputedArray<'a, (), MathValueRecord<'a>>.get(
        &MathItalicsCorrectionInfo.italicsCorrection(self),
        index,
      ),
    )
  }
}

