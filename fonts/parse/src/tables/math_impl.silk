  pub fn attachment(self: &Self, glyph: GlyphId) -> Option<i32> {
    let record = match move MathTopAccentAttachment.record(self, glyph) {
      Option<MathValueRecord<'a>>.Some { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    return Option<i32>.some(i16.toI32(FWord.toI16(MathValueRecord.value(&record))))
  }

  pub fn attachmentForPpem(self: &Self, glyph: GlyphId, ppem: u16) -> Option<MathValue> {
    let record = match move MathTopAccentAttachment.record(self, glyph) {
      Option<MathValueRecord<'a>>.Some { value } => value
      _ => {
        return Option<MathValue>.None
      }
    }
    return Option<MathValue>.some(
      MathValueRecord.valueForPpem(&record, MathTopAccentAttachment.offsetData(self), ppem),
    )
  }

  fn record(self: &Self, glyph: GlyphId) -> Option<MathValueRecord<'a>> {
    let coverage = match move MathTopAccentAttachment.topAccentCoverage(self) {
      Result<CoverageTable<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MathValueRecord<'a>>.None
      }
    }
    let index = match move CoverageTable.get(&coverage, glyph) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Option<MathValueRecord<'a>>.None
      }
    }
    return mathOk(
      ComputedArray<'a, (), MathValueRecord<'a>>.get(
        &MathTopAccentAttachment.topAccentAttachment(self),
        index,
      ),
    )
  }
}

impl<'a> MathKernInfo<'a> {
  pub fn kern(self: &Self, glyph: GlyphId, corner: MathKernCorner) -> Option<MathKern<'a>> {
    let coverage = match move MathKernInfo.mathKernCoverage(self) {
      Result<CoverageTable<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MathKern<'a>>.None
      }
    }
    let index = match move CoverageTable.get(&coverage, glyph) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Option<MathKern<'a>>.None
      }
    }
    let record = match move ComputedArray<'a, (), MathKernInfoRecord<'a>>.get(
      &MathKernInfo.mathKernInfoRecords(self),
      index,
    ) {
      Result<MathKernInfoRecord<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MathKern<'a>>.None
      }
    }
    let data = MathKernInfo.offsetData(self)
    return mathOptional(
      match corner {
        MathKernCorner.TopRight => MathKernInfoRecord.topRightMathKern(&record, data)
        MathKernCorner.TopLeft => MathKernInfoRecord.topLeftMathKern(&record, data)
        MathKernCorner.BottomRight => MathKernInfoRecord.bottomRightMathKern(&record, data)
        MathKernCorner.BottomLeft => MathKernInfoRecord.bottomLeftMathKern(&record, data)
      },
    )
  }
}

impl<'a> MathKern<'a> {
  pub fn kerning(self: &Self, correctionHeight: i32) -> Option<i32> {
    let record = match move ComputedArray<'a, (), MathValueRecord<'a>>.get(
      &MathKern.kernValues(self),
      MathKern.band(self, correctionHeight),
    ) {
      Result<MathValueRecord<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    return Option<i32>.some(i16.toI32(FWord.toI16(MathValueRecord.value(&record))))
  }

  pub fn entriesForPpem(self: &Self, ppem: u16) -> MathKernEntryIter<'a> {
    return MathKernEntryIter<'a> {
      heights: MathKern.correctionHeight(self),
      kerns: MathKern.kernValues(self),
      data: MathKern.offsetData(self),
      ppem: ppem,
      index: 0,
    }
  }

  fn band(self: &Self, correctionHeight: i32) -> usize {
    let heights = MathKern.correctionHeight(self)
    let length = ComputedArray<'a, (), MathValueRecord<'a>>.len(&heights)
    let mut index: usize = 0
    while index < length {
      if let Result<MathValueRecord<'a>, ReadError>.Success { value } = move ComputedArray<
        'a,
        (),
        MathValueRecord<'a>
      >.get(&heights, index) {
        if correctionHeight < i16.toI32(FWord.toI16(MathValueRecord.value(&value))) {
          return index
        }
      }
      index = index + 1
    }
    return length
  }
}

pub struct MathKernEntryIter<'a> {
  heights: ComputedArray<'a, (), MathValueRecord<'a>>,
  kerns: ComputedArray<'a, (), MathValueRecord<'a>>,
  data: FontData<'a>,
  ppem: u16,
  index: usize,
}

impl<'a> Copy for MathKernEntryIter<'a> {}

impl<'a> MathKernEntryIter<'a> {
  pub fn next(self: &mut Self) -> Option<MathKernEntry> {
    let kern = match move ComputedArray<'a, (), MathValueRecord<'a>>.get(&self.kerns, self.index) {
      Result<MathValueRecord<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<MathKernEntry>.None
      }
    }
    let height = match move ComputedArray<'a, (), MathValueRecord<'a>>.get(
      &self.heights,
      self.index,
    ) {
      Result<MathValueRecord<'a>, ReadError>.Success { value } => Option<MathValue>.some(
        MathValueRecord.valueForPpem(&value, self.data, self.ppem),
      )
      _ => Option<MathValue>.None
    }
    self.index = self.index + 1
    return Option<MathKernEntry>.some(
      MathKernEntry {
        maxHeight: move height,
        kern: MathValueRecord.valueForPpem(&kern, self.data, self.ppem),
      },
    )
  }
}

impl<'a> MathVariants<'a> {
  pub fn glyphConstruction(self: &Self, glyph: GlyphId, axis: StretchAxis) -> Option<
    MathGlyphConstruction<'a>
  > {
    let selected = match axis {
      StretchAxis.Vertical => MathVariants.vertGlyphCoverage(self)
      StretchAxis.Horizontal => MathVariants.horizGlyphCoverage(self)
    }
    let coverage = match move mathOptional(move selected) {
      Option<CoverageTable<'a>>.Some { value } => value
      _ => {
        return Option<MathGlyphConstruction<'a>>.None
      }
    }
    let index = match move CoverageTable.get(&coverage, glyph) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Option<MathGlyphConstruction<'a>>.None
      }
    }
    let constructions = match axis {
      StretchAxis.Vertical => MathVariants.vertGlyphConstructions(self)
      StretchAxis.Horizontal => MathVariants.horizGlyphConstructions(self)
    }
    return mathOk(
      ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.get(&constructions, index),
    )
  }
}

impl<'a> GlyphAssembly<'a> {
  pub fn italicsCorrectionForPpem(self: &Self, ppem: u16) -> MathValue {
    return MathValueRecord.valueForPpem(
      &GlyphAssembly.italicsCorrection(self),
      GlyphAssembly.offsetData(self),
      ppem,
    )
  }
}
