import read { VarSize }

impl<'a> VarSize for Subtable<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    return match move FontData<'b>.readAt<u32>(&data, position) {
      Result<u32, ReadError>.Success { value } => Option<usize>.some(u32.toUsize(value))
      _ => Option<usize>.None
    }
  }
}

import generated_aat { ExtendedStateTable, LookupU16, LookupU32, TypedLookup, safeReadArrayToEnd }
import font_types.lib { BigEndian }

impl<'a> Subtable<'a> {
  pub fn headerLen() -> usize {
    return 12
  }

  pub fn isVertical(self: &Self) -> bool {
    return Subtable.coverage(self) & 2147483648 != 0
  }

  pub fn isHorizontal(self: &Self) -> bool {
    return !Subtable.isVertical(self)
  }

  pub fn isCrossStream(self: &Self) -> bool {
    return Subtable.coverage(self) & 1073741824 != 0
  }

  pub fn isVariable(self: &Self) -> bool {
    return Subtable.coverage(self) & 536870912 != 0
  }

  pub fn processDirection(self: &Self) -> bool {
    return Subtable.coverage(self) & 268435456 != 0
  }

  pub fn kind(self: &Self) -> Result<SubtableKind<'a>, ReadError> {
    return SubtableKind<'a>.readWithArgs(
      ScalarArray<u8>.offsetData(&Subtable.data(self)),
      ReadArgs2<u32, u32> { first: Subtable.coverage(self), second: Subtable.tupleCount(self) },
    )
  }
}

pub union SubtableKind<'a> {
  Format0 { pub value: Subtable0<'a> },
  Format1 { pub value: Subtable1<'a> },
  Format2 { pub value: Subtable2<'a> },
  Format4 { pub value: Subtable4<'a> },
  Format6 { pub value: Subtable6<'a> },
}

impl<'a> SubtableKind<'a> {
  pub fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u32, u32>) -> Result<Self, ReadError> {
    let format = args.first & 255
    if format == 0 {
      let value = match move Subtable0<'a>.read(data) {
        Result<Subtable0<'a>, ReadError>.Success { value } => value
        Result<Subtable0<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format0 { value: move value })
    }
    if format == 1 {
      let value = match move Subtable1<'a>.read(data) {
        Result<Subtable1<'a>, ReadError>.Success { value } => value
        Result<Subtable1<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format1 { value: move value })
    }
    if format == 2 {
      let value = match move Subtable2<'a>.read(data) {
        Result<Subtable2<'a>, ReadError>.Success { value } => value
        Result<Subtable2<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format2 { value: move value })
    }
    if format == 4 {
      let value = match move Subtable4<'a>.read(data) {
        Result<Subtable4<'a>, ReadError>.Success { value } => value
        Result<Subtable4<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format4 { value: move value })
    }
    if format == 6 {
      let value = match move Subtable6<'a>.readWithArgs(data, args.second) {
        Result<Subtable6<'a>, ReadError>.Success { value } => move value
        Result<Subtable6<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Format6 { value: move value })
    }
    return Result<Self, ReadError>.failResult(ReadError.InvalidFormat { value: u32.toI64(format) })
  }
}

impl<'a> FontRead<'a, ReadArgs2<u32, u32>> for SubtableKind<'a> {
  fn readWithArgs(data: FontData<'a>, args: ReadArgs2<u32, u32>) -> Result<Self, ReadError> {
    return SubtableKind<'a>.readWithArgs(data, args)
  }
}

impl<'a> Subtable0<'a> {
  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    return pairKerning(Subtable0.pairs(self), left, right)
  }
}

/// Shared pair search used by the legacy kern table.
pub fn pairKerning<'a>(
  pairs: ComputedArray<'a, (), Subtable0Pair<'a>>,
  left: GlyphId,
  right: GlyphId,
) -> Option<i32> {
  let l = GlyphId.toU32(left)
  let r = GlyphId.toU32(right)
  if l > 65535 || r > 65535 {
    return Option<i32>.None
  }
  let key = u32.shiftLeft(l, 16) | r
  let mut low: usize = 0
  let mut size = ComputedArray<'a, (), Subtable0Pair<'a>>.len(&pairs)
  if size == 0 {
    return Option<i32>.None
  }

  // Match Rust slice::binary_search, including malformed unsorted records.
  while size > 1 {
    let half = size / 2
    let mid = low + half
    let pair = match move ComputedArray<'a, (), Subtable0Pair<'a>>.get(&pairs, mid) {
      Result<Subtable0Pair<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<i32>.None
      }
    }
    let candidate = u32.shiftLeft(GlyphId16.toU32(Subtable0Pair.left(&pair)), 16)
      | GlyphId16.toU32(Subtable0Pair.right(&pair))
    if candidate <= key {
      low = mid
    }
    size = size - half
  }
  let pair = match move ComputedArray<'a, (), Subtable0Pair<'a>>.get(&pairs, low) {
    Result<Subtable0Pair<'a>, ReadError>.Success { value } => value
    _ => {
      return Option<i32>.None
    }
  }
  if GlyphId16.toU32(Subtable0Pair.left(&pair)) != l
    || GlyphId16.toU32(Subtable0Pair.right(&pair)) != r {
    return Option<i32>.None
  }
  return Option<i32>.some(i16.toI32(Subtable0Pair.value(&pair)))
}

pub struct Subtable1<'a> {
  pub stateTable: ExtendedStateTable<'a, BigEndian<u16>>,
  pub values: ScalarArray<'a, i16>,
}

impl<'a> Copy for Subtable1<'a> {}

impl<'a> Subtable1<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, BigEndian<u16>>.read(data) {
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let values = match move safeReadArrayToEnd<i16>(&data, offset) {
      Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, values: values })
  }
}

pub struct Subtable2<'a> {
  pub data: FontData<'a>,
  pub leftOffsetTable: LookupU16<'a>,
  pub rightOffsetTable: LookupU16<'a>,
  pub array: ScalarArray<'a, i16>,
}

impl<'a> Copy for Subtable2<'a> {}

impl<'a> Subtable2<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let leftRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 4) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let leftOffset = match move usize.checkedSubtract(leftRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let rightRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 8) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let rightOffset = match move usize.checkedSubtract(rightRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let arrayRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 12) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let arrayOffset = match move usize.checkedSubtract(arrayRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let leftData = match move FontData.splitOff(&data, leftOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let left = match move TypedLookup<'a, u16>.read(leftData) {
      Result<LookupU16<'a>, ReadError>.Success { value } => value
      Result<LookupU16<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let rightData = match move FontData.splitOff(&data, rightOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let right = match move TypedLookup<'a, u16>.read(rightData) {
      Result<LookupU16<'a>, ReadError>.Success { value } => value
      Result<LookupU16<'a>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let array = match move safeReadArrayToEnd<i16>(&data, arrayOffset) {
      Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(
      Self { data: data, leftOffsetTable: left, rightOffsetTable: right, array: array },
    )
  }

  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    let l = GlyphId.toU32(left)
    let r = GlyphId.toU32(right)
    if l > 65535 || r > 65535 {
      return Option<i32>.None
    }
    let li = TypedLookup<'a, u16>.value(&self.leftOffsetTable, u32.toU16(l))
      |> Result<u16, ReadError>.unwrapOr(0)
    let ri = TypedLookup<'a, u16>.value(&self.rightOffsetTable, u32.toU16(r))
      |> Result<u16, ReadError>.unwrapOr(0)
    return match move ScalarArray<i16>.get(&self.array, u16.toUsize(li) + u16.toUsize(ri)) {
      Option<i16>.Some { value } => Option<i32>.some(i16.toI32(value))
      _ => Option<i32>.None
    }
  }
}

pub union Subtable4Actions<'a> {
  ControlPoints { pub values: ScalarArray<'a, u16> },
  AnchorPoints { pub values: ScalarArray<'a, u16> },
  ControlPointCoords { pub values: ScalarArray<'a, i16> },
}

impl<'a> Copy for Subtable4Actions<'a> {}

pub struct Subtable4<'a> {
  pub stateTable: ExtendedStateTable<'a, BigEndian<u16>>,
  pub flags: u32,
  pub actions: Subtable4Actions<'a>,
}

impl<'a> Copy for Subtable4<'a> {}

impl<'a> Subtable4<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move ExtendedStateTable<'a, BigEndian<u16>>.read(data) {
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Success { value } => value
      Result<ExtendedStateTable<'a, BigEndian<u16>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let flags = match move FontData<'a>.readAt<u32>(&data, 16) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let actionType = u32.shiftRight(flags & 3221225472, 30)
    let offset = u32.toUsize(flags & 16777215)
    if actionType == 0 {
      let values = match move safeReadArrayToEnd<u16>(&data, offset) {
        Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
        Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(
        Self {
          stateTable: state,
          flags: flags,
          actions: Subtable4Actions<'a>.ControlPoints { values: values },
        },
      )
    }
    if actionType == 1 {
      let values = match move safeReadArrayToEnd<u16>(&data, offset) {
        Result<ScalarArray<'a, u16>, ReadError>.Success { value } => value
        Result<ScalarArray<'a, u16>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(
        Self {
          stateTable: state,
          flags: flags,
          actions: Subtable4Actions<'a>.AnchorPoints { values: values },
        },
      )
    }
    if actionType == 2 {
      let values = match move safeReadArrayToEnd<i16>(&data, offset) {
        Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
        Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(
        Self {
          stateTable: state,
          flags: flags,
          actions: Subtable4Actions<'a>.ControlPointCoords { values: values },
        },
      )
    }
    return Result<Self, ReadError>.failResult(
      ReadError.MalformedData { message: "invalid action type in kerx subtable 4" },
    )
  }
}

pub union Subtable6<'a> {
  ShortValues {
    pub rows: LookupU16<'a>,
    pub columns: LookupU16<'a>,
    pub array: ScalarArray<'a, i16>,
    pub vector: Option<ScalarArray<'a, i16>>
  },
  LongValues {
    pub rows: LookupU32<'a>,
    pub columns: LookupU32<'a>,
    pub array: ScalarArray<'a, i32>,
    pub vector: Option<ScalarArray<'a, i16>>
  },
}

impl<'a> Subtable6<'a> {
  pub fn readWithArgs(data: FontData<'a>, tupleCount: u32) -> Result<Self, ReadError> {
    let flags = match move FontData<'a>.readAt<u32>(&data, 0) {
      Result<u32, ReadError>.Success { value } => value
      Result<u32, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let rowRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 8) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let rowOffset = match move usize.checkedSubtract(rowRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let columnRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 12) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let columnOffset = match move usize.checkedSubtract(columnRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let arrayRaw = u32.toUsize(
      match move FontData<'a>.readAt<u32>(&data, 16) {
        Result<u32, ReadError>.Success { value } => value
        Result<u32, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let arrayOffset = match move usize.checkedSubtract(arrayRaw, 12) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let mut vector: Option<ScalarArray<'a, i16>> = Option<ScalarArray<'a, i16>>.None
    if tupleCount != 0 {
      let vectorRaw = u32.toUsize(
        match move FontData<'a>.readAt<u32>(&data, 20) {
          Result<u32, ReadError>.Success { value } => value
          Result<u32, ReadError>.Failure { error } => {
            return Result<Self, ReadError>.failResult(error)
          }
        },
      )
      let vectorOffset = match move usize.checkedSubtract(vectorRaw, 12) {
        Option<usize>.Some { value } => value
        _ => {
          return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
        }
      }
      vector = Option<ScalarArray<'a, i16>>.some(
        match move safeReadArrayToEnd<i16>(&data, vectorOffset) {
          Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
          Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => {
            return Result<Self, ReadError>.failResult(error)
          }
        },
      )
    }
    let rowData = match move FontData.splitOff(&data, rowOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let columnData = match move FontData.splitOff(&data, columnOffset) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    if flags & 1 == 0 {
      let rows = match move TypedLookup<'a, u16>.read(rowData) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      let columns = match move TypedLookup<'a, u16>.read(columnData) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      let array = match move safeReadArrayToEnd<i16>(&data, arrayOffset) {
        Result<ScalarArray<'a, i16>, ReadError>.Success { value } => value
        Result<ScalarArray<'a, i16>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(
        Subtable6<'a>.ShortValues {
          rows: rows,
          columns: columns,
          array: array,
          vector: move vector
        },
      )
    } else {
      let rows = match move TypedLookup<'a, u32>.read(rowData) {
        Result<LookupU32<'a>, ReadError>.Success { value } => value
        Result<LookupU32<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      let columns = match move TypedLookup<'a, u32>.read(columnData) {
        Result<LookupU32<'a>, ReadError>.Success { value } => value
        Result<LookupU32<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      let array = match move safeReadArrayToEnd<i32>(&data, arrayOffset) {
        Result<ScalarArray<'a, i32>, ReadError>.Success { value } => value
        Result<ScalarArray<'a, i32>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(
        Subtable6<'a>.LongValues {
          rows: rows,
          columns: columns,
          array: array,
          vector: move vector
        },
      )
    }
  }

  pub fn kerning(self: &Self, left: GlyphId, right: GlyphId) -> Option<i32> {
    let l = GlyphId.toU32(left)
    let r = GlyphId.toU32(right)
    if l > 65535 || r > 65535 {
      return Option<i32>.None
    }
    match &self.* {
      Subtable6<'a>.ShortValues { rows, columns, array, vector } => {
        let li = TypedLookup<'a, u16>.value(&rows, u32.toU16(l))
          |> Result<u16, ReadError>.unwrapOr(0)
        let ri = TypedLookup<'a, u16>.value(&columns, u32.toU16(r))
          |> Result<u16, ReadError>.unwrapOr(0)
        let index = match move usize.checkedAdd(u16.toUsize(li), u16.toUsize(ri)) {
          Option<usize>.Some { value } => value
          _ => {
            return Option<i32>.None
          }
        }
        let value = match move ScalarArray<i16>.get(&array, index) {
          Option<i16>.Some { value } => i16.toI32(value)
          _ => {
            return Option<i32>.None
          }
        }
        return tupleKern(value, &vector)
      }
      Subtable6<'a>.LongValues { rows, columns, array, vector } => {
        let li = TypedLookup<'a, u32>.value(&rows, u32.toU16(l))
          |> Result<u32, ReadError>.unwrapOr(0)
        let ri = TypedLookup<'a, u32>.value(&columns, u32.toU16(r))
          |> Result<u32, ReadError>.unwrapOr(0)
        let index = match move usize.checkedAdd(u32.toUsize(li), u32.toUsize(ri)) {
          Option<usize>.Some { value } => value
          _ => {
            return Option<i32>.None
          }
        }
        let value = match move ScalarArray<i32>.get(&array, index) {
          Option<i32>.Some { value } => value
          _ => {
            return Option<i32>.None
          }
        }
        return tupleKern(value, &vector)
      }
    }
  }
}

fn tupleKern<'a>(value: i32, vector: &Option<ScalarArray<'a, i16>>) -> Option<i32> {
  match &vector.* {
    Option<ScalarArray<'a, i16>>.Some { value: values } => {
      // Rust's negative signed-to-usize cast yields an unreachable vector index.
      if value < 0 {
        return Option<i32>.None
      }
      return match move ScalarArray<i16>.get(&values, i32.toUsize(value) / 2) {
        Option<i16>.Some { value: found } => Option<i32>.some(i16.toI32(found))
        _ => Option<i32>.None
      }
    }
    Option<ScalarArray<'a, i16>>.None => {
      return Option<i32>.some(value)
    }
  }
}

impl<'a> FontRead<'a, ()> for Subtable1<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Subtable1<'a>.read(data)
  }
}

impl<'a> FontRead<'a, ()> for Subtable2<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Subtable2<'a>.read(data)
  }
}

impl<'a> FontRead<'a, ()> for Subtable4<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return Subtable4<'a>.read(data)
  }
}

impl<'a> FontRead<'a, u32> for Subtable6<'a> {
  fn readWithArgs(data: FontData<'a>, args: u32) -> Result<Self, ReadError> {
    return Subtable6<'a>.readWithArgs(data, args)
  }
}
