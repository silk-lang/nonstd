impl<'a> Strike<'a> {
  pub fn glyphData(self: &Self, glyphId: GlyphId) -> Result<Option<GlyphData<'a>>, ReadError> {
    let offsets = Strike.glyphDataOffsets(self)
    let index = u32.toUsize(GlyphId.toU32(glyphId))
    let start = match move ScalarArray<u32>.get(&offsets, index) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Result<Option<GlyphData<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let next = match move usize.checkedAdd(index, 1) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<Option<GlyphData<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    let end = match move ScalarArray<u32>.get(&offsets, next) {
      Option<u32>.Some { value } => u32.toUsize(value)
      _ => {
        return Result<Option<GlyphData<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    if start == end {
      return Result<Option<GlyphData<'a>>, ReadError>.succeed(Option<GlyphData<'a>>.None)
    }
    let data = match move FontData.slice(&Strike.offsetData(self), start, end) {
      Option<FontData<'a>>.Some { value } => value
      _ => {
        return Result<Option<GlyphData<'a>>, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return match move GlyphData.read(data) {
      Result<GlyphData<'a>, ReadError>.Success { value } => Result<
        Option<GlyphData<'a>>,
        ReadError
      >.succeed(Option<GlyphData<'a>>.some(value))
      Result<GlyphData<'a>, ReadError>.Failure { error } => Result<
        Option<GlyphData<'a>>,
        ReadError
      >.failResult(error)
    }
  }
}
