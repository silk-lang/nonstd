import read { VarSize }

impl<'a> VarSize for Chain<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    let offset = match move usize.checkedAdd(position, 4) {
      Option<usize>.Some { value } => value
      _ => {
        return Option<usize>.None
      }
    }
    return match move FontData<'b>.readAt<u32>(&data, offset) {
      Result<u32, ReadError>.Success { value } => Option<usize>.some(u32.toUsize(value))
      _ => Option<usize>.None
    }
  }
}

impl<'a> VarSize for Subtable<'a> {
  fn readLenAt<'b>(data: FontData<'b>, position: usize) -> Option<usize> {
    return match move FontData<'b>.readAt<u16>(&data, position) {
      Result<u16, ReadError>.Success { value } => Option<usize>.some(u16.toUsize(value))
      _ => Option<usize>.None
    }
  }
}

import generated_aat {
  StateTable,
  LegacyStateTableParts,
  NoPayload,
  LookupU16,
  TypedLookup,
  safeReadArrayToEnd
}
import font_types.lib { BigEndian }

impl<'a> FontRead<'a, ()> for ContextualEntryData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ContextualEntryData<'a>.readAt(data, 0, ())
  }
}

impl<'a> FontRead<'a, ()> for InsertionEntryData<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return InsertionEntryData<'a>.readAt(data, 0, ())
  }
}

impl<'a> Subtable<'a> {
  pub fn isLogical(self: &Self) -> bool {
    return Subtable.coverage(self) & 4096 != 0
  }

  pub fn isAllDirections(self: &Self) -> bool {
    return Subtable.coverage(self) & 8192 != 0
  }

  pub fn isBackwards(self: &Self) -> bool {
    return Subtable.coverage(self) & 16384 != 0
  }

  pub fn isVertical(self: &Self) -> bool {
    return Subtable.coverage(self) & 32768 != 0
  }

  pub fn kind(self: &Self) -> Result<SubtableKind<'a>, ReadError> {
    return SubtableKind<'a>.readWithArgs(
      ScalarArray<u8>.offsetData(&Subtable.data(self)),
      Subtable.coverage(self),
    )
  }
}

pub union SubtableKind<'a> {
  Rearrangement { pub value: StateTable<'a, NoPayload> },
  Contextual { pub value: ContextualSubtable<'a> },
  Ligature { pub value: LigatureSubtable<'a> },
  NonContextual { pub value: LookupU16<'a> },
  Insertion { pub value: InsertionSubtable<'a> },
}

impl<'a> Copy for SubtableKind<'a> {}

pub struct SubtableParts {
  pub format: u8,
  pub state: LegacyStateTableParts,
  pub extra: [u16; 3],
}

impl Copy for SubtableParts {}

impl SubtableParts {
  pub fn default() -> Self {
    return Self { format: 0, state: LegacyStateTableParts.default(), extra: [0; 3] }
  }
}

impl<'a> SubtableKind<'a> {
  pub fn readWithArgs(data: FontData<'a>, coverage: u16) -> Result<Self, ReadError> {
    let format = coverage & 255
    if format == 0 {
      let value = match move StateTable<'a, NoPayload>.read(data) {
        Result<StateTable<'a, NoPayload>, ReadError>.Success { value } => value
        Result<StateTable<'a, NoPayload>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Rearrangement { value: value })
    }
    if format == 1 {
      let value = match move ContextualSubtable<'a>.read(data) {
        Result<ContextualSubtable<'a>, ReadError>.Success { value } => value
        Result<ContextualSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Contextual { value: value })
    }
    if format == 2 {
      let value = match move LigatureSubtable<'a>.read(data) {
        Result<LigatureSubtable<'a>, ReadError>.Success { value } => value
        Result<LigatureSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Ligature { value: value })
    }
    if format == 4 {
      let value = match move TypedLookup<'a, u16>.read(data) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.NonContextual { value: value })
    }
    if format == 5 {
      let value = match move InsertionSubtable<'a>.read(data) {
        Result<InsertionSubtable<'a>, ReadError>.Success { value } => value
        Result<InsertionSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Insertion { value: value })
    }
    return Result<Self, ReadError>.failResult(ReadError.InvalidFormat { value: u16.toI64(format) })
  }

  pub fn parts(data: FontData<'a>, coverage: u16) -> Result<SubtableParts, ReadError> {
    let mut parts = SubtableParts.default()
    parts.format = u16.toU8(coverage & 255)
    if parts.format == 4 {
      return Result<SubtableParts, ReadError>.succeed(parts)
    }
    parts.state = match move LegacyStateTableParts.read(data) {
      Result<LegacyStateTableParts, ReadError>.Success { value } => value
      Result<LegacyStateTableParts, ReadError>.Failure { error } => {
        return Result<SubtableParts, ReadError>.failResult(error)
      }
    }
    if parts.format == 1 || parts.format == 5 {
      parts.extra[0] = match move FontData<'a>.readAt<u16>(&data, 8) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
    }
    if parts.format == 2 {
      parts.extra[0] = match move FontData<'a>.readAt<u16>(&data, 8) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
      parts.extra[1] = match move FontData<'a>.readAt<u16>(&data, 10) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
      parts.extra[2] = match move FontData<'a>.readAt<u16>(&data, 12) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<SubtableParts, ReadError>.failResult(error)
        }
      }
    }
    return Result<SubtableParts, ReadError>.succeed(parts)
  }

  pub fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    if parts.format == 0 {
      let value = match move StateTable<'a, NoPayload>.fromParts(data, &parts.state) {
        Result<StateTable<'a, NoPayload>, ReadError>.Success { value } => value
        Result<StateTable<'a, NoPayload>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Rearrangement { value: value })
    }
    if parts.format == 1 {
      let value = match move ContextualSubtable<'a>.fromParts(data, parts) {
        Result<ContextualSubtable<'a>, ReadError>.Success { value } => value
        Result<ContextualSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Contextual { value: value })
    }
    if parts.format == 2 {
      let value = match move LigatureSubtable<'a>.fromParts(data, parts) {
        Result<LigatureSubtable<'a>, ReadError>.Success { value } => value
        Result<LigatureSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Ligature { value: value })
    }
    if parts.format == 4 {
      let value = match move TypedLookup<'a, u16>.read(data) {
        Result<LookupU16<'a>, ReadError>.Success { value } => value
        Result<LookupU16<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.NonContextual { value: value })
    }
    if parts.format == 5 {
      let value = match move InsertionSubtable<'a>.fromParts(data, parts) {
        Result<InsertionSubtable<'a>, ReadError>.Success { value } => value
        Result<InsertionSubtable<'a>, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      }
      return Result<Self, ReadError>.succeed(SubtableKind<'a>.Insertion { value: value })
    }
    return Result<Self, ReadError>.failResult(
      ReadError.InvalidFormat { value: u8.toI64(parts.format) },
    )
  }
}

impl<'a> FontRead<'a, u16> for SubtableKind<'a> {
  fn readWithArgs(data: FontData<'a>, args: u16) -> Result<Self, ReadError> {
    return SubtableKind<'a>.readWithArgs(data, args)
  }
}

pub struct ContextualSubtable<'a> {
  pub stateTable: StateTable<'a, ContextualEntryData<'a>>,
  data: FontData<'a>,
}

impl<'a> Copy for ContextualSubtable<'a> {}

impl<'a> ContextualSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, ContextualEntryData<'a>>.read(data) {
      Result<StateTable<'a, ContextualEntryData<'a>>, ReadError>.Success { value } => value
      Result<StateTable<'a, ContextualEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 8) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    return Result<Self, ReadError>.succeed(Self { stateTable: state, data: data })
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, ContextualEntryData<'a>>.fromParts(data, &parts.state) {
      Result<StateTable<'a, ContextualEntryData<'a>>, ReadError>.Success { value } => value
      Result<StateTable<'a, ContextualEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, data: data })
  }

  pub fn substitution(self: &Self, offset: i16, glyph: GlyphId16) -> Result<GlyphId16, ReadError> {
    let word = i16.toI32(offset) + u16.toI32(GlyphId16.toU16(glyph))
    if word < 0 {
      return Result<GlyphId16, ReadError>.failResult(ReadError.OutOfBounds)
    }
    return FontData<'a>.readAt<GlyphId16>(&self.data, i32.toUsize(word) * 2)
  }
}

impl<'a> FontRead<'a, ()> for ContextualSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return ContextualSubtable<'a>.read(data)
  }
}

pub struct LigatureSubtable<'a> {
  pub stateTable: StateTable<'a, NoPayload>,
  data: FontData<'a>,
}

impl<'a> Copy for LigatureSubtable<'a> {}

impl<'a> LigatureSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, NoPayload>.read(data) {
      Result<StateTable<'a, NoPayload>, ReadError>.Success { value } => value
      Result<StateTable<'a, NoPayload>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 8) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let offset1 = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 10) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let offset2 = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 12) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    return Result<Self, ReadError>.succeed(Self { stateTable: state, data: data })
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, NoPayload>.fromParts(data, &parts.state) {
      Result<StateTable<'a, NoPayload>, ReadError>.Success { value } => value
      Result<StateTable<'a, NoPayload>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, data: data })
  }

  pub fn ligatureAction(self: &Self, offset: usize) -> Result<u32, ReadError> {
    return FontData<'a>.readAt<u32>(&self.data, offset)
  }

  pub fn component(self: &Self, offset: i32) -> Result<u16, ReadError> {
    if offset < 0 {
      return Result<u16, ReadError>.failResult(ReadError.OutOfBounds)
    }
    let byte = match move usize.checkedMultiply(i32.toUsize(offset), 2) {
      Option<usize>.Some { value } => value
      _ => {
        return Result<u16, ReadError>.failResult(ReadError.OutOfBounds)
      }
    }
    return FontData<'a>.readAt<u16>(&self.data, byte)
  }

  pub fn ligature(self: &Self, offset: usize) -> Result<GlyphId16, ReadError> {
    return FontData<'a>.readAt<GlyphId16>(&self.data, offset)
  }
}

impl<'a> FontRead<'a, ()> for LigatureSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return LigatureSubtable<'a>.read(data)
  }
}

pub struct InsertionSubtable<'a> {
  pub stateTable: StateTable<'a, InsertionEntryData<'a>>,
  pub glyphs: ScalarArray<'a, GlyphId16>,
}

impl<'a> Copy for InsertionSubtable<'a> {}

impl<'a> InsertionSubtable<'a> {
  pub fn read(data: FontData<'a>) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, InsertionEntryData<'a>>.read(data) {
      Result<StateTable<'a, InsertionEntryData<'a>>, ReadError>.Success { value } => value
      Result<StateTable<'a, InsertionEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u16.toUsize(
      match move FontData<'a>.readAt<u16>(&data, 8) {
        Result<u16, ReadError>.Success { value } => value
        Result<u16, ReadError>.Failure { error } => {
          return Result<Self, ReadError>.failResult(error)
        }
      },
    )
    let glyphs = match move safeReadArrayToEnd<GlyphId16>(&data, offset0) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, glyphs: glyphs })
  }

  fn fromParts(data: FontData<'a>, parts: &SubtableParts) -> Result<Self, ReadError> {
    let state = match move StateTable<'a, InsertionEntryData<'a>>.fromParts(data, &parts.state) {
      Result<StateTable<'a, InsertionEntryData<'a>>, ReadError>.Success { value } => value
      Result<StateTable<'a, InsertionEntryData<'a>>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    let offset0 = u16.toUsize(parts.extra[0])
    let glyphs = match move safeReadArrayToEnd<GlyphId16>(&data, offset0) {
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Success { value } => value
      Result<ScalarArray<'a, GlyphId16>, ReadError>.Failure { error } => {
        return Result<Self, ReadError>.failResult(error)
      }
    }
    return Result<Self, ReadError>.succeed(Self { stateTable: state, glyphs: glyphs })
  }
}

impl<'a> FontRead<'a, ()> for InsertionSubtable<'a> {
  fn readWithArgs(data: FontData<'a>, args: ()) -> Result<Self, ReadError> {
    return InsertionSubtable<'a>.read(data)
  }
}
