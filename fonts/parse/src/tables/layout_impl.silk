pub union FeatureParams<'a> {
  StylisticSet { pub value: StylisticSetParams<'a> },
  Size { pub value: SizeParams<'a> },
  CharacterVariant { pub value: CharacterVariantParams<'a> },
}

impl<'a> Copy for FeatureParams<'a> {}

impl<'a> FeatureParams<'a> {
  pub fn read(data: FontData<'a>, tag: Tag) -> Result<Self, ReadError> {
    let raw = Tag.toU32(tag)
    if raw == 1936292453 {
      return match move SizeParams<'a>.read(data) {
        Result<SizeParams<'a>, ReadError>.Success { value } => Result<Self, ReadError>.succeed(
          FeatureParams<'a>.Size { value: value },
        )
        Result<SizeParams<'a>, ReadError>.Failure { error } => Result<Self, ReadError>.failResult(
          error,
        )
      }
    }
    if u32.shiftRight(raw, 16) == 29555 {
      return match move StylisticSetParams<'a>.read(data) {
        Result<StylisticSetParams<'a>, ReadError>.Success { value } => Result<
          Self,
          ReadError
        >.succeed(FeatureParams<'a>.StylisticSet { value: value })
        Result<StylisticSetParams<'a>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    if u32.shiftRight(raw, 16) == 25462 {
      return match move CharacterVariantParams<'a>.read(data) {
        Result<CharacterVariantParams<'a>, ReadError>.Success { value } => Result<
          Self,
          ReadError
        >.succeed(FeatureParams<'a>.CharacterVariant { value: value })
        Result<CharacterVariantParams<'a>, ReadError>.Failure { error } => Result<
          Self,
          ReadError
        >.failResult(error)
      }
    }
    return Result<Self, ReadError>.failResult(ReadError.InvalidFormat { value: 57005 })
  }
}

impl<'a> FontRead<'a, Tag> for FeatureParams<'a> {
  fn readWithArgs(data: FontData<'a>, args: Tag) -> Result<Self, ReadError> {
    return FeatureParams<'a>.read(data, args)
  }
}

fn deltaValueCount(format: DeltaFormat, start: u16, end: u16) -> usize {
  let count = u16.toUsize(u16.saturatingSubtract(u16.saturatingAdd(end, 1), start))
  let perWord: usize = match format {
    DeltaFormat.Local2BitDeltas => 8
    DeltaFormat.Local4BitDeltas => 4
    DeltaFormat.Local8BitDeltas => 2
    _ => {
      return 0
    }
  }
  return (count + perWord - 1) / perWord
}

pub struct HeaderOffset {
  pub offset: Offset32,
  pub extended: bool,
}

impl Copy for HeaderOffset {}

impl HeaderOffset {
  pub fn select(
    original: Nullable<Offset16>,
    extended: Option<Nullable<Offset32>>,
    hasExtended: bool,
  ) -> Result<Self, ReadError> {
    if hasExtended {
      let value = match move extended {
        Option<Nullable<Offset32>>.Some { value } => value
        Option<Nullable<Offset32>>.None => {
          return Result<Self, ReadError>.failResult(ReadError.OutOfBounds)
        }
      }
      if !Nullable<Offset32>.isNull(&value) {
        return Result<Self, ReadError>.succeed(
          Self { offset: Nullable<Offset32>.offset(&value).*, extended: true },
        )
      }
    }
    return Result<Self, ReadError>.succeed(
      Self {
        offset: Offset32.new(Offset16.toU32(Nullable<Offset16>.offset(&original).*)),
        extended: false,
      },
    )
  }

  pub fn isNull(self: &Self) -> bool {
    return Offset32.toU32(self.offset) == 0
  }

  pub fn resolve<'a, T: FontRead<'a, ()>>(self: &Self, data: FontData<'a>) -> Option<
    Result<T, ReadError>
  > {
    if HeaderOffset.isNull(self) {
      return Option<Result<T, ReadError>>.None
    }
    return Option<Result<T, ReadError>>.some(resolve<T, Offset32>(self.offset, data))
  }
}

pub union LayoutOffsetArray<'a, T: FontRead<'a, ()>> {
  Offset16 { pub value: ArrayOfOffsets<'a, (), T, Offset16> },
  Offset24 { pub value: ArrayOfOffsets<'a, (), T, Offset24> },
  Offset32 { pub value: ArrayOfOffsets<'a, (), T, Offset32> },
}

impl<'a, T: FontRead<'a, ()>> Copy for LayoutOffsetArray<'a, T> {}

impl<'a, T> LayoutOffsetArray<'a, T> {
  pub fn len(self: &Self) -> usize {
    return match &self.* {
      LayoutOffsetArray<'a, T>.Offset16 { value } => ArrayOfOffsets<'a, (), T, Offset16>.len(&value)
      LayoutOffsetArray<'a, T>.Offset24 { value } => ArrayOfOffsets<'a, (), T, Offset24>.len(&value)
      LayoutOffsetArray<'a, T>.Offset32 { value } => ArrayOfOffsets<'a, (), T, Offset32>.len(&value)
    }
  }

  pub fn isEmpty(self: &Self) -> bool {
    return LayoutOffsetArray<'a, T>.len(self) == 0
  }

  pub fn get(self: &Self, index: usize) -> Result<T, ReadError> {
    return match &self.* {
      LayoutOffsetArray<'a, T>.Offset16 { value } => ArrayOfOffsets<'a, (), T, Offset16>.get(
        &value,
        index,
      )
      LayoutOffsetArray<'a, T>.Offset24 { value } => ArrayOfOffsets<'a, (), T, Offset24>.get(
        &value,
        index,
      )
      LayoutOffsetArray<'a, T>.Offset32 { value } => ArrayOfOffsets<'a, (), T, Offset32>.get(
        &value,
        index,
      )
    }
  }

  pub fn iter(self: &Self) -> LayoutOffsetIter<'a, T> {
    return LayoutOffsetIter<'a, T> { array: self.*, index: 0 }
  }
}

pub struct LayoutOffsetIter<'a, T: FontRead<'a, ()>> {
  array: LayoutOffsetArray<'a, T>,
  index: usize,
}

impl<'a, T> LayoutOffsetIter<'a, T> {
  pub fn next(self: &mut Self) -> Option<Result<T, ReadError>> {
    if self.index >= LayoutOffsetArray<'a, T>.len(&self.array) {
      return Option<Result<T, ReadError>>.None
    }
    let value = LayoutOffsetArray<'a, T>.get(&self.array, self.index)
    self.index = self.index + 1
    return Option<Result<T, ReadError>>.some(move value)
  }

  pub fn nextAsNullable(self: &mut Self) -> Option<Option<Result<T, ReadError>>> {
    return match move LayoutOffsetIter<'a, T>.next(&mut self) {
      Option<Result<T, ReadError>>.None => Option<Option<Result<T, ReadError>>>.None
      Option<Result<T, ReadError>>.Some { value } => match move value {
        Result<T, ReadError>.Success { value: item } => Option<Option<Result<T, ReadError>>>.some(
          Option<Result<T, ReadError>>.some(Result<T, ReadError>.succeed(move item)),
        )
        Result<T, ReadError>.Failure { error: ReadError.NullOffset } => Option<
          Option<Result<T, ReadError>>
        >.some(Option<Result<T, ReadError>>.None)
        Result<T, ReadError>.Failure { error } => Option<Option<Result<T, ReadError>>>.some(
          Option<Result<T, ReadError>>.some(Result<T, ReadError>.failResult(error)),
        )
      }
    }
  }
}

pub union SelectedLookupList<'a, T: FontRead<'a, ()>> {
  Original { pub value: LookupList<'a, T> },
  Extended { pub value: LookupList2<'a, T> },
}

impl<'a, T: FontRead<'a, ()>> Copy for SelectedLookupList<'a, T> {}

impl<'a, T> SelectedLookupList<'a, T> {
  pub fn lookupCount(self: &Self) -> u16 {
    return match &self.* {
      SelectedLookupList<'a, T>.Original { value } => LookupList<'a, T>.lookupCount(&value)
      SelectedLookupList<'a, T>.Extended { value } => LookupList2<'a, T>.lookupCount(&value)
    }
  }

  pub fn lookups(self: &Self) -> LayoutOffsetArray<'a, T> {
    return match &self.* {
      SelectedLookupList<'a, T>.Original { value } => LayoutOffsetArray<'a, T>.Offset16 {
        value: LookupList<'a, T>.lookups(&value)
      }
      SelectedLookupList<'a, T>.Extended { value } => LayoutOffsetArray<'a, T>.Offset32 {
        value: LookupList2<'a, T>.lookups(&value)
      }
    }
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return match &self.* {
      SelectedLookupList<'a, T>.Original { value } => LookupList<'a, T>.offsetData(&value)
      SelectedLookupList<'a, T>.Extended { value } => LookupList2<'a, T>.offsetData(&value)
    }
  }
}

impl<'a, T> Lookup<'a, T> {
  pub fn getSubtable(self: &Self, offset: Offset16) -> Result<T, ReadError> {
    return resolve<T, Offset16>(offset, self._fontData)
  }
}

pub interface ExtensionLookup<'a, T> {
  fn extension(self: &Self) -> Result<T, ReadError>
}

pub struct Subtables<'a, T: FontRead<'a, ()>, Ext: FontRead<'a, ()> + ExtensionLookup<'a, T>> {
  offsets: ScalarArray<'a, Offset16>,
  data: FontData<'a>,
  extended: bool,
}

impl<'a, T: FontRead<'a, ()>, Ext: FontRead<'a, ()> + ExtensionLookup<'a, T>> Copy for Subtables<
  'a,
  T,
  Ext
> {}

impl<'a, T, Ext> Subtables<'a, T, Ext> {
  pub fn new(offsets: ScalarArray<'a, Offset16>, data: FontData<'a>) -> Self {
    return Self { offsets: offsets, data: data, extended: false }
  }

  pub fn newExt(offsets: ScalarArray<'a, Offset16>, data: FontData<'a>) -> Self {
    return Self { offsets: offsets, data: data, extended: true }
  }

  pub fn len(self: &Self) -> usize {
    return ScalarArray<Offset16>.len(&self.offsets)
  }

  pub fn isEmpty(self: &Self) -> bool {
    return ScalarArray<Offset16>.isEmpty(&self.offsets)
  }

  pub fn get(self: &Self, index: usize) -> Result<T, ReadError> {
    let offset = match move ScalarArray<Offset16>.get(&self.offsets, index) {
      Option<Offset16>.Some { value } => value
      Option<Offset16>.None => {
        return Result<T, ReadError>.failResult(
          ReadError.InvalidCollectionIndex { index: usize.toU32(index & 4294967295) },
        )
      }
    }
    if self.extended {
      return match move resolve<Ext, Offset16>(offset, self.data) {
        Result<Ext, ReadError>.Success { value } => ExtensionLookup.extension(&value)
        Result<Ext, ReadError>.Failure { error } => Result<T, ReadError>.failResult(error)
      }
    }
    return resolve<T, Offset16>(offset, self.data)
  }

  pub fn iter(self: &Self) -> SubtableIter<'a, T, Ext> {
    return SubtableIter<'a, T, Ext> { array: self.*, index: 0 }
  }
}

pub struct SubtableIter<'a, T: FontRead<'a, ()>, Ext: FontRead<'a, ()> + ExtensionLookup<'a, T>> {
  array: Subtables<'a, T, Ext>,
  index: usize,
}

impl<'a, T, Ext> SubtableIter<'a, T, Ext> {
  pub fn next(self: &mut Self) -> Option<Result<T, ReadError>> {
    if self.index >= Subtables<'a, T, Ext>.len(&self.array) {
      return Option<Result<T, ReadError>>.None
    }
    let value = Subtables<'a, T, Ext>.get(&self.array, self.index)
    self.index = self.index + 1
    return Option<Result<T, ReadError>>.some(move value)
  }
}
