import font_types.lib { F48Dot16 }
import generated_variations { advanceDeltaWithScalars, itemDeltaWithScalars }

impl<'a> Vvar<'a> {
  pub fn computeScalars(self: &Self, coords: &[F2Dot14], out: &mut [Fixed]) -> usize {
    return match move Vvar.itemVariationStore(self) {
      Result<ItemVariationStore<'a>, ReadError>.Success {
        value
      } => ItemVariationStore.computeScalars(&value, coords, &mut out)
      _ => 0
    }
  }

  pub fn advanceDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Vvar.advanceDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn advanceDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return advanceDeltaWithScalars(
      Vvar.advanceHeightMapping(self),
      Vvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }

  pub fn tsbDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Vvar.tsbDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn tsbDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return itemDeltaWithScalars(
      Vvar.tsbMapping(self),
      Vvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }

  pub fn bsbDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Vvar.bsbDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn bsbDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return itemDeltaWithScalars(
      Vvar.bsbMapping(self),
      Vvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }

  pub fn vOriginYDelta(self: &Self, glyphId: GlyphId, coords: &[F2Dot14]) -> Option<F48Dot16> {
    return Vvar.vOriginYDeltaWithScalars(self, glyphId, coords, &[])
  }

  pub fn vOriginYDeltaWithScalars(
    self: &Self,
    glyphId: GlyphId,
    coords: &[F2Dot14],
    scalars: &[Fixed],
  ) -> Option<F48Dot16> {
    return itemDeltaWithScalars(
      Vvar.vOrgMapping(self),
      Vvar.itemVariationStore(self),
      glyphId,
      coords,
      scalars,
    )
  }
}
