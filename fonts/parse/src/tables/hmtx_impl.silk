fn advance<'a>(metrics: ComputedArray<'a, (), LongMetric<'a>>, glyph: GlyphId) -> Option<u16> {
  let count = ComputedArray<'a, (), LongMetric<'a>>.len(&metrics)
  if count == 0 {
    return Option<u16>.None
  }
  let requested = u32.toUsize(GlyphId.toU32(glyph))
  let mut index = requested
  if index >= count {
    index = count - 1
  }
  return match move ComputedArray<'a, (), LongMetric<'a>>.get(&metrics, index) {
    Result<LongMetric<'a>, ReadError>.Success { value } => Option<u16>.some(
      LongMetric<'a>.advance(&value),
    )
    Result<LongMetric<'a>, ReadError>.Failure { error } => Option<u16>.None
  }
}

fn sideBearing<'a>(
  metrics: ComputedArray<'a, (), LongMetric<'a>>,
  bearings: ScalarArray<'a, i16>,
  glyph: GlyphId,
) -> Option<i16> {
  let index = u32.toUsize(GlyphId.toU32(glyph))
  if let Result<LongMetric<'a>, ReadError>.Success { value } = move ComputedArray<
    'a,
    (),
    LongMetric<'a>
  >.get(&metrics, index) {
    return Option<i16>.some(LongMetric<'a>.sideBearing(&value))
  }
  return ScalarArray<'a, i16>.get(
    &bearings,
    usize.saturatingSubtract(index, ComputedArray<'a, (), LongMetric<'a>>.len(&metrics)),
  )
}

impl<'a> Hmtx<'a> {
  pub fn advance(self: &Self, glyph: GlyphId) -> Option<u16> {
    return advance(Hmtx<'a>.hMetrics(self), glyph)
  }

  pub fn sideBearing(self: &Self, glyph: GlyphId) -> Option<i16> {
    return sideBearing(Hmtx<'a>.hMetrics(self), Hmtx<'a>.leftSideBearings(self), glyph)
  }
}

impl<'a> HmtxExtended<'a> {
  pub fn advance(self: &Self, glyph: GlyphId) -> Option<u16> {
    return advance(HmtxExtended<'a>.hMetrics(self), glyph)
  }

  pub fn sideBearing(self: &Self, glyph: GlyphId) -> Option<i16> {
    return sideBearing(
      HmtxExtended<'a>.hMetrics(self),
      HmtxExtended<'a>.leftSideBearings(self),
      glyph,
    )
  }
}

pub struct GlyphMetricRecords<'a> {
  metrics: ComputedArray<'a, (), LongMetric<'a>>,
  bearings: ScalarArray<'a, i16>,
}

impl<'a> Copy for GlyphMetricRecords<'a> {}

impl<'a> GlyphMetricRecords<'a> {
  pub fn new(
    metrics: ComputedArray<'a, (), LongMetric<'a>>,
    bearings: ScalarArray<'a, i16>,
  ) -> Self {
    return Self { metrics: metrics, bearings: bearings }
  }

  pub fn default() -> Self {
    return Self {
      metrics: ComputedArray<'a, (), LongMetric<'a>>.empty(()),
      bearings: ScalarArray<i16>.empty(),
    }
  }

  pub fn fromHmtx(table: Hmtx<'a>) -> Self {
    return Self { metrics: Hmtx<'a>.hMetrics(&table), bearings: Hmtx<'a>.leftSideBearings(&table) }
  }

  pub fn fromHmtxExtended(table: HmtxExtended<'a>) -> Self {
    return Self {
      metrics: HmtxExtended<'a>.hMetrics(&table),
      bearings: HmtxExtended<'a>.leftSideBearings(&table),
    }
  }

  pub fn longMetrics(self: &Self) -> ComputedArray<'a, (), LongMetric<'a>> {
    return self.metrics
  }

  pub fn sideBearings(self: &Self) -> ScalarArray<'a, i16> {
    return self.bearings
  }

  pub fn advance(self: &Self, glyph: GlyphId) -> Option<u16> {
    return advance(self.metrics, glyph)
  }

  pub fn sideBearing(self: &Self, glyph: GlyphId) -> Option<i16> {
    return sideBearing(self.metrics, self.bearings, glyph)
  }
}

import tables.vmtx { Vmtx, VmtxExtended }

impl<'a> GlyphMetricRecords<'a> {
  pub fn fromVmtx(table: Vmtx<'a>) -> Self {
    return GlyphMetricRecords.new(Vmtx.vMetrics(&table), Vmtx.topSideBearings(&table))
  }

  pub fn fromVmtxExtended(table: VmtxExtended<'a>) -> Self {
    return GlyphMetricRecords.new(
      VmtxExtended.vMetrics(&table),
      VmtxExtended.topSideBearings(&table),
    )
  }
}
