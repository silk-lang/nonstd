pub type PaintId = usize

pub struct PaintWithId<'a> {
  pub paint: Paint<'a>,
  pub id: PaintId,
}

impl<'a> Copy for PaintWithId<'a> {}

pub struct ColorLayer {
  pub glyphId: GlyphId16,
  pub paletteIndex: u16,
}

impl Copy for ColorLayer {}

fn colrOptional<T>(result: Option<Result<T, ReadError>>) -> Option<T> {
  return match move result {
    Option<Result<T, ReadError>>.Some { value } => {
      return match move value {
        Result<T, ReadError>.Success { value: table } => Option<T>.some(move table)
        _ => Option<T>.None
      }
    }
    _ => Option<T>.None
  }
}

impl<'a> Colr<'a> {
  pub fn v0BaseGlyph(self: &Self, glyphId: GlyphId) -> Option<ByteRange> {
    let gid = GlyphId.toU32(glyphId)
    if gid > 65535 {
      return Option<ByteRange>.None
    }
    let records = match move colrOptional(Colr.baseGlyphRecords(self)) {
      Option<ComputedArray<'a, (), BaseGlyph<'a>>>.Some { value } => value
      _ => {
        return Option<ByteRange>.None
      }
    }
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), BaseGlyph<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), BaseGlyph<'a>>.get(&records, mid) {
        Result<BaseGlyph<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<ByteRange>.None
        }
      }
      let current = GlyphId16.toU32(BaseGlyph.glyphId(&record))
      if current < gid {
        lo = mid + 1
      } else if current > gid {
        hi = mid
      } else {
        let start = u16.toUsize(BaseGlyph.firstLayerIndex(&record))
        let end = match move usize.checkedAdd(start, u16.toUsize(BaseGlyph.numLayers(&record))) {
          Option<usize>.Some { value } => value
          _ => {
            return Option<ByteRange>.None
          }
        }
        return Option<ByteRange>.some(ByteRange { start: start, end: end })
      }
    }
    return Option<ByteRange>.None
  }

  pub fn v0Layer(self: &Self, index: usize) -> Option<ColorLayer> {
    let records = match move colrOptional(Colr.layerRecords(self)) {
      Option<ComputedArray<'a, (), Layer<'a>>>.Some { value } => value
      _ => {
        return Option<ColorLayer>.None
      }
    }
    let layer = match move ComputedArray<'a, (), Layer<'a>>.get(&records, index) {
      Result<Layer<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<ColorLayer>.None
      }
    }
    return Option<ColorLayer>.some(
      ColorLayer { glyphId: Layer.glyphId(&layer), paletteIndex: Layer.paletteIndex(&layer) },
    )
  }

  pub fn v1BaseGlyph(self: &Self, glyphId: GlyphId) -> Option<PaintWithId<'a>> {
    let gid = GlyphId.toU32(glyphId)
    if gid > 65535 {
      return Option<PaintWithId<'a>>.None
    }
    let list = match move colrOptional(Colr.baseGlyphList(self)) {
      Option<BaseGlyphList<'a>>.Some { value } => value
      _ => {
        return Option<PaintWithId<'a>>.None
      }
    }
    let records = BaseGlyphList.baseGlyphPaintRecords(&list)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), BaseGlyphPaint<'a>>.len(&records)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<'a, (), BaseGlyphPaint<'a>>.get(&records, mid) {
        Result<BaseGlyphPaint<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<PaintWithId<'a>>.None
        }
      }
      let current = GlyphId16.toU32(BaseGlyphPaint.glyphId(&record))
      if current < gid {
        lo = mid + 1
      } else if current > gid {
        hi = mid
      } else {
        let data = BaseGlyphList.offsetData(&list)
        let paint = match move BaseGlyphPaint.paint(&record, data) {
          Result<Paint<'a>, ReadError>.Success { value } => value
          _ => {
            return Option<PaintWithId<'a>>.None
          }
        }

        // Byte identity within this COLR table replaces upstream's raw address.
        let id = FontData.len(&Colr.offsetData(self)) - FontData.len(&data)
          + u32.toUsize(Offset32.toU32(BaseGlyphPaint.paintOffset(&record)))
        return Option<PaintWithId<'a>>.some(PaintWithId<'a> { paint: paint, id: id })
      }
    }
    return Option<PaintWithId<'a>>.None
  }

  pub fn v1Layer(self: &Self, index: usize) -> Option<PaintWithId<'a>> {
    let list = match move colrOptional(Colr.layerList(self)) {
      Option<LayerList<'a>>.Some { value } => value
      _ => {
        return Option<PaintWithId<'a>>.None
      }
    }
    let offset = match move ScalarArray<Offset32>.get(&LayerList.paintOffsets(&list), index) {
      Option<Offset32>.Some { value } => value
      _ => {
        return Option<PaintWithId<'a>>.None
      }
    }
    let data = LayerList.offsetData(&list)
    let paint = match move resolve<Paint<'a>, Offset32>(offset, data) {
      Result<Paint<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<PaintWithId<'a>>.None
      }
    }
    let id = FontData.len(&Colr.offsetData(self)) - FontData.len(&data)
      + u32.toUsize(Offset32.toU32(offset))
    return Option<PaintWithId<'a>>.some(PaintWithId<'a> { paint: paint, id: id })
  }

  pub fn v1ClipBox(self: &Self, glyphId: GlyphId) -> Option<ClipBox<'a>> {
    let gid = GlyphId.toU32(glyphId)
    if gid > 65535 {
      return Option<ClipBox<'a>>.None
    }
    let list = match move colrOptional(Colr.clipList(self)) {
      Option<ClipList<'a>>.Some { value } => value
      _ => {
        return Option<ClipBox<'a>>.None
      }
    }
    let clips = ClipList.clips(&list)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, (), Clip<'a>>.len(&clips)
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let clip = match move ComputedArray<'a, (), Clip<'a>>.get(&clips, mid) {
        Result<Clip<'a>, ReadError>.Success { value } => value
        _ => {
          return Option<ClipBox<'a>>.None
        }
      }
      if gid < GlyphId16.toU32(Clip.startGlyphId(&clip)) {
        hi = mid
      } else if gid > GlyphId16.toU32(Clip.endGlyphId(&clip)) {
        lo = mid + 1
      } else {
        return match move Clip.clipBox(&clip, ClipList.offsetData(&list)) {
          Result<ClipBox<'a>, ReadError>.Success { value } => Option<ClipBox<'a>>.some(value)
          _ => Option<ClipBox<'a>>.None
        }
      }
    }
    return Option<ClipBox<'a>>.None
  }
}
