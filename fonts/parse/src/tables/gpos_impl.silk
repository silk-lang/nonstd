pub type OriginalPositionLookupList<'a> = LookupList<'a, PositionLookup<'a>>

pub type PositionLookupList2<'a> = LookupList2<'a, PositionLookup<'a>>

pub type PositionSequenceContext<'a> = SequenceContext<'a>

pub type PositionChainContext<'a> = ChainedSequenceContext<'a>

impl ValueFormat {
  pub fn anyDeviceOrVaridx() -> Self {
    return ValueFormat.fromBitsTruncate(240)
  }

  pub fn recordByteLen(self: Self) -> usize {
    return countBits16(ValueFormat.bits(&self)) * 2
  }
}

pub struct ValueRecord<'a> {
  _data: FontData<'a>,
  _offset: u32,
  _format: ValueFormat,
}

impl<'a> Copy for ValueRecord<'a> {}

impl<'a> ValueRecord<'a> {
  pub fn new(data: FontData<'a>, offset: usize, format: ValueFormat) -> Self {
    let mut bounded = offset
    if bounded > 4294967295 {
      bounded = 4294967295
    }
    return Self { _data: data, _offset: usize.toU32(bounded), _format: format }
  }

  pub fn default() -> Self {
    return Self { _data: FontData.new(b""), _offset: 0, _format: ValueFormat.empty() }
  }

  pub fn format(self: &Self) -> ValueFormat {
    return self._format
  }

  pub fn byteLen(self: &Self) -> usize {
    return ValueFormat.recordByteLen(self._format)
  }

  pub fn isEmpty(self: &Self) -> bool {
    return ValueFormat.isEmpty(&self._format)
  }

  pub fn offsetData(self: &Self) -> FontData<'a> {
    return self._data
  }

  pub fn offset(self: &Self) -> usize {
    return u32.toUsize(self._offset)
  }

  fn fieldOffset(self: &Self, field: ValueFormat) -> Option<usize> {
    if !ValueFormat.contains(&self._format, field) {
      return Option<usize>.None
    }
    let bits = ValueFormat.bits(&field)

    // A zero flag is contained; upstream's subtraction wraps in release.
    let preceding = ValueFormat.bits(&self._format) & u16.wrappingSubtract(bits, 1)
    return Option<usize>.some(u32.toUsize(self._offset) + countBits16(preceding) * 2)
  }

  fn readI16(self: &Self, field: ValueFormat) -> Option<i16> {
    if let Option<usize>.Some { value } = move ValueRecord<'a>.fieldOffset(self, field) {
      return match move FontData<'a>.readAt<i16>(&self._data, value) {
        Result<i16, ReadError>.Success { value: item } => Option<i16>.some(item)
        Result<i16, ReadError>.Failure { error } => Option<i16>.None
      }
    }
    return Option<i16>.None
  }

  pub fn xPlacement(self: &Self) -> Option<i16> {
    return ValueRecord<'a>.readI16(self, ValueFormat.xPlacement())
  }

  pub fn yPlacement(self: &Self) -> Option<i16> {
    return ValueRecord<'a>.readI16(self, ValueFormat.yPlacement())
  }

  pub fn xAdvance(self: &Self) -> Option<i16> {
    return ValueRecord<'a>.readI16(self, ValueFormat.xAdvance())
  }

  pub fn yAdvance(self: &Self) -> Option<i16> {
    return ValueRecord<'a>.readI16(self, ValueFormat.yAdvance())
  }

  pub fn deviceOffset(self: &Self, field: ValueFormat) -> Option<Nullable<Offset16>> {
    if let Option<usize>.Some { value } = move ValueRecord<'a>.fieldOffset(self, field) {
      return match move FontData<'a>.readAt<Nullable<Offset16>>(&self._data, value) {
        Result<Nullable<Offset16>, ReadError>.Success { value: item } => Option<
          Nullable<Offset16>
        >.some(item)
        Result<Nullable<Offset16>, ReadError>.Failure { error } => Option<Nullable<Offset16>>.None
      }
    }
    return Option<Nullable<Offset16>>.None
  }

  fn readDevice(self: &Self, field: ValueFormat) -> Option<
    Result<DeviceOrVariationIndex<'a>, ReadError>
  > {
    if let Option<usize>.Some { value: pos } = move ValueRecord<'a>.fieldOffset(self, field) {
      return match move FontData<'a>.readAt<Nullable<Offset16>>(&self._data, pos) {
        Result<Nullable<Offset16>, ReadError>.Success { value } => resolveNullableWithArgs<
          (),
          DeviceOrVariationIndex<'a>,
          Offset16
        >(&value, self._data, ())
        Result<Nullable<Offset16>, ReadError>.Failure { error } => Option<
          Result<DeviceOrVariationIndex<'a>, ReadError>
        >.some(Result<DeviceOrVariationIndex<'a>, ReadError>.failResult(error))
      }
    }
    return Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None
  }

  pub fn xPlacementDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return ValueRecord<'a>.readDevice(self, ValueFormat.xPlacementDevice())
  }

  pub fn yPlacementDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return ValueRecord<'a>.readDevice(self, ValueFormat.yPlacementDevice())
  }

  pub fn xAdvanceDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return ValueRecord<'a>.readDevice(self, ValueFormat.xAdvanceDevice())
  }

  pub fn yAdvanceDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return ValueRecord<'a>.readDevice(self, ValueFormat.yAdvanceDevice())
  }

  pub fn bytes(self: &Self) -> Option<&'a [u8]> {
    let start = u32.toUsize(self._offset)
    return match move FontData.slice(&self._data, start, start + ValueRecord<'a>.byteLen(self)) {
      Option<FontData<'a>>.Some { value } => Option<&'a [u8]>.some(FontData.asBytes(&value))
      Option<FontData<'a>>.None => Option<&'a [u8]>.None
    }
  }
}

impl<'a> ComputeSize<ValueFormat> for ValueRecord<'a> {
  fn computeSize(args: ValueFormat) -> Result<usize, ReadError> {
    return Result<usize, ReadError>.succeed(ValueFormat.recordByteLen(args))
  }
}

impl<'a> FontReadAt<'a, ValueFormat> for ValueRecord<'a> {
  fn readAt(data: FontData<'a>, position: usize, args: ValueFormat) -> Result<Self, ReadError> {
    return Result<Self, ReadError>.succeed(ValueRecord<'a>.new(data, position, args))
  }
}

fn countBits16(bits: u16) -> usize {
  let mut remaining = bits
  let mut count: usize = 0
  while remaining != 0 {
    remaining = remaining & (remaining - 1)
    count = count + 1
  }
  return count
}

pub type PositionLookupList<'a> = SelectedLookupList<'a, PositionLookup<'a>>

impl<'a> Gpos<'a> {
  fn selectOffset(
    self: &Self,
    original: Nullable<Offset16>,
    extended: Option<Nullable<Offset32>>,
  ) -> Result<HeaderOffset, ReadError> {
    return HeaderOffset.select(
      original,
      move extended,
      MajorMinor.compatible(&Gpos<'a>.version(self), MajorMinor.new(1, 2)),
    )
  }

  pub fn scriptList(self: &Self) -> Result<ScriptList<'a>, ReadError> {
    let selected = match move Gpos<'a>.selectOffset(
      self,
      Gpos<'a>.scriptListOffset(self),
      Gpos<'a>.scriptList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<ScriptList<'a>, ReadError>.failResult(error)
      }
    }
    return resolve<ScriptList<'a>, Offset32>(selected.offset, self._fontData)
  }

  pub fn originalScriptList(self: &Self) -> Option<Result<ScriptList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), ScriptList<'a>, Offset16>(
      &Gpos<'a>.scriptListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn featureList(self: &Self) -> Result<FeatureList<'a>, ReadError> {
    let selected = match move Gpos<'a>.selectOffset(
      self,
      Gpos<'a>.featureListOffset(self),
      Gpos<'a>.featureList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<FeatureList<'a>, ReadError>.failResult(error)
      }
    }
    return resolve<FeatureList<'a>, Offset32>(selected.offset, self._fontData)
  }

  pub fn originalFeatureList(self: &Self) -> Option<Result<FeatureList<'a>, ReadError>> {
    return resolveNullableWithArgs<(), FeatureList<'a>, Offset16>(
      &Gpos<'a>.featureListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn originalLookupList(self: &Self) -> Option<
    Result<OriginalPositionLookupList<'a>, ReadError>
  > {
    return resolveNullableWithArgs<(), OriginalPositionLookupList<'a>, Offset16>(
      &Gpos<'a>.lookupListOffset(self),
      self._fontData,
      (),
    )
  }

  pub fn lookupList(self: &Self) -> Result<PositionLookupList<'a>, ReadError> {
    let selected = match move Gpos<'a>.selectOffset(
      self,
      Gpos<'a>.lookupListOffset(self),
      Gpos<'a>.lookupList2Offset(self),
    ) {
      Result<HeaderOffset, ReadError>.Success { value } => value
      Result<HeaderOffset, ReadError>.Failure { error } => {
        return Result<PositionLookupList<'a>, ReadError>.failResult(error)
      }
    }
    if selected.extended {
      return match move resolve<PositionLookupList2<'a>, Offset32>(
        selected.offset,
        self._fontData,
      ) {
        Result<PositionLookupList2<'a>, ReadError>.Success { value } => Result<
          PositionLookupList<'a>,
          ReadError
        >.succeed(SelectedLookupList<'a, PositionLookup<'a>>.Extended { value: value })
        Result<PositionLookupList2<'a>, ReadError>.Failure { error } => Result<
          PositionLookupList<'a>,
          ReadError
        >.failResult(error)
      }
    }
    return match move resolve<OriginalPositionLookupList<'a>, Offset32>(
      selected.offset,
      self._fontData,
    ) {
      Result<OriginalPositionLookupList<'a>, ReadError>.Success { value } => Result<
        PositionLookupList<'a>,
        ReadError
      >.succeed(SelectedLookupList<'a, PositionLookup<'a>>.Original { value: value })
      Result<OriginalPositionLookupList<'a>, ReadError>.Failure { error } => Result<
        PositionLookupList<'a>,
        ReadError
      >.failResult(error)
    }
  }
}

impl<'a, T: FontRead<'a, ()>> ExtensionLookup<'a, T> for ExtensionPosFormat1<'a, T> {
  fn extension(self: &Self) -> Result<T, ReadError> {
    return ExtensionPosFormat1<'a, T>.extension(self)
  }
}

pub union PositionSubtables<'a> {
  Single { pub value: Subtables<'a, SinglePos<'a>, ExtensionPosFormat1<'a, SinglePos<'a>>> },
  Pair { pub value: Subtables<'a, PairPos<'a>, ExtensionPosFormat1<'a, PairPos<'a>>> },
  Cursive { pub value: Subtables<'a, CursivePos<'a>, ExtensionPosFormat1<'a, CursivePos<'a>>> },
  MarkToBase {
    pub value: Subtables<'a, MarkBasePos<'a>, ExtensionPosFormat1<'a, MarkBasePos<'a>>>
  },
  MarkToLig { pub value: Subtables<'a, MarkLigPos<'a>, ExtensionPosFormat1<'a, MarkLigPos<'a>>> },
  MarkToMark {
    pub value: Subtables<'a, MarkMarkPos<'a>, ExtensionPosFormat1<'a, MarkMarkPos<'a>>>
  },
  Contextual {
    pub value: Subtables<
      'a,
      PositionSequenceContext<'a>,
      ExtensionPosFormat1<'a, PositionSequenceContext<'a>>
    >
  },
  ChainContextual {
    pub value: Subtables<
      'a,
      PositionChainContext<'a>,
      ExtensionPosFormat1<'a, PositionChainContext<'a>>
    >
  },
  EmptyExtension,
}

impl<'a> Copy for PositionSubtables<'a> {}

impl<'a> PositionLookup<'a> {
  pub fn lookupFlag(self: &Self) -> LookupFlag {
    return Lookup<'a, ()>.lookupFlag(&PositionLookup<'a>.ofUnitType(self))
  }

  pub fn lookupType(self: &Self) -> u16 {
    return Lookup<'a, ()>.lookupType(&PositionLookup<'a>.ofUnitType(self))
  }

  pub fn markFilteringSet(self: &Self) -> Option<u16> {
    return Lookup<'a, ()>.markFilteringSet(&PositionLookup<'a>.ofUnitType(self))
  }

  pub fn subtables(self: &Self) -> Result<PositionSubtables<'a>, ReadError> {
    let raw = PositionLookup<'a>.ofUnitType(self)
    let offsets = Lookup<'a, ()>.subtableOffsets(&raw)
    let data = Lookup<'a, ()>.offsetData(&raw)
    let mut lookupType = Lookup<'a, ()>.lookupType(&raw)
    let mut extended = false
    if lookupType == 9 {
      let mut index: usize = 0
      let mut found = false
      while index < ScalarArray<Offset16>.len(&offsets) {
        let offset = ScalarArray<Offset16>.get(&offsets, index)
          |> Option<Offset16>.unwrapOr(Offset16.new(0))
        if let Result<ExtensionPosFormat1<'a, ()>, ReadError>.Success { value } = move resolve<
          ExtensionPosFormat1<'a, ()>,
          Offset16
        >(offset, data) {
          lookupType = ExtensionPosFormat1<'a, ()>.extensionLookupType(&value)
          found = true
          break
        }
        index = index + 1
      }
      if !found {
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.EmptyExtension,
        )
      }
      extended = true
    }
    match lookupType {
      1 => {
        let mut array = Subtables<'a, SinglePos<'a>, ExtensionPosFormat1<'a, SinglePos<'a>>>.new(
          offsets,
          data,
        )
        if extended {
          array = Subtables<'a, SinglePos<'a>, ExtensionPosFormat1<'a, SinglePos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.Single { value: array },
        )
      }
      2 => {
        let mut array = Subtables<'a, PairPos<'a>, ExtensionPosFormat1<'a, PairPos<'a>>>.new(
          offsets,
          data,
        )
        if extended {
          array = Subtables<'a, PairPos<'a>, ExtensionPosFormat1<'a, PairPos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.Pair { value: array },
        )
      }
      3 => {
        let mut array = Subtables<'a, CursivePos<'a>, ExtensionPosFormat1<'a, CursivePos<'a>>>.new(
          offsets,
          data,
        )
        if extended {
          array = Subtables<'a, CursivePos<'a>, ExtensionPosFormat1<'a, CursivePos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.Cursive { value: array },
        )
      }
      4 => {
        let mut array = Subtables<
          'a,
          MarkBasePos<'a>,
          ExtensionPosFormat1<'a, MarkBasePos<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<'a, MarkBasePos<'a>, ExtensionPosFormat1<'a, MarkBasePos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.MarkToBase { value: array },
        )
      }
      5 => {
        let mut array = Subtables<'a, MarkLigPos<'a>, ExtensionPosFormat1<'a, MarkLigPos<'a>>>.new(
          offsets,
          data,
        )
        if extended {
          array = Subtables<'a, MarkLigPos<'a>, ExtensionPosFormat1<'a, MarkLigPos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.MarkToLig { value: array },
        )
      }
      6 => {
        let mut array = Subtables<
          'a,
          MarkMarkPos<'a>,
          ExtensionPosFormat1<'a, MarkMarkPos<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<'a, MarkMarkPos<'a>, ExtensionPosFormat1<'a, MarkMarkPos<'a>>>.newExt(
            offsets,
            data,
          )
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.MarkToMark { value: array },
        )
      }
      7 => {
        let mut array = Subtables<
          'a,
          PositionSequenceContext<'a>,
          ExtensionPosFormat1<'a, PositionSequenceContext<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            PositionSequenceContext<'a>,
            ExtensionPosFormat1<'a, PositionSequenceContext<'a>>
          >.newExt(offsets, data)
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.Contextual { value: array },
        )
      }
      8 => {
        let mut array = Subtables<
          'a,
          PositionChainContext<'a>,
          ExtensionPosFormat1<'a, PositionChainContext<'a>>
        >.new(offsets, data)
        if extended {
          array = Subtables<
            'a,
            PositionChainContext<'a>,
            ExtensionPosFormat1<'a, PositionChainContext<'a>>
          >.newExt(offsets, data)
        }
        return Result<PositionSubtables<'a>, ReadError>.succeed(
          PositionSubtables<'a>.ChainContextual { value: array },
        )
      }
      _ => {
        return Result<PositionSubtables<'a>, ReadError>.failResult(
          ReadError.InvalidFormat { value: u16.toI64(lookupType) },
        )
      }
    }
  }
}

impl<'a> AnchorTable<'a> {
  pub fn xDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return match &self.* {
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.xDevice(&value)
      _ => Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None
    }
  }

  pub fn yDevice(self: &Self) -> Option<Result<DeviceOrVariationIndex<'a>, ReadError>> {
    return match &self.* {
      AnchorTable<'a>.Format3 { value } => AnchorFormat3<'a>.yDevice(&value)
      _ => Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None
    }
  }
}

impl<'a> PairSet<'a> {
  pub fn findPairValueRecord(self: &Self, secondGlyph: GlyphId16) -> Option<PairValueRecord<'a>> {
    let records = PairSet<'a>.pairValueRecords(self)
    let mut lo: usize = 0
    let mut hi = ComputedArray<'a, ReadArgs2<ValueFormat, ValueFormat>, PairValueRecord<'a>>.len(
      &records,
    )
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      let record = match move ComputedArray<
        'a,
        ReadArgs2<ValueFormat, ValueFormat>,
        PairValueRecord<'a>
      >.get(&records, mid) {
        Result<PairValueRecord<'a>, ReadError>.Success { value } => value
        Result<PairValueRecord<'a>, ReadError>.Failure { error } => {
          return Option<PairValueRecord<'a>>.None
        }
      }
      let glyph = GlyphId16.toU16(PairValueRecord<'a>.secondGlyph(&record))
      if glyph < GlyphId16.toU16(secondGlyph) {
        lo = mid + 1
      } else {
        if glyph > GlyphId16.toU16(secondGlyph) {
          hi = mid
        } else {
          return Option<PairValueRecord<'a>>.some(record)
        }
      }
    }
    return Option<PairValueRecord<'a>>.None
  }
}

pub struct ClassValueRecords<'a> {
  data: FontData<'a>,
  start: usize,
  recordSize: usize,
  format1Len: usize,
  _class1Count: u16,
  _class2Count: u16,
  format1: ValueFormat,
  format2: ValueFormat,
}

impl<'a> Copy for ClassValueRecords<'a> {}

impl<'a> ClassValueRecords<'a> {
  pub fn class1Count(self: &Self) -> u16 {
    return self._class1Count
  }

  pub fn class2Count(self: &Self) -> u16 {
    return self._class2Count
  }

  pub fn get(self: &Self, class1: u16, class2: u16) -> Option<[ValueRecord<'a>; 2]> {
    if class1 >= self._class1Count || class2 >= self._class2Count {
      return Option<[ValueRecord<'a>; 2]>.None
    }

    // Counts are u16, record widths at most 32 bytes; these products fit usize.
    let offset = self.start + u16.toUsize(class1) * self.recordSize * u16.toUsize(self._class2Count)
      + u16.toUsize(class2) * self.recordSize
    return Option<[ValueRecord<'a>; 2]>.some(
      [
        ValueRecord<'a>.new(self.data, offset, self.format1),
        ValueRecord<'a>.new(self.data, offset + self.format1Len, self.format2),
      ],
    )
  }
}

impl<'a> PairPosFormat2<'a> {
  pub fn classValueRecords(self: &Self) -> ClassValueRecords<'a> {
    let format1 = PairPosFormat2<'a>.valueFormat1(self)
    let format2 = PairPosFormat2<'a>.valueFormat2(self)
    let len1 = ValueFormat.recordByteLen(format1)
    return ClassValueRecords<'a> {
      data: self._fontData,
      start: PairPosFormat2<'a>.class1RecordsByteRange(self).start,
      recordSize: len1 + ValueFormat.recordByteLen(format2),
      format1Len: len1,
      _class1Count: PairPosFormat2<'a>.class1Count(self),
      _class2Count: PairPosFormat2<'a>.class2Count(self),
      format1: format1,
      format2: format2,
    }
  }

  pub fn valueRecordRefs(self: &Self, class1: u16, class2: u16) -> Option<[ValueRecord<'a>; 2]> {
    return ClassValueRecords<'a>.get(&PairPosFormat2<'a>.classValueRecords(self), class1, class2)
  }
}

impl<'a> PairPosFormat4<'a> {
  pub fn classValueRecords(self: &Self) -> ClassValueRecords<'a> {
    let format1 = PairPosFormat4<'a>.valueFormat1(self)
    let format2 = PairPosFormat4<'a>.valueFormat2(self)
    let len1 = ValueFormat.recordByteLen(format1)
    return ClassValueRecords<'a> {
      data: self._fontData,
      start: PairPosFormat4<'a>.class1RecordsByteRange(self).start,
      recordSize: len1 + ValueFormat.recordByteLen(format2),
      format1Len: len1,
      _class1Count: PairPosFormat4<'a>.class1Count(self),
      _class2Count: PairPosFormat4<'a>.class2Count(self),
      format1: format1,
      format2: format2,
    }
  }

  pub fn valueRecordRefs(self: &Self, class1: u16, class2: u16) -> Option<[ValueRecord<'a>; 2]> {
    return ClassValueRecords<'a>.get(&PairPosFormat4<'a>.classValueRecords(self), class1, class2)
  }
}

impl<'a> Equal for ValueRecord<'a> {
  fn equals(left: &ValueRecord<'a>, right: &ValueRecord<'a>) -> bool {
    if ValueFormat.bits(&left._format) != ValueFormat.bits(&right._format) {
      return false
    }
    let a = ValueRecord<'a>.bytes(left)
    let b = ValueRecord<'a>.bytes(right)
    return match move a {
      Option<&'a [u8]>.Some { value: x } => match move b {
        Option<&'a [u8]>.Some { value: y } => {
          if x.length != y.length {
            return false
          }
          let mut i: usize = 0
          while i < x.length {
            if x[i] != y[i] {
              return false
            }
            i = i + 1
          }
          return true
        }
        Option<&'a [u8]>.None => false
      }
      Option<&'a [u8]>.None => match move b {
        Option<&'a [u8]>.None => true
        _ => false
      }
    }
  }
}
