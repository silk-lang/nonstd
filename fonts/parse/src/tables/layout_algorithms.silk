//! Coverage, class, and packed device algorithms from the pinned layout extensions.
import silk.num.i8

struct LayoutRange {
  start: u32,
  end: u32,
  value: u32,
}

impl Copy for LayoutRange {}

interface LayoutRangeRecord {
  fn range(self: &Self) -> LayoutRange
}

fn rangeAt<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + LayoutRangeRecord>(
  array: &ComputedArray<'a, (), T>,
  index: usize,
) -> Option<LayoutRange> {
  return match move ComputedArray<'a, (), T>.get(array, index) {
    Result<T, ReadError>.Success { value } => Option<LayoutRange>.some(
      LayoutRangeRecord.range(&value),
    )
    Result<T, ReadError>.Failure { error } => Option<LayoutRange>.None
  }
}

fn rangeCompare(range: LayoutRange, glyph: u32, byStart: bool) -> i32 {
  if byStart {
    if range.start < glyph {
      return -1
    }
    if range.start > glyph {
      return 1
    }
    return 0
  }
  if range.end < glyph {
    return -1
  }
  if range.start > glyph {
    return 1
  }
  return 0
}

fn findRange<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + LayoutRangeRecord>(
  array: &ComputedArray<'a, (), T>,
  glyph: u32,
  byStart: bool,
) -> Option<LayoutRange> {
  let mut size = ComputedArray<'a, (), T>.len(array)
  if size == 0 {
    return Option<LayoutRange>.None
  }
  let mut base: usize = 0
  while size > 1 {
    let half = size / 2
    let mid = base + half
    let range = rangeAt<'a, T>(array, mid)
      |> Option<LayoutRange>.unwrapOr(LayoutRange { start: 0, end: 0, value: 0 })
    if rangeCompare(range, glyph, byStart) <= 0 {
      base = mid
    }
    size = size - half
  }
  let candidate = rangeAt<'a, T>(array, base)
    |> Option<LayoutRange>.unwrapOr(LayoutRange { start: 0, end: 0, value: 0 })
  let cmp = rangeCompare(candidate, glyph, byStart)
  if !byStart {
    if cmp == 0 {
      return Option<LayoutRange>.some(candidate)
    }
    return Option<LayoutRange>.None
  }
  if cmp > 0 {
    base = usize.saturatingSubtract(base, 1)
  }
  let selected = rangeAt<'a, T>(array, base)
    |> Option<LayoutRange>.unwrapOr(LayoutRange { start: 0, end: 0, value: 0 })
  if glyph < selected.start || glyph > selected.end {
    return Option<LayoutRange>.None
  }
  return Option<LayoutRange>.some(selected)
}

fn rangePopulation<'a, T: FontReadAt<'a, ()> + ComputeSize<()> + LayoutRangeRecord>(
  array: &ComputedArray<'a, (), T>,
) -> usize {
  let mut count: usize = 0
  let mut index: usize = 0
  while index < ComputedArray<'a, (), T>.len(array) {
    if let Option<LayoutRange>.Some { value } = move rangeAt<'a, T>(array, index) {
      if value.start <= value.end {
        count = usize.saturatingAdd(count, u32.toUsize(value.end - value.start) + 1)
      }
    }
    index = index + 1
  }
  return count
}

fn bitStorage(value: u32) -> u32 {
  let mut n = value
  let mut bits: u32 = 0
  while n != 0 {
    n = u32.shiftRight(n, 1)
    bits = bits + 1
  }
  return bits
}

pub struct RangeGlyphIter {
  nextGlyph: u32,
  end: u32,
}

impl RangeGlyphIter {
  pub fn next(self: &mut Self) -> Option<GlyphId> {
    if self.nextGlyph >= self.end {
      return Option<GlyphId>.None
    }
    let glyph = self.nextGlyph
    self.nextGlyph = self.nextGlyph + 1
    return Option<GlyphId>.some(GlyphId.new(glyph))
  }
}

pub struct RangeGlyph16Iter {
  inner: RangeGlyphIter,
}

impl RangeGlyph16Iter {
  pub fn next(self: &mut Self) -> Option<GlyphId16> {
    return match move RangeGlyphIter.next(&mut self.inner) {
      Option<GlyphId>.Some { value } => Option<GlyphId16>.some(
        GlyphId16.new(u32.toU16(GlyphId.toU32(value))),
      )
      Option<GlyphId>.None => Option<GlyphId16>.None
    }
  }
}

impl<'a> LayoutRangeRecord for RangeRecord<'a> {
  fn range(self: &Self) -> LayoutRange {
    return LayoutRange {
      start: GlyphId16.toU32(RangeRecord<'a>.startGlyphId(self)),
      end: GlyphId16.toU32(RangeRecord<'a>.endGlyphId(self)),
      value: u16.toU32(RangeRecord<'a>.startCoverageIndex(self)),
    }
  }
}

impl<'a> RangeRecord<'a> {
  pub fn population(self: &Self) -> usize {
    let start = GlyphId16.toU32(RangeRecord<'a>.startGlyphId(self))
    let end = GlyphId16.toU32(RangeRecord<'a>.endGlyphId(self))
    if start > end {
      return 0
    }
    return u32.toUsize(end - start) + 1
  }
}

impl<'a> RangeRecord<'a> {
  pub fn iter(self: &Self) -> RangeGlyph16Iter {
    return RangeGlyph16Iter {
      inner: RangeGlyphIter {
        nextGlyph: GlyphId16.toU32(RangeRecord<'a>.startGlyphId(self)),
        end: GlyphId16.toU32(RangeRecord<'a>.endGlyphId(self)) + 1,
      },
    }
  }
}

impl<'a> LayoutRangeRecord for RangeRecord2<'a> {
  fn range(self: &Self) -> LayoutRange {
    return LayoutRange {
      start: GlyphId24.toU32(RangeRecord2<'a>.startGlyphId(self)),
      end: GlyphId24.toU32(RangeRecord2<'a>.endGlyphId(self)),
      value: Uint24.toU32(RangeRecord2<'a>.startCoverageIndex(self)),
    }
  }
}

impl<'a> RangeRecord2<'a> {
  pub fn population(self: &Self) -> usize {
    let start = GlyphId24.toU32(RangeRecord2<'a>.startGlyphId(self))
    let end = GlyphId24.toU32(RangeRecord2<'a>.endGlyphId(self))
    if start > end {
      return 0
    }
    return u32.toUsize(end - start) + 1
  }
}

impl<'a> RangeRecord2<'a> {
  pub fn iter(self: &Self) -> RangeGlyphIter {
    return RangeGlyphIter {
      nextGlyph: GlyphId24.toU32(RangeRecord2<'a>.startGlyphId(self)),
      end: GlyphId24.toU32(RangeRecord2<'a>.endGlyphId(self)) + 1,
    }
  }
}

impl<'a> LayoutRangeRecord for ClassRangeRecord<'a> {
  fn range(self: &Self) -> LayoutRange {
    return LayoutRange {
      start: GlyphId16.toU32(ClassRangeRecord<'a>.startGlyphId(self)),
      end: GlyphId16.toU32(ClassRangeRecord<'a>.endGlyphId(self)),
      value: u16.toU32(ClassRangeRecord<'a>.class(self)),
    }
  }
}

impl<'a> ClassRangeRecord<'a> {
  pub fn population(self: &Self) -> usize {
    let start = GlyphId16.toU32(ClassRangeRecord<'a>.startGlyphId(self))
    let end = GlyphId16.toU32(ClassRangeRecord<'a>.endGlyphId(self))
    if start > end {
      return 0
    }
    return u32.toUsize(end - start) + 1
  }
}

impl<'a> LayoutRangeRecord for ClassRangeRecord2<'a> {
  fn range(self: &Self) -> LayoutRange {
    return LayoutRange {
      start: GlyphId24.toU32(ClassRangeRecord2<'a>.startGlyphId(self)),
      end: GlyphId24.toU32(ClassRangeRecord2<'a>.endGlyphId(self)),
      value: u16.toU32(ClassRangeRecord2<'a>.class(self)),
    }
  }
}

impl<'a> ClassRangeRecord2<'a> {
  pub fn population(self: &Self) -> usize {
    let start = GlyphId24.toU32(ClassRangeRecord2<'a>.startGlyphId(self))
    let end = GlyphId24.toU32(ClassRangeRecord2<'a>.endGlyphId(self))
    if start > end {
      return 0
    }
    return u32.toUsize(end - start) + 1
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyph)
    if gid > 65535 {
      return Option<u16>.None
    }
    let array = CoverageFormat1<'a>.glyphArray(self)
    let mut size = ScalarArray<GlyphId16>.len(&array)
    if size == 0 {
      return Option<u16>.None
    }
    let mut base: usize = 0
    while size > 1 {
      let half = size / 2
      let mid = base + half
      let value = ScalarArray<GlyphId16>.get(&array, mid)
        |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0))
      if GlyphId16.toU32(value) <= gid {
        base = mid
      }
      size = size - half
    }
    let value = ScalarArray<GlyphId16>.get(&array, base)
      |> Option<GlyphId16>.unwrapOr(GlyphId16.new(0))
    if GlyphId16.toU32(value) == gid {
      return Option<u16>.some(usize.toU16(base))
    }
    return Option<u16>.None
  }
}

impl<'a> CoverageFormat3<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    let gid = GlyphId.toU32(glyph)
    if gid > 16777215 {
      return Option<u32>.None
    }
    let array = CoverageFormat3<'a>.glyphArray(self)
    let mut size = ScalarArray<GlyphId24>.len(&array)
    if size == 0 {
      return Option<u32>.None
    }
    let mut base: usize = 0
    while size > 1 {
      let half = size / 2
      let mid = base + half
      let value = ScalarArray<GlyphId24>.get(&array, mid)
        |> Option<GlyphId24>.unwrapOr(GlyphId24.new(0))
      if GlyphId24.toU32(value) <= gid {
        base = mid
      }
      size = size - half
    }
    let value = ScalarArray<GlyphId24>.get(&array, base)
      |> Option<GlyphId24>.unwrapOr(GlyphId24.new(0))
    if GlyphId24.toU32(value) == gid {
      return Option<u32>.some(usize.toU32(base))
    }
    return Option<u32>.None
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u16> {
    let gid = GlyphId.toU32(glyph)
    if gid > 65535 {
      return Option<u16>.None
    }
    if let Option<LayoutRange>.Some { value } = move findRange<RangeRecord<'a>>(
      &CoverageFormat2<'a>.rangeRecords(self),
      gid,
      false,
    ) {
      let index = value.value + gid - value.start
      if index <= 65535 {
        return Option<u16>.some(u32.toU16(index))
      }
    }
    return Option<u16>.None
  }
}

impl<'a> CoverageFormat4<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    let gid = GlyphId.toU32(glyph)
    if let Option<LayoutRange>.Some { value } = move findRange<RangeRecord2<'a>>(
      &CoverageFormat4<'a>.rangeRecords(self),
      gid,
      false,
    ) {
      let index = value.value + gid - value.start
      if index <= 16777215 {
        return Option<u32>.some(index)
      }
    }
    return Option<u32>.None
  }
}

impl<'a> CoverageFormat1<'a> {
  pub fn population(self: &Self) -> usize {
    return u16.toUsize(CoverageFormat1<'a>.glyphCount(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(CoverageFormat1<'a>.glyphCount(self)))
  }
}

impl<'a> CoverageFormat2<'a> {
  pub fn population(self: &Self) -> usize {
    return rangePopulation<RangeRecord<'a>>(&CoverageFormat2<'a>.rangeRecords(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(CoverageFormat2<'a>.rangeCount(self)))
  }
}

impl<'a> CoverageTable<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> Option<u32> {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => match move CoverageFormat1<'a>.get(&value, glyph) {
        Option<u16>.Some { value: index } => Option<u32>.some(u16.toU32(index))
        Option<u16>.None => Option<u32>.None
      }
      CoverageTable<'a>.Format2 { value } => match move CoverageFormat2<'a>.get(&value, glyph) {
        Option<u16>.Some { value: index } => Option<u32>.some(u16.toU32(index))
        Option<u16>.None => Option<u32>.None
      }
      CoverageTable<'a>.Format3 { value } => CoverageFormat3<'a>.get(&value, glyph)
      CoverageTable<'a>.Format4 { value } => CoverageFormat4<'a>.get(&value, glyph)
    }
  }

  pub fn iter(self: &Self) -> CoverageIter<'a> {
    return CoverageIter<'a> { table: self.*, index: 0, nextGlyph: 0, end: 0 }
  }

  pub fn population(self: &Self) -> usize {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.population(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.population(&value)
      CoverageTable<'a>.Format3 { value } => u32.toUsize(
        Uint24.toU32(CoverageFormat3<'a>.glyphCount(&value)),
      )
      CoverageTable<'a>.Format4 { value } => rangePopulation<RangeRecord2<'a>>(
        &CoverageFormat4<'a>.rangeRecords(&value),
      )
    }
  }

  pub fn cost(self: &Self) -> u32 {
    return match &self.* {
      CoverageTable<'a>.Format1 { value } => CoverageFormat1<'a>.cost(&value)
      CoverageTable<'a>.Format2 { value } => CoverageFormat2<'a>.cost(&value)
      CoverageTable<'a>.Format3 { value } => bitStorage(
        Uint24.toU32(CoverageFormat3<'a>.glyphCount(&value)),
      )
      CoverageTable<'a>.Format4 { value } => bitStorage(
        Uint24.toU32(CoverageFormat4<'a>.rangeCount(&value)),
      )
    }
  }
}

pub struct CoverageIter<'a> {
  table: CoverageTable<'a>,
  index: usize,
  nextGlyph: u32,
  end: u32,
}

impl<'a> CoverageIter<'a> {
  pub fn next(self: &mut Self) -> Option<GlyphId> {
    while true {
      if self.nextGlyph < self.end {
        let glyph = self.nextGlyph
        self.nextGlyph = self.nextGlyph + 1
        return Option<GlyphId>.some(GlyphId.new(glyph))
      }
      let index = self.index
      match self.table {
        CoverageTable<'a>.Format1 { value } => {
          if let Option<GlyphId16>.Some { value: glyph } = move ScalarArray<GlyphId16>.get(
            &CoverageFormat1<'a>.glyphArray(&value),
            index,
          ) {
            self.index = self.index + 1
            return Option<GlyphId>.some(GlyphId.new(GlyphId16.toU32(glyph)))
          }
          return Option<GlyphId>.None
        }
        CoverageTable<'a>.Format3 { value } => {
          if let Option<GlyphId24>.Some { value: glyph } = move ScalarArray<GlyphId24>.get(
            &CoverageFormat3<'a>.glyphArray(&value),
            index,
          ) {
            self.index = self.index + 1
            return Option<GlyphId>.some(GlyphId.new(GlyphId24.toU32(glyph)))
          }
          return Option<GlyphId>.None
        }
        CoverageTable<'a>.Format2 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<RangeRecord<'a>>(
            &CoverageFormat2<'a>.rangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
          } else {
            return Option<GlyphId>.None
          }
        }
        CoverageTable<'a>.Format4 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<RangeRecord2<'a>>(
            &CoverageFormat4<'a>.rangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
          } else {
            return Option<GlyphId>.None
          }
        }
      }
    }
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u16 {
    let gid = GlyphId.toU32(glyph)
    let start = GlyphId16.toU32(ClassDefFormat1<'a>.startGlyphId(self))
    if gid < start || gid > 4294967295 {
      return 0
    }
    let raw = ScalarArray<u16>.get(
      &ClassDefFormat1<'a>.classValueArray(self),
      u32.toUsize(gid - start),
    )
      |> Option<u16>.unwrapOr(0)
    return raw
  }
}

impl<'a> ClassDefFormat3<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    let gid = GlyphId.toU32(glyph)
    let start = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(self))
    if gid < start || gid > 16777215 {
      return 0
    }
    let raw = ScalarArray<Uint24>.get(
      &ClassDefFormat3<'a>.classValueArray(self),
      u32.toUsize(gid - start),
    )
      |> Option<Uint24>.unwrapOr(Uint24.new(0))
    return Uint24.toU32(raw)
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u16 {
    if let Option<LayoutRange>.Some { value } = move findRange<ClassRangeRecord<'a>>(
      &ClassDefFormat2<'a>.classRangeRecords(self),
      GlyphId.toU32(glyph),
      true,
    ) {
      return u32.toU16(value.value)
    }
    return 0
  }
}

impl<'a> ClassDefFormat4<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    if let Option<LayoutRange>.Some { value } = move findRange<ClassRangeRecord2<'a>>(
      &ClassDefFormat4<'a>.classRangeRecords(self),
      GlyphId.toU32(glyph),
      true,
    ) {
      return value.value
    }
    return 0
  }
}

impl<'a> ClassDefFormat1<'a> {
  pub fn iter(self: &Self) -> Class16Iter<'a> {
    return Class16Iter<'a> { inner: ClassDef<'a>.iter(&ClassDef<'a>.Format1 { value: self.* }) }
  }

  pub fn population(self: &Self) -> usize {
    return u16.toUsize(ClassDefFormat1<'a>.glyphCount(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return 1
  }
}

impl<'a> ClassDefFormat2<'a> {
  pub fn iter(self: &Self) -> Class16Iter<'a> {
    return Class16Iter<'a> { inner: ClassDef<'a>.iter(&ClassDef<'a>.Format2 { value: self.* }) }
  }

  pub fn population(self: &Self) -> usize {
    return rangePopulation<ClassRangeRecord<'a>>(&ClassDefFormat2<'a>.classRangeRecords(self))
  }

  pub fn cost(self: &Self) -> u32 {
    return bitStorage(u16.toU32(ClassDefFormat2<'a>.classRangeCount(self)))
  }
}

pub struct ClassEntry {
  pub glyph: GlyphId,
  pub class: u32,
}

impl Copy for ClassEntry {}

pub struct ClassEntry16 {
  pub glyph: GlyphId16,
  pub class: u16,
}

impl Copy for ClassEntry16 {}

impl<'a> ClassDef<'a> {
  pub fn get(self: &Self, glyph: GlyphId) -> u32 {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => u16.toU32(ClassDefFormat1<'a>.get(&value, glyph))
      ClassDef<'a>.Format2 { value } => u16.toU32(ClassDefFormat2<'a>.get(&value, glyph))
      ClassDef<'a>.Format3 { value } => ClassDefFormat3<'a>.get(&value, glyph)
      ClassDef<'a>.Format4 { value } => ClassDefFormat4<'a>.get(&value, glyph)
    }
  }

  pub fn iter(self: &Self) -> ClassIter<'a> {
    return ClassIter<'a> { table: self.*, index: 0, nextGlyph: 0, end: 0, class: 0 }
  }

  pub fn population(self: &Self) -> usize {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => ClassDefFormat1<'a>.population(&value)
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.population(&value)
      ClassDef<'a>.Format3 { value } => u32.toUsize(
        Uint24.toU32(ClassDefFormat3<'a>.glyphCount(&value)),
      )
      ClassDef<'a>.Format4 { value } => rangePopulation<ClassRangeRecord2<'a>>(
        &ClassDefFormat4<'a>.classRangeRecords(&value),
      )
    }
  }

  pub fn cost(self: &Self) -> u32 {
    return match &self.* {
      ClassDef<'a>.Format1 { value } => 1
      ClassDef<'a>.Format2 { value } => ClassDefFormat2<'a>.cost(&value)
      ClassDef<'a>.Format3 { value } => 1
      ClassDef<'a>.Format4 { value } => bitStorage(
        Uint24.toU32(ClassDefFormat4<'a>.classRangeCount(&value)),
      )
    }
  }
}

pub struct ClassIter<'a> {
  table: ClassDef<'a>,
  index: usize,
  nextGlyph: u32,
  end: u32,
  class: u32,
}

impl<'a> ClassIter<'a> {
  pub fn next(self: &mut Self) -> Option<ClassEntry> {
    while true {
      if self.nextGlyph < self.end {
        let glyph = self.nextGlyph
        self.nextGlyph = self.nextGlyph + 1
        return Option<ClassEntry>.some(ClassEntry { glyph: GlyphId.new(glyph), class: self.class })
      }
      let index = self.index
      match self.table {
        ClassDef<'a>.Format1 { value } => {
          if let Option<u16>.Some { value: class } = move ScalarArray<u16>.get(
            &ClassDefFormat1<'a>.classValueArray(&value),
            index,
          ) {
            self.index = self.index + 1
            let glyph = u16.toU32(
              u16.saturatingAdd(
                GlyphId16.toU16(ClassDefFormat1<'a>.startGlyphId(&value)),
                usize.toU16(index),
              ),
            )
            return Option<ClassEntry>.some(
              ClassEntry { glyph: GlyphId.new(glyph), class: u16.toU32(class) },
            )
          }
          return Option<ClassEntry>.None
        }
        ClassDef<'a>.Format3 { value } => {
          if let Option<Uint24>.Some { value: class } = move ScalarArray<Uint24>.get(
            &ClassDefFormat3<'a>.classValueArray(&value),
            index,
          ) {
            self.index = self.index + 1
            let glyph = GlyphId24.toU32(ClassDefFormat3<'a>.startGlyphId(&value))
              + usize.toU32(index)
            if glyph > 16777215 {
              return Option<ClassEntry>.None
            }
            return Option<ClassEntry>.some(
              ClassEntry { glyph: GlyphId.new(glyph), class: Uint24.toU32(class) },
            )
          }
          return Option<ClassEntry>.None
        }
        ClassDef<'a>.Format2 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<ClassRangeRecord<'a>>(
            &ClassDefFormat2<'a>.classRangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
            self.class = range.value
          } else {
            return Option<ClassEntry>.None
          }
        }
        ClassDef<'a>.Format4 { value } => {
          if let Option<LayoutRange>.Some { value: range } = move rangeAt<ClassRangeRecord2<'a>>(
            &ClassDefFormat4<'a>.classRangeRecords(&value),
            index,
          ) {
            self.index = self.index + 1
            self.nextGlyph = range.start
            self.end = range.end + 1
            self.class = range.value
          } else {
            return Option<ClassEntry>.None
          }
        }
      }
    }
  }
}

pub struct Class16Iter<'a> {
  inner: ClassIter<'a>,
}

impl<'a> Class16Iter<'a> {
  pub fn next(self: &mut Self) -> Option<ClassEntry16> {
    return match move ClassIter<'a>.next(&mut self.inner) {
      Option<ClassEntry>.Some { value } => Option<ClassEntry16>.some(
        ClassEntry16 {
          glyph: GlyphId16.new(u32.toU16(GlyphId.toU32(value.glyph))),
          class: u32.toU16(value.class),
        },
      )
      Option<ClassEntry>.None => Option<ClassEntry16>.None
    }
  }
}

pub struct DeviceIter<'a> {
  values: ScalarArray<'a, u16>,
  index: usize,
  count: usize,
  bits: u16,
}

impl<'a> Device<'a> {
  pub fn iter(self: &Self) -> DeviceIter<'a> {
    let bits: u16 = match Device<'a>.deltaFormat(self) {
      DeltaFormat.Local2BitDeltas => 2
      DeltaFormat.Local4BitDeltas => 4
      DeltaFormat.Local8BitDeltas => 8
      _ => 0
    }
    let start = Device<'a>.startSize(self)
    let end = Device<'a>.endSize(self)
    let mut count: usize = 0
    if end >= start && bits != 0 {
      count = u16.toUsize(end - start) + 1
    }
    return DeviceIter<'a> {
      values: Device<'a>.deltaValue(self),
      index: 0,
      count: count,
      bits: bits,
    }
  }

  pub fn deltaForPpem(self: &Self, ppem: u16) -> i32 {
    let start = Device<'a>.startSize(self)
    if ppem == 0 || ppem < start || ppem > Device<'a>.endSize(self) {
      return 0
    }
    let mut iter = Device<'a>.iter(self)
    iter.index = u16.toUsize(ppem - start)
    return i8.toI32(DeviceIter<'a>.next(&mut iter) |> Option<i8>.unwrapOr(0))
  }
}

impl<'a> DeviceIter<'a> {
  pub fn next(self: &mut Self) -> Option<i8> {
    if self.index >= self.count || self.bits == 0 {
      return Option<i8>.None
    }
    let perWord = u16.toUsize(16 / self.bits)
    let word = match move ScalarArray<u16>.get(&self.values, self.index / perWord) {
      Option<u16>.Some { value } => value
      Option<u16>.None => {
        return Option<i8>.None
      }
    }
    let shift = 16 - self.bits - usize.toU16(self.index % perWord) * self.bits
    let mask = u16.shiftLeft(1, self.bits) - 1
    let raw = u16.shiftRight(word, shift) & mask
    let mut value = u16.toI16(raw)
    if (raw & u16.shiftLeft(1, self.bits - 1)) != 0 {
      value = value - u16.toI16(mask + 1)
    }
    self.index = self.index + 1
    return Option<i8>.some(i16.toI8(value))
  }
}

// Upstream layout::tests::bit_storage_tests; kept beside the private helper.
import silk.testing.testing { Testing, AssertionError }

test effect fn bitStorageTests() -> ()
  ! AssertionError<'static> {
  let values: [u32; 9] = [0, 1, 2, 4, 9, 291, 4660, 65535, 4294967295]
  let expected: [u32; 9] = [0, 1, 2, 3, 4, 9, 13, 16, 32]
  let mut i: usize = 0
  while i < 9 {
    run Testing.expect(bitStorage(values[i]) == expected[i], "bits required")
    i = i + 1
  }
}
