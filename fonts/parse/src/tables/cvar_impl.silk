import generated_variations {
  Tuple,
  TupleDelta,
  TupleVariationData,
  PackedPointNumbers,
  ActiveTupleVariationIter,
  ActiveTupleVariation,
  TupleVariation,
  TupleDeltaIter
}

pub type CvtVariationData<'a> = TupleVariationData<'a, CvtDelta>

pub struct CvtDelta {
  pub position: u16,
  pub value: i32,
}

impl Copy for CvtDelta {}

impl Equal for CvtDelta {
  fn equals(a: &Self, b: &Self) -> bool {
    return a.position == b.position && a.value == b.value
  }
}

impl CvtDelta {
  pub fn applyScalar(self: Self, scalar: Fixed) -> Fixed {
    return Fixed.fromI32(self.value) * scalar
  }
}

impl TupleDelta for CvtDelta {
  fn isPoint() -> bool {
    return false
  }

  fn new(position: u16, x: i32, y: i32) -> Self {
    return Self { position: position, value: x }
  }
}

impl<'a> Cvar<'a> {
  pub fn variationData(self: &Self, axisCount: u16) -> Option<CvtVariationData<'a>> {
    let count = Cvar.tupleVariationCount(self)
    let mut serialized = match move Cvar.data(self) {
      Result<FontData<'a>, ReadError>.Success { value } => value
      _ => {
        return Option<CvtVariationData<'a>>.None
      }
    }
    let headers = FontData.splitOff(
      &self._fontData,
      Cvar.tupleVariationHeadersByteRange(self).start,
    )
      |> Option<FontData<'a>>.unwrapOr(FontData.new(b""))
    let mut points = Option<PackedPointNumbers<'a>>.None
    if TupleVariationCount.sharedPointNumbers(count) {
      let split = PackedPointNumbers.splitOffFront(serialized)
      points = Option<PackedPointNumbers<'a>>.some(split.points)
      serialized = split.remainder
    }
    return Option<CvtVariationData<'a>>.some(
      TupleVariationData<'a, CvtDelta>.new(
        axisCount,
        Option<ComputedArray<'a, u16, Tuple<'a>>>.None,
        move points,
        count,
        headers,
        serialized,
      ),
    )
  }

  pub fn deltas(self: &Self, axisCount: u16, coords: &[F2Dot14], deltas: &mut [i32]) -> Option<()> {
    let data = match move Cvar.variationData(self, axisCount) {
      Option<CvtVariationData<'a>>.Some { value } => value
      _ => {
        return Option<()>.None
      }
    }
    let mut active = TupleVariationData<'a, CvtDelta>.activeTuplesAt(&data, coords)
    while let Option<ActiveTupleVariation<'a, CvtDelta>>.Some {
      value: entry
    } = move ActiveTupleVariationIter<CvtDelta>.next(&mut active) {
      let mut values = TupleVariation<'a, CvtDelta>.deltas(&entry.variation)
      while let Option<CvtDelta>.Some { value } = move TupleDeltaIter<'a, CvtDelta>.next(
        &mut values,
      ) {
        let i = u16.toUsize(value.position)
        if i < deltas.length {
          deltas[i] = i32.wrappingAdd(
            deltas[i],
            Fixed.toBits(CvtDelta.applyScalar(value, entry.scalar)),
          )
        }
      }
    }
    return Option<()>.some(())
  }
}
