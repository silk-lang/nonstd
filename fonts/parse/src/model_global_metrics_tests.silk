import silk.num.u32
import silk.num.usize

effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: found } => move found
    _ => {
      run Testing.expect(false, "metric fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T: Copy>(value: &Option<T>) -> T
  ! AssertionError<'static> {
  return match &value.* {
    Option<T>.Some { value: found } => found
    _ => {
      run Testing.expect(false, "metric exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn absent<T>(value: &Option<T>) -> bool {
  return match &value.* {
    Option<T>.None => true
    _ => false
  }
}

fn line(a: i32, d: i32) -> LineBox<F48Dot16> {
  return LineBox<F48Dot16> {
    ascender: F48Dot16.fromI32(a),
    descender: F48Dot16.fromI32(d),
    lineGap: F48Dot16.zero(),
  }
}

effect fn readMetrics<'a, 'c>(data: &'a [u8], coords: &'c [F2Dot14]) -> Metrics
  ! AssertionError<'static> {
  let font = run must(FontRef.new(data))
  return Metrics.fromSfnt(&font, coords)
}

effect fn expectLine(value: Option<LineBox<F48Dot16>>, a: i32, d: i32) -> ()
  ! AssertionError<'static> {
  let actual = run some(&value)
  run Testing.expect(
    F48Dot16.toI32(actual.ascender) == a && F48Dot16.toI32(actual.descender) == d
      && F48Dot16.toBits(actual.lineGap) == 0,
    "selected line",
  )
}

fn sameLine(a: &Option<LineBox<F48Dot16>>, b: &Option<LineBox<F48Dot16>>) -> bool {
  return match &a.* {
    Option<LineBox<F48Dot16>>.None => absent(b)
    Option<LineBox<F48Dot16>>.Some { value: x } => match &b.* {
      Option<LineBox<F48Dot16>>.Some { value: y } => &x.ascender == &y.ascender
        && &x.descender == &y.descender
        && &x.lineGap == &y.lineGap
      _ => false
    }
  }
}

fn sameValue(a: &Option<F48Dot16>, b: &Option<F48Dot16>) -> bool {
  return match &a.* {
    Option<F48Dot16>.None => absent(b)
    Option<F48Dot16>.Some { value: x } => match &b.* {
      Option<F48Dot16>.Some { value: y } => &x == &y
      _ => false
    }
  }
}

fn sameEnds(a: &Option<LineExtents<F48Dot16>>, b: &Option<LineExtents<F48Dot16>>) -> bool {
  return match &a.* {
    Option<LineExtents<F48Dot16>>.None => absent(b)
    Option<LineExtents<F48Dot16>>.Some { value: x } => match &b.* {
      Option<LineExtents<F48Dot16>>.Some { value: y } => &x.ascender == &y.ascender
        && &x.descender == &y.descender
      _ => false
    }
  }
}

effect fn unchanged(a: &Metrics, b: &Metrics) -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    a.unitsPerEm == b.unitsPerEm && a.rawUnitsPerEm == b.rawUnitsPerEm && a.numGlyphs == b.numGlyphs
      && &a.bounds.xMin == &b.bounds.xMin
      && &a.bounds.yMin == &b.bounds.yMin
      && &a.bounds.xMax == &b.bounds.xMax
      && &a.bounds.yMax == &b.bounds.yMax
      && sameValue(&a.maxHAdvance, &b.maxHAdvance)
      && sameValue(&a.maxVAdvance, &b.maxVAdvance)
      && sameValue(&a.averageCharWidth, &b.averageCharWidth),
    "non-varying metrics stay fixed",
  )
}

test effect fn theTypographicLineIsReadWhenTheFontAsks() -> ()
  ! AssertionError<'static> {
  let mut metrics = Metrics.default()
  metrics.hheaLine = Option<LineBox<F48Dot16>>.some(line(800, -200))
  metrics.typoLine = Option<LineBox<F48Dot16>>.some(line(750, -250))
  metrics.useTypoMetrics = true
  run expectLine(Metrics.hLine(&metrics), 750, -250)
}

test effect fn hheaIsReadWhenItDoesNot() -> ()
  ! AssertionError<'static> {
  let mut metrics = Metrics.default()
  metrics.hheaLine = Option<LineBox<F48Dot16>>.some(line(800, -200))
  metrics.typoLine = Option<LineBox<F48Dot16>>.some(line(750, -250))
  run expectLine(Metrics.hLine(&metrics), 800, -200)
}

test effect fn aSilentHheaGivesWayToTheTypographicLine() -> ()
  ! AssertionError<'static> {
  let mut metrics = Metrics.default()
  metrics.hheaLine = Option<LineBox<F48Dot16>>.some(line(0, 0))
  metrics.typoLine = Option<LineBox<F48Dot16>>.some(line(750, -250))
  run expectLine(Metrics.hLine(&metrics), 750, -250)
}

test effect fn aFontSilentTwiceOverFallsBackToTheClippingLine() -> ()
  ! AssertionError<'static> {
  let mut metrics = Metrics.default()
  metrics.hheaLine = Option<LineBox<F48Dot16>>.some(line(0, 0))
  metrics.typoLine = Option<LineBox<F48Dot16>>.some(line(0, 0))
  metrics.winLine = Option<LineExtents<F48Dot16>>.some(
    LineExtents<F48Dot16> { ascender: F48Dot16.fromI32(905), descender: F48Dot16.fromI32(-212) },
  )
  run expectLine(Metrics.hLine(&metrics), 905, -212)
}

test effect fn aFontStatingNoLineReportsNone() -> ()
  ! AssertionError<'static> {
  run Testing.expect(absent(&Metrics.hLine(&Metrics.default())), "no line")
}

test effect fn theThreeSetsOfLineMetricsAreKeptApart() -> ()
  ! AssertionError<'static> {
  let metrics = run readMetrics(tinos(), &[])
  run Testing.expect(metrics.unitsPerEm == 2048, "Tinos em")
  let hhea = run some(&metrics.hheaLine)
  let typo = run some(&metrics.typoLine)
  let win = run some(&metrics.winLine)
  run Testing.expect(
    F48Dot16.toBits(hhea.ascender) > 0 && F48Dot16.toBits(hhea.descender) < 0
      && F48Dot16.toBits(typo.ascender) > 0
      && F48Dot16.toBits(typo.descender) < 0
      && F48Dot16.toBits(win.ascender) > 0
      && F48Dot16.toBits(win.descender) < 0,
    "all lines use signed positions",
  )
}

test effect fn aFontWithoutATableLeavesItsMeasurementsUnset() -> ()
  ! AssertionError<'static> {
  let horizontal = run readMetrics(tinos(), &[])
  run Testing.expect(
    absent(&horizontal.vheaLine) && absent(&horizontal.maxVAdvance),
    "horizontal font lacks vertical metrics",
  )
  let vertical = run readMetrics(vorgFont(), &[])
  drop run some(&vertical.vheaLine)
  run Testing.expect(F48Dot16.toBits(run some(&vertical.maxVAdvance)) > 0, "vertical font maximum")
}

test effect fn aFontWithNothingToReadGivesUpRatherThanFailing() -> ()
  ! AssertionError<'static> {
  let metrics = run readMetrics(namesOnly(), &[])
  let mut expected = Metrics.default()
  expected.unitsPerEm = 1000
  run unchanged(&metrics, &expected)
  run Testing.expect(
    absent(&metrics.hheaLine) && absent(&metrics.vheaLine) && absent(&metrics.typoLine)
      && absent(&metrics.winLine)
      && absent(&metrics.xHeight)
      && absent(&metrics.capHeight)
      && !metrics.useTypoMetrics,
    "empty font metrics remain absent",
  )
}

test effect fn aDefaultLocationLeavesEveryMeasurementOnAWholeUnit() -> ()
  ! AssertionError<'static> {
  let metrics = run readMetrics(tinos(), &[])
  let value = (run some(&metrics.hheaLine)).ascender
  run Testing.expect(
    &value == &F48Dot16.fromI32(F48Dot16.toI32(value)),
    "whole font units at default",
  )
}

test effect fn aLocationMovesWhatMvarVaries() -> ()
  ! AssertionError<'static> {
  let coords: [F2Dot14; 12] = [F2Dot14.one(); 12]
  let base = run readMetrics(amstelvar(), &[])
  let far = run readMetrics(amstelvar(), &coords)
  run Testing.expect(
    !sameEnds(&base.winLine, &far.winLine) && !sameValue(&base.xHeight, &far.xHeight)
      && !sameValue(&base.capHeight, &far.capHeight),
    "MVAR moves clipping line and heights",
  )
}

test effect fn theTwoHorizontalLineSetsMoveTogether() -> ()
  ! AssertionError<'static> {
  let coords: [F2Dot14; 12] = [F2Dot14.one(); 12]
  let base = run readMetrics(amstelvar(), &[])
  let far = run readMetrics(amstelvar(), &coords)
  let shift = (run some(&far.hheaLine)).ascender - (run some(&base.hheaLine)).ascender
  let other = (run some(&far.typoLine)).ascender - (run some(&base.typoLine)).ascender
  run Testing.expect(F48Dot16.toBits(shift) != 0 && &shift == &other, "same ascender delta")
}

test effect fn aDeltaKeepsTheFractionTheVariationStoreComputed() -> ()
  ! AssertionError<'static> {
  let coords: [F2Dot14; 12] = [F2Dot14.fromF32(0.4); 12]
  let far = run readMetrics(amstelvar(), &coords)
  let hhea = run some(&far.hheaLine)
  let win = run some(&far.winLine)
  let values = [
    hhea.ascender,
    hhea.descender,
    win.ascender,
    win.descender,
    run some(&far.xHeight),
    run some(&far.capHeight),
  ]
  let mut fraction = false
  let mut i: usize = 0
  while i < 6 {
    if &values[i] != &F48Dot16.fromI32(F48Dot16.toI32(values[i])) {
      fraction = true
    }
    i = i + 1
  }
  run Testing.expect(fraction, "fractional MVAR precision")
}

test effect fn whatMvarCannotSayDoesNotMove() -> ()
  ! AssertionError<'static> {
  let coords: [F2Dot14; 12] = [F2Dot14.one(); 12]
  let base = run readMetrics(amstelvar(), &[])
  let far = run readMetrics(amstelvar(), &coords)
  run unchanged(&base, &far)
}

test effect fn aStaticFontReadsTheSameAtEveryLocation() -> ()
  ! AssertionError<'static> {
  let coords: [F2Dot14; 12] = [F2Dot14.one(); 12]
  let base = run readMetrics(tinos(), &[])
  let far = run readMetrics(tinos(), &coords)
  run unchanged(&base, &far)
  run Testing.expect(
    sameLine(&base.hheaLine, &far.hheaLine) && sameLine(&base.vheaLine, &far.vheaLine)
      && sameLine(&base.typoLine, &far.typoLine)
      && sameEnds(&base.winLine, &far.winLine)
      && sameValue(&base.xHeight, &far.xHeight)
      && sameValue(&base.capHeight, &far.capHeight)
      && base.useTypoMetrics == far.useTypoMetrics,
    "static values stay fixed",
  )
}

import silk.num.u8

fn be32(data: &[u8], at: usize) -> u32 {
  return u8.toU32(data[at]) * 16777216 + u8.toU32(data[at + 1]) * 65536
    + u8.toU32(data[at + 2]) * 256
    + u8.toU32(data[at + 3])
}

fn tableOffset(data: &[u8], tag: u32) -> usize {
  let count = u8.toUsize(data[4]) * 256 + u8.toUsize(data[5])
  let mut i: usize = 0
  while i < count {
    let at = 12 + i * 16
    if be32(data, at) == tag {
      return u32.toUsize(be32(data, at + 8))
    }
    i = i + 1
  }
  return 0
}

fn set16(data: &mut List<u8>, at: usize, value: u16) -> () {
  List<u8>.set(&mut data, at, u16.toU8(value / 256))
  List<u8>.set(&mut data, at + 1, u16.toU8(value & 255))
}

fn metricView<'a, 'c>(font: &FontRef<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(font, coords)
}

test effect fn descendersStoredPositiveAreBelowTheBaseline() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run positiveDescenderBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn positiveDescenderBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let original = tinos()
  let at = tableOffset(original, 0x68686561) + 6
  let old = u8.toU32(original[at]) * 256 + u8.toU32(original[at + 1])
  let positive = u32.toU16(65536 - old)
  let mut changed = List<u8>.make()
  run List<u8>.appendBytes(&mut changed, original)
  set16(&mut changed, at, positive)
  run Testing.expect(positive > 0 && positive < 32768, "stored descender is positive")
  let a = run readMetrics(original, &[])
  let b = run readMetrics(List<u8>.asSlice(&changed), &[])
  run Testing.expect(
    sameLine(&a.hheaLine, &b.hheaLine) && sameLine(&Metrics.hLine(&a), &Metrics.hLine(&b))
      && F48Dot16.toBits((run some(&Metrics.hLine(&b))).descender) < 0,
    "descender sign normalized",
  )
  let originalFont = run must(FontRef.new(original))
  let changedFont = run must(FontRef.new(List<u8>.asSlice(&changed)))
  let originalGlyphs = metricView(&originalFont, &[])
  let changedGlyphs = metricView(&changedFont, &[])
  run Testing.expect(!GlyphMetrics.statesVerticalAdvances(&changedGlyphs), "no vmtx")
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&originalGlyphs) {
    let glyph = GlyphId.new(i)
    run Testing.expect(
      &GlyphMetrics.vAdvanceExact(&originalGlyphs, glyph)
        == &GlyphMetrics.vAdvanceExact(&changedGlyphs, glyph),
      "vertical fallback unchanged",
    )
    i = i + 1
  }
}

test effect fn aFontStatingAnUnusableEmIsMeasuredOnAThousandUnits() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unusableEmBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unusableEmBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let original = tinos()
  let at = tableOffset(original, 0x68656164) + 18
  let stated: [u16; 4] = [0, 15, 16385, 65535]
  let reference = run readMetrics(original, &[])
  run Testing.expect(reference.unitsPerEm == 2048, "original em")
  let mut i: usize = 0
  while i < 4 {
    let mut data = List<u8>.make()
    run List<u8>.appendBytes(&mut data, original)
    set16(&mut data, at, stated[i])
    let metrics = run readMetrics(List<u8>.asSlice(&data), &[])
    run Testing.expect(
      metrics.unitsPerEm == 1000 && metrics.rawUnitsPerEm == stated[i],
      "unusable em fallback retains raw value",
    )
    i = i + 1
  }
  run Testing.expect(unitsPerEm(16) == 16 && unitsPerEm(16384) == 16384, "valid em endpoints")
}
