effect fn must<T>(value: Result<T, ReadError>) -> T
  ! AssertionError<'static> {
  return match move value {
    Result<T, ReadError>.Success { value: found } => move found
    _ => {
      run Testing.expect(false, "metric fixture parses")
      return Intrinsic.trap("test assertion")
    }
  }
}

effect fn some<T>(value: Option<T>) -> T
  ! AssertionError<'static> {
  return match move value {
    Option<T>.Some { value: found } => move found
    _ => {
      run Testing.expect(false, "metric exists")
      return Intrinsic.trap("test assertion")
    }
  }
}

fn metricView<'a, 'c>(font: &FontRef<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(font, coords)
}

fn scaled<'a, 'c>(metrics: GlyphMetrics<'a, 'c>, scale: ScaleF32) -> ScaledGlyphMetrics<
  'a,
  'c,
  'static,
  ScaleF32,
  f32,
  NoExtents
> {
  return GlyphMetrics<'a, 'c>.scaled<ScaleF32, f32>(metrics, scale)
}

fn line(ascender: f32, descender: f32) -> Option<LineExtents<f32>> {
  return Option<LineExtents<f32>>.some(
    LineExtents<f32> { ascender: ascender, descender: descender },
  )
}

fn absent<T>(value: &Option<T>) -> bool {
  return match &value.* {
    Option<T>.None => true
    _ => false
  }
}

fn sameBox(a: &Option<GlyphExtents<f32>>, b: &Option<GlyphExtents<f32>>) -> bool {
  return match &a.* {
    Option<GlyphExtents<f32>>.None => absent(b)
    Option<GlyphExtents<f32>>.Some { value: x } => match &b.* {
      Option<GlyphExtents<f32>>.Some { value: y } => x.xBearing == y.xBearing
        && x.yBearing == y.yBearing
        && x.width == y.width
        && x.height == y.height
      _ => false
    }
  }
}

struct Ink {
  value: GlyphExtents<f32>,
  mode: u32,
}

impl GlyphExtentsProvider<f32> for Ink {
  fn extents(self: &Self, glyph: GlyphId) -> Option<GlyphExtents<f32>> {
    let gid = GlyphId.toU32(glyph)
    if self.mode == 1 && gid % 2 != 0 {
      return Option<GlyphExtents<f32>>.None
    }
    if self.mode == 2 && gid % 3 == 0 {
      return Option<GlyphExtents<f32>>.None
    }
    if self.mode == 3 {
      return Option<GlyphExtents<f32>>.None
    }
    return Option<GlyphExtents<f32>>.some(self.value)
  }
}

fn ink(x: f32, y: f32, w: f32, h: f32, mode: u32) -> Ink {
  return Ink {
    value: GlyphExtents<f32> { xBearing: x, yBearing: y, width: w, height: h },
    mode: mode,
  }
}

test effect fn theTwoScalesAgreeWithinWhatEachCanHold() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let metrics = metricView(&font, &[])
  let coarse = GlyphMetrics.scaled26dot6(metrics, 16.0)
  let fine = GlyphMetrics.scaledF32(metrics, 16.0)
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&metrics) {
    let gid = GlyphId.new(i)
    let apart = f32.abs(
      F26Dot6.toF32(ScaledGlyphMetrics.hAdvance(&coarse, gid))
        - ScaledGlyphMetrics.hAdvance(&fine, gid),
    )
    run Testing.expect(apart < 1.0 / 32.0, "scale resolution")
    i = i + 1
  }
}

test effect fn aScaleWithASizePerAxisUsesEachInItsOwnDirection() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(mplusVertical()))
  let metrics = metricView(&font, &[])
  let upem = GlyphMetrics.unitsPerEm(&metrics)
  let em = u16.toF32(upem)
  let w = scaled(metrics, ScaleF32.new(em * 2.0, em, upem))
  let t = scaled(metrics, ScaleF32.new(em, em * 2.0, upem))
  let p = scaled(metrics, ScaleF32.new(em, em, upem))
  let gid = GlyphId.new(1)
  run Testing.expect(
    ScaledGlyphMetrics.hAdvance(&w, gid) == ScaledGlyphMetrics.hAdvance(&p, gid) * 2.0
      && ScaledGlyphMetrics.vAdvance(&w, gid) == ScaledGlyphMetrics.vAdvance(&p, gid)
      && ScaledGlyphMetrics.vAdvance(&t, gid) == ScaledGlyphMetrics.vAdvance(&p, gid) * 2.0
      && ScaledGlyphMetrics.hAdvance(&t, gid) == ScaledGlyphMetrics.hAdvance(&p, gid),
    "separate axis scaling",
  )
}

test effect fn freetypeScalesWholeDesignUnits() -> ()
  ! AssertionError<'static> {
  let fraction = F48Dot16.fromF64(10.5)
  let coarse = Scale26Dot6.fromPpem(1000.0, 1000)
  let fine = ScaleF32.fromPpem(1000.0, 1000)
  run Testing.expect(
    &Scale.scaleX(&coarse, fraction) == &F26Dot6.fromI32(11)
      && Scale.scaleX(&fine, fraction) == 10.5,
    "FreeType rounding precedes multiplication",
  )
}

test effect fn aRoundingScaleRoundsExtentsCornersBeforeSize() -> ()
  ! AssertionError<'static> {
  let extents = GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.fromF64(10.6),
    yBearing: F48Dot16.fromF64(-0.5),
    width: F48Dot16.fromF64(9.8),
    height: F48Dot16.fromI32(20),
  }
  let scale = Scale26Dot6.fromPpem(1000.0, 1000)
  let e = Scale.scaleGlyphExtents(&scale, extents)
  run Testing.expect(
    &e.xBearing == &F26Dot6.fromI32(11) && &e.yBearing == &F26Dot6.fromI32(-1)
      && &e.width == &F26Dot6.fromI32(9)
      && &e.height == &F26Dot6.fromI32(20),
    "rounded corners determine size",
  )
  let large = GlyphExtents<F48Dot16> {
    xBearing: F48Dot16.fromBits(6553600000 + 32767),
    yBearing: F48Dot16.fromI32(10),
    width: F48Dot16.fromI32(2),
    height: F48Dot16.fromI32(2),
  }
  run Testing.expect(
    &(Scale.scaleGlyphExtents(&scale, large)).xBearing == &F26Dot6.fromI32(100000),
    "large fixed corner retains fraction precision",
  )
}

test effect fn aStatedLineMeasuresAFontThatStatesNone() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let metrics = GlyphMetrics.scaledF32(metricView(&font, &[]), 16.0)
  let supplied = ScaledGlyphMetrics.withLineExtents(metrics, line(12.0, -4.0))
  let gid = GlyphId.new(1)
  run Testing.expect(
    ScaledGlyphMetrics.vAdvance(&supplied, gid) == 16.0
      && ScaledGlyphMetrics.vAdvance(&metrics, gid) != 16.0,
    "supplied line measures horizontal font",
  )
}

test effect fn aFontThatStatesItsOwnIgnoresTheLine() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(mplusVertical()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let supplied = ScaledGlyphMetrics.withLineExtents(metrics, line(99.0, -99.0))
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    run Testing.expect(
      ScaledGlyphMetrics.vAdvance(&metrics, gid) == ScaledGlyphMetrics.vAdvance(&supplied, gid),
      "vmtx overrides supplied line",
    )
    i = i + 1
  }
}

test effect fn statingNothingIsStatingNothing() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let metrics = GlyphMetrics.scaledF32(metricView(&font, &[]), 16.0)
  let supplied = ScaledGlyphMetrics.withLineExtents(metrics, Option<LineExtents<f32>>.None)
  run Testing.expect(
    ScaledGlyphMetrics.vAdvance(&supplied, GlyphId.new(1))
      == ScaledGlyphMetrics.vAdvance(&metrics, GlyphId.new(1)),
    "absent supplied line",
  )
}

test effect fn aBatchAgreesWithOneAtATime() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aBatchAgreesWithOneAtATimeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aBatchAgreesWithOneAtATimeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [tinos(), mplusVertical()]
  let mut f: usize = 0
  while f < 4 {
    let font = run must(FontRef.new(fonts[f / 2]))
    let raw = metricView(&font, &[])
    let mut metrics = GlyphMetrics.scaledF32(raw, 16.0)
    if f % 2 != 0 {
      metrics = ScaledGlyphMetrics.withLineExtents(metrics, line(12.0, -4.0))
    }
    let mut gids = List<GlyphId>.make()
    let mut h = List<f32>.make()
    let mut v = List<f32>.make()
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      run List<GlyphId>.append(&mut gids, GlyphId.new(i))
      run List<f32>.append(&mut h, 0.0)
      run List<f32>.append(&mut v, 0.0)
      i = i + 1
    }
    ScaledGlyphMetrics.hAdvanceBatched(
      &metrics,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&gids),
      List<f32>.asMutSlice(&mut h),
    )
    ScaledGlyphMetrics.vAdvanceBatched(
      &metrics,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&gids),
      List<f32>.asMutSlice(&mut v),
    )
    i = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      let gid = GlyphId.new(i)
      run Testing.expect(
        ScaledGlyphMetrics.hAdvance(&metrics, gid) == List<f32>.get(&h, u32.toUsize(i))
          && ScaledGlyphMetrics.vAdvance(&metrics, gid) == List<f32>.get(&v, u32.toUsize(i)),
        "scaled advance batch",
      )
      i = i + 1
    }
    f = f + 1
  }
}

test effect fn aScaledBoxIsTheFontBoxThroughTheScale() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aScaledBoxIsTheFontBoxThroughTheScaleBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aScaledBoxIsTheFontBoxThroughTheScaleBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
  let metrics = scaled(raw, scale)
  let mut checked: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    let mut expected = Option<GlyphExtents<f32>>.None
    if let Option<GlyphExtents<F48Dot16>>.Some { value } = run GlyphMetrics.extentsExact(
      &raw,
      gid,
    ) {
      expected = Option<GlyphExtents<f32>>.some(Scale.scaleGlyphExtents(&scale, value))
      checked = checked + 1
    }
    run Testing.expect(
      sameBox(&(run ScaledGlyphMetrics.extents(&metrics, gid)), &expected),
      "scaled glyph bounds",
    )
    i = i + 1
  }
  run Testing.expect(checked > 0, "bounds checked")
}

test effect fn aSuppliedMeasurementReplacesTheFontOne() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedMeasurementReplacesTheFontOneBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedMeasurementReplacesTheFontOneBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let supplied = ink(1.0, 2.0, 3.0, 4.0, 1)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  let mut replaced = false
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    let expected = GlyphExtentsProvider.extents(&supplied, gid)
    run Testing.expect(
      sameBox(&(run ScaledGlyphMetrics.extents(&overridden, gid)), &expected),
      "supplied ink wins including unavailable glyphs",
    )
    if !sameBox(&(run ScaledGlyphMetrics.extents(&metrics, gid)), &expected) {
      replaced = true
    }
    i = i + 1
  }
  run Testing.expect(replaced, "supplied ink differs")
}

test effect fn aSuppliedMeasurementAnswersAWholeRun() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedMeasurementAnswersAWholeRunBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedMeasurementAnswersAWholeRunBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let supplied = ink(5.0, 6.0, 7.0, 8.0, 2)
  let metrics = ScaledGlyphMetrics.withGlyphExtents(
    GlyphMetrics.scaledF32(raw, 16.0),
    Option<&Ink>.some(&supplied),
  )
  let mut gids = List<GlyphId>.make()
  let mut results = List<Option<GlyphExtents<f32>>>.make()
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    run List<GlyphId>.append(&mut gids, GlyphId.new(i))
    run List<Option<GlyphExtents<f32>>>.append(&mut results, Option<GlyphExtents<f32>>.None)
    i = i + 1
  }
  run ScaledGlyphMetrics.extentsBatched(
    &metrics,
    &IdentityConverter {},
    List<GlyphId>.asSlice(&gids),
    List<Option<GlyphExtents<f32>>>.asMutSlice(&mut results),
  )
  let outputs = List<Option<GlyphExtents<f32>>>.asSlice(&results)
  i = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    run Testing.expect(
      sameBox(&outputs[u32.toUsize(i)], &GlyphExtentsProvider.extents(&supplied, GlyphId.new(i))),
      "supplied bounds batch",
    )
    i = i + 1
  }
}

test effect fn noSuppliedMeasurementLeavesTheFontInPlace() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run noSuppliedMeasurementLeavesTheFontInPlaceBody()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn noSuppliedMeasurementLeavesTheFontInPlaceBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let unchanged = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&'static Ink>.None)
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    run Testing.expect(
      sameBox(
        &(run ScaledGlyphMetrics.extents(&unchanged, gid)),
        &(run ScaledGlyphMetrics.extents(&metrics, gid)),
      ),
      "absent provider preserves font extents",
    )
    i = i + 1
  }
}

test effect fn aSuppliedMeasurementCanBorrowForOneQuery() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedMeasurementCanBorrowForOneQueryBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedMeasurementCanBorrowForOneQueryBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let metrics = GlyphMetrics.scaledF32(metricView(&font, &[]), 16.0)
  let glyph = GlyphId.new(1)
  let original = run ScaledGlyphMetrics.extents(&metrics, glyph)
  if true {
    let local = ink(1.0, 2.0, 3.0, 4.0, 0)
    let borrowed = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&local))
    run Testing.expect(
      !sameBox(&(run ScaledGlyphMetrics.extents(&borrowed, glyph)), &original),
      "local provider changes one query",
    )
  }
  run Testing.expect(
    sameBox(&(run ScaledGlyphMetrics.extents(&metrics, glyph)), &original),
    "original remains available after local borrow",
  )
}

test effect fn vorgAnswersAheadOfEverythingElse() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vorgAnswersAheadOfEverythingElseBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vorgAnswersAheadOfEverythingElseBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(vorgFont()))
  let raw = metricView(&font, &[])
  let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
  let metrics = scaled(raw, scale)
  let vorg = run must(FontRef.vorg(&font))
  let supplied = ink(0.0, 999.0, 1.0, 1.0, 0)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  let mut i: u32 = 0
  while i < 4 {
    let gid = GlyphId.new(i)
    let expected = Scale.scaleY(
      &scale,
      F48Dot16.fromI32(i16.toI32(Vorg.verticalOriginY(&vorg, gid))),
    )
    run Testing.expect(
      (run ScaledGlyphMetrics.vOriginY(&metrics, gid)) == expected
        && (run ScaledGlyphMetrics.vOriginY(&overridden, gid)) == expected,
      "VORG overrides ink",
    )
    i = i + 1
  }
}

test effect fn vmtxUsesTheGlyfTopPhantomPoint() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run vmtxUsesTheGlyfTopPhantomPointBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vmtxUsesTheGlyfTopPhantomPointBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(mplusVertical()))
  let raw = metricView(&font, &[])
  let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
  let metrics = scaled(raw, scale)
  run Testing.expect(absent(&GlyphMetrics.statedVOrigin(&raw, GlyphId.new(1))), "no VORG")
  let mut checked: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    if let Option<GlyphExtents<F48Dot16>>.Some { value: e } = run GlyphMetrics.extentsExact(
      &raw,
      gid,
    ) {
      if let Option<F48Dot16>.Some { value: b } = GlyphMetrics.statedVBearing(&raw, gid) {
        let phantom = run some(run GlyphMetrics.glyfVOrigin(&raw, gid))
        run Testing.expect(
          (run ScaledGlyphMetrics.vOriginY(&metrics, gid)) == Scale.scaleY(&scale, phantom)
            && &phantom == &(e.yBearing + b),
          "top phantom includes vertical bearing",
        )
        checked = checked + 1
      }
    }
    i = i + 1
  }
  run Testing.expect(checked > 0, "vertical glyphs checked")
  let supplied = ink(0.0, 999.0, 1.0, 1.0, 0)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  run Testing.expect(
    (run ScaledGlyphMetrics.vOriginY(&overridden, GlyphId.new(1)))
      == (run ScaledGlyphMetrics.vOriginY(&metrics, GlyphId.new(1))),
    "glyf origin overrides supplied ink",
  )
}

test effect fn withoutVmtxTheInkIsCenteredInTheLine() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run withoutVmtxTheInkIsCenteredInTheLineBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn withoutVmtxTheInkIsCenteredInTheLineBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
  let metrics = scaled(raw, scale)
  run Testing.expect(
    absent(&GlyphMetrics.statedVBearing(&raw, GlyphId.new(1))),
    "no vertical bearing",
  )
  let ends = run some(GlyphMetrics.lineExtents(&raw))
  let height = Scale.scaleY(&scale, ends.ascender) - Scale.scaleY(&scale, ends.descender)
  let mut checked: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    if let Option<GlyphExtents<F48Dot16>>.Some { value } = run GlyphMetrics.extentsExact(
      &raw,
      gid,
    ) {
      let e = Scale.scaleGlyphExtents(&scale, value)
      run Testing.expect(
        (run ScaledGlyphMetrics.vOriginY(&metrics, gid)) == e.yBearing + (height - e.height) / 2.0,
        "ink centered in line",
      )
      checked = checked + 1
    }
    i = i + 1
  }
  run Testing.expect(checked > 0, "centered glyphs checked")
}

test effect fn anEmptyGlyphIsCenteredButUnavailableExtentsUseTheAscender() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run anEmptyGlyphIsCenteredButUnavailableExtentsUseTheAscenderBody()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anEmptyGlyphIsCenteredButUnavailableExtentsUseTheAscenderBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let ends = ScaledGlyphMetrics.originLine(&metrics)
  let supplied = ink(0.0, 0.0, 0.0, 0.0, 3)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  let mut checked: u32 = 0
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    if let Option<GlyphExtents<f32>>.Some { value } = run GlyphMetrics.extents(&raw, gid) {
      if value.xBearing == 0.0 && value.yBearing == 0.0 && value.width == 0.0
        && value.height == 0.0 {
        run Testing.expect(
          (run ScaledGlyphMetrics.vOriginY(&metrics, gid)) == (ends.ascender - ends.descender) / 2.0
            && (run ScaledGlyphMetrics.vOriginY(&overridden, gid)) == ends.ascender,
          "empty versus absent ink",
        )
        checked = checked + 1
      }
    }
    i = i + 1
  }
  run Testing.expect(checked > 0, "empty glyph checked")
}

test effect fn aSuppliedMeasurementMovesTheOriginWithIt() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedMeasurementMovesTheOriginWithItBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedMeasurementMovesTheOriginWithItBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let supplied = ink(0.0, 100.0, 10.0, 20.0, 0)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  let ends = ScaledGlyphMetrics.originLine(&metrics)
  let expected = 100.0 + (ends.ascender - ends.descender - 20.0) / 2.0
  let mut moved = false
  let mut gids = List<GlyphId>.make()
  let mut results = List<f32>.make()
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    run Testing.expect(
      (run ScaledGlyphMetrics.vOriginY(&overridden, gid)) == expected,
      "origin follows supplied ink",
    )
    if (run ScaledGlyphMetrics.vOriginY(&metrics, gid)) != expected {
      moved = true
    }
    run List<GlyphId>.append(&mut gids, gid)
    run List<f32>.append(&mut results, 0.0)
    i = i + 1
  }
  run Testing.expect(moved, "supplied ink moved origins")
  run ScaledGlyphMetrics.vOriginYBatched(
    &overridden,
    &IdentityConverter {},
    List<GlyphId>.asSlice(&gids),
    List<f32>.asMutSlice(&mut results),
  )
  let mut n: usize = 0
  while n < List<f32>.length(&results) {
    run Testing.expect(List<f32>.get(&results, n) == expected, "supplied origin batch")
    n = n + 1
  }
}

test effect fn aSuppliedLineMovesTheOriginWithIt() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedLineMovesTheOriginWithItBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedLineMovesTheOriginWithItBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let metrics = GlyphMetrics.scaledF32(raw, 16.0)
  let taller = ScaledGlyphMetrics.withLineExtents(metrics, line(100.0, -20.0))
  let mut checked = false
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    if !absent(&(run GlyphMetrics.extents(&raw, gid))) {
      run Testing.expect(
        (run ScaledGlyphMetrics.vOriginY(&taller, gid))
          != (run ScaledGlyphMetrics.vOriginY(&metrics, gid)),
        "supplied line moves origin",
      )
      checked = true
      break
    }
    i = i + 1
  }
  run Testing.expect(checked, "glyph has extents")
}

test effect fn aRunOfOriginsAgreesWithOneAtATime() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aRunOfOriginsAgreesWithOneAtATimeBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aRunOfOriginsAgreesWithOneAtATimeBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let fonts = [vorgFont(), mplusVertical(), tinos()]
  let mut f: usize = 0
  while f < 3 {
    let font = run must(FontRef.new(fonts[f]))
    let raw = metricView(&font, &[])
    let metrics = GlyphMetrics.scaledF32(raw, 16.0)
    let mut gids = List<GlyphId>.make()
    let mut results = List<f32>.make()
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      run List<GlyphId>.append(&mut gids, GlyphId.new(i))
      run List<f32>.append(&mut results, 0.0)
      i = i + 1
    }
    run ScaledGlyphMetrics.vOriginYBatched(
      &metrics,
      &IdentityConverter {},
      List<GlyphId>.asSlice(&gids),
      List<f32>.asMutSlice(&mut results),
    )
    i = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      run Testing.expect(
        (run ScaledGlyphMetrics.vOriginY(&metrics, GlyphId.new(i)))
          == List<f32>.get(&results, u32.toUsize(i)),
        "scaled origin batch",
      )
      i = i + 1
    }
    f = f + 1
  }
}

test effect fn aSuppliedLineIsTakenAsItWasGiven() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run aSuppliedLineIsTakenAsItWasGivenBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn aSuppliedLineIsTakenAsItWasGivenBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let font = run must(FontRef.new(tinos()))
  let metrics = ScaledGlyphMetrics.withLineExtents(
    GlyphMetrics.scaledF32(metricView(&font, &[]), 16.0),
    line(-100.0, 20.0),
  )
  let supplied = ink(0.0, 0.0, 0.0, 0.0, 3)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  run Testing.expect(
    (run ScaledGlyphMetrics.vOriginY(&overridden, GlyphId.new(1))) == -100.0
      && ScaledGlyphMetrics.vAdvance(&metrics, GlyphId.new(1)) == -120.0,
    "supplied line signs unchanged",
  )
}

import model.metrics { Metrics }
import silk.geometry.rect { Rect }
import test_font_builder as Builder
import silk.core.ownership { Copy }

struct Rounding {
  ppem: f32,
  upem: u16,
}

impl Copy for Rounding {}

impl Scale<f32> for Rounding {
  fn add(a: f32, b: f32) -> f32 {
    return a + b
  }

  fn sub(a: f32, b: f32) -> f32 {
    return a - b
  }

  fn half(value: f32) -> f32 {
    return value / 2.0
  }

  fn scaleX(self: &Self, value: F48Dot16) -> f32 {
    return f32.round(F48Dot16.toF32(value) * self.ppem / u16.toF32(self.upem))
  }

  fn scaleY(self: &Self, value: F48Dot16) -> f32 {
    return Scale.scaleX(self, value)
  }

  fn scaleGlyphExtents(self: &Self, e: GlyphExtents<F48Dot16>) -> GlyphExtents<f32> {
    return GlyphExtents<f32> {
      xBearing: Scale.scaleX(self, e.xBearing),
      yBearing: Scale.scaleY(self, e.yBearing),
      width: Scale.scaleX(self, e.width),
      height: Scale.scaleY(self, e.height),
    }
  }

  fn scaleRect(self: &Self, b: Rect<F48Dot16>) -> Rect<f32> {
    return Rect<f32> {
      xMin: Scale.scaleX(self, b.xMin),
      yMin: Scale.scaleY(self, b.yMin),
      xMax: Scale.scaleX(self, b.xMax),
      yMax: Scale.scaleY(self, b.yMax),
    }
  }
}

fn rounded<'a, 'c>(metrics: GlyphMetrics<'a, 'c>, scale: Rounding) -> ScaledGlyphMetrics<
  'a,
  'c,
  'static,
  Rounding,
  f32,
  NoExtents
> {
  return GlyphMetrics<'a, 'c>.scaled<Rounding, f32>(metrics, scale)
}

test effect fn aRoundingScaleRoundsTheEndsOfTheLineNotTheHeight() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let fromFont = run some(GlyphMetrics.lineExtents(&raw))
  let sizes: [f32; 7] = [11.0, 12.0, 13.0, 14.0, 16.0, 19.0, 24.0]
  let mut apart = false
  let mut i: usize = 0
  while i < sizes.length {
    let scale = Rounding { ppem: sizes[i], upem: GlyphMetrics.unitsPerEm(&raw) }
    let metrics = rounded(raw, scale)
    let ends = LineExtents<f32> {
      ascender: Scale.scaleY(&scale, fromFont.ascender),
      descender: Scale.scaleY(&scale, fromFont.descender),
    }
    let expected = ends.ascender - ends.descender
    let supplied = ScaledGlyphMetrics.withLineExtents(metrics, Option<LineExtents<f32>>.some(ends))
    run Testing.expect(
      ScaledGlyphMetrics.vAdvance(&metrics, GlyphId.new(1)) == expected
        && ScaledGlyphMetrics.vAdvance(&supplied, GlyphId.new(1)) == expected,
      "round line ends before subtraction",
    )
    if Scale.scaleY(&scale, fromFont.ascender - fromFont.descender) != expected {
      apart = true
    }
    i = i + 1
  }
  run Testing.expect(apart, "rounding height would differ")
}

test effect fn theScaledLineIsTheOneTheGlyphMetricsStackBy() -> ()
  ! AssertionError<'static> {
  let font = run must(FontRef.new(tinos()))
  let raw = metricView(&font, &[])
  let global = Metrics.fromSfnt(&font, &[])
  let fromFont = run some(Metrics.hLine(&global))
  let sizes: [f32; 6] = [11.0, 12.0, 13.0, 16.0, 19.0, 24.0]
  let mut n: usize = 0
  while n < sizes.length {
    let scale = Rounding { ppem: sizes[n], upem: global.unitsPerEm }
    let expected = Scale.scaleY(&scale, fromFont.ascender)
      - Scale.scaleY(&scale, fromFont.descender)
    let metrics = rounded(raw, scale)
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      run Testing.expect(
        ScaledGlyphMetrics.vAdvance(&metrics, GlyphId.new(i)) == expected,
        "glyphs stack by individually scaled global line ends",
      )
      i = i + 1
    }
    n = n + 1
  }
}

struct LineProvider<'a> {
  font: FontRef<'a>,
  hhea: Option<FontData<'a>>,
  hideHhea: bool,
}

impl<'a> TableProvider<'a> for LineProvider<'a> {
  fn dataForTag(self: &Self, tag: Tag) -> Option<FontData<'a>> {
    let value = Tag.toU32(tag)
    if value == 0x4f532f32 {
      return Option<FontData<'a>>.None
    }
    if value == 0x68686561 {
      if self.hideHhea {
        return Option<FontData<'a>>.None
      }
      if let Option<FontData<'a>>.Some { value: replacement } = &self.hhea {
        return Option<FontData<'a>>.some(replacement)
      }
    }
    return FontRef.tableData(&self.font, tag)
  }
}

fn lineMetrics<'a, 'c>(provider: &LineProvider<'a>, coords: &'c [F2Dot14]) -> GlyphMetrics<'a, 'c> {
  return GlyphMetrics<'a, 'c>.new(provider, coords)
}

effect fn provider<'a>(data: &'a [u8], hhea: Option<FontData<'a>>, hideHhea: bool) -> LineProvider<
  'a
>
  ! AssertionError<'static> {
  return LineProvider<'a> { font: run must(FontRef.new(data)), hhea: move hhea, hideHhea: hideHhea }
}

test effect fn aFontStatingNoLineIsGivenOneProportionedToItsEm() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run fallbackLineBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn fallbackLineBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let source = run provider(tinos(), Option<FontData<'static>>.None, true)
  let raw = lineMetrics(&source, &[])
  run Testing.expect(
    absent(&GlyphMetrics.lineExtents(&raw)) && GlyphMetrics.unitsPerEm(&raw) > 0,
    "line removed but em survives",
  )
  let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
  let metrics = scaled(raw, scale)
  let supplied = ink(0.0, 0.0, 0.0, 0.0, 3)
  let overridden = ScaledGlyphMetrics.withGlyphExtents(metrics, Option<&Ink>.some(&supplied))
  let upem = u16.toI32(GlyphMetrics.unitsPerEm(&raw))
  let ascender = F48Dot16.fromF64(u16.toF64(GlyphMetrics.unitsPerEm(&raw)) * 0.8)
  let mut checked = false
  let mut i: u32 = 0
  while i < GlyphMetrics.numGlyphs(&raw) {
    let gid = GlyphId.new(i)
    if let Option<GlyphExtents<f32>>.Some { value } = run GlyphMetrics.extents(&raw, gid) {
      if value.width == 0.0 && value.height == 0.0 {
        run Testing.expect(
          (run ScaledGlyphMetrics.vOriginY(&metrics, gid))
            == Scale.scaleY(&scale, F48Dot16.fromI32(upem)) / 2.0
            && (run ScaledGlyphMetrics.vOriginY(&overridden, gid)) == Scale.scaleY(&scale, ascender)
            && ScaledGlyphMetrics.vAdvance(&metrics, gid)
              == Scale.scaleY(&scale, ascender)
                - Scale.scaleY(&scale, ascender - F48Dot16.fromI32(upem)),
          "80 percent em ascender and whole em height",
        )
        checked = true
        break
      }
    }
    i = i + 1
  }
  run Testing.expect(checked, "empty glyph checked with no line")
}

test effect fn theEndsOfTheLineAreSignedWhateverTheFontSays() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lineSignsBody() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lineSignsBody() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut bytes = List<u8>.make()
  run List<u8>.appendBytes(&mut bytes, tinos())
  let font = run must(FontRef.new(List<u8>.asSlice(&bytes)))
  let rawTable = run some(FontRef.tableData(&font, Tag.fromU32(0x68686561)))
  let mut hhea = List<u8>.make()
  run List<u8>.appendBytes(&mut hhea, FontData.asBytes(&rawTable))
  let signs: [[u16; 2]; 4] = [[1600, 65136], [1600, 400], [63936, 400], [63936, 65136]]
  let mut expectedOrigins = List<f32>.make()
  let mut expectedAdvances = List<f32>.make()
  let mut emptyExpected = false
  let mut n: usize = 0
  while n < 4 {
    Builder.put16(List<u8>.asMutSlice(&mut hhea), 4, signs[n][0])
    Builder.put16(List<u8>.asMutSlice(&mut hhea), 6, signs[n][1])
    let source = run provider(
      List<u8>.asSlice(&bytes),
      Option<FontData>.some(FontData.new(List<u8>.asSlice(&hhea))),
      false,
    )
    let raw = lineMetrics(&source, &[])
    let scale = ScaleF32.fromPpem(16.0, GlyphMetrics.unitsPerEm(&raw))
    let metrics = scaled(raw, scale)
    let mut i: u32 = 0
    while i < GlyphMetrics.numGlyphs(&raw) {
      let gid = GlyphId.new(i)
      let origin = run ScaledGlyphMetrics.vOriginY(&metrics, gid)
      let advance = ScaledGlyphMetrics.vAdvance(&metrics, gid)
      if n == 0 {
        run List<f32>.append(&mut expectedOrigins, origin)
        run List<f32>.append(&mut expectedAdvances, advance)
        if let Option<GlyphExtents<f32>>.Some { value } = run GlyphMetrics.extents(&raw, gid) {
          if value.width == 0.0 && value.height == 0.0 {
            run Testing.expect(
              origin == Scale.scaleY(&scale, F48Dot16.fromI32(1000)),
              "stored line sets empty glyph origin",
            )
            emptyExpected = true
          }
        }
      } else {
        run Testing.expect(
          origin == List<f32>.get(&expectedOrigins, u32.toUsize(i))
            && advance == List<f32>.get(&expectedAdvances, u32.toUsize(i)),
          "font line signs normalize consistently",
        )
      }
      i = i + 1
    }
    n = n + 1
  }
  run Testing.expect(emptyExpected, "empty glyph used stored line")
}
