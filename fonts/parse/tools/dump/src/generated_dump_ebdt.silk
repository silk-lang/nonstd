pub effect fn dumpEbdt<'a>(path: &mut DumpPath, value: Ebdt<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    610746941,
    FontData.len(&Ebdt<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Ebdt<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "majorVersion")
    let fieldValue = Ebdt<'a>.majorVersion(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "minorVersion")
    let fieldValue = Ebdt<'a>.minorVersion(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "EBDT")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1161970772)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1161970772) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Ebdt<'a>.read(data) {
          Result<Ebdt<'a>, ReadError>.Success { value: table } => run dumpEbdt(&mut path, table)
          Result<Ebdt<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
