pub effect fn dumpHmtx<'a>(path: &mut DumpPath, value: Hmtx<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3620700273,
    FontData.len(&Hmtx<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Hmtx<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "hMetrics")
    let fieldValue = Hmtx<'a>.hMetrics(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), LongMetric<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), LongMetric<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), LongMetric<'a>>.get(&fieldValue, index) {
        Result<LongMetric<'a>, ReadError>.Success { value: item } => run dumpLongMetric(
          &mut path,
          item,
          base,
        )
        Result<LongMetric<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "leftSideBearings")
    let fieldValue = Hmtx<'a>.leftSideBearings(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, i16>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, i16>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<i16>.Some { value: item } = move ScalarArray<'a, i16>.get(&fieldValue, index) {
        run scalar(&path, item)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  run extensions_metrics.dumpHmtx(&mut path, value)
}

