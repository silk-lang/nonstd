pub effect fn dumpLongMetric<'a>(
  path: &mut DumpPath,
  value: LongMetric<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "advance")
    let fieldValue = LongMetric<'a>.advance(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "sideBearing")
    let fieldValue = LongMetric<'a>.sideBearing(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "hmtx")
    match move FontRef<'a>.hmtx(font) {
      Result<Hmtx<'a>, ReadError>.Success { value: table } => run dumpHmtx(&mut path, table)
      Result<Hmtx<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "HMTX")
    match move FontRef<'a>.hmtxExtended(font) {
      Result<HmtxExtended<'a>, ReadError>.Success { value: table } => run dumpHmtxExtended(
        &mut path,
        table,
      )
      Result<HmtxExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
}
