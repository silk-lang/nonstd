import read_fonts.lib { FontRef, ReadError, ComputedArray }
import read_fonts.tables.maxp { SelectedMaxp }
import read_fonts.tables.hvar { Hvar }
import read_fonts.tables.vvar { Vvar }
import read_fonts.tables.mvar { Mvar, ValueRecord }
import read_fonts.tables.variations { ItemVariationStore, VariationRegionList }
import font_types.lib { GlyphId, F2Dot14, Fixed, F48Dot16 }
import dump_support { DumpPath, scalar, absent, readError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.collections.slice { Slice }
import silk.num.u16
import silk.num.u32

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = match move FontRef.selectedMaxp(font) {
    Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp.numGlyphs(&value)
    _ => 0
  }
  DumpPath.push(&mut path, "HVARMetrics")
  match move FontRef.hvar(font) {
    Result<Hvar<'a>, ReadError>.Success { value } => run dumpHvar(&mut path, value, count)
    Result<Hvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "VVARMetrics")
  match move FontRef.vvar(font) {
    Result<Vvar<'a>, ReadError>.Success { value } => run dumpVvar(&mut path, value, count)
    Result<Vvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "MVARMetrics")
  match move FontRef.mvar(font) {
    Result<Mvar<'a>, ReadError>.Success { value } => run dumpMvar(&mut path, value, count)
    Result<Mvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn dumpHvar<'a>(path: &mut DumpPath, table: Hvar<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let store = Hvar.itemVariationStore(&table)
  let axisCount = match move store {
    Result<ItemVariationStore<'a>, ReadError>.Success {
      value
    } => match move ItemVariationStore.variationRegionList(&value) {
      Result<VariationRegionList<'a>, ReadError>.Success { value: regions } => u16.toUsize(
        VariationRegionList.axisCount(&regions),
      )
      _ => 0
    }
    _ => 0
  }
  let locations: [i16; 4] = [0, -8192, 8192, 16384]
  let mut coordinates = [F2Dot14.zero(); 65535]
  let mut location: usize = 0
  while location < 4 {
    DumpPath.setIndex(&mut path, location)
    let mut axis: usize = 0
    while axis < axisCount {
      coordinates[axis] = F2Dot14.fromBits(locations[location])
      axis = axis + 1
    }
    let coords = Slice.view<F2Dot14>(&coordinates, 0, axisCount)
    DumpPath.push(&mut path, "glyphs")
    let mut glyph: u32 = 0
    while glyph <= count {
      DumpPath.setIndex(&mut path, u32.toUsize(glyph))
      let gid = GlyphId.new(glyph)
      DumpPath.push(&mut path, "advanceDelta")
      match move Hvar.advanceDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "lsbDelta")
      match move Hvar.lsbDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "rsbDelta")
      match move Hvar.rsbDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      glyph = glyph + 1
    }
    DumpPath.pop(&mut path)
    location = location + 1
  }
  DumpPath.clearIndex(&mut path)
}

effect fn dumpVvar<'a>(path: &mut DumpPath, table: Vvar<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let store = Vvar.itemVariationStore(&table)
  let axisCount = match move store {
    Result<ItemVariationStore<'a>, ReadError>.Success {
      value
    } => match move ItemVariationStore.variationRegionList(&value) {
      Result<VariationRegionList<'a>, ReadError>.Success { value: regions } => u16.toUsize(
        VariationRegionList.axisCount(&regions),
      )
      _ => 0
    }
    _ => 0
  }
  let locations: [i16; 4] = [0, -8192, 8192, 16384]
  let mut coordinates = [F2Dot14.zero(); 65535]
  let mut location: usize = 0
  while location < 4 {
    DumpPath.setIndex(&mut path, location)
    let mut axis: usize = 0
    while axis < axisCount {
      coordinates[axis] = F2Dot14.fromBits(locations[location])
      axis = axis + 1
    }
    let coords = Slice.view<F2Dot14>(&coordinates, 0, axisCount)
    DumpPath.push(&mut path, "glyphs")
    let mut glyph: u32 = 0
    while glyph <= count {
      DumpPath.setIndex(&mut path, u32.toUsize(glyph))
      let gid = GlyphId.new(glyph)
      DumpPath.push(&mut path, "advanceDelta")
      match move Vvar.advanceDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "tsbDelta")
      match move Vvar.tsbDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "bsbDelta")
      match move Vvar.bsbDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "vOriginYDelta")
      match move Vvar.vOriginYDelta(&table, gid, coords) {
        Option<F48Dot16>.Some { value } => run scalar(&path, F48Dot16.toBits(value))
        Option<F48Dot16>.None => run absent(&path)
      }
      DumpPath.pop(&mut path)
      glyph = glyph + 1
    }
    DumpPath.pop(&mut path)
    location = location + 1
  }
  DumpPath.clearIndex(&mut path)
}

effect fn dumpMvar<'a>(path: &mut DumpPath, table: Mvar<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let store = Mvar.itemVariationStore(&table)
  let axisCount = match move store {
    Option<Result<ItemVariationStore<'a>, ReadError>>.Some {
      value: Result<ItemVariationStore<'a>, ReadError>.Success { value }
    } => match move ItemVariationStore.variationRegionList(&value) {
      Result<VariationRegionList<'a>, ReadError>.Success { value: regions } => u16.toUsize(
        VariationRegionList.axisCount(&regions),
      )
      _ => 0
    }
    _ => 0
  }
  let locations: [i16; 4] = [0, -8192, 8192, 16384]
  let mut coordinates = [F2Dot14.zero(); 65535]
  let mut location: usize = 0
  while location < 4 {
    DumpPath.setIndex(&mut path, location)
    let mut axis: usize = 0
    while axis < axisCount {
      coordinates[axis] = F2Dot14.fromBits(locations[location])
      axis = axis + 1
    }
    let coords = Slice.view<F2Dot14>(&coordinates, 0, axisCount)
    let records = Mvar.valueRecords(&table)
    DumpPath.push(&mut path, "records")
    let mut index: usize = 0
    while index < ComputedArray<'a, (), ValueRecord<'a>>.len(&records) {
      DumpPath.setIndex(&mut path, index)
      match move ComputedArray<'a, (), ValueRecord<'a>>.get(&records, index) {
        Result<ValueRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
        Result<ValueRecord<'a>, ReadError>.Success { value } => match move Mvar.metricDelta(
          &table,
          ValueRecord.valueTag(&value),
          coords,
        ) {
          Option<Fixed>.Some { value: delta } => run scalar(&path, Fixed.toBits(delta))
          Option<Fixed>.None => run absent(&path)
        }
      }
      index = index + 1
    }
    DumpPath.pop(&mut path)
    location = location + 1
  }
  DumpPath.clearIndex(&mut path)
}
