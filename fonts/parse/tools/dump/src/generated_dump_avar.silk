pub effect fn dumpSegmentMaps<'a>(
  path: &mut DumpPath,
  value: SegmentMaps<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "positionMapCount")
    let fieldValue = SegmentMaps<'a>.positionMapCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "axisValueMaps")
    let fieldValue = SegmentMaps<'a>.axisValueMaps(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), AxisValueMap<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), AxisValueMap<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), AxisValueMap<'a>>.get(&fieldValue, index) {
        Result<AxisValueMap<'a>, ReadError>.Success { value: item } => run dumpAxisValueMap(
          &mut path,
          item,
          base,
        )
        Result<AxisValueMap<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

