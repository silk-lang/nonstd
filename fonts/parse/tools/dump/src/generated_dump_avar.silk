        match move Avar<'a>.read(data) {
          Result<Avar<'a>, ReadError>.Success { value: table } => run dumpAvar(&mut path, table)
          Result<Avar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
