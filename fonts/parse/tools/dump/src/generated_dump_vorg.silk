  let base = Vorg<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Vorg<'a>.version(&value)
    DumpPath.push(&mut path, "major")
    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "defaultVertOriginY")
    let fieldValue = Vorg<'a>.defaultVertOriginY(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numVertOriginYMetrics")
    let fieldValue = Vorg<'a>.numVertOriginYMetrics(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "vertOriginYMetrics")
    let fieldValue = Vorg<'a>.vertOriginYMetrics(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), VertOriginYMetrics<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), VertOriginYMetrics<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), VertOriginYMetrics<'a>>.get(&fieldValue, index) {
        Result<VertOriginYMetrics<'a>, ReadError>.Success {
          value: item
        } => run dumpVertOriginYMetrics(&mut path, item, base)
        Result<VertOriginYMetrics<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
