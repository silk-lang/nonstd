pub effect fn dumpVorg<'a>(path: &mut DumpPath, value: Vorg<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    783236373,
    FontData.len(&Vorg<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
