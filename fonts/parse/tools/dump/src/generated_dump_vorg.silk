}

pub effect fn dumpVertOriginYMetrics<'a>(
  path: &mut DumpPath,
  value: VertOriginYMetrics<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "glyphIndex")
    let fieldValue = VertOriginYMetrics<'a>.glyphIndex(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "vertOriginY")
    let fieldValue = VertOriginYMetrics<'a>.vertOriginY(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "VORG")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1448038983)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1448038983) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Vorg<'a>.read(data) {
          Result<Vorg<'a>, ReadError>.Success { value: table } => run dumpVorg(&mut path, table)
          Result<Vorg<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
