import read_fonts.tables.post { Post, GlyphNames, GlyphNameEntry }
import font_types.lib { GlyphId, GlyphId16 }
import dump_support { DumpPath, scalar, absent, bytes }
import silk.core.option { Option }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

pub effect fn dumpPost<'a>(path: &mut DumpPath, table: Post<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = Post<'a>.numNames(&table)
  DumpPath.push(&mut path, "numNames")
  run scalar(&path, count)
  DumpPath.pop(&mut path)
  let mut names = Post<'a>.glyphNames(&table)
  DumpPath.push(&mut path, "glyphNames")
  let mut i: usize = 0
  while true {
    match move GlyphNames<'a>.next(&mut names) {
      Option<GlyphNameEntry<'a>>.None => {
        break
      }
      Option<GlyphNameEntry<'a>>.Some { value } => {
        DumpPath.setIndex(&mut path, i)
        DumpPath.push(&mut path, "glyph")
        run scalar(&path, GlyphId.toU32(value.glyph))
        DumpPath.pop(&mut path)
        DumpPath.push(&mut path, "name")
        run bytes(&path, String.utf8Bytes(value.name))
        DumpPath.pop(&mut path)
        i = i + 1
      }
    }
  }
  DumpPath.clearIndex(&mut path)
  DumpPath.push(&mut path, "length")
  run scalar(&path, i)
  DumpPath.pop(&mut path)
  DumpPath.pop(&mut path)

  // Probe direct lookup independently of cached iteration, including out-of-range IDs.
  let probes: [usize; 8] = [0, 1, 2, count / 4, count / 2, count, 65534, 65535]
  DumpPath.push(&mut path, "nameProbes")
  i = 0
  while i < probes.length {
    DumpPath.setIndex(&mut path, i)
    match move Post<'a>.glyphName(&table, GlyphId16.new(usize.toU16(probes[i]))) {
      Option<string<'a>>.Some { value } => run bytes(&path, String.utf8Bytes(value))
      _ => run absent(&path)
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}
