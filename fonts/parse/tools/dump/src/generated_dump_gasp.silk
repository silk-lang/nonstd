pub effect fn dumpGasp<'a>(path: &mut DumpPath, value: Gasp<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2812310489,
    FontData.len(&Gasp<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Gasp<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Gasp<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numRanges")
    let fieldValue = Gasp<'a>.numRanges(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "gaspRanges")
    let fieldValue = Gasp<'a>.gaspRanges(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), GaspRange<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), GaspRange<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), GaspRange<'a>>.get(&fieldValue, index) {
        Result<GaspRange<'a>, ReadError>.Success { value: item } => run dumpGaspRange(
          &mut path,
          item,
          base,
        )
        Result<GaspRange<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpGaspRange<'a>(path: &mut DumpPath, value: GaspRange<'a>, base: FontData<'a>) -> ()
  ! WriterError
  ? &mut Writer {
