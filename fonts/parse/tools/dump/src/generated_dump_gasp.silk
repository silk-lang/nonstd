        match move Gasp<'a>.read(data) {
          Result<Gasp<'a>, ReadError>.Success { value: table } => run dumpGasp(&mut path, table)
          Result<Gasp<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
