          &mut path,
        )
        Result<CoverageTable<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

