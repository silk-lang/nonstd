        Result<CaretValue<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
          &table,
          &mut path,
        )
        Result<CaretValue<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpCaretValue<'a>(path: &mut DumpPath, value: CaretValue<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    CaretValue<'a>.Format1 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1")
      DumpPath.pop(&mut path)
      run dumpCaretValueFormat1(&mut path, table)
    }
    CaretValue<'a>.Format2 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2")
      DumpPath.pop(&mut path)
      run dumpCaretValueFormat2(&mut path, table)
    }
    CaretValue<'a>.Format3 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format3")
      DumpPath.pop(&mut path)
      run dumpCaretValueFormat3(&mut path, table)
    }
  }
}

