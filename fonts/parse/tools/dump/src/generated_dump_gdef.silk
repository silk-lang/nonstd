import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "GDEF")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1195656518)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1195656518) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Gdef<'a>.read(data) {
          Result<Gdef<'a>, ReadError>.Success { value: table } => run dumpGdef(&mut path, table)
          Result<Gdef<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
