import read_fonts.lib { FontRef, FontData, ReadError, VarLenArray, VarLenIter, ScalarArray }
import read_fonts.tables.mort {
  Mort,
  Chain,
  Subtable,
  SubtableKind,
  SubtableParts,
  ContextualSubtable,
  LigatureSubtable
}
import read_fonts.tables.maxp { SelectedMaxp }
import read_fonts.tables.aat { TypedLookup, LookupU16 }
import font_types.lib { GlyphId16 }
import extensions_aat_common { dumpLegacyState, dumpArray, dumpGlyphs, dumpLookupU16 }
import dump_support { DumpPath, scalar, readError, absent }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = match move FontRef.selectedMaxp(font) {
    Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp.numGlyphs(&value)
    _ => 0
  }
  DumpPath.push(&mut path, "mortKinds")
  match move FontRef.mort(font) {
    Result<Mort<'a>, ReadError>.Success { value } => {
      let mut chains = VarLenArray<'a, Chain<'a>>.iter(&Mort.chains(&value))
      let mut i: usize = 0
      while let Option<Result<Chain<'a>, ReadError>>.Some { value: result } = move VarLenIter<
        'a,
        Chain<'a>
      >.next(&mut chains) {
        DumpPath.setIndex(&mut path, i)
        match move result {
          Result<Chain<'a>, ReadError>.Success { value: chain } => {
            DumpPath.push(&mut path, "subtables")
            let mut subtables = VarLenArray<'a, Subtable<'a>>.iter(&Chain.subtables(&chain))
            let mut j: usize = 0
            while let Option<Result<Subtable<'a>, ReadError>>.Some {
              value: subtableResult
            } = move VarLenIter<'a, Subtable<'a>>.next(&mut subtables) {
              DumpPath.setIndex(&mut path, j)
              match move subtableResult {
                Result<Subtable<'a>, ReadError>.Success { value: subtable } => run dumpSubtable(
                  &mut path,
                  subtable,
                  count,
                )
                Result<Subtable<'a>, ReadError>.Failure { error } => run readError(&path, error)
              }
              j = j + 1
            }
            DumpPath.pop(&mut path)
          }
          Result<Chain<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        i = i + 1
      }
    }
    Result<Mort<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn dumpSubtable<'a>(path: &mut DumpPath, subtable: Subtable<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let data = ScalarArray<u8>.offsetData(&Subtable.data(&subtable))
  DumpPath.push(&mut path, "isLogical")
  run scalar(&path, Subtable.isLogical(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isAllDirections")
  run scalar(&path, Subtable.isAllDirections(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isBackwards")
  run scalar(&path, Subtable.isBackwards(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isVertical")
  run scalar(&path, Subtable.isVertical(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "parts")
  match move SubtableKind<'a>.parts(data, Subtable.coverage(&subtable)) {
    Result<SubtableParts, ReadError>.Success { value: parts } => {
      DumpPath.push(&mut path, "format")
      run scalar(&path, parts.format)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "nClasses")
      run scalar(&path, parts.state.nClasses)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "classOffset")
      run scalar(&path, parts.state.classTableOffset)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "stateOffset")
      run scalar(&path, parts.state.stateArrayOffset)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "entryOffset")
      run scalar(&path, parts.state.entryTableOffset)
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "extra0")
      run scalar(&path, parts.extra[0])
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "extra1")
      run scalar(&path, parts.extra[1])
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "extra2")
      run scalar(&path, parts.extra[2])
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "fromParts")
      match move SubtableKind<'a>.fromParts(data, &parts) {
        Result<SubtableKind<'a>, ReadError>.Success { value } => run scalar(&path, "ok")
        Result<SubtableKind<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      DumpPath.pop(&mut path)
    }
    Result<SubtableParts, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "kind")
  match move Subtable.kind(&subtable) {
    Result<SubtableKind<'a>, ReadError>.Success { value: kind } => {
      match kind {
        SubtableKind<'a>.Rearrangement { value } => {
          run scalar(&path, "Rearrangement")
          DumpPath.push(&mut path, "state")
          run dumpLegacyState(&mut path, value, data, count)
          DumpPath.pop(&mut path)
        }
        SubtableKind<'a>.Contextual { value } => {
          run scalar(&path, "Contextual")
          DumpPath.push(&mut path, "state")
          run dumpLegacyState(&mut path, value.stateTable, data, count)
          DumpPath.pop(&mut path)
          let offsets: [i16; 5] = [-32768, -1, 0, 1, 32767]
          let gids: [u16; 4] = [0, 1, 2, 65535]
          DumpPath.push(&mut path, "substitutions")
          let mut i: usize = 0
          while i < 5 {
            let mut j: usize = 0
            while j < 4 {
              DumpPath.setIndex(&mut path, i * 4 + j)
              match move ContextualSubtable.substitution(
                &value,
                offsets[i],
                GlyphId16.new(gids[j]),
              ) {
                Result<GlyphId16, ReadError>.Success { value: glyph } => run scalar(
                  &path,
                  GlyphId16.toU32(glyph),
                )
                Result<GlyphId16, ReadError>.Failure { error } => run readError(&path, error)
              }
              j = j + 1
            }
            i = i + 1
          }
          DumpPath.pop(&mut path)
        }
        SubtableKind<'a>.Ligature { value } => {
          run scalar(&path, "Ligature")
          DumpPath.push(&mut path, "state")
          run dumpLegacyState(&mut path, value.stateTable, data, count)
          DumpPath.pop(&mut path)
          if true {
            let offsets: [usize; 4] = [0, 2, 4, 65535]
            DumpPath.push(&mut path, "ligatureAction")
            let mut i: usize = 0
            while i < 4 {
              DumpPath.setIndex(&mut path, i)
              match move LigatureSubtable.ligatureAction(&value, offsets[i]) {
                Result<u32, ReadError>.Success { value: found } => run scalar(&path, found)
                Result<u32, ReadError>.Failure { error } => run readError(&path, error)
              }
              i = i + 1
            }
            DumpPath.pop(&mut path)
          }
          if true {
            let offsets: [i32; 4] = [-1, 0, 1, 65535]
            DumpPath.push(&mut path, "component")
            let mut i: usize = 0
            while i < 4 {
              DumpPath.setIndex(&mut path, i)
              match move LigatureSubtable.component(&value, offsets[i]) {
                Result<u16, ReadError>.Success { value: found } => run scalar(&path, found)
                Result<u16, ReadError>.Failure { error } => run readError(&path, error)
              }
              i = i + 1
            }
            DumpPath.pop(&mut path)
          }
          if true {
            let offsets: [usize; 4] = [0, 2, 4, 65535]
            DumpPath.push(&mut path, "ligature")
            let mut i: usize = 0
            while i < 4 {
              DumpPath.setIndex(&mut path, i)
              match move LigatureSubtable.ligature(&value, offsets[i]) {
                Result<GlyphId16, ReadError>.Success { value: found } => run scalar(
                  &path,
                  GlyphId16.toU32(found),
                )
                Result<GlyphId16, ReadError>.Failure { error } => run readError(&path, error)
              }
              i = i + 1
            }
            DumpPath.pop(&mut path)
          }
        }
        SubtableKind<'a>.NonContextual { value } => {
          run scalar(&path, "NonContextual")
          run dumpLookupU16(&mut path, value, count)
        }
        SubtableKind<'a>.Insertion { value } => {
          run scalar(&path, "Insertion")
          DumpPath.push(&mut path, "state")
          run dumpLegacyState(&mut path, value.stateTable, data, count)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "glyphs")
          run dumpGlyphs(&mut path, value.glyphs)
          DumpPath.pop(&mut path)
        }
      }
    }
    Result<SubtableKind<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}
