pub effect fn dumpCblc<'a>(path: &mut DumpPath, value: Cblc<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    360152757,
    FontData.len(&Cblc<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Cblc<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "majorVersion")
    let fieldValue = Cblc<'a>.majorVersion(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "minorVersion")
    let fieldValue = Cblc<'a>.minorVersion(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "numSizes")
    let fieldValue = Cblc<'a>.numSizes(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "bitmapSizes")
    let fieldValue = Cblc<'a>.bitmapSizes(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), BitmapSize<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), BitmapSize<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), BitmapSize<'a>>.get(&fieldValue, index) {
        Result<BitmapSize<'a>, ReadError>.Success { value: item } => run dumpBitmapSize(
          &mut path,
          item,
          base,
        )
        Result<BitmapSize<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "CBLC")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1128418371)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1128418371) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Cblc<'a>.read(data) {
          Result<Cblc<'a>, ReadError>.Success { value: table } => run dumpCblc(&mut path, table)
          Result<Cblc<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
