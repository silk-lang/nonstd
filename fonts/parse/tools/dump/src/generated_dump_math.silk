  if true {
    DumpPath.push(&mut path, "device")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    match move MathValueRecord<'a>.device(&value, base) {
      Option<Result<DeviceOrVariationIndex<'a>, ReadError>>.None => run absent(&path)
