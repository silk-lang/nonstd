        run scalar(&path, Offset16.toU32(item))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "vertGlyphConstructions")
    let targetArgs: [u64; 3] = [0, 0, 0]
    let resolvedArray = MathVariants<'a>.vertGlyphConstructions(&value)
    DumpPath.push(&mut path, "length")
    run scalar(
      &path,
      ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.len(&resolvedArray),
    )
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.len(&resolvedArray) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, targetArgs)
      let resolved = ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.get(
        &resolvedArray,
        index,
      )
      match move resolved {
        Result<MathGlyphConstruction<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
          &table,
          &mut path,
        )
        Result<MathGlyphConstruction<'a>, ReadError>.Failure { error } => run readError(
          &path,
          error,
        )
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "horizGlyphConstructionOffsets")
    let fieldValue = MathVariants<'a>.horizGlyphConstructionOffsets(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, Offset16>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, Offset16>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<Offset16>.Some { value: item } = move ScalarArray<'a, Offset16>.get(
        &fieldValue,
        index,
      ) {
        run scalar(&path, Offset16.toU32(item))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "horizGlyphConstructions")
    let targetArgs: [u64; 3] = [0, 0, 0]
    let resolvedArray = MathVariants<'a>.horizGlyphConstructions(&value)
    DumpPath.push(&mut path, "length")
    run scalar(
      &path,
      ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.len(&resolvedArray),
    )
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.len(&resolvedArray) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, targetArgs)
      let resolved = ArrayOfOffsets<'a, (), MathGlyphConstruction<'a>, Offset16>.get(
        &resolvedArray,
        index,
      )
      match move resolved {
        Result<MathGlyphConstruction<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
          &table,
          &mut path,
        )
        Result<MathGlyphConstruction<'a>, ReadError>.Failure { error } => run readError(
          &path,
          error,
        )
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpMathGlyphConstruction<'a>(
  path: &mut DumpPath,
  value: MathGlyphConstruction<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    1985745208,
    FontData.len(&MathGlyphConstruction<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = MathGlyphConstruction<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "glyphAssemblyOffset")
    let fieldValue = MathGlyphConstruction<'a>.glyphAssemblyOffset(&value)
    let rawOffset = Nullable<Offset16>.offset(&fieldValue).*
    run scalar(&path, Offset16.toU32(rawOffset))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "glyphAssembly")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    match move MathGlyphConstruction<'a>.glyphAssembly(&value) {
      Option<Result<GlyphAssembly<'a>, ReadError>>.None => run absent(&path)
      Option<Result<GlyphAssembly<'a>, ReadError>>.Some { value: resolved } => {
        match move resolved {
          Result<GlyphAssembly<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
            &table,
            &mut path,
          )
          Result<GlyphAssembly<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "variantCount")
    let fieldValue = MathGlyphConstruction<'a>.variantCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "mathGlyphVariantRecords")
    let fieldValue = MathGlyphConstruction<'a>.mathGlyphVariantRecords(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), MathGlyphVariantRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), MathGlyphVariantRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), MathGlyphVariantRecord<'a>>.get(&fieldValue, index) {
        Result<MathGlyphVariantRecord<'a>, ReadError>.Success {
          value: item
        } => run dumpMathGlyphVariantRecord(&mut path, item, base)
        Result<MathGlyphVariantRecord<'a>, ReadError>.Failure { error } => run readError(
          &path,
          error,
        )
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpMathGlyphVariantRecord<'a>(
  path: &mut DumpPath,
  value: MathGlyphVariantRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "variantGlyph")
    let fieldValue = MathGlyphVariantRecord<'a>.variantGlyph(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "advanceMeasurement")
    let fieldValue = MathGlyphVariantRecord<'a>.advanceMeasurement(&value)
    run scalar(&path, UfWord.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpGlyphAssembly<'a>(path: &mut DumpPath, value: GlyphAssembly<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    752447235,
    FontData.len(&GlyphAssembly<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = GlyphAssembly<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "italicsCorrection")
    let fieldValue = GlyphAssembly<'a>.italicsCorrection(&value)
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    run dumpMathValueRecord(&mut path, fieldValue, base)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "partCount")
    let fieldValue = GlyphAssembly<'a>.partCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "partRecords")
    let fieldValue = GlyphAssembly<'a>.partRecords(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), GlyphPartRecord<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), GlyphPartRecord<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), GlyphPartRecord<'a>>.get(&fieldValue, index) {
        Result<GlyphPartRecord<'a>, ReadError>.Success { value: item } => run dumpGlyphPartRecord(
          &mut path,
          item,
          base,
        )
        Result<GlyphPartRecord<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpGlyphPartRecord<'a>(
  path: &mut DumpPath,
  value: GlyphPartRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "glyphId")
    let fieldValue = GlyphPartRecord<'a>.glyphId(&value)
    run scalar(&path, GlyphId16.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "startConnectorLength")
    let fieldValue = GlyphPartRecord<'a>.startConnectorLength(&value)
    run scalar(&path, UfWord.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "endConnectorLength")
    let fieldValue = GlyphPartRecord<'a>.endConnectorLength(&value)
    run scalar(&path, UfWord.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "fullAdvance")
    let fieldValue = GlyphPartRecord<'a>.fullAdvance(&value)
    run scalar(&path, UfWord.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "partFlags")
    let fieldValue = GlyphPartRecord<'a>.partFlags(&value)
    run scalar(&path, PartFlags.bits(&fieldValue))
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "MATH")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1296127048)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1296127048) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Math<'a>.read(data) {
          Result<Math<'a>, ReadError>.Success { value: table } => run dumpMath(&mut path, table)
          Result<Math<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
