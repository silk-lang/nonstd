import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "morx")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1836020344)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1836020344) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Morx<'a>.read(data) {
          Result<Morx<'a>, ReadError>.Success { value: table } => run dumpMorx(&mut path, table)
          Result<Morx<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
