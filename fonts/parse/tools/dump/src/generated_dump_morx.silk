pub effect fn dumpMorx<'a>(path: &mut DumpPath, value: Morx<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    1797329985,
    FontData.len(&Morx<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Morx<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Morx<'a>.version(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "unused")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Morx<'a>.unusedByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nChains")
    let fieldValue = Morx<'a>.nChains(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "chains")
    let fieldValue = Morx<'a>.chains(&value)
    let mut counter = VarLenArray<'a, Chain<'a>>.iter(&fieldValue)
    let mut count: usize = 0
    while true {
      if let Option<Result<Chain<'a>, ReadError>>.None = move VarLenIter<'a, Chain<'a>>.next(
        &mut counter,
      ) {
        break
      }
      count = count + 1
    }
    DumpPath.push(&mut path, "length")
    run scalar(&path, count)
    DumpPath.pop(&mut path)
    let mut iter = VarLenArray<'a, Chain<'a>>.iter(&fieldValue)
    let mut index: usize = 0
    while index < count {
      DumpPath.beginTable(&mut path)
      DumpPath.setIndex(&mut path, index)
      if let Option<Result<Chain<'a>, ReadError>>.Some { value: result } = move VarLenIter<
        'a,
        Chain<'a>
      >.next(&mut iter) {
        match move result {
          Result<Chain<'a>, ReadError>.Success { value: item } => run dumpChain(
            &mut path,
            move item,
          )
          Result<Chain<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

