      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), TrackTableEntry<'a>>.get(&fieldValue, index) {
        Result<TrackTableEntry<'a>, ReadError>.Success { value: item } => run dumpTrackTableEntry(
          &mut path,
          item,
          base,
        )
        Result<TrackTableEntry<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpTrackTableEntry<'a>(
  path: &mut DumpPath,
  value: TrackTableEntry<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "track")
    let fieldValue = TrackTableEntry<'a>.track(&value)
    run scalar(&path, Fixed.toBits(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nameIndex")
    let fieldValue = TrackTableEntry<'a>.nameIndex(&value)
    run scalar(&path, NameId.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "offset")
    let fieldValue = TrackTableEntry<'a>.offset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "trak")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1953653099)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1953653099) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Trak<'a>.read(data) {
          Result<Trak<'a>, ReadError>.Success { value: table } => run dumpTrak(&mut path, table)
          Result<Trak<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
