  let base = TrackData<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "nTracks")
    let fieldValue = TrackData<'a>.nTracks(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nSizes")
    let fieldValue = TrackData<'a>.nSizes(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "sizeTableOffset")
    let fieldValue = TrackData<'a>.sizeTableOffset(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "trackTable")
    let fieldValue = TrackData<'a>.trackTable(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), TrackTableEntry<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
