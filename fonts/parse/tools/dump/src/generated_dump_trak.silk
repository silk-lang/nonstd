pub effect fn dumpTrackData<'a>(path: &mut DumpPath, value: TrackData<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    785477030,
    FontData.len(&TrackData<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
