pub effect fn dumpFeatureParams<'a>(path: &mut DumpPath, value: FeatureParams<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    FeatureParams<'a>.StylisticSet { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "StylisticSet")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    FeatureParams<'a>.Size { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Size")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    FeatureParams<'a>.CharacterVariant { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "CharacterVariant")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
  }
}
