import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "name")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1851878757)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1851878757) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Name<'a>.read(data) {
          Result<Name<'a>, ReadError>.Success { value: table } => run dumpName(&mut path, table)
          Result<Name<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
