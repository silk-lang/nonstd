  if true {
    DumpPath.push(&mut path, "length")
    let fieldValue = LangTagRecord<'a>.length(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "langTagOffset")
    let fieldValue = LangTagRecord<'a>.langTagOffset(&value)
    run scalar(&path, Offset16.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
}

