import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "gvar")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1735811442)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1735811442) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Gvar<'a>.read(data) {
          Result<Gvar<'a>, ReadError>.Success { value: table } => run dumpGvar(&mut path, table)
          Result<Gvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "GVAR")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1196835154)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1196835154) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move GvarExtended<'a>.read(data) {
          Result<GvarExtended<'a>, ReadError>.Success { value: table } => run dumpGvarExtended(
            &mut path,
            table,
          )
          Result<GvarExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
