import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "hhea")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1751672161)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1751672161) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Hhea<'a>.read(data) {
          Result<Hhea<'a>, ReadError>.Success { value: table } => run dumpHhea(&mut path, table)
          Result<Hhea<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "HHEA")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1212695873)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1212695873) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move HheaExtended<'a>.read(data) {
          Result<HheaExtended<'a>, ReadError>.Success { value: table } => run dumpHheaExtended(
            &mut path,
            table,
          )
          Result<HheaExtended<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
