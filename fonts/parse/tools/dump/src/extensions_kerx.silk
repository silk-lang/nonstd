  FontRef,
  FontData,
  ReadError,
  ScalarArray,
  ComputedArray,
  VarLenArray,
  VarLenIter
}
import read_fonts.tables.kerx {
  Kerx,
  Subtable,
  SubtableKind,
  Subtable0,
  Subtable2,
  Subtable1,
  Subtable4,
  Subtable4Actions,
  Subtable6
}
import read_fonts.tables.kerx { Subtable0Pair }
import read_fonts.tables.maxp { SelectedMaxp }
import read_fonts.tables.aat { StateTable, NoPayload }
import font_types.lib { GlyphId, GlyphId16 }
import extensions_aat_common {
  dumpArray,
  dumpLookupU16,
  dumpLookupU32,
  dumpExtendedState,
  dumpLegacyState
}
import generated_dump_kerx
import dump_support { DumpPath, scalar, bytes, readError, absent }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = match move FontRef.selectedMaxp(font) {
    Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp.numGlyphs(&value)
    _ => 0
  }
  DumpPath.push(&mut path, "kerxKinds")
  match move FontRef.kerx(font) {
    Result<Kerx<'a>, ReadError>.Success { value } => {
      DumpPath.push(&mut path, "subtables")
      let mut iter = VarLenArray<'a, Subtable<'a>>.iter(&Kerx.subtables(&value))
      let mut i: usize = 0
      while let Option<Result<Subtable<'a>, ReadError>>.Some { value: result } = move VarLenIter<
        'a,
        Subtable<'a>
      >.next(&mut iter) {
        DumpPath.setIndex(&mut path, i)
        match move result {
          Result<Subtable<'a>, ReadError>.Success { value: table } => run dumpSubtable(
            &mut path,
            table,
            count,
          )
          Result<Subtable<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        i = i + 1
      }
      DumpPath.pop(&mut path)
    }
    Result<Kerx<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn dumpSubtable<'a>(path: &mut DumpPath, subtable: Subtable<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let data = ScalarArray<u8>.offsetData(&Subtable.data(&subtable))
  DumpPath.push(&mut path, "isVertical")
  run scalar(&path, Subtable.isVertical(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isHorizontal")
  run scalar(&path, Subtable.isHorizontal(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isCrossStream")
  run scalar(&path, Subtable.isCrossStream(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isVariable")
  run scalar(&path, Subtable.isVariable(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "processDirection")
  run scalar(&path, Subtable.processDirection(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "kind")
  match move Subtable.kind(&subtable) {
    Result<SubtableKind<'a>, ReadError>.Success { value: kind } => {
      match move kind {
        SubtableKind<'a>.Format0 { value } => {
          run scalar(&path, "Format0")
          DumpPath.beginTable(&mut path)
          run generated_dump_kerx.dumpSubtable0(&mut path, value)
          let pairs = Subtable0.pairs(&value)
          DumpPath.push(&mut path, "pairLookups")
          let mut i: usize = 0
          while i < ComputedArray<'a, (), Subtable0Pair<'a>>.len(&pairs) {
            DumpPath.setIndex(&mut path, i)
            if let Result<Subtable0Pair<'a>, ReadError>.Success {
              value: pair
            } = move ComputedArray<'a, (), Subtable0Pair<'a>>.get(&pairs, i) {
              match move Subtable0.kerning(
                &value,
                GlyphId.new(GlyphId16.toU32(Subtable0Pair.left(&pair))),
                GlyphId.new(GlyphId16.toU32(Subtable0Pair.right(&pair))),
              ) {
                Option<i32>.Some { value: adjustment } => run scalar(&path, adjustment)
                _ => run absent(&path)
              }
            }
            i = i + 1
          }
          DumpPath.pop(&mut path)
          run probes0(&mut path, &value, count)
        }
        SubtableKind<'a>.Format1 { value } => {
          run scalar(&path, "Format1")
          DumpPath.push(&mut path, "state")
          run dumpExtendedState(&mut path, value.stateTable, data, count)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "values")
          run dumpArray<i16>(&mut path, value.values)
          DumpPath.pop(&mut path)
        }
        SubtableKind<'a>.Format2 { value } => {
          run scalar(&path, "Format2")
          DumpPath.push(&mut path, "leftOffsetTable")
          run dumpLookupU16(&mut path, value.leftOffsetTable, count)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "rightOffsetTable")
          run dumpLookupU16(&mut path, value.rightOffsetTable, count)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "array")
          run dumpArray<i16>(&mut path, value.array)
          DumpPath.pop(&mut path)
          run probes2(&mut path, &value, count)
        }
        SubtableKind<'a>.Format4 { value } => {
          run scalar(&path, "Format4")
          DumpPath.push(&mut path, "state")
          run dumpExtendedState(&mut path, value.stateTable, data, count)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "flags")
          run scalar(&path, value.flags)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "actions")
          match value.actions {
            Subtable4Actions<'a>.ControlPoints { values } => {
              run scalar(&path, "ControlPoints")
              run dumpArray<u16>(&mut path, values)
            }
            Subtable4Actions<'a>.AnchorPoints { values } => {
              run scalar(&path, "AnchorPoints")
              run dumpArray<u16>(&mut path, values)
            }
            Subtable4Actions<'a>.ControlPointCoords { values } => {
              run scalar(&path, "ControlPointCoords")
              run dumpArray<i16>(&mut path, values)
            }
          }
          DumpPath.pop(&mut path)
        }
        SubtableKind<'a>.Format6 { value } => {
          run scalar(&path, "Format6")
          run probes6(&mut path, &value, count)
          match move value {
            Subtable6<'a>.ShortValues { rows, columns, array, vector } => {
              DumpPath.push(&mut path, "valueKind")
              run scalar(&path, "ShortValues")
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "rows")
              run dumpLookupU16(&mut path, rows, count)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "columns")
              run dumpLookupU16(&mut path, columns, count)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "array")
              run dumpArray<i16>(&mut path, array)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "vector")
              match move vector {
                Option<ScalarArray<'a, i16>>.Some { value: values } => run dumpArray<i16>(
                  &mut path,
                  values,
                )
                _ => run absent(&path)
              }
              DumpPath.pop(&mut path)
            }
            Subtable6<'a>.LongValues { rows, columns, array, vector } => {
              DumpPath.push(&mut path, "valueKind")
              run scalar(&path, "LongValues")
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "rows")
              run dumpLookupU32(&mut path, rows, count)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "columns")
              run dumpLookupU32(&mut path, columns, count)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "array")
              run dumpArray<i32>(&mut path, array)
              DumpPath.pop(&mut path)
              DumpPath.push(&mut path, "vector")
              match move vector {
                Option<ScalarArray<'a, i16>>.Some { value: values } => run dumpArray<i16>(
                  &mut path,
                  values,
                )
                _ => run absent(&path)
              }
              DumpPath.pop(&mut path)
            }
          }
        }
      }
    }
    Result<SubtableKind<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn probes0<'a>(path: &mut DumpPath, value: &Subtable0<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let mut last: u32 = 0
  if count > 0 {
    last = count - 1
  }
  let glyphs: [u32; 8] = [0, 1, 2, 31, last, count, 65535, 65536]
  DumpPath.push(&mut path, "kernings")
  let mut i: usize = 0
  while i < 8 {
    let mut j: usize = 0
    while j < 8 {
      DumpPath.setIndex(&mut path, i * 8 + j)
      match move Subtable0.kerning(value, GlyphId.new(glyphs[i]), GlyphId.new(glyphs[j])) {
        Option<i32>.Some { value: adjustment } => run scalar(&path, adjustment)
        _ => run absent(&path)
      }
      j = j + 1
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

