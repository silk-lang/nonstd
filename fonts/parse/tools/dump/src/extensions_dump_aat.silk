pub effect fn dumpTypedLookup<'a, T>(path: &mut DumpPath, value: TypedLookup<'a, T>) -> ()
  ! WriterError
  ? &mut Writer {
  run dumpLookup(&mut path, value.lookup)
}
// DUMP_IMPL impl<'a, T> DumpTable<'a> for TypedLookup<'a, T> { effect fn dump(self: &Self, path: &mut DumpPath) -> () ! WriterError ? &mut Writer { run dumpTypedLookup(&mut path, self.*) } }
