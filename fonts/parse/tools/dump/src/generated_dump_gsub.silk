pub effect fn dumpLigature2<'a>(path: &mut DumpPath, value: Ligature2<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    3784829153,
    FontData.len(&Ligature2<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Ligature2<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "ligatureGlyph")
    let fieldValue = Ligature2<'a>.ligatureGlyph(&value)
    run scalar(&path, GlyphId24.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "componentCount")
    let fieldValue = Ligature2<'a>.componentCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "componentGlyphIds")
    let fieldValue = Ligature2<'a>.componentGlyphIds(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ScalarArray<'a, GlyphId24>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ScalarArray<'a, GlyphId24>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      if let Option<GlyphId24>.Some { value: item } = move ScalarArray<'a, GlyphId24>.get(
        &fieldValue,
        index,
      ) {
        run scalar(&path, GlyphId24.toU32(item))
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpMultipleSubst<'a>(path: &mut DumpPath, value: MultipleSubst<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    MultipleSubst<'a>.Format1 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1")
      DumpPath.pop(&mut path)
      run dumpMultipleSubstFormat1(&mut path, table)
    }
    MultipleSubst<'a>.Format2 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2")
      DumpPath.pop(&mut path)
      run dumpMultipleSubstFormat2(&mut path, table)
    }
  }
}

