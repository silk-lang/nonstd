pub effect fn dumpExtensionSubtable<'a>(path: &mut DumpPath, value: ExtensionSubtable<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    ExtensionSubtable<'a>.Single { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Single")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.Multiple { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Multiple")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.Alternate { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Alternate")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.Ligature { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Ligature")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.Contextual { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Contextual")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.ChainContextual { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "ChainContextual")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
    ExtensionSubtable<'a>.Reverse { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Reverse")
      DumpPath.pop(&mut path)
      run DumpTable.dump(&table, &mut path)
    }
  }
}

