import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "GSUB")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1196643650)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1196643650) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Gsub<'a>.read(data) {
          Result<Gsub<'a>, ReadError>.Success { value: table } => run dumpGsub(&mut path, table)
          Result<Gsub<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
