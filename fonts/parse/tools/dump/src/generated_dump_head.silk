import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "head")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1751474532)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1751474532) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Head<'a>.read(data) {
          Result<Head<'a>, ReadError>.Success { value: table } => run dumpHead(&mut path, table)
          Result<Head<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
