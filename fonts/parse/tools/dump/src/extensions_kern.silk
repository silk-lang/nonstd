import read_fonts.lib {
  FontRef,
  FontData,
  ReadError,
  ScalarArray,
  ComputedArray,
  VarLenArray,
  VarLenIter
}
import read_fonts.tables.kern {
  Kern,
  Subtable,
  SubtableKind,
  Subtable0,
  Subtable2,
  OtKern,
  AatKern,
  OtSubtable,
  AatSubtable,
  Subtables,
  Subtable2ClassTable,
  Subtable3
}
import read_fonts.tables.kerx { Subtable0Pair }
import read_fonts.tables.maxp { SelectedMaxp }
import read_fonts.tables.aat { StateTable, NoPayload }
import font_types.lib { GlyphId, GlyphId16 }
import extensions_aat_common {
  dumpArray,
  dumpLookupU16,
  dumpLookupU32,
  dumpExtendedState,
  dumpLegacyState
}
import generated_dump_kern
import dump_support { DumpPath, scalar, bytes, readError, absent }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = match move FontRef.selectedMaxp(font) {
    Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp.numGlyphs(&value)
    _ => 0
  }
  DumpPath.push(&mut path, "kernKinds")
  match move FontRef.kern(font) {
    Result<Kern<'a>, ReadError>.Success { value } => {
      DumpPath.beginTable(&mut path)
      match value {
        Kern<'a>.Ot { value: table } => run generated_dump_kern.dumpOtKern(&mut path, table)
        Kern<'a>.Aat { value: table } => run generated_dump_kern.dumpAatKern(&mut path, table)
      }
      DumpPath.push(&mut path, "subtables")
      let mut iter = Kern.subtables(&value)
      let mut i: usize = 0
      while let Option<Result<Subtable<'a>, ReadError>>.Some {
        value: result
      } = move Subtables.next(&mut iter) {
        DumpPath.setIndex(&mut path, i)
        match move result {
          Result<Subtable<'a>, ReadError>.Success { value: table } => run dumpSubtable(
            &mut path,
            table,
            count,
          )
          Result<Subtable<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        i = i + 1
      }
      DumpPath.pop(&mut path)
    }
    Result<Kern<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn dumpSubtable<'a>(path: &mut DumpPath, subtable: Subtable<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.beginTable(&mut path)
  let mut data = FontData.new(b"")
  match subtable {
    Subtable<'a>.Ot { value } => {
      run generated_dump_kern.dumpOtSubtable(&mut path, value)
      data = ScalarArray<u8>.offsetData(&OtSubtable.data(&value))
    }
    Subtable<'a>.Aat { value } => {
      run generated_dump_kern.dumpAatSubtable(&mut path, value)
      data = ScalarArray<u8>.offsetData(&AatSubtable.data(&value))
    }
  }
  DumpPath.push(&mut path, "isVertical")
  run scalar(&path, Subtable.isVertical(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isHorizontal")
  run scalar(&path, Subtable.isHorizontal(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isCrossStream")
  run scalar(&path, Subtable.isCrossStream(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isVariable")
  run scalar(&path, Subtable.isVariable(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "isStateMachine")
  run scalar(&path, Subtable.isStateMachine(&subtable))
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "kind")
  match move Subtable.kind(&subtable) {
    Result<SubtableKind<'a>, ReadError>.Success { value: kind } => {
      match move kind {
        SubtableKind<'a>.Format0 { value } => {
          run scalar(&path, "Format0")
          DumpPath.beginTable(&mut path)
          run generated_dump_kern.dumpSubtable0(&mut path, value)
          let pairs = Subtable0.pairs(&value)
          DumpPath.push(&mut path, "pairLookups")
          let mut i: usize = 0
          while i < ComputedArray<'a, (), Subtable0Pair<'a>>.len(&pairs) {
            DumpPath.setIndex(&mut path, i)
            if let Result<Subtable0Pair<'a>, ReadError>.Success {
              value: pair
            } = move ComputedArray<'a, (), Subtable0Pair<'a>>.get(&pairs, i) {
              match move Subtable0.kerning(
                &value,
                GlyphId.new(GlyphId16.toU32(Subtable0Pair.left(&pair))),
                GlyphId.new(GlyphId16.toU32(Subtable0Pair.right(&pair))),
              ) {
                Option<i32>.Some { value: adjustment } => run scalar(&path, adjustment)
                _ => run absent(&path)
              }
            }
            i = i + 1
          }
          DumpPath.pop(&mut path)
          run probes0(&mut path, &value, count)
        }
        SubtableKind<'a>.Format1 { value } => {
          run scalar(&path, "Format1")
          DumpPath.push(&mut path, "state")
          run dumpLegacyState(&mut path, value, data, count)
          DumpPath.pop(&mut path)
        }
        SubtableKind<'a>.Format2 { value } => {
          run scalar(&path, "Format2")
          DumpPath.push(&mut path, "headerLen")
          run scalar(&path, value.headerLen)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "arrayOffset")
          run scalar(&path, value.arrayOffset)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "leftOffsetTable")
          run generated_dump_kern.dumpSubtable2ClassTable(&mut path, value.leftOffsetTable)
          DumpPath.pop(&mut path)
          DumpPath.push(&mut path, "rightOffsetTable")
          run generated_dump_kern.dumpSubtable2ClassTable(&mut path, value.rightOffsetTable)
          DumpPath.pop(&mut path)
          run probes2(&mut path, &value, count)
        }
        SubtableKind<'a>.Format3 { value } => {
          run scalar(&path, "Format3")
          DumpPath.beginTable(&mut path)
          run generated_dump_kern.dumpSubtable3(&mut path, value)
          run probes3(&mut path, &value, count)
        }
      }
    }
    Result<SubtableKind<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn probes0<'a>(path: &mut DumpPath, value: &Subtable0<'a>, count: u32) -> ()
  ! WriterError
  ? &mut Writer {
  let mut last: u32 = 0
  if count > 0 {
    last = count - 1
  }
  let glyphs: [u32; 8] = [0, 1, 2, 31, last, count, 65535, 65536]
  DumpPath.push(&mut path, "kernings")
  let mut i: usize = 0
  while i < 8 {
    let mut j: usize = 0
    while j < 8 {
      DumpPath.setIndex(&mut path, i * 8 + j)
      match move Subtable0.kerning(value, GlyphId.new(glyphs[i]), GlyphId.new(glyphs[j])) {
        Option<i32>.Some { value: adjustment } => run scalar(&path, adjustment)
        _ => run absent(&path)
      }
      j = j + 1
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

