import read_fonts.lib { FontRef, FontData, ReadError, ScalarArray, ComputedArray }
import read_fonts.tables.maxp { SelectedMaxp }
import read_fonts.tables.trak { Trak, TrackData, TrackTableEntry }
import read_fonts.tables.ankr { Ankr, AnchorPoint }
import read_fonts.tables.feat { Feat, FeatureName }
import read_fonts.tables.ltag { Ltag, TagIndex, TagIndices }
import font_types.lib { Fixed, GlyphId, NameId }
import extensions_aat_common { dumpArray }
import dump_support { DumpPath, scalar, bytes, absent, readError }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.text.string { String }
import silk.num.u16
import silk.num.u32

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let mut count = match move FontRef.selectedMaxp(font) {
    Result<SelectedMaxp<'a>, ReadError>.Success { value } => SelectedMaxp.numGlyphs(&value)
    _ => 0
  }
  if count > 65536 {
    count = 65536
  }
  DumpPath.push(&mut path, "trakValues")
  match move FontRef.trak(font) {
    Result<Trak<'a>, ReadError>.Success { value } => {
      DumpPath.push(&mut path, "horizontal")
      run track(&mut path, Trak.horiz(&value), Trak.offsetData(&value))
      DumpPath.pop(&mut path)
      DumpPath.push(&mut path, "vertical")
      run track(&mut path, Trak.vert(&value), Trak.offsetData(&value))
      DumpPath.pop(&mut path)
    }
    Result<Trak<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "ankrPoints")
  match move FontRef.ankr(font) {
    Result<Ankr<'a>, ReadError>.Success { value } => {
      let mut gid: u32 = 0
      while gid <= count {
        DumpPath.setIndex(&mut path, u32.toUsize(gid))
        match move Ankr.anchorPoints(&value, GlyphId.new(gid)) {
          Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.Success { value: points } => {
            let length = ComputedArray<'a, (), AnchorPoint<'a>>.len(&points)
            DumpPath.push(&mut path, "length")
            run scalar(&path, length)
            DumpPath.pop(&mut path)
            DumpPath.push(&mut path, "points")
            let mut i: usize = 0
            while i < length {
              DumpPath.setIndex(&mut path, i)
              match move ComputedArray<'a, (), AnchorPoint<'a>>.get(&points, i) {
                Result<AnchorPoint<'a>, ReadError>.Success { value: point } => {
                  DumpPath.push(&mut path, "x")
                  run scalar(&path, AnchorPoint.x(&point))
                  DumpPath.pop(&mut path)
                  DumpPath.push(&mut path, "y")
                  run scalar(&path, AnchorPoint.y(&point))
                  DumpPath.pop(&mut path)
                }
                Result<AnchorPoint<'a>, ReadError>.Failure { error } => run readError(&path, error)
              }
              i = i + 1
            }
            DumpPath.pop(&mut path)
          }
          Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.Failure {
            error
          } => run readError(&path, error)
        }
        gid = gid + 1
      }
    }
    Result<Ankr<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "featSettings")
  match move FontRef.feat(font) {
    Result<Feat<'a>, ReadError>.Success { value } => {
      let names = Feat.names(&value)
      let mut i: usize = 0
      while i < ComputedArray<'a, (), FeatureName<'a>>.len(&names) {
        DumpPath.setIndex(&mut path, i)
        match move ComputedArray<'a, (), FeatureName<'a>>.get(&names, i) {
          Result<FeatureName<'a>, ReadError>.Success { value: feature } => {
            DumpPath.push(&mut path, "exclusive")
            run scalar(&path, FeatureName.isExclusive(&feature))
            DumpPath.pop(&mut path)
            DumpPath.push(&mut path, "defaultIndex")
            run scalar(&path, FeatureName.defaultSettingIndex(&feature))
            DumpPath.pop(&mut path)
            DumpPath.push(&mut path, "findName")
            match move Feat.find(&value, FeatureName.feature(&feature)) {
              Option<FeatureName<'a>>.Some { value: found } => run scalar(
                &path,
                NameId.toU16(FeatureName.nameIndex(&found)),
              )
              _ => run absent(&path)
            }
            DumpPath.pop(&mut path)
          }
          Result<FeatureName<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
        i = i + 1
      }
    }
    Result<Feat<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "ltagStrings")
  match move FontRef.ltag(font) {
    Result<Ltag<'a>, ReadError>.Success { value } => {
      let mut iter = Ltag.tagIndices(&value)
      while let Option<TagIndex<'a>>.Some { value: item } = move TagIndices.next(&mut iter) {
        DumpPath.setIndex(&mut path, u32.toUsize(item.index))
        DumpPath.push(&mut path, "utf8")
        run bytes(&path, String.utf8Bytes(item.tag))
        DumpPath.pop(&mut path)
        DumpPath.push(&mut path, "findIndex")
        match move Ltag.indexForTag(&value, item.tag) {
          Option<u32>.Some { value: index } => run scalar(&path, index)
          _ => run absent(&path)
        }
        DumpPath.pop(&mut path)
      }
    }
    Result<Ltag<'a>, ReadError>.Failure { error } => run readError(&path, error)
  }
  DumpPath.pop(&mut path)
}

effect fn track<'a>(
  path: &mut DumpPath,
  result: Option<Result<TrackData<'a>, ReadError>>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let data = match move result {
    Option<Result<TrackData<'a>, ReadError>>.Some { value: parsed } => match move parsed {
      Result<TrackData<'a>, ReadError>.Success { value } => value
      Result<TrackData<'a>, ReadError>.Failure { error } => {
        run readError(&path, error)
        return
      }
    }
    _ => {
      run absent(&path)
      return
    }
  }
  DumpPath.push(&mut path, "sizes")
  match move TrackData.sizeTable(&data, base) {
    Option<ScalarArray<'a, Fixed>>.Some { value: sizes } => {
      DumpPath.push(&mut path, "length")
      run scalar(&path, ScalarArray<Fixed>.len(&sizes))
      DumpPath.pop(&mut path)
      let mut i: usize = 0
      while i < ScalarArray<Fixed>.len(&sizes) {
        DumpPath.setIndex(&mut path, i)
        if let Option<Fixed>.Some { value } = move ScalarArray<Fixed>.get(&sizes, i) {
          run scalar(&path, Fixed.toBits(value))
        }
        i = i + 1
      }
    }
    _ => run absent(&path)
  }
  DumpPath.pop(&mut path)
  let tracks = TrackData.trackTable(&data)
  DumpPath.push(&mut path, "tracks")
  let mut i: usize = 0
  while i < ComputedArray<'a, (), TrackTableEntry<'a>>.len(&tracks) {
    DumpPath.setIndex(&mut path, i)
    match move ComputedArray<'a, (), TrackTableEntry<'a>>.get(&tracks, i) {
      Result<TrackTableEntry<'a>, ReadError>.Success { value } => {
        DumpPath.push(&mut path, "values")
        match move TrackTableEntry.perSizeValues(&value, base, TrackData.nSizes(&data)) {
          Option<ScalarArray<'a, i16>>.Some { value: values } => run dumpArray<i16>(
            &mut path,
            values,
          )
          _ => run absent(&path)
        }
        DumpPath.pop(&mut path)
      }
      Result<TrackTableEntry<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    i = i + 1
  }
  DumpPath.pop(&mut path)
}
