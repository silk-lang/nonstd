//! Fixed-capacity output buffering for large differential dumps.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.core.effect { Effect }
import silk.mem.raw_buffer { RawBuffer }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

const CAPACITY: usize = 65536

pub struct BufferedStdout {
  output: StdoutWriter,
  buffer: Intrinsic.RawBuffer<u8>,
  length: usize,
}

impl BufferedStdout {
  pub effect fn make() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let allocation = run Allocator.allocate(Layout { bytes: CAPACITY, alignment: 1 })

    // The allocation was requested for CAPACITY bytes with byte alignment.
    let mut buffer = unsafe RawBuffer.from<u8>(move allocation, CAPACITY)
    RawBuffer.fill(&mut buffer, 0, CAPACITY, 0)
    return Self { output: StdoutWriter.make(), buffer: move buffer, length: 0 }
  }

  effect fn flushOutput(self: &mut Self) -> ()
    ! WriterError {
    if self.length == 0 {
      return
    }

    // The first `length` slots were filled by `make` and `write`.
    run Writer.writeAll(unsafe RawBuffer.view<u8>(&self.buffer, 0, self.length))
      |> Effect.provideMut<Writer>(&mut self.output)
    self.length = 0
  }

  effect fn write(self: &mut Self, value: &[u8]) -> ()
    ! WriterError {
    if value.length > CAPACITY - self.length {
      run BufferedStdout.flushOutput(&mut self)
      if value.length > CAPACITY {
        run Writer.writeAll(value) |> Effect.provideMut<Writer>(&mut self.output)
        return
      }
    }

    // In bounds by the checks above. Bytes have no drop, so overwritten slots leak nothing.
    unsafe {
      RawBuffer.copy<u8>(&mut self.buffer, self.length, value, value.length)
    }
    self.length = self.length + value.length
  }
}

impl Writer for BufferedStdout {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    run BufferedStdout.write(&mut self, value)
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    run BufferedStdout.flushOutput(&mut self)
  }
}
