import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "feat")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1717920116)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1717920116) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Feat<'a>.read(data) {
          Result<Feat<'a>, ReadError>.Success { value: table } => run dumpFeat(&mut path, table)
          Result<Feat<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
