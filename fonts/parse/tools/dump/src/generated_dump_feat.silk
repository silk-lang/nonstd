pub effect fn dumpFeat<'a>(path: &mut DumpPath, value: Feat<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    4031516933,
    FontData.len(&Feat<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Feat<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Feat<'a>.version(&value)
    DumpPath.push(&mut path, "major")
    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "featureNameCount")
    let fieldValue = Feat<'a>.featureNameCount(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved1")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Feat<'a>.reserved1ByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "reserved2")
    let fieldValue = FontData<'a>.readAt<u32>(&base, Feat<'a>.reserved2ByteRange(&value).start)
      |> Result<u32, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "names")
    let fieldValue = Feat<'a>.names(&value)
    DumpPath.push(&mut path, "length")
    run scalar(&path, ComputedArray<'a, (), FeatureName<'a>>.len(&fieldValue))
    DumpPath.pop(&mut path)
    let mut index: usize = 0
    while index < ComputedArray<'a, (), FeatureName<'a>>.len(&fieldValue) {
      DumpPath.setIndex(&mut path, index)
      DumpPath.setArguments(&mut path, [0; 3])
      match move ComputedArray<'a, (), FeatureName<'a>>.get(&fieldValue, index) {
        Result<FeatureName<'a>, ReadError>.Success { value: item } => run dumpFeatureName(
          &mut path,
          item,
          base,
        )
        Result<FeatureName<'a>, ReadError>.Failure { error } => run readError(&path, error)
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpFeatureName<'a>(
  path: &mut DumpPath,
  value: FeatureName<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "feature")
    let fieldValue = FeatureName<'a>.feature(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nSettings")
    let fieldValue = FeatureName<'a>.nSettings(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "settingTableOffset")
    let fieldValue = FeatureName<'a>.settingTableOffset(&value)
    run scalar(&path, Offset32.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "settingTable")
    let targetArgs: [u64; 3] = [u16.toU64(FeatureName<'a>.nSettings(&value)), 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = FeatureName<'a>.settingTable(&value, base)
    match move resolved {
      Result<SettingNameArray<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
        &table,
        &mut path,
      )
      Result<SettingNameArray<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "featureFlags")
    let fieldValue = FeatureName<'a>.featureFlags(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nameIndex")
    let fieldValue = FeatureName<'a>.nameIndex(&value)
    run scalar(&path, NameId.toU16(fieldValue))
    DumpPath.pop(&mut path)
  }
}

