import read_fonts.lib { FontRef, ReadError }
import read_fonts.tables.math {
  Math,
  MathConstants,
  MathConstant,
  MathValue,
  MathGlyphInfo,
  MathKernInfo,
  MathKernCorner,
  MathKern,
  MathKernEntry,
  MathKernEntryIter
}
import font_types.lib { GlyphId }
import dump_support { DumpPath, scalar, absent }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u16
import silk.num.u32

effect fn dumpValue(path: &mut DumpPath, value: MathValue) -> ()
  ! WriterError
  ? &mut Writer {
  DumpPath.push(&mut path, "value")
  run scalar(&path, value.value)
  DumpPath.pop(&mut path)
  DumpPath.push(&mut path, "deltaPx")
  run scalar(&path, value.deltaPx)
  DumpPath.pop(&mut path)
}

pub effect fn dump<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let math = match move FontRef.math(font) {
    Result<Math<'a>, ReadError>.Success { value } => value
    _ => {
      return
    }
  }
  DumpPath.push(&mut path, "mathQueries")
  DumpPath.push(&mut path, "hasSwappedMinHeights")
  run scalar(&path, Math.hasSwappedMinHeights(&math))
  DumpPath.pop(&mut path)
  let sizes: [u16; 6] = [0, 10, 11, 12, 16, 24]
  if let Result<MathConstants<'a>, ReadError>.Success {
    value: constants
  } = move Math.mathConstants(&math) {
    let all = MathConstant.all()
    let mut i: usize = 0
    DumpPath.push(&mut path, "constants")
    while i < all.length {
      DumpPath.setIndex(&mut path, i)
      DumpPath.push(&mut path, "ppem")
      let mut p: usize = 0
      while p < sizes.length {
        DumpPath.setIndex(&mut path, u16.toUsize(sizes[p]))
        run dumpValue(&mut path, MathConstants.constantForPpem(&constants, all[i], sizes[p]))
        p = p + 1
      }
      DumpPath.pop(&mut path)
      i = i + 1
    }
    DumpPath.pop(&mut path)
  }
  if let Result<MathGlyphInfo<'a>, ReadError>.Success { value: info } = move Math.mathGlyphInfo(
    &math,
  ) {
    if let Option<Result<MathKernInfo<'a>, ReadError>>.Some {
      value: result
    } = move MathGlyphInfo.mathKernInfo(&info) {
      if let Result<MathKernInfo<'a>, ReadError>.Success { value: kerns } = move result {
        let glyphs: [u32; 5] = [0, 9, 21, 42, 65535]
        let corners = [
          MathKernCorner.TopRight,
          MathKernCorner.TopLeft,
          MathKernCorner.BottomRight,
          MathKernCorner.BottomLeft,
        ]
        let heights: [i32; 6] = [-1, 19, 20, 39, 40, 32767]
        let mut g: usize = 0
        DumpPath.push(&mut path, "glyphs")
        while g < glyphs.length {
          DumpPath.setIndex(&mut path, u32.toUsize(glyphs[g]))
          DumpPath.push(&mut path, "corners")
          let mut c: usize = 0
          while c < corners.length {
            DumpPath.setIndex(&mut path, c)
            match move MathKernInfo.kern(&kerns, GlyphId.new(glyphs[g]), corners[c]) {
              Option<MathKern<'a>>.None => run absent(&path)
              Option<MathKern<'a>>.Some { value: kern } => {
                DumpPath.push(&mut path, "heightQueries")
                let mut h: usize = 0
                while h < heights.length {
                  DumpPath.setIndex(&mut path, h)
                  match move MathKern.kerning(&kern, heights[h]) {
                    Option<i32>.Some { value } => run scalar(&path, value)
                    _ => run absent(&path)
                  }
                  h = h + 1
                }
                DumpPath.pop(&mut path)
                DumpPath.push(&mut path, "ppem")
                let mut p: usize = 0
                while p < sizes.length {
                  DumpPath.setIndex(&mut path, u16.toUsize(sizes[p]))
                  DumpPath.push(&mut path, "entries")
                  let mut entries = MathKern.entriesForPpem(&kern, sizes[p])
                  let mut e: usize = 0
                  while let Option<MathKernEntry>.Some {
                    value: entry
                  } = move MathKernEntryIter.next(&mut entries) {
                    DumpPath.setIndex(&mut path, e)
                    DumpPath.push(&mut path, "maxHeight")
                    match move entry.maxHeight {
                      Option<MathValue>.Some { value } => run dumpValue(&mut path, value)
                      _ => run absent(&path)
                    }
                    DumpPath.pop(&mut path)
                    DumpPath.push(&mut path, "kern")
                    run dumpValue(&mut path, entry.kern)
                    DumpPath.pop(&mut path)
                    e = e + 1
                  }
                  DumpPath.pop(&mut path)
                  p = p + 1
                }
                DumpPath.pop(&mut path)
              }
            }
            c = c + 1
          }
          DumpPath.pop(&mut path)
          g = g + 1
        }
        DumpPath.pop(&mut path)
      }
    }
  }
  DumpPath.pop(&mut path)
}
