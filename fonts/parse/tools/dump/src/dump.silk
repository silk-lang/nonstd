effect fn text(value: string) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString(value)
}

pub effect fn error(input: ReadError) -> ()
  ! WriterError
  ? &mut Writer {
  match input {
    ReadError.OutOfBounds => run text("OutOfBounds")
    ReadError.InvalidFormat { value } => run Format.format(
      "InvalidFormat({value})",
      &.{ value: value },
    )
    ReadError.InvalidSfnt { value } => run Format.format(
      "InvalidSfnt(0x{value:08x})",
      &.{ value: value },
    )
    ReadError.InvalidTtc { tag } => run Format.format(
      "InvalidTtc({value:08x})",
      &.{ value: Tag.toU32(tag) },
    )
    ReadError.InvalidCollectionIndex { index } => run Format.format(
      "InvalidCollectionIndex({value})",
      &.{ value: index },
    )
    ReadError.InvalidArrayLen => run text("InvalidArrayLen")
    ReadError.ValidationError => run text("ValidationError")
    ReadError.NullOffset => run text("NullOffset")
    ReadError.TableIsMissing { tag } => run Format.format(
      "TableIsMissing({value:08x})",
      &.{ value: Tag.toU32(tag) },
    )
    ReadError.MalformedData { message } => run Format.format(
      "MalformedData({value:?})",
      &.{ value: message },
    )
  }
}

effect fn optional(input: Option<u32>) -> ()
  ! WriterError
  ? &mut Writer {
  match move input {
    Option<u32>.Some { value } => run Format.format("{value}\n", &.{ value: value })
    Option<u32>.None => run text("none\n")
  }
}

effect fn font<'a>(index: u32, font: FontRef<'a>, data: &'a [u8]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  let directory = FontRef.tableDirectory(&font)
  run Format.format(
    "font[{i}].sfntVersion=0x{value:08x}\n",
    &.{ i: index, value: TableDirectory.sfntVersion(directory) },
  )
  run Format.format(
    "font[{i}].numTables={value}\n",
    &.{ i: index, value: TableDirectory.numTables(directory) },
  )
  run Format.format(
    "font[{i}].searchRange={value}\n",
    &.{ i: index, value: TableDirectory.searchRange(directory) },
  )
  run Format.format(
    "font[{i}].entrySelector={value}\n",
    &.{ i: index, value: TableDirectory.entrySelector(directory) },
  )
  run Format.format(
    "font[{i}].rangeShift={value}\n",
    &.{ i: index, value: TableDirectory.rangeShift(directory) },
  )
  let records = TableDirectory.tableRecords(directory)
  run Format.format(
    "font[{i}].tableRecords.length={value}\n",
    &.{ i: index, value: TableRecords.len(&records) },
  )
  let mut j: usize = 0
  while j < TableRecords.len(&records) {
    if let Option<TableRecord<'a>>.Some { value: record } = move TableRecords<'a>.get(&records, j) {
      let tag = TableRecord.tag(&record)
      run Format.format(
        "font[{i}].tableRecords[{j}].tag={value:08x}\n",
        &.{ i: index, j: j, value: Tag.toU32(tag) },
      )
      run Format.format(
        "font[{i}].tableRecords[{j}].checksum=0x{value:08x}\n",
        &.{ i: index, j: j, value: TableRecord.checksum(&record) },
      )
      run Format.format(
        "font[{i}].tableRecords[{j}].offset={value}\n",
        &.{ i: index, j: j, value: TableRecord.offset(&record) },
      )
      run Format.format(
        "font[{i}].tableRecords[{j}].length={value}\n",
        &.{ i: index, j: j, value: TableRecord.length(&record) },
      )
      let mut lookup: string<'static> = "missing"
      if let Option<FontData<'a>>.Some { value } = move FontRef<'a>.tableData(&font, tag) {
        lookup = "available"
      }
      run Format.format(
        "font[{i}].tableRecords[{j}].lookup={value}\n",
        &.{ i: index, j: j, value: lookup },
      )
    }
    j = j + 1
  }
  let mut path = DumpPath.new(u32.toUsize(index))
  run generated_dump_head.dumpTables(&mut path, &font)
  run generated_dump_maxp.dumpTables(&mut path, &font)
  run generated_dump_cmap.dumpTables(&mut path, &font)
  run generated_dump_hhea.dumpTables(&mut path, &font)
  run generated_dump_hmtx.dumpTables(&mut path, &font)
  run generated_dump_name.dumpTables(&mut path, &font)
  run generated_dump_os2.dumpTables(&mut path, &font)
  run generated_dump_gdef.dumpTables(&mut path, &font)
  run generated_dump_gsub.dumpTables(&mut path, &font)
  run generated_dump_gpos.dumpTables(&mut path, &font)
  run generated_dump_post.dumpTables(&mut path, &font)
  run generated_dump_fvar.dumpTables(&mut path, &font)
  run generated_dump_avar.dumpTables(&mut path, &font)
  run generated_dump_hvar.dumpTables(&mut path, &font)
  run generated_dump_vvar.dumpTables(&mut path, &font)
  run generated_dump_mvar.dumpTables(&mut path, &font)
  run generated_dump_gvar.dumpTables(&mut path, &font)
  run generated_dump_glyf.dumpTables(&mut path, &font)
  run generated_dump_vhea.dumpTables(&mut path, &font)
  run generated_dump_vmtx.dumpTables(&mut path, &font)
  run generated_dump_vorg.dumpTables(&mut path, &font)
  run generated_dump_morx.dumpTables(&mut path, &font)
  run generated_dump_mort.dumpTables(&mut path, &font)
  run generated_dump_kerx.dumpTables(&mut path, &font)
  run generated_dump_trak.dumpTables(&mut path, &font)
  run generated_dump_ankr.dumpTables(&mut path, &font)
  run generated_dump_feat.dumpTables(&mut path, &font)
  run generated_dump_ltag.dumpTables(&mut path, &font)
  run generated_dump_base.dumpTables(&mut path, &font)
  run generated_dump_gasp.dumpTables(&mut path, &font)
  run generated_dump_hdmx.dumpTables(&mut path, &font)
  run generated_dump_stat.dumpTables(&mut path, &font)
  run generated_dump_meta.dumpTables(&mut path, &font)
  run generated_dump_cvar.dumpTables(&mut path, &font)
  run generated_dump_cpal.dumpTables(&mut path, &font)
  run generated_dump_svg.dumpTables(&mut path, &font)
  run generated_dump_dsig.dumpTables(&mut path, &font)
  run generated_dump_sbix.dumpTables(&mut path, &font)
  run generated_dump_cbdt.dumpTables(&mut path, &font)
  run generated_dump_cblc.dumpTables(&mut path, &font)
  run generated_dump_ebdt.dumpTables(&mut path, &font)
  run generated_dump_eblc.dumpTables(&mut path, &font)
  run generated_dump_colr.dumpTables(&mut path, &font)
  run generated_dump_varc.dumpTables(&mut path, &font)
  run generated_dump_math.dumpTables(&mut path, &font)
  run extensions_varc.dump(&mut path, &font)
  run extensions_math.dump(&mut path, &font)
  run extensions_bitmaps.dump(&mut path, &font)
  run extensions_glyphs.dump(&mut path, &font)
  run extensions_morx.dump(&mut path, &font)
  run extensions_mort.dump(&mut path, &font)
  run extensions_kerx.dump(&mut path, &font)
  run extensions_kern.dump(&mut path, &font)
  run extensions_aat_misc.dump(&mut path, &font)
  run extensions_metric_variations.dump(&mut path, &font)
  run extensions_cff.dump(&mut path, &font)
  run extensions_model.dump(&mut path, data, index)
}

pub effect fn dump<'a>(data: &'a [u8]) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  run Format.format(
    "font-dump.version=9\ndump.scope=all\nfile.length={value}\n",
    &.{ value: data.length },
  )

  let file = match move FileRef.new(data) {
    Result<FileRef<'a>, ReadError>.Success { value } => value
    Result<FileRef<'a>, ReadError>.Failure { error: err } => {
      run text("file.error=")
      run error(err)
      run text("\n")
      return
    }
  }
  match file {
    FileRef.Font { font } => run text("file.kind=sfnt\nfile.fonts=1\n")
    FileRef.Collection { collection } => {
      run Format.format(
        "file.kind=ttc\nfile.fonts={value}\n",
        &.{ value: CollectionRef.len(&collection) },
      )
      if let Result<TTCHeader<'a>, ReadError>.Success { value: header } = move TTCHeader<'a>.read(
        FontData.new(data),
      ) {
        run Format.format(
          "ttc.ttcTag={value:08x}\n",
          &.{ value: Tag.toU32(TTCHeader.ttcTag(&header)) },
        )
        run Format.format(
          "ttc.version.major={value}\n",
          &.{ value: TTCHeader.version(&header).major },
        )
        run Format.format(
          "ttc.version.minor={value}\n",
          &.{ value: TTCHeader.version(&header).minor },
        )
        run Format.format("ttc.numFonts={value}\n", &.{ value: TTCHeader.numFonts(&header) })
        let offsets = TTCHeader.tableDirectoryOffsets(&header)
        run Format.format(
          "ttc.tableDirectoryOffsets.length={value}\n",
          &.{ value: ScalarArray<u32>.len(&offsets) },
        )
        let mut i: usize = 0
        while i < ScalarArray<u32>.len(&offsets) {
          let offset = ScalarArray<u32>.get(&offsets, i) |> Option<u32>.unwrapOr(0)
          run Format.format("ttc.tableDirectoryOffsets[{i}]={value}\n", &.{ i: i, value: offset })
          i = i + 1
        }
        run text("ttc.dsigTag=")
        run optional(TTCHeader.dsigTag(&header))
        run text("ttc.dsigLength=")
        run optional(TTCHeader.dsigLength(&header))
        run text("ttc.dsigOffset=")
        run optional(TTCHeader.dsigOffset(&header))
      }
    }
  }
  let mut i: u32 = 0
  while i < FileRef.len(&file) {
    match move FileRef<'a>.get(&file, i) {
      Result<FontRef<'a>, ReadError>.Success { value } => run font(i, value, data)
      Result<FontRef<'a>, ReadError>.Failure { error: err } => {
        run Format.format("font[{i}].error=", &.{ i: i })
        run error(err)
        run text("\n")
      }
    }
    i = i + 1
  }
}
