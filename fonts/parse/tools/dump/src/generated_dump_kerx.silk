    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "padding")
    let fieldValue = FontData<'a>.readAt<u16>(&base, Kerx<'a>.paddingByteRange(&value).start)
      |> Result<u16, ReadError>.unwrapOr(0)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "nTables")
    let fieldValue = Kerx<'a>.nTables(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "subtables")
    let fieldValue = Kerx<'a>.subtables(&value)
    let mut counter = VarLenArray<'a, Subtable<'a>>.iter(&fieldValue)
    let mut count: usize = 0
    while true {
      if let Option<Result<Subtable<'a>, ReadError>>.None = move VarLenIter<'a, Subtable<'a>>.next(
        &mut counter,
      ) {
        break
      }
      count = count + 1
    }
    DumpPath.push(&mut path, "length")
    run scalar(&path, count)
    DumpPath.pop(&mut path)
    let mut iter = VarLenArray<'a, Subtable<'a>>.iter(&fieldValue)
    let mut index: usize = 0
    while index < count {
      DumpPath.beginTable(&mut path)
      DumpPath.setIndex(&mut path, index)
      if let Option<Result<Subtable<'a>, ReadError>>.Some { value: result } = move VarLenIter<
        'a,
        Subtable<'a>
      >.next(&mut iter) {
        match move result {
          Result<Subtable<'a>, ReadError>.Success { value: item } => run dumpSubtable(
            &mut path,
            move item,
          )
          Result<Subtable<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
      index = index + 1
    }
    DumpPath.clearIndex(&mut path)
    DumpPath.pop(&mut path)
  }
}

