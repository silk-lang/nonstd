pub effect fn dumpKerx<'a>(path: &mut DumpPath, value: Kerx<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    378325257,
    FontData.len(&Kerx<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Kerx<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
