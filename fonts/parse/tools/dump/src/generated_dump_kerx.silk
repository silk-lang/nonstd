import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "kerx")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1801810552)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1801810552) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Kerx<'a>.read(data) {
          Result<Kerx<'a>, ReadError>.Success { value: table } => run dumpKerx(&mut path, table)
          Result<Kerx<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
