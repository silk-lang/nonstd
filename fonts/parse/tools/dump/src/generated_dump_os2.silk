import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "OS/2")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1330851634)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1330851634) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Os2<'a>.read(data) {
          Result<Os2<'a>, ReadError>.Success { value: table } => run dumpOs2(&mut path, table)
          Result<Os2<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
