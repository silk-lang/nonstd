          Result<BaseCoord<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "maxCoordOffset")
    let fieldValue = FeatMinMaxRecord<'a>.maxCoordOffset(&value)
    let rawOffset = Nullable<Offset16>.offset(&fieldValue).*
    run scalar(&path, Offset16.toU32(rawOffset))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "maxCoord")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    match move FeatMinMaxRecord<'a>.maxCoord(&value, base) {
      Option<Result<BaseCoord<'a>, ReadError>>.None => run absent(&path)
      Option<Result<BaseCoord<'a>, ReadError>>.Some { value: resolved } => {
        match move resolved {
          Result<BaseCoord<'a>, ReadError>.Success { value: table } => run DumpTable.dump(
            &table,
            &mut path,
          )
          Result<BaseCoord<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}

pub effect fn dumpBaseCoord<'a>(path: &mut DumpPath, value: BaseCoord<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  match value {
    BaseCoord<'a>.Format1 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format1")
      DumpPath.pop(&mut path)
      run dumpBaseCoordFormat1(&mut path, table)
    }
    BaseCoord<'a>.Format2 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format2")
      DumpPath.pop(&mut path)
      run dumpBaseCoordFormat2(&mut path, table)
    }
    BaseCoord<'a>.Format3 { value: table } => {
      DumpPath.push(&mut path, "kind")
      run scalar(&path, "Format3")
      DumpPath.pop(&mut path)
      run dumpBaseCoordFormat3(&mut path, table)
    }
  }
}

