import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "BASE")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1111577413)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1111577413) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Base<'a>.read(data) {
          Result<Base<'a>, ReadError>.Success { value: table } => run dumpBase(&mut path, table)
          Result<Base<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
