import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "VVAR")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1448493394)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1448493394) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Vvar<'a>.read(data) {
          Result<Vvar<'a>, ReadError>.Success { value: table } => run dumpVvar(&mut path, table)
          Result<Vvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
