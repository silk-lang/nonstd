import read_fonts.lib { ScalarArray, ComputedArray, ReadError }
import read_fonts.tables.hmtx { Hmtx, HmtxExtended, LongMetric }
import font_types.lib { GlyphId }
import dump_support { DumpPath, scalar, absent }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

pub effect fn dumpHmtx<'a>(path: &mut DumpPath, table: Hmtx<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let count = ComputedArray<'a, (), LongMetric<'a>>.len(&Hmtx<'a>.hMetrics(&table))
    + ScalarArray<'a, i16>.len(&Hmtx<'a>.leftSideBearings(&table))
    + 2
  DumpPath.push(&mut path, "metrics")
  DumpPath.push(&mut path, "length")
  run scalar(&path, count)
  DumpPath.pop(&mut path)
  let mut i: usize = 0
  while i < count {
    DumpPath.setIndex(&mut path, i)
    let glyph = GlyphId.new(usize.toU32(i))
    DumpPath.push(&mut path, "advance")
    match move Hmtx<'a>.advance(&table, glyph) {
      Option<u16>.Some { value } => run scalar(&path, value)
      _ => run absent(&path)
    }
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "sideBearing")
    match move Hmtx<'a>.sideBearing(&table, glyph) {
      Option<i16>.Some { value } => run scalar(&path, value)
      _ => run absent(&path)
    }
    DumpPath.pop(&mut path)
    i = i + 1
  }
  DumpPath.pop(&mut path)
}

