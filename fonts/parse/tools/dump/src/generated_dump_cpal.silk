pub effect fn dumpColorRecord<'a>(
  path: &mut DumpPath,
  value: ColorRecord<'a>,
  base: FontData<'a>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !DumpPath.enter(&mut path) {
    run scalar(&path, "traversal-limit")
    return
  }
  if true {
    DumpPath.push(&mut path, "blue")
    let fieldValue = ColorRecord<'a>.blue(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "green")
    let fieldValue = ColorRecord<'a>.green(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "red")
    let fieldValue = ColorRecord<'a>.red(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "alpha")
    let fieldValue = ColorRecord<'a>.alpha(&value)
    run scalar(&path, fieldValue)
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "CPAL")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1129333068)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1129333068) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Cpal<'a>.read(data) {
          Result<Cpal<'a>, ReadError>.Success { value: table } => run dumpCpal(&mut path, table)
          Result<Cpal<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
