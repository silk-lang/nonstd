import harfrust.lib {
  Feature,
  Variation,
  Direction,
  ClusterLevel,
  ParseError,
  Tag,
  LanguageTags,
  Language
}
import font_types.lib { InvalidTag }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.text.string { String, Split }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.i32
import silk.num.f32
import silk.num.f64
import silk.num.i64

pub struct Options {
  pub features: List<Feature>,
  pub variations: List<Variation>,
  pub direction: Direction,
  pub script: u32,
  pub language: u32,
  pub languageValue: Language,
  pub languages: LanguageTags,
  pub pre: List<u32>,
  pub post: List<u32>,
  pub selector: Option<u32>,
  pub clusterLevel: ClusterLevel,
  pub flags: u32,
  pub serializeFlags: u32,
  pub trace: bool,
  pub utf8Clusters: bool,
  pub fontSize: i32,
  pub scaled: bool,
  pub pointSize: f32,
  pub faceIndex: u32,
}

impl Options {
  pub fn new() -> Self {
    return Self {
      features: List<Feature>.make(),
      variations: List<Variation>.make(),
      direction: Direction.Invalid,
      script: 0,
      language: 0,
      languageValue: Language.empty(),
      languages: LanguageTags.new(),
      pre: List<u32>.make(),
      post: List<u32>.make(),
      selector: Option<u32>.None,
      clusterLevel: ClusterLevel.MonotoneGraphemes,
      flags: 0,
      serializeFlags: 0,
      trace: false,
      utf8Clusters: false,
      fontSize: 0,
      scaled: false,
      pointSize: 0.0,
      faceIndex: 0,
    }
  }

  pub effect fn parse(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut words = String.split(text, " ")
    while let Option<string>.Some { value: word } = Split.next(&mut words) {
      if word == "" {
        continue
      }
      let mut key = word
      let mut value = String.slice(word, 0, 0)
      let mut equal = false
      if let Option<usize>.Some { value: at } = String.find(word, "=") {
        key = String.slice(word, 0, at)
        value = String.slice(word, at + 1, String.byteLength(word) - at - 1)
        equal = true
      }
      let argument = key == "--direction" || key == "--script" || key == "--language"
        || key == "--features"
        || key == "--variations"
        || key == "--cluster-level"
        || key == "--font-size"
        || key == "--font-ptem"
        || key == "--face-index"
        || key == "--font-funcs"
        || key == "--unicodes-before"
        || key == "--unicodes-after"
        || key == "--not-found-variation-selector-glyph"
      if argument && !equal {
        value = Split.next(&mut words) |> Option<string>.unwrapOr("")
      }
      if !run Options.option(&mut self, key, value) {
        return false
      }
    }
    return true
  }

  pub effect fn option(self: &mut Self, key: string, value: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if key == "--trace" {
      self.trace = true
      return true
    }
    if key == "--direction" {
      self.direction = Direction.parse(value)
        |> Result<Direction, ParseError>.unwrapOr(Direction.Invalid)
      return self.direction != Direction.Invalid
    }
    if key == "--script" {
      self.script = scriptTag(tag(value))
      return self.script != 0
    }
    if key == "--language" {
      self.languageValue = match move (run Language.parse(value)) {
        Option<Language>.Some { value: parsed } => move parsed
        _ => Language.empty()
      }
      self.languages = LanguageTags.fromLanguage(&self.languageValue)
      if self.languages.length != 0 {
        self.language = self.languages.values[0]
      }
      return true
    }
    if key == "--unicodes-before" {
      return run unicodeList(&mut self.pre, value)
    }
    if key == "--unicodes-after" {
      return run unicodeList(&mut self.post, value)
    }
    if key == "--not-found-variation-selector-glyph" {
      let n = unsigned(value)
      if let Option<u32>.Some { value: parsed } = move n {
        self.selector = Option<u32>.some(parsed)
        return true
      }
      return false
    }
    if key == "--no-dotted-circle" {
      self.flags = self.flags | 16
      return true
    }
    if key == "--features" {
      let mut parts = String.split(value, ",")
      while let Option<string>.Some { value: part } = Split.next(&mut parts) {
        match move Feature.parse(part) {
          Result<Feature, ParseError>.Success { value: feature } => {
            run List<Feature>.append(&mut self.features, feature)
          }
          _ => {
            return false
          }
        }
      }
      return true
    }
    if key == "--variations" {
      let mut parts = String.split(value, ",")
      while let Option<string>.Some { value: part } = Split.next(&mut parts) {
        if let Option<usize>.Some { value: pos } = String.find(part, "=") {
          let axis = tag(String.slice(part, 0, pos))
          if axis == 0 {
            return false
          }
          let coordinate = match move number(
            String.slice(part, pos + 1, String.byteLength(part) - pos - 1),
          ) {
            Option<f32>.Some { value: parsed } => parsed
            _ => {
              return false
            }
          }
          run List<Variation>.append(
            &mut self.variations,
            Variation.new(Tag.fromU32(axis), coordinate),
          )
        } else {
          return false
        }
      }
      return true
    }
    if key == "--cluster-level" {
      let n = unsigned(value) |> Option<u32>.unwrapOr(4294967295)
      if n > 3 {
        return false
      }
      self.clusterLevel = ClusterLevel.fromU32(n)
      return true
    }
    if key == "--font-size" {
      if let Option<i32>.Some { value: n } = signed(value) {
        self.fontSize = n
        self.scaled = true
        return true
      }
      return false
    }
    if key == "--font-ptem" {
      if let Option<f32>.Some { value: n } = number(value) {
        self.pointSize = n
        return true
      }
      return false
    }
    if key == "--face-index" {
      if let Option<u32>.Some { value: n } = unsigned(value) {
        self.faceIndex = n
        return true
      }
      return false
    }
    if key == "--utf8-clusters" {
      self.utf8Clusters = true
      return true
    }
    if key == "--bot" {
      self.flags = self.flags | 1
      return true
    }
    if key == "--eot" {
      self.flags = self.flags | 2
      return true
    }
    if key == "--preserve-default-ignorables" {
      self.flags = self.flags | 4
      return true
    }
    if key == "--remove-default-ignorables" {
      self.flags = self.flags | 8
      return true
    }
    if key == "--unsafe-to-concat" {
      self.flags = self.flags | 64
      return true
    }
    if key == "--safe-to-insert-tatweel" {
      self.flags = self.flags | 128
      return true
    }
    if key == "--no-clusters" {
      self.serializeFlags = self.serializeFlags | 1
      return true
    }
    if key == "--no-positions" {
      self.serializeFlags = self.serializeFlags | 2
      return true
    }
    if key == "--no-glyph-names" {
      self.serializeFlags = self.serializeFlags | 4
      return true
    }
    if key == "--show-extents" {
      self.serializeFlags = self.serializeFlags | 8
      return true
    }
    if key == "--show-flags" {
      self.serializeFlags = self.serializeFlags | 16
      return true
    }
    if key == "--no-advances" {
      self.serializeFlags = self.serializeFlags | 32
      return true
    }
    if key == "--ned" {
      self.serializeFlags = self.serializeFlags | 33
      return true
    }
    if key == "--verify" || key == "--font-funcs" {
      return true
    }
    return false
  }
}

pub fn tag(value: string) -> u32 {
  return Tag.toU32(
    Tag.newChecked(String.utf8Bytes(value)) |> Result<Tag, InvalidTag>.unwrapOr(Tag.fromU32(0)),
  )
}

fn unsigned(text: string) -> Option<u32> {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  let mut value: u32 = 0
  if bytes.length != 0 && bytes[0] == 43 {
    i = 1
  }
  if i == bytes.length {
    return Option<u32>.None
  }
  while i < bytes.length {
    let b = bytes[i]
    if b < 48 || b > 57 {
      return Option<u32>.None
    }
    let digit = u8.toU32(b - 48)
    if value > (4294967295 - digit) / 10 {
      return Option<u32>.None
    }
    value = value * 10 + digit
    i = i + 1
  }
  return Option<u32>.some(value)
}

fn signed(text: string) -> Option<i32> {
  let bytes = String.utf8Bytes(text)
  let mut rest = text
  let mut negative = false
  if bytes.length != 0 && bytes[0] == 45 {
    if bytes.length > 1 && bytes[1] == 43 {
      return Option<i32>.None
    }
    negative = true
    rest = String.slice(text, 1, bytes.length - 1)
  }
  let n = match move unsigned(rest) {
    Option<u32>.Some { value } => value
    _ => {
      return Option<i32>.None
    }
  }
  let mut limit: u32 = 2147483647
  if negative {
    limit = 2147483648
  }
  if n > limit {
    return Option<i32>.None
  }
  let mut result = u32.toI64(n)
  if negative {
    result = -result
  }
  return Option<i32>.some(i64.toI32(result))
}

fn number(text: string) -> Option<f32> {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  let mut negative = false
  if bytes.length != 0 && (bytes[0] == 45 || bytes[0] == 43) {
    negative = bytes[0] == 45
    i = 1
  }
  let mut value: f64 = 0.0
  let mut divisor: f64 = 1.0
  let mut point = false
  let mut digits: usize = 0
  while i < bytes.length {
    let b = bytes[i]
    if b == 46 && !point {
      point = true
    } else if b >= 48 && b <= 57 {
      digits = digits + 1
      value = value * 10.0 + u8.toF64(b - 48)
      if point {
        divisor = divisor * 10.0
      }
    } else {
      break
    }
    i = i + 1
  }
  if digits == 0 {
    return Option<f32>.None
  }
  value = value / divisor
  if i < bytes.length && (bytes[i] == 69 || bytes[i] == 101) {
    let exponent = match move signed(String.slice(text, i + 1, bytes.length - i - 1)) {
      Option<i32>.Some { value: n } => n
      _ => {
        return Option<f32>.None
      }
    }
    if exponent > 400 || exponent < -400 {
      return Option<f32>.None
    }
    let mut e = exponent
    while e > 0 {
      value = value * 10.0
      e = e - 1
    }
    while e < 0 {
      value = value / 10.0
      e = e + 1
    }
    i = bytes.length
  }
  if i != bytes.length || !f64.isFinite(value) || value > 3.4028234663852886e38 {
    return Option<f32>.None
  }
  if negative {
    value = -value
  }
  return Option<f32>.some(f64.toF32(value))
}

effect fn unicodeList(output: &mut List<u32>, value: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut parts = String.split(value, ",")
  while let Option<string>.Some { value: part } = Split.next(&mut parts) {
    let bytes = String.utf8Bytes(part)
    let mut i: usize = 0
    if bytes.length >= 2 && (bytes[0] == 85 || bytes[0] == 117) && bytes[1] == 43 {
      i = 2
    }
    if i == bytes.length {
      return false
    }
    let mut cp: u32 = 0
    while i < bytes.length {
      let b = bytes[i]
      let mut d: u8 = 255
      if b >= 48 && b <= 57 {
        d = b - 48
      } else if b >= 65 && b <= 70 {
        d = b - 55
      } else if b >= 97 && b <= 102 {
        d = b - 87
      }
      if d == 255 || cp > 0x10ffff / 16 {
        return false
      }
      cp = cp * 16 + u8.toU32(d)
      i = i + 1
    }
    if cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) {
      return false
    }
    run List<u32>.append(&mut output, cp)
  }
  return true
}

pub fn scriptTag(value: u32) -> u32 {
  if value == 0 {
    return 0
  }
  let tag = (value & 0xdfdfdfdf) | 0x00202020
  if (tag & 0xe0e0e0e0) != 0x40606060 {
    return 0x5a7a7a7a
  }
  return match tag {
    0x4172616e => 0x41726162
    0x43797273 => 0x4379726c
    0x47656f6b => 0x47656f72
    0x48616e73 => 0x48616e69
    0x48616e74 => 0x48616e69
    0x4a616d6f => 0x48616e67
    0x4c617466 => 0x4c61746e
    0x4c617467 => 0x4c61746e
    0x53797265 => 0x53797263
    0x5379726a => 0x53797263
    0x5379726e => 0x53797263
    _ => tag
  }
}
