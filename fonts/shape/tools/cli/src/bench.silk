//! Reusable-buffer workloads matching the pinned upstream shaping benchmark.
import io
import harfrust.lib {
  Buffer,
  Glyph,
  ShaperData,
  Shaper,
  shape,
  ShapePlan,
  ShapePlanKey,
  ShapeOptions,
  ShapeError
}
import read_fonts.lib { FontRef, ReadError }
import silk.collections.bytes { Bytes }
import silk.text.string { String, Split, InvalidUtf8 }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Format }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64

pub effect fn execute(base: &Path, fontPath: string, textPath: string, repeatText: string) -> i32
  ! OutOfMemoryError | FileError | WriterError
  ? &mut Allocator | &mut FileSystem | &mut Writer {
  let mut repeat: u32 = 0
  let digits = String.utf8Bytes(repeatText)
  let mut digitIndex: usize = 0
  while digitIndex < digits.length {
    let c = digits[digitIndex]
    if c < 48 || c > 57 || repeat > 100000 {
      return 2
    }
    repeat = repeat * 10 + u8.toU32(c - 48)
    digitIndex = digitIndex + 1
  }
  if repeat == 0 || repeat > 100000 {
    return 2
  }
  let fontBytes = run io.read(base, fontPath)
  let textBytes = run io.read(base, textPath)
  let text = String.fromUtf8(Bytes.asSlice(&textBytes)) |> Result<string, InvalidUtf8>.unwrapOr("")
  let font = match move FontRef.fromIndex(Bytes.asSlice(&fontBytes), 0) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      return 2
    }
  }
  let data = ShaperData.new(&font)
  let shaper = Shaper.new(&data)
  let mut buffer = Buffer.new()
  let mut plans = List<ShapePlan>.make()
  let mut checksum: u64 = 2166136261
  let mut glyphs: u64 = 0
  let mut iteration: u32 = 0
  while iteration < repeat {
    let mut lines = String.split(String.trim(text), "\n")
    while let Option<string>.Some { value: line } = Split.next(&mut lines) {
      Buffer.clear(&mut buffer)
      run Buffer.pushStr(&mut buffer, line)
      Buffer.guessSegmentProperties(&mut buffer)
      let mut index: usize = 0
      if true {
        let key = ShapePlanKey.new(&shaper, &buffer, &[])
        while index < List<ShapePlan>.length(&plans) {
          if ShapePlanKey.matches(&key, &List<ShapePlan>.asSlice(&plans)[index]) {
            break
          }
          index = index + 1
        }
      }
      if index == List<ShapePlan>.length(&plans) {
        let plan = run ShapePlan.new(&shaper, &buffer, &[])
        run List<ShapePlan>.append(&mut plans, move plan)
      }
      let options = ShapeOptions.forPlan(&List<ShapePlan>.asSlice(&plans)[index], &[])
      if let Result<(), ShapeError>.Failure { error } = move run shape(
        &shaper,
        &mut buffer,
        move options,
      ) {
        return 1
      }

      // Shaped glyphs are read in place, as the Rust twin iterates its info and position slices.
      let shaped = List<Glyph>.asSlice(&buffer.glyphs)
      let mut i: usize = 0
      while i < shaped.length {
        let info = &shaped[i].info
        let position = &shaped[i].position
        checksum = mix(checksum, u32.toU64(info.glyphId))
        checksum = mix(checksum, u32.toU64(info.cluster))
        checksum = mix(checksum, bits(position.xAdvance))
        checksum = mix(checksum, bits(position.yAdvance))
        checksum = mix(checksum, bits(position.xOffset))
        checksum = mix(checksum, bits(position.yOffset))
        glyphs = glyphs + 1
        i = i + 1
      }
    }
    iteration = iteration + 1
  }
  run Format.format("{checksum} {glyphs}\n", &.{ checksum: checksum, glyphs: glyphs })
  return 0
}

fn bits(value: i32) -> u64 {
  return i64.toU64(i32.toI64(value) & 4294967295)
}

fn mix(hash: u64, value: u64) -> u64 {
  return u64.wrappingMultiply(hash ^ value, 16777619)
}
