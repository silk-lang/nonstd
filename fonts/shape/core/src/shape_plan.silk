//! Reusable lookup plans and keys for application-owned caches.
import plan { OtPlan }
import font { ConfiguredShaper, FontFuncs, Shaper, table }
import buffer { Buffer }
import direction { Direction }
import feature { Feature }
import language { Language, LanguageTags }
import complex
import arabic
import view { View }
import font_types.lib { Tag, F2Dot14 }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

pub struct ShapePlan<'a> {
  pub substitutions: OtPlan<'a>,
  pub positions: OtPlan<'a>,
  pub direction: Direction,
  pub script: u32,
  pub shaper: u32,
  pub dumber: bool,
  pub fallbackPosition: bool,
  pub languages: LanguageTags,
  pub language: u32,
  pub languageBytes: List<u8>,
  pub features: List<Feature>,
  pub coords: List<F2Dot14>,
}

impl<'a> ShapePlan<'a> {
  /// Build after setting or guessing the buffer's segment properties.
  pub effect fn new<'s, F: FontFuncs>(
    font: &ConfiguredShaper<'a, 's, F>,
    buffer: &Buffer,
    features: &[Feature],
  ) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut properties = Buffer.new()
    properties.direction = buffer.direction
    properties.targetDirection = buffer.direction
    properties.script = buffer.script
    properties.language = buffer.language
    properties.languageTags = buffer.languageTags
    properties.languageValue = match move (run Language.new(
      Language.asBytes(&buffer.languageValue),
    )) {
      Option<Language>.Some { value } => move value
      _ => Language.empty()
    }
    properties.shaper = complex.select(font.data, buffer.script)
    let fallbackPosition = properties.shaper == 0 && buffer.script != 0x54686169
      && buffer.script != 0x4c616f6f
      && buffer.script != 0x51616167
    let hasMorph = View.len(&font.data.morx) >= 8 || View.len(&font.data.mort) >= 8
    let specialized = properties.shaper != 0 || arabic.usesScript(buffer.script)
      || buffer.script == 0x48656272
      || buffer.script == 0x48616e67
      || buffer.script == 0x54686169
      || buffer.script == 0x4c616f6f
      || buffer.script == 0x51616167
    properties.dumber = specialized && hasMorph
      && (Direction.isHorizontal(buffer.direction) || View.len(&font.data.gsub) == 0)
    if properties.dumber {
      properties.shaper = 0
    }
    let substitutions = run OtPlan.new(font, &properties, features, false)
    let positions = run OtPlan.new(font, &properties, features, true)
    let mut storedFeatures = List<Feature>.make()
    let mut coords = List<F2Dot14>.make()
    let mut language = List<u8>.make()
    let mut i: usize = 0
    while i < features.length {
      run List<Feature>.append(&mut storedFeatures, features[i])
      i = i + 1
    }
    i = 0
    while i < List<F2Dot14>.length(&font.coords) {
      run List<F2Dot14>.append(&mut coords, List<F2Dot14>.get(&font.coords, i))
      i = i + 1
    }
    let bytes = Language.asBytes(&buffer.languageValue)
    i = 0
    while i < bytes.length {
      run List<u8>.append(&mut language, bytes[i])
      i = i + 1
    }
    return Self {
      substitutions: move substitutions,
      positions: move positions,
      direction: buffer.direction,
      script: buffer.script,
      shaper: properties.shaper,
      dumber: properties.dumber,
      fallbackPosition: fallbackPosition,
      languages: buffer.languageTags,
      language: buffer.language,
      languageBytes: move language,
      features: move storedFeatures,
      coords: move coords,
    }
  }
}

/// Coordinates are compared conservatively, including fonts whose lookup
/// variation selection happens to be identical at two different locations.
pub struct ShapePlanKey<'a> {
  direction: Direction,
  script: u32,
  language: u32,
  languages: LanguageTags,
  languageBytes: &'a [u8],
  features: &'a [Feature],
  coords: &'a [F2Dot14],
}

impl<'a> ShapePlanKey<'a> {
  pub fn new<F: FontFuncs>(
    font: &'a ConfiguredShaper<F>,
    buffer: &'a Buffer,
    features: &'a [Feature],
  ) -> Self {
    return Self {
      direction: buffer.direction,
      script: buffer.script,
      language: buffer.language,
      languages: buffer.languageTags,
      languageBytes: Language.asBytes(&buffer.languageValue),
      features: features,
      coords: List<F2Dot14>.asSlice(&font.coords),
    }
  }

  pub fn matches(self: &Self, plan: &ShapePlan) -> bool {
    if self.direction != plan.direction || self.script != plan.script
      || self.language != plan.language
      || self.languages.length != plan.languages.length
      || self.languageBytes.length != List<u8>.length(&plan.languageBytes)
      || self.coords.length != List<F2Dot14>.length(&plan.coords)
      || self.features.length != List<Feature>.length(&plan.features) {
      return false
    }
    let mut i: usize = 0
    while i < self.languages.length {
      if self.languages.values[i] != plan.languages.values[i] {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < self.languageBytes.length {
      if self.languageBytes[i] != List<u8>.get(&plan.languageBytes, i) {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < self.coords.length {
      if F2Dot14.toBits(self.coords[i]) != F2Dot14.toBits(List<F2Dot14>.get(&plan.coords, i)) {
        return false
      }
      i = i + 1
    }
    i = 0
    while i < self.features.length {
      let a = self.features[i]
      let b = List<Feature>.get(&plan.features, i)

      // Non-global ranges are applied to the current buffer at execution time.
      if Tag.toU32(a.tag) != Tag.toU32(b.tag) || a.value != b.value
        || Feature.isGlobal(&a) != Feature.isGlobal(&b) {
        return false
      }
      i = i + 1
    }
    return true
  }
}
