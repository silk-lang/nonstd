//! Lazily constructed messages for statically dispatched FontFuncs observers.
import font { ConfiguredShaper, FontFuncs }
import buffer { Buffer }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.num.u32

pub fn enabled<F: FontFuncs>(font: &ConfiguredShaper<F>, buffer: &Buffer) -> bool {
  return FontFuncs.tracing(&font.funcs) && buffer.tracing
}

pub effect fn message<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  text: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  return run FontFuncs.message(&font.funcs, font, buffer, text)
}

effect fn number(out: &mut String, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 24] = [0; 24]
  let mut at: usize = 24
  let mut n = value
  while true {
    at = at - 1
    digits[at] = usize.toU8(n % 10) + 48
    n = n / 10
    if n == 0 {
      break
    }
  }
  run String.append(
    &mut out,
    String.fromUtf8(Slice.view(&digits, at, 24 - at)) |> Result<string, InvalidUtf8>.unwrapOr(""),
  )
}

pub effect fn indexed<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  prefix: string,
  index: usize,
  suffix: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  let mut text = String.make()
  run String.append(&mut text, prefix)
  run number(&mut text, index)
  run String.append(&mut text, suffix)
  return run message(font, buffer, String.view(&text))
}

pub effect fn pair<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  prefix: string,
  first: usize,
  middle: string,
  second: usize,
  suffix: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  let mut text = String.make()
  run String.append(&mut text, prefix)
  run number(&mut text, first)
  run String.append(&mut text, middle)
  run number(&mut text, second)
  run String.append(&mut text, suffix)
  return run message(font, buffer, String.view(&text))
}

effect fn tag(out: &mut String, value: u32, blank: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value == 0 {
    if blank {
      run String.append(&mut out, "    ")
    }
    return
  }
  let bytes: [u8; 4] = [
    u32.toU8(u32.shiftRight(value, 24)),
    u32.toU8(u32.shiftRight(value, 16) & 255),
    u32.toU8(u32.shiftRight(value, 8) & 255),
    u32.toU8(value & 255),
  ]
  run String.append(
    &mut out,
    String.fromUtf8(&bytes) |> Result<string, InvalidUtf8>.unwrapOr("????"),
  )
}

pub effect fn lookup<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  prefix: string,
  index: usize,
  feature: u32,
  suffix: string,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  let mut text = String.make()
  run String.append(&mut text, prefix)
  run number(&mut text, index)
  run String.append(&mut text, " feature '")
  run tag(&mut text, feature, true)
  run String.append(&mut text, "'")
  run String.append(&mut text, suffix)
  return run message(font, buffer, String.view(&text))
}

pub effect fn table<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  prefix: string,
  script: u32,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  let mut text = String.make()
  run String.append(&mut text, prefix)
  run String.append(&mut text, " script tag '")
  run tag(&mut text, script, false)
  run String.append(&mut text, "'")
  return run message(font, buffer, String.view(&text))
}

pub effect fn indices<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &Buffer,
  prefix: string,
  values: &[usize],
  offset: usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if !enabled(font, buffer) {
    return true
  }
  let mut text = String.make()
  run String.append(&mut text, prefix)
  let mut i: usize = 0
  while i < values.length {
    if i != 0 {
      run String.append(&mut text, ",")
    }
    run number(&mut text, values[i] + offset)
    i = i + 1
  }
  return run message(font, buffer, String.view(&text))
}
