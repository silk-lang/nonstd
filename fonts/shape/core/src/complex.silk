//! Script-specific feature staging and syllable reordering.
import trace
import buffer { Buffer, Glyph, reverseRange }
import font { ConfiguredShaper, FontFuncs, Shaper, ShaperData }
import view { View }
import syllable
import generated_machines as data
import unicode
import arabic
import indic
import plan { OtPlan }
import feature { Feature }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u16
import silk.num.u32

pub fn select(font: &ShaperData, script: u32) -> u32 {
  if script == 0x4b686d72 {
    return 2
  }
  if syllable.universal(script) {
    return 4
  }
  let mut kind: u32 = 0
  let tag: u32 = match script {
    0x42656e67 => 0x626e6732
    0x44657661 => 0x64657632
    0x47756a72 => 0x676a7232
    0x47757275 => 0x67757232
    0x4b6e6461 => 0x6b6e6432
    0x4d6c796d => 0x6d6c6d32
    0x4f727961 => 0x6f727932
    0x54616d6c => 0x746d6c32
    0x54656c75 => 0x74656c32
    0x4d796d72 => 0x6d796d32
    _ => 0
  }
  if tag != 0 {
    kind = 1
  }
  if script == 0x4d796d72 {
    kind = 3
  }
  if kind == 0 {
    return 0
  }
  let list = View.layoutList(&font.gsub, 0)
  let mut fallback = false
  let mut i: usize = 0
  while i < u16.toUsize(View.u16(&list, 0)) {
    let found = View.u32(&list, 2 + i * 6)
    if kind == 1 && found == tag + 1 {
      return 4
    }
    if found == tag || (kind == 1 && found == (script | 0x20202020)) {
      return kind
    }
    if found == 0x44464c54 || found == 0x6c61746e || found == 0x6d796d72 {
      fallback = true
    }
    i = i + 1
  }
  if fallback {
    return 0
  }
  return kind
}

pub fn featureBit(tag: u32) -> u32 {
  return match tag {
    0x72706866 => 1
    0x70726566 => 2
    0x626c7766 => 4
    0x61627666 => 8
    0x70737466 => 16
    0x63666172 => 32
    0x68616c66 => 64
    0x696e6974 => 128
    _ => 0
  }
}

pub fn featureDefault(kind: u32, tag: u32, default: u32) -> u32 {
  if kind == 0 {
    return default
  }
  if (kind == 1 || kind == 2) && tag == 0x6c696761 {
    return 0
  }
  if tag == 0x6e756b74 || tag == 0x616b686e || tag == 0x72706866 || tag == 0x70726566
    || tag == 0x626c7766
    || tag == 0x61627666
    || tag == 0x70737466
    || tag == 0x63666172
    || tag == 0x68616c66
    || tag == 0x726b7266
    || tag == 0x76617475
    || tag == 0x636a6374
    || tag == 0x70726573
    || tag == 0x61627673
    || tag == 0x626c7773
    || tag == 0x70737473
    || tag == 0x68616c6e
    || tag == 0x696e6974 {
    return 1
  }
  if kind == 4 && (tag == 0x69736f6c || tag == 0x6d656469 || tag == 0x66696e61) {
    return 1
  }
  return default
}

pub fn featureEnabled(kind: u32, glyph: &Glyph, tag: u32) -> bool {
  let bit = featureBit(tag)
  if kind == 1 || kind == 2 {
    return bit == 0 || (glyph.featureMask & bit) != 0
  }
  if kind == 4 && tag == 0x72706866 {
    return (glyph.featureMask & 1) != 0
  }
  return true
}

pub fn stage(kind: u32, tag: u32) -> u32 {
  if tag == 0x7276726e {
    return 0
  }
  if kind == 2 {
    if tag == 0x63636d70 || tag == 0x6c6f636c || featureBit(tag) != 0 {
      return 1
    }
    return 2
  }
  if kind == 3 {
    if tag == 0x63636d70 || tag == 0x6c6f636c {
      return 1
    }
    return match tag {
      0x72706866 => 2
      0x70726566 => 3
      0x626c7766 => 4
      0x70737466 => 5
      _ => 6
    }
  }
  if kind == 4 {
    if tag == 0x63636d70 || tag == 0x6c6f636c || tag == 0x6e756b74 || tag == 0x616b686e {
      return 1
    }
    if tag == 0x72706866 {
      return 2
    }
    if tag == 0x70726566 {
      return 3
    }
    if tag == 0x726b7266 || tag == 0x61627666 || tag == 0x626c7766 || tag == 0x68616c66
      || tag == 0x70737466
      || tag == 0x76617475
      || tag == 0x636a6374 {
      return 4
    }
    if arabic.isFeature(tag) {
      return 5
    }
    return 6
  }
  if kind == 1 {
    if tag == 0x63636d70 || tag == 0x6c6f636c {
      return 1
    }
    return match tag {
      0x6e756b74 => 2
      0x616b686e => 3
      0x72706866 => 4
      0x726b7266 => 5
      0x70726566 => 6
      0x626c7766 => 7
      0x61627666 => 8
      0x68616c66 => 9
      0x70737466 => 10
      0x76617475 => 11
      0x636a6374 => 12
      _ => 13
    }
  }
  return 1
}

pub effect fn preprocess(buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if (buffer.flags & 16) != 0 || (buffer.shaper != 1 && buffer.shaper != 4) {
    return
  }

  // The pairs are sorted by script and first code point, and vowelScripts holds each
  // script's rows.
  let pairs = View.bytes(data.vowelConstraints())
  let scripts = View.bytes(data.vowelScripts())
  let mut lo: usize = 0
  let mut hi: usize = 0
  let mut at: usize = 0
  while at + 8 <= View.len(&scripts) {
    if View.u32(&scripts, at) == buffer.script {
      lo = u16.toUsize(View.u16(&scripts, at + 4)) * 12
      hi = u16.toUsize(View.u16(&scripts, at + 6)) * 12
      break
    }
    at = at + 8
  }
  let mut lowest: u32 = u32.MAX
  let mut highest: u32 = 0
  if lo < hi {
    lowest = View.u32(&pairs, lo + 4)
    highest = View.u32(&pairs, hi - 8)
  }
  let devanagari = buffer.script == 0x44657661
  if lo == hi && !devanagari {
    return
  }
  let mut i: usize = 0
  while i + 1 < Buffer.len(&buffer.*) {
    let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
    let first = glyphs[i].codepoint
    let second = glyphs[i + 1].codepoint
    let mut matched = false
    let mut j = lo
    if first < lowest || first > highest {
      j = hi
    }
    while j < hi {
      if View.u32(&pairs, j + 4) == first && View.u32(&pairs, j + 8) == second {
        matched = true
        break
      }
      j = j + 12
    }
    if devanagari && first == 0x0930 && second == 0x094d && i + 2 < glyphs.length
      && glyphs[i + 2].codepoint == 0x0907 {
      i = i + 1
      matched = true
    }
    if matched {
      let cluster = List<Glyph>.asSlice(&buffer.glyphs)[i + 1].info.cluster
      run List<Glyph>.insert(&mut buffer.glyphs, i + 1, Glyph.new(0x25cc, cluster))
      i = i + 1
    }
    i = i + 1
  }
}

pub effect fn setup(buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if buffer.shaper == 0 {
    return
  }
  let universal = buffer.shaper == 4
  let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
  let mut i: usize = 0
  while i < slots.length {
    let codepoint = slots[i].codepoint
    let cat = syllable.indicCategory(codepoint)
    slots[i].category = u16.toU8(cat & 255)
    slots[i].order = u16.toU8(cat / 256)
    if universal {
      slots[i].category = syllable.useCategory(codepoint)
    }
    slots[i].featureMask = 0
    i = i + 1
  }
  let machine = buffer.shaper
  run syllable.find(&mut buffer, machine)
  if buffer.shaper == 4 {
    let mut start: usize = 0
    let mut last: usize = 0
    let mut lastForm: u32 = 0
    while start < Buffer.len(&buffer.*) {
      let end = syllable.next(&buffer.*, start)
      let first = List<Glyph>.get(&buffer.glyphs, start)
      let mut limit = start + 3
      if limit > end {
        limit = end
      }
      if first.category == 18 {
        limit = start + 1
      }
      i = start
      while i < limit {
        let mut item = List<Glyph>.get(&buffer.glyphs, i)
        item.featureMask = item.featureMask | 1
        List<Glyph>.set(&mut buffer.glyphs, i, item)
        i = i + 1
      }
      if !arabic.usesScript(buffer.script) {
        if (first.syllable & 15) == 7 || (first.syllable & 15) == 9 {
          lastForm = 0
        } else {
          let join = lastForm == 0x66696e61 || lastForm == 0x69736f6c
          if join {
            let mut form: u32 = 0x696e6974
            if lastForm == 0x66696e61 {
              form = 0x6d656469
            }
            setForm(&mut buffer, last, start, form)
          }
          lastForm = 0x69736f6c
          if join {
            lastForm = 0x66696e61
          }
          setForm(&mut buffer, start, end, lastForm)
        }
      }
      last = start
      start = end
    }
  }
}

fn setForm(buffer: &mut Buffer, start: usize, end: usize, form: u32) -> () {
  let mut i = start
  while i < end {
    let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
    slots[i].form = form
    i = i + 1
  }
}

/// Runs the shaper's work between lookup stages. Returns whether it may have changed which
/// glyphs the buffer holds, rather than only their order or properties.
/// The stages `pause` does anything at for `kind` and `script`, as bits; `ot.apply` calls it
/// only at these. Keep in step with the conditions in `pause`.
pub fn pausedStages(kind: u32, script: u32) -> u64 {
  let mut stages: u64 = 0
  if arabic.usesScript(script) {
    stages = stages | 4
  }
  if script == 0x41726162 {
    stages = stages | 2048
  }
  if kind == 1 {
    stages = stages | 4 | 8192 | 16384
  }
  if kind == 2 {
    stages = stages | 2 | 4
  }
  if kind == 3 {
    stages = stages | 4 | 64
  }
  if kind == 4 {
    stages = stages | 4 | 8 | 16 | 32
  }
  return stages
}

pub effect fn pause<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  plan: &OtPlan,
  stage: u32,
  features: &[Feature],
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if stage == 2 && arabic.usesScript(buffer.script) {
    arabic.recordStretch(&mut buffer, plan)
  }
  if buffer.script == 0x41726162 && stage == 11 {
    arabic.fallback(font, &mut buffer, plan, features)
    return true
  }

  // Each shaper's stages, checked by shaper first so that a call does only its own tests.
  let kind = buffer.shaper
  if kind == 1 {
    if stage == 2 && (run trace.message(font, &buffer.*, "start reordering indic initial")) {
      run indic.initial(font, &mut buffer, plan)
      drop run trace.message(font, &buffer.*, "end reordering indic initial")
      return true
    }
    if stage == 13 && (run trace.message(font, &buffer.*, "start reordering indic final")) {
      indic.final(font, &mut buffer)
      drop run trace.message(font, &buffer.*, "end reordering indic final")
      return true
    }
    if stage == 14 {
      clearSyllables(&mut buffer)
    }
    return false
  }
  if kind == 2 {
    if stage == 1 && (run trace.message(font, &buffer.*, "start reordering khmer")) {
      run dotted(font, &mut buffer, 1, 11, 14)
      khmer(&mut buffer)
      drop run trace.message(font, &buffer.*, "end reordering khmer")
      return true
    }
    if stage == 2 {
      clearSyllables(&mut buffer)
    }
    return false
  }
  if kind == 3 {
    if stage == 2 && (run trace.message(font, &buffer.*, "start reordering myanmar")) {
      run dotted(font, &mut buffer, 2, 11, 255)
      myanmar(&mut buffer)
      drop run trace.message(font, &buffer.*, "end reordering myanmar")
      return true
    }
    if stage == 6 {
      clearSyllables(&mut buffer)
    }
    return false
  }
  if kind == 4 {
    if stage == 3 {
      record(&mut buffer, 18, true)
    }
    if stage == 4 {
      record(&mut buffer, 22, false)
    }
    if stage == 2 || stage == 3 {
      let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
      let mut i: usize = 0
      while i < slots.length {
        slots[i].substituted = false
        i = i + 1
      }
    }
    if stage == 5 {
      let mut changed = false
      if run trace.message(font, &buffer.*, "start reordering USE") {
        run dotted(font, &mut buffer, 8, 1, 18)
        reorderUse(&mut buffer)
        changed = true
        drop run trace.message(font, &buffer.*, "end reordering USE")
      }
      clearSyllables(&mut buffer)
      return changed
    }
  }
  return false
}

fn clearSyllables(buffer: &mut Buffer) -> () {
  let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
  let mut i: usize = 0
  while i < slots.length {
    slots[i].syllable = 0
    i = i + 1
  }
}

pub effect fn dotted<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  broken: u32,
  category: u8,
  repha: u8,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if (buffer.flags & 16) != 0 {
    drop run trace.message(
      font,
      &buffer.*,
      "skipped inserting dotted-circles because buffer flag DO_NOT_INSERT_DOTTED_CIRCLE is set",
    )
    return
  }
  let mut hasBroken = false
  let mut n: usize = 0
  while n < Buffer.len(&buffer.*) {
    if u8.toU32(List<Glyph>.asSlice(&buffer.glyphs)[n].syllable & 15) == broken {
      hasBroken = true
      break
    }
    n = n + 1
  }
  if !hasBroken {
    return
  }
  if !run trace.message(font, &buffer.*, "start inserting dotted-circles") {
    return
  }
  let glyph = ConfiguredShaper.glyphFor(font, 0x25cc)
  if !ConfiguredShaper.mappedGlyphExists(font, 0x25cc, glyph) {
    return
  }
  let mut start: usize = 0
  while start < Buffer.len(&buffer.*) {
    let mut end = syllable.next(&buffer.*, start)
    let first = List<Glyph>.get(&buffer.glyphs, start)
    if u8.toU32(first.syllable & 15) == broken {
      let mut item = Glyph.new(0x25cc, first.info.cluster)
      item.info.glyphId = glyph
      item.syllable = first.syllable
      item.category = category
      item.order = 4
      item.featureMask = first.featureMask
      item.form = first.form
      item.glyphClass = 1
      let mut at = start
      while at < end && List<Glyph>.asSlice(&buffer.glyphs)[at].category == repha {
        at = at + 1
      }
      run List<Glyph>.insert(&mut buffer.glyphs, at, item)
      end = end + 1
    }
    start = end
  }
  drop run trace.message(font, &buffer.*, "end inserting dotted-circles")
}

fn record(buffer: &mut Buffer, category: u8, reph: bool) -> () {
  let mut start: usize = 0
  while start < Buffer.len(&buffer.*) {
    let end = syllable.next(&buffer.*, start)
    let mut i = start
    while i < end {
      let mut item = List<Glyph>.get(&buffer.glyphs, i)
      if reph && (item.featureMask & 1) == 0 {
        break
      }
      if item.substituted {
        item.category = category
        List<Glyph>.set(&mut buffer.glyphs, i, item)
        break
      }
      i = i + 1
    }
    start = end
  }
}

pub fn moveGlyph(buffer: &mut Buffer, from: usize, to: usize) -> () {
  let item = List<Glyph>.get(&buffer.glyphs, from)
  let mut i = from
  while i > to {
    let other = List<Glyph>.get(&buffer.glyphs, i - 1)
    List<Glyph>.set(&mut buffer.glyphs, i, other)
    i = i - 1
  }
  while i < to {
    let other = List<Glyph>.get(&buffer.glyphs, i + 1)
    List<Glyph>.set(&mut buffer.glyphs, i, other)
    i = i + 1
  }
  List<Glyph>.set(&mut buffer.glyphs, to, item)
}

fn halantUse(item: &Glyph) -> bool {
  return !item.ligated && (item.category == 12 || item.category == 53 || item.category == 44)
}

fn reorderUse(buffer: &mut Buffer) -> () {
  let mut start: usize = 0
  while start < Buffer.len(&buffer.*) {
    let end = syllable.next(&buffer.*, start)
    let first = List<Glyph>.get(&buffer.glyphs, start)
    let kind = first.syllable & 15
    if kind == 1 || kind == 2 || kind == 3 || kind == 6 || kind == 8 {
      if first.category == 18 && end - start > 1 {
        let mut i = start + 1
        while i < end {
          let item = List<Glyph>.get(&buffer.glyphs, i)
          let c = item.category
          let post = (c >= 22 && c <= 30) || (c >= 33 && c <= 39) || (c >= 45 && c <= 47)
            || halantUse(&item)
          if post || i == end - 1 {
            let mut target = i
            if post {
              target = target - 1
            }
            Buffer.mergeClusters(&mut buffer, start, target + 1)
            moveGlyph(&mut buffer, start, target)
            break
          }
          i = i + 1
        }
      }
      let mut j = start
      let mut i = start
      while i < end {
        let item = List<Glyph>.get(&buffer.glyphs, i)
        if halantUse(&item) {
          j = i + 1
        } else if (item.category == 22 || item.category == 23) && item.component == 0 && j < i {
          Buffer.mergeClusters(&mut buffer, j, i + 1)
          moveGlyph(&mut buffer, i, j)
        }
        i = i + 1
      }
    }
    start = end
  }
}

fn khmer(buffer: &mut Buffer) -> () {
  let mut start: usize = 0
  while start < Buffer.len(&buffer.*) {
    let end = syllable.next(&buffer.*, start)
    if (List<Glyph>.asSlice(&buffer.glyphs)[start].syllable & 15) != 2 {
      let mut i = start + 1
      while i < end {
        let mut item = List<Glyph>.get(&buffer.glyphs, i)
        item.featureMask = item.featureMask | 28
        List<Glyph>.set(&mut buffer.glyphs, i, item)
        i = i + 1
      }
      let mut coengs: u32 = 0
      i = start + 1
      while i < end {
        let cat = List<Glyph>.asSlice(&buffer.glyphs)[i].category
        if cat == 4 && coengs <= 2 && i + 1 < end {
          coengs = coengs + 1
          if List<Glyph>.asSlice(&buffer.glyphs)[i + 1].category == 15 {
            let mut j = i
            while j < i + 2 {
              let mut item = List<Glyph>.get(&buffer.glyphs, j)
              item.featureMask = item.featureMask | 2
              List<Glyph>.set(&mut buffer.glyphs, j, item)
              j = j + 1
            }
            Buffer.mergeClusters(&mut buffer, start, i + 2)
            moveGlyph(&mut buffer, i, start)
            moveGlyph(&mut buffer, i + 1, start + 1)
            j = i + 2
            while j < end {
              let mut item = List<Glyph>.get(&buffer.glyphs, j)
              item.featureMask = item.featureMask | 32
              List<Glyph>.set(&mut buffer.glyphs, j, item)
              j = j + 1
            }
            coengs = 2
          }
        } else if cat == 22 {
          Buffer.mergeClusters(&mut buffer, start, i + 1)
          moveGlyph(&mut buffer, i, start)
        }
        i = i + 1
      }
    }
    start = end
  }
}

pub fn consonant(item: &Glyph) -> bool {
  let c = item.category
  return !item.ligated && (c == 1 || c == 2 || c == 10 || c == 11 || c == 15 || c == 16 || c == 18)
}

pub fn sort(buffer: &mut Buffer, start: usize, end: usize) -> () {
  let mut i = start + 1
  while i < end {
    let order = List<Glyph>.asSlice(&buffer.glyphs)[i].order
    let mut j = i
    while j > start && List<Glyph>.asSlice(&buffer.glyphs)[j - 1].order > order {
      j = j - 1
    }
    if j != i {
      Buffer.mergeClusters(&mut buffer, j, i + 1)
      moveGlyph(&mut buffer, i, j)
    }
    i = i + 1
  }
}

fn myanmar(buffer: &mut Buffer) -> () {
  let mut start: usize = 0
  while start < Buffer.len(&buffer.*) {
    let end = syllable.next(&buffer.*, start)
    let kind = List<Glyph>.asSlice(&buffer.glyphs)[start].syllable & 15
    if kind == 0 || kind == 2 {
      let reph = start + 3 <= end && List<Glyph>.asSlice(&buffer.glyphs)[start].category == 15
        && List<Glyph>.asSlice(&buffer.glyphs)[start + 1].category == 32
        && List<Glyph>.asSlice(&buffer.glyphs)[start + 2].category == 4
      let mut limit = start
      if reph {
        limit = limit + 3
      }
      let mut base = limit
      let mut i = limit
      while i < end {
        if consonant(&List<Glyph>.asSlice(&buffer.glyphs)[i]) {
          base = i
          break
        }
        i = i + 1
      }
      let mut position: u8 = 5
      i = start
      while i < end {
        let mut item = List<Glyph>.get(&buffer.glyphs, i)
        let c = item.category
        if reph && i < start + 3 {
          item.order = 5
        } else if i < base {
          item.order = 3
        } else if i == base {
          item.order = 4
        } else if c == 36 {
          item.order = 3
        } else if c == 22 {
          item.order = 2
        } else if c == 40 && i > start {
          item.order = List<Glyph>.asSlice(&buffer.glyphs)[i - 1].order
        } else if position == 5 && c == 21 {
          position = 8
          item.order = position
        } else if position == 8 && c == 9 {
          item.order = 7
        } else if position == 8 && c == 21 {
          item.order = position
        } else if position == 8 && c != 9 {
          position = 9
          item.order = position
        } else {
          item.order = position
        }
        List<Glyph>.set(&mut buffer.glyphs, i, item)
        i = i + 1
      }
      sort(&mut buffer, start, end)
      let mut last = start
      while last < end && List<Glyph>.asSlice(&buffer.glyphs)[last].order == 2 {
        last = last + 1
      }
      reverseRange(&mut buffer.glyphs, start, last)
      let mut j = start
      i = start
      while i < last {
        if List<Glyph>.asSlice(&buffer.glyphs)[i].category == 22 {
          reverseRange(&mut buffer.glyphs, j, i + 1)
          j = i + 1
        }
        i = i + 1
      }
    }
    start = end
  }
}

pub fn perSyllable(kind: u32, tag: u32) -> bool {
  if kind == 0 || tag == 0x7276726e {
    return false
  }
  if tag == 0x63636d70 || tag == 0x6c6f636c {
    return true
  }
  if kind == 1 || kind == 2 {
    return featureDefault(kind, tag, 0) != 0
  }
  if kind == 3 {
    return featureDefault(kind, tag, 0) != 0 && stage(kind, tag) <= 5
  }
  return featureDefault(kind, tag, 0) != 0 && stage(kind, tag) < 5
}
