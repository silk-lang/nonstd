//! Apple pair and state-machine positioning. Offsets stay bounded to each subtable.
import trace
import silk.mem.allocator { Allocator, OutOfMemoryError }
import buffer { Buffer, Glyph }
import direction { Direction }
import feature { Feature }
import font { ConfiguredShaper, FontFuncs, Shaper, table }
import plan { featureValue }
import scale { Scale, add, sub }
import view { View, offset }
import font_types.lib { GlyphId }
import read_fonts.lib { FontData, ReadError, TableProvider, ScalarArray, ComputedArray }
import read_fonts.tables.aat { TypedLookup }
import read_fonts.tables.ankr { Ankr, AnchorPoint }
import read_fonts.tables.kern {
  Kern,
  Subtables,
  Subtable,
  OtSubtable,
  AatSubtable,
  SubtableKind,
  Subtable0,
  Subtable2,
  Subtable3
}
import read_fonts.tables.kerx {
  Subtable as KerxSubtable,
  SubtableKind as KerxKind,
  Subtable0 as Kerx0,
  Subtable2 as Kerx2,
  Subtable6 as Kerx6
}
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.num.i16
import silk.num.i32

pub fn hasMachine<F: FontFuncs>(font: &ConfiguredShaper<F>) -> bool {
  if let Result<Kern, ReadError>.Success { value: kernTable } = TableProvider.kern(
    &font.data.font,
  ) {
    let mut tables = Kern.subtables(&kernTable)
    while let Option<Result<Subtable, ReadError>>.Some { value: result } = Subtables.next(
      &mut tables,
    ) {
      if let Result<Subtable, ReadError>.Success { value: entry } = move result {
        if Subtable.isStateMachine(&entry) {
          return true
        }
      }
    }
  }
  return false
}

pub fn hasCross<F: FontFuncs>(font: &ConfiguredShaper<F>) -> bool {
  if let Result<Kern, ReadError>.Success { value: kernTable } = TableProvider.kern(
    &font.data.font,
  ) {
    let mut tables = Kern.subtables(&kernTable)
    while let Option<Result<Subtable, ReadError>>.Some { value: result } = Subtables.next(
      &mut tables,
    ) {
      if let Result<Subtable, ReadError>.Success { value: entry } = move result {
        if Subtable.isCrossStream(&entry) {
          return true
        }
      }
    }
  }
  return false
}

pub effect fn kern<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  features: &[Feature],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !run trace.message(font, &buffer.*, "start table kern") {
    return
  }
  if let Result<Kern, ReadError>.Success { value: kernTable } = TableProvider.kern(
    &font.data.font,
  ) {
    let length = Buffer.len(&buffer.*)
    Buffer.unsafeToConcat(&mut buffer, 0, length)
    let mut tables = Kern.subtables(&kernTable)
    let mut crossSeen = false
    let mut subIndex: usize = 0
    while let Option<Result<Subtable, ReadError>>.Some { value: result } = Subtables.next(
      &mut tables,
    ) {
      let index = subIndex
      subIndex = subIndex + 1
      if let Result<Subtable, ReadError>.Success { value: entry } = move result {
        if Subtable.isVariable(&entry)
          || Subtable.isHorizontal(&entry) != Direction.isHorizontal(buffer.direction) {
          continue
        }
        if !run trace.indexed(font, &buffer.*, "start subtable ", index, "") {
          continue
        }
        if !run trace.message(font, &buffer.*, "start kern") {
          drop run trace.indexed(font, &buffer.*, "end subtable ", index, "")
          continue
        }
        let cross = Subtable.isCrossStream(&entry)
        if cross && !crossSeen {
          crossSeen = true
          chain(&mut buffer)
        }
        let backwards = !Direction.isForward(buffer.direction)
        if backwards {
          Buffer.reverse(&mut buffer)
        }
        if Subtable.isStateMachine(&entry) {
          let data = match &entry {
            Subtable.Ot { value: subtable } => View.new(
              ScalarArray<u8>.offsetData(&OtSubtable.data(&subtable)),
            )
            Subtable.Aat { value: subtable } => View.new(
              ScalarArray<u8>.offsetData(&AatSubtable.data(&subtable)),
            )
          }
          machine(
            font.scale,
            &mut buffer,
            features,
            data,
            View.empty(),
            1,
            true,
            cross,
            0,
            backwards,
          )
        } else if let Result<SubtableKind, ReadError>.Success { value: kind } = Subtable.kind(
          &entry,
        ) {
          let mut i: usize = 0
          while i < Buffer.len(&buffer.*) {
            let first = List<Glyph>.get(&buffer.glyphs, i)
            if !enabled(&first, features, Direction.isHorizontal(buffer.direction)) {
              i = i + 1
              continue
            }
            let j = next(&buffer.*, i, features)
            if j == Buffer.len(&buffer.*) {
              break
            }
            let left = GlyphId.new(first.info.glyphId)
            let right = GlyphId.new(List<Glyph>.get(&buffer.glyphs, j).info.glyphId)
            let amount = match &kind {
              SubtableKind.Format0 { value } => Subtable0.kerning(&value, left, right)
              SubtableKind.Format2 { value } => Subtable2.kerning(&value, left, right)
              SubtableKind.Format3 { value } => Subtable3.kerning(&value, left, right)
              _ => Option<i32>.None
            }
              |> Option<i32>.unwrapOr(0)
            pair(font.scale, &mut buffer, i, j, amount, cross)
            i = j
          }
        }
        drop run trace.message(font, &buffer.*, "end kern")
        drop run trace.indexed(font, &buffer.*, "end subtable ", index, "")
        if backwards {
          Buffer.reverse(&mut buffer)
        }
      }
    }
  }
  drop run trace.message(font, &buffer.*, "end table kern")
}

pub effect fn kerx<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  features: &[Feature],
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !run trace.message(font, &buffer.*, "start table kerx") {
    return
  }
  let data = font.data.kerx
  let ankr = table(&font.data.font, 0x616e6b72)
  let length = Buffer.len(&buffer.*)
  Buffer.unsafeToConcat(&mut buffer, 0, length)
  let count = View.u32(&data, 4)
  let mut n: u32 = 0
  let mut at: usize = 8
  let mut crossSeen = false
  while n < count && at < View.len(&data) {
    let length = u32.toUsize(View.u32(&data, at))
    if length < 12 || length > View.len(&data) - at {
      break
    }
    let part = View.new(
      FontData.slice(&data.data, at, at + length) |> Option<FontData>.unwrapOr(FontData.new(b"")),
    )
    if let Result<KerxSubtable, ReadError>.Success { value: entry } = KerxSubtable.read(part.data) {
      if KerxSubtable.isHorizontal(&entry) == Direction.isHorizontal(buffer.direction) {
        if !run trace.indexed(font, &buffer.*, "start subtable ", u32.toUsize(n), "") {
          at = at + length
          n = n + 1
          continue
        }
        if !run trace.message(font, &buffer.*, "start kern") {
          drop run trace.indexed(font, &buffer.*, "end subtable ", u32.toUsize(n), "")
          at = at + length
          n = n + 1
          continue
        }
        let cross = KerxSubtable.isCrossStream(&entry)
        if cross && !crossSeen {
          crossSeen = true
          chain(&mut buffer)
        }
        let backwards = !Direction.isForward(buffer.direction)
        if backwards {
          Buffer.reverse(&mut buffer)
        }
        let format = KerxSubtable.coverage(&entry) & 255
        let tuples = KerxSubtable.tupleCount(&entry)
        if format == 1 || format == 4 {
          machine(
            font.scale,
            &mut buffer,
            features,
            View.tail(&part, 12),
            ankr,
            format,
            false,
            cross,
            tuples,
            backwards,
          )
        } else if let Result<KerxKind, ReadError>.Success { value: kind } = KerxSubtable.kind(
          &entry,
        ) {
          let mut i: usize = 0
          while i < Buffer.len(&buffer.*) {
            let first = List<Glyph>.get(&buffer.glyphs, i)
            if !enabled(&first, features, Direction.isHorizontal(buffer.direction)) {
              i = i + 1
              continue
            }
            let j = next(&buffer.*, i, features)
            if j == Buffer.len(&buffer.*) {
              break
            }
            let left = GlyphId.new(first.info.glyphId)
            let right = GlyphId.new(List<Glyph>.get(&buffer.glyphs, j).info.glyphId)
            let mut amount: i32 = 0
            match &kind {
              KerxKind.Format0 { value } => {
                if let Option<i32>.Some { value: v } = Kerx0.kerning(&value, left, right) {
                  amount = resolveTuple(v, tuples, View.new(Kerx0.offsetData(&value)))
                }
              }
              KerxKind.Format2 { value } => {
                if let Option<i32>.Some { value: v } = Kerx2.kerning(&value, left, right) {
                  amount = resolveTuple(v, tuples, View.new(value.data))
                }
              }
              KerxKind.Format6 { value } => {
                amount = Kerx6.kerning(&value, left, right) |> Option<i32>.unwrapOr(0)
              }
              _ => {}
            }
            pair(font.scale, &mut buffer, i, j, amount, cross)
            i = j
          }
        }
        drop run trace.message(font, &buffer.*, "end kern")
        drop run trace.indexed(font, &buffer.*, "end subtable ", u32.toUsize(n), "")
        if backwards {
          Buffer.reverse(&mut buffer)
        }
      }
    }
    at = at + length
    n = n + 1
  }
  drop run trace.message(font, &buffer.*, "end table kerx")
}

pub fn resolveTuple(value: i32, count: u32, data: View) -> i32 {
  if count == 0 {
    return value
  }
  if value < 0 {
    return 0
  }
  return i16.toI32(View.i16(&data, i32.toUsize(value)))
}

fn enabled(glyph: &Glyph, features: &[Feature], horizontal: bool) -> bool {
  let mut tag: u32 = 0x6b65726e
  if !horizontal {
    tag = 0x766b726e
  }
  return featureValue(tag, 1, glyph.info.cluster, features) != 0
}

fn next(buffer: &Buffer, first: usize, features: &[Feature]) -> usize {
  let mut i = first + 1
  while i < Buffer.len(buffer) {
    let glyph = List<Glyph>.get(&buffer.glyphs, i)
    if glyph.glyphClass != 3 && !(glyph.ignorable && !glyph.substituted) {
      if !enabled(&glyph, features, Direction.isHorizontal(buffer.direction)) {
        return Buffer.len(buffer)
      }
      return i
    }
    i = i + 1
  }
  return i
}

pub fn chain(buffer: &mut Buffer) -> () {
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    let mut glyph = List<Glyph>.get(&buffer.glyphs, i)
    glyph.attachType = 2
    glyph.attach = -1
    if !Direction.isForward(buffer.direction) {
      glyph.attach = 1
    }
    List<Glyph>.set(&mut buffer.glyphs, i, glyph)
    i = i + 1
  }
}

pub fn pair(scale: Scale, buffer: &mut Buffer, i: usize, j: usize, value: i32, cross: bool) -> () {
  let horizontal = Direction.isHorizontal(buffer.direction)
  let mut amount = Scale.y(&scale, value)
  if horizontal != cross {
    amount = Scale.x(&scale, value)
  }
  if amount == 0 {
    return
  }
  let mut first = List<Glyph>.get(&buffer.glyphs, i)
  let mut second = List<Glyph>.get(&buffer.glyphs, j)
  if cross {
    buffer.haveAttachments = true
    if horizontal {
      second.position.yOffset = amount
    } else {
      second.position.xOffset = amount
    }
  } else {
    let a = i32.shiftRight(amount, 1)
    let b = amount - a
    if horizontal {
      first.position.xAdvance = add(first.position.xAdvance, a)
      second.position.xAdvance = add(second.position.xAdvance, b)
      second.position.xOffset = add(second.position.xOffset, b)
    } else {
      first.position.yAdvance = add(first.position.yAdvance, a)
      second.position.yAdvance = add(second.position.yAdvance, b)
      second.position.yOffset = add(second.position.yOffset, b)
    }
  }
  List<Glyph>.set(&mut buffer.glyphs, i, first)
  List<Glyph>.set(&mut buffer.glyphs, j, second)
  Buffer.unsafeToBreak(&mut buffer, i, j + 1)
}

fn entryAt<'a>(
  states: View<'a>,
  entries: View<'a>,
  state: usize,
  class: usize,
  classes: usize,
  legacy: bool,
) -> View<'a> {
  let index = offset(class, state, classes)
  let mut stride: usize = 6
  let mut entry = u16.toUsize(View.u16(&states, offset(0, index, 2)))
  if legacy {
    if index >= View.len(&states) {
      return View.empty()
    }
    entry = u8.toUsize(View.u8(&states, index))
    stride = 4
  } else {
    if offset(2, index, 2) > View.len(&states) {
      return View.empty()
    }
  }
  let result = View.tail(&entries, offset(0, entry, stride))
  if View.len(&result) < stride {
    return View.empty()
  }
  return result
}

fn actionable(entry: View, legacy: bool) -> bool {
  if View.len(&entry) == 0 {
    return false
  }
  if legacy {
    return (View.u16(&entry, 2) & 0x3fff) != 0
  }
  return View.u16(&entry, 4) != 65535
}

pub fn machine(
  scale: Scale,
  buffer: &mut Buffer,
  features: &[Feature],
  data: View,
  ankr: View,
  kind: u32,
  legacy: bool,
  cross: bool,
  tuples: u32,
  reversed: bool,
) -> () {
  let mut classes = View.offset32(&data, 4)
  let mut states = View.offset32(&data, 8)
  let mut entries = View.offset32(&data, 12)
  let mut count = u32.toUsize(View.u32(&data, 0))
  if legacy {
    classes = View.offset16(&data, 2)
    states = View.offset16(&data, 4)
    entries = View.offset16(&data, 6)
    count = u16.toUsize(View.u16(&data, 0))
  }
  if count < 4 || View.len(&states) == 0 || View.len(&entries) == 0 {
    return
  }
  let values = View.offset32(&data, 16)
  let actionFlags = View.u32(&data, 16)
  let actions = View.tail(&data, u32.toUsize(actionFlags & 0x00ffffff))
  let actionType = u32.shiftRight(actionFlags, 30)
  let mut stack: [usize; 8] = [0; 8]
  let mut depth: usize = 0
  let mut state: usize = 0
  let mut i: usize = 0
  let mut mark: usize = 0
  let mut markSet = false
  let mut budget = buffer.maxOperations
  while i <= Buffer.len(&buffer.*) && budget != 0 {
    budget = budget - 1
    let atEnd = i == Buffer.len(&buffer.*)
    let mut class: usize = 0
    if !atEnd {
      let glyph = List<Glyph>.get(&buffer.glyphs, i).info.glyphId
      class = 1
      if legacy {
        let first = u16.toU32(View.u16(&classes, 0))
        if glyph >= first && glyph - first < u16.toU32(View.u16(&classes, 2)) {
          class = u8.toUsize(View.u8(&classes, 4 + u32.toUsize(glyph - first)))
        }
      } else if glyph <= 65535 {
        if let Result<TypedLookup<u16>, ReadError>.Success { value } = TypedLookup<u16>.read(
          classes.data,
        ) {
          class = u16.toUsize(
            TypedLookup<u16>.value(&value, u32.toU16(glyph)) |> Result<u16, ReadError>.unwrapOr(1),
          )
        }
      }
      if glyph == 65535 {
        class = 2
      }
      if class >= count {
        class = 1
      }
    }
    let entry = entryAt(states, entries, state, class, count, legacy)
    if View.len(&entry) == 0 {
      break
    }
    let flags = View.u16(&entry, 2)
    let mut nextState = u16.toUsize(View.u16(&entry, 0))
    if legacy {
      let base = u16.toUsize(View.u16(&data, 4))
      if nextState < base {
        break
      }
      nextState = (nextState - base) / count
    }
    let start = entryAt(states, entries, 0, class, count, legacy)
    let end = entryAt(states, entries, state, 0, count, legacy)
    let same = View.u16(&entry, 0) == View.u16(&start, 0)
      && (flags & 0x4000) == (View.u16(&start, 2) & 0x4000)
    let safe = !actionable(entry, legacy)
      && (state == 0 || ((flags & 0x4000) != 0 && nextState == 0)
        || (!actionable(start, legacy) && same))
      && !actionable(end, legacy)
    if !safe && i > 0 && !atEnd {
      Buffer.unsafeToBreak(&mut buffer, i - 1, i + 1)
    }
    if kind == 1 {
      if !legacy && (flags & 0x2000) != 0 {
        depth = 0
      }
      if (flags & 0x8000) != 0 {
        if depth < 8 {
          stack[depth] = i
          depth = depth + 1
        } else {
          depth = 0
        }
      }
      if actionable(entry, legacy) {
        let mut action = u16.toUsize(View.u16(&entry, 4))
        if legacy {
          action = u16.toUsize(flags & 0x3fff)
        }
        let mut stride = u32.toUsize(tuples)
        if stride == 0 {
          stride = 1
        }
        if stride > 65535 {
          depth = 0
        }
        while depth != 0 {
          depth = depth - 1
          let target = stack[depth]
          let mut amount: i32 = 0
          if legacy {
            if action + 2 > View.len(&data) {
              depth = 0
              break
            }
            amount = i16.toI32(View.i16(&data, action))
            action = (action + 2) & 65535
          } else {
            if offset(2, action, 2) > View.len(&values) || action + stride > 65535 {
              depth = 0
              break
            }
            amount = i16.toI32(View.i16(&values, action * 2))
            action = action + stride
          }
          if target >= Buffer.len(&buffer.*) {
            continue
          }
          stateValue(scale, &mut buffer, target, amount & -2, cross, features)
          if (amount & 1) != 0 {
            break
          }
        }
      }
    } else if kind == 4 {
      if markSet && actionable(entry, false) && !atEnd && mark < Buffer.len(&buffer.*) {
        let action = u16.toUsize(View.u16(&entry, 4))
        let mut item = List<Glyph>.get(&buffer.glyphs, i)
        let mut mx: i32 = 0
        let mut my: i32 = 0
        let mut cx: i32 = 0
        let mut cy: i32 = 0
        let mut coordinates = false
        if actionType == 1 && offset(4, action, 4) <= View.len(&actions) && View.len(&ankr) != 0 {
          let m = anchor(
            ankr,
            List<Glyph>.get(&buffer.glyphs, mark).info.glyphId,
            View.u16(&actions, action * 4),
          )
          let c = anchor(ankr, item.info.glyphId, View.u16(&actions, action * 4 + 2))
          mx = m[0]
          my = m[1]
          cx = c[0]
          cy = c[1]
          coordinates = true
        } else if actionType == 2 && offset(8, action, 8) <= View.len(&actions) {
          mx = i16.toI32(View.i16(&actions, action * 8))
          my = i16.toI32(View.i16(&actions, action * 8 + 2))
          cx = i16.toI32(View.i16(&actions, action * 8 + 4))
          cy = i16.toI32(View.i16(&actions, action * 8 + 6))
          coordinates = true
        }
        if coordinates {
          item.position.xOffset = sub(Scale.x(&scale, mx), Scale.x(&scale, cx))
          item.position.yOffset = sub(Scale.y(&scale, my), Scale.y(&scale, cy))
        }
        if i >= mark {
          let distance = usize.toI32((i - mark) % 65536)
          item.attachType = 1
          item.attach = -distance
          if distance > 32768 {
            item.attach = 65536 - distance
          }
          if reversed && item.attach != -32768 {
            item.attach = -item.attach
          }
          buffer.haveAttachments = true
          List<Glyph>.set(&mut buffer.glyphs, i, item)
        }
      }
      if (flags & 0x8000) != 0 {
        mark = i
        markSet = true
      }
    }
    state = nextState
    if atEnd {
      break
    }
    if (flags & 0x4000) == 0 {
      i = i + 1
    }
  }
  buffer.maxOperations = budget
  if budget == 0 {
    buffer.successful = false
  }
}

fn stateValue(
  scale: Scale,
  buffer: &mut Buffer,
  target: usize,
  value: i32,
  cross: bool,
  features: &[Feature],
) -> () {
  let horizontal = Direction.isHorizontal(buffer.direction)
  let mut amount = Scale.y(&scale, value)
  if horizontal != cross {
    amount = Scale.x(&scale, value)
  }
  let mut glyph = List<Glyph>.get(&buffer.glyphs, target)
  if cross {
    if value == -32768 {
      glyph.attach = 0
      glyph.attachType = 0
      if horizontal {
        glyph.position.yOffset = 0
      } else {
        glyph.position.xOffset = 0
      }
    } else if glyph.attachType != 0 {
      buffer.haveAttachments = true
      if horizontal {
        glyph.position.yOffset = add(glyph.position.yOffset, amount)
      } else {
        glyph.position.xOffset = add(glyph.position.xOffset, amount)
      }
    }
  } else if enabled(&glyph, features, Direction.isHorizontal(buffer.direction)) {
    if horizontal {
      glyph.position.xAdvance = add(glyph.position.xAdvance, amount)
      glyph.position.xOffset = add(glyph.position.xOffset, amount)
    } else if glyph.position.yOffset == 0 {
      glyph.position.yAdvance = add(glyph.position.yAdvance, amount)
      glyph.position.yOffset = add(glyph.position.yOffset, amount)
    }
  }
  List<Glyph>.set(&mut buffer.glyphs, target, glyph)
}

fn anchor<'a>(data: View<'a>, glyph: u32, index: u16) -> [i32; 2] {
  if let Result<Ankr<'a>, ReadError>.Success { value } = Ankr.read(data.data) {
    if let Result<ComputedArray<'a, (), AnchorPoint<'a>>, ReadError>.Success {
      value: points
    } = Ankr.anchorPoints(&value, GlyphId.new(glyph)) {
      if let Result<AnchorPoint<'a>, ReadError>.Success { value: point } = ComputedArray<
        'a,
        (),
        AnchorPoint<'a>
      >.get(&points, u16.toUsize(index)) {
        return [i16.toI32(AnchorPoint.x(&point)), i16.toI32(AnchorPoint.y(&point))]
      }
    }
  }
  return [0, 0]
}
