//! Arabic-family joining state machine; actions are feature tags on glyphs.
import generated_unicode as Data
import unicode
import view { View }
import read_fonts.lib { FontData }
import font { ConfiguredShaper, FontFuncs, ShaperData, Shaper, Metrics, metrics }
import font_types.lib { GlyphId }
import direction { Direction }
import scale { add, sub, clamp }
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import feature { Feature }
import plan { OtPlan, LookupStep, featureValue }
import buffer { Buffer, Glyph }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.collections.list { List }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize

pub fn usesScript(script: u32) -> bool {
  return script == 0x41726162 || script == 0x53797263 || script == 0x4d6f6e67
    || script == 0x4e6b6f6f
    || script == 0x50686167
    || script == 0x4d616e64
    || script == 0x4d616e69
    || script == 0x50686c70
    || script == 0x41646c6d
    || script == 0x526f6867
    || script == 0x536f6764
    || script == 0x4f756772
}

fn actionTag(action: u8) -> u32 {
  return match action {
    0 => 0x69736f6c
    1 => 0x66696e61
    2 => 0x66696e32
    3 => 0x66696e33
    4 => 0x6d656469
    5 => 0x6d656432
    6 => 0x696e6974
    _ => 0
  }
}

pub fn isFeature(tag: u32) -> bool {
  return tag == 0x69736f6c || tag == 0x66696e61 || tag == 0x66696e32 || tag == 0x66696e33
    || tag == 0x6d656469
    || tag == 0x6d656432
    || tag == 0x696e6974
}

pub fn stage(tag: u32, script: u32) -> u32 {
  if tag == 0x7276726e {
    return 0
  }
  if tag == 0x73746368 {
    return 1
  }
  if tag == 0x63636d70 || tag == 0x6c6f636c {
    return 2
  }
  let mut i: u8 = 0
  while i < 7 {
    if tag == actionTag(i) {
      return u8.toU32(i) + 3
    }
    i = i + 1
  }
  if tag == 0x726c6967 {
    return 10
  }
  if tag == 0x63616c74 || tag == 0x72636c74 {
    if script != 0x41726162 {
      return 10
    }
    return 11
  }
  if script != 0x41726162 {
    return 11
  }
  return 12
}

pub fn setup(buffer: &mut Buffer) -> () {
  let states = Data.arabicStates()
  let mut state: usize = 0
  let mut previous = Buffer.len(&buffer.*)
  let mut i: usize = 0
  while i < List<u32>.length(&buffer.preContext) {
    let kind = unicode.joining(List<u32>.get(&buffer.preContext, i))
    if kind != 6 {
      state = u8.toUsize(states[(state * 6 + kind) * 3 + 2])
      break
    }
    i = i + 1
  }
  i = 0
  let length = Buffer.len(&buffer.*)
  while i < length {
    let kind = unicode.joining(List<Glyph>.asSlice(&buffer.glyphs)[i].codepoint)
    if kind == 6 {
      let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
      slots[i].form = 0
      i = i + 1
      continue
    }
    let at = (state * 6 + kind) * 3
    let prevAction = states[at]
    if prevAction != 7 && previous < length {
      let updated = actionTag(prevAction)
      let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
      slots[previous].form = updated
      Buffer.safeToInsertTatweel(&mut buffer, previous, i + 1)
    }
    if prevAction == 7 || previous >= length {
      if previous < length {
        if kind >= 2 || (state >= 2 && state <= 5) {
          Buffer.unsafeToConcat(&mut buffer, previous, i + 1)
        }
      } else if kind >= 2 {
        Buffer.unsafeToConcat(&mut buffer, 0, i + 1)
      }
    }
    let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
    slots[i].form = actionTag(states[at + 1])
    state = u8.toUsize(states[at + 2])
    previous = i
    i = i + 1
  }
  i = 0
  while i < List<u32>.length(&buffer.postContext) {
    let kind = unicode.joining(List<u32>.get(&buffer.postContext, i))
    if kind != 6 {
      let action = states[(state * 6 + kind) * 3]
      let length = Buffer.len(&buffer.*)
      if action != 7 && previous < length {
        let updated = actionTag(action)
        let slots = List<Glyph>.asMutSlice(&mut buffer.glyphs)
        slots[previous].form = updated
        Buffer.safeToInsertTatweel(&mut buffer, previous, length)
      } else if state >= 2 && state <= 5 && previous < length {
        Buffer.unsafeToConcat(&mut buffer, previous, length)
      }
      break
    }
    i = i + 1
  }

  // Mongolian variation selectors inherit the preceding joining form.
  if buffer.script == 0x4d6f6e67 {
    i = 1
    while i < Buffer.len(&buffer.*) {
      let mut item = List<Glyph>.get(&buffer.glyphs, i)
      if (item.codepoint >= 0x180b && item.codepoint <= 0x180d) || item.codepoint == 0x180f {
        item.form = List<Glyph>.asSlice(&buffer.glyphs)[i - 1].form
        List<Glyph>.set(&mut buffer.glyphs, i, item)
      }
      i = i + 1
    }
  }
}

pub fn fallback<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  plan: &OtPlan,
  features: &[Feature],
) -> () {
  let mut step: usize = 0
  while step < List<LookupStep>.length(&plan.steps) {
    if isFeature(List<LookupStep>.get(&plan.steps, step).tag) {
      return
    }
    step = step + 1
  }
  let win = ConfiguredShaper.glyphFor(font, 0x0627) == 199
    && ConfiguredShaper.glyphFor(font, 0x0644) == 225
    && ConfiguredShaper.glyphFor(font, 0x0649) == 236
    && ConfiguredShaper.glyphFor(font, 0x064a) == 237
    && ConfiguredShaper.glyphFor(font, 0x0652) == 250
  if win {
    let pairs: [u32; 12] = [225, 199, 165, 225, 195, 178, 225, 194, 180, 225, 197, 252]
    windowsLigatures(font, &mut buffer, &pairs, true, features)
  }

  let forms = View.new(FontData.new(Data.arabicForms()))
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    let mut item = List<Glyph>.get(&buffer.glyphs, i)
    if item.form == 0 || featureValue(item.form, 1, item.info.cluster, features) == 0 {
      i = i + 1
      continue
    }
    let mut column: usize = 3
    if item.form == 0x696e6974 {
      column = 0
    } else if item.form == 0x6d656469 {
      column = 1
    } else if item.form == 0x66696e61 {
      column = 2
    }
    if win {
      let data = View.bytes(Data.arabicWindows())
      let mut p: usize = 0
      while p + 6 <= View.len(&data) {
        if u16.toUsize(View.u16(&data, p)) == column
          && u16.toU32(View.u16(&data, p + 2)) == item.info.glyphId {
          item.info.glyphId = u16.toU32(View.u16(&data, p + 4))
          List<Glyph>.set(&mut buffer.glyphs, i, item)
          break
        }
        p = p + 6
      }
      i = i + 1
      continue
    }
    let mut n: usize = 0
    while n < View.len(&forms) / 10 {
      if u16.toU32(View.u16(&forms, n * 10)) == item.codepoint {
        let cp = u16.toU32(View.u16(&forms, n * 10 + 2 + column * 2))
        let glyph = ConfiguredShaper.glyphFor(font, cp)
        if cp != 0 && ConfiguredShaper.mappedGlyphExists(font, cp, glyph) {
          item.info.glyphId = glyph
          List<Glyph>.set(&mut buffer.glyphs, i, item)
        }
        break
      }
      n = n + 1
    }
    i = i + 1
  }
  if win {
    let pairs: [u32; 9] = [248, 243, 172, 248, 245, 173, 248, 246, 175]
    windowsLigatures(font, &mut buffer, &pairs, false, features)
  } else {
    unicodeLigatures(font, &mut buffer, features)
  }
}

fn windowsLigatures<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  pairs: &[u32],
  ignoreMarks: bool,
  features: &[Feature],
) -> () {
  let mut i: usize = 0
  while i < Buffer.len(&buffer.*) {
    let first = List<Glyph>.get(&buffer.glyphs, i)
    if featureValue(0x726c6967, 1, first.info.cluster, features) == 0 {
      i = i + 1
      continue
    }
    let mut second = i + 1
    while ignoreMarks && second < Buffer.len(&buffer.*)
      && List<Glyph>.asSlice(&buffer.glyphs)[second].glyphClass == 3 {
      second = second + 1
    }
    if second >= Buffer.len(&buffer.*) {
      break
    }
    let mut p: usize = 0
    while p + 3 <= pairs.length {
      if first.info.glyphId == pairs[p]
        && List<Glyph>.asSlice(&buffer.glyphs)[second].info.glyphId == pairs[p + 1] {
        ligate(&mut buffer, i, &[i, second], pairs[p + 2], ignoreMarks)
        break
      }
      p = p + 3
    }
    i = i + 1
  }
}

fn ligate(buffer: &mut Buffer, at: usize, positions: &[usize], glyph: u32, base: bool) -> () {
  let last = positions[positions.length - 1]
  Buffer.mergeClusters(&mut buffer, at, last + 1)
  Buffer.unsafeToBreak(&mut buffer, at, last + 1)
  let mut item = List<Glyph>.get(&buffer.glyphs, at)
  item.info.glyphId = glyph
  item.substituted = true
  item.ligated = true
  if base {
    item.glyphClass = 2
    item.ligatureId = usize.wrappingToU8(at % 255 + 1)
    item.component = 0
    item.numComponents = usize.wrappingToU8(positions.length)
  }
  List<Glyph>.set(&mut buffer.glyphs, at, item)
  let mut j = at + 1
  let mut component: u8 = 1
  let mut n: usize = 1
  while j <= last {
    if n < positions.length && j == positions[n] {
      component = component + 1
      n = n + 1
    } else {
      let mut mark = List<Glyph>.get(&buffer.glyphs, j)
      mark.ligatureId = item.ligatureId
      mark.component = component
      List<Glyph>.set(&mut buffer.glyphs, j, mark)
    }
    j = j + 1
  }
  n = positions.length
  while n > 1 {
    n = n - 1
    drop List<Glyph>.remove(&mut buffer.glyphs, positions[n])
  }
}

fn unicodeLigatures<F: FontFuncs>(
  font: &ConfiguredShaper<F>,
  buffer: &mut Buffer,
  features: &[Feature],
) -> () {
  let data = View.bytes(Data.arabicLigatures())
  let mut group: u8 = 0
  while group < 3 {
    let mut i: usize = 0
    while i < Buffer.len(&buffer.*) {
      let first = List<Glyph>.get(&buffer.glyphs, i)
      if featureValue(0x726c6967, 1, first.info.cluster, features) == 0 {
        i = i + 1
        continue
      }
      let mut p: usize = 0
      while p + 10 <= View.len(&data) {
        if View.u8(&data, p) != group {
          p = p + 10
          continue
        }
        let count = u8.toUsize(View.u8(&data, p + 1))
        let target = ConfiguredShaper.glyphFor(font, u16.toU32(View.u16(&data, p + 8)))
        if !ConfiguredShaper.mappedGlyphExists(font, u16.toU32(View.u16(&data, p + 8)), target)
          || ConfiguredShaper.glyphFor(font, u16.toU32(View.u16(&data, p + 2)))
            != first.info.glyphId {
          p = p + 10
          continue
        }
        let mut indices: [usize; 3] = [i; 3]
        let mut n: usize = 1
        let mut cursor = i
        while n < count {
          cursor = cursor + 1
          while group != 2 && cursor < Buffer.len(&buffer.*)
            && List<Glyph>.asSlice(&buffer.glyphs)[cursor].glyphClass == 3 {
            cursor = cursor + 1
          }
          if cursor >= Buffer.len(&buffer.*) {
            break
          }
          let expected = ConfiguredShaper.glyphFor(font, u16.toU32(View.u16(&data, p + 2 + n * 2)))
          if !ConfiguredShaper.mappedGlyphExists(
            font,
            u16.toU32(View.u16(&data, p + 2 + n * 2)),
            expected,
          )
            || List<Glyph>.asSlice(&buffer.glyphs)[cursor].info.glyphId != expected {
            break
          }
          indices[n] = cursor
          n = n + 1
        }
        if n == count {
          ligate(&mut buffer, i, Slice.view(&indices, 0, count), target, group != 2)
          break
        }
        p = p + 10
      }
      i = i + 1
    }
    group = group + 1
  }
}

pub fn recordStretch(buffer: &mut Buffer, plan: &OtPlan) -> () {
  let mut found = false
  let mut i: usize = 0
  while i < List<LookupStep>.length(&plan.steps) {
    if List<LookupStep>.get(&plan.steps, i).tag == 0x73746368 {
      found = true
      break
    }
    i = i + 1
  }
  if !found {
    return
  }
  i = 0
  while i < Buffer.len(&buffer.*) {
    let mut item = List<Glyph>.get(&buffer.glyphs, i)
    if item.multiplied {
      item.stretch = 1
      if item.component % 2 != 0 {
        item.stretch = 2
      }
      List<Glyph>.set(&mut buffer.glyphs, i, item)
    }
    i = i + 1
  }
}

fn wordCategory(gc: u8) -> bool {
  return gc == 2 || gc == 3 || gc == 6 || gc == 7 || (gc >= 10 && gc <= 15)
    || (gc >= 23 && gc <= 26)
}

pub effect fn stretch<F: FontFuncs>(font: &ConfiguredShaper<F>, buffer: &mut Buffer) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let glyphs = List<Glyph>.asSlice(&buffer.glyphs)
  let mut k: usize = 0
  while k < glyphs.length && glyphs[k].stretch == 0 {
    k = k + 1
  }
  if k == glyphs.length {
    return
  }
  let rtl = buffer.direction == Direction.RightToLeft
  if !rtl {
    Buffer.reverse(&mut buffer)
  }
  let metrics = run metrics(font)
  let mut i = Buffer.len(&buffer.*)
  while i != 0 {
    if List<Glyph>.asSlice(&buffer.glyphs)[i - 1].stretch == 0 {
      i = i - 1
      continue
    }
    let end = i
    let mut fixed: i32 = 0
    let mut repeating: i32 = 0
    let mut repeats: i32 = 0
    while i != 0 && List<Glyph>.asSlice(&buffer.glyphs)[i - 1].stretch != 0 {
      i = i - 1
      let item = List<Glyph>.get(&buffer.glyphs, i)
      let width = Metrics.hAdvance(&metrics, GlyphId.new(item.info.glyphId))
      if item.stretch == 1 {
        fixed = add(fixed, width)
      } else {
        repeating = add(repeating, width)
        repeats = add(repeats, 1)
      }
    }
    let start = i
    let mut context = start
    let mut total: i32 = 0
    while context != 0 {
      let item = List<Glyph>.get(&buffer.glyphs, context - 1)
      if item.stretch != 0
        || !((item.ignorable && !item.substituted)
          || wordCategory(unicode.generalCategory(item.codepoint))) {
        break
      }
      context = context - 1
      total = add(total, item.position.xAdvance)
    }
    let mut remaining = sub(total, fixed)
    let mut copies: i32 = 0
    let mut overlap: i32 = 0
    if remaining > repeating && repeating > 0 {
      copies = remaining / repeating - 1
    }
    let shortfall = i32.toI64(remaining) - i32.toI64(repeating) * i32.toI64(copies + 1)
    if shortfall > 0 && repeats > 0 {
      copies = add(copies, 1)
      let excess = (i32.toI64(copies) + 1) * i32.toI64(repeating) - i32.toI64(remaining)
      if excess > 0 {
        overlap = clamp(excess / (i32.toI64(copies) * i32.toI64(repeats)))
        remaining = 0
      }
    }
    if i32.toI64(copies) * i32.toI64(repeats) + usize.toI64(Buffer.len(&buffer.*))
      > usize.toI64(buffer.maxLength) {
      buffer.successful = false
      break
    }
    Buffer.unsafeToBreak(&mut buffer, context, end)
    let mut x = remaining / 2
    let mut k = end
    while k > start {
      k = k - 1
      let mut item = List<Glyph>.get(&buffer.glyphs, k)
      let width = Metrics.hAdvance(&metrics, GlyphId.new(item.info.glyphId))
      let mut repeat: i32 = 1
      if item.stretch == 2 {
        repeat = add(repeat, copies)
      }
      item.position.xAdvance = 0
      let mut n: i32 = 0
      while n < repeat {
        if rtl {
          x = sub(x, width)
          if n > 0 {
            x = add(x, overlap)
          }
        }
        item.position.xOffset = x
        if n == 0 {
          List<Glyph>.set(&mut buffer.glyphs, k, item)
        } else {
          run List<Glyph>.insert(&mut buffer.glyphs, k, item)
        }
        if !rtl {
          x = add(x, width)
          if n > 0 {
            x = sub(x, overlap)
          }
        }
        n = n + 1
      }
    }
    i = start
  }
  if !rtl {
    Buffer.reverse(&mut buffer)
  }
}
