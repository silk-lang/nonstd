//! Unicode properties come from silk.text; shaping policy remains local.
import silk.text.unicode { Unicode }
import silk.text.unicode_properties {
  GeneralCategory,
  CanonicalCombiningClass,
  JoiningType,
  JoiningGroup,
}
import silk.text.unicode_script { Script }
pub import silk.text.unicode { Decomposed }
import silk.core.ownership { Copy }
import silk.core.option { Option }
import generated_unicode as Data
import silk.num.u8

// HarfBuzz's category encoding is a shaping ABI, not a public Unicode property.
@inlineAlways
pub fn generalCategory(cp: u32) -> u8 {
  return match GeneralCategory.of(cp) {
    GeneralCategory.Cc => 0
    GeneralCategory.Cf => 1
    GeneralCategory.Cn => 2
    GeneralCategory.Co => 3
    GeneralCategory.Cs => 4
    GeneralCategory.Ll => 5
    GeneralCategory.Lm => 6
    GeneralCategory.Lo => 7
    GeneralCategory.Lt => 8
    GeneralCategory.Lu => 9
    GeneralCategory.Mc => 10
    GeneralCategory.Me => 11
    GeneralCategory.Mn => 12
    GeneralCategory.Nd => 13
    GeneralCategory.Nl => 14
    GeneralCategory.No => 15
    GeneralCategory.Pc => 16
    GeneralCategory.Pd => 17
    GeneralCategory.Pe => 18
    GeneralCategory.Pf => 19
    GeneralCategory.Pi => 20
    GeneralCategory.Po => 21
    GeneralCategory.Ps => 22
    GeneralCategory.Sc => 23
    GeneralCategory.Sk => 24
    GeneralCategory.Sm => 25
    GeneralCategory.So => 26
    GeneralCategory.Zl => 27
    GeneralCategory.Zp => 28
    GeneralCategory.Zs => 29
  }
}

@inlineAlways
pub fn combiningClass(cp: u32) -> u8 {
  return CanonicalCombiningClass.of(cp).number()
}

@inlineAlways
pub fn script(cp: u32) -> u32 {
  return Script.of(cp).value
}

@inlineAlways
pub fn joining(cp: u32) -> usize {
  let group = JoiningGroup.of(cp)
  if group == JoiningGroup.Alaph {
    return 4
  }
  if group == JoiningGroup.Dalath_Rish {
    return 5
  }
  return match JoiningType.of(cp) {
    JoiningType.U => 0
    JoiningType.L => 1
    JoiningType.R => 2
    JoiningType.D => 3
    JoiningType.C => 3
    JoiningType.T => 6
  }
}

@inlineAlways
pub fn isVariationSelector(cp: u32) -> bool {
  // Mongolian free variation selectors are handled by the Arabic shaper.
  return cp >= 0xfe00 && Unicode.isVariationSelector(cp)
}

@inlineAlways
pub fn isDefaultIgnorable(cp: u32) -> bool {
  // Preserve visible Hangul fillers and shorthand controls, matching HarfBuzz's
  // font compatibility policy (harfbuzz/harfbuzz#503), not the raw UCD property.
  return cp != 0x115f && cp != 0x1160 && cp != 0x3164 && cp != 0xffa0
    && !(cp >= 0x1bca0 && cp <= 0x1bca3)
    && Unicode.isDefaultIgnorable(cp)
}

pub fn modifiedCombiningClass(cp: u32) -> u8 {
  if cp == 0x1a60 || cp == 0x0fc6 {
    return 254
  }
  if cp == 0x0f39 {
    return 127
  }
  return Data.modifiedClasses()[u8.toUsize(combiningClass(cp))]
}

pub fn isRtl(script: u32) -> bool {
  return Data.isRtlScript(script)
}

@inlineAlways
pub fn mirror(cp: u32) -> u32 {
  return Unicode.mirror(cp)
}

@inlineAlways
pub fn vertical(cp: u32) -> u32 {
  return Unicode.verticalForm(cp)
}

@inlineAlways
pub fn isMark(cp: u32) -> bool {
  return Unicode.isMark(cp)
}

@inlineAlways
pub fn isExtendedPictographic(cp: u32) -> bool {
  return Unicode.isExtendedPictographic(cp)
}

@inlineAlways
pub fn composesAsSecond(cp: u32) -> bool {
  return Unicode.composesAsSecond(cp)
}

pub fn compose(first: u32, second: u32) -> Option<u32> {
  return Unicode.compose(first, second)
}

pub fn decompose(cp: u32) -> Option<Decomposed> {
  return Unicode.decompose(cp)
}

/// A one-step canonical decomposition with zero for a missing part, which the normalizer edits in
/// place.
pub struct Decomposition {
  pub first: u32,
  pub second: u32,
}

impl Copy for Decomposition {}

/// Returns the one-step canonical decomposition of `cp`, with `first` zero when it has none and
/// `second` zero for a singleton.
pub fn decomposeRaw(cp: u32) -> Decomposition {
  return match move Unicode.decompose(cp) {
    Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => Decomposition {
      first: first,
      second: second,
    }
    Option<Decomposed>.Some { value: Decomposed.Singleton { scalar } } => Decomposition {
      first: scalar,
      second: 0,
    }
    _ => Decomposition { first: 0, second: 0 }
  }
}

/// Returns the primary composite of `first` and `second`, or zero when they do not compose.
pub fn composeRaw(first: u32, second: u32) -> u32 {
  return Unicode.compose(first, second) |> Option<u32>.unwrapOr(0)
}
