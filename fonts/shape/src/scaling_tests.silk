import test_fonts
import silk.collections.bytes { Bytes }
import silk.system.filesystem { FileError }
import silk.system.host_input { HostInputError }
//! Negative variable advances, clamping, and positioned scaling from upstream.
import font { ShaperData, ConfiguredShaper, DefaultFontFuncs }
import shape { shapeWithFeatures }
import buffer { Buffer, Glyph }
import generated_fixtures as Fixtures
import font_types.lib { Tag, GlyphId }
import read_fonts.lib { FontRef, ReadError }
import read_fonts.model.variation { Variation }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u16
import silk.num.usize

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let negativeAdvancesFontBytes = run test_fonts.read("tests/fonts/negative-var-advances.ttf")
  let source = match move FontRef.new(Bytes.asSlice(&negativeAdvancesFontBytes)) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "negative variable advances fixture")
      return
    }
  }
  let data = ShaperData.new(&source)
  let mut font = ShaperData.shaper(&data)
  let mut varied: usize = 0
  while varied < 2 {
    run ConfiguredShaper.setVariations(
      &mut font,
      &[Variation.new(Tag.fromU32(0x77676874), usize.toF32(varied))],
    )
    let mut factor: i32 = -2
    while factor <= 2 {
      ConfiguredShaper.setScaleUniform(&mut font, factor * 1000)
      let mut buffer = Buffer.new()
      run Buffer.pushStr(&mut buffer, "AB")
      Buffer.guessSegmentProperties(&mut buffer)
      drop run shapeWithFeatures(&font, &mut buffer, &[])
      let mut i: usize = 0
      while i < 2 {
        let mut h: i32 = 500
        let mut v: i32 = 1000
        if varied != 0 {
          h = 0
          v = 0
          if i != 0 {
            h = 600
            v = 1200
          }
        }
        let glyph = GlyphId.new(usize.toU32(i + 1))
        run Testing.expect(
          ConfiguredShaper.glyphHAdvance(&font, glyph) == h * factor
            && ConfiguredShaper.glyphVAdvance(&font, glyph) == -v * factor,
          "varied advances clamp before signed scaling",
        )
        run Testing.expect(
          List<Glyph>.get(&buffer.glyphs, i).position.xAdvance == h * factor,
          "batch shaping uses the same clamped advances",
        )
        i = i + 1
      }
      factor = factor + 1
    }
    varied = varied + 1
  }
  let robotoFontBytes = run test_fonts.read("benches/fonts/Roboto-Regular.ttf")
  run positioned(Bytes.asSlice(&robotoFontBytes), "A\u{0301}V ffi")
  let kernFontBytes = run test_fonts.read("tests/fonts/text-rendering-tests/TestKERNOne.otf")
  run positioned(Bytes.asSlice(&kernFontBytes), "uT")
}

effect fn positioned(bytes: &[u8], text: string) -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError
  ? &mut Allocator {
  let source = match move FontRef.new(bytes) {
    Result<FontRef, ReadError>.Success { value } => value
    _ => {
      run Testing.expect(false, "scaling fixture")
      return
    }
  }
  let data = ShaperData.new(&source)
  let mut font = ShaperData.shaper(&data)
  let mut baseline = Buffer.new()
  run Buffer.pushStr(&mut baseline, text)
  Buffer.guessSegmentProperties(&mut baseline)
  drop run shapeWithFeatures(&font, &mut baseline, &[])
  let factors: [i32; 2] = [-2, 2]
  let mut n: usize = 0
  while n < factors.length {
    let factor = factors[n]
    ConfiguredShaper.setScaleUniform(&mut font, u16.toI32(data.upem) * factor)
    let mut scaled = Buffer.new()
    run Buffer.pushStr(&mut scaled, text)
    Buffer.guessSegmentProperties(&mut scaled)
    drop run shapeWithFeatures(&font, &mut scaled, &[])
    run Testing.expect(
      Buffer.len(&baseline) == Buffer.len(&scaled),
      "scale does not change substitutions",
    )
    let mut i: usize = 0
    while i < Buffer.len(&scaled) {
      let first = List<Glyph>.get(&baseline.glyphs, i).position
      let second = List<Glyph>.get(&scaled.glyphs, i).position
      let dx = second.xOffset - first.xOffset * factor
      let dy = second.yOffset - first.yOffset * factor
      run Testing.expect(
        second.xAdvance == first.xAdvance * factor && second.yAdvance == first.yAdvance * factor
          && dx >= -1
          && dx <= 1
          && dy >= -1
          && dy <= 1,
        "OT and Apple positioning scale advances and offsets",
      )
      i = i + 1
    }
    n = n + 1
  }
}

test effect fn variableAdvancesAndPositionedScaling() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
