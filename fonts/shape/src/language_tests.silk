import language { Language, LanguageTags, subtagMatches }
import script { Script, ScriptTags }
import script
import generated_language_cases as Cases
import generated_scripts as Scripts
import view { View }
import font_types.lib { Tag }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.testing.testing { Testing, AssertionError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u16

effect fn cases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let raw = Cases.languageCases()
  let data = View.bytes(raw)
  let mut at: usize = 0
  let mut caseIndex: usize = 0
  while at < raw.length {
    let count = u16.toUsize(View.u16(&data, at))
    let expected = View.u32(&data, at + 2)
    let language = match move (run Language.new(Slice.view(raw, at + 6, count))) {
      Option<Language>.Some { value } => move value
      _ => Language.empty()
    }
    let tags = LanguageTags.fromLanguage(&language)
    let mut got: u32 = 0x64666c74
    if tags.length != 0 {
      got = tags.values[0]
    }

    // The upstream macro permits absent tags for unregistered extensions.
    run Testing.expect(tags.length == 0 || got == expected, Cases.caseName(caseIndex))
    at = at + 6 + count
    caseIndex = caseIndex + 1
  }
  let unknown: [u32; 5] = [0, 0x41424320, 0x61626364, 0x01020304, 0xffffffff]
  let mut i: usize = 0
  while i < unknown.length {
    let language = match move (run Language.fromTag(Tag.fromU32(unknown[i]))) {
      Option<Language>.Some { value } => move value
      _ => Language.empty()
    }
    let tags = LanguageTags.fromLanguage(&language)
    run Testing.expect(
      tags.length == 1 && tags.values[0] == unknown[i],
      "unknown language tag round trip, including null and non-ASCII bytes",
    )
    i = i + 1
  }
  let private = match move (run Language.parse("EN-x-hbotabc-zzz-hbscDEV2")) {
    Option<Language>.Some { value } => move value
    _ => Language.empty()
  }
  let tags = script.tagsForLanguage(Option<Script>.some(Scripts.latin()), &private)
  run Testing.expect(
    tags.scripts.length == 1 && tags.scripts.values[0] == 0x64657632
      && tags.languages.values[0] == 0x41424320,
    "private script and language overrides stop at subtag boundaries",
  )
  let devanagari = script.tags(Scripts.devanagari())
  run Testing.expect(
    devanagari.length == 3 && devanagari.values[0] == 0x64657633
      && devanagari.values[1] == 0x64657632
      && devanagari.values[2] == 0x64657661,
    "Indic script tag preference",
  )
  let hiragana = script.tags(Scripts.hiragana())
  run Testing.expect(
    hiragana.length == 1 && hiragana.values[0] == 0x6b616e61,
    "Hiragana shares the kana OpenType tag",
  )
  let mut long = String.make()
  run String.append(&mut long, "en-")
  i = 0
  while i < 1024 {
    run String.append(&mut long, "a")
    i = i + 1
  }
  let longTags = run LanguageTags.parse(String.view(&long))
  run Testing.expect(
    longTags.length == 1 && longTags.values[0] == 0x454e4720,
    "language parsing has no fixed input-length limit",
  )
  run Testing.expect(
    subtagMatches("en-latnx-latn!", "-latn"),
    "subtag matching tries later occurrences and non-alphanumeric boundaries",
  )
}

test effect fn upstreamLanguageTagsAndRoundTrips() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
