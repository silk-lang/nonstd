import silk.num.usize

pub struct TryFromUint24Error {}

impl Copy for TryFromUint24Error {}

impl Uint24 {
  pub fn tryFrom(value: usize) -> Result<Uint24, TryFromUint24Error> {
    if value > 16777215 {
      return Result<Uint24, TryFromUint24Error>.failResult(TryFromUint24Error {})
    }
    return Result<Uint24, TryFromUint24Error>.succeed(Uint24.new(usize.toU32(value)))
  }
}

impl Equal for Offset24 {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.value == &right.value
  }
}

impl Order for Offset24 {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if &left.value < &right.value {
      return Ordering.Less
    }
    if &left.value > &right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}
