    return Option<GlyphId24>.some(GlyphId24.new(raw))
  }

  pub fn fromBeBytes(bytes: [u8; 3]) -> GlyphId24 {
    return GlyphId24.new(Uint24.toU32(Uint24.fromBeBytes(bytes)))
