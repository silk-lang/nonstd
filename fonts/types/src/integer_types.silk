import silk.num.i64
import cast

pub struct Uint24 {
  value: u32,
}

impl Copy for Uint24 {}

impl Uint24 {
  pub fn new(raw: u32) -> Uint24 {
    if raw > 16777215 {
      return Uint24 { value: 16777215 }
    }
    return Uint24 { value: raw }
  }

  pub fn toU32(self: Uint24) -> u32 {
    return self.value
  }

  pub fn toBeBytes(self: Uint24) -> [u8; 3] {
    let mut bytes: [u8; 3] = [0; 3]
    drop writeScalar<Uint24>(self, &mut bytes)
    return bytes
  }

  pub fn checkedNew(raw: u32) -> Option<Uint24> {
    if raw > 16777215 {
      return Option<Uint24>.None
    }
    return Option<Uint24>.some(Uint24.new(raw))
  }

  pub fn fromBeBytes(bytes: [u8; 3]) -> Uint24 {
    return Uint24 {
      value: u32.shiftLeft(u8.toU32(bytes[0]), 16) | u32.shiftLeft(u8.toU32(bytes[1]), 8)
        | u8.toU32(bytes[2]),
    }
  }
}

impl Equal for Uint24 {
  fn equals(left: &Uint24, right: &Uint24) -> bool {
    return left.value == right.value
  }
}

impl Order for Uint24 {
  fn compare(left: &Uint24, right: &Uint24) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Scalar for Uint24 {
  fn rawByteLen() -> usize {
    return 3
  }

  fn read(bytes: &[u8]) -> Option<Uint24> {
    if bytes.length != 3 {
      return Option<Uint24>.None
    }
    return Option<Uint24>.some(Uint24.fromBeBytes([bytes[0], bytes[1], bytes[2]]))
  }

  fn write(value: Uint24, bytes: &mut [u8]) -> bool {
    if bytes.length < 3 {
      return false
    }
    bytes[0] = u32.toU8(u32.shiftRight(value.value, 16))
    bytes[1] = u32.toU8(u32.shiftRight(value.value, 8) & 255)
    bytes[2] = u32.toU8(value.value & 255)
    return true
  }
}

pub struct Int24 {
  value: i32,
}

impl Copy for Int24 {}

impl Int24 {
  pub fn new(raw: i32) -> Int24 {
    if raw > 8388607 {
      return Int24 { value: 8388607 }
    }
    if raw < -8388608 {
      return Int24 { value: -8388608 }
    }
    return Int24 { value: raw }
  }

  pub fn toI32(self: Int24) -> i32 {
    return self.value
  }

  pub fn toBeBytes(self: Int24) -> [u8; 3] {
    let mut bytes: [u8; 3] = [0; 3]
    drop writeScalar<Int24>(self, &mut bytes)
    return bytes
  }

  pub fn checkedNew(raw: i32) -> Option<Int24> {
    if raw < -8388608 || raw > 8388607 {
      return Option<Int24>.None
    }
    return Option<Int24>.some(Int24.new(raw))
  }

  pub fn fromBeBytes(bytes: [u8; 3]) -> Int24 {
    let value = Uint24.toU32(Uint24.fromBeBytes(bytes))
    if value >= 8388608 {
      return Int24 { value: u32.toI32(value) - 16777216 }
    }
    return Int24 { value: u32.toI32(value) }
  }
}

impl Equal for Int24 {
  fn equals(left: &Int24, right: &Int24) -> bool {
    return left.value == right.value
  }
}

impl Order for Int24 {
  fn compare(left: &Int24, right: &Int24) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Scalar for Int24 {
  fn rawByteLen() -> usize {
    return 3
  }

  fn read(bytes: &[u8]) -> Option<Int24> {
    if bytes.length != 3 {
      return Option<Int24>.None
    }
    return Option<Int24>.some(Int24.fromBeBytes([bytes[0], bytes[1], bytes[2]]))
  }

  fn write(value: Int24, bytes: &mut [u8]) -> bool {
    return writeScalar<Uint24>(Uint24.new(cast.i32ToU32(value.value) & 16777215), move bytes)
  }
}

pub struct GlyphId16 {
  value: u16,
}

impl Copy for GlyphId16 {}

impl GlyphId16 {
  pub fn new(raw: u16) -> GlyphId16 {
    return GlyphId16 { value: raw }
  }

  pub fn toU16(self: GlyphId16) -> u16 {
    return self.value
  }

  pub fn toBeBytes(self: GlyphId16) -> [u8; 2] {
    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<GlyphId16>(self, &mut bytes)
    return bytes
  }

  pub fn toU32(self: GlyphId16) -> u32 {
    return u16.toU32(self.value)
  }
}

impl Equal for GlyphId16 {
  fn equals(left: &GlyphId16, right: &GlyphId16) -> bool {
    return left.value == right.value
  }
}

impl Order for GlyphId16 {
  fn compare(left: &GlyphId16, right: &GlyphId16) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Scalar for GlyphId16 {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<GlyphId16> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<GlyphId16>.some(GlyphId16 { value: value })
      Option<u16>.None => Option<GlyphId16>.None
    }
  }

  fn write(value: GlyphId16, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.value, move bytes)
  }
}

