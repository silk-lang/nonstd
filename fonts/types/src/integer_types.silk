  fn write(value: Offset24, bytes: &mut [u8]) -> bool {
    return writeScalar<Uint24>(Uint24.new(Offset24.toU32(value)), move bytes)
  }
}

pub struct TryFromGlyphIdError {
  pub value: u32,
}

impl Copy for TryFromGlyphIdError {}

impl GlyphId16 {
  pub fn tryFrom(value: GlyphId) -> Result<GlyphId16, TryFromGlyphIdError> {
    let raw = GlyphId.toU32(value)
    if raw > 65535 {
      return Result<GlyphId16, TryFromGlyphIdError>.failResult(TryFromGlyphIdError { value: raw })
    }
    return Result<GlyphId16, TryFromGlyphIdError>.succeed(GlyphId16.new(u32.toU16(raw)))
  }
}

impl GlyphId24 {
  pub fn tryFrom(value: GlyphId) -> Result<GlyphId24, TryFromGlyphIdError> {
    let raw = GlyphId.toU32(value)
    if raw > 16777215 {
      return Result<GlyphId24, TryFromGlyphIdError>.failResult(TryFromGlyphIdError { value: raw })
    }
    return Result<GlyphId24, TryFromGlyphIdError>.succeed(GlyphId24.new(raw))
  }
}

impl NameId {
  pub fn copyrightNotice() -> NameId {
    return NameId.new(0)
  }

  pub fn familyName() -> NameId {
    return NameId.new(1)
  }

  pub fn subfamilyName() -> NameId {
    return NameId.new(2)
  }

  pub fn uniqueId() -> NameId {
    return NameId.new(3)
  }

  pub fn fullName() -> NameId {
    return NameId.new(4)
  }

  pub fn versionString() -> NameId {
    return NameId.new(5)
  }

  pub fn postscriptName() -> NameId {
    return NameId.new(6)
  }

  pub fn trademark() -> NameId {
    return NameId.new(7)
  }

  pub fn manufacturer() -> NameId {
    return NameId.new(8)
  }

  pub fn designer() -> NameId {
    return NameId.new(9)
  }

  pub fn description() -> NameId {
    return NameId.new(10)
  }

  pub fn vendorUrl() -> NameId {
    return NameId.new(11)
  }

  pub fn designerUrl() -> NameId {
    return NameId.new(12)
  }

  pub fn licenseDescription() -> NameId {
    return NameId.new(13)
  }

  pub fn licenseUrl() -> NameId {
    return NameId.new(14)
  }

  pub fn typographicFamilyName() -> NameId {
    return NameId.new(16)
  }

  pub fn typographicSubfamilyName() -> NameId {
    return NameId.new(17)
  }

  pub fn compatibleFullName() -> NameId {
    return NameId.new(18)
  }

  pub fn sampleText() -> NameId {
    return NameId.new(19)
  }

  pub fn postscriptCidName() -> NameId {
    return NameId.new(20)
  }

  pub fn wwsFamilyName() -> NameId {
    return NameId.new(21)
  }

  pub fn wwsSubfamilyName() -> NameId {
    return NameId.new(22)
  }

  pub fn lightBackgroundPalette() -> NameId {
    return NameId.new(23)
  }

  pub fn darkBackgroundPalette() -> NameId {
    return NameId.new(24)
  }

  pub fn variationsPostscriptNamePrefix() -> NameId {
    return NameId.new(25)
  }

  pub fn lastReservedNameId() -> NameId {
    return NameId.new(255)
  }

  pub fn lastAllowedNameId() -> NameId {
    return NameId.new(32767)
  }

  pub fn default() -> NameId {
    return NameId.new(65535)
  }

  pub fn isReserved(self: NameId) -> bool {
    return self.value <= 255
  }

  pub fn checkedAdd(self: NameId, rhs: u16) -> Option<NameId> {
    let raw = u16.saturatingAdd(self.value, rhs)
    if raw > 32767 {
      return Option<NameId>.None
    }
    return Option<NameId>.some(NameId.new(raw))
  }

  pub fn predefined() -> NameIdIter {
    return NameIdIter { nextValue: 0 }
  }
}

pub struct NameIdIter {
  nextValue: u16,
}

impl NameIdIter {
  pub fn next(self: &mut Self) -> Option<NameId> {
    if self.nextValue > 25 {
      return Option<NameId>.None
    }
    let value = self.nextValue
    self.nextValue = self.nextValue + 1
    if self.nextValue == 15 {
      self.nextValue = 16
    }
    return Option<NameId>.some(NameId.new(value))
  }
}

