test effect fn f48dot16Display() -> ()
  ! WriterError | AssertionError<'static> {
  let values = [
    F48Dot16.fromF64(0.6),
    F48Dot16.fromI64(1099511627776),
    F48Dot16.fromF64(-1099511627776.5),
    F48Dot16.max(),
    F48Dot16.min(),
    F48Dot16.fromBits(i64.MIN + 1),
  ]
  let strings: [string<'static>; 6] = [
    "0.6",
    "1099511627776",
    "-1099511627776.5",
    "140737488355327.99998",
    "-140737488355328",
    "-140737488355327.99998",
  ]
  let mut i: usize = 0
  while i < values.length {
    run text(values[i], strings[i])
    i = i + 1
  }
}

// Independent shortest-decimal check: round-trip the emitted text, then try the
// two nearest candidates with one fewer decimal place (the upstream criterion).
effect fn checkShortest<T: Display>(raw: i64, value: T, fractionalBits: i64) -> ()
  ! WriterError | AssertionError<'static> {
  let mut capture = Capture { bytes: [0; 128], length: 0 }
  run Format.display(&value) |> Effect.provideMut<Writer>(&mut capture)
  let string = contents(&capture)
  run Testing.expect(string != "-0", "never negative zero")
  let parsed = Format.f64Value(string) |> Result<f64, ParseError>.unwrapOr(1000000000000000000.0)
  let one = i64.shiftLeft(1, fractionalBits)
  run Testing.expect(
    f64.round(parsed * i64.toF64(one)) == i64.toF64(raw),
    "shortest text roundtrips",
  )
  let mut dot = capture.length
  let mut i: usize = 0
  while i < capture.length {
    if capture.bytes[i] == 46 {
      dot = i
    }
    i = i + 1
  }
  if dot == capture.length {
    return
  }
  let places = capture.length - dot - 1
  let mut power: i64 = 1
  i = 1
  while i < places {
    power = power * 10
    i = i + 1
  }
  let shorter = f64.floor(i64.toF64(raw * power) / i64.toF64(one)) / i64.toF64(power)
  run Testing.expect(
    f64.round(shorter * i64.toF64(one)) != i64.toF64(raw),
    "shorter lower decimal fails",
  )
  run Testing.expect(
    f64.round((shorter + 1.0 / i64.toF64(power)) * i64.toF64(one)) != i64.toF64(raw),
    "shorter upper decimal fails",
  )
}

test effect fn shortestAllF2dot14() -> ()
  ! WriterError | AssertionError<'static> {
  let mut raw: i32 = -32768
  while raw <= 32767 {
    run checkShortest(i32.toI64(raw), F2Dot14.fromBits(i32.toI16(raw)), 14)
    raw = raw + 1
  }
}

test effect fn shortestAllF4dot12() -> ()
  ! WriterError | AssertionError<'static> {
  let mut raw: i32 = -32768
  while raw <= 32767 {
    run checkShortest(i32.toI64(raw), F4Dot12.fromBits(i32.toI16(raw)), 12)
    raw = raw + 1
  }
}

test effect fn shortestAllF6dot10() -> ()
  ! WriterError | AssertionError<'static> {
  let mut raw: i32 = -32768
  while raw <= 32767 {
    run checkShortest(i32.toI64(raw), F6Dot10.fromBits(i32.toI16(raw)), 10)
    raw = raw + 1
  }
}

effect fn sampledWide(fixed: bool) -> ()
  ! WriterError | AssertionError<'static> {
  let starts: [i64; 4] = [
    i32.toI64(i32.MIN),
    -200000,
    i32.toI64(i32.MIN),
    i32.toI64(i32.MAX) - 2000,
  ]
  let ends: [i64; 4] = [i32.toI64(i32.MIN) + 2000, 200000, i32.toI64(i32.MAX), i32.toI64(i32.MAX)]
  let steps: [i64; 4] = [1, 1, 65521, 1]
  let mut index: usize = 0
  while index < 4 {
    let mut raw = starts[index]
    while raw <= ends[index] {
      if fixed {
        run checkShortest(raw, Fixed.fromBits(i64.toI32(raw)), 16)
      } else {
        run checkShortest(raw, F26Dot6.fromBits(i64.toI32(raw)), 6)
      }
      raw = raw + steps[index]
    }
    index = index + 1
  }
}

test effect fn shortestSampledFixed() -> ()
  ! WriterError | AssertionError<'static> {
  run sampledWide(true)
}

test effect fn shortestSampledF26dot6() -> ()
  ! WriterError | AssertionError<'static> {
  run sampledWide(false)
}

test effect fn formatterFlags() -> ()
  ! WriterError | AssertionError<'static> {
  let value = F2Dot14.fromBits(9830)
  run formatted("{value:.2}", &.{ value: value }, "0.60")
  run formatted("{value:.2?}", &.{ value: value }, "0.60")
  run formatted("{value:>8}", &.{ value: value }, "     0.6")
  run formatted("{value:8}", &.{ value: value }, "     0.6")
  run formatted("{value:<8}|", &.{ value: value }, "0.6     |")
  run formatted("{value:*^9}", &.{ value: value }, "***0.6***")
  run formatted("{value:08}", &.{ value: value }, "000000.6")
  run formatted("{value:+}", &.{ value: value }, "+0.6")
  run formatted("{value:?}", &.{ value: value }, "0.6")
  let floats: [f64; 2] = [-1.5, 1.0]
  let mut i: usize = 0
  while i < 2 {
    let fixed = .{ value: F2Dot14.fromF64(floats[i]) }
    let float = .{ value: floats[i] }
    run sameFormatting("{value}", &fixed, &float)
    run sameFormatting("{value:.3}", &fixed, &float)
    run sameFormatting("{value:>8}", &fixed, &float)
    run sameFormatting("{value:<8}", &fixed, &float)
    run sameFormatting("{value:08}", &fixed, &float)
    run sameFormatting("{value:+09}", &fixed, &float)
    i = i + 1
  }
}
