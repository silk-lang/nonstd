// Display regression tests ported from upstream font-types.
import fixed { F2Dot14, F4Dot12, F6Dot10, Fixed, F26Dot6, F48Dot16 }
import fixed_format { decimalRepresentation }
import tag { Tag }
import silk.text.format { Format, Display, ParseError }
import silk.io.writer { Writer, WriterError }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u64
import silk.num.f64

struct Capture {
  bytes: [u8; 128],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError {
    if value.length > 128 - self.length {
      fail Writer.failure()
    }
    let mut i: usize = 0
    while i < value.length {
      self.bytes[self.length] = value[i]
      self.length = self.length + 1
      i = i + 1
    }
  }

  effect fn flush(self: &mut Self) -> () ! WriterError {}
}

fn contents(capture: &Capture) -> string {
  return String.fromUtf8(Slice.view<u8>(&capture.bytes, 0, capture.length))
    |> Result<string, InvalidUtf8>.unwrapOr("invalid")
}

effect fn text<T: Display>(value: T, expected: string<'static>) -> ()
  ! WriterError | AssertionError<'static> {
  let mut capture = Capture { bytes: [0; 128], length: 0 }
  run Format.display(&value) |> Effect.provideMut<Writer>(&mut capture)
  run Testing.expect(contents(&capture) == expected, expected)
}

effect fn formatted<T>(static template: string<'static>, value: &T, expected: string<'static>) -> ()
  ! WriterError | AssertionError<'static> {
  let mut capture = Capture { bytes: [0; 128], length: 0 }
  run Format.format(template, value) |> Effect.provideMut<Writer>(&mut capture)
  run Testing.expect(contents(&capture) == expected, expected)
}

effect fn sameFormatting<A, B>(static template: string<'static>, left: &A, right: &B) -> ()
  ! WriterError | AssertionError<'static> {
  let mut a = Capture { bytes: [0; 128], length: 0 }
  let mut b = Capture { bytes: [0; 128], length: 0 }
  run Format.format(template, left) |> Effect.provideMut<Writer>(&mut a)
  run Format.format(template, right) |> Effect.provideMut<Writer>(&mut b)
  run Testing.expect(contents(&a) == contents(&b), "fixed and float flags agree")
}

test effect fn tagDisplay() -> ()
  ! WriterError | AssertionError<'static> {
  run text(Tag.fromBeBytes([25, 122, 64, 127]), "{0x19}z@{0x7F}")
}

test effect fn f2dot14Display() -> ()
  ! WriterError | AssertionError<'static> {
  let raws: [i16; 11] = [9830, -10139, 16384, -16384, 0, -32768, 32767, 1, -1, 8192, -4096]
  let strings: [string<'static>; 11] = [
    "0.6",
    "-0.61884",
    "1",
    "-1",
    "0",
    "-2",
    "1.99994",
    "0.00006",
    "-0.00006",
    "0.5",
    "-0.25",
  ]
  let mut i: usize = 0
  while i < raws.length {
    run text(F2Dot14.fromBits(raws[i]), strings[i])
    i = i + 1
  }
}

test effect fn f4dot12F6dot10Display() -> ()
  ! WriterError | AssertionError<'static> {
  run text(F4Dot12.fromF32(0.6), "0.6")
  run text(F4Dot12.min(), "-8")
  run text(F4Dot12.max(), "7.9998")
  run text(F6Dot10.fromF32(-0.6), "-0.6")
  run text(F6Dot10.min(), "-32")
  run text(F6Dot10.max(), "31.999")
}

test effect fn fixedDisplay() -> ()
  ! WriterError | AssertionError<'static> {
  let values = [
    Fixed.fromF64(0.6),
    Fixed.fromF64(-0.6),
    Fixed.fromF64(-1.5),
    Fixed.fromI32(1000),
    Fixed.fromF64(32767.5),
    Fixed.max(),
    Fixed.min(),
    Fixed.epsilon(),
    Fixed.fromBits(-1),
  ]
  let strings: [string<'static>; 9] = [
    "0.6",
    "-0.6",
    "-1.5",
    "1000",
    "32767.5",
    "32767.99998",
    "-32768",
    "0.00002",
    "-0.00002",
  ]
  let mut i: usize = 0
  while i < values.length {
    run text(values[i], strings[i])
    i = i + 1
  }
}

