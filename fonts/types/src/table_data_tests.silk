// Port of the three upstream TableDataRef tests using a borrowed header view.
import table_data { TableDataRef, HeaderRead }
import scalar { FixedSize, readScalar }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.testing.testing { Testing, AssertionError }

struct Header<'a> {
  bytes: &'a [u8],
}

impl<'a> FixedSize for Header<'a> {
  fn rawByteLen() -> usize {
    return 6
  }
}

impl<'a> HeaderRead<'a> for Header<'a> {
  fn readHeader(bytes: &'a [u8]) -> Self {
    return Self { bytes: bytes }
  }
}

impl<'a> Header<'a> {
  fn a(self: &Self) -> u16 {
    return readScalar<u16>(Slice.view<u8>(self.bytes, 0, 2)) |> Option<u16>.unwrapOr(0)
  }

  fn b(self: &Self) -> u32 {
    return readScalar<u32>(Slice.view<u8>(self.bytes, 2, 4)) |> Option<u32>.unwrapOr(0)
  }
}

test effect fn readsHeader() -> ()
  ! AssertionError<'static> {
  if let Option<TableDataRef<'static, Header<'static>>>.Some { value: table } = move TableDataRef<
    'static,
    Header<'static>
  >.new(b"\x00\x01\x00\x00\x00\x02\xff") {
    let header = TableDataRef<'static, Header<'static>>.header(&table)
    run Testing.expect(Header.a(&header) == 1 && Header.b(&header) == 2, "header fields")
    run Testing.expect(
      TableDataRef<'static, Header<'static>>.data(&table).length == 7,
      "full table data retained",
    )
  } else {
    run Testing.expect(false, "header present")
  }
}

test effect fn rejectsShortData() -> ()
  ! AssertionError<'static> {
  let short = TableDataRef<'static, Header<'static>>.new(b"\x00\x01\x00\x00\x00")
  let full = TableDataRef<'static, Header<'static>>.new(b"\x00\x01\x00\x00\x00\x02")
  let a = match move short {
    Option<TableDataRef<'static, Header<'static>>>.None => true
    _ => false
  }
  let b = match move full {
    Option<TableDataRef<'static, Header<'static>>>.Some { value } => true
    _ => false
  }
  run Testing.expect(a && b, "exact fixed header bound")
}

test effect fn readsUnalignedHeader() -> ()
  ! AssertionError<'static> {
  let bytes = b"\xff\x00\x03\x00\x00\x00\x04"
  if let Option<TableDataRef<'static, Header<'static>>>.Some { value: table } = move TableDataRef<
    'static,
    Header<'static>
  >.new(Slice.view<u8>(bytes, 1, 6)) {
    let header = TableDataRef<'static, Header<'static>>.header(&table)
    run Testing.expect(
      Header.a(&header) == 3 && Header.b(&header) == 4,
      "unaligned byte-backed header",
    )
  } else {
    run Testing.expect(false, "unaligned header present")
  }
}
