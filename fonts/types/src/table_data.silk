//! A checked extent with a typed, borrowed fixed-header view.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import scalar { FixedSize, fixedByteLen }
import silk.core.option { Option }
import silk.core.ownership { Copy }

/// Header implementations decode a view from a slice already checked against FixedSize.
/// The returned view must borrow the input; it must not assume native struct layout.
pub interface HeaderRead<'a> {
  fn readHeader(bytes: &'a [u8]) -> Self
}

pub fn readHeader<'a, H: HeaderRead<'a>>(bytes: &'a [u8]) -> H {
  return HeaderRead.readHeader(bytes)
}

pub struct TableDataRef<'a, H: FixedSize + HeaderRead<'a>> {
  bytes: &'a [u8],
}

impl<'a, H: FixedSize + HeaderRead<'a>> Copy for TableDataRef<'a, H> {}

impl<'a, H> TableDataRef<'a, H> {
  pub fn new(bytes: &'a [u8]) -> Option<Self> {
    if bytes.length < fixedByteLen<H>() {
      return Option<Self>.None
    }
    return Option<Self>.some(Self { bytes: bytes })
  }

  pub fn header(self: &Self) -> H {
    return readHeader<H>(self.bytes)
  }

  pub fn data(self: &Self) -> &'a [u8] {
    return self.bytes
  }
}
