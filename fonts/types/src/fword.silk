  pub fn toBeBytes(self: UfWord) -> [u8; 2] {
    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<UfWord>(self, &mut bytes)
    return bytes
  }

  pub fn toFixed(self: UfWord) -> Fixed {
    return Fixed.fromI32(u16.toI32(self.value))
  }

  pub fn applyDelta(self: UfWord, delta: F48Dot16) -> f32 {
    return u16.toF32(self.value) + f64.toF32(F48Dot16.toF64(delta))
  }
}

impl Equal for UfWord {
  fn equals(left: &UfWord, right: &UfWord) -> bool {
    return left.value == right.value
  }
}

impl Order for UfWord {
  fn compare(left: &UfWord, right: &UfWord) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Scalar for UfWord {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<UfWord> {
    return match move readScalar<u16>(bytes) {
      Option<u16>.Some { value } => Option<UfWord>.some(UfWord { value: value })
      Option<u16>.None => Option<UfWord>.None
