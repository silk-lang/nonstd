  fn write(value: UfWord, bytes: &mut [u8]) -> bool {
    return writeScalar<u16>(value.value, move bytes)
  }
}

import scalar { FixedSize }

impl FixedSize for FWord {
  fn rawByteLen() -> usize {
    return 2
  }
}

impl FixedSize for UfWord {
  fn rawByteLen() -> usize {
    return 2
  }
}
