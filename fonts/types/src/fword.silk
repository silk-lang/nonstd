import scalar { Scalar, readScalar, writeScalar }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.i16
import silk.num.i32
import silk.num.i64
import cast
import fixed { Fixed, F48Dot16 }
import silk.num.f64

pub struct FWord {
  value: i16,
}

impl Copy for FWord {}

impl FWord {
  pub fn new(raw: i16) -> FWord {
    return FWord { value: raw }
  }

  pub fn toI16(self: FWord) -> i16 {
    return self.value
  }

  pub fn toBeBytes(self: FWord) -> [u8; 2] {
    let mut bytes: [u8; 2] = [0; 2]
    drop writeScalar<FWord>(self, &mut bytes)
    return bytes
  }

  pub fn toFixed(self: FWord) -> Fixed {
    return Fixed.fromI32(i16.toI32(self.value))
  }

  pub fn applyDelta(self: FWord, delta: F48Dot16) -> f32 {
    return i16.toF32(self.value) + f64.toF32(F48Dot16.toF64(delta))
  }
}

impl Equal for FWord {
  fn equals(left: &FWord, right: &FWord) -> bool {
    return left.value == right.value
  }
}

impl Order for FWord {
  fn compare(left: &FWord, right: &FWord) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Scalar for FWord {
  fn rawByteLen() -> usize {
    return 2
  }

  fn read(bytes: &[u8]) -> Option<FWord> {
    return match move readScalar<i16>(bytes) {
      Option<i16>.Some { value } => Option<FWord>.some(FWord { value: value })
      Option<i16>.None => Option<FWord>.None
    }
  }

  fn write(value: FWord, bytes: &mut [u8]) -> bool {
    return writeScalar<i16>(value.value, move bytes)
  }
}

pub struct UfWord {
  value: u16,
}

impl Copy for UfWord {}

impl UfWord {
  pub fn new(raw: u16) -> UfWord {
    return UfWord { value: raw }
  }

  pub fn toU16(self: UfWord) -> u16 {
    return self.value
