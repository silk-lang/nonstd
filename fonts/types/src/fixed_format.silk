//! Exact shortest decimal formatting without 128-bit integer intermediates.
// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.
import silk.text.format { Format, Formatter }
import silk.io.writer { Writer, WriterError }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u64
import silk.num.i64
import cast

pub struct Decimal {
  pub digits: u64,
  pub places: usize,
}

pub fn decimalRepresentation(raw: i64, fractionBits: u64) -> Decimal {
  let mut magnitude = cast.i64ToU64(raw)
  if raw < 0 {
    magnitude = u64.wrappingSubtract(0, magnitude)
  }
  let one = u64.shiftLeft(1, fractionBits)
  let integer = magnitude / one
  let fraction = magnitude % one
  let mut power: u64 = 1
  let mut places: usize = 0
  while places <= 5 {
    // Split integer/fraction first: raw * power would overflow for F48Dot16.
    let rounded = (2 * fraction * power + one) / (2 * one)
    let left = rounded * one
    let right = fraction * power
    let mut difference: u64 = 0
    if left >= right {
      difference = left - right
    } else {
      difference = right - left
    }
    if difference * 2 < power {
      return Decimal { digits: integer * power + rounded, places: places }
    }
    places = places + 1
    power = power * 10
  }
  return Intrinsic.trap("fixed fraction requires at most five decimal places")
}

pub effect fn displayShortest(raw: i64, fractionBits: u64, formatter: &mut Formatter) -> ()
  ! WriterError
  ? &mut Writer {
  let decimal = decimalRepresentation(raw, fractionBits)
  let mut digits = decimal.digits
  let mut bytes: [u8; 32] = [0; 32]
  let mut position: usize = 32
  let mut written: usize = 0
  while written <= decimal.places || digits != 0 {
    if written == decimal.places && decimal.places != 0 {
      position = position - 1
      bytes[position] = 46
    }
    position = position - 1
    bytes[position] = 48 + u64.toU8(digits % 10)
    digits = digits / 10
    written = written + 1
  }
  let value = String.fromUtf8(Slice.view<u8>(&bytes, position, 32 - position))
    |> Result<string, InvalidUtf8>.unwrapOr("")
  run Format.padNumber(&mut formatter, raw < 0, "", value)
}
