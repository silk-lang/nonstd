//! Glyph outlines drawn into a `vector.Path`, scaled from font units to pixels.
import read_fonts.model.glyph.outline { PathSink }
import vector.path { Path }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32

/// Appends outline commands to `path`, mapping a font-unit point `(x, y)` (y up) to
/// `(originX + x * scale, originY - y * scale)` (y down), so `origin` is the pen position on the
/// baseline and `scale` is pixels per font unit.
///
/// Sinks cannot fail, so the first allocation failure is remembered in `failed` and the later
/// commands are dropped; the caller reports it.
pub struct PathRecorder<'p> {
  pub path: &'p mut Path,
  pub scale: f64,
  pub originX: f64,
  pub originY: f64,
  pub failed: bool,
}

impl<'p> PathRecorder<'p> {
  /// A recorder that appends to `path` with the pen at `(originX, originY)`.
  pub fn new(path: &'p mut Path, scale: f64, originX: f64, originY: f64) -> Self {
    return Self { path: move path, scale: scale, originX: originX, originY: originY, failed: false }
  }

  fn x(self: &Self, x: f32) -> f64 {
    return self.originX + f32.toF64(x) * self.scale
  }

  fn y(self: &Self, y: f32) -> f64 {
    return self.originY - f32.toF64(y) * self.scale
  }

  fn check(self: &mut Self, result: Result<(), OutOfMemoryError>) -> () {
    if let Result<(), OutOfMemoryError>.Failure { error } = move result {
      drop error
      self.failed = true
    }
  }
}

// PathSink methods have no effects, and the system allocator has no state to share.
impl<'p> PathSink for PathRecorder<'p> {
  fn moveTo(self: &mut Self, x: f32, y: f32) {
    if self.failed {
      return
    }
    let px = PathRecorder.x(&self, x)
    let py = PathRecorder.y(&self, y)
    let mut allocator = Allocator.systemAllocatorProvider()
    let result = run Effect.result(Path.moveTo(&mut self.path, px, py))
      |> Effect.provideMut<Allocator>(&mut allocator)
    PathRecorder.check(&mut self, move result)
  }

  fn lineTo(self: &mut Self, x: f32, y: f32) {
    if self.failed {
      return
    }
    let px = PathRecorder.x(&self, x)
    let py = PathRecorder.y(&self, y)
    let mut allocator = Allocator.systemAllocatorProvider()
    let result = run Effect.result(Path.lineTo(&mut self.path, px, py))
      |> Effect.provideMut<Allocator>(&mut allocator)
    PathRecorder.check(&mut self, move result)
  }

  fn quadTo(self: &mut Self, cx: f32, cy: f32, x: f32, y: f32) {
    if self.failed {
      return
    }
    let pcx = PathRecorder.x(&self, cx)
    let pcy = PathRecorder.y(&self, cy)
    let px = PathRecorder.x(&self, x)
    let py = PathRecorder.y(&self, y)
    let mut allocator = Allocator.systemAllocatorProvider()
    let result = run Effect.result(Path.quadTo(&mut self.path, pcx, pcy, px, py))
      |> Effect.provideMut<Allocator>(&mut allocator)
    PathRecorder.check(&mut self, move result)
  }

  fn curveTo(self: &mut Self, cx0: f32, cy0: f32, cx1: f32, cy1: f32, x: f32, y: f32) {
    if self.failed {
      return
    }
    let p0x = PathRecorder.x(&self, cx0)
    let p0y = PathRecorder.y(&self, cy0)
    let p1x = PathRecorder.x(&self, cx1)
    let p1y = PathRecorder.y(&self, cy1)
    let px = PathRecorder.x(&self, x)
    let py = PathRecorder.y(&self, y)
    let mut allocator = Allocator.systemAllocatorProvider()
    let result = run Effect.result(Path.cubicTo(&mut self.path, p0x, p0y, p1x, p1y, px, py))
      |> Effect.provideMut<Allocator>(&mut allocator)
    PathRecorder.check(&mut self, move result)
  }

  fn close(self: &mut Self) {
    if self.failed {
      return
    }
    let mut allocator = Allocator.systemAllocatorProvider()
    let result = run Effect.result(Path.close(&mut self.path))
      |> Effect.provideMut<Allocator>(&mut allocator)
    PathRecorder.check(&mut self, move result)
  }
}
