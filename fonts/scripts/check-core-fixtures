#!/usr/bin/env python3
"""Differential container edge cases independent of the valid-font corpus."""
from pathlib import Path
import struct
import tempfile
import harness


def sfnt(records=(), version=0x00010000):
    return struct.pack(">IHHHH", version, len(records), 0, 0, 0) + b"".join(
        struct.pack(">4sIII", *record) for record in records)


def fixtures():
    records = [(b"head", 0, 44, 4), (b"name", 0, 48, 4)]
    normal = sfnt(records) + b"abcdefgh"
    for length in range(len(normal) + 1):
        yield f"sfnt-prefix-{length:03d}", normal[:length]
    for version in (0, 1, 0x74727565, 0x4F54544F, 0x74797031, 0xFFFFFFFF):
        yield f"sfnt-version-{version:08x}", sfnt(version=version)
    for offset, length in ((0, 4), (28, 0), (28, 4), (29, 0), (0xFFFFFFFF, 0xFFFFFFFF)):
        yield f"record-{offset}-{length}", sfnt([(b"head", 0, offset, length)])
    yield "duplicate-first-null", sfnt([(b"head", 0, 0, 4), (b"head", 0, 44, 4)]) + b"abcd"
    yield "unsorted", sfnt(list(reversed(records))) + b"abcdefgh"
    yield "zero-tag", sfnt([(b"\0\0\0\0", 0, 28, 4)]) + b"abcd"
    for major in (0, 1, 2, 3):
        for minor in (0, 1, 2):
            for legacy_count in (0, 1, 2):
                header = struct.pack(">4sHHI", b"ttcf", major, minor, legacy_count)
                legacy = b"".join(struct.pack(">I", 0xFFFFFFFF) for _ in range(legacy_count))
                dsig = struct.pack(">III", 0x44534947, 8, 0xFFFFFFFF) if major == 2 else b""
                extended_start = len(header + legacy + dsig)
                first = extended_start + 12
                extended = struct.pack(">III", 2, first, first + 12)
                blob = header + legacy + dsig + extended + sfnt() + sfnt(version=0x4F54544F)
                for length in sorted({0, 4, 11, 12, len(header + legacy), extended_start,
                                      extended_start + 4, first - 1, first, len(blob) - 1, len(blob)}):
                    yield f"ttc-{major}-{minor}-{legacy_count}-prefix-{length:03d}", blob[:length]
    yield "ttc-huge-count", struct.pack(">4sHHI", b"ttcf", 1, 0, 0xFFFFFFFF)
    yield "ttc-empty", struct.pack(">4sHHI", b"ttcf", 1, 0, 0)


with tempfile.TemporaryDirectory(prefix="font-core-fixtures-") as temporary:
    fonts = []
    for name, data in fixtures():
        path = Path(temporary) / f"{name}.ttf"
        path.write_bytes(data)
        fonts.append(path)
    raise SystemExit(harness.compare(fonts, harness.REFERENCE, harness.silk_binary(), 5))
