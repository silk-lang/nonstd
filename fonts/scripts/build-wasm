#!/usr/bin/env sh
# Build font-shape-wasm for wasm32 and copy it to fonts/shape/tools/wasm/js/dist/harfrust.wasm.
set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
silk build --release --manifest-path "$root/fonts/shape/tools/wasm/silk.toml" --target wasm32-unknown-unknown
mkdir -p "$root/fonts/shape/tools/wasm/js/dist"
cp "$root/build/llvm/wasm32-unknown-unknown/release/font-shape-wasm" "$root/fonts/shape/tools/wasm/js/dist/harfrust.wasm"
echo "$root/fonts/shape/tools/wasm/js/dist/harfrust.wasm"
